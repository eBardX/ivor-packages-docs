{"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormidi2\/usingivormidi2"]}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"A Universal MIDI Packet (UMP) is one to four 32-bit words. The most","type":"text"},{"type":"text","text":" "},{"type":"text","text":"significant 4 bits of its first word are its message type, which fixes the"},{"type":"text","text":" "},{"type":"text","text":"packet’s size and the family of message it carries:"}]},{"header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Message type"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Family"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Type"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Grouped"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"0x0"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Utility"}],"type":"paragraph"}],[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2UtilityMessage","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"No"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"0x1"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"System common and real-time"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"MIDISystemMessage"},{"type":"text","text":" (IvorMIDI)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Yes"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"0x2"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"MIDI 1.0 channel voice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"MIDIChannelMessage"},{"type":"text","text":" (IvorMIDI)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Yes"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"0x3"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"7-bit system exclusive"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"MIDISystemMessage"},{"type":"text","text":" (IvorMIDI)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Yes"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"0x4"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"MIDI 2.0 channel voice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2ChannelMessage","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Yes"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"0x5","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"System Exclusive 8","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2SystemExclusive8Message","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Yes"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"0xD"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Flex Data"}]}],[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2FlexDataMessage","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Yes"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"0xF"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"UMP stream"}]}],[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2StreamMessage","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"No"}]}]]],"alignments":["left","left","left","left"],"type":"table"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A grouped message travels in one of 16 groups, each with 16 channels of its"},{"type":"text","text":" "},{"type":"text","text":"own. A groupless message addresses the UMP endpoint as a whole."},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2Message","isActive":true},{"type":"text","text":" wraps a message of any family, together with its group, and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2MessageReader","isActive":true},{"type":"text","text":" turns a stream of words into them."}]},{"anchor":"Packets-and-groups","level":2,"type":"heading","text":"Packets and groups"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2Packet","isActive":true},{"type":"text","text":" holds exactly as many words as its message type requires;"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2Packet\/init(words:)","isActive":true},{"type":"text","text":" returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" for any other number."},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2Packet\/wordCount(forUniversalMIDIPacket:)","isActive":true},{"type":"text","text":" reads that number from a"},{"type":"text","text":" "},{"type":"text","text":"first word — including for the reserved message types, so a reader can skip"},{"type":"text","text":" "},{"type":"text","text":"packets it doesn’t understand."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2Group","isActive":true},{"type":"text","text":" numbers the groups from 1 to 16, as the MIDI 2.0"},{"type":"text","text":" "},{"type":"text","text":"specifications do; a packet stores them zero-based. Like the IvorMIDI data"},{"type":"text","text":" "},{"type":"text","text":"values, it can be written as an integer literal."},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2Packet\/group","isActive":true},{"type":"text","text":" is "},{"type":"codeVoice","code":"nil"},{"text":" for a groupless packet.","type":"text"}]},{"anchor":"Converting-messages","level":2,"type":"heading","text":"Converting messages"},{"type":"paragraph","inlineContent":[{"text":"Grouped message types adopt ","type":"text"},{"type":"reference","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2PacketsConvertible","isActive":true},{"type":"text","text":", which converts a"},{"type":"text","text":" "},{"type":"text","text":"message to packets in a group, and back:"}]},{"code":["let noteOn  = MIDIChannelMessage.noteOn(1, 60, 100)","let packets = noteOn.packets(group: 2)","","MIDIChannelMessage(packets: packets!) == noteOn     \/\/ true","packets?.first?.group                               \/\/ 2"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The group defaults to 1. A packet carries its group, so the decoding"},{"type":"text","text":" "},{"type":"text","text":"initializers don’t take one; read it from the first packet’s"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2Packet\/group","isActive":true},{"type":"text","text":". Groupless message types adopt"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2GrouplessPacketsConvertible"},{"type":"text","text":" instead, whose "},{"code":"packets()","type":"codeVoice"},{"type":"text","text":" takes no group."},{"type":"text","text":" "},{"type":"text","text":"Either way, decoding returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" unless the packets encode exactly one valid"},{"type":"text","text":" "},{"type":"text","text":"message, and encoding returns "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" for a message that cannot be encoded."},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2Message","isActive":true},{"type":"text","text":" converts a message of any family the same way."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A MIDI 1.0 channel voice message always fits in one packet, so"},{"type":"text","text":" "},{"type":"codeVoice","code":"MIDIChannelMessage"},{"type":"text","text":" also has the single-packet "},{"type":"codeVoice","code":"packet(group:)"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"init?(packet:)"},{"type":"text","text":"."}]},{"type":"heading","text":"MIDI 1.0 messages in packets","level":2,"anchor":"MIDI-10-messages-in-packets"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The IvorMIDI message types travel unchanged in packets, as CoreMIDI’s event"},{"type":"text","text":" "},{"type":"text","text":"lists carry them. A channel voice message, or a system common or real-time"},{"type":"text","text":" "},{"type":"text","text":"message, is one single-word packet. A system exclusive message is one two-word"},{"type":"text","text":" "},{"type":"text","text":"packet for every 6 data bytes, without the 0xF0 and 0xF7 bytes that frame it"},{"type":"text","text":" "},{"type":"text","text":"on a MIDI 1.0 byte stream:"}]},{"code":["let sysEx   = MIDISystemMessage.systemExclusive([0x7e, 0x7f, 0x09, 0x01, 0xf7])","let packets = sysEx.packets()       \/\/ words: [0x30047E7F, 0x09010000]"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"MIDI 2.0 channel voice messages","level":2,"anchor":"MIDI-20-channel-voice-messages"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2ChannelMessage"},{"type":"text","text":" is a two-word packet with more resolution than its"},{"type":"text","text":" "},{"type":"text","text":"MIDI 1.0 counterpart: 16-bit velocities, and 32-bit controller, pressure, and"},{"type":"text","text":" "},{"type":"text","text":"pitch bend values. It adds per-note controllers, per-note pitch bend, and"},{"type":"text","text":" "},{"type":"text","text":"per-note management, and it replaces MIDI 1.0’s control change sequences for"},{"type":"text","text":" "},{"type":"text","text":"registered and non-registered parameters and bank selection with single"},{"type":"text","text":" "},{"type":"text","text":"messages:"}]},{"type":"codeListing","code":["\/\/ Middle C at full velocity, tuned to 60.5 semitones by its pitch attribute.","let noteOn = MIDI2ChannelMessage.noteOn(1, 60, 0xffff, .pitch(60 << 9 | 256))","","\/\/ Program 25 in bank 121:1, in one message.","let program = MIDI2ChannelMessage.programChange(1, 25, MIDIData2Value(msb: 121, lsb: 1))","","\/\/ Pitch bend sensitivity of 2 semitones (in the top 7 bits), in one message.","let bendRange = MIDI2ChannelMessage.registeredController(1, .pitchBendSensitivity, 2 << 25)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"A note on or note off may carry a ","type":"text"},{"identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2NoteAttribute","isActive":true,"type":"reference"},{"text":": a pitch, as a Q7.9","type":"text"},{"text":" ","type":"text"},{"text":"fixed-point number of semitones, or data whose meaning a manufacturer or a","type":"text"},{"text":" ","type":"text"},{"text":"MIDI-CI profile determines. Unlike MIDI 1.0, a note on with a velocity of zero","type":"text"},{"text":" ","type":"text"},{"text":"is not a note off. A device that uses MIDI 2.0 channel voice messages in a","type":"text"},{"text":" ","type":"text"},{"text":"group must not use MIDI 1.0 channel voice messages in the same group.","type":"text"}]},{"type":"heading","text":"Other MIDI 2.0 messages","anchor":"Other-MIDI-20-messages","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2SystemExclusive8Message","isActive":true},{"type":"text","text":" carries system exclusive data whose bytes"},{"type":"text","text":" "},{"type":"text","text":"may use all 8 bits, up to 13 bytes per four-word packet. Its stream ID lets a"},{"type":"text","text":" "},{"type":"text","text":"sender interleave several messages. System Exclusive 8 messages cannot be"},{"type":"text","text":" "},{"type":"text","text":"translated to MIDI 1.0 byte streams."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2FlexDataMessage","isActive":true},{"type":"text","text":" carries tempo, time signature, metronome, key"},{"type":"text","text":" "},{"type":"text","text":"signature, and chord name events, and metadata and performance text such as"},{"type":"text","text":" "},{"type":"text","text":"a song’s name or a lyric. Each is addressed to a channel of its group, or to"},{"type":"text","text":" "},{"type":"text","text":"the group as a whole; text spans up to 32 packets."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2StreamMessage","isActive":true},{"type":"text","text":" discovers a UMP endpoint and its function blocks,"},{"type":"text","text":" "},{"type":"text","text":"selects the protocol and jitter reduction timestamps of a stream, and marks"},{"type":"text","text":" "},{"type":"text","text":"the start and end of a MIDI Clip File’s sequence data."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2UtilityMessage","isActive":true},{"type":"text","text":" marks time for the messages that follow it: jitter"},{"type":"text","text":" "},{"type":"text","text":"reduction clocks and timestamps, and the delta clockstamps of a MIDI Clip"},{"type":"text","text":" "},{"type":"text","text":"File."}]}]}]},{"type":"codeListing","code":["let tempo    = MIDI2FlexDataMessage.setTempo(50_000_000)     \/\/ 120 BPM, in 10 ns units","let title    = MIDI2FlexDataMessage.metadataText(.group, .compositionName, \"Cooley’s\")","let discover = MIDI2StreamMessage.endpointDiscovery(umpVersionMajor: 1,","                                                    umpVersionMinor: 1,","                                                    filter: [.endpointInfo, .endpointName])"],"syntax":"swift"},{"type":"heading","text":"Reading a stream","anchor":"Reading-a-stream","level":2},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2MessageReader","isActive":true,"type":"reference"},{"text":" splits a stream of words into packets, reassembles","type":"text"},{"text":" ","type":"text"},{"text":"messages that span several packets, and returns each message once its last","type":"text"},{"text":" ","type":"text"},{"text":"packet arrives. Words may arrive in any grouping: the reader keeps the words","type":"text"},{"text":" ","type":"text"},{"text":"of an incomplete packet until the rest arrive.","type":"text"}]},{"type":"codeListing","code":["var reader = MIDI2MessageReader()","","for words in received {","    for message in reader.read(words: words) {","        handle(message)","    }","}","","for message in reader.finish() {    \/\/ the packets of any incomplete message","    handle(message)","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The reader follows the UMP specification’s rules for interleaving. Within a","type":"text"},{"text":" ","type":"text"},{"text":"group, a 7-bit system exclusive or Flex Data message may be interleaved only","type":"text"},{"text":" ","type":"text"},{"text":"with system real-time messages and groupless messages such as jitter reduction","type":"text"},{"text":" ","type":"text"},{"text":"clocks; any other packet in the group interrupts it. System Exclusive 8","type":"text"},{"text":" ","type":"text"},{"text":"messages may be interleaved with anything, including each other when their","type":"text"},{"text":" ","type":"text"},{"text":"stream IDs differ. A UMP stream message that spans several packets is","type":"text"},{"text":" ","type":"text"},{"text":"interrupted by any other UMP stream message.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A message that is interrupted, or whose packets do not decode, comes back","type":"text"},{"text":" ","type":"text"},{"text":"packet by packet as ","type":"text"},{"identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2Message\/unrecognized(_:)","isActive":true,"type":"reference"},{"text":", as does a packet of a","type":"text"},{"text":" ","type":"text"},{"text":"reserved message type. ","type":"text"},{"identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2MessageReader\/finish()","isActive":true,"type":"reference"},{"text":" returns the packets of","type":"text"},{"text":" ","type":"text"},{"text":"any message still incomplete at the end of the stream the same way, and readies","type":"text"},{"text":" ","type":"text"},{"text":"the reader for a new stream.","type":"text"}]},{"type":"heading","text":"Error handling","anchor":"Error-handling","level":2},{"type":"paragraph","inlineContent":[{"text":"IvorMIDI2 throws no errors. Decoding returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" for packets that do not","type":"text"},{"text":" ","type":"text"},{"text":"encode exactly one valid message, encoding returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" for a message that","type":"text"},{"text":" ","type":"text"},{"text":"cannot be encoded, and ","type":"text"},{"identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2MessageReader","isActive":true,"type":"reference"},{"text":" reports what it cannot decode as","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2Message\/unrecognized(_:)","isActive":true,"type":"reference"},{"text":" messages rather than failing.","type":"text"}]},{"type":"heading","text":"Concurrency","anchor":"Concurrency","level":2},{"type":"paragraph","inlineContent":[{"text":"IvorMIDI2 is built for Swift 6 strict concurrency. Every concrete public type","type":"text"},{"text":" ","type":"text"},{"text":"is a ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":" value type, so instances can be freely shared across tasks and","type":"text"},{"text":" ","type":"text"},{"text":"actor boundaries. A ","type":"text"},{"identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2MessageReader","isActive":true,"type":"reference"},{"text":" holds the state of one stream, so","type":"text"},{"text":" ","type":"text"},{"text":"give each stream a reader of its own.","type":"text"}]}]}],"identifier":{"url":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/UsingIvorMIDI2","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2"]]},"abstract":[{"type":"text","text":"Carry MIDI 1.0 and MIDI 2.0 messages in Universal MIDI Packets, and read them"},{"type":"text","text":" "},{"type":"text","text":"back from a stream of words."}],"metadata":{"role":"article","roleHeading":"Article","title":"Using IvorMIDI2","modules":[{"name":"IvorMIDI2"}]},"kind":"article","references":{"doc://IvorMIDI2/documentation/IvorMIDI2/MIDI2Message/unrecognized(_:)":{"identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2Message\/unrecognized(_:)","url":"\/documentation\/ivormidi2\/midi2message\/unrecognized(_:)","role":"symbol","title":"MIDI2Message.unrecognized(_:)","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"unrecognized"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:9IvorMIDI20B6PacketV","text":"MIDI2Packet"},{"kind":"text","text":")"}],"abstract":[{"text":"A packet that ","type":"text"},{"identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2MessageReader","type":"reference","isActive":true},{"text":" could not decode: a packet of a","type":"text"},{"text":" ","type":"text"},{"text":"reserved message type, a Mixed Data Set packet, a packet that does","type":"text"},{"text":" ","type":"text"},{"text":"not encode a valid message, or a packet of a multi-packet message","type":"text"},{"text":" ","type":"text"},{"text":"that was interrupted or never completed.","type":"text"}],"type":"topic","kind":"symbol"},"doc://IvorMIDI2/documentation/IvorMIDI2/MIDI2Message":{"role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MIDI2Message"}],"title":"MIDI2Message","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2Message","type":"topic","abstract":[{"type":"text","text":"A message of any kind that travels in Universal MIDI Packets."}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MIDI2Message","kind":"identifier"}],"url":"\/documentation\/ivormidi2\/midi2message"},"doc://IvorMIDI2/documentation/IvorMIDI2/MIDI2NoteAttribute":{"navigatorTitle":[{"kind":"identifier","text":"MIDI2NoteAttribute"}],"identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2NoteAttribute","url":"\/documentation\/ivormidi2\/midi2noteattribute","type":"topic","title":"MIDI2NoteAttribute","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MIDI2NoteAttribute"}],"abstract":[{"type":"text","text":"An attribute of a MIDI 2.0 note on or note off message: an attribute type"},{"type":"text","text":" "},{"type":"text","text":"with 1