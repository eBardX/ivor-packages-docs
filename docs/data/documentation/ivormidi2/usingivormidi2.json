{"abstract":[{"text":"Carry MIDI 1.0 and MIDI 2.0 messages in Universal MIDI Packets, and read them","type":"text"},{"text":" ","type":"text"},{"text":"back from a stream of words.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"A Universal MIDI Packet (UMP) is one to four 32-bit words. The most","type":"text"},{"text":" ","type":"text"},{"text":"significant 4 bits of its first word are its message type, which fixes the","type":"text"},{"text":" ","type":"text"},{"text":"packet’s size and the family of message it carries:","type":"text"}],"type":"paragraph"},{"alignments":["left","left","left","left"],"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Message type","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Family","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Type","type":"text"}]}],[{"inlineContent":[{"text":"Grouped","type":"text"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"text":"0x0","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Utility","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2UtilityMessage","isActive":true,"type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"text":"No","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"0x1","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"System common and real-time","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"MIDISystemMessage","type":"codeVoice"},{"text":" (IvorMIDI)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Yes","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"0x2","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"MIDI 1.0 channel voice","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"MIDIChannelMessage","type":"codeVoice"},{"text":" (IvorMIDI)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Yes","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"0x3","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"7-bit system exclusive","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"MIDISystemMessage","type":"codeVoice"},{"text":" (IvorMIDI)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Yes","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"0x4","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"MIDI 2.0 channel voice","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2ChannelMessage","isActive":true,"type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"text":"Yes","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"0x5","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"System Exclusive 8","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2SystemExclusive8Message","isActive":true,"type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"text":"Yes","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"0xD","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Flex Data","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2FlexDataMessage","isActive":true,"type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"text":"Yes","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"0xF","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"UMP stream","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2StreamMessage","isActive":true,"type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"text":"No","type":"text"}]}]]],"type":"table","header":"row"},{"inlineContent":[{"text":"A grouped message travels in one of 16 groups, each with 16 channels of its","type":"text"},{"text":" ","type":"text"},{"text":"own. A groupless message addresses the UMP endpoint as a whole.","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2Message"},{"text":" wraps a message of any family, together with its group, and","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2MessageReader"},{"text":" turns a stream of words into them.","type":"text"}],"type":"paragraph"},{"anchor":"Packets-and-groups","level":2,"text":"Packets and groups","type":"heading"},{"inlineContent":[{"text":"A ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2Packet"},{"text":" holds exactly as many words as its message type requires;","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2Packet\/init(words:)"},{"text":" returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" for any other number.","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2Packet\/wordCount(forUniversalMIDIPacket:)"},{"text":" reads that number from a","type":"text"},{"text":" ","type":"text"},{"text":"first word — including for the reserved message types, so a reader can skip","type":"text"},{"text":" ","type":"text"},{"text":"packets it doesn’t understand.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2Group"},{"text":" numbers the groups from 1 to 16, as the MIDI 2.0","type":"text"},{"text":" ","type":"text"},{"text":"specifications do; a packet stores them zero-based. Like the IvorMIDI data","type":"text"},{"text":" ","type":"text"},{"text":"values, it can be written as an integer literal.","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2Packet\/group"},{"text":" is ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" for a groupless packet.","type":"text"}],"type":"paragraph"},{"anchor":"Converting-messages","level":2,"text":"Converting messages","type":"heading"},{"inlineContent":[{"text":"Grouped message types adopt ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2PacketsConvertible"},{"text":", which converts a","type":"text"},{"text":" ","type":"text"},{"text":"message to packets in a group, and back:","type":"text"}],"type":"paragraph"},{"code":["let noteOn  = MIDIChannelMessage.noteOn(1, 60, 100)","let packets = noteOn.packets(group: 2)","","MIDIChannelMessage(packets: packets!) == noteOn     \/\/ true","packets?.first?.group                               \/\/ 2"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"The group defaults to 1. A packet carries its group, so the decoding","type":"text"},{"text":" ","type":"text"},{"text":"initializers don’t take one; read it from the first packet’s","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2Packet\/group"},{"text":". Groupless message types adopt","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2GrouplessPacketsConvertible"},{"text":" instead, whose ","type":"text"},{"code":"packets()","type":"codeVoice"},{"text":" takes no group.","type":"text"},{"text":" ","type":"text"},{"text":"Either way, decoding returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" unless the packets encode exactly one valid","type":"text"},{"text":" ","type":"text"},{"text":"message, and encoding returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" for a message that cannot be encoded.","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2Message"},{"text":" converts a message of any family the same way.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A MIDI 1.0 channel voice message always fits in one packet, so","type":"text"},{"text":" ","type":"text"},{"code":"MIDIChannelMessage","type":"codeVoice"},{"text":" also has the single-packet ","type":"text"},{"code":"packet(group:)","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"init?(packet:)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"MIDI-10-messages-in-packets","level":2,"text":"MIDI 1.0 messages in packets","type":"heading"},{"inlineContent":[{"text":"The IvorMIDI message types travel unchanged in packets, as CoreMIDI’s event","type":"text"},{"text":" ","type":"text"},{"text":"lists carry them. A channel voice message, or a system common or real-time","type":"text"},{"text":" ","type":"text"},{"text":"message, is one single-word packet. A system exclusive message is one two-word","type":"text"},{"text":" ","type":"text"},{"text":"packet for every 6 data bytes, without the 0xF0 and 0xF7 bytes that frame it","type":"text"},{"text":" ","type":"text"},{"text":"on a MIDI 1.0 byte stream:","type":"text"}],"type":"paragraph"},{"code":["let sysEx   = MIDISystemMessage.systemExclusive([0x7e, 0x7f, 0x09, 0x01, 0xf7])","let packets = sysEx.packets()       \/\/ words: [0x30047E7F, 0x09010000]"],"type":"codeListing","syntax":"swift"},{"anchor":"MIDI-20-channel-voice-messages","level":2,"text":"MIDI 2.0 channel voice messages","type":"heading"},{"inlineContent":[{"text":"A ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2ChannelMessage"},{"text":" is a two-word packet with more resolution than its","type":"text"},{"text":" ","type":"text"},{"text":"MIDI 1.0 counterpart: 16-bit velocities, and 32-bit controller, pressure, and","type":"text"},{"text":" ","type":"text"},{"text":"pitch bend values. It adds per-note controllers, per-note pitch bend, and","type":"text"},{"text":" ","type":"text"},{"text":"per-note management, and it replaces MIDI 1.0’s control change sequences for","type":"text"},{"text":" ","type":"text"},{"text":"registered and non-registered parameters and bank selection with single","type":"text"},{"text":" ","type":"text"},{"text":"messages:","type":"text"}],"type":"paragraph"},{"code":["\/\/ Middle C at full velocity, tuned to 60.5 semitones by its pitch attribute.","let noteOn = MIDI2ChannelMessage.noteOn(1, 60, 0xffff, .pitch(60 << 9 | 256))","","\/\/ Program 25 in bank 121:1, in one message.","let program = MIDI2ChannelMessage.programChange(1, 25, MIDIData2Value(msb: 121, lsb: 1))","","\/\/ Pitch bend sensitivity of 2 semitones (in the top 7 bits), in one message.","let bendRange = MIDI2ChannelMessage.registeredController(1, .pitchBendSensitivity, 2 << 25)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"A note on or note off may carry a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2NoteAttribute"},{"text":": a pitch, as a Q7.9","type":"text"},{"text":" ","type":"text"},{"text":"fixed-point number of semitones, or data whose meaning a manufacturer or a","type":"text"},{"text":" ","type":"text"},{"text":"MIDI-CI profile determines. Unlike MIDI 1.0, a note on with a velocity of zero","type":"text"},{"text":" ","type":"text"},{"text":"is not a note off. A device that uses MIDI 2.0 channel voice messages in a","type":"text"},{"text":" ","type":"text"},{"text":"group must not use MIDI 1.0 channel voice messages in the same group.","type":"text"}],"type":"paragraph"},{"anchor":"Other-MIDI-20-messages","level":2,"text":"Other MIDI 2.0 messages","type":"heading"},{"items":[{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2SystemExclusive8Message","isActive":true},{"type":"text","text":" carries system exclusive data whose bytes"},{"type":"text","text":" "},{"type":"text","text":"may use all 8 bits, up to 13 bytes per four-word packet. Its stream ID lets a"},{"type":"text","text":" "},{"type":"text","text":"sender interleave several messages. System Exclusive 8 messages cannot be"},{"type":"text","text":" "},{"type":"text","text":"translated to MIDI 1.0 byte streams."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2FlexDataMessage","isActive":true},{"type":"text","text":" carries tempo, time signature, metronome, key"},{"type":"text","text":" "},{"type":"text","text":"signature, and chord name events, and metadata and performance text such as"},{"type":"text","text":" "},{"type":"text","text":"a song’s name or a lyric. Each is addressed to a channel of its group, or to"},{"type":"text","text":" "},{"type":"text","text":"the group as a whole; text spans up to 32 packets."}]}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2StreamMessage","isActive":true},{"type":"text","text":" discovers a UMP endpoint and its function blocks,"},{"type":"text","text":" "},{"type":"text","text":"selects the protocol and jitter reduction timestamps of a stream, and marks"},{"type":"text","text":" "},{"type":"text","text":"the start and end of a MIDI Clip File’s sequence data."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2UtilityMessage","isActive":true,"type":"reference"},{"type":"text","text":" marks time for the messages that follow it: jitter"},{"text":" ","type":"text"},{"type":"text","text":"reduction clocks and timestamps, and the delta clockstamps of a MIDI Clip"},{"text":" ","type":"text"},{"text":"File.","type":"text"}]}]}],"type":"unorderedList"},{"code":["let tempo    = MIDI2FlexDataMessage.setTempo(50_000_000)     \/\/ 120 BPM, in 10 ns units","let title    = MIDI2FlexDataMessage.metadataText(.group, .compositionName, \"Cooley’s\")","let discover = MIDI2StreamMessage.endpointDiscovery(umpVersionMajor: 1,","                                                    umpVersionMinor: 1,","                                                    filter: [.endpointInfo, .endpointName])"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"Reading a stream","anchor":"Reading-a-stream","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2MessageReader","type":"reference","isActive":true},{"text":" splits a stream of words into packets, reassembles","type":"text"},{"text":" ","type":"text"},{"text":"messages that span several packets, and returns each message once its last","type":"text"},{"text":" ","type":"text"},{"text":"packet arrives. Words may arrive in any grouping: the reader keeps the words","type":"text"},{"text":" ","type":"text"},{"text":"of an incomplete packet until the rest arrive.","type":"text"}]},{"syntax":"swift","code":["var reader = MIDI2MessageReader()","","for words in received {","    for message in reader.read(words: words) {","        handle(message)","    }","}","","for message in reader.finish() {    \/\/ the packets of any incomplete message","    handle(message)","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"The reader follows the UMP specification’s rules for interleaving. Within a","type":"text"},{"text":" ","type":"text"},{"text":"group, a 7-bit system exclusive or Flex Data message may be interleaved only","type":"text"},{"type":"text","text":" "},{"type":"text","text":"with system real-time messages and groupless messages such as jitter reduction"},{"type":"text","text":" "},{"type":"text","text":"clocks; any other packet in the group interrupts it. System Exclusive 8"},{"text":" ","type":"text"},{"text":"messages may be interleaved with anything, including each other when their","type":"text"},{"text":" ","type":"text"},{"text":"stream IDs differ. A UMP stream message that spans several packets is","type":"text"},{"text":" ","type":"text"},{"text":"interrupted by any other UMP stream message.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A message that is interrupted, or whose packets do not decode, comes back","type":"text"},{"text":" ","type":"text"},{"text":"packet by packet as ","type":"text"},{"identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2Message\/unrecognized(_:)","isActive":true,"type":"reference"},{"type":"text","text":", as does a packet of a"},{"type":"text","text":" "},{"type":"text","text":"reserved message type. "},{"type":"reference","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2MessageReader\/finish()","isActive":true},{"type":"text","text":" returns the packets of"},{"type":"text","text":" "},{"text":"any message still incomplete at the end of the stream the same way, and readies","type":"text"},{"text":" ","type":"text"},{"text":"the reader for a new stream.","type":"text"}]},{"type":"heading","text":"Error handling","anchor":"Error-handling","level":2},{"type":"paragraph","inlineContent":[{"text":"IvorMIDI2 throws no errors. Decoding returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" for packets that do not","type":"text"},{"text":" ","type":"text"},{"text":"encode exactly one valid message, encoding returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" for a message that","type":"text"},{"text":" ","type":"text"},{"text":"cannot be encoded, and ","type":"text"},{"identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2MessageReader","type":"reference","isActive":true},{"text":" reports what it cannot decode as","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2Message\/unrecognized(_:)","type":"reference","isActive":true},{"text":" messages rather than failing.","type":"text"}]},{"type":"heading","text":"Concurrency","anchor":"Concurrency","level":2},{"type":"paragraph","inlineContent":[{"text":"IvorMIDI2 is built for Swift 6 strict concurrency. Every concrete public type","type":"text"},{"text":" ","type":"text"},{"text":"is a ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":" value type, so instances can be freely shared across tasks and","type":"text"},{"text":" ","type":"text"},{"text":"actor boundaries. A ","type":"text"},{"identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2MessageReader","type":"reference","isActive":true},{"text":" holds the state of one stream, so","type":"text"},{"text":" ","type":"text"},{"text":"give each stream a reader of its own.","type":"text"}]}]}],"metadata":{"role":"article","roleHeading":"Article","modules":[{"name":"IvorMIDI2"}],"title":"Using IvorMIDI2"},"hierarchy":{"paths":[["doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/UsingIvorMIDI2"},"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormidi2\/usingivormidi2"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"references":{"doc://IvorMIDI2/documentation/IvorMIDI2/MIDI2MessageReader/finish()":{"abstract":[{"type":"text","text":"Ends the stream, returning the packets of any incomplete messages as"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2Message\/unrecognized(_:)","isActive":true},{"type":"text","text":" messages and discarding the words of"},{"type":"text","text":" "},{"type":"text","text":"any incomplete packet."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"finish"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"MIDI2Message","preciseIdentifier":"s:9IvorMIDI20B7MessageO"},{"kind":"text","text":"]"}],"identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2MessageReader\/finish()","kind":"symbol","role":"symbol","type":"topic","title":"finish()","url":"\/documentation\/ivormidi2\/midi2messagereader\/finish()"},"doc://IvorMIDI2/documentation/IvorMIDI2/MIDI2StreamMessage":{"role":"symbol","title":"MIDI2StreamMessage","abstract":[{"type":"text","text":"A UMP stream message (message type 0xF), addressed to a UMP endpoint as a"},{"type":"text","text":" "},{"type":"text","text":"whole."}],"navigatorTitle":[{"kind":"identifier","text":"MIDI2StreamMessage"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2StreamMessage","url":"\/documentation\/ivormidi2\/midi2streammessage","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MIDI2StreamMessage","kind":"identifier"}]},"doc://IvorMIDI2/documentation/IvorMIDI2/MIDI2ChannelMessage":{"role":"symbol","title":"MIDI2ChannelMessage","abstract":[{"type":"text","text":"A MIDI 2.0 channel voice message (message type 0x4)."}],"navigatorTitle":[{"kind":"identifier","text":"MIDI2ChannelMessage"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2ChannelMessage","url":"\/documentation\/ivormidi2\/midi2channelmessage","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MIDI2ChannelMessage"}]},"doc://IvorMIDI2/documentation/IvorMIDI2/MIDI2Packet/init(words:)":{"abstract":[{"type":"text","text":"Creates a "},{"code":"MIDI2Packet","type":"codeVoice"},{"type":"text","text":" instance from the provided words, or "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" if"},{"type":"text","text":" "},{"type":"text","text":"their number does not match the size of the message type in the first"},{"type":"text","text":" "},{"type":"text","text":"word."}],"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"?("},{"kind":"externalParam","text":"words"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Collection","preciseIdentifier":"s:Sl"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Word","preciseIdentifier":"s:9IvorMIDI20B6PacketV4Worda"},{"kind":"text","text":">)"}],"identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2Packet\/init(words:)","kind":"symbol","role":"symbol","type":"topic","title":"init(words:)","url":"\/documentation\/ivormidi2\/midi2packet\/init(words:)"},"doc://IvorMIDI2/documentation/IvorMIDI2/MIDI2MessageReader":{"abstract":[{"text":"A reader of the messages in a stream of Universal MIDI Packets.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MIDI2MessageReader"}],"url":"\/documentation\/ivormidi2\/midi2messagereader","type":"topic","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2MessageReader","role":"symbol","title":"MIDI2MessageReader","navigatorTitle":[{"kind":"identifier","text":"MIDI2MessageReader"}],"kind":"symbol"},"doc://IvorMIDI2/documentation/IvorMIDI2/MIDI2Packet/group":{"abstract":[{"type":"text","text":"The packet’s group, or "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" if its message type has no group"},{"type":"text","text":" "},{"type":"text","text":"(utility messages, type 0x0, and UMP stream messages, type 0xF)."}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text"