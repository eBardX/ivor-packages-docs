{"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"article","abstract":[{"type":"text","text":"Carry MIDI 1.0 and MIDI 2.0 messages in Universal MIDI Packets, and read them"},{"type":"text","text":" "},{"type":"text","text":"back from a stream of words."}],"sections":[],"metadata":{"roleHeading":"Article","modules":[{"name":"IvorMIDI2"}],"role":"article","title":"Using IvorMIDI2"},"hierarchy":{"paths":[["doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2"]]},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A Universal MIDI Packet (UMP) is one to four 32-bit words. The most"},{"type":"text","text":" "},{"type":"text","text":"significant 4 bits of its first word are its message type, which fixes the"},{"type":"text","text":" "},{"type":"text","text":"packet’s size and the family of message it carries:"}]},{"type":"table","header":"row","alignments":["left","left","left","left"],"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Message type"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Family"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Type"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Grouped"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"0x0"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Utility"}]}],[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2UtilityMessage","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"No"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"0x1","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"System common and real-time"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"MIDISystemMessage"},{"type":"text","text":" (IvorMIDI)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Yes"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"0x2"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"MIDI 1.0 channel voice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"MIDIChannelMessage"},{"type":"text","text":" (IvorMIDI)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Yes"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"0x3"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"7-bit system exclusive"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"MIDISystemMessage"},{"text":" (IvorMIDI)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Yes","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"0x4","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"MIDI 2.0 channel voice","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2ChannelMessage"}]}],[{"type":"paragraph","inlineContent":[{"text":"Yes","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"0x5","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"System Exclusive 8","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2SystemExclusive8Message"}]}],[{"inlineContent":[{"type":"text","text":"Yes"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"0xD"}]}],[{"type":"paragraph","inlineContent":[{"text":"Flex Data","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2FlexDataMessage","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"text":"Yes","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"0xF","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"UMP stream"}]}],[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2StreamMessage","type":"reference","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"No"}]}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A grouped message travels in one of 16 groups, each with 16 channels of its"},{"type":"text","text":" "},{"type":"text","text":"own. A groupless message addresses the UMP endpoint as a whole."},{"type":"text","text":" "},{"identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2Message","type":"reference","isActive":true},{"type":"text","text":" wraps a message of any family, together with its group, and"},{"type":"text","text":" "},{"identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2MessageReader","type":"reference","isActive":true},{"type":"text","text":" turns a stream of words into them."}]},{"type":"heading","text":"Packets and groups","level":2,"anchor":"Packets-and-groups"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2Packet","isActive":true},{"type":"text","text":" holds exactly as many words as its message type requires;"},{"type":"text","text":" "},{"identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2Packet\/init(words:)","type":"reference","isActive":true},{"type":"text","text":" returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" for any other number."},{"type":"text","text":" "},{"identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2Packet\/wordCount(forUniversalMIDIPacket:)","type":"reference","isActive":true},{"type":"text","text":" reads that number from a"},{"type":"text","text":" "},{"type":"text","text":"first word — including for the reserved message types, so a reader can skip"},{"type":"text","text":" "},{"type":"text","text":"packets it doesn’t understand."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2Group","type":"reference","isActive":true},{"type":"text","text":" numbers the groups from 1 to 16, as the MIDI 2.0"},{"type":"text","text":" "},{"type":"text","text":"specifications do; a packet stores them zero-based. Like the IvorMIDI data"},{"type":"text","text":" "},{"type":"text","text":"values, it can be written as an integer literal."},{"type":"text","text":" "},{"identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2Packet\/group","type":"reference","isActive":true},{"type":"text","text":" is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" for a groupless packet."}]},{"text":"Converting messages","anchor":"Converting-messages","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Grouped message types adopt "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2PacketsConvertible"},{"type":"text","text":", which converts a"},{"type":"text","text":" "},{"type":"text","text":"message to packets in a group, and back:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let noteOn  = MIDIChannelMessage.noteOn(1, 60, 100)","let packets = noteOn.packets(group: 2)","","MIDIChannelMessage(packets: packets!) == noteOn     \/\/ true","packets?.first?.group                               \/\/ 2"]},{"inlineContent":[{"type":"text","text":"The group defaults to 1. A packet carries its group, so the decoding"},{"type":"text","text":" "},{"type":"text","text":"initializers don’t take one; read it from the first packet’s"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2Packet\/group"},{"type":"text","text":". Groupless message types adopt"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2GrouplessPacketsConvertible"},{"type":"text","text":" instead, whose "},{"code":"packets()","type":"codeVoice"},{"type":"text","text":" takes no group."},{"type":"text","text":" "},{"type":"text","text":"Either way, decoding returns "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" unless the packets encode exactly one valid"},{"type":"text","text":" "},{"type":"text","text":"message, and encoding returns "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" for a message that cannot be encoded."},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2Message","isActive":true},{"type":"text","text":" converts a message of any family the same way."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"A MIDI 1.0 channel voice message always fits in one packet, so","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"MIDIChannelMessage"},{"text":" also has the single-packet ","type":"text"},{"code":"packet(group:)","type":"codeVoice"},{"type":"text","text":" and"},{"type":"text","text":" "},{"code":"init?(packet:)","type":"codeVoice"},{"type":"text","text":"."}]},{"level":2,"type":"heading","text":"MIDI 1.0 messages in packets","anchor":"MIDI-10-messages-in-packets"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The IvorMIDI message types travel unchanged in packets, as CoreMIDI’s event"},{"type":"text","text":" "},{"type":"text","text":"lists carry them. A channel voice message, or a system common or real-time"},{"type":"text","text":" "},{"type":"text","text":"message, is one single-word packet. A system exclusive message is one two-word"},{"type":"text","text":" "},{"type":"text","text":"packet for every 6 data bytes, without the 0xF0 and 0xF7 bytes that frame it"},{"type":"text","text":" "},{"type":"text","text":"on a MIDI 1.0 byte stream:"}]},{"code":["let sysEx   = MIDISystemMessage.systemExclusive([0x7e, 0x7f, 0x09, 0x01, 0xf7])","let packets = sysEx.packets()       \/\/ words: [0x30047E7F, 0x09010000]"],"type":"codeListing","syntax":"swift"},{"level":2,"type":"heading","text":"MIDI 2.0 channel voice messages","anchor":"MIDI-20-channel-voice-messages"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2ChannelMessage","type":"reference","isActive":true},{"type":"text","text":" is a two-word packet with more resolution than its"},{"type":"text","text":" "},{"type":"text","text":"MIDI 1.0 counterpart: 16-bit velocities, and 32-bit controller, pressure, and"},{"type":"text","text":" "},{"type":"text","text":"pitch bend values. It adds per-note controllers, per-note pitch bend, and"},{"type":"text","text":" "},{"type":"text","text":"per-note management, and it replaces MIDI 1.0’s control change sequences for"},{"type":"text","text":" "},{"type":"text","text":"registered and non-registered parameters and bank selection with single"},{"type":"text","text":" "},{"type":"text","text":"messages:"}]},{"code":["\/\/ Middle C at full velocity, tuned to 60.5 semitones by its pitch attribute.","let noteOn = MIDI2ChannelMessage.noteOn(1, 60, 0xffff, .pitch(60 << 9 | 256))","","\/\/ Program 25 in bank 121:1, in one message.","let program = MIDI2ChannelMessage.programChange(1, 25, MIDIData2Value(msb: 121, lsb: 1))","","\/\/ Pitch bend sensitivity of 2 semitones (in the top 7 bits), in one message.","let bendRange = MIDI2ChannelMessage.registeredController(1, .pitchBendSensitivity, 2 << 25)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A note on or note off may carry a "},{"identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2NoteAttribute","type":"reference","isActive":true},{"type":"text","text":": a pitch, as a Q7.9"},{"type":"text","text":" "},{"type":"text","text":"fixed-point number of semitones, or data whose meaning a manufacturer or a"},{"type":"text","text":" "},{"type":"text","text":"MIDI-CI profile determines. Unlike MIDI 1.0, a note on with a velocity of zero"},{"type":"text","text":" "},{"type":"text","text":"is not a note off. A device that uses MIDI 2.0 channel voice messages in a"},{"type":"text","text":" "},{"type":"text","text":"group must not use MIDI 1.0 channel voice messages in the same group."}]},{"level":2,"type":"heading","text":"Other MIDI 2.0 messages","anchor":"Other-MIDI-20-messages"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2SystemExclusive8Message"},{"type":"text","text":" carries system exclusive data whose bytes"},{"type":"text","text":" "},{"type":"text","text":"may use all 8 bits, up to 13 bytes per four-word packet. Its stream ID lets a"},{"type":"text","text":" "},{"type":"text","text":"sender interleave several messages. System Exclusive 8 messages cannot be"},{"type":"text","text":" "},{"type":"text","text":"translated to MIDI 1.0 byte streams."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2FlexDataMessage"},{"type":"text","text":" carries tempo, time signature, metronome, key"},{"type":"text","text":" "},{"type":"text","text":"signature, and chord name events, and metadata and performance text such as"},{"type":"text","text":" "},{"type":"text","text":"a song’s name or a lyric. Each is addressed to a channel of its group, or to"},{"type":"text","text":" "},{"type":"text","text":"the group as a whole; text spans up to 32 packets."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2StreamMessage"},{"type":"text","text":" discovers a UMP endpoint and its function blocks,"},{"type":"text","text":" "},{"type":"text","text":"selects the protocol and jitter reduction timestamps of a stream, and marks"},{"type":"text","text":" "},{"type":"text","text":"the start and end of a MIDI Clip File’s sequence data."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2UtilityMessage"},{"type":"text","text":" marks time for the messages that follow it: jitter"},{"type":"text","text":" "},{"type":"text","text":"reduction clocks and timestamps, and the delta clockstamps of a MIDI Clip"},{"type":"text","text":" "},{"type":"text","text":"File."}],"type":"paragraph"}]}]},{"code":["let tempo    = MIDI2FlexDataMessage.setTempo(50_000_000)     \/\/ 120 BPM, in 10 ns units","let title    = MIDI2FlexDataMessage.metadataText(.group, .compositionName, \"Cooley’s\")","let discover = MIDI2StreamMessage.endpointDiscovery(umpVersionMajor: 1,","                                                    umpVersionMinor: 1,","                                                    filter: [.endpointInfo, .endpointName])"],"type":"codeListing","syntax":"swift"},{"level":2,"type":"heading","text":"Reading a stream","anchor":"Reading-a-stream"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2MessageReader","type":"reference","isActive":true},{"type":"text","text":" splits a stream of words into packets, reassembles"},{"type":"text","text":" "},{"type":"text","text":"messages that span several packets, and returns each message once its last"},{"type":"text","text":" "},{"type":"text","text":"packet arrives. Words may arrive in any grouping: the reader keeps the words"},{"type":"text","text":" "},{"type":"text","text":"of an incomplete packet until the rest arrive."}]},{"code":["var reader = MIDI2MessageReader()","","for words in received {","    for message in reader.read(words: words) {","        handle(message)","    }","}","","for message in reader.finish() {    \/\/ the packets of any incomplete message","    handle(message)","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The reader follows the UMP specification’s rules for interleaving. Within a"},{"type":"text","text":" "},{"type":"text","text":"group, a 7-bit system exclusive or Flex Data message may be interleaved only"},{"type":"text","text":" "},{"type":"text","text":"with system real-time messages and groupless messages such as jitter reduction"},{"type":"text","text":" "},{"type":"text","text":"clocks; any other packet in the group interrupts it. System Exclusive 8"},{"type":"text","text":" "},{"type":"text","text":"messages may be interleaved with anything, including each other when their"},{"type":"text","text":" "},{"type":"text","text":"stream IDs differ. A UMP stream message that spans several packets is"},{"type":"text","text":" "},{"type":"text","text":"interrupted by any other UMP stream message."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A message that is interrupted, or whose packets do not decode, comes back"},{"type":"text","text":" "},{"type":"text","text":"packet by packet as "},{"identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2Message\/unrecognized(_:)","type":"reference","isActive":true},{"type":"text","text":", as does a packet of a"},{"type":"text","text":" "},{"type":"text","text":"reserved message type. "},{"identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2MessageReader\/finish()","type":"reference","isActive":true},{"type":"text","text":" returns the packets of"},{"type":"text","text":" "},{"type":"text","text":"any message still incomplete at the end of the stream the same way, and readies"},{"type":"text","text":" "},{"type":"text","text":"the reader for a new stream."}]},{"level":2,"type":"heading","text":"Error handling","anchor":"Error-handling"},{"type":"paragraph","inlineContent":[{"type":"text","text":"IvorMIDI2 throws no errors. Decoding returns "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" for packets that do not"},{"type":"text","text":" "},{"type":"text","text":"encode exactly one valid message, encoding returns "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" for a message that"},{"type":"text","text":" "},{"type":"text","text":"cannot be encoded, and "},{"identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2MessageReader","type":"reference","isActive":true},{"type":"text","text":" reports what it cannot decode as"},{"type":"text","text":" "},{"identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2Message\/unrecognized(_:)","type":"reference","isActive":true},{"type":"text","text":" messages rather than failing."}]},{"level":2,"type":"heading","text":"Concurrency","anchor":"Concurrency"},{"type":"paragraph","inlineContent":[{"type":"text","text":"IvorMIDI2 is built for Swift 6 strict concurrency. Every concrete public type"},{"type":"text","text":" "},{"type":"text","text":"is a "},{"code":"Sendable","type":"codeVoice"},{"type":"text","text":" value type, so instances can be freely shared across tasks and"},{"type":"text","text":" "},{"type":"text","text":"actor boundaries. A "},{"identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2MessageReader","type":"reference","isActive":true},{"type":"text","text":" holds the state of one stream, so"},{"type":"text","text":" "},{"type":"text","text":"give each stream a reader of its own."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormidi2\/usingivormidi2"]}],"identifier":{"url":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/UsingIvorMIDI2","interfaceLanguage":"swift"},"references":{"doc://IvorMIDI2/documentation/IvorMIDI2/MIDI2PacketsConvertible":{"role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MIDI2PacketsConvertible","kind":"identifier"}],"navigatorTitle":[{"text":"MIDI2PacketsConvertible","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormidi2\/midi2packetsconvertible","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2PacketsConvertible","abstract":[{"type":"text","text":"A type that can be converted to and from the Universal MIDI Packets that"},{"type":"text","text":" "},{"type":"text","text":"encode it in a group."}],"title":"MIDI2PacketsConvertible","kind":"symbol"},"doc://IvorMIDI2/documentation/IvorMIDI2/MIDI2ChannelMessage":{"role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MIDI2ChannelMessage","kind":"identifier"}],"navigatorTitle":[{"text":"MIDI2ChannelMessage","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormidi2\/midi2channelmessage","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2ChannelMessage","abstract":[{"type":"text","text":"A MIDI 2.0 channel voice message (message type 0x4)."}],"title":"MIDI2ChannelMessage","kind":"symbol"},"doc://IvorMIDI2/documentation/IvorMIDI2/MIDI2MessageReader":{"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MIDI2MessageReader","kind":"identifier"}],"navigatorTitle":[{"text":"MIDI2MessageReader","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormidi2\/midi2messagereader","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2MessageReader","abstract":[{"type":"text","text":"A reader of the messages in a stream of Universal MIDI Packets."}],"title":"MIDI2MessageReader","kind":"symbol"},"doc://IvorMIDI2/documentation/IvorMIDI2/MIDI2UtilityMessage":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MIDI2UtilityMessage"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"MIDI2UtilityMessage"}],"kind":"symbol","abstract":[{"text":"A Universal MIDI Packet utility message (message type 0x0).","type":"text"}],"url":"\/documentation\/ivormidi2\/midi2utilitymessage","role":"s