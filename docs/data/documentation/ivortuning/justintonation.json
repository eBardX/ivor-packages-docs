{"hierarchy":{"paths":[["doc:\/\/IvorTuning\/documentation\/IvorTuning"]]},"abstract":[{"text":"A tuning system based on just intonation, using exact integer frequency ratios.","type":"text"}],"topicSections":[{"identifiers":["doc:\/\/IvorTuning\/documentation\/IvorTuning\/JustIntonation\/init(ratios:equivalenceRatio:)"],"anchor":"Initializers","generated":true,"title":"Initializers"},{"identifiers":["doc:\/\/IvorTuning\/documentation\/IvorTuning\/JustIntonation\/equivalenceRatio","doc:\/\/IvorTuning\/documentation\/IvorTuning\/JustIntonation\/ratios"],"anchor":"Instance-Properties","generated":true,"title":"Instance Properties"},{"identifiers":["doc:\/\/IvorTuning\/documentation\/IvorTuning\/JustIntonation\/Equatable-Implementations","doc:\/\/IvorTuning\/documentation\/IvorTuning\/JustIntonation\/TuningSystem-Implementations"],"anchor":"Default-Implementations","generated":true,"title":"Default Implementations"}],"relationshipsSections":[{"identifiers":["doc:\/\/IvorTuning\/s8CopyableP","doc:\/\/IvorTuning\/SQ","doc:\/\/IvorTuning\/s9EscapableP","doc:\/\/IvorTuning\/s8SendableP","doc:\/\/IvorTuning\/s16SendableMetatypeP","doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem"],"kind":"relationships","type":"conformsTo","title":"Conforms To"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"JustIntonation","kind":"identifier"}],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"text":"A just intonation system is defined by a set of frequency ratios relative to the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"tonic, each derived from small-integer harmonics. Any number of tones per interval of"},{"type":"text","text":" "},{"type":"text","text":"equivalence is supported — from a simple pentatonic to Harry Partch’s 43-tone 11-limit scale."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"On initialisation, ratios outside "},{"type":"codeVoice","code":"[1, equivalenceRatio)"},{"type":"text","text":" are reduced by dividing by"},{"type":"text","text":" "},{"type":"codeVoice","code":"equivalenceRatio"},{"type":"text","text":" until they fall in range; exact multiples of "},{"type":"codeVoice","code":"equivalenceRatio"},{"type":"text","text":" "},{"type":"text","text":"(including 1:1) are silently discarded. The remaining ratios are deduplicated and sorted"},{"type":"text","text":" "},{"type":"text","text":"ascending."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/JustIntonation\/ratios","isActive":true,"type":"reference"},{"type":"text","text":" property prepends the tonic (1:1) and appends the interval of equivalence,"},{"text":" ","type":"text"},{"type":"text","text":"so it always spans one complete interval of equivalence."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Does not support standard pitch notation. Just intonation systems are too variable"},{"type":"text","text":" "},{"type":"text","text":"to map reliably to the 35 pitch classes of standard notation: even 5-limit scales"},{"type":"text","text":" "},{"type":"text","text":"contain enharmonic pairs that are distinct in just intonation but share a single"},{"type":"text","text":" "},{"text":"spelling, and higher-limit systems diverge further or exceed the 35-pitch-class maximum.","type":"text"}]}]}],"metadata":{"modules":[{"name":"IvorTuning"}],"title":"JustIntonation","roleHeading":"Structure","externalID":"s:10IvorTuning14JustIntonationV","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"JustIntonation","kind":"identifier"}],"navigatorTitle":[{"text":"JustIntonation","kind":"identifier"}],"role":"symbol","symbolKind":"struct"},"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"url":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/JustIntonation","interfaceLanguage":"swift"},"sections":[],"kind":"symbol","variants":[{"paths":["\/documentation\/ivortuning\/justintonation"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://IvorTuning/s8CopyableP":{"type":"unresolvable","identifier":"doc:\/\/IvorTuning\/s8CopyableP","title":"Swift.Copyable"},"doc://IvorTuning/documentation/IvorTuning/JustIntonation/TuningSystem-Implementations":{"url":"\/documentation\/ivortuning\/justintonation\/tuningsystem-implementations","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/JustIntonation\/TuningSystem-Implementations","title":"TuningSystem Implementations","kind":"article","role":"collectionGroup","abstract":[],"type":"topic"},"doc://IvorTuning/documentation/IvorTuning/JustIntonation/Equatable-Implementations":{"url":"\/documentation\/ivortuning\/justintonation\/equatable-implementations","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/JustIntonation\/Equatable-Implementations","title":"Equatable Implementations","kind":"article","role":"collectionGroup","abstract":[],"type":"topic"},"doc://IvorTuning/s9EscapableP":{"type":"unresolvable","title":"Swift.Escapable","identifier":"doc:\/\/IvorTuning\/s9EscapableP"},"doc://IvorTuning/documentation/IvorTuning/JustIntonation/equivalenceRatio":{"abstract":[{"type":"text","text":"The interval of equivalence. Defaults to "},{"type":"codeVoice","code":".octave"},{"type":"text","text":" (2:1)."}],"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/JustIntonation\/equivalenceRatio","kind":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"equivalenceRatio"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:10IvorTuning5RatioV","text":"Ratio"}],"title":"equivalenceRatio","type":"topic","url":"\/documentation\/ivortuning\/justintonation\/equivalenceratio","role":"symbol"},"