{"identifier":{"url":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/JustIntonation","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"navigatorTitle":[{"kind":"identifier","text":"JustIntonation"}],"symbolKind":"struct","title":"JustIntonation","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"JustIntonation"}],"externalID":"s:10IvorTuning14JustIntonationV","modules":[{"name":"IvorTuning"}],"role":"symbol","roleHeading":"Structure"},"hierarchy":{"paths":[["doc:\/\/IvorTuning\/documentation\/IvorTuning"]]},"abstract":[{"text":"A tuning system based on just intonation, using exact integer frequency ratios.","type":"text"}],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"JustIntonation","kind":"identifier"}],"languages":["swift"]}]},{"content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"A just intonation system is defined by a set of frequency ratios relative to the","type":"text"},{"text":" ","type":"text"},{"text":"tonic, each derived from small-integer harmonics. Any number of tones per interval of","type":"text"},{"text":" ","type":"text"},{"text":"equivalence is supported — from a simple pentatonic to Harry Partch’s 43-tone 11-limit scale.","type":"text"}]},{"inlineContent":[{"type":"text","text":"On initialization, ratios outside "},{"type":"codeVoice","code":"[1, equivalenceRatio)"},{"type":"text","text":" are reduced by dividing by"},{"type":"text","text":" "},{"type":"codeVoice","code":"equivalenceRatio"},{"type":"text","text":" until they fall in range; exact multiples of "},{"type":"codeVoice","code":"equivalenceRatio"},{"type":"text","text":" "},{"type":"text","text":"(including 1:1) are silently discarded. The remaining ratios are deduplicated and sorted"},{"type":"text","text":" "},{"type":"text","text":"ascending."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/JustIntonation\/ratios","isActive":true,"type":"reference"},{"text":" property prepends the tonic (1:1) and appends the interval of equivalence,","type":"text"},{"text":" ","type":"text"},{"text":"so it always spans one complete interval of equivalence.","type":"text"}]},{"inlineContent":[{"type":"text","text":"Does not support standard pitch notation. Just intonation systems are too variable"},{"type":"text","text":" "},{"type":"text","text":"to map reliably to the 35 pitch classes of standard notation: even 5-limit scales"},{"type":"text","text":" "},{"type":"text","text":"contain enharmonic pairs that are distinct in just intonation but share a single"},{"type":"text","text":" "},{"type":"text","text":"spelling, and higher-limit systems diverge further or exceed the 35-pitch-class maximum."}],"type":"paragraph"}],"kind":"content"}],"topicSections":[{"generated":true,"identifiers":["doc:\/\/IvorTuning\/documentation\/IvorTuning\/JustIntonation\/init(ratios:equivalenceRatio:)"],"anchor":"Initializers","title":"Initializers"},{"generated":true,"identifiers":["doc:\/\/IvorTuning\/documentation\/IvorTuning\/JustIntonation\/equivalenceRatio","doc:\/\/IvorTuning\/documentation\/IvorTuning\/JustIntonation\/ratios"],"anchor":"Instance-Properties","title":"Instance Properties"},{"generated":true,"identifiers":["doc:\/\/IvorTuning\/documentation\/IvorTuning\/JustIntonation\/Equatable-Implementations","doc:\/\/IvorTuning\/documentation\/IvorTuning\/JustIntonation\/TuningSystem-Implementations"],"anchor":"Default-Implementations","title":"Default Implementations"}],"variants":[{"paths":["\/documentation\/ivortuning\/justintonation"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/IvorTunin