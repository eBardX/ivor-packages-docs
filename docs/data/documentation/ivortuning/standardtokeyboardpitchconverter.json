{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/StandardToKeyboardPitchConverter"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"StandardToKeyboardPitchConverter"}]}]},{"mentions":["doc:\/\/IvorTuning\/documentation\/IvorTuning\/UsingIvorTuning"],"kind":"mentions"},{"kind":"content","content":[{"anchor":"overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Conversion is acoustic: the converter realizes each pitch as a frequency using the tuning system"},{"type":"text","text":" "},{"type":"text","text":"and pitch standard, then picks the key of the layout that sounds nearest. The keys are tuned by"},{"type":"text","text":" "},{"text":"the same tuning system and pitch standard, so the pitch standard tunes the keyboard rather than","type":"text"},{"text":" ","type":"text"},{"text":"transposing it: with ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/PitchStandard\/a415"},{"type":"text","text":", A4 still converts to 69, and key 69 sounds 415 Hz."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"With the default configuration — "},{"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/KeyboardLayout\/piano","type":"reference","isActive":true},{"type":"text","text":", 12-tone equal temperament, and"},{"type":"text","text":" "},{"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/PitchStandard\/a440","type":"reference","isActive":true},{"type":"text","text":" — this matches the usual piano key assignments, so B♯3 and C4 both"},{"type":"text","text":" "},{"type":"text","text":"convert to 60, and C♭4 to 59. With other tuning systems, a pitch may convert to a key other"},{"type":"text","text":" "},{"type":"text","text":"than the one its spelling suggests: in quarter-comma meantone, B𝄪3 sounds about 45 cents above"},{"type":"text","text":" "},{"type":"text","text":"C4 — nearer the C key than the C♯ key — so it converts to 60, not 61."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When a pitch lies equally near two keys of a pitch-class layout, it converts to the key whose"},{"type":"text","text":" "},{"type":"text","text":"spelling shares its letter; otherwise, to the lower key."}]}]}],"variants":[{"paths":["\/documentation\/ivortuning\/standardtokeyboardpitchconverter"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"symbolKind":"struct","modules":[{"name":"IvorTuning"}],"navigatorTitle":[{"kind":"identifier","text":"StandardToKeyboardPitchConverter"}],"externalID":"s:10IvorTuning32StandardToKeyboardPitchConverterV","role":"symbol","title":"StandardToKeyboardPitchConverter","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"StandardToKeyboardPitchConverter"}],"roleHeading":"Structure"},"kind":"symbol","sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"topicSections":[{"title":"Initializers","identifiers":["doc:\/\/IvorTuning\/documentation\/IvorTuning\/StandardToKeyboardPitchConverter\/init()","doc:\/\/IvorTuning\/documentation\/IvorTuning\/StandardToKeyboardPitchConverter\/init(keyboardLayout:tuningSystem:pitchStandard:keyMatching:)"],"generated":true,"anchor":"Initializers"},{"title":"Default Implementations","identifiers":["doc:\/\/IvorTuning\/documentation\/IvorTuning\/StandardToKeyboardPitchConverter\/Equatable-Implementations","doc:\/\/IvorTuning\/documentation\/IvorTuning\/StandardToKeyboardPitchConverter\/PitchConverter-Implementations"],"generated":true,"anchor":"Default-Implementations"}],"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/IvorTuning\/documentation\/IvorTuning\/PitchConverter","doc:\/\/IvorTuning\/s8CopyableP","doc:\/\/IvorTuning\/SQ",