{"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"seeAlsoSections":[{"identifiers":["doc:\/\/IvorTuning\/documentation\/IvorTuning\/PitchConverter","doc:\/\/IvorTuning\/documentation\/IvorTuning\/StandardToAbsolutePitchConverter","doc:\/\/IvorTuning\/documentation\/IvorTuning\/AbsoluteToKeyboardPitchConverter","doc:\/\/IvorTuning\/documentation\/IvorTuning\/KeyboardToAbsolutePitchConverter","doc:\/\/IvorTuning\/documentation\/IvorTuning\/KeyboardToStandardPitchConverter","doc:\/\/IvorTuning\/documentation\/IvorTuning\/AbsoluteToStandardPitchConverter"],"generated":true,"title":"Converting between notations","anchor":"Converting-between-notations"}],"variants":[{"paths":["\/documentation\/ivortuning\/standardtokeyboardpitchconverter"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/IvorTuning\/documentation\/IvorTuning"]]},"abstract":[{"type":"text","text":"A converter from standard notation pitches ("},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/Pitch"},{"type":"text","text":") to MIDI note numbers ("},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/NoteNumber"},{"type":"text","text":"),"},{"text":" ","type":"text"},{"text":"using a keyboard layout, tuning system, and pitch standard.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/StandardToKeyboardPitchConverter"},"relationshipsSections":[{"kind":"relationships","type":"conformsTo","identifiers":["doc:\/\/IvorTuning\/documentation\/IvorTuning\/PitchConverter","doc:\/\/IvorTuning\/s8CopyableP","doc:\/\/IvorTuning\/SQ","doc:\/\/IvorTuning\/s9EscapableP","doc:\/\/IvorTuning\/s8SendableP","doc:\/\/IvorTuning\/s16SendableMetatypeP"],"title":"Conforms To"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"StandardToKeyboardPitchConverter"}]}],"kind":"declarations"},{"mentions":["doc:\/\/IvorTuning\/documentation\/IvorTuning\/UsingIvorTuning"],"kind":"mentions"},{"content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Conversion is acoustic: the converter realizes each pitch as a frequency using the tuning system"},{"type":"text","text":" "},{"type":"text","text":"and pitch standard, then picks the key of the layout that sounds nearest. The keys are tuned by"},{"type":"text","text":" "},{"type":"text","text":"the same tuning system and pitch standard, so the pitch standard tunes the keyboard rather than"},{"type":"text","text":" "},{"type":"text","text":"transposing it: with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/PitchStandard\/a415"},{"type":"text","text":", A4 still converts to 69, and key 69 sounds 415 Hz."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"With the default configuration — "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/KeyboardLayout\/piano"},{"type":"text","text":", 12-tone equal temperament, and"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/PitchStandard\/a440"},{"type":"text","text":" — this matches the usual piano key assignments, so B♯3 and C4 both"},{"type":"text","text":" "},{"type":"text","text":"convert to 60, and C♭4 to 59. With other tuning systems, a pitch may convert to a key other"},{"type":"text","text":" "},{"type":"text","text":"than the one its spelling suggests: in quarter-comma meantone, B𝄪3 sounds about 45 cents above"},{"type":"text","text":" "},{"type":"text","text":"C4 — nearer the C key than the C♯ key — so it converts to 60, not 61."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"When a pitch lies equally near two keys of a pitch-class layout, it converts to the key whose"},{"type":"text","text":" "},{"type":"text","text":"spelling shares its letter; otherwise, to the lower key."}],"type":"paragraph"}],"kind":"content"}],"metadata":{"externalID":"s:10IvorTuning32StandardToKeyboardPitchConverterV","symbolKind":"struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"StandardToKeyboardPitchConverter","kind":"identifier"}],"navigatorTitle":[{"text":"StandardToKeyboardPitchConverter","kind":"identifier"}],"modules":[{"name":"IvorTuning"}],"role":"symbol","title":"StandardToKeyboardPitchConverter","roleHeading":"Structure"},"topicSections":[{"generated":true,"identifiers":["doc:\/\/IvorTuning\/documentation\/IvorTuning\/StandardToKeyboardPitchConverter\/init()","doc:\/\/IvorTuning\/documentation\/IvorTuning\/StandardToKeyboardPitchConverter\/init(keyboardLayout:tuningSystem:pitchStandard:keyMatching:)"],"anchor":"Initializers","title":"Initializers"},{"generated":true,"identifiers":["doc:\/\/IvorTuning\/documentation\/IvorTuning\/StandardToKeyboardPitchConverter\/Equatable-Implementations","doc:\/\/IvorTuning\/documentation\/IvorTuning\/StandardToKeyboardPitchConverter\/PitchConverter-Implementations"],"anchor":"Default-Implementations","title":"Default Implementations"}],"kind":"symbol","references":{"doc://IvorTuning/documentation/IvorTuning/PitchConverter":{"kind":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"PitchConverter"}],"url":"\/documentation\/ivortuning\/pitchconverter","abstract":[{"text":"A type that converts pitches from one notation to another.","type":"text"}],"title":"PitchConverter","role":"symbol","navigatorTitle":[{"text":"PitchConverter","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/PitchConverter"},"doc://IvorTuning/documentation/IvorTuning/NoteNumber":{"kind":"symbol","identifier":"doc:\/\/IvorTuning\/docu