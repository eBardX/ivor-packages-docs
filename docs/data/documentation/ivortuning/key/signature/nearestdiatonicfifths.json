{"abstract":[{"text":"The number of sharps (when positive) or flats (when negative) of the diatonic signature","type":"text"},{"text":" ","type":"text"},{"text":"nearest this one.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/IvorTuning\/documentation\/IvorTuning","doc:\/\/IvorTuning\/documentation\/IvorTuning\/Key","doc:\/\/IvorTuning\/documentation\/IvorTuning\/Key\/Signature"]]},"metadata":{"extendedModule":"IvorTuning","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"nearestDiatonicFifths","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"roleHeading":"Instance Property","externalID":"s:10IvorTuning3KeyO9SignatureV21nearestDiatonicFifthsSivp","role":"symbol","modules":[{"name":"IvorTuning"}],"symbolKind":"property","title":"nearestDiatonicFifths"},"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"symbol","sections":[],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"text":"nearestDiatonicFifths","kind":"identifier"},{"kind":"text","text":": "},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"kind":"text","text":" { "},{"text":"get","kind":"keyword"},{"kind":"text","text":" }"}]}],"kind":"declarations"},{"content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is the diatonic signature that differs from this one in the fewest letters. Ties go"},{"type":"text","text":" "},{"type":"text","text":"to the one with fewer accidentals, then to the side this signature leans to (sharps when"},{"type":"text","text":" "},{"type":"text","text":"it has more sharps than flats, flats when it has more flats than sharps), then to sharps."},{"text":" ","type":"text"},{"text":"For example, ","type":"text"},{"code":"{F♯, G♯}","type":"codeVoice"},{"text":" differs in one letter from both one sharp and three sharps, and","type":"text"},{"text":" ","type":"text"},{"text":"its nearest is one sharp.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"MIDI can only express diatonic signatures, so this is what a custom key becomes in a MIDI","type":"text"},{"text":" ","type":"text"},{"text":"file.","type":"text"}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/ivortuning\/key\/signature\/nearestdiatonicfifths"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/Key\/Signature\/nearestDiatonicFifths"},"references":{"doc://IvorTuning/documentation/IvorTuning/Key/Signature":{"navigatorTitle":[{"text":"Signature","kind":"identifier"}],"type":"topic","role":"symbol","title":"Key.Signature","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/Key\/Signature","abstract":[{"text":"A custom key signature: one alteration per letter, each flat, natural or sharp, whose","type":"text"},{"text":" ","type":"text"},{"text":"seven pitch classes don’t form a diatonic collection.","type":"text"}],"url":"\/documentation\/ivortuning\/key\/signature","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Signature","kind":"identifier"}],"kind":"symbol"},"doc://IvorTuning/documentation/IvorTuning/Key":{"navigatorTitle":[{"kind":"identifier","text":"Key"}],"type":"topic","role":"symbol","title":"Key","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/Key","abstract":[{"type":"text","text":"A musical key: atonal, diatonic (with or without a known mode), or custom."}],"url":"\/documentation\/ivortuning\/key","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Key"}],"kind":"symbol"},"doc://IvorTuning/documentation/IvorTuning/Key/Signature/nearestDiatonicFifths":{"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/Key\/Signature\/nearestDiatonicFifths","kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"nearestDiatonicFifths","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"title":"nearestDiatonicFifths","abstract":[{"text":"The number of sharps (when positive) or flats (when negative) of the diatonic signature","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"nearest this one."}],"role":"symbol","type":"topic","url":"\/documentation\/ivortuning\/key\/signature\/nearestdiatonicfifths"},"doc://IvorTuning/documentation/IvorTuning":{"abstract":[{"text":"Musical pitch, interval, and tuning system types.","type":"text"}],"url":"\/documentation\/ivortuning","kind":"symbol","type":"topic","role":"collection","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning","title":"IvorTuning"}}}