xt":"","type":"text"},{"code":"true","type":"codeVoice"},{"text":" if ","type":"text"},{"code":"lhs","type":"codeVoice"},{"text":" comes before ","type":"text"},{"code":"rhs","type":"codeVoice"},{"text":"; otherwise, ","type":"text"},{"code":"false","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"Pitches are ordered by their notation: by octave, then by letter from C to B, then by"},{"type":"text","text":" "},{"type":"text","text":"accidental from double flat to double sharp. This is a consistent ordering for sorting,"},{"type":"text","text":" "},{"type":"text","text":"not a comparison of how high the pitches sound, which depends on the tuning system. For"},{"type":"text","text":" "},{"type":"text","text":"example, C𝄪4 comes before D♭4, although it sounds higher in equal temperament."}],"type":"paragraph"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/Pitch\/_(_:_:)"},"references":{"doc://IvorTuning/documentation/IvorTuning/Pitch/_(_:_:)":{"url":"\/documentation\/ivortuning\/pitch\/_(_:_:)","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Returns a Boolean value indicating whether the first pitch comes before the second."}],"title":"<(_:_:)","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"<"},{"kind":"text","text":" "},{"kind":"text","text":"(`Self`"},{"kind":"text","text":", `Self`"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"role":"symbol","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/Pitch\/_(_:_:)"},"doc://IvorTuning/documentation/IvorTuning":{"type":"topic","abstract":[{"text":"Musical pitch, interval, and tuning system types.","type":"text"}],"title":"IvorTuning","kind":"symbol","role":"collection","url":"\/documentation\/ivortuning","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning"},"doc://IvorTuning/documentation/IvorTuning/Pitch":{"url":"\/documentation\/ivortuning\/pitch","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"A musical pitch in scientific pitch notation (SPN), identified by pitch class and octave"},{"type":"text","text":" "},{"type":"text","text":"number. SPN is defined for tuning systems with a 2:1 octave as their interval of equivalence"},{"type":"text","text":" "},{"type":"text","text":"only; systems with a different interval of equivalence (e.g., Bohlen-Pierce) cannot be"},{"type":"text","text":" "},{"type":"text","text":"represented using standard pitch notation."}],"navigatorTitle":[{"kind":"identifier","text":"Pitch"}],"title":"Pitch","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"Pitch","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/Pitch"}}}