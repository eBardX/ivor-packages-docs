}]},{"content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Four fifths — C→G, G→D, D→A, and A→E — are each narrowed by 3\/16 of the syntonic","type":"text"},{"text":" ","type":"text"},{"text":"comma, equal to (3\/2)·(80\/81)^(3\/16) ≈ 697.923 cents. Four more fifths — E→B,","type":"text"},{"text":" ","type":"text"},{"text":"B→F♯, B♭→F, and F→C — are each narrowed by (¼ PC − 3\/16 SC) ≈ 1.833 cents,","type":"text"},{"text":" ","type":"text"},{"text":"equal to (3\/2)·(81\/80)^(3\/16)·(2¹⁹\/3¹²)^(−1\/4) ≈ 700.122 cents. The remaining","type":"text"},{"text":" ","type":"text"},{"text":"four fifths are pure (3:2). The circle closes exactly.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Published in ","type":"text"},{"inlineContent":[{"type":"text","text":"Philosophical Transactions of the Royal Society"}],"type":"emphasis"},{"text":" 90 (1800).","type":"text"}]}],"kind":"content"}],"references":{"doc://IvorTuning/documentation/IvorTuning/WellTemperament/youngI":{"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament\/youngI","abstract":[{"text":"Young I (Thomas Young, 1800).","type":"text"}],"title":"youngI","url":"\/documentation\/ivortuning\/welltemperament\/youngi","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"youngI","kind":"identifier"},{"text":": ","kind":"text"},{"text":"WellTemperament","kind":"typeIdentifier","preciseIdentifier":"s:10IvorTuning15WellTemperamentV"}],"kind":"symbol","role":"symbol","conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"constraints":[{"code":"Self","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"WellTemperament","type":"codeVoice"},{"text":".","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}]},"type":"topic"},"doc://IvorTuning/documentation/IvorTuning/WellTemperament":{"url":"\/documentation\/ivortuning\/welltemperament","role":"symbol","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WellTemperament","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament","navigatorTitle":[{"text":"WellTemperament","kind":"identifier"}],"abstract":[{"type":"text","text":"A tuning system in which all twelve keys are usable but have distinct tonal characters,"},{"type":"text","text":" "},{"type":"text","text":"achieved by distributing the Pythagorean comma unevenly around the circle of fifths."}],"title":"WellTemperament"},"doc://IvorTuning/documentation/IvorTuning":{"abstract":[{"text":"Musical pitch, interval, and tuning system types.","type":"text"}],"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning","url":"\/documentation\/ivortuning","title":"IvorTuning","kind":"symbol","role":"collection","type":"topic"}}}