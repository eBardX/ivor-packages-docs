 C→G, G→D, D→A, and B→F♯","type":"text"},{"text":" ","type":"text"},{"text":"— each equal to 2^(15\/4)\/9 ≈ 696.090 cents. The remaining eight fifths are pure","type":"text"},{"text":" ","type":"text"},{"text":"(3:2). The circle closes exactly.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"This is the most historically cited well temperament, often associated with","type":"text"},{"text":" ","type":"text"},{"text":"Bach’s Well-Tempered Clavier.","type":"text"}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivortuning\/welltemperament\/werckmeisteriii"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament\/werckmeisterIII"},"references":{"doc://IvorTuning/documentation/IvorTuning":{"abstract":[{"text":"Musical pitch, interval, and tuning system types.","type":"text"}],"url":"\/documentation\/ivortuning","kind":"symbol","type":"topic","role":"collection","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning","title":"IvorTuning"},"doc://IvorTuning/documentation/IvorTuning/WellTemperament/werckmeisterIII":{"abstract":[{"type":"text","text":"Werckmeister III (Andreas Werckmeister, 1691)."}],"url":"\/documentation\/ivortuning\/welltemperament\/werckmeisteriii","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"werckmeisterIII","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:10IvorTuning15WellTemperamentV","text":"WellTemperament","kind":"typeIdentifier"}],"kind":"symbol","type":"topic","role":"symbol","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament\/werckmeisterIII","title":"werckmeisterIII","conformance":{"constraints":[{"type":"codeVoice","code":"Self"},{"type":"text","text":" is "},{"type":"codeVoice","code":"WellTemperament"},{"type":"text","text":"."}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"availabilityPrefix":[{"type":"text","text":"Available when"}]}},"doc://IvorTuning/documentation/IvorTuning/WellTemperament":{"abstract":[{"text":"A tuning system in which all twelve keys are usable but have distinct tonal characters,","type":"text"},{"text":" ","type":"text"},{"text":"achieved by distributing the Pythagorean comma unevenly around the circle of fifths.","type":"text"}],"url":"\/documentation\/ivortuning\/welltemperament","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WellTemperament","kind":"identifier"}],"kind":"symbol","type":"topic","role":"symbol","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament","title":"WellTemperament","navigatorTitle":[{"text":"WellTemperament","kind":"identifier"}]}}}