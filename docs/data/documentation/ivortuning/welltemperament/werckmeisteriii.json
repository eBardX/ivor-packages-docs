{"kind":"text","text":" }"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Four fifths are narrowed by ¼ of the Pythagorean comma — C→G, G→D, D→A, and B→F♯"},{"type":"text","text":" "},{"type":"text","text":"— each equal to 2^(15\/4)\/9 ≈ 696.090 cents. The remaining eight fifths are pure"},{"type":"text","text":" "},{"type":"text","text":"(3:2). The circle closes exactly."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is the most historically cited well temperament, often associated with"},{"type":"text","text":" "},{"type":"text","text":"Bach’s Well-Tempered Clavier."}]}]}],"references":{"doc://IvorTuning/documentation/IvorTuning":{"abstract":[{"text":"Musical pitch, interval, and tuning system types.","type":"text"}],"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning","url":"\/documentation\/ivortuning","title":"IvorTuning","kind":"symbol","role":"collection","type":"topic"},"doc://IvorTuning/documentation/IvorTuning/WellTemperament/werckmeisterIII":{"abstract":[{"text":"Werckmeister III (Andreas Werckmeister, 1691).","type":"text"}],"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament\/werckmeisterIII","kind":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"werckmeisterIII","kind":"identifier"},{"text":": ","kind":"text"},{"text":"WellTemperament","preciseIdentifier":"s:10IvorTuning15WellTemperamentV","kind":"typeIdentifier"}],"title":"werckmeisterIII","type":"topic","conformance":{"constraints":[{"type":"codeVoice","code":"Self"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"WellTemperament"},{"text":".","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}]},"url":"\/documentation\/ivortuning\/welltemperament\/werckmeisteriii","role":"symbol"},"doc://IvorTuning/documentation/IvorTuning/WellTemperament":{"url":"\/documentation\/ivortuning\/welltemperament","role":"symbol","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WellTemperament","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament","navigatorTitle":[{"text":"WellTemperament","kind":"identifier"}],"abstract":[{"type":"text","text":"A tuning system in which all twelve keys are usable but have distinct tonal characters,"},{"type":"text","text":" "},{"type":"text","text":"achieved by distributing the Pythagorean comma unevenly around the circle of fifths."}],"title":"WellTemperament"}}}