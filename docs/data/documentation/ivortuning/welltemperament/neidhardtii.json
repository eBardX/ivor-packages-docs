{"sections":[],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament\/neidhardtII"},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"neidhardtII","kind":"identifier"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"WellTemperament","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament","preciseIdentifier":"s:10IvorTuning15WellTemperamentV"},{"kind":"text","text":" { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Three fifths — C→G, G→D, D→A — are each narrowed by ⅙ of the Pythagorean comma"},{"type":"text","text":" "},{"type":"text","text":"(≈ 698.045 cents). Six fifths — A→E, B→F♯, F♯→C♯, C♯→A♭, B♭→F, F→C — are each"},{"type":"text","text":" "},{"type":"text","text":"narrowed by 1\/12 of the Pythagorean comma (≈ 700.000 cents). The remaining three"},{"type":"text","text":" "},{"type":"text","text":"fifths — E→B, A♭→E♭, E♭→B♭ — are pure. The circle closes exactly:"},{"type":"text","text":" "},{"type":"text","text":"3×(1\/6) + 6×(1\/12) = 1 Pythagorean comma."}]},{"type":"paragraph","inlineContent":[{"text":"From ","type":"text"},{"inlineContent":[{"text":"Sectio Canonis Harmonici","type":"text"}],"type":"emphasis"},{"text":" (Königsberg, 1724). Neidhardt relabeled this","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"specification “Large City” in his 1732 revision."}]}],"kind":"content"}],"abstract":[{"type":"text","text":"Neidhardt II (“Small City”; Johann Georg Neidhardt, 1724)."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivortuning\/welltemperament\/neidhardtii"]}],"metadata":{"externalID":"s:10IvorTuning0B6SystemPA2A15WellTemperamentVRszrlE11neidhardtIIAEvpZ::SYNTHESIZED::s:10IvorTuning15WellTemperamentV","conformance":{"conformancePrefix":[{"text":"Conforms when","type":"text"}],"constraints":[{"code":"Self","type":"codeVoice"},{"type":"text","text":" is "},{"code":"WellTemperament","type":"codeVoice"},{"text":".","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}]},"role":"symbol","symbolKind":"property","title":"neidhardtII","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"neidhardtII","kind":"identifier"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:10IvorTuning15WellTemperamentV","text":"WellTemperament"}],"extendedModule":"IvorTuning","modules":[{"name":"IvorTuning"}],"roleHeading":"Type Property"},"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/IvorTuning\/documentation\/IvorTuning","doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament"]]},"references":{"doc://IvorTuning/documentation/IvorTuning/WellTemperament":{"role":"symbol","url":"\/documentation\/ivortuning\/welltemperament","navigatorTitle":[{"text":"WellTemperament","kind":"identifier"}],"title":"WellTemperament","kind":"symbol","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament","abstract":[{"type":"text","text":"A tuning system in which all twelve keys are usable but have distinct tonal characters,"},{"type":"text","text":" "},{"type":"text","text":"achieved by distributing the Pythagorean comma unevenly around the circle of fifths."}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WellTemperament","kind":"identifier"}]},"doc://IvorTuning/documentation/IvorTuning/WellTemperament/neidhardtII":{"kind":"symbol","abstract":[{"text":"Neidhardt II (“Small City”; Johann Georg