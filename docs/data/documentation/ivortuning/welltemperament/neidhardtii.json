{"abstract":[{"text":"Neidhardt II (“Small City”; Johann Georg Neidhardt, 1724).","type":"text"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"title":"neidhardtII","externalID":"s:10IvorTuning0B6SystemPA2A15WellTemperamentVRszrlE11neidhardtIIAEvpZ::SYNTHESIZED::s:10IvorTuning15WellTemperamentV","modules":[{"name":"IvorTuning"}],"role":"symbol","roleHeading":"Type Property","symbolKind":"property","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"neidhardtII","kind":"identifier"},{"text":": ","kind":"text"},{"text":"WellTemperament","kind":"typeIdentifier","preciseIdentifier":"s:10IvorTuning15WellTemperamentV"}],"extendedModule":"IvorTuning","conformance":{"constraints":[{"code":"Self","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"WellTemperament","type":"codeVoice"},{"text":".","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}]}},"hierarchy":{"paths":[["doc:\/\/IvorTuning\/documentation\/IvorTuning","doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament"]]},"sections":[],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"neidhardtII","kind":"identifier"},{"text":": ","kind":"text"},{"text":"WellTemperament","kind":"typeIdentifier","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament","preciseIdentifier":"s:10IvorTuning15WellTemperamentV"},{"text":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"languages":["swift"]}]},{"content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Three fifths — C→G, G→D, D→A — are each narrowed by ⅙ of the Pythagorean comma","type":"text"},{"text":" ","type":"text"},{"text":"(≈ 698.045 cents). Six fifths — A→E, B→F♯, F♯→C♯, C♯→A♭, B♭→F, F→C — are each","type":"text"},{"text":" ","type":"text"},{"text":"narrowed by 1\/12 of the Pythagorean comma (≈ 700.000 cents). The remaining three","type":"text"},{"text":" ","type":"text"},{"text":"fifths — E→B, A♭→E♭, E♭→B♭ — are pure. The circle closes exactly:","type":"text"},{"text":" ","type":"text"},{"text":"3×(1\/6) + 6×(1\/12) = 1 Pythagorean comma.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"From ","type":"text"},{"inlineContent":[{"text":"Sectio Canonis Harmonici","type":"text"}],"type":"emphasis"},{"text":" (Königsberg, 1724). Neidhardt relabeled this","type":"text"},{"text":" ","type":"text"},{"text":"specification “Large City” in his 1732 revision.","type":"text"}]}],"kind":"content"}],"identifier":{"url":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament\/neidhardtII","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/ivortuning\/welltemperament\/neidhardtii"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://IvorTuning/documentation/IvorTuning":{"abstract":[{"text":"Musical pitch, interval, and tuning system types.","type":"text"}],"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning","url":"\/documentation\/ivortuning","title":"IvorTuning","kind":"symbol","role":"collection","type":"topic"},"doc://IvorTuning/documentation/IvorTuning/WellTemperament":{"url":"\/documentation\/ivortuning\/welltemperament","role":"symbol","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WellTemperament","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament","navigatorTitle":[{"text":"WellTemperament","kind":"identifier"}],"abstract":[{"type":"text","text":"A tuning system in which all twelve keys are usable but have distinct tonal characters,"},{"type":"text","text":" "},{"type":"text","text":"achieved by distributing the Pythagorean comma unevenly around the circle of fifths."}],"title":"WellTemperament"},"doc://IvorTuning/documentation/IvorTuning/WellTemperament/neidhardtII":{"abstract":[{"text":"Neidhardt II (“Small City”; Johann Georg Neidhardt, 1724).","type":"text"}],"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament\/neidhardtII","kind":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"neidhardtII"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:10IvorTuning15WellTemperamentV","text":"WellTemperament"}],"title":"neidhardtII","type":"topic","conformance":{"conformancePrefix":[{"text":"Conforms when","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}],"constraints":[{"code":"Self","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"WellTemperament","type":"codeVoice"},{"text":".","type":"text"}]},"url":"\/documentation\/ivortuning\/welltemperament\/neidhardtii","role":"symbol"}}}