{"kind":"symbol","abstract":[{"type":"text","text":"Neidhardt II (“Small City”; Johann Georg Neidhardt, 1724)."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"neidhardtII"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:10IvorTuning15WellTemperamentV","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament","text":"WellTemperament"},{"kind":"text","text":" { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}],"platforms":["macOS"]}]},{"content":[{"type":"heading","anchor":"discussion","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Three fifths — C→G, G→D, D→A — are each narrowed by ⅙ of the Pythagorean comma"},{"type":"text","text":" "},{"text":"(≈ 698.045 cents). Six fifths — A→E, B→F♯, F♯→C♯, C♯→A♭, B♭→F, F→C — are each","type":"text"},{"text":" ","type":"text"},{"text":"narrowed by 1\/12 of the Pythagorean comma (≈ 700.000 cents). The remaining three","type":"text"},{"type":"text","text":" "},{"type":"text","text":"fifths — E→B, A♭→E♭, E♭→B♭ — are pure. The circle closes exactly:"},{"type":"text","text":" "},{"type":"text","text":"3×(1\/6) + 6×(1\/12) = 1 Pythagorean comma."}]},{"type":"paragraph","inlineContent":[{"text":"From ","type":"text"},{"inlineContent":[{"type":"text","text":"Sectio Canonis Harmonici"}],"type":"emphasis"},{"text":" (Königsberg, 1724). Neidhardt relabeled this","type":"text"},{"text":" ","type":"text"},{"text":"specification “Large City” in his 1732 revision.","type":"text"}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/IvorTuning\/documentation\/IvorTuning","doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament"]]},"metadata":{"symbolKind":"property","roleHeading":"Type Property","extendedModule":"IvorTuning","modules":[{"name":"IvorTuning"}],"title":"neidhardtII","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"neidhardtII","kind":"identifier"},{"text":": ","kind":"text"},{"text":"WellTemperament","kind":"typeIdentifier","preciseIdentifier":"s:10IvorTuning15WellTemperamentV"}],"conformance":{"constraints":[{"code":"Self","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"WellTemperament","type":"codeVoice"},{"text":".","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}]},"role":"symbol","externalID":"s:10IvorTuning0B6SystemPA2A15WellTemperamentVRszrlE11neidhardtIIAEvpZ::SYNTHESIZED::s:10IvorTuning15WellTemperamentV"},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivortuning\/welltemperament\/neidhardtii"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament\/neidhardtII"},"references":{"doc://IvorTuning/documentation/IvorTuning/WellTemperament":{"abstract":[{"text":"A tuning system in which all twelve keys are usable but have distinct tonal characters,","type":"text"},{"text":" ","type":"text"},{"text":"achieved by distributing the Pythagorean comma unevenly around the circle of fifths.","type":"text"}],"role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"WellTemperament"}],"url":"\/documentation\/ivortuning\/welltemperament","navigatorTitle":[{"kind":"identifier","text":"WellTemperament"}],"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament","title":"WellTemperament","type":"topic"},"doc://IvorTuning/documentation/IvorTuning/WellTemperament/neidhardtII":{"url":"\/documentation\/ivortuning\/welltemperament\/neidhardtii","abstract":