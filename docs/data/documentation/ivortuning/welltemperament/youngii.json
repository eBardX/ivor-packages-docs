{"abstract":[{"type":"text","text":"Young II (Thomas Young, 1800)."}],"sections":[],"hierarchy":{"paths":[["doc:\/\/IvorTuning\/documentation\/IvorTuning","doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament"]]},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"youngII"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"WellTemperament","preciseIdentifier":"s:10IvorTuning15WellTemperamentV","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament"},{"kind":"text","text":" { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Six consecutive fifths from C to F♯ — C→G, G→D, D→A, A→E, E→B, B→F♯ — are each"},{"type":"text","text":" "},{"text":"narrowed by ⅙ of the Pythagorean comma, equal to 2^(13\/6)\/3 ≈ 698.045 cents.","type":"text"},{"text":" ","type":"text"},{"text":"The remaining six fifths are pure (3:2). The circle closes exactly.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"The tempered fifth size is identical to Vallotti, but the tempered segment runs","type":"text"},{"text":" ","type":"text"},{"text":"from C through F♯ (six sharps) rather than from F through B (six naturals\/flats).","type":"text"},{"text":" ","type":"text"},{"text":"Published in ","type":"text"},{"inlineContent":[{"text":"Philosophical Transactions of the Royal Society","type":"text"}],"type":"emphasis"},{"text":" 90 (1800).","type":"text"}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivortuning\/welltemperament\/youngii"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","identifier":{"u