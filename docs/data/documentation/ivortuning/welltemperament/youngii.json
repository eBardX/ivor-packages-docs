{"kind":"symbol","abstract":[{"text":"Young II (Thomas Young, 1800).","type":"text"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"youngII","kind":"identifier"},{"text":": ","kind":"text"},{"text":"WellTemperament","preciseIdentifier":"s:10IvorTuning15WellTemperamentV","kind":"typeIdentifier","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament"},{"text":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"inlineContent":[{"text":"Six consecutive fifths from C to F♯ — C→G, G→D, D→A, A→E, E→B, B→F♯ — are each","type":"text"},{"text":" ","type":"text"},{"text":"narrowed by ⅙ of the Pythagorean comma, equal to 2^(13\/6)\/3 ≈ 698.045 cents.","type":"text"},{"text":" ","type":"text"},{"text":"The remaining six fifths are pure (3:2). The circle closes exactly.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The tempered fifth size is identical to Vallotti, but the tempered segment runs"},{"type":"text","text":" "},{"text":"from C through F♯ (six sharps) rather than from F through B (six naturals\/flats).","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Published in "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Philosophical Transactions of the Royal Society"}]},{"type":"text","text":" 90 (1800)."}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/IvorTuning\/documentation\/IvorTuning","doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivortuning\/welltemperament\/youngii"]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"metadata":{"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"youngII","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:10IvorTuning15WellTemperamentV","text":"WellTemperament","kind":"typeIdentifier"}],"symbolKind":"property","externalID":"s:10IvorTuning0B6SystemPA2A15WellTemperamentVRszrlE7youngIIAEvpZ::SYNTHESIZED::s:10IvorTuning15WellTemperamentV","extendedModule":"IvorTuning","modules":[{"name":"IvorTuning"}],"title":"youngII","role":"symbol","conformance":{"constraints":[{"type":"codeVoice","code":"Self"},{"type":"text","text":" is "},{"type":"codeVoice","code":"WellTemperament"},{"type":"text","text":"."}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"availabilityPrefix":[{"type":"text","text":"Available when"}]},"roleHeading":"Type Property"},"identifier":{"url":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament\/youngII","interfaceLanguage":"swift"},"references":{"doc://IvorTuning/documentation/IvorTuning/WellTemperament/youngII":{"title":"youngII","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"youngII"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:10IvorTuning15WellTemperamentV","text":"WellTemperament"}],"kind":"symbol","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament\/youngII","abstract":[{"type":"text","text":"Young II (Thomas Young, 1800)."}],"conformance":{"conformancePrefix":[{"text":"Conforms when","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}],"constraints":[{"code":"Self","type":"codeVoice"},{"type":"text","text":" is "},{"type":"codeVoice","code":"WellTemperament"},{"type":"text","text":"."}]},"url":"\/documentation\/ivortuning\/welltemperament\/youngii"},"doc://IvorTuning/documentation/IvorTuning":{"kind":"symbol","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning","role":"collection","type":"topic","title":"IvorTuning","abstract":[{"text":"Musical pitch, interval, and tuning system types.","type":"text"}],"url":"\/documentation\/ivortuning"},"doc://IvorTuning/documentation/IvorTuning/WellTemperament":{"role":"symbol","url":"\/documentation\/ivortuning\/welltemperament","navigatorTitle":[{"text":"WellTemperament","kind":"identifier"}],"title":"WellTemperament","kind":"symbol","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament","abstract":[{"type":"text","text":"A tuning system in which all twelve keys are usable but have distinct tonal characters,"},{"type":"text","text":" "},{"type":"text","text":"achieved by distributing the Pythagorean comma unevenly around the circle of fifths."}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WellTemperament","kind":"identifier"}]}}}