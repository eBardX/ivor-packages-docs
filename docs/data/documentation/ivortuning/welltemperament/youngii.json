{"abstract":[{"text":"Young II (Thomas Young, 1800).","type":"text"}],"hierarchy":{"paths":[["doc:\/\/IvorTuning\/documentation\/IvorTuning","doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament"]]},"metadata":{"extendedModule":"IvorTuning","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"youngII","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:10IvorTuning15WellTemperamentV","text":"WellTemperament","kind":"typeIdentifier"}],"roleHeading":"Type Property","externalID":"s:10IvorTuning0B6SystemPA2A15WellTemperamentVRszrlE7youngIIAEvpZ::SYNTHESIZED::s:10IvorTuning15WellTemperamentV","role":"symbol","modules":[{"name":"IvorTuning"}],"symbolKind":"property","title":"youngII","conformance":{"constraints":[{"type":"codeVoice","code":"Self"},{"type":"text","text":" is "},{"type":"codeVoice","code":"WellTemperament"},{"type":"text","text":"."}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}]}},"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"youngII","kind":"identifier"},{"text":": ","kind":"text"},{"text":"WellTemperament","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament","preciseIdentifier":"s:10IvorTuning15WellTemperamentV","kind":"typeIdentifier"},{"text":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}]}]},{"content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Six consecutive fifths from C to F♯ — C→G, G→D, D→A, A→E, E→B, B→F♯ — are each"},{"type":"text","text":" "},{"type":"text","text":"narrowed by ⅙ of the Pythagorean comma, equal to 2^(13\/6)\/3 ≈ 698.045 cents."},{"type":"text","text":" "},{"type":"text","text":"The remaining six fifths are pure (3:2). The circle closes exactly."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The tempered fifth size is identical to Vallotti, but the tempered segment runs"},{"type":"text","text":" "},{"type":"text","text":"from C through F♯ (six sharps) rather than from F through B (six naturals\/flats)."},{"type":"text","text":" "},{"type":"text","text":"Published in "},{"type":"emphasis","inlineContent":[{"text":"Philosophical Transactions of the Royal Society","type":"text"}]},{"type":"text","text":" 90 (1800)."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/ivortuning\/welltemperament\/youngii"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament\/youngII"},"references":{"doc://IvorTuning/documentation/IvorTuning":{"abstract":[{"text":"Musical pitch, interval, and tuning system types.","type":"text"}],"url":"\/documentation\/ivortuning","kind":"symbol","type":"topic","role":"collection","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning","title":"IvorTuning"},"doc://IvorTuning/documentation/IvorTuning/WellTemperament":{"abstract":[{"text":"A tuning system in which all twelve keys are usable but have distinct tonal characters,","type":"text"},{"text":" ","type":"text"},{"text":"achieved by distributing the Pythagorean comma unevenly around the circle of fifths.","type":"text"}],"url":"\/documentation\/ivortuning\/welltemperament","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WellTemperament","kind":"identifier"}],"kind":"symbol","type":"topic","role":"symbol","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament","title":"WellTemperament","navigatorTitle":[{"text":"Well