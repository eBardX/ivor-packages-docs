{"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament\/youngII"},"abstract":[{"text":"Young II (Thomas Young, 1800).","type":"text"}],"metadata":{"externalID":"s:10IvorTuning0B6SystemPA2A15WellTemperamentVRszrlE7youngIIAEvpZ::SYNTHESIZED::s:10IvorTuning15WellTemperamentV","symbolKind":"property","title":"youngII","modules":[{"name":"IvorTuning"}],"roleHeading":"Type Property","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"youngII"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:10IvorTuning15WellTemperamentV","text":"WellTemperament"}],"role":"symbol","conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"constraints":[{"code":"Self","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"WellTemperament","type":"codeVoice"},{"text":".","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}]},"extendedModule":"IvorTuning"},"variants":[{"paths":["\/documentation\/ivortuning\/welltemperament\/youngii"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"youngII","kind":"identifier"},{"text":": ","kind":"text"},{"text":"WellTemperament","preciseIdentifier":"s:10IvorTuning15WellTemperamentV","kind":"typeIdentifier","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament"},{"text":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"Six consecutive fifths from C to F♯ — C→G, G→D, D→A, A→E, E→B, B→F♯ — are each","type":"text"},{"text":" ","type":"text"},{"text":"narrowed by ⅙ of the Pythagorean comma, equal to 2^(13\/6)\/3 ≈ 698.045 cents.","type":"text"},{"text":" ","type":"text"},{"text":"The remaining six fifths are pure (3:2). The circle closes exactly.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The tempered fifth size is identical to Vallotti, but the tempered segment runs","type":"text"},{"text":" ","type":"text"},{"text":"from C through F♯ (six sharps) rather than from F through B (six naturals\/flats).","type":"text"},{"text":" ","type":"text"},{"text":"Published in ","type":"text"},{"inlineContent":[{"text":"Philosophical Transactions of the Royal Society","type":"text"}],"type":"emphasis"},{"text":" 90 (1800).","type":"text"}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/IvorTuning\/documentation\/IvorTuning","doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament"]]},"references":{"doc://IvorTuning/documentation/IvorTuning/WellTemperament/youngII":{"abstract":[{"text":"Young II (Thomas Young, 1800).","type":"text"}],"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament\/youngII","title":"youngII","type":"topic","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"youngII"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:10IvorTuning15WellTemperamentV","text":"WellTemperament"}],"kind":"symbol","role":"symbol","conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"constraints":[{"code":"Self","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"WellTemperament","type":"codeVoice"},{"text":".","type":"text"}]},"url":"\/documentation\/ivortuning\/welltemperament\/youngii"},"doc://IvorTuning/documentation/IvorTuning":{"abstract":[{"text":"Musical pitch, interval, and tuning system types.","type":"text"}],"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning","url":"\/documentation\/ivortuning","title":"IvorTuning","kind":"symbol","role":"collection","type":"topic"},"doc://IvorTuning/documentation/IvorTuning/WellTemperament":{"url":"\/documentation\/ivortuning\/welltemperament","role":"symbol","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WellTemperament","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament","navigatorTitle":[{"text":"WellTemperament","kind":"identifier"}],"abstract":[{"type":"text","text":"A tuning system in which all twelve keys are usable but have distinct tonal characters,"},{"type":"text","text":" "},{"type":"text","text":"achieved by distributing the Pythagorean comma unevenly around the circle of fifths."}],"title":"WellTemperament"}}}