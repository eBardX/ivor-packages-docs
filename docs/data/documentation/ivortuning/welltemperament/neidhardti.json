"type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Four fifths — C→G, G→D, D→A, A→E — are each narrowed by ⅙ of the Pythagorean"},{"type":"text","text":" "},{"text":"comma (≈ 698.045 cents). Four fifths — E→B, B→F♯, A♭→E♭, E♭→B♭ — are each","type":"text"},{"text":" ","type":"text"},{"text":"narrowed by 1\/12 of the Pythagorean comma, equal to the equal-temperament fifth","type":"text"},{"type":"text","text":" "},{"type":"text","text":"2^(7\/12) ≈ 700.000 cents. The remaining four fifths are pure. The circle closes"},{"type":"text","text":" "},{"type":"text","text":"exactly: 4×(1\/6) + 4×(1\/12) = 1 Pythagorean comma."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"From ","type":"text"},{"inlineContent":[{"type":"text","text":"Sectio Canonis Harmonici"}],"type":"emphasis"},{"text":" (Königsberg, 1724). Neidhardt relabeled this","type":"text"},{"text":" ","type":"text"},{"text":"specification “Small City” in his 1732 revision.","type":"text"}]}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament\/neidhardtI"},"references":{"doc://IvorTuning/documentation/IvorTuning/WellTemperament/neidhardtI":{"abstract":[{"type":"text","text":"Neidhardt I (“Village”; Johann Georg Neidhardt, 1724)."}],"title":"neidhardtI","role":"symbol","conformance":{"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"type":"codeVoice","code":"Self"},{"text":" is ","type":"text"},{"code":"WellTemperament","type":"codeVoice"},{"text":".","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}]},"kind":"symbol","url":"\/documentation\/ivortuning\/welltemperament\/neidhardti","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament\/neidhardtI","type":"topic","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"text":" ","kind":"text"},{"text":"neidhardtI","kind":"identifier"},{"t