equal to ⁵√(2¹⁴\/3⁷) ≈ 697.654 cents. The remaining seven","type":"text"},{"type":"text","text":" "},{"text":"fifths are pure (3:2). The circle closes exactly.","type":"text"}]},{"inlineContent":[{"type":"text","text":"Proposed by Kellner as a reconstruction of Bach’s own tuning, published in"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Das Musikinstrument"}]},{"type":"text","text":" 26 (1977). The choice of five fifths and their positions"},{"type":"text","text":" "},{"type":"text","text":"mirrors the structure of Werckmeister III while spreading the tempering more evenly."}],"type":"paragraph"}],"kind":"content"}],"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/IvorTuning\/documentation\/IvorTuning","doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament"]]},"kind":"symbol","abstract":[{"type":"text","text":"Kellner (Herbert Anton Kellner, 1977)."}],"references":{"doc://IvorTuning/documentation/IvorTuning/WellTemperament/kellner":{"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament\/kellner","conformance":{"conformancePrefix":[{"type":"text","text":"Conforms when"}],"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"type":"codeVoice","code":"Self"},{"type":"text","text":" is "},{"type":"codeVoice","code":"WellTemperament"},{"type":"text","text":"."}]},"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"kellner"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:10IvorTuning15WellTemperamentV","text":"WellTemperament"}],"title":"kellner","url":"\/documentation\/ivortuning\/welltemperament\/kellner","abstract":[{"type":"text","text":"Kellner (Herbert Anton Kellner, 1977)."}],"kind":"symbol","type":"topic","role":"symbol"},"doc://IvorTuning/documentation/IvorTuning/WellTemperament":{"type":"topic","navigatorTitle":[{"text":"WellTemperament","kind":"identifier"}],"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament","abstract":[{"type":"text","text":"A tuning system in which all twelve keys are usable but have distinct tonal characters,"},{"type":"text","text":" "},{"type":"text","text":"achieved by distributing the Pythagorean comma unevenly around the circle of fifths."}],"role":"symbol","title":"WellTemperament","url":"\/documentation\/ivortuning\/welltemperament","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WellTemperament","kind":"identifier"}],"kind":"symbol"},"doc://IvorTuning/documentation/IvorTuning":{"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning","title":"IvorTuning","url":"\/documentation\/ivortuning","abstract":[{"text":"Musical pitch, interval, and tuning system types.","type":"text"}],"kind":"symbol","type":"topic","role":"collection"}}}