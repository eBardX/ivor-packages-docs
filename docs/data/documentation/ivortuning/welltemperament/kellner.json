{"abstract":[{"text":"Kellner (Herbert Anton Kellner, 1977).","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament\/kellner"},"metadata":{"roleHeading":"Type Property","extendedModule":"IvorTuning","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"kellner","kind":"identifier"},{"text":": ","kind":"text"},{"text":"WellTemperament","kind":"typeIdentifier","preciseIdentifier":"s:10IvorTuning15WellTemperamentV"}],"externalID":"s:10IvorTuning0B6SystemPA2A15WellTemperamentVRszrlE7kellnerAEvpZ::SYNTHESIZED::s:10IvorTuning15WellTemperamentV","symbolKind":"property","conformance":{"conformancePrefix":[{"type":"text","text":"Conforms when"}],"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"code":"Self","type":"codeVoice"},{"type":"text","text":" is "},{"type":"codeVoice","code":"WellTemperament"},{"type":"text","text":"."}]},"title":"kellner","role":"symbol","modules":[{"name":"IvorTuning"}]},"hierarchy":{"paths":[["doc:\/\/IvorTuning\/documentation\/IvorTuning","doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament"]]},"variants":[{"paths":["\/documentation\/ivortuning\/welltemperament\/kellner"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","primaryContentSections":[{"declarations":[{"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"kellner","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:10IvorTuning15WellTemperamentV","text":"WellTemperament","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament","kind":"typeIdentifier"},{"text":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Five fifths — C→G, G→D, D→A, A→E, and B→F♯ — are each narrowed by ⅕ of the"},{"type":"text","text":" "},{"type":"text","text":"Pythagorean comma, equal to ⁵√(2¹⁴\/3⁷) ≈ 697.654 cents. The remaining seven"},{"type":"text","text":" "},{"type":"text","text":"fifths are pure (3:2). The circle closes exactly."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Proposed by Kellner as a reconstruction of Bach’s own tuning, published in"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Das Musikinstrument"}]},{"type":"text","text":" 26 (1977). The choice of five fifths and their positions"},{"type":"text","text":" "},{"type":"text","text":"mirrors the structure of Werckmeister III while spreading the tempering more evenly."}],"type":"paragraph"}],"kind":"content"}],"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"references":{"doc://IvorTuning/documentation/IvorTuning/WellTemperament":{"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"WellTemperament"}],"url":"\/documentation\/ivortuning\/welltemperament","abstract":[{"text":"A tuning system in which all twelve keys are usable but have distinct tonal characters,","type":"text"},{"text":" ","type":"text"},{"text":"achieved by distributing the Pythagorean comma unevenly around the circle of fifths.","type":"text"}],"title":"WellTemperament","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"WellTemperament"}],"type":"topic","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament"},"doc://IvorTuning/documentation/IvorTuning":{"kind":"symbol","url":"\/documentation\/ivortuning","abstract":[{"type":"text","text":"Musical pitch, interval, and tuning system types."}],"title":"IvorTuning","role":"collection","type":"topic","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning"},"doc://IvorTuning/documentation/IvorTuning/WellTemperament/kellner":{"abstract":[{"type":"text","text":"Kellner (Herbert Anton Kellner, 1977)."}],"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament\/kellner","type":"topic","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"kellner","kind":"identifier"},{"text":": ","kind":"text"},{"text":"WellTemperament","kind":"typeIdentifier","preciseIdentifier":"s:10IvorTuning15WellTemperamentV"}],"url":"\/documentation\/ivortuning\/welltemperament\/kellner","kind":"symbol","conformance":{"conformancePrefix":[{"text":"Conforms when","type":"text"}],"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"code":"Self","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"WellTemperament","type":"codeVoice"},{"text":".","type":"text"}]},"title":"kellner","role":"symbol"}}}