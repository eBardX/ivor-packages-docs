{"sections":[],"variants":[{"paths":["\/documentation\/ivortuning\/welltemperament\/kirnbergeriii"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament\/kirnbergerIII","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/IvorTuning\/documentation\/IvorTuning","doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament"]]},"abstract":[{"text":"Kirnberger III (Johann Philipp Kirnberger, 1779).","type":"text"}],"kind":"symbol","metadata":{"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"kirnbergerIII","kind":"identifier"},{"text":": ","kind":"text"},{"text":"WellTemperament","kind":"typeIdentifier","preciseIdentifier":"s:10IvorTuning15WellTemperamentV"}],"title":"kirnbergerIII","roleHeading":"Type Property","modules":[{"name":"IvorTuning"}],"conformance":{"conformancePrefix":[{"type":"text","text":"Conforms when"}],"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"code":"Self","type":"codeVoice"},{"type":"text","text":" is "},{"code":"WellTemperament","type":"codeVoice"},{"type":"text","text":"."}]},"extendedModule":"IvorTuning","symbolKind":"property","externalID":"s:10IvorTuning0B6SystemPA2A15WellTemperamentVRszrlE13kirnbergerIIIAEvpZ::SYNTHESIZED::s:10IvorTuning15WellTemperamentV","role":"symbol"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"kirnbergerIII"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"WellTemperament","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament","preciseIdentifier":"s:10IvorTuning15WellTemperamentV"},{"kind":"text","text":" { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Four fifths — C→G, G→D, D→A, and A→E — are each narrowed by ¼ of the syntonic","type":"text"},{"text":" ","type":"text"},{"text":"comma, equal to ⁴√5 ≈ 696.578 cents. One fifth — F♯→C♯ — is narrowed by one","type":"text"},{"text":" ","type":"text"},{"text":"schisma (32805:32768), equal to 16384:10935 ≈ 699.977 cents. The remaining seven","type":"text"},{"text":" ","type":"text"},{"text":"fifths are pure (3:2). The circle closes exactly because one syntonic comma times","type":"text"},{"text":" ","type":"text"},{"text":"one schisma equals one Pythagorean comma.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The four quarter-comma fifths make C–E a pure major third (5:4). Published in","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"Die Kunst des reinen Satzes in der Musik"}],"type":"emphasis"},{"text":", Part II.","type":"text"}]}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"references":{"doc://IvorTuning/documentation/IvorTuning/WellTemperament/kirnbergerIII":{"kind":"symbol","title":"kirnbergerIII","type":"topic","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament\/kirnbergerIII","url":"\/documentation\/ivortuning\/welltemperament\/kirnbergeriii","role":"symbol","abstract":[{"type":"text","text":"Kirnberger III (Johann Philipp Kirnberger, 1779)."}],"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"kirnbergerIII","kind":"identifier"},{"text":": ","kind":"text"},{"text":"WellTemperament","preciseIdentifier":"s:10IvorTuning15WellTemperamentV","kind":"typeIdentifier"}],"conformance":{"conformancePrefix":[{"type":"text","text":"Conforms when"}],"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"code":"Self","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"WellTemperament","type":"codeVoice"},{"type":"text","text":"."}]}},"doc://IvorTuning/documentation/IvorTuning":{"kind":"symbol","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning","role":"collection","type":"topic","title":"IvorTuning","abstract":[{"text":"Musical pitch, interval, and tuning system types.","type":"text"}],"url":"\/documentation\/ivortuning"},"doc://IvorTuning/documentation/IvorTuning/WellTemperament":{"role":"symbol","url":"\/documentation\/ivortuning\/welltemperament","navigatorTitle":[{"text":"WellTemperament","kind":"identifier"}],"title":"WellTemperament","kind":"symbol","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament","abstract":[{"type":"text","text":"A tuning system in which all twelve keys are usable but have distinct tonal characters,"},{"type":"text","text":" "},{"type":"text","text":"achieved by distributing the Pythagorean comma unevenly around the circle of fifths."}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WellTemperament","kind":"identifier"}]}}}