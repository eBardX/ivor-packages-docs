{"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"keyword","text":"var"},{"text":" ","kind":"text"},{"kind":"identifier","text":"neidhardtIII"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament","kind":"typeIdentifier","text":"WellTemperament","preciseIdentifier":"s:10IvorTuning15WellTemperamentV"},{"kind":"text","text":" { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Three fifths — C→G, G→D, D→A — are each narrowed by ⅙ of the Pythagorean comma","type":"text"},{"text":" ","type":"text"},{"text":"(≈ 698.045 cents). Six fifths — A→E, B→F♯, F♯→C♯, C♯→A♭, E♭→B♭, B♭→F — are","type":"text"},{"text":" ","type":"text"},{"text":"each narrowed by 1\/12 of the Pythagorean comma (≈ 700.000 cents). The remaining","type":"text"},{"text":" ","type":"text"},{"text":"three fifths — E→B, A♭→E♭, F→C — are pure. The circle closes exactly:","type":"text"},{"text":" ","type":"text"},{"text":"3×(1\/6) + 6×(1\/12) = 1 Pythagorean comma.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"From ","type":"text"},{"inlineContent":[{"type":"text","text":"Sectio Canonis Harmonici"}],"type":"emphasis"},{"text":" (Königsberg, 1724). Differs from ","type":"text"},{"isActive":true,"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament\/neidhardtII","type":"reference"},{"text":" ","type":"text"},{"text":"only in the placement of the sixth-comma group on the flat side: E♭→B♭ is tempered","type":"text"},{"text":" ","type":"text"},{"text":"here where it is pure in Neidhardt II, and F→C is pure here where it is tempered","type":"text"},{"text":" ","type":"text"},{"text":"in Neidhardt II.","type":"text"}]}]}],"sections":[],"metadata":{"role":"symbol","modules":[{"name":"IvorTuning"}],"externalID":"s:10IvorTuning0B6SystemPA2A15WellTemperamentVRszrlE12neidhardtIIIAEvpZ::SYNTHESIZED::s:10IvorTuning15WellTemperamentV","title":"neidhardtIII","roleHeading":"Type Property","conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"constraints":[{"code":"Self","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"WellTemperament","type":"codeVoice"},{"text":".","type":"text"}]},"symbolKind":"property","extendedModule":"IvorTuning","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"neidhardtIII"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:10IvorTuning15WellTemperamentV","text":"WellTemperament"}]},"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivortuning\/welltemperament\/neidhardtiii"]}],"hierarchy":{"paths":[["doc:\/\/IvorTuning\/documentation\/IvorTuning","doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament\/neidhardtIII"},"abstract":[{"type":"text","text":"Neidhardt III (“Large City”; Johann Georg Neidhardt, 1724)."}],"references":{"doc://IvorTuning/documentation/IvorTuning":{"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning","title":"IvorTuning","url":"\/documentation\/ivortuning","abstract":[{"text":"Musical pitch, interval, and tuning system types.","type":"text"}],"kind":"symbol","type":"topic","role":"collection"},"doc://IvorTuning/documentation/IvorTuning/WellTemperament":{"type":"topic","navigatorTitle":[{"text":"WellTemperament","kind":"identifier"}],"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament","abstract":[{"type":"text","text":"A tuning system in which all twelve keys are usable but have distinct tonal characters,"},{"type":"text","text":" "},{"type":"text","text":"achieved by distributing the Pythagorean comma unevenly around the circle of fifths."}],"role":"symbol","title":"WellTemperament","url":"\/documentation\/ivortuning\/welltemperament","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WellTemperament","kind":"identifier"}],"kind":"symbol"},"doc://IvorTuning/documentation/IvorTuning/WellTemperament/neidhardtII":{"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament\/neidhardtII","title":"neidhardtII","role":"symbol","conformance":{"conformancePrefix":[{"type":"text","text":"Conforms when"}],"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"code":"Self","type":"codeVoice"},{"type":"text","text":" is "},{"code":"WellTemperament","type":"codeVoice"},{"type":"text","text":"."}]},"type":"topic","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"neidhardtII","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:10IvorTuning15WellTemperamentV","text":"WellTemperament","kind":"typeIdentifier"}],"url":"\/documentation\/ivortuning\/welltemperament\/neidhardtii","kind":"symbol","abstract":[{"type":"text","text":"Neidhardt II (“Small City”; Johann Georg Neidhardt, 1724)."}]},"doc://IvorTuning/documentation/IvorTuning/WellTemperament/neidhardtIII":{"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"neidhardtIII","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:10IvorTuning15WellTemperamentV","text":"WellTemperament","kind":"typeIdentifier"}],"kind":"symbol","type":"topic","url":"\/documentation\/ivortuning\/welltemperament\/neidhardtiii"