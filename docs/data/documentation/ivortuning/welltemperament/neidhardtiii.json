{"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"neidhardtIII","kind":"identifier"},{"text":": ","kind":"text"},{"text":"WellTemperament","kind":"typeIdentifier","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament","preciseIdentifier":"s:10IvorTuning15WellTemperamentV"},{"text":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}]}]},{"content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"Three fifths — C→G, G→D, D→A — are each narrowed by ⅙ of the Pythagorean comma","type":"text"},{"text":" ","type":"text"},{"text":"(≈ 698.045 cents). Six fifths — A→E, B→F♯, F♯→C♯, C♯→A♭, E♭→B♭, B♭→F — are","type":"text"},{"text":" ","type":"text"},{"text":"each narrowed by 1\/12 of the Pythagorean comma (≈ 700.000 cents). The remaining","type":"text"},{"text":" ","type":"text"},{"text":"three fifths — E→B, A♭→E♭, F→C — are pure. The circle closes exactly:","type":"text"},{"text":" ","type":"text"},{"text":"3×(1\/6) + 6×(1\/12) = 1 Pythagorean comma.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"From ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"Sectio Canonis Harmonici"}]},{"text":" (Königsberg, 1724). Differs from ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament\/neidhardtII"},{"text":" ","type":"text"},{"text":"only in the placement of the sixth-comma group on the flat side: E♭→B♭ is tempered","type":"text"},{"text":" ","type":"text"},{"text":"here where it is pure in Neidhardt II, and F→C is pure here where it is tempered","type":"text"},{"text":" ","type":"text"},{"text":"in Neidhardt II.","type":"text"}]}],"kind":"content"}],"identifier":{"url":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament\/neidhardtIII","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/IvorTuning\/documentation\/IvorTuning","doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament"]]},"kind":"symbol","variants":[{"paths":["\/documentation\/ivortuning\/welltemperament\/neidhardtiii"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"Neidhardt III (“Large City”; Johann Georg Neidhardt, 1724)."}],"sections":[],"metadata":{"roleHeading":"Type Property","symbolKind":"property","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"neidhardtIII","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:10IvorTuning15WellTemperamentV","text":"WellTemperament","kind":"typeIdentifier"}],"conformance":{"constraints":[{"code":"Self","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"WellTemperament","type":"codeVoice"},{"text":".","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}]},"modules":[{"name":"IvorTuning"}],"title":"neidhardtIII","role":"symbol","extendedModule":"IvorTuning","externalID":"s:10IvorTuning0B6SystemPA2A15WellTemperamentVRszrlE12neidhardtIIIAEvpZ::SYNTHESIZED::s:10IvorTuning15WellTemperamentV"},"references":{"doc://IvorTuning/documentation/IvorTuning/WellTemperament/neidhardtIII":{"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament\/neidhardtIII","abstract":[{"type":"text","text":"Neidhardt III (“Large City”; Johann Georg Neidhardt, 1724)."}],"title":"neidhardtIII","type":"topic","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"neidhardtIII"},{"kind":"text","text":": "},