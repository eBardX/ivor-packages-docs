{"variants":[{"paths":["\/documentation\/ivortuning\/welltemperament\/neidhardtiii"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"roleHeading":"Type Property","modules":[{"name":"IvorTuning"}],"externalID":"s:10IvorTuning0B6SystemPA2A15WellTemperamentVRszrlE12neidhardtIIIAEvpZ::SYNTHESIZED::s:10IvorTuning15WellTemperamentV","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"neidhardtIII","kind":"identifier"},{"text":": ","kind":"text"},{"text":"WellTemperament","kind":"typeIdentifier","preciseIdentifier":"s:10IvorTuning15WellTemperamentV"}],"role":"symbol","symbolKind":"property","conformance":{"constraints":[{"code":"Self","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"WellTemperament","type":"codeVoice"},{"text":".","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}]},"extendedModule":"IvorTuning","title":"neidhardtIII"},"hierarchy":{"paths":[["doc:\/\/IvorTuning\/documentation\/IvorTuning","doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament"]]},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"neidhardtIII","kind":"identifier"},{"text":": ","kind":"text"},{"text":"WellTemperament","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament","kind":"typeIdentifier","preciseIdentifier":"s:10IvorTuning15WellTemperamentV"},{"text":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"Three fifths — C→G, G→D, D→A — are each narrowed by ⅙ of the Pythagorean comma","type":"text"},{"text":" ","type":"text"},{"text":"(≈ 698.045 cents). Six fifths — A→E, B→F♯, F♯→C♯, C♯→A♭, E♭→B♭, B♭→F — are","type":"text"},{"text":" ","type":"text"},{"text":"each narrowed by 1\/12 of the Pythagorean comma (≈ 700.000 cents). The remaining","type":"text"},{"type":"text","text":" "},{"type":"text","text":"three fifths — E→B, A♭→E♭, F→C — are pure. The circle closes exactly:"},{"type":"text","text":" "},{"type":"text","text":"3×(1\/6) + 6×(1\/12) = 1 Pythagorean comma."}]},{"type":"paragraph","inlineContent":[{"text":"From ","type":"text"},{"inlineContent":[{"type":"text","text":"Sectio Canonis Harmonici"}],"type":"emphasis"},{"text":" (Königsberg, 1724). Differs from ","type":"text"},{"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament\/neidhardtII","type":"reference","isActive":true},{"text":" ","type":"text"},{"text":"only in the placement of the sixth-comma group on the flat side: E♭→B♭ is tempered","type":"text"},{"text":" ","type":"text"},{"text":"here where it is pure in Neidhardt II, and F→C is pure here where it is tempered","type":"text"},{"text":" ","type":"text"},{"text":"in Neidhardt II.","type":"text"}]}],"kind":"content"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament\/neidhardtIII"},"abstract":[{"type":"text","text":"Neidhardt III (“Large City”; Johann Georg Neidhardt, 1724)."}],"references":{"doc://IvorTuning/documentation/IvorTuning/WellTemperament/neidhardtII":{"url":"\/documentation\/ivortuning\/welltemperament\/neidhardtii","abstract":[{"text":"Neidhardt II (“Small City”; Johann Georg Neidhardt, 1724).","type":"text"}],"type":"topic","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"neidhardtII"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:10IvorTuning15WellTemperamentV","text":"WellTemperament"}],"role":"symbol","conformance":{"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"type":"codeVoice","code":"Self"},{"type":"text","text":" is "},{"code":"WellTemperament","type":"codeVoice"},{"text":".","type":"text"}],"availabilityPrefix":[{"type":"text","text":"Available when"}]},"kind":"symbol","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament\/neidhardtII","title":"neidhardtII"},"doc://IvorTuning/documentation/IvorTuning/WellTemperament":{"abstract":[{"text":"A tuning system in which all twelve keys are usable but have distinct tonal characters,","type":"text"},{"text":" ","type":"text"},{"text":"achieved by distributing the Pythagorean comma unevenly around the circle of fifths.","type":"text"}],"role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"WellTemperament"}],"url":"\/documentation\/ivortuning\/welltemperament","navigatorTitle":[{"kind":"identifier","text":"WellTemperament"}],"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament","title":"WellTemperament","type":"topic"},"doc://IvorTuning/documentation/IvorTuning/WellTemperament/neidhardtIII":{"abstract":[{"type":"text","text":"Neidhardt III (“Large City”; Johann Georg Neidhardt, 1724)."}],"title":"neidhardtIII","role":"symbol","conformance":{"constraints":[{"type":"codeVoice","code":"Self"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"WellTemperament"},{"text":".","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}]},"kind":"symbol","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament\/neidhardtIII","url":"\/documentation\/ivortuning\/welltemperament\/neidhardtiii","type":"topic","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"neidhardtIII"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:10IvorTuning15WellTemperamentV","text":"WellTemperament"}]},"doc://IvorTuning/documentation/IvorTuning":{"type":"topic","abstract":[{"text":"Musical pitch, interval, and tuning system types.","type":"text"}],"title":"IvorTuning","kind":"symbol","role":"collection","url":"\/documentation\/ivortuning","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning"}}}