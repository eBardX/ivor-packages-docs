vortuning\/welltemperament\/kirnbergerii","role":"symbol"},"doc://IvorTuning/documentation/IvorTuning":{"abstract":[{"text":"Musical pitch, interval, and tuning system types.","type":"text"}],"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning","url":"\/documentation\/ivortuning","title":"IvorTuning","kind":"symbol","role":"collection","type":"topic"},"doc://IvorTuning/documentation/IvorTuning/WellTemperament":{"url":"\/documentation\/ivortuning\/welltemperament","role":"symbol","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WellTemperament","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament","navigatorTitle":[{"text":"WellTemperament","kind":"identifier"}],"abstract":[{"type":"text","text":"A tuning system in which all twelve keys are usable but have distinct tonal characters,"},{"type":"text","text":" "},{"type":"text","text":"achieved by distributing the Pythagorean comma unevenly around the circle of fifths."}],"title":"WellTemperament"}}}