{"sections":[],"variants":[{"paths":["\/documentation\/ivortuning\/welltemperament\/kirnbergerii"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament\/kirnbergerII"},"hierarchy":{"paths":[["doc:\/\/IvorTuning\/documentation\/IvorTuning","doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament"]]},"abstract":[{"type":"text","text":"Kirnberger II (Johann Philipp Kirnberger, c. 1771)."}],"kind":"symbol","metadata":{"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"kirnbergerII"},{"kind":"text","text":": "},{"preciseIdentifier":"s:10IvorTuning15WellTemperamentV","kind":"typeIdentifier","text":"WellTemperament"}],"title":"kirnbergerII","extendedModule":"IvorTuning","externalID":"s:10IvorTuning0B6SystemPA2A15WellTemperamentVRszrlE12kirnbergerIIAEvpZ::SYNTHESIZED::s:10IvorTuning15WellTemperamentV","roleHeading":"Type Property","role":"symbol","modules":[{"name":"IvorTuning"}],"symbolKind":"property","conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"constraints":[{"type":"codeVoice","code":"Self"},{"type":"text","text":" is "},{"type":"codeVoice","code":"WellTemperament"},{"type":"text","text":"."}]}},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"kirnbergerII","kind":"identifier"},{"text":": ","kind":"text"},{"text":"WellTemperament","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament","kind":"typeIdentifier","preciseIdentifier":"s:10IvorTuning15WellTemperamentV"},{"text":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"Two fifths — D→A and A→E — are each narrowed by ½ of the syntonic comma, equal to","type":"text"},{"text":" ","type":"text"},{"text":"√(20\/9) ≈ 691.202 cents. One fifth — F♯→C♯ — is narrowed by one schisma","type":"text"},{"text":" ","type":"text"},{"text":"(32805:32768), equal to 16384:10935 ≈ 699.977 cents. The remaining nine fifths are","type":"text"},{"text":" ","type":"text"},{"text":"pure (3:2). The circle closes exactly because one syntonic comma times one schisma","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"equals one Pythagorean comma."}]},{"inlineContent":[{"type":"text","text":"The two half-comma fifths are unusually flat, giving C-adjacent keys very pure"},{"type":"text","text":" "},{"type":"text","text":"thirds while keys with many sharps or flats suffer greatly."}],"type":"paragraph"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://IvorTuning/documentation/IvorTuning/WellTemperament/kirnbergerII":{"url":"\/documentation\/ivortuning\/welltemperament\/kirnbergerii","role":"symbol","type":"topic","title":"kirnbergerII","abstract":[{"text":"Kirnberger II (Johann Philipp Kirnberger, c. 1771).","type":"text"}],"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"kirnbergerII","kind":"identifier"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:10IvorTuning15WellTemperamentV","text":"WellTemperament"}],"conformance":{"constraints":[{"type":"codeVoice","code":"Self"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"WellTemperament"},{"type":"text","text":"."}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}]},"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament\/kirnbergerII","kind":"symbol"},"doc://IvorTuning/documentation/IvorTuning/WellTemperament":{"role":"symbol","url":"\/documentation\/ivortuning\/welltemperament","navigatorTitle":[{"text":"WellTemperament","kind":"identifier"}],"title":"WellTemperament","kind":"symbol","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament","abstract":[{"type":"text","text":"A tuning system in which all twelve keys are usable but have distinct tonal characters,"},{"type":"text","text":" "},{"type":"text","text":"achieved by distributing the Pythagorean comma unevenly around the circle of fifths."}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WellTemperament","kind":"identifier"}]},"doc://IvorTuning/documentation/IvorTuning":{"kind":"symbol","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning","role":"collection","type":"topic","title":"IvorTuning","abstract":[{"text":"Musical pitch, interval, and tuning system types.","type":"text"}],"url":"\/documentation\/ivortuning"}}}