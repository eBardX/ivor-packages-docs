],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Two fifths — D→A and A→E — are each narrowed by ½ of the syntonic comma, equal to"},{"type":"text","text":" "},{"type":"text","text":"√(20\/9) ≈ 691.202 cents. One fifth — F♯→C♯ — is narrowed by one schisma"},{"type":"text","text":" "},{"type":"text","text":"(32805:32768), equal to 16384:10935 ≈ 699.977 cents. The remaining nine fifths are"},{"type":"text","text":" "},{"type":"text","text":"pure (3:2). The circle closes exactly because one syntonic comma times one schisma"},{"type":"text","text":" "},{"type":"text","text":"equals one Pythagorean comma."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The two half-comma fifths are unusually flat, giving C-adjacent keys very pure"},{"type":"text","text":" "},{"type":"text","text":"thirds while keys with many sharps or flats suffer greatly."}]}]}],"sections":[],"references":{"doc://IvorTuning/documentation/IvorTuning/WellTemperament":{"abstract":[{"text":"A tuning system in which all twelve keys are usable but have distinct tonal characters,","type":"text"},{"text":" ","type":"text"},{"text":"achieved by distributing the Pythagorean comma unevenly around the circle of fifths.","type":"text"}],"url":"\/documentation\/ivortuning\/welltemperament","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WellTemperament","kind":"identifier"}],"kind":"symbol","type":"topic","role":"symbol","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament","title":"WellTemperament","navigatorTitle":[{"text":"WellTemperament","kind":"identifier"}]},"doc://IvorTuning/documentation/IvorTuning/WellTemperament/kirnbergerII":{"abstract":[{"text":"Kirnberger II (Johann Philipp Kirnberger, c. 1771).","type":"text"}],"url":"\/documentation\/ivortuning\/welltemperament\/kirnber