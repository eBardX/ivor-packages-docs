macOS"]}]},{"kind":"content","content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Four fifths — C→G, G→D, D→A, and A→E — are each narrowed by ¼ of the syntonic","type":"text"},{"text":" ","type":"text"},{"text":"comma, equal to ⁴√5 ≈ 696.578 cents. One fifth — F♯→C♯ — is narrowed by one","type":"text"},{"text":" ","type":"text"},{"text":"schisma (32805:32768), equal to 16384:10935 ≈ 699.977 cents. The remaining seven","type":"text"},{"text":" ","type":"text"},{"text":"fifths are pure (3:2). The circle closes exactly because one syntonic comma times","type":"text"},{"text":" ","type":"text"},{"text":"one schisma equals one Pythagorean comma.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The four quarter-comma fifths make C–E a pure major third (5:4). Published in"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"text":"Die Kunst des reinen Satzes in der Musik","type":"text"}]},{"type":"text","text":", Part II."}]}]}],"references":{"doc://IvorTuning/documentation/IvorTuning/TuningSystem":{"url":"\/documentation\/ivortuning\/tuningsystem","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"text":"TuningSystem","kind":"identifier"}],"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem","type":"topic","navigatorTitle":[{"text":"TuningSystem","kind":"identifier"}],"abstract":[{"type":"text","text":"A type that describes a musical tuning system."}],"title":"TuningSystem"},"doc://IvorTuning/documentation/IvorTuning/TuningSystem/kirnbergerIII":{"abstract":[{"text":"Kirnberger III (Johann Philipp Kirnberger, 1779).","type":"text"}],"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem\/kirnbergerIII","kind":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":