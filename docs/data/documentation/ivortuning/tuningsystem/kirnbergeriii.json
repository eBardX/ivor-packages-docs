ontent":[{"text":"Four fifths — C→G, G→D, D→A, and A→E — are each narrowed by ¼ of the syntonic","type":"text"},{"text":" ","type":"text"},{"text":"comma, equal to ⁴√5 ≈ 696.578 cents. One fifth — F♯→C♯ — is narrowed by one","type":"text"},{"text":" ","type":"text"},{"text":"schisma (32805:32768), equal to 16384:10935 ≈ 699.977 cents. The remaining seven","type":"text"},{"type":"text","text":" "},{"type":"text","text":"fifths are pure (3:2). The circle closes exactly because one syntonic comma times"},{"type":"text","text":" "},{"type":"text","text":"one schisma equals one Pythagorean comma."}]},{"type":"paragraph","inlineContent":[{"text":"The four quarter-comma fifths make C–E a pure major third (5:4). Published in","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"Die Kunst des reinen Satzes in der Musik"}],"type":"emphasis"},{"text":", Part II.","type":"text"}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivortuning\/tuningsystem\/kirnbergeriii"]}],"sections":[],"references":{"doc://IvorTuning/documentation/IvorTuning":{"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning","title":"IvorTuning","url":"\/documentation\/ivortuning","abstract":[{"text":"Musical pitch, interval, and tuning system types.","type":"text"}],"kind":"symbol","type":"topic","role":"collection"},"doc://IvorTuning/documentation/IvorTuning/TuningSystem/kirnbergerIII":{"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem\/kirnbergerIII","title":"kirnbergerIII","role":"symbol","conformance":{"constraints":[{"code":"Self","type":"codeVoice"},{"type":"text","text":" is "},{"code":"WellTemperament","type":"codeVoice"},{"type":"text","text":"."}],"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]},"type":"topic","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"kirnbergerIII","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:10IvorTuning15WellTemperamentV","text":"WellTemperament","kind":"typeIdentifier"}],"url":"\/documentation\/ivortuning\/tuningsystem\/kirnbergeriii","kind":"symbol","abstract":[{"type":"text","text":"Kirnberger III (Johann Philipp Kirnberger, 1779)."}]},"doc://IvorTuning/documentation/IvorTuning/WellTemperament":{"type":"topic","navigatorTitle":[{"text":"WellTemperament","kind":"identifier"}],"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament","abstract":[{"type":"text","text":"A tuning system in which all twelve keys are usable but have distinct tonal characters,"},{"type":"text","text":" "},{"type":"text","text":"achieved by distributing the Pythagorean comma unevenly around the circle of fifths."}],"role":"symbol","title":"WellTemperament","url":"\/documentation\/ivortuning\/welltemperament","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WellTemperament","kind":"identifier"}],"kind":"symbol"},"doc://IvorTuning/documentation/IvorTuning/TuningSystem":{"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem","title":"TuningSystem","role":"symbol","navigatorTitle":[{"text":"TuningSystem","kind":"identifier"}],"type":"topic","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TuningSystem","kind":"identifier"}],"url":"\/documentation\/ivortuning\/tuningsystem","kind":"symbol","abstract":[{"type":"text","text":"A type that describes a musical tuning system."}]}}}