ind":"content","content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Four fifths — C→G, G→D, D→A, and A→E — are each narrowed by ¼ of the syntonic"},{"type":"text","text":" "},{"type":"text","text":"comma, equal to ⁴√5 ≈ 696.578 cents. One fifth — F♯→C♯ — is narrowed by one"},{"type":"text","text":" "},{"type":"text","text":"schisma (32805:32768), equal to 16384:10935 ≈ 699.977 cents. The remaining seven"},{"type":"text","text":" "},{"type":"text","text":"fifths are pure (3:2). The circle closes exactly because one syntonic comma times"},{"type":"text","text":" "},{"type":"text","text":"one schisma equals one Pythagorean comma."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The four quarter-comma fifths make C–E a pure major third (5:4). Published in"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Die Kunst des reinen Satzes in der Musik"}]},{"type":"text","text":", Part II."}],"type":"paragraph"}]}],"sections":[],"references":{"doc://IvorTuning/documentation/IvorTuning/TuningSystem":{"navigatorTitle":[{"text":"TuningSystem","kind":"identifier"}],"type":"topic","role":"symbol","title":"TuningSystem","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem","abstract":[{"text":"A type that describes a musical tuning system.","type":"text"}],"url":"\/documentation\/ivortuning\/tuningsystem","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TuningSystem","kind":"identifier"}],"kind":"symbol"},"doc://IvorTuning/documentation/IvorTuning":{"abstract":[{"text":"Musical pitch, interval, and tuning system types.","type":"text"}],"url":"\/documentation\/ivortuning","kind":"symbol","type":"topic","role":"collection","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning","title":"IvorTuning"},"doc://IvorTuning/documentation/IvorTuning/TuningSystem/kirnbergerIII":{"type":"topic","role":"symbol","title":"kirnbergerIII","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem\/kirnbergerIII","abstract":[{"type":"text","text":"Kirnberger III (Johann Philipp Kirnberger, 1779)."}],"url":"\/documentation\/ivortuning\/tuningsystem\/kirnbergeriii","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"kirnbergerIII","kind":"identifier"},{"text":": ","kind":"text"},{"text":"WellTemperament","kind":"typeIdentifier","preciseIdentifier":"s:10IvorTuning15WellTemperamentV"}],"conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"type":"codeVoice","code":"Self"},{"type":"text","text":" is "},{"type":"codeVoice","code":"WellTemperament"},{"type":"text","text":"."}]},"kind":"symbol"},"doc://IvorTuning/documentation/IvorTuning/WellTemperament":{"abstract":[{"text":"A tuning system in which all twelve keys are usable but have distinct tonal characters,","type":"text"},{"text":" ","type":"text"},{"text":"achieved by distributing the Pythagorean comma unevenly around the circle of fifths.","type":"text"}],"url":"\/documentation\/ivortuning\/welltemperament","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WellTemperament","kind":"identifier"}],"kind":"symbol","type":"topic","role":"symbol","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament","title":"WellTemperament","navigatorTitle":[{"text":"WellTemperament","kind":"identifier"}]}}}