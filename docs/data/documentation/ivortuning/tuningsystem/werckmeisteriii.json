xt":"— each equal to 2^(15\/4)\/9 ≈ 696.090 cents. The remaining eight fifths are pure"},{"text":" ","type":"text"},{"text":"(3:2). The circle closes exactly.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is the most historically cited well temperament, often associated with"},{"type":"text","text":" "},{"type":"text","text":"Bach’s Well-Tempered Clavier."}]}],"kind":"content"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"kind":"symbol","identifier":{"url":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem\/werckmeisterIII","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Werckmeister III (Andreas Werckmeister, 1691)."}],"references":{"doc://IvorTuning/documentation/IvorTuning":{"type":"topic","abstract":[{"text":"Musical pitch, interval, and tuning system types.","type":"text"}],"title":"IvorTuning","kind":"symbol","role":"collection","url":"\/documentation\/ivortuning","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning"},"doc://IvorTuning/documentation/IvorTuning/TuningSystem/werckmeisterIII":{"abstract":[{"text":"Werckmeister III (Andreas Werckmeister, 1691).","type":"text"}],"role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"werckmeisterIII"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:10IvorTuning15WellTemperamentV","text":"WellTemperament"}],"conformance":{"constraints":[{"type":"codeVoice","code":"Self"},{"type":"text","text":" is "},{"type":"codeVoice","code":"WellTemperament"},{"type":"text","text":"."}],"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]},"url":"\/documentation\/ivortuning\/tuningsystem\/werckmeisteriii","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem\/werckmeisterIII","title":"werc