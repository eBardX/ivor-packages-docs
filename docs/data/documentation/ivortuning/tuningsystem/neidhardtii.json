{"abstract":[{"type":"text","text":"Neidhardt II (“Small City”; Johann Georg Neidhardt, 1724)."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem\/neidhardtII"},"metadata":{"roleHeading":"Type Property","extendedModule":"IvorTuning","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"neidhardtII","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:10IvorTuning15WellTemperamentV","text":"WellTemperament","kind":"typeIdentifier"}],"externalID":"s:10IvorTuning0B6SystemPA2A15WellTemperamentVRszrlE11neidhardtIIAEvpZ","symbolKind":"property","conformance":{"constraints":[{"type":"codeVoice","code":"Self"},{"type":"text","text":" is "},{"type":"codeVoice","code":"WellTemperament"},{"type":"text","text":"."}],"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]},"title":"neidhardtII","role":"symbol","modules":[{"name":"IvorTuning"}]},"hierarchy":{"paths":[["doc:\/\/IvorTuning\/documentation\/IvorTuning","doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem"]]},"variants":[{"paths":["\/documentation\/ivortuning\/tuningsystem\/neidhardtii"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","primaryContentSections":[{"declarations":[{"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"neidhardtII","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:10IvorTuning15WellTemperamentV","text":"WellTemperament","kind":"typeIdentifier","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament"},{"text":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Three fifths — C→G, G→D, D→A — are each narrowed by ⅙ of the Pythagorean comma"},{"type":"text","text":" "},{"type":"text","text":"(≈ 698.045 cents). Six fifths — A→E, B→F♯, F♯→C♯, C♯→A♭, B♭→F, F→C — are each"},{"type":"text","text":" "},{"type":"text","text":"narrowed by 1\/12 of the Pythagorean comma (≈ 700.000 cents). The remaining three"},{"type":"text","text":" "},{"type":"text","text":"fifths — E→B, A♭→E♭, E♭→B♭ — are pure. The circle closes exactly:"},{"type":"text","text":" "},{"type":"text","text":"3×(1\/6) + 6×(1\/12) = 1 Pythagorean comma."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"From "},{"inlineContent":[{"text":"Sectio Canonis Harmonici","type":"text"}],"type":"emphasis"},{"type":"text","text":" (Königsberg, 1724). Neidhardt relabeled this"},{"type":"text","text":" "},{"type":"text","text":"specification “Large City” in his 1732 revision."}]}]}],"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"references":{"doc://IvorTuning/documentation/IvorTuning/WellTemperament":{"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"WellTemperament"}],"url":"\/documentation\/ivortuning\/welltemperament","abstract":[{"text":"A tuning system in which all twelve keys are usable but have distinct tonal characters,","type":"text"},{"text":" ","type":"text"},{"text":"achieved by distributing the Pythagorean comma unevenly around the circle of fifths.","type":"text"}],"title":"WellTemperament","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"WellTemperament"}],"type":"topic","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament"},"doc://IvorTuning/documentation/IvorTuning":{"kind":"symbol","url":"\/documentation\/ivortuning","abstract":[{"type":"text","text":"Musical pitch, interval, and tuning system types."}],"title":"IvorTuning","role":"collection","type":"topic","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning"},"doc://IvorTuning/documentation/IvorTuning/TuningSystem/neidhardtII":{"abstract":[{"type":"text","text":"Neidhardt II (“Small City”; Johann Georg Neidhardt, 1724)."}],"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem\/neidhardtII","type":"topic","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"neidhardtII","kind":"identifier"},{"text":": ","kind":"text"},{"text":"WellTemperament","preciseIdentifier":"s:10IvorTuning15WellTemperamentV","kind":"typeIdentifier"}],"url":"\/documentation\/ivortuning\/tuningsystem\/neidhardtii","kind":"symbol","conformance":{"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"type":"codeVoice","code":"Self"},{"type":"text","text":" is "},{"type":"codeVoice","code":"WellTemperament"},{"type":"text","text":"."}],"availabilityPrefix":[{"type":"text","text":"Available when"}]},"title":"neidhardtII","role":"symbol"},"doc://IvorTuning/documentation/IvorTuning/TuningSystem":{"kind":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"TuningSystem"}],"url":"\/documentation\/ivortuning\/tuningsystem","abstract":[{"text":"A type that describes a musical tuning system.","type":"text"}],"title":"TuningSystem","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"TuningSystem"}],"type":"topic","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem"}}}