{"metadata":{"symbolKind":"property","roleHeading":"Type Property","extendedModule":"IvorTuning","modules":[{"name":"IvorTuning"}],"title":"neidhardtII","fragments":[{"kind":"keyword","text":"static"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"neidhardtII","kind":"identifier"},{"text":": ","kind":"text"},{"text":"WellTemperament","kind":"typeIdentifier","preciseIdentifier":"s:10IvorTuning15WellTemperamentV"}],"conformance":{"constraints":[{"type":"codeVoice","code":"Self"},{"type":"text","text":" is "},{"type":"codeVoice","code":"WellTemperament"},{"type":"text","text":"."}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"availabilityPrefix":[{"type":"text","text":"Available when"}]},"role":"symbol","externalID":"s:10IvorTuning0B6SystemPA2A15WellTemperamentVRszrlE11neidhardtIIAEvpZ"},"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"text":"Neidhardt II (“Small City”; Johann Georg Neidhardt, 1724).","type":"text"}],"variants":[{"paths":["\/documentation\/ivortuning\/tuningsystem\/neidhardtii"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/IvorTuning\/documentation\/IvorTuning","doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem"]]},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"neidhardtII"},{"text":": ","kind":"text"},{"text":"WellTemperament","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament","preciseIdentifier":"s:10IvorTuning15WellTemperamentV","kind":"typeIdentifier"},{"text":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Three fifths — C→G, G→D, D→A — are each narrowed by ⅙ of the Pythagorean comma"},{"type":"text","text":" "},{"type":"text","text":"(≈ 698.045 cents). Six fifths — A→E, B→F♯, F♯→C♯, C♯→A♭, B♭→F, F→C — are each"},{"type":"text","text":" "},{"text":"narrowed by 1\/12 of the Pythagorean comma (≈ 700.000 cents). The remaining three","type":"text"},{"text":" ","type":"text"},{"text":"fifths — E→B, A♭→E♭, E♭→B♭ — are pure. The circle closes exactly:","type":"text"},{"text":" ","type":"text"},{"text":"3×(1\/6) + 6×(1\/12) = 1 Pythagorean comma.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"From "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Sectio Canonis Harmonici"}]},{"text":" (Königsberg, 1724). Neidhardt relabeled this","type":"text"},{"text":" ","type":"text"},{"text":"specification “Large City” in his 1732 revision.","type":"text"}],"type":"paragraph"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem\/neidhardtII"},"references":{"doc://IvorTuning/documentation/IvorTuning/WellTemperament":{"abstract":[{"text":"A tuning system in which all twelve keys are usable but have distinct tonal characters,","type":"text"},{"text":" ","type":"text"},{"text":"achieved by distributing the Pythagorean comma unevenly around the circle of fifths.","type":"text"}],"role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"WellTemperament"}],"url":"\/documentation\/ivortuning\/welltemperament","navigatorTitle":[{"kind":"identifier","text":"WellTemperament"}],"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament","title":"WellTemperament","type":"topic"},"doc://IvorTuning/documentation/IvorTuning/TuningSystem":{"url":"\/documentation\/ivortuning\/tuningsystem","type":"topic","kind":"symbol","abstract":[{"text":"A type that describes a musical tuning system.