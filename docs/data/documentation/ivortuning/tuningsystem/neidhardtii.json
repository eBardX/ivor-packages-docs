{"abstract":[{"text":"Neidhardt II (“Small City”; Johann Georg Neidhardt, 1724).","type":"text"}],"hierarchy":{"paths":[["doc:\/\/IvorTuning\/documentation\/IvorTuning","doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem"]]},"metadata":{"extendedModule":"IvorTuning","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"neidhardtII","kind":"identifier"},{"text":": ","kind":"text"},{"text":"WellTemperament","kind":"typeIdentifier","preciseIdentifier":"s:10IvorTuning15WellTemperamentV"}],"roleHeading":"Type Property","externalID":"s:10IvorTuning0B6SystemPA2A15WellTemperamentVRszrlE11neidhardtIIAEvpZ","role":"symbol","modules":[{"name":"IvorTuning"}],"symbolKind":"property","title":"neidhardtII","conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"constraints":[{"code":"Self","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"WellTemperament","type":"codeVoice"},{"text":".","type":"text"}]}},"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"neidhardtII","kind":"identifier"},{"text":": ","kind":"text"},{"text":"WellTemperament","kind":"typeIdentifier","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament","preciseIdentifier":"s:10IvorTuning15WellTemperamentV"},{"text":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"platforms":["macOS"]}]},{"content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"Three fifths — C→G, G→D, D→A — are each narrowed by ⅙ of the Pythagorean comma","type":"text"},{"text":" ","type":"text"},{"text":"(≈ 698.045 cents). Six fifths — A→E, B→F♯, F♯→C♯, C♯→A♭, B♭→F, F→C — are each","type":"text"},{"text":" ","type":"text"},{"text":"narrowed by 1\/12 of the Pythagorean comma (≈ 700.000 cents). The remaining three","type":"text"},{"text":" ","type":"text"},{"text":"fifths — E→B, A♭→E♭, E♭→B♭ — are pure. The circle closes exactly:","type":"text"},{"text":" ","type":"text"},{"text":"3×(1\/6) + 6×(1\/12) = 1 Pythagorean comma.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"From ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"Sectio Canonis Harmonici","type":"text"}]},{"text":" (Königsberg, 1724). Neidhardt relabeled this","type":"text"},{"text":" ","type":"text"},{"text":"specification “Large City” in his 1732 revision.","type":"text"}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/ivortuning\/tuningsystem\/neidhardtii"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem\/neidhardtII"},"references":{"doc://IvorTuning/documentation/IvorTuning/TuningSystem":{"navigatorTitle":[{"text":"TuningSystem","kind":"identifier"}],"type":"topic","role":"symbol","title":"TuningSystem","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem","abstract":[{"text":"A type that describes a musical tuning system.","type":"text"}],"url":"\/documentation\/ivortuning\/tuningsystem","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TuningSystem","kind":"identifier"}],"kind":"symbol"},"doc://IvorTuning/documentation/IvorTuning/WellTemperament":{"abstract":[{"text":"A tuning system in which all twelve keys are usable but have distinct tonal characters,","type":"text"},{"text":" ","type":"text"},{"text":"achieved by distributing the Pythagorean comma unevenly around the circle of fifths.","type":"text"}],"url":"\/documentation\/ivortuning\/welltemperament","fragments":[{"text":"s