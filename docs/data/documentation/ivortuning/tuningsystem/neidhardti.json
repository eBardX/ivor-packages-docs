ext":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"Four fifths — C→G, G→D, D→A, A→E — are each narrowed by ⅙ of the Pythagorean","type":"text"},{"text":" ","type":"text"},{"text":"comma (≈ 698.045 cents). Four fifths — E→B, B→F♯, A♭→E♭, E♭→B♭ — are each","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"narrowed by 1\/12 of the Pythagorean comma, equal to the equal-temperament fifth"},{"text":" ","type":"text"},{"type":"text","text":"2^(7\/12) ≈ 700.000 cents. The remaining four fifths are pure. The circle closes"},{"type":"text","text":" "},{"type":"text","text":"exactly: 4×(1\/6) + 4×(1\/12) = 1 Pythagorean comma."}]},{"inlineContent":[{"text":"From ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"Sectio Canonis Harmonici","type":"text"}]},{"type":"text","text":" (Königsberg, 1724). Neidhardt relabeled this"},{"type":"text","text":" "},{"type":"text","text":"specification “Small City” in his 1732 revision."}],"type":"paragraph"}],"kind":"content"}],"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://IvorTuning/documentation/IvorTuning/TuningSystem":{"kind":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"TuningSystem"}],"url":"\/documentation\/ivortuning\/tuningsystem","abstract":[{"text":"A type that describes a musical tuning system.","type":"text"}],"title":"TuningSystem","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"TuningSystem"}],"type":"topic","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem"},"doc://IvorTuning/documentation/IvorTuning/TuningSystem/neidhardtI":{"title":"neidhardtI","abstract":[{"type":"text","text":"Neidhardt I (“Village”; Johann Georg Neidhardt, 1724)."}],"kind":"symbol","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem\/neidhardtI","role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"neidhardtI","kind":"identifier"},{"text":": ","kind":"text"},{"text":"WellTemperament","kind":"typeIdentifier","preciseIdentifier":"s:10IvorTuning15WellTemperamentV"}],"conformance":{"conformancePrefix":[{"type":"text","text":"Conforms when"}],"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"type":"codeVoice","code":"Self"},{"type":"text","text":" is "},{"type":"codeVoice","code":"WellTemperament"},{"type":"text","text":"."}]},"type":"topic","url":"\/documentation\/ivortuning\/tuningsystem\/neidhardti"},"doc://IvorTuning/documentation/IvorTuning":{"kind":"symbol","url":"\/documentation\/ivortuning","abstract":[{"type":"text","text":"Musical pitch, interval, and tuning system types."}],"title":"IvorTuning","role":"collection","type":"topic","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning"},"doc://IvorTuning/documentation/IvorTuning/WellTemperament":{"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"WellTemperament"}],"url":"\/documentation\/ivortuning\/welltemperament","abstract":[{"text":"A tuning system in which all twelve keys are usable but have distinct tonal characters,","type":"text"},{"text":" ","type":"text"},{"text":"achieved by distributing the Pythagorean comma unevenly around the circle of fifths.","type":"text"}],"title":"WellTemperament","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"WellTemperament"}],"type":"topic","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament"}}}