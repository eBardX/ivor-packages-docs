Temperament","kind":"identifier"}],"abstract":[{"type":"text","text":"A tuning system in which all twelve keys are usable but have distinct tonal characters,"},{"type":"text","text":" "},{"type":"text","text":"achieved by distributing the Pythagorean comma unevenly around the circle of fifths."}],"title":"WellTemperament"},"doc://IvorTuning/documentation/IvorTuning/TuningSystem/neidhardtI":{"abstract":[{"text":"Neidhardt I (“Village”; Johann Georg Neidhardt, 1724).","type":"text"}],"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem\/neidhardtI","kind":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"neidhardtI"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"WellTemperament","preciseIdentifier":"s:10IvorTuning15WellTemperamentV"}],"title":"neidhardtI","type":"topic","conformance":{"constraints":[{"code":"Self","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"WellTemperament","type":"codeVoice"},{"text":".","type":"text"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"availabilityPrefix":[{"type":"text","text":"Available when"}]},"url":"\/documentation\/ivortuning\/tuningsystem\/neidhardti","role":"symbol"},"doc://IvorTuning/documentation/IvorTuning":{"abstract":[{"text":"Musical pitch, interval, and tuning system types.","type":"text"}],"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning","url":"\/documentation\/ivortuning","title":"IvorTuning","kind":"symbol","role":"collection","type":"topic"}}}