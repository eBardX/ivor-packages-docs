{"abstract":[{"type":"text","text":"Neidhardt I (“Village”; Johann Georg Neidhardt, 1724)."}],"hierarchy":{"paths":[["doc:\/\/IvorTuning\/documentation\/IvorTuning","doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem"]]},"metadata":{"extendedModule":"IvorTuning","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"neidhardtI"},{"kind":"text","text":": "},{"preciseIdentifier":"s:10IvorTuning15WellTemperamentV","kind":"typeIdentifier","text":"WellTemperament"}],"roleHeading":"Type Property","externalID":"s:10IvorTuning0B6SystemPA2A15WellTemperamentVRszrlE10neidhardtIAEvpZ","role":"symbol","modules":[{"name":"IvorTuning"}],"symbolKind":"property","title":"neidhardtI","conformance":{"constraints":[{"type":"codeVoice","code":"Self"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"WellTemperament"},{"text":".","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}]}},"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"neidhardtI"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament","text":"WellTemperament","preciseIdentifier":"s:10IvorTuning15WellTemperamentV"},{"kind":"text","text":" { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Four fifths — C→G, G→D, D→A, A→E — are each narrowed by ⅙ of the Pythagorean","type":"text"},{"text":" ","type":"text"},{"text":"comma (≈ 698.045 cents). Four fifths — E→B, B→F♯, A♭→E♭, E♭→B♭ — are each","type":"text"},{"text":" ","type":"text"},{"text":"narrowed by 1\/12 of the Pythagorean comma, equal to the equal-temperament fifth","type":"text"},{"text":" ","type":"text"},{"text":"2^(7\/12) ≈ 700.000 cents. The remaining four fifths are pure. The circle closes","type":"text"},{"text":" ","type":"text"},{"text":"exactly: 4×(1\/6) + 4×(1\/12) = 1 Pythagorean comma.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"From "},{"type":"emphasis","inlineContent":[{"text":"Sectio Canonis Harmonici","type":"text"}]},{"type":"text","text":" (Königsberg, 1724). Neidhardt relabeled this"},{"type":"text","text":" "},{"type":"text","text":"specification “Small City” in his 1732 revision."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivortuning\/tuningsystem\/neidhardti"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem\/neidhardtI"},"references":{"doc://IvorTuning/documentation/IvorTuning/TuningSystem":{"navigatorTitle":[{"text":"TuningSystem","kind":"identifier"}],"type":"topic","role":"symbol","title":"TuningSystem","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem","abstract":[{"text":"A type that describes a musical tuning system.","type":"text"}],"url":"\/documentation\/ivortuning\/tuningsystem","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TuningSystem","kind":"identifier"}],"kind":"symbol"},"doc://IvorTuning/documentation/IvorTuning":{"abstract":[{"text":"Musical pitch, interval, and tuning system types.","type":"text"}],"url":"\/documentation\/ivortuning","kind":"symbol","type":"topic","role":"collection","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning","title":"IvorTuning"},"doc://IvorTuning/documentation/IvorTuning/WellTemperament":{"abstract":[{"text":"A tuning system in which all twelve keys are usable but have distinct tonal characters,","type":"text"},{"text":" ","type":"text"},{"text":"achieved by distributing the Pythagorean comma unevenly around the circle of fifths.","type":"text"}],"url":"\/documentation\/ivortuning\/welltemperament","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WellTemperament","kind":"identifier"}],"kind":"symbol","type":"topic","role":"symbol","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament","title":"WellTemperament","navigatorTitle":[{"text":"WellTemperament","kind":"identifier"}]},"doc://IvorTuning/documentation/IvorTuning/TuningSystem/neidhardtI":{"abstract":[{"type":"text","text":"Neidhardt I (“Village”; Johann Georg Neidhardt, 1724)."}],"url":"\/documentation\/ivortuning\/tuningsystem\/neidhardti","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"neidhardtI","kind":"identifier"},{"text":": ","kind":"text"},{"text":"WellTemperament","preciseIdentifier":"s:10IvorTuning15WellTemperamentV","kind":"typeIdentifier"}],"kind":"symbol","type":"topic","role":"symbol","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem\/neidhardtI","title":"neidhardtI","conformance":{"constraints":[{"type":"codeVoice","code":"Self"},{"type":"text","text":" is "},{"type":"codeVoice","code":"WellTemperament"},{"type":"text","text":"."}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"availabilityPrefix":[{"type":"text","text":"Available when"}]}}}}