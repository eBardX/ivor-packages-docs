{"abstract":[{"text":"Neidhardt I (“Village”; Johann Georg Neidhardt, 1724).","type":"text"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/IvorTuning\/documentation\/IvorTuning","doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"neidhardtI"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:10IvorTuning15WellTemperamentV","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament","text":"WellTemperament"},{"kind":"text","text":" { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}]}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"inlineContent":[{"type":"text","text":"Four fifths — C→G, G→D, D→A, A→E — are each narrowed by ⅙ of the Pythagorean"},{"type":"text","text":" "},{"type":"text","text":"comma (≈ 698.045 cents). Four fifths — E→B, B→F♯, A♭→E♭, E♭→B♭ — are each"},{"type":"text","text":" "},{"type":"text","text":"narrowed by 1\/12 of the Pythagorean comma, equal to the equal-temperament fifth"},{"type":"text","text":" "},{"type":"text","text":"2^(7\/12) ≈ 700.000 cents. The remaining four fifths are pure. The circle closes"},{"type":"text","text":" "},{"type":"text","text":"exactly: 4×(1\/6) + 4×(1\/12) = 1 Pythagorean comma."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"From "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Sectio Canonis Harmonici"}]},{"type":"text","text":" (Königsberg, 1724). Neidhardt relabeled this"},{"type":"text","text":" "},{"type":"text","text":"specification “Small City” in his 1732 revision."}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivortuning\/tuningsystem\/neidhardti"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem\/neidhardtI"},"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","metadata":{"extendedModule":"IvorTuning","modules":[{"name":"IvorTuning"}],"role":"symbol","title":"neidhardtI","symbolKind":"property","conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"code":"Self","type":"codeVoice"},{"type":"text","text":" is "},{"code":"WellTemperament","type":"codeVoice"},{"type":"text","text":"."}]},"roleHeading":"Type Property","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"neidhardtI","kind":"identifier"},{"text":": ","kind":"text"},{"text":"WellTemperament","kind":"typeIdentifier","preciseIdentifier":"s:10IvorTuning15WellTemperamentV"}],"externalID":"s:10IvorTuning0B6SystemPA2A15WellTemperamentVRszrlE10neidhardtIAEvpZ"},"references":{"doc://IvorTuning/documentation/IvorTuning/TuningSystem":{"url":"\/documentation\/ivortuning\/tuningsystem","type":"topic","kind":"symbol","abstract":[{"text":"A type that describes a musical tuning system.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"TuningSystem"}],"title":"TuningSystem","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"TuningSystem"}],"role":"symbol","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem"},"doc://IvorTuning/documentation/IvorTuning":{"type":"topic","abstract":[{"text":"Musical pitch, interval, and tuning system types.","type":"text"}],"title":"IvorTuning","kind":"symbol","role":"collection","url":"\/documentation\/ivortuning","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning"},"doc://IvorTuning/documentation/IvorTuning/WellTemperament":{"abstract":[{"text":"A tuning system in which all twelve keys are usable but have distinct tonal characters,","type":"text"},{"text":" ","type":"text"},{"text":"achieved by distributing the Pythagorean comma unevenly around the circle of fifths.","type":"text"}],"role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"WellTemperament"}],"url":"\/documentation\/ivortuning\/welltemperament","navigatorTitle":[{"kind":"identifier","text":"WellTemperament"}],"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament","title":"WellTemperament","type":"topic"},"doc://IvorTuning/documentation/IvorTuning/TuningSystem/neidhardtI":{"url":"\/documentation\/ivortuning\/tuningsystem\/neidhardti","type":"topic","kind":"symbol","abstract":[{"text":"Neidhardt I (“Village”; Johann Georg Neidhardt, 1724).","type":"text"}],"title":"neidhardtI","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"neidhardtI","kind":"identifier"},{"text":": ","kind":"text"},{"text":"WellTemperament","kind":"typeIdentifier","preciseIdentifier":"s:10IvorTuning15WellTemperamentV"}],"conformance":{"constraints":[{"type":"codeVoice","code":"Self"},{"type":"text","text":" is "},{"type":"codeVoice","code":"WellTemperament"},{"type":"text","text":"."}],"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]},"role":"symbol","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem\/neidhardtI"}}}