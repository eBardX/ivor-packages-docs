{"abstract":[{"text":"Neidhardt III (“Large City”; Johann Georg Neidhardt, 1724).","type":"text"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/IvorTuning\/documentation\/IvorTuning","doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"neidhardtIII"},{"kind":"text","text":": "},{"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament","preciseIdentifier":"s:10IvorTuning15WellTemperamentV","kind":"typeIdentifier","text":"WellTemperament"},{"kind":"text","text":" { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}]}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Three fifths — C→G, G→D, D→A — are each narrowed by ⅙ of the Pythagorean comma"},{"text":" ","type":"text"},{"text":"(≈ 698.045 cents). Six fifths — A→E, B→F♯, F♯→C♯, C♯→A♭, E♭→B♭, B♭→F — are","type":"text"},{"text":" ","type":"text"},{"text":"each narrowed by 1\/12 of the Pythagorean comma (≈ 700.000 cents). The remaining","type":"text"},{"type":"text","text":" "},{"type":"text","text":"three fifths — E→B, A♭→E♭, F→C — are pure. The circle closes exactly:"},{"type":"text","text":" "},{"type":"text","text":"3×(1\/6) + 6×(1\/12) = 1 Pythagorean comma."}]},{"type":"paragraph","inlineContent":[{"text":"From ","type":"text"},{"inlineContent":[{"type":"text","text":"Sectio Canonis Harmonici"}],"type":"emphasis"},{"text":" (Königsberg, 1724). Differs from ","type":"text"},{"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem\/neidhardtII","type":"reference","isActive":true},{"text":" ","type":"text"},{"text":"only in the placement of the sixth-comma group on the flat side: E♭→B♭ is tempered","type":"text"},{"text":" ","type":"text"},{"text":"here where it is pure in Neidhardt II, and F→C is pure here where it is tempered","type":"text"},{"text":" ","type":"text"},{"text":"in Neidhardt II.","type":"text"}]}]}],"variants":[{"paths":["\/documentation\/ivortuning\/tuningsystem\/neidhardtiii"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem\/neidhardtIII"},"kind":"symbol","schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"extendedModule":"IvorTuning","modules":[{"name":"IvorTuning"}],"role":"symbol","title":"neidhardtIII","symbolKind":"property","conformance":{"constraints":[{"code":"Self","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"WellTemperament","type":"codeVoice"},{"text":".","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}]},"roleHeading":"Type Property","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"neidhardtIII","kind":"identifier"},{"text":": ","kind":"text"},{"text":"WellTemperament","kind":"typeIdentifier","preciseIdentifier":"s:10IvorTuning15WellTemperamentV"}],"externalID":"s:10IvorTuning0B6SystemPA2A15WellTemperamentVRszrlE12neidhardtIIIAEvpZ"},"references":{"doc://IvorTuning/documentation/IvorTuning/WellTemperament":{"abstract":[{"text":"A tuning system in which all twelve keys are usable but have distinct tonal characters,","type":"text"},{"text":" ","type":"text"},{"text":"achieved by distributing the Pythagorean comma unevenly around the circle of fifths.","type":"text"}],"role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"WellTemperament"}],"url":"\/documentation\/ivortuning\/welltemperament","navigatorTitle":[{"kind":"identifier","text":"WellTemperament"}],"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament","title":"WellTemperament","type":"topic"},"doc://IvorTuning/documentation/IvorTuning":{"type":"topic","abstract":[{"text":"Musical pitch, interval, and tuning system types.","type":"text"}],"title":"IvorTuning","kind":"symbol","role":"collection","url":"\/documentation\/ivortuning","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning"},"doc://IvorTuning/documentation/IvorTuning/TuningSystem":{"url":"\/documentation\/ivortuning\/tuningsystem","type":"topic","kind":"symbol","abstract":[{"text":"A type that describes a musical tuning system.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"TuningSystem"}],"title":"TuningSystem","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"TuningSystem"}],"role":"symbol","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem"},"doc://IvorTuning/documentation/IvorTuning/TuningSystem/neidhardtII":{"url":"\/documentation\/ivortuning\/tuningsystem\/neidhardtii","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Neidhardt II (“Small City”; Johann Georg Neidhardt, 1724)."}],"title":"neidhardtII","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"neidhardtII"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:10IvorTuning15WellTemperamentV","text":"WellTemperament"}],"conformance":{"constraints":[{"type":"codeVoice","code":"Self"},{"type":"text","text":" is "},{"type":"codeVoice","code":"WellTemperament"},{"type":"text","text":"."}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"availabilityPrefix":[{"type":"text","text":"Available when"}]},"role":"symbol","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem\/neidhardtII"},"doc://IvorTuning/documentat