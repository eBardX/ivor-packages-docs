r":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Four fifths — C→G, G→D, D→A, and A→E — are each narrowed by 3\/16 of the syntonic","type":"text"},{"text":" ","type":"text"},{"text":"comma, equal to (3\/2)·(80\/81)^(3\/16) ≈ 697.923 cents. Four more fifths — E→B,","type":"text"},{"text":" ","type":"text"},{"text":"B→F♯, B♭→F, and F→C — are each narrowed by (¼ PC − 3\/16 SC) ≈ 1.833 cents,","type":"text"},{"text":" ","type":"text"},{"text":"equal to (3\/2)·(81\/80)^(3\/16)·(2¹⁹\/3¹²)^(−1\/4) ≈ 700.122 cents. The remaining","type":"text"},{"text":" ","type":"text"},{"text":"four fifths are pure (3:2). The circle closes exactly.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Published in ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"Philosophical Transactions of the Royal Society","type":"text"}]},{"text":" 90 (1800).","type":"text"}]}],"kind":"content"}],"sections":[],"references":{"doc://IvorTuning/documentation/IvorTuning":{"abstract":[{"text":"Musical pitch, interval, and tuning system types.","type":"text"}],"url":"\/documentation\/ivortuning","kind":"symbol","type":"topic","role":"collection","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning","title":"IvorTuning"},"doc://IvorTuning/documentation/IvorTuning/TuningSystem":{"navigatorTitle":[{"text":"TuningSystem","kind":"identifier"}],"type":"topic","role":"symbol","title":"TuningSystem","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem","abstract":[{"text":"A type that describes a musical tuning system.","type":"text"}],"url":"\/documentation\/ivortuning\/tuningsystem","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TuningSystem","kind":"identifier"}],"kind":"symbol"},"doc://IvorTuning/documentation/IvorTuning/TuningSystem/youngI":{"type":"topic","role":"symbol","title":"youngI","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem\/youngI","abstract":[{"type":"text","text":"Young I (Thomas Young, 1800)."}],"url":"\/documentation\/ivortuning\/tuningsystem\/youngi","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"youngI","kind":"identifier"},{"text":": ","kind":"text"},{"text":"WellTemperament","kind":"typeIdentifier","preciseIdentifier":"s:10IvorTuning15WellTemperamentV"}],"conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"type":"codeVoice","code":"Self"},{"type":"text","text":" is "},{"type":"codeVoice","code":"WellTemperament"},{"type":"text","text":"."}]},"kind":"symbol"},"doc://IvorTuning/documentation/IvorTuning/WellTemperament":{"abstract":[{"text":"A tuning system in which all twelve keys are usable but have distinct tonal characters,","type":"text"},{"text":" ","type":"text"},{"text":"achieved by distributing the Pythagorean comma unevenly around the circle of fifths.","type":"text"}],"url":"\/documentation\/ivortuning\/welltemperament","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WellTemperament","kind":"identifier"}],"kind":"symbol","type":"topic","role":"symbol","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament","title":"WellTemperament","navigatorTitle":[{"text":"WellTemperament","kind":"identifier"}]}}}