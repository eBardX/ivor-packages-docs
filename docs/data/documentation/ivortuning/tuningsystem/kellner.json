{"abstract":[{"text":"Kellner (Herbert Anton Kellner, 1977).","type":"text"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/IvorTuning\/documentation\/IvorTuning","doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"kellner"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:10IvorTuning15WellTemperamentV","text":"WellTemperament","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament"},{"kind":"text","text":" { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}]}]},{"kind":"content","content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Five fifths — C→G, G→D, D→A, A→E, and B→F♯ — are each narrowed by ⅕ of the"},{"type":"text","text":" "},{"text":"Pythagorean comma, equal to ⁵√(2¹⁴\/3⁷) ≈ 697.654 cents. The remaining seven","type":"text"},{"text":" ","type":"text"},{"text":"fifths are pure (3:2). The circle closes exactly.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Proposed by Kellner as a reconstruction of Bach’s own tuning, published in","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"text":"Das Musikinstrument","type":"text"}],"type":"emphasis"},{"text":" 26 (1977). The choice of five fifths and their positions","type":"text"},{"text":" ","type":"text"},{"text":"mirrors the structure of Werckmeister III while spreading the tempering more evenly.","type":"text"}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/ivortuning\/tuningsystem\/kellner"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem\/kellner"},"metadata":{"extendedModule":"IvorTuning","modules":[{"name":"IvorTuning"}],"role":"symbol","title":"kellner","symbolKind":"property","conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"constraints":[{"type":"codeVoice","code":"Self"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"WellTemperament"},{"text":".","type":"text"}]},"roleHeading":"Type Property","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"kellner","kind":"identifier"},{"text":": ","kind":"text"},{"text":"WellTemperament","kind":"typeIdentifier","preciseIdentifier":"s:10IvorTuning15WellTemperamentV"}],"externalID":"s:10IvorTuning0B6SystemPA2A15WellTemperamentVRszrlE7kellnerAEvpZ"},"references":{"doc://IvorTuning/documentation/IvorTuning/TuningSystem":{"url":"\/documentation\/ivortuning\/tuningsystem","type":"topic","kind":"symbol","abstract":[{"text":"A type that describes a musical tuning system.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"TuningSystem"}],"title":"TuningSystem","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"TuningSystem"}],"role":"symbol","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem"},"doc://IvorTuning/documentation/IvorTuning/TuningSystem/kellner":{"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem\/kellner","title":"kellner","type":"topic","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"kellner","kind":"identifier"},{"text":": ","kind":"text"},{"text":"WellTemperament","kind":"typeIdentifier","preciseIdentifier":"s:10IvorTuning15WellTemperamentV"}],"role":"symbol","conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"code":"Self","type":"codeVoice"},{"type":"text","text":" is "},{"code":"WellTemperament","type":"codeVoice"},{"type":"text","text":"."}]},"kind":"symbol","abstract":[{"type":"text","text":"Kellner (Herbert Anton Kellner, 1977)."}],"url":"\/documentation\/ivortuning\/tuningsystem\/kellner"},"doc://IvorTuning/documentation/IvorTuning/WellTemperament":{"abstract":[{"text":"A tuning system in which all twelve keys are usable but have distinct tonal characters,","type":"text"},{"text":" ","type":"text"},{"text":"achieved by distributing the Pythagorean comma unevenly around the circle of fifths.","type":"text"}],"role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"WellTemperament"}],"url":"\/documentation\/ivortuning\/welltemperament","navigatorTitle":[{"kind":"identifier","text":"WellTemperament"}],"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament","title":"WellTemperament","type":"topic"},"doc://IvorTuning/documentation/IvorTuning":{"type":"topic","abstract":[{"text":"Musical pitch, interval, and tuning system types.","type":"text"}],"title":"IvorTuning","kind":"symbol","role":"collection","url":"\/documentation\/ivortuning","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning"}}}