{"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"conformance":{"constraints":[{"code":"Self","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"WellTemperament","type":"codeVoice"},{"text":".","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}]},"symbolKind":"property","title":"kellner","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"kellner"},{"kind":"text","text":": "},{"preciseIdentifier":"s:10IvorTuning15WellTemperamentV","kind":"typeIdentifier","text":"WellTemperament"}],"extendedModule":"IvorTuning","externalID":"s:10IvorTuning0B6SystemPA2A15WellTemperamentVRszrlE7kellnerAEvpZ","modules":[{"name":"IvorTuning"}],"role":"symbol","roleHeading":"Type Property"},"identifier":{"url":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem\/kellner","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/IvorTuning\/documentation\/IvorTuning","doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem"]]},"abstract":[{"type":"text","text":"Kellner (Herbert Anton Kellner, 1977)."}],"kind":"symbol","primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"kellner"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament","text":"WellTemperament","preciseIdentifier":"s:10IvorTuning15WellTemperamentV"},{"kind":"text","text":" { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"inlineContent":[{"text":"Five fifths — C→G, G→D, D→A, A→E, and B→F♯ — are each narrowed by ⅕ of the","type":"text"},{"text":" ","type":"text"},{"text":"Pythagorean comma, equal to ⁵√(2¹⁴\/3⁷) ≈ 697.654 cents. The remaining seven","type":"text"},{"text":" ","type":"text"},{"text":"fifths are pure (3:2). The circle closes exactly.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Proposed by Kellner as a reconstruction of Bach’s own tuning, published in","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"text":"Das Musikinstrument","type":"text"}],"type":"emphasis"},{"text":" 26 (1977). The choice of five fifths and their positions","type":"text"},{"text":" ","type":"text"},{"text":"mirrors the structure of Werckmeister III while spreading the tempering more evenly.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivortuning\/tuningsystem\/kellner"]}],"sections":[],"references":{"doc://IvorTuning/documentation/IvorTuning":{"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning","title":"IvorTuning","url":"\/documentation\/ivortuning","abstract":[{"text":"Musical pitch, interval, and tuning system types.","type":"text"}],"kind":"symbol","type":"topic","role":"collection"},"doc://IvorTuning/documentation/IvorTuning/TuningSystem/kellner":{"fragments":[{"text":"static","kind":"keyword"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"kellner"},{"kind":"text","text":": "},{"preciseIdentifier":"s:10IvorTuning15WellTemperamentV","text":"WellTemperament","kind":"typeIdentifier"}],"kind":"symbol","type":"topic","url":"\/documentation\/ivortuning\/tuningsystem\/kellner","title":"kellner","role":"symbol","conformance":{"constraints":[{"code":"Self","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"WellTemperament","type":"codeVoice"},{"text":".","type":"text"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"availabilityPrefix":[{"text":"Available when","type":"text"}]},"abstract":[{"type":"text","text":"Kellner (Herbert Anton Kellner, 1977)."}],"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem\/kellner"},"doc://IvorTuning/documentation/IvorTuning/WellTemperament":{"type":"topic","navigatorTitle":[{"text":"WellTemperament","kind":"identifier"}],"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament","abstract":[{"type":"text","text":"A tuning system in which all twelve keys are usable but have distinct tonal characters,"},{"type":"text","text":" "},{"type":"text","text":"achieved by distributing the Pythagorean comma unevenly around the circle of fifths."}],"role":"symbol","title":"WellTemperament","url":"\/documentation\/ivortuning\/welltemperament","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WellTemperament","kind":"identifier"}],"kind":"symbol"},"doc://IvorTuning/documentation/IvorTuning/TuningSystem":{"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem","title":"TuningSystem","role":"symbol","navigatorTitle":[{"text":"TuningSystem","kind":"identifier"}],"type":"topic","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TuningSystem","kind":"identifier"}],"url":"\/documentation\/ivortuning\/tuningsystem","kind":"symbol","abstract":[{"type":"text","text":"A type that describes a musical tuning system."}]}}}