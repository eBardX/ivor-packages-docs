{"sections":[],"kind":"symbol","identifier":{"url":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem\/kellner","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"kellner"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament","text":"WellTemperament","preciseIdentifier":"s:10IvorTuning15WellTemperamentV"},{"kind":"text","text":" { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}]}],"kind":"declarations"},{"content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Five fifths — C→G, G→D, D→A, A→E, and B→F♯ — are each narrowed by ⅕ of the"},{"type":"text","text":" "},{"type":"text","text":"Pythagorean comma, equal to ⁵√(2¹⁴\/3⁷) ≈ 697.654 cents. The remaining seven"},{"type":"text","text":" "},{"type":"text","text":"fifths are pure (3:2). The circle closes exactly."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Proposed by Kellner as a reconstruction of Bach’s own tuning, published in"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Das Musikinstrument"}]},{"type":"text","text":" 26 (1977). The choice of five fifths and their positions"},{"type":"text","text":" "},{"type":"text","text":"mirrors the structure of Werckmeister III while spreading the tempering more evenly."}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"type":"text","text":"Kellner (Herbert Anton Kellner, 1977)."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivortuning\/tuningsystem\/kellner"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"externalID":"s:10IvorTuning0B6SystemPA2A15WellTemperamentVRszrlE7kellnerAEvpZ","conformance":{"constraints":[{"type":"codeVoice","code":"Self"},{"type":"text","text":" is "},{"type":"codeVoice","code":"WellTemperament"},{"type":"text","text":"."}],"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]},"role":"symbol","symbolKind":"property","title":"kellner","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"kellner"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"WellTemperament","preciseIdentifier":"s:10IvorTuning15WellTemperamentV"}],"extendedModule":"IvorTuning","modules":[{"name":"IvorTuning"}],"roleHeading":"Type Property"},"hierarchy":{"paths":[["doc:\/\/IvorTuning\/documentation\/IvorTuning","doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem"]]},"references":{"doc://IvorTuning/documentation/IvorTuning/TuningSystem":{"url":"\/documentation\/ivortuning\/tuningsystem","type":"topic","role":"symbol","kind":"symbol","abstract":[{"text":"A type that describes a musical tuning system.","type":"text"}],"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem","title":"TuningSystem","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TuningSystem","kind":"identifier"}],"navigatorTitle":[{"text":"TuningSystem","kind":"identifier"}]},"doc://IvorTuning/documentation/IvorTuning/WellTemperament":{"role":"symbol","url":"\/documentation\/ivortuning\/welltemperament","navigatorTitle":[{"text":"WellTemperament","kind":"identifier"}],"title":"WellTemperament","kind":"symbol","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament","abstract":[{"type":"text","text":"A tuning system in which all twelve keys are usable but have distinct tonal characters,"},{"type":"text","text":" "},{"type":"text","text":"achieved by distributing the Pythagorean comma unevenly around the circle of fifths."}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WellTemperament","kind":"identifier"}]},"doc://IvorTuning/documentation/IvorTuning/TuningSystem/kellner":{"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem\/kellner","type":"topic","url":"\/documentation\/ivortuning\/tuningsystem\/kellner","abstract":[{"text":"Kellner (Herbert Anton Kellner, 1977).","type":"text"}],"role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"kellner","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:10IvorTuning15WellTemperamentV","text":"WellTemperament","kind":"typeIdentifier"}],"title":"kellner","kind":"symbol","conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"constraints":[{"type":"codeVoice","code":"Self"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"WellTemperament"},{"text":".","type":"text"}]}},"doc://IvorTuning/documentation/IvorTuning":{"kind":"symbol","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning","role":"collection","type":"topic","title":"IvorTuning","abstract":[{"text":"Musical pitch, interval, and tuning system types.","type":"text"}],"url":"\/documentation\/ivortuning"}}}