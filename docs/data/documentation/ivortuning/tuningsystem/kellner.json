type":"heading","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"Five fifths — C→G, G→D, D→A, A→E, and B→F♯ — are each narrowed by ⅕ of the","type":"text"},{"text":" ","type":"text"},{"text":"Pythagorean comma, equal to ⁵√(2¹⁴\/3⁷) ≈ 697.654 cents. The remaining seven","type":"text"},{"text":" ","type":"text"},{"text":"fifths are pure (3:2). The circle closes exactly.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Proposed by Kellner as a reconstruction of Bach’s own tuning, published in","type":"text"},{"text":" ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"Das Musikinstrument","type":"text"}]},{"text":" 26 (1977). The choice of five fifths and their positions","type":"text"},{"text":" ","type":"text"},{"text":"mirrors the structure of Werckmeister III while spreading the tempering more evenly.","type":"text"}]}]}],"sections":[],"references":{"doc://IvorTuning/documentation/IvorTuning/TuningSystem":{"navigatorTitle":[{"text":"TuningSystem","kind":"identifier"}],"type":"topic","role":"symbol","title":"TuningSystem","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem","abstract":[{"text":"A type that describes a musical tuning system.","type":"text"}],"url":"\/documentation\/ivortuning\/tuningsystem","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TuningSystem","kind":"identifier"}],"kind":"symbol"},"doc://IvorTuning/documentation/IvorTuning/WellTemperament":{"abstract":[{"text":"A tuning system in which all twelve keys are usable but have distinct tonal characters,","type":"text"},{"text":" ","type":"text"},{"text":"achieved by distributing the Pythagorean comma unevenly around the circle of fifths.","type":"text"}],"url":"\/documentation\/ivortuning\/welltemperament","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WellTemperament","kind":"identifier"}],"kind":"symbol","type":"topic","role":"symbol","identifie