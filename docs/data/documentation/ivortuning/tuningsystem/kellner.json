{"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","metadata":{"extendedModule":"IvorTuning","conformance":{"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"type":"codeVoice","code":"Self"},{"type":"text","text":" is "},{"code":"WellTemperament","type":"codeVoice"},{"text":".","type":"text"}],"availabilityPrefix":[{"type":"text","text":"Available when"}]},"externalID":"s:10IvorTuning0B6SystemPA2A15WellTemperamentVRszrlE7kellnerAEvpZ","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"kellner"},{"kind":"text","text":": "},{"preciseIdentifier":"s:10IvorTuning15WellTemperamentV","kind":"typeIdentifier","text":"WellTemperament"}],"symbolKind":"property","title":"kellner","role":"symbol","modules":[{"name":"IvorTuning"}],"roleHeading":"Type Property"},"sections":[],"abstract":[{"text":"Kellner (Herbert Anton Kellner, 1977).","type":"text"}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"kellner"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament","text":"WellTemperament","kind":"typeIdentifier","preciseIdentifier":"s:10IvorTuning15WellTemperamentV"},{"kind":"text","text":" { "},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Five fifths — C→G, G→D, D→A, A→E, and B→F♯ — are each narrowed by ⅕ of the"},{"type":"text","text":" "},{"type":"text","text":"Pythagorean comma, equal to ⁵√(2¹⁴\/3⁷) ≈ 697.654 cents. The remaining seven"},{"text":" ","type":"text"},{"text":"fifths are pure (3:2). The circle closes exactly.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Proposed by Kellner as a reconstruction of Bach’s own tuning, published in","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"Das Musikinstrument"}],"type":"emphasis"},{"text":" 26 (1977). The choice of five fifths and their positions","type":"text"},{"text":" ","type":"text"},{"text":"mirrors the structure of Werckmeister III while spreading the tempering more evenly.","type":"text"}]}]}],"hierarchy":{"paths":[["doc:\/\/IvorTuning\/documentation\/IvorTuning","doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem"]]},"identifier":{"url":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem\/kellner","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivortuning\/tuningsystem\/kellner"]}],"references":{"doc://IvorTuning/documentation/IvorTuning/TuningSystem/kellner":{"kind":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"kellner"},{"kind":"text","text":": "},{"preciseIdentifier":"s:10IvorTuning15WellTemperamentV","kind":"typeIdentifier","text":"WellTemperament"}],"url":"\/documentation\/ivortuning\/tuningsystem\/kellner","abstract":[{"text":"Kellner (Herbert Anton Kellner, 1977).","type":"text"}],"title":"kellner","role":"symbol","type":"topic","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem\/kellner","conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"constraints":[{"code":"Self","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"WellTemperament","type":"codeVoice"},{"text":".","type":"text"}]}},"doc://IvorTuning/documentation/IvorTuning/WellTemperament":{"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"WellTemperament"}],"url":"\/documentation\/ivortuning\/welltemperament","abstract":[{"text":"A tuning system in which all twelve keys are usable but have distinct tonal characters,","type":"text"},{"text":" ","type":"text"},{"text":"achieved by distributing the Pythagorean comma unevenly around the circle of fifths.","type":"text"}],"title":"WellTemperament","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"WellTemperament"}],"type":"topic","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament"},"doc://IvorTuning/documentation/IvorTuning":{"kind":"symbol","url":"\/documentation\/ivortuning","abstract":[{"type":"text","text":"Musical pitch, interval, and tuning system types."}],"title":"IvorTuning","role":"collection","type":"topic","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning"},"doc://IvorTuning/documentation/IvorTuning/TuningSystem":{"kind":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"TuningSystem"}],"url":"\/documentation\/ivortuning\/tuningsystem","abstract":[{"text":"A type that describes a musical tuning system.","type":"text"}],"title":"TuningSystem","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"TuningSystem"}],"type":"topic","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem"}}}