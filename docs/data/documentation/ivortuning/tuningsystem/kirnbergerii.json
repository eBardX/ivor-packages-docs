{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem\/kirnbergerII"},"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"type":"codeVoice","code":"Self"},{"type":"text","text":" is "},{"type":"codeVoice","code":"WellTemperament"},{"type":"text","text":"."}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]},"symbolKind":"property","title":"kirnbergerII","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"kirnbergerII"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"WellTemperament","preciseIdentifier":"s:10IvorTuning15WellTemperamentV"}],"extendedModule":"IvorTuning","externalID":"s:10IvorTuning0B6SystemPA2A15WellTemperamentVRszrlE12kirnbergerIIAEvpZ","role":"symbol","modules":[{"name":"IvorTuning"}],"roleHeading":"Type Property"},"hierarchy":{"paths":[["doc:\/\/IvorTuning\/documentation\/IvorTuning","doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem"]]},"abstract":[{"type":"text","text":"Kirnberger II (Johann Philipp Kirnberger, c. 1771)."}],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"kirnbergerII"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:10IvorTuning15WellTemperamentV","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament","text":"WellTemperament"},{"kind":"text","text":" { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}],"platforms":["macOS"],"languages":["swift"]}]},{"content":[{"level":2,"type":"heading","anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Two fifths — D→A and A→E — are each narrowed by ½ of the syntonic comma, equal to"},{"type":"text","text":" "},{"type":"text","text":"√(20\/9) ≈ 691.202 cents. One fifth — F♯→C♯ — is narrowed by one schisma"},{"type":"text","text":" "},{"type":"text","text":"(32805:32768), equal to 16384:10935 ≈ 699.977 cents. The remaining nine fifths are"},{"type":"text","text":" "},{"type":"text","text":"pure (3:2). The circle closes exactly because one syntonic comma times one schisma"},{"type":"text","text":" "},{"type":"text","text":"equals one Pythagorean comma."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The two half-comma fifths are unusually flat, giving C-adjacent keys very pure"},{"type":"text","text":" "},{"type":"text","text":"thirds while keys with many sharps or flats suffer greatly."}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivortuning\/tuningsystem\/kirnbergerii"]}],"sections":[],"references":{"doc://IvorTuning/documentation/IvorTuning":{"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning","title":"IvorTuning","url":"\/documentation\/ivortuning","abstract":[{"text":"Musical pitch, interval, and tuning system types.","type":"text"}],"kind":"symbol","type":"topic","role":"collection"},"doc://IvorTuning/documentation/IvorTuning/TuningSystem":{"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem","title":"TuningSystem","role":"symbol","navigatorTitle":[{"text":"TuningSystem","kind":"identifier"}],"type":"topic","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TuningSystem","kind":"identifier"}],"url":"\/documentation\/ivortuning\/tuningsystem","kind":"symbol","abstract":[{"type":"text","text":"A type that describes a musical tuning system."}]},"doc://IvorTuning/documentation/IvorTuning/WellTemperament":{"type":"topic","navigatorTitle":[{"text":"WellTemperament","kind":"identifier"}],"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament","abstract":[{"type":"text","text":"A tuning system in which all twelve keys are usable but have distinct tonal characters,"},{"type":"text","text":" "},{"type":"text","text":"achieved by distributing the Pythagorean comma unevenly around the circle of fifths."}],"role":"symbol","title":"WellTemperament","url":"\/documentation\/ivortuning\/welltemperament","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WellTemperament","kind":"identifier"}],"kind":"symbol"},"doc://IvorTuning/documentation/IvorTuning/TuningSystem/kirnbergerII":{"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem\/kirnbergerII","title":"kirnbergerII","role":"symbol","conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"constraints":[{"type":"codeVoice","code":"Self"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"WellTemperament"},{"text":".","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}]},"type":"topic","fragments":[{"text":"static","kind":"keyword"},{"kind":"text","text":" "},{"text":"var","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"kirnbergerII"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"WellTemperament","preciseIdentifier":"s:10IvorTuning15WellTemperamentV"}],"url":"\/documentation\/ivortuning\/tuningsystem\/kirnbergerii","abstract":[{"text":"Kirnberger II (Johann Philipp Kirnberger, c. 1771).","type":"text"}],"kind":"symbol"}}}