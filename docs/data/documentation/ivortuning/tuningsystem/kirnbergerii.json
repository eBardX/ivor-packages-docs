{"abstract":[{"type":"text","text":"Kirnberger II (Johann Philipp Kirnberger, c. 1771)."}],"hierarchy":{"paths":[["doc:\/\/IvorTuning\/documentation\/IvorTuning","doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem"]]},"metadata":{"extendedModule":"IvorTuning","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"kirnbergerII","kind":"identifier"},{"text":": ","kind":"text"},{"text":"WellTemperament","preciseIdentifier":"s:10IvorTuning15WellTemperamentV","kind":"typeIdentifier"}],"roleHeading":"Type Property","externalID":"s:10IvorTuning0B6SystemPA2A15WellTemperamentVRszrlE12kirnbergerIIAEvpZ","role":"symbol","modules":[{"name":"IvorTuning"}],"symbolKind":"property","title":"kirnbergerII","conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"constraints":[{"code":"Self","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"WellTemperament","type":"codeVoice"},{"text":".","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}]}},"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"kirnbergerII","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:10IvorTuning15WellTemperamentV","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament","text":"WellTemperament","kind":"typeIdentifier"},{"text":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Two fifths — D→A and A→E — are each narrowed by ½ of the syntonic comma, equal to","type":"text"},{"text":" ","type":"text"},{"text":"√(20\/9) ≈ 691.202 cents. One fifth — F♯→C♯ — is narrowed by one schisma","type":"text"},{"text":" ","type":"text"},{"text":"(32805:32768), equal to 16384:10935 ≈ 699.977 cents. The remaining nine fifths are","type":"text"},{"text":" ","type":"text"},{"text":"pure (3:2). The circle closes exactly because one syntonic comma times one schisma","type":"text"},{"text":" ","type":"text"},{"text":"equals one Pythagorean comma.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The two half-comma fifths are unusually flat, giving C-adjacent keys very pure","type":"text"},{"text":" ","type":"text"},{"text":"thirds while keys with many sharps or flats suffer greatly.","type":"text"}]}]}],"variants":[{"paths":["\/documentation\/ivortuning\/tuningsystem\/kirnbergerii"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem\/kirnbergerII"},"references":{"doc://IvorTuning/documentation/IvorTuning/TuningSystem/kirnbergerII":{"abstract":[{"type":"text","text":"Kirnberger II (Johann Philipp Kirnberger, c. 1771)."}],"url":"\/documentation\/ivortuning\/tuningsystem\/kirnbergerii","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"kirnbergerII"},{"kind":"text","text":": "},{"preciseIdentifier":"s:10IvorTuning15WellTemperamentV","kind":"typeIdentifier","text":"WellTemperament"}],"kind":"symbol","type":"topic","role":"symbol","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem\/kirnbergerII","title":"kirnbergerII","conformance":{"constraints":[{"type":"codeVoice","code":"Self"},{"type":"text","text":" is "},{"type":"codeVoice","code":"WellTemperament"},{"type":"text","text":"."}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"availabilityPrefix":[{"type":"text","text":"Available when"}]}},"doc:/