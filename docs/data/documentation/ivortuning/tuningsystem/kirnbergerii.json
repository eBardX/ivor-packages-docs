/IvorTuning/documentation/IvorTuning/WellTemperament":{"abstract":[{"text":"A tuning system in which all twelve keys are usable but have distinct tonal characters,","type":"text"},{"text":" ","type":"text"},{"text":"achieved by distributing the Pythagorean comma unevenly around the circle of fifths.","type":"text"}],"role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"WellTemperament"}],"url":"\/documentation\/ivortuning\/welltemperament","navigatorTitle":[{"kind":"identifier","text":"WellTemperament"}],"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament","title":"WellTemperament","type":"topic"},"doc://IvorTuning/documentation/IvorTuning/TuningSystem":{"url":"\/documentation\/ivortuning\/tuningsystem","type":"topic","kind":"symbol","abstract":[{"text":"A type that describes a musical tuning system.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"TuningSystem"}],"title":"TuningSystem","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"TuningSystem"}],"role":"symbol","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem"},"doc://IvorTuning/documentation/IvorTuning":{"type":"topic","abstract":[{"text":"Musical pitch, interval, and tuning system types.","type":"text"}],"title":"IvorTuning","kind":"symbol","role":"collection","url":"\/documentation\/ivortuning","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning"}}}