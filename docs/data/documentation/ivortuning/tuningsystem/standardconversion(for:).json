fier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/PitchClass","preciseIdentifier":"s:10IvorTuning10PitchClassV"},{"text":" : ","kind":"text"},{"text":"DirectedInterval","kind":"typeIdentifier","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/DirectedInterval","preciseIdentifier":"s:10IvorTuning16DirectedIntervalV"},{"text":"<","kind":"text"},{"text":"Ratio","kind":"typeIdentifier","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/Ratio","preciseIdentifier":"s:10IvorTuning5RatioV"},{"text":">]?","kind":"text"}],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"text":"The reference pitch and its associated frequency.","type":"text"}],"type":"paragraph"}],"name":"standard"}]},{"content":[{"text":"Return Value","type":"heading","level":2,"anchor":"return-value"},{"type":"paragraph","inlineContent":[{"text":"A 35-entry dictionary, or ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" if standard notation is not supported.","type":"text"}]}],"kind":"content"},{"content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" if this tuning system does not support standard pitch notation (e.g., because","type":"text"},{"text":" ","type":"text"},{"text":"its interval of equivalence is not 2:1, or it has more than 35 distinct pitch classes per","type":"text"},{"text":" ","type":"text"},{"text":"octave). Otherwise returns a dictionary with exactly 35 entries — one per pitch class.","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Convention for each entry:","type":"text"}],"type":"strong"},{"text":" the directed frequency ratio from ","type":"text"},{"code":"standard","type":"codeVoice"},{"text":"’s reference","type":"text"},{"text":" ","type":"text"},{"text":"pitch to the instance of that pitch class within the ","type":"text"},{"inlineContent":[{"text":"same SPN octave","type":"text"}],"type":"strong"},{"text":" as the reference.","type":"text"},{"text":" ","type":"text"},{"text":"Direction is ","type":"text"},{"code":".ascending","type":"codeVoice"},{"text":" if that same-octave instance lies above the reference,","type":"text"},{"text":" ","type":"text"},{"code":".descending","type":"codeVoice"},{"text":" if below, and ","type":"text"},{"code":".same","type":"codeVoice"},{"text":" if it is the reference (or enharmonically equivalent).","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For example, with A4 as the reference, every entry corresponds to a pitch in the range","type":"text"},{"text":" ","type":"text"},{"text":"[C4, B4]. B maps to the ascending ratio to B4 — not to the nearer descending ratio to B3.","type":"text"},{"text":" ","type":"text"},{"text":"This same-SPN-octave rule holds for all pitch classes, regardless of chromatic distance","type":"text"},{"text":" ","type":"text"},{"text":"from the reference, and regardless of which pitch class is chosen as the reference.","type":"text"}]}],"kind":"content"}],"identifier":{"url":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem\/standardConversion(for:)","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/ivortuning\/tuningsystem\/standardconversion(for:)"],"traits":[{"interfaceLanguage":"swift"}]}],"defaultImplementationsSections":[{"title":"TuningSystem Implementations","identifiers":["doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem\/standardConversion(for:)-7xdwh"],"anchor":"TuningSystem-Implementations"}],"references":{"doc://IvorTuning/documentation/IvorTuning/TuningSystem":{"url":"\/documentation\/ivortuning\/tuningsystem","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"text":"TuningSystem","kind":"identifier"}],"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem","type":"topic","navigatorTitle":[{"text":"TuningSystem","kind":"identifier"}],"abstract":[{"type":"text","text":"A type that describes a musical tuning system."}],"title":"TuningSystem"},"doc://IvorTuning/documentation/IvorTuning/PitchClass":{"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/PitchClass","abstract":[{"text":"A pitch class in standard notation, identified by a diatonic letter and an accidental.","type":"text"},{"text":" ","type":"text"},{"text":"There are exactly 35 pitch classes (7 letters × 5 accidentals). Enharmonically equivalent","type":"text"},{"text":" ","type":"text"},{"text":"pitch classes (e.g., ","type":"text"},{"code":"C♯","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"D♭","type":"codeVoice"},{"text":") are distinct values; tuning systems with more than 35","type":"text"},{"text":" ","type":"text"},{"text":"distinct pitches per octave cannot be fully represented using standard notation.","type":"text"}],"title":"PitchClass","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PitchClass"}],"navigatorTitle":[{"text":"PitchClass","kind":"identifier"}],"kind":"symbol","role":"symbol","url":"\/documentation\/ivortuning\/pitchclass"},"doc://IvorTuning/documentation/IvorTuning":{"abstract":[{"text":"Musical pitch, interval, and tuning system types.","type":"text"}],"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning","url":"\/documentation\/ivortuning","title":"IvorTuning","kind":"symbol","role":"collection","type":"topic"},"doc://IvorTuning/documentation/IvorTuning/DirectedInterval":{"url":"\/documentation\/ivortuning\/directedinterval","role":"symbol","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedInterval","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/DirectedInterval","navigatorTitle":[{"text":"DirectedInterval","kind":"identifier"}],"abstract":[{"type":"text","text":"A musical interval combined with a direction, indicating whether it moves"},{"type":"text","text":" "},{"type":"text","text":"upward, downward, or stays in place."}],"title":"DirectedInterval"},"doc://IvorTuning/documentation/IvorTuning/Ratio":{"url":"\/documentation\/ivortuning\/ratio","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/Ratio","title":"Ratio","abstract":[{"text":"A frequency ratio representing a musical interval.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Ratio","kind":"identifier"}],"navigatorTitle":[{"text":"Ratio","kind":"identifier"}],"kind":"symbol","role":"symbol","type":"topic"},"doc://IvorTuning/documentation/IvorTuning/TuningSystem/standardConversion(for:)-7xdwh":{"abstract":[{"text":"Returns ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" by default; override to support standard pitch notation.","type":"text"}],"title":"standardConversion(for:)","url":"\/documentation\/ivortuning\/tuningsystem\/standardconversion(for:)-7xdwh","kind":"symbol","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"standardConversion","kind":"identifier"},{"text":"(","kind":"text"},{"text":"for","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:10IvorTuning13PitchStandardV","text":"PitchStandard","kind":"typeIdentifier"},{"text":") -> [","kind":"text"},{"preciseIdentifier":"s:10IvorTuning10PitchClassV","text":"PitchClass","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:10IvorTuning16DirectedIntervalV","text":"DirectedInterval","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:10IvorTuning5RatioV","text":"Ratio","kind":"typeIdentifier"},{"text":">]?","kind":"text"}],"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem\/standardConversion(for:)-7xdwh","type":"topic"},"doc://IvorTuning/documentation/IvorTuning/TuningSystem/standardConve