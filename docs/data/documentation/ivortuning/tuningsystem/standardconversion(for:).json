ypeIdentifier"},{"text":"<","kind":"text"},{"text":"Ratio","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/Ratio","preciseIdentifier":"s:10IvorTuning5RatioV","kind":"typeIdentifier"},{"text":">]?","kind":"text"}]}]},{"parameters":[{"name":"standard","content":[{"inlineContent":[{"text":"The reference pitch and its associated frequency.","type":"text"}],"type":"paragraph"}]}],"kind":"parameters"},{"content":[{"text":"Return Value","level":2,"anchor":"return-value","type":"heading"},{"inlineContent":[{"text":"A 35-entry dictionary, or ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" if standard notation is not supported.","type":"text"}],"type":"paragraph"}],"kind":"content"},{"mentions":["doc:\/\/IvorTuning\/documentation\/IvorTuning\/UsingIvorTuning"],"kind":"mentions"},{"content":[{"type":"heading","anchor":"discussion","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Returns "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" if this tuning system does not support standard pitch notation (e.g., because"},{"type":"text","text":" "},{"type":"text","text":"its interval of equivalence is not 2:1, or it has more than 35 distinct pitch classes per"},{"type":"text","text":" "},{"text":"octave). Otherwise returns a dictionary with exactly 35 entries — one per pitch class.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Convention for each entry:"}]},{"type":"text","text":" the directed frequency ratio from "},{"code":"standard","type":"codeVoice"},{"type":"text","text":"’s reference"},{"type":"text","text":" "},{"type":"text","text":"pitch to the instance of that pitch class within the "},{"inlineContent":[{"type":"text","text":"same SPN octave"}],"type":"strong"},{"text":" as the reference.","type":"text"},{"text":" ","type":"text"},{"text":"Direction is ","type":"text"},{"code":".ascending","type":"codeVoice"},{"text":" if that same