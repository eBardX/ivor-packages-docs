classes per"},{"type":"text","text":" "},{"type":"text","text":"octave). Otherwise returns a dictionary with exactly 35 entries — one per pitch class."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Convention for each entry:","type":"text"}]},{"type":"text","text":" the directed frequency ratio from "},{"type":"codeVoice","code":"standard"},{"type":"text","text":"’s reference"},{"type":"text","text":" "},{"type":"text","text":"pitch to the instance of that pitch class within the "},{"type":"strong","inlineContent":[{"text":"same SPN octave","type":"text"}]},{"type":"text","text":" as the reference."},{"type":"text","text":" "},{"type":"text","text":"Direction is "},{"type":"codeVoice","code":".ascending"},{"type":"text","text":" if that same-octave instance lies above the reference,"},{"type":"text","text":" "},{"type":"codeVoice","code":".descending"},{"type":"text","text":" if below, and "},{"type":"codeVoice","code":".same"},{"type":"text","text":" if it is the reference (or enharmonically equivalent)."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For example, with A4 as the reference, every entry corresponds to a pitch in the range"},{"type":"text","text":" "},{"type":"text","text":"[C4, B4]. B maps to the ascending ratio to B4 — not to the nearer descending ratio to B3."},{"type":"text","text":" "},{"type":"text","text":"This same-SPN-octave rule holds for all pitch classes, regardless of chromatic distance"},{"type":"text","text":" "},{"type":"text","text":"from the reference, and regardless of which pitch class is chosen as the reference."}],"type":"paragraph"}]}],"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://IvorTuning/documentation/IvorTuning/PitchDirection":{"kind":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"PitchDirection"}],"url":"\/documentation\/ivortuning\/pitchdirection","abstract":[{"type":"te