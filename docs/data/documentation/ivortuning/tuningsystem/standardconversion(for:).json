"text"},{"text":"pitch to the instance of that pitch class within the ","type":"text"},{"type":"strong","inlineContent":[{"text":"same SPN octave","type":"text"}]},{"text":" as the reference.","type":"text"},{"text":" ","type":"text"},{"text":"Direction is ","type":"text"},{"type":"codeVoice","code":".ascending"},{"text":" if that same-octave instance lies above the reference,","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":".descending"},{"text":" if below, and ","type":"text"},{"type":"codeVoice","code":".same"},{"text":" if it is the reference (or enharmonically equivalent).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For example, with A4 as the reference, every entry corresponds to a pitch in the range","type":"text"},{"text":" ","type":"text"},{"text":"[C4, B4]. B maps to the ascending ratio to B4 — not to the nearer descending ratio to B3.","type":"text"},{"text":" ","type":"text"},{"text":"This same-SPN-octave rule holds for all pitch classes, regardless of chromatic distance","type":"text"},{"text":" ","type":"text"},{"text":"from the reference, and regardless of which pitch class is chosen as the reference.","type":"text"}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/ivortuning\/tuningsystem\/standardconversion(for:)"],"traits":[{"interfaceLanguage":"swift"}]}],"defaultImplementationsSections":[{"title":"TuningSystem Implementations","identifiers":["doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem\/standardConversion(for:)-7xdwh"],"anchor":"TuningSystem-Implementations"}],"identifier":{"url":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem\/standardConversion(for:)","interfaceLanguage":"swift"},"references":{"doc://IvorTuning/documentation/IvorTuning":{"abstract":[{"text":"Musical pitch, interval, and tuning system types.","type":"text"}],"url":"\/documentation\/ivortuning","kind":"symbol","type":"topic","role":"collection","identifier":"doc:\/\/IvorTuning\/documentation\/Iv