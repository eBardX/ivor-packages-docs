{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem\/youngII"},"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"conformance":{"constraints":[{"type":"codeVoice","code":"Self"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"WellTemperament"},{"text":".","type":"text"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"availabilityPrefix":[{"type":"text","text":"Available when"}]},"symbolKind":"property","title":"youngII","fragments":[{"text":"static","kind":"keyword"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"youngII"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:10IvorTuning15WellTemperamentV","text":"WellTemperament"}],"extendedModule":"IvorTuning","externalID":"s:10IvorTuning0B6SystemPA2A15WellTemperamentVRszrlE7youngIIAEvpZ","role":"symbol","modules":[{"name":"IvorTuning"}],"roleHeading":"Type Property"},"hierarchy":{"paths":[["doc:\/\/IvorTuning\/documentation\/IvorTuning","doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem"]]},"abstract":[{"text":"Young II (Thomas Young, 1800).","type":"text"}],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"youngII","kind":"identifier"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament","preciseIdentifier":"s:10IvorTuning15WellTemperamentV","text":"WellTemperament","kind":"typeIdentifier"},{"text":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"languages":["swift"]}]},{"content":[{"level":2,"type":"heading","anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Six consecutive fifths from C to F♯ — C→G, G→D, D→A, A→E, E→B, B→F♯ — are each"},{"text":" ","type":"text"},{"text":"narrowed by ⅙ of the Pythagorean comma, equal to 2^(13\/6)\/3 ≈ 698.045 cents.","type":"text"},{"text":" ","type":"text"},{"text":"The remaining six fifths are pure (3:2). The circle closes exactly.","type":"text"}]},{"inlineContent":[{"text":"The tempered fifth size is identical to Vallotti, but the tempered segment runs","type":"text"},{"text":" ","type":"text"},{"text":"from C through F♯ (six sharps) rather than from F through B (six naturals\/flats).","type":"text"},{"text":" ","type":"text"},{"text":"Published in ","type":"text"},{"inlineContent":[{"type":"text","text":"Philosophical Transactions of the Royal Society"}],"type":"emphasis"},{"type":"text","text":" 90 (1800)."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivortuning\/tuningsystem\/youngii"]}],"sections":[],"references":{"doc://IvorTuning/documentation/IvorTuning/TuningSystem/youngII":{"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem\/youngII","title":"youngII","role":"symbol","conformance":{"constraints":[{"code":"Self","type":"codeVoice"},{"type":"text","text":" is "},{"code":"WellTemperament","type":"codeVoice"},{"type":"text","text":"."}],"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]},"type":"topic","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"youngII","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:10IvorTuning15WellTemperamentV","text":"WellTemperament","kind":"typeIdentifier"}],"url":"\/documentation\/ivortuning\/tuningsystem\/youngii","kind":"symbol","abstract":[{"type":"text","text":"Young II (Thomas Young, 1800)."}]},"doc://IvorTuning/documentation/IvorTuning":{"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning","title":"IvorTuning","url":"\/documentation\/ivortuning","abstract":[{"text":"Musical pitch, interval, and tuning system types.","type":"text"}],"kind":"symbol","type":"topic","role":"collection"},"doc://IvorTuning/documentation/IvorTuning/WellTemperament":{"type":"topic","navigatorTitle":[{"text":"WellTemperament","kind":"identifier"}],"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament","abstract":[{"type":"text","text":"A tuning system in which all twelve keys are usable but have distinct tonal characters,"},{"type":"text","text":" "},{"type":"text","text":"achieved by distributing the Pythagorean comma unevenly around the circle of fifths."}],"role":"symbol","title":"WellTemperament","url":"\/documentation\/ivortuning\/welltemperament","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WellTemperament","kind":"identifier"}],"kind":"symbol"},"doc://IvorTuning/documentation/IvorTuning/TuningSystem":{"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem","title":"TuningSystem","role":"symbol","navigatorTitle":[{"text":"TuningSystem","kind":"identifier"}],"type":"topic","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TuningSystem","kind":"identifier"}],"url":"\/documentation\/ivortuning\/tuningsystem","kind":"symbol","abstract":[{"type":"text","text":"A type that describes a musical tuning system."}]}}}