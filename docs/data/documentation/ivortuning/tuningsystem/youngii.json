ineContent":[{"text":"Six consecutive fifths from C to F♯ — C→G, G→D, D→A, A→E, E→B, B→F♯ — are each","type":"text"},{"text":" ","type":"text"},{"text":"narrowed by ⅙ of the Pythagorean comma, equal to 2^(13\/6)\/3 ≈ 698.045 cents.","type":"text"},{"text":" ","type":"text"},{"text":"The remaining six fifths are pure (3:2). The circle closes exactly.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The tempered fifth size is identical to Vallotti, but the tempered segment runs","type":"text"},{"text":" ","type":"text"},{"text":"from C through F♯ (six sharps) rather than from F through B (six naturals\/flats).","type":"text"},{"text":" ","type":"text"},{"text":"Published in ","type":"text"},{"inlineContent":[{"text":"Philosophical Transactions of the Royal Society","type":"text"}],"type":"emphasis"},{"text":" 90 (1800).","type":"text"}]}],"kind":"content"}],"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://IvorTuning/documentation/IvorTuning/TuningSystem":{"kind":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"TuningSystem"}],"url":"\/documentation\/ivortuning\/tuningsystem","abstract":[{"text":"A type that describes a musical tuning system.","type":"text"}],"title":"TuningSystem","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"TuningSystem"}],"type":"topic","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem"},"doc://IvorTuning/documentation/IvorTuning":{"kind":"symbol","url":"\/documentation\/ivortuning","abstract":[{"type":"text","text":"Musical pitch, interval, and tuning system types."}],"title":"IvorTuning","role":"collection","type":"topic","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning"},"doc://IvorTuning/documentation/IvorTuning/WellTemperament":{"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"WellTemperament"}],"url":"\/docum