el":2},{"inlineContent":[{"text":"Six consecutive fifths from C to F♯ — C→G, G→D, D→A, A→E, E→B, B→F♯ — are each","type":"text"},{"text":" ","type":"text"},{"text":"narrowed by ⅙ of the Pythagorean comma, equal to 2^(13\/6)\/3 ≈ 698.045 cents.","type":"text"},{"text":" ","type":"text"},{"text":"The remaining six fifths are pure (3:2). The circle closes exactly.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The tempered fifth size is identical to Vallotti, but the tempered segment runs"},{"type":"text","text":" "},{"type":"text","text":"from C through F♯ (six sharps) rather than from F through B (six naturals\/flats)."},{"type":"text","text":" "},{"type":"text","text":"Published in "},{"type":"emphasis","inlineContent":[{"text":"Philosophical Transactions of the Royal Society","type":"text"}]},{"type":"text","text":" 90 (1800)."}],"type":"paragraph"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://IvorTuning/documentation/IvorTuning/TuningSystem/youngII":{"conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"type":"codeVoice","code":"Self"},{"type":"text","text":" is "},{"type":"codeVoice","code":"WellTemperament"},{"type":"text","text":"."}]},"kind":"symbol","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem\/youngII","role":"symbol","type":"topic","title":"youngII","abstract":[{"type":"text","text":"Young II (Thomas Young, 1800)."}],"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"youngII","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:10IvorTuning15WellTemperamentV","text":"WellTemperament","kind":"typeIdentifier"}],"url":"\/documentation\/ivortuning\/tuningsystem\/youngii"},"doc://IvorTuning/documentation/IvorTuning":{"kind":"symbol","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning","role":"collection","type":"topic","title":"IvorTuning","abstract":[{"text":"Musical pitch, interval, and tuning system types.","type":"text"}],"url":"\/documentation\/ivortuning"},"doc://IvorTuning/documentation/IvorTuning/WellTemperament":{"role":"symbol","url":"\/documentation\/ivortuning\/welltemperament","navigatorTitle":[{"text":"WellTemperament","kind":"identifier"}],"title":"WellTemperament","kind":"symbol","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/WellTemperament","abstract":[{"type":"text","text":"A tuning system in which all twelve keys are usable but have distinct tonal characters,"},{"type":"text","text":" "},{"type":"text","text":"achieved by distributing the Pythagorean comma unevenly around the circle of fifths."}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WellTemperament","kind":"identifier"}]},"doc://IvorTuning/documentation/IvorTuning/TuningSystem":{"url":"\/documentation\/ivortuning\/tuningsystem","type":"topic","role":"symbol","kind":"symbol","abstract":[{"text":"A type that describes a musical tuning system.","type":"text"}],"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem","title":"TuningSystem","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TuningSystem","kind":"identifier"}],"navigatorTitle":[{"text":"TuningSystem","kind":"identifier"}]}}}