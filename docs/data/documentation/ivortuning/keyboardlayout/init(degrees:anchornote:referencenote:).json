xt":"is negative or appears twice, the degrees don’t ascend, or ","type":"text"},{"code":"referenceNote","type":"codeVoice"},{"text":" ","type":"text"},{"text":"falls on an unmapped key.","type":"text"}],"type":"paragraph"}],"name":"Throws","type":"aside","style":"note"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/IvorTuning\/documentation\/IvorTuning","doc:\/\/IvorTuning\/documentation\/IvorTuning\/KeyboardLayout"]]},"kind":"symbol","sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/KeyboardLayout\/init(degrees:anchorNote:referenceNote:)"},"metadata":{"roleHeading":"Initializer","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"degrees","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":"?], ","kind":"text"},{"text":"anchorNote","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"NoteNumber","kind":"typeIdentifier","preciseIdentifier":"s:10IvorTuning10NoteNumberV"},{"text":", ","kind":"text"},{"text":"referenceNote","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"NoteNumber","kind":"typeIdentifier","preciseIdentifier":"s:10IvorTuning10NoteNumberV"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"TuningError","kind":"typeIdentifier","preciseIdentifier":"s:10IvorTuning0B5ErrorO"},{"text":")","kind":"text"}],"role":"symbol","modules":[{"name":"IvorTuning"}],"title":"init(degrees:anchorNote:referenceNote:)","symbolKind":"init","externalID":"s:10IvorTuning14KeyboardLayoutV7degrees10anchorNote09referenceG0ACSaySiSgG_AA0G6NumberVAJtAA0B5ErrorOYKcfc"},"abstract":[{"text":"Creates a layout whose keys are described by degrees of the tuning system, for tuning","type":"text"},{"text":" ","type":"text"},{"text":"systems without standard notation.","type":"text"}],"references":{"doc://IvorTuning/documentation/IvorTuning/TuningError/