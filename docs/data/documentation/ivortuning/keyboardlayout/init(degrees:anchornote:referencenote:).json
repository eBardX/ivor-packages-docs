er":"s:10IvorTuning10NoteNumberV","kind":"typeIdentifier","text":"NoteNumber"},{"kind":"text","text":" = 60, "},{"kind":"externalParam","text":"referenceNote"},{"kind":"text","text":": "},{"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/NoteNumber","preciseIdentifier":"s:10IvorTuning10NoteNumberV","kind":"typeIdentifier","text":"NoteNumber"},{"kind":"text","text":" = 69) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningError","preciseIdentifier":"s:10IvorTuning0B5ErrorO","kind":"typeIdentifier","text":"TuningError"},{"kind":"text","text":")"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"One degree per key in a period, in ascending order of sound,"},{"type":"text","text":" "},{"type":"text","text":"wrapping at most once. "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" means the key is unmapped."}]}],"name":"degrees"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The MIDI note number that sounds "},{"type":"codeVoice","code":"degrees[0]"},{"type":"text","text":". Defaults to 60."}]}],"name":"anchorNote"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The MIDI note number that sounds the pitch standard’s"},{"type":"text","text":" "},{"type":"text","text":"frequency. Must fall on a mapped key. Defaults to 69."}]}],"name":"referenceNote"}]},{"mentions":["doc:\/\/IvorTuning\/documentation\/IvorTuning\/UsingIvorTuning"],"kind":"mentions"},{"kind":"content","content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each element is the degree of the tuning system its key plays, counted from 0 (the unison)"},{"type":"text","text":" "},{"type":"text","text":"within one period. Key "},{"type":"codeVoice","code":"anchorNote"},{"type":"text","text":" sounds "},{"type":"codeVoice","code":"degrees[0]"},{"type":"text","text":", and each later mapped slot takes"},{"type":"text","text":" "},{"type":"text","text":"the lowest period of its degree that sounds above the previous mapped slot. Key"},{"type":"text","text":" "},{"type":"codeVoice","code":"referenceNote"},{"type":"text","text":" sounds the pitch standard’s frequency; the pitch standard’s pitch is"},{"type":"text","text":" "},{"type":"text","text":"ignored."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"degrees[0]"},{"type":"text","text":" may be any degree, not only 0, and the layout need not contain degree 0 at"},{"type":"text","text":" "},{"type":"text","text":"all. For example, "},{"type":"codeVoice","code":"[5, 7, 9, 0, 2]"},{"type":"text","text":" puts degree 5 on "},{"type":"codeVoice","code":"anchorNote"},{"type":"text","text":", and degree 0 three keys"},{"type":"text","text":" "},{"type":"text","text":"higher, in the next period."}]},{"type":"aside","name":"Throws","style":"note","content":[{"inlineContent":[{"text":"","type":"text"},{"isActive":true,"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningError\/invalidKeyboardLayout(_:)","type":"reference"},{"text":" if ","type":"text"},{"code":"degrees[0]","type":"codeVoice"},{"text":" is unmapped, a degree","type":"text"},{"text":" ","type":"text"},{"text":"is negative or appears twice, the degrees don’t ascend, or ","type":"text"},{"code":"referenceNote","type":"codeVoice"},{"text":" ","type":"text"},{"text":"falls on an unmapped key.","type":"text"}],"type":"paragraph"}]}]}],"variants":[{"paths":["\/documentation\/ivortuning\/keyboardlayout\/init(degrees:anchornote:referencenote:)"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/KeyboardLayout\/init(degrees:anchorNote:referenceNote:)","interfaceLanguage":"swift"},"references":{"doc://IvorTuning/documentation/IvorTuning/NoteNumber":