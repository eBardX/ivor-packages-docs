{"abstract":[{"type":"text","text":"A tuning system that divides an interval of equivalence into equal logarithmic steps."}],"hierarchy":{"paths":[["doc:\/\/IvorTuning\/documentation\/IvorTuning"]]},"metadata":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EqualTemperament","kind":"identifier"}],"roleHeading":"Structure","externalID":"s:10IvorTuning16EqualTemperamentV","role":"symbol","modules":[{"name":"IvorTuning"}],"symbolKind":"struct","title":"EqualTemperament","navigatorTitle":[{"text":"EqualTemperament","kind":"identifier"}]},"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"symbol","sections":[],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EqualTemperament","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"mentions":["doc:\/\/IvorTuning\/documentation\/IvorTuning\/UsingIvorTuning"],"kind":"mentions"},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Standard pitch notation support depends on the configuration. "},{"type":"reference","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/EqualTemperament\/standardConversion(for:)","isActive":true},{"type":"text","text":" "},{"type":"text","text":"needs an octave (2:1) interval of equivalence, letters that ascend in pitch (so that E lies"},{"type":"text","text":" "},{"type":"text","text":"below F), and a sharp that raises the pitch; 12-EDO, 19-EDO, and 31-EDO are fully supported."},{"type":"text","text":" "},{"type":"text","text":"Non-octave instances (e.g., "},{"type":"reference","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/EqualTemperament\/bohlenPierce","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/EqualTemperament\/carlosAlpha","isActive":true},{"type":"text","text":") cannot support standard"},{"type":"text","text":" "},{"type":"text","text":"notation. Standard notation has only 35 pitch classes, so instances with more than 35"},{"type":"text","text":" "},{"type":"text","text":"divisions (e.g., "},{"type":"reference","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/EqualTemperament\/edo53","isActive":true},{"type":"text","text":") cannot be fully represented: a conversion reaches only the steps"},{"type":"text","text":" "},{"type":"text","text":"its spellings land on, and a work must stay within those. Some instances with fewer divisions"},{"type":"text","text":" "},{"type":"text","text":"have the same limit, because their chain of fifths closes early (e.g., "},{"type":"reference","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/EqualTemperament\/edo24","isActive":true},{"type":"text","text":", whose"},{"type":"text","text":" "},{"type":"text","text":"spellings land on only 12 pitches). Accidentals can also surprise: a sharp larger than a"},{"type":"text","text":" "},{"type":"text","text":"diatonic semitone puts E♯ above F, and in 17-EDO and "},{"type":"reference","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/EqualTemperament\/edo22","isActive":true},{"type":"text","text":" it lands at least a whole"},{"type":"text","text":" "},{"type":"text","text":"diatonic semitone above F."}]}],"kind":"content"}],"topicSections":[{"identifiers":["doc:\/\/IvorTuning\/documentation\/IvorTuning\/EqualTemperament\/init(divisions:equivalenceRatio:)"],"anchor":"Initializers","generated":true,"title":"Initializers"},{"identifiers":["doc:\/\/IvorTuning\/documentation\/IvorTuning\/EqualTemperament\/divisions","doc:\/\/IvorTuning\/documentation\/IvorTuning\/EqualTemperament\/equivalenceRatio"],"anchor":"Instance-Properties","generated":true,"title":"Instance Properties"},{"identifiers":["doc:\/\/IvorTuning\/documentation\/IvorTuning\/EqualTemperament\/Equatable-Implementations","doc:\/\/IvorTuning\/