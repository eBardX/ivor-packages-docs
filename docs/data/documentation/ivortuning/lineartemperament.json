arrowingRatio"},{"text":". The interval of equivalence is an","type":"text"},{"text":" ","type":"text"},{"text":"octave (2:1).","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"All predefined linear temperaments fully support standard pitch notation via","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/LinearTemperament\/standardConversion(for:)"},{"text":". So-called ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"extended","type":"text"}]},{"text":" linear temperaments — those requiring","type":"text"},{"text":" ","type":"text"},{"text":"more than 35 pitch classes to span the full chain of fifths — are not fully supported.","type":"text"}]}],"kind":"content"}],"topicSections":[{"generated":true,"identifiers":["doc:\/\/IvorTuning\/documentation\/IvorTuning\/LinearTemperament\/init(narrowingRatio:)"],"anchor":"Initializers","title":"Initializers"},{"generated":true,"identifiers":["doc:\/\/IvorTuning\/documentation\/IvorTuning\/LinearTemperament\/narrowingRatio"],"anchor":"Instance-Properties","title":"Instance Properties"},{"generated":true,"identifiers":["doc:\/\/IvorTuning\/documentation\/IvorTuning\/LinearTemperament\/Equatable-Implementations","doc:\/\/IvorTuning\/documentation\/IvorTuning\/LinearTemperament\/TuningSystem-Implementations"],"anchor":"Default-Implementations","title":"Default Implementations"}],"variants":[{"paths":["\/documentation\/ivortuning\/lineartemperament"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"relationshipsSections":[{"identifiers":["doc:\/\/IvorTuning\/s8CopyableP","doc:\/\/IvorTuning\/SQ","doc:\/\/IvorTuning\/s9EscapableP","doc:\/\/IvorTuning\/s8SendableP","doc:\/\/IvorTuning\/s16SendableMetatypeP","doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem"],"kind":"relationships","title":"Conforms To","type":"conformsTo"}],"references":{"doc://IvorTuning/s16SendableMetatypeP":{"type":"unresolvable"