ype":"text"},{"isActive":true,"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/KeyboardLayout\/init(pitchClasses:anchorNote:anchorOctave:)","type":"reference"},{"text":") name each key by","type":"text"},{"text":" ","type":"text"},{"text":"its spelled pitch class, for tuning systems that support standard notation.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Degree layouts","type":"text"}]},{"text":" (","type":"text"},{"isActive":true,"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/KeyboardLayout\/init(degrees:anchorNote:referenceNote:)","type":"reference"},{"text":") name each key by a degree","type":"text"},{"text":" ","type":"text"},{"text":"of the tuning system, for tuning systems without standard notation.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Raw-ratio layouts","type":"text"}]},{"text":" (","type":"text"},{"isActive":true,"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/KeyboardLayout\/init(ratios:equivalenceRatio:anchorNote:referenceNote:referenceFrequency:)","type":"reference"},{"text":")","type":"text"},{"text":" ","type":"text"},{"text":"give each key an explicit ratio and tune themselves. They are intended for ","type":"text"},{"code":".kbm","type":"codeVoice"},{"text":"\/","type":"text"},{"code":".scl","type":"codeVoice"},{"text":" ","type":"text"},{"text":"import.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Frequency layouts","type":"text"}]},{"text":" (","type":"text"},{"isActive":true,"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/KeyboardLayout\/init(frequencies:)","type":"reference"},{"text":") give every MIDI note number an explicit","type":"text"},{"text":" ","type":"text"},{"text":"frequency, with no repeating pattern. They are intended for per-key tuning tables.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Raw-ratio and frequency layouts together are the ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"raw"}]},{"text":" layouts: they hold frequencies","type":"text"},{"text":" ","type":"text"},{"text":"themselves rather than taking them from a tuning system and pitch standard.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"In the three patterned kinds, slot ","type":"text"},{"type":"codeVoice","code":"i"},{"text":" is key ","type":"text"},{"type":"codeVoice","code":"anchorNote + i"},{"text":" in every period, so the list","type":"text"},{"text":" ","type":"text"},{"text":"order is the keyboard’s physical left-to-right order, and the pattern repeats outward from","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"anchorNote"},{"text":". A ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" slot is an unmapped key. Slot 0 must be mapped, because it defines the","type":"text"},{"text":" ","type":"text"},{"text":"anchor.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Every initializer validates what it can without a tuning system and throws","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningError\/invalidKeyboardLayout(_:)","isActive":true,"type":"reference"},{"text":" on failure. Checks that depend on the tuning system","type":"text"},{"text":" ","type":"text"},{"text":"run when a converter is created.","type":"text"}]}]}],"topicSections":[{"title":"Initializers","identifiers":["doc:\/\/IvorTuning\/documentation\/IvorTuning\/KeyboardLayout\/init(_:)","doc:\/\/IvorTuning\/documentation\/IvorTuning\/KeyboardLayout\/init(degrees:anchorNote:referenceNote:)","doc:\/\/IvorTuning\/documentation\/IvorTuning\/KeyboardLayout\/init(frequencies:)","doc:\/\/IvorTuning\/documentation\/IvorTuning\/KeyboardLayout\/init(pitchClasses:anchorNote:anchorOctave:)","doc:\/\/IvorTuning\/documentation\/IvorTuni