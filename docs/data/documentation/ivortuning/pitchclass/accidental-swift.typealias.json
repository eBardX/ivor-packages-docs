 with a different interval of equivalence (e.g., Bohlen-Pierce) cannot be"},{"type":"text","text":" "},{"type":"text","text":"represented using standard pitch notation."}],"navigatorTitle":[{"kind":"identifier","text":"Pitch"}],"title":"Pitch","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"Pitch","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/Pitch"},"doc://IvorTuning/documentation/IvorTuning/Pitch/Accidental-swift.enum":{"type":"topic","abstract":[{"type":"text","text":"An accidental modifier applied to a diatonic letter. Combined with the seven diatonic"},{"type":"text","text":" "},{"type":"text","text":"letters, the five accidentals yield the 35 pitch classes of standard notation."}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Accidental","kind":"identifier"}],"title":"Pitch.Accidental","kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Accidental"}],"url":"\/documentation\/ivortuning\/pitch\/accidental-swift.enum","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/Pitch\/Accidental-swift.enum"},"doc://IvorTuning/documentation/IvorTuning":{"type":"topic","abstract":[{"text":"Musical pitch, interval, and tuning system types.","type":"text"}],"title":"IvorTuning","kind":"symbol","role":"collection","url":"\/documentation\/ivortuning","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning"}}}