tave","type":"text"},{"text":" ","type":"text"},{"text":"number. SPN is defined for tuning systems with a 2:1 octave as their interval of equivalence","type":"text"},{"text":" ","type":"text"},{"text":"only; systems with a different interval of equivalence (e.g., Bohlen-Pierce) cannot be","type":"text"},{"text":" ","type":"text"},{"text":"represented using standard pitch notation.","type":"text"}],"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/Pitch","navigatorTitle":[{"kind":"identifier","text":"Pitch"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Pitch"}],"title":"Pitch","type":"topic","url":"\/documentation\/ivortuning\/pitch","role":"symbol"},"doc://IvorTuning/documentation/IvorTuning/Pitch/Accidental-swift.enum":{"title":"Pitch.Accidental","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Accidental"}],"identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/Pitch\/Accidental-swift.enum","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Accidental"}],"abstract":[{"type":"text","text":"An accidental modifier applied to a diatonic letter. Combined with the seven diatonic"},{"type":"text","text":" "},{"type":"text","text":"letters, the five accidentals yield the 35 pitch classes of standard notation."}],"url":"\/documentation\/ivortuning\/pitch\/accidental-swift.enum"}}}