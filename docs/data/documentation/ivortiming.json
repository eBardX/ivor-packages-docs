{"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"inlineContent":[{"text":"The IvorTiming framework provides musical time, duration, and tempo types","type":"text"},{"text":" ","type":"text"},{"text":"written in Swift. Both beat-based (measured in whole notes) and wall-clock","type":"text"},{"text":" ","type":"text"},{"text":"representations of time and duration are supported, along with tempo-based","type":"text"},{"text":" ","type":"text"},{"text":"types for converting between the two and a quantizer for snapping beat times to","type":"text"},{"text":" ","type":"text"},{"text":"rhythmic grid points.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import IvorTiming","","var tempoMap = TempoMap()","","tempoMap.insert(beatTime: 0, tempo: Tempo(120))     \/\/ ♩ = 120","tempoMap.insert(beatTime: 2, tempo: Tempo(60))      \/\/ slow to ♩ = 60 over two whole notes","","tempoMap[1].plain                           \/\/ \"1\/4=105\" (♩ = 105)","","let converter = TimeConverter(tempoMap: tempoMap)","","converter.wallTime(at: 1).plain             \/\/ \"2.090202\" (seconds)","converter.beatTime(at: WallTime(doubleValue: 2)!).plain    \/\/ \"0.96\" (whole notes)","","let quantizer = try BeatQuantizer(factors: [16, 12])","","quantizer.quantize(BeatTime(plain: \"0.33\")!).plain  \/\/ \"0 1\/3\""]},{"inlineContent":[{"text":"See ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorTiming\/documentation\/IvorTiming\/UsingIvorTiming"},{"text":" for a full guide to times and durations, tempo maps,","type":"text"},{"text":" ","type":"text"},{"text":"conversion, quantization, and error handling.","type":"text"}],"type":"paragraph"}]}],"kind":"symbol","variants":[{"paths":["\/documentation\/ivortiming"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"topicSections":[{"title":"Guides","identifiers":["doc:\/\/IvorTiming\/documentation\/IvorTiming\/UsingIvorTiming"],"anchor":"Guides"},{"title":"Time","identifiers":["doc:\/\/IvorTiming\/documentation\/IvorTiming\/BeatTime","doc:\/\/IvorTiming\/documentation\/IvorTiming\/WallTime","doc:\/\/IvorTiming\/documentation\/IvorTiming\/TimeProtocol","doc:\/\/IvorTiming\/documentation\/IvorTiming\/TimeBasis","doc:\/\/IvorTiming\/documentation\/IvorTiming\/TimeDirection"],"anchor":"Time"},{"title":"Duration","identifiers":["doc:\/\/IvorTiming\/documentation\/IvorTiming\/BeatDuration","doc:\/\/IvorTiming\/documentation\/IvorTiming\/WallDuration","doc:\/\/IvorTiming\/documentation\/IvorTiming\/DirectedDuration","doc:\/\/IvorTiming\/documentation\/IvorTiming\/DurationProtocol"],"anchor":"Duration"},{"title":"Tempo","identifiers":["doc:\/\/IvorTiming\/documentation\/IvorTiming\/Tempo","doc:\/\/IvorTiming\/documentation\/IvorTiming\/TempoMap","doc:\/\/IvorTiming\/documentation\/IvorTiming\/TimeConverter"],"anchor":"Tempo"},{"title":"Quantization","identifiers":["doc:\/\/IvorTiming\/documentation\/IvorTiming\/BeatQuantizer"],"anchor":"Quantization"},{"title":"Errors","identifiers":["doc:\/\/IvorTiming\/documentation\/IvorTiming\/ParseError"],"anchor":"Errors"}],"identifier":{"url":"doc:\/\/IvorTiming\/documentation\/IvorTiming","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"Musical time, duration, and tempo types.","type":"text"}],"hierarchy":{"paths":[[]]},"metadata":{"role":"collection","externalID":"IvorTiming","title":"IvorTiming","roleHeading":"Framework","symbolKind":"module","modules":[{"name":"IvorTiming"}],"color":{"standardColorIdentifier":"blue"}},"references":{"doc://IvorTiming/documentation/IvorTiming/BeatDuration":{"url":"\/documentation\/ivortiming\/beatduration","role":"symbol","kind":"symbol","type":"topic","title":"BeatDuration","identifier":"doc:\/\/IvorTiming\/documentation\/IvorTiming\/BeatDuration","abstract":[{"type":"text","text":"A non-negative duration in musical beat time, measured in whole notes."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"BeatDuration"}],"navigatorTitle":[{"kind":"identifier","text":"BeatDuration"}]},"doc://IvorTiming/documentation/IvorTiming/WallDuration":{"url":"\/documentation\/ivortiming\/wallduration","role":"symbol","kind":"symbol","type":"topic","title":"WallDuration","identifier":"doc:\/\/IvorTiming\/documentation\/IvorTiming\/WallDuration","abstract":[{"type":"text","text":"A non-negative duration of wall-clock time, measured in microseconds."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"WallDuration"}],"navigatorTitle":[{"kind":"identifier","text":"WallDuration"}]},"doc://IvorTiming/documentation/IvorTiming/UsingIvorTiming":{"url":"\/documentation\/ivortiming\/usingivortiming","role":"article","kind":"article","type":"topic","title":"Using IvorTiming","identifier":"doc:\/\/IvorTiming\/documentation\/IvorTiming\/UsingIvorTiming","abstract":[{"type":"text","text":"Measure musical time in whole notes or in seconds, and convert between the two"},{"type":"text","text":" "},{"type":"text","text":"with a tempo map."}]},"doc://IvorTiming/documentation/IvorTiming/Tempo":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Tempo","kind":"identifier"}],"url":"\/documentation\/ivortiming\/tempo","navigatorTitle":[{"text":"Tempo","kind":"identifier"}],"role":"symbol","title":"Tempo","kind":"symbol","abstract":[{"type":"text","text":"A tempo: a positive, exact rational rate per minute of a stated note value (the tempo’s"},{"type":"text","text":" "},{"inlineContent":[{"type":"text","text":"unit"}],"type":"emphasis"},{"type":"text","text":")."}],"type":"topic","identifier":"doc:\/\/IvorTiming\/documentation\/IvorTiming\/Tempo"},"doc://IvorTiming/documentation/IvorTiming":{"type":"topic","abstract":[{"type":"text","text":"Musical time, duration, and tempo types."}],"identifier":"doc:\/\/IvorT