ltime","navigatorTitle":[{"text":"WallTime","kind":"identifier"}],"role":"symbol","title":"WallTime","kind":"symbol","identifier":"doc:\/\/IvorTiming\/documentation\/IvorTiming\/WallTime","abstract":[{"type":"text","text":"A point in wall-clock time, measured in microseconds from time zero."}],"type":"topic"},"doc://IvorTiming/documentation/IvorTiming/DurationProtocol":{"url":"\/documentation\/ivortiming\/durationprotocol","role":"symbol","kind":"symbol","type":"topic","title":"DurationProtocol","identifier":"doc:\/\/IvorTiming\/documentation\/IvorTiming\/DurationProtocol","abstract":[{"type":"text","text":"A protocol for types that represent a non-negative duration of time."}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DurationProtocol","kind":"identifier"}],"navigatorTitle":[{"text":"DurationProtocol","kind":"identifier"}]},"doc://IvorTiming/documentation/IvorTiming/TimeDirection":{"url":"\/documentation\/ivortiming\/timedirection","role":"symbol","kind":"symbol","type":"topic","title":"TimeDirection","identifier":"doc:\/\/IvorTiming\/documentation\/IvorTiming\/TimeDirection","abstract":[{"type":"text","text":"The direction of movement between two points in time."}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"TimeDirection"}],"navigatorTitle":[{"kind":"identifier","text":"TimeDirection"}]},"doc://IvorTiming/documentation/IvorTiming/BeatTime":{"url":"\/documentation\/ivortiming\/beattime","role":"symbol","kind":"symbol","type":"topic","title":"BeatTime","identifier":"doc:\/\/IvorTiming\/documentation\/IvorTiming\/BeatTime","abstract":[{"text":"A point in musical beat time, measured in whole notes from time zero.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"BeatTime"}],"navigatorTitle":[{"kind":"identifier","text":"BeatTime"}]}}}