{"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"hierarchy":{"paths":[[]]},"identifier":{"url":"doc:\/\/IvorTiming\/documentation\/IvorTiming","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/ivortiming"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"role":"collection","roleHeading":"Framework","title":"IvorTiming","modules":[{"name":"IvorTiming"}],"color":{"standardColorIdentifier":"blue"},"externalID":"IvorTiming","symbolKind":"module"},"abstract":[{"type":"text","text":"Musical time, duration, and tempo types."}],"topicSections":[{"identifiers":["doc:\/\/IvorTiming\/documentation\/IvorTiming\/UsingIvorTiming"],"title":"Guides","anchor":"Guides"},{"identifiers":["doc:\/\/IvorTiming\/documentation\/IvorTiming\/BeatTime","doc:\/\/IvorTiming\/documentation\/IvorTiming\/WallTime","doc:\/\/IvorTiming\/documentation\/IvorTiming\/TimeProtocol","doc:\/\/IvorTiming\/documentation\/IvorTiming\/TimeBasis","doc:\/\/IvorTiming\/documentation\/IvorTiming\/TimeDirection"],"title":"Time","anchor":"Time"},{"identifiers":["doc:\/\/IvorTiming\/documentation\/IvorTiming\/BeatDuration","doc:\/\/IvorTiming\/documentation\/IvorTiming\/WallDuration","doc:\/\/IvorTiming\/documentation\/IvorTiming\/DirectedDuration","doc:\/\/IvorTiming\/documentation\/IvorTiming\/DurationProtocol"],"title":"Duration","anchor":"Duration"},{"anchor":"Tempo","identifiers":["doc:\/\/IvorTiming\/documentation\/IvorTiming\/Tempo","doc:\/\/IvorTiming\/documentation\/IvorTiming\/TempoMap","doc:\/\/IvorTiming\/documentation\/IvorTiming\/TimeConverter"],"title":"Tempo"},{"anchor":"Quantization","identifiers":["doc:\/\/IvorTiming\/documentation\/IvorTiming\/BeatQuantizer"],"title":"Quantization"},{"anchor":"Errors","identifiers":["doc:\/\/IvorTiming\/documentation\/IvorTiming\/ParseError"],"title":"Errors"}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"The IvorTiming framework provides musical time, duration, and tempo types"},{"type":"text","text":" "},{"type":"text","text":"written in Swift. Both beat-based (measured in whole notes) and wall-clock"},{"type":"text","text":" "},{"type":"text","text":"representations of time and duration are supported, along with tempo-based"},{"type":"text","text":" "},{"type":"text","text":"types for converting between the two and a quantizer for snapping beat times to"},{"type":"text","text":" "},{"type":"text","text":"rhythmic grid points."}],"type":"paragraph"},{"syntax":"swift","code":["import IvorTiming","","var tempoMap = TempoMap()","","tempoMap.insert(beatTime: 0, tempo: Tempo(120))     \/\/ ♩ = 120","tempoMap.insert(beatTime: 2, tempo: Tempo(60))      \/\/ slow to ♩ = 60 over two whole notes","","tempoMap[1].plain                           \/\/ \"1\/4=105\" (♩ = 105)","","let converter = TimeConverter(tempoMap: tempoMap)","","converter.wallTime(at: 1).plain             \/\/ \"2.090202\" (seconds)","converter.beatTime(at: WallTime(doubleValue: 2)!).plain    \/\/ \"0.96\" (whole notes)","","let quantizer = try BeatQuantizer(factors: [16, 12])","","quantizer.quantize(BeatTime(plain: \"0.33\")!).plain  \/\/ \"0 1\/3\""],"type":"codeListing"},{"inlineContent":[{"text":"See ","type":"text"},{"identifier":"doc:\/\/IvorTiming\/documentation\/IvorTiming\/UsingIvorTiming","type":"reference","isActive":true},{"type":"text","text":" for a full guide to times and durations, tempo maps,"},{"text":" ","type":"text"},{"type":"text","text":"conversion, quantization, and error handling."}],"type":"paragraph"}]}],"references":{"doc://IvorTiming/documentation/IvorTiming/BeatQuantizer":{"url":"\/documentation\/ivortiming\/beatquantizer","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"BeatQuantizer"}],"title":"BeatQuantizer","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"BeatQuantizer"}],"identifier":"doc:\/\/