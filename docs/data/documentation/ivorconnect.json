 the start,","type":"text"},{"text":" ","type":"text"},{"text":"in the order they are sent.","type":"text"}],"url":"\/documentation\/ivorconnect\/midisequence","title":"MIDISequence","type":"topic"},"doc://IvorConnect/documentation/IvorConnect/SynthOutput":{"role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SynthOutput","kind":"identifier"}],"navigatorTitle":[{"text":"SynthOutput","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/IvorConnect\/documentation\/IvorConnect\/SynthOutput","abstract":[{"text":"A MIDI output that plays on Apple’s multitimbral MIDI synth","type":"text"},{"text":" ","type":"text"},{"text":"(AUMIDISynth), loaded with a General MIDI sound bank, so that music can","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"be heard with no other software."}],"url":"\/documentation\/ivorconnect\/synthoutput","title":"SynthOutput","type":"topic"},"doc://IvorConnect/documentation/IvorConnect/CoreMIDISourceOutput":{"role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"CoreMIDISourceOutput"}],"navigatorTitle":[{"kind":"identifier","text":"CoreMIDISourceOutput"}],"kind":"symbol","identifier":"doc:\/\/IvorConnect\/documentation\/IvorConnect\/CoreMIDISourceOutput","abstract":[{"text":"A MIDI output that sends to other apps, through a virtual source they","type":"text"},{"text":" ","type":"text"},{"text":"can connect to.","type":"text"}],"url":"\/documentation\/ivorconnect\/coremidisourceoutput","title":"CoreMIDISourceOutput","type":"topic"},"https://github.com/eBardX/IvorMIDI":{"title":"IvorMIDI","url":"https:\/\/github.com\/eBardX\/IvorMIDI","identifier":"https:\/\/github.com\/eBardX\/IvorMIDI","titleInlineContent":[{"text":"IvorMIDI","type":"text"}],"type":"link"},"doc://IvorConnect/documentation/IvorConnect/MIDIOutputChoice":{"role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"id