{"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"paths":["\/documentation\/ivorconnect"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"inlineContent":[{"text":"The IvorConnect framework sends ","type":"text"},{"isActive":true,"identifier":"https:\/\/github.com\/eBardX\/IvorMIDI","type":"reference"},{"text":" ","type":"text"},{"text":"channel messages, each timestamped for the moment it should sound, to","type":"text"},{"text":" ","type":"text"},{"text":"CoreMIDI and to Apple’s multitimbral MIDI synth. Every destination is a","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/IvorConnect\/documentation\/IvorConnect\/MIDIOutput","type":"reference","isActive":true},{"text":":","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/IvorConnect\/documentation\/IvorConnect\/CoreMIDISourceOutput","type":"reference"},{"type":"text","text":" publishes a virtual source that other apps can"},{"type":"text","text":" "},{"type":"text","text":"connect to."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/IvorConnect\/documentation\/IvorConnect\/CoreMIDIDestinationOutput","type":"reference"},{"type":"text","text":" sends to one CoreMIDI destination (a synth,"},{"type":"text","text":" "},{"type":"text","text":"an interface, another app), and finds it again whenever it comes back."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/IvorConnect\/documentation\/IvorConnect\/SynthOutput","type":"reference"},{"text":" plays on AUMIDISynth with a General MIDI sound bank,","type":"text"},{"text":" ","type":"text"},{"text":"placing every message at its exact sample.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"A ","type":"text"},{"isActive":true,"identifier":"doc:\/\/IvorConnect\/documentation\/IvorConnect\/MIDIRouter","type":"reference"},{"text":" delivers each message to its channel’s outputs, keeping","type":"text"},{"text":" ","type":"text"},{"text":"timestamps in order across all of them, so that a note-off sent “now” can","type":"text"},{"text":" ","type":"text"},{"text":"never overtake a note-on already scheduled. A ","type":"text"},{"isActive":true,"identifier":"doc:\/\/IvorConnect\/documentation\/IvorConnect\/CoreMIDIClient","type":"reference"},{"text":" lists the","type":"text"},{"text":" ","type":"text"},{"text":"available destinations and reports every change to the MIDI setup.","type":"text"}],"type":"paragraph"},{"code":["import IvorMIDI","import IvorConnect","","let client = try CoreMIDIClient(name: \"MyApp\")","let source = try CoreMIDISourceOutput(client: client)","let synth = try SynthOutput(soundBankURL: SynthOutput.systemSoundBankURL)   \/\/ macOS","let router = MIDIRouter(outputs: [source, synth])","let start = ContinuousClock.now.advanced(by: .milliseconds(50))","","router.send(message: .noteOn(1, 60, 100), at: start)","router.send(message: .noteOff(1, 60, 0), at: start.advanced(by: .seconds(1)))","router.waitUntilDelivered()"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"Timing","level":3,"anchor":"Timing"},{"inlineContent":[{"type":"text","text":"Send each message a little ahead of time, at least the synth’s "},{"code":"lead","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"(20 milliseconds by default), stamped with the exact time it should sound."},{"type":"text","text":" "},{"type":"text","text":"Then neither thread scheduling nor other work on the sending thread can"},{"type":"text","text":" "},{"type":"text","text":"disturb the music: CoreMIDI delivers each message at its timestamp, and the"},{"type":"text","text":" "},{"type":"text","text":"synth places it at its exact sample."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorConnect\/documentation\/IvorConnect\/MIDIScheduler"},{"type":"text","text":" does this on a dedicated high-priority thread, for any"},{"type":"text","text":" "},{"type":"text","text":"state that can say what falls due and when it next needs to run. A"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/IvorConnect\/documentation\/IvorConnect\/MIDISequencePlayer","isActive":true},{"type":"text","text":" uses one to play a fixed "},{"type":"reference","identifier":"doc:\/\/IvorConnect\/documentation\/IvorConnect\/MIDISequence","isActive":true},{"type":"text","text":" from any"},{"type":"text","text":" "},{"type":"text","text":"position, first setting each channel to the patch it would have reached."}],"type":"paragraph"},{"type":"heading","text":"Platform notes","level":3,"anchor":"Platform-notes"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Create a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorConnect\/documentation\/IvorConnect\/CoreMIDIClient"},{"type":"text","text":" before making any other CoreMIDI call, or"},{"type":"text","text":" "},{"type":"text","text":"setup changes may never be reported."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"iOS has no built-in sound bank, so an app must bundle a General MIDI"},{"type":"text","text":" "},{"type":"text","text":"SoundFont for "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorConnect\/documentation\/IvorConnect\/SynthOutput"},{"type":"text","text":". On macOS,"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorConnect\/documentation\/IvorConnect\/SynthOutput\/systemSoundBankURL"},{"type":"text","text":" is always available."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"AUMIDISynth crashes if two instances load a sound bank or render at once."},{"type":"text","text":" "},{"type":"text","text":"Never create a second "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorConnect\/documentation\/IvorConnect\/SynthOutput"},{"type":"text","text":" while one is loading, and serialize"},{"type":"text","text":" "},{"type":"text","text":"any tests that use one."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"On iOS (only), activate the audio session with"},{"type":"text","text":" "},{"type":"codeVoice","code":"AudioSession.activateForPlayback(preferredIOBufferDuration:)"},{"type":"text","text":" before"},{"type":"text","text":" "},{"type":"text","text":"making a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorConnect\/documentation\/IvorConnect\/SynthOutput"},{"type":"text","text":", and keep an "},{"type":"codeVoice","code":"AudioSession.Monitor"},{"type":"text","text":" to restart"},{"type":"text","text":" "},{"type":"text","text":"the synth after an interruption and make it again after a media-services"},{"type":"text","text":" "},{"type":"text","text":"reset."}]}]}],"type":"unorderedList"}],"kind":"content"}],"metadata":{"role":"collection","externalID":"IvorConnect","color":{"standardColorIdentifier":"blue"},"roleHeading":"Framework","symbolKind":"module","modules":[{"name":"IvorConnect"}],"title":"IvorConnect"},"identifier":{"url":"doc:\/\/IvorConnect\/documentation\/IvorConnect","interfaceLanguage":"swift"},"sections":[],"kind":"symbol","abstract":[{"type":"text","text":"MIDI playback through CoreMIDI and Apple’s built-in General MIDI synth."}],"topicSections":[{"title":"Outputs","identifiers":["doc:\/\/IvorConnect\/documentation\/IvorConnect\/MIDIOutput","doc:\/\/IvorConnect\/documentation\/IvorConnect\/CoreMIDIDestinationOutput","doc:\/\/IvorConnect\/documentation\/IvorConnect\/CoreMIDISourceOutput","doc:\/\/IvorConnect\/documentation\/IvorConnect\/SynthOutput"],"anchor":"Outputs"},{"title":"Routing","identifiers":["doc:\/\/IvorConnect\/documentation\/IvorConnect\/MIDIRouter","doc:\/\/IvorC