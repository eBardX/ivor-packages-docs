{"sections":[],"hierarchy":{"paths":[[]]},"metadata":{"roleHeading":"Framework","symbolKind":"module","externalID":"IvorMIDI2","color":{"standardColorIdentifier":"blue"},"modules":[{"name":"IvorMIDI2"}],"role":"collection","title":"IvorMIDI2"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormidi2"]}],"topicSections":[{"anchor":"Guides","title":"Guides","identifiers":["doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/UsingIvorMIDI2"]},{"anchor":"Data-values","title":"Data values","identifiers":["doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2Group"]},{"anchor":"Reading-messages","title":"Reading messages","identifiers":["doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2Message","doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2MessageReader"]},{"anchor":"Packets","title":"Packets","identifiers":["doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2Packet","doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2PacketsConvertible","doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2GrouplessPacketsConvertible"]},{"anchor":"Utility-messages","title":"Utility messages","identifiers":["doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2UtilityMessage"]},{"anchor":"MIDI-20-channel-voice-messages","title":"MIDI 2.0 channel voice messages","identifiers":["doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2ChannelMessage","doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2NoteAttribute"]},{"anchor":"System-Exclusive-8-messages","title":"System Exclusive 8 messages","identifiers":["doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2SystemExclusive8Message"]},{"anchor":"Flex-Data-messages","title":"Flex Data messages","identifiers":["doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2FlexDataMessage"]},{"anchor":"UMP-stream-messages","title":"UMP stream messages","identifiers":["doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2StreamMessage"]}],"identifier":{"url":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Universal MIDI Packet (UMP) group and message encoding types."}],"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The IvorMIDI2 framework provides "},{"identifier":"https:\/\/midi.org\/universal-midi-packet-ump-and-midi-2-0-protocol-specification","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"support written in Swift, building on the message and data value types of"},{"type":"text","text":" "},{"identifier":"https:\/\/github.com\/eBardX\/IvorMIDI","type":"reference","isActive":true},{"type":"text","text":". A UMP group number addresses"},{"type":"text","text":" "},{"type":"text","text":"one of the 16 groups of a packet stream, and a UMP packet holds the one to four"},{"type":"text","text":" "},{"type":"text","text":"32-bit words that its message type requires. The channel and system messages"},{"type":"text","text":" "},{"type":"text","text":"of IvorMIDI can be converted to and from MIDI 1.0 Universal MIDI Packets, as"},{"type":"text","text":" "},{"type":"text","text":"CoreMIDI’s event lists carry them: channel voice messages as single-word"},{"type":"text","text":" "},{"type":"text","text":"packets of message type 0x2, system common and real-time messages as"},{"type":"text","text":" "},{"type":"text","text":"single-word packets of message type 0x1, and system exclusive messages as"},{"type":"text","text":" "},{"type":"text","text":"two-word packets of message type 0x3. The MIDI 2.0 message families have types"},{"type":"text","text":" "},{"type":"text","text":"of their own: utility messages, MIDI 2.0 channel voice messages, System"},{"type":"text","text":" "},{"type":"text","text":"Exclusive 8 messages, Flex Data messages, and UMP stream messages. A message"},{"type":"text","text":" "},{"type":"text","text":"reader turns a stream of 32-bit words into messages of every family,"},{"type":"text","text":" "},{"type":"text","text":"reassembling those that span several packets."}]},{"type":"codeListing","code":["import IvorMIDI","import IvorMIDI2","","\/\/ Middle C, velocity 127, on channel 1 of group 6.","let noteOn = MIDIChannelMessage.noteOn(1, 60, 127)","let packet = noteOn.packet(group: 6)               \/\/ words: [0x25903C7F]","","\/\/ Decode the message and its group from a packet.","if let received = MIDI2Packet(words: [0x25903c7f]) {","    MIDIChannelMessage(packet: received) == noteOn \/\/ true","    received.group                                 \/\/ 6","}","","\/\/ A system exclusive message spans one two-word packet per 6 data bytes.","let sysEx = MIDISystemMessage.systemExclusive([0x7e, 0x7f, 0x09, 0x01, 0xf7])","let packets = sysEx.packets()                      \/\/ words: [0x30047E7F, 0x09010000]","","\/\/ Read the messages of a stream of words, in any grouping.","var reader = MIDI2MessageReader()","","reader.read(words: [0x45903c00])                   \/\/ []: half a packet","reader.read(words: [0xffff0000])                   \/\/ [.midi2ChannelVoice(.noteOn(1, 60, 65535, nil), 6)]"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"See "},{"identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/UsingIvorMIDI2","type":"reference","isActive":true},{"type":"text","text":" for a full guide to packets, groups, the message"},{"type":"text","text":" "},{"type":"text","text":"families, and reading a stream."}]}]}],"kind":"symbol","references":{"doc://IvorMIDI2/documentation/IvorMIDI2/MIDI2PacketsConvertible":{"role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MIDI2PacketsConvertible","kind":"identifier"}],"navigatorTitle":[{"text":"MIDI2PacketsConvertible","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormidi2\/midi2packetsconvertible","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2PacketsConvertible","abstract":[{"type":"text","text":"A type that can be converted to and from the Universal MIDI Packets that"},{"type":"text","text":" "},{"type":"text","text":"encode it in a group."}],"title":"MIDI2PacketsConvertible","kind":"symbol"},"doc://IvorMIDI2/documentation/IvorMIDI2/MIDI2ChannelMessage":{"role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MIDI2ChannelMessage","kind":"identifier"}],"navigatorTitle":[{"text":"MIDI2ChannelMessage","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormidi2\/midi2channelmessage","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2ChannelMessage","abstract":[{"type":"text","text":"A MIDI 2.0 channel voice message (message type 0x4)."}],"title":"MIDI2ChannelMessage","kind":"symbol"},"doc://IvorMIDI2/documentation/IvorMIDI2/MIDI2UtilityMessage":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MIDI2UtilityMessage"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"MIDI2UtilityMessage"}],"kind":"symbol","abstract":[{"text":"A Universal MIDI Packet utility message (message type 0x0).","type":"text"}],"url":"\/documentation\/ivormidi2\/midi2utilitymessage","role":"symbol","title":"MIDI2UtilityMessage","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2UtilityMessage"},"doc://IvorMIDI2/documentation/IvorMIDI2/MIDI2MessageReader":{"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MIDI2MessageReader","kind":"identifier"}],"navigatorTitle":[{"text":"MIDI2MessageReader","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormidi2\/midi2messagereader","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2MessageReader","abstract":[{"type":"text","text":"A reader of the messages in a stream of Universal MIDI Packets."}],"title":"MIDI2MessageReader","kind":"symbol"},"doc://IvorMIDI2/documentation/IvorMIDI2/MIDI2GrouplessPacketsConvertible":{"role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MIDI2GrouplessPacketsConvertible","kind":"identifier"}],"navigatorTitle":[{"text":"MIDI2GrouplessPacketsConvertible","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormidi2\/midi2grouplesspacketsconvertible","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2GrouplessPacketsConvertible","abstract":[{"type":"text","text":"A type that can be converted to and from the Universal MIDI Packets that"},{"type":"text","text":" "},{"type":"text","text":"encode it without a group."}],"title":"MIDI2GrouplessPacketsConvertible","kind":"symbol"},"doc://IvorMIDI2/documentation/IvorMIDI2/MIDI2Group":{"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MIDI2Group","kind":"identifier"}],"navigatorTitle":[{"text":"MIDI2Group","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormidi2\/midi2group","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2Group","abstract":[{"type":"text","text":"A Universal MIDI Packet (UMP) group number (1–16)."}],"title":"MIDI2Group","kind":"symbol"},"doc://IvorMIDI2/documentation/IvorMIDI2/UsingIvorMIDI2":{"role":"article","type":"topic","url":"\/documentation\/ivormidi2\/usingivormidi2","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/UsingIvorMIDI2","abstract":[{"type":"text","text":"Carry MIDI 1.0 and MIDI 2.0 messages in Universal MIDI Packets, and read them"},{"type":"text","text":" "},{"type":"text","text":"back from a stream of words."}],"title":"Using IvorMIDI2","kind":"article"},"doc://IvorMIDI2/documentation/IvorMIDI2/MIDI2StreamMessage":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MIDI2StreamMessage","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"MIDI2StreamMessage","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"A UMP stream message (message type 0xF), addressed to a UMP endpoint as a","type":"text"},{"text":" ","type":"text"},{"text":"whole.","type":"text"}],"url":"\/documentation\/ivormidi2\/midi2streammessage","role":"symbol","title":"MIDI2StreamMessage","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2StreamMessage"},"doc://IvorMIDI2/documentation/IvorMIDI2/MIDI2SystemExclusive8Message":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MIDI2SystemExclusive8Message"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"MIDI2SystemExclusive8Message"}],"kind":"symbol","abstract":[{"text":"A System Exclusive 8 message (message type 0x5): system exclusive data","type":"text"},{"text":" ","type":"text"},{"text":"whose bytes may use all 8 bits.","type":"text"}],"url":"\/documentation\/ivormidi2\/midi2systemexclusive8message","role":"symbol","title":"MIDI2SystemExclusive8Message","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2SystemExclusive8Message"},"https://github.com/eBardX/IvorMIDI":{"titleInlineContent":[{"type":"text","text":"IvorMIDI"}],"type":"link","identifier":"https:\/\/github.com\/eBardX\/IvorMIDI","title":"IvorMIDI","url":"https:\/\/github.com\/eBardX\/IvorMIDI"},"doc://IvorMIDI2/documentation/IvorMIDI2/MIDI2FlexDataMessage":{"role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MIDI2FlexDataMessage","kind":"identifier"}],"navigatorTitle":[{"text":"MIDI2FlexDataMessage","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormidi2\/midi2flexdatamessage","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2FlexDataMessage","abstract":[{"text":"A Flex Data message (message type 0xD): a setup or performance event, or","type":"text"},{"text":" ","type":"text"},{"text":"text, addressed to a MIDI channel or to a whole group.","type":"text"}],"title":"MIDI2FlexDataMessage","kind":"symbol"},"doc://IvorMIDI2/documentation/