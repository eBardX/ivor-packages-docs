{"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2"},"abstract":[{"type":"text","text":"Universal MIDI Packet (UMP) group and message encoding types."}],"sections":[],"kind":"symbol","topicSections":[{"title":"Guides","identifiers":["doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/UsingIvorMIDI2"],"anchor":"Guides"},{"title":"Data values","identifiers":["doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2Group"],"anchor":"Data-values"},{"title":"Reading messages","identifiers":["doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2Message","doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2MessageReader"],"anchor":"Reading-messages"},{"title":"Packets","identifiers":["doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2Packet","doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2PacketsConvertible","doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2GrouplessPacketsConvertible"],"anchor":"Packets"},{"title":"Utility messages","identifiers":["doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2UtilityMessage"],"anchor":"Utility-messages"},{"title":"MIDI 2.0 channel voice messages","identifiers":["doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2ChannelMessage","doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2NoteAttribute"],"anchor":"MIDI-20-channel-voice-messages"},{"title":"System Exclusive 8 messages","identifiers":["doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2SystemExclusive8Message"],"anchor":"System-Exclusive-8-messages"},{"title":"Flex Data messages","identifiers":["doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2FlexDataMessage"],"anchor":"Flex-Data-messages"},{"title":"UMP stream messages","identifiers":["doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2StreamMessage"],"anchor":"UMP-stream-messages"}],"variants":[{"paths":["\/documentation\/ivormidi2"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[[]]},"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The IvorMIDI2 framework provides "},{"identifier":"https:\/\/midi.org\/universal-midi-packet-ump-and-midi-2-0-protocol-specification","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"support written in Swift, building on the message and data value types of"},{"type":"text","text":" "},{"identifier":"https:\/\/github.com\/eBardX\/IvorMIDI","type":"reference","isActive":true},{"type":"text","text":". A UMP group number addresses"},{"type":"text","text":" "},{"type":"text","text":"one of the 16 groups of a packet stream, and a UMP packet holds the one to four"},{"type":"text","text":" "},{"type":"text","text":"32-bit words that its message type requires. The channel and system messages"},{"type":"text","text":" "},{"type":"text","text":"of IvorMIDI can be converted to and from MIDI 1.0 Universal MIDI Packets, as"},{"type":"text","text":" "},{"type":"text","text":"CoreMIDI’s event lists carry them: channel voice messages as single-word"},{"type":"text","text":" "},{"type":"text","text":"packets of message type 0x2, system common and real-time messages as"},{"type":"text","text":" "},{"type":"text","text":"single-word packets of message type 0x1, and system exclusive messages as"},{"type":"text","text":" "},{"type":"text","text":"two-word packets of message type 0x3. The MIDI 2.0 message families have types"},{"type":"text","text":" "},{"type":"text","text":"of their own: utility messages, MIDI 2.0 channel voice messages, System"},{"type":"text","text":" "},{"type":"text","text":"Exclusive 8 messages, Flex Data messages, and UMP stream messages. A message"},{"type":"text","text":" "},{"type":"text","text":"reader turns a stream of 32-bit words into messages of every family,"},{"type":"text","text":" "},{"type":"text","text":"reassembling those that span several packets."}]},{"syntax":"swift","type":"codeListing","code":["import IvorMIDI","import IvorMIDI2","","\/\/ Middle C, velocity 127, on channel 1 of group 6.","let noteOn = MIDIChannelMessage.noteOn(1, 60, 127)","let packet = noteOn.packet(group: 6)               \/\/ words: [0x25903C7F]","","\/\/ Decode the message and its group from a packet.","if let received = MIDI2Packet(words: [0x25903c7f]) {","    MIDIChannelMessage(packet: received) == noteOn \/\/ true","    received.group                                 \/\/ 6","}","","\/\/ A system exclusive message spans one two-word packet per 6 data bytes.","let sysEx = MIDISystemMessage.systemExclusive([0x7e, 0x7f, 0x09, 0x01, 0xf7])","let packets = sysEx.packets()                      \/\/ words: [0x30047E7F, 0x09010000]","","\/\/ Read the messages of a stream of words, in any grouping.","var reader = MIDI2MessageReader()","","reader.read(words: [0x45903c00])                   \/\/ []: half a packet","reader.read(words: [0xffff0000])                   \/\/ [.midi2ChannelVoice(.noteOn(1, 60, 65535, nil), 6)]"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"See "},{"identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/UsingIvorMIDI2","type":"reference","isActive":true},{"type":"text","text":" for a full guide to packets, groups, the message"},{"type":"text","text":" "},{"type":"text","text":"families, and reading a stream."}]}],"kind":"content"}],"metadata":{"symbolKind":"module","title":"IvorMIDI2","color":{"standardColorIdentifier":"blue"},"roleHeading":"Framework","externalID":"IvorMIDI2","role":"collection","modules":[{"name":"IvorMIDI2"}]},"references":{"doc://IvorMIDI2/documentation/IvorMIDI2/MIDI2NoteAttribute":{"abstract":[{"type":"text","text":"An attribute of a MIDI 2.0 note on or note off message: an attribute type"},{"type":"text","text":" "},{"type":"text","text":"with 16 bits of attribute data."}],"type":"topic","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2NoteAttribute","kind":"symbol","title":"MIDI2NoteAttribute","navigatorTitle":[{"text":"MIDI2NoteAttribute","kind":"identifier"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MIDI2NoteAttribute","kind":"identifier"}],"url":"\/documentation\/ivormidi2\/midi2noteattribute","role":"symbol"},"doc://IvorMIDI2/documentation/IvorMIDI2/MIDI2FlexDataMessage":{"fragments":[{"text":"enum","kind":"keyword"},{"kind":"text","text":" "},{"text":"MIDI2FlexDataMessage","kind":"identifier"}],"navigatorTitle":[{"text":"MIDI2FlexDataMessage","kind":"identifier"}],"identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2FlexDataMessage","abstract":[{"type":"text","text":"A Flex Data message (message type 0xD): a setup or performance event, or"},{"type":"text","text":" "},{"type":"text","text":"text, addressed to a MIDI channel or to a whole group."}],"title":"MIDI2FlexDataMessage","type":"topic","url":"\/documentation\/ivormidi2\/midi2flexdatamessage","role":"symbol","kind":"symbol"},"doc://IvorMIDI2/documentation/IvorMIDI2/MIDI2GrouplessPacketsConvertible":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"MIDI2GrouplessPacketsConvertible"}],"navigatorTitle":[{"kind":"identifier","text":"MIDI2GrouplessPacketsConvertible"}],"identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2GrouplessPacketsConvertible","abstract":[{"type":"text","text":"A type that can be converted to and from the Universal MIDI Packets that"},{"type":"text","text":" "},{"type":"text","text":"encode it without a group."}],"title":"MIDI2GrouplessPacketsConvertible","type":"topic","url":"\/documentation\/ivormidi2\/midi2grouplesspacketsconvertible","role":"symbol","kind":"symbol"},"doc://IvorMIDI2/documentation/IvorMIDI2/MIDI2SystemExclusive8Message":{"identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2SystemExclusive8Message","type":"topic","title":"MIDI2SystemExclusive8Message","kind":"symbol","abstract":[{"type":"text","text":"A System Exclusive 8 message (message type 0x5): system exclusive data"},{"type":"text","text":" "},{"type":"text","text":"whose bytes may use all 8 bits."}],"navigatorTitle":[{"kind":"identifier","text":"MIDI2SystemExclusive8Message"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"MIDI2SystemExclusive8Message","kind":"identifier"}],"url":"\/documentation\/ivormidi2\/midi2systemexclusive8message","role":"symbol"},"doc://IvorMIDI2/documentation/IvorMIDI2/MIDI2Packet":{"type":"topic","navigatorTitle":[{"kind":"identifier","text":"MIDI2Packet"}],"kind":"symbol","abstract":[{"type":"text","text":"A Universal MIDI Packet (UMP): one, two, three, or four 32-bit words."}],"url":"\/documentation\/ivormidi2\/midi2packet","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"text":"MIDI2Packet","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2Packet","title":"MIDI2Packet"},"doc://IvorMIDI2/documentation/IvorMIDI2/UsingIvorMIDI2":{"type":"topic","kind":"article","abstract":[{"type":"text","text":"Carry MIDI 1.0 and MIDI 2.0 messages in Universal MIDI Packets, and read them"},{"type":"text","text":" "},{"type":"text","text":"back from a stream of words."}],"url":"\/documentation\/ivormidi2\/usingivormidi2","role":"article","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/UsingIvorMIDI2","title":"Using IvorMIDI2"},"doc://IvorMIDI2/documentation/IvorMIDI2/MIDI2MessageReader":{"abstract":[{"type":"text","text":"A reader of the messages in a stream of Universal MIDI Packets."}],"type":"topic","title":"MIDI2MessageReader","kind":"symbol","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2MessageReader","navigatorTitle":[{"text":"MIDI2MessageReader","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MIDI2MessageReader","kind":"identifier"}],"url":"\/documentation\/ivormidi2\/midi2messagereader","role":"symbol"},"doc://IvorMIDI2/documentation/IvorMIDI2/MIDI2Message":{"abstract":[{"type":"text","text":"A message of any kind that travels in Universal MIDI Packets."}],"type":"topic","title":"MIDI2Message","kind":"symbol","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2Message","navigatorTitle":[{"text":"MIDI2Message","kind":"identifier"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MIDI2Message","kind":"identifier"}],"url":"\/documentation\/ivormidi2\/midi2message","role":"symbol"},"https://github.com/eBardX/IvorMIDI":{"titleInlineContent":[{"type":"text","text":"IvorMIDI"}],"title":"IvorMIDI","url":"https:\/\/github.com\/eBardX\/IvorMIDI","type":"link","identifier":"https:\/\/github.com\/eBardX\/IvorMIDI"},"https://midi.org/universal-midi-packet-ump-and-midi-2-0-protocol-specification":{"titleInlineContent":[{"type":"text","text":"Universal MIDI"},{"type":"text","text":" "},{"type":"text","text":"Packet"}],"title":"Universal MIDI Packet","url":"https:\/\/midi.org\/universal-midi-packet-ump-and-midi-2-0-protocol-specification","type":"link","identifier":"https:\/\/midi.org\/universal-midi-packet-ump-and-midi-2-0-protocol-specification"},"doc://IvorMIDI2/documentation/IvorMIDI2/MIDI2PacketsConvertible":{"abstract":[{"type":"text","text":"A type that can be converted to and from the Universal MIDI Packets that"},{"type":"text","text":" "},{"type":"text","text":"encode it in a group."}],"type":"topic","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2PacketsConvertible","kind":"symbol","title":"MIDI2PacketsConvertible","navigatorTitle":[{"kind":"identifier","text":"MIDI2PacketsConvertible"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"MIDI2PacketsConvertible"}],"url":"\/documentation\/ivormidi2\/midi2packetsconvertible","role":"symbol"},"doc://IvorMIDI2/documentation/IvorMIDI2/MIDI2Group":{"abstract":[{"type":"text","text":"A Universal MIDI Packet (UMP) group number (1–16)."}],"ty