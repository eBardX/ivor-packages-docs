{"kind":"symbol","sections":[],"topicSections":[{"identifiers":["doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/UsingIvorMIDI2"],"title":"Guides","anchor":"Guides"},{"identifiers":["doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2Group"],"title":"Data values","anchor":"Data-values"},{"identifiers":["doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2Message","doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2MessageReader"],"title":"Reading messages","anchor":"Reading-messages"},{"identifiers":["doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2Packet","doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2PacketsConvertible","doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2GrouplessPacketsConvertible"],"title":"Packets","anchor":"Packets"},{"identifiers":["doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2UtilityMessage"],"title":"Utility messages","anchor":"Utility-messages"},{"identifiers":["doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2ChannelMessage","doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2NoteAttribute"],"title":"MIDI 2.0 channel voice messages","anchor":"MIDI-20-channel-voice-messages"},{"identifiers":["doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2SystemExclusive8Message"],"title":"System Exclusive 8 messages","anchor":"System-Exclusive-8-messages"},{"identifiers":["doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2FlexDataMessage"],"title":"Flex Data messages","anchor":"Flex-Data-messages"},{"identifiers":["doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2StreamMessage"],"title":"UMP stream messages","anchor":"UMP-stream-messages"}],"identifier":{"url":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2","interfaceLanguage":"swift"},"hierarchy":{"paths":[[]]},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"text":"The IvorMIDI2 framework provides ","type":"text"},{"type":"reference","identifier":"https:\/\/midi.org\/universal-midi-packet-ump-and-midi-2-0-protocol-specification","isActive":true},{"text":" ","type":"text"},{"text":"support written in Swift, building on the message and data value types of","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"https:\/\/github.com\/eBardX\/IvorMIDI","isActive":true},{"text":". A UMP group number addresses","type":"text"},{"text":" ","type":"text"},{"text":"one of the 16 groups of a packet stream, and a UMP packet holds the one to four","type":"text"},{"text":" ","type":"text"},{"text":"32-bit words that its message type requires. The channel and system messages","type":"text"},{"text":" ","type":"text"},{"text":"of IvorMIDI can be converted to and from MIDI 1.0 Universal MIDI Packets, as","type":"text"},{"text":" ","type":"text"},{"text":"CoreMIDI’s event lists carry them: channel voice messages as single-word","type":"text"},{"text":" ","type":"text"},{"text":"packets of message type 0x2, system common and real-time messages as","type":"text"},{"text":" ","type":"text"},{"text":"single-word packets of message type 0x1, and system exclusive messages as","type":"text"},{"text":" ","type":"text"},{"text":"two-word packets of message type 0x3. The MIDI 2.0 message families have types","type":"text"},{"text":" ","type":"text"},{"text":"of their own: utility messages, MIDI 2.0 channel voice messages, System","type":"text"},{"text":" ","type":"text"},{"text":"Exclusive 8 messages, Flex Data messages, and UMP stream messages. A message","type":"text"},{"text":" ","type":"text"},{"text":"reader turns a stream of 32-bit words into messages of every family,","type":"text"},{"text":" ","type":"text"},{"text":"reassembling those that span several packets.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import IvorMIDI","import IvorMIDI2","","\/\/ Middle C, velocity 127, on channel 1 of group 6.","let noteOn = MIDIChannelMessage.noteOn(1, 60, 127)","let packet = noteOn.packet(group: 6)               \/\/ words: [0x25903C7F]","","\/\/ Decode the message and its group from a packet.","if let received = MIDI2Packet(words: [0x25903c7f]) {","    MIDIChannelMessage(packet: received) == noteOn \/\/ true","    received.group                                 \/\/ 6","}","","\/\/ A system exclusive message spans one two-word packet per 6 data bytes.","let sysEx = MIDISystemMessage.systemExclusive([0x7e, 0x7f, 0x09, 0x01, 0xf7])","let packets = sysEx.packets()                      \/\/ words: [0x30047E7F, 0x09010000]","","\/\/ Read the messages of a stream of words, in any grouping.","var reader = MIDI2MessageReader()","","reader.read(words: [0x45903c00])                   \/\/ []: half a packet","reader.read(words: [0xffff0000])                   \/\/ [.midi2ChannelVoice(.noteOn(1, 60, 65535, nil), 6)]"],"type":"codeListing"},{"inlineContent":[{"text":"See ","type":"text"},{"type":"reference","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/UsingIvorMIDI2","isActive":true},{"text":" for a full guide to packets, groups, the message","type":"text"},{"text":" ","type":"text"},{"text":"families, and reading a stream.","type":"text"}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormidi2"]}],"abstract":[{"text":"Universal MIDI Packet (UMP) group and message encoding types.","type":"text"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"externalID":"IvorMIDI2","symbolKind":"module","color":{"standardColorIdentifier":"blue"},"title":"IvorMIDI2","modules":[{"name":"IvorMIDI2"}],"roleHeading":"Framework","role":"collection"},"references":{"doc://IvorMIDI2/documentation/IvorMIDI2/MIDI2Message":{"role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MIDI2Message"}],"title":"MIDI2Message","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2Message","type":"topic","abstract":[{"type":"text","text":"A message of any kind that travels in Universal MIDI Packets."}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MIDI2Message","kind":"identifier"}],"url":"\/documentation\/ivormidi2\/midi2message"},"doc://IvorMIDI2/documentation/IvorMIDI2/MIDI2NoteAttribute":{"navigatorTitle":[{"kind":"identifier","text":"MIDI2NoteAttribute"}],"identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2NoteAttribute","url":"\/documentation\/ivormidi2\/midi2noteattribute","type":"topic","title":"MIDI2NoteAttribute","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MIDI2NoteAttribute"}],"abstract":[{"type":"text","text":"An attribute of a MIDI 2.0 note on or note off message: an attribute type"},{"type":"text","text":" "},{"type":"text","text":"with 16 bits of attribute data."}],"role":"symbol","kind":"symbol"},"doc://IvorMIDI2/documentation/IvorMIDI2/MIDI2PacketsConvertible":{"identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2PacketsConvertible","url":"\/documentation\/ivormidi2\/midi2packetsconvertible","role":"symbol","title":"MIDI2PacketsConvertible","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"MIDI2PacketsConvertible"}],"navigatorTitle":[{"kind":"identifier","text":"MIDI2PacketsConvertible"}],"abstract":[{"text":"A type that can be converted to and from the Universal MIDI Packets that","type":"text"},{"text":" ","type":"text"},{"text":"encode it in a group.","type":"text"}],"type":"topic","kind":"symbol"},"doc://IvorMIDI2/documentation/IvorMIDI2/MIDI2SystemExclusive8Message":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MIDI2SystemExclusive8Message"}],"title":"MIDI2SystemExclusive8Message","abstract":[{"type":"text","text":"A System Exclusive 8 message (message type 0x5): system exclusive data"},{"type":"text","text":" "},{"type":"text","text":"whose bytes may use all 8 bits."}],"role":"symbol","url":"\/documentation\/ivormidi2\/midi2systemexclusive8message","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2SystemExclusive8Message","navigatorTitle":[{"kind":"identifier","text":"MIDI2SystemExclusive8Message"}],"type":"topic","kind":"symbol"},"doc://IvorMIDI2/documentation/IvorMIDI2/MIDI2Group":{"abstract":[{"type":"text","text":"A Universal MIDI Packet (UMP) group number (1–16)."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MIDI2Group","kind":"identifier"}],"type":"topic","title":"MIDI2Group","kind":"symbol","navigatorTitle":[{"text":"MIDI2Group","kind":"identifier"}],"identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2Group","url":"\/documentation\/ivormidi2\/midi2group","role":"symbol"},"doc://IvorMIDI2/documentation/IvorMIDI2/MIDI2GrouplessPacketsConvertible":{"identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2GrouplessPacketsConvertible","url":"\/documentation\/ivormidi2\/midi2grouplesspacketsconvertible","role":"symbol","title":"MIDI2GrouplessPacketsConvertible","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"MIDI2GrouplessPacketsConvertible"}],"navigatorTitle":[{"kind":"identifier","text":"MIDI2GrouplessPacketsConvertible"}],"abstract":[{"text":"A type that can be converted to and from the Universal MIDI Packets that","type":"text"},{"text":" ","type":"text"},{"text":"encode it without a group.","type":"text"}],"type":"topic","kind":"symbol"},"doc://IvorMIDI2/documentation/IvorMIDI2/MIDI2Packet":{"role":"symbol","kind":"symbol","navigatorTitle":[{"text":"MIDI2Packet","kind":"identifier"}],"title":"MIDI2Packet","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2Packet","type":"topic","abstract":[{"type":"text","text":"A Universal MIDI Packet (UMP): one, two, three, or four 32-bit words."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MIDI2Packet","kind":"identifier"}],"url":"\/documentation\/ivormidi2\/midi2packet"},"doc://IvorMIDI2/documentati