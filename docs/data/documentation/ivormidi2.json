{"abstract":[{"text":"Universal MIDI Packet (UMP) group and message encoding types.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"The IvorMIDI2 framework provides "},{"identifier":"https:\/\/midi.org\/universal-midi-packet-ump-and-midi-2-0-protocol-specification","type":"reference","isActive":true},{"type":"text","text":" support written in"},{"type":"text","text":" "},{"type":"text","text":"Swift, building on the message and data value types of "},{"code":"IvorMIDI","type":"codeVoice"},{"type":"text","text":". A UMP"},{"type":"text","text":" "},{"type":"text","text":"group number addresses one of the 16 groups of a packet stream, and a UMP"},{"type":"text","text":" "},{"type":"text","text":"packet holds the one to four 32-bit words that its message type requires. The"},{"type":"text","text":" "},{"type":"text","text":"channel and system messages of IvorMIDI can be converted to and from MIDI 1.0"},{"type":"text","text":" "},{"type":"text","text":"Universal MIDI Packets, as CoreMIDI’s event lists carry them: channel voice"},{"type":"text","text":" "},{"type":"text","text":"messages as single-word packets of message type 0x2, system common and"},{"type":"text","text":" "},{"type":"text","text":"real-time messages as single-word packets of message type 0x1, and system"},{"type":"text","text":" "},{"text":"exclusive messages as two-word packets of message type 0x3. The MIDI 2.0","type":"text"},{"text":" ","type":"text"},{"text":"message families have types of their own: utility messages, MIDI 2.0 channel","type":"text"},{"text":" ","type":"text"},{"text":"voice messages, System Exclusive 8 messages, Flex Data messages, and UMP stream","type":"text"},{"text":" ","type":"text"},{"text":"messages. A message reader turns a stream of 32-bit words into messages of","type":"text"},{"text":" ","type":"text"},{"text":"every family, reassembling those that span several packets.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import IvorMIDI","import IvorMIDI2","","\/\/ Middle C, velocity 127, on channel 1 of group 6.","let noteOn = MIDIChannelMessage.noteOn(1, 60, 127)","let packet = noteOn.packet(group: 6)               \/\/ words: [0x25903C7F]","","\/\/ Decode the message and its group from a packet.","if let received = MIDI2Packet(words: [0x25903c7f]) {","    MIDIChannelMessage(packet: received) == noteOn \/\/ true","    received.group                                 \/\/ 6","}","","\/\/ Read the messages of a stream of words, in any grouping.","var reader = MIDI2MessageReader()","","reader.read(words: [0x45903c00])                   \/\/ []: half a packet","reader.read(words: [0xffff0000])                   \/\/ [.midi2ChannelVoice(.noteOn(1, 60, 65535, nil), 6)]"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every concrete public type is a "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":" value type, so instances can be"},{"type":"text","text":" "},{"type":"text","text":"freely shared across tasks and actor boundaries."}]}]}],"hierarchy":{"paths":[[]]},"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2"},"topicSections":[{"title":"Data values","anchor":"Data-values","identifiers":["doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2Group"]},{"title":"Reading messages","anchor":"Reading-messages","identifiers":["doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2Message","doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2MessageReader"]},{"title":"Packets","anchor":"Packets","identifiers":["doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2Packet","doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2PacketsConvertible","doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2GrouplessPacketsConvertible"]},{"title":"Utility messages","anchor":"Utility-messages","identifiers":["doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2UtilityMessage"]},{"title":"MIDI 2.0 channel voice messages","anchor":"MIDI-20-channel-voice-messages","identifiers":["doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2ChannelMessage","doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2NoteAttribute"]},{"title":"System Exclusive 8 messages","anchor":"System-Exclusive-8-messages","identifiers":["doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2SystemExclusive8Message"]},{"title":"Flex Data messages","anchor":"Flex-Data-messages","identifiers":["doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2FlexDataMessage"]},{"title":"UMP stream messages","anchor":"UMP-stream-messages","identifiers":["doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2StreamMessage"]}],"metadata":{"roleHeading":"Framework","title":"IvorMIDI2","externalID":"IvorMIDI2","modules":[{"name":"IvorMIDI2"}],"role":"collection","symbolKind":"module","color":{"standardColorIdentifier":"blue"}},"variants":[{"paths":["\/documentation\/ivormidi2"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://IvorMIDI2/documentation/IvorMIDI2/MIDI2PacketsConvertible":{"abstract":[{"text":"A type that can be converted to and from the Universal MIDI Packets that","type":"text"},{"text":" ","type":"text"},{"text":"encode it in a group.","type":"text"}],"title":"MIDI2PacketsConvertible","fragments":[{"text":"protocol","kind":"keyword"},{"kind":"text","text":" "},{"text":"MIDI2PacketsConvertible","kind":"identifier"}],"role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MIDI2PacketsConvertible"}],"type":"topic","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2PacketsConvertible","url":"\/documentation\/ivormidi2\/midi2packetsconvertible"},"https://midi.org/universal-midi-packet-ump-and-midi-2-0-protocol-specification":{"type":"link","title":"Universal MIDI Packet","identifier":"https:\/\/midi.org\/universal-midi-packet-ump-and-midi-2-0-protocol-specification","titleInlineContent":[{"text":"Universal MIDI Packet","type":"text"}],"url":"https:\/\/midi.org\/universal-midi-packet-ump-and-midi-2-0-protocol-specification"},"doc://IvorMIDI2/documentation/IvorMIDI2":{"role":"collection","kind":"symbol","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2","title":"IvorMIDI2","url":"\/documentation\/ivormidi2","type":"topic","abstract":[{"type":"text","text":"Universal MIDI Packet (UMP) group and message encoding types."}]},"doc://IvorMIDI2/documentation/IvorMIDI2/MIDI2SystemExclusive8Message":{"kind":"symbol","role":"symbol","title":"MIDI2SystemExclusive8Message","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MIDI2SystemExclusive8Message"}],"url":"\/documentation\/ivormidi2\/midi2systemexclusive8message","abstract":[{"type":"text","text":"A System Exclusive 8 message (message type 0x5): system exclusive data"},{"type":"text","text":" "},{"type":"text","text":"whose bytes may use all 8 bits."}],"navigatorTitle":[{"kind":"identifier","text":"MIDI2SystemExclusive8Message"}],"identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2SystemExclusive8Message","type":"topic"},"doc://IvorMIDI2/documentation/IvorMIDI2/MIDI2MessageReader":{"navigatorTitle":[{"kind":"identifier","text":"MIDI2MessageReader"}],"title":"MIDI2MessageReader","kind":"symbol","role":"symbol","url":"\/documentation\/ivormidi2\/midi2messagereader","type":"topic","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2MessageReader","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MIDI2MessageReader"}],"abstract":[{"type":"text","text":"A reader of the messages in a stream of Universal MIDI Packets."}]},"doc://IvorMIDI2/documentation/IvorMIDI2/MIDI2Group":{"identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2Group","role":"symbol","title":"MIDI2Group","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MIDI2Group"}],"url":"\/documentation\/ivormidi2\/midi2group","abstract":[{"type":"text","text":"A Universal MIDI Packet (UMP) group number (1–16)."}],"navigatorTitle":[{"kind":"identifier","text":"MIDI2Group"}],"kind":"symbol","type":"topic"},"doc://IvorMIDI2/documentation/IvorMIDI2/MIDI2ChannelMessage":{"navigatorTitle":[{"text":"MIDI2ChannelMessage","kind":"identifier"}],"title":"MIDI2ChannelMessage","kind":"symbol","role":"symbol","type":"topic","url":"\/documentation\/ivormidi2\/midi2channelmessage","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2ChannelMessage","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MIDI2ChannelMessage"}],"abstract":[{"text":"A MIDI 2.0 channel voice message (message type 0x4).","type":"text"}]},"doc://IvorMIDI2/documentation/IvorMIDI2/MIDI2StreamMessage":{"role":"symbol","kind":"symbol","title":"MIDI2StreamMessage","url":"\/documentation\/ivormidi2\/midi2streammessage","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2StreamMessage","fragments":[{"kind":"keyword","text":"enum"},{"text":" ","kind":"text"},{"kind":"identifier","text":"MIDI2StreamMessage"}],"type":"topic","navigatorTitle":[{"text":"MIDI2StreamMessage","kind":"identifier"}],"abstract":[{"type":"text","text":"A UMP stream message (message type 0xF), addressed to a UMP endpoint as a"},{"type":"text","text":" "},{"type":"text","text":"whole."}]},"doc://IvorMIDI2/documentation/IvorMIDI2/MIDI2Packet":{"role":"symbol","kind":"symbol","title":"MIDI2Packet","url":"\/documentation\/ivormidi2\/midi2packet","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2Packet","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MIDI2Packet","kind":"identifier"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"MIDI2Packet"}],"abstract":[{"text":"A Universal MIDI Packet (UMP): one, two, three, or four 32-bit words.","type":"text"}]},"doc://IvorMIDI2/documentation/IvorMIDI2/MIDI2Message":{"abstract":[{"text":"A message of any kind that travels in Universal MIDI Packets.","type":"text"}],"title":"MIDI2Message","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MIDI2Message"}],"role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MIDI2Message"}],"type":"topic","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2Message","url":"\/documentation\/ivormidi2\/midi2message"},"doc://IvorMIDI2/documentation/IvorMIDI2/MIDI2NoteAttribute":{"abstract":[{"text":"An attribute of a MIDI 2.0 note on or note off message: an attribute type","type":"text"},{"text":" ","type":"text"},{"text":"with 16 bits of attribute data.","type":"text"}],"title":"MIDI2NoteAttribute","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MIDI2NoteAttribute"}],"role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MIDI2NoteAttribute"}],"type":"topic","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2NoteAttribute","url":"\/documentation\/ivormidi2\/midi2noteattribute"},"doc://IvorMIDI2/documentation/IvorMIDI2/MIDI2GrouplessPacketsConvertible":{"role":"symbol","abstract":[{"text":"A type that can be converted to and from the Universal MIDI Packets that","type":"text"},{"text":" ","type":"text"},{"text":"encode it without a group.","type":"text"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormidi2\/midi2grouplesspacketsconvertible","title":"MIDI2GrouplessPacketsConvertible","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MIDI2GrouplessPacketsConvertible","kind":"identifier"}],"navigatorTitle":[{"text":"MIDI2GrouplessPacketsConvertible","kind":"identifier"}],"identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2GrouplessPacketsConvertible"},"doc://IvorMIDI2/documentation/IvorMIDI2/MIDI2FlexDataMessage":{"navigatorTitle":[{"kind":"identifier","text":"MIDI2FlexDataMessage"}],"title":"MIDI2FlexDataMessage","kind":"symbol","role":"symbol","type":"topic","url":"\/documentation\/ivormidi2\/midi2flexdatamessage","identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2FlexDataMessage","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MIDI2FlexDataMessage"}],"abstract":[{"text":"A Flex Data message (message type 0xD): a setup or performance event, or","type":"text"},{"text":" ","type":"text"},{"text":"text, addressed to a MIDI channel or to a whole group.","type":"text"}]},"doc://IvorMIDI2/documentation/IvorMIDI2/MIDI2UtilityMessage":{"kind":"symbol","role":"symbol","title":"MIDI2UtilityMessage","fragments":[{"kind":"keyword","text":"enum"},{"text":" ","kind":"text"},{"kind":"identifier","text":"MIDI2UtilityMessage"}],"url":"\/documentation\/ivormidi2\/midi2utilitymessage","abstract":[{"text":"A Universal MIDI Packet utility message (message type 0x0).","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"MIDI2UtilityMessage"}],"identifier":"doc:\/\/IvorMIDI2\/documentation\/IvorMIDI2\/MIDI2UtilityMessage","type":"topic"}}}