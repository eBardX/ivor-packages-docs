{"abstract":[{"text":"Musical pitch, interval, and tuning system types.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorTuning\/documentation\/IvorTuning"},"metadata":{"roleHeading":"Framework","color":{"standardColorIdentifier":"blue"},"externalID":"IvorTuning","symbolKind":"module","title":"IvorTuning","role":"collection","modules":[{"name":"IvorTuning"}]},"hierarchy":{"paths":[[]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivortuning"]}],"kind":"symbol","primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The IvorTuning framework provides musical pitch, interval, and tuning system"},{"type":"text","text":" "},{"type":"text","text":"types written in Swift. Pitches and intervals are each available in standard,"},{"type":"text","text":" "},{"type":"text","text":"keyboard, and absolute (frequency) representations. Several tuning systems are"},{"type":"text","text":" "},{"type":"text","text":"provided, including equal temperament, just intonation, meantone temperament,"},{"type":"text","text":" "},{"type":"text","text":"Pythagorean tuning, and well temperament."}],"type":"paragraph"},{"code":["import IvorTuning","","let a4 = Pitch(plain: \"A4\")!","","\/\/ Standard pitch to frequency, in quarter-comma meantone at A4 = 415 Hz.","let toFrequency = try StandardToAbsolutePitchConverter(tuningSystem: LinearTemperament.quarterCommaMeantone,","                                                       pitchStandard: .a415)","","toFrequency.convert(a4)                     \/\/ 415 Hz","","\/\/ Standard pitch to MIDI note number, on a 12-tone equal-tempered piano.","StandardToKeyboardPitchConverter().convert(a4)              \/\/ 69","","\/\/ Spell a passage of MIDI note numbers in context.","KeyboardToStandardPitchConverter().convert([60, 63, 67, 70])    \/\/ C4, E♭4, G4, B♭4","","\/\/ Intervals in standard notation.","a4.interval(to: Pitch(plain: \"C#5\")!)       \/\/ an ascending major third"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"See "},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorTuning\/documentation\/IvorTuning\/UsingIvorTuning"},{"type":"text","text":" for a full guide to the pitch and interval types,"},{"type":"text","text":" "},{"type":"text","text":"tuning systems, conversion between notations, keyboard layouts, and spelling."}],"type":"paragraph"}]}],"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"topicSections":[{"identifiers":["doc:\/\/IvorTuning\/documentation\/IvorTuning\/UsingIvorTuning"],"anchor":"Guides","title":"Guides"},{"identifiers":["doc:\/\/IvorTuning\/documentation\/IvorTuning\/Pitch","doc:\/\/IvorTuning\/documentation\/IvorTuning\/PitchClass","doc:\/\/IvorTuning\/documentation\/IvorTuning\/Interval"],"anchor":"Standard-notation","title":"Standard notation"},{"identifiers":["doc:\/\/IvorTuning\/documentation\/IvorTuning\/Key"],"anchor":"Keys","title":"Keys"},{"identifiers":["doc:\/\/IvorTuning\/documentation\/IvorTuning\/Frequency","doc:\/\/IvorTuning\/documentation\/IvorTuning\/Ratio"],"anchor":"Absolute-notation","title":"Absolute notation"},{"identifiers":["doc:\/\/IvorTuning\/documentation\/IvorTuning\/NoteNumber","doc:\/\/IvorTuning\/documentation\/IvorTuning\/NoteDistance"],"anchor":"Keyboard-notation","title":"Keyboard notation"},{"identifiers":["doc:\/\/IvorTuning\/documentation\/IvorTuning\/PitchNotation","doc:\/\/IvorTuning\/documentation\/IvorTuning\/PitchProtocol","doc:\/\/IvorTuning\/documentation\/IvorTuning\/PitchDirection","doc:\/\/IvorTuning\/documentation\/IvorTuning\/IntervalProtocol","doc:\/\/IvorTuning\/documentation\/IvorTuning\/DirectedInterval"],"anchor":"Pitches-and-intervals-in-general","title":"Pitches and intervals in general"},{"identifiers":["doc:\/\/IvorTuning\/documentation\/IvorTuning\/TuningSystem","doc:\/\/IvorTuning\/documentation\/