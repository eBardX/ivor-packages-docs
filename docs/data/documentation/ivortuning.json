{"abstract":[{"text":"Musical pitch, interval, and tuning system types.","type":"text"}],"hierarchy":{"paths":[[]]},"metadata":{"roleHeading":"Framework","externalID":"IvorTuning","role":"collection","modules":[{"name":"IvorTuning"}],"symbolKind":"module","title":"IvorTuning","color":{"standardColorIdentifier":"blue"}},"sections":[],"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The IvorTuning framework provides musical pitch, interval, and tuning system"},{"type":"text","text":" "},{"type":"text","text":"types written in Swift. Pitches and intervals are each available in standard,"},{"type":"text","text":" "},{"type":"text","text":"keyboard, and absolute (frequency) representations. Several tuning systems are"},{"type":"text","text":" "},{"type":"text","text":"provided, including equal temperament, just intonation, meantone temperament,"},{"type":"text","text":" "},{"type":"text","text":"Pythagorean tuning, and well temperament."}]},{"syntax":"swift","type":"codeListing","code":["import IvorTuning","","let a4 = Pitch(plain: \"A4\")!","","\/\/ Standard pitch to frequency, in quarter-comma meantone at A4 = 415 Hz.","let toFrequency = try StandardToAbsolutePitchConverter(tuningSystem: LinearTemperament.quarterCommaMeantone,","                                                       pitchStandard: .a415)","","toFrequency.convert(a4)                     \/\/ 415 Hz","","\/\/ Standard pitch to MIDI note number, on a 12-tone equal-tempered piano.","StandardToKeyboardPitchConverter().convert(a4)              \/\/ 69","","\/\/ Spell a passage of MIDI note numbers in context.","KeyboardToStandardPitchConverter().convert([60, 63, 67, 70])    \/\/ C4, E♭4, G4, B♭4","","\/\/ Intervals in standard notation.","a4.interval(to: Pitch(plain: \"C#5\")!)       \/\/ an ascending major third"]