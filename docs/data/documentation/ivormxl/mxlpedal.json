"text","text":"used. It is no by default. Otherwise the abbreviated attribute is ignored. The alignment attributes are"},{"type":"text","text":" "},{"type":"text","text":"ignored if the sign attribute is no."}],"url":"\/documentation\/ivormxl\/mxlpedal"},"doc://IvorMXL/s8CopyableP":{"identifier":"doc:\/\/IvorMXL\/s8CopyableP","title":"Swift.Copyable","type":"unresolvable"},"doc://IvorMXL/documentation/IvorMXL/MXLPedal/color":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPedal\/color","kind":"symbol","type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlpedal\/color","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"color","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLColor","preciseIdentifier":"s:7IvorMXL8MXLColorV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"title":"color","abstract":[{"type":"text","text":"The color attribute group indicates the color of an element."}]},"doc://IvorMXL/documentation/IvorMXL/MXLPedal/Kind-swift.enum":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Kind"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPedal\/Kind-swift.enum","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Kind"}],"title":"MXLPedal.Kind","abstract":[{"type":"text","text":"The pedal-type simple type is used to distinguish types of pedal directions. The start value indicates the"},{"type":"text","text":" "},{"type":"text","text":"start of a damper pedal, while the sostenuto value indicates the start of a sostenuto pedal. The other values"},{"type":"text","text":" "},{"type":"text","text":"can be used with either the damper or sostenuto pedal. The soft pedal is not included here because there is"},{"type":"text","text":" "},{"type":"text","text":"no special symbol or graphic used for it beyond what can be specified with words and bracket elements."}],"url":"\/documentation\/ivormxl\/mxlpedal\/kind-swift.enum"},"doc://IvorMXL/s16SendableMetatypeP":{"identifier":"doc:\/\/IvorMXL\/s16SendableMetatypeP","title":"Swift.SendableMetatype","type":"unresolvable"},"doc://IvorMXL/SH":{"identifier":"doc:\/\/IvorMXL\/SH","title":"Swift.Hashable","type":"unresolvable"},"doc://IvorMXL/documentation/IvorMXL/MXLPedal/position":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPedal\/position","kind":"symbol","type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlpedal\/position","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"position","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLPosition","preciseIdentifier":"s:7IvorMXL11MXLPositionV","kind":"typeIdentifier"}],"title":"position","abstract":[{"type":"text","text":"For most elements, any program will compute a default x and y position. The position attributes let this be"},{"type":"text","text":" "},{"type":"text","text":"changed two ways."}]},"doc://IvorMXL/documentation/IvorMXL/MXLPedal/valign":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPedal\/valign","kind":"symbol","type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlpedal\/valign","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"valign","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLValign","preciseIdentifier":"s:7IvorMXL9MXLValignO","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"title":"valign","abstract":[{"type":"text","text":"The valign attribute is used to indicate vertical alignment to the top, middle, bottom, or baseline of the"},{"type":"text","text":" "},{"type":"text","text":"text. Defaults are implementation-dependent."}]},"doc://IvorMXL/s8SendableP":{"identifier":"doc:\/\/IvorMXL\/s8SendableP","title":"Swift.Sendable","type":"unresolvable"},"doc://IvorMXL/documentation/IvorMXL/MXLPedal/font":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPedal\/font","kind":"symbol","type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlpedal\/font","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"font","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLFont","preciseIdentifier":"s:7IvorMXL7MXLFontV","kind":"typeIdentifier"}],"title":"font","abstract":[{"type":"text","text":"The font attribute group gathers together attributes for determining the font within a credit or direction."},{"type":"text","text":" "},{"type":"text","text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of"},{"type":"text","text":" "},{"type":"text","text":"font names.The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric"},{"type":"text","text":" "},{"type":"text","text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font"},{"type":"text","text":" "},{"type":"text","text":"vs. a music font."}]},"doc://IvorMXL/documentation/IvorMXL/MXLPedal/usesLines":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPedal\/usesLines","kind":"symbol","type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlpedal\/useslines","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"usesLines","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"title":"usesLines","abstract":[{"type":"text","text":"A Boolean value indicating whether pedal lines are used."}]},"doc://IvorMXL/documentation/IvorMXL/MXLPedal/isAbbreviated":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPedal\/isAbbreviated","kind":"symbol","type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlpedal\/isabbreviated","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isAbbreviated","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"title":"isAbbreviated","abstract":[{"type":"text","text":"A Boolean value indicating whether the short P and S signs are used instead of the full Ped and Sost signs,"},{"type":"text","text":" "},{"type":"text","text":"when the sign attribute is set and the type is start or sostenuto."}]},"doc://IvorMXL/SQ":{"identifier":"doc:\/\/IvorMXL\/SQ","title":"Swift.Equatable","type":"unresolvable"}}}