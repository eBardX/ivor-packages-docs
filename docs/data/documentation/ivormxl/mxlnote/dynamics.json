{"abstract":[{"type":"text","text":"The Note On velocity, corresponding to MIDI 1.0’s Note On velocity, expressed as a percentage of the default"},{"type":"text","text":" "},{"type":"text","text":"forte value (90 for MIDI 1.0)."}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote"]]},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlnote\/dynamics"]}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dynamics","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLNonNegativeDecimal","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNonNegativeDecimal","preciseIdentifier":"s:7IvorMXL21MXLNonNegativeDecimala"},{"text":"?","kind":"text"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Maps to the MusicXML "},{"type":"codeVoice","code":"dynamics"},{"type":"text","text":" attribute."}]}]}],"metadata":{"externalID":"s:7IvorMXL7MXLNoteV8dynamicsSdSgvp","title":"dynamics","symbolKind":"property","roleHeading":"Instance Property","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dynamics","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLNonNegativeDecimal","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL21MXLNonNegativeDecimala"},{"text":"?","kind":"text"}],"modules":[{"name":"IvorMXL"}],"role":"symbol"},"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/dynamics","interfaceLanguage":"swift"},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLNote/dynamics":{"title":"dynamics","kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dynamics","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLNonNegativeDecimal","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL21MXLNonNegativeDecimala"},{"text":"?","kind":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/dynamics","url":"\/documentation\/ivormxl\/mxlnote\/dynamics","type":"topic","abstract":[{"type":"text","text":"The Note On velocity, corresponding to MIDI 1.0’s Note On velocity, expressed as a percentage of the default"},{"type":"text","text":" "},{"type":"text","text":"forte value (90 for MIDI 1.0)."}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"title":"MXLNote","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNote"}],"abstract":[{"type":"text","text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for"},{"type":"text","text":" "},{"type":"text","text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation)."},{"type":"text","text":" "},{"type":"text","text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,"},{"type":"text","text":" "},{"type":"text","text":"but no tie elements. Having these two types of information available can make interchange easier, as some"},{"type":"text","text":" "},{"type":"text","text":"programs handle one type of information more readily than the other."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLNote"}],"url":"\/documentation\/ivormxl\/mxlnote"},"doc://IvorMXL/documentation/IvorMXL/MXLNonNegativeDecimal":{"fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNonNegativeDecimal"}],"navigatorTitle":[{"text":"MXLNonNega