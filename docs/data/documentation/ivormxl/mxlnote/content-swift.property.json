 do forward elements,","type":"text"},{"text":" ","type":"text"},{"text":"but no tie elements. Having these two types of information available can make interchange easier, as some","type":"text"},{"text":" ","type":"text"},{"text":"programs handle one type of information more readily than the other.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","role":"symbol","url":"\/documentation\/ivormxl\/mxlnote","kind":"symbol","navigatorTitle":[{"text":"MXLNote","kind":"identifier"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/Content-swift.enum":{"title":"MXLNote.Content","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Content"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlnote\/content-swift.enum","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Content"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Content-swift.enum","abstract":[{"text":"One of the alternatives for Note.","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/content-swift.property":{"kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"One of the alternatives for Note."}],"url":"\/documentation\/ivormxl\/mxlnote\/content-swift.property","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"content","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Content","preciseIdentifier":"s:7IvorMXL7MXLNoteV7ContentO","kind":"typeIdentifier"}],"title":"content","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/content-swift.property"}}}