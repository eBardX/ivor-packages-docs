gatorTitle":[{"text":"MXLBeam","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"Beam values include begin, continue, end, forward hook, and backward hook. Up to eight concurrent beams are","type":"text"},{"text":" ","type":"text"},{"text":"available to cover up to 1024th notes. Each beam in a note is represented with a separate beam element,","type":"text"},{"text":" ","type":"text"},{"text":"starting with the eighth note beam using a number attribute of 1.","type":"text"}],"role":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBeam","url":"\/documentation\/ivormxl\/mxlbeam","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLBeam","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNote"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLNote"}],"url":"\/documentation\/ivormxl\/mxlnote","role":"symbol","title":"MXLNote","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","type":"topic","abstract":[{"type":"text","text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for"},{"type":"text","text":" "},{"type":"text","text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation)."},{"type":"text","text":" "},{"type":"text","text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,"},{"type":"text","text":" "},{"type":"text","text":"but no tie elements. Having these two types of information available can make interchange easier, as some"},{"type":"text","text":" "},{"type":"text","text":"programs handle one type of information more readily than the other."}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote/beam":{"url":"\/documentation\/ivormxl\/mxlnote\/beam","fragments":[{"ki