{"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote"]]},"abstract":[{"type":"text","text":"The beam markings associated with this note."}],"metadata":{"modules":[{"name":"IvorMXL"}],"externalID":"s:7IvorMXL7MXLNoteV4beamSayAA7MXLBeamVGvp","title":"beam","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"beam","kind":"identifier"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:7IvorMXL7MXLBeamV","text":"MXLBeam","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"roleHeading":"Instance Property","role":"symbol","symbolKind":"property"},"variants":[{"paths":["\/documentation\/ivormxl\/mxlnote\/beam"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/beam","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"beam","kind":"identifier"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:7IvorMXL7MXLBeamV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBeam","text":"MXLBeam","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"platforms":["macOS"]}]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"Maps to nested MusicXML ","type":"text"},{"code":"<beam>","type":"codeVoice"},{"text":" elements.","type":"text"}]}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"symbol","references":{"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlnote","title":"MXLNote","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNote","kind":"identifier"}],"navigatorTitle":[{"text":"MXLNote","kind":"identifier"}],"abstract":[{"type":"text","text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for"},{"type":"text","text":" "},{"type":"text","text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation)."},{"type":"text","text":" "},{"type":"text","text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,"},{"type":"text","text":" "},{"text":"but no tie elements. Having these two types of information available can make interchange easier, as some","type":"text"},{"type":"text","text":" "},{"type":"text","text":"programs handle one type of information more readily than the other."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/beam":{"url":"\/documentation\/ivormxl\/mxlnote\/beam","role":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/beam","abstract":[{"type":"text","text":"The beam markings associated with this note."}],"title":"beam","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"beam","kind":"identifier"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:7IvorMXL7MXLBeamV","text":"MXLBeam","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLBeam":{"kind":"symbol","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBeam","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLBeam","kind":"identifier"}],"type":"topic","abstract":[{"text":"Beam values include begin, continue, end, forward hook, and backward hook. Up to eight concurrent beams are","type":"text"},{"text":" ","type":"text"},{"text":"available to cover up to 1024th notes. Each beam in a note is represented with a separate beam element,","type":"text"},{"text":" ","type":"text"},{"text":"starting with the eighth note beam using a number attribute of 1.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlbeam","navigatorTitle":[{"kind":"identifier","text":"MXLBeam"}],"title":"MXLBeam"}}}