{"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote"]]},"metadata":{"modules":[{"name":"IvorMXL"}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"beam","kind":"identifier"},{"text":": [","kind":"text"},{"text":"MXLBeam","preciseIdentifier":"s:7IvorMXL7MXLBeamV","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"roleHeading":"Instance Property","title":"beam","role":"symbol","externalID":"s:7IvorMXL7MXLNoteV4beamSayAA7MXLBeamVGvp","symbolKind":"property"},"schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlnote\/beam"]}],"sections":[],"kind":"symbol","identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/beam","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"beam","kind":"identifier"},{"text":": [","kind":"text"},{"text":"MXLBeam","preciseIdentifier":"s:7IvorMXL7MXLBeamV","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBeam"},{"text":"]","kind":"text"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"Maps to nested MusicXML ","type":"text"},{"code":"<beam>","type":"codeVoice"},{"text":" elements.","type":"text"}]}]}],"abstract":[{"type":"text","text":"The beam markings associated with this note."}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNote","kind":"identifier"}],"title":"MXLNote","abstract":[{"text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for","type":"text"},{"text":" ","type":"text"},{"text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation).","type":"text"},{"text":" ","type":"text"},{"text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,","type":"text"},{"text":" ","type":"text"},{"text":"but no tie elements. Having these two types of information available can make interchange easier, as some","type":"text"},{"text":" ","type":"text"},{"text":"programs handle one type of information more readily than the other.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","role":"symbol","url":"\/documentation\/ivormxl\/mxlnote","kind":"symbol","navigatorTitle":[{"text":"MXLNote","kind":"identifier"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/beam":{"kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"The beam markings associated with this note."}],"url":"\/documentation\/ivormxl\/mxlnote\/beam","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"beam","kind":"identifier"},{"text":": [","kind":"text"},{"text":"MXLBeam","preciseIdentifier":"s:7IvorMXL7MXLBeamV","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"title":"beam","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/beam"},"doc://IvorMXL/documentation/IvorMXL/MXLBeam":{"type":"topic","abstract":[{"text":"Beam values include begin, continue, end, forward hook, and backward hook. Up to eight concurrent beams are","type":"text"},{"text":" ","type":"text"},{"text":"available to cover up to 1024th notes. Each beam in a note is represented with a separate beam element,","type":"text"},{"text":" ","type":"text"},{"text":"starting with the eighth note beam using a number attribute of 1.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlbeam","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLBeam","kind":"identifier"}],"kind":"symbol","title":"MXLBeam","navigatorTitle":[{"text":"MXLBeam","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBeam","role":"symbol"}}}