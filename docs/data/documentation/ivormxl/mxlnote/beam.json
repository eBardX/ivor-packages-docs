used for sound, tied for notation).","type":"text"},{"text":" ","type":"text"},{"text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,","type":"text"},{"text":" ","type":"text"},{"text":"but no tie elements. Having these two types of information available can make interchange easier, as some","type":"text"},{"text":" ","type":"text"},{"text":"programs handle one type of information more readily than the other.","type":"text"}],"title":"MXLNote","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","kind":"symbol","url":"\/documentation\/ivormxl\/mxlnote","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNote"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/beam":{"url":"\/documentation\/ivormxl\/mxlnote\/beam","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/beam","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"beam","kind":"identifier"},{"text":": [","kind":"text"},{"text":"MXLBeam","preciseIdentifier":"s:7IvorMXL7MXLBeamV","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"kind":"symbol","abstract":[{"text":"The beam markings associated with this note.","type":"text"}],"type":"topic","title":"beam"},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLBeam":{"abstract":[{"type":"text","text":"Beam values include begin, continue, end, forward hook, and backward hook. Up to eight concurrent beams are"},{"type":"text","text":" "},{"type":"text","text":"available to cover up to 1024th notes. Each beam in a note is represented with a separate beam element,"},{"type":"text","text":" "},{"type":"text","text":"starting with the eighth note beam using a number attribute of 1."}],"title":"MXLBeam","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLBeam","kind":"identifier"}],"navigatorTitle":[{"text":"MXLBeam","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlbeam","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBeam"}}}