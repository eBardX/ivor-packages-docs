{"abstract":[{"text":"The beam markings associated with this note.","type":"text"}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote"]]},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlnote\/beam"]}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"beam"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:7IvorMXL7MXLBeamV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBeam","kind":"typeIdentifier","text":"MXLBeam"},{"kind":"text","text":"]"}]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"Maps to nested MusicXML "},{"type":"codeVoice","code":"<beam>"},{"type":"text","text":" elements."}],"type":"paragraph"}]}],"metadata":{"externalID":"s:7IvorMXL7MXLNoteV4beamSayAA7MXLBeamVGvp","title":"beam","symbolKind":"property","roleHeading":"Instance Property","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"beam"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:7IvorMXL7MXLBeamV","kind":"typeIdentifier","text":"MXLBeam"},{"kind":"text","text":"]"}],"modules":[{"name":"IvorMXL"}],"role":"symbol"},"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/beam","interfaceLanguage":"swift"},"references":{"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"title":"MXLNote","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNote"}],"abstract":[{"type":"text","text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for"},{"type":"text","text":" "},{"type":"text","text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation)."},{"type":"text","text":" "},{"type":"text","text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,"},{"type":"text","text":" "},{"type":"text","text":"but no tie elements. Having these two types of information available can make interchange easier, as some"},{"type":"text","text":" "},{"type":"text","text":"programs handle one type of information more readily than the other."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLNote"}],"url":"\/documentation\/ivormxl\/mxlnote"},"doc://IvorMXL/documentation/IvorMXL/MXLBeam":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlbeam","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBeam","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLBeam","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"Beam values include begin, continue, end, forward hook, and backward hook. Up to eight concurrent beams are","type":"text"},{"text":" ","type":"text"},{"text":"available to cover up to 1024th notes. Each beam in a note is represented with a separate beam element,","type":"text"},{"text":" ","type":"text"},{"text":"starting with the eighth note beam using a number attribute of 1.","type":"text"}],"type":"topic","navigatorTitle":[{"text":"MXLBeam","kind":"identifier"}],"title":"MXLBeam"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/beam":{"title":"beam","kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"beam","kind":"identifier"},{"text":": [","kind":"text"},{"text":"MXLBeam","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL7MXLBeamV"},{"text":"]","kind":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/beam","url":"\/documentation\/ivormxl\/mxlnote\/beam","type":"topic","abstract":[{"type":"text","text":"The beam markings associated with this note."}],"role":"symbol"}}}