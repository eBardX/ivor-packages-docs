,"type":"topic","role":"collection"},"doc://IvorMXL/s8SendableP":{"identifier":"doc:\/\/IvorMXL\/s8SendableP","type":"unresolvable","title":"Swift.Sendable"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/Notehead-swift.struct":{"abstract":[{"type":"text","text":"The notehead type indicates shapes other than the open and closed ovals associated with note durations."}],"title":"MXLNote.Notehead","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Notehead","kind":"identifier"}],"navigatorTitle":[{"text":"Notehead","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlnote\/notehead-swift.struct","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Notehead-swift.struct"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/Notehead-swift.struct/Value-swift.enum":{"abstract":[{"type":"text","text":"The notehead-value type indicates shapes other than the open and closed ovals associated with note durations."}],"title":"MXLNote.Notehead.Value","kind":"symbol","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Value","kind":"identifier"}],"navigatorTitle":[{"text":"Value","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlnote\/notehead-swift.struct\/value-swift.enum","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Notehead-swift.struct\/Value-swift.enum"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/Notehead-swift.struct/smufl":{"url":"\/documentation\/ivormxl\/mxlnote\/notehead-swift.struct\/smufl","abstract":[{"type":"text","text":"The smufl attribute group is used to indicate a particular Standard Music Font Layout (SMuFL) character."},{"type":"text","text":" "},{"type":"text","text":"Sometimes this is a formatting choice, and sometimes this is a refinement of the semantic meaning of an"},{"type":"text","text":" "},{"type":"text","text":"element."}],"title":"smufl","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Notehead-swift.struct\/smufl","type":"topic","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"smufl"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL17MXLSmuflGlyphNameV","kind":"typeIdentifier","text":"MXLSmuflGlyphName"},{"kind":"text","text":"?"}],"role":"symbol"},"doc://IvorMXL/s8CopyableP":{"identifier":"doc:\/\/IvorMXL\/s8CopyableP","type":"unresolvable","title":"Swift.Copyable"},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"navigatorTitle":[{"kind":"identifier","text":"MXLNote"}],"abstract":[{"text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for","type":"text"},{"text":" ","type":"text"},{"text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation).","type":"text"},{"text":" ","type":"text"},{"text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,","type":"text"},{"text":" ","type":"text"},{"text":"but no tie elements. Having these two types of information available can make interchange easier, as some","type":"text"},{"text":" ","type":"text"},{"text":"programs handle one type of information more readily than the other.","type":"text"}],"title":"MXLNote","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","kind":"symbol","url":"\/documentation\/ivormxl\/mxlnote","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNote"}],"role":"symbol"},"doc://IvorMXL/s16SendableMetatypeP":{"identifier":"doc:\/\/IvorMXL\/s16SendableMetatypeP","type":"unresolvable","title":"Swift.SendableMetatype"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/Notehead-swift.struct/Equatable-Implementations":{"url":"\/documentation\/ivormxl\/mxlnote\/notehead-swift.struct\/equatable-implementations","abstract":[],"title":"Equa