{"kind":"symbol","identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Notehead-swift.struct","interfaceLanguage":"swift"},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Notehead"}]}]},{"content":[{"anchor":"overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The smufl attribute can be used to specify a particular notehead, allowing application interoperability"},{"type":"text","text":" "},{"type":"text","text":"without requiring every SMuFL glyph to have a MusicXML element equivalent. This attribute can be used either"},{"type":"text","text":" "},{"type":"text","text":"with the “other” value, or to refine a specific notehead value such as “cluster”. Noteheads in the SMuFL Note"},{"type":"text","text":" "},{"type":"text","text":"name noteheads and Note name noteheads supplement ranges (U+E150–U+E1AF and U+EEE0–U+EEFF) should not use the"},{"type":"text","text":" "},{"type":"text","text":"smufl attribute or the “other” value, but instead use the notehead-text element."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For the enclosed shapes, the default is to be hollow for half notes and longer, and filled otherwise. The"},{"type":"text","text":" "},{"type":"text","text":"filled attribute can be set to change this if needed."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If the parentheses attribute is set to yes, the notehead is parenthesized. It is no by default."}],"type":"paragraph"},{"inlineContent":[{"text":"Maps the MusicXML ","type":"text"},{"code":"<notehead>","type":"codeVoice"},{"text":" element.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"type":"text","text":"The notehead type indicates shapes other than the open and closed ovals associated with note durations."}],"topicSections":[{"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Notehead-swift.struct\/init(value:isFilled:hasParentheses:font:color:smufl:)"],"generated":true},{"anchor":"Instance-Properties","title":"Instance Properties","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Notehead-swift.struct\/color","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Notehead-swift.struct\/font","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Notehead-swift.struct\/hasParentheses","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Notehead-swift.struct\/isFilled","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Notehead-swift.struct\/smufl","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Notehead-swift.struct\/value-swift.property"],"generated":true},{"anchor":"Enumerations","title":"Enumerations","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Notehead-swift.struct\/Value-swift.enum"],"generated":true},{"anchor":"Default-Implementations","title":"Default Implementations","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Notehead-swift.struct\/Equatable-Implementations"],"generated":true}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote"]]},"relationshipsSections":[{"type":"conformsTo","title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/IvorMXL\/s8CopyableP","doc:\/\/IvorMXL\/SQ","doc:\/\/IvorMXL\/s9EscapableP","doc:\/\/IvorMXL\/SH","doc:\/\/IvorMXL\/s8SendableP","doc:\/\/IvorMXL\/s16SendableMetatypeP"]}],"metadata":{"symbolKind":"struct","role":"symbol","extendedModule":"IvorMXL","navigatorTitle":[{"text":"Notehead","kind":"identifier"}],"title":"MXLNote.Notehead","modules":[{"name":"IvorMXL"}],"externalID":"s:7IvorMXL7MXLNoteV8NoteheadV","roleHeading":"Structure","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Notehead","kind":"identifie