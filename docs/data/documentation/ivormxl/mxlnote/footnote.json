{"kind":"symbol","abstract":[{"text":"The footnote element specifies editorial information that appears in footnotes in the printed score. It is","type":"text"},{"text":" ","type":"text"},{"text":"defined within a group due to its multiple uses within the MusicXML schema.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlnote\/footnote"]}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote"]]},"sections":[],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/footnote","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"footnote","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLFormattedText","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFormattedText","preciseIdentifier":"s:7IvorMXL16MXLFormattedTextV"},{"text":"?","kind":"text"}],"platforms":["macOS"]}]},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"inlineContent":[{"text":"Maps to a nested MusicXML ","type":"text"},{"type":"codeVoice","code":"<footnote>"},{"text":" element.","type":"text"}],"type":"paragraph"}]}],"metadata":{"externalID":"s:7IvorMXL7MXLNoteV8footnoteAA16MXLFormattedTextVSgvp","roleHeading":"Instance Property","modules":[{"name":"IvorMXL"}],"role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"footnote","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLFormattedText","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL16MXLFormattedTextV"},{"text":"?","kind":"text"}],"symbolKind":"property","title":"footnote"},"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLNote/footnote":{"url":"\/documentation\/ivormxl\/mxlnote\/footnote","role":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/footnote","abstract":[{"type":"text","text":"The footnote element specifies editorial information that appears in footnotes in the printed score. It is"},{"type":"text","text":" "},{"type":"text","text":"defined within a group due to its multiple uses within the MusicXML schema."}],"title":"footnote","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"footnote","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL16MXLFormattedTextV","text":"MXLFormattedText","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlnote","title":"MXLNote","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNote","kind":"identifier"}],"navigatorTitle":[{"text":"MXLNote","kind":"identifier"}],"abstract":[{"type":"text","text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for"},{"type":"text","text":" "},{"type":"text","text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation)."},{"type":"text","text":" "},{"type":"text","text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,"},{"type":"text","text":" "},{"text":"but no tie elements. Having these two types of information available can make interchange easier, as some","type":"text"},{"type":"text","text":" "},{"type":"text","text":"programs handle one type of information more readily than the other."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote"},"doc://IvorMXL/documentation/IvorMXL/MXLFormattedText":{"navigatorTitle":[{"kind":"identifier","text":"MXLFormattedText"}],"url":"\/documentation\/ivormxl\/mxlformattedtext","kind":"symbol","type":"topic","role":"symbol","title":"MXLFormattedText","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFormattedText","abstract":[{"text":"The formatted-text type represents a text element with text-formatting attributes.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFormattedText"}]}}}