ext":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"staff","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLStaff","preciseIdentifier":"s:7IvorMXL8MXLStaffV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"title":"staff","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/staff"},"doc://IvorMXL/documentation/IvorMXL/MXLStaff":{"type":"topic","abstract":[{"type":"text","text":"The staff element is defined within a group due to its use by both notes and direction elements."}],"url":"\/documentation\/ivormxl\/mxlstaff","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLStaff"}],"kind":"symbol","title":"MXLStaff","navigatorTitle":[{"kind":"identifier","text":"MXLStaff"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaff","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNote","kind":"identifier"}],"title":"MXLNote","abstract":[{"text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for","type":"text"},{"text":" ","type":"text"},{"text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation).","type":"text"},{"text":" ","type":"text"},{"text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,","type":"text"},{"text":" ","type":"text"},{"text":"but no tie elements. Having these two types of information available can make interchange easier, as some","type":"text"},{"text":" ","type":"text"},{"text":"programs