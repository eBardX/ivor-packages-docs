symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLTimeOnly":{"role":"symbol","url":"\/documentation\/ivormxl\/mxltimeonly","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTimeOnly","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTimeOnly","kind":"identifier"}],"abstract":[{"text":"The time-only type is used to indicate that a particular playback- or listening-related element only applies","type":"text"},{"text":" ","type":"text"},{"text":"particular times through a repeated section. The value is a list of positive integers arranged in ascending","type":"text"},{"text":" ","type":"text"},{"text":"order, indicating which times through the repeated section that the element applies.","type":"text"}],"kind":"symbol","type":"topic","navigatorTitle":[{"text":"MXLTimeOnly","kind":"identifier"}],"title":"MXLTimeOnly"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/timeOnly":{"title":"timeOnly","kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"timeOnly","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLTimeOnly","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLTimeOnlya"},{"text":"?","kind":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/timeOnly","url":"\/documentation\/ivormxl\/mxlnote\/timeonly","type":"topic","abstract":[{"text":"Indicates which times through a repeat this note is played, if only particular times.","type":"text"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"title":"MXLNote","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNote"}],"abstract":[{"type":"text","text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for"},{"type":"text","text":" "},{"type":"text","text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation)."},{"type":"text","text":" "},{"type":"text","text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,"},{"type":"text","text":" "},{"type":"text","text":"but no tie elements. Having these two types of information available can make interchange easier, as some"},{"type":"text","text":" "},{"type":"text","text":"programs handle one type of information more readily than the other."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLNote"}],"url":"\/documentation\/ivormxl\/mxlnote"}}}