LNote","kind":"identifier"}],"abstract":[{"type":"text","text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for"},{"type":"text","text":" "},{"type":"text","text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation)."},{"type":"text","text":" "},{"type":"text","text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,"},{"type":"text","text":" "},{"text":"but no tie elements. Having these two types of information available can make interchange easier, as some","type":"text"},{"type":"text","text":" "},{"type":"text","text":"programs handle one type of information more readily than the other."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote"},"doc://IvorMXL/documentation/IvorMXL/MXLTimeOnly":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxltimeonly","title":"MXLTimeOnly","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTimeOnly","kind":"identifier"}],"navigatorTitle":[{"text":"MXLTimeOnly","kind":"identifier"}],"abstract":[{"type":"text","text":"The time-only type is used to indicate that a particular playback- or listening-related element only applies"},{"type":"text","text":" "},{"type":"text","text":"particular times through a repeated section. The value is a list of positive integers arranged in ascending"},{"type":"text","text":" "},{"type":"text","text":"order, indicating which times through the repeated section that the element applies."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTimeOnly"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/timeOnly":{"url":"\/documentation\/ivormxl\/mxlnote\/timeonly","role":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/timeOnly","abstract":[{"type":"text","text":"Indicates which times through a repeat this note is played, if only particular times."}],"title":"timeOnly","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"timeOnly","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLTimeOnly","preciseIdentifier":"s:7IvorMXL11MXLTimeOnlya","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]}}}