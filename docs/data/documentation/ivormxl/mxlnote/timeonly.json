{"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/timeOnly","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"timeOnly","kind":"identifier"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTimeOnly","preciseIdentifier":"s:7IvorMXL11MXLTimeOnlya","text":"MXLTimeOnly","kind":"typeIdentifier"},{"text":"?","kind":"text"}]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Maps to the MusicXML ","type":"text"},{"code":"time-only","type":"codeVoice"},{"text":" attribute.","type":"text"}]}],"kind":"content"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote"]]},"variants":[{"paths":["\/documentation\/ivormxl\/mxlnote\/timeonly"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"externalID":"s:7IvorMXL7MXLNoteV8timeOnlySaySiGSgvp","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"timeOnly","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLTimeOnly","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLTimeOnlya"},{"text":"?","kind":"text"}],"roleHeading":"Instance Property","title":"timeOnly","role":"symbol","symbolKind":"property","modules":[{"name":"IvorMXL"}]},"kind":"symbol","abstract":[{"text":"Indicates which times through a repeat this note is played, if only particular times.","type":"text"}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNote"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLNote"}],"url":"\/documentation\/ivormxl\/mxlnote","role":"symbol","title":"MXLNote","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","type":"topic","abstract":[{"type":"text","text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for"},{"type":"text","text":" "},{"type":"text","text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation)."},{"type":"text","text":" "},{"type":"text","text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,"},{"type":"text","text":" "},{"type":"text","text":"but no tie elements. Having these two types of information available can make interchange easier, as some"},{"type":"text","text":" "},{"type":"text","text":"programs handle one type of information more readily than the other."}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/timeOnly":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"timeOnly","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL11MXLTimeOnlya","text":"MXLTimeOnly","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlnote\/timeonly","role":"symbol","title":"timeOnly","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/timeOnly","type":"topic","abstract":[{"text":"Indicates which times through a repeat this note is played, if only particular times.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLTimeOnly":{"fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTimeOnly"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTimeOnly","navigatorTitle":[{"kind":"identifier","text":"MXLTimeOnly"}],"type":"topic","title":"MXLTimeOnly","role":"symbol","abstract":[{"type":"text","text":"The time-only type is used to indicate that a particular playback- or listening-related element only applies"},{"type":"text","text":" "},{"type":"text","text":"particular times through a repeated section. The value is a list of positive integers arranged in ascending"},{"type":"text","text":" "},{"type":"text","text":"order, indicating which times through the repeated section that the element applies."}],"url":"\/documentation\/ivormxl\/mxltimeonly","kind":"symbol"}}}