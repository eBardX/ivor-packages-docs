pe":"text","text":"The Note Off velocity, corresponding to MIDI 1.0’s Note Off velocity, expressed as a percentage of the"},{"type":"text","text":" "},{"type":"text","text":"default forte value (90 for MIDI 1.0)."}],"url":"\/documentation\/ivormxl\/mxlnote\/enddynamics","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"endDynamics","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLNonNegativeDecimal","preciseIdentifier":"s:7IvorMXL21MXLNonNegativeDecimala","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"title":"endDynamics","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/endDynamics"},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNote","kind":"identifier"}],"title":"MXLNote","abstract":[{"text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for","type":"text"},{"text":" ","type":"text"},{"text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation).","type":"text"},{"text":" ","type":"text"},{"text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,","type":"text"},{"text":" ","type":"text"},{"text":"but no tie elements. Having these two types of information available can make interchange easier, as some","type":"text"},{"text":" ","type":"text"},{"text":"programs handle one type of information more readily than the other.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","role":"symbol","url":"\/documentation\/ivormxl\/mxlnote","kind":"symbol","navigatorTitle":[{"text":"MXLNote","kind":"identifier"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML