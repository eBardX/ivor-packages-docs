{"sections":[],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote"]]},"abstract":[{"text":"The text displayed inside the notehead, if any.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"noteheadText"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL7MXLNoteV12NoteheadTextV","kind":"typeIdentifier","text":"NoteheadText","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/NoteheadText-swift.struct"},{"kind":"text","text":"?"}]}]},{"content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Maps to a nested MusicXML "},{"code":"<notehead-text>","type":"codeVoice"},{"type":"text","text":" element."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/ivormxl\/mxlnote\/noteheadtext-swift.property"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"noteheadText"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL7MXLNoteV12NoteheadTextV","kind":"typeIdentifier","text":"NoteheadText"},{"kind":"text","text":"?"}],"title":"noteheadText","externalID":"s:7IvorMXL7MXLNoteV12noteheadTextAC08NoteheadE0VSgvp","roleHeading":"Instance Property","modules":[{"name":"IvorMXL"}],"role":"symbol","symbolKind":"property"},"kind":"symbol","identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/noteheadText-swift.property","interfaceLanguage":"swift"},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"navigatorTitle":[{"kind":"identifier","text":"MXLNote"}],"abstract":[{"text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for","type":"text"},{"text":" ","type":"text"},{"text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation).","type":"text"},{"text":" ","type":"text"},{"text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,","type":"text"},{"text":" ","type":"text"},{"text":"but no tie elements. Having these two types of information available can make interchange easier, as some","type":"text"},{"text":" ","type":"text"},{"text":"programs handle one type of information more readily than the other.","type":"text"}],"title":"MXLNote","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","kind":"symbol","url":"\/documentation\/ivormxl\/mxlnote","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNote"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/noteheadText-swift.property":{"url":"\/documentation\/ivormxl\/mxlnote\/noteheadtext-swift.property","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/noteheadText-swift.property","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"noteheadText"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL7MXLNoteV12NoteheadTextV","text":"NoteheadText"},{"kind":"text","text":"?"}],"title":"noteheadText","abstract":[{"type":"text","text":"The text displayed inside the notehead, if any."}],"type":"topic","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/NoteheadText-swift.struct":{"abstract":[{"text":"The notehead-text type represents text that is displayed inside a notehead, as is done in some educational","type":"text"},{"text":" ","type":"text"},{"text":"music. It is not needed for the numbers used in tablature or jianpu notation. The presence of a TAB or jianpu","type":"text"},{"text":" ","type":"text"},{"text":"clefs is sufficient to indicate that numbers are used. The display-text and accidental-text elements allow","type":"text"},{"text":" ","type":"text"},{"text":"display of fully formatted text and accidentals.","type":"text"}],"title":"MXLNote.NoteheadText","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"NoteheadText"}],"navigatorTitle":[{"kind":"identifier","text":"NoteheadText"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlnote\/noteheadtext-swift.struct","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/NoteheadText-swift.struct"}}}