{"abstract":[{"type":"text","text":"The lyrics associated with this note."}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lyric","kind":"identifier"},{"text":": [","kind":"text"},{"text":"MXLLyric","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLLyricV"},{"text":"]","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"inlineContent":[{"text":"Maps to nested MusicXML ","type":"text"},{"code":"<lyric>","type":"codeVoice"},{"text":" elements.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/ivormxl\/mxlnote\/lyric"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"roleHeading":"Instance Property","modules":[{"name":"IvorMXL"}],"symbolKind":"property","role":"symbol","title":"lyric","externalID":"s:7IvorMXL7MXLNoteV5lyricSayAA8MXLLyricVGvp","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lyric","kind":"identifier"},{"text":": [","kind":"text"},{"text":"MXLLyric","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLLyricV"},{"text":"]","kind":"text"}]},"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote"]]},"kind":"symbol","identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/lyric","interfaceLanguage":"swift"},"sections":[],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLNote/lyric":{"kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"The lyrics associated with this note."}],"url":"\/documentation\/ivormxl\/mxlnote\/lyric","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lyric","kind":"identifier"},{"text":": [","kind":"text"},{"text":"MXLLyric","preciseIdentifier":"s:7IvorMXL8MXLLyricV","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"title":"lyric","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/lyric"},"doc://IvorMXL/documentation/IvorMXL/MXLLyric":{"type":"topic","abstract":[{"type":"text","text":"The lyric type represents text underlays for lyrics. Two text elements that are not separated by an elision"},{"type":"text","text":" "},{"type":"text","text":"element are part of the same syllable, but may have different text formatting. The MusicXML XSD is more strict"},{"type":"text","text":" "},{"type":"text","text":"than the DTD in enforcing this by disallowing a second syllabic element unless preceded by an elision element."},{"type":"text","text":" "},{"type":"text","text":"The lyric number indicates multiple lines, though a name can be used as well. Common name examples are verse"},{"type":"text","text":" "},{"text":"and chorus.","type":"text"}],"url":"\/documentation\/ivormxl\/mxllyric","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLLyric"}],"kind":"symbol","title":"MXLLyric","navigatorTitle":[{"text":"MXLLyric","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNote","kind":"identifier"}],"title":"MXLNote","abstract":[{"text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for","type":"text"},{"text":" ","type":"text"},{"text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation).","type":"text"},{"text":" ","type":"text"},{"text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,","type":"text"},{"text":" ","type":"text"},{"text":"but no tie elements. Having these two types of information available can make interchange easier, as some","type":"text"},{"text":" ","type":"text"},{"text":"programs handle one type of information more readily than the other.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","role":"symbol","url":"\/documentation\/ivormxl\/mxlnote","kind":"symbol","navigatorTitle":[{"text":"MXLNote","kind":"identifier"}],"type":"topic"}}}