{"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"lyric"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric","preciseIdentifier":"s:7IvorMXL8MXLLyricV","text":"MXLLyric"},{"kind":"text","text":"]"}]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"inlineContent":[{"type":"text","text":"Maps to nested MusicXML "},{"type":"codeVoice","code":"<lyric>"},{"type":"text","text":" elements."}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"type":"text","text":"The lyrics associated with this note."}],"variants":[{"paths":["\/documentation\/ivormxl\/mxlnote\/lyric"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote"]]},"kind":"symbol","metadata":{"modules":[{"name":"IvorMXL"}],"externalID":"s:7IvorMXL7MXLNoteV5lyricSayAA8MXLLyricVGvp","role":"symbol","symbolKind":"property","title":"lyric","roleHeading":"Instance Property","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"lyric"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLLyricV","text":"MXLLyric"},{"kind":"text","text":"]"}]},"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/lyric","interfaceLanguage":"swift"},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNote"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLNote"}],"url":"\/documentation\/ivormxl\/mxlnote","role":"symbol","title":"MXLNote","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","type":"topic","abstract":[{"type":"text","text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for"},{"type":"text","text":" "},{"type":"text","text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation)."},{"type":"text","text":" "},{"type":"text","text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,"},{"type":"text","text":" "},{"type":"text","text":"but no tie elements. Having these two types of information available can make interchange easier, as some"},{"type":"text","text":" "},{"type":"text","text":"programs handle one type of information more readily than the other."}]},"doc://IvorMXL/documentation/IvorMXL/MXLLyric":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLLyric"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLLyric"}],"url":"\/documentation\/ivormxl\/mxllyric","role":"symbol","title":"MXLLyric","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric","type":"topic","abstract":[{"type":"text","text":"The lyric type represents text underlays for lyrics. Two text elements that are not separated by an elision"},{"type":"text","text":" "},{"type":"text","text":"element are part of the same syllable, but may have different text formatting. The MusicXML XSD is more strict"},{"type":"text","text":" "},{"type":"text","text":"than the DTD in enforcing this by disallowing a second syllabic element unless preceded by an elision element."},{"type":"text","text":" "},{"type":"text","text":"The lyric number indicates multiple lines, though a name can be used as well. Common name examples are verse"},{"text":" ","type":"text"},{"type":"text","text":"and chorus."}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote/lyric":{"role":"symbol","abstract":[{"type":"text","text":"The lyrics associated with this note."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/lyric","url":"\/documentation\/ivormxl\/mxlnote\/lyric","title":"lyric","kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"lyric"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"MXLLyric","preciseIdentifier":"s:7IvorMXL8MXLLyricV"},{"kind":"text","text":"]"}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"}}}