{"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote"]]},"sections":[],"metadata":{"role":"symbol","symbolKind":"property","externalID":"s:7IvorMXL7MXLNoteV5lyricSayAA8MXLLyricVGvp","modules":[{"name":"IvorMXL"}],"roleHeading":"Instance Property","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lyric","kind":"identifier"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:7IvorMXL8MXLLyricV","text":"MXLLyric","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"title":"lyric"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/lyric"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lyric","kind":"identifier"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:7IvorMXL8MXLLyricV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric","text":"MXLLyric","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Maps to nested MusicXML "},{"type":"codeVoice","code":"<lyric>"},{"type":"text","text":" elements."}]}]}],"kind":"symbol","abstract":[{"type":"text","text":"The lyrics associated with this note."}],"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlnote\/lyric"]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLLyric":{"role":"symbol","url":"\/documentation\/ivormxl\/mxllyric","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLLyric"}],"kind":"symbol","abstract":[{"type":"text","text":"The lyric type represents text underlays for lyrics. Two text elements that are not separated by an elision"},{"type":"text","text":" "},{"type":"text","text":"element are part of the same syllable, but may have different text formatting. The MusicXML XSD is more strict"},{"type":"text","text":" "},{"type":"text","text":"than the DTD in enforcing this by disallowing a second syllabic element unless preceded by an elision element."},{"type":"text","text":" "},{"type":"text","text":"The lyric number indicates multiple lines, though a name can be used as well. Common name examples are verse"},{"type":"text","text":" "},{"type":"text","text":"and chorus."}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLLyric"}],"title":"MXLLyric"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"title":"MXLNote","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNote"}],"abstract":[{"type":"text","text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for"},{"type":"text","text":" "},{"type":"text","text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation)."},{"type":"text","text":" "},{"type":"text","text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,"},{"type":"text","text":" "},{"type":"text","text":"but no tie elements. Having these two types of information available can make interchange easier, as some"},{"type":"text","text":" "},{"type":"text","text":"programs handle one type of information more readily than the other."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLNote"}],"url":"\/documentation\/ivormxl\/mxlnote"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/lyric":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlnote\/lyric","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/lyric","fragments":[{"kind":"keyword","text":"let"},{"text":" ","kind":"text"},{"text":"lyric","kind":"identifier"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:7IvorMXL8MXLLyricV","text":"MXLLyric","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"abstract":[{"type":"text","text":"The lyrics associated with this note."}],"kind":"symbol","type":"topic","title":"lyric"}}}