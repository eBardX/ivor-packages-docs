{"sections":[],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote"]]},"abstract":[{"type":"text","text":"The lyrics associated with this note."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"lyric"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric","preciseIdentifier":"s:7IvorMXL8MXLLyricV","text":"MXLLyric"},{"kind":"text","text":"]"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"inlineContent":[{"text":"Maps to nested MusicXML ","type":"text"},{"type":"codeVoice","code":"<lyric>"},{"type":"text","text":" elements."}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/ivormxl\/mxlnote\/lyric"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"lyric"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"MXLLyric","preciseIdentifier":"s:7IvorMXL8MXLLyricV"},{"kind":"text","text":"]"}],"title":"lyric","externalID":"s:7IvorMXL7MXLNoteV5lyricSayAA8MXLLyricVGvp","modules":[{"name":"IvorMXL"}],"roleHeading":"Instance Property","role":"symbol","symbolKind":"property"},"kind":"symbol","identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/lyric","interfaceLanguage":"swift"},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLLyric":{"navigatorTitle":[{"kind":"identifier","text":"MXLLyric"}],"abstract":[{"text":"The lyric type represents text underlays for lyrics. Two text elements that are not separated by an elision","type":"text"},{"text":" ","type":"text"},{"text":"element are part of the same syllable, but may have different text formatting. The MusicXML XSD is more strict","type":"text"},{"text":" ","type":"text"},{"text":"than the DTD in enforcing this by disallowing a second syllabic element unless preceded by an elision element.","type":"text"},{"text":" ","type":"text"},{"text":"The lyric number indicates multiple lines, though a name can be used as well. Common name examples are verse","type":"text"},{"text":" ","type":"text"},{"text":"and chorus.","type":"text"}],"title":"MXLLyric","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric","kind":"symbol","url":"\/documentation\/ivormxl\/mxllyric","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLLyric"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/lyric":{"url":"\/documentation\/ivormxl\/mxlnote\/lyric","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/lyric","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lyric","kind":"identifier"},{"text":": [","kind":"text"},{"text":"MXLLyric","preciseIdentifier":"s:7IvorMXL8MXLLyricV","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"kind":"symbol","abstract":[{"text":"The lyrics associated with this note.","type":"text"}],"type":"topic","title":"lyric"},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"navigatorTitle":[{"kind":"identifier","text":"MXLNote"}],"abstract":[{"text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for","type":"text"},{"text":" ","type":"text"},{"text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation).","type":"text"},{"text":" ","type":"text"},{"text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,","type":"text"},{"text":" ","type":"text"},{"text":"but no tie elements. Having these two types of information available can make interchange easier, as some","type":"text"},{"text":" ","type":"text"},{"text":"programs handle one type of information more readily than the other.","type":"text"}],"title":"MXLNote","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","kind":"symbol","url":"\/documentation\/ivormxl\/mxlnote","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNote"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"}}}