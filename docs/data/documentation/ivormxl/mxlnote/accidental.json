{"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"accidental"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL13MXLAccidentalV","kind":"typeIdentifier","text":"MXLAccidental","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidental"},{"kind":"text","text":"?"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Maps to a nested MusicXML "},{"type":"codeVoice","code":"<accidental>"},{"type":"text","text":" element."}],"type":"paragraph"}]}],"sections":[],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlnote\/accidental"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/accidental"},"abstract":[{"text":"The accidental to be displayed for this note, if any.","type":"text"}],"metadata":{"modules":[{"name":"IvorMXL"}],"role":"symbol","externalID":"s:7IvorMXL7MXLNoteV10accidentalAA13MXLAccidentalVSgvp","title":"accidental","roleHeading":"Instance Property","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"accidental"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLAccidental","preciseIdentifier":"s:7IvorMXL13MXLAccidentalV"},{"kind":"text","text":"?"}],"symbolKind":"property"},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLNote/accidental":{"kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"The accidental to be displayed for this note, if any."}],"url":"\/documentation\/ivormxl\/mxlnote\/accidental","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"accidental","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLAccidental","preciseIdentifier":"s:7IvorMXL13MXLAccidentalV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"title":"accidental","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/accidental"},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNote","kind":"identifier"}],"title":"MXLNote","abstract":[{"text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for","type":"text"},{"text":" ","type":"text"},{"text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation).","type":"text"},{"text":" ","type":"text"},{"text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,","type":"text"},{"text":" ","type":"text"},{"text":"but no tie elements. Having these two types of information available can make interchange easier, as some","type":"text"},{"text":" ","type":"text"},{"text":"programs handle one type of information more readily than the other.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","role":"symbol","url":"\/documentation\/ivormxl\/mxlnote","kind":"symbol","navigatorTitle":[{"text":"MXLNote","kind":"identifier"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLAccidental":{"type":"topic","abstract":[{"text":"The accidental type represents actual notated accidentals. Editorial and cautionary indications are indicated","type":"text"},{"text":" ","type":"text"},{"text":"by attributes. Values for these attributes are “no” if not present. Specific graphic display such as","type":"text"},{"text":" ","type":"text"},{"text":"parentheses, brackets, and size are controlled by the level-display attribute group.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlaccidental","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLAccidental"}],"kind":"symbol","title":"MXLAccidental","navigatorTitle":[{"kind":"identifier","text":"MXLAccidental"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidental","role":"symbol"}}}