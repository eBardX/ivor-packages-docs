text":"MXLNote","kind":"identifier"}],"abstract":[{"type":"text","text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for"},{"type":"text","text":" "},{"type":"text","text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation)."},{"type":"text","text":" "},{"type":"text","text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,"},{"type":"text","text":" "},{"text":"but no tie elements. Having these two types of information available can make interchange easier, as some","type":"text"},{"type":"text","text":" "},{"type":"text","text":"programs handle one type of information more readily than the other."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote"},"doc://IvorMXL/documentation/IvorMXL/MXLAccidental":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlaccidental","title":"MXLAccidental","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLAccidental"}],"navigatorTitle":[{"kind":"identifier","text":"MXLAccidental"}],"abstract":[{"text":"The accidental type represents actual notated accidentals. Editorial and cautionary indications are indicated","type":"text"},{"text":" ","type":"text"},{"text":"by attributes. Values for these attributes are “no” if not present. Specific graphic display such as","type":"text"},{"text":" ","type":"text"},{"text":"parentheses, brackets, and size are controlled by the level-display attribute group.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidental"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote/accidental":{"url":"\/documentation\/ivormxl\/mxlnote\/accidental","role":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/accidental","abstract":[{"type":"text","text":"The accidental to be displayed for this note, if any."}],"title":"accidental","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"accidental","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL13MXLAccidentalV","text":"MXLAccidental","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"kind":"symbol"}}}