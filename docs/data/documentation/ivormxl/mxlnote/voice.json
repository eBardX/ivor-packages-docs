{"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"voice","kind":"identifier"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLVoice","text":"MXLVoice","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLVoiceV"},{"text":"?","kind":"text"}],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"inlineContent":[{"type":"text","text":"Maps to a nested MusicXML "},{"type":"codeVoice","code":"<voice>"},{"type":"text","text":" element."}],"type":"paragraph"}]}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/voice","interfaceLanguage":"swift"},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlnote\/voice"]}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote"]]},"sections":[],"abstract":[{"type":"text","text":"A voice is a sequence of musical events (e.g. notes, chords, rests) that proceeds linearly in time. The voice"},{"type":"text","text":" "},{"type":"text","text":"element is used to distinguish between multiple voices in individual parts. It is defined within a group due"},{"type":"text","text":" "},{"type":"text","text":"to its multiple uses within the MusicXML schema."}],"metadata":{"symbolKind":"property","externalID":"s:7IvorMXL7MXLNoteV5voiceAA8MXLVoiceVSgvp","modules":[{"name":"IvorMXL"}],"roleHeading":"Instance Property","role":"symbol","title":"voice","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"voice","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLVoice","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLVoiceV"},{"text":"?","kind":"text"}]},"references":{"doc://IvorMXL/documentat