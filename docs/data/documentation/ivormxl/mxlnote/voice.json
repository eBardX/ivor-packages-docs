{"abstract":[{"type":"text","text":"A voice is a sequence of musical events (e.g. notes, chords, rests) that proceeds linearly in time. The voice"},{"type":"text","text":" "},{"type":"text","text":"element is used to distinguish between multiple voices in individual parts. It is defined within a group due"},{"type":"text","text":" "},{"type":"text","text":"to its multiple uses within the MusicXML schema."}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote"]]},"sections":[],"variants":[{"paths":["\/documentation\/ivormxl\/mxlnote\/voice"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"voice","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLVoice","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLVoice","preciseIdentifier":"s:7IvorMXL8MXLVoiceV"},{"text":"?","kind":"text"}],"languages":["swift"]}]},{"content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Maps to a nested MusicXML "},{"code":"<voice>","type":"codeVoice"},{"type":"text","text":" element."}]}],"kind":"content"}],"metadata":{"externalID":"s:7IvorMXL7MXLNoteV5voiceAA8MXLVoiceVSgvp","role":"symbol","symbolKind":"property","roleHeading":"Instance Property","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"voice","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL8MXLVoiceV","text":"MXLVoice","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"modules":[{"name":"IvorMXL"}],"title":"voice"},"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/voice"},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLNote/voice":{"title":"voice","kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"voice","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLVoice","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLVoiceV"},{"text":"?","kind":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/voice","url":"\/documentation\/ivormxl\/mxlnote\/voice","type":"topic","abstract":[{"type":"text","text":"A voice is a sequence of musical events (e.g. notes, chords, rests) that proceeds linearly in time. The voice"},{"type":"text","text":" "},{"type":"text","text":"element is used to distinguish between multiple voices in individual parts. It is defined within a group due"},{"type":"text","text":" "},{"type":"text","text":"to its multiple uses within the MusicXML schema."}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"title":"MXLNote","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNote"}],"abstract":[{"type":"text","text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for"},{"type":"text","text":" "},{"type":"text","text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation)."},{"type":"text","text":" "},{"type":"text","text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,"},{"type":"text","text":" "},{"type":"text","text":"but no tie elements. Having these two types of information available can make interchange easier, as some"},{"type":"text","text":" "},{"type":"text","text":"programs handle one type of information more readily than the other."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLNote"}],"url":"\/documentation\/ivormxl\/mxlnote"},"doc://IvorMXL/documentation/IvorMXL/MXLVoice":{"navigatorTitle":[{"text":"MXLVoice","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlvoice","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLVoice","title":"MXLVoice","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLVoice","kind":"identifier"}],"abstract":[{"type":"text","text":"A voice is a sequence of musical events (e.g. notes, chords, rests) that proceeds linearly in time. The voice"},{"type":"text","text":" "},{"type":"text","text":"element is used to distinguish between multiple voices in individual parts. It is defined within a group due"},{"type":"text","text":" "},{"type":"text","text":"to its multiple uses within the MusicXML schema."}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"}}}