{"sections":[],"abstract":[{"text":"Listening information associated with this note, if any.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote"]]},"variants":[{"paths":["\/documentation\/ivormxl\/mxlnote\/listen"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"modules":[{"name":"IvorMXL"}],"externalID":"s:7IvorMXL7MXLNoteV6listenAA9MXLListenVSgvp","role":"symbol","roleHeading":"Instance Property","symbolKind":"property","title":"listen","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"listen","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLListen","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLListenV"},{"text":"?","kind":"text"}]},"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/listen","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"listen","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLListen","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLListen","preciseIdentifier":"s:7IvorMXL9MXLListenV"},{"text":"?","kind":"text"}],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"inlineContent":[{"text":"Maps to a nested MusicXML ","type":"text"},{"type":"codeVoice","code":"<listen>"},{"text":" element.","type":"text"}],"type":"paragraph"}]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNote"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLNote"}],"url":"\/documentation\/ivormxl\/mxlnote","role":"symbol","title":"MXLNote","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","type":"topic","abstract":[{"type":"text","text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for"},{"type":"text","text":" "},{"type":"text","text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation)."},{"type":"text","text":" "},{"type":"text","text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,"},{"type":"text","text":" "},{"type":"text","text":"but no tie elements. Having these two types of information available can make interchange easier, as some"},{"type":"text","text":" "},{"type":"text","text":"programs handle one type of information more readily than the other."}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLListen":{"title":"MXLListen","navigatorTitle":[{"text":"MXLListen","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"The listen and listening types, new in Version 4.0, specify different ways that a score following or machine"},{"type":"text","text":" "},{"type":"text","text":"listening application can interact with a performer. The listen type handles interactions that are specific to"},{"type":"text","text":" "},{"type":"text","text":"a note. If multiple child elements of the same type are present, they should have distinct player and\/or time-"},{"type":"text","text":" "},{"type":"text","text":"only attributes."}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLListen","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLListen","url":"\/documentation\/ivormxl\/mxllisten"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/listen":{"role":"symbol","abstract":[{"text":"Listening information associated with this note, if any.","type":"text"}],"title":"listen","url":"\/documentation\/ivormxl\/mxlnote\/listen","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/listen","kind":"symbol","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"listen","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLListen","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLListenV"},{"text":"?","kind":"text"}]}}}