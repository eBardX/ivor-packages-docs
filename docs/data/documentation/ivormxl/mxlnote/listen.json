{"abstract":[{"type":"text","text":"Listening information associated with this note, if any."}],"metadata":{"modules":[{"name":"IvorMXL"}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"listen"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLListen","preciseIdentifier":"s:7IvorMXL9MXLListenV"},{"kind":"text","text":"?"}],"roleHeading":"Instance Property","symbolKind":"property","role":"symbol","externalID":"s:7IvorMXL7MXLNoteV6listenAA9MXLListenVSgvp","title":"listen"},"variants":[{"paths":["\/documentation\/ivormxl\/mxlnote\/listen"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"listen"},{"kind":"text","text":": "},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLListen","kind":"typeIdentifier","text":"MXLListen","preciseIdentifier":"s:7IvorMXL9MXLListenV"},{"kind":"text","text":"?"}],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"Maps to a nested MusicXML "},{"code":"<listen>","type":"codeVoice"},{"type":"text","text":" element."}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote"]]},"kind":"symbol","identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/listen","interfaceLanguage":"swift"},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLNote/listen":{"title":"listen","kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"listen","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLListen","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLListenV"},{"text":"?","kind":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/listen","url":"\/documentation\/ivormxl\/mxlnote\/listen","type":"topic","abstract":[{"type":"text","text":"Listening information associated with this note, if any."}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"title":"MXLNote","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNote"}],"abstract":[{"type":"text","text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for"},{"type":"text","text":" "},{"type":"text","text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation)."},{"type":"text","text":" "},{"type":"text","text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,"},{"type":"text","text":" "},{"type":"text","text":"but no tie elements. Having these two types of information available can make interchange easier, as some"},{"type":"text","text":" "},{"type":"text","text":"programs handle one type of information more readily than the other."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLNote"}],"url":"\/documentation\/ivormxl\/mxlnote"},"doc://IvorMXL/documentation/IvorMXL/MXLListen":{"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLListen","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLListen"}],"url":"\/documentation\/ivormxl\/mxllisten","type":"topic","title":"MXLListen","navigatorTitle":[{"kind":"identifier","text":"MXLListen"}],"abstract":[{"text":"The listen and listening types, new in Version 4.0, specify different ways that a score following or machine","type":"text"},{"text":" ","type":"text"},{"text":"listening application can interact with a performer. The listen type handles interactions that are specific to","type":"text"},{"text":" ","type":"text"},{"text":"a note. If multiple child elements of the same type are present, they should have distinct player and\/or time-","type":"text"},{"text":" ","type":"text"},{"text":"only attributes.","type":"text"}]}}}