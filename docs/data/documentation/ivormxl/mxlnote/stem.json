{"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"abstract":[{"text":"The direction of the stem for this note, if any.","type":"text"}],"metadata":{"roleHeading":"Instance Property","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"stem"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL7MXLStemV","text":"MXLStem"},{"kind":"text","text":"?"}],"externalID":"s:7IvorMXL7MXLNoteV4stemAA7MXLStemVSgvp","symbolKind":"property","role":"symbol","modules":[{"name":"IvorMXL"}],"title":"stem"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote"]]},"variants":[{"paths":["\/documentation\/ivormxl\/mxlnote\/stem"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/stem","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"stem"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStem","preciseIdentifier":"s:7IvorMXL7MXLStemV","text":"MXLStem"},{"kind":"text","text":"?"}]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Maps to a nested MusicXML "},{"type":"codeVoice","code":"<stem>"},{"type":"text","text":" element."}],"type":"paragraph"}]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLNote/stem":{"kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"The direction of the stem for this note, if any."}],"url":"\/documentation\/ivormxl\/mxlnote\/stem","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"stem","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLStem","preciseIdentifier":"s:7IvorMXL7MXLStemV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"title":"stem","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/stem"},"doc://IvorMXL/documentation/IvorMXL/MXLStem":{"type":"topic","title":"MXLStem","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStem","abstract":[{"text":"Stems can be down, up, none, or double. For down and up stems, the position attributes can be used to specify","type":"text"},{"text":" ","type":"text"},{"text":"stem length. The relative values specify the end of the stem relative to the program default. Default values","type":"text"},{"text":" ","type":"text"},{"text":"specify an absolute end stem position. Negative values of relative-y that would flip a stem instead of","type":"text"},{"text":" ","type":"text"},{"text":"shortening it are ignored. A stem element associated with a rest refers to a stemlet.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLStem"}],"navigatorTitle":[{"kind":"identifier","text":"MXLStem"}],"url":"\/documentation\/ivormxl\/mxlstem"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNote","kind":"identifier"}],"title":"MXLNote","abstract":[{"text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for","type":"text"},{"text":" ","type":"text"},{"text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation).","type":"text"},{"text":" ","type":"text"},{"text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,","type":"text"},{"text":" ","type":"text"},{"text":"but no tie elements. Having these two types of information available can make interchange easier, as some","type":"text"},{"text":" ","type":"text"},{"text":"programs handle one type of information more readily than the other.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","role":"symbol","url":"\/documentation\/ivormxl\/mxlnote","kind":"symbol","navigatorTitle":[{"text":"MXLNote","kind":"identifier"}],"type":"topic"}}}