{"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","abstract":[{"type":"text","text":"The direction of the stem for this note, if any."}],"variants":[{"paths":["\/documentation\/ivormxl\/mxlnote\/stem"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/stem"},"metadata":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"stem","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL7MXLStemV","text":"MXLStem","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"externalID":"s:7IvorMXL7MXLNoteV4stemAA7MXLStemVSgvp","title":"stem","roleHeading":"Instance Property","symbolKind":"property","role":"symbol","modules":[{"name":"IvorMXL"}]},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote"]]},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"stem"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL7MXLStemV","text":"MXLStem","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStem"},{"kind":"text","text":"?"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Maps to a nested MusicXML "},{"type":"codeVoice","code":"<stem>"},{"type":"text","text":" element."}]}]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLStem":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLStem"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLStem"}],"url":"\/documentation\/ivormxl\/mxlstem","role":"symbol","title":"MXLStem","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStem","type":"topic","abstract":[{"text":"Stems can be down, up, none, or double. For down and up stems, the position attributes can be used to specify","type":"text"},{"text":" ","type":"text"},{"text":"stem length. The relative values specify the end of the stem relative to the program default. Default values","type":"text"},{"text":" ","type":"text"},{"text":"specify an absolute end stem position. Negative values of relative-y that would flip a stem instead of","type":"text"},{"text":" ","type":"text"},{"text":"shortening it are ignored. A stem element associated with a rest refers to a stemlet.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNote"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLNote"}],"url":"\/documentation\/ivormxl\/mxlnote","role":"symbol","title":"MXLNote","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","type":"topic","abstract":[{"type":"text","text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for"},{"type":"text","text":" "},{"type":"text","text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation)."},{"type":"text","text":" "},{"type":"text","text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,"},{"type":"text","text":" "},{"type":"text","text":"but no tie elements. Having these two types of information available can make interchange easier, as some"},{"type":"text","text":" "},{"type":"text","text":"programs handle one type of information more readily than the other."}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote/stem":{"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"stem"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLStem","preciseIdentifier":"s:7IvorMXL7MXLStemV"},{"kind":"text","text":"?"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlnote\/stem","role":"symbol","title":"stem","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/stem","type":"topic","abstract":[{"type":"text","text":"The direction of the stem for this note, if any."}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"}}}