{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"stem"},{"kind":"text","text":": "},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStem","kind":"typeIdentifier","text":"MXLStem","preciseIdentifier":"s:7IvorMXL7MXLStemV"},{"kind":"text","text":"?"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"inlineContent":[{"text":"Maps to a nested MusicXML ","type":"text"},{"type":"codeVoice","code":"<stem>"},{"text":" element.","type":"text"}],"type":"paragraph"}]}],"kind":"symbol","identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/stem","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote"]]},"metadata":{"roleHeading":"Instance Property","symbolKind":"property","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"stem"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLStem","preciseIdentifier":"s:7IvorMXL7MXLStemV"},{"kind":"text","text":"?"}],"title":"stem","externalID":"s:7IvorMXL7MXLNoteV4stemAA7MXLStemVSgvp","modules":[{"name":"IvorMXL"}],"role":"symbol"},"variants":[{"paths":["\/documentation\/ivormxl\/mxlnote\/stem"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"The direction of the stem for this note, if any.","type":"text"}],"sections":[],"references":{"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLStem":{"title":"MXLStem","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLStem","kind":"identifier"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlstem","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStem","abstract":[{"type":"text","text":"Stems can be down, up, none, or double. For down and up stems, the position attributes can be used to specify"},{"type":"text","text":" "},{"type":"text","text":"stem length. The relative values specify the end of the stem relative to the program default. Default values"},{"type":"text","text":" "},{"type":"text","text":"specify an absolute end stem position. Negative values of relative-y that would flip a stem instead of"},{"type":"text","text":" "},{"type":"text","text":"shortening it are ignored. A stem element associated with a rest refers to a stemlet."}],"navigatorTitle":[{"text":"MXLStem","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"navigatorTitle":[{"kind":"identifier","text":"MXLNote"}],"abstract":[{"text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for","type":"text"},{"text":" ","type":"text"},{"text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation).","type":"text"},{"text":" ","type":"text"},{"text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,","type":"text"},{"text":" ","type":"text"},{"text":"but no tie elements. Having these two types of information available can make interchange easier, as some","type":"text"},{"text":" ","type":"text"},{"text":"programs handle one type of information more readily than the other.","type":"text"}],"title":"MXLNote","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","kind":"symbol","url":"\/documentation\/ivormxl\/mxlnote","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNote"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/stem":{"url":"\/documentation\/ivormxl\/mxlnote\/stem","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/stem","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"stem","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLStem","preciseIdentifier":"s:7IvorMXL7MXLStemV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"kind":"symbol","abstract":[{"text":"The direction of the stem for this note, if any.","type":"text"}],"type":"topic","title":"stem"}}}