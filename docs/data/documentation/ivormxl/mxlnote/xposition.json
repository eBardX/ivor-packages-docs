{"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"xPosition"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL12MXLXPositionV","kind":"typeIdentifier","text":"MXLXPosition","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLXPosition"}],"languages":["swift"],"platforms":["macOS"]}]}],"kind":"symbol","metadata":{"role":"symbol","externalID":"s:7IvorMXL7MXLNoteV9xPositionAA12MXLXPositionVvp","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"xPosition","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL12MXLXPositionV","text":"MXLXPosition","kind":"typeIdentifier"}],"modules":[{"name":"IvorMXL"}],"title":"xPosition","roleHeading":"Instance Property","symbolKind":"property"},"sections":[],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/xPosition","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"type":"text","text":"The x-position attribute group is used for elements like notes where specifying x position is common, but"},{"type":"text","text":" "},{"type":"text","text":"specifying y position is rare."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlnote\/xposition"]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLXPosition":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLXPosition","role":"symbol","navigatorTitle":[{"text":"MXLXPosition","kind":"identifier"}],"type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLXPosition","kind":"identifier"}],"abstract":[{"type":"text","text":"The x-position attribute group is used for elements like notes where specifying x position is common, but"},{"type":"text","text":" "},{"type":"text","text":"specifying y position is rare."}],"url":"\/documentation\/ivormxl\/mxlxposition","title":"MXLXPosition"},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlnote","title":"MXLNote","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNote","kind":"identifier"}],"navigatorTitle":[{"text":"MXLNote","kind":"identifier"}],"abstract":[{"type":"text","text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for"},{"type":"text","text":" "},{"type":"text","text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation)."},{"type":"text","text":" "},{"type":"text","text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,"},{"type":"text","text":" "},{"text":"but no tie elements. Having these two types of information available can make interchange easier, as some","type":"text"},{"type":"text","text":" "},{"type":"text","text":"programs handle one type of information more readily than the other."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote/xPosition":{"url":"\/documentation\/ivormxl\/mxlnote\/xposition","role":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/xPosition","abstract":[{"type":"text","text":"The x-position attribute group is used for elements like notes where specifying x position is common, but"},{"type":"text","text":" "},{"type":"text","text":"specifying y position is rare."}],"title":"xPosition","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"xPosition","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL12MXLXPositionV","text":"MXLXPosition","kind":"typeIdentifier"}],"kind":"symbol"}}}