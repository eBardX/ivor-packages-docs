{"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"title":"instrument","role":"symbol","modules":[{"name":"IvorMXL"}],"roleHeading":"Instance Property","symbolKind":"property","externalID":"s:7IvorMXL7MXLNoteV10instrumentSayAA13MXLInstrumentVGvp","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"instrument"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:7IvorMXL13MXLInstrumentV","kind":"typeIdentifier","text":"MXLInstrument"},{"kind":"text","text":"]"}]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/instrument"},"kind":"symbol","variants":[{"paths":["\/documentation\/ivormxl\/mxlnote\/instrument"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote"]]},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"instrument"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:7IvorMXL13MXLInstrumentV","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLInstrument","text":"MXLInstrument"},{"kind":"text","text":"]"}]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Maps to nested MusicXML "},{"code":"<instrument>","type":"codeVoice"},{"type":"text","text":" elements."}]}],"kind":"content"}],"abstract":[{"type":"text","text":"The instruments used to play this note, for parts with multiple instruments."}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLNote/instrument":{"url":"\/documentation\/ivormxl\/mxlnote\/instrument","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"instrument"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:7IvorMXL13MXLInstrumentV","text":"MXLInstrument","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"title":"instrument","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/instrument","role":"symbol","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The instruments used to play this note, for parts with multiple instruments."}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNote"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLNote"}],"url":"\/documentation\/ivormxl\/mxlnote","role":"symbol","title":"MXLNote","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","type":"topic","abstract":[{"type":"text","text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for"},{"type":"text","text":" "},{"type":"text","text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation)."},{"type":"text","text":" "},{"type":"text","text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,"},{"type":"text","text":" "},{"type":"text","text":"but no tie elements. Having these two types of information available can make interchange easier, as some"},{"type":"text","text":" "},{"type":"text","text":"programs handle one type of information more readily than the other."}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLInstrument":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLInstrument","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlinstrument","title":"MXLInstrument","navigatorTitle":[{"text":"MXLInstrument","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLInstrument","type":"topic","abstract":[{"text":"The instrument type distinguishes between score-instrument elements in a score-part. The id attribute is an","type":"text"},{"text":" ","type":"text"},{"text":"IDREF back to the score-instrument ID. If multiple score-instruments are specified in a score-part, there","type":"text"},{"text":" ","type":"text"},{"text":"should be an instrument element for each note in the part. Notes that are shared between multiple score-","type":"text"},{"text":" ","type":"text"},{"text":"instruments can have more than one instrument element.","type":"text"}],"role":"symbol"}}}