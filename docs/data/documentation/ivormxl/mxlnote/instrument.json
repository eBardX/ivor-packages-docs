{"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/instrument","interfaceLanguage":"swift"},"metadata":{"roleHeading":"Instance Property","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"instrument","kind":"identifier"},{"text":": [","kind":"text"},{"text":"MXLInstrument","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL13MXLInstrumentV"},{"text":"]","kind":"text"}],"title":"instrument","symbolKind":"property","externalID":"s:7IvorMXL7MXLNoteV10instrumentSayAA13MXLInstrumentVGvp","modules":[{"name":"IvorMXL"}]},"sections":[],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote"]]},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"instrument","kind":"identifier"},{"text":": [","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLInstrument","text":"MXLInstrument","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL13MXLInstrumentV"},{"text":"]","kind":"text"}]}],"kind":"declarations"},{"content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Maps to nested MusicXML ","type":"text"},{"code":"<instrument>","type":"codeVoice"},{"text":" elements.","type":"text"}]}],"kind":"content"}],"abstract":[{"type":"text","text":"The instruments used to play this note, for parts with multiple instruments."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlnote\/instrument"]}],"references":{"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlnote","title":"MXLNote","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNote","kind":"identifier"}],"navigatorTitle":[{"text":"MXLNote","kind":"identifier"}],"abstract":[{"type":"text","text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for"},{"type":"text","text":" "},{"type":"text","text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation)."},{"type":"text","text":" "},{"type":"text","text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,"},{"type":"text","text":" "},{"text":"but no tie elements. Having these two types of information available can make interchange easier, as some","type":"text"},{"type":"text","text":" "},{"type":"text","text":"programs handle one type of information more readily than the other."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote"},"doc://IvorMXL/documentation/IvorMXL/MXLInstrument":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLInstrument","abstract":[{"text":"The instrument type distinguishes between score-instrument elements in a score-part. The id attribute is an","type":"text"},{"text":" ","type":"text"},{"text":"IDREF back to the score-instrument ID. If multiple score-instruments are specified in a score-part, there","type":"text"},{"text":" ","type":"text"},{"text":"should be an instrument element for each note in the part. Notes that are shared between multiple score-","type":"text"},{"text":" ","type":"text"},{"text":"instruments can have more than one instrument element.","type":"text"}],"title":"MXLInstrument","navigatorTitle":[{"kind":"identifier","text":"MXLInstrument"}],"type":"topic","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLInstrument"}],"url":"\/documentation\/ivormxl\/mxlinstrument"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/instrument":{"url":"\/documentation\/ivormxl\/mxlnote\/instrument","role":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/instrument","abstract":[{"type":"text","text":"The instruments used to play this note, for parts with multiple instruments."}],"title":"instrument","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"instrument","kind":"identifier"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:7IvorMXL13MXLInstrumentV","text":"MXLInstrument","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"kind":"symbol"}}}