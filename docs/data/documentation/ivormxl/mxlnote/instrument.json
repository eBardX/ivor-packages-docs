{"sections":[],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/instrument","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"instrument","kind":"identifier"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:7IvorMXL13MXLInstrumentV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLInstrument","text":"MXLInstrument","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Maps to nested MusicXML "},{"type":"codeVoice","code":"<instrument>"},{"type":"text","text":" elements."}],"type":"paragraph"}],"kind":"content"}],"metadata":{"symbolKind":"property","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"instrument","kind":"identifier"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:7IvorMXL13MXLInstrumentV","text":"MXLInstrument","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"role":"symbol","modules":[{"name":"IvorMXL"}],"roleHeading":"Instance Property","externalID":"s:7IvorMXL7MXLNoteV10instrumentSayAA13MXLInstrumentVGvp","title":"instrument"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlnote\/instrument"]}],"abstract":[{"text":"The instruments used to play this note, for parts with multiple instruments.","type":"text"}],"kind":"symbol","schemaVersion":{"patch":0,"minor":3,"major":0},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLInstrument":{"type":"topic","abstract":[{"type":"text","text":"The instrument type distinguishes between score-instrument elements in a score-part. The id attribute is an"},{"type":"text","text":" "},{"type":"text","text":"IDREF back to the score-instrument ID. If multiple score-instruments are specified in a score-part, there"},{"type":"text","text":" "},{"type":"text","text":"should be an instrument element for each note in the part. Notes that are shared between multiple score-"},{"type":"text","text":" "},{"type":"text","text":"instruments can have more than one instrument element."}],"url":"\/documentation\/ivormxl\/mxlinstrument","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLInstrument"}],"kind":"symbol","title":"MXLInstrument","navigatorTitle":[{"kind":"identifier","text":"MXLInstrument"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLInstrument","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNote","kind":"identifier"}],"title":"MXLNote","abstract":[{"text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for","type":"text"},{"text":" ","type":"text"},{"text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation).","type":"text"},{"text":" ","type":"text"},{"text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,","type":"text"},{"text":" ","type":"text"},{"text":"but no tie elements. Having these two types of information available can make interchange easier, as some","type":"text"},{"text":" ","type":"text"},{"text":"programs handle one type of information more readily than the other.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","role":"symbol","url":"\/documentation\/ivormxl\/mxlnote","kind":"symbol","navigatorTitle":[{"text":"MXLNote","kind":"identifier"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/instrument":{"kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"The instruments used to play this note, for parts with multiple instruments."}],"url":"\/documentation\/ivormxl\/mxlnote\/instrument","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"instrument","kind":"identifier"},{"text":": [","kind":"text"},{"text":"MXLInstrument","preciseIdentifier":"s:7IvorMXL13MXLInstrumentV","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"title":"instrument","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/instrument"}}}