l":"\/documentation\/ivormxl\/mxlinstrument","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLInstrument","abstract":[{"text":"The instrument type distinguishes between score-instrument elements in a score-part. The id attribute is an","type":"text"},{"text":" ","type":"text"},{"text":"IDREF back to the score-instrument ID. If multiple score-instruments are specified in a score-part, there","type":"text"},{"text":" ","type":"text"},{"text":"should be an instrument element for each note in the part. Notes that are shared between multiple score-","type":"text"},{"text":" ","type":"text"},{"text":"instruments can have more than one instrument element.","type":"text"}],"navigatorTitle":[{"text":"MXLInstrument","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote/instrument":{"kind":"symbol","abstract":[{"type":"text","text":"The instruments used to play this note, for parts with multiple instruments."}],"title":"instrument","url":"\/documentation\/ivormxl\/mxlnote\/instrument","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/instrument","type":"topic","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"instrument"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL13MXLInstrumentV","text":"MXLInstrument"},{"kind":"text","text":"]"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"navigatorTitle":[{"kind":"identifier","text":"MXLNote"}],"abstract":[{"text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for","type":"text"},{"text":" ","type":"text"},{"text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation).","type":"text"},{"text":" ","type":"text"},{"text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,","type":"text"},{"text":" ","type":"text"},{"text":"but no tie elements. Having these two types of information available can make interchange easier, as some","type":"text"},{"text":" ","type":"text"},{"text":"programs handle one type of information more readily than the other.","type":"text"}],"title":"MXLNote","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","kind":"symbol","url":"\/documentation\/ivormxl\/mxlnote","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNote"}],"role":"symbol"}}}