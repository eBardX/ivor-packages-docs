{"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote"]]},"variants":[{"paths":["\/documentation\/ivormxl\/mxlnote\/instrument"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"The instruments used to play this note, for parts with multiple instruments.","type":"text"}],"kind":"symbol","sections":[],"metadata":{"roleHeading":"Instance Property","externalID":"s:7IvorMXL7MXLNoteV10instrumentSayAA13MXLInstrumentVGvp","modules":[{"name":"IvorMXL"}],"role":"symbol","title":"instrument","symbolKind":"property","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"instrument","kind":"identifier"},{"text":": [","kind":"text"},{"text":"MXLInstrument","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL13MXLInstrumentV"},{"text":"]","kind":"text"}]},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"instrument","kind":"identifier"},{"text":": [","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLInstrument","text":"MXLInstrument","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL13MXLInstrumentV"},{"text":"]","kind":"text"}]}],"kind":"declarations"},{"content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Maps to nested MusicXML "},{"type":"codeVoice","code":"<instrument>"},{"type":"text","text":" elements."}]}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/instrument"},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLNote/instrument":{"title":"instrument","kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"instrument","kind":"identifier"},{"text":": [","kind":"text"},{"text":"MXLInstrument","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL13MXLInstrumentV"},{"text":"]","kind":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/instrument","url":"\/documentation\/ivormxl\/mxlnote\/instrument","type":"topic","abstract":[{"type":"text","text":"The instruments used to play this note, for parts with multiple instruments."}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"title":"MXLNote","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNote"}],"abstract":[{"type":"text","text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for"},{"type":"text","text":" "},{"type":"text","text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation)."},{"type":"text","text":" "},{"type":"text","text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,"},{"type":"text","text":" "},{"type":"text","text":"but no tie elements. Having these two types of information available can make interchange easier, as some"},{"type":"text","text":" "},{"type":"text","text":"programs handle one type of information more readily than the other."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLNote"}],"url":"\/documentation\/ivormxl\/mxlnote"},"doc://IvorMXL/documentation/IvorMXL/MXLInstrument":{"abstract":[{"text":"The instrument type distinguishes between score-instrument elements in a score-part. The id attribute is an","type":"text"},{"text":" ","type":"text"},{"text":"IDREF back to the score-instrument ID. If multiple score-instruments are specified in a score-part, there","type":"text"},{"text":" ","type":"text"},{"text":"should be an instrument element for each note in the part. Notes that are shared between multiple score-","type":"text"},{"text":" ","type":"text"},{"text":"instruments can have more than one instrument element.","type":"text"}],"role":"symbol","kind":"symbol","url":"\/documentation\/ivormxl\/mxlinstrument","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLInstrument","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"MXLInstrument","kind":"identifier"}],"title":"MXLInstrument","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLInstrument"}}}