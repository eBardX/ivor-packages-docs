{"metadata":{"title":"Equatable Implementations","modules":[{"name":"IvorMXL"}],"role":"collectionGroup","roleHeading":"API Collection"},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlnote\/kind-swift.struct\/equatable-implementations"]}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Kind-swift.struct"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Kind-swift.struct\/Equatable-Implementations"},"kind":"article","topicSections":[{"title":"Operators","anchor":"Operators","generated":true,"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Kind-swift.struct\/!=(_:_:)"]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLNote/Kind-swift.struct":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlnote\/kind-swift.struct","title":"MXLNote.Kind","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Kind"}],"navigatorTitle":[{"kind":"identifier","text":"Kind"}],"abstract":[{"type":"text","text":"The note-type type indicates the graphic note type. Values range from 1024th to maxima. The size attribute"},{"type":"text","text":" "},{"type":"text","text":"indicates full, cue, grace-cue, or large size. The default is full for regular notes, grace-cue for notes that"},{"type":"text","text":" "},{"type":"text","text":"contain both grace and cue elements, and cue for notes that contain either a cue or a grace element, but not"},{"type":"text","text":" "},{"type":"text","text":"both."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Kind-swift.struct"},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlnote","title":"MXLNote","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNote","kind":"identifier"}],"navigatorTitle":[{"text":"MXLNote","kind":"identifier"}],"abstract":[{"type":"text","text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for"},{"type":"text","text":" "},{"type":"text","text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation)."},{"type":"text","text":" "},{"type":"text","text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,"},{"type":"text","text":" "},{"text":"but no tie elements. Having these two types of information available can make interchange easier, as some","type":"text"},{"type":"text","text":" "},{"type":"text","text":"programs handle one type of information more readily than the other."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote/Kind-swift.struct/!=(_:_:)":{"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlnote\/kind-swift.struct\/!=(_:_:)","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"!=","kind":"identifier"},{"text":" ","kind":"text"},{"text":"(","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Kind-swift.struct\/!=(_:_:)","abstra