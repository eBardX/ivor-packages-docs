{"abstract":[{"type":"text","text":"The value of this element."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"text":"value","kind":"identifier"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL16MXLNoteKindValueO","text":"MXLNoteKindValue","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNoteKindValue"}],"platforms":["macOS"]}]}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Kind-swift.struct"]]},"kind":"symbol","metadata":{"roleHeading":"Instance Property","title":"value","role":"symbol","externalID":"s:7IvorMXL7MXLNoteV4KindV5valueAA0cD5ValueOvp","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"value","kind":"identifier"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL16MXLNoteKindValueO","text":"MXLNoteKindValue","kind":"typeIdentifier"}],"modules":[{"name":"IvorMXL"}],"symbolKind":"property"},"sections":[],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Kind-swift.struct\/value","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlnote\/kind-swift.struct\/value"]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLNote/Kind-swift.struct/value":{"abstract":[{"text":"The value of this element.","type":"text"}],"title":"value","url":"\/documentation\/ivormxl\/mxlnote\/kind-swift.struct\/value","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"value"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLNoteKindValue","preciseIdentifier":"s:7IvorMXL16MXLNoteKindValueO"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Kind-swift.struct\/value"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"title":"MXLNote","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNote"}],"abstract":[{"type":"text","text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for"},{"type":"text","text":" "},{"type":"text","text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation)."},{"type":"text","text":" "},{"type":"text","text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,"},{"type":"text","text":" "},{"type":"text","text":"but no tie elements. Having these two types of information available can make interchange easier, as some"},{"type":"text","text":" "},{"type":"text","text":"programs handle one type of information more readily than the other."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLNote"}],"url":"\/documentation\/ivormxl\/mxlnote"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/Kind-swift.struct":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlnote\/kind-swift.struct","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Kind-swift.struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Kind"}],"abstract":[{"type":"text","text":"The note-type type indicates the graphic note type. Values range from 1024th to maxima. The size attribute"},{"type":"text","text":" "},{"type":"text","text":"indicates full, cue, grace-cue, or large size. The default is full for regular notes, grace-cue for notes that"},{"type":"text","text":" "},{"type":"text","text":"contain both grace and cue elements, and cue for notes that contain either a cue or a grace element, but not"},{"type":"text","text":" "},{"type":"text","text":"both."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Kind"}],"title":"MXLNote.Kind"},"doc://IvorMXL/documentation/IvorMXL/MXLNoteKindValue":{"url":"\/documentation\/ivormxl\/mxlnotekindvalue","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNoteKindValue","abstract":[{"type":"text","text":"The note-type-value type is used for the MusicXML type element and represents the graphic note type, from"},{"type":"text","text":" "},{"type":"text","text":"1024th (shortest) to maxima (longest)."}],"title":"MXLNoteKindValue","kind":"symbol","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNoteKindValue"}],"navigatorTitle":[{"kind":"identifier","text":"MXLNoteKindValue"}]}}}