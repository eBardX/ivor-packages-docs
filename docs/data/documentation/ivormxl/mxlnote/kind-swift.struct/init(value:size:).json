\/ivormxl\/mxlnote\/kind-swift.struct\/init(value:size:)"]}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Kind-swift.struct"]]},"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Kind-swift.struct\/init(value:size:)","interfaceLanguage":"swift"},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLNote/Kind-swift.struct/init(value:size:)":{"kind":"symbol","title":"init(value:size:)","url":"\/documentation\/ivormxl\/mxlnote\/kind-swift.struct\/init(value:size:)","abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLNote.Kind"},{"type":"text","text":"."}],"fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"value","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLNoteKindValue","preciseIdentifier":"s:7IvorMXL16MXLNoteKindValueO","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"size","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLSymbolSize","preciseIdentifier":"s:7IvorMXL13MXLSymbolSizeO","kind":"typeIdentifier"},{"text":"?)","kind":"text"}],"type":"topic","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Kind-swift.struct\/init(value:size:)"},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNote"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLNote"}],"url":"\/documentation\/ivormxl\/mxlnote","role":"symbol","title":"MXLNote","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","type":"topic","abstract":[{"type":"text","text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for"},{"type":"text","text":" "},{"type":"text","text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation)."},{"type":"text","text":" "},{"type":"text","text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,"},{"type":"text","text":" "},{"type":"text","text":"but no tie elements. Having these two types of information available can make interchange easier, as some"},{"type":"text","text":" "},{"type":"text","text":"programs handle one type of information more readily than the other."}]},"doc://IvorMXL/documentation/IvorMXL/MXLNoteKindValue":{"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlnotekindvalue","abstract":[{"text":"The note-type-value type is used for the MusicXML type element and represents the graphic note type, from","type":"text"},{"text":" ","type":"text"},{"text":"1024th (shortest) to maxima (longest).","type":"text"}],"navigatorTitle":[{"text":"MXLNoteKindValue","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNoteKindValue","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNoteKindValue","title":"MXLNoteKindValue"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/Kind-swift.struct":{"url":"\/documentation\/ivormxl\/mxlnote\/kind-swift.struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Kind"}],"title":"MXLNote.Kind","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Kind-swift.struct","navigatorTitle":[{"kind":"identifier","text":"Kind"}],"role":"symbol","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The note-type type indicates the graphic note type. Values range from 1024th to maxima. The size attribute"},{"type":"text","text":" "},{"type":"text","text":"indicates full, cue, grace-cue, or large size. The default is full for regular notes, grace-cue for notes that"},{"type":"text","text":" "},{"type":"text","text":"contain both grace and cue elements, and cue for notes that contain either a cue or a grace element, but not"},{"type":"text","text":" "},{"type":"text","text":"both."}]},"doc://IvorMXL/documentation/IvorMXL/MXLSymbolSize":{"url":"\/documentation\/ivormxl\/mxlsymbolsize","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSymbolSize","kind":"identifier"}],"title":"MXLSymbolSize","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSymbolSize","navigatorTitle":[{"text":"MXLSymbolSize","kind":"identifier"}],"role":"symbol","type":"topic","kind":"symbol","abstract":[{"text":"The symbol-size type is used to distinguish between full, cue sized, grace cue sized, and oversized symbols.","type":"text"}]}}}