ound, tied for notation).","type":"text"},{"text":" ","type":"text"},{"text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,","type":"text"},{"text":" ","type":"text"},{"text":"but no tie elements. Having these two types of information available can make interchange easier, as some","type":"text"},{"text":" ","type":"text"},{"text":"programs handle one type of information more readily than the other.","type":"text"}],"title":"MXLNote","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","kind":"symbol","url":"\/documentation\/ivormxl\/mxlnote","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNote"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/Kind-swift.struct":{"abstract":[{"type":"text","text":"The note-type type indicates the graphic note type. Values range from 1024th to maxima. The size attribute"},{"type":"text","text":" "},{"type":"text","text":"indicates full, cue, grace-cue, or large size. The default is full for regular notes, grace-cue for notes that"},{"type":"text","text":" "},{"type":"text","text":"contain both grace and cue elements, and cue for notes that contain either a cue or a grace element, but not"},{"type":"text","text":" "},{"type":"text","text":"both."}],"title":"MXLNote.Kind","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Kind","kind":"identifier"}],"navigatorTitle":[{"text":"Kind","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlnote\/kind-swift.struct","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Kind-swift.struct"},"doc://IvorMXL/documentation/IvorMXL/MXLSymbolSize":{"navigatorTitle":[{"kind":"identifier","text":"MXLSymbolSize"}],"abstract":[{"text":"The symbol-size type is used to distinguish between full, cue sized, grace cue sized, and oversized symbols.","type":"text"}],"title":"MXLSymbolSize","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSymbolSize","kind":"symbol","url":"\/documentation\/ivormxl\/mxlsymbolsize","type":"topic","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLSymbolSize"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNoteKindValue":{"navigatorTitle":[{"text":"MXLNoteKindValue","kind":"identifier"}],"abstract":[{"text":"The note-type-value type is used for the MusicXML type element and represents the graphic note type, from","type":"text"},{"text":" ","type":"text"},{"text":"1024th (shortest) to maxima (longest).","type":"text"}],"title":"MXLNoteKindValue","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNoteKindValue","kind":"symbol","url":"\/documentation\/ivormxl\/mxlnotekindvalue","type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNoteKindValue","kind":"identifier"}],"role":"symbol"}}}