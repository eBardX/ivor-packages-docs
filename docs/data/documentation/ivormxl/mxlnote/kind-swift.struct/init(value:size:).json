","text":"?)"}],"title":"init(value:size:)","role":"symbol"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Kind-swift.struct"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Kind-swift.struct\/init(value:size:)"},"references":{"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLSymbolSize":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlsymbolsize","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSymbolSize","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSymbolSize","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"The symbol-size type is used to distinguish between full, cue sized, grace cue sized, and oversized symbols.","type":"text"}],"type":"topic","navigatorTitle":[{"text":"MXLSymbolSize","kind":"identifier"}],"title":"MXLSymbolSize"},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"title":"MXLNote","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNote"}],"abstract":[{"type":"text","text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for"},{"type":"text","text":" "},{"type":"text","text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation)."},{"type":"text","text":" "},{"type":"text","text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,"},{"type":"text","text":" "},{"type":"text","text":"but no tie elements. Having these two types of information available can make interchange easier, as some"},{"type":"text","text":" "},{"type":"text","text":"programs handle one type of information more readily than the other."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLNote"}],"url":"\/documentation\/ivormxl\/mxlnote"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/Kind-swift.struct":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlnote\/kind-swift.struct","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Kind-swift.struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Kind"}],"abstract":[{"type":"text","text":"The note-type type indicates the graphic note type. Values range from 1024th to maxima. The size attribute"},{"type":"text","text":" "},{"type":"text","text":"indicates full, cue, grace-cue, or large size. The default is full for regular notes, grace-cue for notes that"},{"type":"text","text":" "},{"type":"text","text":"contain both grace and cue elements, and cue for notes that contain either a cue or a grace element, but not"},{"type":"text","text":" "},{"type":"text","text":"both."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Kind"}],"title":"MXLNote.Kind"},"doc://IvorMXL/documentation/IvorMXL/MXLNoteKindValue":{"url":"\/documentation\/ivormxl\/mxlnotekindvalue","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNoteKindValue","abstract":[{"type":"text","text":"The note-type-value type is used for the MusicXML type element and represents the graphic note type, from"},{"type":"text","text":" "},{"type":"text","text":"1024th (shortest) to maxima (longest)."}],"title":"MXLNoteKindValue","kind":"symbol","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNoteKindValue"}],"naviga