{"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Kind-swift.struct"]]},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlnote\/kind-swift.struct\/size"]}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Kind-swift.struct\/size"},"abstract":[{"text":"The size of the note: full, cue, grace-cue, or large.","type":"text"}],"metadata":{"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"size"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLSymbolSize","preciseIdentifier":"s:7IvorMXL13MXLSymbolSizeO"},{"kind":"text","text":"?"}],"title":"size","externalID":"s:7IvorMXL7MXLNoteV4KindV4sizeAA13MXLSymbolSizeOSgvp","role":"symbol","modules":[{"name":"IvorMXL"}],"roleHeading":"Instance Property","symbolKind":"property"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"size"},{"kind":"text","text":": "},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSymbolSize","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL13MXLSymbolSizeO","text":"MXLSymbolSize"},{"kind":"text","text":"?"}],"platforms":["macOS"],"languages":["swift"]}]},{"content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"Maps to the MusicXML ","type":"text"},{"type":"codeVoice","code":"size"},{"text":" attribute.","type":"text"}]}],"kind":"content"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLNote/Kind-swift.struct":{"type":"topic","title":"MXLNote.Kind","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Kind-swift.struct","abstract":[{"text":"The note-type type indicates the graphic note type. Values range from 1024th to maxima. The size attribute","type":"text"},{"text":" ","type":"text"},{"text":"indicates full, cue, grace-cue, or large size. The default is full for regular notes, grace-cue for notes that","type":"text"},{"text":" ","type":"text"},{"text":"contain both grace and cue elements, and cue for notes that contain either a cue or a grace element, but not","type":"text"},{"text":" ","type":"text"},{"text":"both.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Kind"}],"navigatorTitle":[{"kind":"identifier","text":"Kind"}],"url":"\/documentation\/ivormxl\/mxlnote\/kind-swift.struct"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNote","kind":"identifier"}],"title":"MXLNote","abstract":[{"text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for","type":"text"},{"text":" ","type":"text"},{"text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation).","type":"text"},{"text":" ","type":"text"},{"text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,","type":"text"},{"text":" ","type":"text"},{"text":"but no tie elements. Having these two types of information available can make interchange easier, as some","type":"text"},{"text":" ","type":"text"},{"text":"programs handle one type of information more readily than the other.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","role":"symbol","url":"\/documentation\/ivormxl\/mxlnote","kind":"symbol","navigatorTitle":[{"text":"MXLNote","kind":"identifier"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLSymbolSize":{"type":"topic","title":"MXLSymbolSize","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSymbolSize","abstract":[{"text":"The symbol-size type is used to distinguish between full, cue sized, grace cue sized, and oversized symbols.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLSymbolSize"}],"navigatorTitle":[{"kind":"identifier","text":"MXLSymbolSize"}],"url":"\/documentation\/ivormxl\/mxlsymbolsize"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/Kind-swift.struct/size":{"type":"topic","title":"size","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Kind-swift.struct\/size","abstract":[{"text":"The size of the note: full, cue, grace-cue, or large.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"size"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL13MXLSymbolSizeO","kind":"typeIdentifier","text":"MXLSymbolSize"},{"kind":"text","text":"?"}],"url":"\/documentation\/ivormxl\/mxlnote\/kind-swift.struct\/size"}}}