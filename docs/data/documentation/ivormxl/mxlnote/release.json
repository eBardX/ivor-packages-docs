{"kind":"symbol","sections":[],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/release","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Alters the stopping time of the note from when it would otherwise occur, expressed in divisions. A note that"},{"type":"text","text":" "},{"type":"text","text":"starts a tie should not have a release attribute."}],"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"symbolKind":"property","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"release"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL12MXLDivisionsV","kind":"typeIdentifier","text":"MXLDivisions"},{"kind":"text","text":"?"}],"externalID":"s:7IvorMXL7MXLNoteV7releaseAA12MXLDivisionsVSgvp","roleHeading":"Instance Property","role":"symbol","title":"release","modules":[{"name":"IvorMXL"}]},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote"]]},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"release"},{"kind":"text","text":": "},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDivisions","preciseIdentifier":"s:7IvorMXL12MXLDivisionsV","kind":"typeIdentifier","text":"MXLDivisions"},{"kind":"text","text":"?"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","anchor":"discussion","text":"Discussion","level":2},{"inlineContent":[{"type":"text","text":"Maps to the MusicXML "},{"code":"release","type":"codeVoice"},{"type":"text","text":" attribute."}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlnote\/release"]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLDivisions":{"abstract":[{"text":"The divisions type is used to express values in terms of the musical divisions defined by the divisions","type":"text"},{"text":" ","type":"text"},{"text":"element. It is preferred that these be integer values both for MIDI interoperability and to avoid roundoff","type":"text"},{"text":" ","type":"text"},{"text":"errors.","type":"text"}],"kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLDivisions","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"MXLDivisions"}],"type":"topic","url":"\/documentation\/ivormxl\/mxldivisions","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDivisions","title":"MXLDivisions"},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNote"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLNote"}],"url":"\/documentation\/ivormxl\/mxlnote","role":"symbol","title":"MXLNote","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","type":"topic","abstract":[{"type":"text","text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for"},{"type":"text","text":" "},{"type":"text","text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation)."},{"type":"text","text":" "},{"type":"text","text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,"},{"type":"text","text":" "},{"type":"text","text":"but no tie elements. Having these two types of information available can make interchange easier, as some"},{"type":"text","text":" "},{"type":"text","text":"programs handle one type of information more readily than the other."}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\