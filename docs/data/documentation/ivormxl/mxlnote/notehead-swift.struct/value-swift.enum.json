{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Notehead-swift.struct\/Value-swift.enum"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Notehead-swift.struct"]]},"abstract":[{"type":"text","text":"The notehead-value type indicates shapes other than the open and closed ovals associated with note durations."}],"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/IvorMXL\/s8CopyableP","doc:\/\/IvorMXL\/SQ","doc:\/\/IvorMXL\/s9EscapableP","doc:\/\/IvorMXL\/SH","doc:\/\/IvorMXL\/s8SendableP","doc:\/\/IvorMXL\/s16SendableMetatypeP"],"kind":"relationships","type":"conformsTo"}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Value","kind":"identifier"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The values do, re, mi, fa, fa up, so, la, and ti correspond to Aikin’s 7-shape system. The fa up shape is"},{"type":"text","text":" "},{"type":"text","text":"typically used with upstems; the fa shape is typically used with downstems or no stems."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The arrow shapes differ from triangle and inverted triangle by being centered on the stem. Slashed and back"},{"type":"text","text":" "},{"type":"text","text":"slashed notes include both the normal notehead and a slash. The triangle shape has the tip of the triangle"},{"type":"text","text":" "},{"type":"text","text":"pointing up; the inverted triangle shape has the tip of the triangle pointing down. The left triangle shape is"},{"type":"text","text":" "},{"type":"text","text":"a right triangle with the hypotenuse facing up and to the left."}]},{"type":"p