o types of information available can make interchange easier, as some","type":"text"},{"text":" ","type":"text"},{"text":"programs handle one type of information more readily than the other.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","role":"symbol","url":"\/documentation\/ivormxl\/mxlnote","kind":"symbol","navigatorTitle":[{"text":"MXLNote","kind":"identifier"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/Notehead-swift.struct/Value-swift.enum":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Value","kind":"identifier"}],"title":"MXLNote.Notehead.Value","abstract":[{"type":"text","text":"The notehead-value type indicates shapes other than the open and closed ovals associated with note durations."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Notehead-swift.struct\/Value-swift.enum","role":"symbol","url":"\/documentation\/ivormxl\/mxlnote\/notehead-swift.struct\/value-swift.enum","kind":"symbol","navigatorTitle":[{"text":"Value","kind":"identifier"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/Notehead-swift.struct":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Notehead","kind":"identifier"}],"title":"MXLNote.Notehead","abstract":[{"type":"text","text":"The notehead type indicates shapes other than the open and closed ovals associated with note durations."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Notehead-swift.struct","role":"symbol","url":"\/documentation\/ivormxl\/mxlnote\/notehead-swift.struct","kind":"symbol","navigatorTitle":[{"text":"Notehead","kind":"identifier"}],"type":"topic"},"doc: