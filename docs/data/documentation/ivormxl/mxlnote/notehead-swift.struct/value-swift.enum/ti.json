otation information (e.g., tie is used for sound, tied for notation)."},{"type":"text","text":" "},{"type":"text","text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,"},{"type":"text","text":" "},{"type":"text","text":"but no tie elements. Having these two types of information available can make interchange easier, as some"},{"type":"text","text":" "},{"type":"text","text":"programs handle one type of information more readily than the other."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLNote"}],"url":"\/documentation\/ivormxl\/mxlnote"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/Notehead-swift.struct/Value-swift.enum/ti":{"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"ti"}],"title":"MXLNote.Notehead.Value.ti","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Notehead-swift.struct\/Value-swift.enum\/ti","kind":"symbol","url":"\/documentation\/ivormxl\/mxlnote\/notehead-swift.struct\/value-swift.enum\/ti","type":"topic","abstract":[{"type":"text","text":"The “ti” shape in Aikin’s 7-shape system."}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote/Notehead-swift.struct":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlnote\/notehead-swift.struct","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Notehead-swift.struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Notehead"}],"abstract":[{"type":"text","text":"The notehead type indicates shapes other than the open and closed ovals associated with note durations."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Notehead"}],"title":"MXLNote.Notehead"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/Notehead-swift.struct/Value-swift.enum":{"role":"symbol","url":"\/documentati