sParentheses","content":[{"inlineContent":[{"type":"text","text":"A Boolean value indicating whether the notehead is parenthesized. Defaults to "},{"code":"false","type":"codeVoice"},{"type":"text","text":" if not specified."}],"type":"paragraph"}]},{"name":"font","content":[{"inlineContent":[{"type":"text","text":"The font attribute group gathers together attributes for determining the font within a credit or direction. They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of font names.The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font vs. a music font."}],"type":"paragraph"}]},{"name":"color","content":[{"inlineContent":[{"type":"text","text":"The color attribute group indicates the color of an element."}],"type":"paragraph"}]},{"name":"smufl","content":[{"inlineContent":[{"type":"text","text":"The smufl attribute group is used to indicate a particular Standard Music Font Layout (SMuFL) character. Sometimes this is a formatting choice, and sometimes this is a refinement of the semantic meaning of an element."}],"type":"paragraph"}]}],"kind":"parameters"}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Notehead-swift.struct\/init(value:isFilled:hasParentheses:font:color:smufl:)","interfaceLanguage":"swift"},"sections":[],"kind":"symbol","abstract":[{"type":"text","text":"Creates a new "},{"code":"MXLNote.Notehead","type":"codeVoice"},{"type":"text","text":"."}],"metadata":{"symbolKind":"init","role":"symbol","roleHeading":"Initializer","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"value","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL7MXLNoteV8NoteheadV5ValueO","text":"Value","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"isFilled","kind":"externalParam