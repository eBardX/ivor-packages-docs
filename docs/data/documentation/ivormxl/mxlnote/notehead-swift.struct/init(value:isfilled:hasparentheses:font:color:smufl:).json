","text":"?)"}],"title":"init(value:isFilled:hasParentheses:font:color:smufl:)"},"sections":[],"abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLNote.Notehead"},{"type":"text","text":"."}],"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"value"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Value","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Notehead-swift.struct\/Value-swift.enum","preciseIdentifier":"s:7IvorMXL7MXLNoteV8NoteheadV5ValueO"},{"kind":"text","text":", "},{"kind":"externalParam","text":"isFilled"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"hasParentheses"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"font"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLFont","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","preciseIdentifier":"s:7IvorMXL7MXLFontV"},{"kind":"text","text":" = MXLFont(), "},{"kind":"externalParam","text":"color"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLColor","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","preciseIdentifier":"s:7IvorMXL8MXLColorV"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"smufl"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLSmuflGlyphName","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSmuflGlyphName","preciseIdentifier":"s:7IvorMXL17MXLSmuflGlyphNameV"},{"kind":"text","text":"? = nil)"}]}],"kind":"declarations"},{"parameters":[{"name":"value","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The value of this element."}]}]},{"name":"isFilled","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A Boolean value indicating whether the notehead is filled. Defaults to hollow"},{"type":"text","text":" "},{"type":"text","text":"for half notes and longer, and filled otherwise."}]}]},{"name":"hasParentheses","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A Boolean value indicating whether the notehead is parenthesized. Defaults to"},{"type":"text","text":" "},{"code":"false","type":"codeVoice"},{"type":"text","text":" if not specified."}]}]},{"name":"font","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The font attribute group gathers together attributes for determining the font"},{"type":"text","text":" "},{"type":"text","text":"within a credit or direction. They are based on the text styles for Cascading"},{"type":"text","text":" "},{"type":"text","text":"Style Sheets. The font-family is a comma-separated list of font names. The"},{"type":"text","text":" "},{"type":"text","text":"font-style can be normal or italic. The font-size can be one of the CSS sizes"},{"type":"text","text":" "},{"type":"text","text":"or a numeric point size. The font-weight can be normal or bold. The default is"},{"type":"text","text":" "},{"type":"text","text":"application-dependent, but is a text font vs. a music font."}]}]},{"name":"color","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The color attribute group indicates the color of an element."}]}]},{"name":"smufl","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The smufl attribute group is used to indicate a particular Standard Music Font"},{"type":"text","text":" "},{"type":"text","text":"Layout (SMuFL) character. Sometimes this is a formatting choice, and sometimes"},{"type":"text","text":" "},{"type":"text","text":"this is a refinement of the semantic meaning of an element."}]}]}],"kind":"parameters"}],"references":{"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"type":"topic","abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"type":"text","text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is"},{"type":"text","text":" "},{"type":"text","text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF."}],"url":"\/documentation\/ivormxl\/mxlcolor","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"kind":"symbol","title":"MXLColor","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/Notehead-swift.struct":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Notehead","kind":"identifier"}],"title":"MXLNote.Notehead","abstract":[{"type":"text","text":"The notehead type indicates shapes other than the open and closed ovals associated with note durations."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Notehead-swift.struct","role":"symbol","url":"\/documentation\/ivormxl\/mxlnote\/notehead-swift.struct","kind":"symbol","navigatorTitle":[{"text":"Notehead","kind":"identifier"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLFont":{"type":"topic","title":"MXLFont","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","abstract":[{"type":"text","text":"The font attribute group gathers together attributes for determining the font within a credit or direction."},{"type":"text","text":" "},{"type":"text","text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of"},{"type":"text","text":" "},{"type":"text","text":"font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric"},{"type":"text","text":" "},{"type":"text","text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font"},{"type":"text","text":" "},{"type":"text","text":"vs. a music font."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFont"}],"navigatorTitle":[{"kind":"identifier","text":"MXLFont"}],"url":"\/documentation\/ivormxl\/mxlfont"},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNote","kind":"identifier"}],"title":"MXLNote","abstract":[{"text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for","type":"text"},{"text":" ","type":"text"},{"text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation).","type":"text"},{"text":" ","type":"text"},{"text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,","type":"text"},{"text":" ","type":"text"},{"text":"but no tie elements. Having these two types of information available can make interchange easier, as some","type":"text"},{"text":" ","type":"text"},{"text":"programs handle one type of information more readily than the other.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","role":"symbol","url":"\/documentation\/ivormxl\/mxlnote","kind":"symbol","navigatorTitle":[{"text":"MXLNote","kind":"identifier"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/Notehead-swift.struct/Value-swift.enum":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Value","kind":"identifier"}],"title":"MXLNote.Notehead.Value","abstract":[{"type":"text","text":"The notehead-value type indicates shapes other than the open and closed ovals associated with note durations."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Notehead-swift.struct\/Value-swift.enum","role":"symbol","url":"\/documentation\/ivormxl\/mxlnote\/notehead-swift.struct\/value-swift.enum","kind":"symbol","navigatorTitle":[{"text":"Value","kind":"identifier"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/Notehead-swift.struct/init(value:isFilled:hasParentheses:font:color:smufl:)":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Notehead-swift.struct\/init(value:isFilled:hasParentheses:font:color:smufl:)","url":"\/documentation\/ivormxl\/mxlnote\/notehead-swift.struct\/init(value:isfilled:hasparentheses:font:color:smufl:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"value","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Value","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL7MXLNoteV8NoteheadV5ValueO"},{"text":", ","kind":"text"},{"text":"isFilled","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":"?, ","kind":"text"},{"text":"hasParentheses","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":"?, ","kind":"text"},{"text":"font","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLFont","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL7MXLFontV"},{"text":", ","kind":"text"},{"text":"color","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLColor","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLColorV"},{"text":"?, ","kind":"text"},{"text":"smufl","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLSmuflGlyphName","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL17MXLSmuflGlyphNameV"},{"text":"?)","kind":"text"}],"title":"init(value:isFilled:hasParentheses:font:color:smufl:)","abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLNote.Notehead"},{"type":"text","text":"."}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLSmuflGlyphName":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSmuflGlyphName","kind":"identifier"}],"title":"MXLSmuflGlyphName","abstract":[{"type":"text","text":"The smufl-glyph-name type is used for attributes that reference a specific Standard Music Font Layout (SMuFL)"},{"text":" ","type":"text"},{"type":"text","text":"character. The value is a SMuFL canonical glyph name, not a code point. For instance, the value for a standard"},{"type":"text","text":" "},{"text":"piano pedal mark would be keyboardPedalPed, not U+E650.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSmuflGlyphName","role":"symbol","url":"\/documentation\/ivormxl\/mxlsmuflglyphname","kind":"symbol","navigatorTitle":[{"text":"MXLSmuflGlyphName","kind":"identifier"}],"type":"topic"}}}