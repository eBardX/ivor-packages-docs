most common type of MusicXML data. The MusicXML format distinguishes between elements used for"},{"type":"text","text":" "},{"type":"text","text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation)."},{"type":"text","text":" "},{"type":"text","text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,"},{"type":"text","text":" "},{"type":"text","text":"but no tie elements. Having these two types of information available can make interchange easier, as some"},{"type":"text","text":" "},{"type":"text","text":"programs handle one type of information more readily than the other."}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote/Notehead-swift.struct":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Notehead","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"Notehead","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlnote\/notehead-swift.struct","role":"symbol","title":"MXLNote.Notehead","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Notehead-swift.struct","type":"topic","abstract":[{"text":"The notehead type indicates shapes other than the open and closed ovals associated with note durations.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote/Notehead-swift.struct/Value-swift.enum":{"navigatorTitle":[{"text":"Value","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Notehead-swift.struct\/Value-swift.enum","type":"topic","title":"MXLNote.Notehead.Value","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Value","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlnote\/notehead-swift.struct\/value-swift.enum","abstract":[{"text":"The notehead-value type indicates shapes other than the open and closed ovals associated with note durations.","type":"text"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLColor","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","title":"MXLColor","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlcolor"},"doc://IvorMXL/documentation/IvorMXL/MXLSmuflGlyphName":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLSmuflGlyphName"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSmuflGlyphName","title":"MXLSmuflGlyphName","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLSmuflGlyphName"}],"abstract":[{"text":"The smufl-glyph-name type is used for attributes that reference a specific Standard Music Font Layout (SMuFL)","type":"text"},{"text":" ","type":"text"},{"text":"character. The value is a SMuFL canonical glyph name, not a code point. For instance, the value for a standard","type":"text"},{"text":" ","type":"text"},{"text":"piano pedal mark would be keyboardPedalPed, not U+E650.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlsmuflglyphname"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/Notehead-swift.struct/init(value:isFilled:hasParentheses:font:color:smufl:)":{"type":"topic","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Notehead-swift.struct\/init(value:isFilled:hasParentheses:font:color:smufl:)","u