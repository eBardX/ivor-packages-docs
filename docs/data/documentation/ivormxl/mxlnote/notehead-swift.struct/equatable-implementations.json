/Notehead-swift.struct":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Notehead","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"Notehead","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlnote\/notehead-swift.struct","role":"symbol","title":"MXLNote.Notehead","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Notehead-swift.struct","type":"topic","abstract":[{"text":"The notehead type indicates shapes other than the open and closed ovals associated with note durations.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNote"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLNote"}],"url":"\/documentation\/ivormxl\/mxlnote","role":"symbol","title":"MXLNote","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","type":"topic","abstract":[{"type":"text","text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for"},{"type":"text","text":" "},{"type":"text","text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation)."},{"type":"text","text":" "},{"type":"text","text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,"},{"type":"text","text":" "},{"type":"text","text":"but no tie elements. Having these two types of information available can make interchange easier, as some"},{"type":"text","text":" "},{"type":"text","text":"programs handle one type of information more readily than the other."}]}}}