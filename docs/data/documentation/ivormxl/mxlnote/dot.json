{"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote"]]},"sections":[],"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"text":"One dot element is used for each dot of prolongation. The placement attribute is used to specify whether the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"dot should appear above or below the staff line. It is ignored for notes that appear on a staff space."}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"dot"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"MXLEmptyPlacement","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEmptyPlacement","preciseIdentifier":"s:7IvorMXL17MXLEmptyPlacementV"},{"kind":"text","text":"]"}],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Maps to nested MusicXML "},{"code":"<dot>","type":"codeVoice"},{"text":" elements.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/dot"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlnote\/dot"]}],"metadata":{"title":"dot","modules":[{"name":"IvorMXL"}],"symbolKind":"property","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"dot"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"MXLEmptyPlacement","preciseIdentifier":"s:7IvorMXL17MXLEmptyPlacementV"},{"kind":"text","text":"]"}],"role":"symbol","externalID":"s:7IvorMXL7MXLNoteV3dotSayAA17MXLEmptyPlacementVGvp","roleHeading":"Instance Property"},"references":{"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"title":"MXLNote","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNote"}],"abstract":[{"type":"text","text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for"},{"type":"text","text":" "},{"type":"text","text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation)."},{"type":"text","text":" "},{"type":"text","text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,"},{"type":"text","text":" "},{"type":"text","text":"but no tie elements. Having these two types of information available can make interchange easier, as some"},{"type":"text","text":" "},{"type":"text","text":"programs handle one type of information more readily than the other."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLNote"}],"url":"\/documentation\/ivormxl\/mxlnote"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/dot":{"title":"dot","kind":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"dot"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:7IvorMXL17MXLEmptyPlacementV","kind":"typeIdentifier","text":"MXLEmptyPlacement"},{"kind":"text","text":"]"}],"abstract":[{"type":"text","text":"One dot element is used for each dot of prolongation. The placement attribute is used to specify whether the"},{"type":"text","text":" "},{"type":"text","text":"dot should appear above or below the staff line. It is ignored for notes that appear on a staff space."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/dot","role":"symbol","url":"\/documentation\/ivormxl\/mxlnote\/dot"},"doc://IvorMXL/documentation/IvorMXL/MXLEmptyPlacement":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLEmptyPlacement"}],"navigatorTitle":[{"kind":"identifier","text":"MXLEmptyPlacement"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEmptyPlacement","kind":"symbol","role":"symbol","title":"MXLEmptyPlacement","abstract":[{"text":"The empty-placement type represents an empty element with print-style and placement attributes.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlemptyplacement"}}}