{"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"title":"dot","role":"symbol","roleHeading":"Instance Property","externalID":"s:7IvorMXL7MXLNoteV3dotSayAA17MXLEmptyPlacementVGvp","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dot","kind":"identifier"},{"text":": [","kind":"text"},{"text":"MXLEmptyPlacement","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL17MXLEmptyPlacementV"},{"text":"]","kind":"text"}],"modules":[{"name":"IvorMXL"}],"symbolKind":"property"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote"]]},"kind":"symbol","primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dot","kind":"identifier"},{"text":": [","kind":"text"},{"text":"MXLEmptyPlacement","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL17MXLEmptyPlacementV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEmptyPlacement"},{"text":"]","kind":"text"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Maps to nested MusicXML "},{"type":"codeVoice","code":"<dot>"},{"type":"text","text":" elements."}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"text":"One dot element is used for each dot of prolongation. The placement attribute is used to specify whether the","type":"text"},{"text":" ","type":"text"},{"text":"dot should appear above or below the staff line. It is ignored for notes that appear on a staff space.","type":"text"}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/dot","interfaceLanguage":"swift"},"sections":[],"variants":[{"paths":["\/documentation\/ivormxl\/mxlnote\/dot"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLNote/dot":{"title":"dot","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"dot"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:7IvorMXL17MXLEmptyPlacementV","kind":"typeIdentifier","text":"MXLEmptyPlacement"},{"kind":"text","text":"]"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlnote\/dot","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/dot","abstract":[{"text":"One dot element is used for each dot of prolongation. The placement attribute is used to specify whether the","type":"text"},{"text":" ","type":"text"},{"text":"dot should appear above or below the staff line. It is ignored for notes that appear on a staff space.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"navigatorTitle":[{"kind":"identifier","text":"MXLNote"}],"abstract":[{"text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for","type":"text"},{"text":" ","type":"text"},{"text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation).","type":"text"},{"text":" ","type":"text"},{"text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,","type":"text"},{"text":" ","type":"text"},{"text":"but no tie elements. Having these two types of information available can make interchange easier, as some","type":"text"},{"text":" ","type":"text"},{"text":"programs handle one type of information more readily than the other.","type":"text"}],"title":"MXLNote","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","kind":"symbol","url":"\/documentation\/ivormxl\/mxlnote","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNote"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLEmptyPlacement":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEmptyPlacement","title":"MXLEm