{"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/dot","interfaceLanguage":"swift"},"sections":[],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote"]]},"abstract":[{"text":"One dot element is used for each dot of prolongation. The placement attribute is used to specify whether the","type":"text"},{"text":" ","type":"text"},{"text":"dot should appear above or below the staff line. It is ignored for notes that appear on a staff space.","type":"text"}],"metadata":{"symbolKind":"property","externalID":"s:7IvorMXL7MXLNoteV3dotSayAA17MXLEmptyPlacementVGvp","title":"dot","modules":[{"name":"IvorMXL"}],"role":"symbol","roleHeading":"Instance Property","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"dot"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"MXLEmptyPlacement","preciseIdentifier":"s:7IvorMXL17MXLEmptyPlacementV"},{"kind":"text","text":"]"}]},"schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlnote\/dot"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"dot"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:7IvorMXL17MXLEmptyPlacementV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEmptyPlacement","kind":"typeIdentifier","text":"MXLEmptyPlacement"},{"kind":"text","text":"]"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"Maps to nested MusicXML "},{"type":"codeVoice","code":"<dot>"},{"type":"text","text":" elements."}],"type":"paragraph"}]}],"kind":"symbol","references":{"doc://IvorMXL/documentation/IvorMXL/MXLEmptyPlacement":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlemptyplacement","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLEmptyPlacement"}],"navigatorTitle":[{"kind":"identifier","text":"MXLEmptyPlacement"}],"abstract":[{"type":"text","text":"The empty-placement type represents an empty element with print-style and placement attributes."}],"title":"MXLEmptyPlacement","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEmptyPlacement","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlnote","title":"MXLNote","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNote","kind":"identifier"}],"navigatorTitle":[{"text":"MXLNote","kind":"identifier"}],"abstract":[{"type":"text","text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for"},{"type":"text","text":" "},{"type":"text","text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation)."},{"type":"text","text":" "},{"type":"text","text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,"},{"type":"text","text":" "},{"text":"but no tie elements. Having these two types of information available can make interchange easier, as some","type":"text"},{"type":"text","text":" "},{"type":"text","text":"programs handle one type of information more readily than the other."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/dot":{"url":"\/documentation\/ivormxl\/mxlnote\/dot","role":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/dot","abstract":[{"type":"text","text":"One dot element is used for each dot of prolongation. The placement attribute is used to specify whether the"},{"type":"text","text":" "},{"type":"text","text":"dot should appear above or below the staff line. It is ignored for notes that appear on a staff space."}],"title":"dot","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dot","kind":"identifier"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:7IvorMXL17MXLEmptyPlacementV","text":"MXLEmptyPlacement","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"kind":"symbol"}}}