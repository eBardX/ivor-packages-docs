tract":[{"type":"text","text":"One dot element is used for each dot of prolongation. The placement attribute is used to specify whether the"},{"type":"text","text":" "},{"type":"text","text":"dot should appear above or below the staff line. It is ignored for notes that appear on a staff space."}],"url":"\/documentation\/ivormxl\/mxlnote\/dot","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dot","kind":"identifier"},{"text":": [","kind":"text"},{"text":"MXLEmptyPlacement","preciseIdentifier":"s:7IvorMXL17MXLEmptyPlacementV","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"title":"dot","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/dot"},"doc://IvorMXL/documentation/IvorMXL/MXLEmptyPlacement":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLEmptyPlacement","kind":"identifier"}],"navigatorTitle":[{"text":"MXLEmptyPlacement","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEmptyPlacement","abstract":[{"text":"The empty-placement type represents an empty element with print-style and placement attributes.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlemptyplacement","type":"topic","title":"MXLEmptyPlacement","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNote","kind":"identifier"}],"title":"MXLNote","abstract":[{"text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for","type":"text"},{"text":" ","type":"text"},{"text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation).","type":"text"},{"text":" ","type":"text"},{"text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,","type":"text"},{"text":" ","type":"text"},{"text":"but no tie elements. Having these two types of information available can make interchange easier, as some","type":"text"},{"text":" ","type":"text"},{"text":"programs handle one type of information more readily than the other.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","role":"symbol","url":"\/documentation\/ivormxl\/mxlnote","kind":"symbol","navigatorTitle":[{"text":"MXLNote","kind":"identifier"}],"type":"topic"}}}