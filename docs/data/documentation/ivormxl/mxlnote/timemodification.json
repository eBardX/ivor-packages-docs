{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/timeModification"},"variants":[{"paths":["\/documentation\/ivormxl\/mxlnote\/timemodification"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"timeModification"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL19MXLTimeModificationV","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTimeModification","text":"MXLTimeModification"},{"kind":"text","text":"?"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Maps to a nested MusicXML "},{"code":"<time-modification>","type":"codeVoice"},{"type":"text","text":" element."}]}],"kind":"content"}],"kind":"symbol","abstract":[{"type":"text","text":"The time modification (e.g. for tuplets) applied to this note, if any."}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote"]]},"metadata":{"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"timeModification"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL19MXLTimeModificationV","kind":"typeIdentifier","text":"MXLTimeModification"},{"kind":"text","text":"?"}],"roleHeading":"Instance Property","externalID":"s:7IvorMXL7MXLNoteV16timeModificationAA07MXLTimeE0VSgvp","modules":[{"name":"IvorMXL"}],"symbolKind":"property","title":"timeModification","role":"symbol"},"references":{"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLTimeModification":{"role":"symbol","url":"\/documentation\/ivormxl\/mxltimemodification","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTimeModification","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTimeModification"}],"abstract":[{"type":"text","text":"Time modification indicates tuplets, double-note tremolos, and other durational changes. A time-modification"},{"type":"text","text":" "},{"type":"text","text":"element shows how the cumulative, sounding effect of tuplets and double-note tremolos compare to the written"},{"type":"text","text":" "},{"type":"text","text":"note type represented by the type and dot elements. Nested tuplets and other notations that use more detailed"},{"type":"text","text":" "},{"type":"text","text":"information need both the time-modification and tuplet elements to be represented accurately."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLTimeModification"}],"title":"MXLTimeModification"},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"title":"MXLNote","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNote"}],"abstract":[{"type":"text","text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for"},{"type":"text","text":" "},{"type":"text","text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation)."},{"type":"text","text":" "},{"type":"text","text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,"},{"type":"text","text":" "},{"type":"text","text":"but no tie elements. Having these two types of information available can make interchange easier, as some"},{"type":"text","text":" "},{"type":"text","text":"programs handle one type of information more readily than the other."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLNote"}],"url":"\/documentation\/ivormxl\/mxlnote"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/timeModification":{"title":"timeModification","kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"timeModification","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLTimeModification","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL19MXLTimeModificationV"},{"text":"?","kind":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/timeModification","url":"\/documentation\/ivormxl\/mxlnote\/timemodification","type":"topic","abstract":[{"type":"text","text":"The time modification (e.g. for tuplets) applied to this note, if any."}],"role":"symbol"}}}