me-modification","type":"text"},{"text":" ","type":"text"},{"text":"element shows how the cumulative, sounding effect of tuplets and double-note tremolos compare to the written","type":"text"},{"text":" ","type":"text"},{"text":"note type represented by the type and dot elements. Nested tuplets and other notations that use more detailed","type":"text"},{"text":" ","type":"text"},{"text":"information need both the time-modification and tuplet elements to be represented accurately.","type":"text"}],"url":"\/documentation\/ivormxl\/mxltimemodification","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTimeModification"}],"kind":"symbol","title":"MXLTimeModification","navigatorTitle":[{"kind":"identifier","text":"MXLTimeModification"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTimeModification","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/timeModification":{"kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"The time modification (e.g. for tuplets) applied to this note, if any."}],"url":"\/documentation\/ivormxl\/mxlnote\/timemodification","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"timeModification","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLTimeModification","preciseIdentifier":"s:7IvorMXL19MXLTimeModificationV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"title":"timeModification","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/timeModification"},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNote","kind":"identifier"}],"title":"MXLNote","abstract":[{"text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for","type":"text"},{"text":" ","type":"text"},{"text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation).","type":"text"},{"text":" ","type":"text"},{"text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,","type":"text"},{"text":" ","type":"text"},{"text":"but no tie elements. Having these two types of information available can make interchange easier, as some","type":"text"},{"text":" ","type":"text"},{"text":"programs handle one type of information more readily than the other.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","role":"symbol","url":"\/documentation\/ivormxl\/mxlnote","kind":"symbol","navigatorTitle":[{"text":"MXLNote","kind":"identifier"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"}}}