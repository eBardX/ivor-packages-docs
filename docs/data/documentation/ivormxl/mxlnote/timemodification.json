{"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote"]]},"kind":"symbol","schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"type":"text","text":"The time modification (e.g. for tuplets) applied to this note, if any."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"timeModification"},{"kind":"text","text":": "},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTimeModification","kind":"typeIdentifier","text":"MXLTimeModification","preciseIdentifier":"s:7IvorMXL19MXLTimeModificationV"},{"kind":"text","text":"?"}],"platforms":["macOS"]}]},{"content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Maps to a nested MusicXML "},{"code":"<time-modification>","type":"codeVoice"},{"type":"text","text":" element."}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/ivormxl\/mxlnote\/timemodification"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/timeModification"},"metadata":{"roleHeading":"Instance Property","title":"timeModification","symbolKind":"property","externalID":"s:7IvorMXL7MXLNoteV16timeModificationAA07MXLTimeE0VSgvp","modules":[{"name":"IvorMXL"}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"timeModification"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLTimeModification","preciseIdentifier":"s:7IvorMXL19MXLTimeModificationV"},{"kind":"text","text":"?"}],"role":"symbol"},"references":{"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"navigatorTitle":[{"kind":"identifier","text":"MXLNote"}],"abstract":[{"text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for","type":"text"},{"text":" ","type":"text"},{"text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation).","type":"text"},{"text":" ","type":"text"},{"text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,","type":"text"},{"text":" ","type":"text"},{"text":"but no tie elements. Having these two types of information available can make interchange easier, as some","type":"text"},{"text":" ","type":"text"},{"text":"programs handle one type of information more readily than the other.","type":"text"}],"title":"MXLNote","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","kind":"symbol","url":"\/documentation\/ivormxl\/mxlnote","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNote"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/timeModification":{"url":"\/documentation\/ivormxl\/mxlnote\/timemodification","abstract":[{"type":"text","text":"The time modification (e.g. for tuplets) applied to this note, if any."}],"kind":"symbol","title":"timeModification","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/timeModification","type":"topic","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"timeModification"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLTimeModification","preciseIdentifier":"s:7IvorMXL19MXLTimeModificationV"},{"kind":"text","text":"?"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLTimeModification":{"abstract":[{"text":"Time modification indicates tuplets, double-note tremolos, and other durational changes. A time-modification","type":"text"},{"text":" ","type":"text"},{"text":"element shows how the cumulative, sounding effect of tuplets and double-note tremolos compare to the written","type":"text"},{"text":" ","type":"text"},{"text":"note type represented by the type and dot elements. Nested tuplets and other notations that use more detailed","type":"text"},{"type":"text","text":" "},{"type":"text","text":"information need both the time-modification and tuplet elements to be represented accurately."}],"title":"MXLTimeModification","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTimeModification"}],"navigatorTitle":[{"kind":"identifier","text":"MXLTimeModification"}],"type":"topic","url":"\/documentation\/ivormxl\/mxltimemodification","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTimeModification"}}}