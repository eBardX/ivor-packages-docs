{"kind":"symbol","abstract":[{"type":"text","text":"Alters the starting time of the note from when it would otherwise occur, expressed in divisions. A note that"},{"text":" ","type":"text"},{"text":"stops a tie should not have an attack attribute.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"attack"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLDivisions","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDivisions","preciseIdentifier":"s:7IvorMXL12MXLDivisionsV"},{"kind":"text","text":"?"}],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"Maps to the MusicXML "},{"type":"codeVoice","code":"attack"},{"type":"text","text":" attribute."}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote"]]},"metadata":{"modules":[{"name":"IvorMXL"}],"roleHeading":"Instance Property","externalID":"s:7IvorMXL7MXLNoteV6attackAA12MXLDivisionsVSgvp","title":"attack","symbolKind":"property","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"attack"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL12MXLDivisionsV","text":"MXLDivisions"},{"kind":"text","text":"?"}]},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/attack","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/ivormxl\/mxlnote\/attack"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlnote","title":"MXLNote","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNote","kind":"identifier"}],"navigatorTitle":[{"text":"MXLNote","kind":"identifier"}],"abstract":[{"type":"text","text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for"},{"type":"text","text":" "},{"type":"text","text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation)."},{"type":"text","text":" "},{"type":"text","text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,"},{"type":"text","text":" "},{"text":"but no tie elements. Having these two types of information available can make interchange easier, as some","type":"text"},{"type":"text","text":" "},{"type":"text","text":"programs handle one type of information more readily than the other."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote"},"doc://IvorMXL/documentation/IvorMXL/MXLDivisions":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDivisions","role":"symbol","navigatorTitle":[{"text":"MXLDivisions","kind":"identifier"}],"type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLDivisions","kind":"identifier"}],"abstract":[{"type":"text","text":"The divisions type is used to express values in terms of the musical divisions defined by the divisions"},{"type":"text","text":" "},{"type":"text","text":"element. It is preferred that these be integer values both for MIDI interoperability and to avoid roundoff"},{"type":"text","text":" "},{"type":"text","text":"errors."}],"url":"\/documentation\/ivormxl\/mxldivisions","title":"MXLDivisions"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote/attack":{"url":"\/documentation\/ivormxl\/mxlnote\/attack","role":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/attack","abstract":[{"type":"text","text":"Alters the starting time of the note from when it would otherwise occur, expressed in divisions. A note that"},{"type":"text","text":" "},{"type":"text","text":"stops a tie should not have an attack attribute."}],"title":"attack","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"attack","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL12MXLDivisionsV","text":"MXLDivisions","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"kind":"symbol"}}}