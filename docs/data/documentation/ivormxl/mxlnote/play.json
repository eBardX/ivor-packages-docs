{"kind":"symbol","hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote"]]},"variants":[{"paths":["\/documentation\/ivormxl\/mxlnote\/play"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/play"},"metadata":{"title":"play","modules":[{"name":"IvorMXL"}],"role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"play","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL7MXLPlayV","text":"MXLPlay","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"roleHeading":"Instance Property","symbolKind":"property","externalID":"s:7IvorMXL7MXLNoteV4playAA7MXLPlayVSgvp"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"play","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL7MXLPlayV","text":"MXLPlay","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPlay"},{"text":"?","kind":"text"}]}]},{"content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Maps to a nested MusicXML "},{"code":"<play>","type":"codeVoice"},{"type":"text","text":" element."}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"type":"text","text":"Playback information associated with this note, if any."}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"title":"MXLNote","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNote"}],"abstract":[{"type":"text","text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for"},{"type":"text","text":" "},{"type":"text","text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation)."},{"type":"text","text":" "},{"type":"text","text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,"},{"type":"text","text":" "},{"type":"text","text":"but no tie elements. Having these two types of information available can make interchange easier, as some"},{"type":"text","text":" "},{"type":"text","text":"programs handle one type of information more readily than the other."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLNote"}],"url":"\/documentation\/ivormxl\/mxlnote"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/play":{"title":"play","kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"play","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLPlay","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL7MXLPlayV"},{"text":"?","kind":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/play","url":"\/documentation\/ivormxl\/mxlnote\/play","type":"topic","abstract":[{"type":"text","text":"Playback information associated with this note, if any."}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLPlay":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlplay","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPlay","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPlay"}],"kind":"symbol","abstract":[{"type":"text","text":"The play type specifies playback techniques to be used in conjunction with the instrument-sound element. When"},{"type":"text","text":" "},{"type":"text","text":"used as part of a sound element, it applies to all notes going forward in score order. In multi-instrument"},{"type":"text","text":" "},{"type":"text","text":"parts, the affected instrument should be specified using the id attribute. When used as part of a note"},{"type":"text","text":" "},{"type":"text","text":"element, it applies to the current note only."}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLPlay"}],"title":"MXLPlay"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"}}}