{"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/play"},"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlnote\/play"]}],"kind":"symbol","sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"play","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL7MXLPlayV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPlay","text":"MXLPlay","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Maps to a nested MusicXML "},{"code":"<play>","type":"codeVoice"},{"type":"text","text":" element."}]}]}],"metadata":{"modules":[{"name":"IvorMXL"}],"symbolKind":"property","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"play","kind":"identifier"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLPlay","preciseIdentifier":"s:7IvorMXL7MXLPlayV"},{"text":"?","kind":"text"}],"title":"play","roleHeading":"Instance Property","externalID":"s:7IvorMXL7MXLNoteV4playAA7MXLPlayVSgvp"},"abstract":[{"type":"text","text":"Playback information associated with this note, if any."}],"references":{"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLPlay":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPlay","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPlay","title":"MXLPlay","kind":"symbol","navigatorTitle":[{"text":"MXLPlay","kind":"identifier"}],"abstract":[{"text":"The play type specifies playback techniques to be used in conjunction with the instrument-sound element. When","type":"text"},{"type":"text","text":" "},{"text":"used as part of a sound element, it applies to all notes going forward in score order. In multi-instrument","type":"text"},{"type":"text","text":" "},{"type":"text","text":"parts, the affected instrument should be specified using the id attribute. When used as part of a note"},{"type":"text","text":" "},{"type":"text","text":"element, it applies to the current note only."}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlplay"},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNote"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLNote"}],"url":"\/documentation\/ivormxl\/mxlnote","role":"symbol","title":"MXLNote","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","type":"topic","abstract":[{"type":"text","text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for"},{"type":"text","text":" "},{"type":"text","text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation)."},{"type":"text","text":" "},{"type":"text","text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,"},{"type":"text","text":" "},{"type":"text","text":"but no tie elements. Having these two types of information available can make interchange easier, as some"},{"type":"text","text":" "},{"type":"text","text":"programs handle one type of information more readily than the other."}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote/play":{"url":"\/documentation\/ivormxl\/mxlnote\/play","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"play"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLPlay","preciseIdentifier":"s:7IvorMXL7MXLPlayV"},{"kind":"text","text":"?"}],"title":"play","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/play","role":"symbol","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Playback information associated with this note, if any."}]}}}