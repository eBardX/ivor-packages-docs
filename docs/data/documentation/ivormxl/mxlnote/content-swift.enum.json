{"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"text":"One of the alternatives for Note.","type":"text"}],"topicSections":[{"generated":true,"title":"Enumeration Cases","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Content-swift.enum\/graceNote(fullNote:grace:tie:)","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Content-swift.enum\/graceNoteCue(fullNote:grace:)","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Content-swift.enum\/regularNote(fullNote:duration:tie:)","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Content-swift.enum\/regularNoteCue(fullNote:duration:)"],"anchor":"Enumeration-Cases"},{"generated":true,"title":"Default Implementations","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Content-swift.enum\/Equatable-Implementations"],"anchor":"Default-Implementations"}],"metadata":{"modules":[{"name":"IvorMXL"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Content","kind":"identifier"}],"externalID":"s:7IvorMXL7MXLNoteV7ContentO","symbolKind":"enum","role":"symbol","roleHeading":"Enumeration","navigatorTitle":[{"text":"Content","kind":"identifier"}],"title":"MXLNote.Content","extendedModule":"IvorMXL"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlnote\/content-swift.enum"]}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Content-swift.enum","interfaceLanguage":"swift"},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Content"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Overview","level":2,"type":"heading","anchor":"overview"},{"inlineContent":[{"text":"MusicXML distinguishes sound information from notation information: grace notes carry no duration, since","type":"text"},{"text":" ","type":"text"},{"text":"they have no defined sounding length, while cue notes do carry a duration, since — despite being silent for","type":"text"},{"text":" ","type":"text"},{"text":"playback — they still occupy a definite amount of time in the measure. The ","type":"text"},{"code":"cue","type":"codeVoice"},{"text":" marker and the presence of","type":"text"},{"text":" ","type":"text"},{"code":"duration","type":"codeVoice"},{"text":" are therefore independent: a grace note stays undurated even when it is also marked ","type":"text"},{"code":"cue","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote"]]},"relationshipsSections":[{"kind":"relationships","type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/IvorMXL\/s8CopyableP","doc:\/\/IvorMXL\/SQ","doc:\/\/IvorMXL\/s9EscapableP","doc:\/\/IvorMXL\/SH","doc:\/\/IvorMXL\/s8SendableP","doc:\/\/IvorMXL\/s16SendableMetatypeP"]}],"references":{"doc://IvorMXL/s8CopyableP":{"type":"unresolvable","title":"Swift.Copyable","identifier":"doc:\/\/IvorMXL\/s8CopyableP"},"doc://IvorMXL/s16SendableMetatypeP":{"type":"unresolvable","title":"Swift.SendableMetatype","identifier":"doc:\/\/IvorMXL\/s16SendableMetatypeP"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/Content-swift.enum":{"title":"MXLNote.Content","kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Content","kind":"identifier"}],"navigatorTitle":[{"text":"Content","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Content-swift.enum","url":"\/documentation\/ivormxl\/mxlnote\/content-swift.enum","type":"topic","abstract":[{"text":"One of the alternatives for Note.","type":"text"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"title":"MXLNote","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNote"}],"abstract":[{"type":"text","text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for"},{"type":"text","text":" "},{"type":"text","text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation)."},{"type":"text","text":" "},{"type":"text","text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,"},{"type":"text","text":" "},{"type":"text","text":"but no tie elements. Having these two types of information available can make interchange easier, as some"},{"type":"text","text":" "},{"type":"text","text":"programs handle one type of information more readily than the other."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLNote"}],"url":"\/documentation\/ivormxl\/mxlnote"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/Content-swift.enum/graceNoteCue(fullNote:grace:)":{"type":"topic","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"graceNoteCue"},{"kind":"text","text":"("},{"kind":"externalParam","text":"fullNote"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLFullNoteV","text":"MXLFullNote"},{"kind":"text","text":", "},{"kind":"externalParam","text":"grace"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLGraceV","text":"MXLGrace"},{"kind":"text","text":")"}],"abstract":[{"text":"A grace note that is also cue-sized\/silent-for-playback. Like all grace notes, it has no duration.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Content-swift.enum\/graceNoteCue(fullNote:grace:)","role":"symbol","kind":"symbol","title":"MXLNote.Content.graceNoteCue(fullNote:grace:)","url":"\/documentation\/ivormxl\/mxlnote\/content-swift.enum\/gra