ice","code":"MXLNote.NoteheadText"},{"type":"text","text":"."}],"title":"init(items:)","kind":"symbol","role":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"items"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL7MXLNoteV12NoteheadTextV4ItemO","text":"Item"},{"kind":"text","text":"])"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlnote\/noteheadtext-swift.struct\/init(items:)","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/NoteheadText-swift.struct\/init(items:)"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/NoteheadText-swift.struct":{"abstract":[{"text":"The notehead-text type represents text that is displayed inside a notehead, as is done in some educational","type":"text"},{"text":" ","type":"text"},{"text":"music. It is not needed for the numbers used in tablature or jianpu notation. The presence of a TAB or jianpu","type":"text"},{"text":" ","type":"text"},{"text":"clefs is sufficient to indicate that numbers are used. The display-text and accidental-text elements allow","type":"text"},{"text":" ","type":"text"},{"text":"display of fully formatted text and accidentals.","type":"text"}],"title":"MXLNote.NoteheadText","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"NoteheadText"}],"navigatorTitle":[{"kind":"identifier","text":"NoteheadText"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlnote\/noteheadtext-swift.struct","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/NoteheadText-swift.struct"},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"navigatorTitle":[{"kind":"identifier","text":"MXLNote"}],"abstract":[{"text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for","type":"text"},{"text":" ","type":"text"},{"text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation).","type":"text"},{"text":" ","type":"text"},{"text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,","type":"text"},{"text":" ","type":"text"},{"text":"but no tie elements. Having these two types of information available can make interchange easier, as some","type":"text"},{"text":" ","type":"text"},{"text":"programs handle one type of information more readily than the other.","type":"text"}],"title":"MXLNote","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","kind":"symbol","url":"\/documentation\/ivormxl\/mxlnote","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNote"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/NoteheadText-swift.struct/Item":{"abstract":[{"text":"One of the alternatives for NoteheadText.","type":"text"}],"title":"MXLNote.NoteheadText.Item","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Item"}],"navigatorTitle":[{"kind":"identifier","text":"Item"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlnote\/noteheadtext-swift.struct\/item","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/NoteheadText-swift.struct\/Item"},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"}}}