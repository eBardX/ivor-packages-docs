{"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"items"},{"kind":"text","text":": ["},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/NoteheadText-swift.struct\/Item","kind":"typeIdentifier","text":"Item","preciseIdentifier":"s:7IvorMXL7MXLNoteV12NoteheadTextV4ItemO"},{"kind":"text","text":"]"}]}]}],"abstract":[{"text":"One of the alternatives for NoteheadText.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/NoteheadText-swift.struct"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/NoteheadText-swift.struct\/items"},"metadata":{"roleHeading":"Instance Property","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"items"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"Item","preciseIdentifier":"s:7IvorMXL7MXLNoteV12NoteheadTextV4ItemO"},{"kind":"text","text":"]"}],"modules":[{"name":"IvorMXL"}],"externalID":"s:7IvorMXL7MXLNoteV12NoteheadTextV5itemsSayAE4ItemOGvp","role":"symbol","symbolKind":"property","title":"items"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlnote\/noteheadtext-swift.struct\/items"]}],"sections":[],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLNote/NoteheadText-swift.struct/Item":{"role":"symbol","kind":"symbol","title":"MXLNote.NoteheadText.Item","abstract":[{"type":"text","text":"One of the alternatives for NoteheadText."}],"url":"\/documentation\/ivormxl\/mxlnote\/noteheadtext-swift.struct\/item","type":"topic","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Item"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/NoteheadText-swift.struct\/Item","navigatorTitle":[{"kind":"identifier","text":"Item"}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote/NoteheadText-swift.struct/items":{"role":"symbol","kind":"symbol","title":"items","abstract":[{"type":"text","text":"One of the alternatives for NoteheadText."}],"url":"\/documentation\/ivormxl\/mxlnote\/noteheadtext-swift.struct\/items","type":"topic","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"items"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:7IvorMXL7MXLNoteV12NoteheadTextV4ItemO","kind":"typeIdentifier","text":"Item"},{"kind":"text","text":"]"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/NoteheadText-swift.struct\/items"},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNote"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLNote"}],"url":"\/documentation\/ivormxl\/mxlnote","role":"symbol","title":"MXLNote","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","type":"topic","abstract":[{"type":"text","text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for"},{"type":"text","text":" "},{"type":"text","text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation)."},{"type":"text","text":" "},{"type":"text","text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,"},{"type":"text","text":" "},{"type":"text","text":"but no tie elements. Having these two types of information available can make interchange easier, as some"},{"type":"text","text":" "},{"type":"text","text":"programs handle one type of information more readily than the other."}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/NoteheadText-swift.struct":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"NoteheadText"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NoteheadText"}],"url":"\/documentation\/ivormxl\/mxlnote\/noteheadtext-swift.struct","role":"symbol","title":"MXLNote.NoteheadText","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/NoteheadText-swift.struct","type":"topic","abstract":[{"type":"text","text":"The notehead-text type represents text that is displayed inside a notehead, as is done in some educational"},{"type":"text","text":" "},{"type":"text","text":"music. It is not needed for the numbers used in tablature or jianpu notation. The presence of a TAB or jianpu"},{"type":"text","text":" "},{"type":"text","text":"clefs is sufficient to indicate that numbers are used. The display-text and accidental-text elements allow"},{"type":"text","text":" "},{"type":"text","text":"display of fully formatted text and accidentals."}]}}}