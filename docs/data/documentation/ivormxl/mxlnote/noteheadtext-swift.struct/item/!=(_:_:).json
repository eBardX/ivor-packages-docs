ge":"swift"}]}],"abstract":[{"type":"text","text":"Inherited from "},{"code":"Equatable.!=(_:_:)","type":"codeVoice"},{"type":"text","text":"."}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLNote/NoteheadText-swift.struct/Item":{"role":"symbol","kind":"symbol","title":"MXLNote.NoteheadText.Item","abstract":[{"type":"text","text":"One of the alternatives for NoteheadText."}],"url":"\/documentation\/ivormxl\/mxlnote\/noteheadtext-swift.struct\/item","type":"topic","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Item"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/NoteheadText-swift.struct\/Item","navigatorTitle":[{"kind":"identifier","text":"Item"}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNote"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLNote"}],"url":"\/documentation\/ivormxl\/mxlnote","role":"symbol","title":"MXLNote","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","type":"topic","abstract":[{"type":"text","text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for"},{"type":"text","text":" "},{"type":"text","text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation)."},{"type":"text","text":" "},{"type":"text","text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,"},{"type":"text","text":" "},{"type":"text","text":"but no tie elements. Having these two types of information available can make interchange easier, as some"},{"type":"text","text":" "},{"type":"text","text":"programs handle one type of information more readily than the other."}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote/NoteheadText-swift.struct/Item/!=(_:_:)":{"title":"!=(_:_:)","url":"\/documentation\/ivormxl\/mxlnote\/noteheadtext-swift.struct\/item\/!=(_:_:)","role":"symbol","abstract":[],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/NoteheadText-swift.struct\/Item\/!=(_:_:)","kind":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"!=","kind":"identifier"},{"text":" ","kind":"text"},{"text":"(","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/NoteheadText-swift.struct":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"NoteheadText"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NoteheadText"}],"url":"\/documentation\/ivormxl\/mxlnote\/noteheadtext-swift.struct","role":"symbol","title":"MXLNote.NoteheadText","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/NoteheadText-swift.struct","type":"topic","abstract":[{"type":"text","text":"The notehead-text type represents text that is displayed inside a notehead, as is done in some educational"},{"type":"text","text":" "},{"type":"text","text":"music. It is not needed for the numbers used in tablature or jianpu notation. The presence of a TAB or jianpu"},{"type":"text","text":" "},{"type":"text","text":"clefs is sufficient to indicate that numbers are used. The display-text and accidental-text elements allow"},{"type":"text","text":" "},{"type":"text","text":"display of fully formatted text and accidentals."}]}}}