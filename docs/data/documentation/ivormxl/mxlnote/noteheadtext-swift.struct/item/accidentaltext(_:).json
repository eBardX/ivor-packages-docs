ext":" ","kind":"text"},{"text":"MXLNote","kind":"identifier"}],"navigatorTitle":[{"text":"MXLNote","kind":"identifier"}],"abstract":[{"type":"text","text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for"},{"type":"text","text":" "},{"type":"text","text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation)."},{"type":"text","text":" "},{"type":"text","text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,"},{"type":"text","text":" "},{"text":"but no tie elements. Having these two types of information available can make interchange easier, as some","type":"text"},{"type":"text","text":" "},{"type":"text","text":"programs handle one type of information more readily than the other."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/NoteheadText-swift.struct/Item/accidentalText(_:)":{"title":"MXLNote.NoteheadText.Item.accidentalText(_:)","abstract":[{"text":"The ","type":"text"},{"code":"accidental-text","type":"codeVoice"},{"text":" alternative.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlnote\/noteheadtext-swift.struct\/item\/accidentaltext(_:)","role":"symbol","type":"topic","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/NoteheadText-swift.struct\/Item\/accidentalText(_:)","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"accidentalText","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:7IvorMXL17MXLAccidentalTextV","text":"MXLAccidentalText","kind":"typeIdentifier"},{"text":")","kind":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote/NoteheadText-swift.struct":{"url":"\/documentation\/ivormxl\/mxlnote\/noteheadtext-swift.struct","role":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/NoteheadText-swift.struct","abstract":[{"type":"text","text":"The notehead-text type represents text that is displayed inside a notehead, as is done in some educational"},{"type":"text","text":" "},{"type":"text","text":"music. It is not needed for the numbers used in tablature or jianpu notation. The presence of a TAB or jianpu"},{"type":"text","text":" "},{"type":"text","text":"clefs is sufficient to indicate that numbers are used. The display-text and accidental-text elements allow"},{"type":"text","text":" "},{"type":"text","text":"display of fully formatted text and accidentals."}],"title":"MXLNote.NoteheadText","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NoteheadText","kind":"identifier"}],"navigatorTitle":[{"text":"NoteheadText","kind":"identifier"}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/NoteheadText-swift.struct/Item":{"title":"MXLNote.NoteheadText.Item","abstract":[{"text":"One of the alternatives for NoteheadText.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlnote\/noteheadtext-swift.struct\/item","role":"symbol","type":"topic","kind":"symbol","navigatorTitle":[{"text":"Item","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/NoteheadText-swift.struct\/Item","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Item","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLAccidentalText":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidentalText","title":"MXLAccidentalText","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLAccidentalText"}],"abstract":[{"type":"text","text":"The accidental-text type represents an element with an accidental value and text-formatting attributes."}],"url":"\/documentation\/ivormxl\/mxlaccidentaltext","kind":"symbol","type":"topic","navigatorTitle":[{"text":"MXLAccidentalText","kind":"identifier"}]}}}