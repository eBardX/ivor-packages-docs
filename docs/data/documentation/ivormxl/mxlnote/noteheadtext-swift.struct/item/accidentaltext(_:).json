{"abstract":[{"type":"text","text":"The "},{"type":"codeVoice","code":"accidental-text"},{"type":"text","text":" alternative."}],"metadata":{"modules":[{"name":"IvorMXL"}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"accidentalText"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"MXLAccidentalText","preciseIdentifier":"s:7IvorMXL17MXLAccidentalTextV"},{"text":")","kind":"text"}],"roleHeading":"Case","symbolKind":"case","role":"symbol","title":"MXLNote.NoteheadText.Item.accidentalText(_:)","externalID":"s:7IvorMXL7MXLNoteV12NoteheadTextV4ItemO010accidentalE0yAgA013MXLAccidentalE0VcAGmF"},"variants":[{"paths":["\/documentation\/ivormxl\/mxlnote\/noteheadtext-swift.struct\/item\/accidentaltext(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"accidentalText"},{"kind":"text","text":"("},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidentalText","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL17MXLAccidentalTextV","text":"MXLAccidentalText"},{"kind":"text","text":")"}],"languages":["swift"]}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/NoteheadText-swift.struct","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/NoteheadText-swift.struct\/Item"]]},"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/NoteheadText-swift.struct\/Item\/accidentalText(_:)","interfaceLanguage":"swift"},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"title":"MXLNote","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNote"}],"abstract":[{"type":"text","text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for"},{"type":"text","text":" "},{"type":"text","text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation)."},{"type":"text","text":" "},{"type":"text","text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,"},{"type":"text","text":" "},{"type":"text","text":"but no tie elements. Having these two types of information available can make interchange easier, as some"},{"type":"text","text":" "},{"type":"text","text":"programs handle one type of information more readily than the other."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLNote"}],"url":"\/documentation\/ivormxl\/mxlnote"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/NoteheadText-swift.struct/Item":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlnote\/noteheadtext-swift.struct\/item","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/NoteheadText-swift.struct\/Item","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Item"}],"kind":"symbol","abstract":[{"type":"text","text":"One of the alternatives for NoteheadText."}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"Item"}],"title":"MXLNote.NoteheadText.Item"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/NoteheadText-swift.struct":{"title":"MXLNote.NoteheadText","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NoteheadText","kind":"identifier"}],"navigatorTitle":[{"text":"NoteheadText","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/NoteheadText-swift.struct","url":"\/documentation\/ivormxl\/mxlnote\/noteheadtext-swift.struct","type":"topic","abstract":[{"type":"text","text":"The notehead-text type represents text that is displayed inside a notehead, as is done in some educational"},{"type":"text","text":" "},{"type":"text","text":"music. It is not needed for the numbers used in tablature or jianpu notation. The presence of a TAB or jianpu"},{"type":"text","text":" "},{"type":"text","text":"clefs is sufficient to indicate that numbers are used. The display-text and accidental-text elements allow"},{"type":"text","text":" "},{"type":"text","text":"display of fully formatted text and accidentals."}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLAccidentalText":{"title":"MXLAccidentalText","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLAccidentalText","kind":"identifier"}],"abstract":[{"text":"The accidental-text type represents an element with an accidental value and text-formatting attributes.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidentalText","role":"symbol","navigatorTitle":[{"text":"MXLAccidentalText","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlaccidentaltext"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/NoteheadText-swift.struct/Item/accidentalText(_:)":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/NoteheadText-swift.struct\/Item\/accidentalText(_:)","kind":"symbol","abstract":[{"type":"text","text":"The "},{"type":"codeVoice","code":"accidental-text"},{"type":"text","text":" alternative."}],"role":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxlnote\/noteheadtext-swift.struct\/item\/accidentaltext(_:)","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"accidentalText","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:7IvorMXL17MXLAccidentalTextV","text":"MXLAccidentalText","kind":"typeIdentifier"},{"text":")","kind":"text"}],"title":"MXLNote.NoteheadText.Item.accidentalText(