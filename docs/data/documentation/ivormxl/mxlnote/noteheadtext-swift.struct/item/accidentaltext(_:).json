{"sections":[],"abstract":[{"text":"The ","type":"text"},{"code":"accidental-text","type":"codeVoice"},{"text":" alternative.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlnote\/noteheadtext-swift.struct\/item\/accidentaltext(_:)"]}],"metadata":{"symbolKind":"case","title":"MXLNote.NoteheadText.Item.accidentalText(_:)","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"accidentalText"},{"kind":"text","text":"("},{"preciseIdentifier":"s:7IvorMXL17MXLAccidentalTextV","kind":"typeIdentifier","text":"MXLAccidentalText"},{"kind":"text","text":")"}],"role":"symbol","roleHeading":"Case","modules":[{"name":"IvorMXL"}],"externalID":"s:7IvorMXL7MXLNoteV12NoteheadTextV4ItemO010accidentalE0yAgA013MXLAccidentalE0VcAGmF"},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"accidentalText"},{"kind":"text","text":"("},{"preciseIdentifier":"s:7IvorMXL17MXLAccidentalTextV","kind":"typeIdentifier","text":"MXLAccidentalText","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidentalText"},{"kind":"text","text":")"}],"languages":["swift"]}],"kind":"declarations"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/NoteheadText-swift.struct\/Item\/accidentalText(_:)","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/NoteheadText-swift.struct","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/NoteheadText-swift.struct\/Item"]]},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"navigatorTitle":[{"kind":"identifier","text":"MXLNote"}],"abstract":[{"text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for","type":"text"},{"text":" ","type":"text"},{"text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation).","type":"text"},{"text":" ","type":"text"},{"text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,","type":"text"},{"text":" ","type":"text"},{"text":"but no tie elements. Having these two types of information available can make interchange easier, as some","type":"text"},{"text":" ","type":"text"},{"text":"programs handle one type of information more readily than the other.","type":"text"}],"title":"MXLNote","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","kind":"symbol","url":"\/documentation\/ivormxl\/mxlnote","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNote"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/NoteheadText-swift.struct":{"abstract":[{"text":"The notehead-text type represents text that is displayed inside a notehead, as is done in some educational","type":"text"},{"text":" ","type":"text"},{"text":"music. It is not needed for the numbers used in tablature or jianpu notation. The presence of a TAB or jianpu","type":"text"},{"text":" ","type":"text"},{"text":"clefs is sufficient to indicate that numbers are used. The display-text and accidental-text elements allow","type":"text"},{"text":" ","type":"text"},{"text":"display of fully formatted text and accidentals.","type":"text"}],"title":"MXLNote.NoteheadText","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"NoteheadText"}],"navigatorTitle":[{"kind":"identifier","text":"NoteheadText"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlnote\/noteheadtext-swift.struct","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/NoteheadText-sw