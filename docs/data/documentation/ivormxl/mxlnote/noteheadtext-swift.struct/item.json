ntifier":"s:7IvorMXL16MXLFormattedTextV","text":"MXLFormattedText"},{"kind":"text","text":")"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/NoteheadText-swift.struct\/Item\/displayText(_:)","title":"MXLNote.NoteheadText.Item.displayText(_:)"},"doc://IvorMXL/SH":{"identifier":"doc:\/\/IvorMXL\/SH","title":"Swift.Hashable","type":"unresolvable"},"doc://IvorMXL/s8SendableP":{"identifier":"doc:\/\/IvorMXL\/s8SendableP","title":"Swift.Sendable","type":"unresolvable"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlnote","title":"MXLNote","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNote","kind":"identifier"}],"navigatorTitle":[{"text":"MXLNote","kind":"identifier"}],"abstract":[{"type":"text","text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for"},{"type":"text","text":" "},{"type":"text","text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation)."},{"type":"text","text":" "},{"type":"text","text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,"},{"type":"text","text":" "},{"text":"but no tie elements. Having these two types of information available can make interchange easier, as some","type":"text"},{"type":"text","text":" "},{"type":"text","text":"programs handle one type of information more readily than the other."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote"}}}