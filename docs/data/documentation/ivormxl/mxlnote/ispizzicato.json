t":" "},{"type":"text","text":"which changes overall playback between pizzicato and arco."}],"url":"\/documentation\/ivormxl\/mxlnote\/ispizzicato","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isPizzicato","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"title":"isPizzicato","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/isPizzicato"},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNote","kind":"identifier"}],"title":"MXLNote","abstract":[{"text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for","type":"text"},{"text":" ","type":"text"},{"text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation).","type":"text"},{"text":" ","type":"text"},{"text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,","type":"text"},{"text":" ","type":"text"},{"text":"but no tie elements. Having these two types of information available can make interchange easier, as some","type":"text"},{"text":" ","type":"text"},{"text":"programs handle one type of information more readily than the other.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","role":"symbol","url":"\/documentation\/ivormxl\/mxlnote","kind":"symbol","navigatorTitle":[{"text":"MXLNote","kind":"identifier"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"}}}