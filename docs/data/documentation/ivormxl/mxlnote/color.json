{"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote"]]},"sections":[],"abstract":[{"type":"text","text":"The color attribute group indicates the color of an element."}],"metadata":{"modules":[{"name":"IvorMXL"}],"title":"color","roleHeading":"Instance Property","role":"symbol","externalID":"s:7IvorMXL7MXLNoteV5colorAA8MXLColorVSgvp","symbolKind":"property","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"color"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLColorV","text":"MXLColor"},{"kind":"text","text":"?"}]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"color"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL8MXLColorV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","kind":"typeIdentifier","text":"MXLColor"},{"kind":"text","text":"?"}],"platforms":["macOS"],"languages":["swift"]}]}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/color","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/ivormxl\/mxlnote\/color"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","references":{"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNote","kind":"identifier"}],"title":"MXLNote","abstract":[{"text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for","type":"text"},{"text":" ","type":"text"},{"text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation).","type":"text"},{"text":" ","type":"text"},{"text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,","type":"text"},{"text":" ","type":"text"},{"text":"but no tie elements. Having these two types of information available can make interchange easier, as some","type":"text"},{"text":" ","type":"text"},{"text":"programs handle one type of information more readily than the other.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","role":"symbol","url":"\/documentation\/ivormxl\/mxlnote","kind":"symbol","navigatorTitle":[{"text":"MXLNote","kind":"identifier"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/color":{"abstract":[{"text":"The color attribute group indicates the color of an element.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/color","title":"color","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"color"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL8MXLColorV","kind":"typeIdentifier","text":"MXLColor"},{"kind":"text","text":"?"}],"url":"\/documentation\/ivormxl\/mxlnote\/color","type":"topic"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"type":"topic","abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"type":"text","text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is"},{"type":"text","text":" "},{"type":"text","text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF."}],"url":"\/documentation\/ivormxl\/mxlcolor","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"kind":"symbol","title":"MXLColor","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","role":"symbol"}}}