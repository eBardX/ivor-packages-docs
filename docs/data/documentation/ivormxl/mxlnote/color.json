t","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLColorV","text":"MXLColor"},{"kind":"text","text":"?"}],"title":"color","abstract":[{"type":"text","text":"The color attribute group indicates the color of an element."}],"type":"topic","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"navigatorTitle":[{"kind":"identifier","text":"MXLNote"}],"abstract":[{"text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for","type":"text"},{"text":" ","type":"text"},{"text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation).","type":"text"},{"text":" ","type":"text"},{"text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,","type":"text"},{"text":" ","type":"text"},{"text":"but no tie elements. Having these two types of information available can make interchange easier, as some","type":"text"},{"text":" ","type":"text"},{"text":"programs handle one type of information more readily than the other.","type":"text"}],"title":"MXLNote","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","kind":"symbol","url":"\/documentation\/ivormxl\/mxlnote","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNote"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"abstract":[{"text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in","type":"text"},{"type":"text","text":" "},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"title":"MXLColor","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlcolor","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor"}}}