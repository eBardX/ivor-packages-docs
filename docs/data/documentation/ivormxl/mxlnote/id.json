{"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote"]]},"metadata":{"modules":[{"name":"IvorMXL"}],"externalID":"s:7IvorMXL7MXLNoteV2idSSSgvp","title":"id","fragments":[{"kind":"keyword","text":"let"},{"text":" ","kind":"text"},{"kind":"identifier","text":"id"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"text":"?","kind":"text"}],"symbolKind":"property","role":"symbol","roleHeading":"Instance Property"},"abstract":[{"text":"The optional-unique-id attribute group allows an element to optionally specify an ID that is unique to the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"entire document. This attribute group is not used for a required id attribute, or for an id attribute that"},{"type":"text","text":" "},{"type":"text","text":"specifies an id reference."}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/id","interfaceLanguage":"swift"},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"id","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}]},{"content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"Maps to the MusicXML ","type":"text"},{"code":"id","type":"codeVoice"},{"text":" attribute.","type":"text"}]}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"variants":[{"paths":["\/documentation\/ivormxl\/mxlnote\/id"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/id":{"url":"\/documentation\/ivormxl\/mxlnote\/id","abstract":[{"type":"text","text":"The optional-unique-id attribute group allows an element to optionally specify an ID that is unique to the"},{"type":"text","text":" "},{"type":"text","text":"entire document. This attribute group is not used for a required id attribute, or for an id attribute that"},{"type":"text","text":" "},{"type":"text","text":"specifies an id reference."}],"kind":"symbol","title":"id","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/id","type":"topic","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"id"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"navigatorTitle":[{"kind":"identifier","text":"MXLNote"}],"abstract":[{"text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for","type":"text"},{"text":" ","type":"text"},{"text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation).","type":"text"},{"text":" ","type":"text"},{"text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,","type":"text"},{"text":" ","type":"text"},{"text":"but no tie elements. Having these two types of information available can make interchange easier, as some","type":"text"},{"text":" ","type":"text"},{"text":"programs handle one type of information more readily than the other.","type":"text"}],"title":"MXLNote","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","kind":"symbol","url":"\/documentation\/ivormxl\/mxlnote","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{