oc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTie","text":"MXLTie","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL6MXLTieV"},{"text":"])","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"}],"variants":[{"paths":["\/documentation\/ivormxl\/mxlnote\/content-swift.enum\/gracenote(fullnote:grace:tie:)"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Content-swift.enum\/graceNote(fullNote:grace:tie:)"},"abstract":[{"text":"A grace note that is not additionally marked ","type":"text"},{"type":"codeVoice","code":"cue"},{"text":". Like all grace notes, it has no duration, but it may","type":"text"},{"text":" ","type":"text"},{"text":"carry ties.","type":"text"}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNote","kind":"identifier"}],"title":"MXLNote","abstract":[{"text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for","type":"text"},{"text":" ","type":"text"},{"text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation).","type":"text"},{"text":" ","type":"text"},{"text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,","type":"text"},{"text":" ","type":"text"},{"text":"but no tie elements. Having these two types of information available can make interchange easier, as some","type":"text"},{"text":" ","type":"text"},{"text":"programs handle one type of information more readily than the other.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","role":"symbol","url":"\/documentation\/ivormxl\/mxlnote","kind":"symbol","navigatorTitle":[{"text":"MXLNote","kind":"identifier"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLGrace":{"title":"MXLGrace","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLGrace"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlgrace","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLGrace"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLGrace","abstract":[{"text":"The grace type indicates the presence of a grace note. The slash attribute for a grace note is yes for slashed","type":"text"},{"text":" ","type":"text"},{"text":"grace notes. The steal-time-previous attribute indicates the percentage of time to steal from the previous","type":"text"},{"text":" ","type":"text"},{"text":"note for the grace note. The steal-time-following attribute indicates the percentage of time to steal from the","type":"text"},{"text":" ","type":"text"},{"text":"following note for the grace note, as for appoggiaturas. The make-time attribute indicates to make time, not","type":"text"},{"text":" ","type":"text"},{"text":"steal time; the units are in real-time divisions for the grace note.","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/Content-swift.enum":{"title":"MXLNote.Content","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Content"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlnote\/content-swift.enum","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Content"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Content-swift.enum","abstract":[{"text":"One of the alternatives for Note.","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLFullNote":{"title":"MXLFullNote","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFullNote"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlfullnote","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLFullNote"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFullNote","abstract":[{"text":"The full-note group is a sequence of the common note elements between cue\/grace notes and regular (full)","type":"text"},{"text":" ","type":"text"},{"text":"notes: pitch, chord, and rest information, but not duration (cue and grace notes do not have duration","type":"text"},{"text":" ","type":"text"},{"text":"encoded). Unpitched elements are used for unpitched percussion, speaking voice, and other musical elements","type":"text"},{"text":" ","type":"text"},{"text":"lacking determinate pitch.","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/Content-swift.enum/graceNote(fullNote:grace:tie:)":{"title":"MXLNote.Content.graceNote(fullNote:grace:tie:)","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"graceNote"},{"kind":"text","text":"("},{"kind":"externalParam","text":"fullNote"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL11MXLFullNoteV","kind":"typeIdentifier","text":"MXLFullNote"},{"kind":"text","text":", "},{"kind":"externalParam","text":"grace"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL8MXLGraceV","kind":"typeIdentifier","text":"MXLGrace"},{"kind":"text","text":", "},{"kind":"externalParam","text":"tie"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:7IvorMXL6MXLTieV","kind":"typeIdentifier","text":"MXLTie"},{"kind":"text","text":"])"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlnote\/content-swift.enum\/gracenote(fullnote:grace:tie:)","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Content-swift.enum\/graceNote(fullNote:grace:tie:)","abstract":[{"text":"A grace note that is not additionally marked ","type":"text"},{"type":"codeVoice","code":"cue"},{"text":". Like all grace notes, it has no duration, but it may","type":"text"},{"text":" ","type":"text"},{"text":"carry ties.","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLTie":{"type":"topic","abstract":[{"type":"text","text":"The tie element indicates that a tie begins or ends with this note. If the tie element applies only particular"},{"type":"text","text":" "},{"type":"text","text":"times through a repeat, the time-only attribute indicates which times to apply it. The tie element indicates"},{"type":"text","text":" "},{"type":"text","text":"sound; the tied element indicates notation."}],"url":"\/documentation\/ivormxl\/mxltie","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTie"}],"kind":"symbol","title":"MXLTie","navigatorTitle":[{"kind":"identifier","text":"MXLTie"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTie","role":"symbol"}}}