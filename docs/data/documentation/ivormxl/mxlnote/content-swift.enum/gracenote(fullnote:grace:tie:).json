{"kind":"symbol","abstract":[{"text":"A grace note that is not additionally marked ","type":"text"},{"code":"cue","type":"codeVoice"},{"text":". Like all grace notes, it has no duration, but it may","type":"text"},{"text":" ","type":"text"},{"text":"carry ties.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlnote\/content-swift.enum\/gracenote(fullnote:grace:tie:)"]}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Content-swift.enum"]]},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Content-swift.enum\/graceNote(fullNote:grace:tie:)"},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"graceNote","kind":"identifier"},{"text":"(","kind":"text"},{"text":"fullNote","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFullNote","preciseIdentifier":"s:7IvorMXL11MXLFullNoteV","text":"MXLFullNote","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"kind":"externalParam","text":"grace"},{"text":": ","kind":"text"},{"text":"MXLGrace","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLGraceV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLGrace"},{"text":", ","kind":"text"},{"kind":"externalParam","text":"tie"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:7IvorMXL6MXLTieV","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTie","text":"MXLTie"},{"kind":"text","text":"])"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"}],"metadata":{"externalID":"s:7IvorMXL7MXLNoteV7ContentO9graceNoteyAeA07MXLFullF0V_AA8MXLGraceVSayAA6MXLTieVGtcAEmF","roleHeading":"Case","modules":[{"name":"IvorMXL"}],"role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"graceNote"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"fullNote"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"MXLFullNote","preciseIdentifier":"s:7IvorMXL11MXLFullNoteV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"grace"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLGrace","preciseIdentifier":"s:7IvorMXL8MXLGraceV"},{"kind":"text","text":", "},{"text":"tie","kind":"externalParam"},{"text":": [","kind":"text"},{"kind":"typeIdentifier","text":"MXLTie","preciseIdentifier":"s:7IvorMXL6MXLTieV"},{"kind":"text","text":"])"}],"symbolKind":"case","title":"MXLNote.Content.graceNote(fullNote:grace:tie:)"},"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlnote","title":"MXLNote","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNote","kind":"identifier"}],"navigatorTitle":[{"text":"MXLNote","kind":"identifier"}],"abstract":[{"type":"text","text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for"},{"type":"text","text":" "},{"type":"text","text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation)."},{"type":"text","text":" "},{"type":"text","text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,"},{"type":"text","text":" "},{"text":"but no tie elements. Having these two types of information available can make interchange easier, as some","type":"text"},{"type":"text","text":" "},{"type":"text","text":"programs handle one type of information more readily than the other."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote"},"doc://IvorMXL/documentation/IvorMXL/MXLFullNote":{"url":"\/documentation\/ivormxl\/mxlfullnote","role":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFullNote","abstract":[{"type":"text","text":"The full-note group is a sequence of the common note elements between cue\/grace notes and regular (full)"},{"type":"text","text":" "},{"type":"text","text":"notes: pitch, chord, and rest information, but not duration (cue and grace notes do not have duration"},{"type":"text","text":" "},{"type":"text","text":"encoded). Unpitched elements are used for unpitched percussion, speaking voice, and other musical elements"},{"type":"text","text":" "},{"type":"text","text":"lacking determinate pitch."}],"title":"MXLFullNote","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLFullNote","kind":"identifier"}],"navigatorTitle":[{"text":"MXLFullNote","kind":"identifier"}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/Content-swift.enum/graceNote(fullNote:grace:tie:)":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Content-swift.enum\/graceNote(fullNote:grace:tie:)","abstract":[{"type":"text","text":"A grace note that is not additionally marked "},{"code":"cue","type":"codeVoice"},{"text":". Like all grace notes, it has no duration, but it may","type":"text"},{"type":"text","text":" "},{"text":"carry ties.","type":"text"}],"title":"MXLNote.Content.graceNote(fullNote:grace:tie:)","kind":"symbol","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"case"},{"text":" ","kind":"text"},{"kind":"identifier","text":"graceNote"},{"text":"(","kind":"text"},{"text":"fullNote","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLFullNote","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLFullNoteV"},{"kind":"text","text":", "},{"text":"grace","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLGrace","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLGraceV"},{"text":", ","kind":"text"},{"text":"tie","kind":"externalParam"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:7IvorMXL6MXLTieV","kind":"typeIdentifier","text":"MXLTie"},{"text":"])","kind":"text"}],"url":"\/documentation\/ivormxl\/mxlnote\/content-swift.enum\/gracenote(fullnote:grace:tie:)"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLGrace":{"navigatorTitle":[{"kind":"identifier","text":"MXLGrace"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLGrace"}],"abstract":[{"text":"The grace type indicates the presence of a grace note. The slash attribute for a grace note is yes for slashed","type":"text"},{"text":" ","type":"text"},{"text":"grace notes. The steal-time-previous attribute indicates the percentage of time to steal from the previous","type":"text"},{"text":" ","type":"text"},{"text":"note for the grace note. The steal-time-following attribute indicates the percentage of time to steal from the","type":"text"},{"text":" ","type":"text"},{"text":"following note for the grace note, as for appoggiaturas. The make-time attribute indicates to make time, not","type":"text"},{"text":" ","type":"text"},{"text":"steal time; the units are in real-time divisions for the grace note.","type":"text"}],"role":"symbol","url":"\/documentation\/ivormxl\/mxlgrace","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLGrace","title":"MXLGrace","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/Content-swift.enum":{"url":"\/documentation\/ivormxl\/mxlnote\/content-swift.enum","role":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Content-swift.enum","abstract":[{"type":"text","text":"One of the alternatives for Note."}],"title":"MXLNote.Content","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Content","kind":"identifier"}],"navigatorTitle":[{"text":"Content","kind":"identifier"}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLTie":{"type":"topic","title":"MXLTie","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTie","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxltie","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTie","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"MXLTie","kind":"identifier"}],"abstract":[{"type":"text","text":"The tie element indicates that a tie begins or ends with this note. If the tie element applies only particular"},{"type":"text","text":" "},{"type":"text","text":"times through a repeat, the time-only attribute indicates which times to apply it. The tie element indicates"},{"type":"text","text":" "},{"type":"text","text":"sound; the tied element indicates notation."}]}}}