"}],"title":"MXLNote.Content","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Content-swift.enum","navigatorTitle":[{"kind":"identifier","text":"Content"}],"role":"symbol","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"One of the alternatives for Note."}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLTie":{"title":"MXLTie","url":"\/documentation\/ivormxl\/mxltie","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTie","kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTie"}],"navigatorTitle":[{"kind":"identifier","text":"MXLTie"}],"role":"symbol","abstract":[{"text":"The tie element indicates that a tie begins or ends with this note. If the tie element applies only particular","type":"text"},{"text":" ","type":"text"},{"text":"times through a repeat, the time-only attribute indicates which times to apply it. The tie element indicates","type":"text"},{"text":" ","type":"text"},{"text":"sound; the tied element indicates notation.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote/Content-swift.enum/graceNote(fullNote:grace:tie:)":{"kind":"symbol","url":"\/documentation\/ivormxl\/mxlnote\/content-swift.enum\/gracenote(fullnote:grace:tie:)","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Content-swift.enum\/graceNote(fullNote:grace:tie:)","abstract":[{"text":"A grace note that is not additionally marked ","type":"text"},{"code":"cue","type":"codeVoice"},{"text":". Like all grace notes, it has no duration, but it may","type":"text"},{"text":" ","type":"text"},{"text":"carry ties.","type":"text"}],"type":"topic","role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"graceNote","kind":"identifier"},{"text":"(","kind":"text"},{"text":"fullNote","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLFullNote","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLFullNoteV"},{"text":", ","kind":"text"},{"text":"grace","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLGrace","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLGraceV"},{"text":", ","kind":"text"},{"text":"tie","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"MXLTie","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL6MXLTieV"},{"text":"])","kind":"text"}],"title":"MXLNote.Content.graceNote(fullNote:grace:tie:)"},"doc://IvorMXL/documentation/IvorMXL/MXLGrace":{"abstract":[{"text":"The grace type indicates the presence of a grace note. The slash attribute for a grace note is yes for slashed","type":"text"},{"type":"text","text":" "},{"text":"grace notes. The steal-time-previous attribute indicates the percentage of time to steal from the previous","type":"text"},{"text":" ","type":"text"},{"text":"note for the grace note. The steal-time-following attribute indicates the percentage of time to steal from the","type":"text"},{"text":" ","type":"text"},{"text":"following note for the grace note, as for appoggiaturas. The make-time attribute indicates to make time, not","type":"text"},{"text":" ","type":"text"},{"text":"steal time; the units are in real-time divisions for the grace note.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLGrace","kind":"symbol","url":"\/documentation\/ivormxl\/mxlgrace","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLGrace","kind":"identifier"}],"title":"MXLGrace","role":"symbol","navigatorTitle":[{"text":"MXLGrace","kind":"identifier"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNote"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLNote"}],"url":"\/documentation\/ivormxl\/mxlnote","role":"symbol","title":"MXLNote","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","type":"topic","abstract":[{"type":"text","text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for"},{"type":"text","text":" "},{"type":"text","text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation)."},{"type":"text","text":" "},{"type":"text","text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,"},{"type":"text","text":" "},{"type":"text","text":"but no tie elements. Having these two types of information available can make interchange easier, as some"},{"type":"text","text":" "},{"type":"text","text":"programs handle one type of information more readily than the other."}]}}}