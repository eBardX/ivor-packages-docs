ote","preciseIdentifier":"s:7IvorMXL11MXLFullNoteV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFullNote"},{"kind":"text","text":", "},{"kind":"externalParam","text":"grace"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLGrace","preciseIdentifier":"s:7IvorMXL8MXLGraceV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLGrace"},{"kind":"text","text":", "},{"kind":"externalParam","text":"tie"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"MXLTie","preciseIdentifier":"s:7IvorMXL6MXLTieV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTie"},{"text":"])","kind":"text"}]}]}],"variants":[{"paths":["\/documentation\/ivormxl\/mxlnote\/content-swift.enum\/gracenote(fullnote:grace:tie:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLNote/Content-swift.enum":{"title":"MXLNote.Content","kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Content","kind":"identifier"}],"navigatorTitle":[{"text":"Content","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Content-swift.enum","url":"\/documentation\/ivormxl\/mxlnote\/content-swift.enum","type":"topic","abstract":[{"text":"One of the alternatives for Note.","type":"text"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLTie":{"title":"MXLTie","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTie"}],"navigatorTitle":[{"kind":"identifier","text":"MXLTie"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTie","url":"\/documentation\/ivormxl\/mxltie","type":"topic","abstract":[{"type":"text","text":"The tie element indicates that a tie begins or ends with this note. If the tie element applies only particular"},{"type":"text","text":" "},{"type":"text","text":"times through a repeat, the time-only attribute indicates which times to apply it. The tie element indicates"},{"type":"text","text":" "},{"type":"text","text":"sound; the tied element indicates notation."}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLGrace":{"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLGrace","type":"topic","url":"\/documentation\/ivormxl\/mxlgrace","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLGrace","kind":"identifier"}],"navigatorTitle":[{"text":"MXLGrace","kind":"identifier"}],"title":"MXLGrace","role":"symbol","abstract":[{"type":"text","text":"The grace type indicates the presence of a grace note. The slash attribute for a grace note is yes for slashed"},{"type":"text","text":" "},{"type":"text","text":"grace notes. The steal-time-previous attribute indicates the percentage of time to steal from the previous"},{"type":"text","text":" "},{"type":"text","text":"note for the grace note. The steal-time-following attribute indicates the percentage of time to steal from the"},{"type":"text","text":" "},{"type":"text","text":"following note for the grace note, as for appoggiaturas. The make-time attribute indicates to make time, not"},{"type":"text","text":" "},{"text":"steal time; the units are in real-time divisions for the grace note.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote/Content-swift.enum/graceNote(fullNote:grace:tie:)":{"type":"topic","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"graceNote"},{"kind":"text","text":"("},{"kind":"externalParam","text":"fullNote"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLFullNoteV","text":"MXLFullNote"},{"kind":"text","text":", "},{"kind":"externalParam","text":"grace"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLGraceV","text":"MXLGrace"},{"kind":"text","text":", "},{"kind":"externalParam","text":"tie"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL6MXLTieV","text":"MXLTie"},{"kind":"text","text":"])"}],"abstract":[{"text":"A grace note that is not additionally marked ","type":"text"},{"type":"codeVoice","code":"cue"},{"text":". Like all grace notes, it has no duration, but it may","type":"text"},{"text":" ","type":"text"},{"text":"carry ties.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Content-swift.enum\/graceNote(fullNote:grace:tie:)","role":"symbol","kind":"symbol","title":"MXLNote.Content.graceNote(fullNote:grace:tie:)","url":"\/documentation\/ivormxl\/mxlnote\/content-swift.enum\/gracenote(fullnote:grace:tie:)"},"doc://IvorMXL/documentation/IvorMXL/MXLFullNote":{"title":"MXLFullNote","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLFullNote","kind":"identifier"}],"abstract":[{"text":"The full-note group is a sequence of the common note elements between cue\/grace notes and regular (full)","type":"text"},{"text":" ","type":"text"},{"text":"notes: pitch, chord, and rest information, but not duration (cue and grace notes do not have duration","type":"text"},{"text":" ","type":"text"},{"text":"encoded). Unpitched elements are used for unpitched percussion, speaking voice, and other musical elements","type":"text"},{"text":" ","type":"text"},{"text":"lacking determinate pitch.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFullNote","role":"symbol","navigatorTitle":[{"text":"MXLFullNote","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlfullnote"},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"title":"MXLNote","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNote"}],"abstract":[{"type":"text","text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for"},{"type":"text","text":" "},{"type":"text","text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation)."},{"type":"text","text":" "},{"type":"text","text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,"},{"type":"text","text":" "},{"type":"text","text":"but no tie elements. Having these two types of information available can make interchange easier, as some"},{"type":"text","text":" "},{"type":"text","text":"programs handle one type of information more readily than the other."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLNote"}],"url":"\/documentation\/ivormxl\/mxlnote"}}}