ole":"symbol","url":"\/documentation\/ivormxl\/mxlnote","title":"MXLNote","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNote","kind":"identifier"}],"navigatorTitle":[{"text":"MXLNote","kind":"identifier"}],"abstract":[{"type":"text","text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for"},{"type":"text","text":" "},{"type":"text","text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation)."},{"type":"text","text":" "},{"type":"text","text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,"},{"type":"text","text":" "},{"text":"but no tie elements. Having these two types of information available can make interchange easier, as some","type":"text"},{"type":"text","text":" "},{"type":"text","text":"programs handle one type of information more readily than the other."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/Content-swift.enum":{"url":"\/documentation\/ivormxl\/mxlnote\/content-swift.enum","role":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Content-swift.enum","abstract":[{"type":"text","text":"One of the alternatives for Note."}],"title":"MXLNote.Content","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Content","kind":"identifier"}],"navigatorTitle":[{"text":"Content","kind":"identifier"}],"kind":"symbol"}}}