ruct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFullNote"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlfullnote","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLFullNote"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFullNote","abstract":[{"text":"The full-note group is a sequence of the common note elements between cue\/grace notes and regular (full)","type":"text"},{"text":" ","type":"text"},{"text":"notes: pitch, chord, and rest information, but not duration (cue and grace notes do not have duration","type":"text"},{"text":" ","type":"text"},{"text":"encoded). Unpitched elements are used for unpitched percussion, speaking voice, and other musical elements","type":"text"},{"text":" ","type":"text"},{"text":"lacking determinate pitch.","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/Content-swift.enum":{"title":"MXLNote.Content","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Content"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlnote\/content-swift.enum","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Content"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Content-swift.enum","abstract":[{"text":"One of the alternatives for Note.","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLPositiveDivisions":{"type":"topic","title":"MXLPositiveDivisions","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPositiveDivisions","abstract":[{"type":"text","text":"The positive-divisions type restricts divisions values to positive numbers."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPositiveDivisions"}],"navigatorTitle":[{"kind":"identifier","text":"MXLPositiveDivisions"}],"url":"\/documentation\/ivormxl\/mxlpositivedivisions"},"doc://IvorMXL/documentation/IvorMXL/MXLTie":{"type":"topic","abstract":[{"type":"text","text":"The tie element indicates that a tie begins or ends with this note. If the tie element applies only particular"},{"type":"text","text":" "},{"type":"text","text":"times through a repeat, the time-only attribute indicates which times to apply it. The tie element indicates"},{"type":"text","text":" "},{"type":"text","text":"sound; the tied element indicates notation."}],"url":"\/documentation\/ivormxl\/mxltie","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTie"}],"kind":"symbol","title":"MXLTie","navigatorTitle":[{"kind":"identifier","text":"MXLTie"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTie","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/Content-swift.enum/regularNote(fullNote:duration:tie:)":{"url":"\/documentation\/ivormxl\/mxlnote\/content-swift.enum\/regularnote(fullnote:duration:tie:)","type":"topic","abstract":[{"type":"text","text":"A normal, sounding note, with a duration and any ties."}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Content-swift.enum\/regularNote(fullNote:duration:tie:)","title":"MXLNote.Content.regularNote(fullNote:duration:tie:)","role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"regularNote","kind":"identifier"},{"text":"(","kind":"text"},{"text":"fullNote","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLFullNote","preciseIdentifier":"s:7IvorMXL11MXLFullNoteV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"duration","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLPositiveDivisions","preciseIdentifier":"s:7IvorMXL20MXLPositiveDivisionsV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"tie","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"MXLTie","preciseIdentifier":"s:7IvorMXL6MXLTieV","kind":"typeIdentifier"},{"text":"])","kind":"text"}]}}}