Divisions","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPositiveDivisions","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLFullNote":{"title":"MXLFullNote","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLFullNote","kind":"identifier"}],"abstract":[{"text":"The full-note group is a sequence of the common note elements between cue\/grace notes and regular (full)","type":"text"},{"text":" ","type":"text"},{"text":"notes: pitch, chord, and rest information, but not duration (cue and grace notes do not have duration","type":"text"},{"text":" ","type":"text"},{"text":"encoded). Unpitched elements are used for unpitched percussion, speaking voice, and other musical elements","type":"text"},{"text":" ","type":"text"},{"text":"lacking determinate pitch.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFullNote","role":"symbol","navigatorTitle":[{"text":"MXLFullNote","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlfullnote"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/Content-swift.enum/regularNote(fullNote:duration:tie:)":{"type":"topic","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"regularNote"},{"kind":"text","text":"("},{"kind":"externalParam","text":"fullNote"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLFullNoteV","text":"MXLFullNote"},{"kind":"text","text":", "},{"kind":"externalParam","text":"duration"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL20MXLPositiveDivisionsV","text":"MXLPositiveDivisions"},{"kind":"text","text":", "},{"kind":"externalParam","text":"tie"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL6MXLTieV","text":"MXLTie"},{"kind":"text","text":"])"}],"abstract":[{"text":"A normal, sounding note, with a duration and any ties.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Content-swift.enum\/regularNote(fullNote:duration:tie:)","role":"symbol","kind":"symbol","title":"MXLNote.Content.regularNote(fullNote:duration:tie:)","url":"\/documentation\/ivormxl\/mxlnote\/content-swift.enum\/regularnote(fullnote:duration:tie:)"},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"title":"MXLNote","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNote"}],"abstract":[{"type":"text","text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for"},{"type":"text","text":" "},{"type":"text","text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation)."},{"type":"text","text":" "},{"type":"text","text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,"},{"type":"text","text":" "},{"type":"text","text":"but no tie elements. Having these two types of information available can make interchange easier, as some"},{"type":"text","text":" "},{"type":"text","text":"programs handle one type of information more readily than the other."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLNote"}],"url":"\/documentation\/ivormxl\/mxlnote"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/Content-swift.enum":{"title":"MXLNote.Content","kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Content","kind":"identifier"}],"navigatorTitle":[{"te