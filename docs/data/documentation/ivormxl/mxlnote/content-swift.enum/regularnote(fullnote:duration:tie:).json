":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"regularNote","kind":"identifier"},{"text":"(","kind":"text"},{"text":"fullNote","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLFullNote","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLFullNoteV"},{"text":", ","kind":"text"},{"text":"duration","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLPositiveDivisions","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL20MXLPositiveDivisionsV"},{"text":", ","kind":"text"},{"text":"tie","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"MXLTie","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL6MXLTieV"},{"text":"])","kind":"text"}]},"sections":[],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLFullNote":{"url":"\/documentation\/ivormxl\/mxlfullnote","role":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFullNote","abstract":[{"type":"text","text":"The full-note group is a sequence of the common note elements between cue\/grace notes and regular (full)"},{"type":"text","text":" "},{"type":"text","text":"notes: pitch, chord, and rest information, but not duration (cue and grace notes do not have duration"},{"type":"text","text":" "},{"type":"text","text":"encoded). Unpitched elements are used for unpitched percussion, speaking voice, and other musical elements"},{"type":"text","text":" "},{"type":"text","text":"lacking determinate pitch."}],"title":"MXLFullNote","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLFullNote","kind":"identifier"}],"navigatorTitle":[{"text":"MXLFullNote","kind":"identifier"}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlnote","title":"MXLNote","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNote","kind":"identifier"}],"navigatorTitle":[{"text":"MXLNote","kind":"identifier"}],"abstract":[{"type":"text","text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for"},{"type":"text","text":" "},{"type":"text","text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation)."},{"type":"text","text":" "},{"type":"text","text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,"},{"type":"text","text":" "},{"text":"but no tie elements. Having these two types of information available can make interchange easier, as some","type":"text"},{"type":"text","text":" "},{"type":"text","text":"programs handle one type of information more readily than the other."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote"},"doc://IvorMXL/documentation/IvorMXL/MXLPositiveDivisions":{"type":"topic","title":"MXLPositiveDivisions","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPositiveDivisions","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlpositivedivisions","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPositiveDivisions","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"MXLPositiveDivisions","kind":"identifier"}],"abstract":[{"type":"text","text":"The positive-divisions type restricts divisions values to positive numbers."}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote/Content-swift.enum":{"url":"\/documentation\/ivormxl\/mxlnote\/content-swift.enum","role":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Content-swift.enum","abstract":[{"type":"text","text":"One of the alternatives for Note."}],"title":"MXLNote.Content","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Content","kind":"identifier"}],"navigatorTitle":[{"text":"Content","kind":"identifier"}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLTie":{"type":"topic","title":"MXLTie","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTie","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxltie","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTie","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"MXLTie","kind":"identifier"}],"abstract":[{"type":"text","text":"The tie element indicates that a tie begins or ends with this note. If the tie element applies only particular"},{"type":"text","text":" "},{"type":"text","text":"times through a repeat, the time-only attribute indicates which times to apply it. The tie element indicates"},{"type":"text","text":" "},{"type":"text","text":"sound; the tied element indicates notation."}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote/Content-swift.enum/regularNote(fullNote:duration:tie:)":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Content-swift.enum\/regularNote(fullNote:duration:tie:)","abstract":[{"text":"A normal, sounding note, with a duration and any ties.","type":"text"}],"title":"MXLNote.Content.regularNote(fullNote:duration:tie:)","type":"topic","kind":"symbol","role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"regularNote","kind":"identifier"},{"text":"(","kind":"text"},{"text":"fullNote","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLFullNote","preciseIdentifier":"s:7IvorMXL11MXLFullNoteV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"duration","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLPositiveDivisions","preciseIdentifier":"s:7IvorMXL20MXLPositiveDivisionsV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"tie","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"MXLTie","preciseIdentifier":"s:7IvorMXL6MXLTieV","kind":"typeIdentifier"},{"text":"])","kind":"text"}],"url":"\/documentation\/ivormxl\/mxlnote\/content-swift.enum\/regularnote(fullnote:duration:tie:)"}}}