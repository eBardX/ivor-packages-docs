ext":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTie"}],"navigatorTitle":[{"kind":"identifier","text":"MXLTie"}],"role":"symbol","abstract":[{"text":"The tie element indicates that a tie begins or ends with this note. If the tie element applies only particular","type":"text"},{"text":" ","type":"text"},{"text":"times through a repeat, the time-only attribute indicates which times to apply it. The tie element indicates","type":"text"},{"text":" ","type":"text"},{"text":"sound; the tied element indicates notation.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLPositiveDivisions":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPositiveDivisions"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLPositiveDivisions"}],"url":"\/documentation\/ivormxl\/mxlpositivedivisions","role":"symbol","title":"MXLPositiveDivisions","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPositiveDivisions","type":"topic","abstract":[{"type":"text","text":"The positive-divisions type restricts divisions values to positive numbers."}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNote"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLNote"}],"url":"\/documentation\/ivormxl\/mxlnote","role":"symbol","title":"MXLNote","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","type":"topic","abstract":[{"type":"text","text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for"},{"type":"text","text":" "},{"type":"text","text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation)."},{"type":"text","text":" "},{"type":"text","text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,"},{"type":"text","text":" "},{"type":"text","text":"but no tie elements. Having these two types of information available can make interchange easier, as some"},{"type":"text","text":" "},{"type":"text","text":"programs handle one type of information more readily than the other."}]}}}