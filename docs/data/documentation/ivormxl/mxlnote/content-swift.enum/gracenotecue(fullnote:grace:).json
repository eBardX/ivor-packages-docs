y":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Content-swift.enum"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"symbol","references":{"doc://IvorMXL/documentation/IvorMXL/MXLNote/Content-swift.enum/graceNoteCue(fullNote:grace:)":{"type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"graceNoteCue"},{"kind":"text","text":"("},{"kind":"externalParam","text":"fullNote"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL11MXLFullNoteV","kind":"typeIdentifier","text":"MXLFullNote"},{"kind":"text","text":", "},{"kind":"externalParam","text":"grace"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL8MXLGraceV","kind":"typeIdentifier","text":"MXLGrace"},{"kind":"text","text":")"}],"title":"MXLNote.Content.graceNoteCue(fullNote:grace:)","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Content-swift.enum\/graceNoteCue(fullNote:grace:)","abstract":[{"text":"A grace note that is also cue-sized\/silent-for-playback. Like all grace notes, it has no duration.","type":"text"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlnote\/content-swift.enum\/gracenotecue(fullnote:grace:)"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLFullNote":{"url":"\/documentation\/ivormxl\/mxlfullnote","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFullNote"}],"title":"MXLFullNote","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFullNote","navigatorTitle":[{"kind":"identifier","text":"MXLFullNote"}],"role":"symbol","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The full-note group is a sequence of the common note elements between cue\/grace notes and regular (full)"},{"type":"text","text":" "},{"type":"text","text":"notes: pitch, chord, and rest information, but not duration (cue and grace notes do not have duration"},{"type":"text","text":" "},{"type":"text","text":"encoded). Unpitched elements are used for unpitched percussion, speaking voice, and other musical elements"},{"type":"text","text":" "},{"type":"text","text":"lacking determinate pitch."}]},"doc://IvorMXL/documentation/IvorMXL/MXLGrace":{"abstract":[{"text":"The grace type indicates the presence of a grace note. The slash attribute for a grace note is yes for slashed","type":"text"},{"type":"text","text":" "},{"text":"grace notes. The steal-time-previous attribute indicates the percentage of time to steal from the previous","type":"text"},{"text":" ","type":"text"},{"text":"note for the grace note. The steal-time-following attribute indicates the percentage of time to steal from the","type":"text"},{"text":" ","type":"text"},{"text":"following note for the grace note, as for appoggiaturas. The make-time attribute indicates to make time, not","type":"text"},{"text":" ","type":"text"},{"text":"steal time; the units are in real-time divisions for the grace note.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLGrace","kind":"symbol","url":"\/documentation\/ivormxl\/mxlgrace","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLGrace","kind":"identifier"}],"title":"MXLGrace","role":"symbol","navigatorTitle":[{"text":"MXLGrace","kind":"identifier"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/Content-swift.enum":{"url":"\/documentation\/ivormxl\/mxlnote\/content-swift.enum","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Content"}],"title":"MXLNote.Content","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Content-swift.enum","navigatorTitle":[{"kind":"identifier","text":"Content"}],"role":"symbol","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"One of the alternatives for Note."}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNote"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLNote"}],"url":"\/documentation\/ivormxl\/mxlnote","role":"symbol","title":"MXLNote","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","type":"topic","abstract":[{"type":"text","text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for"},{"type":"text","text":" "},{"type":"text","text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation)."},{"type":"text","text":" "},{"type":"text","text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,"},{"type":"text","text":" "},{"type":"text","text":"but no tie elements. Having these two types of information available can make interchange easier, as some"},{"type":"text","text":" "},{"type":"text","text":"programs handle one type of information more readily than the other."}]}}}