,{"kind":"text","text":")"}],"languages":["swift"]}]}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Content-swift.enum"]]},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLFullNote":{"title":"MXLFullNote","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFullNote"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlfullnote","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLFullNote"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFullNote","abstract":[{"text":"The full-note group is a sequence of the common note elements between cue\/grace notes and regular (full)","type":"text"},{"text":" ","type":"text"},{"text":"notes: pitch, chord, and rest information, but not duration (cue and grace notes do not have duration","type":"text"},{"text":" ","type":"text"},{"text":"encoded). Unpitched elements are used for unpitched percussion, speaking voice, and other musical elements","type":"text"},{"text":" ","type":"text"},{"text":"lacking determinate pitch.","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLGrace":{"title":"MXLGrace","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLGrace"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlgrace","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLGrace"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLGrace","abstract":[{"text":"The grace type indicates the presence of a grace note. The slash attribute for a grace note is yes for slashed","type":"text"},{"text":" ","type":"text"},{"text":"grace notes. The steal-time-previous attribute indicates the percentage of time to steal from the previous","type":"text"},{"text":" ","type":"text"},{"text":"note for the grace note. The steal-time-following attribute indicates the percentage of time to steal from the","type":"text"},{"text":" ","type":"text"},{"text":"following note for the grace note, as for appoggiaturas. The make-time attribute indicates to make time, not","type":"text"},{"text":" ","type":"text"},{"text":"steal time; the units are in real-time divisions for the grace note.","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/Content-swift.enum":{"title":"MXLNote.Content","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Content"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlnote\/content-swift.enum","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Content"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Content-swift.enum","abstract":[{"text":"One of the alternatives for Note.","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNote","kind":"identifier"}],"title":"MXLNote","abstract":[{"text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for","type":"text"},{"text":" ","type":"text"},{"text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation).","type":"text"},{"text":" ","type":"text"},{"text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,","type":"text"},{"text":" ","type":"text"},{"text":"but no tie elements. Having these two types of information available can make interchange easier, as some","type":"text"},{"text":" ","type":"text"},{"text":"programs handle one type of information more readily than the other.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","role":"symbol","url":"\/documentation\/ivormxl\/mxlnote","kind":"symbol","navigatorTitle":[{"text":"MXLNote","kind":"identifier"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/Content-swift.enum/graceNoteCue(fullNote:grace:)":{"url":"\/documentation\/ivormxl\/mxlnote\/content-swift.enum\/gracenotecue(fullnote:grace:)","type":"topic","abstract":[{"type":"text","text":"A grace note that is also cue-sized\/silent-for-playback. Like all grace notes, it has no duration."}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Content-swift.enum\/graceNoteCue(fullNote:grace:)","title":"MXLNote.Content.graceNoteCue(fullNote:grace:)","role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"graceNoteCue","kind":"identifier"},{"text":"(","kind":"text"},{"text":"fullNote","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLFullNote","preciseIdentifier":"s:7IvorMXL11MXLFullNoteV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"grace","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLGrace","preciseIdentifier":"s:7IvorMXL8MXLGraceV","kind":"typeIdentifier"},{"text":")","kind":"text"}]}}}