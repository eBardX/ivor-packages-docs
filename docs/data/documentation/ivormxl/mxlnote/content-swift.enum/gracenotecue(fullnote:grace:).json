notes, it has no duration.","type":"text"}],"variants":[{"paths":["\/documentation\/ivormxl\/mxlnote\/content-swift.enum\/gracenotecue(fullnote:grace:)"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLFullNote":{"title":"MXLFullNote","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLFullNote","kind":"identifier"}],"abstract":[{"text":"The full-note group is a sequence of the common note elements between cue\/grace notes and regular (full)","type":"text"},{"text":" ","type":"text"},{"text":"notes: pitch, chord, and rest information, but not duration (cue and grace notes do not have duration","type":"text"},{"text":" ","type":"text"},{"text":"encoded). Unpitched elements are used for unpitched percussion, speaking voice, and other musical elements","type":"text"},{"text":" ","type":"text"},{"text":"lacking determinate pitch.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFullNote","role":"symbol","navigatorTitle":[{"text":"MXLFullNote","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlfullnote"},"doc://IvorMXL/documentation/IvorMXL/MXLGrace":{"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLGrace","type":"topic","url":"\/documentation\/ivormxl\/mxlgrace","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLGrace","kind":"identifier"}],"navigatorTitle":[{"text":"MXLGrace","kind":"identifier"}],"title":"MXLGrace","role":"symbol","abstract":[{"type":"text","text":"The grace type indicates the presence of a grace note. The slash attribute for a grace note is yes for slashed"},{"type":"text","text":" "},{"type":"text","text":"grace notes. The steal-time-previous attribute indicates the percentage of time to steal from the previous"},{"type":"text","text":" "},{"type":"text","text":"note for the grace note. The steal-time-following attribute indicates the percentage of time to steal from the"},{"type":"text","text":" "},{"type":"text","text":"following note for the grace note, as for appoggiaturas. The make-time attribute indicates to make time, not"},{"type":"text","text":" "},{"text":"steal time; the units are in real-time divisions for the grace note.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"title":"MXLNote","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNote"}],"abstract":[{"type":"text","text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for"},{"type":"text","text":" "},{"type":"text","text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation)."},{"type":"text","text":" "},{"type":"text","text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,"},{"type":"text","text":" "},{"type":"text","text":"but no tie elements. Having these two types of information available can make interchange easier, as some"},{"type":"text","text":" "},{"type":"text","text":"programs handle one type of information more readily than the other."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLNote"}],"url":"\/documentation\/ivormxl\/mxlnote"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/Content-swift.enum/graceNoteCue(fullNote:grace:)":{"type":"topic","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"graceNoteCue"},{"kind":"text","text":"("},{"kind":"externalParam","text":"fullNote"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLFullNoteV","text":"MXLFullNote"},{"kind":"text","text":", "},{"kind":"externalParam","text":"grace"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLGraceV","text":"MXLGrace"},{"kind":"text","text":")"}],"abstract":[{"text":"A grace note that is also cue-sized\/silent-for-playback. Like all grace notes, it has no duration.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Content-swift.enum\/graceNoteCue(fullNote:grace:)","role":"symbol","kind":"symbol","title":"MXLNote.Content.graceNoteCue(fullNote:grace:)","url":"\/documentation\/ivormxl\/mxlnote\/content-swift.enum\/gracenotecue(fullnote:grace:)"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/Content-swift.enum":{"title":"MXLNote.Content","kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Content","kind":"identifier"}],"navigatorTitle":[{"text":"Content","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Content-swift.enum","url":"\/documentation\/ivormxl\/mxlnote\/content-swift.enum","type":"topic","abstract":[{"text":"One of the alternatives for Note.","type":"text"}],"role":"symbol"}}}