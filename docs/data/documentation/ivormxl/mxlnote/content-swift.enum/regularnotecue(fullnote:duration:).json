{"kind":"symbol","abstract":[{"type":"text","text":"A cue-sized, silent-for-playback note that is not a grace note. Still occupies a definite duration in"},{"type":"text","text":" "},{"type":"text","text":"the measure."}],"sections":[],"metadata":{"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"regularNoteCue","kind":"identifier"},{"kind":"text","text":"("},{"kind":"externalParam","text":"fullNote"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLFullNoteV","text":"MXLFullNote"},{"kind":"text","text":", "},{"kind":"externalParam","text":"duration"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL20MXLPositiveDivisionsV","text":"MXLPositiveDivisions"},{"kind":"text","text":")"}],"externalID":"s:7IvorMXL7MXLNoteV7ContentO14regularNoteCueyAeA07MXLFullF0V_AA20MXLPositiveDivisionsVtcAEmF","roleHeading":"Case","modules":[{"name":"IvorMXL"}],"role":"symbol","symbolKind":"case","title":"MXLNote.Content.regularNoteCue(fullNote:duration:)"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"case"},{"text":" ","kind":"text"},{"kind":"identifier","text":"regularNoteCue"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"fullNote"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFullNote","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLFullNoteV","text":"MXLFullNote"},{"text":", ","kind":"text"},{"text":"duration","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPositiveDivisions","preciseIdentifier":"s:7IvorMXL20MXLPositiveDivisionsV","text":"MXLPositiveDivisions","kind":"typeIdentifier"},{"text":")","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"paths":["\/documentation\/ivormxl\/mxlnote\/content-swift.enum\/regularnotec