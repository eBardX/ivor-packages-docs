l\/mxlnote","role":"symbol","title":"MXLNote","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","type":"topic","abstract":[{"type":"text","text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for"},{"type":"text","text":" "},{"type":"text","text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation)."},{"type":"text","text":" "},{"type":"text","text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,"},{"type":"text","text":" "},{"type":"text","text":"but no tie elements. Having these two types of information available can make interchange easier, as some"},{"type":"text","text":" "},{"type":"text","text":"programs handle one type of information more readily than the other."}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote/notations":{"url":"\/documentation\/ivormxl\/mxlnote\/notations","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"notations"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"MXLNotations","preciseIdentifier":"s:7IvorMXL12MXLNotationsV"},{"kind":"text","text":"]"}],"title":"notations","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/notations","role":"symbol","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The notations (e.g. articulations, ornaments) associated with this note."}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLNotations":{"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlnotations","abstract":[{"type":"text","text":"Notations refer to musical notations, not XML notations. Multiple notations are allowed in order to represent"},{"type":"text","text":" "},{"type":"text","text":"multiple editorial levels. The print-object attribute, added in Version 3.0, allows notations to represent"},{"type":"text","text":" "},{"type":"text","text":"details of performance technique, such as fingerings, without having them appear in the score."}],"navigatorTitle":[{"kind":"identifier","text":"MXLNotations"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNotations"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNotations","title":"MXLNotations"}}}