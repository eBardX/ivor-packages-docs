{"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/notations","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"The notations (e.g. articulations, ornaments) associated with this note."}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlnote\/notations"]}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"notations","kind":"identifier"},{"text":": [","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNotations","text":"MXLNotations","preciseIdentifier":"s:7IvorMXL12MXLNotationsV","kind":"typeIdentifier"},{"text":"]","kind":"text"}]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Maps to nested MusicXML "},{"type":"codeVoice","code":"<notations>"},{"type":"text","text":" elements."}]}],"kind":"content"}],"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote"]]},"metadata":{"symbolKind":"property","title":"notations","roleHeading":"Instance Property","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"notations","kind":"identifier"},{"text":": [","kind":"text"},{"text":"MXLNotations","preciseIdentifier":"s:7IvorMXL12MXLNotationsV","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"externalID":"s:7IvorMXL7MXLNoteV9notationsSayAA12MXLNotationsVGvp","modules":[{"name":"IvorMXL"}]},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLNotations":{"navigatorTitle":[{"text":"MXLNotations","kind":"identifier"}],"abstract":[{"text":"Notations refer to musical notations, not XML notations. Multiple notations are allowed in order to represent","type":"text"},{"text":" ","type":"text"},{"text":"multiple editorial levels. The print-object attribute, added in Version 3.0, allows notations to represent","type":"text"},{"text":" ","type":"text"},{"text":"details of performance technique, such as fingerings, without having them appear in the score.","type":"text"}],"title":"MXLNotations","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNotations","kind":"symbol","url":"\/documentation\/ivormxl\/mxlnotations","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNotations","kind":"identifier"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"navigatorTitle":[{"kind":"identifier","text":"MXLNote"}],"abstract":[{"text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for","type":"text"},{"text":" ","type":"text"},{"text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation).","type":"text"},{"text":" ","type":"text"},{"text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,","type":"text"},{"text":" ","type":"text"},{"text":"but no tie elements. Having these two types of information available can make interchange easier, as some","type":"text"},{"text":" ","type":"text"},{"text":"programs handle one type of information more readily than the other.","type":"text"}],"title":"MXLNote","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","kind":"symbol","url":"\/documentation\/ivormxl\/mxlnote","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNote"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/notations":{"abstract":[{"type":"text","text":"The notations (e.g. articulations, ornaments) associated with this note."}],"title":"notations","kind":"symbol","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"notations","kind":"identifier"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:7IvorMXL12MXLNotationsV","text":"MXLNotations","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlnote\/notations","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/notations"}}}