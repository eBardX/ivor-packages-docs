affLayout:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"pageLayout","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLPageLayout","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL13MXLPageLayoutV"},{"text":"?, ","kind":"text"},{"text":"systemLayout","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLSystemLayout","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL15MXLSystemLayoutV"},{"text":"?, ","kind":"text"},{"text":"staffLayout","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"MXLStaffLayout","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL14MXLStaffLayoutV"},{"text":"])","kind":"text"}],"modules":[{"name":"IvorMXL"}],"symbolKind":"init","role":"symbol"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxllayout\/init(pagelayout:systemlayout:stafflayout:)"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLayout\/init(pageLayout:systemLayout:staffLayout:)"},"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLayout"]]},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLSystemLayout":{"abstract":[{"type":"text","text":"A system is a group of staves that are read and played simultaneously. System layout includes left and right"},{"type":"text","text":" "},{"type":"text","text":"margins and the vertical distance from the previous system. The system distance is measured from the bottom"},{"type":"text","text":" "},{"type":"text","text":"line of the previous system to the top line of the current system. It is ignored for the first system on a"},{"type":"text","text":" "},{"type":"text","text":"page. The top system distance is measured from the page’s top margin to the top line of the first system. It"},{"type":"text","text":" "},{"type":"text","text":"is ignored for all but the first system on a page."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSystemLayout","kind":"identifier"}],"title":"MXLSystemLayout","navigatorTitle":[{"text":"MXLSystemLayout","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlsystemlayout","type":"topic","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemLayout"},"doc://IvorMXL/documentation/IvorMXL/MXLStaffLayout":{"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLStaffLayout","kind":"identifier"}],"title":"MXLStaffLayout","navigatorTitle":[{"text":"MXLStaffLayout","kind":"identifier"}],"abstract":[{"text":"Staff layout includes the vertical distance from the bottom line of the previous staff in this system to the","type":"text"},{"text":" ","type":"text"},{"text":"top line of the staff specified by the number attribute. The optional number attribute refers to staff numbers","type":"text"},{"text":" ","type":"text"},{"text":"within the part, from top to bottom on the system. A value of 1 is used if not present.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffLayout","type":"topic","url":"\/documentation\/ivormxl\/mxlstafflayout","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLLayout/init(pageLayout:systemLayout:staffLayout:)":{"abstract":[{"text":"Creates a new ","type":"text"},{"type":"codeVoice","code":"MXLLayout"},{"text":".","type":"text"}],"kind":"symbol","type":"topic","title":"init(pageLayout:systemLayout:staffLayout:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"pageLayout"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL13MXLPageLayoutV","text":"MXLPageLayout"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"systemLayout"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL15MXLSystemLayoutV","text":"MXLSystemLayout"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"staffLayout"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL14MXLStaffLayoutV","text":"MXLStaffLayout"},{"kind":"text","text":"])"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLayout\/init(pageLayout:systemLayout:staffLayout:)","role":"symbol","url":"\/documentation\/ivormxl\/mxllayout\/init(pagelayout:systemlayout:stafflayout:)"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLLayout":{"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLLayout","kind":"identifier"}],"title":"MXLLayout","navigatorTitle":[{"text":"MXLLayout","kind":"identifier"}],"abstract":[{"text":"The layout group specifies the sequence of page, system, and staff layout elements that is common to both the","type":"text"},{"text":" ","type":"text"},{"text":"defaults and print elements.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLayout","type":"topic","url":"\/documentation\/ivormxl\/mxllayout","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLPageLayout":{"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPageLayout","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPageLayout","title":"MXLPageLayout","url":"\/documentation\/ivormxl\/mxlpagelayout","kind":"symbol","navigatorTitle":[{"text":"MXLPageLayout","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"Page layout can be defined both in score-wide defaults and in the print element. Page margins are specified"},{"type":"text","text":" "},{"type":"text","text":"either for both even and odd pages, or via separate odd and even page number values. The type is not needed"},{"type":"text","text":" "},{"type":"text","text":"when used as part of a print element. If omitted when used in the defaults element, “both” is the default."}]}}}