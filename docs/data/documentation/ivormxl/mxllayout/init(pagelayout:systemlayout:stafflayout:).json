"},{"text":"?, ","kind":"text"},{"text":"staffLayout","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"MXLStaffLayout","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL14MXLStaffLayoutV"},{"text":"])","kind":"text"}],"kind":"symbol","abstract":[{"text":"Creates a new ","type":"text"},{"code":"MXLLayout","type":"codeVoice"},{"text":".","type":"text"}],"type":"topic","title":"init(pageLayout:systemLayout:staffLayout:)"},"doc://IvorMXL/documentation/IvorMXL/MXLStaffLayout":{"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffLayout","abstract":[{"type":"text","text":"Staff layout includes the vertical distance from the bottom line of the previous staff in this system to the"},{"type":"text","text":" "},{"type":"text","text":"top line of the staff specified by the number attribute. The optional number attribute refers to staff numbers"},{"type":"text","text":" "},{"type":"text","text":"within the part, from top to bottom on the system. A value of 1 is used if not present."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLStaffLayout"}],"title":"MXLStaffLayout","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLStaffLayout"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlstafflayout"},"doc://IvorMXL/documentation/IvorMXL/MXLLayout":{"role":"symbol","url":"\/documentation\/ivormxl\/mxllayout","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLayout","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLLayout","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"The layout group specifies the sequence of page, system, and staff layout elements that is common to both the","type":"text"},{"text":" ","type":"text"},{"text":"defaults and print elements.","type":"text"}],"type":"topic","navigatorTitle":[{"text":"MXLLayout","kind":"identifier"}],"title":"MXLLayout"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLPageLayout":{"navigatorTitle":[{"text":"MXLPageLayout","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlpagelayout","type":"topic","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPageLayout","title":"MXLPageLayout","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPageLayout","kind":"identifier"}],"abstract":[{"text":"Page layout can be defined both in score-wide defaults and in the print element. Page margins are specified","type":"text"},{"text":" ","type":"text"},{"text":"either for both even and odd pages, or via separate odd and even page number values. The type is not needed","type":"text"},{"text":" ","type":"text"},{"text":"when used as part of a print element. If omitted when used in the defaults element, “both” is the default.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLSystemLayout":{"title":"MXLSystemLayout","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLSystemLayout"}],"navigatorTitle":[{"text":"MXLSystemLayout","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemLayout","url":"\/documentation\/ivormxl\/mxlsystemlayout","type":"topic","abstract":[{"type":"text","text":"A system is a group of staves that are read and played simultaneously. System layout includes left and right"},{"type":"text","text":" "},{"type":"text","text":"margins and the vertical distance from the previous system. The system distance is measured from the bottom"},{"type":"text","text":" "},{"type":"text","text":"line of the previous system to the top line of the current system. It is ignored for the first system on a"},{"type":"text","text":" "},{"type":"text","text":"page. The top system distance is measured from the page’s top margin to the top line of the first system. It"},{"type":"text","text":" "},{"type":"text","text":"is ignored for all but the first system on a page."}],"role":"symbol"}}}