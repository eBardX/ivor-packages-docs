L\/documentation\/IvorMXL\/MXLPageLayout","kind":"symbol","url":"\/documentation\/ivormxl\/mxlpagelayout","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPageLayout","kind":"identifier"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLSystemLayout":{"navigatorTitle":[{"text":"MXLSystemLayout","kind":"identifier"}],"abstract":[{"text":"A system is a group of staves that are read and played simultaneously. System layout includes left and right","type":"text"},{"text":" ","type":"text"},{"text":"margins and the vertical distance from the previous system. The system distance is measured from the bottom","type":"text"},{"text":" ","type":"text"},{"text":"line of the previous system to the top line of the current system. It is ignored for the first system on a","type":"text"},{"text":" ","type":"text"},{"text":"page. The top system distance is measured from the page’s top margin to the top line of the first system. It","type":"text"},{"text":" ","type":"text"},{"text":"is ignored for all but the first system on a page.","type":"text"}],"title":"MXLSystemLayout","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemLayout","kind":"symbol","url":"\/documentation\/ivormxl\/mxlsystemlayout","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSystemLayout","kind":"identifier"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLStaffLayout":{"navigatorTitle":[{"text":"MXLStaffLayout","kind":"identifier"}],"abstract":[{"text":"Staff layout includes the vertical distance from the bottom line of the previous staff in this system to the","type":"text"},{"text":" ","type":"text"},{"text":"top line of the staff specified by the number attribute. The optional number attribute refers to staff numbers","type":"text"},{"text":" ","type":"text"},{"text":"within the part, from top to bottom on the system. A value of 1 is used if not present.","type":"text"}],"title":"MXLStaffLayout","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffLayout","kind":"symbol","url":"\/documentation\/ivormxl\/mxlstafflayout","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLStaffLayout","kind":"identifier"}],"role":"symbol"}}}