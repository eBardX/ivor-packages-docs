"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPageLayout","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLStaffLayout":{"role":"symbol","kind":"symbol","title":"MXLStaffLayout","abstract":[{"type":"text","text":"Staff layout includes the vertical distance from the bottom line of the previous staff in this system to the"},{"type":"text","text":" "},{"type":"text","text":"top line of the staff specified by the number attribute. The optional number attribute refers to staff numbers"},{"type":"text","text":" "},{"type":"text","text":"within the part, from top to bottom on the system. A value of 1 is used if not present."}],"url":"\/documentation\/ivormxl\/mxlstafflayout","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLStaffLayout","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffLayout","navigatorTitle":[{"text":"MXLStaffLayout","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLSystemLayout":{"role":"symbol","kind":"symbol","title":"MXLSystemLayout","abstract":[{"type":"text","text":"A system is a group of staves that are read and played simultaneously. System layout includes left and right"},{"type":"text","text":" "},{"type":"text","text":"margins and the vertical distance from the previous system. The system distance is measured from the bottom"},{"type":"text","text":" "},{"type":"text","text":"line of the previous system to the top line of the current system. It is ignored for the first system on a"},{"type":"text","text":" "},{"type":"text","text":"page. The top system distance is measured from the page’s top margin to the top line of the first system. It"},{"type":"text","text":" "},{"type":"text","text":"is ignored for all but the first system on a page."}],"url":"\/documentation\/ivormxl\/mxlsystemlayout","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSystemLayout","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemLayout","navigatorTitle":[{"text":"MXLSystemLayout","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLLayout":{"role":"symbol","kind":"symbol","title":"MXLLayout","abstract":[{"type":"text","text":"The layout group specifies the sequence of page, system, and staff layout elements that is common to both the"},{"type":"text","text":" "},{"type":"text","text":"defaults and print elements."}],"url":"\/documentation\/ivormxl\/mxllayout","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLLayout","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLayout","navigatorTitle":[{"text":"MXLLayout","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLLayout/init(pageLayout:systemLayout:staffLayout:)":{"role":"symbol","kind":"symbol","title":"init(pageLayout:systemLayout:staffLayout:)","abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLLayout"},{"type":"text","text":"."}],"url":"\/documentation\/ivormxl\/mxllayout\/init(pagelayout:systemlayout:stafflayout:)","type":"topic","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"pageLayout","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLPageLayout","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL13MXLPageLayoutV"},{"text":"?, ","kind":"text"},{"text":"systemLayout","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLSystemLayout","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL15MXLSystemLayoutV"},{"text":"?, ","kind":"text"},{"