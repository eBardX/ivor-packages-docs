["swift"]}]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLKey":{"type":"topic","abstract":[{"text":"The key type represents a key signature. Both traditional and non-traditional key signatures are supported.","type":"text"},{"text":" ","type":"text"},{"text":"The optional number attribute refers to staff numbers. If absent, the key signature applies to all staves in","type":"text"},{"text":" ","type":"text"},{"text":"the part. Key signatures appear at the start of each system unless the print-object attribute has been set to","type":"text"},{"text":" ","type":"text"},{"text":"“no”.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlkey","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLKey","kind":"identifier"}],"kind":"symbol","title":"MXLKey","navigatorTitle":[{"text":"MXLKey","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLKey","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLKey/Octave-swift.struct":{"type":"topic","abstract":[{"text":"The key-octave type specifies in which octave an element of a key signature appears. The content specifies the","type":"text"},{"text":" ","type":"text"},{"text":"octave value using the same values as the display-octave element. The number attribute is a positive integer","type":"text"},{"text":" ","type":"text"},{"text":"that refers to the key signature element in left-to-right order. If the cancel attribute is set to yes, then","type":"text"},{"text":" ","type":"text"},{"text":"this number refers to the canceling key signature specified by the cancel element in the parent key element.","type":"text"},{"text":" ","type":"text"},{"text":"The cancel attribute cannot be set to yes if there is no corresponding cancel element within the parent key","type":"text"},{"text":" ","type":"text"},{"text":"element. It is no by default.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlkey\/octave-swift.struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Octave","kind":"identifier"}],"kind":"symbol","title":"MXLKey.Octave","navigatorTitle":[{"text":"Octave","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLKey\/Octave-swift.struct","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLKey/Octave-swift.struct/!=(_:_:)":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLKey\/Octave-swift.struct\/!=(_:_:)","abstract":[],"type":"topic","kind":"symbol","title":"!=(_:_:)","role":"symbol","url":"\/documentation\/ivormxl\/mxlkey\/octave-swift.struct\/!=(_:_:)","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"!="},{"kind":"text","text":" "},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}]}}}