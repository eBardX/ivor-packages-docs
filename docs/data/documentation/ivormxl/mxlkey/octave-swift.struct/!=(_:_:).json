ole":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLKey\/Octave-swift.struct\/!=(_:_:)"},"doc://IvorMXL/documentation/IvorMXL/MXLKey":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLKey"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLKey","title":"MXLKey","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLKey"}],"abstract":[{"text":"The key type represents a key signature. Both traditional and non-traditional key signatures are supported.","type":"text"},{"text":" ","type":"text"},{"text":"The optional number attribute refers to staff numbers. If absent, the key signature applies to all staves in","type":"text"},{"text":" ","type":"text"},{"text":"the part. Key signatures appear at the start of each system unless the print-object attribute has been set to","type":"text"},{"text":" ","type":"text"},{"text":"“no”.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlkey"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"}}}