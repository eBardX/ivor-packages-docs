{"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLKey","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLKey\/Octave-swift.struct"]]},"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLKey\/Octave-swift.struct\/number","interfaceLanguage":"swift"},"metadata":{"fragments":[{"text":"let","kind":"keyword"},{"kind":"text","text":" "},{"text":"number","kind":"identifier"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}],"roleHeading":"Instance Property","title":"number","modules":[{"name":"IvorMXL"}],"symbolKind":"property","role":"symbol","externalID":"s:7IvorMXL6MXLKeyV6OctaveV6numberSivp"},"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"abstract":[{"type":"text","text":"A positive integer that refers to the key signature element in left-to-right order."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlkey\/octave-swift.struct\/number"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"let","kind":"keyword"},{"kind":"text","text":" "},{"text":"number","kind":"identifier"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}],"platforms":["macOS"],"languages":["swift"]}]},{"content":[{"anchor":"discussion","text":"Discussion","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Maps to the MusicXML "},{"type":"codeVoice","code":"number"},{"type":"text","text":" attribute."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLKey":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLKey"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLKey","title":"MXLKey","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLKey"}],"abstract":[{"text":"The key type represents a key signature. Both traditional and non-traditional key signatures are supported.","type":"text"},{"text":" ","type":"text"},{"text":"The optional number attribute refers to staff numbers. If absent, the key signature applies to all staves in","type":"text"},{"text":" ","type":"text"},{"text":"the part. Key signatures appear at the start of each system unless the print-object attribute has been set to","type":"text"},{"text":" ","type":"text"},{"text":"“no”.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlkey"},"doc://IvorMXL/documentation/IvorMXL/MXLKey/Octave-swift.struct":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Octave","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLKey\/Octave-swift.struct","title":"MXLKey.Octave","kind":"symbol","navigatorTitle":[{"text":"Octave","kind":"identifier"}],"abstract":[{"text":"The key-octave type specifies in which octave an element of a key signature appears. The content specifies the","type":"text"},{"text":" ","type":"text"},{"text":"octave value using the same values as the display-octave element. The number attribute is a positive integer","type":"text"},{"type":"text","text":" "},{"type":"text","text":"that refers to the key signature element in left-to-right order. If the cancel attribute is set to yes, then"},{"type":"text","text":" "},{"type":"text","text":"this number refers to the canceling key signature specified by the cancel element in the parent key element."},{"type":"text","text":" "},{"type":"text","text":"The cancel attribute cannot be set to yes if there is no corresponding cancel element within the parent key"},{"text":" ","type":"text"},{"text":"element. It is no by default.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlkey\/octave-swift.struct"},"doc://IvorMXL/documentation/IvorMXL/MXLKey/Octave-swift.struct/number":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"number","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLKey\/Octave-swift.struct\/number","title":"number","kind":"symbol","abstract":[{"type":"text","text":"A positive integer that refers to the key signature element in left-to-right order."}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlkey\/octave-swift.struct\/number"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"}}}