navigatorTitle":[{"text":"Octave","kind":"identifier"}],"title":"MXLKey.Octave","role":"symbol","abstract":[{"type":"text","text":"The key-octave type specifies in which octave an element of a key signature appears. The content specifies the"},{"type":"text","text":" "},{"type":"text","text":"octave value using the same values as the display-octave element. The number attribute is a positive integer"},{"type":"text","text":" "},{"type":"text","text":"that refers to the key signature element in left-to-right order. If the cancel attribute is set to yes, then"},{"type":"text","text":" "},{"type":"text","text":"this number refers to the canceling key signature specified by the cancel element in the parent key element."},{"type":"text","text":" "},{"type":"text","text":"The cancel attribute cannot be set to yes if there is no corresponding cancel element within the parent key"},{"type":"text","text":" "},{"type":"text","text":"element. It is no by default."}]},"doc://IvorMXL/documentation/IvorMXL/MXLKey":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlkey","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLKey","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLKey"}],"kind":"symbol","abstract":[{"type":"text","text":"The key type represents a key signature. Both traditional and non-traditional key signatures are supported."},{"type":"text","text":" "},{"type":"text","text":"The optional number attribute refers to staff numbers. If absent, the key signature applies to all staves in"},{"type":"text","text":" "},{"type":"text","text":"the part. Key signatures appear at the start of each system unless the print-object attribute has been set to"},{"type":"text","text":" "},{"type":"text","text":"“no”."}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLKey"}],"title":"MXLKey"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"}}}