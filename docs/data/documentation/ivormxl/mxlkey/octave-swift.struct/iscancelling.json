orMXL\/documentation\/IvorMXL\/MXLKey\/Octave-swift.struct"]]},"references":{"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLKey":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLKey"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLKey","title":"MXLKey","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLKey"}],"abstract":[{"text":"The key type represents a key signature. Both traditional and non-traditional key signatures are supported.","type":"text"},{"text":" ","type":"text"},{"text":"The optional number attribute refers to staff numbers. If absent, the key signature applies to all staves in","type":"text"},{"text":" ","type":"text"},{"text":"the part. Key signatures appear at the start of each system unless the print-object attribute has been set to","type":"text"},{"text":" ","type":"text"},{"text":"“no”.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlkey"},"doc://IvorMXL/documentation/IvorMXL/MXLKey/Octave-swift.struct/isCancelling":{"kind":"symbol","title":"isCancelling","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isCancelling","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLKey\/Octave-swift.struct\/isCancelling","url":"\/documentation\/ivormxl\/mxlkey\/octave-swift.struct\/iscancelling","type":"topic","role":"symbol","abstract":[{"type":"text","text":"A Boolean value indicating whether this number refers to the canceling key signature specified by the"},{"type":"text","text":" "},{"type":"text","text":"cancel element in the parent key element, rather than to the new key signature. Cannot be "},{"type":"codeVoice","code":"true"},{"type":"text","text":" if there"},{"type":"text","text":" "},{"type":"text","text":"is no corresponding cancel element within the parent key element."}]},"doc://IvorMXL/documentation/IvorMXL/MXLKey/Octave-swift.struct":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Octave","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLKey\/Octave-swift.struct","title":"MXLKey.Octave","kind":"symbol","navigatorTitle":[{"text":"Octave","kind":"identifier"}],"abstract":[{"text":"The key-octave type specifies in which octave an element of a key signature appears. The content specifies the","type":"text"},{"text":" ","type":"text"},{"text":"octave value using the same values as the display-octave element. The number attribute is a positive integer","type":"text"},{"type":"text","text":" "},{"type":"text","text":"that refers to the key signature element in left-to-right order. If the cancel attribute is set to yes, then"},{"type":"text","text":" "},{"type":"text","text":"this number refers to the canceling key signature specified by the cancel element in the parent key element."},{"type":"text","text":" "},{"type":"text","text":"The cancel attribute cannot be set to yes if there is no corresponding cancel element within the parent key"},{"text":" ","type":"text"},{"text":"element. It is no by default.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlkey\/octave-swift.struct"}}}