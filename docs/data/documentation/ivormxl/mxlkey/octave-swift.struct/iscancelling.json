{"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLKey","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLKey\/Octave-swift.struct"]]},"metadata":{"role":"symbol","modules":[{"name":"IvorMXL"}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"isCancelling"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":"?"}],"symbolKind":"property","externalID":"s:7IvorMXL6MXLKeyV6OctaveV12isCancellingSbSgvp","title":"isCancelling","roleHeading":"Instance Property"},"abstract":[{"text":"A Boolean value indicating whether this number refers to the canceling key signature specified by the","type":"text"},{"text":" ","type":"text"},{"text":"cancel element in the parent key element, rather than to the new key signature. Cannot be ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" if there","type":"text"},{"text":" ","type":"text"},{"text":"is no corresponding cancel element within the parent key element.","type":"text"}],"sections":[],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"isCancelling"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":"?"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Maps to the MusicXML "},{"code":"cancel","type":"codeVoice"},{"type":"text","text":" attribute."}]}],"kind":"content"}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlkey\/octave-swift.struct\/iscancelling"]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLKey\/Octave-swift.struct\/isCancelling"},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLKey/Octave-swift.struct/isCancelling":{"type":"topic","abstract":[{"text":"A Boolean value indicating whether this number refers to the canceling key signature specified by the","type":"text"},{"text":" ","type":"text"},{"text":"cancel element in the parent key element, rather than to the new key signature. Cannot be ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" if there","type":"text"},{"text":" ","type":"text"},{"text":"is no corresponding cancel element within the parent key element.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlkey\/octave-swift.struct\/iscancelling","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"isCancelling"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":"?"}],"kind":"symbol","title":"isCancelling","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLKey\/Octave-swift.struct\/isCancelling","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLKey":{"type":"topic","abstract":[{"text":"The key type represents a key signature. Both traditional and non-traditional key signatures are supported.","type":"text"},{"text":" ","type":"text"},{"text":"The optional number attribute refers to staff numbers. If absent, the key signature applies to all staves in","type":"text"},{"text":" ","type":"text"},{"text":"the part. Key signatures appear at the start of each system unless the print-object attribute has been set to","type":"text"},{"text":" ","type":"text"},{"text":"“no”.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlkey","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLKey","kind":"identifier"}],"kind":"symbol","title":"MXLKey","navigatorTitle":[{"text":"MXLKey","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLKey","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLKey/Octave-swift.struct":{"type":"topic","abstract":[{"text":"The key-octave type specifies in which octave an element of a key signature appears. The content specifies the","type":"text"},{"text":" ","type":"text"},{"text":"octave value using the same values as the display-octave element. The number attribute is a positive integer","type":"text"},{"text":" ","type":"text"},{"text":"that refers to the key signature element in left-to-right order. If the cancel attribute is set to yes, then","type":"text"},{"text":" ","type":"text"},{"text":"this number refers to the canceling key signature specified by the cancel element in the parent key element.","type":"text"},{"text":" ","type":"text"},{"text":"The cancel attribute cannot be set to yes if there is no corresponding cancel element within the parent key","type":"text"},{"text":" ","type":"text"},{"text":"element. It is no by default.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlkey\/octave-swift.struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Octave","kind":"identifier"}],"kind":"symbol","title":"MXLKey.Octave","navigatorTitle":[{"text":"Octave","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLKey\/Octave-swift.struct","role":"symbol"}}}