type":"text"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLKey/Octave-swift.struct/isCancelling":{"kind":"symbol","url":"\/documentation\/ivormxl\/mxlkey\/octave-swift.struct\/iscancelling","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLKey\/Octave-swift.struct\/isCancelling","role":"symbol","title":"isCancelling","abstract":[{"type":"text","text":"A Boolean value indicating whether this number refers to the canceling key signature specified by the"},{"type":"text","text":" "},{"type":"text","text":"cancel element in the parent key element, rather than to the new key signature. Cannot be "},{"code":"true","type":"codeVoice"},{"type":"text","text":" if there"},{"type":"text","text":" "},{"type":"text","text":"is no corresponding cancel element within the parent key element."}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isCancelling","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":"?","kind":"text"}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLKey":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlkey","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLKey","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLKey"}],"kind":"symbol","abstract":[{"type":"text","text":"The key type represents a key signature. Both traditional and non-traditional key signatures are supported."},{"type":"text","text":" "},{"type":"text","text":"The optional number attribute refers to staff numbers. If absent, the key signature applies to all staves in"},{"type":"text","text":" "},{"type":"text","text":"the part. Key signatures appear at the start of each system unless the print-object attribute has been set to"},{"type":"text","text":" "},{"type":"text","text":"“no”."}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLKey"}],"title":"MXLKey"},"doc://IvorMXL/documentation/IvorMXL/MXLKey/Octave-swift.struct":{"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLKey\/Octave-swift.struct","kind":"symbol","url":"\/documentation\/ivormxl\/mxlkey\/octave-swift.struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Octave","kind":"identifier"}],"navigatorTitle":[{"text":"Octave","kind":"identifier"}],"title":"MXLKey.Octave","role":"symbol","abstract":[{"type":"text","text":"The key-octave type specifies in which octave an element of a key signature appears. The content specifies the"},{"type":"text","text":" "},{"type":"text","text":"octave value using the same values as the display-octave element. The number attribute is a positive integer"},{"type":"text","text":" "},{"type":"text","text":"that refers to the key signature element in left-to-right order. If the cancel attribute is set to yes, then"},{"type":"text","text":" "},{"type":"text","text":"this number refers to the canceling key signature specified by the cancel element in the parent key element."},{"type":"text","text":" "},{"type":"text","text":"The cancel attribute cannot be set to yes if there is no corresponding cancel element within the parent key"},{"type":"text","text":" "},{"type":"text","text":"element. It is no by default."}]}}}