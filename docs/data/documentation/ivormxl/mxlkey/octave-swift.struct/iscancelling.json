d":"content"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLKey/Octave-swift.struct":{"url":"\/documentation\/ivormxl\/mxlkey\/octave-swift.struct","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLKey\/Octave-swift.struct","title":"MXLKey.Octave","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Octave","kind":"identifier"}],"abstract":[{"text":"The key-octave type specifies in which octave an element of a key signature appears. The content specifies the","type":"text"},{"text":" ","type":"text"},{"text":"octave value using the same values as the display-octave element. The number attribute is a positive integer","type":"text"},{"text":" ","type":"text"},{"text":"that refers to the key signature element in left-to-right order. If the cancel attribute is set to yes, then","type":"text"},{"text":" ","type":"text"},{"text":"this number refers to the canceling key signature specified by the cancel element in the parent key element.","type":"text"},{"text":" ","type":"text"},{"text":"The cancel attribute cannot be set to yes if there is no corresponding cancel element within the parent key","type":"text"},{"text":" ","type":"text"},{"text":"element. It is no by default.","type":"text"}],"role":"symbol","navigatorTitle":[{"text":"Octave","kind":"identifier"}],"type":"topic","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLKey/Octave-swift.struct/isCancelling":{"abstract":[{"text":"A Boolean value indicating whether this number refers to the canceling key signature specified by the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"cancel element in the parent key element, rather than to the new key signature. Cannot be "},{"code":"true","type":"codeVoice"},{"type":"text","text":" if there"},{"text":" ","type":"text"},{"type":"text","text":"is no corresponding cancel element within the parent key element."}],"title":"isCancelling","identifier":"doc:\/\