{"variants":[{"paths":["\/documentation\/ivormxl\/mxlkey\/octave-swift.property"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"text":"The optional list of key-octave elements is used to specify in which octave each element of the key signature","type":"text"},{"text":" ","type":"text"},{"text":"appears.","type":"text"}],"metadata":{"title":"octave","role":"symbol","roleHeading":"Instance Property","externalID":"s:7IvorMXL6MXLKeyV6octaveSayAC6OctaveVGvp","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"octave","kind":"identifier"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:7IvorMXL6MXLKeyV6OctaveV","text":"Octave","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"modules":[{"name":"IvorMXL"}],"symbolKind":"property"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"octave","kind":"identifier"},{"text":": [","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLKey\/Octave-swift.struct","preciseIdentifier":"s:7IvorMXL6MXLKeyV6OctaveV","text":"Octave","kind":"typeIdentifier"},{"text":"]","kind":"text"}]}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Maps to a nested MusicXML "},{"type":"codeVoice","code":"<key-octave>"},{"type":"text","text":" element."}],"type":"paragraph"}]}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLKey\/octave-swift.property"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLKey"]]},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLKey":{"title":"MXLKey","url":"\/documentation\/ivormxl\/mxlkey","abstract":[{"type":"text","text":"The key type represents a key signature. Both traditional and non-traditional key signatures are supported."},{"type":"text","text":" "},{"type":"text","text":"The optional number attribute refers to staff numbers. If absent, the key signature applies to all staves in"},{"type":"text","text":" "},{"type":"text","text":"the part. Key signatures appear at the start of each system unless the print-object attribute has been set to"},{"type":"text","text":" "},{"type":"text","text":"“no”."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLKey","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"MXLKey","kind":"identifier"}],"type":"topic","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLKey"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLKey/Octave-swift.struct":{"url":"\/documentation\/ivormxl\/mxlkey\/octave-swift.struct","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLKey\/Octave-swift.struct","title":"MXLKey.Octave","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Octave","kind":"identifier"}],"abstract":[{"text":"The key-octave type specifies in which octave an element of a key signature appears. The content specifies the","type":"text"},{"text":" ","type":"text"},{"text":"octave value using the same values as the display-octave element. The number attribute is a positive integer","type":"text"},{"text":" ","type":"text"},{"text":"that refers to the key signature element in left-to-right order. If the cancel attribute is set to yes, then","type":"text"},{"text":" ","type":"text"},{"text":"this number refers to the canceling key signature specified by the cancel element in the parent key element.","type":"text"},{"text":" ","type":"text"},{"text":"The cancel attribute cannot be set to yes if there is no corresponding cancel element within the parent key","type":"text"},{"text":" ","type":"text"},{"text":"element. It is no by default.","type":"text"}],"role":"symbol","navigatorTitle":[{"text":"Octave","kind":"identifier"}],"type":"topic","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLKey/octave-swift.property":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLKey\/octave-swift.property","type":"topic","abstract":[{"type":"text","text":"The optional list of key-octave elements is used to specify in which octave each element of the key signature"},{"type":"text","text":" "},{"type":"text","text":"appears."}],"url":"\/documentation\/ivormxl\/mxlkey\/octave-swift.property","role":"symbol","title":"octave","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"octave","kind":"identifier"},{"text":": [","kind":"text"},{"text":"Octave","preciseIdentifier":"s:7IvorMXL6MXLKeyV6OctaveV","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"kind":"symbol"}}}