"title":"MXLKey","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLKey","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLKey","abstract":[{"text":"The key type represents a key signature. Both traditional and non-traditional key signatures are supported.","type":"text"},{"text":" ","type":"text"},{"text":"The optional number attribute refers to staff numbers. If absent, the key signature applies to all staves in","type":"text"},{"text":" ","type":"text"},{"text":"the part. Key signatures appear at the start of each system unless the print-object attribute has been set to","type":"text"},{"text":" ","type":"text"},{"text":"“no”.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLKey/octave-swift.property":{"title":"octave","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"octave"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL6MXLKeyV6OctaveV","text":"Octave"},{"kind":"text","text":"]"}],"kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxlkey\/octave-swift.property","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLKey\/octave-swift.property","abstract":[{"type":"text","text":"The optional list of key-octave elements is used to specify in which octave each element of the key signature"},{"type":"text","text":" "},{"type":"text","text":"appears."}]},"doc://IvorMXL/documentation/IvorMXL/MXLKey/Octave-swift.struct":{"kind":"symbol","navigatorTitle":[{"text":"Octave","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlkey\/octave-swift.struct","title":"MXLKey.Octave","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Octave","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLKey\/Octave-swift.struct","abstract":[{"text":"The key-octave type specifies in which octave an element of a key signature appears. The content specifies the","type":"text"},{"type":"text","text":" "},{"text":"octave value using the same values as the display-octave element. The number attribute is a positive integer","type":"text"},{"text":" ","type":"text"},{"text":"that refers to the key signature element in left-to-right order. If the cancel attribute is set to yes, then","type":"text"},{"type":"text","text":" "},{"type":"text","text":"this number refers to the canceling key signature specified by the cancel element in the parent key element."},{"type":"text","text":" "},{"type":"text","text":"The cancel attribute cannot be set to yes if there is no corresponding cancel element within the parent key"},{"text":" ","type":"text"},{"text":"element. It is no by default.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"}}}