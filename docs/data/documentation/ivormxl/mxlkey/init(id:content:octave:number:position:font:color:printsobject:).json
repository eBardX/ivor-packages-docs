ext":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":"? = nil)","kind":"text"}],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The optional-unique-id attribute group allows an element to optionally specify an ID that is unique to the entire document. This attribute group is not used for a required id attribute, or for an id attribute that specifies an id reference.","type":"text"}]}],"name":"id"},{"content":[{"type":"paragraph","inlineContent":[{"text":"One of the alternatives for Key.","type":"text"}]}],"name":"content"},{"name":"octave","content":[{"inlineContent":[{"type":"text","text":"The optional list of key-octave elements is used to specify in which octave each element of the key signature appears."}],"type":"paragraph"}]},{"name":"number","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The staff number that this element applies to. If absent, the key signature applies to all staves in the part."}]}]},{"name":"position","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For most elements, any program will compute a default x and y position. The position attributes let this be changed two ways."}]}]},{"name":"font","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The font attribute group gathers together attributes for determining the font within a credit or direction. They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font vs. a music font."}]}]},{"name":"color","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The color attribute group indicates the color of an element."}]}]},{"name":"printsObject","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A Boolean value indicating whether to print an object (e.g. a note or a rest). Defaults to "},{"type":"codeVoice","code":"true"},{"type":"text","text":" if not specified."}]}]}],"kind":"parameters"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLKey\/init(id:content:octave:number:position:font:color:printsObject:)","interfaceLanguage":"swift"},"metadata":{"roleHeading":"Initializer","symbolKind":"init","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"id"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"content"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL6MXLKeyV7ContentO","kind":"typeIdentifier","text":"Content"},{"kind":"text","text":", "},{"kind":"externalParam","text":"octave"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:7IvorMXL6MXLKeyV6OctaveV","kind":"typeIdentifier","text":"Octave"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"number"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL14MXLStaffNumberV","text":"MXLStaffNumber"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"position"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLPositionV","text":"MXLPosition"},{"kind":"text","text":", "},{"kind":"externalParam","text":"font"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL7MXLFontV","text":"MXLFont"},{"kind":"text","text":", "},{"kind":"externalParam","text":"color"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLColorV","text":"MXLColor"},{"text":"?, ","kind":"text"},{"text":"printsObject","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":"?)","kind":"text"}],"title":"init(id:content:octave:number:position:font:color:printsObject:)","externalID":"s:7IvorMXL6MXLKeyV2id7content6octave6number8position4font5color12printsObjectACSSSg_AC7ContentOSayAC6OctaveVGAA14MXLStaffNumberVSgAA11MXLPositionVAA7MXLFontVAA8MXLColorVSgSbSgtcfc","modules":[{"name":"IvorMXL"}],"role":"symbol"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLKey"]]},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlkey\/init(id:content:octave:number:position:font:color:printsobject:)"]}],"abstract":[{"text":"Creates a new ","type":"text"},{"code":"MXLKey","type":"codeVoice"},{"text":".","type":"text"}],"sections":[],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLKey/Octave-swift.struct":{"kind":"symbol","navigatorTitle":[{"text":"Octave","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlkey\/octave-swift.struct","title":"MXLKey.Octave","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Octave","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLKey\/Octave-swift.struct","abstract":[{"text":"The key-octave type specifies in which octave an element of a key signature appears. The content specifies the","type":"text"},{"type":"text","text":" "},{"text":"octave value using the same values as the display-octave element. The number attribute is a positive integer","type":"text"},{"text":" ","type":"text"},{"text":"that refers to the key signature element in left-to-right order. If the cancel attribute is set to yes, then","type":"text"},{"type":"text","text":" "},{"type":"text","text":"this number refers to the canceling key signature specified by the cancel element in the parent key element."},{"type":"text","text":" "},{"type":"text","text":"The cancel attribute cannot be set to yes if there is no corresponding cancel element within the parent key"},{"text":" ","type":"text"},{"text":"element. It is no by default.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"abstract":[{"text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in","type":"text"},{"type":"text","text":" "},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"title":"MXLColor","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlcolor","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor"},"doc://IvorMXL/documentation/IvorMXL/MXLKey":{"kind":"symbol","navigatorTitle":[{"text":"MXLKey","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlkey","title":"MXLKey","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLKey","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLKey","abstract":[{"text":"The key type represents a key signature. Both traditional and non-traditional key signatures are supported.","type":"text"},{"text":" ","type":"text"},{"text":"The optional number attribute refers to staff numbers. If absent, the key signature applies to all staves in","type":"text"},{"text":" ","type":"text"},{"text":"the part. Key signatures appear at the start of each system unless the print-object attribute has been set to","type":"text"},{"text":" ","type":"text"},{"text":"“no”.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLKey/init(id:content:octave:number:positi