,"kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLStaffNumber","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"MXLStaffNumber","kind":"identifier"}],"abstract":[{"text":"The staff-number type indicates staff numbers within a multi-staff part. Staves are numbered from top to","type":"text"},{"type":"text","text":" "},{"type":"text","text":"bottom, with 1 being the top staff on a part."}],"url":"\/documentation\/ivormxl\/mxlstaffnumber","title":"MXLStaffNumber","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffNumber","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLPosition":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlposition","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPosition"}],"kind":"symbol","abstract":[{"text":"For most elements, any program will compute a default x and y position. The position attributes let this be","type":"text"},{"text":" ","type":"text"},{"text":"changed two ways.","type":"text"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLPosition"}],"title":"MXLPosition"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLKey/Content-swift.enum":{"abstract":[{"text":"One of the alternatives for Key.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLKey\/Content-swift.enum","kind":"symbol","url":"\/documentation\/ivormxl\/mxlkey\/content-swift.enum","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Content","kind":"identifier"}],"navigatorTitle":[{"text":"Content","kind":"identifier"}],"title":"MXLKey.Content","role":"symbol","type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLKey":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlkey","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLKey","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLKey"}],"kind":"symbol","abstract":[{"type":"text","text":"The key type represents a key signature. Both traditional and non-traditional key signatures are supported."},{"type":"text","text":" "},{"type":"text","text":"The optional number attribute refers to staff numbers. If absent, the key signature applies to all staves in"},{"type":"text","text":" "},{"type":"text","text":"the part. Key signatures appear at the start of each system unless the print-object attribute has been set to"},{"type":"text","text":" "},{"type":"text","text":"“no”."}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLKey"}],"title":"MXLKey"},"doc://IvorMXL/documentation/IvorMXL/MXLKey/Octave-swift.struct":{"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLKey\/Octave-swift.struct","kind":"symbol","url":"\/documentation\/ivormxl\/mxlkey\/octave-swift.struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Octave","kind":"identifier"}],"navigatorTitle":[{"text":"Octave","kind":"identifier"}],"title":"MXLKey.Octave","role":"symbol","abstract":[{"type":"text","text":"The key-octave type specifies in which octave an element of a key signature appears. The content specifies the"},{"type":"text","text":" "},{"type":"text","text":"octave value using the same values as the display-octave element. The number attribute is a positive integer"},{"type":"text","text":" "},{"type":"text","text":"that refers to the key signature element in left-to-right order. If the cancel attribute is set to yes, then"},{"type":"text","text":" "},{"type":"text","text":"this number refers to the canceling key signature specified by the cancel element in the parent key element."},{"type":"text","text":" "},{"type":"text","text":"The cancel attribute cannot be set to yes if there is no corresponding cancel element within the parent key"},{"type":"text","text":" "},{"type":"text","text":"element. It is no by default."}]},"doc://IvorMXL/documentation/IvorMXL/MXLKey/init(id:content:octave:number:position:font:color:printsObject:)":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLKey\/init(id:content:octave:number:position:font:color:printsObject:)","role":"symbol","kind":"symbol","url":"\/documentation\/ivormxl\/mxlkey\/init(id:content:octave:number:position:font:color:printsobject:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"id"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"content"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL6MXLKeyV7ContentO","text":"Content"},{"kind":"text","text":", "},{"kind":"externalParam","text":"octave"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL6MXLKeyV6OctaveV","text":"Octave"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"number"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL14MXLStaffNumberV","text":"MXLStaffNumber"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"position"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLPositionV","text":"MXLPosition"},{"kind":"text","text":", "},{"kind":"externalParam","text":"font"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL7MXLFontV","text":"MXLFont"},{"kind":"text","text":", "},{"kind":"externalParam","text":"color"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLColorV","text":"MXLColor"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"printsObject"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":"?)"}],"type":"topic","title":"init(id:content:octave:number:position:font:color:printsObject:)","abstract":[{"type":"text","text":"Creates a new "},{"code":"MXLKey","type":"codeVoice"},{"type":"text","text":"."}]},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"title":"MXLColor","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"abstract":[{"text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in","type":"text"},{"text":" ","type":"text"},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"url":"\/documentation\/ivormxl\/mxlcolor"}}}