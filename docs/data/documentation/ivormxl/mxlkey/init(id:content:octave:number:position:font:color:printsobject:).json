pe":"text"}]}]},{"name":"color","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The color attribute group indicates the color of an element."}]}]},{"name":"printsObject","content":[{"type":"paragraph","inlineContent":[{"text":"A Boolean value indicating whether to print an object (e.g. a note or a rest). Defaults to ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" if not specified.","type":"text"}]}]}]}],"metadata":{"externalID":"s:7IvorMXL6MXLKeyV2id7content6octave6number8position4font5color12printsObjectACSSSg_AC7ContentOSayAC6OctaveVGAA14MXLStaffNumberVSgAA11MXLPositionVAA7MXLFontVAA8MXLColorVSgSbSgtcfc","title":"init(id:content:octave:number:position:font:color:printsObject:)","modules":[{"name":"IvorMXL"}],"roleHeading":"Initializer","role":"symbol","symbolKind":"init","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"content","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL6MXLKeyV7ContentO","text":"Content","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"octave","kind":"externalParam"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:7IvorMXL6MXLKeyV6OctaveV","text":"Octave","kind":"typeIdentifier"},{"text":"], ","kind":"text"},{"text":"number","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL14MXLStaffNumberV","text":"MXLStaffNumber","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"position","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL11MXLPositionV","text":"MXLPosition","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"font","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL7MXLFontV","text":"MXLFont","kind":"typeIdentifier"},{"text":", ","ki