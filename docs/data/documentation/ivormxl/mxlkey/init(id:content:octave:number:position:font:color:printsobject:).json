nt-family is a comma-separated list of","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric"},{"type":"text","text":" "},{"type":"text","text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font"},{"type":"text","text":" "},{"type":"text","text":"vs. a music font."}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLFont","kind":"identifier"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLKey":{"title":"MXLKey","url":"\/documentation\/ivormxl\/mxlkey","abstract":[{"type":"text","text":"The key type represents a key signature. Both traditional and non-traditional key signatures are supported."},{"type":"text","text":" "},{"type":"text","text":"The optional number attribute refers to staff numbers. If absent, the key signature applies to all staves in"},{"type":"text","text":" "},{"type":"text","text":"the part. Key signatures appear at the start of each system unless the print-object attribute has been set to"},{"type":"text","text":" "},{"type":"text","text":"“no”."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLKey","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"MXLKey","kind":"identifier"}],"type":"topic","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLKey"},"doc://IvorMXL/documentation/IvorMXL/MXLKey/Octave-swift.struct":{"url":"\/documentation\/ivormxl\/mxlkey\/octave-swift.struct","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLKey\/Octave-swift.struct","title":"MXLKey.Octave","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Octave","kind":"identifier"}],"abstract":[{"text":"The key-octave type specifies in which octave an element of a key signature appears. The content specifies the","type":"text"},{"text":" ","type":"text"},{"text":"octave value using the same values as the display-octave element. The number attribute is a positive integer","type":"text"},{"text":" ","type":"text"},{"text":"that refers to the key signature element in left-to-right order. If the cancel attribute is set to yes, then","type":"text"},{"text":" ","type":"text"},{"text":"this number refers to the canceling key signature specified by the cancel element in the parent key element.","type":"text"},{"text":" ","type":"text"},{"text":"The cancel attribute cannot be set to yes if there is no corresponding cancel element within the parent key","type":"text"},{"text":" ","type":"text"},{"text":"element. It is no by default.","type":"text"}],"role":"symbol","navigatorTitle":[{"text":"Octave","kind":"identifier"}],"type":"topic","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLKey/init(id:content:octave:number:position:font:color:printsObject:)":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLKey\/init(id:content:octave:number:position:font:color:printsObject:)","type":"topic","abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLKey"},{"type":"text","text":"."}],"url":"\/documentation\/ivormxl\/mxlkey\/init(id:content:octave:number:position:font:color:printsobject:)","role":"symbol","title":"init(id:content:octave:number:position:font:color:printsObject:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"content","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Content","preciseIdentifier":"s:7IvorMXL6MXLKeyV7ContentO","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"octave","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"Octave","preciseIdentifier":"s:7IvorMXL6MXLKeyV6OctaveV","kind":"typeIdentifier"},{"tex