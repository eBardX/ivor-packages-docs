,"preciseIdentifier":"s:Sb"},{"text":"?)","kind":"text"}]},"abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLKey"},{"type":"text","text":"."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlkey\/init(id:content:octave:number:position:font:color:printsobject:)"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLKey\/init(id:content:octave:number:position:font:color:printsObject:)"},"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"init","kind":"keyword"},{"text":"(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"content"},{"text":": ","kind":"text"},{"text":"Content","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLKey\/Content-swift.enum","preciseIdentifier":"s:7IvorMXL6MXLKeyV7ContentO"},{"text":", ","kind":"text"},{"text":"octave","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"Octave","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLKey\/Octave-swift.struct","preciseIdentifier":"s:7IvorMXL6MXLKeyV6OctaveV"},{"text":"] = [], ","kind":"text"},{"text":"number","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLStaffNumber","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffNumber","preciseIdentifier":"s:7IvorMXL14MXLStaffNumberV"},{"text":"? = nil, ","kind":"text"},{"text":"position","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLPosition","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","preciseIdentifier":"s:7IvorMXL11MXLPositionV"},{"text":" = MXLPosition(), ","kind":"text"},{"text":"font","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLFont","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","preciseIdentifier":"s:7IvorMXL7MXLFontV"},{"text":" = MXLFont(), ","kind":"text"},{"text":"color","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLColor","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","preciseIdentifier":"s:7IvorMXL8MXLColorV"},{"text":"? = nil, ","kind":"text"},{"text":"printsObject","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":"? = nil)","kind":"text"}]}]},{"parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The optional-unique-id attribute group allows an element to optionally specify an ID"},{"type":"text","text":" "},{"type":"text","text":"that is unique to the entire document. This attribute group is not used for a"},{"type":"text","text":" "},{"type":"text","text":"required id attribute, or for an id attribute that specifies an id reference."}],"type":"paragraph"}],"name":"id"},{"content":[{"inlineContent":[{"type":"text","text":"One of the alternatives for Key."}],"type":"paragraph"}],"name":"content"},{"content":[{"inlineContent":[{"type":"text","text":"The optional list of key-octave elements is used to specify in which octave each"},{"type":"text","text":" "},{"type":"text","text":"element of the key signature appears."}],"type":"paragraph"}],"name":"octave"},{"content":[{"inlineContent":[{"type":"text","text":"The staff number that this element applies to. If absent, the key signature applies"},{"type":"text","text":" "},{"type":"text","text":"to all staves in the part."}],"type":"paragraph"}],"name":"number"},{"content":[{"inlineContent":[{"type":"text","text":"For most elements, any program will compute a default x and y position. The position"},{"type":"text","text":" "},{"type":"text","text":"attributes let this be changed two ways."}],"type":"paragraph"}],"name":"position"},{"content":[{"inlineContent":[{"type":"text","text":"The font attribute group gathers together attributes for determining the font within"},{"type":"text","text":" "},{"type":"text","text":"a credit or direction. They are based on the text styles for Cascading Style Sheets."},{"type":"text","text":" "},{"type":"text","text":"The font-family is a comma-separated list of font names. The font-style can be normal"},{"type":"text","text":" "},{"type":"text","text":"or italic. The font-size can be one of the CSS sizes or a numeric point size. The"},{"type":"text","text":" "},{"type":"text","text":"font-weight can be normal or bold. The default is application-dependent, but is a"},{"type":"text","text":" "},{"type":"text","text":"text font vs. a music font."}],"type":"paragraph"}],"name":"font"},{"content":[{"inlineContent":[{"type":"text","text":"The color attribute group indicates the color of an element."}],"type":"paragraph"}],"name":"color"},{"content":[{"inlineContent":[{"type":"text","text":"A Boolean value indicating whether to print an object (e.g. a note or a rest)."},{"type":"text","text":" "},{"type":"text","text":"Defaults to "},{"type":"codeVoice","code":"true"},{"type":"text","text":" if not specified."}],"type":"paragraph"}],"name":"printsObject"}],"kind":"parameters"}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLKey":{"type":"topic","abstract":[{"text":"The key type represents a key signature. Both traditional and non-traditional key signatures are supported.","type":"text"},{"text":" ","type":"text"},{"text":"The optional number attribute refers to staff numbers. If absent, the key signature applies to all staves in","type":"text"},{"text":" ","type":"text"},{"text":"the part. Key signatures appear at the start of each system unless the print-object attribute has been set to","type":"text"},{"text":" ","type":"text"},{"text":"“no”.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlkey","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLKey","kind":"identifier"}],"kind":"symbol","title":"MXLKey","navigatorTitle":[{"text":"MXLKey","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLKey","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLStaffNumber":{"type":"topic","title":"MXLStaffNumber","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffNumber","abstract":[{"type":"text","text":"The staff-number type indicates staff numbers within a multi-staff part. Staves are numbered from top to"},{"type":"text","text":" "},{"type":"text","text":"bottom, with 1 being the top staff on a part."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLStaffNumber"}],"navigatorTitle":[{"kind":"identifier","text":"MXLStaffNumber"}],"url":"\/documentation\/ivormxl\/mxlstaffnumber"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLKey/Content-swift.enum":{"navigatorTitle":[{"kind":"identifier","text":"Content"}],"abstract":[{"type":"text","text":"One of the alternatives for Key."}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLKey\/Content-swift.enum","url":"\/documentation\/ivormxl\/mxlkey\/content-swift.enum","role":"symbol","title":"MXLKey.Content","type":"topic","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Content"}]},"doc://IvorMXL/documentation/IvorMXL/MXLKey/Octave-swift.struct":{"type":"topic","abstract":[{"text":"The key-octave type specifies in which octave an element of a key signature appears. The content specifies the","type":"text"},{"text":" ","type":"text"},{"text":"octave value using the same values as the display-octave element. The number attribute is a positive integer","type":"text"},{"text":" ","type":"text"},{"text":"that refers to the key signature element in left-to-right order. If the cancel attribute is set to yes, then","type":"text"},{"text":" ","type":"text"},{"text":"this number refers to the canceling key signature specified by the cancel element in the parent key element.","type":"text"},{"text":" ","type":"text"},{"text":"The cancel attribute cannot be set to yes if there is no corresponding cancel element within the parent key","type":"text"},{"text":" ","type":"text"},{"text":"element. It is no by default.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlkey\/octave-swift.struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Octave","kind":"identifier"}],"kind":"symbol","title":"MXLKey.Octave","navigatorTitle":[{"text":"Octave","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLKey\/Octave-swift.struct","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLPosition":{"type":"topic","abstract":[{"type":"text","text":"For most elements, any program will compute a default x and y position. The position attributes let this be"},{"type":"text","text":" "},{"type":"text","text":"changed two ways."}],"url":"\/documentation\/ivormxl\/mxlposition","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPosition"}],"kind":"symbol","title":"MXLPosition","navigatorTitle":[{"kind":"identifier","text":"MXLPosition"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"type":"topic","abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"type":"text","text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is"},{"type":"text","text":" "},{"type":"text","text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF."}],"url":"\/documentation\/ivormxl\/mxlcolor","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"kind":"symbol","title":"MXLColor","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLFont":{"type":"topic","title":"MXLFont","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","abstract":[{"type":"text","text":"The font attribute group gathers together attributes for determining the font within a credit or direction."},{"type":"text","text":" "},{"type":"text","text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of"},{"type":"text","text":" "},{"type":"text","text":"font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric"},{"type":"text","text":" "},{"type":"text","text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font"},{"type":"text","text":" "},{"type":"text","text":"vs. a music font."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFont"}],"navigatorTitle":[{"kind":"identifier","text":"MXLFont"}],"url":"\/documentation\/ivormxl\/mxlfont"},"doc://IvorMXL/documentation/IvorMXL/MXLKey/init(id:content:octave:number:position:font:color:printsObject:)":{"kind":"symbol","abstract":[{"text":"Creates a new ","type":"text"},{"type":"codeVoice","code":"MXLKey"},{"text":".","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/