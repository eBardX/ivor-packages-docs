,{"text":"? = nil)","kind":"text"}],"platforms":["macOS"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The optional-unique-id attribute group allows an element to optionally specify an ID that"},{"type":"text","text":" "},{"type":"text","text":"is unique to the entire document. This attribute group is not used for a required id"},{"type":"text","text":" "},{"type":"text","text":"attribute, or for an id attribute that specifies an id reference."}]}],"name":"id"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A Boolean value indicating whether the string mute is on ("},{"type":"codeVoice","code":"true"},{"type":"text","text":") or off ("},{"type":"codeVoice","code":"false"},{"type":"text","text":")."}]}],"name":"isOn"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For most elements, any program will compute a default x and y position. The position"},{"type":"text","text":" "},{"type":"text","text":"attributes let this be changed two ways."}]}],"name":"position"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The font attribute group gathers together attributes for determining the font within a"},{"type":"text","text":" "},{"type":"text","text":"credit or direction. They are based on the text styles for Cascading Style Sheets. The"},{"type":"text","text":" "},{"type":"text","text":"font-family is a comma-separated list of font names. The font-style can be normal or"},{"type":"text","text":" "},{"type":"text","text":"italic. The font-size can be one of the CSS sizes or a numeric point size. The"},{"type":"text","text":" "},{"type":"text","text":"font-weight can be normal or bold. The default is application-dependent, but is a text"},{"type":"text","text":" "},{"type":"text","text":"font vs. a music font."}]}],"name":"font"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The color attribute group indicates the color of an element."}]}],"name":"color"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In cases where text extends over more than one line, horizontal alignment and justify"},{"type":"text","text":" "},{"type":"text","text":"values can be different."}]}],"name":"halign"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The valign attribute is used to indicate vertical alignment to the top, middle, bottom,"},{"type":"text","text":" "},{"type":"text","text":"or baseline of the text. Defaults are implementation-dependent."}]}],"name":"valign"}]}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStringMute"]]},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"type":"topic","abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"type":"text","text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is"},{"type":"text","text":" "},{"type":"text","text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF."}],"url":"\/documentation\/ivormxl\/mxlcolor","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"kind":"symbol","title":"MXLColor","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLStringMute":{"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"