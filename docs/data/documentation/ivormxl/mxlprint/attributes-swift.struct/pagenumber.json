{"sections":[],"abstract":[{"type":"text","text":"The number of a new page. Ignored if "},{"type":"codeVoice","code":"newPage"},{"type":"text","text":" is not "},{"code":"true","type":"codeVoice"},{"type":"text","text":"."}],"variants":[{"paths":["\/documentation\/ivormxl\/mxlprint\/attributes-swift.struct\/pagenumber"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"pageNumber","kind":"identifier"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"text":"?","kind":"text"}],"title":"pageNumber","externalID":"s:7IvorMXL8MXLPrintV10AttributesV10pageNumberSSSgvp","modules":[{"name":"IvorMXL"}],"roleHeading":"Instance Property","role":"symbol","symbolKind":"property"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"pageNumber"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?"}]}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"Maps to the MusicXML ","type":"text"},{"code":"page-number","type":"codeVoice"},{"text":" attribute.","type":"text"}]}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint\/Attributes-swift.struct\/pageNumber","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint\/Attributes-swift.struct"]]},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLPrint":{"abstract":[{"type":"text","text":"The print type contains general printing parameters, including layout elements. The part-name-display and"},{"type":"text","text":" "},{"type":"text","text":"part-abbreviation-display elements may also be used here to change how a part name or abbreviation is"},{"type":"text","text":" "},{"type":"text","text":"displayed over the course of a piece. They take effect when the current measure or a succeeding measure starts"},{"type":"text","text":" "},{"type":"text","text":"a new system."}],"title":"MXLPrint","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPrint"}],"navigatorTitle":[{"kind":"identifier","text":"MXLPrint"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlprint","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint"},"doc://IvorMXL/documentation/IvorMXL/MXLPrint/Attributes-swift.struct/pageNumber":{"abstract":[{"text":"The number of a new page. Ignored if ","type":"text"},{"code":"newPage","type":"codeVoice"},{"text":" is not ","type":"text"},{"code":"true","type":"codeVoice"},{"text":".","type":"text"}],"title":"pageNumber","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"pageNumber"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlprint\/attributes-swift.struct\/pagenumber","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint\/Attributes-swift.struct\/pageNumber"},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLPrint/Attributes-swift.struct":{"abstract":[{"type":"text","text":"The print-attributes group is used by the print element. The new-system and new-page attributes indicate"},{"type":"text","text":" "},{"type":"text","text":"whether to force a system or page break, or to force the current music onto the same system or page as the"},{"type":"text","text":" "},{"type":"text","text":"preceding music. Normally this is the first music data within a measure. If used in multi-part music, they"},{"type":"text","text":" "},{"type":"text","text":"should be placed in the same positions within each part, or the results are undefined. The page-number"},{"type":"text","text":" "},{"type":"text","text":"attribute sets the number of a new page; it is ignored if new-page is not “yes”. Version 2.0 adds a blank-page"},{"type":"text","text":" "},{"type":"text","text":"attribute. This is a positive integer value that specifies the number of blank pages to insert before the"},{"type":"text","text":" "},{"type":"text","text":"current measure. It is ignored if new-page is not “yes”. These blank pages have no music, but may have text or"},{"type":"text","text":" "},{"type":"text","text":"images specified by the credit element. This is used to allow a combination of pages that are all text, or all"},{"type":"text","text":" "},{"type":"text","text":"text and images, together with pages of music."}],"title":"MXLPrint.Attributes","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Attributes"}],"navigatorTitle":[{"kind":"identifier","text":"Attributes"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlprint\/attributes-swift.struct","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint\/Attributes-swift.struct"}}}