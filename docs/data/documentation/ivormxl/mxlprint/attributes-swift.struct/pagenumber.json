{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlprint\/attributes-swift.struct\/pagenumber"]}],"kind":"symbol","metadata":{"role":"symbol","roleHeading":"Instance Property","title":"pageNumber","modules":[{"name":"IvorMXL"}],"externalID":"s:7IvorMXL8MXLPrintV10AttributesV10pageNumberSSSgvp","symbolKind":"property","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"pageNumber","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?","kind":"text"}]},"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint\/Attributes-swift.struct\/pageNumber","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint\/Attributes-swift.struct"]]},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"pageNumber","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?","kind":"text"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"Maps to the MusicXML "},{"type":"codeVoice","code":"page-number"},{"type":"text","text":" attribute."}],"type":"paragraph"}]}],"abstract":[{"type":"text","text":"The number of a new page. Ignored if "},{"code":"newPage","type":"codeVoice"},{"type":"text","text":" is not "},{"code":"true","type":"codeVoice"},{"type":"text","text":"."}],"sections":[],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLPrint/Attributes-swift.struct":{"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint\/Attributes-swift.struct","url":"\/documentation\/ivormxl\/mxlprint\/attributes-swift.struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Attributes"}],"abstract":[{"type":"text","text":"The print-attributes group is used by the print element. The new-system and new-page attributes indicate"},{"type":"text","text":" "},{"type":"text","text":"whether to force a system or page break, or to force the current music onto the same system or page as the"},{"type":"text","text":" "},{"type":"text","text":"preceding music. Normally this is the first music data within a measure. If used in multi-part music, they"},{"type":"text","text":" "},{"type":"text","text":"should be placed in the same positions within each part, or the results are undefined. The page-number"},{"type":"text","text":" "},{"type":"text","text":"attribute sets the number of a new page; it is ignored if new-page is not “yes”. Version 2.0 adds a blank-page"},{"type":"text","text":" "},{"type":"text","text":"attribute. This is a positive integer value that specifies the number of blank pages to insert before the"},{"type":"text","text":" "},{"type":"text","text":"current measure. It is ignored if new-page is not “yes”. These blank pages have no music, but may have text or"},{"type":"text","text":" "},{"type":"text","text":"images specified by the credit element. This is used to allow a combination of pages that are all text, or all"},{"type":"text","text":" "},{"type":"text","text":"text and images, together with pages of music."}],"kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Attributes"}],"title":"MXLPrint.Attributes"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLPrint/Attributes-swift.struct/pageNumber":{"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint\/Attributes-swift.struct\/pageNumber","url":"\/documentation\/ivormxl\/mxlprint\/attributes-swift.struct\/pagenumber","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"pageNumber","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"abstract":[{"type":"text","text":"The number of a new page. Ignored if "},{"code":"newPage","type":"codeVoice"},{"type":"text","text":" is not "},{"code":"true","type":"codeVoice"},{"type":"text","text":"."}],"kind":"symbol","role":"symbol","title":"pageNumber"},"doc://IvorMXL/documentation/IvorMXL/MXLPrint":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPrint","kind":"identifier"}],"navigatorTitle":[{"text":"MXLPrint","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint","kind":"symbol","role":"symbol","title":"MXLPrint","abstract":[{"text":"The print type contains general printing parameters, including layout elements. The part-name-display and","type":"text"},{"text":" ","type":"text"},{"text":"part-abbreviation-display elements may also be used here to change how a part name or abbreviation is","type":"text"},{"text":" ","type":"text"},{"text":"displayed over the course of a piece. They take effect when the current measure or a succeeding measure starts","type":"text"},{"text":" ","type":"text"},{"text":"a new system.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlprint"}}}