d":"identifier","text":"pageNumber"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?"}],"abstract":[{"type":"text","text":"The number of a new page. Ignored if "},{"code":"newPage","type":"codeVoice"},{"text":" is not ","type":"text"},{"code":"true","type":"codeVoice"},{"text":".","type":"text"}],"role":"symbol","url":"\/documentation\/ivormxl\/mxlprint\/attributes-swift.struct\/pagenumber","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint\/Attributes-swift.struct\/pageNumber","title":"pageNumber","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLPrint/Attributes-swift.struct":{"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint\/Attributes-swift.struct","url":"\/documentation\/ivormxl\/mxlprint\/attributes-swift.struct","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Attributes","kind":"identifier"}],"title":"MXLPrint.Attributes","kind":"symbol","abstract":[{"type":"text","text":"The print-attributes group is used by the print element. The new-system and new-page attributes indicate"},{"type":"text","text":" "},{"type":"text","text":"whether to force a system or page break, or to force the current music onto the same system or page as the"},{"type":"text","text":" "},{"type":"text","text":"preceding music. Normally this is the first music data within a measure. If used in multi-part music, they"},{"text":" ","type":"text"},{"type":"text","text":"should be placed in the same positions within each part, or the results are undefined. The page-number"},{"type":"text","text":" "},{"text":"attribute sets the number of a new page; it is ignored if new-page is not “yes”. Version 2.0 adds a blank-page","type":"text"},{"text":" ","type":"text"},{"text":"attribute. This is a positive integer value that specifies the number of blank pages to insert before the","type":"text"},{"text":" ","type":"text"},{"text":"current measure. It is ignored if new-page is not “yes”. These blank pages have no music, but may have text or","type":"text"},{"type":"text","text":" "},{"text":"images specified by the credit element. This is used to allow a combination of pages that are all text, or all","type":"text"},{"type":"text","text":" "},{"text":"text and images, together with pages of music.","type":"text"}],"navigatorTitle":[{"text":"Attributes","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLPrint":{"title":"MXLPrint","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"kind":"identifier","text":"MXLPrint"}],"url":"\/documentation\/ivormxl\/mxlprint","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"MXLPrint","kind":"identifier"}],"abstract":[{"type":"text","text":"The print type contains general printing parameters, including layout elements. The part-name-display and"},{"type":"text","text":" "},{"text":"part-abbreviation-display elements may also be used here to change how a part name or abbreviation is","type":"text"},{"type":"text","text":" "},{"text":"displayed over the course of a piece. They take effect when the current measure or a succeeding measure starts","type":"text"},{"text":" ","type":"text"},{"text":"a new system.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]}}}