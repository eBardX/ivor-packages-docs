":"text"},{"text":"staff-layout values take priority.","type":"text"}],"type":"paragraph"}]},{"name":"startsNewSystem","content":[{"inlineContent":[{"text":"A Boolean value indicating whether to force a system break, or to force the","type":"text"},{"text":" ","type":"text"},{"text":"current music onto the same system as the preceding music, normally the first","type":"text"},{"text":" ","type":"text"},{"text":"music data within a measure. In multi-part music this should be placed in the","type":"text"},{"text":" ","type":"text"},{"text":"same position within each part, or the results are undefined.","type":"text"}],"type":"paragraph"}]},{"name":"startsNewPage","content":[{"inlineContent":[{"text":"A Boolean value indicating whether to force a page break, or to force the","type":"text"},{"text":" ","type":"text"},{"text":"current music onto the same page as the preceding music, normally the first","type":"text"},{"text":" ","type":"text"},{"text":"music data within a measure. In multi-part music this should be placed in the","type":"text"},{"text":" ","type":"text"},{"text":"same position within each part, or the results are undefined.","type":"text"}],"type":"paragraph"}]},{"name":"blankPage","content":[{"inlineContent":[{"text":"The number of blank pages to insert before the current measure. Ignored if","type":"text"},{"text":" ","type":"text"},{"code":"newPage","type":"codeVoice"},{"text":" is not ","type":"text"},{"code":"true","type":"codeVoice"},{"text":". Blank pages have no music, but may have text or","type":"text"},{"text":" ","type":"text"},{"text":"images specified by the credit element.","type":"text"}],"type":"paragraph"}]},{"name":"pageNumber","content":[{"inlineContent":[{"text":"The number of a new page. Ignored if ","type":"text"},{"type":"codeVoice","code":"newPage"},{"text":" is not ","type":"text"},{"type":"codeVoice","code":"true"},{"text":".","type":"text"}],"type":"paragraph"}]}],"kind":"parameters"}],"sections":[],"metadata":{"title":"init(staffSpacing:startsNewSystem:startsNewPage:blankPage:pageNumber:)","symbolKind":"init","modules":[{"name":"IvorMXL"}],"role":"symbol","roleHeading":"Initializer","externalID":"s:7IvorMXL8MXLPrintV10AttributesV12staffSpacing15startsNewSystem0gH4Page05blankJ010pageNumberAESdSg_SbSgALSiSgSSSgtcfc","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"staffSpacing"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLTenthsa","text":"MXLTenths"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"startsNewSystem"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"startsNewPage"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"blankPage"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"pageNumber"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?)"}]},"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint\/Attributes-swift.struct\/init(staffSpacing:startsNewSystem:startsNewPage:blankPage:pageNumber:)","interfaceLanguage":"swift"},"kind":"symbol","schemaVersion":{"minor":3,"major":0,"patch":0},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLPrint":{"type":"topic","abstract":[{"type":"text","text":"The print type contains general printing parameters, including layout elements. The part-name-display and"},{"type":"text","text":" "},{"type":"text","text":"part-abbreviation-display elements may also be used here to change how a part name or abbreviation is"},{"type":"text","text":" "},{"type":"text","text":"displayed over the course of a piece. They take effect when the current measure or a succeeding measure starts"},{"type":"text","text":" "},{"type":"text","text":"a new system."}],"url":"\/documentation\/ivormxl\/mxlprint","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPrint"}],"kind":"symbol","title":"MXLPrint","navigatorTitle":[{"kind":"identifier","text":"MXLPrint"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLPrint/Attributes-swift.struct":{"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Attributes"}],"type":"topic","title":"MXLPrint.Attributes","navigatorTitle":[{"kind":"identifier","text":"Attributes"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint\/Attributes-swift.struct","url":"\/documentation\/ivormxl\/mxlprint\/attributes-swift.struct","abstract":[{"type":"text","text":"The print-attributes group is used by the print element. The new-system and new-page attributes indicate"},{"type":"text","text":" "},{"type":"text","text":"whether to force a system or page break, or to force the current music onto the same system or page as the"},{"type":"text","text":" "},{"type":"text","text":"preceding music. Normally this is the first music data within a measure. If used in multi-part music, they"},{"type":"text","text":" "},{"type":"text","text":"should be placed in the same positions within each part, or the results are undefined. The page-number"},{"type":"text","text":" "},{"type":"text","text":"attribute sets the number of a new page; it is ignored if new-page is not “yes”. Version 2.0 adds a blank-page"},{"type":"text","text":" "},{"type":"text","text":"attribute. This is a positive integer value that specifies the number of blank pages to insert before the"},{"type":"text","text":" "},{"type":"text","text":"current measure. It is ignored if new-page is not “yes”. These blank pages have no music, but may have text or"},{"type":"text","text":" "},{"type":"text","text":"images specified by the credit element. This is used to allow a combination of pages that are all text, or all"},{"type":"text","text":" "},{"type":"text","text":"text and images, together with pages of music."}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLPrint/Attributes-swift.struct/init(staffSpacing:startsNewSystem:startsNewPage:blankPage:pageNumber:)":{"role":"symbol","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Creates a new "},{"code":"MXLPrint.Attributes","type":"codeVoice"},{"type":"text","text":"."}],"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"staffSpacing"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLTenthsa","text":"MXLTenths"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"startsNewSystem"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"startsNewPage"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"blankPage"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"pageNumber"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?)"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint\/Attributes-swift.struct\/init(staffSpacing:startsNewSystem:startsNewPage:blankPage:pageNumber:)","url":"\/documentation\/ivormxl\/mxlprint\/attributes-swift.struct\/init(staffspacing:startsnewsystem:startsnewpage:blankpage:pagenumber:)","title":"init(staffSpacing:startsNewSystem:startsNewPage:blankPage:pageNumber:)"},"doc://IvorMXL/documentation/IvorMXL/MXLTenths":{"type":"topic","abstract":[{"type":"text","text":"The tenths type is a number representing tenths of interline staff space (positive or negative). Both integer"},{"type":"text","text":" "},{"type":"text","text":"and decimal values are allowed, such as 5 for a half space and 2.5 for a quarter space. Interline space is"},{"type":"text","text":" "},{"type":"text","text":"measured from the middle of a staff line."}],"url":"\/documentation\/ivormxl\/mxltenths","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTenths"}],"kind":"symbol","title":"MXLTenths","navigatorTitle":[{"kind":"identifier","text":"MXLTenths"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"}}}