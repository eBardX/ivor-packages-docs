{"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","abstract":[{"type":"text","text":"Creates a new "},{"code":"MXLPrint.Attributes","type":"codeVoice"},{"type":"text","text":"."}],"sections":[],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"staffSpacing"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths","preciseIdentifier":"s:7IvorMXL9MXLTenthsa","text":"MXLTenths"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"startsNewSystem"},{"kind":"text","text":": "},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"kind":"text","text":"? = nil, "},{"text":"startsNewPage","kind":"externalParam"},{"kind":"text","text":": "},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"kind":"text","text":"? = nil, "},{"text":"blankPage","kind":"externalParam"},{"kind":"text","text":": "},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"kind":"text","text":"? = nil, "},{"text":"pageNumber","kind":"externalParam"},{"kind":"text","text":": "},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"? = nil)","kind":"text"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The spacing between multiple staves, in tenths of staff space. Deprecated as of Version 1.1 in favor of the staff-layout element; if both are present, the staff-layout values take priority."}],"type":"paragraph"}],"name":"staffSpacing"},{"content":[{"inlineContent":[{"type":"text","text":"A Boolean value indicating whether to force a system break, or to force the current music onto the same system as the preceding music, normally the first music data within a measure. In multi-part music this should be placed in the same position within each part, or the results are undefined."}],"type":"paragraph"}],"name":"startsNewSystem"},{"content":[{"inlineContent":[{"type":"text","text":"A Boolean value indicating whether to force a page break, or to force the current music onto the same page as the preceding music, normally the first music data within a measure. In multi-part music this should be placed in the same position within each part, or the results are undefined."}],"type":"paragraph"}],"name":"startsNewPage"},{"content":[{"inlineContent":[{"type":"text","text":"The number of blank pages to insert before the current measure. Ignored if "},{"code":"newPage","type":"codeVoice"},{"type":"text","text":" is not "},{"code":"true","type":"codeVoice"},{"type":"text","text":". Blank pages have no music, but may have text or images specified by the credit element."}],"type":"paragraph"}],"name":"blankPage"},{"content":[{"inlineContent":[{"type":"text","text":"The number of a new page. Ignored if "},{"code":"newPage","type":"codeVoice"},{"type":"text","text":" is not "},{"code":"true","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}],"name":"pageNumber"}]}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint\/Attributes-swift.struct\/init(staffSpacing:startsNewSystem:startsNewPage:blankPage:pageNumber:)","interfaceLanguage":"swift"},"metadata":{"role":"symbol","externalID":"s:7IvorMXL8MXLPrintV10AttributesV12staffSpacing15startsNewSystem0gH4Page05blankJ010pageNumberAESdSg_SbSgALSiSgSSSgtcfc","symbolKind":"init","title":"init(staffSpacing:startsNewSystem:startsNewPage:blankPage:pageNumber:)","roleHeading":"Initializer","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"staffSpacing"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLTenthsa","text":"MXLTenths"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"startsNewSystem"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"startsNewPage"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"blankPage"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"pageNumber"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?)"}],"modules":[{"name":"IvorMXL"}]},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint\/Attributes-swift.struct"]]},"variants":[{"paths":["\/documentation\/ivormxl\/mxlprint\/attributes-swift.struct\/init(staffspacing:startsnewsystem:startsnewpage:blankpage:pagenumber:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLTenths":{"title":"MXLTenths","kind":"symbol","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTenths"}],"abstract":[{"type":"text","text":"The tenths type is a number representing tenths of interline staff space (positive or negative). Both integer"},{"type":"text","text":" "},{"type":"text","text":"and decimal values are allowed, such as 5 for a half space and 2.5 for a quarter space. Interline space is"},{"type":"text","text":" "},{"type":"text","text":"measured from the middle of a staff line."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLTenths"}],"url":"\/documentation\/ivormxl\/mxltenths"},"doc://IvorMXL/documentation/IvorMXL/MXLPrint/Attributes-swift.struct/init(staffSpacing:startsNewSystem:startsNewPage:blankPage:pageNumber:)":{"kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxlprint\/attributes-swift.struct\/init(staffspacing:startsnewsystem:startsnewpage:blankpage:pagenumber:)","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint\/Attributes-swift.struct\/init(staffSpacing:startsNewSystem:startsNewPage:blankPage:pageNumber:)","role":"symbol","title":"init(staffSpacing:startsNewSystem:startsNewPage:blankPage:pageNumber:)","abstract":[{"type":"text","text":"Creates a new "},{"code":"MXLPrint.Attributes","type":"codeVoice"},{"type":"text","text":"."}],"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"staffSpacing"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLTenths","preciseIdentifier":"s:7IvorMXL9MXLTenthsa"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"startsNewSystem"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"startsNewPage"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"blankPage"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"pageNumber"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?)"}]},"doc://IvorMXL/documentation/IvorMXL/MXLPrint/Attributes-swift.struct":{"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint\/Attributes-swift.struct","url":"\/documentation\/ivormxl\/mxlprint\/attributes-swift.struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Attributes"}],"abstract":[{"type":"text","text":"The print-attributes group is used by the print element. The new-system and new-page attributes indicate"},{"type":"text","text":" "},{"type":"text","text":"whether to force a system or page break, or to force the current music onto the same system or page as the"},{"type":"text","text":" "},{"type":"text","text":"preceding music. Normally this is the first music data within a measure. If used in multi-part music, they"},{"type":"text","text":" "},{"type":"text","text":"should be placed in the same positions within each part, or the results are undefined. The page-number"},{"type":"text","text":" "},{"type":"text","text":"attribute sets the number of a new page; it is ignored if new-page is not “yes”. Version 2.0 adds a blank-page"},{"type":"text","text":" "},{"type":"text","text":"attribute. This is a positive integer value that specifies the number of blank pages to insert before the"},{"type":"text","text":" "},{"type":"text","text":"current measure. It is ignored if new-page is not “yes”. These blank pages have no music, but may have text or"},{"type":"text","text":" "},{"type":"text","text":"images specified by the credit element. This is used to allow a combination of pages that are all text, or all"},{"type":"text","text":" "},{"type":"text","text":"text and images, together with pages of music."}],"kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Attributes"}],"title":"MXLPrint.Attributes"},"doc://IvorMXL/documentation/IvorMXL/MXLPrint":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPrint","kind":"identifier"}],"navigatorTitle":[{"text":"MXLPrint","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint","kind":"symbol","role":"symbol","title":"MXLPrint","abstract":[{"text":"The print type contains general printing parameters, including layout elements. The part-name-display and","type":"text"},{"text":" ","type":"text"},{"text":"part-abbreviation-display elements may also be used here to change how a part name or abbreviation is","type":"text"},{"text":" ","type":"text"},{"text":"displayed over the course of a piece. They take effect when the current measure or a succeeding measure starts","type":"text"},{"text":" ","type":"text"},{"text":"a new system.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlprint"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"}}}