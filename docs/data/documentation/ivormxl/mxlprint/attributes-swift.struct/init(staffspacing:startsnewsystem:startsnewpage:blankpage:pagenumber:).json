{"metadata":{"roleHeading":"Initializer","symbolKind":"init","modules":[{"name":"IvorMXL"}],"role":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"staffSpacing"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLTenths","preciseIdentifier":"s:7IvorMXL9MXLTenthsa"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"startsNewSystem"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"startsNewPage"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"blankPage"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"pageNumber"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?)"}],"title":"init(staffSpacing:startsNewSystem:startsNewPage:blankPage:pageNumber:)","externalID":"s:7IvorMXL8MXLPrintV10AttributesV12staffSpacing15startsNewSystem0gH4Page05blankJ010pageNumberAESdSg_SbSgALSiSgSSSgtcfc"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"staffSpacing"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLTenths","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths","preciseIdentifier":"s:7IvorMXL9MXLTenthsa"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"startsNewSystem"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"startsNewPage"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"blankPage"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"pageNumber"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"? = nil)"}],"platforms":["macOS"]}]},{"kind":"parameters","parameters":[{"name":"staffSpacing","content":[{"inlineContent":[{"text":"The spacing between multiple staves, in tenths of staff space. Deprecated as of Version 1.1 in favor of the staff-layout element; if both are present, the staff-layout values take priority.","type":"text"}],"type":"paragraph"}]},{"name":"startsNewSystem","content":[{"inlineContent":[{"text":"A Boolean value indicating whether to force a system break, or to force the current music onto the same system as the preceding music, normally the first music data within a measure. In multi-part music this should be placed in the same position within each part, or the results are undefined.","type":"text"}],"type":"paragraph"}]},{"name":"startsNewPage","content":[{"inlineContent":[{"text":"A Boolean value indicating whether to force a page break, or to force the current music onto the same page as the preceding music, normally the first music data within a measure. In multi-part music this should be placed in the same position within each part, or the results are undefined.","type":"text"}],"type":"paragraph"}]},{"name":"blankPage","content":[{"inlineContent":[{"text":"The number of blank pages to insert before the current measure. Ignored if ","type":"text"},{"code":"newPage","type":"codeVoice"},{"text":" is not ","type":"text"},{"code":"true","type":"codeVoice"},{"text":". Blank pages have no music, but may have text or images specified by the credit element.","type":"text"}],"type":"paragraph"}]},{"name":"pageNumber","content":[{"inlineContent":[{"text":"The number of a new page. Ignored if ","type":"text"},{"code":"newPage","type":"codeVoice"},{"text":" is not ","type":"text"},{"code":"true","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}]}],"sections":[],"abstract":[{"text":"Creates a new ","type":"text"},{"code":"MXLPrint.Attributes","type":"codeVoice"},{"text":".","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlprint\/attributes-swift.struct\/init(staffspacing:startsnewsystem:startsnewpage:blankpage:pagenumber:)"]}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint\/Attributes-swift.struct\/init(staffSpacing:startsNewSystem:startsNewPage:blankPage:pageNumber:)","interfaceLanguage":"swift"},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint\/Attributes-swift.struct"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLPrint/Attributes-swift.struct/init(staffSpacing:startsNewSystem:startsNewPage:blankPage:pageNumber:)":{"kind":"symbol","url":"\/documentation\/ivormxl\/mxlprint\/attributes-swift.struct\/init(staffspacing:startsnewsystem:startsnewpage:blankpage:pagenumber:)","abstract":[{"text":"Creates a new ","type":"text"},{"type":"codeVoice","code":"MXLPrint.Attributes"},{"text":".","type":"text"}],"role":"symbol","title":"init(staffSpacing:startsNewSystem:startsNewPage:blankPage:pageNumber:)","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint\/Attributes-swift.struct\/init(staffSpacing:startsNewSystem:startsNewPage:blankPage:pageNumber:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"staffSpacing","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL9MXLTenthsa","text":"MXLTenths","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"startsNewSystem","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"startsNewPage","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"blankPage","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"pageNumber","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"?)","kind":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLPrint/Attributes-swift.struct":{"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint\/Attributes-swift.struct","url":"\/documentation\/ivormxl\/mxlprint\/attributes-swift.struct","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Attributes","kind":"identifier"}],"title":"MXLPrint.Attributes","kind":"symbol","abstract":[{"type":"text","text":"The print-attributes group is used by the print element. The new-system and new-page attributes indicate"},{"type":"text","text":" "},{"type":"text","text":"whether to force a system or page break, or to force the current music onto the same system or page as the"},{"type":"text","text":" "},{"type":"text","text":"preceding music. Normally this is the first music data within a measure. If used in multi-part music, they"},{"text":" ","type":"text"},{"type":"text","text":"should be placed in the same positions within each part, or the results are undefined. The page-number"},{"type":"text","text":" "},{"text":"attribute sets the number of a new page; it is ignored if new-page is not “yes”. Version 2.0 adds a blank-page","type":"text"},{"text":" ","type":"text"},{"text":"attribute. This is a positive integer value that specifies the number of blank pages to insert before the","type":"text"},{"text":" ","type":"text"},{"text":"current measure. It is ignored if new-page is not “yes”. These blank pages have no music, but may have text or","type":"text"},{"type":"text","text":" "},{"text":"images specified by the credit element. This is used to allow a combination of pages that are all text, or all","type":"text"},{"type":"text","text":" "},{"text":"text and images, together with pages of music.","type":"text"}],"navigatorTitle":[{"text":"Attributes","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLPrint":{"title":"MXLPrint","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"kind":"identifier","text":"MXLPrint"}],"url":"\/documentation\/ivormxl\/mxlprint","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"MXLPrint","kind":"identifier"}],"abstract":[{"type":"text","text":"The print type contains general printing parameters, including layout elements. The part-name-display and"},{"type":"text","text":" "},{"text":"part-abbreviation-display elements may also be used here to change how a part name or abbreviation is","type":"text"},{"type":"text","text":" "},{"text":"displayed over the course of a piece. They take effect when the current measure or a succeeding measure starts","type":"text"},{"text":" ","type":"text"},{"text":"a new system.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLTenths":{"title":"MXLTenths","type":"topic","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTenths","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxltenths","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"MXLTenths","kind":"identifier"}],"abstract":[{"type":"text","text":"The tenths type is a number representing tenths of interline staff space (positive or negative). Both integer"},{"type":"text","text":" "},{"type":"text","text":"and decimal values are allowed, such as 5 for a half space and 2.5 for a quarter space. Interline space is"},{"type":"text","text":" "},{"type":"text","text":"measured from the middle of a staff line."}]}}}