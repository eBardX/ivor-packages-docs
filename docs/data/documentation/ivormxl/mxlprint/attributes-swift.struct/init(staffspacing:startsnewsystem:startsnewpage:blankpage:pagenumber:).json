"paragraph"}],"name":"staffSpacing"},{"content":[{"inlineContent":[{"type":"text","text":"A Boolean value indicating whether to force a system break, or to force the current music onto the same system as the preceding music, normally the first music data within a measure. In multi-part music this should be placed in the same position within each part, or the results are undefined."}],"type":"paragraph"}],"name":"startsNewSystem"},{"content":[{"inlineContent":[{"type":"text","text":"A Boolean value indicating whether to force a page break, or to force the current music onto the same page as the preceding music, normally the first music data within a measure. In multi-part music this should be placed in the same position within each part, or the results are undefined."}],"type":"paragraph"}],"name":"startsNewPage"},{"content":[{"inlineContent":[{"type":"text","text":"The number of blank pages to insert before the current measure. Ignored if "},{"type":"codeVoice","code":"newPage"},{"type":"text","text":" is not "},{"type":"codeVoice","code":"true"},{"type":"text","text":". Blank pages have no music, but may have text or images specified by the credit element."}],"type":"paragraph"}],"name":"blankPage"},{"content":[{"inlineContent":[{"type":"text","text":"The number of a new page. Ignored if "},{"type":"codeVoice","code":"newPage"},{"type":"text","text":" is not "},{"type":"codeVoice","code":"true"},{"type":"text","text":"."}],"type":"paragraph"}],"name":"pageNumber"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"staffSpacing","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLTenths","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLTenthsa"},{"text":"?, ","kind":"text"},{"text":"startsNewSystem","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":"?, ","kind":"text"},{"text":"startsNewPage","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":"?, ","kind":"text"},{"text":"blankPage","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":"?, ","kind":"text"},{"text":"pageNumber","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?)","kind":"text"}],"symbolKind":"init","modules":[{"name":"IvorMXL"}],"roleHeading":"Initializer","title":"init(staffSpacing:startsNewSystem:startsNewPage:blankPage:pageNumber:)","externalID":"s:7IvorMXL8MXLPrintV10AttributesV12staffSpacing15startsNewSystem0gH4Page05blankJ010pageNumberAESdSg_SbSgALSiSgSSSgtcfc","role":"symbol"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlprint\/attributes-swift.struct\/init(staffspacing:startsnewsystem:startsnewpage:blankpage:pagenumber:)"]}],"references":{"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLPrint":{"role":"symbol","abstract":[{"type":"text","text":"The print type contains general printing parameters, including layout elements. The part-name-display and"},{"type":"text","text":" "},{"type":"text","text":"part-abbreviation-display elements may also be used here to change how a part name or abbreviation is"},{"type":"text","text":" "},{"type":"text","text":"displayed over the course of a piece. They take effect when the current measure or a succeeding measure starts"},{"type":"text","text":" "},{"type":"text","text":"a new system."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint","url":"\/documentation\/ivormxl\/mxlprint","title":"MXLPrint","navigatorTitle":[{"kind":"identifier","text":"MXLPrint"}],"kind":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPrint","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLTenths":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLTenths"}],"abstract":[{"type":"text","text":"The tenths type is a number representing tenths of interline staff space (positive or negative). Both integer"},{"type":"text","text":" "},{"type":"text","text":"and decimal values are allowed, such as 5 for a half space and 2.5 for a quarter space. Interline space is"},{"type":"text","text":" "},{"type":"text","text":"measured from the middle of a staff line."}],"kind":"symbol","title":"MXLTenths","url":"\/documentation\/ivormxl\/mxltenths","role":"symbol","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTenths"}]},"doc://IvorMXL/documentation/IvorMXL/MXLPrint/Attributes-swift.struct/init(staffSpacing:startsNewSystem:startsNewPage:blankPage:pageNumber:)":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint\/Attributes-swift.struct\/init(staffSpacing:startsNewSystem:startsNewPage:blankPage:pageNumber:)","url":"\/documentation\/ivormxl\/mxlprint\/attributes-swift.struct\/init(staffspacing:startsnewsystem:startsnewpage:blankpage:pagenumber:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"staffSpacing","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLTenths","preciseIdentifier":"s:7IvorMXL9MXLTenthsa","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"startsNewSystem","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"startsNewPage","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"blankPage","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"pageNumber","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?)","kind":"text"}],"title":"init(staffSpacing:startsNewSystem:startsNewPage:blankPage:pageNumber:)","type":"topic","abstract":[{"text":"Creates a new ","type":"text"},{"type":"codeVoice","code":"MXLPrint.Attributes"},{"text":".","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLPrint/Attributes-swift.struct":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Attributes","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint\/Attributes-swift.struct","title":"MXLPrint.Attributes","kind":"symbol","navigatorTitle":[{"text":"Attributes","kind":"identifier"}],"abstract":[{"type":"text","text":"The print-attributes group is used by the print element. The new-system and new-page attributes indicate"},{"type":"text","text":" "},{"type":"text","text":"whether to force a system or page break, or to force the current music onto the same system or page as the"},{"type":"text","text":" "},{"type":"text","text":"preceding music. Normally this is the first music data within a measure. If used in multi-part music, they"},{"type":"text","text":" "},{"type":"text","text":"should be placed in the same positions within each part, or the results are undefined. The page-number"},{"type":"text","text":" "},{"type":"text","text":"attribute sets the number of a new page; it is ignored if new-page is not “yes”. Version 2.0 adds a blank-page"},{"type":"text","text":" "},{"type":"text","text":"attribute. This is a positive integer value that specifies the number of blank pages to insert before the"},{"type":"text","text":" "},{"type":"text","text":"current measure. It is ignored if new-page is not “yes”. These blank pages have no music, but may have text or"},{"type":"text","text":" "},{"type":"text","text":"images specified by the credit element. This is used to allow a combination of pages that are all text, or all"},{"type":"text","text":" "},{"type":"text","text":"text and images, together with pages of music."}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlprint\/attributes-swift.struct"}}}