eIdentifier","preciseIdentifier":"s:7IvorMXL8MXLPrintV10AttributesV"},{"text":")","kind":"text"}],"symbolKind":"init"},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLPrint":{"type":"topic","abstract":[{"type":"text","text":"The print type contains general printing parameters, including layout elements. The part-name-display and"},{"type":"text","text":" "},{"type":"text","text":"part-abbreviation-display elements may also be used here to change how a part name or abbreviation is"},{"type":"text","text":" "},{"type":"text","text":"displayed over the course of a piece. They take effect when the current measure or a succeeding measure starts"},{"type":"text","text":" "},{"type":"text","text":"a new system."}],"url":"\/documentation\/ivormxl\/mxlprint","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPrint"}],"kind":"symbol","title":"MXLPrint","navigatorTitle":[{"kind":"identifier","text":"MXLPrint"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLLayout":{"navigatorTitle":[{"kind":"identifier","text":"MXLLayout"}],"abstract":[{"text":"The layout group specifies the sequence of page, system, and staff layout elements that is common to both the","type":"text"},{"text":" ","type":"text"},{"text":"defaults and print elements.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLayout","url":"\/documentation\/ivormxl\/mxllayout","role":"symbol","title":"MXLLayout","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLLayout"}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLPrint/init(id:layout:measureLayout:measureNumbering:partNameDisplay:partAbbreviationDisplay:attributes:)":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint\/init(id:layout:measureLayout:measureNumbering:partNameDisplay:partAbbreviationDisplay:attributes:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"layout","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLLayout","preciseIdentifier":"s:7IvorMXL9MXLLayoutV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"measureLayout","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLMeasureLayout","preciseIdentifier":"s:7IvorMXL16MXLMeasureLayoutV","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"measureNumbering","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLMeasureNumbering","preciseIdentifier":"s:7IvorMXL19MXLMeasureNumberingV","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"partNameDisplay","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLNameDisplay","preciseIdentifier":"s:7IvorMXL14MXLNameDisplayV","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"partAbbreviationDisplay","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLNameDisplay","preciseIdentifier":"s:7IvorMXL14MXLNameDisplayV","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"attributes","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Attributes","preciseIdentifier":"s:7IvorMXL8MXLPrintV10AttributesV","kind":"typeIdentifier"},{"text":")","kind":"text"}],"kind":"symbol","title":"init(id:layout:measureLayout:measureNumbering:partNameDisplay:partAbbreviationDisplay:attributes:)","url":"\/documentation\/ivormxl\/mxlprint\/init(id:layout:measurelayout:measurenumbering:partnamedisplay:partabbreviationdisplay:attributes:)","type":"topic","role":"symbol","abstract":[{"text":"Creates a new ","type":"text"},{"code":"MXLPrint","type":"codeVoice"},{"text":".","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLNameDisplay":{"type":"topic","title":"MXLNameDisplay","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNameDisplay","abstract":[{"type":"text","text":"The name-display type is used for exact formatting of multi-font text in part and group names to the left of"},{"type":"text","text":" "},{"type":"text","text":"the system. The print-object attribute can be used to determine what, if anything, is printed at the start of"},{"type":"text","text":" "},{"type":"text","text":"each system. Enclosure for the display-text element is none by default. Language for the display-text element"},{"type":"text","text":" "},{"type":"text","text":"is Italian (“it”) by default."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNameDisplay"}],"navigatorTitle":[{"kind":"identifier","text":"MXLNameDisplay"}],"url":"\/documentation\/ivormxl\/mxlnamedisplay"},"doc://IvorMXL/documentation/IvorMXL/MXLMeasureLayout":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMeasureLayout","navigatorTitle":[{"text":"MXLMeasureLayout","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlmeasurelayout","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLMeasureLayout","kind":"identifier"}],"title":"MXLMeasureLayout","abstract":[{"text":"The measure-layout type includes the horizontal distance from the previous measure. It applies to the current","type":"text"},{"text":" ","type":"text"},{"text":"measure only.","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLMeasureNumbering":{"title":"MXLMeasureNumbering","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLMeasureNumbering","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlmeasurenumbering","role":"symbol","navigatorTitle":[{"text":"MXLMeasureNumbering","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMeasureNumbering","abstract":[{"text":"The measure-numbering type describes how frequently measure numbers are displayed on this part. The text","type":"text"},{"text":" ","type":"text"},{"text":"attribute from the measure element is used for display, or the number attribute if the text attribute is not","type":"text"},{"text":" ","type":"text"},{"text":"present. Measures with an implicit attribute set to “yes” never display a measure number, regardless of the","type":"text"},{"text":" ","type":"text"},{"text":"measure-numbering setting.","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLPrint/Attributes-swift.struct":{"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Attributes"}],"type":"topic","title":"MXLPrint.Attributes","navigatorTitle":[{"kind":"identifier","text":"Attributes"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint\/Attributes-swift.struct","url":"\/documentation\/ivormxl\/mxlprint\/attributes-swift.struct","abstract":[{"type":"text","text":"The print-attributes group is used by the print element. The new-system and new-page attributes indicate"},{"type":"text","text":" "},{"type":"text","text":"whether to force a system or page break, or to force the current music onto the same system or page as the"},{"type":"text","text":" "},{"type":"text","text":"preceding music. Normally this is the first music data within a measure. If used in multi-part music, they"},{"type":"text","text":" "},{"type":"text","text":"should be placed in the same positions within each part, or the results are undefined. The page-number"},{"type":"text","text":" "},{"type":"text","text":"attribute sets the number of a new page; it is ignored if new-page is not “yes”. Version 2.0 adds a blank-page"},{"type":"text","text":" "},{"type":"text","text":"attribute. This is a positive integer value that specifies the number of blank pages to insert before the"},{"type":"text","text":" "},{"type":"text","text":"current measure. It is ignored if new-page is not “yes”. These blank pages have no music, but may have text or"},{"type":"text","text":" "},{"type":"text","text":"images specified by the credit element. This is used to allow a combination of pages that are all text, or all"},{"type":"text","text":" "},{"type":"text","text":"text and images, together with pages of music."}],"kind":"symbol"}}}