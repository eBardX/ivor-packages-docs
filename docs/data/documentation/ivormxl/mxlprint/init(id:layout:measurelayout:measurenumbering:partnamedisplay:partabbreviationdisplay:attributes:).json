{"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLPrint"},{"type":"text","text":"."}],"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"init","kind":"keyword"},{"text":"(","kind":"text"},{"text":"id","kind":"externalParam"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"text":"? = nil, ","kind":"text"},{"text":"layout","kind":"externalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLayout","preciseIdentifier":"s:7IvorMXL9MXLLayoutV","text":"MXLLayout"},{"kind":"text","text":" = MXLLayout(), "},{"text":"measureLayout","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLMeasureLayout","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMeasureLayout","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL16MXLMeasureLayoutV"},{"text":"? = nil, ","kind":"text"},{"text":"measureNumbering","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLMeasureNumbering","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMeasureNumbering","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL19MXLMeasureNumberingV"},{"text":"? = nil, ","kind":"text"},{"text":"partNameDisplay","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLNameDisplay","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNameDisplay","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL14MXLNameDisplayV"},{"text":"? = nil, ","kind":"text"},{"text":"partAbbreviationDisplay","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLNameDisplay","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNameDisplay","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL14MXLNameDisplayV"},{"text":"? = nil, ","kind":"text"},{"text":"attributes","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Attributes","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLPrintV10AttributesV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint\/Attributes-swift.struct"},{"text":")","kind":"text"}]}]},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The optional-unique-id attribute group allows an element to optionally specify an ID that is unique to the entire document. This attribute group is not used for a required id attribute, or for an id attribute that specifies an id reference.","type":"text"}]}],"name":"id"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The layout group specifies the sequence of page, system, and staff layout elements that is common to both the defaults and print elements.","type":"text"}]}],"name":"layout"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Specifies the horizontal distance from the previous measure, in tenths.","type":"text"}]}],"name":"measureLayout"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Specifies details about measure numbering displayed at this point in the score.","type":"text"}]}],"name":"measureNumbering"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Changes how the part name is displayed, taking effect when the current measure or a succeeding measure starts a new system.","type":"text"}]}],"name":"partNameDisplay"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Changes how the part abbreviation is displayed, taking effect when the current measure or a succeeding measure starts a new system.","type":"text"}]}],"name":"partAbbreviationDisplay"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The print-attributes group is used by the print element. The new-system and new-page attributes indicate whether to force a system or page break, or to force the current music onto the same system or page as the preceding music. Normally this is the first music data within a measure. If used in multi-part music, they should be placed in the same positions within each part, or the results are undefined. The page-number attribute sets the number of a new page; it is ignored if new-page is not “yes”. Version 2.0 adds a blank-page attribute. This is a positive integer value that specifies the number of blank pages to insert before the current measure. It is ignored if new-page is not “yes”. These blank pages have no music, but may have text or images specified by the credit element. This is used to allow a combination of pages that are all text, or all text and images, together with pages of music.","type":"text"}]}],"name":"attributes"}],"kind":"parameters"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint\/init(id:layout:measureLayout:measureNumbering:partNameDisplay:partAbbreviationDisplay:attributes:)"},"metadata":{"role":"symbol","externalID":"s:7IvorMXL8MXLPrintV2id6layout13measureLayout0F9Numbering15partNameDisplay0i12AbbreviationK010attributesACSSSg_AA9MXLLayoutVAA010MXLMeasureG0VSgAA0oH0VSgAA07MXLNameK0VSgAvC10AttributesVtcfc","symbolKind":"init","title":"init(id:layout:measureLayout:measureNumbering:partNameDisplay:partAbbreviationDisplay:attributes:)","roleHeading":"Initializer","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?, ","kind":"text"},{"text":"layout","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL9MXLLayoutV","kind":"typeIdentifier","text":"MXLLayout"},{"kind":"text","text":", "},{"kind":"externalParam","text":"measureLayout"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL16MXLMeasureLayoutV","kind":"typeIdentifier","text":"MXLMeasureLayout"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"measureNumbering"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL19MXLMeasureNumberingV","kind":"typeIdentifier","text":"MXLMeasureNumbering"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"partNameDisplay"},{"kind":"text","text":": "},{"text":"MXLNameDisplay","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL14MXLNameDisplayV"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"partAbbreviationDisplay"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL14MXLNameDisplayV","kind":"typeIdentifier","text":"MXLNameDisplay"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"attributes"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLPrintV10AttributesV","text":"Attributes"},{"kind":"text","text":")"}],"modules":[{"name":"IvorMXL"}]},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlprint\/init(id:layout:measurelayout:measurenumbering:partnamedisplay:partabbreviationdisplay:attributes:)"]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLPrint/Attributes-swift.struct":{"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint\/Attributes-swift.struct","url":"\/documentation\/ivormxl\/mxlprint\/attributes-swift.struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Attributes"}],"abstract":[{"type":"text","text":"The print-attributes group is used by the print element. The new-system and new-page attributes indicate"},{"type":"text","text":" "},{"type":"text","text":"whether to force a system or page break, or to force the current music onto the same system or page as the"},{"type":"text","text":" "},{"type":"text","text":"preceding music. Normally this is the first music data within a measure. If used in multi-part music, they"},{"type":"text","text":" "},{"type":"text","text":"should be placed in the same positions within each part, or the results are undefined. The page-number"},{"type":"text","text":" "},{"type":"text","text":"attribute sets the number of a new page; it is ignored if new-page is not “yes”. Version 2.0 adds a blank-page"},{"type":"text","text":" "},{"type":"text","text":"attribute. This is a positive integer value that specifies the number of blank pages to insert before the"},{"type":"text","text":" "},{"type":"text","text":"current measure. It is ignored if new-page is not “yes”. These blank pages have no music, but may have text or"},{"type":"text","text":" "},{"type":"text","text":"images specified by the credit element. This is used to allow a combination of pages that are all text, or all"},{"type":"text","text":" "},{"type":"text","text":"text and images, together with pages of music."}],"kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Attributes"}],"title":"MXLPrint.Attributes"},"doc://IvorMXL/documentation/IvorMXL/MXLMeasureLayout":{"url":"\/documentation\/ivormxl\/mxlmeasurelayout","abstract":[{"type":"text","text":"The measure-layout type includes the horizontal distance from the previous measure. It applies to the current"},{"type":"text","text":" "},{"type":"text","text":"measure only."}],"fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLMeasureLayout"}],"kind":"symbol","role":"symbol","title":"MXLMeasureLayout","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMeasureLayout","navigatorTitle":[{"kind":"identifier","text":"MXLMeasureLayout"}]},"doc://IvorMXL/documentation/IvorMXL/MXLNameDisplay":{"role":"symbol","navigatorTitle":[{"text":"MXLNameDisplay","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNameDisplay","kind":"identifier"}],"kind":"symbol","title":"MXLNameDisplay","url":"\/documentation\/ivormxl\/mxlnamedisplay","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNameDisplay","abstract":[{"text":"The name-display type is used for exact formatting of multi-font text in part and group names to the left of","type":"text"},{"type":"text","text":" "},{"type":"text","text":"the system. The print-object attribute can be used to determine what, if anything, is printed at the start of"},{"type":"text","text":" "},{"type":"text","text":"each system. Enclosure for the display-text element is none by default. Language for the display-text element"},{"type":"text","text":" "},{"type":"text","text":"is Italian (“it”) by default."}]},"doc://IvorMXL/documentation/IvorMXL/MXLPrint/init(id:layout:measureLayout:measureNumbering:partNameDisplay:partAbbreviationDisplay:attributes:)":{"abstract":[{"text":"Creates a new ","type":"text"},{"code":"MXLPrint","type":"codeVoice"},{"text":".","type":"text"}],"kind":"symbol","role":"symbol","type":"topic","title":"init(id:layout:measureLayout:measureNumbering:partNameDisplay:partAbbreviationDisplay:attributes:)","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint\/init(id:layout:measureLayout:measureNumbering:partNameDisplay:partAbbreviationDisplay:attributes:)","url":"\/documentation\/ivormxl\/mxlprint\/init(id:layout:measurelayout:measurenumbering:partnamedisplay:partabbreviationdisplay:attributes:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"id"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"layout"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL9MXLLayoutV","kind":"typeIdentifier","text":"MXLLayout"},{"kind":"text","text":", "},{"kind":"externalParam","text":"measureLayout"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL16MXLMeasureLayoutV","kind":"typeIdentifier","text":"MXLMeasureLayout"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"measureNumbering"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL19MXLMeasureNumberingV","kind":"typeIdentifier","text":"MXLMeasureNumbering"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"partNameDisplay"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL14MXLNameDisplayV","kind":"typeIdentifier","text":"MXLNameDisplay"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"partAbbreviationDisplay"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL14MXLNameDisplayV","kind":"typeIdentifier","text":"MXLNameDisplay"},{"kind":"text","text":"?, "},{"text":"attributes","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Attributes","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLPrintV10AttributesV"},{"kind":"text","text":")"}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLPrint":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPrint","kind":"identifier"}],"navigatorTitle":[{"text":"MXLPrint","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint","kind":"symbol","role":"symbol","title":"MXLPrint","abstract":[{"text":"The print type contains general printing parameters, including layout elements. The part-name-display and","type":"text"},{"text":" ","type":"text"},{"text":"part-abbreviation-display elements may also be used here to change how a part name or abbreviation is","type":"text"},{"text":" ","type":"text"},{"text":"displayed over the course of a piece. They take effect when the current measure or a succeeding measure starts","type":"text"},{"text":" ","type":"text"},{"text":"a new system.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlprint"},"doc://IvorMXL/documentation/IvorMXL/MXLLayout":{"role":"symbol","url":"\/documentation\/ivormxl\/mxllayout","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLayout","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLLayout","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"The layout group specifies the sequence of page, system, and staff layout elements that is common to both the","type":"text"},{"text":" ","type":"text"},{"text":"defaults and print elements.","type":"text"}],"type":"topic","navigatorTitle":[{"text":"MXLLayout","kind":"identifier"}],"title":"MXLLayout"},"doc://IvorMXL/documentation/IvorMXL/MXLMeasureNumbering":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLMeasureNumbering","kind":"identifier"}],"navigatorTitle":[{"text":"MXLMeasureNumbering","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMeasureNumbering","kind":"symbol","role":"symbol","title":"MXLMeasureNumbering","abstract":[{"text":"The measure-numbering type describes how frequently measure numbers are displayed on this part. The text","type":"text"},{"text":" ","type":"text"},{"text":"attribute from the measure element is used for display, or the number attribute if the text attribute is not","type":"text"},{"text":" ","type":"text"},{"text":"present. Measures with an implicit attribute set to “yes” never display a measure number, regardless of the","type":"text"},{"text":" ","type":"text"},{"text":"measure-numbering setting.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlmeasurenumbering"}}}