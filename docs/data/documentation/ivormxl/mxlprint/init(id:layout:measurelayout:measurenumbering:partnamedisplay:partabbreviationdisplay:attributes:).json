; it is ignored if new-page is not “yes”. Version 2.0 adds a blank-page"},{"type":"text","text":" "},{"type":"text","text":"attribute. This is a positive integer value that specifies the number of blank pages to insert before the"},{"type":"text","text":" "},{"type":"text","text":"current measure. It is ignored if new-page is not “yes”. These blank pages have no music, but may have text or"},{"type":"text","text":" "},{"type":"text","text":"images specified by the credit element. This is used to allow a combination of pages that are all text, or all"},{"type":"text","text":" "},{"type":"text","text":"text and images, together with pages of music."}],"title":"MXLPrint.Attributes","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Attributes"}],"navigatorTitle":[{"kind":"identifier","text":"Attributes"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlprint\/attributes-swift.struct","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint\/Attributes-swift.struct"},"doc://IvorMXL/documentation/IvorMXL/MXLLayout":{"abstract":[{"type":"text","text":"The layout group specifies the sequence of page, system, and staff layout elements that is common to both the"},{"type":"text","text":" "},{"type":"text","text":"defaults and print elements."}],"title":"MXLLayout","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLLayout"}],"navigatorTitle":[{"kind":"identifier","text":"MXLLayout"}],"type":"topic","url":"\/documentation\/ivormxl\/mxllayout","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLayout"}}}