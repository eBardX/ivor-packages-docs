ciseIdentifier":"s:7IvorMXL8MXLPrintV10AttributesV"},{"text":")","kind":"text"}],"modules":[{"name":"IvorMXL"}],"symbolKind":"init"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint"]]},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"init","kind":"keyword"},{"text":"(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"? = nil, ","kind":"text"},{"text":"layout","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLayout","text":"MXLLayout","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLLayoutV"},{"text":" = MXLLayout(), ","kind":"text"},{"text":"measureLayout","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMeasureLayout","text":"MXLMeasureLayout","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL16MXLMeasureLayoutV"},{"text":"? = nil, ","kind":"text"},{"text":"measureNumbering","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMeasureNumbering","text":"MXLMeasureNumbering","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL19MXLMeasureNumberingV"},{"text":"? = nil, ","kind":"text"},{"text":"partNameDisplay","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNameDisplay","text":"MXLNameDisplay","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL14MXLNameDisplayV"},{"text":"? = nil, ","kind":"text"},{"text":"partAbbreviationDisplay","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNameDisplay","text":"MXLNameDisplay","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL14MXLNameDisplayV"},{"text":"? = nil, ","kind":"text"},{"text":"attributes","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint\/Attributes-swift.struct","text":"Attributes","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLPrintV10AttributesV"},{"text":")","kind":"text"}],"platforms":["macOS"]}],"kind":"declarations"},{"parameters":[{"name":"id","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The optional-unique-id attribute group allows an element to optionally specify an ID that is unique to the entire document. This attribute group is not used for a required id attribute, or for an id attribute that specifies an id reference."}]}]},{"name":"layout","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The layout group specifies the sequence of page, system, and staff layout elements that is common to both the defaults and print elements."}]}]},{"name":"measureLayout","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Specifies the horizontal distance from the previous measure, in tenths."}]}]},{"name":"measureNumbering","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Specifies details about measure numbering displayed at this point in the score."}]}]},{"name":"partNameDisplay","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Changes how the part name is displayed, taking effect when the current measure or a succeeding measure starts a new system."}]}]},{"name":"partAbbreviationDisplay","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Changes how the part abbreviation is displayed, taking effect when the current measure or a succeeding measure starts a new system."}]}]},{"name":"attributes","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The print-attributes group is used by the print element. The new-system and new-page attributes indicate whether to force a system or page break, or to force the current music onto the same system or page as the preceding music. Normally this is the first music data within a measure. If used in multi-part music, they should be placed in the same positions within each part, or the results are undefined. The page-number attribute sets the number of a new page; it is ignored if new-page is not “yes”. Version 2.0 adds a blank-page attribute. This is a positive integer value that specifies the number of blank pages to insert before the current measure. It is ignored if new-page is not “yes”. These blank pages have no music, but may have text or images specified by the credit element. This is used to allow a combination of pages that are all text, or all text and images, together with pages of music."}]}]}],"kind":"parameters"}],"abstract":[{"text":"Creates a new ","type":"text"},{"code":"MXLPrint","type":"codeVoice"},{"text":".","type":"text"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint\/init(id:layout:measureLayout:measureNumbering:partNameDisplay:partAbbreviationDisplay:attributes:)","interfaceLanguage":"swift"},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLPrint":{"title":"MXLPrint","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"kind":"identifier","text":"MXLPrint"}],"url":"\/documentation\/ivormxl\/mxlprint","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"MXLPrint","kind":"identifier"}],"abstract":[{"type":"text","text":"The print type contains general printing parameters, including layout elements. The part-name-display and"},{"type":"text","text":" "},{"text":"part-abbreviation-display elements may also be used here to change how a part name or abbreviation is","type":"text"},{"type":"text","text":" "},{"text":"displayed over the course of a piece. They take effect when the current measure or a succeeding measure starts","type":"text"},{"text":" ","type":"text"},{"text":"a new system.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLPrint/init(id:layout:measureLayout:measureNumbering:partNameDisplay:partAbbreviationDisplay:attributes:)":{"fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"layout","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLLayout","preciseIdentifier":"s:7IvorMXL9MXLLayoutV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"measureLayout","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLMeasureLayout","preciseIdentifier":"s:7IvorMXL16MXLMeasureLayoutV","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"measureNumbering","kind":"externalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"MXLMeasureNumbering","preciseIdentifier":"s:7IvorMXL19MXLMeasureNumberingV"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"partNameDisplay"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLNameDisplay","preciseIdentifier":"s:7IvorMXL14MXLNameDisplayV"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"partAbbreviationDisplay"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLNameDisplay","preciseIdentifier":"s:7IvorMXL14MXLNameDisplayV"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"attributes"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"Attributes","preciseIdentifier":"s:7IvorMXL8MXLPrintV10AttributesV"},{"kind":"text","text":")"}],"abstract":[{"text":"Creates a new ","type":"text"},{"type":"codeVoice","code":"MXLPrint"},{"text":".","type":"text"}],"role":"symbol","kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxlprint\/init(id:layout:measurelayout:measurenumbering:partnamedisplay:partabbreviationdisplay:attributes:)","title":"init(id:layout:measureLayout:measureNumbering:partNameDisplay:partAbbreviationDisplay:attributes:)","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint\/init(id:layout:measureLayout:measureNumbering:partNameDisplay:partAbbreviationDisplay:attributes:)"},"doc://IvorMXL/documentation/IvorMXL/MXLMeasureNumbering":{"abstract":[{"type":"text","text":"The measure-numbering type describes how frequently measure numbers are displayed on this part. The text"},{"type":"text","text":" "},{"type":"text","text":"attribute from the measure element is used for display, or the number attribute if the text attribute is not"},{"type":"text","text":" "},{"type":"text","text":"present. Measures with an implicit attribute set to “yes” never display a measure number, regardless of the"},{"type":"text","text":" "},{"type":"text","text":"measure-numbering setting."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMeasureNumbering","kind":"symbol","type":"topic","navigatorTitle":[{"text":"MXLMeasureNumbering","kind":"identifier"}],"title":"MXLMeasureNumbering","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLMeasureNumbering","kind":"identifier"}],"role":"symbol","url":"\/documentation\/ivormxl\/mxlmeasurenumbering"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLLayout":{"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLLayout","kind":"identifier"}],"title":"MXLLayout","navigatorTitle":[{"text":"MXLLayout","kind":"identifier"}],"abstract":[{"text":"The layout group specifies the sequence of page, system, and staff layout elements that is common to both the","type":"text"},{"text":" ","type":"text"},{"text":"defaults and print elements.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLayout","type":"topic","url":"\/documentation\/ivormxl\/mxllayout","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLMeasureLayout":{"navigatorTitle":[{"text":"MXLMeasureLayout","kind":"identifier"}],"title":"MXLMeasureLayout","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMeasureLayout","type":"topic","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLMeasureLayout","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlmeasurelayout","abstract":[{"type":"text","text":"The measure-layout type includes the horizontal distance from the previous measure. It applies to the current"},{"text":" ","type":"text"},{"text":"measure only.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLPrint/Attributes-swift.struct":{"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint\/Attributes-swift.struct","url":"\/documentation\/ivormxl\/mxlprint\/attributes-swift.struct","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Attributes","kind":"identifier"}],"title":"MXLPrint.Attributes","kind":"symbol","abstract":[{"type":"text","text":"The print-attributes group is used by the print element. The new-system and new-page attributes indicate"},{"type":"text","text":" "},{"type":"text","text":"whether to force a system or page break, or to force the current music onto the same system or page as the"},{"type":"text","text":" "},{"type":"text","text":"preceding music. Normally this is the first music data within a measure. If used in multi-part music, they"},{"text":" ","type":"text"},{"type":"text","text":"should be placed in the same positions within each part, or the results are undefined. The page-number"},{"type":"text","text":" "},{"text":"attribute sets the number of a new page; it is ignored if new-page is not “yes”. Version 2.0 adds a blank-page","type":"text"},{"text":" ","type":"text"},{"text":"attribute. This is a positive integer value that specifies the number of blank pages to insert before the","type":"text"},{"text":" ","type":"text"},{"text":"current measure. It is ignored if new-page is not “yes”. These blank pages have no music, but may have text or","type":"text"},{"type":"text","text":" "},{"text":"images specified by the credit element. This is used to allow a combination of pages that are all text, or all","type":"text"},{"type":"text","text":" "},{"text":"text and images, together with pages of music.","type":"text"}],"navigatorTitle":[{"text":"Attributes","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLNameDisplay":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlnamedisplay","title":"MXLNameDisplay","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNameDisplay","kind":"identifier"}],"navigatorTitle":[{"text":"MXLNameDisplay","kind":"identifier"}],"abstract":[{"text":"The name-display type is used for exact formatting of multi-font text in part and group names to the left of","type":"text"},{"text":" ","type":"text"},{"text":"the system. The print-object attribute can be used to determine what, if anything, is printed at the start of","type":"text"},{"text":" ","type":"text"},{"text":"each system. Enclosure for the display-text element is none by default. Language for the display-text element","type":"text"},{"text":" ","type":"text"},{"text":"is Italian (“it”) by default.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNameDisplay"}}}