{"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"init","kind":"keyword"},{"text":"(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"? = nil, ","kind":"text"},{"text":"layout","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL9MXLLayoutV","text":"MXLLayout","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLayout"},{"text":" = MXLLayout(), ","kind":"text"},{"text":"measureLayout","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL16MXLMeasureLayoutV","text":"MXLMeasureLayout","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMeasureLayout"},{"text":"? = nil, ","kind":"text"},{"text":"measureNumbering","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL19MXLMeasureNumberingV","text":"MXLMeasureNumbering","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMeasureNumbering"},{"text":"? = nil, ","kind":"text"},{"text":"partNameDisplay","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL14MXLNameDisplayV","text":"MXLNameDisplay","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNameDisplay"},{"text":"? = nil, ","kind":"text"},{"text":"partAbbreviationDisplay","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL14MXLNameDisplayV","text":"MXLNameDisplay","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNameDisplay"},{"text":"? = nil, ","kind":"text"},{"text":"attributes","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL8MXLPrintV10AttributesV","text":"Attributes","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint\/Attributes-swift.struct"},{"text":")","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}]},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The optional-unique-id attribute group allows an element to optionally"},{"type":"text","text":" "},{"type":"text","text":"specify an ID that is unique to the entire document. This attribute group"},{"type":"text","text":" "},{"type":"text","text":"is not used for a required id attribute, or for an id attribute that"},{"type":"text","text":" "},{"type":"text","text":"specifies an id reference."}]}],"name":"id"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The layout group specifies the sequence of page, system, and staff layout"},{"type":"text","text":" "},{"type":"text","text":"elements that is common to both the defaults and print elements."}]}],"name":"layout"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Specifies the horizontal distance from the previous measure, in tenths."}]}],"name":"measureLayout"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Specifies details about measure numbering displayed at this point in the"},{"type":"text","text":" "},{"type":"text","text":"score."}]}],"name":"measureNumbering"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Changes how the part name is displayed, taking effect when the current"},{"type":"text","text":" "},{"type":"text","text":"measure or a succeeding measure starts a new system."}]}],"name":"partNameDisplay"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Changes how the part abbreviation is displayed, taking effect when the"},{"type":"text","text":" "},{"type":"text","text":"current measure or a succeeding measure starts a new system."}]}],"name":"partAbbreviationDisplay"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The print-attributes group is used by the print element. The new-system"},{"type":"text","text":" "},{"type":"text","text":"and new-page attributes indicate whether to force a system or page break,"},{"type":"text","text":" "},{"type":"text","text":"or to force the current music onto the same system or page as the"},{"type":"text","text":" "},{"type":"text","text":"preceding music. Normally this is the first music data within a measure."},{"type":"text","text":" "},{"type":"text","text":"If used in multi-part music, they should be placed in the same positions"},{"type":"text","text":" "},{"type":"text","text":"within each part, or the results are undefined. The page-number attribute"},{"type":"text","text":" "},{"type":"text","text":"sets the number of a new page; it is ignored if new-page is not “yes”."},{"type":"text","text":" "},{"type":"text","text":"Version 2.0 adds a blank-page attribute. This is a positive integer value"},{"type":"text","text":" "},{"type":"text","text":"that specifies the number of blank pages to insert before the current"},{"type":"text","text":" "},{"type":"text","text":"measure. It is ignored if new-page is not “yes”. These blank pages have no"},{"type":"text","text":" "},{"type":"text","text":"music, but may have text or images specified by the credit element. This"},{"type":"text","text":" "},{"type":"text","text":"is used to allow a combination of pages that are all text, or all text and"},{"type":"text","text":" "},{"type":"text","text":"images, together with pages of music."}]}],"name":"attributes"}],"kind":"parameters"}],"sections":[],"kind":"symbol","variants":[{"paths":["\/documentation\/ivormxl\/mxlprint\/init(id:layout:measurelayout:measurenumbering:partnamedisplay:partabbreviationdisplay:attributes:)"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint\/