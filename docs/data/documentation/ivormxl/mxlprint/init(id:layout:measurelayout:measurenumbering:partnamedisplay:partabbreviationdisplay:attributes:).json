AttributesV","text":"Attributes","kind":"typeIdentifier"},{"text":")","kind":"text"}],"roleHeading":"Initializer"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint"]]},"abstract":[{"text":"Creates a new ","type":"text"},{"code":"MXLPrint","type":"codeVoice"},{"text":".","type":"text"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"init","kind":"keyword"},{"text":"(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"layout","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL9MXLLayoutV","text":"MXLLayout","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLayout"},{"text":" = MXLLayout(), ","kind":"text"},{"text":"measureLayout","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL16MXLMeasureLayoutV","text":"MXLMeasureLayout","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMeasureLayout"},{"text":"? = nil, ","kind":"text"},{"text":"measureNumbering","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL19MXLMeasureNumberingV","text":"MXLMeasureNumbering","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMeasureNumbering"},{"text":"? = nil, ","kind":"text"},{"text":"partNameDisplay","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLNameDisplay","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNameDisplay","preciseIdentifier":"s:7IvorMXL14MXLNameDisplayV"},{"text":"? = nil, ","kind":"text"},{"text":"partAbbreviationDisplay","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLNameDisplay","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNameDisplay","preciseIdentifier":"s:7IvorMXL14MXLNameDisplayV"},{"text":"? = nil, ","kind":"text"},{"text":"attributes","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Attributes","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint\/Attributes-swift.struct","preciseIdentifier":"s:7IvorMXL8MXLPrintV10AttributesV"},{"text":")","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"content":[{"inlineContent":[{"text":"The optional-unique-id attribute group allows an element to optionally specify an ID that is unique to the entire document. This attribute group is not used for a required id attribute, or for an id attribute that specifies an id reference.","type":"text"}],"type":"paragraph"}],"name":"id"},{"content":[{"inlineContent":[{"text":"The layout group specifies the sequence of page, system, and staff layout elements that is common to both the defaults and print elements.","type":"text"}],"type":"paragraph"}],"name":"layout"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Specifies the horizontal distance from the previous measure, in tenths.","type":"text"}]}],"name":"measureLayout"},{"name":"measureNumbering","content":[{"inlineContent":[{"text":"Specifies details about measure numbering displayed at this point in the score.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Changes how the part name is displayed, taking effect when the current measure or a succeeding measure starts a new system.","type":"text"}],"type":"paragraph"}],"name":"partNameDisplay"},{"content":[{"inlineContent":[{"type":"text","text":"Changes how the part abbreviation is displayed, taking effect when the current measure or a succeeding measure starts a new system."}],"type":"paragraph"}],"name":"partAbbreviationDisplay"},{"content":[{"inlineContent":[{"type":"text","text":"The print-attributes group is used by the print element. The new-system and new-page attributes indicate whether to force a system or page break, or to force the current music onto the same system or page as the preceding music. Normally this is the first music data within a measure. If used in multi-part music, they should be placed in the same positions within each part, or the results are undefined. The page-number attribute sets the number of a new page; it is ignored if new-page is not “yes”. Version 2.0 adds a blank-page attribute. This is a positive integer value that specifies the number of blank pages to insert before the current measure. It is ignored if new-page is not “yes”. These blank pages have no music, but may have text or images specified by the credit element. This is used to allow a combination of pages that are all text, or all text and images, together with pages of music."}],"type":"paragraph"}],"name":"attributes"}],"kind":"parameters"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlprint\/init(id:layout:measurelayout:measurenumbering:partnamedisplay:partabbreviationdisplay:attributes:)"]}],"kind":"symbol","references":{"doc://IvorMXL/documentation/IvorMXL/MXLMeasureLayout":{"navigatorTitle":[{"text":"MXLMeasureLayout","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlmeasurelayout","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMeasureLayout","title":"MXLMeasureLayout","kind":"symbol","abstract":[{"text":"The measure-layout type includes the horizontal distance from the previous measure. It applies to the current","type":"text"},{"text":" ","type":"text"},{"text":"measure only.","type":"text"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLMeasureLayout","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLMeasureNumbering":{"role":"symbol","kind":"symbol","title":"MXLMeasureNumbering","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMeasureNumbering","abstract":[{"text":"The measure-numbering type describes how frequently measure numbers are displayed on this part. The text","type":"text"},{"text":" ","type":"text"},{"text":"attribute from the measure element is used for display, or the number attribute if the text attribute is not","type":"text"},{"text":" ","type":"text"},{"text":"present. Measures with an implicit attribute set to “yes” never display a measure number, regardless of the","type":"text"},{"text":" ","type":"text"},{"text":"measure-numbering setting.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlmeasurenumbering","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLMeasureNumbering"}],"navigatorTitle":[{"kind":"identifier","text":"MXLMeasureNumbering"}]},"doc://IvorMXL/documentation/IvorMXL/MXLPrint/init(id:layout:measureLayout:measureNumbering:partNameDisplay:partAbbreviationDisplay:attributes:)":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint\/init(id:layout:measureLayout:measureNumbering:partNameDisplay:partAbbreviationDisplay:attributes:)","type":"topic","kind":"symbol","title":"init(id:layout:measureLayout:measureNumbering:partNameDisplay:partAbbreviationDisplay:attributes:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"id"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"layout"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL9MXLLayoutV","kind":"typeIdentifier","text":"MXLLayout"},{"kind":"text","text":", "},{"kind":"externalParam","text":"measureLayout"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL16MXLMeasureLayoutV","kind":"typeIdentifier","text":"MXLMeasureLayout"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"measureNumbering"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL19MXLMeasureNumberingV","kind":"typeIdentifier","text":"MXLMeasureNumbering"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"partNameDisplay"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL14MXLNameDisplayV","kind":"typeIdentifier","text":"MXLNameDisplay"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"partAbbreviationDisplay"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL14MXLNameDisplayV","kind":"typeIdentifier","text":"MXLNameDisplay"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"attributes"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL8MXLPrintV10AttributesV","kind":"typeIdentifier","text":"Attributes"},{"kind":"text","text":")"}],"url":"\/documentation\/ivormxl\/mxlprint\/init(id:layout:measurelayout:measurenumbering:partnamedisplay:partabbreviationdisplay:attributes:)","abstract":[{"text":"Creates a new ","type":"text"},{"code":"MXLPrint","type":"codeVoice"},{"text":".","type":"text"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLPrint/Attributes-swift.struct":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Attributes","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint\/Attributes-swift.struct","title":"MXLPrint.Attributes","kind":"symbol","navigatorTitle":[{"text":"Attributes","kind":"identifier"}],"abstract":[{"type":"text","text":"The print-attributes group is used by the print element. The new-system and new-page attributes indicate"},{"type":"text","text":" "},{"type":"text","text":"whether to force a system or page break, or to force the current music onto the same system or page as the"},{"type":"text","text":" "},{"type":"text","text":"preceding music. Normally this is the first music data within a measure. If used in multi-part music, they"},{"type":"text","text":" "},{"type":"text","text":"should be placed in the same positions within each part, or the results are undefined. The page-number"},{"type":"text","text":" "},{"type":"text","text":"attribute sets the number of a new page; it is ignored if new-page is not “yes”. Version 2.0 adds a blank-page"},{"type":"text","text":" "},{"type":"text","text":"attribute. This is a positive integer value that specifies the number of blank pages to insert before the"},{"type":"text","text":" "},{"type":"text","text":"current measure. It is ignored if new-page is not “yes”. These blank pages have no music, but may have text or"},{"type":"text","text":" "},{"type":"text","text":"images specified by the credit element. This is used to allow a combination of pages that are all text, or all"},{"type":"text","text":" "},{"type":"text","text":"text and images, together with pages of music."}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlprint\/attributes-swift.struct"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLNameDisplay":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNameDisplay"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLNameDisplay"}],"url":"\/documentation\/ivormxl\/mxlnamedisplay","role":"symbol","title":"MXLNameDisplay","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNameDisplay","type":"topic","abstract":[{"type":"text","text":"The name-display type is used for exact formatting of multi-font text in part and group names to the left of"},{"type":"text","text":" "},{"type":"text","text":"the system. The print-object attribute can be used to determine what, if anything, is printed at the start of"},{"type":"text","text":" "},{"type":"text","text":"each system. Enclosure for the display-text element is none by default. Language for the display-text element"},{"type":"text","text":" "},{"type":"text","text":"is Italian (“it”) by default."}]},"doc://IvorMXL/documentation/IvorMXL/MXLLayout":{"role":"symbol","kind":"symbol","title":"MXLLayout","abstract":[{"type":"text","text":"The layout group specifies the sequence of page, system, and staff layout elements that is common to both the"},{"type":"text","text":" "},{"type":"text","text":"defaults and print elements."}],"url":"\/documentation\/ivormxl\/mxllayout","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLLayout","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLayout","navigatorTitle":[{"text":"MXLLayout","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLPrint":{"role":"symbol","abstract":[{"type":"text","text":"The print type contains general printing parameters, including layout elements. The part-name-display and"},{"type":"text","text":" "},{"type":"text","text":"part-abbreviation-display elements may also be used here to change how a part name or abbreviation is"},{"type":"text","text":" "},{"type":"text","text":"displayed over the course of a piece. They take effect when the current measure or a succeeding measure starts"},{"type":"text","text":" "},{"type":"text","text":"a new system."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint","url":"\/documentation\/ivormxl\/mxlprint","title":"MXLPrint","navigatorTitle":[{"kind":"identifier","text":"MXLPrint"}],"kind":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPrint","kind":"identifier"}]}}}