Italian (“it”) by default.","type":"text"}],"title":"MXLNameDisplay","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNameDisplay"}],"navigatorTitle":[{"text":"MXLNameDisplay","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlnamedisplay","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNameDisplay"},"doc://IvorMXL/documentation/IvorMXL/MXLPrint":{"abstract":[{"type":"text","text":"The print type contains general printing parameters, including layout elements. The part-name-display and"},{"type":"text","text":" "},{"type":"text","text":"part-abbreviation-display elements may also be used here to change how a part name or abbreviation is"},{"type":"text","text":" "},{"type":"text","text":"displayed over the course of a piece. They take effect when the current measure or a succeeding measure starts"},{"type":"text","text":" "},{"type":"text","text":"a new system."}],"title":"MXLPrint","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPrint"}],"navigatorTitle":[{"kind":"identifier","text":"MXLPrint"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlprint","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint"},"doc://IvorMXL/documentation/IvorMXL/MXLPrint/init(id:layout:measureLayout:measureNumbering:partNameDisplay:partAbbreviationDisplay:attributes:)":{"title":"init(id:layout:measureLayout:measureNumbering:partNameDisplay:partAbbreviationDisplay:attributes:)","role":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"layout","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLLayout","preciseIdentifier":"s:7IvorMXL9MXLLayoutV","kind":