ype":"paragraph","inlineContent":[{"type":"text","text":"A Boolean value indicating whether a circle appears at the point of the wedge, indicating a crescendo from nothing or diminuendo to nothing."}]}]},{"name":"lineKind","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The line-type attribute distinguishes between solid, dashed, dotted, and wavy lines."}]}]},{"name":"dashLength","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The length, in tenths, of the dashes in a dashed line. Ignored if the corresponding line-type attribute is not dashed."}]}]},{"name":"spaceLength","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The length, in tenths, of the spaces in a dashed line. Ignored if the corresponding line-type attribute is not dashed."}]}]},{"name":"position","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For most elements, any program will compute a default x and y position. The position attributes let this be changed two ways."}]}]},{"name":"color","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The color attribute group indicates the color of an element."}]}]}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLWedge\/init(id:kind:number:spread:isNiente:lineKind:dashLength:spaceLength:position:color:)"},"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"title":"init(id:kind:number:spread:isNiente:lineKind:dashLength:spaceLength:position:color:)","role":"symbol","externalID":"s:7IvorMXL8MXLWedgeV2id4kind6number6spread8isNiente8lineKind10dashLength05spaceM08position5colorACSSSg_AC0K0OAA14MXLNumberLevelVSgSdSgSbSgAA07MXLLineK0OSgA2tA11MXLPositionVAA8MXLColorVSgtcfc","symbolKind":"init","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"id"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"kind"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Kind","preciseIdentifier":"s:7IvorMXL8MXLWedgeV4KindO"},{"kind":"text","text":", "},{"kind":"externalParam","text":"number"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLNumberLevel","preciseIdentifier":"s:7IvorMXL14MXLNumberLevelV"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"spread"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLTenths","preciseIdentifier":"s:7IvorMXL9MXLTenthsa"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"isNiente"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"lineKind"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLLineKind","preciseIdentifier":"s:7IvorMXL11MXLLineKindO"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"dashLength"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLTenths","preciseIdentifier":"s:7IvorMXL9MXLTenthsa"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"spaceLength"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLTenths","preciseIdentifier":"s:7IvorMXL9MXLTenthsa"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"position"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLPosition","preciseIdentifier":"s:7IvorMXL11MXLPositionV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"color"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLColor","preciseIdentifier":"s:7IvorMXL8MXLColorV"},{"kind":"text","text":"?)"}],"modules":[{"name":"IvorMXL"}],"roleHeading":"Initializer"},"sections":[],"kind":"symbol","abstract":[{"type":"text","text":"Creates a new "},{"code":"MXLWedge","type":"codeVoice"},{"type":"text","text":"."}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLWedge/Kind-swift.enum":{"title":"MXLWedge.Kind","url":"\/documentation\/ivormxl\/mxlwedge\/kind-swift.enum","role":"symbol","navigatorTitle":[{"text":"Kind","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLWedge\/Kind-swift.enum","kind":"symbol","abstract":[{"type":"text","text":"The wedge type is crescendo for the start of a wedge that is closed at the left side, diminuendo for the"},{"type":"text","text":" "},{"type":"text","text":"start of a wedge that is closed on the right side, and stop for the end of a wedge. The continue type is"},{"type":"text","text":" "},{"type":"text","text":"used for formatting wedges over a system break, or for other situations where a single wedge is divided"},{"type":"text","text":" "},{"type":"text","text":"into multiple segments."}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Kind","kind":"identifier"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLNumberLevel":{"type":"topic","url":"\/documentation\/ivormxl\/mxlnumberlevel","role":"symbol","title":"MXLNumberLevel","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumberLevel","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNumberLevel","kind":"identifier"}],"abstract":[{"text":"Slurs, tuplets, and many other features can be concurrent and overlap within a single musical part. The","type":"text"},{"text":" ","type":"text"},{"text":"number-level entity distinguishes up to 16 concurrent objects of the same type when the objects overlap in","type":"text"},{"text":" ","type":"text"},{"text":"MusicXML document order. Values greater than 6 are usually only needed for music with a large number of divisi","type":"text"},{"text":" ","type":"text"},{"text":"staves in a single part, or if there are more than 6 cross-staff arpeggios in a single measure. When a number-","type":"text"},{"text":" ","type":"text"},{"text":"level value is implied, the value is 1 by default.","type":"text"}],"navigatorTitle":[{"text":"MXLNumberLevel","kind":"identifier"}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlcolor","title":"MXLColor","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"type":"text","text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is"},{"type":"text","text":" "},{"type":"text","text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor"},"doc://IvorMXL/documentation/IvorMXL/MXLTenths":{"title":"MXLTenths","type":"topic","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTenths","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxltenths","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"MXLTenths","kind":"identifier"}],"abstract":[{"type":"text","text":"The tenths type is a number representing tenths of interline staff space (positive or negative). Both integer"},{"type":"text","text":" "},{"type":"text","text":"and decimal values are allowed, such as 5 for a half space and 2.5 for a quarter space. Interline space is"},{"type":"text","text":" "},{"type":"text","text":"measured from the middle of a staff line."}]},"doc://IvorMXL/documentation/IvorMXL/MXLWedge":{"title":"MXLWedge","url":"\/documentation\/ivormxl\/mxlwedge","role":"symbol","navigatorTitle":[{"text":"MXLWedge","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLWedge","abstract":[{"text":"The wedge type represents crescendo and diminuendo wedge symbols. The type attribute is crescendo for the","type":"text"},{"text":" ","type":"text"},{"text":"start of a wedge that is closed at the left side, and diminuendo for the start of a wedge that is closed on","type":"text"},{"text":" ","type":"text"},{"text":"the right side. Spread values are measured in tenths; those at the start of a crescendo wedge or end of a","type":"text"},{"text":" ","type":"text"},{"text":"diminuendo wedge are ignored. The niente attribute is yes if a circle appears at the point of the wedge,","type":"text"},{"text":" ","type":"text"},{"text":"indicating a crescendo from nothing or diminuendo to nothing. It is no by default, and used only when the type","type":"text"},{"text":" ","type":"text"},{"text":"is crescendo, or the type is stop for a wedge that began with a diminuendo type. The line-type is solid if not","type":"text"},{"text":" ","type":"text"},{"text":"specified.","type":"text"}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLWedge","kind":"identifier"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLPosition":{"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPosition","kind":"identifier"}],"title":"MXLPosition","navigatorTitle":[{"text":"MXLPosition","kind":"identifier"}],"abstract":[{"type":"text","text":"For most elements, any program will compute a default x and y position. The position attributes let this be"},{"type":"text","text":" "},{"type":"text","text":"changed two ways."}],"url":"\/documentation\/ivormxl\/mxlposition","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLWedge/init(id:kind:number:spread:isNiente:lineKind:dashLength:spaceLength:position:color:)":{"abstract":[{"text":"Creates a new ","type":"text"},{"code":"MXLWedge","type":"codeVoice"},{"text":".","type":"text"}],"title":"init(id:kind:number:spread:isNiente:lineKind:dashLength:spaceLength:position:color:)","url":"\/documentation\/ivormxl\/mxlwedge\/init(id:kind:number:spread:isniente:linekind:dashlength:spacelength:position:color:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?, ","kind":"text"},{"text":"kind","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Kind","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLWedgeV4KindO"},{"text":", ","kind":"text"},{"text":"number","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLNumberLevel","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL14MXLNumberLevelV"},{"text":"?, ","kind":"text"},{"text":"spread","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLTenths","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLTenthsa"},{"text":"?, ","kind":"text"},{"text":"isNiente","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":"?, ","kind":"text"},{"text":"lineKind","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLLineKind","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLLineKindO"},{"text":"?, ","kind":"text"},{"text":"dashLength","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLTenths","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLTenthsa"},{"text":"?, ","kind":"text"},{"text":"spaceLength","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLTenths","kind":"typ