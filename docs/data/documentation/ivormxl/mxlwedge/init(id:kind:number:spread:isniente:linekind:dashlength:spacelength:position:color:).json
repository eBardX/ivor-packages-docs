":"kind"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Distinguishes this wedge from other wedges that might be active at the same time."}]}],"name":"number"},{"content":[{"inlineContent":[{"type":"text","text":"The spread, in tenths, between the wedge lines at this point. Ignored at the start of a crescendo wedge or the end of a diminuendo wedge."}],"type":"paragraph"}],"name":"spread"},{"content":[{"type":"paragraph","inlineContent":[{"text":"A Boolean value indicating whether a circle appears at the point of the wedge, indicating a crescendo from nothing or diminuendo to nothing.","type":"text"}]}],"name":"isNiente"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The line-type attribute distinguishes between solid, dashed, dotted, and wavy lines."}]}],"name":"lineKind"},{"content":[{"inlineContent":[{"type":"text","text":"The length, in tenths, of the dashes in a dashed line. Ignored if the corresponding line-type attribute is not dashed."}],"type":"paragraph"}],"name":"dashLength"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The length, in tenths, of the spaces in a dashed line. Ignored if the corresponding line-type attribute is not dashed.","type":"text"}]}],"name":"spaceLength"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For most elements, any program will compute a default x and y position. The position attributes let this be changed two ways."}]}],"name":"position"},{"content":[{"inlineContent":[{"type":"text","text":"The color attribute group indicates the color of an element."}],"type":"paragraph"}],"name":"color"}],"kind":"parameters"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlwedge\/init(id:kind:number:spread:isniente:linekind:dashlength:spacelength:position:color:)"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLWedge/Kind-swift.enum":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLWedge\/Kind-swift.enum","url":"\/documentation\/ivormxl\/mxlwedge\/kind-swift.enum","abstract":[{"text":"The wedge type is crescendo for the start of a wedge that is closed at the left side, diminuendo for the","type":"text"},{"text":" ","type":"text"},{"text":"start of a wedge that is closed on the right side, and stop for the end of a wedge. The continue type is","type":"text"},{"text":" ","type":"text"},{"text":"used for formatting wedges over a system break, or for other situations where a single wedge is divided","type":"text"},{"text":" ","type":"text"},{"text":"into multiple segments.","type":"text"}],"type":"topic","role":"symbol","kind":"symbol","title":"MXLWedge.Kind","navigatorTitle":[{"text":"Kind","kind":"identifier"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Kind","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLLineKind":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLineKind","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLLineKind"}],"abstract":[{"type":"text","text":"The line-type type distinguishes between solid, dashed, dotted, and wavy lines."}],"kind":"symbol","title":"MXLLineKind","url":"\/documentation\/ivormxl\/mxllinekind","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLLineKind"}]},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLColor","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","title":"MXLColor","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlcolor"},"doc://IvorMXL/documentation/IvorMXL/MXLPosition":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLPosition"}],"abstract":[{"text":"For most elements, any program will compute a default x and y position. The position attributes let this be","type":"text"},{"text":" ","type":"text"},{"text":"changed two ways.","type":"text"}],"kind":"symbol","title":"MXLPosition","url":"\/documentation\/ivormxl\/mxlposition","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPosition"}]},"doc://IvorMXL/documentation/IvorMXL/MXLTenths":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLTenths"}],"abstract":[{"type":"text","text":"The tenths type is a number representing tenths of interline staff space (positive or negative). Both integer"},{"type":"text","text":" "},{"type":"text","text":"and decimal values are allowed, such as 5 for a half space and 2.5 for a quarter space. Interline space is"},{"type":"text","text":" "},{"type":"text","text":"measured from the middle of a staff line."}],"kind":"symbol","title":"MXLTenths","url":"\/documentation\/ivormxl\/mxltenths","role":"symbol","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTenths"}]},"doc://IvorMXL/documentation/IvorMXL/MXLNumberLevel":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumberLevel","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLNumberLevel"}],"abstract":[{"type":"text","text":"Slurs, tuplets, and many other features can be concurrent and overlap within a single musical part. The"},{"type":"text","text":" "},{"type":"text","text":"number-level entity distinguishes up to 16 concurrent objects of the same type when the objects overlap in"},{"type":"text","text":" "},{"type":"text","text":"MusicXML document order. Values greater than 6 are usually only needed for music with a large number of divisi"},{"type":"text","text":" "},{"type":"text","text":"staves in a single part, or if there are more than 6 cross-staff arpeggios in a single measure. When a number-"},{"type":"text","text":" "},{"type":"text","text":"level value is implied, the value is 1 by default."}],"kind":"symbol","title":"MXLNumberLevel","url":"\/documentation\/ivormxl\/mxlnumberlevel","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNumberLevel"}]},"doc://IvorMXL/documentation/IvorMXL/MXLWedge/init(id:kind:number:spread:isNiente:lineKind:dashLength:spaceLength:position:color:)":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLWedge\/init(id:kind:number:spread:isNiente:lineKind:dashLength:spaceLength:position:color:)","url":"\/documentation\/ivormxl\/mxlwedge\/init(id:kind:number:spread:isniente:linekind:dashlength:spacelength:position:color:)","abstract":[{"text":"Creates a new ","type":"text"},{"type":"codeVoice","code":"MXLWedge"},{"text":".","type":"text"}],"type":"topic","role":"symbol","kind":"symbol","title":"init(id:kind:number:spread:isNiente:lineKind:dashLength:spaceLength:position:color:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?, ","kind":"text"},{"text":"kind","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Kind","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLWedgeV4KindO"},{"text":", ","kind":"text"},{"text":"number","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLNumberLevel","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL14MXLNumberLevelV"},{"text":"?, ","kind":"text"},{"text":"spread","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLTenths","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLTenthsa"},{"text":"?, ","kind":"text"},{"text":"isNiente","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":"?, ","kind":"text"},{"text":"lineKind","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLLineKind","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLLineKindO"},{"text":"?, ","kind":"text"},{"text":"dashLength","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLTenths","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLTenthsa"},{"text":"?, ","kind":"text"},{"text":"spaceLength","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLTenths","preciseIdentifier":"s:7IvorMXL9MXLTenthsa","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"position","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLPosition","preciseIdentifier":"s:7IvorMXL11MXLPositionV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"color","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLColor","preciseIdentifier":"s:7IvorMXL8MXLColorV","kind":"typeIdentifier"},{"text":"?)","kind":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLWedge":{"url":"\/documentation\/ivormxl\/mxlwedge","title":"MXLWedge","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLWedge","kind":"identifier"}],"navigatorTitle":[{"text":"MXLWedge","kind":"identifier"}],"abstract":[{"text":"The wedge type represents crescendo and diminuendo wedge symbols. The type attribute is crescendo for the","type":"text"},{"text":" ","type":"text"},{"text":"start of a wedge that is closed at the left side, and diminuendo for the start of a wedge that is closed on","type":"text"},{"text":" ","type":"text"},{"text":"the right side. Spread values are measured in tenths; those at the start of a crescendo wedge or end of a","type":"text"},{"text":" ","type":"text"},{"text":"diminuendo wedge are ignored. The niente attribute is yes if a circle appears at the point of the wedge,","type":"text"},{"text":" ","type":"text"},{"text":"indicating a crescendo from nothing or diminuendo to nothing. It is no by default, and used only when the type","type":"text"},{"text":" ","type":"text"},{"text":"is crescendo, or the type is stop for a wedge that began with a diminuendo type. The line-type is solid if not","type":"text"},{"text":" ","type":"text"},{"text":"specified.","type":"text"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLWedge"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"}}}