LLineKind","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLineKind","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLLineKindO"},{"text":"? = nil, ","kind":"text"},{"text":"dashLength","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLTenths","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLTenthsa"},{"text":"? = nil, ","kind":"text"},{"text":"spaceLength","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLTenths","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLTenthsa"},{"text":"? = nil, ","kind":"text"},{"text":"position","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLPosition","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLPositionV"},{"text":" = MXLPosition(), ","kind":"text"},{"text":"color","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLColor","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLColorV"},{"text":"? = nil)","kind":"text"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The optional-unique-id attribute group allows an element to optionally specify an ID"},{"type":"text","text":" "},{"type":"text","text":"that is unique to the entire document. This attribute group is not used for a required"},{"type":"text","text":" "},{"type":"text","text":"id attribute, or for an id attribute that specifies an id reference."}],"type":"paragraph"}],"name":"id"},{"content":[{"inlineContent":[{"type":"text","text":"Whether this is the start of a crescendo or diminuendo wedge, the end of a wedge, or a"},{"type":"text","text":" "},{"type":"text","text":"continuation of one divided into multiple segments."}],"type":"paragraph"}],"name":"kind"},{"content":[{"inlineContent":[{"type":"text","text":"Distinguishes this wedge from other wedges that might be active at the same time."}],"type":"paragraph"}],"name":"number"},{"content":[{"inlineContent":[{"type":"text","text":"The spread, in tenths, between the wedge lines at this point. Ignored at the start of"},{"type":"text","text":" "},{"type":"text","text":"a crescendo wedge or the end of a diminuendo wedge."}],"type":"paragraph"}],"name":"spread"},{"content":[{"inlineContent":[{"type":"text","text":"A Boolean value indicating whether a circle appears at the point of the wedge,"},{"type":"text","text":" "},{"type":"text","text":"indicating a crescendo from nothing or diminuendo to nothing."}],"type":"paragraph"}],"name":"isNiente"},{"content":[{"inlineContent":[{"type":"text","text":"The line-type attribute distinguishes between solid, dashed, dotted, and wavy lines."}],"type":"paragraph"}],"name":"lineKind"},{"content":[{"inlineContent":[{"type":"text","text":"The length, in tenths, of the dashes in a dashed line. Ignored if the corresponding"},{"type":"text","text":" "},{"type":"text","text":"line-type attribute is not dashed."}],"type":"paragraph"}],"name":"dashLength"},{"content":[{"inlineContent":[{"type":"text","text":"The length, in tenths, of the spaces in a dashed line. Ignored if the corresponding"},{"type":"text","text":" "},{"type":"text","text":"line-type attribute is not dashed."}],"type":"paragraph"}],"name":"spaceLength"},{"content":[{"inlineContent":[{"type":"text","text":"For most elements, any program will compute a default x and y position. The position"},{"type":"text","text":" "},{"type":"text","text":"attributes let this be changed two ways."}],"type":"paragraph"}],"name":"position"},{"content":[{"inlineContent":[{"type":"text","text":"The color attribute group indicates the color of an element."}],"type":"paragraph"}],"name":"color"}]}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLWedge\/init(id:kind:number:spread:isNiente:lineKind:dashLength:spaceLength:position:color:)","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/ivormxl\/mxlwedge\/init(id:kind:number:spread:isniente:linekind:dashlength:spacelength:position:color:)"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","references":{"doc://IvorMXL/documentation/IvorMXL/MXLWedge/Kind-swift.enum":{"kind":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Kind"}],"role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLWedge\/Kind-swift.enum","title":"MXLWedge.Kind","navigatorTitle":[{"kind":"identifier","text":"Kind"}],"url":"\/documentation\/ivormxl\/mxlwedge\/kind-swift.enum","abstract":[{"type":"text","text":"The wedge type is crescendo for the start of a wedge that is closed at the left side, diminuendo for the"},{"type":"text","text":" "},{"type":"text","text":"start of a wedge that is closed on the right side, and stop for the end of a wedge. The continue type is"},{"type":"text","text":" "},{"type":"text","text":"used for formatting wedges over a system break, or for other situations where a single wedge is divided"},{"type":"text","text":" "},{"type":"text","text":"into multiple segments."}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLNumberLevel":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumberLevel","navigatorTitle":[{"kind":"identifier","text":"MXLNumberLevel"}],"url":"\/documentation\/ivormxl\/mxlnumberlevel","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNumberLevel"}],"title":"MXLNumberLevel","abstract":[{"text":"Slurs, tuplets, and many other features can be concurrent and overlap within a single musical part. The","type":"text"},{"text":" ","type":"text"},{"text":"number-level entity distinguishes up to 16 concurrent objects of the same type when the objects overlap in","type":"text"},{"text":" ","type":"text"},{"text":"MusicXML document order. Values greater than 6 are usually only needed for music with a large number of divisi","type":"text"},{"text":" ","type":"text"},{"text":"staves in a single part, or if there are more than 6 cross-staff arpeggios in a single measure. When a number-","type":"text"},{"text":" ","type":"text"},{"text":"level value is implied, the value is 1 by default.","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLPosition":{"type":"topic","abstract":[{"type":"text","text":"For most elements, any program will compute a default x and y position. The position attributes let this be"},{"type":"text","text":" "},{"type":"text","text":"changed two ways."}],"url":"\/documentation\/ivormxl\/mxlposition","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPosition"}],"kind":"symbol","title":"MXLPosition","navigatorTitle":[{"kind":"identifier","text":"MXLPosition"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLWedge":{"type":"topic","title":"MXLWedge","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLWedge","abstract":[{"type":"text","text":"The wedge type represents crescendo and diminuendo wedge symbols. The type attribute is crescendo for the"},{"type":"text","text":" "},{"type":"text","text":"start of a wedge that is closed at the left side, and diminuendo for the start of a wedge that is closed on"},{"type":"text","text":" "},{"type":"text","text":"the right side. Spread values are measured in tenths; those at the start of a crescendo wedge or end of a"},{"type":"text","text":" "},{"type":"text","text":"diminuendo wedge are ignored. The niente attribute is yes if a circle appears at the point of the wedge,"},{"type":"text","text":" "},{"type":"text","text":"indicating a crescendo from nothing or diminuendo to nothing. It is no by default, and used only when the type"},{"type":"text","text":" "},{"type":"text","text":"is crescendo, or the type is stop for a wedge that began with a diminuendo type. The line-type is solid if not"},{"type":"text","text":" "},{"type":"text","text":"specified."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLWedge"}],"navigatorTitle":[{"kind":"identifier","text":"MXLWedge"}],"url":"\/documentation\/ivormxl\/mxlwedge"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"type":"topic","abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"type":"text","text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is"},{"type":"text","text":" "},{"type":"text","text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF."}],"url":"\/documentation\/ivormxl\/mxlcolor","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"kind":"symbol","title":"MXLColor","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLLineKind":{"type":"topic","title":"MXLLineKind","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLineKind","abstract":[{"text":"The line-type type distinguishes between solid, dashed, dotted, and wavy lines.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLLineKind"}],"navigatorTitle":[{"kind":"identifier","text":"MXLLineKind"}],"url":"\/documentation\/ivormxl\/mxllinekind"},"doc://IvorMXL/documentation/IvorMXL/MXLTenths":{"type":"topic","abstract":[{"type":"text","text":"The tenths type is a number representing tenths of interline staff space (positive or negative). Both integer"},{"type":"text","text":" "},{"type":"text","text":"and decimal values are allowed, such as 5 for a half space and 2.5 for a quarter space. Interline space is"},{"type":"text","text":" "},{"type":"text","text":"measured from the middle of a staff line."}],"url":"\/documentation\/ivormxl\/mxltenths","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTenths"}],"kind":"symbol","title":"MXLTenths","navigatorTitle":[{"kind":"identifier","text":"MXLTenths"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLWedge/init(id:kind:number:spread:isNiente:lineKind:dashLength:spaceLength:position:color:)":{"type":"topic","title":"init(id:kind:number:spread:isNiente:lineKind:dashLength:spaceLength:position:color:)","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLWedge\/init(id:kind:number:spread:isNiente:lineKind:dashLength:spaceLength:position:color:)","abstract":[{"type":"text","text":"Creates a new "},{"code":"MXLWedge","type":"codeVoice"},{"type":"text","text":"."}],"role":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"id"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"kind"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Kind","preciseIdentifier":"s:7IvorMXL8MXLWedgeV4KindO"},{"kind":"text","text":", "},{"kind":"externalParam","text":"number"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLNumberLevel","preciseIdentifier":"s:7IvorMXL14MXLNumberLevelV"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"spread"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLTenths","preciseIdentifier":"s:7IvorMXL9MXLTenthsa"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"isNiente"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"lineKind"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLLineKind","preciseIdentifier":"s:7IvorMXL11MXLLineKindO"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"dashLength"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLTenths","preciseIdentifier":"s:7IvorMXL9MXLTenthsa"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"spaceLength"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLTenths","preciseIdentifier":"s:7IvorMXL9MXLTenthsa"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"position"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLPosition","preciseIdentifier":"s:7IvorMXL11MXLPositionV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"color"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLColor","preciseIdentifier":"s:7IvorMXL8MXLColorV"},{"kind":"text","text":"?)"}],"url":"\/documentation\/ivormxl\/mxlwedge\/init(id:kind:number:spread:isniente:linekind:dashlength:spacelength:position:color:)"}}}