n the wedge lines at this point. Ignored at the start of a crescendo wedge or the end of a diminuendo wedge.","type":"text"}],"type":"paragraph"}]},{"name":"isNiente","content":[{"type":"paragraph","inlineContent":[{"text":"A Boolean value indicating whether a circle appears at the point of the wedge, indicating a crescendo from nothing or diminuendo to nothing.","type":"text"}]}]},{"name":"lineKind","content":[{"inlineContent":[{"text":"The line-type attribute distinguishes between solid, dashed, dotted, and wavy lines.","type":"text"}],"type":"paragraph"}]},{"name":"dashLength","content":[{"inlineContent":[{"text":"The length, in tenths, of the dashes in a dashed line. Ignored if the corresponding line-type attribute is not dashed.","type":"text"}],"type":"paragraph"}]},{"name":"spaceLength","content":[{"inlineContent":[{"type":"text","text":"The length, in tenths, of the spaces in a dashed line. Ignored if the corresponding line-type attribute is not dashed."}],"type":"paragraph"}]},{"name":"position","content":[{"inlineContent":[{"type":"text","text":"For most elements, any program will compute a default x and y position. The position attributes let this be changed two ways."}],"type":"paragraph"}]},{"name":"color","content":[{"type":"paragraph","inlineContent":[{"text":"The color attribute group indicates the color of an element.","type":"text"}]}]}]}],"sections":[],"metadata":{"modules":[{"name":"IvorMXL"}],"symbolKind":"init","title":"init(id:kind:number:spread:isNiente:lineKind:dashLength:spaceLength:position:color:)","roleHeading":"Initializer","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"kind","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Kind","preciseIdentifier":"s:7IvorMXL8MXLWedgeV4KindO","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"number","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLNumberLevel","preciseIdentifier":"s:7IvorMXL14MXLNumberLevelV","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"spread","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLTenths","preciseIdentifier":"s:7IvorMXL9MXLTenthsa","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"isNiente","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"lineKind","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLLineKind","preciseIdentifier":"s:7IvorMXL11MXLLineKindO","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"dashLength","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLTenths","preciseIdentifier":"s:7IvorMXL9MXLTenthsa","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"spaceLength","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLTenths","preciseIdentifier":"s:7IvorMXL9MXLTenthsa","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"position","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLPosition","preciseIdentifier":"s:7IvorMXL11MXLPositionV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"color","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLColor","preciseIdentifier":"s:7IvorMXL8MXLColorV","kind":"typeIdentifier"},{"text":"?)","kind":"text"}],"role":"symbol","externalID":"s:7IvorMXL8MXLWedgeV2id4kind6number6spread8isNiente8lineKind10dashLength05spaceM08position5colorACSSSg_AC0K0OAA14MXLNumberLevelVSgSdSgSbSgAA07MXLLineK0OSgA2tA11MXLPositionVAA8MXLColorVSgtcfc"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlwedge\/init(id:kind:number:spread:isniente:linekind:dashlength:spacelength:position:color:)"]}],"references":{"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLWedge":{"title":"MXLWedge","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLWedge","kind":"identifier"}],"navigatorTitle":[{"text":"MXLWedge","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlwedge","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLWedge","abstract":[{"text":"The wedge type represents crescendo and diminuendo wedge symbols. The type attribute is crescendo for the","type":"text"},{"text":" ","type":"text"},{"text":"start of a wedge that is closed at the left side, and diminuendo for the start of a wedge that is closed on","type":"text"},{"text":" ","type":"text"},{"text":"the right side. Spread values are measured in tenths; those at the start of a crescendo wedge or end of a","type":"text"},{"text":" ","type":"text"},{"text":"diminuendo wedge are ignored. The niente attribute is yes if a circle appears at the point of the wedge,","type":"text"},{"text":" ","type":"text"},{"text":"indicating a crescendo from nothing or diminuendo to nothing. It is no by default, and used only when the type","type":"text"},{"text":" ","type":"text"},{"text":"is crescendo, or the type is stop for a wedge that began with a diminuendo type. The line-type is solid if not","type":"text"},{"text":" ","type":"text"},{"text":"specified.","type":"text"}],"type":"topic","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLTenths":{"title":"MXLTenths","kind":"symbol","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTenths"}],"abstract":[{"type":"text","text":"The tenths type is a number representing tenths of interline staff space (positive or negative). Both integer"},{"type":"text","text":" "},{"type":"text","text":"and decimal values are allowed, such as 5 for a half space and 2.5 for a quarter space. Interline space is"},{"type":"text","text":" "},{"type":"text","text":"measured from the middle of a staff line."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLTenths"}],"url":"\/documentation\/ivormxl\/mxltenths"},"doc://IvorMXL/documentation/IvorMXL/MXLLineKind":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLLineKind"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLLineKind"}],"url":"\/documentation\/ivormxl\/mxllinekind","abstract":[{"type":"text","text":"The line-type type distinguishes between solid, dashed, dotted, and wavy lines."}],"title":"MXLLineKind","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLineKind","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLPosition":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlposition","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPosition"}],"kind":"symbol","abstract":[{"text":"For most elements, any program will compute a default x and y position. The position attributes let this be","type":"text"},{"text":" ","type":"text"},{"text":"changed two ways.","type":"text"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLPosition"}],"title":"MXLPosition"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"title":"MXLColor","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"abstract":[{"text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in","type":"text"},{"text":" ","type":"text"},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"url":"\/documentation\/ivormxl\/mxlcolor"},"doc://IvorMXL/documentation/IvorMXL/MXLWedge/Kind-swift.enum":{"title":"MXLWedge.Kind","kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Kind","kind":"identifier"}],"navigatorTitle":[{"text":"Kind","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLWedge\/Kind-swift.enum","url":"\/documentation\/ivormxl\/mxlwedge\/kind-swift.enum","type":"topic","abstract":[{"type":"text","text":"The wedge type is crescendo for the start of a wedge that is closed at the left side, diminuendo for the"},{"type":"text","text":" "},{"type":"text","text":"start of a wedge that is closed on the right side, and stop for the end of a wedge. The continue type is"},{"type":"text","text":" "},{"type":"text","text":"used for formatting wedges over a system break, or for other situations where a single wedge is divided"},{"type":"text","text":" "},{"type":"text","text":"into multiple segments."}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLWedge/init(id:kind:number:spread:isNiente:lineKind:dashLength:spaceLength:position:color:)":{"title":"init(id:kind:number:spread:isNiente:lineKind:dashLength:spaceLength:position:color:)","url":"\/documentation\/ivormxl\/mxlwedge\/init(id:kind:number:spread:isniente:linekind:dashlength:spacelength:position:color:)","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLWedge\/init(id:kind:number:spread:isNiente:lineKind:dashLength:spaceLength:position:color:)","type":"topic","role":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"kind","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Kind","preciseIdentifier":"s:7IvorMXL8MXLWedgeV4KindO","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"number","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLNumberLevel","preciseIdentifier":"s:7IvorMXL14MXLNumberLevelV","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"spread","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLTenths","preciseIdentifier":"s:7IvorMXL9MXLTenthsa","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"isNiente","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"lineKind","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLLineKind","preciseIdentifier":"s:7IvorMXL11MXLLineKindO","kind":"typeIdentifier"},{"kind":"text","text":"?, "},{"text":"dashLength","kind":"externalParam"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLTenths","preciseIdentifier":"s:7IvorMXL9MXLTenthsa"},{"kind":"text","text":"?, "},{"text":"spaceLength","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLTenths","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLTenthsa"},{"text":"?, ","kind":"text"},{"text":"position","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLPosition","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLPositionV"},{"text":", ","kind":"text"},{"text":"color","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLColor","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLColorV"},{"text":"?)","kind":"text"}],"kind":"symbol","abstract":[{"text":"Creates a new ","type":"text"},{"type":"codeVoice","code":"MXLWedge"},{"type":"text","text":"."}]},"doc://IvorMXL/documentation/IvorMXL/MXLNumberLevel":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlnumberlevel","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumberLevel","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNumberLevel","kind":"identifier"}],"kind":"symbol","abstract":[{"type":"text","text":"Slurs, tuplets, and many other features can be concurrent and overlap within a single musical part. The"},{"type":"text","text":" "},{"type":"text","text":"number-level entity distinguishes up to 16 concurrent objects of the same type when the objects overlap in"},{"type":"text","text":" "},{"type":"text","text":"MusicXML document order. Values greater than 6 are usually only needed for music with a large number of divisi"},{"type":"text","text":" "},{"type":"text","text":"staves in a single part, or if there are more than 6 cross-staff arpeggios in a single measure. When a number-"},{"type":"text","text":" "},{"type":"text","text":"level value is implied, the value is 1 by default."}],"type":"topic","navigatorTitle":[{"text":"MXLNumberLevel","kind":"identifier"}],"title":"MXLNumberLevel"}}}