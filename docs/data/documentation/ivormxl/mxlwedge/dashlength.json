{"metadata":{"externalID":"s:7IvorMXL8MXLWedgeV10dashLengthSdSgvp","title":"dashLength","role":"symbol","symbolKind":"property","modules":[{"name":"IvorMXL"}],"roleHeading":"Instance Property","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"dashLength"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLTenths","preciseIdentifier":"s:7IvorMXL9MXLTenthsa"},{"kind":"text","text":"?"}]},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLWedge"]]},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"dashLength"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLTenths","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths","preciseIdentifier":"s:7IvorMXL9MXLTenthsa"},{"kind":"text","text":"?"}],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"inlineContent":[{"type":"text","text":"Maps to the MusicXML "},{"type":"codeVoice","code":"dash-length"},{"type":"text","text":" attribute."}],"type":"paragraph"}]}],"kind":"symbol","abstract":[{"type":"text","text":"The length, in tenths, of the dashes in a dashed line. Ignored if the corresponding line-type attribute is"},{"type":"text","text":" "},{"type":"text","text":"not dashed."}],"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLWedge\/dashLength"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlwedge\/dashlength"]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLTenths":{"type":"topic","abstract":[{"type":"text","text":"The tenths type is a number representing tenths of interline staff space (positive or negative). Both integer"},{"type":"text","text":" "},{"type":"text","text":"and decimal values are allowed, such as 5 for a half space and 2.5 for a quarter space. Interline space is"},{"type":"text","text":" "},{"type":"text","text":"measured from the middle of a staff line."}],"url":"\/documentation\/ivormxl\/mxltenths","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTenths"}],"kind":"symbol","title":"MXLTenths","navigatorTitle":[{"kind":"identifier","text":"MXLTenths"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLWedge/dashLength":{"type":"topic","title":"dashLength","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLWedge\/dashLength","abstract":[{"type":"text","text":"The length, in tenths, of the dashes in a dashed line. Ignored if the corresponding line-type attribute is"},{"type":"text","text":" "},{"type":"text","text":"not dashed."}],"role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"dashLength"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLTenths","preciseIdentifier":"s:7IvorMXL9MXLTenthsa"},{"kind":"text","text":"?"}],"url":"\/documentation\/ivormxl\/mxlwedge\/dashlength"},"doc://IvorMXL/documentation/IvorMXL/MXLWedge":{"type":"topic","title":"MXLWedge","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLWedge","abstract":[{"type":"text","text":"The wedge type represents crescendo and diminuendo wedge symbols. The type attribute is crescendo for the"},{"type":"text","text":" "},{"type":"text","text":"start of a wedge that is closed at the left side, and diminuendo for the start of a wedge that is closed on"},{"type":"text","text":" "},{"type":"text","text":"the right side. Spread values are measured in tenths; those at the start of a crescendo wedge or end of a"},{"type":"text","text":" "},{"type":"text","text":"diminuendo wedge are ignored. The niente attribute is yes if a circle appears at the point of the wedge,"},{"type":"text","text":" "},{"type":"text","text":"indicating a crescendo from nothing or diminuendo to nothing. It is no by default, and used only when the type"},{"type":"text","text":" "},{"type":"text","text":"is crescendo, or the type is stop for a wedge that began with a diminuendo type. The line-type is solid if not"},{"type":"text","text":" "},{"type":"text","text":"specified."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLWedge"}],"navigatorTitle":[{"kind":"identifier","text":"MXLWedge"}],"url":"\/documentation\/ivormxl\/mxlwedge"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"}}}