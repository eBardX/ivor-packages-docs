{"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"metadata":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isNiente","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"role":"symbol","modules":[{"name":"IvorMXL"}],"externalID":"s:7IvorMXL8MXLWedgeV8isNienteSbSgvp","symbolKind":"property","roleHeading":"Instance Property","title":"isNiente"},"abstract":[{"text":"A Boolean value indicating whether a circle appears at the point of the wedge, indicating a crescendo from","type":"text"},{"text":" ","type":"text"},{"text":"nothing or diminuendo to nothing.","type":"text"}],"variants":[{"paths":["\/documentation\/ivormxl\/mxlwedge\/isniente"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isNiente","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"platforms":["macOS"]}]},{"content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Maps to the MusicXML "},{"type":"codeVoice","code":"niente"},{"type":"text","text":" attribute."}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLWedge\/isNiente","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLWedge"]]},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLWedge/isNiente":{"title":"isNiente","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLWedge\/isNiente","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isNiente","kind":"identifier"},{"kind":"text","text":"