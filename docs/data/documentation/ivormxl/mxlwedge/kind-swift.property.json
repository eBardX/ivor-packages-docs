{"abstract":[{"type":"text","text":"Whether this is the start of a crescendo or diminuendo wedge, the end of a wedge, or a continuation of one"},{"type":"text","text":" "},{"type":"text","text":"divided into multiple segments."}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"kind","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Kind","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLWedge\/Kind-swift.enum","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLWedgeV4KindO"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"inlineContent":[{"text":"Maps to the MusicXML ","type":"text"},{"code":"type","type":"codeVoice"},{"text":" attribute.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/ivormxl\/mxlwedge\/kind-swift.property"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"roleHeading":"Instance Property","modules":[{"name":"IvorMXL"}],"symbolKind":"property","role":"symbol","title":"kind","externalID":"s:7IvorMXL8MXLWedgeV4kindAC4KindOvp","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"kind","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Kind","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLWedgeV4KindO"}]},"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLWedge"]]},"kind":"symbol","identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLWedge\/kind-swift.property","interfaceLanguage":"swift"},"sections":[],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLWedge":{"type":"topic","title":"MXLWedge","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLWedge","abstract":[{"type":"text","text":"The wedge type represents crescendo and diminuendo wedge symbols. The type attribute is crescendo for the"},{"type":"text","text":" "},{"type":"text","text":"start of a wedge that is closed at the left side, and diminuendo for the start of a wedge that is closed on"},{"type":"text","text":" "},{"type":"text","text":"the right side. Spread values are measured in tenths; those at the start of a crescendo wedge or end of a"},{"type":"text","text":" "},{"type":"text","text":"diminuendo wedge are ignored. The niente attribute is yes if a circle appears at the point of the wedge,"},{"type":"text","text":" "},{"type":"text","text":"indicating a crescendo from nothing or diminuendo to nothing. It is no by default, and used only when the type"},{"type":"text","text":" "},{"type":"text","text":"is crescendo, or the type is stop for a wedge that began with a diminuendo type. The line-type is solid if not"},{"type":"text","text":" "},{"type":"text","text":"specified."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLWedge"}],"navigatorTitle":[{"kind":"identifier","text":"MXLWedge"}],"url":"\/documentation\/ivormxl\/mxlwedge"},"doc://IvorMXL/documentation/IvorMXL/MXLWedge/kind-swift.property":{"type":"topic","title":"kind","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLWedge\/kind-swift.property","abstract":[{"type":"text","text":"Whether this is the start of a crescendo or diminuendo wedge, the end of a wedge, or a continuation of one"},{"type":"text","text":" "},{"type":"text","text":"divided into multiple segments."}],"role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"kind"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Kind","preciseIdentifier":"s:7IvorMXL8MXLWedgeV4KindO"}],"url":"\/documentation\/ivormxl\/mxlwedge\/kind-swift.property"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLWedge/Kind-swift.enum":{"kind":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Kind"}],"role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLWedge\/Kind-swift.enum","title":"MXLWedge.Kind","navigatorTitle":[{"kind":"identifier","text":"Kind"}],"url":"\/documentation\/ivormxl\/mxlwedge\/kind-swift.enum","abstract":[{"type":"text","text":"The wedge type is crescendo for the start of a wedge that is closed at the left side, diminuendo for the"},{"type":"text","text":" "},{"type":"text","text":"start of a wedge that is closed on the right side, and stop for the end of a wedge. The continue type is"},{"type":"text","text":" "},{"type":"text","text":"used for formatting wedges over a system break, or for other situations where a single wedge is divided"},{"type":"text","text":" "},{"type":"text","text":"into multiple segments."}],"type":"topic"}}}