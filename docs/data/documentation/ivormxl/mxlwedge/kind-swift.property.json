nd":"identifier"}],"navigatorTitle":[{"text":"MXLWedge","kind":"identifier"}],"abstract":[{"text":"The wedge type represents crescendo and diminuendo wedge symbols. The type attribute is crescendo for the","type":"text"},{"text":" ","type":"text"},{"text":"start of a wedge that is closed at the left side, and diminuendo for the start of a wedge that is closed on","type":"text"},{"text":" ","type":"text"},{"text":"the right side. Spread values are measured in tenths; those at the start of a crescendo wedge or end of a","type":"text"},{"text":" ","type":"text"},{"text":"diminuendo wedge are ignored. The niente attribute is yes if a circle appears at the point of the wedge,","type":"text"},{"text":" ","type":"text"},{"text":"indicating a crescendo from nothing or diminuendo to nothing. It is no by default, and used only when the type","type":"text"},{"text":" ","type":"text"},{"text":"is crescendo, or the type is stop for a wedge that began with a diminuendo type. The line-type is solid if not","type":"text"},{"text":" ","type":"text"},{"text":"specified.","type":"text"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLWedge"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLWedge/Kind-swift.enum":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLWedge\/Kind-swift.enum","url":"\/documentation\/ivormxl\/mxlwedge\/kind-swift.enum","abstract":[{"text":"The wedge type is crescendo for the start of a wedge that is closed at the left side, diminuendo for the","type":"text"},{"text":" ","type":"text"},{"text":"start of a wedge that is closed on the right side, and stop for the end of a wedge. The continue type is","type":"text"},{"text":" ","type":"text"},{"text":"used for formatting wedges over a system break, or for other situations where a single wedge is divided","type":"text"},{"text":" ","type":"text"},{"text":"into multiple segments.","type":"text"}],"type":"topic","role":"symbol","kind":"symbol","title":"MXLWedge.Kind","navigatorTitle":[{"text":"Kind","kind":"identifier"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Kind","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLWedge/kind-swift.property":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLWedge\/kind-swift.property","url":"\/documentation\/ivormxl\/mxlwedge\/kind-swift.property","abstract":[{"type":"text","text":"Whether this is the start of a crescendo or diminuendo wedge, the end of a wedge, or a continuation of one"},{"type":"text","text":" "},{"type":"text","text":"divided into multiple segments."}],"type":"topic","role":"symbol","kind":"symbol","title":"kind","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"kind","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Kind","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLWedgeV4KindO"}]}}}