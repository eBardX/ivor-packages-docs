{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLWedge\/Kind-swift.enum\/continue"},"metadata":{"modules":[{"name":"IvorMXL"}],"roleHeading":"Case","title":"MXLWedge.Kind.continue","symbolKind":"case","externalID":"s:7IvorMXL8MXLWedgeV4KindO8continueyA2EmF","role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"`continue`","kind":"identifier"}]},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLWedge","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLWedge\/Kind-swift.enum"]]},"kind":"symbol","primaryContentSections":[{"declarations":[{"tokens":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"`continue`","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"}],"abstract":[{"type":"text","text":"A continuation of a wedge, used for formatting across a system break or when a wedge is divided into"},{"type":"text","text":" "},{"type":"text","text":"multiple segments."}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlwedge\/kind-swift.enum\/continue"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLWedge/Kind-swift.enum":{"title":"MXLWedge.Kind","kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Kind","kind":"identifier"}],"navigatorTitle":[{"text":"Kind","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLWedge\/Kind-swift.enum","url":"\/documentation\/ivormxl\/mxlwedge\/kind-swift.enum","type":"topic","abstract":[{"type":"text","text":"The wedge type is crescendo for the start of a wedge that is closed at the left side, diminuendo for the"},{"type":"text","text":" "},{"type":"text","text":"start of a wedge that is closed on the right side, and stop for the end of a wedge. The continue type is"},{"type":"text","text":" "},{"type":"text","text":"used for formatting wedges over a system break, or for other situations where a single wedge is divided"},{"type":"text","text":" "},{"type":"text","text":"into multiple segments."}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLWedge":{"title":"MXLWedge","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLWedge","kind":"identifier"}],"navigatorTitle":[{"text":"MXLWedge","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlwedge","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLWedge","abstract":[{"text":"The wedge type represents crescendo and diminuendo wedge symbols. The type attribute is crescendo for the","type":"text"},{"text":" ","type":"text"},{"text":"start of a wedge that is closed at the left side, and diminuendo for the start of a wedge that is closed on","type":"text"},{"text":" ","type":"text"},{"text":"the right side. Spread values are measured in tenths; those at the start of a crescendo wedge or end of a","type":"text"},{"text":" ","type":"text"},{"text":"diminuendo wedge are ignored. The niente attribute is yes if a circle appears at the point of the wedge,","type":"text"},{"text":" ","type":"text"},{"text":"indicating a crescendo from nothing or diminuendo to nothing. It is no by default, and used only when the type","type":"text"},{"text":" ","type":"text"},{"text":"is crescendo, or the type is stop for a wedge that began with a diminuendo type. The line-type is solid if not","type":"text"},{"text":" ","type":"text"},{"text":"specified.","type":"text"}],"type":"topic","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLWed