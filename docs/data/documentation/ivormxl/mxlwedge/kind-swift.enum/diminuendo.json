kind":"identifier"}],"navigatorTitle":[{"text":"Kind","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlwedge\/kind-swift.enum","abstract":[{"text":"The wedge type is crescendo for the start of a wedge that is closed at the left side, diminuendo for the","type":"text"},{"text":" ","type":"text"},{"text":"start of a wedge that is closed on the right side, and stop for the end of a wedge. The continue type is","type":"text"},{"text":" ","type":"text"},{"text":"used for formatting wedges over a system break, or for other situations where a single wedge is divided","type":"text"},{"text":" ","type":"text"},{"text":"into multiple segments.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLWedge":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLWedge","title":"MXLWedge","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLWedge","kind":"identifier"}],"navigatorTitle":[{"text":"MXLWedge","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlwedge","abstract":[{"text":"The wedge type represents crescendo and diminuendo wedge symbols. The type attribute is crescendo for the","type":"text"},{"text":" ","type":"text"},{"text":"start of a wedge that is closed at the left side, and diminuendo for the start of a wedge that is closed on","type":"text"},{"text":" ","type":"text"},{"text":"the right side. Spread values are measured in tenths; those at the start of a crescendo wedge or end of a","type":"text"},{"text":" ","type":"text"},{"text":"diminuendo wedge are ignored. The niente attribute is yes if a circle appears at the point of the wedge,","type":"text"},{"text":" ","type":"text"},{"text":"indicating a crescendo from nothing or diminuendo to nothing. It is no by default, and used only when the type","type":"text"},{"text":" ","type":"text"},{"text":"is crescendo, or the type is stop for a wedge that began with a diminuendo type. The line-type is solid if not","type":"text"},{"text":" ","type":"text"},{"text":"specified.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"}}}