or for other situations where a single wedge is divided"},{"type":"text","text":" "},{"type":"text","text":"into multiple segments."}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLWedge":{"type":"topic","title":"MXLWedge","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLWedge","abstract":[{"type":"text","text":"The wedge type represents crescendo and diminuendo wedge symbols. The type attribute is crescendo for the"},{"type":"text","text":" "},{"type":"text","text":"start of a wedge that is closed at the left side, and diminuendo for the start of a wedge that is closed on"},{"type":"text","text":" "},{"type":"text","text":"the right side. Spread values are measured in tenths; those at the start of a crescendo wedge or end of a"},{"type":"text","text":" "},{"type":"text","text":"diminuendo wedge are ignored. The niente attribute is yes if a circle appears at the point of the wedge,"},{"type":"text","text":" "},{"type":"text","text":"indicating a crescendo from nothing or diminuendo to nothing. It is no by default, and used only when the type"},{"type":"text","text":" "},{"type":"text","text":"is crescendo, or the type is stop for a wedge that began with a diminuendo type. The line-type is solid if not"},{"type":"text","text":" "},{"type":"text","text":"specified."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLWedge"}],"navigatorTitle":[{"kind":"identifier","text":"MXLWedge"}],"url":"\/documentation\/ivormxl\/mxlwedge"},"doc://IvorMXL/documentation/IvorMXL/MXLWedge/Kind-swift.enum/diminuendo":{"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"diminuendo","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLWedge\/Kind-swift.enum\/diminuendo","abstract":[{"text":"The start of a wedge that is closed at the right side.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlwedge\/kind-s