"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The font attribute group gathers together attributes for determining the font within a"},{"type":"text","text":" "},{"type":"text","text":"credit or direction. They are based on the text styles for Cascading Style Sheets. The"},{"type":"text","text":" "},{"type":"text","text":"font-family is a comma-separated list of font names. The font-style can be normal or"},{"type":"text","text":" "},{"type":"text","text":"italic. The font-size can be one of the CSS sizes or a numeric point size. The"},{"type":"text","text":" "},{"type":"text","text":"font-weight can be normal or bold. The default is application-dependent, but is a text"},{"type":"text","text":" "},{"type":"text","text":"font vs. a music font."}]}]},{"name":"color","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The color attribute group indicates the color of an element."}]}]},{"name":"placement","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The placement attribute indicates whether something is above or below another element,"},{"type":"text","text":" "},{"type":"text","text":"such as a note or a notation."}]}]}],"kind":"parameters"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBreathMark\/init(value:position:font:color:placement:)"},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlbreathmark\/init(value:position:font:color:placement:)"]}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBreathMark"]]},"sections":[],"abstract":[{"text":"Creates a new ","type":"text"},{"type":"codeVoice","code":"MXLBreathMark"},{"text":".","type":"text"}],"metadata":{"symbolKind":"init","externalID":"s:7IvorMXL13MXLBreathMarkV5value8position4font5color9placementA2C5ValueO_AA11MXLPositionVAA7MXLFontVAA8MXLColorVSgAA13MXLAboveBelowOSgtcfc","modu