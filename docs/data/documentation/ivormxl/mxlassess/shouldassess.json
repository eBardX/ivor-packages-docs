essment to be overridden for individual"},{"type":"text","text":" "},{"type":"text","text":"notes. The optional player and time-only attributes restrict the type to apply to a single player or set of"},{"type":"text","text":" "},{"type":"text","text":"times through a repeated section, respectively. If missing, the type applies to all players or all times"},{"type":"text","text":" "},{"type":"text","text":"through the repeated section, respectively. The player attribute references the id attribute of a player"},{"type":"text","text":" "},{"type":"text","text":"element defined within the matching score-part."}],"url":"\/documentation\/ivormxl\/mxlassess","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAssess","type":"topic","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"text":"MXLAssess","kind":"identifier"}],"title":"MXLAssess","navigatorTitle":[{"text":"MXLAssess","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLAssess/shouldAssess":{"kind":"symbol","abstract":[{"type":"text","text":"A Boolean value indicating whether the note should ("},{"type":"codeVoice","code":"true"},{"type":"text","text":") or should not ("},{"type":"codeVoice","code":"false"},{"type":"text","text":") be assessed."}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"shouldAssess","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"url":"\/documentation\/ivormxl\/mxlassess\/shouldassess","title":"shouldAssess","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAssess\/shouldAssess","type":"topic"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]}}}