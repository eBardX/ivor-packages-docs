{"abstract":[{"type":"text","text":"A Boolean value indicating whether the note should ("},{"code":"true","type":"codeVoice"},{"type":"text","text":") or should not ("},{"code":"false","type":"codeVoice"},{"type":"text","text":") be assessed."}],"kind":"symbol","metadata":{"roleHeading":"Instance Property","symbolKind":"property","externalID":"s:7IvorMXL9MXLAssessV12shouldAssessSbvp","title":"shouldAssess","modules":[{"name":"IvorMXL"}],"role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"shouldAssess","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}]},"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAssess\/shouldAssess"},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"shouldAssess","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"inlineContent":[{"text":"Maps to the MusicXML ","type":"text"},{"code":"type","type":"codeVoice"},{"text":" attribute.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/ivormxl\/mxlassess\/shouldassess"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAssess"]]},"sections":[],"references":{"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLAssess/shouldAssess":{"title":"shouldAssess","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"text":"shouldAssess","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlassess\/shouldassess","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAssess\/shouldAssess","abstract":[{"type":"text","text":"A Boolean value indicating whether the note should ("},{"type":"codeVoice","code":"true"},{"type":"text","text":") or should not ("},{"type":"codeVoice","code":"false"},{"type":"text","text":") be assessed."}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLAssess":{"type":"topic","abstract":[{"type":"text","text":"By default, an assessment application should assess all notes without a cue child element, and not assess any"},{"type":"text","text":" "},{"type":"text","text":"note with a cue child element. The assess type allows this default assessment to be overridden for individual"},{"type":"text","text":" "},{"type":"text","text":"notes. The optional player and time-only attributes restrict the type to apply to a single player or set of"},{"type":"text","text":" "},{"type":"text","text":"times through a repeated section, respectively. If missing, the type applies to all players or all times"},{"type":"text","text":" "},{"type":"text","text":"through the repeated section, respectively. The player attribute references the id attribute of a player"},{"type":"text","text":" "},{"type":"text","text":"element defined within the matching score-part."}],"url":"\/documentation\/ivormxl\/mxlassess","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLAssess"}],"kind":"symbol","title":"MXLAssess","navigatorTitle":[{"kind":"identifier","text":"MXLAssess"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAssess","role":"symbol"}}}