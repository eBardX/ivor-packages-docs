{"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAssess"]]},"abstract":[{"type":"text","text":"Restricts the assessment to a set of times through a repeated section."}],"sections":[],"variants":[{"paths":["\/documentation\/ivormxl\/mxlassess\/timeonly"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","metadata":{"symbolKind":"property","externalID":"s:7IvorMXL9MXLAssessV8timeOnlySaySiGSgvp","title":"timeOnly","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"timeOnly"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL11MXLTimeOnlya","kind":"typeIdentifier","text":"MXLTimeOnly"},{"kind":"text","text":"?"}],"roleHeading":"Instance Property","modules":[{"name":"IvorMXL"}],"role":"symbol"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAssess\/timeOnly"},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"timeOnly"},{"text":": ","kind":"text"},{"text":"MXLTimeOnly","preciseIdentifier":"s:7IvorMXL11MXLTimeOnlya","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTimeOnly"},{"kind":"text","text":"?"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"inlineContent":[{"type":"text","text":"Maps to the MusicXML "},{"type":"codeVoice","code":"time-only"},{"type":"text","text":" attribute."}],"type":"paragraph"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLAssess":{"url":"\/documentation\/ivormxl\/mxlassess","navigatorTitle":[{"kind":"identifier","text":"MXLAssess"}],"type":"topic","kind":"symbol","abstract":[{"type":"text","text":"By default, an assessment application should assess all notes without a cue child element, and not assess any"},{"type":"text","text":" "},{"type":"text","text":"note with a cue child element. The assess type allows this default assessment to be overridden for individual"},{"type":"text","text":" "},{"type":"text","text":"notes. The optional player and time-only attributes restrict the type to apply to a single player or set of"},{"type":"text","text":" "},{"type":"text","text":"times through a repeated section, respectively. If missing, the type applies to all players or all times"},{"type":"text","text":" "},{"type":"text","text":"through the repeated section, respectively. The player attribute references the id attribute of a player"},{"type":"text","text":" "},{"type":"text","text":"element defined within the matching score-part."}],"role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAssess","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLAssess"}],"title":"MXLAssess"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLAssess/timeOnly":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlassess\/timeonly","type":"topic","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"timeOnly"},{"text":": ","kind":"text"},{"text":"MXLTimeOnly","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLTimeOnlya"},{"text":"?","kind":"text"}],"title":"timeOnly","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAssess\/timeOnly","abstract":[{"text":"Restricts the assessment to a set of times through a repeated section.","type":"text"}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLTimeOnly":{"fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTimeOnly"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTimeOnly","navigatorTitle":[{"kind":"identifier","text":"MXLTimeOnly"}],"type":"topic","title":"MXLTimeOnly","role":"symbol","abstract":[{"type":"text","text":"The time-only type is used to indicate that a particular playback- or listening-related element only applies"},{"type":"text","text":" "},{"type":"text","text":"particular times through a repeated section. The value is a list of positive integers arranged in ascending"},{"type":"text","text":" "},{"type":"text","text":"order, indicating which times through the repeated section that the element applies."}],"url":"\/documentation\/ivormxl\/mxltimeonly","kind":"symbol"}}}