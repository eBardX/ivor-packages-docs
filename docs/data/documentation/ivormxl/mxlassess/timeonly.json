},"doc://IvorMXL/documentation/IvorMXL/MXLAssess":{"title":"MXLAssess","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLAssess","kind":"identifier"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlassess","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAssess","abstract":[{"type":"text","text":"By default, an assessment application should assess all notes without a cue child element, and not assess any"},{"type":"text","text":" "},{"type":"text","text":"note with a cue child element. The assess type allows this default assessment to be overridden for individual"},{"type":"text","text":" "},{"type":"text","text":"notes. The optional player and time-only attributes restrict the type to apply to a single player or set of"},{"type":"text","text":" "},{"type":"text","text":"times through a repeated section, respectively. If missing, the type applies to all players or all times"},{"type":"text","text":" "},{"type":"text","text":"through the repeated section, respectively. The player attribute references the id attribute of a player"},{"type":"text","text":" "},{"type":"text","text":"element defined within the matching score-part."}],"navigatorTitle":[{"text":"MXLAssess","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLAssess/timeOnly":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAssess\/timeOnly","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"timeOnly"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL11MXLTimeOnlya","kind":"typeIdentifier","text":"MXLTimeOnly"},{"kind":"text","text":"?"}],"role":"symbol","type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlassess\/timeonly","title":"timeOnly","abstract":[{"type":"text","text":"Restricts the assessment to a set of times through a repeated section."}]},"doc://IvorMXL/documentation/IvorMXL/MXLTimeOnly":{"title":"MXLTimeOnly","role":"symbol","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTimeOnly"}],"kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxltimeonly","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTimeOnly","abstract":[{"text":"The time-only type is used to indicate that a particular playback- or listening-related element only applies","type":"text"},{"text":" ","type":"text"},{"text":"particular times through a repeated section. The value is a list of positive integers arranged in ascending","type":"text"},{"type":"text","text":" "},{"type":"text","text":"order, indicating which times through the repeated section that the element applies."}],"navigatorTitle":[{"kind":"identifier","text":"MXLTimeOnly"}]}}}