sess all notes without a cue child element, and not assess any","type":"text"},{"text":" ","type":"text"},{"text":"note with a cue child element. The assess type allows this default assessment to be overridden for individual","type":"text"},{"text":" ","type":"text"},{"text":"notes. The optional player and time-only attributes restrict the type to apply to a single player or set of","type":"text"},{"text":" ","type":"text"},{"text":"times through a repeated section, respectively. If missing, the type applies to all players or all times","type":"text"},{"text":" ","type":"text"},{"text":"through the repeated section, respectively. The player attribute references the id attribute of a player","type":"text"},{"text":" ","type":"text"},{"text":"element defined within the matching score-part.","type":"text"}],"title":"MXLAssess","url":"\/documentation\/ivormxl\/mxlassess","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLAssess","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLTimeOnly":{"role":"symbol","url":"\/documentation\/ivormxl\/mxltimeonly","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTimeOnly","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTimeOnly","kind":"identifier"}],"abstract":[{"text":"The time-only type is used to indicate that a particular playback- or listening-related element only applies","type":"text"},{"text":" ","type":"text"},{"text":"particular times through a repeated section. The value is a list of positive integers arranged in ascending","type":"text"},{"text":" ","type":"text"},{"text":"order, indicating which times through the repeated section that the element applies.","type":"text"}],"kind":"symbol","type":"topic","navigatorTitle":[{"text":"MXLTimeOnly","kind":"identifier"}],"title":"MXLTimeOnly"},"doc://IvorMXL/documentation/IvorMXL/MXLAssess/timeOnly":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAssess\/timeOnly","abst