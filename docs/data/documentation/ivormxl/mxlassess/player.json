ation/IvorMXL/MXLAssess":{"type":"topic","abstract":[{"type":"text","text":"By default, an assessment application should assess all notes without a cue child element, and not assess any"},{"type":"text","text":" "},{"type":"text","text":"note with a cue child element. The assess type allows this default assessment to be overridden for individual"},{"type":"text","text":" "},{"type":"text","text":"notes. The optional player and time-only attributes restrict the type to apply to a single player or set of"},{"type":"text","text":" "},{"type":"text","text":"times through a repeated section, respectively. If missing, the type applies to all players or all times"},{"type":"text","text":" "},{"type":"text","text":"through the repeated section, respectively. The player attribute references the id attribute of a player"},{"type":"text","text":" "},{"type":"text","text":"element defined within the matching score-part."}],"url":"\/documentation\/ivormxl\/mxlassess","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLAssess"}],"kind":"symbol","title":"MXLAssess","navigatorTitle":[{"kind":"identifier","text":"MXLAssess"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAssess","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLAssess/player":{"type":"topic","abstract":[{"type":"text","text":"References the id attribute of a player element defined within the matching score-part, restricting the"},{"type":"text","text":" "},{"type":"text","text":"assessment to that player."}],"url":"\/documentation\/ivormxl\/mxlassess\/player","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"player"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?"}],"kind":"symbol","title":"player","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAssess\/player","role":"symbol"}}}