ation/IvorMXL/MXLAssess/player":{"url":"\/documentation\/ivormxl\/mxlassess\/player","abstract":[{"text":"References the id attribute of a player element defined within the matching score-part, restricting the","type":"text"},{"text":" ","type":"text"},{"text":"assessment to that player.","type":"text"}],"kind":"symbol","title":"player","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAssess\/player","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"player"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLAssess":{"title":"MXLAssess","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLAssess","kind":"identifier"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlassess","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAssess","abstract":[{"type":"text","text":"By default, an assessment application should assess all notes without a cue child element, and not assess any"},{"type":"text","text":" "},{"type":"text","text":"note with a cue child element. The assess type allows this default assessment to be overridden for individual"},{"type":"text","text":" "},{"type":"text","text":"notes. The optional player and time-only attributes restrict the type to apply to a single player or set of"},{"type":"text","text":" "},{"type":"text","text":"times through a repeated section, respectively. If missing, the type applies to all players or all times"},{"type":"text","text":" "},{"type":"text","text":"through the repeated section, respectively. The player attribute references the id attribute of a player"},{"type":"text","text":" "},{"type":"text","text":"element defined within the matching score-part."}],"navigatorTitle":[{"text":"MXLAssess","kind":"identifier"}]}}}