"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTimeOnly","preciseIdentifier":"s:7IvorMXL11MXLTimeOnlya","kind":"typeIdentifier","text":"MXLTimeOnly"},{"kind":"text","text":"? = nil)"}],"platforms":["macOS"],"languages":["swift"]}]},{"parameters":[{"name":"shouldAssess","content":[{"inlineContent":[{"type":"text","text":"A Boolean value indicating whether the note should ("},{"code":"true","type":"codeVoice"},{"type":"text","text":") or should not ("},{"code":"false","type":"codeVoice"},{"type":"text","text":") be assessed."}],"type":"paragraph"}]},{"name":"player","content":[{"inlineContent":[{"type":"text","text":"References the id attribute of a player element defined within the matching score-part, restricting the assessment to that player."}],"type":"paragraph"}]},{"name":"timeOnly","content":[{"inlineContent":[{"type":"text","text":"Restricts the assessment to a set of times through a repeated section."}],"type":"paragraph"}]}],"kind":"parameters"}],"references":{"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLAssess":{"url":"\/documentation\/ivormxl\/mxlassess","navigatorTitle":[{"kind":"identifier","text":"MXLAssess"}],"type":"topic","kind":"symbol","abstract":[{"type":"text","text":"By default, an assessment application should assess all notes without a cue child element, and not assess any"},{"type":"text","text":" "},{"type":"text","text":"note with a cue child element. The assess type allows this default assessment to be overridden for individual"},{"type":"text","text":" "},{"type":"text","text":"notes. The optional player and time-only attributes restrict the type to apply to a single player or set of"},{"type":"text","text":" "},{"type":"text","text":"times through a repeated section, respectively. If missing, the type applies to all players or all times"},{"type":"text","text":" "},{"type":"text","text":"through the repeated section, respectively. The player attribute references the id attribute of a player"},{"type":"text","text":" "},{"type":"text","text":"element defined within the matching score-part."}],"role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAssess","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLAssess"}],"title":"MXLAssess"},"doc://IvorMXL/documentation/IvorMXL/MXLAssess/init(shouldAssess:player:timeOnly:)":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlassess\/init(shouldassess:player:timeonly:)","type":"topic","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"shouldAssess"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":", "},{"kind":"externalParam","text":"player"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"timeOnly"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLTimeOnly","preciseIdentifier":"s:7IvorMXL11MXLTimeOnlya"},{"kind":"text","text":"?)"}],"title":"init(shouldAssess:player:timeOnly:)","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAssess\/init(shouldAssess:player:timeOnly:)","abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLAssess"},{"type":"text","text":"."}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLTimeOnly":{"fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTimeOnly"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTimeOnly","navigatorTitle":[{"kind":"identifier","text":"MXLTimeOnly"}],"type":"topic","title":"MXLTimeOnly","role":"symbol","abstract":[{"type":"text","text":"The time-only type is used to indicate that a particular playback- or listening-related element only applies"},{"type":"text","text":" "},{"type":"text","text":"particular times through a repeated section. The value is a list of positive integers arranged in ascending"},{"type":"text","text":" "},{"type":"text","text":"order, indicating which times through the repeated section that the element applies."}],"url":"\/documentation\/ivormxl\/mxltimeonly","kind":"symbol"}}}