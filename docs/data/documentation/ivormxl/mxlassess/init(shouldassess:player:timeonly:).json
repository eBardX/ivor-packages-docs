{"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAssess"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"init","kind":"keyword"},{"text":"(","kind":"text"},{"text":"shouldAssess","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"player","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"timeOnly","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL11MXLTimeOnlya","text":"MXLTimeOnly","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTimeOnly"},{"text":"? = nil)","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}]},{"parameters":[{"name":"shouldAssess","content":[{"inlineContent":[{"type":"text","text":"A Boolean value indicating whether the note should ("},{"code":"true","type":"codeVoice"},{"type":"text","text":") or should not ("},{"code":"false","type":"codeVoice"},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"be assessed."}],"type":"paragraph"}]},{"name":"player","content":[{"inlineContent":[{"type":"text","text":"References the id attribute of a player element defined within the matching"},{"type":"text","text":" "},{"type":"text","text":"score-part, restricting the assessment to that player."}],"type":"paragraph"}]},{"name":"timeOnly","content":[{"inlineContent":[{"type":"text","text":"Restricts the assessment to a set of times through a repeated section."}],"type":"paragraph"}]}],"kind":"parameters"}],"sections":[],"kind":"symbol","variants":[{"paths":["\/documentation\/ivormxl\/mxlassess\/init(shouldassess:player:timeonly:)"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAssess\/init(shouldAssess:player:timeOnly:)","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Creates a new "},{"code":"MXLAssess","type":"codeVoice"},{"type":"text","text":"."}],"metadata":{"role":"symbol","modules":[{"name":"IvorMXL"}],"externalID":"s:7IvorMXL9MXLAssessV12shouldAssess6player8timeOnlyACSb_SSSgSaySiGSgtcfc","title":"init(shouldAssess:player:timeOnly:)","roleHeading":"Initializer","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"shouldAssess","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"player","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"timeOnly","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL11MXLTimeOnlya","text":"MXLTimeOnly","kind":"typeIdentifier"},{"text":"?)","kind":"text"}],"symbolKind":"init"},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLAssess/init(shouldAssess:player:timeOnly:)":{"title":"init(shouldAssess:player:timeOnly:)","fragments":[{"kind":"identifier","text":"init"},{"text":"(","kind":"text"},{"text":"shouldAssess","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":", ","kind":"text"},{"text":"player","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?, "},{"text":"timeOnly","kind":"externalParam"},{"kind":"text","text":": "},{"text":"MXLTimeOnly","preciseIdentifier":"s:7IvorMXL11MXLTimeOnlya","kind":"typeIdentifier"},{"kind":"text","text":"?)"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlassess\/init(shouldassess:player:timeonly:)","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAssess\/init(shouldAssess:player:timeOnly:)","abstract":[{"text":"Creates a new ","type":"text"},{"type":"codeVoice","code":"MXLAssess"},{"text":".","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLAssess":{"type":"topic","abstract":[{"type":"text","text":"By default, an assessment application should assess all notes without a cue child element, and not assess any"},{"type":"text","text":" "},{"type":"text","text":"note with a cue child element. The assess type allows this default assessment to be overridden for individual"},{"type":"text","text":" "},{"type":"text","text":"notes. The optional player and time-only attributes restrict the type to apply to a single player or set of"},{"type":"text","text":" "},{"type":"text","text":"times through a repeated section, respectively. If missing, the type applies to all players or all times"},{"type":"text","text":" "},{"type":"text","text":"through the repeated section, respectively. The player attribute references the id attribute of a player"},{"type":"text","text":" "},{"type":"text","text":"element defined within the matching score-part."}],"url":"\/documentation\/ivormxl\/mxlassess","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLAssess"}],"kind":"symbol","title":"MXLAssess","navigatorTitle":[{"kind":"identifier","text":"MXLAssess"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAssess","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLTimeOnly":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTimeOnly","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLTimeOnly"}],"type":"topic","title":"MXLTimeOnly","kind":"symbol","url":"\/documentation\/ivormxl\/mxltimeonly","abstract":[{"type":"text","text":"The time-only type is used to indicate that a particular playback- or listening-related element only applies"},{"type":"text","text":" "},{"type":"text","text":"particular times through a repeated section. The value is a list of positive integers arranged in ascending"},{"type":"text","text":" "},{"type":"text","text":"order, indicating which times through the repeated section that the element applies."}],"fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTimeOnly"}]}}}