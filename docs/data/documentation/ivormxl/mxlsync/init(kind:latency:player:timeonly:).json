nly":{"role":"symbol","url":"\/documentation\/ivormxl\/mxltimeonly","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTimeOnly","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTimeOnly","kind":"identifier"}],"abstract":[{"text":"The time-only type is used to indicate that a particular playback- or listening-related element only applies","type":"text"},{"text":" ","type":"text"},{"text":"particular times through a repeated section. The value is a list of positive integers arranged in ascending","type":"text"},{"text":" ","type":"text"},{"text":"order, indicating which times through the repeated section that the element applies.","type":"text"}],"kind":"symbol","type":"topic","navigatorTitle":[{"text":"MXLTimeOnly","kind":"identifier"}],"title":"MXLTimeOnly"},"doc://IvorMXL/documentation/IvorMXL/MXLMilliseconds":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMilliseconds","type":"topic","abstract":[{"text":"The milliseconds type represents an integral number of milliseconds.","type":"text"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlmilliseconds","title":"MXLMilliseconds","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLMilliseconds"}],"navigatorTitle":[{"kind":"identifier","text":"MXLMilliseconds"}]},"doc://IvorMXL/documentation/IvorMXL/MXLSync/Kind-swift.enum":{"url":"\/documentation\/ivormxl\/mxlsync\/kind-swift.enum","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSync\/Kind-swift.enum","abstract":[{"type":"text","text":"The sync-type type specifies the style that a score following application should use to synchronize an"},{"type":"text","text":" "},{"type":"text","text":"accompaniment with a performer. The none type indicates no synchronization to the performer. The tempo type"},{"type":"text","text":" "},{"type":"text","text":"indicates synchronization based on the performer tempo rather than individual events in the score. The event"},{"type":"text","text":" "},{"type":"text","text":"type indicates synchronization by following the performance of individual events in the score rather than"},{"type":"text","text":" "},{"type":"text","text":"the performer tempo. The mostly-tempo and mostly-event types combine these two approaches, with mostly-tempo"},{"type":"text","text":" "},{"type":"text","text":"giving more weight to tempo and mostly-event giving more weight to performed events. The always-event type"},{"type":"text","text":" "},{"type":"text","text":"provides the strictest synchronization by not being forgiving of missing performed events."}],"title":"MXLSync.Kind","kind":"symbol","role":"symbol","type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Kind","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"Kind"}]}}}