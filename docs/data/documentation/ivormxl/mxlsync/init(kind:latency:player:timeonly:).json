nc","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSync","abstract":[{"text":"The sync type specifies the style that a score following application should use to synchronize an","type":"text"},{"text":" ","type":"text"},{"text":"accompaniment with a performer. If this type is not included in a score, default synchronization depends on","type":"text"},{"text":" ","type":"text"},{"text":"the application.","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLSync/Kind-swift.enum":{"title":"MXLSync.Kind","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Kind","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlsync\/kind-swift.enum","role":"symbol","navigatorTitle":[{"text":"Kind","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSync\/Kind-swift.enum","abstract":[{"text":"The sync-type type specifies the style that a score following application should use to synchronize an","type":"text"},{"text":" ","type":"text"},{"text":"accompaniment with a performer. The none type indicates no synchronization to the performer. The tempo type","type":"text"},{"text":" ","type":"text"},{"text":"indicates synchronization based on the performer tempo rather than individual events in the score. The event","type":"text"},{"text":" ","type":"text"},{"text":"type indicates synchronization by following the performance of individual events in the score rather than","type":"text"},{"text":" ","type":"text"},{"text":"the performer tempo. The mostly-tempo and mostly-event types combine these two approaches, with mostly-tempo","type":"text"},{"text":" ","type":"text"},{"text":"giving more weight to tempo and mostly-event giving more weight to performed events. The always-event type","type":"text"},{"text":" ","type":"text"},{"text":"provides the strictest synchronization by not being forgiving of missing performed events.","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLTimeOnly":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTimeOnly","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLTimeOnly"}],"type":"topic","title":"MXLTimeOnly","kind":"symbol","url":"\/documentation\/ivormxl\/mxltimeonly","abstract":[{"type":"text","text":"The time-only type is used to indicate that a particular playback- or listening-related element only applies"},{"type":"text","text":" "},{"type":"text","text":"particular times through a repeated section. The value is a list of positive integers arranged in ascending"},{"type":"text","text":" "},{"type":"text","text":"order, indicating which times through the repeated section that the element applies."}],"fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTimeOnly"}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLSync/init(kind:latency:player:timeOnly:)":{"abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLSync"},{"type":"text","text":"."}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlsync\/init(kind:latency:player:timeonly:)","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSync\/init(kind:latency:player:timeOnly:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"kind"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Kind","preciseIdentifier":"s:7IvorMXL7MXLSyncV4KindO"},{"kind":"text","text":", "},{"kind":"externalParam","text":"latency"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL15MXLMillisecondsV","text":"MXLMillisec