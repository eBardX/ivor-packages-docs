."}],"references":{"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLSync/Kind-swift.enum":{"url":"\/documentation\/ivormxl\/mxlsync\/kind-swift.enum","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSync\/Kind-swift.enum","abstract":[{"type":"text","text":"The sync-type type specifies the style that a score following application should use to synchronize an"},{"type":"text","text":" "},{"type":"text","text":"accompaniment with a performer. The none type indicates no synchronization to the performer. The tempo type"},{"type":"text","text":" "},{"type":"text","text":"indicates synchronization based on the performer tempo rather than individual events in the score. The event"},{"type":"text","text":" "},{"type":"text","text":"type indicates synchronization by following the performance of individual events in the score rather than"},{"type":"text","text":" "},{"type":"text","text":"the performer tempo. The mostly-tempo and mostly-event types combine these two approaches, with mostly-tempo"},{"type":"text","text":" "},{"type":"text","text":"giving more weight to tempo and mostly-event giving more weight to performed events. The always-event type"},{"type":"text","text":" "},{"type":"text","text":"provides the strictest synchronization by not being forgiving of missing performed events."}],"title":"MXLSync.Kind","kind":"symbol","role":"symbol","type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Kind","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"Kind"}]},"doc://IvorMXL/documentation/IvorMXL/MXLSync":{"url":"\/documentation\/ivormxl\/mxlsync","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSync","abstract":[{"