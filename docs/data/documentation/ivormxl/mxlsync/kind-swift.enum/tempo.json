role":"symbol","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSync\/Kind-swift.enum\/tempo","url":"\/documentation\/ivormxl\/mxlsync\/kind-swift.enum\/tempo","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"tempo"}],"title":"MXLSync.Kind.tempo","abstract":[{"text":"Synchronization based on the performer tempo rather than individual events in the score.","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLSync/Kind-swift.enum":{"title":"MXLSync.Kind","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Kind","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlsync\/kind-swift.enum","role":"symbol","navigatorTitle":[{"text":"Kind","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSync\/Kind-swift.enum","abstract":[{"text":"The sync-type type specifies the style that a score following application should use to synchronize an","type":"text"},{"text":" ","type":"text"},{"text":"accompaniment with a performer. The none type indicates no synchronization to the performer. The tempo type","type":"text"},{"text":" ","type":"text"},{"text":"indicates synchronization based on the performer tempo rather than individual events in the score. The event","type":"text"},{"text":" ","type":"text"},{"text":"type indicates synchronization by following the performance of individual events in the score rather than","type":"text"},{"text":" ","type":"text"},{"text":"the performer tempo. The mostly-tempo and mostly-event types combine these two approaches, with mostly-tempo","type":"text"},{"text":" ","type":"text"},{"text":"giving more weight to tempo and mostly-event giving more weight to performed events. The always-event type","type":"text"},{"text":" ","type":"text"},{"text":"provides the strictest synchronization by not being forgiving of missing performed events.","type":"text"}],"type":"topic"},"doc://Ivo