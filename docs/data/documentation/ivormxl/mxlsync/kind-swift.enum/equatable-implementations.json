rTitle":[{"kind":"identifier","text":"Kind"}],"role":"symbol","title":"MXLSync.Kind","abstract":[{"type":"text","text":"The sync-type type specifies the style that a score following application should use to synchronize an"},{"type":"text","text":" "},{"type":"text","text":"accompaniment with a performer. The none type indicates no synchronization to the performer. The tempo type"},{"type":"text","text":" "},{"type":"text","text":"indicates synchronization based on the performer tempo rather than individual events in the score. The event"},{"type":"text","text":" "},{"type":"text","text":"type indicates synchronization by following the performance of individual events in the score rather than"},{"type":"text","text":" "},{"type":"text","text":"the performer tempo. The mostly-tempo and mostly-event types combine these two approaches, with mostly-tempo"},{"type":"text","text":" "},{"type":"text","text":"giving more weight to tempo and mostly-event giving more weight to performed events. The always-event type"},{"type":"text","text":" "},{"type":"text","text":"provides the strictest synchronization by not being forgiving of missing performed events."}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlsync\/kind-swift.enum","type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"kind":"text","text":" "},{"text":"Kind","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSync\/Kind-swift.enum"},"doc://IvorMXL/documentation/IvorMXL/MXLSync/Kind-swift.enum/!=(_:_:)":{"kind":"symbol","title":"!=(_:_:)","url":"\/documentation\/ivormxl\/mxlsync\/kind-swift.enum\/!=(_:_:)","abstract":[],"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"!=","kind":"identifier"},{"text":" ","kind":"text"},{"text":"(","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":") -> ","kind":"text"