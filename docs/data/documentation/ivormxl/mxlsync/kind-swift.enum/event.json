{"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlsync\/kind-swift.enum\/event"]}],"kind":"symbol","metadata":{"title":"MXLSync.Kind.event","role":"symbol","externalID":"s:7IvorMXL7MXLSyncV4KindO5eventyA2EmF","roleHeading":"Case","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"event","kind":"identifier"}],"modules":[{"name":"IvorMXL"}],"symbolKind":"case"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSync","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSync\/Kind-swift.enum"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"event","kind":"identifier"}],"languages":["swift"],"platforms":["macOS"]}]}],"abstract":[{"text":"Synchronization by following the performance of individual events in the score.","type":"text"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSync\/Kind-swift.enum\/event"},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLSync/Kind-swift.enum/event":{"url":"\/documentation\/ivormxl\/mxlsync\/kind-swift.enum\/event","type":"topic","abstract":[{"text":"Synchronization by following the performance of individual events in the score.","type":"text"}],"kind":"symbol","title":"MXLSync.Kind.event","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSync\/Kind-swift.enum\/event","role":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"event"}]},"doc://IvorMXL/documentation/IvorMXL/MXLSync":{"navigatorTitle":[{"text":"MXLSync","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSync","kind":"identifier"}],"abstract":[{"text":"The sync type specifies the style that a score following application should use to synchronize an","type":"text"},{"text":" ","type":"text"},{"text":"accompaniment with a performer. If this type is not included in a score, default synchronization depends on","type":"text"},{"text":" ","type":"text"},{"text":"the application.","type":"text"}],"role":"symbol","url":"\/documentation\/ivormxl\/mxlsync","type":"topic","title":"MXLSync","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSync","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLSync/Kind-swift.enum":{"abstract":[{"type":"text","text":"The sync-type type specifies the style that a score following application should use to synchronize an"},{"type":"text","text":" "},{"type":"text","text":"accompaniment with a performer. The none type indicates no synchronization to the performer. The tempo type"},{"type":"text","text":" "},{"type":"text","text":"indicates synchronization based on the performer tempo rather than individual events in the score. The event"},{"type":"text","text":" "},{"type":"text","text":"type indicates synchronization by following the performance of individual events in the score rather than"},{"type":"text","text":" "},{"type":"text","text":"the performer tempo. The mostly-tempo and mostly-event types combine these two approaches, with mostly-tempo"},{"type":"text","text":" "},{"type":"text","text":"giving more weight to tempo and mostly-event giving more weight to performed events. The always-event type"},{"type":"text","text":" "},{"type":"text","text":"provides the strictest synchronization by not being forgiving of missing performed events."}],"fragments":[{"kind":"keyword","text":"enum"},{"text":" ","kind":"text"},{"text":"Kind","kind":"identifier"}],"title":"MXLSync.Kind","navigatorTitle":[{"kind":"identifier","text":"Kind"}],"url":"\/documentation\/ivormxl\/mxlsync\/kind-swift.enum","kind":"symbol","type":"topic","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSync\/Kind-swift.enum"}}}