{"kind":"text","text":" "},{"kind":"identifier","text":"mostlyEvent"}]},"doc://IvorMXL/documentation/IvorMXL/MXLSync/Kind-swift.enum":{"abstract":[{"type":"text","text":"The sync-type type specifies the style that a score following application should use to synchronize an"},{"type":"text","text":" "},{"type":"text","text":"accompaniment with a performer. The none type indicates no synchronization to the performer. The tempo type"},{"type":"text","text":" "},{"type":"text","text":"indicates synchronization based on the performer tempo rather than individual events in the score. The event"},{"type":"text","text":" "},{"type":"text","text":"type indicates synchronization by following the performance of individual events in the score rather than"},{"type":"text","text":" "},{"type":"text","text":"the performer tempo. The mostly-tempo and mostly-event types combine these two approaches, with mostly-tempo"},{"type":"text","text":" "},{"type":"text","text":"giving more weight to tempo and mostly-event giving more weight to performed events. The always-event type"},{"type":"text","text":" "},{"type":"text","text":"provides the strictest synchronization by not being forgiving of missing performed events."}],"fragments":[{"kind":"keyword","text":"enum"},{"text":" ","kind":"text"},{"text":"Kind","kind":"identifier"}],"title":"MXLSync.Kind","navigatorTitle":[{"kind":"identifier","text":"Kind"}],"url":"\/documentation\/ivormxl\/mxlsync\/kind-swift.enum","kind":"symbol","type":"topic","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSync\/Kind-swift.enum"},"doc://IvorMXL/documentation/IvorMXL/MXLSync":{"navigatorTitle":[{"text":"MXLSync","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSync","kind":"identifier"}],"abstract":[{"text":"The sync type specifies the style that a score following application should use to synchronize an","type":"text"},{"text":" ","type":"text"},{"text":"accompaniment with a performer. If this type is not included in a score, default synchronization depends on","type":"text"},{"text":" ","type":"text"},{"text":"the application.","type":"text"}],"role":"symbol","url":"\/documentation\/ivormxl\/mxlsync","type":"topic","title":"MXLSync","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSync","kind":"symbol"}}}