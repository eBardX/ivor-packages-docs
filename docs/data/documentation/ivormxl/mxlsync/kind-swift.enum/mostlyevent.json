{"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSync","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSync\/Kind-swift.enum"]]},"metadata":{"modules":[{"name":"IvorMXL"}],"externalID":"s:7IvorMXL7MXLSyncV4KindO11mostlyEventyA2EmF","title":"MXLSync.Kind.mostlyEvent","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"mostlyEvent","kind":"identifier"}],"symbolKind":"case","role":"symbol","roleHeading":"Case"},"abstract":[{"text":"A combination of tempo and event synchronization, giving more weight to performed events.","type":"text"}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSync\/Kind-swift.enum\/mostlyEvent","interfaceLanguage":"swift"},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"mostlyEvent","kind":"identifier"}],"languages":["swift"],"platforms":["macOS"]}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlsync\/kind-swift.enum\/mostlyevent"]}],"references":{"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLSync/Kind-swift.enum/mostlyEvent":{"abstract":[{"text":"A combination of tempo and event synchronization, giving more weight to performed events.","type":"text"}],"title":"MXLSync.Kind.mostlyEvent","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSync\/Kind-swift.enum\/mostlyEvent","kind":"symbol","url":"\/documentation\/ivormxl\/mxlsync\/kind-swift.enum\/mostlyevent","type":"topic","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"mostlyEvent"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLSync":{"navigatorTitle":[{"kind":"identifier","text":"MXLSync"}],"abstract":[{"type":"text","text":"The sync type specifies the style that a score following application should use to synchronize an"},{"type":"text","text":" "},{"type":"text","text":"accompaniment with a performer. If this type is not included in a score, default synchronization depends on"},{"type":"text","text":" "},{"type":"text","text":"the application."}],"title":"MXLSync","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSync","kind":"symbol","url":"\/documentation\/ivormxl\/mxlsync","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLSync"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLSync/Kind-swift.enum":{"navigatorTitle":[{"kind":"identifier","text":"Kind"}],"abstract":[{"type":"text","text":"The sync-type type specifies the style that a score following application should use to synchronize an"},{"text":" ","type":"text"},{"type":"text","text":"accompaniment with a performer. The none type indicates no synchronization to the performer. The tempo type"},{"type":"text","text":" "},{"text":"indicates synchronization based on the performer tempo rather than individual events in the score. The event","type":"text"},{"text":" ","type":"text"},{"text":"type indicates synchronization by following the performance of individual events in the score rather than","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"the performer tempo. The mostly-tempo and mostly-event types combine these two approaches, with mostly-tempo"},{"type":"text","text":" "},{"type":"text","text":"giving more weight to tempo and mostly-event giving more weight to performed events. The always-event type"},{"type":"text","text":" "},{"type":"text","text":"provides the strictest synchronization by not being forgiving of missing performed events."}],"title":"MXLSync.Kind","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSync\/Kind-swift.enum","kind":"symbol","url":"\/documentation\/ivormxl\/mxlsync\/kind-swift.enum","type":"topic","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"text":"Kind","kind":"identifier"}],"role":"symbol"}}}