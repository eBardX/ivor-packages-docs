{"kind":"symbol","variants":[{"paths":["\/documentation\/ivormxl\/mxlsync\/kind-swift.enum\/mostlytempo"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSync\/Kind-swift.enum\/mostlyTempo","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"title":"MXLSync.Kind.mostlyTempo","symbolKind":"case","role":"symbol","roleHeading":"Case","externalID":"s:7IvorMXL7MXLSyncV4KindO11mostlyTempoyA2EmF","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"mostlyTempo"}],"modules":[{"name":"IvorMXL"}]},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSync","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSync\/Kind-swift.enum"]]},"abstract":[{"text":"A combination of tempo and event synchronization, giving more weight to tempo.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"mostlyTempo"}],"platforms":["macOS"]}]}],"sections":[],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLSync/Kind-swift.enum/mostlyTempo":{"url":"\/documentation\/ivormxl\/mxlsync\/kind-swift.enum\/mostlytempo","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSync\/Kind-swift.enum\/mostlyTempo","kind":"symbol","type":"topic","role":"symbol","abstract":[{"type":"text","text":"A combination of tempo and event synchronization, giving more weight to tempo."}],"title":"MXLSync.Kind.mostlyTempo","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"mostlyTempo","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLSync/Kind-swift.enum":{"title":"MXLSync.Kind","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Kind","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlsync\/kind-swift.enum","role":"symbol","navigatorTitle":[{"text":"Kind","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSync\/Kind-swift.enum","abstract":[{"text":"The sync-type type specifies the style that a score following application should use to synchronize an","type":"text"},{"text":" ","type":"text"},{"text":"accompaniment with a performer. The none type indicates no synchronization to the performer. The tempo type","type":"text"},{"text":" ","type":"text"},{"text":"indicates synchronization based on the performer tempo rather than individual events in the score. The event","type":"text"},{"text":" ","type":"text"},{"text":"type indicates synchronization by following the performance of individual events in the score rather than","type":"text"},{"text":" ","type":"text"},{"text":"the performer tempo. The mostly-tempo and mostly-event types combine these two approaches, with mostly-tempo","type":"text"},{"text":" ","type":"text"},{"text":"giving more weight to tempo and mostly-event giving more weight to performed events. The always-event type","type":"text"},{"text":" ","type":"text"},{"text":"provides the strictest synchronization by not being forgiving of missing performed events.","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLSync":{"title":"MXLSync","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSync","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlsync","role":"symbol","navigatorTitle":[{"text":"MXLSync","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSync","abstract":[{"text":"The sync type specifies the style that a score following application should use to synchronize an","type":"text"},{"text":" ","type":"text"},{"text":"accompaniment with a performer. If this type is not included in a score, default synchronization depends on","type":"text"},{"text":" ","type":"text"},{"text":"the application.","type":"text"}],"type":"topic"}}}