e strictest synchronization by not being forgiving of missing performed events."}],"title":"MXLSync.Kind","kind":"symbol","role":"symbol","type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Kind","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"Kind"}]}}}