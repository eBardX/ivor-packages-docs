{"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSync","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSync\/Kind-swift.enum"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"alwaysEvent","kind":"identifier"}],"languages":["swift"],"platforms":["macOS"]}]}],"abstract":[{"text":"The strictest synchronization, not forgiving of missing performed events.","type":"text"}],"sections":[],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSync\/Kind-swift.enum\/alwaysEvent","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlsync\/kind-swift.enum\/alwaysevent"]}],"kind":"symbol","metadata":{"role":"symbol","modules":[{"name":"IvorMXL"}],"symbolKind":"case","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"alwaysEvent","kind":"identifier"}],"externalID":"s:7IvorMXL7MXLSyncV4KindO11alwaysEventyA2EmF","title":"MXLSync.Kind.alwaysEvent","roleHeading":"Case"},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLSync":{"title":"MXLSync","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSync","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlsync","role":"symbol","navigatorTitle":[{"text":"MXLSync","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSync","abstract":[{"text":"The sync type specifies the style that a score following application should use to synchronize an","type":"text"},{"text":" ","type":"text"},{"text":"accompaniment with a performer. If this type is not included in a score, default synchronization depends on","type":"text"},{"text":" ","type":"text"},{"text":"the application.","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLSync/Kind-swift.enum":{"title":"MXLSync.Kind","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Kind","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlsync\/kind-swift.enum","role":"symbol","navigatorTitle":[{"text":"Kind","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSync\/Kind-swift.enum","abstract":[{"text":"The sync-type type specifies the style that a score following application should use to synchronize an","type":"text"},{"text":" ","type":"text"},{"text":"accompaniment with a performer. The none type indicates no synchronization to the performer. The tempo type","type":"text"},{"text":" ","type":"text"},{"text":"indicates synchronization based on the performer tempo rather than individual events in the score. The event","type":"text"},{"text":" ","type":"text"},{"text":"type indicates synchronization by following the performance of individual events in the score rather than","type":"text"},{"text":" ","type":"text"},{"text":"the performer tempo. The mostly-tempo and mostly-event types combine these two approaches, with mostly-tempo","type":"text"},{"text":" ","type":"text"},{"text":"giving more weight to tempo and mostly-event giving more weight to performed events. The always-event type","type":"text"},{"text":" ","type":"text"},{"text":"provides the strictest synchronization by not being forgiving of missing performed events.","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLSync/Kind-swift.enum/alwaysEvent":{"type":"topic","role":"symbol","abstract":[{"text":"The strictest synchronization, not forgiving of missing performed events.","type":"text"}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"alwaysEvent"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSync\/Kind-swift.enum\/alwaysEvent","kind":"symbol","title":"MXLSync.Kind.alwaysEvent","url":"\/documentation\/ivormxl\/mxlsync\/kind-swift.enum\/alwaysevent"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"}}}