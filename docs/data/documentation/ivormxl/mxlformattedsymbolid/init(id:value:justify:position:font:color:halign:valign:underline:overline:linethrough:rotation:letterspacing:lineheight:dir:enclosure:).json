n","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLLeftCenterRight","preciseIdentifier":"s:7IvorMXL18MXLLeftCenterRightO","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLeftCenterRight"},{"text":"? = nil, ","kind":"text"},{"text":"valign","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLValign","preciseIdentifier":"s:7IvorMXL9MXLValignO","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValign"},{"text":"? = nil, ","kind":"text"},{"text":"underline","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLNumberOfLines","preciseIdentifier":"s:7IvorMXL16MXLNumberOfLinesV","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumberOfLines"},{"text":"? = nil, ","kind":"text"},{"text":"overline","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLNumberOfLines","preciseIdentifier":"s:7IvorMXL16MXLNumberOfLinesV","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumberOfLines"},{"text":"? = nil, ","kind":"text"},{"text":"lineThrough","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLNumberOfLines","preciseIdentifier":"s:7IvorMXL16MXLNumberOfLinesV","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumberOfLines"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"rotation"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLRotationDegrees","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRotationDegrees","preciseIdentifier":"s:7IvorMXL18MXLRotationDegreesa"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"letterSpacing"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLNumberOrNormal","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumberOrNormal","preciseIdentifier":"s:7IvorMXL17MXLNumberOrNormalO"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"lineHeight"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLNumberOrNormal","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumberOrNormal","preciseIdentifier":"s:7IvorMXL17MXLNumberOrNormalO"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"dir"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLTextDirection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTextDirection","preciseIdentifier":"s:7IvorMXL16MXLTextDirectionO"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"enclosure"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLEnclosureShape","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnclosureShape","preciseIdentifier":"s:7IvorMXL17MXLEnclosureShapeO"},{"kind":"text","text":"? = nil)"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The optional-unique-id attribute group allows an element to optionally specify an ID","type":"text"},{"text":" ","type":"text"},{"text":"that is unique to the entire document. This attribute group is not used for a","type":"text"},{"text":" ","type":"text"},{"text":"required id attribute, or for an id attribute that specifies an id reference.","type":"text"}]}],"name":"id"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The value of this element.","type":"text"}]}],"name":"value"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The justify attribute is used to indicate left, center, or right justification. The","type":"text"},{"text":" ","type":"text"},{"text":"default value varies for different elements. For elements where the justify","type":"text"},{"text":" ","type":"text"},{"text":"attribute is present but the halign attribute is not, the justify attribute","type":"text"},{"text":" ","type":"text"},{"text":"indicates horizontal alignment as well as justification.","type":"text"}]}],"name":"justify"},{"content":[{"type":"paragraph","inlineContent":[{"text":"For most elements, any program will compute a default x and y position. The position","type":"text"},{"text":" ","type":"text"},{"text":"attributes let this be changed two ways.","type":"text"}]}],"name":"position"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The font attribute group gathers together attributes for determining the font within","type":"text"},{"text":" ","type":"text"},{"text":"a credit or direction. They are based on the text styles for Cascading Style Sheets.","type":"text"},{"text":" ","type":"text"},{"text":"The font-family is a comma-separated list of font names. The font-style can be","type":"text"},{"text":" ","type":"text"},{"text":"normal or italic. The font-size can be one of the CSS sizes or a numeric point size.","type":"text"},{"text":" ","type":"text"},{"text":"The font-weight can be normal or bold. The default is application-dependent, but is","type":"text"},{"text":" ","type":"text"},{"text":"a text font vs. a music font.","type":"text"}]}],"name":"font"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The color attribute group indicates the color of an element.","type":"text"}]}],"name":"color"},{"content":[{"type":"paragraph","inlineContent":[{"text":"In cases where text extends over more than one line, horizontal alignment and","type":"text"},{"text":" ","type":"text"},{"text":"justify values can be different.","type":"text"}]}],"name":"halign"},{"content":[{"inlineContent":[{"type":"text","text":"The valign attribute is used to indicate vertical alignment to the top, middle,"},{"type":"text","text":" "},{"type":"text","text":"bottom, or baseline of the text. Defaults are implementation-dependent."}],"type":"paragraph"}],"name":"valign"},{"content":[{"inlineContent":[{"type":"text","text":"The number of lines used to underline the text: "},{"type":"codeVoice","code":"0"},{"type":"text","text":" (none), "},{"type":"codeVoice","code":"1"},{"type":"text","text":", "},{"type":"codeVoice","code":"2"},{"type":"text","text":", or "},{"type":"codeVoice","code":"3"},{"type":"text","text":"."}],"type":"paragraph"}],"name":"underline"},{"content":[{"inlineContent":[{"text":"The number of lines used to overline the text: ","type":"text"},{"type":"codeVoice","code":"0"},{"type":"text","text":" (none), "},{"type":"codeVoice","code":"1"},{"type":"text","text":", "},{"type":"codeVoice","code":"2"},{"type":"text","text":", or "},{"type":"codeVoice","code":"3"},{"type":"text","text":"."}],"type":"paragraph"}],"name":"overline"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The number of lines used to strike through the text: ","type":"text"},{"type":"codeVoice","code":"0"},{"type":"text","text":" (none), "},{"type":"codeVoice","code":"1"},{"type":"text","text":", "},{"type":"codeVoice","code":"2"},{"type":"text","text":", or "},{"type":"codeVoice","code":"3"},{"type":"text","text":"."}]}],"name":"lineThrough"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The rotation attribute is used to rotate text around the alignment point specified"},{"type":"text","text":" "},{"type":"text","text":"by the halign and valign attributes. Positive values are clockwise rotations, while"},{"type":"text","text":" "},{"type":"text","text":"negative values are counter-clockwise rotations."}]}],"name":"rotation"},{"name":"letterSpacing","content":[{"inlineContent":[{"text":"The letter-spacing attribute specifies text tracking. Values are either “normal” or","type":"text"},{"text":" ","type":"text"},{"text":"a number representing the number of ems to add between each letter. The number may","type":"text"},{"text":" ","type":"text"},{"text":"be negative in order to subtract space. The default is normal, which allows","type":"text"},{"text":" ","type":"text"},{"text":"flexibility of letter-spacing for purposes of text justification.","type":"text"}],"type":"paragraph"}]},{"name":"lineHeight","content":[{"type":"paragraph","inlineContent":[{"text":"The line-height attribute specifies text leading. Values are either “normal” or a","type":"text"},{"text":" ","type":"text"},{"text":"number representing the percentage of the current font height to use for leading.","type":"text"},{"text":" ","type":"text"},{"text":"The default is “normal”. The exact normal value is implementation-dependent, but","type":"text"},{"text":" ","type":"text"},{"text":"values between 100 and 120 are recommended.","type":"text"}]}]},{"name":"dir","content":[{"type":"paragraph","inlineContent":[{"text":"The text-direction attribute is used to adjust and override the Unicode","type":"text"},{"text":" ","type":"text"},{"text":"bidirectional text algorithm, similar to the Directionality data category in the W3C","type":"text"},{"text":" ","type":"text"},{"text":"Internationalization Tag Set recommendation.","type":"text"}]}]},{"name":"enclosure","content":[{"inlineContent":[{"type":"text","text":"The enclosure attribute group is used to specify the formatting of an enclosure"},{"text":" ","type":"text"},{"type":"text","text":"around text or symbols."}],"type":"paragraph"}]}],"kind":"parameters"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlformattedsymbolid\/init(id:value:justify:position:font:color:halign:valign:underline:overline:linethrough:rotation:letterspacing:lineheight:dir:enclosure:)"]}],"abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLFormattedSymbolID"},{"type":"text","text":"."}],"metadata":{"symbolKind":"init","role":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"value","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":