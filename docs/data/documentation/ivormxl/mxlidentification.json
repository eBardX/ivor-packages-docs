"kind":"text"}],"abstract":[{"text":"The source for the music that is encoded. This is similar to the Dublin Core source element.","type":"text"}],"title":"source","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLIdentification\/source","type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLIdentification/rights":{"kind":"symbol","url":"\/documentation\/ivormxl\/mxlidentification\/rights","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLIdentification\/rights","role":"symbol","type":"topic","title":"rights","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"rights","kind":"identifier"},{"text":": [","kind":"text"},{"text":"MXLTypedText","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL12MXLTypedTextV"},{"text":"]","kind":"text"}],"abstract":[{"type":"text","text":"The rights element is borrowed from Dublin Core. It contains copyright and other intellectual property"},{"type":"text","text":" "},{"type":"text","text":"notices. Words, music, and derivatives can have different types, so multiple rights elements with different"},{"type":"text","text":" "},{"type":"text","text":"type attributes are supported. Standard type values are music, words, and arrangement, but other types may be"},{"type":"text","text":" "},{"type":"text","text":"used. The type attribute is only needed when there are multiple rights elements."}]},"doc://IvorMXL/documentation/IvorMXL/MXLIdentification/creator":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlidentification\/creator","kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"creator","kind":"identifier"},{"text":": [","kind":"text"},{"text":"MXLTypedText","preciseIdentifier":"s:7IvorMXL12MXLTypedTextV","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"abstract":[{"text":"The creator element is borrowed from Dublin Core. It is used for the creators of the score. The type attribute","type":"text"},{"text":" ","type":"text"},{"text":"is used to distinguish different creative contributions. Thus, there can be multiple creators within an","type":"text"},{"text":" ","type":"text"},{"text":"identification. Standard type values are composer, lyricist, and arranger. Other type values may be used for","type":"text"},{"text":" ","type":"text"},{"text":"different types of creative roles. The type attribute should usually be used even if there is just a single","type":"text"},{"text":" ","type":"text"},{"text":"creator element. The MusicXML format does not use the creator \/ contributor distinction from Dublin Core.","type":"text"}],"title":"creator","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLIdentification\/creator","type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLIdentification":{"kind":"symbol","title":"MXLIdentification","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLIdentification"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlidentification","navigatorTitle":[{"text":"MXLIdentification","kind":"identifier"}],"abstract":[{"text":"Identification contains basic metadata about the score. It includes information that may apply at a score-","type":"text"},{"text":" ","type":"text"},{"text":"wide, movement-wide, or part-wide level. The creator, rights, source, and relation elements are based on","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Dublin Core."}],"role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLIdentification"},"doc://IvorMXL/s8SendableP":{"title":"Swift.Sendable","type":"unresolvable","identifier":"doc:\/\/IvorMXL\/s8SendableP"},"doc://IvorMXL/documentation/IvorMXL/MXLIdentification/Equatable-Implementations":{"role":"collectionGroup","url":"\/documentation\/ivormxl\/mxlidentification\/equatable-implementations","kind":"article","abstract":[],"title":"Equatable Implementations","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLIdentification\/Equatable-Implem