/documentation\/ivormxl\/mxlidentification\/miscellaneous","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLIdentification\/miscellaneous","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"miscellaneous"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLMiscellaneous","preciseIdentifier":"s:7IvorMXL16MXLMiscellaneousV"},{"kind":"text","text":"?"}],"abstract":[{"type":"text","text":"Other metadata not yet supported elsewhere in the MusicXML format."}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLIdentification/source":{"type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"source","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"title":"source","url":"\/documentation\/ivormxl\/mxlidentification\/source","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLIdentification\/source","role":"symbol","abstract":[{"text":"The source for the music that is encoded. This is similar to the Dublin Core source element.","type":"text"}]},"doc://IvorMXL/s16SendableMetatypeP":{"type":"unresolvable","title":"Swift.SendableMetatype","identifier":"doc:\/\/IvorMXL\/s16SendableMetatypeP"},"doc://IvorMXL/s8CopyableP":{"type":"unresolvable","title":"Swift.Copyable","identifier":"doc:\/\/IvorMXL\/s8CopyableP"},"doc://IvorMXL/documentation/IvorMXL/MXLIdentification/rights":{"title":"rights","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"rights","kind":"identifier"},{"text":": [","kind":"text"},{"text":"MXLTypedText","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL12MXLTypedTextV"},{"text":"]","kind":"text"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlidentification\/rights","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLIdentification\/rights","abstract":[{"text":"The rights element is borrowed from Dublin Core. It contains copyright and other intellectual property","type":"text"},{"text":" ","type":"text"},{"text":"notices. Words, music, and derivatives can have different types, so multiple rights elements with different","type":"text"},{"text":" ","type":"text"},{"text":"type attributes are supported. Standard type values are music, words, and arrangement, but other types may be","type":"text"},{"text":" ","type":"text"},{"text":"used. The type attribute is only needed when there are multiple rights elements.","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLIdentification/creator":{"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"creator"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:7IvorMXL12MXLTypedTextV","kind":"typeIdentifier","text":"MXLTypedText"},{"kind":"text","text":"]"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLIdentification\/creator","type":"topic","abstract":[{"text":"The creator element is borrowed from Dublin Core. It is used for the creators of the score. The type attribute","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"is used to distinguish different creative contributions. Thus, there can be multiple creators within an"},{"text":" ","type":"text"},{"type":"text","text":"identification. Standard type values are composer, lyricist, and arranger. Other type values may be used for"},{"type":"text","text":" "},{"type":"text","text":"different types of creative roles. The type attribute should usually be used even if there is just a single"},{"type":"text","text":" "},{"type":"text","text":"creator element. The MusicXML format does not use the creator \/ contributor distinction from Dublin Core."}],"title":"creator","url":"\/documentation\/ivormxl\/mxlidentification\/creator"},"doc://IvorMXL/s8SendableP":{"type":"unresolvable","title":"Swift.Sendable","identifier":"doc:\