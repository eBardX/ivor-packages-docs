ntent":[{"type":"text","text":"One of the alternatives for Lyric."}]}],"name":"content"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A Boolean value indicating whether this lyric ends a line, per RP-017 for Standard"},{"type":"text","text":" "},{"type":"text","text":"MIDI File Lyric meta-events. Used to facilitate lyric display for Karaoke and"},{"type":"text","text":" "},{"type":"text","text":"similar applications."}]}],"name":"endsLine"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A Boolean value indicating whether this lyric ends a paragraph, per RP-017 for"},{"type":"text","text":" "},{"type":"text","text":"Standard MIDI File Lyric meta-events. Used to facilitate lyric display for Karaoke"},{"type":"text","text":" "},{"type":"text","text":"and similar applications."}]}],"name":"endsParagraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The footnote element specifies editorial information that appears in footnotes in"},{"type":"text","text":" "},{"type":"text","text":"the printed score. It is defined within a group due to its multiple uses within the"},{"type":"text","text":" "},{"type":"text","text":"MusicXML schema."}]}],"name":"footnote"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The level element specifies editorial information for different MusicXML elements."},{"type":"text","text":" "},{"type":"text","text":"It is defined within a group due to its multiple uses within the MusicXML schema."}]}],"name":"level"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Identifies this lyric among multiple lines, such as when the same lyric applies to","type":"text"},{"text":" ","type":"text"},{"text":"both a stem-up and a stem-down voice.","type":"text"}]}],"name":"number"},{"content":[{"type":"paragraph","inlineContent":[{"text":"An alternative to ","type":"text"},{"type":"codeVoice","code":"number"},{"text":" for identifying this lyric among multiple lines. Common","type":"text"},{"text":" ","type":"text"},{"text":"values are verse and chorus.","type":"text"}]}],"name":"name"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The justify attribute is used to indicate left, center, or right justification. The","type":"text"},{"text":" ","type":"text"},{"text":"default value varies for different elements. For elements where the justify","type":"text"},{"text":" ","type":"text"},{"text":"attribute is present but the halign attribute is not, the justify attribute","type":"text"},{"text":" ","type":"text"},{"text":"indicates horizontal alignment as well as justification.","type":"text"}]}],"name":"justify"},{"content":[{"type":"paragraph","inlineContent":[{"text":"For most elements, any program will compute a default x and y position. The position","type":"text"},{"text":" ","type":"text"},{"text":"attributes let this be changed two ways.","type":"text"}]}],"name":"position"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The placement attribute indicates whether something is above or below another","type":"text"},{"text":" ","type":"text"},{"text":"element, such as a note or a notation.","type":"text"}]}],"name":"placement"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The color attribute group indicates the color of an element."}]}],"name":"color"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A Boolean value indicating whether to print an object (e.g. a note or a rest)."},{"type":"text","text":" "},{"type":"text","text":"Defaults to "},{"code":"true","type":"codeVoice"},{"type":"text","text":" if not specified."}]}],"name":"printsObject"},{"content":[{"inlineContent":[{"text":"Restricts the element to apply to a specific set of times through a repeated","type":"text"},{"text":" ","type":"text"},{"text":"section.","type":"text"}],"type":"paragraph"}],"name":"timeOnly"}],"kind":"parameters"}],"kind":"symbol","sections":[],"identifier":{"i