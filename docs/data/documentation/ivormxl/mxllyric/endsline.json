{"kind":"symbol","schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"abstract":[{"type":"text","text":"A Boolean value indicating whether this lyric ends a line, per RP-017 for Standard MIDI File Lyric"},{"type":"text","text":" "},{"type":"text","text":"meta-events. Used to facilitate lyric display for Karaoke and similar applications."}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric"]]},"metadata":{"roleHeading":"Instance Property","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"endsLine","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"externalID":"s:7IvorMXL8MXLLyricV8endsLineSbvp","symbolKind":"property","role":"symbol","title":"endsLine","modules":[{"name":"IvorMXL"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxllyric\/endsline"]}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric\/endsLine","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"endsLine","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"inlineContent":[{"text":"Maps to a nested MusicXML ","type":"text"},{"code":"<end-line>","type":"codeVoice"},{"text":" element.","type":"text"}],"type":"paragraph"}]}],"references":{"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLLyric/endsLine":{"role":"symbol","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"A Boolean value indicating whether this lyric ends a line, per RP-017 for Standard MIDI File Lyric"},{"type":"text","text":" "},{"type":"text","text":"meta-events. Used to facilitate lyric display for Karaoke and similar applications."}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"endsLine","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric\/endsLine","title":"endsLine","url":"\/documentation\/ivormxl\/mxllyric\/endsline"},"doc://IvorMXL/documentation/IvorMXL/MXLLyric":{"type":"topic","abstract":[{"type":"text","text":"The lyric type represents text underlays for lyrics. Two text elements that are not separated by an elision"},{"type":"text","text":" "},{"type":"text","text":"element are part of the same syllable, but may have different text formatting. The MusicXML XSD is more strict"},{"type":"text","text":" "},{"type":"text","text":"than the DTD in enforcing this by disallowing a second syllabic element unless preceded by an elision element."},{"type":"text","text":" "},{"type":"text","text":"The lyric number indicates multiple lines, though a name can be used as well. Common name examples are verse"},{"type":"text","text":" "},{"text":"and chorus.","type":"text"}],"url":"\/documentation\/ivormxl\/mxllyric","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLLyric"}],"kind":"symbol","title":"MXLLyric","navigatorTitle":[{"text":"MXLLyric","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric","role":"symbol"}}}