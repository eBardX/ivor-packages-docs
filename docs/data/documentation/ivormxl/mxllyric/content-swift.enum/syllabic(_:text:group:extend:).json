idator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLLyric":{"navigatorTitle":[{"kind":"identifier","text":"MXLLyric"}],"abstract":[{"text":"The lyric type represents text underlays for lyrics. Two text elements that are not separated by an elision","type":"text"},{"text":" ","type":"text"},{"text":"element are part of the same syllable, but may have different text formatting. The MusicXML XSD is more strict","type":"text"},{"text":" ","type":"text"},{"text":"than the DTD in enforcing this by disallowing a second syllabic element unless preceded by an elision element.","type":"text"},{"text":" ","type":"text"},{"text":"The lyric number indicates multiple lines, though a name can be used as well. Common name examples are verse","type":"text"},{"text":" ","type":"text"},{"text":"and chorus.","type":"text"}],"title":"MXLLyric","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric","kind":"symbol","url":"\/documentation\/ivormxl\/mxllyric","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLLyric"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLExtend":{"abstract":[{"type":"text","text":"The extend type represents lyric word extension \/ melisma lines as well as figured bass extensions. The"},{"type":"text","text":" "},{"type":"text","text":"optional type and position attributes are added in Version 3.0 to provide better formatting control."}],"title":"MXLExtend","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLExtend","kind":"identifier"}],"navigatorTitle":[{"text":"MXLExtend","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlextend","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLExtend"},"doc://IvorMXL/documentation/IvorMXL/MXLTextElementData":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTextElementData","title":"MXLTextElementData","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTextElementData"}],"navigatorTitle":[{"text":"MXLTextElementData","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxltextelementdata","abstract":[{"type":"text","text":"The text-element-data type represents a syllable or portion of a syllable for lyric text underlay. A hyphen in"},{"text":" ","type":"text"},{"text":"the string content should only be used for an actual hyphenated word. Language names for text elements come","type":"text"},{"text":" ","type":"text"},{"text":"from ISO 639, with optional country subcodes from ISO 3166.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLLyric/Content-swift.enum/SyllabicGroup":{"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"SyllabicGroup"}],"title":"MXLLyric.Content.SyllabicGroup","url":"\/documentation\/ivormxl\/mxllyric\/content-swift.enum\/syllabicgroup","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SyllabicGroup"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric\/Content-swift.enum\/SyllabicGroup","abstract":[{"text":"An elided continuation of a lyric syllable, consisting of an optional elision-and-syllabic marker paired","type":"text"},{"text":" ","type":"text"},{"text":"with additional text.","type":"text"}]}}}