:{"url":"\/documentation\/ivormxl\/mxlextend","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLExtend","abstract":[{"type":"text","text":"The extend type represents lyric word extension \/ melisma lines as well as figured bass extensions. The"},{"type":"text","text":" "},{"type":"text","text":"optional type and position attributes are added in Version 3.0 to provide better formatting control."}],"title":"MXLExtend","kind":"symbol","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLExtend"}],"navigatorTitle":[{"kind":"identifier","text":"MXLExtend"}]},"doc://IvorMXL/documentation/IvorMXL/MXLTextElementData":{"title":"MXLTextElementData","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTextElementData"}],"abstract":[{"text":"The text-element-data type represents a syllable or portion of a syllable for lyric text underlay. A hyphen in","type":"text"},{"text":" ","type":"text"},{"text":"the string content should only be used for an actual hyphenated word. Language names for text elements come","type":"text"},{"text":" ","type":"text"},{"text":"from ISO 639, with optional country subcodes from ISO 3166.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTextElementData","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLTextElementData"}],"url":"\/documentation\/ivormxl\/mxltextelementdata"},"doc://IvorMXL/documentation/IvorMXL/MXLLyric/Content-swift.enum/SyllabicGroup":{"kind":"symbol","abstract":[{"type":"text","text":"An elided continuation of a lyric syllable, consisting of an optional elision-and-syllabic marker paired"},{"type":"text","text":" "},{"type":"text","text":"with additional text."}],"url":"\/documentation\/ivormxl\/mxllyric\/content-swift.enum\/syllabicgroup","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric\/Content-swift.enum\/SyllabicGroup","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SyllabicGroup","kind":"identifier"}],"title":"MXLLyric.Content.SyllabicGroup","navigatorTitle":[{"kind":"identifier","text":"SyllabicGroup"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLLyric/Content-swift.enum":{"role":"symbol","url":"\/documentation\/ivormxl\/mxllyric\/content-swift.enum","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric\/Content-swift.enum","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Content","kind":"identifier"}],"abstract":[{"type":"text","text":"One of the alternatives for Lyric."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Content"}],"title":"MXLLyric.Content"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLLyric":{"role":"symbol","url":"\/documentation\/ivormxl\/mxllyric","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLLyric"}],"kind":"symbol","abstract":[{"type":"text","text":"The lyric type represents text underlays for lyrics. Two text elements that are not separated by an elision"},{"type":"text","text":" "},{"type":"text","text":"element are part of the same syllable, but may have different text formatting. The MusicXML XSD is more strict"},{"type":"text","text":" "},{"type":"text","text":"than the DTD in enforcing this by disallowing a second syllabic element unless preceded by an elision element."},{"type":"text","text":" "},{"type":"text","text":"The lyric number indicates multiple lines, though a name can be used as well. Common name examples are verse"},{"type":"text","text":" "},{"type":"text","text":"and chorus."}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLLyric"}],"title":"MXLLyric"},"doc://IvorMXL/documentation/IvorMXL/MXLLyric/Content-swift.enum/syllabic(_:text:group:extend:)":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric\/Content-swift.enum\/syllabic(_:text:group:extend:)","role":"symbol","kind":"symbol","url":"\/documentation\/ivormxl\/mxllyric\/content-swift.enum\/syllabic(_:text:group:extend:)","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"syllabic","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:7IvorMXL11MXLSyllabicO","text":"MXLSyllabic","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"text","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL18MXLTextElementDataV","text":"MXLTextElementData","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"group","kind":"externalParam"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:7IvorMXL8MXLLyricV7ContentO13SyllabicGroupV","text":"SyllabicGroup","kind":"typeIdentifier"},{"text":"], ","kind":"text"},{"text":"extend","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL9MXLExtendV","text":"MXLExtend","kind":"typeIdentifier"},{"text":"?)","kind":"text"}],"type":"topic","title":"MXLLyric.Content.syllabic(_:text:group:extend:)","abstract":[{"text":"The ","type":"text"},{"code":"syllabic","type":"codeVoice"},{"text":" alternative.","type":"text"}]}}}