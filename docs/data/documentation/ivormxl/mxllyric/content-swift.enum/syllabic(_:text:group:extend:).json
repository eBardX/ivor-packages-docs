ntifier","text":"MXLTextElementData"}],"url":"\/documentation\/ivormxl\/mxltextelementdata","type":"topic","kind":"symbol","title":"MXLTextElementData","abstract":[{"text":"The text-element-data type represents a syllable or portion of a syllable for lyric text underlay. A hyphen in","type":"text"},{"text":" ","type":"text"},{"text":"the string content should only be used for an actual hyphenated word. Language names for text elements come","type":"text"},{"text":" ","type":"text"},{"text":"from ISO 639, with optional country subcodes from ISO 3166.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLLyric/Content-swift.enum":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric\/Content-swift.enum","title":"MXLLyric.Content","type":"topic","kind":"symbol","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Content","kind":"identifier"}],"abstract":[{"type":"text","text":"One of the alternatives for Lyric."}],"url":"\/documentation\/ivormxl\/mxllyric\/content-swift.enum","navigatorTitle":[{"text":"Content","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLLyric/Content-swift.enum/syllabic(_:text:group:extend:)":{"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric\/Content-swift.enum\/syllabic(_:text:group:extend:)","kind":"symbol","title":"MXLLyric.Content.syllabic(_:text:group:extend:)","fragments":[{"kind":"keyword","text":"case"},{"text":" ","kind":"text"},{"kind":"identifier","text":"syllabic"},{"text":"(","kind":"text"},{"kind":"typeIdentifier","text":"MXLSyllabic","preciseIdentifier":"s:7IvorMXL11MXLSyllabicO"},{"text":"?, ","kind":"text"},{"text":"text","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLTextElementData","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL18MXLTextElementDataV"},{"kind":"text","text":", "},{"text":"group","kind":"externalParam"},{"kind":"text","text":": ["},{"text":"SyllabicGroup","kind":"typeIdentifier","prec