rTitle":[{"kind":"identifier","text":"MXLLyric"}],"abstract":[{"text":"The lyric type represents text underlays for lyrics. Two text elements that are not separated by an elision","type":"text"},{"text":" ","type":"text"},{"text":"element are part of the same syllable, but may have different text formatting. The MusicXML XSD is more strict","type":"text"},{"text":" ","type":"text"},{"text":"than the DTD in enforcing this by disallowing a second syllabic element unless preceded by an elision element.","type":"text"},{"text":" ","type":"text"},{"text":"The lyric number indicates multiple lines, though a name can be used as well. Common name examples are verse","type":"text"},{"text":" ","type":"text"},{"text":"and chorus.","type":"text"}],"title":"MXLLyric","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric","kind":"symbol","url":"\/documentation\/ivormxl\/mxllyric","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLLyric"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLLyric/Content-swift.enum":{"navigatorTitle":[{"kind":"identifier","text":"Content"}],"abstract":[{"type":"text","text":"One of the alternatives for Lyric."}],"title":"MXLLyric.Content","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric\/Content-swift.enum","kind":"symbol","url":"\/documentation\/ivormxl\/mxllyric\/content-swift.enum","type":"topic","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Content"}],"role":"symbol"}}}