":"text"},{"type":"text","text":"and chorus."}]},"doc://IvorMXL/documentation/IvorMXL/MXLSyllabic":{"url":"\/documentation\/ivormxl\/mxlsyllabic","abstract":[{"type":"text","text":"Lyric hyphenation is indicated by the syllabic type. The single, begin, end, and middle values represent"},{"type":"text","text":" "},{"type":"text","text":"single-syllable words, word-beginning syllables, word-ending syllables, and mid-word syllables, respectively."}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSyllabic","kind":"identifier"}],"navigatorTitle":[{"text":"MXLSyllabic","kind":"identifier"}],"type":"topic","title":"MXLSyllabic","role":"symbol","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSyllabic"}}}