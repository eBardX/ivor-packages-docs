ext","text":" "},{"type":"text","text":"present, the elision glyph is application-specific."}],"title":"MXLElision","navigatorTitle":[{"text":"MXLElision","kind":"identifier"}],"type":"topic","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLElision","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlelision"},"doc://IvorMXL/documentation/IvorMXL/MXLLyric/Content-swift.enum":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric\/Content-swift.enum","title":"MXLLyric.Content","type":"topic","kind":"symbol","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Content","kind":"identifier"}],"abstract":[{"type":"text","text":"One of the alternatives for Lyric."}],"url":"\/documentation\/ivormxl\/mxllyric\/content-swift.enum","navigatorTitle":[{"text":"Content","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLLyric/Content-swift.enum/SyllabicGroup/Group-swift.struct":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric\/Content-swift.enum\/SyllabicGroup\/Group-swift.struct","abstract":[{"text":"The elision and optional syllabic hyphenation type that precede a further syllable of elided lyric text.","type":"text"}],"title":"MXLLyric.Content.SyllabicGroup.Group","navigatorTitle":[{"text":"Group","kind":"identifier"}],"type":"topic","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Group","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxllyric\/content-swift.enum\/syllabicgroup\/group-swift.struct"},"doc://IvorMXL/documentation/IvorMXL/MXLLyric/Content-swift.enum/SyllabicGroup/Group-swift.struct/init(elision:syllabic:)":{"url":"\/documentation\/ivormxl\/mxllyric\/content-swift.enum\/syllabicgroup\/group-swift.struct\/init(elision:syllabic:)","title":"init(elision:syllabic:)","type":"topic","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric\/Content-swift.enum\/SyllabicGroup\/Group-swift.struct\/init(elision:syllabic:)","role":"symbol","abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLLyric.Content.SyllabicGroup.Group"},{"type":"text","text":"."}],"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"elision"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL10MXLElisionV","text":"MXLElision"},{"kind":"text","text":", "},{"kind":"externalParam","text":"syllabic"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLSyllabicO","text":"MXLSyllabic"},{"kind":"text","text":"?)"}]},"doc://IvorMXL/documentation/IvorMXL/MXLLyric/Content-swift.enum/SyllabicGroup":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric\/Content-swift.enum\/SyllabicGroup","abstract":[{"text":"An elided continuation of a lyric syllable, consisting of an optional elision-and-syllabic marker paired","type":"text"},{"text":" ","type":"text"},{"text":"with additional text.","type":"text"}],"title":"MXLLyric.Content.SyllabicGroup","navigatorTitle":[{"text":"SyllabicGroup","kind":"identifier"}],"type":"topic","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SyllabicGroup","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxllyric\/content-swift.enum\/syllabicgroup"},"doc://IvorMXL/documentation/IvorMXL/MXLLyric":{"type":"topic","title":"MXLLyric","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLLyric"}],"url":"\/documentation\/ivormxl\/mxllyric","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric","role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLLyric"}],"abstract":[{"type":"text","text":"The lyric type represents text underlays for lyrics. Two text elements that are not separated by an elision"},{"type":"text","text":" "},{"type":"text","text":"element are part of the same syllable, but may have different text formatting. The MusicXML XSD is more strict"},{"type":"text","text":" "},{"type":"text","text":"than the DTD in enforcing this by disallowing a second syllabic element unless preceded by an elision element."},{"type":"text","text":" "},{"type":"text","text":"The lyric number indicates multiple lines, though a name can be used as well. Common name examples are verse"},{"type":"text","text":" "},{"type":"text","text":"and chorus."}]},"doc://IvorMXL/documentation/IvorMXL/MXLSyllabic":{"url":"\/documentation\/ivormxl\/mxlsyllabic","navigatorTitle":[{"kind":"identifier","text":"MXLSyllabic"}],"title":"MXLSyllabic","type":"topic","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSyllabic","role":"symbol","abstract":[{"type":"text","text":"Lyric hyphenation is indicated by the syllabic type. The single, begin, end, and middle values represent"},{"type":"text","text":" "},{"type":"text","text":"single-syllable words, word-beginning syllables, word-ending syllables, and mid-word syllables, respectively."}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLSyllabic"}]}}}