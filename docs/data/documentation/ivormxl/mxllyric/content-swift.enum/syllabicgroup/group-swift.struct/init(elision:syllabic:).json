this syllable to the following text.","type":"text"}],"type":"paragraph"}],"name":"elision"},{"content":[{"inlineContent":[{"text":"The syllable hyphenation type for the text that follows the elision, if any.","type":"text"}],"type":"paragraph"}],"name":"syllabic"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxllyric\/content-swift.enum\/syllabicgroup\/group-swift.struct\/init(elision:syllabic:)"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric\/Content-swift.enum\/SyllabicGroup\/Group-swift.struct\/init(elision:syllabic:)"},"abstract":[{"text":"Creates a new ","type":"text"},{"code":"MXLLyric.Content.SyllabicGroup.Group","type":"codeVoice"},{"text":".","type":"text"}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLSyllabic":{"type":"topic","abstract":[{"type":"text","text":"Lyric hyphenation is indicated by the syllabic type. The single, begin, end, and middle values represent"},{"type":"text","text":" "},{"type":"text","text":"single-syllable words, word-beginning syllables, word-ending syllables, and mid-word syllables, respectively."}],"url":"\/documentation\/ivormxl\/mxlsyllabic","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLSyllabic"}],"kind":"symbol","title":"MXLSyllabic","navigatorTitle":[{"kind":"identifier","text":"MXLSyllabic"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSyllabic","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLLyric/Content-swift.enum/SyllabicGroup/Group-swift.struct":{"type":"topic","title":"MXLLyric.Content.SyllabicGroup.Group","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric\/Content-swift.enum\/SyllabicGroup\/Group-swift.struct","abstract":[{"text":"The elision and optional syllabic hyphenation type that precede a further syllable of elided lyric text.","type":"text"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Group","kind":"identifier"}],"navigatorTitle":[{"text":"Group","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxllyric\/content-swift.enum\/syllabicgroup\/group-swift.struct"},"doc://IvorMXL/documentation/IvorMXL/MXLLyric/Content-swift.enum/SyllabicGroup/Group-swift.struct/init(elision:syllabic:)":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric\/Content-swift.enum\/SyllabicGroup\/Group-swift.struct\/init(elision:syllabic:)","url":"\/documentation\/ivormxl\/mxllyric\/content-swift.enum\/syllabicgroup\/group-swift.struct\/init(elision:syllabic:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"elision"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLElision","preciseIdentifier":"s:7IvorMXL10MXLElisionV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"syllabic"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLSyllabic","preciseIdentifier":"s:7IvorMXL11MXLSyllabicO"},{"kind":"text","text":"?)"}],"title":"init(elision:syllabic:)","abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLLyric.Content.SyllabicGroup.Group"},{"type":"text","text":"."}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLLyric":{"type":"topic","abstract":[{"type":"text","text":"The lyric type represents text underlays for lyrics. Two text elements that are not separated by an elision"},{"type":"text","text":" "},{"type":"text","text":"element are part of the same syllable, but may have different text formatting. The MusicXML XSD is more strict"},{"type":"text","text":" "},{"type":"text","text":"than the DTD in enforcing this by disallowing a second syllabic element unless preceded by an elision element."},{"type":"text","text":" "},{"type":"text","text":"The lyric number indicates multiple lines, though a name can be used as well. Common name examples are verse"},{"type":"text","text":" "},{"text":"and chorus.","type":"text"}],"url":"\/documentation\/ivormxl\/mxllyric","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLLyric"}],"kind":"symbol","title":"MXLLyric","navigatorTitle":[{"text":"MXLLyric","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLLyric/Content-swift.enum/SyllabicGroup":{"type":"topic","title":"MXLLyric.Content.SyllabicGroup","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric\/Content-swift.enum\/SyllabicGroup","abstract":[{"text":"An elided continuation of a lyric syllable, consisting of an optional elision-and-syllabic marker paired","type":"text"},{"text":" ","type":"text"},{"text":"with additional text.","type":"text"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SyllabicGroup","kind":"identifier"}],"navigatorTitle":[{"text":"SyllabicGroup","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxllyric\/content-swift.enum\/syllabicgroup"},"doc://IvorMXL/documentation/IvorMXL/MXLElision":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLElision","navigatorTitle":[{"kind":"identifier","text":"MXLElision"}],"url":"\/documentation\/ivormxl\/mxlelision","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLElision"}],"title":"MXLElision","abstract":[{"type":"text","text":"The elision type represents an elision between lyric syllables. The text content specifies the symbol used to"},{"type":"text","text":" "},{"type":"text","text":"display the elision. Common values are a no-break space (Unicode 00A0), an underscore (Unicode 005F), or an"},{"type":"text","text":" "},{"type":"text","text":"undertie (Unicode 203F). If the text content is empty, the smufl attribute is used to specify the symbol to"},{"type":"text","text":" "},{"type":"text","text":"use. Its value is a SMuFL canonical glyph name that starts with lyrics. The SMuFL attribute is ignored if the"},{"type":"text","text":" "},{"type":"text","text":"elision glyph is already specified by the text content. If neither text content nor a smufl attribute are"},{"type":"text","text":" "},{"type":"text","text":"present, the elision glyph is application-specific."}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLLyric/Content-swift.enum":{"type":"topic","title":"MXLLyric.Content","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric\/Content-swift.enum","abstract":[{"text":"One of the alternatives for Lyric.","type":"text"}],"role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Content","kind":"identifier"}],"navigatorTitle":[{"text":"Content","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxllyric\/content-swift.enum"}}}