abstract":[{"type":"text","text":"The elision symbol connecting this syllable to the following text."}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"elision","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLElision","preciseIdentifier":"s:7IvorMXL10MXLElisionV","kind":"typeIdentifier"}],"kind":"symbol","role":"symbol","title":"elision","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric\/Content-swift.enum\/SyllabicGroup\/Group-swift.struct\/elision"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLLyric/Content-swift.enum/SyllabicGroup":{"kind":"symbol","abstract":[{"type":"text","text":"An elided continuation of a lyric syllable, consisting of an optional elision-and-syllabic marker paired"},{"type":"text","text":" "},{"type":"text","text":"with additional text."}],"url":"\/documentation\/ivormxl\/mxllyric\/content-swift.enum\/syllabicgroup","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric\/Content-swift.enum\/SyllabicGroup","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SyllabicGroup","kind":"identifier"}],"title":"MXLLyric.Content.SyllabicGroup","navigatorTitle":[{"kind":"identifier","text":"SyllabicGroup"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLLyric/Content-swift.enum":{"role":"symbol","url":"\/documentation\/ivormxl\/mxllyric\/content-swift.enum","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric\/Content-swift.enum","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Content","kind":"identifier"}],"abstract":[{"type":"text","text":"One of the alternatives for Lyric."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Content"}],"title":"MXLLyric.Content"},"doc://IvorMXL/documentation/IvorMXL/MXLLyric/Content-swift.enum/SyllabicGroup/Group-swift.struct":{"url":"\/documentation\/ivormxl\/mxllyric\/content-swift.enum\/syllabicgroup\/group-swift.struct","abstract":[{"type":"text","text":"The elision and optional syllabic hyphenation type that precede a further syllable of elided lyric text."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Group","kind":"identifier"}],"kind":"symbol","role":"symbol","title":"MXLLyric.Content.SyllabicGroup.Group","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric\/Content-swift.enum\/SyllabicGroup\/Group-swift.struct","navigatorTitle":[{"text":"Group","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLLyric":{"role":"symbol","url":"\/documentation\/ivormxl\/mxllyric","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLLyric"}],"kind":"symbol","abstract":[{"type":"text","text":"The lyric type represents text underlays for lyrics. Two text elements that are not separated by an elision"},{"type":"text","text":" "},{"type":"text","text":"element are part of the same syllable, but may have different text formatting. The MusicXML XSD is more strict"},{"type":"text","text":" "},{"type":"text","text":"than the DTD in enforcing this by disallowing a second syllabic element unless preceded by an elision element."},{"type":"text","text":" "},{"type":"text","text":"The lyric number indicates multiple lines, though a name can be used as well. Common name examples are verse"},{"type":"text","text":" "},{"type":"text","text":"and chorus."}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLLyric"}],"title":"MXLLyric"},"doc://IvorMXL/documentation/IvorMXL/MXLElision":{"role":"symbol","navigatorTitle":[{"text":"MXLElision","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLElision","kind":"identifier"}],"kind":"symbol","title":"MXLElision","url":"\/documentation\/ivormxl\/mxlelision","type":"topic","abstract":[{"text":"The elision type represents an elision between lyric syllables. The text content specifies the symbol used to","type":"text"},{"text":" ","type":"text"},{"text":"display the elision. Common values are a no-break space (Unicode 00A0), an underscore (Unicode 005F), or an","type":"text"},{"text":" ","type":"text"},{"text":"undertie (Unicode 203F). If the text content is empty, the smufl attribute is used to specify the symbol to","type":"text"},{"text":" ","type":"text"},{"text":"use. Its value is a SMuFL canonical glyph name that starts with lyrics. The SMuFL attribute is ignored if the","type":"text"},{"text":" ","type":"text"},{"text":"elision glyph is already specified by the text content. If neither text content nor a smufl attribute are","type":"text"},{"text":" ","type":"text"},{"text":"present, the elision glyph is application-specific.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLElision"}}}