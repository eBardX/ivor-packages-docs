{"sections":[],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric\/Content-swift.enum","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric\/Content-swift.enum\/SyllabicGroup","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric\/Content-swift.enum\/SyllabicGroup\/Group-swift.struct"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxllyric\/content-swift.enum\/syllabicgroup\/group-swift.struct\/elision"]}],"metadata":{"title":"elision","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"elision"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLElision","preciseIdentifier":"s:7IvorMXL10MXLElisionV"}],"modules":[{"name":"IvorMXL"}],"roleHeading":"Instance Property","externalID":"s:7IvorMXL8MXLLyricV7ContentO13SyllabicGroupV0F0V7elisionAA10MXLElisionVvp","symbolKind":"property","role":"symbol"},"abstract":[{"text":"The elision symbol connecting this syllable to the following text.","type":"text"}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"elision"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLElision","text":"MXLElision","preciseIdentifier":"s:7IvorMXL10MXLElisionV"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric\/Content-swift.enum\/SyllabicGroup\/Group-swift.struct\/elision"},"kind":"symbol","references":{"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLLyric":{"type":"topic","title":"MXLLyric","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLLyric"}],"url":"\/documentation\/ivormxl\/mxllyric","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric","role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLLyric"}],"abstract":[{"type":"text","text":"The lyric type represents text underlays for lyrics. Two text elements that are not separated by an elision"},{"type":"text","text":" "},{"type":"text","text":"element are part of the same syllable, but may have different text formatting. The MusicXML XSD is more strict"},{"type":"text","text":" "},{"type":"text","text":"than the DTD in enforcing this by disallowing a second syllabic element unless preceded by an elision element."},{"type":"text","text":" "},{"type":"text","text":"The lyric number indicates multiple lines, though a name can be used as well. Common name examples are verse"},{"type":"text","text":" "},{"type":"text","text":"and chorus."}]},"doc://IvorMXL/documentation/IvorMXL/MXLLyric/Content-swift.enum/SyllabicGroup/Group-swift.struct":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric\/Content-swift.enum\/SyllabicGroup\/Group-swift.struct","abstract":[{"text":"The elision and optional syllabic hyphenation type that precede a further syllable of elided lyric text.","type":"text"}],"title":"MXLLyric.Content.SyllabicGroup.Group","navigatorTitle":[{"text":"Group","kind":"identifier"}],"type":"topic","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Group","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxllyric\/content-swift.enum\/syllabicgroup\/group-swift.struct"},"doc://IvorMXL/documentation/IvorMXL/MXLElision":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLElision","abstract":[{"type":"text","text":"The elision type represents an elision between lyric syllables. The text content specifies the symbol used to"},{"type":"text","text":" "},{"type":"text","text":"display the elision. Common values are a no-break space (Unicode 00A0), an underscore (Unicode 005F), or an"},{"type":"text","text":" "},{"type":"text","text":"undertie (Unicode 203F). If the text content is empty, the smufl attribute is used to specify the symbol to"},{"type":"text","text":" "},{"type":"text","text":"use. Its value is a SMuFL canonical glyph name that starts with lyrics. The SMuFL attribute is ignored if the"},{"type":"text","text":" "},{"type":"text","text":"elision glyph is already specified by the text content. If neither text content nor a smufl attribute are"},{"type":"text","text":" "},{"type":"text","text":"present, the elision glyph is application-specific."}],"title":"MXLElision","navigatorTitle":[{"text":"MXLElision","kind":"identifier"}],"type":"topic","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLElision","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlelision"},"doc://IvorMXL/documentation/IvorMXL/MXLLyric/Content-swift.enum":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric\/Content-swift.enum","title":"MXLLyric.Content","type":"topic","kind":"symbol","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Content","kind":"identifier"}],"abstract":[{"type":"text","text":"One of the alternatives for Lyric."}],"url":"\/documentation\/ivormxl\/mxllyric\/content-swift.enum","navigatorTitle":[{"text":"Content","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLLyric/Content-swift.enum/SyllabicGroup/Group-swift.struct/elision":{"abstract":[{"text":"The elision symbol connecting this syllable to the following text.","type":"text"}],"kind":"symbol","type":"topic","role":"symbol","title":"elision","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric\/Content-swift.enum\/SyllabicGroup\/Group-swift.struct\/elision","url":"\/documentation\/ivormxl\/mxllyric\/content-swift.enum\/syllabicgroup\/group-swift.struct\/elision","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"elision"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL10MXLElisionV","text":"MXLElision"}]},"doc://IvorMXL/documentation/IvorMXL/MXLLyric/Content-swift.enum/SyllabicGroup":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric\/Content-swift.enum\/SyllabicGroup","abstract":[{"text":"An elided continuation of a lyric syllable, consisting of an optional elision-and-syllabic marker paired","type":"text"},{"text":" ","type":"text"},{"text":"with additional text.","type":"text"}],"title":"MXLLyric.Content.SyllabicGroup","navigatorTitle":[{"text":"SyllabicGroup","kind":"identifier"}],"type":"topic","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SyllabicGroup","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxllyric\/content-swift.enum\/syllabicgroup"}}}