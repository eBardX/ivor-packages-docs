r":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTextElementData","title":"MXLTextElementData","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTextElementData"}],"navigatorTitle":[{"text":"MXLTextElementData","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxltextelementdata","abstract":[{"type":"text","text":"The text-element-data type represents a syllable or portion of a syllable for lyric text underlay. A hyphen in"},{"text":" ","type":"text"},{"text":"the string content should only be used for an actual hyphenated word. Language names for text elements come","type":"text"},{"text":" ","type":"text"},{"text":"from ISO 639, with optional country subcodes from ISO 3166.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLLyric/Content-swift.enum":{"navigatorTitle":[{"kind":"identifier","text":"Content"}],"abstract":[{"type":"text","text":"One of the alternatives for Lyric."}],"title":"MXLLyric.Content","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric\/Content-swift.enum","kind":"symbol","url":"\/documentation\/ivormxl\/mxllyric\/content-swift.enum","type":"topic","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Content"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLLyric/Content-swift.enum/SyllabicGroup":{"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"SyllabicGroup"}],"title":"MXLLyric.Content.SyllabicGroup","url":"\/documentation\/ivormxl\/mxllyric\/content-swift.enum\/syllabicgroup","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SyllabicGroup"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric\/Content-swift.enum\/SyllabicGroup","abstract":[{"text":"An elided continuation of a lyric syllable, consisting of an optional elision-and-syllabic marker paired","type":"text"},{"text":" ","type":"text"},{"text":"with additional text.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLLyric":{"navigatorTitle":[{"kind":"identifier","text":"MXLLyric"}],"abstract":[{"text":"The lyric type represents text underlays for lyrics. Two text elements that are not separated by an elision","type":"text"},{"text":" ","type":"text"},{"text":"element are part of the same syllable, but may have different text formatting. The MusicXML XSD is more strict","type":"text"},{"text":" ","type":"text"},{"text":"than the DTD in enforcing this by disallowing a second syllabic element unless preceded by an elision element.","type":"text"},{"text":" ","type":"text"},{"text":"The lyric number indicates multiple lines, though a name can be used as well. Common name examples are verse","type":"text"},{"text":" ","type":"text"},{"text":"and chorus.","type":"text"}],"title":"MXLLyric","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric","kind":"symbol","url":"\/documentation\/ivormxl\/mxllyric","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLLyric"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLLyric/Content-swift.enum/SyllabicGroup/text":{"url":"\/documentation\/ivormxl\/mxllyric\/content-swift.enum\/syllabicgroup\/text","kind":"symbol","title":"text","abstract":[{"type":"text","text":"The text of this elided lyric continuation."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric\/Content-swift.enum\/SyllabicGroup\/text","type":"topic","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"text"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL18MXLTextElementDataV","text":"MXLTextElementData"}],"role":"symbol"}}}