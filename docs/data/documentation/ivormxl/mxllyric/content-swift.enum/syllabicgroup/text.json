"kind":"text"},{"preciseIdentifier":"s:7IvorMXL18MXLTextElementDataV","text":"MXLTextElementData","kind":"typeIdentifier"}],"title":"text","url":"\/documentation\/ivormxl\/mxllyric\/content-swift.enum\/syllabicgroup\/text","abstract":[{"type":"text","text":"The text of this elided lyric continuation."}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLLyric/Content-swift.enum":{"type":"topic","title":"MXLLyric.Content","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric\/Content-swift.enum","abstract":[{"text":"One of the alternatives for Lyric.","type":"text"}],"role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Content","kind":"identifier"}],"navigatorTitle":[{"text":"Content","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxllyric\/content-swift.enum"},"doc://IvorMXL/documentation/IvorMXL/MXLLyric/Content-swift.enum/SyllabicGroup":{"type":"topic","title":"MXLLyric.Content.SyllabicGroup","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric\/Content-swift.enum\/SyllabicGroup","abstract":[{"text":"An elided continuation of a lyric syllable, consisting of an optional elision-and-syllabic marker paired","type":"text"},{"text":" ","type":"text"},{"text":"with additional text.","type":"text"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SyllabicGroup","kind":"identifier"}],"navigatorTitle":[{"text":"SyllabicGroup","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxllyric\/content-swift.enum\/syllabicgroup"},"doc://IvorMXL/documentation/IvorMXL/MXLTextElementData":{"type":"topic","title":"MXLTextElementData","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTextElementData","abstract":[{"text":"The text-element-data type represents a syllable or portion of a syllable for lyric text underlay. A hyphen in","type":"text"},{"text":" ","type":"text"},{"text":"the string content should only be used for an actual hyphenated word. Language names for text elements come","type":"text"},{"text":" ","type":"text"},{"text":"from ISO 639, with optional country subcodes from ISO 3166.","type":"text"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTextElementData","kind":"identifier"}],"navigatorTitle":[{"text":"MXLTextElementData","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxltextelementdata"},"doc://IvorMXL/documentation/IvorMXL/MXLLyric":{"type":"topic","abstract":[{"type":"text","text":"The lyric type represents text underlays for lyrics. Two text elements that are not separated by an elision"},{"type":"text","text":" "},{"type":"text","text":"element are part of the same syllable, but may have different text formatting. The MusicXML XSD is more strict"},{"type":"text","text":" "},{"type":"text","text":"than the DTD in enforcing this by disallowing a second syllabic element unless preceded by an elision element."},{"type":"text","text":" "},{"type":"text","text":"The lyric number indicates multiple lines, though a name can be used as well. Common name examples are verse"},{"type":"text","text":" "},{"text":"and chorus.","type":"text"}],"url":"\/documentation\/ivormxl\/mxllyric","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLLyric"}],"kind":"symbol","title":"MXLLyric","navigatorTitle":[{"text":"MXLLyric","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric","role":"symbol"}}}