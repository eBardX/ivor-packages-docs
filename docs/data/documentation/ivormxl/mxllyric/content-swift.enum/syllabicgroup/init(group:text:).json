ontent-swift.enum","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Content"}]},"doc://IvorMXL/documentation/IvorMXL/MXLLyric":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLLyric"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLLyric"}],"url":"\/documentation\/ivormxl\/mxllyric","role":"symbol","title":"MXLLyric","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric","type":"topic","abstract":[{"type":"text","text":"The lyric type represents text underlays for lyrics. Two text elements that are not separated by an elision"},{"type":"text","text":" "},{"type":"text","text":"element are part of the same syllable, but may have different text formatting. The MusicXML XSD is more strict"},{"type":"text","text":" "},{"type":"text","text":"than the DTD in enforcing this by disallowing a second syllabic element unless preceded by an elision element."},{"type":"text","text":" "},{"type":"text","text":"The lyric number indicates multiple lines, though a name can be used as well. Common name examples are verse"},{"text":" ","type":"text"},{"type":"text","text":"and chorus."}]},"doc://IvorMXL/documentation/IvorMXL/MXLLyric/Content-swift.enum/SyllabicGroup":{"url":"\/documentation\/ivormxl\/mxllyric\/content-swift.enum\/syllabicgroup","abstract":[{"type":"text","text":"An elided continuation of a lyric syllable, consisting of an optional elision-and-syllabic marker paired"},{"type":"text","text":" "},{"type":"text","text":"with additional text."}],"title":"MXLLyric.Content.SyllabicGroup","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SyllabicGroup"}],"navigatorTitle":[{"kind":"identifier","text":"SyllabicGroup"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric\/Content-swift.enum\/SyllabicGroup","kind":"symbol","type":"topic"}}}