:"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLLyric/Content-swift.enum/SyllabicGroup":{"kind":"symbol","abstract":[{"type":"text","text":"An elided continuation of a lyric syllable, consisting of an optional elision-and-syllabic marker paired"},{"type":"text","text":" "},{"type":"text","text":"with additional text."}],"url":"\/documentation\/ivormxl\/mxllyric\/content-swift.enum\/syllabicgroup","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric\/Content-swift.enum\/SyllabicGroup","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SyllabicGroup","kind":"identifier"}],"title":"MXLLyric.Content.SyllabicGroup","navigatorTitle":[{"kind":"identifier","text":"SyllabicGroup"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLTextElementData":{"title":"MXLTextElementData","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTextElementData"}],"abstract":[{"text":"The text-element-data type represents a syllable or portion of a syllable for lyric text underlay. A hyphen in","type":"text"},{"text":" ","type":"text"},{"text":"the string content should only be used for an actual hyphenated word. Language names for text elements come","type":"text"},{"text":" ","type":"text"},{"text":"from ISO 639, with optional country subcodes from ISO 3166.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTextElementData","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLTextElementData"}],"url":"\/documentation\/ivormxl\/mxltextelementdata"},"doc://IvorMXL/documentation/IvorMXL/MXLLyric/Content-swift.enum":{"role":"symbol","url":"\/documentation\/ivormxl\/mxllyric\/content-swift.enum","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric\/Content-swift.enum","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Content","kind":"identifier"}],"abstract":[{"type":"text","text":"One of the alternatives for Lyric."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Content"}],"title":"MXLLyric.Content"},"doc://IvorMXL/documentation/IvorMXL/MXLLyric/Content-swift.enum/SyllabicGroup/Group-swift.struct":{"url":"\/documentation\/ivormxl\/mxllyric\/content-swift.enum\/syllabicgroup\/group-swift.struct","abstract":[{"type":"text","text":"The elision and optional syllabic hyphenation type that precede a further syllable of elided lyric text."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Group","kind":"identifier"}],"kind":"symbol","role":"symbol","title":"MXLLyric.Content.SyllabicGroup.Group","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric\/Content-swift.enum\/SyllabicGroup\/Group-swift.struct","navigatorTitle":[{"text":"Group","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLLyric":{"role":"symbol","url":"\/documentation\/ivormxl\/mxllyric","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLLyric"}],"kind":"symbol","abstract":[{"type":"text","text":"The lyric type represents text underlays for lyrics. Two text elements that are not separated by an elision"},{"type":"text","text":" "},{"type":"text","text":"element are part of the same syllable, but may have different text formatting. The MusicXML XSD is more strict"},{"type":"text","text":" "},{"type":"text","text":"than the DTD in enforcing this by disallowing a second syllabic element unless preceded by an elision element."},{"type":"text","text":" "},{"type":"text","text":"The lyric number indicates multiple lines, though a name can be used as well. Common name examples are verse"},{"type":"text","text":" "},{"type":"text","text":"and chorus."}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLLyric"}],"title":"MXLLyric"}}}