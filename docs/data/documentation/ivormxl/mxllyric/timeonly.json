rmatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLTimeOnly":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxltimeonly","title":"MXLTimeOnly","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTimeOnly","kind":"identifier"}],"navigatorTitle":[{"text":"MXLTimeOnly","kind":"identifier"}],"abstract":[{"type":"text","text":"The time-only type is used to indicate that a particular playback- or listening-related element only applies"},{"type":"text","text":" "},{"type":"text","text":"particular times through a repeated section. The value is a list of positive integers arranged in ascending"},{"type":"text","text":" "},{"type":"text","text":"order, indicating which times through the repeated section that the element applies."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTimeOnly"},"doc://IvorMXL/documentation/IvorMXL/MXLLyric/timeOnly":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric\/timeOnly","type":"topic","title":"timeOnly","kind":"symbol","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"timeOnly","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLTimeOnly","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLTimeOnlya"},{"text":"?","kind":"text"}],"abstract":[{"type":"text","text":"Restricts the element to apply to a specific set of times through a repeated section."}],"url":"\/documentation\/ivormxl\/mxllyric\/timeonly"},"doc://IvorMXL/documentation/IvorMXL/MXLLyric":{"type":"topic","title":"MXLLyric","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLLyric"}],"url":"\/documentation\/ivormxl\/mxllyric","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric","role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLLyric"}],"abstract":[{"type":"text","text":"The lyric type represents text underlays for lyrics. Two text elements that are not separated by an elision"},{"type":"text","text":" "},{"type":"text","text":"element are part of the same syllable, but may have different text formatting. The MusicXML XSD is more strict"},{"type":"text","text":" "},{"type":"text","text":"than the DTD in enforcing this by disallowing a second syllabic element unless preceded by an elision element."},{"type":"text","text":" "},{"type":"text","text":"The lyric number indicates multiple lines, though a name can be used as well. Common name examples are verse"},{"type":"text","text":" "},{"type":"text","text":"and chorus."}]}}}