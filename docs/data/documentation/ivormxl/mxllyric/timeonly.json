he same syllable, but may have different text formatting. The MusicXML XSD is more strict"},{"type":"text","text":" "},{"type":"text","text":"than the DTD in enforcing this by disallowing a second syllabic element unless preceded by an elision element."},{"type":"text","text":" "},{"type":"text","text":"The lyric number indicates multiple lines, though a name can be used as well. Common name examples are verse"},{"type":"text","text":" "},{"text":"and chorus.","type":"text"}],"url":"\/documentation\/ivormxl\/mxllyric","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLLyric"}],"kind":"symbol","title":"MXLLyric","navigatorTitle":[{"text":"MXLLyric","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLLyric/timeOnly":{"type":"topic","fragments":[{"kind":"keyword","text":"let"},{"text":" ","kind":"text"},{"text":"timeOnly","kind":"identifier"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL11MXLTimeOnlya","kind":"typeIdentifier","text":"MXLTimeOnly"},{"kind":"text","text":"?"}],"url":"\/documentation\/ivormxl\/mxllyric\/timeonly","title":"timeOnly","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric\/timeOnly","kind":"symbol","abstract":[{"type":"text","text":"Restricts the element to apply to a specific set of times through a repeated section."}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLTimeOnly":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTimeOnly","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLTimeOnly"}],"type":"topic","title":"MXLTimeOnly","kind":"symbol","url":"\/documentation\/ivormxl\/mxltimeonly","abstract":[{"type":"text","text":"The time-only type is used to indicate that a particular playback- or listening-related element only applies"},{"type":"text","text":" "},{"type":"text","text":"particular times through a repeated section. The value is a list of positive integers arranged in ascending"},{"type":"text","text":" "},{"type":"text","text":"order, indicating which times through the repeated section that the element applies."}],"fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTimeOnly"}]}}}