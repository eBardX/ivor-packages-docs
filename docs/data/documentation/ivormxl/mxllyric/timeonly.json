n\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLLyric":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLLyric"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLLyric"}],"url":"\/documentation\/ivormxl\/mxllyric","role":"symbol","title":"MXLLyric","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric","type":"topic","abstract":[{"type":"text","text":"The lyric type represents text underlays for lyrics. Two text elements that are not separated by an elision"},{"type":"text","text":" "},{"type":"text","text":"element are part of the same syllable, but may have different text formatting. The MusicXML XSD is more strict"},{"type":"text","text":" "},{"type":"text","text":"than the DTD in enforcing this by disallowing a second syllabic element unless preceded by an elision element."},{"type":"text","text":" "},{"type":"text","text":"The lyric number indicates multiple lines, though a name can be used as well. Common name examples are verse"},{"text":" ","type":"text"},{"type":"text","text":"and chorus."}]},"doc://IvorMXL/documentation/IvorMXL/MXLLyric/timeOnly":{"abstract":[{"text":"Restricts the element to apply to a specific set of times through a repeated section.","type":"text"}],"type":"topic","title":"timeOnly","kind":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"timeOnly"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLTimeOnly","preciseIdentifier":"s:7IvorMXL11MXLTimeOnlya"},{"kind":"text","text":"?"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric\/timeOnly","url":"\/documentation\/ivormxl\/mxllyric\/timeonly","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLTimeOnly":{"fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTimeOnly"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTimeOnly","navigatorTitle":[{"kind":"identifier","text":"MXLTimeOnly"}],"type":"topic","title":"MXLTimeOnly","role":"symbol","abstract":[{"type":"text","text":"The time-only type is used to indicate that a particular playback- or listening-related element only applies"},{"type":"text","text":" "},{"type":"text","text":"particular times through a repeated section. The value is a list of positive integers arranged in ascending"},{"type":"text","text":" "},{"type":"text","text":"order, indicating which times through the repeated section that the element applies."}],"url":"\/documentation\/ivormxl\/mxltimeonly","kind":"symbol"}}}