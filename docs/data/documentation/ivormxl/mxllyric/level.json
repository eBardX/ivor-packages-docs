vel":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxllevel","title":"MXLLevel","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLLevel"}],"navigatorTitle":[{"kind":"identifier","text":"MXLLevel"}],"abstract":[{"text":"The level type is used to specify editorial information for different MusicXML elements. The content contains","type":"text"},{"text":" ","type":"text"},{"text":"identifying and\/or descriptive text about the editorial status of the parent element.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLevel"}}}