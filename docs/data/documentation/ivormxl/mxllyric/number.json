ber","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric\/number","type":"topic","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"number"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLLyric":{"navigatorTitle":[{"kind":"identifier","text":"MXLLyric"}],"abstract":[{"text":"The lyric type represents text underlays for lyrics. Two text elements that are not separated by an elision","type":"text"},{"text":" ","type":"text"},{"text":"element are part of the same syllable, but may have different text formatting. The MusicXML XSD is more strict","type":"text"},{"text":" ","type":"text"},{"text":"than the DTD in enforcing this by disallowing a second syllabic element unless preceded by an elision element.","type":"text"},{"text":" ","type":"text"},{"text":"The lyric number indicates multiple lines, though a name can be used as well. Common name examples are verse","type":"text"},{"text":" ","type":"text"},{"text":"and chorus.","type":"text"}],"title":"MXLLyric","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric","kind":"symbol","url":"\/documentation\/ivormxl\/mxllyric","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLLyric"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"}}}