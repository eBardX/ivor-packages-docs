},{"text":" ","type":"text"},{"text":"includes key and time signatures, clefs, transpositions, and staving. When attributes are changed mid-measure,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"it affects the music in score order, not in MusicXML document order."}],"sections":[],"relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/IvorMXL\/s8CopyableP","doc:\/\/IvorMXL\/SQ","doc:\/\/IvorMXL\/s9EscapableP","doc:\/\/IvorMXL\/SH","doc:\/\/IvorMXL\/s8SendableP","doc:\/\/IvorMXL\/s16SendableMetatypeP"],"type":"conformsTo"}],"seeAlsoSections":[{"title":"Music","generated":true,"anchor":"Music","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMusicItem","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFullNote","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRest","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPitch","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound"]}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes","interfaceLanguage":"swift"},"metadata":{"title":"MXLAttributes","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLAttributes"}],"modules":[{"name":"IvorMXL"}],"roleHeading":"Structure","navigatorTitle":[{"kind":"identifier","text":"MXLAttributes"}],"externalID":"s:7IvorMXL13MXLAttributesV","symbolKind":"struct"},"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLAttributes"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Maps the MusicXML "},{"code":"<attributes>","type":"codeVoice"},{"type":"text","text":" element."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlattributes"]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/footnote":{"title":"footnote","url":"\/documentation\/ivormxl\/mxlattributes\/footnote","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/footnote","abstract":[{"text":"The footnote element specifies editorial information that appears in footnotes in the printed score. It is","type":"text"},{"text":" ","type":"text"},{"text":"defined within a group due to its multiple uses within the MusicXML schema.","type":"text"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"footnote"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL16MXLFormattedTextV","text":"MXLFormattedText"},{"kind":"text","text":"?"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLRest":{"url":"\/documentation\/ivormxl\/mxlrest","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLRest"}],"title":"MXLRest","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRest","navigatorTitle":[{"kind":"identifier","text":"MXLRest"}],"role":"symbol","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The rest element indicates notated rests or silences. Rest elements are usually empty, but placement on the"},{"type":"text","text":" "},{"type":"text","text":"staff can be specified using display-step and display-octave elements. If the measure attribute is set to yes,"},{"type":"text","text":" "},{"type":"text","text":"this indicates this is a complete measure rest."}]},"doc://IvorMXL/documentation/IvorMXL/MXLDirection":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLDirection"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection","title":"MXLDirection","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLDirection"}],"abstract":[{"text":"A direction is a musical indication that is not necessarily attached to a specific note. Two or more may be","type":"text"},{"type":"text","text":" "},{"text":"combined to indicate words followed by the start of a dashed line, the end of a wedge followed by dynamics,","type":"text"},{"type":"text","text":" "},{"text":"etc. For applications where a specific direction is indeed attached to a specific note, the direction element","type":"text"},{"type":"text","text":" "},{"text":"can be associated with the first note element that follows it in score order that is not in a different voice.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxldirection"},"doc://IvorMXL/s16SendableMetatypeP":{"type":"unresolvable","title":"Swift.SendableMetatype","identifier":"doc:\/\/IvorMXL\/s16SendableMetatypeP"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/instruments":{"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/instruments","url":"\/documentation\/ivormxl\/mxlattributes\/instruments","abstract":[{"text":"The instruments element is only used if more than one instrument is represented in the part (e.g., oboe I and","type":"text"},{"text":" ","type":"text"},{"text":"II where they play together most of the time). If absent, a value of 1 is assumed.","type":"text"}],"type":"topic","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"instruments","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"title":"instruments"},"doc://IvorMXL/documentation/IvorMXL/MXLSound":{"url":"\/documentation\/ivormxl\/mxlsound","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLSound"}],"title":"MXLSound","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound","navigatorTitle":[{"kind":"identifier","text":"MXLSound"}],"role":"symbol","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The sound element contains general playback parameters. They can stand alone within a part\/measure, or be a"},{"type":"text","text":" "},{"type":"text","text":"component element within a direction."}]},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/key":{"title":"key","url":"\/documentation\/ivormxl\/mxlattributes\/key","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/key","abstract":[{"text":"The key element represents a key signature. Both traditional and non-traditional key signatures are supported.","type":"text"},{"text":" ","type":"text"},{"text":"The optional number attribute refers to staff numbers. If absent, the key signature applies to all staves in","type":"text"},{"text":" ","type":"text"},{"text":"the part.","type":"text"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"key"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL6MXLKeyV","text":"MXLKey"},{"kind":"text","text":"]"}],"type":"topic"},"doc://IvorMXL/SQ":{"identifier":"doc:\/\/IvorMXL\/SQ","title":"Swift.Equatable","type":"unresolvable"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline":{"role":"symbol","abstract":[{"type":"text","text":"If a barline is other than a normal single barline, it should be represented by a barline type that describes"},{"text":" ","type":"text"},{"type":"text","text":"it. This includes information about repeats and multiple endings, as well as line style. Barline data is on"},{"type":"text","text":" "},{"type":"text","text":"the same level as the other musical data in a score — a child of a measure in a partwise score, or a part in a"},{"text":" ","type":"text"},{"type":"text","text":"timewise score. This allows for barlines within measures, as in dotted barlines that subdivide measures in"},{"text":" ","type":"text"},{"type":"text","text":"complex meters. The two fermata elements allow for fermatas on both sides of the barline (the lower one"},{"type":"text","text":" "},{"type":"text","text":"inverted)."}],"title":"MXLBarline","url":"\/documentation\/ivormxl\/mxlbarline","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline","navigatorTitle":[{"text":"MXLBarline","kind":"identifier"}],"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLBarline"}]},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/staves":{"type":"topic","abstract":[{"type":"text","text":"The staves element is used if there is more than one staff represented in the given part (e.g., 2 staves for"},{"type":"text","text":" "},{"type":"text","text":"typical piano parts). If absent, a value of 1 is assumed. Staves are ordered from top to bottom in a part in"},{"type":"text","text":" "},{"type":"text","text":"numerical order, with staff 1 above staff 2."}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/staves","title":"staves","url":"\/documentation\/ivormxl\/mxlattributes\/staves","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"staves","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":"?","kind":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLMusicItem":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLMusicItem"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLMusicItem"}],"url":"\/documentation\/ivormxl\/mxlmusicitem","role":"symbol","title":"MXLMusicItem","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMusicItem","type":"topic","abstract":[{"type":"text","text":"One of the alternatives for a music item."}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/staffDetails":{"title":"staffDetails","url":"\/documentation\/ivormxl\/mxlattributes\/staffdetails","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/staffDetails","abstract":[{"text":"The staff-details element is used to indicate different types of staves.","type":"text"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"staffDetails"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL15MXLStaffDetailsV","text":"MXLStaffDetails"},{"kind":"text","text":"]"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/content-swift.property":{"kind":"symbol","abstract":[{"text":"One of the alternatives for Attributes.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/content-swift.property","url":"\/documentation\/ivormxl\/mxlattributes\/content-swift.property","fragments":[{"kind":"keyword","text":"let"},{"text":" ","kind":"text"},{"text":"content","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL13MXLAttributesV7ContentO","kind":"typeIdentifier","text":"Content"}],"title":"content","role":"symbol","type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/divisions":{"type":"topic","abstract":[{"type":"text","text":"Musical notation duration is commonly represented as fractions. The divisions element indicates how many"},{"type":"text","text":" "},{"type":"text","text":"divisions per quarter note are used to indicate a note’s duration. For example, if duration = 1 and divisions"},{"text":" ","type":"text"},{"text":"= 2, this is an eighth note duration. Duration and divisions are used directly for generating sound output, so","type":"text"},{"text":" ","type":"text"},{"text":"they must be chosen to take tuplets into account. Using a divisions element lets us use just one number to","type":"text"},{"text":" ","type":"text"},{"text":"represent a duration for each note in the score, while retaining the full power of a fractional","type":"text"},{"type":"text","text":" "},{"type":"text","text":"representation. If maximum compatibility with Standard MIDI 1.0 files is important, do not have the divisions"},{"type":"text","text":" "},{"type":"text","text":"value exceed 16383."}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/divisions","title":"divisions","url":"\/documentation\/ivormxl\/mxlattributes\/divisions","fragments":[{"text":"let","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"divisions"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL20MXLPositiveDivisionsV","text":"MXLPositiveDivisions"},{"kind":"text","text":"?"}]},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/directive-swift.property":{"kind":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"directive"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:7IvorMXL13MXLAttributesV9DirectiveV","text":"Directive","kind":"typeIdentifier"},{"kind":"text","text":"]"}],"type":"topic","title":"directive","role":"symbol","abstract":[{"type":"text","text":"Directives are like directions, but can be grouped together with attributes for convenience. This is typically"},{"type":"text","text":" "},{"type":"text","text":"used for tempo markings at the beginning of a piece of music. This element was deprecated in Version 2.0 in"},{"type":"text","text":" "},{"type":"text","text":"favor of the direction element’s directive attribute. Language names come from ISO 639, with optional country"},{"type":"text","text":" "},{"type":"text","text":"subcodes from ISO 3166."}],"url":"\/documentation\/ivormxl\/mxlattributes\/directive-swift.property","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/directive-swift.property"},"doc://IvorMXL/s8SendableP":{"identifier":"doc:\/\/IvorMXL\/s8SendableP","type":"unresolvable","title":"Swift.Sendable"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/Directive-swift.struct":{"type":"topic","abstract":[{"type":"text","text":"Directives are like directions, but can be grouped together with attributes for convenience. This is typically"},{"type":"text","text":" "},{"type":"text","text":"used for tempo markings at the beginning of a piece of music. This element was deprecated in Version 2.0 in"},{"type":"text","text":" "},{"type":"text","text":"favor of the direction element’s directive attribute. Language names come from ISO 639, with optional country"},{"type":"text","text":" "},{"type":"text","text":"subcodes from ISO 3166."}],"kind":"symbol","role":"symbol","navigatorTitle":[{"text":"Directive","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/Directive-swift.struct","title":"MXLAttributes.Directive","url":"\/documentation\/ivormxl\/mxlattributes\/directive-swift.struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Directive","kind":"identifier"}]},"doc://IvorMXL/SH":{"identifier":"doc:\/\/IvorMXL\/SH","title":"Swift.Hashable","type":"unresolvable"},"doc://IvorMXL/documentation/IvorMXL/MXLFullNote":{"url":"\/documentation\/ivormxl\/mxlfullnote","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFullNote"}],"title":"MXLFullNote","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFullNote","navigatorTitle":[{"kind":"identifier","text":"MXLFullNote"}],"role":"symbol","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The full-note group is a sequence of the common note elements between cue\/grace notes and regular (full)"},{"type":"text","text":" "},{"type":"text","text":"notes: pitch, chord, and rest information, but not duration (cue and grace notes do not have duration"},{"type":"text","text":" "},{"type":"text","text":"encoded). Unpitched elements are used for unpitched percussion, speaking voice, and other musical elements"},{"type":"text","text":" "},{"type":"text","text":"lacking determinate pitch."}]},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes":{"type":"topic","abstract":[{"type":"text","text":"The attributes element contains musical information that typically changes on measure boundaries. This"},{"text":" ","type":"text"},{"type":"text","text":"includes key and time signatures, clefs, transpositions, and staving. When attributes are changed mid-measure,"},{"type":"text","text":" "},{"type":"text","text":"it affects the music in score order, not in MusicXML document order."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLAttributes","kind":"identifier"}],"navigatorTitle":[{"text":"MXLAttributes","kind":"identifier"}],"title":"MXLAttributes","kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlattributes","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/measureStyle":{"type":"topic","abstract":[{"text":"A measure-style indicates a special way to print partial to multiple measures within a part. This includes","type":"text"},{"text":" ","type":"text"},{"text":"multiple rests over several measures, repeats of beats, single, or multiple measures, and use of slash","type":"text"},{"text":" ","type":"text"},{"text":"notation.","type":"text"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/measureStyle","title":"measureStyle","url":"\/documentation\/ivormxl\/mxlattributes\/measurestyle","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"measureStyle","kind":"identifier"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:7IvorMXL15MXLMeasureStyleV","text":"MXLMeasureStyle","kind":"typeIdentifier"},{"text":"]","kind":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNote"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLNote"}],"url":"\/documentation\/ivormxl\/mxlnote","role":"symbol","title":"MXLNote","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","type":"topic","abstract":[{"type":"text","text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for"},{"type":"text","text":" "},{"type":"text","text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation)."},{"type":"text","text":" "},{"type":"text","text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,"},{"type":"text","text":" "},{"type":"text","text":"but no tie elements. Having these two types of information available can make interchange easier, as some"},{"type":"text","text":" "},{"type":"text","text":"programs handle one type of information more readily than the other."}]},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/time":{"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/time","url":"\/documentation\/ivormxl\/mxlattributes\/time","abstract":[{"type":"text","text":"Time signatures are represented by the beats element for the numerator and the beat-type element for the"},{"type":"text","text":" "},{"type":"text","text":"denominator."}],"type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"time"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL7MXLTimeV","text":"MXLTime"},{"kind":"text","text":"]"}],"title":"time"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/init(footnote:level:divisions:key:time:staves:partSymbol:instruments:clef:staffDetails:content:directive:measureStyle:)":{"title":"init(footnote:level:divisions:key:time:staves:partSymbol:instruments:clef:staffDetails:content:directive:measureStyle:)","url":"\/documentation\/ivormxl\/mxlattributes\/init(footnote:level:divisions:key:time:staves:partsymbol:instruments:clef:staffdetails:content:directive:measurestyle:)","role":"symbol","abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLAttributes"},{"type":"text","text":"."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/init(footnote:level:divisions:key:time:staves:partSymbol:instruments:clef:staffDetails:content:directive:measureStyle:)","kind":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"footnote"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL16MXLFormattedTextV","text":"MXLFormattedText"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"level"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLLevelV","text":"MXLLevel"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"divisions"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL20MXLPositiveDivisionsV","text":"MXLPositiveDivisions"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"key"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL6MXLKeyV","text":"MXLKey"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"time"},{"kind":"text","text":": ["},{"kind":"typeIdentifie