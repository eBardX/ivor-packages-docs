{"seeAlsoSections":[{"anchor":"Music","generated":true,"title":"Music","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMusicItem","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRest","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPitch","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLAttributes","kind":"identifier"}],"languages":["swift"]}]},{"content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Maps the MusicXML "},{"type":"codeVoice","code":"<attributes>"},{"type":"text","text":" element."}]}],"kind":"content"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL"]]},"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes","interfaceLanguage":"swift"},"kind":"symbol","relationshipsSections":[{"identifiers":["doc:\/\/IvorMXL\/s8CopyableP","doc:\/\/IvorMXL\/SQ","doc:\/\/IvorMXL\/s9EscapableP","doc:\/\/IvorMXL\/SH","doc:\/\/IvorMXL\/s8SendableP","doc:\/\/IvorMXL\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships","title":"Conforms To"}],"variants":[{"paths":["\/documentation\/ivormxl\/mxlattributes"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLAttributes","kind":"identifier"}],"role":"symbol","roleHeading":"Structure","title":"MXLAttributes","externalID":"s:7IvorMXL13MXLAttributesV","navigatorTitle":[{"kind":"identifier","text":"MXLAttributes"}],"modules":[{"name":"IvorMXL"}],"symbolKind":"struct"},"abstract":[{"type":"text","text":"The attributes element contains musical information that typically changes on measure boundaries. This"},{"type":"text","text":" "},{"type":"text","text":"includes key and time signatures, clefs, transpositions, and staving. When attributes are changed mid-measure,"},{"type":"text","text":" "},{"type":"text","text":"it affects the music in score order, not in MusicXML document order."}],"topicSections":[{"anchor":"Structures","generated":true,"title":"Structures","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/Directive-swift.struct"]},{"anchor":"Initializers","generated":true,"title":"Initializers","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/init(footnote:level:divisions:key:time:staves:partSymbol:instruments:clef:staffDetails:content:directive:measureStyle:)"]},{"anchor":"Instance-Properties","generated":true,"title":"Instance Properties","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/clef","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/content-swift.property","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/directive-swift.property","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/divisions","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/footnote","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/instruments","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/key","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/level","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/measureStyle","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/partSymbol","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/staffDetails","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/staves","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/time"]},{"anchor":"Enumerations","generated":true,"title":"Enumerations","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/Content-swift.enum"]},{"anchor":"Default-Implementations","generated":true,"title":"Default Implementations","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/Equatable-Implementations"]}],"sections":[],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLSound":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlsound","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLSound"}],"abstract":[{"type":"text","text":"The sound element contains general playback parameters. They can stand alone within a part\/measure, or be a"},{"type":"text","text":" "},{"type":"text","text":"component element within a direction."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLSound"}],"title":"MXLSound"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/measureStyle":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"measureStyle","kind":"identifier"},{"text":": [","kind":"text"},{"text":"MXLMeasureStyle","preciseIdentifier":"s:7IvorMXL15MXLMeasureStyleV","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlattributes\/measurestyle","role":"symbol","type":"topic","abstract":[{"text":"A measure-style indicates a special way to print partial to multiple measures within a part. This includes","type":"text"},{"text":" ","type":"text"},{"text":"multiple rests over several measures, repeats of beats, single, or multiple measures, and use of slash","type":"text"},{"text":" ","type":"text"},{"text":"notation.","type":"text"}],"title":"measureStyle","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/measureStyle"},"doc://IvorMXL/SQ":{"type":"unresolvable","identifier":"doc:\/\/IvorMXL\/SQ","title":"Swift.Equatable"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes":{"role":"symbol","navigatorTitle":[{"text":"MXLAttributes","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLAttributes","kind":"identifier"}],"kind":"symbol","title":"MXLAttributes","url":"\/documentation\/ivormxl\/mxlattributes","type":"topic","abstract":[{"text":"The attributes element contains musical information that typically changes on measure boundaries. This","type":"text"},{"text":" ","type":"text"},{"text":"includes key and time signatures, clefs, transpositions, and staving. When attributes are changed mid-measure,","type":"text"},{"text":" ","type":"text"},{"text":"it affects the music in score order, not in MusicXML document order.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/level":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/level","kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxlattributes\/level","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"level"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLLevelV","text":"MXLLevel"},{"kind":"text","text":"?"}],"abstract":[{"type":"text","text":"The level element specifies editorial information for different MusicXML elements. It is defined within a"},{"type":"text","text":" "},{"type":"text","text":"group due to its multiple uses within the MusicXML schema."}],"role":"symbol","title":"level"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/footnote":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"footnote","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL16MXLFormattedTextV","text":"MXLFormattedText","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"role":"symbol","title":"footnote","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/footnote","kind":"symbol","abstract":[{"type":"text","text":"The footnote element specifies editorial information that appears in footnotes in the printed score. It is"},{"type":"text","text":" "},{"type":"text","text":"defined within a group due to its multiple uses within the MusicXML schema."}],"type":"topic","url":"\/documentation\/ivormxl\/mxlattributes\/footnote"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection":{"role":"symbol","url":"\/documentation\/ivormxl\/mxldirection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLDirection","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"A direction is a musical indication that is not necessarily attached to a specific note. Two or more may be","type":"text"},{"text":" ","type":"text"},{"text":"combined to indicate words followed by the start of a dashed line, the end of a wedge followed by dynamics,","type":"text"},{"text":" ","type":"text"},{"text":"etc. For applications where a specific direction is indeed attached to a specific note, the direction element","type":"text"},{"text":" ","type":"text"},{"text":"can be associated with the first note element that follows it in score order that is not in a different voice.","type":"text"}],"type":"topic","navigatorTitle":[{"text":"MXLDirection","kind":"identifier"}],"title":"MXLDirection"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/clef":{"kind":"symbol","url":"\/documentation\/ivormxl\/mxlattributes\/clef","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/clef","role":"symbol","title":"clef","abstract":[{"text":"Clefs are represented by a combination of sign, line, and clef-octave-change elements.","type":"text"}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"clef"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL7MXLClefV","text":"MXLClef"},{"kind":"text","text":"]"}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/SH":{"type":"unresolvable","identifier":"doc:\/\/IvorMXL\/SH","title":"Swift.Hashable"},"doc://IvorMXL/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/IvorMXL\/s8SendableP","title":"Swift.Sendable"},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"title":"MXLNote","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNote"}],"abstract":[{"type":"text","text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for"},{"type":"text","text":" "},{"type":"text","text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation)."},{"type":"text","text":" "},{"type":"text","text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,"},{"type":"text","text":" "},{"type":"text","text":"but no tie elements. Having these two types of information available can make interchange easier, as some"},{"type":"text","text":" "},{"type":"text","text":"programs handle one type of information more readily than the other."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLNote"}],"url":"\/documentation\/ivormxl\/mxlnote"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/partSymbol":{"abstract":[{"text":"The part-symbol element indicates how a symbol for a multi-staff part is indicated in the score.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlattributes\/partsymbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"partSymbol","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLPartSymbol","preciseIdentifier":"s:7IvorMXL13MXLPartSymbolV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/partSymbol","role":"symbol","title":"partSymbol","type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/Directive-swift.struct":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlattributes\/directive-swift.struct","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/Directive-swift.struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Directive","kind":"identifier"}],"abstract":[{"text":"Directives are like directions, but can be grouped together with attributes for convenience. This is typically","type":"text"},{"text":" ","type":"text"},{"text":"used for tempo markings at the beginning of a piece of music. This element was deprecated in Version 2.0 in","type":"text"},{"text":" ","type":"text"},{"text":"favor of the direction element’s directive attribute. Language names come from ISO 639, with optional country","type":"text"},{"text":" ","type":"text"},{"text":"subcodes from ISO 3166.","type":"text"}],"kind":"symbol","type":"topic","navigatorTitle":[{"text":"Directive","kind":"identifier"}],"title":"MXLAttributes.Directive"},"doc://IvorMXL/documentation/IvorMXL/MXLMusicItem":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlmusicitem","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMusicItem","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLMusicItem"}],"abstract":[{"type":"text","text":"One of the alternatives for a music item."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLMusicItem"}],"title":"MXLMusicItem"},"doc://IvorMXL/documentation/IvorMXL/MXLPitch":{"role":"symbol","navigatorTitle":[{"text":"MXLPitch","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPitch","kind":"identifier"}],"kind":"symbol","title":"MXLPitch","url":"\/documentation\/ivormxl\/mxlpitch","type":"topic","abstract":[{"text":"Pitch is represented as a combination of the step of the diatonic scale, the chromatic alteration, and the","type":"text"},{"text":" ","type":"text"},{"text":"octave.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPitch"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/staves":{"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"staves"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":"?"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlattributes\/staves","role":"symbol","type":"topic","abstract":[{"type":"text","text":"The staves element is used if there is more than one staff represented in the given part (e.g., 2 staves for"},{"type":"text","text":" "},{"type":"text","text":"typical piano parts). If absent, a value of 1 is assumed. Staves are ordered from top to bottom in a part in"},{"type":"text","text":" "},{"type":"text","text":"numerical order, with staff 1 above staff 2."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/staves","title":"staves"},"doc://IvorMXL/s8CopyableP":{"type":"unresolvable","identifier":"doc:\/\/IvorMXL\/s8CopyableP","title":"Swift.Copyable"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/directive-swift.property":{"type":"topic","url":"\/documentation\/ivormxl\/mxlattributes\/directive-swift.property","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/directive-swift.property","title":"directive","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"directive","kind":"identifier"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:7IvorMXL13MXLAttributesV9DirectiveV","text":"Directive","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"abstract":[{"text":"Directives are like directions, but can be grouped together with attributes for convenience. This is typically","type":"text"},{"text":" ","type":"text"},{"text":"used for tempo markings at the beginning of a piece of music. This element was deprecated in Version 2.0 in","type":"text"},{"text":" ","type":"text"},{"text":"favor of the direction element’s directive attribute. Language names come from ISO 639, with optional country","type":"text"},{"text":" ","type":"text"},{"text":"subcodes from ISO 3166.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/init(footnote:level:divisions:key:time:staves:partSymbol:instruments:clef:staffDetails:content:directive:measureStyle:)":{"url":"\/documentation\/ivormxl\/mxlattributes\/init(footnote:level:divisions:key:time:staves:partsymbol:instruments:clef:staffdetails:content:directive:measurestyle:)","title":"init(footnote:level:divisions:key:time:staves:partSymbol:instruments:clef:staffDetails:content:directive:measureStyle:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"footnote","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLFormattedText","preciseIdentifier":"s:7IvorMXL16MXLFormattedTextV","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"level","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLLevel","preciseIdentifier":"s:7IvorMXL8MXLLevelV","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"divisions","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLPositiveDivisions","preciseIdentifier":"s:7IvorMXL20MXLPositiveDivisionsV","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"key","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"MXLKey","preciseIdentifier":"s:7IvorMXL6MXLKeyV","kind":"typeIdentifier"},{"text":"], ","kind":"text"},{"text":"time","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"MXLTime","preciseIdentifier":"s:7IvorMXL7MXLTimeV","kind":"typeIdentifier"},{"text":"], ","kind":"text"},{"text":"staves","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"partSymbol","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLPartSymbol","preciseIdentifier":"s:7IvorMXL13MXLPartSymbolV","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"instruments","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"clef","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"MXLClef","preciseIdentifier":"s:7IvorMXL7MXLClefV","kind":"typeIdentifier"},{"text":"], ","kind":"text"},{"text":"staffDetails","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"MXLStaffDetails","preciseIdentifier":"s:7IvorMXL15MXLStaffDetailsV","kind":"typeIdentifier"},{"text":"], ","kind":"text"},{"text":"content","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Content","preciseIdentifier":"s:7IvorMXL13MXLAttributesV7ContentO","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"directive","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"Directive","preciseIdentifier":"s:7IvorMXL13MXLAttributesV9DirectiveV","kind":"typeIdentifier"},{"text":"], ","kind":"text"},{"text":"measureStyle","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"MXLMeasureStyle","preciseIdentifier":"s:7IvorMXL15MXLMeasureStyleV","kind":"typeIdentifier"},{"text":"])","kind":"text"}],"abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLAttributes"},{"type":"text","text":"."}],"role":"symbol","kind":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/init(footnote:level:divisions:key:time:staves:partSymbol:instruments:clef:staffDetails:content:directive:measureStyle:)"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/staffDetails":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/staffDetails","url":"\/documentation\/ivormxl\/mxlattributes\/staffdetails","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"staffDetails","kind":"identifier"},{"text":": [","kind":"text"},{"text":"MXLStaffDetails","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL15MXLStaffDetailsV"},{"kind":"text","text":"]"}],"type":"topic","kind":"symbol","title":"staffDetails","role":"symbol","abstract":[{"type":"text","text":"The staff-details element is used to indicate different types of staves."}]},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/content-swift.property":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/content-swift.property","kind":"symbol","abstract":[{"text":"One of the alternatives for Attributes.","type":"text"}],"type":"topic","title":"content","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"content","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Content","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL13MXLAttributesV7ContentO"}],"url":"\/documentation\/ivormxl\/mxlattributes\/content-swift.property","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLRest":{"role":"symbol","navigatorTitle":[{"text":"MXLRest","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLRest","kind":"identifier"}],"kind":"symbol","title":"MXLRest","url":"\/documentation\/ivormxl\/mxlrest","type":"topic","abstract":[{"text":"The rest element indicates notated rests or silences. Rest elements are usually empty, but placement on the","type":"text"},{"text":" ","type":"text"},{"text":"staff can be specified using display-step and display-octave elements. If the measure attribute is set to yes,","type":"text"},{"text":" ","type":"text"},{"text":"this indicates this is a complete measure rest.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRest"},"doc://IvorMXL/s9EscapableP":{"type":"unresolvable","identifier":"doc:\/\/IvorMXL\/s9EscapableP","title":"Swift.Escapable"},"doc://IvorMXL/s16SendableMetatypeP":{"type":"unresolvable","identifier":"doc:\/\/IvorMXL\/s16SendableMetatypeP","title":"Swift.SendableMetatype"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/Content-swift.enum":{"abstract":[{"type":"text","text":"One of the alternatives for Attributes."}],"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlattributes\/content-swift.enum","title":"MXLAttributes.Content","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/Content-swift.enum","navigatorTitle":[{"text":"Content","kind":"identifier"}],"type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Content","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/divisions":{"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/divisions","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"divisions"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL20MXLPositiveDivisionsV","kind":"typeIdentifier","text":"MXLPositiveDivisions"},{"kind":"text","text":"?"}],"url":"\/documentation\/ivormxl\/mxlattributes\/divisions","title":"divisions","type":"topic","abstract":[{"type":"text","text":"Musical notation duration is commonly represented as fractions. The divisions element indicates how many"},{"type":"text","text":" "},{"type":"text","text":"divisions per quarter note are used to indicate a note’s duration. For example, if duration = 1 and divisions"},{"type":"text","text":" "},{"type":"text","text":"= 2, this is an eighth note duration. Duration and divisions are used directly for generating sound output, so"},{"type":"text","text":" "},{"type":"text","text":"they must be chosen to take tuplets into account. Using a divisions element lets us use just one number to"},{"type":"text","text":" "},{"type":"text","text":"represent a duration for each note in the score, while retaining the full power of a fractional"},{"type":"text","text":" "},{"type":"text","text":"representation. If maximum compatibility with Standard MIDI 1.0 files is important, do not have the divisions"},{"type":"text","text":" "},{"type":"text","text":"value exceed 16383."}]},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/time":{"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"time"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL7MXLTimeV","text":"MXLTime"},{"kind":"text","text":"]"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlattributes\/time","role":"symbol","type":"topic","abstract":[{"type":"text","text":"Time signatures are represented by the beats element for the numerator and the beat-type element for the"},{"type":"text","text":" "},{"type":"text","text":"denominator."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/time","title":"time"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlbarline","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLBarline"}],"abstract":[{"type":"text","text":"If a barline is other than a normal single barline, it should be represented by a barline type that describes"},{"type":"text","text":" "},{"type":"text","text":"it. This includes information about repeats and multiple endings, as well as line style. Barline data is on"},{"type":"text","text":" "},{"type":"text","text":"the same level as the other musical data in a score — a child of a measure in a partwise score, or a part in a"},{"type":"text","text":" "},{"type":"text","text":"timewise score. This allows for barlines within measures, as in dotted barlines that subdivide measures in"},{"type":"text","text":" "},{"type":"text","text":"complex meters. The two fermata elements allow for fermatas on both sides of the barline (the lower one"},{"type":"text","text":" "},{"type":"text","text":"inverted)."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLBarline"}],"title":"MXLBarline"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/key":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"key","kind":"identifier"},{"text":": [","kind":"text"},{"text":"MXLKey","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL6MXLKeyV"},{"text":"]","kind":"text"}],"type":"topic","role":"symbol","title":"key","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/key","abstract":[{"type":"text","text":"The key element represents a key signature. Both traditional and non-traditional key signatures are supported."},{"type":"text","text":" "},{"type":"text","text":"The optional number attribute refers to staff numbers. If absent, the key signature applies to all staves in"},{"type":"text","text":" "},{"type":"text","text":"the part."}],"url":"\/documentation\/ivormxl\/mxlattributes\/key"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/instruments":{"abstract":[{"type":"text","text":"The instruments element is only used if more than one instrument is represented in the part (e.g., oboe I and"},{"type":"text","text":" "},{"type":"text","text":"II where they play together most of the time). If absent, a value of 1 is assumed."}],"kind":"symbol","role":"symbol","type":"topic","title":"instruments","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/instruments","url":"\/documentation\/ivormxl\/mxlattributes\/instruments","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"instruments","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":"?","kind":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/Equatable-Implementations":{"role":"collectionGroup","title":"Equatable Implementations","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/Equatable-Implementations","kind":"article","abstract":[],"type":"topic","url":"\/documentation\/ivormxl\/mxlattributes\/equatable-implementations"}}}