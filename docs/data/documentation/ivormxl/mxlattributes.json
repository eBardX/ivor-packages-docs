{"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"roleHeading":"Structure","symbolKind":"struct","modules":[{"name":"IvorMXL"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLAttributes"}],"title":"MXLAttributes","navigatorTitle":[{"text":"MXLAttributes","kind":"identifier"}],"externalID":"s:7IvorMXL13MXLAttributesV","role":"symbol"},"kind":"symbol","variants":[{"paths":["\/documentation\/ivormxl\/mxlattributes"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLAttributes"}]}]},{"content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Maps the MusicXML "},{"type":"codeVoice","code":"<attributes>"},{"type":"text","text":" element."}]}],"kind":"content"}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL"]]},"sections":[],"abstract":[{"type":"text","text":"The attributes element contains musical information that typically changes on measure boundaries. This"},{"type":"text","text":" "},{"type":"text","text":"includes key and time signatures, clefs, transpositions, and staving. When attributes are changed mid-measure,"},{"type":"text","text":" "},{"type":"text","text":"it affects the music in score order, not in MusicXML document order."}],"topicSections":[{"generated":true,"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/Directive-swift.struct"],"title":"Structures","anchor":"Structures"},{"generated":true,"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/init(footnote:level:divisions:key:time:staves:partSymbol:instruments:clef:staffDetails:content:directive:measureStyle:)"],"title":"Initializers","anchor":"Initializers"},{"generated":true,"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/clef","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/content-swift.property","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/directive-swift.property","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/divisions","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/footnote","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/instruments","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/key","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/level","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/measureStyle","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/partSymbol","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/staffDetails","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/staves","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/time"],"title":"Instance Properties","anchor":"Instance-Properties"},{"generated":true,"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/Content-swift.enum"],"title":"Enumerations","anchor":"Enumerations"},{"generated":true,"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/Equatable-Implementations"],"title":"Default Implementations","anchor":"Default-Implementations"}],"relationshipsSections":[{"type":"conformsTo","kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/IvorMXL\/s8CopyableP","doc:\/\/IvorMXL\/SQ","doc:\/\/IvorMXL\/s9EscapableP","doc:\/\/IvorMXL\/SH","doc:\/\/IvorMXL\/s8SendableP","doc:\/\/IvorMXL\/s16SendableMetatypeP"]}],"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMusicItem","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFullNote","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRest","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPitch","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound"],"title":"Music","anchor":"Music"}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLPitch":{"navigatorTitle":[{"text":"MXLPitch","kind":"identifier"}],"abstract":[{"type":"text","text":"Pitch is represented as a combination of the step of the diatonic scale, the chromatic alteration, and the"},{"type":"text","text":" "},{"type":"text","text":"octave."}],"title":"MXLPitch","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPitch","kind":"symbol","url":"\/documentation\/ivormxl\/mxlpitch","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPitch","kind":"identifier"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/Directive-swift.struct":{"abstract":[{"text":"Directives are like directions, but can be grouped together with attributes for convenience. This is typically","type":"text"},{"text":" ","type":"text"},{"text":"used for tempo markings at the beginning of a piece of music. This element was deprecated in Version 2.0 in","type":"text"},{"text":" ","type":"text"},{"text":"favor of the direction element’s directive attribute. Language names come from ISO 639, with optional country","type":"text"},{"text":" ","type":"text"},{"text":"subcodes from ISO 3166.","type":"text"}],"title":"MXLAttributes.Directive","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Directive"}],"navigatorTitle":[{"kind":"identifier","text":"Directive"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlattributes\/directive-swift.struct","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/Directive-swift.struct"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/staves":{"url":"\/documentation\/ivormxl\/mxlattributes\/staves","kind":"symbol","title":"staves","abstract":[{"text":"The staves element is used if there is more than one staff represented in the given part (e.g., 2 staves for","type":"text"},{"text":" ","type":"text"},{"text":"typical piano parts). If absent, a value of 1 is assumed. Staves are ordered from top to bottom in a part in","type":"text"},{"text":" ","type":"text"},{"text":"numerical order, with staff 1 above staff 2.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/staves","type":"topic","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"staves"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":"?"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/partSymbol":{"title":"partSymbol","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"text":"partSymbol","kind":"identifier"},{"kind":"text","text":": "},{"text":"MXLPartSymbol","preciseIdentifier":"s:7IvorMXL13MXLPartSymbolV","kind":"typeIdentifier"},{"kind":"text","text":"?"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlattributes\/partsymbol","abstract":[{"text":"The part-symbol element indicates how a symbol for a multi-staff part is indicated in the score.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/partSymbol"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/divisions":{"abstract":[{"type":"text","text":"Musical notation duration is commonly represented as fractions. The divisions element indicates how many"},{"type":"text","text":" "},{"type":"text","text":"divisions per quarter note are used to indicate a note’s duration. For example, if duration = 1 and divisions"},{"type":"text","text":" "},{"type":"text","text":"= 2, this is an eighth note duration. Duration and divisions are used directly for generating sound output, so"},{"type":"text","text":" "},{"type":"text","text":"they must be chosen to take tuplets into account. Using a divisions element lets us use just one number to"},{"type":"text","text":" "},{"type":"text","text":"represent a duration for each note in the score, while retaining the full power of a fractional"},{"type":"text","text":" "},{"type":"text","text":"representation. If maximum compatibility with Standard MIDI 1.0 files is important, do not have the divisions"},{"type":"text","text":" "},{"type":"text","text":"value exceed 16383."}],"title":"divisions","kind":"symbol","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"divisions","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLPositiveDivisions","preciseIdentifier":"s:7IvorMXL20MXLPositiveDivisionsV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlattributes\/divisions","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/divisions"},"doc://IvorMXL/SQ":{"type":"unresolvable","title":"Swift.Equatable","identifier":"doc:\/\/IvorMXL\/SQ"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/measureStyle":{"url":"\/documentation\/ivormxl\/mxlattributes\/measurestyle","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/measureStyle","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"measureStyle","kind":"identifier"},{"text":": [","kind":"text"},{"text":"MXLMeasureStyle","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL15MXLMeasureStyleV"},{"kind":"text","text":"]"}],"kind":"symbol","abstract":[{"type":"text","text":"A measure-style indicates a special way to print partial to multiple measures within a part. This includes"},{"type":"text","text":" "},{"type":"text","text":"multiple rests over several measures, repeats of beats, single, or multiple measures, and use of slash"},{"type":"text","text":" "},{"type":"text","text":"notation."}],"type":"topic","title":"measureStyle"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/key":{"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlattributes\/key","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"key"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"MXLKey","preciseIdentifier":"s:7IvorMXL6MXLKeyV"},{"kind":"text","text":"]"}],"title":"key","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/key","abstract":[{"type":"text","text":"The key element represents a key signature. Both traditional and non-traditional key signatures are supported."},{"type":"text","text":" "},{"type":"text","text":"The optional number attribute refers to staff numbers. If absent, the key signature applies to all staves in"},{"type":"text","text":" "},{"type":"text","text":"the part."}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/time":{"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlattributes\/time","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"time","kind":"identifier"},{"text":": [","kind":"text"},{"text":"MXLTime","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL7MXLTimeV"},{"text":"]","kind":"text"}],"title":"time","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/time","abstract":[{"type":"text","text":"Time signatures are represented by the beats element for the numerator and the beat-type element for the"},{"type":"text","text":" "},{"type":"text","text":"denominator."}],"role":"symbol"},"doc://IvorMXL/s9EscapableP":{"type":"unresolvable","title":"Swift.Escapable","identifier":"doc:\/\/IvorMXL\/s9EscapableP"},"doc://IvorMXL/s8CopyableP":{"type":"unresolvable","title":"Swift.Copyable","identifier":"doc:\/\/IvorMXL\/s8CopyableP"},"doc://IvorMXL/s8SendableP":{"type":"unresolvable","title":"Swift.Sendable","identifier":"doc:\/\/IvorMXL\/s8SendableP"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/directive-swift.property":{"url":"\/documentation\/ivormxl\/mxlattributes\/directive-swift.property","abstract":[{"type":"text","text":"Directives are like directions, but can be grouped together with attributes for convenience. This is typically"},{"type":"text","text":" "},{"type":"text","text":"used for tempo markings at the beginning of a piece of music. This element was deprecated in Version 2.0 in"},{"type":"text","text":" "},{"type":"text","text":"favor of the direction element’s directive attribute. Language names come from ISO 639, with optional country"},{"type":"text","text":" "},{"type":"text","text":"subcodes from ISO 3166."}],"title":"directive","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/directive-swift.property","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"directive","kind":"identifier"},{"text":": [","kind":"text"},{"text":"Directive","preciseIdentifier":"s:7IvorMXL13MXLAttributesV9DirectiveV","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/Content-swift.enum":{"navigatorTitle":[{"text":"Content","kind":"identifier"}],"abstract":[{"type":"text","text":"One of the alternatives for Attributes."}],"title":"MXLAttributes.Content","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/Content-swift.enum","kind":"symbol","url":"\/documentation\/ivormxl\/mxlattributes\/content-swift.enum","type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Content","kind":"identifier"}],"role":"symbol"},"doc://IvorMXL/s16SendableMetatypeP":{"type":"unresolvable","title":"Swift.SendableMetatype","identifier":"doc:\/\/IvorMXL\/s16SendableMetatypeP"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/instruments":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/instruments","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"instruments"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":"?"}],"role":"symbol","kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxlattributes\/instruments","title":"instruments","abstract":[{"type":"text","text":"The instruments element is only used if more than one instrument is represented in the part (e.g., oboe I and"},{"type":"text","text":" "},{"type":"text","text":"II where they play together most of the time). If absent, a value of 1 is assumed."}]},"doc://IvorMXL/documentation/IvorMXL/MXLMusicItem":{"abstract":[{"text":"One of the alternatives for a music item.","type":"text"}],"title":"MXLMusicItem","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLMusicItem"}],"navigatorTitle":[{"kind":"identifier","text":"MXLMusicItem"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlmusicitem","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMusicItem"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/footnote":{"url":"\/documentation\/ivormxl\/mxlattributes\/footnote","abstract":[{"type":"text","text":"The footnote element specifies editorial information that appears in footnotes in the printed score. It is"},{"type":"text","text":" "},{"type":"text","text":"defined within a group due to its multiple uses within the MusicXML schema."}],"kind":"symbol","title":"footnote","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/footnote","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"footnote","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL16MXLFormattedTextV","kind":"typeIdentifier","text":"MXLFormattedText"},{"text":"?","kind":"text"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection","title":"MXLDirection","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLDirection","kind":"identifier"}],"navigatorTitle":[{"text":"MXLDirection","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxldirection","abstract":[{"text":"A direction is a musical indication that is not necessarily attached to a specific note. Two or more may be","type":"text"},{"type":"text","text":" "},{"type":"text","text":"combined to indicate words followed by the start of a dashed line, the end of a wedge followed by dynamics,"},{"type":"text","text":" "},{"type":"text","text":"etc. For applications where a specific direction is indeed attached to a specific note, the direction element"},{"type":"text","text":" "},{"type":"text","text":"can be associated with the first note element that follows it in score order that is not in a different voice."}]},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/Equatable-Implementations":{"type":"topic","kind":"article","url":"\/documentation\/ivormxl\/mxlattributes\/equatable-implementations","title":"Equatable Implementations","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/Equatable-Implementations","abstract":[],"role":"collectionGroup"},"doc://IvorMXL/documentation/IvorMXL/MXLSound":{"abstract":[{"text":"The sound element contains general playback parameters. They can stand alone within a part\/measure, or be a","type":"text"},{"text":" ","type":"text"},{"text":"component element within a direction.","type":"text"}],"title":"MXLSound","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLSound"}],"navigatorTitle":[{"kind":"identifier","text":"MXLSound"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlsound","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes":{"abstract":[{"text":"The attributes element contains musical information that typically changes on measure boundaries. This","type":"text"},{"text":" ","type":"text"},{"text":"includes key and time signatures, clefs, transpositions, and staving. When attributes are changed mid-measure,","type":"text"},{"text":" ","type":"text"},{"text":"it affects the music in score order, not in MusicXML document order.","type":"text"}],"title":"MXLAttributes","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLAttributes"}],"navigatorTitle":[{"kind":"identifier","text":"MXLAttributes"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlattributes","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline":{"navigatorTitle":[{"text":"MXLBarline","kind":"identifier"}],"abstract":[{"text":"If a barline is other than a normal single barline, it should be represented by a barline type that describes","type":"text"},{"text":" ","type":"text"},{"text":"it. This includes information about repeats and multiple endings, as well as line style. Barline data is on","type":"text"},{"text":" ","type":"text"},{"text":"the same level as the other musical data in a score — a child of a measure in a partwise score, or a part in a","type":"text"},{"text":" ","type":"text"},{"text":"timewise score. This allows for barlines within measures, as in dotted barlines that subdivide measures in","type":"text"},{"text":" ","type":"text"},{"text":"complex meters. The two fermata elements allow for fermatas on both sides of the barline (the lower one","type":"text"},{"text":" ","type":"text"},{"text":"inverted).","type":"text"}],"title":"MXLBarline","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline","kind":"symbol","url":"\/documentation\/ivormxl\/mxlbarline","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLBarline","kind":"identifier"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/staffDetails":{"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlattributes\/staffdetails","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"staffDetails"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"MXLStaffDetails","preciseIdentifier":"s:7IvorMXL15MXLStaffDetailsV"},{"kind":"text","text":"]"}],"title":"staffDetails","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/staffDetails","abstract":[{"type":"text","text":"The staff-details element is used to indicate different types of staves."}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLFullNote":{"abstract":[{"text":"The full-note group is a sequence of the common note elements between cue\/grace notes and regular (full)","type":"text"},{"text":" ","type":"text"},{"text":"notes: pitch, chord, and rest information, but not duration (cue and grace notes do not have duration","type":"text"},{"text":" ","type":"text"},{"text":"encoded). Unpitched elements are used for unpitched percussion, speaking voice, and other musical elements","type":"text"},{"text":" ","type":"text"},{"text":"lacking determinate pitch.","type":"text"}],"title":"MXLFullNote","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFullNote"}],"navigatorTitle":[{"kind":"identifier","text":"MXLFullNote"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlfullnote","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFullNote"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/level":{"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlattributes\/level","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"level"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLLevel","preciseIdentifier":"s:7IvorMXL8MXLLevelV"},{"kind":"text","text":"?"}],"title":"level","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/level","abstract":[{"type":"text","text":"The level element specifies editorial information for different MusicXML elements. It is defined within a"},{"type":"text","text":" "},{"type":"text","text":"group due to its multiple uses within the MusicXML schema."}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLRest":{"kind":"symbol","navigatorTitle":[{"text":"MXLRest","kind":"identifier"}],"title":"MXLRest","url":"\/documentation\/ivormxl\/mxlrest","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLRest","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRest","abstract":[{"text":"The rest element indicates notated rests or silences. Rest elements are usually empty, but placement on the","type":"text"},{"text":" ","type":"text"},{"text":"staff can be specified using display-step and display-octave elements. If the measure attribute is set to yes,","type":"text"},{"text":" ","type":"text"},{"text":"this indicates this is a complete measure rest.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"navigatorTitle":[{"kind":"identifier","text":"MXLNote"}],"abstract":[{"text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for","type":"text"},{"text":" ","type":"text"},{"text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation).","type":"text"},{"text":" ","type":"text"},{"text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,","type":"text"},{"text":" ","type":"text"},{"text":"but no tie elements. Having these two types of information available can make interchange easier, as some","type":"text"},{"text":" ","type":"text"},{"text":"programs handle one type of information more readily than the other.","type":"text"}],"title":"MXLNote","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","kind":"symbol","url":"\/documentation\/ivormxl\/mxlnote","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNote"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/content-swift.property":{"url":"\/documentation\/ivormxl\/mxlattributes\/content-swift.property","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/content-swift.property","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"content"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Content","preciseIdentifier":"s:7IvorMXL13MXLAttributesV7ContentO"}],"title":"content","abstract":[{"type":"text","text":"One of the alternatives for Attributes."}],"type":"topic","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/init(footnote:level:divisions:key:time:staves:partSymbol:instruments:clef:staffDetails:content:directive:measureStyle:)":{"url":"\/documentation\/ivormxl\/mxlattributes\/init(footnote:level:divisions:key:time:staves:partsymbol:instruments:clef:staffdetails:content:directive:measurestyle:)","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/init(footnote:level:divisions:key:time:staves:partSymbol:instruments:clef:staffDetails:content:directive:measureStyle:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"footnote","kind":"externalPa