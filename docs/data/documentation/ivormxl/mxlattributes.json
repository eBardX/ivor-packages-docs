rnalParam","text":"instruments"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"clef"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"MXLClef","preciseIdentifier":"s:7IvorMXL7MXLClefV"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"staffDetails"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"MXLStaffDetails","preciseIdentifier":"s:7IvorMXL15MXLStaffDetailsV"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"content"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Content","preciseIdentifier":"s:7IvorMXL13MXLAttributesV7ContentO"},{"kind":"text","text":", "},{"kind":"externalParam","text":"directive"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"Directive","preciseIdentifier":"s:7IvorMXL13MXLAttributesV9DirectiveV"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"measureStyle"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"MXLMeasureStyle","preciseIdentifier":"s:7IvorMXL15MXLMeasureStyleV"},{"kind":"text","text":"])"}]},"doc://IvorMXL/s8CopyableP":{"title":"Swift.Copyable","identifier":"doc:\/\/IvorMXL\/s8CopyableP","type":"unresolvable"},"doc://IvorMXL/documentation/IvorMXL/MXLFullNote":{"title":"MXLFullNote","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFullNote"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlfullnote","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLFullNote"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFullNote","abstract":[{"text":"The full-note group is a sequence of the common note elements between cue\/grace notes and regular (full)","type":"text"},{"text":" ","type":"text"},{"text":"notes: pitch, chord, and rest information, but not duration (cue and grace notes do not have duration","type":"text"},{"text":" ","type":"text"},{"text":"encoded). Unpitched elements are used for unpitched percussion, speaking voice, and other musical elements","type":"text"},{"text":" ","type":"text"},{"text":"lacking determinate pitch.","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/staves":{"abstract":[{"text":"The staves element is used if there is more than one staff represented in the given part (e.g., 2 staves for","type":"text"},{"text":" ","type":"text"},{"text":"typical piano parts). If absent, a value of 1 is assumed. Staves are ordered from top to bottom in a part in","type":"text"},{"text":" ","type":"text"},{"text":"numerical order, with staff 1 above staff 2.","type":"text"}],"role":"symbol","kind":"symbol","title":"staves","url":"\/documentation\/ivormxl\/mxlattributes\/staves","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/staves","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"staves"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":"?"}]},"doc://IvorMXL/documentation/IvorMXL/MXLSound":{"type":"topic","title":"MXLSound","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound","abstract":[{"type":"text","text":"The sound element contains general playback parameters. They can stand alone within a part\/measure, or be a"},{"type":"text","text":" "},{"type":"text","text":"component element within a direction."}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSound","kind":"identifier"}],"navigatorTitle":[{"text":"MXLSound","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlsound"},"doc://IvorMXL/documentation/IvorMXL/MXLRest":{"title":"MXLRest","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLRest","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"MXLRest","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlrest","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRest","abstract":[{"type":"text","text":"The rest element indicates notated rests or silences. Rest elements are usually empty, but placement on the"},{"type":"text","text":" "},{"text":"staff can be specified using display-step and display-octave elements. If the measure attribute is set to yes,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"this indicates this is a complete measure rest."}],"type":"topic","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/footnote":{"type":"topic","role":"symbol","kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"footnote","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLFormattedText","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL16MXLFormattedTextV"},{"text":"?","kind":"text"}],"url":"\/documentation\/ivormxl\/mxlattributes\/footnote","abstract":[{"text":"The footnote element specifies editorial information that appears in footnotes in the printed score. It is","type":"text"},{"type":"text","text":" "},{"type":"text","text":"defined within a group due to its multiple uses within the MusicXML schema."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/footnote","title":"footnote"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection":{"type":"topic","title":"MXLDirection","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection","abstract":[{"type":"text","text":"A direction is a musical indication that is not necessarily attached to a specific note. Two or more may be"},{"type":"text","text":" "},{"type":"text","text":"combined to indicate words followed by the start of a dashed line, the end of a wedge followed by dynamics,"},{"type":"text","text":" "},{"type":"text","text":"etc. For applications where a specific direction is indeed attached to a specific note, the direction element"},{"type":"text","text":" "},{"type":"text","text":"can be associated with the first note element that follows it in score order that is not in a different voice."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLDirection"}],"navigatorTitle":[{"kind":"identifier","text":"MXLDirection"}],"url":"\/documentation\/ivormxl\/mxldirection"},"doc://IvorMXL/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","identifier":"doc:\/\/IvorMXL\/s16SendableMetatypeP","type":"unresolvable"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/Directive-swift.struct":{"type":"topic","title":"MXLAttributes.Directive","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/Directive-swift.struct","abstract":[{"text":"Directives are like directions, but can be grouped together with attributes for convenience. This is typically","type":"text"},{"text":" ","type":"text"},{"text":"used for tempo markings at the beginning of a piece of music. This element was deprecated in Version 2.0 in","type":"text"},{"text":" ","type":"text"},{"text":"favor of the direction element’s directive attribute. Language names come from ISO 639, with optional country","type":"text"},{"text":" ","type":"text"},{"text":"subcodes from ISO 3166.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Directive"}],"navigatorTitle":[{"kind":"identifier","text":"Directive"}],"url":"\/documentation\/ivormxl\/mxlattributes\/directive-swift.struct"},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNote","kind":"identifier"}],"title":"MXLNote","abstract":[{"text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for","type":"text"},{"text":" ","type":"text"},{"text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation).","type":"text"},{"text":" ","type":"text"},{"text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,","type":"text"},{"text":" ","type":"text"},{"text":"but no tie elements. Having these two types of information available can make interchange easier, as some","type":"text"},{"text":" ","type":"text"},{"text":"programs handle one type of information more readily than the other.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","role":"symbol","url":"\/documentation\/ivormxl\/mxlnote","kind":"symbol","navigatorTitle":[{"text":"MXLNote","kind":"identifier"}],"type":"topic"},"doc://IvorMXL/SH":{"title":"Swift.Hashable","identifier":"doc:\/\/IvorMXL\/SH","type":"unresolvable"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/key":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/key","url":"\/documentation\/ivormxl\/mxlattributes\/key","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"key"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL6MXLKeyV","text":"MXLKey"},{"kind":"text","text":"]"}],"title":"key","abstract":[{"text":"The key element represents a key signature. Both traditional and non-traditional key signatures are supported.","type":"text"},{"text":" ","type":"text"},{"text":"The optional number attribute refers to staff numbers. If absent, the key signature applies to all staves in","type":"text"},{"text":" ","type":"text"},{"text":"the part.","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/time":{"abstract":[{"type":"text","text":"Time signatures are represented by the beats element for the numerator and the beat-type element for the"},{"type":"text","text":" "},{"type":"text","text":"denominator."}],"type":"topic","role":"symbol","title":"time","kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"time","kind":"identifier"},{"text":": [","kind":"text"},{"text":"MXLTime","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL7MXLTimeV"},{"text":"]","kind":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/time","url":"\/documentation\/ivormxl\/mxlattributes\/time"},"doc://IvorMXL/documentation/IvorMXL/MXLPitch":{"title":"MXLPitch","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPitch","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlpitch","role":"symbol","navigatorTitle":[{"text":"MXLPitch","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPitch","abstract":[{"type":"text","text":"Pitch is represented as a combination of the step of the diatonic scale, the chromatic alteration, and the"},{"type":"text","text":" "},{"type":"text","text":"octave."}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/partSymbol":{"url":"\/documentation\/ivormxl\/mxlattributes\/partsymbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/partSymbol","kind":"symbol","type":"topic","role":"symbol","abstract":[{"type":"text","text":"The part-symbol element indicates how a symbol for a multi-staff part is indicated in the score."}],"title":"partSymbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"partSymbol","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLPartSymbol","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL13MXLPartSymbolV"},{"text":"?","kind":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/content-swift.property":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/content-swift.property","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"content"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL13MXLAttributesV7ContentO","kind":"typeIdentifier","text":"Content"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlattributes\/content-swift.property","abstract":[{"type":"text","text":"One of the alternatives for Attributes."}],"type":"topic","title":"content","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/level":{"abstract":[{"type":"text","text":"The level element specifies editorial information for different MusicXML elements. It is defined within a"},{"type":"text","text":" "},{"type":"text","text":"group due to its multiple uses within the MusicXML schema."}],"type":"topic","role":"symbol","title":"level","kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"level","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLLevel","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLLevelV"},{"text":"?","kind":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/level","url":"\/documentation\/ivormxl\/mxlattributes\/level"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/clef":{"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/clef","url":"\/documentation\/ivormxl\/mxlattributes\/clef","abstract":[{"text":"Clefs are represented by a combination of sign, line, and clef-octave-change elements.","type":"text"}],"kind":"symbol","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"clef","kind":"identifier"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:7IvorMXL7MXLClefV","text":"MXLClef","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"title":"clef"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/directive-swift.property":{"type":"topic","abstract":[{"text":"Directives are like directions, but can be grouped together with attributes for convenience. This is typically","type":"text"},{"text":" ","type":"text"},{"text":"used for tempo markings at the beginning of a piece of music. This element was deprecated in Version 2.0 in","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"favor of the direction element’s directive attribute. Language names come from ISO 639, with optional country"},{"type":"text","text":" "},{"type":"text","text":"subcodes from ISO 3166."}],"url":"\/documentation\/ivormxl\/mxlattributes\/directive-swift.property","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"directive"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL13MXLAttributesV9DirectiveV","text":"Directive"},{"kind":"text","text":"]"}],"kind":"symbol","title":"directive","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/directive-swift.property","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/measureStyle":{"abstract":[{"type":"text","text":"A measure-style indicates a special way to print partial to multiple measures within a part. This includes"},{"type":"text","text":" "},{"type":"text","text":"multiple rests over several measures, repeats of beats, single, or multiple measures, and use of slash"},{"type":"text","text":" "},{"type":"text","text":"notation."}],"type":"topic","role":"symbol","title":"measureStyle","kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"measureStyle","kind":"identifier"},{"text":": [","kind":"text"},{"text":"MXLMeasureStyle","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL15MXLMeasureStyleV"},{"text":"]","kind":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/measureStyle","url":"\/documentation\/ivormxl\/mxlattributes\/measurestyle"},"doc://IvorMXL/documentation/IvorMXL/MXLMusicItem":{"type":"topic","title":"MXLMusicItem","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMusicItem","abstract":[{"type":"text","text":"One of the alternatives for a music item."}],"role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLMusicItem","kind":"identifier"}],"navigatorTitle":[{"text":"MXLMusicItem","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlmusicitem"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/Content-swift.enum":{"title":"MXLAttributes.Content","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Content"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlattributes\/content-swift.enum","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Content"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/Content-swift.enum","abstract":[{"type":"text","text":"One of the alternatives for Attributes."}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/divisions":{"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"divisions"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL20MXLPositiveDivisionsV","text":"MXLPositiveDivisions"},{"kind":"text","text":"?"}],"abstract":[{"text":"Musical notation duration is commonly represented as fractions. The divisions element indicates how many","type":"text"},{"text":" ","type":"text"},{"text":"divisions per quarter note are used to indicate a note’s duration. For example, if duration = 1 and divisions","type":"text"},{"text":" ","type":"text"},{"text":"= 2, this is an eighth note duration. Duration and divisions are used directly for generating sound output, so","type":"text"},{"text":" ","type":"text"},{"text":"they must be chosen to take tuplets into account. Using a divisions element lets us use just one number to","type":"text"},{"text":" ","type":"text"},{"text":"represent a duration for each note in the score, while retaining the full power of a fractional","type":"text"},{"text":" ","type":"text"},{"text":"representation. If maximum compatibility with Standard MIDI 1.0 files is important, do not have the divisions","type":"text"},{"text":" ","type":"text"},{"text":"value exceed 16383.","type":"text"}],"role":"symbol","url":"\/documentation\/ivormxl\/mxlattributes\/divisions","type":"topic","kind":"symbol","title":"divisions","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/divisions"},"doc://IvorMXL/SQ":{"title":"Swift.Equatable","identifier":"doc:\/\/IvorMXL\/SQ","type":"unresolvable"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLBarline"}],"abstract":[{"text":"If a barline is other than a normal single barline, it should be represented by a barline type that describes","type":"text"},{"text":" ","type":"text"},{"text":"it. This includes information about repeats and multiple endings, as well as line style. Barline data is on","type":"text"},{"text":" ","type":"text"},{"text":"the same level as the other musical data in a score — a child of a measure in a partwise score, or a part in a","type":"text"},{"text":" ","type":"text"},{"text":"timewise score. This allows for barlines within measures, as in dotted barlines that subdivide measures in","type":"text"},{"text":" ","type":"text"},{"text":"complex meters. The two fermata elements allow for fermatas on both sides of the barline (the lower one","type":"text"},{"text":" ","type":"text"},{"text":"inverted).","type":"text"}],"title":"MXLBarline","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline","role":"symbol","url":"\/documentation\/ivormxl\/mxlbarline","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLBarline"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/Equatable-Implementations":{"abstract":[],"type":"topic","role":"collectionGroup","title":"Equatable Implementations","kind":"article","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/Equatable-Implementations","url":"\/documentation\/ivormxl\/mxlattributes\/equatable-implementations"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/instruments":{"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"instruments"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":"?"}],"url":"\/documentation\/ivormxl\/mxlattributes\/instruments","abstract":[{"type":"text","text":"The instruments element is only used if more than one instrument is represented in the part (e.g., oboe I and"},{"type":"text","text":" "},{"type":"text","text":"II where they play together most of the time). If absent, a value of 1 is assumed."}],"title":"instruments","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/instruments"},"doc://IvorMXL/s9EscapableP":{"title":"Swift.Escapable","identifier":"doc:\/\/IvorMXL\/s9EscapableP","type":"unresolvable"},"doc://IvorMXL/s8SendableP":{"title":"Swift.Sendable","identifier":"doc:\/\/IvorMXL\/s8SendableP","type":"unresolvable"}}}