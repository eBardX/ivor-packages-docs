{"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes","interfaceLanguage":"swift"},"sections":[],"topicSections":[{"title":"Structures","anchor":"Structures","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/Directive-swift.struct"],"generated":true},{"title":"Initializers","anchor":"Initializers","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/init(footnote:level:divisions:key:time:staves:partSymbol:instruments:clef:staffDetails:content:directive:measureStyle:)"],"generated":true},{"title":"Instance Properties","anchor":"Instance-Properties","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/clef","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/content-swift.property","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/directive-swift.property","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/divisions","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/footnote","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/instruments","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/key","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/level","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/measureStyle","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/partSymbol","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/staffDetails","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/staves","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/time"],"generated":true},{"title":"Enumerations","anchor":"Enumerations","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/Content-swift.enum"],"generated":true},{"title":"Default Implementations","anchor":"Default-Implementations","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/Equatable-Implementations"],"generated":true}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL"]]},"seeAlsoSections":[{"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMusicItem","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFullNote","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRest","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPitch","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound"],"anchor":"Music","generated":true,"title":"Music"}],"abstract":[{"text":"The attributes element contains musical information that typically changes on measure boundaries. This","type":"text"},{"text":" ","type":"text"},{"text":"includes key and time signatures, clefs, transpositions, and staving. When attributes are changed mid-measure,","type":"text"},{"text":" ","type":"text"},{"text":"it affects the music in score order, not in MusicXML document order.","type":"text"}],"metadata":{"symbolKind":"struct","roleHeading":"Structure","role":"symbol","title":"MXLAttributes","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLAttributes"}],"modules":[{"name":"IvorMXL"}],"navigatorTitle":[{"text":"MXLAttributes","kind":"identifier"}],"externalID":"s:7IvorMXL13MXLAttributesV"},"schemaVersion":{"minor":3,"major":0,"patch":0},"relationshipsSections":[{"identifiers":["doc:\/\/IvorMXL\/s8CopyableP","doc:\/\/IvorMXL\/SQ","doc:\/\/IvorMXL\/s9EscapableP","doc:\/\/IvorMXL\/SH","doc:\/\/IvorMXL\/s8SendableP","doc:\/\/IvorMXL\/s16SendableMetatypeP"],"kind":"relationships","title":"Conforms To","type":"conformsTo"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlattributes"]}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLAttributes"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"inlineContent":[{"type":"text","text":"Maps the MusicXML "},{"code":"<attributes>","type":"codeVoice"},{"text":" element.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","references":{"doc://IvorMXL/documentation/IvorMXL/MXLSound":{"abstract":[{"type":"text","text":"The sound element contains general playback parameters. They can stand alone within a part\/measure, or be a"},{"type":"text","text":" "},{"type":"text","text":"component element within a direction."}],"title":"MXLSound","url":"\/documentation\/ivormxl\/mxlsound","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSound","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"MXLSound","kind":"identifier"}],"type":"topic","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/partSymbol":{"abstract":[{"text":"The part-symbol element indicates how a symbol for a multi-staff part is indicated in the score.","type":"text"}],"title":"partSymbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/partSymbol","url":"\/documentation\/ivormxl\/mxlattributes\/partsymbol","kind":"symbol","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"partSymbol"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL13MXLPartSymbolV","text":"MXLPartSymbol"},{"kind":"text","text":"?"}]},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/clef":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/clef","type":"topic","abstract":[{"text":"Clefs are represented by a combination of sign, line, and clef-octave-change elements.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlattributes\/clef","role":"symbol","title":"clef","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"clef","kind":"identifier"},{"text":": [","kind":"text"},{"kind":"typeIdentifier","text":"MXLClef","preciseIdentifier":"s:7IvorMXL7MXLClefV"},{"kind":"text","text":"]"}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection":{"role":"symbol","url":"\/documentation\/ivormxl\/mxldirection","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLDirection","kind":"identifier"}],"navigatorTitle":[{"text":"MXLDirection","kind":"identifier"}],"abstract":[{"text":"A direction is a musical indication that is not necessarily attached to a specific note. Two or more may be","type":"text"},{"text":" ","type":"text"},{"text":"combined to indicate words followed by the start of a dashed line, the end of a wedge followed by dynamics,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"etc. For applications where a specific direction is indeed attached to a specific note, the direction element"},{"text":" ","type":"text"},{"type":"text","text":"can be associated with the first note element that follows it in score order that is not in a different voice."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection","title":"MXLDirection","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLBarline"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLBarline"}],"title":"MXLBarline","abstract":[{"type":"text","text":"If a barline is other than a normal single barline, it should be represented by a barline type that describes"},{"type":"text","text":" "},{"type":"text","text":"it. This includes information about repeats and multiple endings, as well as line style. Barline data is on"},{"type":"text","text":" "},{"type":"text","text":"the same level as the other musical data in a score — a child of a measure in a partwise score, or a part in a"},{"type":"text","text":" "},{"type":"text","text":"timewise score. This allows for barlines within measures, as in dotted barlines that subdivide measures in"},{"type":"text","text":" "},{"type":"text","text":"complex meters. The two fermata elements allow for fermatas on both sides of the barline (the lower one"},{"type":"text","text":" "},{"type":"text","text":"inverted)."}],"url":"\/documentation\/ivormxl\/mxlbarline"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/key":{"title":"key","url":"\/documentation\/ivormxl\/mxlattributes\/key","abstract":[{"type":"text","text":"The key element represents a key signature. Both traditional and non-traditional key signatures are supported."},{"type":"text","text":" "},{"type":"text","text":"The optional number attribute refers to staff numbers. If absent, the key signature applies to all staves in"},{"type":"text","text":" "},{"type":"text","text":"the part."}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"key","kind":"identifier"},{"text":": [","kind":"text"},{"text":"MXLKey","preciseIdentifier":"s:7IvorMXL6MXLKeyV","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"kind":"symbol","type":"topic","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/key"},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlnote","title":"MXLNote","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNote","kind":"identifier"}],"navigatorTitle":[{"text":"MXLNote","kind":"identifier"}],"abstract":[{"type":"text","text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for"},{"type":"text","text":" "},{"type":"text","text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation)."},{"type":"text","text":" "},{"type":"text","text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,"},{"type":"text","text":" "},{"text":"but no tie elements. Having these two types of information available can make interchange easier, as some","type":"text"},{"type":"text","text":" "},{"type":"text","text":"programs handle one type of information more readily than the other."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/init(footnote:level:divisions:key:time:staves:partSymbol:instruments:clef:staffDetails:content:directive:measureStyle:)":{"kind":"symbol","title":"init(footnote:level:divisions:key:time:staves:partSymbol:instruments:clef:staffDetails:content:directive:measureStyle:)","url":"\/documentation\/ivormxl\/mxlattributes\/init(footnote:level:divisions:key:time:staves:partsymbol:instruments:clef:staffdetails:content:directive:measurestyle:)","role":"symbol","abstract":[{"text":"Creates a new ","type":"text"},{"code":"MXLAttributes","type":"codeVoice"},{"text":".","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/init(footnote:level:divisions:key:time:staves:partSymbol:instruments:clef:staffDetails:content:directive:measureStyle:)","type":"topic","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"footnote","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLFormattedText","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL16MXLFormattedTextV"},{"text":"?, ","kind":"text"},{"text":"level","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLLevel","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLLevelV"},{"text":"?, ","kind":"text"},{"text":"divisions","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLPositiveDivisions","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL20MXLPositiveDivisionsV"},{"text":"?, ","kind":"text"},{"text":"key","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"MXLKey","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL6MXLKeyV"},{"text":"], ","kind":"text"},{"text":"time","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"MXLTime","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL7MXLTimeV"},{"text":"], ","kind":"text"},{"text":"staves","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":"?, ","kind":"text"},{"text":"partSymbol","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLPartSymbol","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL13MXLPartSymbolV"},{"text":"?, ","kind":"text"},{"text":"instruments","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":"?, ","kind":"text"},{"text":"clef","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"MXLClef","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL7MXLClefV"},{"text":"], ","kind":"text"},{"text":"staffDetails","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"MXLStaffDetails","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL15MXLStaffDetailsV"},{"text":"], ","kind":"text"},{"text":"content","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Content","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL13MXLAttributesV7ContentO"},{"text":", ","kind":"text"},{"text":"directive","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"Directive","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL13MXLAttributesV9DirectiveV"},{"text":"], ","kind":"text"},{"text":"measureStyle","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"MXLMeasureStyle","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL15MXLMeasureStyleV"},{"text":"])","kind":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/staffDetails":{"abstract":[{"text":"The staff-details element is used to indicate different types of staves.","type":"text"}],"title":"staffDetails","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/staffDetails","url":"\/documentation\/ivormxl\/mxlattributes\/staffdetails","kind":"symbol","role":"symbol","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"staffDetails","kind":"identifier"},{"kind":"text","text":": ["},{"text":"MXLStaffDetails","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL15MXLStaffDetailsV"},{"text":"]","kind":"text"}]},"doc://IvorMXL/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","type":"unresolvable","identifier":"doc:\/\/IvorMXL\/s16SendableMetatypeP"},"doc://IvorMXL/documentation/IvorMXL/MXLFullNote":{"url":"\/documentation\/ivormxl\/mxlfullnote","role":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFullNote","abstract":[{"type":"text","text":"The full-note group is a sequence of the common note elements between cue\/grace notes and regular (full)"},{"type":"text","text":" "},{"type":"text","text":"notes: pitch, chord, and rest information, but not duration (cue and grace notes do not have duration"},{"type":"text","text":" "},{"type":"text","text":"encoded). Unpitched elements are used for unpitched percussion, speaking voice, and other musical elements"},{"type":"text","text":" "},{"type":"text","text":"lacking determinate pitch."}],"title":"MXLFullNote","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLFullNote","kind":"identifier"}],"navigatorTitle":[{"text":"MXLFullNote","kind":"identifier"}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/Directive-swift.struct":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Directive","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/Directive-swift.struct","navigatorTitle":[{"text":"Directive","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlattributes\/directive-swift.struct","abstract":[{"type":"text","text":"Directives are like directions, but can be grouped together with attributes for convenience. This is typically"},{"type":"text","text":" "},{"type":"text","text":"used for tempo markings at the beginning of a piece of music. This element was deprecated in Version 2.0 in"},{"type":"text","text":" "},{"type":"text","text":"favor of the direction element’s directive attribute. Language names come from ISO 639, with optional country"},{"type":"text","text":" "},{"type":"text","text":"subcodes from ISO 3166."}],"type":"topic","title":"MXLAttributes.Directive","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/s9EscapableP":{"identifier":"doc:\/\/IvorMXL\/s9EscapableP","type":"unresolvable","title":"Swift.Escapable"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/instruments":{"abstract":[{"text":"The instruments element is only used if more than one instrument is represented in the part (e.g., oboe I and","type":"text"},{"text":" ","type":"text"},{"text":"II where they play together most of the time). If absent, a value of 1 is assumed.","type":"text"}],"title":"instruments","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/instruments","url":"\/documentation\/ivormxl\/mxlattributes\/instruments","kind":"symbol","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"instruments"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":"?","kind":"text"}]},"doc://IvorMXL/s8CopyableP":{"identifier":"doc:\/\/IvorMXL\/s8CopyableP","type":"unresolvable","title":"Swift.Copyable"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/measureStyle":{"abstract":[{"type":"text","text":"A measure-style indicates a special way to print partial to multiple measures within a part. This includes"},{"type":"text","text":" "},{"type":"text","text":"multiple rests over several measures, repeats of beats, single, or multiple measures, and use of slash"},{"type":"text","text":" "},{"type":"text","text":"notation."}],"url":"\/documentation\/ivormxl\/mxlattributes\/measurestyle","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"measureStyle","kind":"identifier"},{"text":": [","kind":"text"},{"text":"MXLMeasureStyle","preciseIdentifier":"s:7IvorMXL15MXLMeasureStyleV","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"type":"topic","role":"symbol","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/measureStyle","title":"measureStyle"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/time":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlattributes\/time","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"time","kind":"identifier"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:7IvorMXL7MXLTimeV","text":"MXLTime","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"abstract":[{"text":"Time signatures are represented by the beats element for the numerator and the beat-type element for the","type":"text"},{"text":" ","type":"text"},{"text":"denominator.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/time","title":"time","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/divisions":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/divisions","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"divisions"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL20MXLPositiveDivisionsV","text":"MXLPositiveDivisions"},{"kind":"text","text":"?"}],"url":"\/documentation\/ivormxl\/mxlattributes\/divisions","role":"symbol","type":"topic","abstract":[{"type":"text","text":"Musical notation duration is commonly represented as fractions. The divisions element indicates how many"},{"type":"text","text":" "},{"type":"text","text":"divisions per quarter note are used to indicate a note’s duration. For example, if duration = 1 and divisions"},{"type":"text","text":" "},{"type":"text","text":"= 2, this is an eighth note duration. Duration and divisions are used directly for generating sound output, so"},{"type":"text","text":" "},{"type":"text","text":"they must be chosen to take tuplets into account. Using a divisions element lets us use just one number to"},{"type":"text","text":" "},{"type":"text","text":"represent a duration for each note in the score, while retaining the full power of a fractional"},{"type":"text","text":" "},{"type":"text","text":"representation. If maximum compatibility with Standard MIDI 1.0 files is important, do not have the divisions"},{"type":"text","text":" "},{"type":"text","text":"value exceed 16383."}],"kind":"symbol","title":"divisions"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/staves":{"abstract":[{"text":"The staves element is used if there is more than one staff represented in the given part (e.g., 2 staves for","type":"text"},{"text":" ","type":"text"},{"text":"typical piano parts). If absent, a value of 1 is assumed. Staves are ordered from top to bottom in a part in","type":"text"},{"text":" ","type":"text"},{"text":"numerical order, with staff 1 above staff 2.","type":"text"}],"title":"staves","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/staves","url":"\/documentation\/ivormxl\/mxlattributes\/staves","kind":"symbol","role":"symbol","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"staves","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":"?","kind":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLMusicItem":{"navigatorTitle":[{"text":"MXLMusicItem","kind":"identifier"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLMusicItem","kind":"identifier"}],"abstract":[{"type":"text","text":"One of the alternatives for a music item."}],"role":"symbol","url":"\/documentation\/ivormxl\/mxlmusicitem","type":"topic","title":"MXLMusicItem","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMusicItem","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/footnote":{"abstract":[{"text":"The footnote element specifies editorial information that appears in footnotes in the printed score. It is","type":"text"},{"text":" ","type":"text"},{"text":"defined within a group due to its multiple uses within the MusicXML schema.","type":"text"}],"title":"footnote","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/footnote","url":"\/documentation\/ivormxl\/mxlattributes\/footnote","kind":"symbol","role":"symbol","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"footnote","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLFormattedText","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL16MXLFormattedTextV"},{"text":"?","kind":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLRest":{"url":"\/documentation\/ivormxl\/mxlrest","role":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRest","abstract":[{"type":"text","text":"The rest element indicates notated rests or silences. Rest elements are usually empty, but placement on the"},{"type":"text","text":" "},{"type":"text","text":"staff can be specified using display-step and display-octave elements. If the measure attribute is set to yes,"},{"type":"text","text":" "},{"type":"text","text":"this indicates this is a complete measure rest."}],"title":"MXLRest","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLRest","kind":"identifier"}],"navigatorTitle":[{"text":"MXLRest","kind":"identifier"}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLPitch":{"navigatorTitle":[{"text":"MXLPitch","kind":"identifier"}],"title":"MXLPitch","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPitch","type":"topic","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPitch","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlpitch","abstract":[{"text":"Pitch is represented as a combination of the step of the diatonic scale, the chromatic alteration, and the","type":"text"},{"text":" ","type":"text"},{"text":"octave.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/level":{"title":"level","abstract":[{"type":"text","text":"The level element specifies editorial information for different MusicXML elements. It is defined within a"},{"type":"text","text":" "},{"type":"text","text":"group due to its multiple uses within the MusicXML schema."}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlattributes\/level","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"level","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLLevel","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLLevelV"},{"text":"?","kind":"text"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/level"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/Equatable-Implementations":{"abstract":[],"title":"Equatable Implementations","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/Equatable-Implementations","url":"\/documentation\/ivormxl\/mxlattributes\/equatable-implementations","kind":"article","role":"collectionGroup","type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes":{"title":"MXLAttributes","url":"\/documentation\/ivormxl\/mxlattributes","abstract":[{"type":"text","text":"The attributes element contains musical information that typically changes on measure boundaries. This"},{"type":"text","text":" "},{"type":"text","text":"includes key and time signatures, clefs, transpositions, and staving. When attributes are changed mid-measure,"},{"type":"text","text":" "},{"type":"text","text":"it affects the music in score order, not in MusicXML document order."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLAttributes","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"MXLAttributes","kind":"identifier"}],"type":"topic","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/Content-swift.enum":{"abstract":[{"type":"text","text":"One of the alternatives for Attributes."}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Content","kind":"identifier"}],"title":"MXLAttributes.Content","role":"symbol","type":"topic","navigatorTitle":[{"text":"Content","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlattributes\/content-swift.enum","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/Content-swift.enum"},"doc://IvorMXL/SQ":{"identifier":"doc:\/\/IvorMXL\/SQ","type":"unresolvable","title":"Swift.Equatable"},"doc://IvorMXL/SH":{"identifier":"doc:\/\/IvorMXL\/SH","type":"unresolvable","title":"Swift.Hashable"},"doc://IvorMXL/s8SendableP":{"identifier":"doc:\/\/IvorMXL\/s8SendableP","type":"unresolvable","title":"Swift.Sendable"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/content-swift.property":{"abstract":[{"text":"One of the alternatives for Attributes.","type":"text"}],"title":"content","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/content-swift.property","url":"\/documentation\/ivormxl\/mxlattributes\/content-swift.property","kind":"symbol","role":"symbol","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"content","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Content","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL13MXLAttributesV7ContentO"}]},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/directive-swift.property":{"abstract":[{"text":"Directives are like directions, but can be grouped together with attributes for convenience. This is typically","type":"text"},{"text":" ","type":"text"},{"text":"used for tempo markings at the beginning of a piece of music. This element was deprecated in Version 2.0 in","type":"text"},{"text":" ","type":"text"},{"text":"favor of the direction element’s directive attribute. Language names come from ISO 639, with optional country","type":"text"},{"text":" ","type":"text"},{"text":"subcodes from ISO 3166.","type":"text"}],"title":"directive","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/directive-swift.property","url":"\/documentation\/ivormxl\/mxlattributes\/directive-swift.property","kind":"symbol","role":"symbol","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"directive","kind":"identifier"},{"text":": [","kind":"text"},{"text":"Directive","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL13MXLAttributesV9DirectiveV"},{"text":"]","kind":"text"}]}}}