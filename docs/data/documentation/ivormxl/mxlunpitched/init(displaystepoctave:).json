ext","text":" "},{"type":"text","text":"use an unpitched element rather than a pitch element."}],"navigatorTitle":[{"kind":"identifier","text":"MXLUnpitched"}],"url":"\/documentation\/ivormxl\/mxlunpitched"},"doc://IvorMXL/documentation/IvorMXL/MXLDisplayStepOctave":{"role":"symbol","url":"\/documentation\/ivormxl\/mxldisplaystepoctave","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDisplayStepOctave","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLDisplayStepOctave"}],"abstract":[{"type":"text","text":"The display-step-octave group contains the sequence of elements used by both the rest and unpitched elements."},{"type":"text","text":" "},{"type":"text","text":"This group is used to place rests and unpitched elements on the staff without implying that these elements"},{"type":"text","text":" "},{"type":"text","text":"have pitch. Positioning follows the current clef. If percussion clef is used, the display-step and display-"},{"type":"text","text":" "},{"type":"text","text":"octave elements are interpreted as if in treble clef, with a G in octave 4 on line 2."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLDisplayStepOctave"}],"title":"MXLDisplayStepOctave"}}}