{"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"type":"text","text":"The display-step-octave group contains the sequence of elements used by both the rest and unpitched elements."},{"text":" ","type":"text"},{"text":"This group is used to place rests and unpitched elements on the staff without implying that these elements","type":"text"},{"text":" ","type":"text"},{"text":"have pitch. Positioning follows the current clef. If percussion clef is used, the display-step and display-","type":"text"},{"text":" ","type":"text"},{"text":"octave elements are interpreted as if in treble clef, with a G in octave 4 on line 2.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLUnpitched\/displayStepOctave"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLUnpitched"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlunpitched\/displaystepoctave"]}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"displayStepOctave"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDisplayStepOctave","preciseIdentifier":"s:7IvorMXL20MXLDisplayStepOctaveV","text":"MXLDisplayStepOctave"},{"kind":"text","text":"?"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Maps to nested MusicXML "},{"type":"codeVoice","code":"<display-step>"},{"type":"text","text":" and "},{"type":"codeVoice","code":"<display-octave>"},{"type":"text","text":" elements."}]}]}],"metadata":{"modules":[{"name":"IvorMXL"}],"externalID":"s:7IvorMXL12MXLUnpitchedV17displayStepOctaveAA010MXLDisplayeF0VSgvp","symbolKind":"prope