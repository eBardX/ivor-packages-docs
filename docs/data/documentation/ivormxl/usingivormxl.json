{"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL"]]},"sections":[],"abstract":[{"text":"Take a MusicXML document from bytes to a validated, round-trippable syntax","type":"text"},{"type":"text","text":" "},{"type":"text","text":"tree."}],"variants":[{"paths":["\/documentation\/ivormxl\/usingivormxl"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"inlineContent":[{"text":"IvorMXL exposes four processing types. Each is a ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":" value type","type":"text"},{"text":" ","type":"text"},{"text":"with a no-argument initializer and a single primary method:","type":"text"}],"type":"paragraph"},{"alignments":["left","left","left"],"type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Type"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Method","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Result"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLParser"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"parse(_:compressed:)"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"(MXLDocument, [MXLParser.Diagnostic])"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNormalizer"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"normalize(_:)"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"(MXLDocument, [MXLNormalizer.Change])"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValidator"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"validate(_:)"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"(MXLDocument, [MXLValidator.Issue])"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFormatter"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"format(_:compressed:)"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Data"}]}]]],"header":"row"},{"inlineContent":[{"type":"text","text":"An "},{"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDocument","isActive":true},{"type":"text","text":" carries two Boolean state flags that enforce the order of"},{"type":"text","text":" "},{"type":"text","text":"the pipeline:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":"isNormalized","type":"codeVoice"}],"type":"strong"},{"text":" — ","type":"text"},{"code":"validate(_:)","type":"codeVoice"},{"text":" throws unless this is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":"isValidated","type":"codeVoice"}],"type":"strong"},{"text":" — ","type":"text"},{"code":"format(_:compressed:)","type":"codeVoice"},{"text":" throws unless this is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":".","type":"text"}]}]}]},{"inlineContent":[{"type":"text","text":"So the canonical order is "},{"type":"strong","inlineContent":[{"type":"text","text":"parse → normalize → validate → format"}]},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let (parsed, diagnostics) = try MXLParser().parse(data, compressed: false)","let (normalized, changes) = MXLNormalizer().normalize(parsed)","let (validated, issues)   = try MXLValidator().validate(normalized)","","guard issues.isEmpty","else { \/* handle issues *\/ return }","","let xml = try MXLFormatter().format(validated, compressed: false)"]},{"inlineContent":[{"type":"text","text":"Both "},{"type":"codeVoice","code":"normalize(_:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"validate(_:)"},{"type":"text","text":" are idempotent — calling them on a"},{"type":"text","text":" "},{"text":"document that is already normalized or validated returns it unchanged — so it","type":"text"},{"text":" ","type":"text"},{"text":"is always safe to run the full pipeline.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"MusicXML files come in two physical encodings: an uncompressed XML document and","type":"text"},{"text":" ","type":"text"},{"text":"a compressed ","type":"text"},{"code":".mxl","type":"codeVoice"},{"text":" ZIP archive that wraps a ","type":"text"},{"code":"META-INF\/container.xml","type":"codeVoice"},{"text":" pointing","type":"text"},{"text":" ","type":"text"},{"text":"at the root score. The ","type":"text"},{"code":"compressed:","type":"codeVoice"},{"text":" argument on ","type":"text"},{"type":"codeVoice","code":"parse(_:compressed:)"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"format(_:compressed:)"},{"type":"text","text":" selects between them; the rest of the pipeline is"},{"type":"text","text":" "},{"text":"encoding-agnostic.","type":"text"}],"type":"paragraph"},{"anchor":"Parsing","type":"heading","text":"Parsing","level":2},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLParser","type":"reference"},{"type":"text","text":" decodes "},{"type":"codeVoice","code":"Data"},{"type":"text","text":" into an "},{"isActive":true,"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDocument","type":"reference"},{"type":"text","text":":"}]},{"type":"codeListing","code":["let (document, diagnostics) = try MXLParser().parse(data, compressed: false)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A MusicXML root file may have three document elements — a part-wise score, a"},{"type":"text","text":" "},{"type":"text","text":"time-wise score, or an "},{"type":"codeVoice","code":"<opus>"},{"type":"text","text":" — so "},{"isActive":true,"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDocument\/Content-swift.enum","type":"reference"},{"type":"text","text":" is an enum over all"},{"type":"text","text":" "},{"type":"text","text":"three. Most documents are a part-wise "},{"isActive":true,"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePartwise","type":"reference"},{"type":"text","text":". An MXL"},{"type":"text","text":" "},{"type":"codeVoice","code":"<container>"},{"type":"text","text":" is an archive implementation detail rather than a document, so a"},{"type":"text","text":" "},{"type":"text","text":"bare "},{"type":"codeVoice","code":"container.xml"},{"type":"text","text":" is rejected as an unexpected root element."}]},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLParser\/Diagnostic","type":"reference"},{"type":"text","text":" reports things the parser accepted but had to adjust"},{"type":"text","text":" "},{"type":"text","text":"or work around — a "},{"type":"codeVoice","code":"version"},{"type":"text","text":" attribute it had to default or repair"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"defaultedVersion"},{"type":"text","text":", "},{"type":"codeVoice","code":"malformedVersion(_:)"},{"type":"text","text":"), an element or attribute the"},{"type":"text","text":" "},{"type":"text","text":"schema deprecated ("},{"type":"codeVoice","code":"deprecatedElement(_:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"deprecatedAttribute(_:)"},{"type":"text","text":"), or one"},{"type":"text","text":" "},{"type":"text","text":"it did not recognize and skipped ("},{"type":"codeVoice","code":"ignoredElement(_:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"ignoredAttribute(_:)"},{"type":"text","text":"). Diagnostics are always returned, never thrown; each"},{"type":"text","text":" "},{"type":"text","text":"has a human-readable "},{"type":"codeVoice","code":"message"},{"type":"text","text":":"}]},{"type":"codeListing","code":["for diagnostic in diagnostics {","    print(diagnostic.message)","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Unrecoverable problems are thrown as an "},{"isActive":true,"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLParser\/Error","type":"reference"},{"type":"text","text":" — a malformed ZIP"},{"type":"text","text":" "},{"type":"text","text":"container ("},{"type":"codeVoice","code":"noRootFileFound"},{"type":"text","text":", "},{"type":"codeVoice","code":"invalidRootFileMediaType(_:)"},{"type":"text","text":") or an XML body"},{"type":"text","text":" "},{"type":"text","text":"that will not parse at all ("},{"type":"codeVoice","code":"parseFailure(_:)"},{"type":"text","text":"). Like all IvorMXL errors"},{"type":"text","text":" "},{"type":"text","text":"it conforms to "},{"type":"codeVoice","code":"EnhancedError"},{"type":"text","text":" and provides a "},{"type":"codeVoice","code":"message"},{"type":"text","text":":"}]},{"type":"codeListing","code":["do {","    let (document, _) = try MXLParser().parse(data, compressed: true)","} catch let error as MXLParser.Error {","    print(error.message)","}"],"syntax":"swift"},{"type":"heading","text":"Normalizing","level":2,"anchor":"Normalizing"},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNormalizer","type":"reference"},{"type":"text","text":" migrates a document to the most recent supported MusicXML"},{"type":"text","text":" "},{"type":"text","text":"version, returning a new document whose "},{"type":"codeVoice","code":"isNormalized"},{"type":"text","text":" flag is "},{"type":"codeVoice","code":"true"},{"type":"text","text":", together"},{"type":"text","text":" "},{"type":"text","text":"with a list of the changes it applied:"}]},{"type":"codeListing","code":["let (normalized, changes) = MXLNormalizer().normalize(parsed)","","for change in changes {","    print(change.message)","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDocument\/Version","type":"reference"},{"type":"text","text":" lists all six supported versions (1.0 through 4.0);"},{"type":"text","text":" "},{"type":"codeVoice","code":".current"},{"type":"text","text":" is the migration target. A part-wise score enters an ordered chain"},{"type":"text","text":" "},{"type":"text","text":"of per-version passes at its declared version and is stamped with the current"},{"type":"text","text":" "},{"type":"text","text":"version on the way out. The passes are "},{"inlineContent":[{"text":"derived by diffing the six vendored","type":"text"},{"text":" ","type":"text"},{"text":"schemas","type":"text"}],"type":"strong"},{"type":"text","text":" rather than written from memory — the 1.0 and 1.1 DTDs and the 2.0–4.0"},{"type":"text","text":" "},{"type":"text","text":"XSDs — and applied as an additive record of deprecations. Each"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNormalizer\/Change","type":"reference"},{"type":"text","text":" case names what moved: "},{"type":"codeVoice","code":"upgradedVersion(_:_:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"renamedElement(_:_:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"replacedConstruct(_:_:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"suppliedDefault(_:_:)"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"codeVoice","code":"convertedToPartwise"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"inlineContent":[{"text":"time-wise score is converted to part-wise","type":"text"}],"type":"strong"},{"type":"text","text":" as its first migration step —"},{"type":"text","text":" "},{"type":"text","text":"the two encodings are isomorphic in musical content — so a normalized document"},{"type":"text","text":" "},{"type":"text","text":"is never time-wise. An opus has no migration passes — the opus schema has never"},{"type":"text","text":" "},{"type":"text","text":"changed structurally — but it does take the same closing version stamp, applied"},{"type":"text","text":" "},{"type":"text","text":"at every level of nesting. Because a content-changing normalization can"},{"type":"text","text":" "},{"type":"text","text":"invalidate a prior validation, normalizing clears "},{"type":"codeVoice","code":"isValidated"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"IvorMXL has "},{"inlineContent":[{"text":"no born-normalized fast path","type":"text"}],"type":"strong"},{"type":"text","text":": the parser never pre-sets"},{"type":"text","text":" "},{"type":"codeVoice","code":"isNormalized"},{"type":"text","text":", so every document goes through the normalizer at least once."},{"type":"text","text":" "},{"type":"text","text":"Detecting an already-canonical document would mean proving no migration-triggering"},{"type":"text","text":" "},{"type":"text","text":"construct appears anywhere in it — the declared "},{"type":"codeVoice","code":"version"},{"type":"text","text":" is asserted by the file,"},{"type":"text","text":" "},{"type":"text","text":"never verified, so a document may claim "},{"type":"codeVoice","code":"4.0"},{"type":"text","text":" and still contain a 2.0-era"},{"type":"text","text":" "},{"type":"text","text":"deprecated element. Over-reporting is harmless (a pass that makes no changes)"},{"type":"text","text":" "},{"type":"text","text":"while under-reporting silently skips a migration, so the check would have to be"},{"type":"text","text":" "},{"type":"text","text":"exhaustive to be safe — which costs more than the pass it would skip."}]},{"type":"heading","text":"Validating","level":2,"anchor":"Validating"},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValidator","type":"reference"},{"type":"text","text":" checks a "},{"inlineContent":[{"text":"normalized","type":"text"}],"type":"strong"},{"type":"text","text":" score:"}]},{"type":"codeListing","code":["let (validated, issues) = try MXLValidator().validate(normalized)","","if issues.isEmpty {","    \/\/ `validated.isValidated` is now true.","} else {","    issues.forEach { print($0.message) }","}"],"syntax":"swift"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"If the document has not been normalized, "},{"type":"codeVoice","code":"validate(_:)"},{"type":"text","text":" throws"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValidator\/Error\/notNormalized","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"An opus passes straight through, marked validated with no issues: its schema"},{"type":"text","text":" "},{"type":"text","text":"is four elements and the parser already enforces nearly everything they"},{"type":"text","text":" "},{"type":"text","text":"constrain, so there is nothing left to check."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"If any issues are found, the returned document is the "},{"type":"strong","inlineContent":[{"text":"input unchanged","type":"text"}]},{"type":"text","text":" "},{"type":"text","text":"(its "},{"type":"codeVoice","code":"isValidated"},{"text":" flag stays ","type":"text"},{"type":"codeVoice","code":"false"},{"text":"). Fix the issues and validate again.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Only when the issues array is empty does the returned document have"},{"type":"text","text":" "},{"type":"codeVoice","code":"isValidated == true"},{"type":"text","text":" — the prerequisite for formatting and resolving."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"A time-wise score is validated in its part-wise encoding. The","type":"text"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValidator\/Issue","type":"reference"},{"text":" catalogue covers the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"cross-references the schema cannot express on its own: an "},{"code":"<part>","type":"codeVoice"},{"type":"text","text":" whose "},{"code":"id","type":"codeVoice"},{"text":" ","type":"text"},{"type":"text","text":"names no "},{"code":"<score-part>","type":"codeVoice"},{"text":" (","type":"text"},{"code":"danglingPartID(_:)","type":"codeVoice"},{"text":"), a ","type":"text"},{"code":"<score-part>","type":"codeVoice"},{"text":" no ","type":"text"},{"code":"<part>","type":"codeVoice"},{"text":" ","type":"text"},{"text":"realizes (","type":"text"},{"code":"unusedScorePart(_:)","type":"codeVoice"},{"text":"), a durational element before the first","type":"text"},{"text":" ","type":"text"},{"code":"<divisions>","type":"codeVoice"},{"text":" (","type":"text"},{"code":"durationBeforeDivisions(part:measure:)","type":"codeVoice"},{"text":"), an unmatched","type":"text"},{"text":" ","type":"text"},{"code":"<ending>","type":"codeVoice"},{"text":" (","type":"text"},{"code":"unpairedEnding(number:part:measure:)","type":"codeVoice"},{"text":"), an unbalanced","type":"text"},{"text":" ","type":"text"},{"code":"<part-group>","type":"codeVoice"},{"text":" (","type":"text"},{"code":"unbalancedPartGroup(number:)","type":"codeVoice"},{"text":"), and an ","type":"text"},{"code":"<instrument-sound>","type":"codeVoice"},{"text":" ","type":"text"},{"text":"that is not one of the 894 standard sounds defined by MusicXML 4.0","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"unknownInstrumentSound(_:)","type":"codeVoice"},{"text":").","type":"text"}]},{"type":"heading","text":"Formatting","level":2,"anchor":"Formatting"},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFormatter","type":"reference"},{"text":" serializes a ","type":"text"},{"inlineContent":[{"type":"text","text":"validated"}],"type":"strong"},{"text":" score back to MusicXML ","type":"text"},{"code":"Data","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"optionally as a compressed ","type":"text"},{"code":".mxl","type":"codeVoice"},{"text":" archive:","type":"text"}]},{"type":"codeListing","code":["let xml = try MXLFormatter().format(validated, compressed: false)","let mxl = try MXLFormatter().format(validated, compressed: true)"],"syntax":"swift"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"If the document has not been validated, ","type":"text"},{"code":"format(_:compressed:)","type":"codeVoice"},{"text":" throws","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFormatter\/Error\/notValidated","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The formatter writes ","type":"text"},{"inlineContent":[{"type":"text","text":"part-wise scores and opus documents"}],"type":"strong"},{"text":" — both are","type":"text"},{"text":" ","type":"text"},{"text":"document elements a MusicXML root file may have, and both can be written","type":"text"},{"text":" ","type":"text"},{"text":"compressed. A time-wise document throws","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFormatter\/Error\/unsupportedTimewise","isActive":true,"type":"reference"},{"text":" — but since the normalizer converts","type":"text"},{"text":" ","type":"text"},{"text":"time-wise to part-wise, a normally-processed document never hits that case.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"Because the AST is lossless, ","type":"text"},{"code":"parse → normalize → validate → format","type":"codeVoice"},{"text":" reproduces","type":"text"},{"text":" ","type":"text"},{"text":"the original score (modulo the version migration the normalizer applies and","type":"text"},{"text":" ","type":"text"},{"text":"settled whitespace canonicalization).","type":"text"}]},{"type":"heading","text":"The AST model","level":2,"anchor":"The-AST-model"},{"type":"paragraph","inlineContent":[{"text":"The syntactic model is a tree of value types rooted at ","type":"text"},{"isActive":true,"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDocument","type":"reference"},{"text":":","type":"text"}]},{"type":"codeListing","code":["MXLDocument","└─ content: MXLDocument.Content","   └─ .scorePartwise(MXLScorePartwise)","      ├─ partList: MXLPartList","      └─ parts:    [MXLScorePartwise.Part]","         └─ measures: [Measure]","            └─ items: [MXLMusicItem]   \/\/ .note, .attributes, .direction, …"],"syntax":null},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDocument\/Content-swift.enum","type":"reference"},{"text":" is an enum over the three MusicXML document elements","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"opus","type":"codeVoice"},{"text":", ","type":"text"},{"code":"scorePartwise","type":"codeVoice"},{"text":", ","type":"text"},{"code":"scoreTimewise","type":"codeVoice"},{"text":"). The AST is","type":"text"},{"text":" ","type":"text"},{"text":"lossless — it records exactly what was written so it can round-trip through","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFormatter","type":"reference"},{"text":" — and every leaf value is wrapped in a small validating type.","type":"text"},{"text":" ","type":"text"},{"text":"All AST types are ","type":"text"},{"code":"Equatable","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDocument","type":"reference"},{"text":" equality compares ","type":"text"},{"code":"content","type":"codeVoice"},{"text":" only; the ","type":"text"},{"code":"isNormalized","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"isValidated","type":"codeVoice"},{"text":" flags are metadata and are excluded.","type":"text"}]},{"type":"heading","text":"Building a document programmatically","level":2,"anchor":"Building-a-document-programmatically"},{"type":"paragraph","inlineContent":[{"text":"You can construct the AST directly rather than parsing bytes:","type":"text"}]},{"type":"codeListing","code":["let pitch    = MXLPitch(step: .c, octave: 4)","let fullNote = MXLFullNote(isChord: false, content: .pitch(pitch))","let note     = MXLNote(content: .regularNote(fullNote: fullNote,","                                             duration: 4,","                                             tie: []))","","let measure  = MXLScorePartwise.Part.Measure(number: \"1\", items: [.note(note)])","let part     = MXLScorePartwise.Part(id: \"P1\", measures: [measure])","let scorePart = MXLScorePart(id: \"P1\",","                             name: MXLPartName(value: \"Music\",","                                               text: MXLPartName.Text()))","let score    = MXLScorePartwise(partList: MXLPartList(items: [.scorePart(scorePart)]),","                                parts: [part])","let document = MXLDocument(content: .scorePartwise(score))"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"A directly-constructed document has ","type":"text"},{"code":"isNormalized == false","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"isValidated == false","type":"codeVoice"},{"text":", so you must run it through the normalizer and validator","type":"text"},{"text":" ","type":"text"},{"text":"before formatting.","type":"text"}]},{"type":"heading","text":"Error handling","level":2,"anchor":"Error-handling"},{"type":"paragraph","inlineContent":[{"text":"Thrown errors conform to ","type":"text"},{"code":"EnhancedError","type":"codeVoice"},{"text":" (from","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"https:\/\/github.com\/eBardX\/XestiTools","type":"reference"},{"text":"): each has a ","type":"text"},{"code":"category","type":"codeVoice"},{"text":" of","type":"text"},{"text":" ","type":"text"},{"code":"\"IvorMXL\"","type":"codeVoice"},{"text":" and a human-readable ","type":"text"},{"code":"message","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Type"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Thrown by"}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLParser\/Error","type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"MXLParser.parse(_:compressed:)"}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValidator\/Error","type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"MXLValidator.validate(_:)"}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFormatter\/Error","type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"MXLFormatter.format(_:compressed:)"}],"type":"paragraph"}]]],"alignments":["left","left"]},{"type":"paragraph","inlineContent":[{"code":"MXLNormalizer.normalize(_:)","type":"codeVoice"},{"text":" never throws — every version is migratable, so","type":"text"},{"text":" ","type":"text"},{"text":"normalization has no failure mode.","type":"text"}]},{"inlineContent":[{"type":"text","text":"Non-fatal results are returned rather than thrown, and each also provides a"},{"type":"text","text":" "},{"type":"codeVoice","code":"message"},{"type":"text","text":":"}],"type":"paragraph"},{"rows":[[[{"inlineContent":[{"text":"Type","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Returned by","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLParser\/Diagnostic","type":"reference","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"parse(_:compressed:)"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNormalizer\/Change","type":"reference","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"normalize(_:)"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValidator\/Issue","type":"reference","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"validate(_:)"}],"type":"paragraph"}]]],"header":"row","type":"table","alignments":["left","left"]},{"level":2,"text":"Concurrency","type":"heading","anchor":"Concurrency"},{"inlineContent":[{"type":"text","text":"IvorMXL is built for Swift 6 strict concurrency. Every public type — the"},{"type":"text","text":" "},{"type":"text","text":"four processing types and the entire AST — is a "},{"code":"Sendable","type":"codeVoice"},{"type":"text","text":" value type, so"},{"type":"text","text":" "},{"type":"text","text":"instances can be freely shared across tasks and actor boun