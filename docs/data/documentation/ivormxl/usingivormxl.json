{"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL"]]},"kind":"article","schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/UsingIvorMXL","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"inlineContent":[{"text":"IvorMXL exposes four processing types. Each is a ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":" value type with a","type":"text"},{"text":" ","type":"text"},{"text":"no-argument initializer and a single primary method:","type":"text"}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Type","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Method","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Result","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLParser"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"parse(_:compressed:)"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"(MXLDocument, [MXLParser.Diagnostic])"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNormalizer"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"normalize(_:)"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"(MXLDocument, [MXLNormalizer.Change])"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValidator"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"validate(_:)"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"(MXLDocument, [MXLValidator.Issue])"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFormatter"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"format(_:compressed:)"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Data"}]}]]],"alignments":["left","left","left"],"type":"table","header":"row"},{"inlineContent":[{"text":"An ","type":"text"},{"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDocument","isActive":true},{"text":" carries two Boolean state flags that enforce the order of","type":"text"},{"text":" ","type":"text"},{"text":"the pipeline:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"isNormalized","type":"codeVoice"}]},{"type":"text","text":" — "},{"type":"codeVoice","code":"validate(_:)"},{"type":"text","text":" throws unless this is "},{"type":"codeVoice","code":"true"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"isValidated","type":"codeVoice"}]},{"type":"text","text":" — "},{"type":"codeVoice","code":"format(_:compressed:)"},{"type":"text","text":" throws unless this is "},{"type":"codeVoice","code":"true"},{"type":"text","text":"."}]}]}]},{"inlineContent":[{"text":"So the canonical order is ","type":"text"},{"type":"strong","inlineContent":[{"text":"parse → normalize → validate → format","type":"text"}]},{"text":":","type":"text"}],"type":"paragraph"},{"code":["let (parsed, diagnostics) = try MXLParser().parse(data, compressed: false)","let (normalized, changes) = MXLNormalizer().normalize(parsed)","let (validated, issues)   = try MXLValidator().validate(normalized)","","guard issues.isEmpty","else { \/* handle issues *\/ return }","","let output = try MXLFormatter().format(validated, compressed: false)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Both ","type":"text"},{"code":"normalize(_:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"validate(_:)","type":"codeVoice"},{"text":" are idempotent — calling them on a","type":"text"},{"text":" ","type":"text"},{"text":"document that is already normalized or validated returns it unchanged — so it","type":"text"},{"text":" ","type":"text"},{"text":"is always safe to run the full pipeline.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"MusicXML files come in two physical encodings: an uncompressed XML document and","type":"text"},{"text":" ","type":"text"},{"text":"a compressed ","type":"text"},{"code":".mxl","type":"codeVoice"},{"text":" ZIP archive that wraps a ","type":"text"},{"code":"META-INF\/container.xml","type":"codeVoice"},{"text":" pointing","type":"text"},{"text":" ","type":"text"},{"text":"at the root score. The ","type":"text"},{"code":"compressed:","type":"codeVoice"},{"text":" argument on ","type":"text"},{"code":"parse(_:compressed:)","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"format(_:compressed:)","type":"codeVoice"},{"text":" selects between them; the rest of the pipeline is","type":"text"},{"text":" ","type":"text"},{"text":"encoding-agnostic.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Parsing","anchor":"Parsing","type":"heading"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLParser","isActive":true},{"text":" decodes ","type":"text"},{"code":"Data","type":"codeVoice"},{"text":" into an ","type":"text"},{"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDocument","isActive":true},{"text":":","type":"text"}],"type":"paragraph"},{"code":["let (document, diagnostics) = try MXLParser().parse(data, compressed: false)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"A MusicXML root file may have three document elements — a part-wise score, a","type":"text"},{"text":" ","type":"text"},{"text":"time-wise score, or an ","type":"text"},{"code":"<opus>","type":"codeVoice"},{"text":" — so ","type":"text"},{"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDocument\/Content-swift.enum","isActive":true},{"text":" is an enum over all","type":"text"},{"text":" ","type":"text"},{"text":"three. Most documents are a part-wise ","type":"text"},{"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePartwise","isActive":true},{"text":". An MXL","type":"text"},{"text":" ","type":"text"},{"code":"<container>","type":"codeVoice"},{"text":" is an archive implementation detail rather than a document, so a","type":"text"},{"text":" ","type":"text"},{"text":"bare ","type":"text"},{"code":"container.xml","type":"codeVoice"},{"text":" is rejected as an unexpected root element.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLParser\/Diagnostic","isActive":true},{"text":" reports things the parser accepted but had to adjust","type":"text"},{"text":" ","type":"text"},{"text":"or work around — a ","type":"text"},{"code":"version","type":"codeVoice"},{"text":" attribute it had to default or repair","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"defaultedVersion","type":"codeVoice"},{"text":", ","type":"text"},{"code":"malformedVersion(_:)","type":"codeVoice"},{"text":"), an element or attribute the","type":"text"},{"text":" ","type":"text"},{"text":"schema deprecated (","type":"text"},{"code":"deprecatedElement(_:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"deprecatedAttribute(_:)","type":"codeVoice"},{"text":"), or one","type":"text"},{"text":" ","type":"text"},{"text":"it did not recognize and skipped (","type":"text"},{"code":"ignoredElement(_:)","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"ignoredAttribute(_:)","type":"codeVoice"},{"text":"), or a zero-length ","type":"text"},{"code":"<forward>","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"<backup>","type":"codeVoice"},{"text":" it dropped","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"droppedZeroDuration(_:)","type":"codeVoice"},{"text":"). Diagnostics are always returned, never thrown; each","type":"text"},{"text":" ","type":"text"},{"text":"has a human-readable ","type":"text"},{"code":"message","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["for diagnostic in diagnostics {","    print(diagnostic.message)","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Unrecoverable problems are thrown as an ","type":"text"},{"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLParser\/Error","isActive":true},{"text":" — a malformed ZIP","type":"text"},{"text":" ","type":"text"},{"text":"container (","type":"text"},{"code":"noRootFileFound","type":"codeVoice"},{"text":", ","type":"text"},{"code":"invalidRootFileMediaType(_:)","type":"codeVoice"},{"text":") or an XML body","type":"text"},{"text":" ","type":"text"},{"text":"that will not parse at all (","type":"text"},{"code":"parseFailure(_:)","type":"codeVoice"},{"text":"). Like all IvorMXL errors","type":"text"},{"text":" ","type":"text"},{"text":"it conforms to ","type":"text"},{"code":"EnhancedError","type":"codeVoice"},{"text":" and provides a ","type":"text"},{"code":"message","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["do {","    let (document, _) = try MXLParser().parse(data, compressed: true)","} catch let error as MXLParser.Error {","    print(error.message)","}"],"syntax":"swift","type":"codeListing"},{"level":2,"text":"Normalizing","anchor":"Normalizing","type":"heading"},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNormalizer","type":"reference"},{"text":" migrates a document to the most recent supported MusicXML","type":"text"},{"text":" ","type":"text"},{"text":"version, returning a new document whose ","type":"text"},{"code":"isNormalized","type":"codeVoice"},{"text":" flag is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":", together","type":"text"},{"text":" ","type":"text"},{"text":"with a list of the changes it applied:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let (normalized, changes) = MXLNormalizer().normalize(parsed)","","for change in changes {","    print(change.message)","}"]},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDocument\/Version"},{"text":" lists all six supported versions (1.0 through 4.0);","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":".current"},{"text":" is the migration target. A part-wise score enters an ordered chain","type":"text"},{"text":" ","type":"text"},{"text":"of per-version passes at its declared version and is stamped with the current","type":"text"},{"text":" ","type":"text"},{"text":"version on the way out. The passes are ","type":"text"},{"type":"strong","inlineContent":[{"text":"derived by diffing the six vendored","type":"text"},{"text":" ","type":"text"},{"text":"schemas","type":"text"}]},{"text":" rather than written from memory — the 1.0 and 1.1 DTDs and the 2.0–4.0","type":"text"},{"text":" ","type":"text"},{"text":"XSDs — and applied as an additive record of deprecations. Each","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNormalizer\/Change"},{"text":" case names what moved: ","type":"text"},{"type":"codeVoice","code":"upgradedVersion(_:_:)"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"renamedElement(_:_:)"},{"text":", ","type":"text"},{"type":"codeVoice","code":"replacedConstruct(_:_:)"},{"text":", ","type":"text"},{"type":"codeVoice","code":"suppliedDefault(_:_:)"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"convertedToPartwise"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"inlineContent":[{"text":"time-wise score is converted to part-wise","type":"text"}],"type":"strong"},{"text":" as its first migration step —","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"the two encodings are isomorphic in musical content — so a normalized document"},{"text":" ","type":"text"},{"text":"is never time-wise. An opus has no migration passes — the opus schema has never","type":"text"},{"type":"text","text":" "},{"text":"changed structurally — but it does take the same closing version stamp, applied","type":"text"},{"text":" ","type":"text"},{"text":"at every level of nesting. Because a content-changing normalization can","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"invalidate a prior validation, normalizing clears "},{"code":"isValidated","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"IvorMXL has ","type":"text"},{"inlineContent":[{"text":"no born-normalized fast path","type":"text"}],"type":"strong"},{"text":": the parser never pre-sets","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"isNormalized"},{"text":", so every document goes through the normalizer at least once.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Detecting an already-canonical document would mean proving no"},{"type":"text","text":" "},{"type":"text","text":"migration-triggering construct appears anywhere in it — the declared "},{"code":"version","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"is asserted by the file, never verified, so a document may claim "},{"code":"4.0","type":"codeVoice"},{"text":" and still","type":"text"},{"text":" ","type":"text"},{"text":"contain a 2.0-era deprecated element. Over-reporting is harmless (a pass that","type":"text"},{"text":" ","type":"text"},{"text":"makes no changes) while under-reporting silently skips a migration, so the check","type":"text"},{"text":" ","type":"text"},{"text":"would have to be exhaustive to be safe — which costs more than the pass it would","type":"text"},{"text":" ","type":"text"},{"text":"skip.","type":"text"}]},{"type":"heading","anchor":"Validating","level":2,"text":"Validating"},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValidator","type":"reference"},{"text":" checks a ","type":"text"},{"inlineContent":[{"type":"text","text":"normalized"}],"type":"strong"},{"text":" document:","type":"text"}]},{"type":"codeListing","code":["let (validated, issues) = try MXLValidator().validate(normalized)","","if issues.isEmpty {","    \/\/ `validated.isValidated` is now true.","} else {","    issues.forEach { print($0.message) }","}"],"syntax":"swift"},{"items":[{"content":[{"inlineContent":[{"text":"If the document has not been normalized, ","type":"text"},{"type":"codeVoice","code":"validate(_:)"},{"text":" throws","type":"text"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValidator\/Error\/notNormalized","isActive":true},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"An opus passes straight through, marked validated with no issues: its schema","type":"text"},{"text":" ","type":"text"},{"text":"is four elements and the parser already enforces nearly everything they","type":"text"},{"text":" ","type":"text"},{"text":"constrain, so there is nothing left to check.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"If any issues are found, the returned document is the ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"input unchanged"}]},{"text":" ","type":"text"},{"text":"(its ","type":"text"},{"code":"isValidated","type":"codeVoice"},{"text":" flag stays ","type":"text"},{"code":"false","type":"codeVoice"},{"text":"). Fix the issues — or run it through","type":"text"},{"text":" ","type":"text"},{"text":"the normalizer again after editing — and validate again.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Only when the issues array is empty does the returned document have","type":"text"},{"text":" ","type":"text"},{"code":"isValidated == true","type":"codeVoice"},{"text":" — the prerequisite for formatting.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"A time-wise score is validated in its part-wise encoding. The"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValidator\/Issue"},{"type":"text","text":" catalogue covers the"},{"type":"text","text":" "},{"type":"text","text":"cross-references the schema cannot express on its own: a "},{"code":"<part>","type":"codeVoice"},{"type":"text","text":" whose "},{"code":"id","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"names no "},{"code":"<score-part>","type":"codeVoice"},{"type":"text","text":" ("},{"code":"danglingPartID(_:)","type":"codeVoice"},{"type":"text","text":"), a "},{"code":"<score-part>","type":"codeVoice"},{"type":"text","text":" no "},{"code":"<part>","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"realizes ("},{"code":"unusedScorePart(_:)","type":"codeVoice"},{"type":"text","text":"), a durational element before the first"},{"type":"text","text":" "},{"code":"<divisions>","type":"codeVoice"},{"type":"text","text":" ("},{"code":"durationBeforeDivisions(part:measure:)","type":"codeVoice"},{"type":"text","text":"), an "},{"code":"<ending>","type":"codeVoice"},{"type":"text","text":" start"},{"type":"text","text":" "},{"type":"text","text":"with no stop ("},{"code":"unmatchedEndingStart(number:part:measure:)","type":"codeVoice"},{"type":"text","text":") or a stop with no"},{"type":"text","text":" "},{"type":"text","text":"start ("},{"code":"unmatchedEndingStop(number:part:measure:)","type":"codeVoice"},{"type":"text","text":"), an unbalanced"},{"type":"text","text":" "},{"code":"<part-group>","type":"codeVoice"},{"type":"text","text":" ("},{"code":"unbalancedPartGroup(number:)","type":"codeVoice"},{"type":"text","text":"), and an "},{"code":"<instrument-sound>","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"that is not one of the 894 standard sounds defined by MusicXML 4.0"},{"type":"text","text":" "},{"type":"text","text":"("},{"code":"unknownInstrumentSound(_:)","type":"codeVoice"},{"type":"text","text":")."}],"type":"paragraph"},{"text":"Formatting","anchor":"Formatting","level":2,"type":"heading"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFormatter"},{"type":"text","text":" serializes a "},{"inlineContent":[{"type":"text","text":"validated"}],"type":"strong"},{"type":"text","text":" document back to MusicXML "},{"code":"Data","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"optionally as a compressed "},{"code":".mxl","type":"codeVoice"},{"type":"text","text":" archive:"}],"type":"paragraph"},{"code":["let xml = try MXLFormatter().format(validated, compressed: false)","let mxl = try MXLFormatter().format(validated, compressed: true)"],"syntax":"swift","type":"codeListing"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"If the document has not been validated, ","type":"text"},{"code":"format(_:compressed:)","type":"codeVoice"},{"text":" throws","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFormatter\/Error\/notValidated","isActive":true},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The formatter writes ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"part-wise scores and opus documents"}]},{"text":" — both are","type":"text"},{"text":" ","type":"text"},{"text":"document elements a MusicXML root file may have, and both can be written","type":"text"},{"text":" ","type":"text"},{"text":"compressed. A time-wise document throws","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFormatter\/Error\/unsupportedTimewise","isActive":true},{"text":" — but since the normalizer converts","type":"text"},{"text":" ","type":"text"},{"text":"time-wise to part-wise, a normally-processed document never hits that case.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Because the AST is lossless, "},{"code":"parse → normalize → validate → format","type":"codeVoice"},{"type":"text","text":" reproduces"},{"type":"text","text":" "},{"type":"text","text":"the original document (modulo the version migration the normalizer applies and"},{"type":"text","text":" "},{"type":"text","text":"settled whitespace canonicalization)."}],"type":"paragraph"},{"text":"The AST model","anchor":"The-AST-model","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The syntactic model is a tree of value types rooted at "},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDocument"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["MXLDocument","└─ content: MXLDocument.Content","   └─ .scorePartwise(MXLScorePartwise)","      ├─ partList: MXLPartList","      └─ parts:    [MXLScorePartwise.Part]","         └─ measures: [Measure]","            └─ items: [MXLMusicItem]   \/\/ .note, .attributes, .direction, …"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDocument\/Content-swift.enum"},{"type":"text","text":" is an enum over the three MusicXML document elements"},{"type":"text","text":" "},{"type":"text","text":"("},{"code":"opus","type":"codeVoice"},{"type":"text","text":", "},{"code":"scorePartwise","type":"codeVoice"},{"type":"text","text":", "},{"code":"scoreTimewise","type":"codeVoice"},{"type":"text","text":"). The AST is"},{"type":"text","text":" "},{"type":"text","text":"lossless — it records exactly what was written so it can round-trip through"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFormatter","isActive":true},{"type":"text","text":" — and every leaf value is wrapped in a small validating type."},{"type":"text","text":" "},{"type":"text","text":"All AST types are "},{"type":"codeVoice","code":"Equatable"},{"text":", ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"type":"text","text":", and "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDocument","isActive":true},{"type":"text","text":" equality and hashing compare "},{"type":"codeVoice","code":"content"},{"type":"text","text":" only; the"},{"type":"text","text":" "},{"type":"codeVoice","code":"isNormalized"},{"type":"text","text":" and "},{"code":"isValidated","type":"codeVoice"},{"text":" flags are metadata and are excluded.","type":"text"}],"type":"paragraph"},{"text":"Building a document programmatically","anchor":"Building-a-document-programmatically","level":2,"type":"heading"},{"inlineContent":[{"text":"You can construct the AST directly rather than parsing bytes:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["let pitch    = MXLPitch(step: .c, octave: 4)","let fullNote = MXLFullNote(isChord: false, content: .pitch(pitch))","let note     = MXLNote(content: .regularNote(fullNote: fullNote,","                                             duration: 4,","                                             tie: []))","","let measure  = MXLScorePartwise.Part.Measure(number: \"1\", items: [.note(note)])","let part     = MXLScorePartwise.Part(id: \"P1\", measures: [measure])","let scorePart = MXLScorePart(id: \"P1\",","                             name: MXLPartName(value: \"Music\",","                                               text: MXLPartName.Text()))","let score    = MXLScorePartwise(partList: MXLPartList(items: [.scorePart(scorePart)]),","                                parts: [part])","let document = MXLDocument(content: .scorePartwise(score))"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A directly-constructed document has "},{"type":"codeVoice","code":"isNormalized == false"},{"type":"text","text":" and"},{"type":"text","text":" "},{"code":"isValidated == false","type":"codeVoice"},{"type":"text","text":" — exactly like one fresh out of the parser — so you must"},{"type":"text","text":" "},{"type":"text","text":"run it through the normalizer and validator before formatting."}]},{"text":"Error handling","level":2,"type":"heading","anchor":"Error-handling"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Thrown errors conform to "},{"type":"codeVoice","code":"EnhancedError"},{"type":"text","text":" (from"},{"type":"text","text":" "},{"type":"reference","identifier":"https:\/\/github.com\/eBardX\/XestiTools","isActive":true},{"type":"text","text":"): each has a "},{"type":"codeVoice","code":"category"},{"type":"text","text":" of"},{"type":"text","text":" "},{"type":"codeVoice","code":"\"IvorMXL\""},{"type":"text","text":" and a human-readable "},{"type":"codeVoice","code":"message"},{"type":"text","text":"."}]},{"type":"table","alignments":["left","left"],"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Type"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Thrown by"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLParser\/Error","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"code":"MXLParser.parse(_:compressed:)","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValidator\/Error","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"code":"MXLValidator.validate(_:)","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFormatter\/Error","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"code":"MXLFormatter.format(_:compressed:)","type":"codeVoice"}]}]]]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"MXLNormalizer.normalize(_:)"},{"type":"text","text":" never throws — normalization has no failure mode,"},{"type":"text","text":" "},{"type":"text","text":"since every version is migratable."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Non-fatal results are returned rather than thrown, and each also provides a"},{"type":"text","text":" "},{"type":"codeVoice","code":"message"},{"type":"text","text":":"}]},{"type":"table","alignments":["left","left"],"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Type"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Returned by"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLParser\/Diagnostic","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"code":"parse(_:compressed:)","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNormalizer\/Change","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"code":"normalize(_:)","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXL