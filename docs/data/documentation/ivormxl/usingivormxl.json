{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/UsingIvorMXL"},"primaryContentSections":[{"content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"IvorMXL exposes four processing types. Each is a "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":" value type with a"},{"type":"text","text":" "},{"type":"text","text":"no-argument initializer and a single primary method:"}]},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Type"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Method"}]}],[{"inlineContent":[{"type":"text","text":"Result"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLParser","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"parse(_:compressed:)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"(MXLDocument, [MXLParser.Diagnostic])"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNormalizer","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"normalize(_:)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"(MXLDocument, [MXLNormalizer.Change])"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValidator","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"validate(_:)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"(MXLDocument, [MXLValidator.Issue])"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFormatter","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"format(_:compressed:)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Data"}],"type":"paragraph"}]]],"header":"row","type":"table","alignments":["left","left","left"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDocument","type":"reference","isActive":true},{"type":"text","text":" carries two Boolean state flags that enforce the order of"},{"type":"text","text":" "},{"type":"text","text":"the pipeline:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"isNormalized"}]},{"type":"text","text":" — "},{"type":"codeVoice","code":"validate(_:)"},{"type":"text","text":" throws unless this is "},{"code":"true","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"isValidated","type":"codeVoice"}]},{"type":"text","text":" — "},{"code":"format(_:compressed:)","type":"codeVoice"},{"type":"text","text":" throws unless this is "},{"code":"true","type":"codeVoice"},{"type":"text","text":"."}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"So the canonical order is "},{"inlineContent":[{"type":"text","text":"parse → normalize → validate → format"}],"type":"strong"},{"type":"text","text":":"}]},{"syntax":"swift","type":"codeListing","code":["let (parsed, diagnostics) = try MXLParser().parse(data, compressed: false)","let (normalized, changes) = MXLNormalizer().normalize(parsed)","let (validated, issues)   = try MXLValidator().validate(normalized)","","guard issues.isEmpty","else { \/* handle issues *\/ return }","","let output = try MXLFormatter().format(validated, compressed: false)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Both "},{"code":"normalize(_:)","type":"codeVoice"},{"type":"text","text":" and "},{"code":"validate(_:)","type":"codeVoice"},{"type":"text","text":" are idempotent — calling them on a"},{"type":"text","text":" "},{"type":"text","text":"document that is already normalized or validated returns it unchanged — so it"},{"type":"text","text":" "},{"type":"text","text":"is always safe to run the full pipeline."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"MusicXML files come in two physical encodings: an uncompressed XML document and"},{"type":"text","text":" "},{"type":"text","text":"a compressed "},{"code":".mxl","type":"codeVoice"},{"type":"text","text":" ZIP archive that wraps a "},{"code":"META-INF\/container.xml","type":"codeVoice"},{"type":"text","text":" pointing"},{"type":"text","text":" "},{"type":"text","text":"at the root score. The "},{"code":"compressed:","type":"codeVoice"},{"type":"text","text":" argument on "},{"code":"parse(_:compressed:)","type":"codeVoice"},{"type":"text","text":" and"},{"type":"text","text":" "},{"code":"format(_:compressed:)","type":"codeVoice"},{"type":"text","text":" selects between them; the rest of the pipeline is"},{"type":"text","text":" "},{"type":"text","text":"encoding-agnostic."}]},{"anchor":"Parsing","text":"Parsing","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLParser","type":"reference","isActive":true},{"type":"text","text":" decodes "},{"code":"Data","type":"codeVoice"},{"type":"text","text":" into an "},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDocument","type":"reference","isActive":true},{"type":"text","text":":"}]},{"syntax":"swift","type":"codeListing","code":["let (document, diagnostics) = try MXLParser().parse(data, compressed: false)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A MusicXML root file may have three document elements — a part-wise score, a"},{"type":"text","text":" "},{"type":"text","text":"time-wise score, or an "},{"code":"<opus>","type":"codeVoice"},{"type":"text","text":" — so "},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDocument\/Content-swift.enum","type":"reference","isActive":true},{"type":"text","text":" is an enum over all"},{"type":"text","text":" "},{"type":"text","text":"three. Most documents are a part-wise "},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePartwise","type":"reference","isActive":true},{"type":"text","text":". An MXL"},{"type":"text","text":" "},{"code":"<container>","type":"codeVoice"},{"type":"text","text":" is an archive implementation detail rather than a document, so a"},{"type":"text","text":" "},{"type":"text","text":"bare "},{"code":"container.xml","type":"codeVoice"},{"type":"text","text":" is rejected as an unexpected root element."}]},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLParser\/Diagnostic","type":"reference","isActive":true},{"type":"text","text":" reports things the parser accepted but had to adjust"},{"type":"text","text":" "},{"type":"text","text":"or work around — a "},{"code":"version","type":"codeVoice"},{"type":"text","text":" attribute it had to default or repair"},{"type":"text","text":" "},{"type":"text","text":"("},{"code":"defaultedVersion","type":"codeVoice"},{"type":"text","text":", "},{"code":"malformedVersion(_:)","type":"codeVoice"},{"type":"text","text":"), an element or attribute the"},{"type":"text","text":" "},{"type":"text","text":"schema deprecated ("},{"code":"deprecatedElement(_:)","type":"codeVoice"},{"type":"text","text":", "},{"code":"deprecatedAttribute(_:)","type":"codeVoice"},{"type":"text","text":"), or one"},{"type":"text","text":" "},{"type":"text","text":"it did not recognize and skipped ("},{"code":"ignoredElement(_:)","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"ignoredAttribute(_:)","type":"codeVoice"},{"type":"text","text":"). Diagnostics are always returned, never thrown; each"},{"type":"text","text":" "},{"type":"text","text":"has a human-readable "},{"code":"message","type":"codeVoice"},{"type":"text","text":":"}]},{"syntax":"swift","type":"codeListing","code":["for diagnostic in diagnostics {","    print(diagnostic.message)","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Unrecoverable problems are thrown as an "},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLParser\/Error","type":"reference","isActive":true},{"type":"text","text":" — a malformed ZIP"},{"type":"text","text":" "},{"type":"text","text":"container ("},{"code":"noRootFileFound","type":"codeVoice"},{"type":"text","text":", "},{"code":"invalidRootFileMediaType(_:)","type":"codeVoice"},{"type":"text","text":") or an XML body"},{"type":"text","text":" "},{"type":"text","text":"that will not parse at all ("},{"code":"parseFailure(_:)","type":"codeVoice"},{"type":"text","text":"). Like all IvorMXL errors"},{"type":"text","text":" "},{"type":"text","text":"it conforms to "},{"code":"EnhancedError","type":"codeVoice"},{"type":"text","text":" and provides a "},{"code":"message","type":"codeVoice"},{"type":"text","text":":"}]},{"syntax":"swift","type":"codeListing","code":["do {","    let (document, _) = try MXLParser().parse(data, compressed: true)","} catch let error as MXLParser.Error {","    print(error.message)","}"]},{"anchor":"Normalizing","text":"Normalizing","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNormalizer","type":"reference","isActive":true},{"type":"text","text":" migrates a document to the most recent supported MusicXML"},{"type":"text","text":" "},{"type":"text","text":"version, returning a new document whose "},{"code":"isNormalized","type":"codeVoice"},{"type":"text","text":" flag is "},{"code":"true","type":"codeVoice"},{"type":"text","text":", together"},{"type":"text","text":" "},{"type":"text","text":"with a list of the changes it applied:"}]},{"syntax":"swift","type":"codeListing","code":["let (normalized, changes) = MXLNormalizer().normalize(parsed)","","for change in changes {","    print(change.message)","}"]},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDocument\/Version","type":"reference","isActive":true},{"type":"text","text":" lists all six supported versions (1.0 through 4.0);"},{"type":"text","text":" "},{"code":".current","type":"codeVoice"},{"type":"text","text":" is the migration target. A part-wise score enters an ordered chain"},{"type":"text","text":" "},{"type":"text","text":"of per-version passes at its declared version and is stamped with the current"},{"type":"text","text":" "},{"type":"text","text":"version on the way out. The passes are "},{"inlineContent":[{"type":"text","text":"derived by diffing the six vendored"},{"type":"text","text":" "},{"type":"text","text":"schemas"}],"type":"strong"},{"type":"text","text":" rather than written from memory — the 1.0 and 1.1 DTDs and the 2.0–4.0"},{"type":"text","text":" "},{"type":"text","text":"XSDs — and applied as an additive record of deprecations. Each"},{"type":"text","text":" "},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNormalizer\/Change","type":"reference","isActive":true},{"type":"text","text":" case names what moved: "},{"code":"upgradedVersion(_:_:)","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"renamedElement(_:_:)","type":"codeVoice"},{"type":"text","text":", "},{"code":"replacedConstruct(_:_:)","type":"codeVoice"},{"type":"text","text":", "},{"code":"suppliedDefault(_:_:)","type":"codeVoice"},{"type":"text","text":", and"},{"type":"text","text":" "},{"code":"convertedToPartwise","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"inlineContent":[{"text":"time-wise score is converted to part-wise","type":"text"}],"type":"strong"},{"type":"text","text":" as its first migration step —"},{"type":"text","text":" "},{"type":"text","text":"the two encodings are isomorphic in musical content — so a normalized document"},{"type":"text","text":" "},{"type":"text","text":"is never time-wise. An opus has no migration passes — the opus schema has never"},{"type":"text","text":" "},{"type":"text","text":"changed structurally — but it does take the same closing version stamp, applied"},{"type":"text","text":" "},{"type":"text","text":"at every level of nesting. Because a content-changing normalization can"},{"type":"text","text":" "},{"type":"text","text":"invalidate a prior validation, normalizing clears "},{"code":"isValidated","type":"codeVoice"},{"type":"text","text":"."}]},{"inlineContent":[{"type":"text","text":"IvorMXL has "},{"inlineContent":[{"text":"no born-normalized fast path","type":"text"}],"type":"strong"},{"text":": the parser never pre-sets","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"isNormalized"},{"text":", so every document goes through the normalizer at least once.","type":"text"},{"text":" ","type":"text"},{"text":"Detecting an already-canonical document would mean proving no","type":"text"},{"text":" ","type":"text"},{"text":"migration-triggering construct appears anywhere in it — the declared ","type":"text"},{"type":"codeVoice","code":"version"},{"text":" ","type":"text"},{"text":"is asserted by the file, never verified, so a document may claim ","type":"text"},{"code":"4.0","type":"codeVoice"},{"text":" and still","type":"text"},{"text":" ","type":"text"},{"text":"contain a 2.0-era deprecated element. Over-reporting is harmless (a pass that","type":"text"},{"text":" ","type":"text"},{"text":"makes no changes) while under-reporting silently skips a migration, so the check","type":"text"},{"text":" ","type":"text"},{"text":"would have to be exhaustive to be safe — which costs more than the pass it would","type":"text"},{"text":" ","type":"text"},{"text":"skip.","type":"text"}],"type":"paragraph"},{"type":"heading","level":2,"anchor":"Validating","text":"Validating"},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValidator","type":"reference"},{"text":" checks a ","type":"text"},{"inlineContent":[{"text":"normalized","type":"text"}],"type":"strong"},{"text":" document:","type":"text"}],"type":"paragraph"},{"code":["let (validated, issues) = try MXLValidator().validate(normalized)","","if issues.isEmpty {","    \/\/ `validated.isValidated` is now true.","} else {","    issues.forEach { print($0.message) }","}"],"syntax":"swift","type":"codeListing"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"If the document has not been normalized, "},{"code":"validate(_:)","type":"codeVoice"},{"type":"text","text":" throws"},{"type":"text","text":" "},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValidator\/Error\/notNormalized","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"An opus passes straight through, marked validated with no issues: its schema"},{"type":"text","text":" "},{"type":"text","text":"is four elements and the parser already enforces nearly everything they"},{"type":"text","text":" "},{"type":"text","text":"constrain, so there is nothing left to check."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"If any issues are found, the returned document is the "},{"inlineContent":[{"type":"text","text":"input unchanged"}],"type":"strong"},{"type":"text","text":" "},{"type":"text","text":"(its "},{"code":"isValidated","type":"codeVoice"},{"type":"text","text":" flag stays "},{"code":"false","type":"codeVoice"},{"type":"text","text":"). Fix the issues — or run it through"},{"type":"text","text":" "},{"type":"text","text":"the normalizer again after editing — and validate again."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Only when the issues array is empty does the returned document have"},{"type":"text","text":" "},{"code":"isValidated == true","type":"codeVoice"},{"type":"text","text":" — the prerequisite for formatting."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"A time-wise score is validated in its part-wise encoding. The","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValidator\/Issue","type":"reference","isActive":true},{"text":" catalogue covers the","type":"text"},{"text":" ","type":"text"},{"text":"cross-references the schema cannot express on its own: a ","type":"text"},{"code":"<part>","type":"codeVoice"},{"text":" whose ","type":"text"},{"code":"id","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"names no "},{"code":"<score-part>","type":"codeVoice"},{"type":"text","text":" ("},{"code":"danglingPartID(_:)","type":"codeVoice"},{"type":"text","text":"), a "},{"code":"<score-part>","type":"codeVoice"},{"type":"text","text":" no "},{"code":"<part>","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"realizes ("},{"code":"unusedScorePart(_:)","type":"codeVoice"},{"type":"text","text":"), a durational element before the first"},{"type":"text","text":" "},{"code":"<divisions>","type":"codeVoice"},{"type":"text","text":" ("},{"code":"durationBeforeDivisions(part:measure:)","type":"codeVoice"},{"type":"text","text":"), an unmatched"},{"type":"text","text":" "},{"code":"<ending>","type":"codeVoice"},{"type":"text","text":" ("},{"code":"unpairedEnding(number:part:measure:)","type":"codeVoice"},{"type":"text","text":"), an unbalanced"},{"type":"text","text":" "},{"code":"<part-group>","type":"codeVoice"},{"type":"text","text":" ("},{"code":"unbalancedPartGroup(number:)","type":"codeVoice"},{"type":"text","text":"), and an "},{"code":"<instrument-sound>","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"that is not one of the 894 standard sounds defined by MusicXML 4.0"},{"type":"text","text":" "},{"type":"text","text":"("},{"code":"unknownInstrumentSound(_:)","type":"codeVoice"},{"type":"text","text":")."}],"type":"paragraph"},{"text":"Formatting","anchor":"Formatting","type":"heading","level":2},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFormatter"},{"type":"text","text":" serializes a "},{"type":"strong","inlineContent":[{"type":"text","text":"validated"}]},{"type":"text","text":" document back to MusicXML "},{"code":"Data","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"optionally as a compressed "},{"code":".mxl","type":"codeVoice"},{"type":"text","text":" archive:"}],"type":"paragraph"},{"code":["let xml = try MXLFormatter().format(validated, compressed: false)","let mxl = try MXLFormatter().format(validated, compressed: true)"],"syntax":"swift","type":"codeListing"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"If the document has not been validated, "},{"code":"format(_:compressed:)","type":"codeVoice"},{"type":"text","text":" throws"},{"type":"text","text":" "},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFormatter\/Error\/notValidated","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The formatter writes ","type":"text"},{"type":"strong","inlineContent":[{"text":"part-wise scores and opus documents","type":"text"}]},{"text":" — both are","type":"text"},{"text":" ","type":"text"},{"text":"document elements a MusicXML root file may have, and both can be written","type":"text"},{"text":" ","type":"text"},{"text":"compressed. A time-wise document throws","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFormatter\/Error\/unsupportedTimewise","type":"reference","isActive":true},{"text":" — but since the normalizer converts","type":"text"},{"text":" ","type":"text"},{"text":"time-wise to part-wise, a normally-processed document never hits that case.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Because the AST is lossless, "},{"code":"parse → normalize → validate → format","type":"codeVoice"},{"type":"text","text":" reproduces"},{"type":"text","text":" "},{"type":"text","text":"the original document (modulo the version migration the normalizer applies and"},{"type":"text","text":" "},{"type":"text","text":"settled whitespace canonicalization)."}],"type":"paragraph"},{"level":2,"type":"heading","text":"The AST model","anchor":"The-AST-model"},{"inlineContent":[{"type":"text","text":"The syntactic model is a tree of value types rooted at "},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDocument"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":null,"code":["MXLDocument","└─ content: MXLDocument.Content","   └─ .scorePartwise(MXLScorePartwise)","      ├─ partList: MXLPartList","      └─ parts:    [MXLScorePartwise.Part]","         └─ measures: [Measure]","            └─ items: [MXLMusicItem]   \/\/ .note, .attributes, .direction, …"],"type":"codeListing"},{"inlineContent":[{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDocument\/Content-swift.enum","type":"reference","isActive":true},{"type":"text","text":" is an enum over the three MusicXML document elements"},{"type":"text","text":" "},{"type":"text","text":"("},{"code":"opus","type":"codeVoice"},{"type":"text","text":", "},{"code":"scorePartwise","type":"codeVoice"},{"type":"text","text":", "},{"code":"scoreTimewise","type":"codeVoice"},{"type":"text","text":"). The AST is"},{"type":"text","text":" "},{"type":"text","text":"lossless — it records exactly what was written so it can round-trip through"},{"type":"text","text":" "},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFormatter","type":"reference","isActive":true},{"type":"text","text":" — and every leaf value is wrapped in a small validating type."},{"type":"text","text":" "},{"type":"text","text":"All AST types are "},{"code":"Equatable","type":"codeVoice"},{"type":"text","text":", "},{"code":"Hashable","type":"codeVoice"},{"type":"text","text":", and "},{"code":"Sendable","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDocument","type":"reference","isActive":true},{"type":"text","text":" equality and hashing compare "},{"code":"content","type":"codeVoice"},{"type":"text","text":" only; the"},{"type":"text","text":" "},{"code":"isNormalized","type":"codeVoice"},{"type":"text","text":" and "},{"code":"isValidated","type":"codeVoice"},{"type":"text","text":" flags are metadata and are excluded."}],"type":"paragraph"},{"level":2,"type":"heading","text":"Building a document programmatically","anchor":"Building-a-document-programmatically"},{"inlineContent":[{"type":"text","text":"You can construct the AST directly rather than parsing bytes:"}],"type":"paragraph"},{"syntax":"swift","code":["let pitch    = MXLPitch(step: .c, octave: 4)","let fullNote = MXLFullNote(isChord: false, content: .pitch(pitch))","let note     = MXLNote(content: .regularNote(fullNote: fullNote,","                                             duration: 4,","                                             tie: []))","","let measure  = MXLScorePartwise.Part.Measure(number: \"1\", items: [.note(note)])","let part     = MXLScorePartwise.Part(id: \"P1\", measures: [measure])","let scorePart = MXLScorePart(id: \"P1\",","                             name: MXLPartName(value: \"Music\",","                                               text: MXLPartName.Text()))","let score    = MXLScorePartwise(partList: MXLPartList(items: [.scorePart(scorePart)]),","                                parts: [part])","let document = MXLDocument(content: .scorePartwise(score))"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"A directly-constructed document has "},{"code":"isNormalized == false","type":"codeVoice"},{"type":"text","text":" and"},{"type":"text","text":" "},{"code":"isValidated == false","type":"codeVoice"},{"type":"text","text":" — exactly like one fresh out of the parser — so you must"},{"type":"text","text":" "},{"type":"text","text":"run it through the normalizer and validator before formatting."}],"type":"paragraph"},{"level":2,"type":"heading","text":"Error handling","anchor":"Error-handling"},{"inlineContent":[{"type":"text","text":"Thrown errors conform to "},{"code":"EnhancedError","type":"codeVoice"},{"type":"text","text":" (from"},{"type":"text","text":" "},{"identifier":"https:\/\/github.com\/eBardX\/XestiTools","type":"reference","isActive":true},{"type":"text","text":"): each has a "},{"code":"category","type":"codeVoice"},{"type":"text","text":" of"},{"type":"text","text":" "},{"code":"\"IvorMXL\"","type":"codeVoice"},{"type":"text","text":" and a human-readable "},{"code":"message","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Type"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Thrown by","type":"text"}]}]],[[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLParser\/Error","type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"code":"MXLParser.parse(_:compressed:)","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValidator\/Error","type":"reference","isActive":true}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"code":"MXLValidator.validate(_:)","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFormatter\/Error"}]}],[{"type":"paragraph","inlineContent":[{"code":"MXLFormatter.format(_:compressed:)","type":"codeVoice"}]}]]],"alignments":["left","left"]},{"inlineContent":[{"type":"codeVoice","code":"MXLNormalizer.normalize(_:)"},{"type":"text","text":" never throws — normalization has no failure mode,"},{"type":"text","text":" "},{"type":"text","text":"since every version is migratable."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Non-fatal results are returned rather than thrown, and each also provides a"},{"type":"text","text":" "},{"code":"message","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"text":"Type","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Returned by","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLParser\/Diagnostic","type":"reference","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"parse(_:compressed:)"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNormalizer\/Change","type":"reference","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"normalize(_:)"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValidator\/Issue","type":"reference","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"validate(_:)"}],"type":"paragraph"}]]],"alignments":["left","left"]},{"level":2,"type":"heading","text":"Concurrency","anchor":"Concurrency"},{"inlineContent":[{"type":"text","text":"IvorMXL is built for Swift 6 strict concurrency. Every public type — the"},{"type":"text","text":" "},{"type":"text","text":"four processing types and the entire AST — is a "},{"code":"Sendable","type":"codeVoice"},{"type":"text","text":" value type, so"},{"type":"text","text":" "},{"type":"text","text":"instances can be freely shared across tasks and actor boundaries. The"},{"type":"text","text":" "},{"type":"text","text":"p