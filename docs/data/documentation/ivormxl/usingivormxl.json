{"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL"]]},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"IvorMXL exposes four processing types. Each is a "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":" value type with a"},{"type":"text","text":" "},{"type":"text","text":"no-argument initializer and a single primary method:"}]},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"text":"Type","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Method","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Result","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLParser","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"code":"parse(_:compressed:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"(MXLDocument, [MXLParser.Diagnostic])","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNormalizer","isActive":true}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"code":"normalize(_:)","type":"codeVoice"}]}],[{"inlineContent":[{"code":"(MXLDocument, [MXLNormalizer.Change])","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValidator","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"code":"validate(_:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"(MXLDocument, [MXLValidator.Issue])","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFormatter","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"code":"format(_:compressed:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Data","type":"codeVoice"}],"type":"paragraph"}]]],"alignments":["left","left","left"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDocument","isActive":true},{"type":"text","text":" carries two Boolean state flags that enforce the order of"},{"type":"text","text":" "},{"type":"text","text":"the pipeline:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"code":"isNormalized","type":"codeVoice"}],"type":"strong"},{"text":" — ","type":"text"},{"code":"validate(_:)","type":"codeVoice"},{"text":" throws unless this is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"code":"isValidated","type":"codeVoice"}],"type":"strong"},{"text":" — ","type":"text"},{"code":"format(_:compressed:)","type":"codeVoice"},{"text":" throws unless this is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"So the canonical order is "},{"inlineContent":[{"text":"parse → normalize → validate → format","type":"text"}],"type":"strong"},{"type":"text","text":":"}]},{"type":"codeListing","code":["let (parsed, diagnostics) = try MXLParser().parse(data, compressed: false)","let (normalized, changes) = MXLNormalizer().normalize(parsed)","let (validated, issues)   = try MXLValidator().validate(normalized)","","guard issues.isEmpty","else { \/* handle issues *\/ return }","","let output = try MXLFormatter().format(validated, compressed: false)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Both "},{"type":"codeVoice","code":"normalize(_:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"validate(_:)"},{"type":"text","text":" are idempotent — calling them on a"},{"type":"text","text":" "},{"type":"text","text":"document that is already normalized or validated returns it unchanged — so it"},{"type":"text","text":" "},{"type":"text","text":"is always safe to run the full pipeline."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"MusicXML files come in two physical encodings: an uncompressed XML document and"},{"type":"text","text":" "},{"type":"text","text":"a compressed "},{"type":"codeVoice","code":".mxl"},{"type":"text","text":" ZIP archive that wraps a "},{"type":"codeVoice","code":"META-INF\/container.xml"},{"type":"text","text":" pointing"},{"type":"text","text":" "},{"type":"text","text":"at the root score. The "},{"type":"codeVoice","code":"compressed:"},{"type":"text","text":" argument on "},{"type":"codeVoice","code":"parse(_:compressed:)"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"format(_:compressed:)"},{"type":"text","text":" selects between them; the rest of the pipeline is"},{"type":"text","text":" "},{"type":"text","text":"encoding-agnostic."}]},{"type":"heading","anchor":"Parsing","level":2,"text":"Parsing"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLParser","isActive":true},{"type":"text","text":" decodes "},{"type":"codeVoice","code":"Data"},{"type":"text","text":" into an "},{"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDocument","isActive":true},{"type":"text","text":":"}]},{"type":"codeListing","code":["let (document, diagnostics) = try MXLParser().parse(data, compressed: false)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A MusicXML root file may have three document elements — a part-wise score, a"},{"type":"text","text":" "},{"type":"text","text":"time-wise score, or an "},{"type":"codeVoice","code":"<opus>"},{"type":"text","text":" — so "},{"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDocument\/Content-swift.enum","isActive":true},{"type":"text","text":" is an enum over all"},{"type":"text","text":" "},{"type":"text","text":"three. Most documents are a part-wise "},{"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePartwise","isActive":true},{"type":"text","text":". An MXL"},{"type":"text","text":" "},{"type":"codeVoice","code":"<container>"},{"type":"text","text":" is an archive implementation detail rather than a document, so a"},{"type":"text","text":" "},{"type":"text","text":"bare "},{"type":"codeVoice","code":"container.xml"},{"type":"text","text":" is rejected as an unexpected root element."}]},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLParser\/Diagnostic","isActive":true},{"type":"text","text":" reports things the parser accepted but had to adjust"},{"type":"text","text":" "},{"type":"text","text":"or work around — a "},{"type":"codeVoice","code":"version"},{"type":"text","text":" attribute it had to default or repair"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"defaultedVersion"},{"type":"text","text":", "},{"type":"codeVoice","code":"malformedVersion(_:)"},{"type":"text","text":"), an element or attribute the"},{"type":"text","text":" "},{"type":"text","text":"schema deprecated ("},{"type":"codeVoice","code":"deprecatedElement(_:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"deprecatedAttribute(_:)"},{"type":"text","text":"), or one"},{"type":"text","text":" "},{"type":"text","text":"it did not recognize and skipped ("},{"type":"codeVoice","code":"ignoredElement(_:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"ignoredAttribute(_:)"},{"type":"text","text":"), or a zero-length "},{"type":"codeVoice","code":"<forward>"},{"type":"text","text":" or "},{"type":"codeVoice","code":"<backup>"},{"type":"text","text":" it dropped"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"droppedZeroDuration(_:)"},{"type":"text","text":"). Diagnostics are always returned, never thrown; each"},{"type":"text","text":" "},{"type":"text","text":"has a human-readable "},{"type":"codeVoice","code":"message"},{"type":"text","text":":"}]},{"type":"codeListing","code":["for diagnostic in diagnostics {","    print(diagnostic.message)","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Unrecoverable problems are thrown as an "},{"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLParser\/Error","isActive":true},{"type":"text","text":" — a malformed ZIP"},{"type":"text","text":" "},{"type":"text","text":"container ("},{"type":"codeVoice","code":"noRootFileFound"},{"type":"text","text":", "},{"type":"codeVoice","code":"invalidRootFileMediaType(_:)"},{"type":"text","text":") or an XML body"},{"type":"text","text":" "},{"type":"text","text":"that will not parse at all ("},{"type":"codeVoice","code":"parseFailure(_:)"},{"type":"text","text":"). Like all IvorMXL errors"},{"type":"text","text":" "},{"type":"text","text":"it conforms to "},{"type":"codeVoice","code":"EnhancedError"},{"type":"text","text":" and provides a "},{"type":"codeVoice","code":"message"},{"type":"text","text":":"}]},{"type":"codeListing","code":["do {","    let (document, _) = try MXLParser().parse(data, compressed: true)","} catch let error as MXLParser.Error {","    print(error.message)","}"],"syntax":"swift"},{"type":"heading","anchor":"Normalizing","level":2,"text":"Normalizing"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNormalizer","isActive":true},{"type":"text","text":" migrates a document to the most recent supported MusicXML"},{"type":"text","text":" "},{"type":"text","text":"version, returning a new document whose "},{"code":"isNormalized","type":"codeVoice"},{"type":"text","text":" flag is "},{"type":"codeVoice","code":"true"},{"type":"text","text":", together"},{"type":"text","text":" "},{"type":"text","text":"with a list of the changes it applied:"}],"type":"paragraph"},{"code":["let (normalized, changes) = MXLNormalizer().normalize(parsed)","","for change in changes {","    print(change.message)","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDocument\/Version","isActive":true},{"text":" lists all six supported versions (1.0 through 4.0);","type":"text"},{"text":" ","type":"text"},{"code":".current","type":"codeVoice"},{"text":" is the migration target. A part-wise score enters an ordered chain","type":"text"},{"text":" ","type":"text"},{"text":"of per-version passes at its declared version and is stamped with the current","type":"text"},{"text":" ","type":"text"},{"text":"version on the way out. The passes are ","type":"text"},{"inlineContent":[{"type":"text","text":"derived by diffing the six vendored"},{"type":"text","text":" "},{"type":"text","text":"schemas"}],"type":"strong"},{"text":" rather than written from memory — the 1.0 and 1.1 DTDs and the 2.0–4.0","type":"text"},{"text":" ","type":"text"},{"text":"XSDs — and applied as an additive record of deprecations. Each","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNormalizer\/Change","isActive":true},{"text":" case names what moved: ","type":"text"},{"code":"upgradedVersion(_:_:)","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"renamedElement(_:_:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"replacedConstruct(_:_:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"suppliedDefault(_:_:)","type":"codeVoice"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"code":"convertedToPartwise","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A ","type":"text"},{"inlineContent":[{"type":"text","text":"time-wise score is converted to part-wise"}],"type":"strong"},{"text":" as its first migration step —","type":"text"},{"text":" ","type":"text"},{"text":"the two encodings are isomorphic in musical content — so a normalized document","type":"text"},{"text":" ","type":"text"},{"text":"is never time-wise. An opus has no migration passes — the opus schema has never","type":"text"},{"text":" ","type":"text"},{"text":"changed structurally — but it does take the same closing version stamp, applied","type":"text"},{"text":" ","type":"text"},{"text":"at every level of nesting. Because a content-changing normalization can","type":"text"},{"text":" ","type":"text"},{"text":"invalidate a prior validation, normalizing clears ","type":"text"},{"code":"isValidated","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"IvorMXL has ","type":"text"},{"inlineContent":[{"type":"text","text":"no born-normalized fast path"}],"type":"strong"},{"text":": the parser never pre-sets","type":"text"},{"text":" ","type":"text"},{"code":"isNormalized","type":"codeVoice"},{"text":", so every document goes through the normalizer at least once.","type":"text"},{"text":" ","type":"text"},{"text":"Detecting an already-canonical document would mean proving no","type":"text"},{"text":" ","type":"text"},{"text":"migration-triggering construct appears anywhere in it — the declared ","type":"text"},{"code":"version","type":"codeVoice"},{"text":" ","type":"text"},{"text":"is asserted by the file, never verified, so a document may claim ","type":"text"},{"code":"4.0","type":"codeVoice"},{"text":" and still","type":"text"},{"text":" ","type":"text"},{"text":"contain a 2.0-era deprecated element. Over-reporting is harmless (a pass that","type":"text"},{"text":" ","type":"text"},{"text":"makes no changes) while under-reporting silently skips a migration, so the check","type":"text"},{"text":" ","type":"text"},{"text":"would have to be exhaustive to be safe — which costs more than the pass it would","type":"text"},{"text":" ","type":"text"},{"text":"skip.","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Validating","anchor":"Validating","level":2},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValidator","isActive":true},{"text":" checks a ","type":"text"},{"inlineContent":[{"type":"text","text":"normalized"}],"type":"strong"},{"text":" document:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let (validated, issues) = try MXLValidator().validate(normalized)","","if issues.isEmpty {","    \/\/ `validated.isValidated` is now true.","} else {","    issues.forEach { print($0.message) }","}"]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If the document has not been normalized, "},{"code":"validate(_:)","type":"codeVoice"},{"type":"text","text":" throws"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValidator\/Error\/notNormalized","isActive":true},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An opus passes straight through, marked validated with no issues: its schema"},{"type":"text","text":" "},{"type":"text","text":"is four elements and the parser already enforces nearly everything they"},{"type":"text","text":" "},{"type":"text","text":"constrain, so there is nothing left to check."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If any issues are found, the returned document is the "},{"inlineContent":[{"text":"input unchanged","type":"text"}],"type":"strong"},{"type":"text","text":" "},{"type":"text","text":"(its "},{"code":"isValidated","type":"codeVoice"},{"type":"text","text":" flag stays "},{"code":"false","type":"codeVoice"},{"type":"text","text":"). Fix the issues — or run it through"},{"type":"text","text":" "},{"type":"text","text":"the normalizer again after editing — and validate again."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Only when the issues array is empty does the returned document have"},{"type":"text","text":" "},{"code":"isValidated == true","type":"codeVoice"},{"type":"text","text":" — the prerequisite for formatting."}]}]}]},{"inlineContent":[{"text":"A time-wise score is validated in its part-wise encoding. The","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValidator\/Issue","isActive":true},{"text":" catalogue covers the","type":"text"},{"text":" ","type":"text"},{"text":"cross-references the schema cannot express on its own: a ","type":"text"},{"code":"<part>","type":"codeVoice"},{"text":" whose ","type":"text"},{"code":"id","type":"codeVoice"},{"text":" ","type":"text"},{"text":"names no ","type":"text"},{"code":"<score-part>","type":"codeVoice"},{"text":" (","type":"text"},{"code":"danglingPartID(_:)","type":"codeVoice"},{"text":"), a ","type":"text"},{"code":"<score-part>","type":"codeVoice"},{"text":" no ","type":"text"},{"code":"<part>","type":"codeVoice"},{"text":" ","type":"text"},{"text":"realizes (","type":"text"},{"code":"unusedScorePart(_:)","type":"codeVoice"},{"text":"), a durational element before the first","type":"text"},{"text":" ","type":"text"},{"code":"<divisions>","type":"codeVoice"},{"text":" (","type":"text"},{"code":"durationBeforeDivisions(part:measure:)","type":"codeVoice"},{"text":"), an ","type":"text"},{"code":"<ending>","type":"codeVoice"},{"text":" start","type":"text"},{"text":" ","type":"text"},{"text":"with no stop (","type":"text"},{"code":"unmatchedEndingStart(number:part:measure:)","type":"codeVoice"},{"text":") or a stop with no","type":"text"},{"text":" ","type":"text"},{"text":"start (","type":"text"},{"code":"unmatchedEndingStop(number:part:measure:)","type":"codeVoice"},{"text":"), an unbalanced","type":"text"},{"text":" ","type":"text"},{"code":"<part-group>","type":"codeVoice"},{"text":" (","type":"text"},{"code":"unbalancedPartGroup(number:)","type":"codeVoice"},{"text":"), and an ","type":"text"},{"code":"<instrument-sound>","type":"codeVoice"},{"text":" ","type":"text"},{"text":"that is not one of the 894 standard sounds defined by MusicXML 4.0","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"unknownInstrumentSound(_:)","type":"codeVoice"},{"text":").","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Formatting","anchor":"Formatting","level":2},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFormatter","isActive":true},{"text":" serializes a ","type":"text"},{"inlineContent":[{"type":"text","text":"validated"}],"type":"strong"},{"text":" document back to MusicXML ","type":"text"},{"code":"Data","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"optionally as a compressed ","type":"text"},{"code":".mxl","type":"codeVoice"},{"text":" archive:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let xml = try MXLFormatter().format(validated, compressed: false)","let mxl = try MXLFormatter().format(validated, compressed: true)"]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If the document has not been validated, "},{"code":"format(_:compressed:)","type":"codeVoice"},{"type":"text","text":" throws"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFormatter\/Error\/notValidated","isActive":true},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The formatter writes "},{"inlineContent":[{"text":"part-wise scores and opus documents","type":"text"}],"type":"strong"},{"type":"text","text":" — both are"},{"type":"text","text":" "},{"type":"text","text":"document elements a MusicXML root file may have, and both can be written"},{"type":"text","text":" "},{"type":"text","text":"compressed. A time-wise document throws"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFormatter\/Error\/unsupportedTimewise","isActive":true},{"type":"text","text":" — but since the normalizer converts"},{"type":"text","text":" "},{"type":"text","text":"time-wise to part-wise, a normally-processed document never hits that case."}]}]}]},{"inlineContent":[{"text":"Because the AST is lossless, ","type":"text"},{"code":"parse → normalize → validate → format","type":"codeVoice"},{"text":" reproduces","type":"text"},{"text":" ","type":"text"},{"text":"the original document (modulo the version migration the normalizer applies and","type":"text"},{"text":" ","type":"text"},{"text":"settled whitespace canonicalization).","type":"text"}],"type":"paragraph"},{"type":"heading","text":"The AST model","anchor":"The-AST-model","level":2},{"inlineContent":[{"text":"The syntactic model is a tree of value types rooted at ","type":"text"},{"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDocument","isActive":true},{"text":":","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":null,"code":["MXLDocument","└─ content: MXLDocument.Content","   └─ .scorePartwise(MXLScorePartwise)","      ├─ partList: MXLPartList","      └─ parts:    [MXLScorePartwise.Part]","         └─ measures: [Measure]","            └─ items: [MXLMusicItem]   \/\/ .note, .attributes, .direction, …"]},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDocument\/Content-swift.enum","isActive":true},{"text":" is an enum over the three MusicXML document elements","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"opus","type":"codeVoice"},{"text":", ","type":"text"},{"code":"scorePartwise","type":"codeVoice"},{"text":", ","type":"text"},{"code":"scoreTimewise","type":"codeVoice"},{"text":"). The AST is","type":"text"},{"text":" ","type":"text"},{"text":"lossless — it records exactly what was written so it can round-trip through","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFormatter","isActive":true},{"text":" — and every leaf value is wrapped in a small validating type.","type":"text"},{"text":" ","type":"text"},{"text":"All AST types are ","type":"text"},{"code":"Equatable","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDocument","isActive":true},{"text":" equality and hashing compare ","type":"text"},{"code":"content","type":"codeVoice"},{"text":" only; the","type":"text"},{"text":" ","type":"text"},{"code":"isNormalized","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"isValidated","type":"codeVoice"},{"text":" flags are metadata and are excluded.","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Building a document programmatically","anchor":"Building-a-document-programmatically","level":2},{"inlineContent":[{"text":"You can construct the AST directly rather than parsing bytes:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let pitch    = MXLPitch(step: .c, octave: 4)","let fullNote = MXLFullNote(isChord: false, content: .pitch(pitch))","let note     = MXLNote(content: .regularNote(fullNote: fullNote,","                                             duration: 4,","                                             tie: []))","","let measure  = MXLScorePartwise.Part.Measure(number: \"1\", items: [.note(note)])","let part     = MXLScorePartwise.Part(id: \"P1\", measures: [measure])","let scorePart = MXLScorePart(id: \"P1\",","                             name: MXLPartName(value: \"Music\",","                                               text: MXLPartName.Text()))","let score    = MXLScorePartwise(partList: MXLPartList(items: [.scorePart(scorePart)]),","                                parts: [part])","let document = MXLDocument(content: .scorePartwise(score))"]},{"inlineContent":[{"text":"A directly-constructed document has ","type":"text"},{"code":"isNormalized == false","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"isValidated == false","type":"codeVoice"},{"text":" — exactly like one fresh out of the parser — so you must","type":"text"},{"text":" ","type":"text"},{"text":"run it through the normalizer and validator before formatting.","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Error handling","anchor":"Error-handling","level":2},{"inlineContent":[{"text":"Thrown errors conform to ","type":"text"},{"code":"EnhancedError","type":"codeVoice"},{"text":" (from","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"https:\/\/github.com\/eBardX\/XestiTools","isActive":true},{"text":"): each has a ","type":"text"},{"code":"category","type":"codeVoice"},{"text":" of","type":"text"},{"text":" ","type":"text"},{"code":"\"IvorMXL\"","type":"codeVoice"},{"text":" and a human-readable ","type":"text"},{"code":"message","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Type"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Thrown by"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLParser\/Error","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"MXLParser.parse(_:compressed:)"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValidator\/Error","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"MXLValidator.validate(_:)"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFormatter\/Error","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"MXLFormatter.format(_:compressed:)"}],"type":"paragraph"}]]],"alignments":["left","left"]},{"inlineContent":[{"code":"MXLNormalizer.normalize(_:)","type":"codeVoice"},{"text":" never throws — normalization has no failure mode,","type":"text"},{"text":" ","type":"text"},{"text":"since every version is migratable.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Non-fatal results are returned rather than thrown, and each also provides a","type":"text"},{"text":" ","type":"text"},{"code":"message","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Type"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Returned by"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLParser\/Diagnostic","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"parse(_:compressed:)"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNormalizer\/Change","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"normalize(_:)"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValidator\/Issue","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"validate(_:)"}],"type":"paragraph"}]]],"alignments":["left","left"