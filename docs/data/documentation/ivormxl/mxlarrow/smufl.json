{"abstract":[{"type":"text","text":"The smufl attribute group is used to indicate a particular Standard Music Font Layout (SMuFL) character."},{"type":"text","text":" "},{"type":"text","text":"Sometimes this is a formatting choice, and sometimes this is a refinement of the semantic meaning of an"},{"type":"text","text":" "},{"type":"text","text":"element."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"smufl"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLSmuflGlyphName","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSmuflGlyphName","preciseIdentifier":"s:7IvorMXL17MXLSmuflGlyphNameV"},{"kind":"text","text":"?"}],"platforms":["macOS"],"languages":["swift"]}]},{"content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"inlineContent":[{"text":"Maps to the MusicXML ","type":"text"},{"code":"smufl","type":"codeVoice"},{"text":" attribute.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArrow\/smufl"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArrow"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"paths":["\/documentation\/ivormxl\/mxlarrow\/smufl"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"modules":[{"name":"IvorMXL"}],"externalID":"s:7IvorMXL8MXLArrowV5smuflAA17MXLSmuflGlyphNameVSgvp","roleHeading":"Instance Property","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"smufl"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLSmuflGlyphName","preciseIdentifier":"s:7IvorMXL17MXLSmuflGlyphNameV"},{"kind":"text","text":"?"}],"title":"smufl","symbolKind":"property"},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLArrow/smufl":{"type":"topic","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArrow\/smufl","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"smufl","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLSmuflGlyphName","preciseIdentifier":"s:7IvorMXL17MXLSmuflGlyphNameV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"title":"smufl","url":"\/documentation\/ivormxl\/mxlarrow\/smufl","abstract":[{"type":"text","text":"The smufl attribute group is used to indicate a particular Standard Music Font Layout (SMuFL) character."},{"type":"text","text":" "},{"type":"text","text":"Sometimes this is a formatting choice, and sometimes this is a refinement of the semantic meaning of an"},{"type":"text","text":" "},{"type":"text","text":"element."}]},"doc://IvorMXL/documentation/IvorMXL/MXLSmuflGlyphName":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSmuflGlyphName","kind":"identifier"}],"title":"MXLSmuflGlyphName","abstract":[{"type":"text","text":"The smufl-glyph-name type is used for attributes that reference a specific Standard Music Font Layout (SMuFL)"},{"text":" ","type":"text"},{"type":"text","text":"character. The value is a SMuFL canonical glyph name, not a code point. For instance, the value for a standard"},{"type":"text","text":" "},{"text":"piano pedal mark would be keyboardPedalPed, not U+E650.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSmuflGlyphName","role":"symbol","url":"\/documentation\/ivormxl\/mxlsmuflglyphname","kind":"symbol","navigatorTitle":[{"text":"MXLSmuflGlyphName","kind":"identifier"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLArrow":{"type":"topic","title":"MXLArrow","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArrow","abstract":[{"type":"text","text":"The arrow element represents an arrow used for a musical technical indication. It can represent both Unicode"},{"type":"text","text":" "},{"type":"text","text":"and SMuFL arrows. The presence of an arrowhead element indicates that only the arrowhead is displayed, not the"},{"type":"text","text":" "},{"type":"text","text":"arrow stem. The smufl attribute distinguishes different SMuFL glyphs that have an arrow appearance such as"},{"type":"text","text":" "},{"type":"text","text":"arrowBlackUp, guitarStrumUp, or handbellsSwingUp. The specified glyph should match the descriptive"},{"type":"text","text":" "},{"type":"text","text":"representation."}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLArrow","kind":"identifier"}],"navigatorTitle":[{"text":"MXLArrow","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlarrow"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"}}}