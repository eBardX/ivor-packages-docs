mentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLArrow":{"url":"\/documentation\/ivormxl\/mxlarrow","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArrow","abstract":[{"type":"text","text":"The arrow element represents an arrow used for a musical technical indication. It can represent both Unicode"},{"type":"text","text":" "},{"type":"text","text":"and SMuFL arrows. The presence of an arrowhead element indicates that only the arrowhead is displayed, not the"},{"type":"text","text":" "},{"type":"text","text":"arrow stem. The smufl attribute distinguishes different SMuFL glyphs that have an arrow appearance such as"},{"type":"text","text":" "},{"type":"text","text":"arrowBlackUp, guitarStrumUp, or handbellsSwingUp. The specified glyph should match the descriptive"},{"type":"text","text":" "},{"type":"text","text":"representation."}],"title":"MXLArrow","kind":"symbol","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLArrow"}],"navigatorTitle":[{"kind":"identifier","text":"MXLArrow"}]},"doc://IvorMXL/documentation/IvorMXL/MXLArrow/smufl":{"kind":"symbol","abstract":[{"text":"The smufl attribute group is used to indicate a particular Standard Music Font Layout (SMuFL) character.","type":"text"},{"text":" ","type":"text"},{"text":"Sometimes this is a formatting choice, and sometimes this is a refinement of the semantic meaning of an","type":"text"},{"text":" ","type":"text"},{"text":"element.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlarrow\/smufl","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArrow\/smufl","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{