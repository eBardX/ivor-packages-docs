{"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"text":"Creates a new ","type":"text"},{"code":"MXLArrow","type":"codeVoice"},{"text":".","type":"text"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"content"},{"kind":"text","text":": "},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArrow\/Content-swift.enum","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLArrowV7ContentO","text":"Content"},{"kind":"text","text":", "},{"kind":"externalParam","text":"position"},{"kind":"text","text":": "},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLPositionV","text":"MXLPosition"},{"kind":"text","text":" = MXLPosition(), "},{"kind":"externalParam","text":"font"},{"kind":"text","text":": "},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL7MXLFontV","text":"MXLFont"},{"kind":"text","text":" = MXLFont(), "},{"kind":"externalParam","text":"color"},{"kind":"text","text":": "},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLColorV","text":"MXLColor"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"placement"},{"kind":"text","text":": "},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAboveBelow","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL13MXLAboveBelowO","text":"MXLAboveBelow"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"smufl"},{"kind":"text","text":": "},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSmuflGlyphName","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL17MXLSmuflGlyphNameV","text":"MXLSmuflGlyphName"},{"kind":"text","text":"? = nil)"}]}],"kind":"declarations"},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"One of the alternatives for Arrow."}]}],"name":"content"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For most elements, any program will compute a default x and y position. The position attributes let this be changed two ways."}]}],"name":"position"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The font attribute group gathers together attributes for determining the font within a credit or direction. They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font vs. a music font."}]}],"name":"font"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The color attribute group indicates the color of an element."}]}],"name":"color"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The placement attribute indicates whether something is above or below another element, such as a note or a notation."}]}],"name":"placement"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The smufl attribute group is used to indicate a particular Standard Music Font Layout (SMuFL) character. Sometimes this is a formatting choice, and sometimes this is a refinement of the semantic meaning of an element."}]}],"name":"smufl"}],"kind":"parameters"}],"metadata":{"roleHeading":"Initializer","title":"init(content:position:font:color:placement:smufl:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"content"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Content","preciseIdentifier":"s:7IvorMXL8MXLArrowV7ContentO"},{"kind":"text","text":", "},{"kind":"externalParam","text":"position"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLPosition","preciseIdentifier":"s:7IvorMXL11MXLPositionV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"font"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLFont","preciseIdentifier":"s:7IvorMXL7MXLFontV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"color"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLColorV","text":"MXLColor"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"placement"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLAboveBelow","preciseIdentifier":"s:7IvorMXL13MXLAboveBelowO"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"smufl"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL17MXLSmuflGlyphNameV","text":"MXLSmuflGlyphName"},{"kind":"text","text":"?)"}],"modules":[{"name":"IvorMXL"}],"role":"symbol","symbolKind":"init","externalID":"s:7IvorMXL8MXLArrowV7content8position4font5color9placement5smuflA2C7ContentO_AA11MXLPositionVAA7MXLFontVAA8MXLColorVSgAA13MXLAboveBelowOSgAA17MXLSmuflGlyphNameVSgtcfc"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArrow"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlarrow\/init(content:position:font:color:placement:smufl:)"]}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArrow\/init(content:position:font:color:placement:smufl:)","interfaceLanguage":"swift"},"sections":[],"kind":"symbol","references":{"doc://IvorMXL/documentation/IvorMXL/MXLArrow":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlarrow","title":"MXLArrow","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLArrow"}],"navigatorTitle":[{"kind":"identifier","text":"MXLArrow"}],"abstract":[{"type":"text","text":"The arrow element represents an arrow used for a musical technical indication. It can represent both Unicode"},{"type":"text","text":" "},{"type":"text","text":"and SMuFL arrows. The presence of an arrowhead element indicates that only the arrowhead is displayed, not the"},{"type":"text","text":" "},{"type":"text","text":"arrow stem. The smufl attribute distinguishes different SMuFL glyphs that have an arrow appearance such as"},{"type":"text","text":" "},{"type":"text","text":"arrowBlackUp, guitarStrumUp, or handbellsSwingUp. The specified glyph should match the descriptive"},{"type":"text","text":" "},{"type":"text","text":"representation."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArrow"},"doc://IvorMXL/documentation/IvorMXL/MXLFont":{"title":"MXLFont","url":"\/documentation\/ivormxl\/mxlfont","role":"symbol","navigatorTitle":[{"text":"MXLFont","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","abstract":[{"text":"The font attribute group gathers together attributes for determining the font within a credit or direction.","type":"text"},{"text":" ","type":"text"},{"text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric"},{"type":"text","text":" "},{"type":"text","text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font"},{"type":"text","text":" "},{"type":"text","text":"vs. a music font."}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLFont","kind":"identifier"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLPosition":{"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPosition","kind":"identifier"}],"title":"MXLPosition","navigatorTitle":[{"text":"MXLPosition","kind":"identifier"}],"abstract":[{"type":"text","text":"For most elements, any program will compute a default x and y position. The position attributes let this be"},{"type":"text","text":" "},{"type":"text","text":"changed two ways."}],"url":"\/documentation\/ivormxl\/mxlposition","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlcolor","title":"MXLColor","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"type":"text","text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is"},{"type":"text","text":" "},{"type":"text","text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor"},"doc://IvorMXL/documentation/IvorMXL/MXLSmuflGlyphName":{"type":"topic","title":"MXLSmuflGlyphName","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLSmuflGlyphName"}],"url":"\/documentation\/ivormxl\/mxlsmuflglyphname","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSmuflGlyphName","role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLSmuflGlyphName"}],"abstract":[{"type":"text","text":"The smufl-glyph-name type is used for attributes that reference a specific Standard Music Font Layout (SMuFL)"},{"type":"text","text":" "},{"type":"text","text":"character. The value is a SMuFL canonical glyph name, not a code point. For instance, the value for a standard"},{"type":"text","text":" "},{"type":"text","text":"piano pedal mark would be keyboardPedalPed, not U+E650."}]},"doc://IvorMXL/documentation/IvorMXL/MXLArrow/Content-swift.enum":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArrow\/Content-swift.enum","url":"\/documentation\/ivormxl\/mxlarrow\/content-swift.enum","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Content"}],"abstract":[{"type":"text","text":"One of the alternatives for Arrow."}],"navigatorTitle":[{"kind":"identifier","text":"Content"}],"title":"MXLArrow.Content","type":"topic","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLAboveBelow":{"title":"MXLAboveBelow","type":"topic","fragments":[{"kind":"keyword","text":"enum"},{"text":" ","kind":"text"},{"kind":"identifier","text":"MXLAboveBelow"}],"url":"\/documentation\/ivormxl\/mxlabovebelow","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAboveBelow","role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLAboveBelow"}],"abstract":[{"type":"text","text":"The above-below type is used to indicate whether one element appears above or below another element."}]},"doc://IvorMXL/documentation/IvorMXL/MXLArrow/init(content:position:font:color:placement:smufl:)":{"fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"content","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Content","preciseIdentifier":"s:7IvorMXL8MXLArrowV7ContentO","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"position","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLPosition","preciseIdentifier":"s:7IvorMXL11MXLPositionV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"font","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLFont","preciseIdentifier":"s:7IvorMXL7MXLFontV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"color","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLColor","preciseIdentifier":"s:7IvorMXL8MXLColorV","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"placement","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLAboveBelow","preciseIdentifier":"s:7IvorMXL13MXLAboveBelowO","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"smufl","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLSmuflGlyphName","preciseIdentifier":"s:7IvorMXL17MXLSmuflGlyphNameV","kind":"typeIdentifier"},{"text":"?)","kind":"text"}],"role":"symbol","title":"init(content:position:font:color:placement:smufl:)","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArrow\/init(content:position:font:color:placement:smufl:)","url":"\/documentation\/ivormxl\/mxlarrow\/init(content:position:font:color:placement:smufl:)","type":"topic","abstract":[{"text":"Creates a new ","type":"text"},{"code":"MXLArrow","type":"codeVoice"},{"text":".","type":"text"}],"kind":"symbol"}}}