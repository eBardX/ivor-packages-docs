{"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArrow","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArrow\/Style"]]},"metadata":{"roleHeading":"Case","modules":[{"name":"IvorMXL"}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"single"}],"symbolKind":"case","externalID":"s:7IvorMXL8MXLArrowV5StyleO6singleyA2EmF","title":"MXLArrow.Style.single","role":"symbol"},"abstract":[{"text":"A single arrow.","type":"text"}],"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"single"}],"languages":["swift"],"platforms":["macOS"]}]}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlarrow\/style\/single"]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArrow\/Style\/single"},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLArrow/Style":{"type":"topic","abstract":[{"type":"text","text":"The arrow-style type represents the style of an arrow, using Unicode arrow terminology. Filled and hollow"},{"type":"text","text":" "},{"type":"text","text":"arrows indicate polygonal single arrows. Paired arrows are duplicate single arrows in the same direction."},{"type":"text","text":" "},{"type":"text","text":"Combined arrows apply to double direction arrows like left right, indicating that an arrow in one direction"},{"type":"text","text":" "},{"type":"text","text":"should be combined with an arrow in the other direction."}],"url":"\/documentation\/ivormxl\/mxlarrow\/style","fragments":[{"kind":"keyword","text":"enum"},{"text":" ","kind":"text"},{"text":"Style","kind":"identifier"}],"kind":"symbol","title":"MXLArrow.Style","navigatorTitle":[{"text":"Style","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArrow\/Style","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLArrow":{"type":"topic","title":"MXLArrow","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArrow","abstract":[{"type":"text","text":"The arrow element represents an arrow used for a musical technical indication. It can represent both Unicode"},{"type":"text","text":" "},{"type":"text","text":"and SMuFL arrows. The presence of an arrowhead element indicates that only the arrowhead is displayed, not the"},{"type":"text","text":" "},{"type":"text","text":"arrow stem. The smufl attribute distinguishes different SMuFL glyphs that have an arrow appearance such as"},{"type":"text","text":" "},{"type":"text","text":"arrowBlackUp, guitarStrumUp, or handbellsSwingUp. The specified glyph should match the descriptive"},{"type":"text","text":" "},{"type":"text","text":"representation."}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLArrow","kind":"identifier"}],"navigatorTitle":[{"text":"MXLArrow","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlarrow"},"doc://IvorMXL/documentation/IvorMXL/MXLArrow/Style/single":{"type":"topic","abstract":[{"text":"A single arrow.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlarrow\/style\/single","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"single","kind":"identifier"}],"kind":"symbol","title":"MXLArrow.Style.single","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArrow\/Style\/single","role":"symbol"}}}