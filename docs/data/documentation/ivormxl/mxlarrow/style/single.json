{"kind":"symbol","hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArrow","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArrow\/Style"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlarrow\/style\/single"]}],"metadata":{"title":"MXLArrow.Style.single","role":"symbol","modules":[{"name":"IvorMXL"}],"externalID":"s:7IvorMXL8MXLArrowV5StyleO6singleyA2EmF","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"single"}],"roleHeading":"Case","symbolKind":"case"},"abstract":[{"type":"text","text":"A single arrow."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"single"}],"languages":["swift"]}]}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArrow\/Style\/single","interfaceLanguage":"swift"},"sections":[],"references":{"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLArrow":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArrow","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLArrow"}],"abstract":[{"type":"text","text":"The arrow element represents an arrow used for a musical technical indication. It can represent both Unicode"},{"type":"text","text":" "},{"type":"text","text":"and SMuFL arrows. The presence of an arrowhead element indicates that only the arrowhead is displayed, not the"},{"type":"text","text":" "},{"type":"text","text":"arrow stem. The smufl attribute distinguishes different SMuFL glyphs that have an arrow appearance such as"},{"type":"text","text":" "},{"type":"text","text":"arrowBlackUp, guitarStrumUp, or handbellsSwingUp. The specified glyph should match the descriptive"},{"type":"text","text":" "},{"type":"text","text":"representation."}],"kind":"symbol","title":"MXLArrow","url":"\/documentation\/ivormxl\/mxlarrow","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLArrow"}]},"doc://IvorMXL/documentation/IvorMXL/MXLArrow/Style":{"type":"topic","abstract":[{"text":"The arrow-style type represents the style of an arrow, using Unicode arrow terminology. Filled and hollow","type":"text"},{"text":" ","type":"text"},{"text":"arrows indicate polygonal single arrows. Paired arrows are duplicate single arrows in the same direction.","type":"text"},{"text":" ","type":"text"},{"text":"Combined arrows apply to double direction arrows like left right, indicating that an arrow in one direction","type":"text"},{"text":" ","type":"text"},{"text":"should be combined with an arrow in the other direction.","type":"text"}],"kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Style"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArrow\/Style","url":"\/documentation\/ivormxl\/mxlarrow\/style","title":"MXLArrow.Style","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Style"}]},"doc://IvorMXL/documentation/IvorMXL/MXLArrow/Style/single":{"kind":"symbol","title":"MXLArrow.Style.single","url":"\/documentation\/ivormxl\/mxlarrow\/style\/single","abstract":[{"text":"A single arrow.","type":"text"}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"single"}],"type":"topic","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArrow\/Style\/single"}}}