{"kind":"symbol","variants":[{"paths":["\/documentation\/ivormxl\/mxlarrow\/style\/filled"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"A polygonal single arrow with a filled head."}],"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArrow\/Style\/filled"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArrow","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArrow\/Style"]]},"metadata":{"externalID":"s:7IvorMXL8MXLArrowV5StyleO6filledyA2EmF","modules":[{"name":"IvorMXL"}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"filled"}],"roleHeading":"Case","role":"symbol","title":"MXLArrow.Style.filled","symbolKind":"case"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"filled"}],"languages":["swift"]}]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLArrow/Style/filled":{"kind":"symbol","abstract":[{"type":"text","text":"A polygonal single arrow with a filled head."}],"url":"\/documentation\/ivormxl\/mxlarrow\/style\/filled","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArrow\/Style\/filled","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"filled"}],"type":"topic","role":"symbol","title":"MXLArrow.Style.filled"},"doc://IvorMXL/documentation/IvorMXL/MXLArrow/Style":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArrow\/Style","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Style"}],"type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Style"}],"abstract":[{"type":"text","text":"The arrow-style type represents the style of an arrow, using Unicode arrow terminology. Filled and hollow"},{"type":"text","text":" "},{"type":"text","text":"arrows indicate polygonal single arrows. Paired arrows are duplicate single arrows in the same direction."},{"type":"text","text":" "},{"type":"text","text":"Combined arrows apply to double direction arrows like left right, indicating that an arrow in one direction"},{"type":"text","text":" "},{"type":"text","text":"should be combined with an arrow in the other direction."}],"url":"\/documentation\/ivormxl\/mxlarrow\/style","title":"MXLArrow.Style"},"doc://IvorMXL/documentation/IvorMXL/MXLArrow":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlarrow","title":"MXLArrow","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLArrow"}],"navigatorTitle":[{"kind":"identifier","text":"MXLArrow"}],"abstract":[{"type":"text","text":"The arrow element represents an arrow used for a musical technical indication. It can represent both Unicode"},{"type":"text","text":" "},{"type":"text","text":"and SMuFL arrows. The presence of an arrowhead element indicates that only the arrowhead is displayed, not the"},{"type":"text","text":" "},{"type":"text","text":"arrow stem. The smufl attribute distinguishes different SMuFL glyphs that have an arrow appearance such as"},{"type":"text","text":" "},{"type":"text","text":"arrowBlackUp, guitarStrumUp, or handbellsSwingUp. The specified glyph should match the descriptive"},{"type":"text","text":" "},{"type":"text","text":"representation."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArrow"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]}}}