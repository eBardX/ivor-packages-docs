{"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArrow","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArrow\/Style"]]},"metadata":{"role":"symbol","modules":[{"name":"IvorMXL"}],"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"hollow","kind":"identifier"}],"symbolKind":"case","externalID":"s:7IvorMXL8MXLArrowV5StyleO6hollowyA2EmF","title":"MXLArrow.Style.hollow","roleHeading":"Case"},"abstract":[{"type":"text","text":"A polygonal single arrow with a hollow head."}],"sections":[],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"hollow","kind":"identifier"}],"platforms":["macOS"]}],"kind":"declarations"}],"kind":"symbol","variants":[{"paths":["\/documentation\/ivormxl\/mxlarrow\/style\/hollow"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArrow\/Style\/hollow","interfaceLanguage":"swift"},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLArrow":{"type":"topic","title":"MXLArrow","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArrow","abstract":[{"type":"text","text":"The arrow element represents an arrow used for a musical technical indication. It can represent both Unicode"},{"type":"text","text":" "},{"type":"text","text":"and SMuFL arrows. The presence of an arrowhead element indicates that only the arrowhead is displayed, not the"},{"type":"text","text":" "},{"type":"text","text":"arrow stem. The smufl attribute distinguishes different SMuFL glyphs that have an arrow appearance such as"},{"type":"text","text":" "},{"type":"text","text":"arrowBlackUp, guitarStrumUp, or handbellsSwingUp. The specified glyph should match the descriptive"},{"type":"text","text":" "},{"type":"text","text":"representation."}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLArrow","kind":"identifier"}],"navigatorTitle":[{"text":"MXLArrow","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlarrow"},"doc://IvorMXL/documentation/IvorMXL/MXLArrow/Style/hollow":{"type":"topic","abstract":[{"type":"text","text":"A polygonal single arrow with a hollow head."}],"url":"\/documentation\/ivormxl\/mxlarrow\/style\/hollow","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"hollow"}],"kind":"symbol","title":"MXLArrow.Style.hollow","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArrow\/Style\/hollow","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLArrow/Style":{"type":"topic","abstract":[{"type":"text","text":"The arrow-style type represents the style of an arrow, using Unicode arrow terminology. Filled and hollow"},{"type":"text","text":" "},{"type":"text","text":"arrows indicate polygonal single arrows. Paired arrows are duplicate single arrows in the same direction."},{"type":"text","text":" "},{"type":"text","text":"Combined arrows apply to double direction arrows like left right, indicating that an arrow in one direction"},{"type":"text","text":" "},{"type":"text","text":"should be combined with an arrow in the other direction."}],"url":"\/documentation\/ivormxl\/mxlarrow\/style","fragments":[{"kind":"keyword","text":"enum"},{"text":" ","kind":"text"},{"text":"Style","kind":"identifier"}],"kind":"symbol","title":"MXLArrow.Style","navigatorTitle":[{"text":"Style","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArrow\/Style","role":"symbol"}}}