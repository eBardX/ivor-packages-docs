{"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","metadata":{"roleHeading":"Case","externalID":"s:7IvorMXL8MXLArrowV5StyleO6hollowyA2EmF","symbolKind":"case","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"hollow","kind":"identifier"}],"role":"symbol","title":"MXLArrow.Style.hollow","modules":[{"name":"IvorMXL"}]},"sections":[],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"hollow","kind":"identifier"}]}],"kind":"declarations"}],"abstract":[{"type":"text","text":"A polygonal single arrow with a hollow head."}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArrow","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArrow\/Style"]]},"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArrow\/Style\/hollow","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/ivormxl\/mxlarrow\/style\/hollow"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLArrow/Style":{"url":"\/documentation\/ivormxl\/mxlarrow\/style","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArrow\/Style","abstract":[{"type":"text","text":"The arrow-style type represents the style of an arrow, using Unicode arrow terminology. Filled and hollow"},{"type":"text","text":" "},{"type":"text","text":"arrows indicate polygonal single arrows. Paired arrows are duplicate single arrows in the same direction."},{"type":"text","text":" "},{"type":"text","text":"Combined arrows apply to double direction arrows like left right, indicating that an arrow in one direction"},{"type":"text","text":" "},{"type":"text","text":"should be combined with an arrow in the other direction."}],"title":"MXLArrow.Style","kind":"symbol","role":"symbol","type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"Style"}],"navigatorTitle":[{"kind":"identifier","text":"Style"}]},"doc://IvorMXL/documentation/IvorMXL/MXLArrow":{"url":"\/documentation\/ivormxl\/mxlarrow","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArrow","abstract":[{"type":"text","text":"The arrow element represents an arrow used for a musical technical indication. It can represent both Unicode"},{"type":"text","text":" "},{"type":"text","text":"and SMuFL arrows. The presence of an arrowhead element indicates that only the arrowhead is displayed, not the"},{"type":"text","text":" "},{"type":"text","text":"arrow stem. The smufl attribute distinguishes different SMuFL glyphs that have an arrow appearance such as"},{"type":"text","text":" "},{"type":"text","text":"arrowBlackUp, guitarStrumUp, or handbellsSwingUp. The specified glyph should match the descriptive"},{"type":"text","text":" "},{"type":"text","text":"representation."}],"title":"MXLArrow","kind":"symbol","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLArrow"}],"navigatorTitle":[{"kind":"identifier","text":"MXLArrow"}]},"doc://IvorMXL/documentation/IvorMXL/MXLArrow/Style/hollow":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlarrow\/style\/hollow","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArrow\/Style\/hollow","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"hollow","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"A polygonal single arrow with a hollow head.","type":"text"}],"type":"topic","title":"MXLArrow.Style.hollow"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"}}}