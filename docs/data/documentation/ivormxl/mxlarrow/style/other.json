{"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","metadata":{"modules":[{"name":"IvorMXL"}],"roleHeading":"Case","symbolKind":"case","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"other"}],"role":"symbol","title":"MXLArrow.Style.other","externalID":"s:7IvorMXL8MXLArrowV5StyleO5otheryA2EmF"},"sections":[],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"other"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"}],"abstract":[{"type":"text","text":"An arrow style other than those listed here."}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArrow","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArrow\/Style"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArrow\/Style\/other"},"variants":[{"paths":["\/documentation\/ivormxl\/mxlarrow\/style\/other"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLArrow/Style":{"url":"\/documentation\/ivormxl\/mxlarrow\/style","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArrow\/Style","abstract":[{"type":"text","text":"The arrow-style type represents the style of an arrow, using Unicode arrow terminology. Filled and hollow"},{"type":"text","text":" "},{"type":"text","text":"arrows indicate polygonal single arrows. Paired arrows are duplicate single arrows in the same direction."},{"type":"text","text":" "},{"type":"text","text":"Combined arrows apply to double direction arrows like left right, indicating that an arrow in one direction"},{"type":"text","text":" "},{"type":"text","text":"should be combined with an arrow in the other direction."}],"title":"MXLArrow.Style","kind":"symbol","role":"symbol","type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"Style"}],"navigatorTitle":[{"kind":"identifier","text":"Style"}]},"doc://IvorMXL/documentation/IvorMXL/MXLArrow":{"url":"\/documentation\/ivormxl\/mxlarrow","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArrow","abstract":[{"type":"text","text":"The arrow element represents an arrow used for a musical technical indication. It can represent both Unicode"},{"type":"text","text":" "},{"type":"text","text":"and SMuFL arrows. The presence of an arrowhead element indicates that only the arrowhead is displayed, not the"},{"type":"text","text":" "},{"type":"text","text":"arrow stem. The smufl attribute distinguishes different SMuFL glyphs that have an arrow appearance such as"},{"type":"text","text":" "},{"type":"text","text":"arrowBlackUp, guitarStrumUp, or handbellsSwingUp. The specified glyph should match the descriptive"},{"type":"text","text":" "},{"type":"text","text":"representation."}],"title":"MXLArrow","kind":"symbol","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLArrow"}],"navigatorTitle":[{"kind":"identifier","text":"MXLArrow"}]},"doc://IvorMXL/documentation/IvorMXL/MXLArrow/Style/other":{"type":"topic","abstract":[{"text":"An arrow style other than those listed here.","type":"text"}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"text":"other","kind":"identifier"}],"role":"symbol","title":"MXLArrow.Style.other","url":"\/documentation\/ivormxl\/mxlarrow\/style\/other","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArrow\/Style\/other","kind":"symbol"}}}