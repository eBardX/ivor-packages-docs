rMXL/documentation/IvorMXL/MXLArrow":{"abstract":[{"text":"The arrow element represents an arrow used for a musical technical indication. It can represent both Unicode","type":"text"},{"text":" ","type":"text"},{"text":"and SMuFL arrows. The presence of an arrowhead element indicates that only the arrowhead is displayed, not the","type":"text"},{"text":" ","type":"text"},{"text":"arrow stem. The smufl attribute distinguishes different SMuFL glyphs that have an arrow appearance such as","type":"text"},{"text":" ","type":"text"},{"text":"arrowBlackUp, guitarStrumUp, or handbellsSwingUp. The specified glyph should match the descriptive","type":"text"},{"text":" ","type":"text"},{"text":"representation.","type":"text"}],"title":"MXLArrow","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLArrow"}],"navigatorTitle":[{"text":"MXLArrow","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlarrow","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArrow"}}}