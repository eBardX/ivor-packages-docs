//IvorMXL/documentation/IvorMXL/MXLArrow":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArrow","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLArrow"}],"abstract":[{"type":"text","text":"The arrow element represents an arrow used for a musical technical indication. It can represent both Unicode"},{"type":"text","text":" "},{"type":"text","text":"and SMuFL arrows. The presence of an arrowhead element indicates that only the arrowhead is displayed, not the"},{"type":"text","text":" "},{"type":"text","text":"arrow stem. The smufl attribute distinguishes different SMuFL glyphs that have an arrow appearance such as"},{"type":"text","text":" "},{"type":"text","text":"arrowBlackUp, guitarStrumUp, or handbellsSwingUp. The specified glyph should match the descriptive"},{"type":"text","text":" "},{"type":"text","text":"representation."}],"kind":"symbol","title":"MXLArrow","url":"\/documentation\/ivormxl\/mxlarrow","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLArrow"}]},"doc://IvorMXL/documentation/IvorMXL/MXLArrow/Style/!=(_:_:)":{"url":"\/documentation\/ivormxl\/mxlarrow\/style\/!=(_:_:)","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArrow\/Style\/!=(_:_:)","role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"!=","kind":"identifier"},{"text":" ","kind":"text"},{"text":"(","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"kind":"symbol","title":"!=(_:_:)","type":"topic","abstract":[]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLArrow/Style":{"type":"topic","abstract":[{"text":"The arrow-style type represents the style of an arrow, using Unicode arrow terminology. Filled and hollow","type":"text"},{"text":" ","type":"text"},{"text":"arrows indicate polygonal single arrows. Paired arrows are duplicate single arrows in the same direction.","type":"text"},{"text":" ","type":"text"},{"text":"Combined arrows apply to double direction arrows like left right, indicating that an arrow in one direction","type":"text"},{"text":" ","type":"text"},{"text":"should be combined with an arrow in the other direction.","type":"text"}],"kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Style"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArrow\/Style","url":"\/documentation\/ivormxl\/mxlarrow\/style","title":"MXLArrow.Style","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Style"}]}}}