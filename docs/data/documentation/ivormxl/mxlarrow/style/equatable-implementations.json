rowhead is displayed, not the"},{"type":"text","text":" "},{"type":"text","text":"arrow stem. The smufl attribute distinguishes different SMuFL glyphs that have an arrow appearance such as"},{"type":"text","text":" "},{"type":"text","text":"arrowBlackUp, guitarStrumUp, or handbellsSwingUp. The specified glyph should match the descriptive"},{"type":"text","text":" "},{"type":"text","text":"representation."}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLArrow","kind":"identifier"}],"navigatorTitle":[{"text":"MXLArrow","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlarrow"},"doc://IvorMXL/documentation/IvorMXL/MXLArrow/Style":{"type":"topic","abstract":[{"type":"text","text":"The arrow-style type represents the style of an arrow, using Unicode arrow terminology. Filled and hollow"},{"type":"text","text":" "},{"type":"text","text":"arrows indicate polygonal single arrows. Paired arrows are duplicate single arrows in the same direction."},{"type":"text","text":" "},{"type":"text","text":"Combined arrows apply to double direction arrows like left right, indicating that an arrow in one direction"},{"type":"text","text":" "},{"type":"text","text":"should be combined with an arrow in the other direction."}],"url":"\/documentation\/ivormxl\/mxlarrow\/style","fragments":[{"kind":"keyword","text":"enum"},{"text":" ","kind":"text"},{"text":"Style","kind":"identifier"}],"kind":"symbol","title":"MXLArrow.Style","navigatorTitle":[{"text":"Style","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArrow\/Style","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"}}}