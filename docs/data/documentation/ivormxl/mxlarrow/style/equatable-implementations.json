{"kind":"article","variants":[{"paths":["\/documentation\/ivormxl\/mxlarrow\/style\/equatable-implementations"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArrow","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArrow\/Style"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArrow\/Style\/Equatable-Implementations"},"topicSections":[{"generated":true,"title":"Operators","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArrow\/Style\/!=(_:_:)"],"anchor":"Operators"}],"metadata":{"roleHeading":"API Collection","title":"Equatable Implementations","role":"collectionGroup","modules":[{"name":"IvorMXL"}]},"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLArrow":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlarrow","title":"MXLArrow","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLArrow"}],"navigatorTitle":[{"kind":"identifier","text":"MXLArrow"}],"abstract":[{"type":"text","text":"The arrow element represents an arrow used for a musical technical indication. It can represent both Unicode"},{"type":"text","text":" "},{"type":"text","text":"and SMuFL arrows. The presence of an arrowhead element indicates that only the arrowhead is displayed, not the"},{"type":"text","text":" "},{"type":"text","text":"arrow stem. The smufl attribute distinguishes different SMuFL glyphs that have an arrow appearance such as"},{"type":"text","text":" "},{"type":"text","text":"arrowBlackUp, guitarStrumUp, or handbellsSwingUp. The specified glyph should match the descriptive"},{"type":"text","text":" "},{"type":"text","text":"representation."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArrow"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLArrow/Style":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArrow\/Style","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Style"}],"type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Style"}],"abstract":[{"type":"text","text":"The arrow-style type represents the style of an arrow, using Unicode arrow terminology. Filled and hollow"},{"type":"text","text":" "},{"type":"text","text":"arrows indicate polygonal single arrows. Paired arrows are duplicate single arrows in the same direction."},{"type":"text","text":" "},{"type":"text","text":"Combined arrows apply to double direction arrows like left right, indicating that an arrow in one direction"},{"type":"text","text":" "},{"type":"text","text":"should be combined with an arrow in the other direction."}],"url":"\/documentation\/ivormxl\/mxlarrow\/style","title":"MXLArrow.Style"},"doc://IvorMXL/documentation/IvorMXL/MXLArrow/Style/!=(_:_:)":{"kind":"symbol","abstract":[],"type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"!="},{"kind":"text","text":" "},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"title":"!=(_:_:)","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArrow\/Style\/!=(_:_:)","url":"\/documentation\/ivormxl\/mxlarrow\/style\/!=(_:_:)"}}}