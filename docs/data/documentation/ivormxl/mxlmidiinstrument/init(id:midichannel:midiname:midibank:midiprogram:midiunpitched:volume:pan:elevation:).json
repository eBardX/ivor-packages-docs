xt":": ","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMidi128","text":"MXLMidi128","preciseIdentifier":"s:7IvorMXL10MXLMidi128V","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"midiUnpitched","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMidi128","text":"MXLMidi128","preciseIdentifier":"s:7IvorMXL10MXLMidi128V","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"volume","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPercent","text":"MXLPercent","preciseIdentifier":"s:7IvorMXL10MXLPercenta","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"pan","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRotationDegrees","text":"MXLRotationDegrees","preciseIdentifier":"s:7IvorMXL18MXLRotationDegreesa","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"elevation","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLRotationDegrees","preciseIdentifier":"s:7IvorMXL18MXLRotationDegreesa","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRotationDegrees","kind":"typeIdentifier"},{"text":"? = nil)","kind":"text"}]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The score-instrument affected by the change."}],"type":"paragraph"}],"name":"id"},{"content":[{"inlineContent":[{"text":"The midi-channel element specifies a MIDI 1.0 channel number ranging from 1 to 16.","type":"text"}],"type":"paragraph"}],"name":"midiChannel"},{"content":[{"inlineContent":[{"type":"text","text":"The midi-name element corresponds to a ProgramName meta-event within a Standard MIDI File."}],"type":"paragraph"}],"name":"midiName"},{"content":[{"inlineContent":[{"type":"text","text":"The midi-bank element specifies a MIDI 1.0 bank number ranging from 1 to 16,384."}],"type":"paragraph"}],"name":"midiBank"},{"content":[{"inlineContent":[{"type":"text","text":"The midi-program element specifies a MIDI 1.0 program number ranging from 1 to 128."}],"type":"paragraph"}],"name":"midiProgram"},{"content":[{"type":"paragraph","inlineContent":[{"text":"For unpitched instruments, the midi-unpitched element specifies a MIDI 1.0 note number ranging from 1 to 128. It is usually used with MIDI banks for percussion. Note that MIDI 1.0 note numbers are generally specified from 0 to 127 rather than the 1 to 128 numbering used in this element.","type":"text"}]}],"name":"midiUnpitched"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The volume element value is a percentage of the maximum ranging from 0 to 100, with decimal values allowed. This corresponds to a scaling value for the MIDI 1.0 channel volume controller.","type":"text"}]}],"name":"volume"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The pan and elevation elements allow placing of sound in a 3-D space relative to the listener. Both are expressed in degrees ranging from -180 to 180. For pan, 0 is straight ahead, -90 is hard left, 90 is hard right, and -180 and 180 are directly behind the listener.","type":"text"}]}],"name":"pan"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The elevation and pan elements allow placing of sound in a 3-D space relative to the listener. Both are expressed in degrees ranging from -180 to 180. For elevation, 0 is level with the listener, 90 is directly above, and -90 is directly below.","type":"text"}]}],"name":"elevation"}]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLMidi16":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMidi16","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLMidi16"}],"abstract":[{"text":"The midi-16 type is used to express MIDI 1.0 values that range from 1 to 16.","type":"text"}],"title":"MXLMidi16","kind":"symbol","url":"\/documentatio