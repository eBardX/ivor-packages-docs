/\/IvorMXL\/documentation\/IvorMXL\/MXLRotationDegrees","text":"MXLRotationDegrees"},{"kind":"text","text":"? = nil, "},{"text":"elevation","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLRotationDegrees","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL18MXLRotationDegreesa","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRotationDegrees"},{"text":"? = nil)","kind":"text"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The score-instrument affected by the change.","type":"text"}]}],"name":"id"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The midi-channel element specifies a MIDI 1.0 channel number ranging from 1 to 16.","type":"text"}]}],"name":"midiChannel"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The midi-name element corresponds to a ProgramName meta-event within a Standard MIDI File.","type":"text"}]}],"name":"midiName"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The midi-bank element specifies a MIDI 1.0 bank number ranging from 1 to 16,384.","type":"text"}]}],"name":"midiBank"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The midi-program element specifies a MIDI 1.0 program number ranging from 1 to 128.","type":"text"}]}],"name":"midiProgram"},{"content":[{"type":"paragraph","inlineContent":[{"text":"For unpitched instruments, the midi-unpitched element specifies a MIDI 1.0 note number ranging from 1 to 128. It is usually used with MIDI banks for percussion. Note that MIDI 1.0 note numbers are generally specified from 0 to 127 rather than the 1 to 128 numbering used in this element.","type":"text"}]}],"name":"midiUnpitched"},{"content":[{"inlineContent":[{"text":"The volume element value is a percentage of the maximum ranging from 0 to 100, with decimal values allowed. This corresponds to a scaling value for the MIDI 1.0 channel volume controller.","type":"text"}],"type":"paragraph"}],"name":"volume"},{"content":[{"inlineContent":[{"text":"The pan and elevation elements allow placing of sound in a 3-D space relative to the listener. Both are expressed in degrees ranging from -180 to 180. For pan, 0 is straight ahead, -90 is hard left, 90 is hard right, and -180 and 180 are directly behind the listener.","type":"text"}],"type":"paragraph"}],"name":"pan"},{"content":[{"inlineContent":[{"text":"The elevation and pan elements allow placing of sound in a 3-D space relative to the listener. Both are expressed in degrees ranging from -180 to 180. For elevation, 0 is level with the listener, 90 is directly above, and -90 is directly below.","type":"text"}],"type":"paragraph"}],"name":"elevation"}]}],"kind":"symbol","metadata":{"role":"symbol","externalID":"s:7IvorMXL17MXLMidiInstrumentV2id11midiChannel0F4Name0F4Bank0F7Program0F9Unpitched6volume3pan9elevationACSS_AA9MXLMidi16VSgSSSgAA12MXLMidi16384VSgAA10MXLMidi128VSgAVSdSgA2Wtcfc","roleHeading":"Initializer","title":"init(id:midiChannel:midiName:midiBank:midiProgram:midiUnpitched:volume:pan:elevation:)","modules":[{"name":"IvorMXL"}],"fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"midiChannel","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLMidi16","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLMidi16V"},{"text":"?, ","kind":"text"},{"text":"midiName","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?, ","kind":"text"},{"text":"midiBank","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLMidi16384","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL12MXLMidi16384V"},{"text":"?, ","kind":"text"},{"text":"midiProgram","kind":"externalParam"},{"text":": ","