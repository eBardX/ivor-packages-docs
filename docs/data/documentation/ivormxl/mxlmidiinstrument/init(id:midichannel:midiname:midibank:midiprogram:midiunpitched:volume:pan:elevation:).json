 midi-instrument type defines MIDI 1.0 instrument playback. The midi-instrument element can be a part of"},{"type":"text","text":" "},{"type":"text","text":"either the score-instrument element at the start of a part, or the sound element within a part. The id"},{"type":"text","text":" "},{"type":"text","text":"attribute refers to the score-instrument affected by the change."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLMidiInstrument"}],"title":"MXLMidiInstrument"},"doc://IvorMXL/documentation/IvorMXL/MXLRotationDegrees":{"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRotationDegrees","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLRotationDegrees","kind":"identifier"}],"kind":"symbol","title":"MXLRotationDegrees","role":"symbol","url":"\/documentation\/ivormxl\/mxlrotationdegrees","navigatorTitle":[{"text":"MXLRotationDegrees","kind":"identifier"}],"abstract":[{"text":"The rotation-degrees type specifies rotation, pan, and elevation values in degrees. Values range from -180 to","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"180."}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLMidi128":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlmidi128","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMidi128","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLMidi128","kind":"identifier"}],"abstract":[{"text":"The midi-128 type is used to express MIDI 1.0 values that range from 1 to 128.","type":"text"}],"kind":"symbol","type":"topic","navigatorTitle":[{"text":"MXLMidi128","kind":"identifier"}],"title":"MXLMidi128"},"doc://