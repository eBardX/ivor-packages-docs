:"paragraph","inlineContent":[{"type":"text","text":"The pan and elevation elements allow placing of sound in a 3-D space relative to the listener. Both are expressed in degrees ranging from -180 to 180. For pan, 0 is straight ahead, -90 is hard left, 90 is hard right, and -180 and 180 are directly behind the listener."}]}],"name":"pan"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The elevation and pan elements allow placing of sound in a 3-D space relative to the listener. Both are expressed in degrees ranging from -180 to 180. For elevation, 0 is level with the listener, 90 is directly above, and -90 is directly below."}]}],"name":"elevation"}],"kind":"parameters"}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMidiInstrument\/init(id:midiChannel:midiName:midiBank:midiProgram:midiUnpitched:volume:pan:elevation:)","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMidiInstrument"]]},"abstract":[{"type":"text","text":"Creates a new "},{"code":"MXLMidiInstrument","type":"codeVoice"},{"type":"text","text":"."}],"metadata":{"externalID":"s:7IvorMXL17MXLMidiInstrumentV2id11midiChannel0F4Name0F4Bank0F7Program0F9Unpitched6volume3pan9elevationACSS_AA9MXLMidi16VSgSSSgAA12MXLMidi16384VSgAA10MXLMidi128VSgAVSdSgA2Wtcfc","modules":[{"name":"IvorMXL"}],"roleHeading":"Initializer","role":"symbol","title":"init(id:midiChannel:midiName:midiBank:midiProgram:midiUnpitched:volume:pan:elevation:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"midiChannel","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLMidi16","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLMidi16V"},{"text":"?, ","kind":"text"},{"text":"midiName","kind":"externa