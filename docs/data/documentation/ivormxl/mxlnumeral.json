-swift.property","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/key-swift.property","type":"topic","role":"symbol","abstract":[{"text":"The key for the numeral, when it differs from the key specified by the key signature.","type":"text"}],"title":"key","kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"key","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL10MXLNumeralV3KeyV","text":"Key","kind":"typeIdentifier"},{"text":"?","kind":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLNumeral/root-swift.property":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/root-swift.property","title":"root","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"root"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL10MXLNumeralV4RootV","text":"Root"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlnumeral\/root-swift.property","kind":"symbol","role":"symbol","abstract":[{"text":"The Roman numeral or Nashville number part of the harmony.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLNumeral/Equatable-Implementations":{"url":"\/documentation\/ivormxl\/mxlnumeral\/equatable-implementations","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/Equatable-Implementations","type":"topic","role":"collectionGroup","abstract":[],"title":"Equatable Implementations","kind":"article"},"doc://IvorMXL/documentation/IvorMXL/MXLNumeral/Mode":{"title":"MXLNumeral.Mode","url":"\/documentation\/ivormxl\/mxlnumeral\/mode","abstract":[{"type":"text","text":"The numeral-mode type specifies the mode similar to the mode type, but with a restricted set of values. The"},{"type":"text","text":" "},{"type":"text","text":"different minor values are used to interpret numeral-root values of 6 and 7 when present in a minor key. The"},{"type":"text","text":" "},{"type":"text","text":"harmonic minor value sharpens the 7 and the melodic minor value sharpens both 6 and 7. If a minor mode is used"},{"type":"text","text":" "},{"type":"text","text":"without qualification, either in the mode or numeral-mode elements, natural minor is used."}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Mode"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Mode"}],"type":"topic","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/Mode"},"doc://IvorMXL/documentation/IvorMXL/MXLNumeral/alter":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"alter","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL15MXLHarmonyAlterV","text":"MXLHarmonyAlter","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/alter","type":"topic","role":"symbol","title":"alter","abstract":[{"text":"The numeral-alter element represents an alteration to the numeral-root, similar to the alter element for a","type":"text"},{"text":" ","type":"text"},{"text":"pitch. The print-object attribute can be used to hide an alteration in cases such as when the MusicXML","type":"text"},{"type":"text","text":" "},{"text":"encoding of a 6 or 7 numeral-root in a minor key requires an alteration that is not displayed. The location","type":"text"},{"type":"text","text":" "},{"text":"attribute indicates whether the alteration should appear to the left or the right of the numeral-root. It is","type":"text"},{"text":" ","type":"text"},{"text":"left by default.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlnumeral\/alter"}}}