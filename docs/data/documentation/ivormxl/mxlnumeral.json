orTitle":[{"kind":"identifier","text":"Key"}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/SH":{"title":"Swift.Hashable","identifier":"doc:\/\/IvorMXL\/SH","type":"unresolvable"},"doc://IvorMXL/documentation/IvorMXL/MXLNumeral/alter":{"kind":"symbol","url":"\/documentation\/ivormxl\/mxlnumeral\/alter","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/alter","role":"symbol","title":"alter","type":"topic","abstract":[{"type":"text","text":"The numeral-alter element represents an alteration to the numeral-root, similar to the alter element for a"},{"type":"text","text":" "},{"type":"text","text":"pitch. The print-object attribute can be used to hide an alteration in cases such as when the MusicXML"},{"type":"text","text":" "},{"type":"text","text":"encoding of a 6 or 7 numeral-root in a minor key requires an alteration that is not displayed. The location"},{"type":"text","text":" "},{"type":"text","text":"attribute indicates whether the alteration should appear to the left or the right of the numeral-root. It is"},{"type":"text","text":" "},{"type":"text","text":"left by default."}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"alter"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL15MXLHarmonyAlterV","text":"MXLHarmonyAlter"},{"kind":"text","text":"?"}]},"doc://IvorMXL/documentation/IvorMXL/MXLNumeral/Value":{"abstract":[{"text":"The numeral-value type represents a Roman numeral or Nashville number value as a positive integer from 1 to 7.","type":"text"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Value"}],"url":"\/documentation\/ivormxl\/mxlnumeral\/value","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Value"}],"title":"MXLNumeral.Value","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/Value","type":"topic"},"doc://IvorMXL/s8CopyableP":{"title":"Swift.Copyable","identifier":"doc:\/\/IvorMXL\/s8CopyableP","type":"unresolvable"},"doc://IvorMXL/documentation/IvorMXL/MXLNumeral/Mode":{"role":"symbol","navigatorTitle":[{"text":"Mode","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/Mode","url":"\/documentation\/ivormxl\/mxlnumeral\/mode","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Mode","kind":"identifier"}],"title":"MXLNumeral.Mode","type":"topic","abstract":[{"type":"text","text":"The numeral-mode type specifies the mode similar to the mode type, but with a restricted set of values. The"},{"type":"text","text":" "},{"type":"text","text":"different minor values are used to interpret numeral-root values of 6 and 7 when present in a minor key. The"},{"type":"text","text":" "},{"type":"text","text":"harmonic minor value sharpens the 7 and the melodic minor value sharpens both 6 and 7. If a minor mode is used"},{"type":"text","text":" "},{"type":"text","text":"without qualification, either in the mode or numeral-mode elements, natural minor is used."}]},"doc://IvorMXL/documentation/IvorMXL/MXLNumeral/key-swift.property":{"type":"topic","url":"\/documentation\/ivormxl\/mxlnumeral\/key-swift.property","role":"symbol","title":"key","abstract":[{"type":"text","text":"The key for the numeral, when it differs from the key specified by the key signature."}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/key-swift.property","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"key","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Key","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL10MXLNumeralV3KeyV