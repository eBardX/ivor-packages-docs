tent":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The optional-unique-id attribute group allows an element to optionally specify an ID that is unique to the entire document. This attribute group is not used for a required id attribute, or for an id attribute that specifies an id reference."}]}],"name":"id"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The frame-strings element gives the overall size of the frame in vertical lines (strings)."}]}],"name":"strings"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The frame-frets element gives the overall size of the frame in horizontal spaces (frets)."}]}],"name":"frets"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The fret shown in the top space of the frame. Fret 1 if not present."}]}],"name":"firstFret"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The individual notes included in the frame."}]}],"name":"note"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For most elements, any program will compute a default x and y position. The position attributes let this be changed two ways."}]}],"name":"position"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The color attribute group indicates the color of an element."}]}],"name":"color"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In cases where text extends over more than one line, horizontal alignment and justify values can be different. The most typical case is for credits, such as:"}]}],"name":"halign"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The valign-image attribute is used to indicate vertical alignment for images and graphics, so it removes the baseline value. Defaults are implementation-dependent."}]}],"name":"valign"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The height of the frame diagram."}]}],"name":