oc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValignImage","title":"MXLValignImage"},"doc://IvorMXL/documentation/IvorMXL/MXLFrame/Note-swift.struct":{"url":"\/documentation\/ivormxl\/mxlframe\/note-swift.struct","title":"MXLFrame.Note","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Note"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFrame\/Note-swift.struct","navigatorTitle":[{"kind":"identifier","text":"Note"}],"kind":"symbol","abstract":[{"text":"The frame-note type represents each note included in the frame. An open string will have a fret value of 0,","type":"text"},{"text":" ","type":"text"},{"text":"while a muted string will not be associated with a frame-note element.","type":"text"}],"type":"topic","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLTenths":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLTenths"}],"abstract":[{"type":"text","text":"The tenths type is a number representing tenths of interline staff space (positive or negative). Both integer"},{"type":"text","text":" "},{"type":"text","text":"and decimal values are allowed, such as 5 for a half space and 2.5 for a quarter space. Interline space is"},{"type":"text","text":" "},{"type":"text","text":"measured from the middle of a staff line."}],"kind":"symbol","title":"MXLTenths","url":"\/documentation\/ivormxl\/mxltenths","role":"symbol","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTenths"}]},"doc://IvorMXL/documentation/IvorMXL/MXLFirstFret":{"type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLFirstFret"}],"url":"\/documentation\/ivormxl\/mxlfirstfret","role":"symbol","abstract":[{"text":"The first-fret type indicates which fret is shown in the top space of the frame; it is fret 1 if the element","type":"text"},{"text":" ","type":"text"},{"text":"is not present. The optional text attribute indicates how this is represented in the fret diagram, while the","type":"text"},{"text":" ","type":"text"},{"text":"location attribute indicates whether the text appears to the left or right of the frame.","type":"text"}],"kind":"symbol","title":"MXLFirstFret","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFirstFret","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLFirstFret","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLFrame":{"role":"symbol","kind":"symbol","url":"\/documentation\/ivormxl\/mxlframe","title":"MXLFrame","abstract":[{"type":"text","text":"The frame type represents a frame or fretboard diagram used together with a chord symbol. The representation"},{"type":"text","text":" "},{"type":"text","text":"is based on the NIFF guitar grid with additional information. The frame type’s unplayed attribute indicates"},{"type":"text","text":" "},{"type":"text","text":"what to display above a string that has no associated frame-note element. Typical values are x and the empty"},{"type":"text","text":" "},{"type":"text","text":"string. If the attribute is not present, the display of the unplayed string is application-defined."}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLFrame","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFrame","navigatorTitle":[{"text":"MXLFrame","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLLeftCenterRight":{"type":"topic","kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLLeftCenterRight","kind":"identifier"}],"navigatorTitle":[{"text":"MXLLeftCenterRight","kind":"identifier"}],"abstract":[{"text":"The left-center-right type is used to define horizontal alignment and text justification.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLeftCenterRight","title":"MXLLeftCenterRight","role":"symbol","url":"\/documentation\/ivormxl\/mxlleftcenterright"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"}}}