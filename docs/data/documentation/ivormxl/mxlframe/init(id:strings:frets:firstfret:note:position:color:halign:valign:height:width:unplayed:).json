t":[{"type":"text","text":"The color attribute group indicates the color of an element."}]}]},{"name":"halign","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In cases where text extends over more than one line, horizontal alignment and justify"},{"type":"text","text":" "},{"type":"text","text":"values can be different."}]}]},{"name":"valign","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The valign-image attribute is used to indicate vertical alignment for images and"},{"type":"text","text":" "},{"type":"text","text":"graphics, so it removes the baseline value. Defaults are implementation-dependent."}]}]},{"name":"height","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The height of the frame diagram."}]}]},{"name":"width","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The width of the frame diagram."}]}]},{"name":"unplayed","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Indicates what to display above a string that has no associated frame-note element."},{"type":"text","text":" "},{"type":"text","text":"Typical values are "},{"type":"codeVoice","code":"x"},{"type":"text","text":" and the empty string. Application-defined if not present."}]}]}],"kind":"parameters"}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLPosition":{"type":"topic","abstract":[{"type":"text","text":"For most elements, any program will compute a default x and y position. The position attributes let this be"},{"type":"text","text":" "},{"type":"text","text":"changed two ways."}],"url":"\/documentation\/ivormxl\/mxlposition","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPosition"}],"kind":"symbol","title":"MXLPosition","navigatorTitle":[{"kind":"identifier","text":"MXLPosition"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"type":"topic","abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"type":"text","text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is"},{"type":"text","text":" "},{"type":"text","text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF."}],"url":"\/documentation\/ivormxl\/mxlcolor","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"kind":"symbol","title":"MXLColor","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLValignImage":{"kind":"symbol","abstract":[{"text":"The valign-image type is used to indicate vertical alignment for images and graphics, so it does not include a","type":"text"},{"text":" ","type":"text"},{"text":"baseline value. Defaults are implementation-dependent.","type":"text"}],"title":"MXLValignImage","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValignImage","navigatorTitle":[{"kind":"identifier","text":"MXLValignImage"}],"role":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxlvalignimage","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLValignImage"}]},"doc://IvorMXL/documentation/IvorMXL/MXLFrame/init(id:strings:frets:firstFret:note:position:color:halign:valign:height:width:unplayed:)":{"type":"topic","abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLFrame"},{"type":"text","text":"."}],"url":"\/documentation\/ivormxl\/mxlframe\/init(id:strings:frets:firstfret:note:position:color:halign:valign:height:width:unplayed:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"id"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"strings"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"frets"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"firstFret"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL12MXLFirstFretV","text":"MXLFirstFret"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"note"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLFrameV4NoteV","text":"Note"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"position"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLPositionV","text":"MXLPosition"},{"kind":"text","text":", "},{"kind":"externalParam","text":"color"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL8MXLColorV","text":"MXLColor","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"halign","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL18MXLLeftCenterRightO","text":"MXLLeftCenterRight","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"valign","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL14MXLValignImageO","text":"MXLValignImage","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"kind":"externalParam","text":"height"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLTenths","preciseIdentifier":"s:7IvorMXL9MXLTenthsa"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"width"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLTenthsa","text":"MXLTenths"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"unplayed"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"text":"?)","kind":"text"}],"kind":"symbol","title":"init(id:strings:frets:firstFret:note:position:color:halign:valign:height:width:unplayed:)","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFrame\/init(id:strings:frets:firstFret:note:position:color:halign:valign:height:width:unplayed:)","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLFirstFret":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFirstFret","navigatorTitle":[{"kind":"identifier","text":"MXLFirstFret"}],"url":"\/documentation\/ivormxl\/mxlfirstfret","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFirstFret"}],"title":"MXLFirstFret","abstract":[{"text":"The first-fret type indicates which fret is shown in the top space of the frame; it is fret 1 if the element","type":"text"},{"text":" ","type":"text"},{"text":"is not present. The optional text attribute indicates how this is represented in the fret diagram, while the","type":"text"},{"text":" ","type":"text"},{"text":"location attribute indicates whether the text appears to the left or right of the frame.","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLFrame":{"type":"topic","abstract":[{"text":"The frame type represents a frame or fretboard diagram used together with a chord symbol. The representation","type":"text"},{"text":" ","type":"text"},{"text":"is based on the NIFF guitar grid with additional information. The frame type’s unplayed attribute indicates","type":"text"},{"text":" ","type":"text"},{"text":"what to display above a string that has no associated frame-note element. Typical values are x and the empty","type":"text"},{"text":" ","type":"text"},{"text":"string. If the attribute is not present, the display of the unplayed string is application-defined.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlframe","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLFrame","kind":"identifier"}],"kind":"symbol","title":"MXLFrame","navigatorTitle":[{"text":"MXLFrame","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFrame","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLTenths":{"type":"topic","abstract":[{"type":"text","text":"The tenths type is a number representing tenths of interline staff space (positive or negative). Both integer"},{"type":"text","text":" "},{"type":"text","text":"and decimal values are allowed, such as 5 for a half space and 2.5 for a quarter space. Interline space is"},{"type":"text","text":" "},{"type":"text","text":"measured from the middle of a staff line."}],"url":"\/documentation\/ivormxl\/mxltenths","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTenths"}],"kind":"symbol","title":"MXLTenths","navigatorTitle":[{"kind":"identifier","text":"MXLTenths"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLLeftCenterRight":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLLeftCenterRight"}],"title":"MXLLeftCenterRight","abstract":[{"text":"The left-center-right type is used to define horizontal alignment and text justification.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLeftCenterRight","role":"symbol","url":"\/documentation\/ivormxl\/mxlleftcenterright","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLLeftCenterRight"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLFrame/Note-swift.struct":{"type":"topic","abstract":[{"text":"The frame-note type represents each note included in the frame. An open string will have a fret value of 0,","type":"text"},{"text":" ","type":"text"},{"text":"while a muted string will not be associated with a frame-note element.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlframe\/note-swift.struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Note"}],"kind":"symbol","title":"MXLFrame.Note","navigatorTitle":[{"kind":"identifier","text":"Note"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFrame\/Note-swift.struct","role":"symbol"}}}