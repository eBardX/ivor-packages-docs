"? = nil, ","kind":"text"},{"text":"unplayed","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"? = nil)","kind":"text"}],"platforms":["macOS"]}],"kind":"declarations"},{"parameters":[{"name":"id","content":[{"type":"paragraph","inlineContent":[{"text":"The optional-unique-id attribute group allows an element to optionally specify an ID that is unique to the entire document. This attribute group is not used for a required id attribute, or for an id attribute that specifies an id reference.","type":"text"}]}]},{"name":"strings","content":[{"inlineContent":[{"text":"The frame-strings element gives the overall size of the frame in vertical lines (strings).","type":"text"}],"type":"paragraph"}]},{"name":"frets","content":[{"inlineContent":[{"text":"The frame-frets element gives the overall size of the frame in horizontal spaces (frets).","type":"text"}],"type":"paragraph"}]},{"name":"firstFret","content":[{"inlineContent":[{"text":"The fret shown in the top space of the frame. Fret 1 if not present.","type":"text"}],"type":"paragraph"}]},{"name":"note","content":[{"inlineContent":[{"text":"The individual notes included in the frame.","type":"text"}],"type":"paragraph"}]},{"name":"position","content":[{"inlineContent":[{"text":"For most elements, any program will compute a default x and y position. The position attributes let this be changed two ways.","type":"text"}],"type":"paragraph"}]},{"name":"color","content":[{"inlineContent":[{"text":"The color attribute group indicates the color of an element.","type":"text"}],"type":"paragraph"}]},{"name":"halign","content":[{"inlineContent":[{"text":"In cases where text extends over more than one line, horizontal alignment and justify values can be different. The most typical case is for credits, such as:","type":"text"}],"type":"paragraph"}]},{"name":"valign","content":[{"inlineContent":[{"text":"The valign-image attribute is used to indicate vertical alignment for images and graphics, so it removes the baseline value. Defaults are implementation-dependent.","type":"text"}],"type":"paragraph"}]},{"name":"height","content":[{"inlineContent":[{"text":"The height of the frame diagram.","type":"text"}],"type":"paragraph"}]},{"name":"width","content":[{"inlineContent":[{"text":"The width of the frame diagram.","type":"text"}],"type":"paragraph"}]},{"name":"unplayed","content":[{"inlineContent":[{"text":"Indicates what to display above a string that has no associated frame-note element. Typical values are ","type":"text"},{"type":"codeVoice","code":"x"},{"text":" and the empty string. Application-defined if not present.","type":"text"}],"type":"paragraph"}]}],"kind":"parameters"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFrame\/init(id:strings:frets:firstFret:note:position:color:halign:valign:height:width:unplayed:)"},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLLeftCenterRight":{"title":"MXLLeftCenterRight","url":"\/documentation\/ivormxl\/mxlleftcenterright","role":"symbol","navigatorTitle":[{"text":"MXLLeftCenterRight","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLeftCenterRight","abstract":[{"text":"The left-center-right type is used to define horizontal alignment and text justification.","type":"text"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"text":" ","kind":"text"},{"text":"MXLLeftCenterRight","kind":"identifier"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLValignImage":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValignImage","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLValignImage","kind":"identifier"}],"title":"MXLValignImage","abstract":[{"type":"text","text":"The valign-image type is used to indicate vertical alignment for images and graphics, so it does not include a"},{"type":"text","text":" "},{"type":"text","text":"baseline value. Defaults are implementation-dependent."}],"navigatorTitle":[{"text":"MXLValignImage","kind":"identifier"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlvalignimage"},"doc://IvorMXL/documentation/IvorMXL/MXLFrame/init(id:strings:frets:firstFret:note:position:color:halign:valign:height:width:unplayed:)":{"kind":"symbol","url":"\/documentation\/ivormxl\/mxlframe\/init(id:strings:frets:firstfret:note:position:color:halign:valign:height:width:unplayed:)","abstract":[{"text":"Creates a new ","type":"text"},{"type":"codeVoice","code":"MXLFrame"},{"text":".","type":"text"}],"role":"symbol","title":"init(id:strings:frets:firstFret:note:position:color:halign:valign:height:width:unplayed:)","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFrame\/init(id:strings:frets:firstFret:note:position:color:halign:valign:height:width:unplayed:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"strings","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"frets","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"firstFret","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLFirstFret","preciseIdentifier":"s:7IvorMXL12MXLFirstFretV","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"note","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"Note","preciseIdentifier":"s:7IvorMXL8MXLFrameV4NoteV","kind":"typeIdentifier"},{"text":"], ","kind":"text"},{"text":"position","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLPosition","preciseIdentifier":"s:7IvorMXL11MXLPositionV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"color","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLColor","preciseIdentifier":"s:7IvorMXL8MXLColorV","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"halign","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLLeftCenterRight","preciseIdentifier":"s:7IvorMXL18MXLLeftCenterRightO","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"valign","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLValignImage","preciseIdentifier":"s:7IvorMXL14MXLValignImageO","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"height","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLTenths","preciseIdentifier":"s:7IvorMXL9MXLTenthsa","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"width","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLTenths","preciseIdentifier":"s:7IvorMXL9MXLTenthsa","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"unplayed","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?)","kind":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLTenths":{"title":"MXLTenths","type":"topic","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTenths","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxltenths","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"MXLTenths","kind":"identifier"}],"abstract":[{"type":"text","text":"The tenths type is a number representing tenths of interline staff space (positive or negative). Both integer"},{"type":"text","text":" "},{"type":"text","text":"and decimal values are allowed, such as 5 for a half space and 2.5 for a quarter space. Interline space is"},{"type":"text","text":" "},{"type":"text","text":"measured from the middle of a staff line."}]},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLFrame":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlframe","title":"MXLFrame","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLFrame","kind":"identifier"}],"navigatorTitle":[{"text":"MXLFrame","kind":"identifier"}],"abstract":[{"text":"The frame type represents a frame or fretboard diagram used together with a chord symbol. The representation","type":"text"},{"text":" ","type":"text"},{"text":"is based on the NIFF guitar grid with additional information. The frame type’s unplayed attribute indicates","type":"text"},{"text":" ","type":"text"},{"text":"what to display above a string that has no associated frame-note element. Typical values are x and the empty","type":"text"},{"text":" ","type":"text"},{"text":"string. If the attribute is not present, the display of the unplayed string is application-defined.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFrame"},"doc://IvorMXL/documentation/IvorMXL/MXLFirstFret":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFirstFret","url":"\/documentation\/ivormxl\/mxlfirstfret","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLFirstFret","kind":"identifier"}],"abstract":[{"type":"text","text":"The first-fret type indicates which fret is shown in the top space of the frame; it is fret 1 if the element"},{"type":"text","text":" "},{"type":"text","text":"is not present. The optional text attribute indicates how this is represented in the fret diagram, while the"},{"type":"text","text":" "},{"type":"text","text":"location attribute indicates whether the text appears to the left or right of the frame."}],"navigatorTitle":[{"text":"MXLFirstFret","kind":"identifier"}],"title":"MXLFirstFret","type":"topic","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLPosition":{"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPosition","kind":"identifier"}],"title":"MXLPosition","navigatorTitle":[{"text":"MXLPosition","kind":"identifier"}],"abstract":[{"type":"text","text":"For most elements, any program will compute a default x and y position. The position attributes let this be"},{"type":"text","text":" "},{"type":"text","text":"changed two ways."}],"url":"\/documentation\/ivormxl\/mxlposition","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLFrame/Note-swift.struct":{"abstract":[{"type":"text","text":"The frame-note type represents each note included in the frame. An open string will have a fret value of 0,"},{"type":"text","text":" "},{"type":"text","text":"while a muted string will not be associated with a frame-note element."}],"title":"MXLFrame.Note","url":"\/documentation\/ivormxl\/mxlframe\/note-swift.struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Note","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"Note","kind":"identifier"}],"type":"topic","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFrame\/Note-swift.struct"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlcolor","title":"MXLColor","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"type":"text","text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is"},{"type":"text","text":" "},{"type":"text","text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor"}}}