IvorMXL/documentation/IvorMXL/MXLFrame":{"abstract":[{"text":"The frame type represents a frame or fretboard diagram used together with a chord symbol. The representation","type":"text"},{"text":" ","type":"text"},{"text":"is based on the NIFF guitar grid with additional information. The frame type’s unplayed attribute indicates","type":"text"},{"text":" ","type":"text"},{"text":"what to display above a string that has no associated frame-note element. Typical values are x and the empty","type":"text"},{"text":" ","type":"text"},{"text":"string. If the attribute is not present, the display of the unplayed string is application-defined.","type":"text"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlframe","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFrame","kind":"symbol","title":"MXLFrame","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLFrame","kind":"identifier"}],"navigatorTitle":[{"text":"MXLFrame","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"title":"MXLColor","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"abstract":[{"text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in","type":"text"},{"text":" ","type":"text"},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"url":"\/documentation\/ivormxl\/mxlcolor"}}}