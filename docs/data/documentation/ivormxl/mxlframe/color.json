IvorMXL/documentation/IvorMXL/MXLFrame":{"abstract":[{"type":"text","text":"The frame type represents a frame or fretboard diagram used together with a chord symbol. The representation"},{"type":"text","text":" "},{"type":"text","text":"is based on the NIFF guitar grid with additional information. The frame type’s unplayed attribute indicates"},{"type":"text","text":" "},{"type":"text","text":"what to display above a string that has no associated frame-note element. Typical values are x and the empty"},{"type":"text","text":" "},{"type":"text","text":"string. If the attribute is not present, the display of the unplayed string is application-defined."}],"title":"MXLFrame","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFrame"}],"navigatorTitle":[{"kind":"identifier","text":"MXLFrame"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlframe","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFrame"},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"abstract":[{"text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in","type":"text"},{"type":"text","text":" "},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"title":"MXLColor","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"navigatorTitle":[{"kind":"identi