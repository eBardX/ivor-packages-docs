nd":"identifier"}],"abstract":[{"text":"The frame type represents a frame or fretboard diagram used together with a chord symbol. The representation","type":"text"},{"text":" ","type":"text"},{"text":"is based on the NIFF guitar grid with additional information. The frame type’s unplayed attribute indicates","type":"text"},{"text":" ","type":"text"},{"text":"what to display above a string that has no associated frame-note element. Typical values are x and the empty","type":"text"},{"text":" ","type":"text"},{"text":"string. If the attribute is not present, the display of the unplayed string is application-defined.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFrame"},"doc://IvorMXL/documentation/IvorMXL/MXLFrame/note-swift.property":{"type":"topic","abstract":[{"type":"text","text":"The individual notes included in the frame."}],"url":"\/documentation\/ivormxl\/mxlframe\/note-swift.property","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFrame\/note-swift.property","kind":"symbol","title":"note","fragments":[{"kind":"keyword","text":"let"},{"text":" ","kind":"text"},{"text":"note","kind":"identifier"},{"text":": [","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLFrameV4NoteV","text":"Note"},{"text":"]","kind":"text"}]},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLFrame/Note-swift.struct":{"abstract":[{"type":"text","text":"The frame-note type represents each note included in the frame. An open string will have a fret value of 0,"},{"type":"text","text":" "},{"type":"text","text":"while a muted string will not be associated with a frame-note element."}],"title":"MXLFrame.Note","url":"\/doc