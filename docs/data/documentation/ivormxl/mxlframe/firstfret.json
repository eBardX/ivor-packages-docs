text"},{"text":" ","type":"text"},{"text":"is not present. The optional text attribute indicates how this is represented in the fret diagram, while the","type":"text"},{"text":" ","type":"text"},{"text":"location attribute indicates whether the text appears to the left or right of the frame.","type":"text"}],"kind":"symbol","title":"MXLFirstFret","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFirstFret","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLFirstFret","kind":"identifier"}]}}}