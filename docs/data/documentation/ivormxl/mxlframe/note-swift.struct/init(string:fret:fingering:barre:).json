:"symbol","abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLFrame.Note"},{"type":"text","text":"."}],"title":"init(string:fret:fingering:barre:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"string","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLString","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLStringV"},{"text":", ","kind":"text"},{"text":"fret","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLFret","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL7MXLFretV"},{"text":", ","kind":"text"},{"text":"fingering","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLFingering","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL12MXLFingeringV"},{"text":"?, ","kind":"text"},{"text":"barre","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLBarre","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLBarreV"},{"text":"?)","kind":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLString":{"type":"topic","title":"MXLString","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLString","abstract":[{"text":"The string type is used with tablature notation, regular notation (where it is often circled), and chord","type":"text"},{"text":" ","type":"text"},{"text":"diagrams. String numbers start with 1 for the highest pitched full-length string.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLString"}],"navigatorTitle":[{"kind":"identifier","text":"MXLString"}],"url":"\/documentation\/ivormxl\/mxlstring"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLFingering":{"title":"MXLFingering","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFingering"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlfingering","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLFingering"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFingering","abstract":[{"text":"Fingering is typically indicated 1,2,3,4,5. Multiple fingerings may be given, typically to substitute","type":"text"},{"text":" ","type":"text"},{"text":"fingerings in the middle of a note. The substitution and alternate values are “no” if the attribute is not","type":"text"},{"text":" ","type":"text"},{"text":"present. For guitar and other fretted instruments, the fingering element represents the fretting finger; the","type":"text"},{"text":" ","type":"text"},{"text":"pluck element represents the plucking finger.","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLFret":{"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFret","url":"\/documentation\/ivormxl\/mxlfret","abstract":[{"text":"The fret element is used with tablature notation and chord diagrams. Fret numbers start with 0 for an open","type":"text"},{"text":" ","type":"text"},{"text":"string and 1 for the first fret.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLFret","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"MXLFret","kind":"identifier"}],"role":"symbol","title":"MXLFret"},"doc://IvorMXL/documentation/IvorMXL/MXLBarre":{"type":"topic","title":"MXLBarre","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarre","abstract":[{"type":"text","text":"The barre element indicates placing a finger over multiple strings on a single fret. The type is “start” for"},{"type":"text","text":" "},{"type":"text","text":"the lowest pitched string (e.g., the string with the highest MusicXML number) and is “stop” for the highest"},{"type":"text","text":" "},{"type":"text","text":"pitched string."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLBarre"}],"navigatorTitle":[{"kind":"identifier","text":"MXLBarre"}],"url":"\/documentation\/ivormxl\/mxlbarre"},"doc://IvorMXL/documentation/IvorMXL/MXLFrame":{"type":"topic","abstract":[{"text":"The frame type represents a frame or fretboard diagram used together with a chord symbol. The representation","type":"text"},{"text":" ","type":"text"},{"text":"is based on the NIFF guitar grid with additional information. The frame type’s unplayed attribute indicates","type":"text"},{"text":" ","type":"text"},{"text":"what to display above a string that has no associated frame-note element. Typical values are x and the empty","type":"text"},{"text":" ","type":"text"},{"text":"string. If the attribute is not present, the display of the unplayed string is application-defined.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlframe","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLFrame","kind":"identifier"}],"kind":"symbol","title":"MXLFrame","navigatorTitle":[{"text":"MXLFrame","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFrame","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLFrame/Note-swift.struct":{"type":"topic","abstract":[{"text":"The frame-note type represents each note included in the frame. An open string will have a fret value of 0,","type":"text"},{"text":" ","type":"text"},{"text":"while a muted string will not be associated with a frame-note element.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlframe\/note-swift.struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Note"}],"kind":"symbol","title":"MXLFrame.Note","navigatorTitle":[{"kind":"identifier","text":"Note"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFrame\/Note-swift.struct","role":"symbol"}}}