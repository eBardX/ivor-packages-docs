"text":"MXLFrame","kind":"identifier"}],"abstract":[{"text":"The frame type represents a frame or fretboard diagram used together with a chord symbol. The representation","type":"text"},{"text":" ","type":"text"},{"text":"is based on the NIFF guitar grid with additional information. The frame type’s unplayed attribute indicates","type":"text"},{"text":" ","type":"text"},{"text":"what to display above a string that has no associated frame-note element. Typical values are x and the empty","type":"text"},{"text":" ","type":"text"},{"text":"string. If the attribute is not present, the display of the unplayed string is application-defined.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFrame"},"doc://IvorMXL/documentation/IvorMXL/MXLFret":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFret","url":"\/documentation\/ivormxl\/mxlfret","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFret"}],"abstract":[{"type":"text","text":"The fret element is used with tablature notation and chord diagrams. Fret numbers start with 0 for an open"},{"type":"text","text":" "},{"type":"text","text":"string and 1 for the first fret."}],"navigatorTitle":[{"kind":"identifier","text":"MXLFret"}],"title":"MXLFret","type":"topic","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLFingering":{"url":"\/documentation\/ivormxl\/mxlfingering","abstract":[{"text":"Fingering is typically indicated 1,2,3,4,5. Multiple fingerings may be given, typically to substitute","type":"text"},{"text":" ","type":"text"},{"text":"fingerings in the middle of a note. The substitution and alternate values are “no” if the attribute is not","type":"text"},{"text":" ","type":"text"},{"text":"present. For guitar and other fretted instruments, the fingering element represents the fretting finger; the","type":"text"},{"text":" ","type":"text"},{"text":"pluck element represents the plucking finger.","type":"text"}],"title":"MXLFingering","role":"symbol","type":"topic","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLFingering"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFingering","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFingering"}]},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLBarre":{"kind":"symbol","abstract":[{"text":"The barre element indicates placing a finger over multiple strings on a single fret. The type is “start” for","type":"text"},{"text":" ","type":"text"},{"text":"the lowest pitched string (e.g., the string with the highest MusicXML number) and is “stop” for the highest","type":"text"},{"text":" ","type":"text"},{"text":"pitched string.","type":"text"}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLBarre","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"text":"MXLBarre","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlbarre","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarre","title":"MXLBarre"},"doc://IvorMXL/documentation/IvorMXL/MXLString":{"abstract":[{"type":"text","text":"The string type is used with tablature notation, regular notation (where it is often circled), and chord"},{"type":"text","text":" "},{"type":"text","text":"diagrams. String numbers start with 1 for the highest pitched full-length string."}],"title":"MXLString","url":"\/documentation\/ivormxl\/mxlstring","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLString","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"MXLString","kind":"identifier"}],"type":"t