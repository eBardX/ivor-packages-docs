"text":"MXLFret"}],"role":"symbol","abstract":[{"text":"The fret element is used with tablature notation and chord diagrams. Fret numbers start with 0 for an open","type":"text"},{"text":" ","type":"text"},{"text":"string and 1 for the first fret.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLFrame/Note-swift.struct/init(string:fret:fingering:barre:)":{"type":"topic","url":"\/documentation\/ivormxl\/mxlframe\/note-swift.struct\/init(string:fret:fingering:barre:)","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFrame\/Note-swift.struct\/init(string:fret:fingering:barre:)","role":"symbol","kind":"symbol","abstract":[{"text":"Creates a new ","type":"text"},{"code":"MXLFrame.Note","type":"codeVoice"},{"text":".","type":"text"}],"title":"init(string:fret:fingering:barre:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"string","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL9MXLStringV","text":"MXLString","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"fret","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL7MXLFretV","text":"MXLFret","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"fingering","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL12MXLFingeringV","text":"MXLFingering","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"barre","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL8MXLBarreV","text":"MXLBarre","kind":"typeIdentifier"},{"text":"?)","kind":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLBarre":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLBarre","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlbarre","title":"MXLBarre","navigatorTitle":[{"text":"MXLBarre","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarre","type":"topic","abstract":[{"type":"text","text":"The barre element indicates placing a finger over multiple strings on a single fret. The type is “start” for"},{"type":"text","text":" "},{"type":"text","text":"the lowest pitched string (e.g., the string with the highest MusicXML number) and is “stop” for the highest"},{"type":"text","text":" "},{"type":"text","text":"pitched string."}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLFingering":{"navigatorTitle":[{"kind":"identifier","text":"MXLFingering"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlfingering","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFingering","title":"MXLFingering","kind":"symbol","abstract":[{"type":"text","text":"Fingering is typically indicated 1,2,3,4,5. Multiple fingerings may be given, typically to substitute"},{"type":"text","text":" "},{"type":"text","text":"fingerings in the middle of a note. The substitution and alternate values are “no” if the attribute is not"},{"type":"text","text":" "},{"type":"text","text":"present. For guitar and other fretted instruments, the fingering element represents the fretting finger; the"},{"type":"text","text":" "},{"type":"text","text":"pluck element represents the plucking finger."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFingering"}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLString":{"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLString","url":"\/documentation\/ivormxl\/mxlstring","navigatorTitle":[{"text":"MXLString","kind":"identifier"}],"title":"MXLString","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLString","kind":"identifier"}],"type":"topic","abstract":[{"text":"The string type is used with tablature notation, regular notation (where it is often circled), and chord","type":"text"},{"text":" ","type":"text"},{"text":"diagrams. String numbers start with 1 for the highest pitched full-length string.","type":"text"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLFrame/Note-swift.struct":{"url":"\/documentation\/ivormxl\/mxlframe\/note-swift.struct","title":"MXLFrame.Note","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Note"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFrame\/Note-swift.struct","navigatorTitle":[{"kind":"identifier","text":"Note"}],"kind":"symbol","abstract":[{"text":"The frame-note type represents each note included in the frame. An open string will have a fret value of 0,","type":"text"},{"text":" ","type":"text"},{"text":"while a muted string will not be associated with a frame-note element.","type":"text"}],"type":"topic","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLFrame":{"role":"symbol","kind":"symbol","url":"\/documentation\/ivormxl\/mxlframe","title":"MXLFrame","abstract":[{"type":"text","text":"The frame type represents a frame or fretboard diagram used together with a chord symbol. The representation"},{"type":"text","text":" "},{"type":"text","text":"is based on the NIFF guitar grid with additional information. The frame type’s unplayed attribute indicates"},{"type":"text","text":" "},{"type":"text","text":"what to display above a string that has no associated frame-note element. Typical values are x and the empty"},{"type":"text","text":" "},{"type":"text","text":"string. If the attribute is not present, the display of the unplayed string is application-defined."}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLFrame","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFrame","navigatorTitle":[{"text":"MXLFrame","kind":"identifier"}]}}}