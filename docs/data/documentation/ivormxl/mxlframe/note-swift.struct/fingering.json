:"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"fingering"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL12MXLFingeringV","text":"MXLFingering"},{"kind":"text","text":"?"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFrame\/Note-swift.struct\/fingering","kind":"symbol","abstract":[{"text":"The fingering used for this note.","type":"text"}],"type":"topic","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLFingering":{"navigatorTitle":[{"kind":"identifier","text":"MXLFingering"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlfingering","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFingering","title":"MXLFingering","kind":"symbol","abstract":[{"type":"text","text":"Fingering is typically indicated 1,2,3,4,5. Multiple fingerings may be given, typically to substitute"},{"type":"text","text":" "},{"type":"text","text":"fingerings in the middle of a note. The substitution and alternate values are “no” if the attribute is not"},{"type":"text","text":" "},{"type":"text","text":"present. For guitar and other fretted instruments, the fingering element represents the fretting finger; the"},{"type":"text","text":" "},{"type":"text","text":"pluck element represents the plucking finger."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFingering"}]},"doc://IvorMXL/documentation/IvorMXL/MXLFrame/Note-swift.struct":{"url":"\/documentation\/ivormxl\/mxlframe\/note-swift.struct","title":"MXLFrame.Note","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Note"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFrame\/Note-swift.struct","navigatorTitle":[{"kind":"identifier","text":"Note"}],"kind":"symbol","abstract":[{"text":"The frame-note type represents each note included in the frame. An open string will have a fret value of 0,","type":"text"},{"text":" ","type":"text"},{"text":"while a muted string will not be associated with a frame-note element.","type":"text"}],"type":"topic","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLFrame":{"role":"symbol","kind":"symbol","url":"\/documentation\/ivormxl\/mxlframe","title":"MXLFrame","abstract":[{"type":"text","text":"The frame type represents a frame or fretboard diagram used together with a chord symbol. The representation"},{"type":"text","text":" "},{"type":"text","text":"is based on the NIFF guitar grid with additional information. The frame type’s unplayed attribute indicates"},{"type":"text","text":" "},{"type":"text","text":"what to display above a string that has no associated frame-note element. Typical values are x and the empty"},{"type":"text","text":" "},{"type":"text","text":"string. If the attribute is not present, the display of the unplayed string is application-defined."}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLFrame","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFrame","navigatorTitle":[{"text":"MXLFrame","kind":"identifier"}]}}}