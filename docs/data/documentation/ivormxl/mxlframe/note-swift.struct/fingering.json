orMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLFingering":{"url":"\/documentation\/ivormxl\/mxlfingering","abstract":[{"text":"Fingering is typically indicated 1,2,3,4,5. Multiple fingerings may be given, typically to substitute","type":"text"},{"text":" ","type":"text"},{"text":"fingerings in the middle of a note. The substitution and alternate values are “no” if the attribute is not","type":"text"},{"text":" ","type":"text"},{"text":"present. For guitar and other fretted instruments, the fingering element represents the fretting finger; the","type":"text"},{"text":" ","type":"text"},{"text":"pluck element represents the plucking finger.","type":"text"}],"title":"MXLFingering","role":"symbol","type":"topic","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLFingering"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFingering","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFingering"}]},"doc://IvorMXL/documentation/IvorMXL/MXLFrame/Note-swift.struct":{"abstract":[{"type":"text","text":"The frame-note type represents each note included in the frame. An open string will have a fret value of 0,"},{"type":"text","text":" "},{"type":"text","text":"while a muted string will not be associated with a frame-note element."}],"title":"MXLFrame.Note","url":"\/documentation\/ivormxl\/mxlframe\/note-swift.struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Note","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"Note","kind":"identifier"}],"type":"topic","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFrame\/Note-swift.struct"},"doc://IvorMXL/documentation/IvorMXL/MXLFrame/Note-swift.struct/fingering":{"type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"fingering","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLFingering","preciseIdentifier":"s:7IvorMXL12MXLFingeringV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlframe\/note-swift.struct\/fingering","abstract":[{"type":"text","text":"The fingering used for this note."}],"role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFrame\/Note-swift.struct\/fingering","title":"fingering"},"doc://IvorMXL/documentation/IvorMXL/MXLFrame":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlframe","title":"MXLFrame","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLFrame","kind":"identifier"}],"navigatorTitle":[{"text":"MXLFrame","kind":"identifier"}],"abstract":[{"text":"The frame type represents a frame or fretboard diagram used together with a chord symbol. The representation","type":"text"},{"text":" ","type":"text"},{"text":"is based on the NIFF guitar grid with additional information. The frame type’s unplayed attribute indicates","type":"text"},{"text":" ","type":"text"},{"text":"what to display above a string that has no associated frame-note element. Typical values are x and the empty","type":"text"},{"text":" ","type":"text"},{"text":"string. If the attribute is not present, the display of the unplayed string is application-defined.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFrame"}}}