 a fret value of 0,"},{"type":"text","text":" "},{"type":"text","text":"while a muted string will not be associated with a frame-note element."}],"title":"MXLFrame.Note","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Note"}],"navigatorTitle":[{"kind":"identifier","text":"Note"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlframe\/note-swift.struct","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFrame\/Note-swift.struct"},"doc://IvorMXL/documentation/IvorMXL/MXLFrame":{"abstract":[{"type":"text","text":"The frame type represents a frame or fretboard diagram used together with a chord symbol. The representation"},{"type":"text","text":" "},{"type":"text","text":"is based on the NIFF guitar grid with additional information. The frame type’s unplayed attribute indicates"},{"type":"text","text":" "},{"type":"text","text":"what to display above a string that has no associated frame-note element. Typical values are x and the empty"},{"type":"text","text":" "},{"type":"text","text":"string. If the attribute is not present, the display of the unplayed string is application-defined."}],"title":"MXLFrame","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFrame"}],"navigatorTitle":[{"kind":"identifier","text":"MXLFrame"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlframe","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFrame"},"doc://IvorMXL/documentation/IvorMXL/MXLFrame/Note-swift.struct/fingering":{"url":"\/documentation\/ivormxl\/mxlframe\/note-swift.struct\/fingering","abstract":[{"text":"The fingering used for this note.","type":"text"}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"fingering","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLFingering","preciseIdentifier":"s:7IvorMXL12MXLFingeringV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"title":"fingering","type":"topic","role":"symbol","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFrame\/Note-swift.struct\/fingering"},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLFingering":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFingering","title":"MXLFingering","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLFingering","kind":"identifier"}],"navigatorTitle":[{"text":"MXLFingering","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlfingering","abstract":[{"text":"Fingering is typically indicated 1,2,3,4,5. Multiple fingerings may be given, typically to substitute","type":"text"},{"text":" ","type":"text"},{"text":"fingerings in the middle of a note. The substitution and alternate values are “no” if the attribute is not","type":"text"},{"text":" ","type":"text"},{"text":"present. For guitar and other fretted instruments, the fingering element represents the fretting finger; the","type":"text"},{"text":" ","type":"text"},{"text":"pluck element represents the plucking finger.","type":"text"}]}}}