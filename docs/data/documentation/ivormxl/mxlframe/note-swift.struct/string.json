itional information. The frame type’s unplayed attribute indicates","type":"text"},{"text":" ","type":"text"},{"text":"what to display above a string that has no associated frame-note element. Typical values are x and the empty","type":"text"},{"text":" ","type":"text"},{"text":"string. If the attribute is not present, the display of the unplayed string is application-defined.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlframe","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLFrame","kind":"identifier"}],"kind":"symbol","title":"MXLFrame","navigatorTitle":[{"text":"MXLFrame","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFrame","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLFrame/Note-swift.struct":{"type":"topic","abstract":[{"text":"The frame-note type represents each note included in the frame. An open string will have a fret value of 0,","type":"text"},{"text":" ","type":"text"},{"text":"while a muted string will not be associated with a frame-note element.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlframe\/note-swift.struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Note"}],"kind":"symbol","title":"MXLFrame.Note","navigatorTitle":[{"kind":"identifier","text":"Note"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFrame\/Note-swift.struct","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLString":{"type":"topic","title":"MXLString","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLString","abstract":[{"text":"The string type is used with tablature notation, regular notation (where it is often circled), and chord","type":"text"},{"text":" ","type":"text"},{"text":"diagrams. String numbers start with 1 for the highest pitched full-length string.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLString"}],"navigatorTitle":[{"kind":"identifier","text":"MXLString"}],"url":"\/documentation\/ivormxl\/mxlstring"},"doc://IvorMXL/documentation/IvorMXL/MXLFrame/Note-swift.struct/string":{"role":"symbol","title":"string","kind":"symbol","url":"\/documentation\/ivormxl\/mxlframe\/note-swift.struct\/string","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFrame\/Note-swift.struct\/string","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"string","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLString","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLStringV"}],"abstract":[{"text":"The string this note is played on.","type":"text"}],"type":"topic"}}}