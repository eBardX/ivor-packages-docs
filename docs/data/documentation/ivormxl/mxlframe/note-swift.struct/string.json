IvorMXL\/documentation\/IvorMXL\/MXLFrame\/Note-swift.struct","navigatorTitle":[{"kind":"identifier","text":"Note"}],"kind":"symbol","abstract":[{"text":"The frame-note type represents each note included in the frame. An open string will have a fret value of 0,","type":"text"},{"text":" ","type":"text"},{"text":"while a muted string will not be associated with a frame-note element.","type":"text"}],"type":"topic","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLFrame/Note-swift.struct/string":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"string","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLString","preciseIdentifier":"s:7IvorMXL9MXLStringV","kind":"typeIdentifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFrame\/Note-swift.struct\/string","url":"\/documentation\/ivormxl\/mxlframe\/note-swift.struct\/string","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"The string this note is played on."}],"title":"string","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLString":{"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLString","url":"\/documentation\/ivormxl\/mxlstring","navigatorTitle":[{"text":"MXLString","kind":"identifier"}],"title":"MXLString","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLString","kind":"identifier"}],"type":"topic","abstract":[{"text":"The string type is used with tablature notation, regular notation (where it is often circled), and chord","type":"text"},{"text":" ","type":"text"},{"text":"diagrams. String numbers start with 1 for the highest pitched full-length string.","type":"text"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLFrame":{"role":"symbol","kind":"symbol","url":"\/documentation\/ivormxl\/mxlframe","title":"MXLFrame","abstract":[{"type":"text","text":"The frame type represents a frame or fretboard diagram used together with a chord symbol. The representation"},{"type":"text","text":" "},{"type":"text","text":"is based on the NIFF guitar grid with additional information. The frame type’s unplayed attribute indicates"},{"type":"text","text":" "},{"type":"text","text":"what to display above a string that has no associated frame-note element. Typical values are x and the empty"},{"type":"text","text":" "},{"type":"text","text":"string. If the attribute is not present, the display of the unplayed string is application-defined."}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLFrame","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFrame","navigatorTitle":[{"text":"MXLFrame","kind":"identifier"}]}}}