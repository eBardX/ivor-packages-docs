IvorMXL/documentation/IvorMXL/MXLFrame":{"abstract":[{"text":"The frame type represents a frame or fretboard diagram used together with a chord symbol. The representation","type":"text"},{"text":" ","type":"text"},{"text":"is based on the NIFF guitar grid with additional information. The frame type’s unplayed attribute indicates","type":"text"},{"text":" ","type":"text"},{"text":"what to display above a string that has no associated frame-note element. Typical values are x and the empty","type":"text"},{"text":" ","type":"text"},{"text":"string. If the attribute is not present, the display of the unplayed string is application-defined.","type":"text"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlframe","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFrame","kind":"symbol","title":"MXLFrame","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLFrame","kind":"identifier"}],"navigatorTitle":[{"text":"MXLFrame","kind":"identifier"}]}}}