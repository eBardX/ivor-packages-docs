":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLFrame":{"abstract":[{"text":"The frame type represents a frame or fretboard diagram used together with a chord symbol. The representation","type":"text"},{"text":" ","type":"text"},{"text":"is based on the NIFF guitar grid with additional information. The frame type’s unplayed attribute indicates","type":"text"},{"text":" ","type":"text"},{"text":"what to display above a string that has no associated frame-note element. Typical values are x and the empty","type":"text"},{"text":" ","type":"text"},{"text":"string. If the attribute is not present, the display of the unplayed string is application-defined.","type":"text"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlframe","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFrame","kind":"symbol","title":"MXLFrame","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLFrame","kind":"identifier"}],"navigatorTitle":[{"text":"MXLFrame","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLBarre":{"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarre","title":"MXLBarre","navigatorTitle":[{"text":"MXLBarre","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLBarre","kind":"identifier"}],"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlbarre","abstract":[{"type":"text","text":"The barre element indicates placing a finger over multiple strings on a single fret. The type is “start” for"},{"type":"text","text":" "},{"type":"text","text":"the lowest pitched string (e.g., the string with the highest MusicXML number) and is “stop” for the highest"},{"type":"text","text":" "},{"type":"text","text":"pitched string."}]},"doc://IvorMXL/documentation/IvorMXL/MXLFrame/Note-swift.struct/barre":{"abstract":[{"type":"text","text":"A barre placed at this note’s fret and st