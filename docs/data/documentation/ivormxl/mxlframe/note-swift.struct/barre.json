rd","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"barre"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL8MXLBarreV","text":"MXLBarre","kind":"typeIdentifier"},{"kind":"text","text":"?"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFrame\/Note-swift.struct\/barre","url":"\/documentation\/ivormxl\/mxlframe\/note-swift.struct\/barre","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLFrame/Note-swift.struct":{"url":"\/documentation\/ivormxl\/mxlframe\/note-swift.struct","title":"MXLFrame.Note","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Note"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFrame\/Note-swift.struct","navigatorTitle":[{"kind":"identifier","text":"Note"}],"kind":"symbol","abstract":[{"text":"The frame-note type represents each note included in the frame. An open string will have a fret value of 0,","type":"text"},{"text":" ","type":"text"},{"text":"while a muted string will not be associated with a frame-note element.","type":"text"}],"type":"topic","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLBarre":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLBarre","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlbarre","title":"MXLBarre","navigatorTitle":[{"text":"MXLBarre","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarre","type":"topic","abstract":[{"type":"text","text":"The barre element indicates placing a finger over multiple strings on a single fret. The type is “start” for"},{"type":"text","text":" "},{"type":"text","text":"the lowest pitched string (e.g., the string with the highest MusicXML number) and is “stop” for the highest"},{"type":"text","text":" "},{"type":"text","text":"pitched string."}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLFrame":{"role":"symbol","kind":"symbol","url":"\/documentation\/ivormxl\/mxlframe","title":"MXLFrame","abstract":[{"type":"text","text":"The frame type represents a frame or fretboard diagram used together with a chord symbol. The representation"},{"type":"text","text":" "},{"type":"text","text":"is based on the NIFF guitar grid with additional information. The frame type’s unplayed attribute indicates"},{"type":"text","text":" "},{"type":"text","text":"what to display above a string that has no associated frame-note element. Typical values are x and the empty"},{"type":"text","text":" "},{"type":"text","text":"string. If the attribute is not present, the display of the unplayed string is application-defined."}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLFrame","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFrame","navigatorTitle":[{"text":"MXLFrame","kind":"identifier"}]}}}