{"abstract":[{"text":"In cases where text extends over more than one line, horizontal alignment and justify values can be different.","type":"text"},{"text":" ","type":"text"},{"text":"The most typical case is for credits, such as:","type":"text"}],"kind":"symbol","metadata":{"symbolKind":"property","roleHeading":"Instance Property","externalID":"s:7IvorMXL8MXLFrameV6halignAA18MXLLeftCenterRightOSgvp","title":"halign","modules":[{"name":"IvorMXL"}],"role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"halign","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL18MXLLeftCenterRightO","text":"MXLLeftCenterRight","kind":"typeIdentifier"},{"text":"?","kind":"text"}]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFrame\/halign"},"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"halign","kind":"identifier"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLeftCenterRight","preciseIdentifier":"s:7IvorMXL18MXLLeftCenterRightO","text":"MXLLeftCenterRight","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"Words and music by Pat Songwriter","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Typically this type of credit is aligned to the right, so that the position information refers to the right-","type":"text"},{"text":" ","type":"text"},{"text":"most part of the text. But in this example, the text is center-justified, not right-justified.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The halign attribute is used in these situations. If it is not present, its value is the same as for the","type":"text"},{"text":" ","type":"text"},{"text":"justify attribute. For elements where a justify attribute is not allowed, the default is implementation-","type":"text"},{"text":" ","type":"text"},{"text":"dependent.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Maps to the MusicXML ","type":"text"},{"code":"halign","type":"codeVoice"},{"text":" attribute.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlframe\/halign"]}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFrame"]]},"sections":[],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLFrame":{"type":"topic","abstract":[{"text":"The frame type represents a frame or fretboard diagram used together with a chord symbol. The representation","type":"text"},{"text":" ","type":"text"},{"text":"is based on the NIFF guitar grid with additional information. The frame type’s unplayed attribute indicates","type":"text"},{"text":" ","type":"text"},{"text":"what to display above a string that has no associated frame-note element. Typical values are x and the empty","type":"text"},{"text":" ","type":"text"},{"text":"string. If the attribute is not present, the display of the unplayed string is application-defined.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlframe","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLFrame","kind":"identifier"}],"kind":"symbol","title":"MXLFrame","navigatorTitle":[{"text":"MXLFrame","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFrame","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLLeftCenterRight":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLLeftCenterRight"}],"title":"MXLLeftCenterRight","abstract":[{"text":"The left-center-right type is used to define horizontal align