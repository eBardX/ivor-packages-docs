"},{"type":"text","text":" "},{"type":"text","text":"display elements."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPartName"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLPartName"}],"type":"topic","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartName"},"doc://IvorMXL/SH":{"type":"unresolvable","title":"Swift.Hashable","identifier":"doc:\/\/IvorMXL\/SH"},"doc://IvorMXL/documentation/IvorMXL/MXLScoreTimewise":{"type":"topic","title":"MXLScoreTimewise","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLScoreTimewise"}],"url":"\/documentation\/ivormxl\/mxlscoretimewise","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScoreTimewise","role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLScoreTimewise"}],"abstract":[{"type":"text","text":"The score-timewise element is the root element for a timewise MusicXML score. It includes a score-header group"},{"type":"text","text":" "},{"type":"text","text":"followed by a series of measures with parts inside. The document-attributes attribute group includes the"},{"type":"text","text":" "},{"type":"text","text":"version attribute."}]},"doc://IvorMXL/documentation/IvorMXL/MXLScorePartwise":{"type":"topic","title":"MXLScorePartwise","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLScorePartwise","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlscorepartwise","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePartwise","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"MXLScorePartwise","kind":"identifier"}],"abstract":[{"type":"text","text":"The score-partwise element is the root element for a partwise MusicXML score. It includes a score-header group"},{"type":"text","text":" "},{"type":"text","text":"followed by a series of parts with measures inside. The docu