{"abstract":[{"type":"text","text":"The part-name type describes the name or abbreviation of a score-part element. Formatting attributes for the"},{"type":"text","text":" "},{"type":"text","text":"part-name element are deprecated in Version 2.0 in favor of the new part-name-display and part-abbreviation-"},{"type":"text","text":" "},{"type":"text","text":"display elements."}],"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"relationshipsSections":[{"type":"conformsTo","kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/IvorMXL\/s8CopyableP","doc:\/\/IvorMXL\/SQ","doc:\/\/IvorMXL\/s9EscapableP","doc:\/\/IvorMXL\/SH","doc:\/\/IvorMXL\/s8SendableP","doc:\/\/IvorMXL\/s16SendableMetatypeP"]}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL"]]},"variants":[{"paths":["\/documentation\/ivormxl\/mxlpartname"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","seeAlsoSections":[{"generated":true,"title":"Documents","anchor":"Documents","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDocument","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePartwise","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScoreTimewise","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOpus","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartList","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePart"]}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartName","interfaceLanguage":"swift"},"topicSections":[{"title":"Structures","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartName\/Text-swift.struct"],"generated":true,"anchor":"Structures"},{"title":"Initializers","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartName\/init(value:text:)"],"generated":true,"anchor":"Initializers"},{"title":"Instance Properties","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartName\/text-swift.property","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartName\/value"],"generated":true,"anchor":"Instance-Properties"},{"title":"Default Implementations","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartName\/Equatable-Implementations"],"generated":true,"anchor":"Default-Implementations"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"MXLPartName"}],"platforms":["macOS"],"languages":["swift"]}]},{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"inlineContent":[{"text":"Maps the MusicXML ","type":"text"},{"code":"<part-abbreviation>","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"<part-name>","type":"codeVoice"},{"text":" elements.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"metadata":{"symbolKind":"struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPartName","kind":"identifier"}],"roleHeading":"Structure","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLPartName"}],"externalID":"s:7IvorMXL11MXLPartNameV","modules":[{"name":"IvorMXL"}],"title":"MXLPartName"},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLPartList":{"type":"topic","title":"MXLPartList","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPartList"}],"url":"\/documentation\/ivormxl\/mxlpartlist","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartList","role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLPartList"}],"abstract":[{"type":"text","text":"The part-list identifies the different musical parts in this document. Each part has an ID that is used later"},{"type":"text","text":" "},{"type":"text","text":"within the musical data. Since parts may be encoded separately and combined later, identification elements are"},{"type":"text","text":" "},{"type":"text","text":"present at both the score and score-part levels. There must be at least one score-part, combined as desired"},{"type":"text","text":" "},{"type":"text","text":"with part-group elements that indicate braces and brackets. Parts are ordered from top to bottom in a score"},{"type":"text","text":" "},{"type":"text","text":"based on the order in which they appear in the part-list."}]},"doc://IvorMXL/documentation/IvorMXL/MXLOpus":{"title":"MXLOpus","url":"\/documentation\/ivormxl\/mxlopus","abstract":[{"type":"text","text":"The opus type is used for the root element of a MusicXML opus. Each opus is made up of a series of score,"},{"type":"text","text":" "},{"type":"text","text":"opus-link, and\/or nested opus elements. The document-attributes attribute group includes the version"},{"type":"text","text":" "},{"type":"text","text":"attribute. Future versions may include more metadata elements. In this version, we just include the title of"},{"type":"text","text":" "},{"type":"text","text":"the opus."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLOpus"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLOpus"}],"type":"topic","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOpus"},"doc://IvorMXL/documentation/IvorMXL/MXLPartName/value":{"title":"value","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartName\/value","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"value","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlpartname\/value","abstract":[{"text":"The value of this element.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLPartName/Text-swift.struct":{"navigatorTitle":[{"text":"Text","kind":"identifier"}],"title":"MXLPartName.Text","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartName\/Text-swift.struct","kind":"symbol","type":"topic","rol