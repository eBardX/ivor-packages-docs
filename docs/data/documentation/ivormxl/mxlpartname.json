:[{"text":"The opus type is used for the root element of a MusicXML opus. Each opus is made up of a series of score,","type":"text"},{"text":" ","type":"text"},{"text":"opus-link, and\/or nested opus elements. The document-attributes attribute group includes the version","type":"text"},{"text":" ","type":"text"},{"text":"attribute. Future versions may include more metadata elements. In this version, we just include the title of","type":"text"},{"text":" ","type":"text"},{"text":"the opus.","type":"text"}],"title":"MXLOpus","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOpus","kind":"symbol","url":"\/documentation\/ivormxl\/mxlopus","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLOpus"}],"role":"symbol"},"doc://IvorMXL/SH":{"title":"Swift.Hashable","type":"unresolvable","identifier":"doc:\/\/IvorMXL\/SH"},"doc://IvorMXL/documentation/IvorMXL/MXLDocument":{"navigatorTitle":[{"kind":"identifier","text":"MXLDocument"}],"abstract":[{"type":"text","text":"A top-level document parsed from a MusicXML file."}],"title":"MXLDocument","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDocument","kind":"symbol","url":"\/documentation\/ivormxl\/mxldocument","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLDocument"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLPartName/Equatable-Implementations":{"url":"\/documentation\/ivormxl\/mxlpartname\/equatable-implementations","kind":"article","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartName\/Equatable-Implementations","title":"Equatable Implementations","abstract":[],"type":"topic","role":"collectionGroup"}}}