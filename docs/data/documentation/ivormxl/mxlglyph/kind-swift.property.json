{"sections":[],"kind":"symbol","identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLGlyph\/kind-swift.property","interfaceLanguage":"swift"},"metadata":{"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"kind"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLGlyphV4Kinda","text":"Kind"}],"symbolKind":"property","externalID":"s:7IvorMXL8MXLGlyphV4kindSSvp","title":"kind","role":"symbol","roleHeading":"Instance Property","modules":[{"name":"IvorMXL"}]},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"kind","kind":"identifier"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLGlyph\/Kind-swift.typealias","preciseIdentifier":"s:7IvorMXL8MXLGlyphV4Kinda","text":"Kind","kind":"typeIdentifier"}],"platforms":["macOS"]}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Maps to the MusicXML "},{"type":"codeVoice","code":"type"},{"type":"text","text":" attribute."}]}]}],"abstract":[{"type":"text","text":"The type of glyph being defined."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlglyph\/kind-swift.property"]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLGlyph"]]},"references":{"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLGlyph":{"abstract":[{"type":"text","text":"The glyph element represents what SMuFL glyph should be used for different variations of symbols that are"},{"type":"text","text":" "},{"type":"text","text":"semantically identical. The type attribute specifies what type of glyph is being defined. The element value"},{"type":"text","text":" "},{"type":"text","text":"specifies what SMuFL glyph to use, including recommended stylistic alternates. The SMuFL glyph name should"},{"type":"text","text":" "},{"type":"text","text":"match the type. For instance, a type of quarter-rest would use values restQuarter, restQuarterOld, or"},{"type":"text","text":" "},{"type":"text","text":"restQuarterZ. A type of g-clef-ottava-bassa would use values gClef8vb, gClef8vbOld, or gClef8vbCClef. A type"},{"type":"text","text":" "},{"type":"text","text":"of octave-shift-up-8 would use values ottava, ottavaBassa, ottavaBassaBa, ottavaBassaVb, or octaveBassa."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLGlyph","url":"\/documentation\/ivormxl\/mxlglyph","navigatorTitle":[{"text":"MXLGlyph","kind":"identifier"}],"title":"MXLGlyph","role":"symbol","type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLGlyph","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLGlyph/kind-swift.property":{"type":"topic","url":"\/documentation\/ivormxl\/mxlglyph\/kind-swift.property","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLGlyph\/kind-swift.property","title":"kind","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"kind"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL8MXLGlyphV4Kinda","kind":"typeIdentifier","text":"Kind"}],"abstract":[{"type":"text","text":"The type of glyph being defined."}]},"doc://IvorMXL/documentation/IvorMXL/MXLGlyph/Kind-swift.typealias":{"abstract":[{"type":"text","text":"The glyph-type defines what type of glyph is being defined in a glyph element. Values include quarter-rest,"},{"type":"text","text":" "},{"type":"text","text":"g-clef-ottava-bassa, c-clef, f-clef, percussion-clef, octave-shift-up-8, octave-shift-down-8, octave-shift-"},{"type":"text","text":" "},{"type":"text","text":"continue-8, octave-shift-down-15, octave-shift-up-15, octave-shift-continue-15, octave-shift-down-22, octave-"},{"type":"text","text":" "},{"type":"text","text":"shift-up-22, and octave-shift-continue-22. This is left as a string so that other application-specific types"},{"type":"text","text":" "},{"type":"text","text":"can be defined, but it is made a separate type so that it can be redefined more strictly."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLGlyph\/Kind-swift.typealias","url":"\/documentation\/ivormxl\/mxlglyph\/kind-swift.typealias","navigatorTitle":[{"text":"Kind","kind":"identifier"}],"title":"MXLGlyph.Kind","role":"symbol","type":"topic","kind":"symbol","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Kind","kind":"identifier"}]}}}