{"variants":[{"paths":["\/documentation\/ivormxl\/mxlglyph\/kind-swift.property"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"roleHeading":"Instance Property","modules":[{"name":"IvorMXL"}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"kind","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Kind","preciseIdentifier":"s:7IvorMXL8MXLGlyphV4Kinda","kind":"typeIdentifier"}],"externalID":"s:7IvorMXL8MXLGlyphV4kindSSvp","role":"symbol","symbolKind":"property","title":"kind"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLGlyph"]]},"kind":"symbol","abstract":[{"type":"text","text":"The type of glyph being defined."}],"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLGlyph\/kind-swift.property","interfaceLanguage":"swift"},"sections":[],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"kind","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Kind","preciseIdentifier":"s:7IvorMXL8MXLGlyphV4Kinda","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLGlyph\/Kind-swift.typealias","kind":"typeIdentifier"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Maps to the MusicXML ","type":"text"},{"type":"codeVoice","code":"type"},{"text":" attribute.","type":"text"}]}]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLGlyph/kind-swift.property":{"url":"\/documentation\/ivormxl\/mxlglyph\/kind-swift.property","abstract":[{"type":"text","text":"The type of glyph being defined."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLGlyph\/kind-swift.property","type":"topic","title":"kind","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"kind"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLGlyphV4Kinda","text":"Kind"}],"role":"symbol","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLGlyph":{"url":"\/documentation\/ivormxl\/mxlglyph","title":"MXLGlyph","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLGlyph","kind":"identifier"}],"abstract":[{"type":"text","text":"The glyph element represents what SMuFL glyph should be used for different variations of symbols that are"},{"type":"text","text":" "},{"type":"text","text":"semantically identical. The type attribute specifies what type of glyph is being defined. The element value"},{"type":"text","text":" "},{"type":"text","text":"specifies what SMuFL glyph to use, including recommended stylistic alternates. The SMuFL glyph name should"},{"type":"text","text":" "},{"type":"text","text":"match the type. For instance, a type of quarter-rest would use values restQuarter, restQuarterOld, or"},{"type":"text","text":" "},{"type":"text","text":"restQuarterZ. A type of g-clef-ottava-bassa would use values gClef8vb, gClef8vbOld, or gClef8vbCClef. A type"},{"type":"text","text":" "},{"type":"text","text":"of octave-shift-up-8 would use values ottava, ottavaBassa, ottavaBassaBa, ottavaBassaVb, or octaveBassa."}],"navigatorTitle":[{"text":"MXLGlyph","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLGlyph","kind":"symbol","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLGlyph/Kind-swift.typealias":{"url":"\/documentation\/ivormxl\/mxlglyph\/kind-swift.typealias","abstract":[{"type":"text","text":"The glyph-type defines what type of glyph is being defined in a glyph element. Values include quarter-rest,"},{"type":"text","text":" "},{"type":"text","text":"g-clef-ottava-bassa, c-clef, f-clef, percussion-clef, octave-shift-up-8, octave-shift-down-8, octave-shift-"},{"type":"text","text":" "},{"type":"text","text":"continue-8, octave-shift-down-15, octave-shift-up-15, octave-shift-continue-15, octave-shift-down-22, octave-"},{"type":"text","text":" "},{"type":"text","text":"shift-up-22, and octave-shift-continue-22. This is left as a string so that other application-specific types"},{"type":"text","text":" "},{"type":"text","text":"can be defined, but it is made a separate type so that it can be redefined more strictly."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLGlyph\/Kind-swift.typealias","type":"topic","title":"MXLGlyph.Kind","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"Kind"}],"role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Kind"}]}}}