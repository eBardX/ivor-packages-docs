type":"text"},{"type":"codeVoice","code":"MXLGlyph"},{"type":"text","text":"."}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLGlyph":{"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlglyph","abstract":[{"type":"text","text":"The glyph element represents what SMuFL glyph should be used for different variations of symbols that are"},{"type":"text","text":" "},{"type":"text","text":"semantically identical. The type attribute specifies what type of glyph is being defined. The element value"},{"type":"text","text":" "},{"type":"text","text":"specifies what SMuFL glyph to use, including recommended stylistic alternates. The SMuFL glyph name should"},{"type":"text","text":" "},{"type":"text","text":"match the type. For instance, a type of quarter-rest would use values restQuarter, restQuarterOld, or"},{"type":"text","text":" "},{"type":"text","text":"restQuarterZ. A type of g-clef-ottava-bassa would use values gClef8vb, gClef8vbOld, or gClef8vbCClef. A type"},{"type":"text","text":" "},{"type":"text","text":"of octave-shift-up-8 would use values ottava, ottavaBassa, ottavaBassaBa, ottavaBassaVb, or octaveBassa."}],"navigatorTitle":[{"text":"MXLGlyph","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLGlyph","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLGlyph","title":"MXLGlyph"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLGlyph/init(value:kind:)":{"fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"value","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"kind","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Kind","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLGlyphV4Kinda"},{"text":")","kind":"text"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlglyph\/init(value:kind:)","title":"init(value:kind:)","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLGlyph\/init(value:kind:)","abstract":[{"text":"Creates a new ","type":"text"},{"code":"MXLGlyph","type":"codeVoice"},{"text":".","type":"text"}],"type":"topic","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLGlyph/Kind-swift.typealias":{"navigatorTitle":[{"text":"Kind","kind":"identifier"}],"role":"symbol","abstract":[{"type":"text","text":"The glyph-type defines what type of glyph is being defined in a glyph element. Values include quarter-rest,"},{"type":"text","text":" "},{"type":"text","text":"g-clef-ottava-bassa, c-clef, f-clef, percussion-clef, octave-shift-up-8, octave-shift-down-8, octave-shift-"},{"type":"text","text":" "},{"type":"text","text":"continue-8, octave-shift-down-15, octave-shift-up-15, octave-shift-continue-15, octave-shift-down-22, octave-"},{"type":"text","text":" "},{"type":"text","text":"shift-up-22, and octave-shift-continue-22. This is left as a string so that other application-specific types"},{"type":"text","text":" "},{"type":"text","text":"can be defined, but it is made a separate type so that it can be redefined more strictly."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLGlyph\/Kind-swift.typealias","title":"MXLGlyph.Kind","url":"\/documentation\/ivormxl\/mxlglyph\/kind-swift.typealias","type":"topic","kind":"symbol","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Kind","kind":"identifier"}]}}}