XL"},"doc://IvorMXL/documentation/IvorMXL/MXLGlyph":{"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlglyph","abstract":[{"type":"text","text":"The glyph element represents what SMuFL glyph should be used for different variations of symbols that are"},{"type":"text","text":" "},{"type":"text","text":"semantically identical. The type attribute specifies what type of glyph is being defined. The element value"},{"type":"text","text":" "},{"type":"text","text":"specifies what SMuFL glyph to use, including recommended stylistic alternates. The SMuFL glyph name should"},{"type":"text","text":" "},{"type":"text","text":"match the type. For instance, a type of quarter-rest would use values restQuarter, restQuarterOld, or"},{"type":"text","text":" "},{"type":"text","text":"restQuarterZ. A type of g-clef-ottava-bassa would use values gClef8vb, gClef8vbOld, or gClef8vbCClef. A type"},{"type":"text","text":" "},{"type":"text","text":"of octave-shift-up-8 would use values ottava, ottavaBassa, ottavaBassaBa, ottavaBassaVb, or octaveBassa."}],"navigatorTitle":[{"text":"MXLGlyph","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLGlyph","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLGlyph","title":"MXLGlyph"}}}