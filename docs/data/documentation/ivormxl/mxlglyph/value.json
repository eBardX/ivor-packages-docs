emantically identical. The type attribute specifies what type of glyph is being defined. The element value","type":"text"},{"text":" ","type":"text"},{"text":"specifies what SMuFL glyph to use, including recommended stylistic alternates. The SMuFL glyph name should","type":"text"},{"text":" ","type":"text"},{"text":"match the type. For instance, a type of quarter-rest would use values restQuarter, restQuarterOld, or","type":"text"},{"text":" ","type":"text"},{"text":"restQuarterZ. A type of g-clef-ottava-bassa would use values gClef8vb, gClef8vbOld, or gClef8vbCClef. A type","type":"text"},{"text":" ","type":"text"},{"text":"of octave-shift-up-8 would use values ottava, ottavaBassa, ottavaBassaBa, ottavaBassaVb, or octaveBassa.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLGlyph","url":"\/documentation\/ivormxl\/mxlglyph","role":"symbol","title":"MXLGlyph","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLGlyph","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"}}}