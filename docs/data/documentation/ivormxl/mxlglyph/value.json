f. A type","type":"text"},{"text":" ","type":"text"},{"text":"of octave-shift-up-8 would use values ottava, ottavaBassa, ottavaBassaBa, ottavaBassaVb, or octaveBassa.","type":"text"}],"title":"MXLGlyph","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLGlyph","kind":"identifier"}],"navigatorTitle":[{"text":"MXLGlyph","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlglyph","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLGlyph"},"doc://IvorMXL/documentation/IvorMXL/MXLGlyph/value":{"title":"value","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"value","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlglyph\/value","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLGlyph\/value","abstract":[{"text":"The value of this element.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"}}}