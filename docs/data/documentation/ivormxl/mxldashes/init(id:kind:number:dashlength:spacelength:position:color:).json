is attribute group is not used for a required id attribute, or for an id attribute that specifies an id reference.","type":"text"}]}],"name":"id"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Whether this is the start, stop, or continuation of the dashes.","type":"text"}]}],"name":"kind"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Distinguishes this set of dashes from other dashes that might be active at the same time.","type":"text"}]}],"name":"number"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The length, in tenths, of the dashes in a dashed line. Ignored if the corresponding line-type attribute is not dashed.","type":"text"}]}],"name":"dashLength"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The length, in tenths, of the spaces in a dashed line. Ignored if the corresponding line-type attribute is not dashed.","type":"text"}]}],"name":"spaceLength"},{"content":[{"type":"paragraph","inlineContent":[{"text":"For most elements, any program will compute a default x and y position. The position attributes let this be changed two ways.","type":"text"}]}],"name":"position"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The color attribute group indicates the color of an element.","type":"text"}]}],"name":"color"}]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDashes"]]},"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDashes\/init(id:kind:number:dashLength:spaceLength:position:color:)","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Creates a new "},{"code":"MXLDashes","type":"codeVoice"},{"type":"text","text":"."}],"sections":[],"variants":[{"paths":["\/documentation\/ivormxl\/mxldashes\/init(id:kind:number:dashlength:spacelength:position:color:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLDashes":{"role":"symbol","url":"\/documentation\/ivormxl\/mxldashes","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDashes","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLDashes"}],"abstract":[{"type":"text","text":"The dashes type represents dashes, used for instance with cresc. and dim. marks."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLDashes"}],"title":"MXLDashes"},"doc://IvorMXL/documentation/IvorMXL/MXLStartStopContinue":{"kind":"symbol","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStartStopContinue","navigatorTitle":[{"text":"MXLStartStopContinue","kind":"identifier"}],"title":"MXLStartStopContinue","type":"topic","url":"\/documentation\/ivormxl\/mxlstartstopcontinue","abstract":[{"type":"text","text":"The start-stop-continue type is used for an attribute of musical elements that can either start or stop, but"},{"type":"text","text":" "},{"type":"text","text":"also need to refer to an intermediate point in the symbol, as for complex slurs or for formatting of symbols"},{"type":"text","text":" "},{"type":"text","text":"across system breaks."}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLStartStopContinue","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLPosition":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlposition","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPosition"}],"kind":"symbol","abstract":[{"text":"For most elements, any program will compute a default x and y position. The position attributes let this be","type":"text"},{"text":" ","type":"text"},{"text":"changed two ways.","type":"text"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLPosition"}],"title":"MXLPosition"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLTenths":{"title":"MXLTenths","kind":"symbol","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTenths"}],"abstract":[{"type":"text","text":"The tenths type is a number representing tenths of interline staff space (positive or negative). Both integer"},{"type":"text","text":" "},{"type":"text","text":"and decimal values are allowed, such as 5 for a half space and 2.5 for a quarter space. Interline space is"},{"type":"text","text":" "},{"type":"text","text":"measured from the middle of a staff line."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLTenths"}],"url":"\/documentation\/ivormxl\/mxltenths"},"doc://IvorMXL/documentation/IvorMXL/MXLNumberLevel":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlnumberlevel","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumberLevel","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNumberLevel","kind":"identifier"}],"kind":"symbol","abstract":[{"type":"text","text":"Slurs, tuplets, and many other features can be concurrent and overlap within a single musical part. The"},{"type":"text","text":" "},{"type":"text","text":"number-level entity distinguishes up to 16 concurrent objects of the same type when the objects overlap in"},{"type":"text","text":" "},{"type":"text","text":"MusicXML document order. Values greater than 6 are usually only needed for music with a large number of divisi"},{"type":"text","text":" "},{"type":"text","text":"staves in a single part, or if there are more than 6 cross-staff arpeggios in a single measure. When a number-"},{"type":"text","text":" "},{"type":"text","text":"level value is implied, the value is 1 by default."}],"type":"topic","navigatorTitle":[{"text":"MXLNumberLevel","kind":"identifier"}],"title":"MXLNumberLevel"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"title":"MXLColor","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"abstract":[{"text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in","type":"text"},{"text":" ","type":"text"},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"url":"\/documentation\/ivormxl\/mxlcolor"},"doc://IvorMXL/documentation/IvorMXL/MXLDashes/init(id:kind:number:dashLength:spaceLength:position:color:)":{"role":"symbol","type":"topic","title":"init(id:kind:number:dashLength:spaceLength:position:color:)","url":"\/documentation\/ivormxl\/mxldashes\/init(id:kind:number:dashlength:spacelength:position:color:)","kind":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"id"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"kind"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL20MXLStartStopContinueO","kind":"typeIdentifier","text":"MXLStartStopContinue"},{"kind":"text","text":", "},{"kind":"externalParam","text":"number"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL14MXLNumberLevelV","kind":"typeIdentifier","text":"MXLNumberLevel"},{"kind":"text","text":"?