":"MXLColor"},{"kind":"text","text":"? = nil)"}],"languages":["swift"],"platforms":["macOS"]}]},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The optional-unique-id attribute group allows an element to optionally specify an ID that is unique to the entire document. This attribute group is not used for a required id attribute, or for an id attribute that specifies an id reference.","type":"text"}]}],"name":"id"},{"name":"kind","content":[{"type":"paragraph","inlineContent":[{"text":"Whether this is the start, stop, or continuation of the dashes.","type":"text"}]}]},{"name":"number","content":[{"inlineContent":[{"text":"Distinguishes this set of dashes from other dashes that might be active at the same time.","type":"text"}],"type":"paragraph"}]},{"name":"dashLength","content":[{"inlineContent":[{"text":"The length, in tenths, of the dashes in a dashed line. Ignored if the corresponding line-type attribute is not dashed.","type":"text"}],"type":"paragraph"}]},{"name":"spaceLength","content":[{"type":"paragraph","inlineContent":[{"text":"The length, in tenths, of the spaces in a dashed line. Ignored if the corresponding line-type attribute is not dashed.","type":"text"}]}]},{"name":"position","content":[{"inlineContent":[{"text":"For most elements, any program will compute a default x and y position. The position attributes let this be changed two ways.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The color attribute group indicates the color of an element."}]}],"name":"color"}],"kind":"parameters"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDashes\/init(id:kind:number:dashLength:spaceLength:position:color:)"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDashes"]]},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLNumberLevel":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumberLevel","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLNumberLevel"}],"abstract":[{"type":"text","text":"Slurs, tuplets, and many other features can be concurrent and overlap within a single musical part. The"},{"type":"text","text":" "},{"type":"text","text":"number-level entity distinguishes up to 16 concurrent objects of the same type when the objects overlap in"},{"type":"text","text":" "},{"type":"text","text":"MusicXML document order. Values greater than 6 are usually only needed for music with a large number of divisi"},{"type":"text","text":" "},{"type":"text","text":"staves in a single part, or if there are more than 6 cross-staff arpeggios in a single measure. When a number-"},{"type":"text","text":" "},{"type":"text","text":"level value is implied, the value is 1 by default."}],"kind":"symbol","title":"MXLNumberLevel","url":"\/documentation\/ivormxl\/mxlnumberlevel","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNumberLevel"}]},"doc://IvorMXL/documentation/IvorMXL/MXLDashes":{"role":"symbol","abstract":[{"text":"The dashes type represents dashes, used for instance with cresc. and dim. marks.","type":"text"}],"title":"MXLDashes","url":"\/documentation\/ivormxl\/mxldashes","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDashes","navigatorTitle":[{"kind":"identifier","text":"MXLDashes"}],"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLDashes"}]},"doc://IvorMXL/documentation/IvorMXL/MXLTenths":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLTenths"}],"abstract":[{"type":"text","text":"The tenths type is a number representing tenths of interline staff space (positive or negative). Both integer"},{"type":"text","text":" "},{"type":"text","text":"and decimal values are allowed, such as 5 for a half space and 2.5 for a quarter space. Interline space is"},{"type":"text","text":" "},{"type":"text","text":"measured from the middle of a staff line."}],"kind":"symbol","title":"MXLTenths","url":"\/documentation\/ivormxl\/mxltenths","role":"symbol","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTenths"}]},"doc://IvorMXL/documentation/IvorMXL/MXLPosition":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLPosition"}],"abstract":[{"text":"For most elements, any program will compute a default x and y position. The position attributes let this be","type":"text"},{"text":" ","type":"text"},{"text":"changed two ways.","type":"text"}],"kind":"symbol","title":"MXLPosition","url":"\/documentation\/ivormxl\/mxlposition","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPosition"}]},"doc://IvorMXL/documentation/IvorMXL/MXLStartStopContinue":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStartStopContinue","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLStartStopContinue"}],"abstract":[{"type":"text","text":"The start-stop-continue type is used for an attribute of musical elements that can either start or stop, but"},{"type":"text","text":" "},{"type":"text","text":"also need to refer to an intermediate point in the symbol, as for complex slurs or for formatting of symbols"},{"type":"text","text":" "},{"type":"text","text":"across system breaks."}],"kind":"symbol","title":"MXLStartStopContinue","url":"\/documentation\/ivormxl\/mxlstartstopcontinue","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLStartStopContinue"}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLColor","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","title":"MXLColor","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlcolor"},"doc://IvorMXL/documentation/IvorMXL/MXLDashes/init(id:kind:number:dashLength:spaceLength:position:color:)":{"abstract":[{"text":"Creates a new ","type":"text"},{"code":"MXLDashes","type":"codeVoice"},{"text":".","type":"text"}],"role":"symbol","url":"\/documentation\/ivormxl\/mxldashes\/init(id:kind:number:dashlength:spacelength:position:color:)","kind":"symbol","fragments":[{"kind":"identifier","text":"init"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"id"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"text":"?, ","kind":"text"},{"kind":"externalParam","text":"kind"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLStartStopContinue","preciseIdentifier":"s:7IvorMXL20MXLStartStopContinueO"},{"kind":"text","text":", "},{"text":"number","kind":"externalParam"},{"kind":"text","text":": "},{"text":"MXLNumberLevel","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL14MXLNumb