:["macOS"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The optional-unique-id attribute group allows an element to optionally specify an ID"},{"type":"text","text":" "},{"type":"text","text":"that is unique to the entire document. This attribute group is not used for a required"},{"type":"text","text":" "},{"type":"text","text":"id attribute, or for an id attribute that specifies an id reference."}]}],"name":"id"},{"content":[{"inlineContent":[{"text":"Whether this is the start, stop, or continuation of the dashes.","type":"text"}],"type":"paragraph"}],"name":"kind"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Distinguishes this set of dashes from other dashes that might be active at the same"},{"type":"text","text":" "},{"type":"text","text":"time."}]}],"name":"number"},{"content":[{"inlineContent":[{"text":"The length, in tenths, of the dashes in a dashed line. Ignored if the corresponding","type":"text"},{"text":" ","type":"text"},{"text":"line-type attribute is not dashed.","type":"text"}],"type":"paragraph"}],"name":"dashLength"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The length, in tenths, of the spaces in a dashed line. Ignored if the corresponding"},{"type":"text","text":" "},{"type":"text","text":"line-type attribute is not dashed."}]}],"name":"spaceLength"},{"content":[{"inlineContent":[{"text":"For most elements, any program will compute a default x and y position. The position","type":"text"},{"text":" ","type":"text"},{"text":"attributes let this be changed two ways.","type":"text"}],"type":"paragraph"}],"name":"position"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The color attribute group indicates the color of an element."}]}],"name":"color"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDashes\/init(id:kind:number:dashLength:spaceLength:position:color:)"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxldashes\/init(id:kind:number:dashlength:spacelength:position:color:)"]}],"kind":"symbol","references":{"doc://IvorMXL/documentation/IvorMXL/MXLNumberLevel":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumberLevel","navigatorTitle":[{"kind":"identifier","text":"MXLNumberLevel"}],"url":"\/documentation\/ivormxl\/mxlnumberlevel","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNumberLevel"}],"title":"MXLNumberLevel","abstract":[{"text":"Slurs, tuplets, and many other features can be concurrent and overlap within a single musical part. The","type":"text"},{"text":" ","type":"text"},{"text":"number-level entity distinguishes up to 16 concurrent objects of the same type when the objects overlap in","type":"text"},{"text":" ","type":"text"},{"text":"MusicXML document order. Values greater than 6 are usually only needed for music with a large number of divisi","type":"text"},{"text":" ","type":"text"},{"text":"staves in a single part, or if there are more than 6 cross-staff arpeggios in a single measure. When a number-","type":"text"},{"text":" ","type":"text"},{"text":"level value is implied, the value is 1 by default.","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLDashes/init(id:kind:number:dashLength:spaceLength:position:color:)":{"abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLDashes"},{"type":"text","text":"."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDashes\/init(id:kind:number:dashLength:spaceLength:position:color:)","title":"init(id:kind:number:dashLength:spaceLength:position:color:)","role":"symbol","kind":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"id"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"kind"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLStartStopContinue","preciseIdentifier":"s:7IvorMXL20MXLStartStopContinueO"},{"kind":"text","text":", "},{"kind":"externalParam","text":"number"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLNumberLevel","preciseIdentifier":"s:7IvorMXL14MXLNumberLevelV"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"dashLength"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLTenths","preciseIdentifier":"s:7IvorMXL9MXLTenthsa"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"spaceLength"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLTenths","preciseIdentifier":"s:7IvorMXL9MXLTenthsa"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"position"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLPosition","preciseIdentifier":"s:7IvorMXL11MXLPositionV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"color"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLColor","preciseIdentifier":"s:7IvorMXL8MXLColorV"},{"kind":"text","text":"?)"}],"url":"\/documentation\/ivormxl\/mxldashes\/init(id:kind:number:dashlength:spacelength:position:color:)","type":"topic"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLPosition":{"type":"topic","abstract":[{"type":"text","text":"For most elements, any program will compute a default x and y position. The position attributes let this be"},{"type":"text","text":" "},{"type":"text","text":"changed two ways."}],"url":"\/documentation\/ivormxl\/mxlposition","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPosition"}],"kind":"symbol","title":"MXLPosition","navigatorTitle":[{"kind":"identifier","text":"MXLPosition"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"type":"topic","abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"type":"text","text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is"},{"type":"text","text":" "},{"type":"text","text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF."}],"url":"\/documentation\/ivormxl\/mxlcolor","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"kind":"symbol","title":"MXLColor","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLDashes":{"abstract":[{"type":"text","text":"The dashes type represents dashes, used for instance with cresc. and dim. marks."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDashes","title":"MXLDashes","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLDashes"}],"url":"\/documentation\/ivormxl\/mxldashes","navigatorTitle":[{"kind":"identifier","text":"MXLDashes"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLTenths":{"type":"topic","abstract":[{"type":"text","text":"The tenths type is a number representing tenths of interline staff space (positive or negative). Both integer"},{"type":"text","text":" "},{"type":"text","text":"and decimal values are allowed, such as 5 for a half space and 2.5 for a quarter space. Interline space is"},{"type":"text","text":" "},{"type":"text","text":"measured from the middle of a staff line."}],"url":"\/documentation\/ivormxl\/mxltenths","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTenths"}],"kind":"symbol","title":"MXLTenths","navigatorTitle":[{"kind":"identifier","text":"MXLTenths"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLStartStopContinue":{"type":"topic","abstract":[{"type":"text","text":"The start-stop-continue type is used for an attribute of musical elements that can either start or stop, but"},{"type":"text","text":" "},{"type":"text","text":"also need to refer to an intermediate point in the symbol, as for complex slurs or for formatting of symbols"},{"type":"text","text":" "},{"type":"text","text":"across system breaks."}],"url":"\/documentation\/ivormxl\/mxlstartstopcontinue","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLStartStopContinue"}],"kind":"symbol","title":"MXLStartStopContinue","navigatorTitle":[{"text":"MXLStartStopContinue","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStartStopContinue","role":"symbol"}}}