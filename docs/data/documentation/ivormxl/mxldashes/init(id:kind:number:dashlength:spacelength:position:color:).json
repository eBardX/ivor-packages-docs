for a half space and 2.5 for a quarter space. Interline space is"},{"type":"text","text":" "},{"type":"text","text":"measured from the middle of a staff line."}]},"doc://IvorMXL/documentation/IvorMXL/MXLStartStopContinue":{"title":"MXLStartStopContinue","abstract":[{"text":"The start-stop-continue type is used for an attribute of musical elements that can either start or stop, but","type":"text"},{"text":" ","type":"text"},{"text":"also need to refer to an intermediate point in the symbol, as for complex slurs or for formatting of symbols","type":"text"},{"text":" ","type":"text"},{"text":"across system breaks.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlstartstopcontinue","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLStartStopContinue"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLStartStopContinue"}],"type":"topic","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStartStopContinue"}}}