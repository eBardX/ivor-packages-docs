{"kind":"symbol","metadata":{"modules":[{"name":"IvorMXL"}],"roleHeading":"Instance Property","role":"symbol","title":"isChord","symbolKind":"property","externalID":"s:7IvorMXL11MXLFullNoteV7isChordSbvp","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isChord","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}]},"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFullNote\/isChord","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isChord","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The duration of a chord note does not move the musical position within a measure. That is done by the duration"},{"type":"text","text":" "},{"type":"text","text":"of the first preceding note without a chord element. Thus the duration of a chord note cannot be longer than"},{"type":"text","text":" "},{"type":"text","text":"the preceding note. In most cases the duration will be the same as the preceding note. However, it can be"},{"type":"text","text":" "},{"type":"text","text":"shorter in situations such as multiple stops for string instruments."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Maps to a nested MusicXML "},{"type":"codeVoice","code":"<chord>"},{"type":"text","text":" element."}]}]}],"sections":[],"abstract":[{"type":"text","text":"A Boolean value indicating whether this note is an additional chord tone with the preceding note."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlfullnote\/ischord"]}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFullNote"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLFullNote/isChord":{"kind":"symbol","url":"\/documentation\/ivormxl\/mxlfullnote\/ischord","abstract":[{"type":"text","text":"A Boolean value indicating whether this note is an additional chord tone with the preceding note."}],"role":"symbol","type":"topic","title":"isChord","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"isChord"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFullNote\/isChord"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLFullNote":{"url":"\/documentation\/ivormxl\/mxlfullnote","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFullNote"}],"title":"MXLFullNote","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFullNote","navigatorTitle":[{"kind":"identifier","text":"MXLFullNote"}],"role":"symbol","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The full-note group is a sequence of the common note elements between cue\/grace notes and regular (full)"},{"type":"text","text":" "},{"type":"text","text":"notes: pitch, chord, and rest information, but not duration (cue and grace notes do not have duration"},{"type":"text","text":" "},{"type":"text","text":"encoded). Unpitched elements are used for unpitched percussion, speaking voice, and other musical elements"},{"type":"text","text":" "},{"type":"text","text":"lacking determinate pitch."}]}}}