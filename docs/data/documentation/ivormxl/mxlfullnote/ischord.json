{"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","abstract":[{"type":"text","text":"A Boolean value indicating whether this note is an additional chord tone with the preceding note."}],"sections":[],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"isChord"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"The duration of a chord note does not move the musical position within a measure. That is done by the duration","type":"text"},{"text":" ","type":"text"},{"text":"of the first preceding note without a chord element. Thus the duration of a chord note cannot be longer than","type":"text"},{"text":" ","type":"text"},{"text":"the preceding note. In most cases the duration will be the same as the preceding note. However, it can be","type":"text"},{"text":" ","type":"text"},{"text":"shorter in situations such as multiple stops for string instruments.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Maps to a nested MusicXML ","type":"text"},{"code":"<chord>","type":"codeVoice"},{"text":" element.","type":"text"}]}]}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFullNote\/isChord","interfaceLanguage":"swift"},"metadata":{"role":"symbol","externalID":"s:7IvorMXL11MXLFullNoteV7isChordSbvp","symbolKind":"property","title":"isChord","roleHeading":"Instance Property","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"isChord"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}],"modules":[{"name":"IvorMXL"}]},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFullNote"]]},"variants":[{"paths":["\/documentation\/ivormxl\/mxlfullnote\/ischord"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLFullNote":{"title":"MXLFullNote","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLFullNote","kind":"identifier"}],"abstract":[{"text":"The full-note group is a sequence of the common note elements between cue\/grace notes and regular (full)","type":"text"},{"text":" ","type":"text"},{"text":"notes: pitch, chord, and rest information, but not duration (cue and grace notes do not have duration","type":"text"},{"text":" ","type":"text"},{"text":"encoded). Unpitched elements are used for unpitched percussion, speaking voice, and other musical elements","type":"text"},{"text":" ","type":"text"},{"text":"lacking determinate pitch.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFullNote","role":"symbol","navigatorTitle":[{"text":"MXLFullNote","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlfullnote"},"doc://IvorMXL/documentation/IvorMXL/MXLFullNote/isChord":{"abstract":[{"type":"text","text":"A Boolean value indicating whether this note is an additional chord tone with the preceding note."}],"kind":"symbol","role":"symbol","type":"topic","title":"isChord","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFullNote\/isChord","url":"\/documentation\/ivormxl\/mxlfullnote\/ischord","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isChord","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"