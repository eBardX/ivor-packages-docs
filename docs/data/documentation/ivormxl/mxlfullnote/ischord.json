{"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isChord","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The duration of a chord note does not move the musical position within a measure. That is done by the duration"},{"type":"text","text":" "},{"type":"text","text":"of the first preceding note without a chord element. Thus the duration of a chord note cannot be longer than"},{"type":"text","text":" "},{"type":"text","text":"the preceding note. In most cases the duration will be the same as the preceding note. However, it can be"},{"type":"text","text":" "},{"type":"text","text":"shorter in situations such as multiple stops for string instruments."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Maps to a nested MusicXML "},{"type":"codeVoice","code":"<chord>"},{"type":"text","text":" element."}]}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFullNote\/isChord"},"kind":"symbol","variants":[{"paths":["\/documentation\/ivormxl\/mxlfullnote\/ischord"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFullNote"]]},"sections":[],"abstract":[{"text":"A Boolean value indicating whether this note is an additional chord tone with the preceding note.","type":"text"}],"metadata":{"symbolKind":"property","externalID":"s:7IvorMXL11MXLFullNoteV7isChordSbvp","modules":[{"name":"IvorMXL"}],"roleHeading":"Instance Property","role":"symbol","title":"isChord","fragments":[{"text":"let","kind":"keyword"},{"t