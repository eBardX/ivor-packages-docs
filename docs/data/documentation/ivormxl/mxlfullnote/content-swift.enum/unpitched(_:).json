{"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"A note notated on the staff but lacking definite pitch, such as unpitched percussion or a speaking voice.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"unpitched"},{"kind":"text","text":"("},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLUnpitched","kind":"typeIdentifier","text":"MXLUnpitched","preciseIdentifier":"s:7IvorMXL12MXLUnpitchedV"},{"kind":"text","text":")"}],"languages":["swift"],"platforms":["macOS"]}]}],"metadata":{"roleHeading":"Case","title":"MXLFullNote.Content.unpitched(_:)","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"unpitched"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"MXLUnpitched","preciseIdentifier":"s:7IvorMXL12MXLUnpitchedV"},{"kind":"text","text":")"}],"modules":[{"name":"IvorMXL"}],"role":"symbol","symbolKind":"case","externalID":"s:7IvorMXL11MXLFullNoteV7ContentO9unpitchedyAeA12MXLUnpitchedVcAEmF"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFullNote","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFullNote\/Content-swift.enum"]]},"variants":[{"paths":["\/documentation\/ivormxl\/mxlfullnote\/content-swift.enum\/unpitched(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFullNote\/Content-swift.enum\/unpitched(_:)"},"sections":[],"kind":"symbol","references":{"doc://IvorMXL/documentation/IvorMXL/MXLUnpitched":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLUnpitched","url":"\/documentation\/ivormxl\/mxlunpitched","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLUnpitched","kind":"identifier"}],"abstract":[{"text":"The unpitched type represents musical elements that are notated on the staff but lack definite pitch, such as","type":"text"},{"text":" ","type":"text"},{"text":"unpitched percussion and speaking voice. If the child elements are not present, the note is placed on the","type":"text"},{"text":" ","type":"text"},{"text":"middle line of the staff. This is generally used with a one-line staff. Notes in percussion clef should always","type":"text"},{"text":" ","type":"text"},{"text":"use an unpitched element rather than a pitch element.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"MXLUnpitched"}],"title":"MXLUnpitched","type":"topic","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLFullNote":{"url":"\/documentation\/ivormxl\/mxlfullnote","role":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFullNote","abstract":[{"type":"text","text":"The full-note group is a sequence of the common note elements between cue\/grace notes and regular (full)"},{"type":"text","text":" "},{"type":"text","text":"notes: pitch, chord, and rest information, but not duration (cue and grace notes do not have duration"},{"type":"text","text":" "},{"type":"text","text":"encoded). Unpitched elements are used for unpitched percussion, speaking voice, and other musical elements"},{"type":"text","text":" "},{"type":"text","text":"lacking determinate pitch."}],"title":"MXLFullNote","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLFullNote","kind":"identifier"}],"navigatorTitle":[{"text":"MXLFullNote","kind":"identifier"}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLFullNote/Content-swift.enum":{"abstract":[{"type":"text","text":"O