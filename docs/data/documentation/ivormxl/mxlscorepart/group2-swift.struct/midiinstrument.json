rt","kind":"identifier"}],"title":"MXLScorePart"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLMidiInstrument":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlmidiinstrument","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMidiInstrument","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLMidiInstrument"}],"abstract":[{"type":"text","text":"The midi-instrument type defines MIDI 1.0 instrument playback. The midi-instrument element can be a part of"},{"type":"text","text":" "},{"type":"text","text":"either the score-instrument element at the start of a part, or the sound element within a part. The id"},{"type":"text","text":" "},{"type":"text","text":"attribute refers to the score-instrument affected by the change."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLMidiInstrument"}],"title":"MXLMidiInstrument"}}}