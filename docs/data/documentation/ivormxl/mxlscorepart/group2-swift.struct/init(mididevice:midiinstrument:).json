ct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLScorePart","kind":"identifier"}],"title":"MXLScorePart","navigatorTitle":[{"text":"MXLScorePart","kind":"identifier"}],"abstract":[{"type":"text","text":"The score-part type collects part-wide information for each part in a score. Often, each MusicXML part"},{"type":"text","text":" "},{"type":"text","text":"corresponds to a track in a Standard MIDI Format 1 file. In this case, the midi-device element is used to make"},{"type":"text","text":" "},{"type":"text","text":"a MIDI device or port assignment for the given track or specific MIDI instruments. Initial midi-instrument"},{"type":"text","text":" "},{"type":"text","text":"assignments may be made here as well. The score-instrument elements are used when there are multiple"},{"type":"text","text":" "},{"type":"text","text":"instruments per track."}],"url":"\/documentation\/ivormxl\/mxlscorepart","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePart","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLMidiDevice":{"type":"topic","title":"MXLMidiDevice","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLMidiDevice","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlmididevice","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMidiDevice","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"MXLMidiDevice","kind":"identifier"}],"abstract":[{"type":"text","text":"The midi-device type corresponds to the DeviceName meta event in Standard MIDI Files. The optional port"},{"type":"text","text":" "},{"type":"text","text":"attribute is a number from 1 to 16 that can be used with the unofficial MIDI 1.0 port (or cable) meta event."},{"type":"text","text":" "},{"type":"text","text":"Unlike the DeviceName meta event, there can be multiple midi-device elements per MusicXML part. The optional"},{"type":"text","text":" "},{"type":"text","text":"id attribute refers to the score-instrument assigned to this device. If missing, the device assignment affects"},{"type":"text","text":" "},{"type":"text","text":"all score-instrument elements in the score-part."}]},"doc://IvorMXL/documentation/IvorMXL/MXLScorePart/Group2-swift.struct":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePart\/Group2-swift.struct","url":"\/documentation\/ivormxl\/mxlscorepart\/group2-swift.struct","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Group2"}],"abstract":[{"text":"A single MIDI device and instrument assignment for a score-part.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"Group2"}],"title":"MXLScorePart.Group2","type":"topic","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLMidiInstrument":{"title":"MXLMidiInstrument","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMidiInstrument","navigatorTitle":[{"text":"MXLMidiInstrument","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLMidiInstrument","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"The midi-instrument type defines MIDI 1.0 instrument playback. The midi-instrument element can be a part of","type":"text"},{"text":" ","type":"text"},{"text":"either the score-instrument element at the start of a part, or the sound element within a part. The id","type":"text"},{"text":" ","type":"text"},{"text":"attribute refers to the score-instrument affected by the change.","type":"text"}],"role":"symbol","url":"\/documentation\/ivormxl\/mxlmidiinstrument"}}}