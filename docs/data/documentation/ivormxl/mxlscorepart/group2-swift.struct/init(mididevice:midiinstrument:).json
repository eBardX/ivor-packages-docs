tle":"MXLMidiDevice"},"doc://IvorMXL/documentation/IvorMXL/MXLScorePart":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlscorepart","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePart","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLScorePart","kind":"identifier"}],"abstract":[{"text":"The score-part type collects part-wide information for each part in a score. Often, each MusicXML part","type":"text"},{"text":" ","type":"text"},{"text":"corresponds to a track in a Standard MIDI Format 1 file. In this case, the midi-device element is used to make","type":"text"},{"text":" ","type":"text"},{"text":"a MIDI device or port assignment for the given track or specific MIDI instruments. Initial midi-instrument","type":"text"},{"text":" ","type":"text"},{"text":"assignments may be made here as well. The score-instrument elements are used when there are multiple","type":"text"},{"text":" ","type":"text"},{"text":"instruments per track.","type":"text"}],"kind":"symbol","type":"topic","navigatorTitle":[{"text":"MXLScorePart","kind":"identifier"}],"title":"MXLScorePart"},"doc://IvorMXL/documentation/IvorMXL/MXLScorePart/Group2-swift.struct":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePart\/Group2-swift.struct","role":"symbol","kind":"symbol","url":"\/documentation\/ivormxl\/mxlscorepart\/group2-swift.struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Group2","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"Group2","kind":"identifier"}],"title":"MXLScorePart.Group2","abstract":[{"text":"A single MIDI device and instrument assignment for a score-part.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLScorePart/Group2-swift.struct/init(midiDevice:midiInstrument:)":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePart\/Group2-swift.struct\/init(midiDevice:midiInstrument:)","role":"symbol","kind":"symbol","url":"\/documentation