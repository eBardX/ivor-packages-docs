","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePart\/Group2-swift.struct","abstract":[{"text":"A single MIDI device and instrument assignment for a score-part.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLMidiDevice":{"abstract":[{"type":"text","text":"The midi-device type corresponds to the DeviceName meta event in Standard MIDI Files. The optional port"},{"type":"text","text":" "},{"type":"text","text":"attribute is a number from 1 to 16 that can be used with the unofficial MIDI 1.0 port (or cable) meta event."},{"type":"text","text":" "},{"type":"text","text":"Unlike the DeviceName meta event, there can be multiple midi-device elements per MusicXML part. The optional"},{"type":"text","text":" "},{"type":"text","text":"id attribute refers to the score-instrument assigned to this device. If missing, the device assignment affects"},{"type":"text","text":" "},{"type":"text","text":"all score-instrument elements in the score-part."}],"title":"MXLMidiDevice","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLMidiDevice","kind":"identifier"}],"navigatorTitle":[{"text":"MXLMidiDevice","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlmididevice","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMidiDevice"},"doc://IvorMXL/documentation/IvorMXL/MXLScorePart":{"abstract":[{"type":"text","text":"The score-part type collects part-wide information for each part in a score. Often, each MusicXML part"},{"type":"text","text":" "},{"type":"text","text":"corresponds to a track in a Standard MIDI Format 1 file. In this case, the midi-device element is used to make"},{"type":"text","text":" "},{"type":"text","text":"a MIDI device or port assignment for the given track or specific MIDI instruments. Initial midi-instrument"},{"type":"text","text":" "},{"type":"text","text":"assignments may be made here as well. The score-instrument elements are used when there are multiple"},{"type":"text","text":" "},{"type":"text","text":"instruments per track."}],"title":"MXLScorePart","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLScorePart"}],"navigatorTitle":[{"kind":"identifier","text":"MXLScorePart"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlscorepart","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePart"},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLMidiInstrument":{"title":"MXLMidiInstrument","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLMidiInstrument","kind":"identifier"}],"kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxlmidiinstrument","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMidiInstrument","abstract":[{"text":"The midi-instrument type defines MIDI 1.0 instrument playback. The midi-instrument element can be a part of","type":"text"},{"text":" ","type":"text"},{"text":"either the score-instrument element at the start of a part, or the sound element within a part. The id","type":"text"},{"text":" ","type":"text"},{"text":"attribute refers to the score-instrument affected by the change.","type":"text"}],"navigatorTitle":[{"text":"MXLMidiInstrument","kind":"identifier"}]}}}