{"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","metadata":{"modules":[{"name":"IvorMXL"}],"roleHeading":"Instance Property","symbolKind":"property","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"text":"midiDevice","kind":"identifier"},{"kind":"text","text":": "},{"text":"MXLMidiDevice","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL13MXLMidiDeviceV"},{"kind":"text","text":"?"}],"role":"symbol","title":"midiDevice","externalID":"s:7IvorMXL12MXLScorePartV6Group2V10midiDeviceAA07MXLMidiG0VSgvp"},"sections":[],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"midiDevice","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLMidiDevice","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMidiDevice","preciseIdentifier":"s:7IvorMXL13MXLMidiDeviceV"},{"text":"?","kind":"text"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"}],"abstract":[{"type":"text","text":"The MIDI device assignment for this element."}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePart","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePart\/Group2-swift.struct"]]},"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePart\/Group2-swift.struct\/midiDevice","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlscorepart\/group2-swift.struct\/mididevice"]}],"references":{"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLMidiDevice":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlmididevice","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMidiDevice","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLMidiDevice"}],"abstract":[{"type":"text","text":"The midi-device type corresponds to the DeviceName meta event in Standard MIDI Files. The optional port"},{"type":"text","text":" "},{"type":"text","text":"attribute is a number from 1 to 16 that can be used with the unofficial MIDI 1.0 port (or cable) meta event."},{"type":"text","text":" "},{"type":"text","text":"Unlike the DeviceName meta event, there can be multiple midi-device elements per MusicXML part. The optional"},{"type":"text","text":" "},{"type":"text","text":"id attribute refers to the score-instrument assigned to this device. If missing, the device assignment affects"},{"type":"text","text":" "},{"type":"text","text":"all score-instrument elements in the score-part."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLMidiDevice"}],"title":"MXLMidiDevice"},"doc://IvorMXL/documentation/IvorMXL/MXLScorePart":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlscorepart","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePart","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLScorePart","kind":"identifier"}],"abstract":[{"text":"The score-part type collects part-wide information for each part in a score. Often, each MusicXML part","type":"text"},{"text":" ","type":"text"},{"text":"corresponds to a track in a Standard MIDI Format 1 file. In this case, the midi-device element is used to make","type":"text"},{"text":" ","type":"text"},{"text":"a MIDI device or port assignment for the given track or specific MIDI instruments. Initial midi-instrument","type":"text"},{"text":" ","type":"text"},{"text":"assignments may be made here as well. The score-instrument elements are used when there are multiple","type":"text"},{"text":" ","type":"text"},{"text":"instruments per track.","type":"text"}],"kind":"symbol","type":"topic","navigatorTitle":[{"text":"MXLScorePart","kind":"identifier"}],"title":"MXLScorePart"},"doc://IvorMXL/documentation/IvorMXL/MXLScorePart/Group2-swift.struct":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePart\/Group2-swift.struct","role":"symbol","kind":"symbol","url":"\/documentation\/ivormxl\/mxlscorepart\/group2-swift.struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Group2","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"Group2","kind":"identifier"}],"title":"MXLScorePart.Group2","abstract":[{"text":"A single MIDI device and instrument assignment for a score-part.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLScorePart/Group2-swift.struct/midiDevice":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePart\/Group2-swift.struct\/midiDevice","role":"symbol","kind":"symbol","url":"\/documentation\/ivormxl\/mxlscorepart\/group2-swift.struct\/mididevice","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"midiDevice","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL13MXLMidiDeviceV","text":"MXLMidiDevice","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"type":"topic","title":"midiDevice","abstract":[{"text":"The MIDI device assignment for this element.","type":"text"}]}}}