{"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePart\/Group2-swift.struct\/midiDevice","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"metadata":{"role":"symbol","roleHeading":"Instance Property","modules":[{"name":"IvorMXL"}],"title":"midiDevice","externalID":"s:7IvorMXL12MXLScorePartV6Group2V10midiDeviceAA07MXLMidiG0VSgvp","symbolKind":"property","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"midiDevice","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL13MXLMidiDeviceV","text":"MXLMidiDevice","kind":"typeIdentifier"},{"text":"?","kind":"text"}]},"kind":"symbol","primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"midiDevice","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL13MXLMidiDeviceV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMidiDevice","text":"MXLMidiDevice","kind":"typeIdentifier"},{"text":"?","kind":"text"}]}],"kind":"declarations"}],"abstract":[{"type":"text","text":"The MIDI device assignment for this element."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlscorepart\/group2-swift.struct\/mididevice"]}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePart","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePart\/Group2-swift.struct"]]},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLScorePart/Group2-swift.struct":{"abstract":[{"type":"text","text":"A single MIDI device and instrument assignment for a score-part."}],"navigatorTitle":[{"text":"Group2","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePart\/Group2-swift.struct","title":"MXLScorePart.Group2","url":"\/documentation\/ivormxl\/mxlscorepart\/group2-swift.struct","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Group2"}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLScorePart":{"type":"topic","title":"MXLScorePart","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePart","abstract":[{"text":"The score-part type collects part-wide information for each part in a score. Often, each MusicXML part","type":"text"},{"text":" ","type":"text"},{"text":"corresponds to a track in a Standard MIDI Format 1 file. In this case, the midi-device element is used to make","type":"text"},{"text":" ","type":"text"},{"text":"a MIDI device or port assignment for the given track or specific MIDI instruments. Initial midi-instrument","type":"text"},{"text":" ","type":"text"},{"text":"assignments may be made here as well. The score-instrument elements are used when there are multiple","type":"text"},{"text":" ","type":"text"},{"text":"instruments per track.","type":"text"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLScorePart"}],"navigatorTitle":[{"kind":"identifier","text":"MXLScorePart"}],"url":"\/documentation\/ivormxl\/mxlscorepart"},"doc://IvorMXL/documentation/IvorMXL/MXLScorePart/Group2-swift.struct/midiDevice":{"role":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePart\/Group2-swift.struct\/midiDevice","title":"midiDevice","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"midiDevice","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL13MXLMidiDeviceV","text":"MXLMidiDevice","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"kind":"symbol","abstract":[{"type":"text","text":"The MIDI device assignment for this element."}],"url":"\/documentation\/ivormxl\/mxlscorepart\/group2-swift.struct\/mididevice"},"doc://IvorMXL/documentation/IvorMXL/MXLMidiDevice":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMidiDevice","navigatorTitle":[{"kind":"identifier","text":"MXLMidiDevice"}],"url":"\/documentation\/ivormxl\/mxlmididevice","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLMidiDevice"}],"title":"MXLMidiDevice","abstract":[{"type":"text","text":"The midi-device type corresponds to the DeviceName meta event in Standard MIDI Files. The optional port"},{"type":"text","text":" "},{"type":"text","text":"attribute is a number from 1 to 16 that can be used with the unofficial MIDI 1.0 port (or cable) meta event."},{"type":"text","text":" "},{"type":"text","text":"Unlike the DeviceName meta event, there can be multiple midi-device elements per MusicXML part. The optional"},{"type":"text","text":" "},{"type":"text","text":"id attribute refers to the score-instrument assigned to this device. If missing, the device assignment affects"},{"type":"text","text":" "},{"type":"text","text":"all score-instrument elements in the score-part."}],"type":"topic"}}}