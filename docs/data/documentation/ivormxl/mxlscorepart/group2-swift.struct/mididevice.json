{"abstract":[{"type":"text","text":"The MIDI device assignment for this element."}],"sections":[],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePart\/Group2-swift.struct\/midiDevice"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePart","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePart\/Group2-swift.struct"]]},"metadata":{"role":"symbol","symbolKind":"property","roleHeading":"Instance Property","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"midiDevice","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLMidiDevice","preciseIdentifier":"s:7IvorMXL13MXLMidiDeviceV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"modules":[{"name":"IvorMXL"}],"externalID":"s:7IvorMXL12MXLScorePartV6Group2V10midiDeviceAA07MXLMidiG0VSgvp","title":"midiDevice"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"midiDevice","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLMidiDevice","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMidiDevice","preciseIdentifier":"s:7IvorMXL13MXLMidiDeviceV"},{"text":"?","kind":"text"}],"platforms":["macOS"]}],"kind":"declarations"}],"variants":[{"paths":["\/documentation\/ivormxl\/mxlscorepart\/group2-swift.struct\/mididevice"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLMidiDevice":{"type":"topic","title":"MXLMidiDevice","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLMidiDevice","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlmididevice","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMidiDevice","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"MXLMidiDevice","kind":"identifier"}],"abstract":[{"type":"text","text":"The midi-device type corresponds to the DeviceName meta event in Standard MIDI Files. The optional port"},{"type":"text","text":" "},{"type":"text","text":"attribute is a number from 1 to 16 that can be used with the unofficial MIDI 1.0 port (or cable) meta event."},{"type":"text","text":" "},{"type":"text","text":"Unlike the DeviceName meta event, there can be multiple midi-device elements per MusicXML part. The optional"},{"type":"text","text":" "},{"type":"text","text":"id attribute refers to the score-instrument assigned to this device. If missing, the device assignment affects"},{"type":"text","text":" "},{"type":"text","text":"all score-instrument elements in the score-part."}]},"doc://IvorMXL/documentation/IvorMXL/MXLScorePart/Group2-swift.struct/midiDevice":{"url":"\/documentation\/ivormxl\/mxlscorepart\/group2-swift.struct\/mididevice","abstract":[{"text":"The MIDI device assignment for this element.","type":"text"}],"role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"midiDevice","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLMidiDevice","preciseIdentifier":"s:7IvorMXL13MXLMidiDeviceV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePart\/Group2-swift.struct\/midiDevice","title":"midiDevice","type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLScorePart/Group2-swift.struct":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePart\/Group2-swift.struct","url":"\/documentation\/ivormxl\/mxlscorepart\/group2-swift.struct","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Group2"}],"abstract":[{"text":"A single MIDI device and instrument assignment for a score-part.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"Group2"}],"title":"MXLScorePart.Group2","type":"topic","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLScorePart":{"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLScorePart","kind":"identifier"}],"title":"MXLScorePart","navigatorTitle":[{"text":"MXLScorePart","kind":"identifier"}],"abstract":[{"type":"text","text":"The score-part type collects part-wide information for each part in a score. Often, each MusicXML part"},{"type":"text","text":" "},{"type":"text","text":"corresponds to a track in a Standard MIDI Format 1 file. In this case, the midi-device element is used to make"},{"type":"text","text":" "},{"type":"text","text":"a MIDI device or port assignment for the given track or specific MIDI instruments. Initial midi-instrument"},{"type":"text","text":" "},{"type":"text","text":"assignments may be made here as well. The score-instrument elements are used when there are multiple"},{"type":"text","text":" "},{"type":"text","text":"instruments per track."}],"url":"\/documentation\/ivormxl\/mxlscorepart","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePart","role":"symbol"}}}