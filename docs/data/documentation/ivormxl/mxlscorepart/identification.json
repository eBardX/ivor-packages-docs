":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLScorePart":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlscorepart","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePart","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLScorePart","kind":"identifier"}],"abstract":[{"text":"The score-part type collects part-wide information for each part in a score. Often, each MusicXML part","type":"text"},{"text":" ","type":"text"},{"text":"corresponds to a track in a Standard MIDI Format 1 file. In this case, the midi-device element is used to make","type":"text"},{"text":" ","type":"text"},{"text":"a MIDI device or port assignment for the given track or specific MIDI instruments. Initial midi-instrument","type":"text"},{"text":" ","type":"text"},{"text":"assignments may be made here as well. The score-instrument elements are used when there are multiple","type":"text"},{"text":" ","type":"text"},{"text":"instruments per track.","type":"text"}],"kind":"symbol","type":"topic","navigatorTitle":[{"text":"MXLScorePart","kind":"identifier"}],"title":"MXLScorePart"},"doc://IvorMXL/documentation/IvorMXL/MXLScorePart/identification":{"abstract":[{"text":"Identification information specific to this part.","type":"text"}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"identification","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLIdentification","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL17MXLIdentificationV"},{"text":"?","kind":"text"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePart\/identification","title":"identification","url":"\/documentation\/ivormxl\/mxlscorepart\/identification","type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLIdentification":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlidentification","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLIdentification","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLIdentification"}],"kind":"symbol","abstract":[{"text":"Identification contains basic metadata about the score. It includes information that may apply at a score-","type":"text"},{"text":" ","type":"text"},{"text":"wide, movement-wide, or part-wide level. The creator, rights, source, and relation elements are based on","type":"text"},{"text":" ","type":"text"},{"text":"Dublin Core.","type":"text"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLIdentification"}],"title":"MXLIdentification"}}}