{"abstract":[{"type":"text","text":"The group element allows the use of different versions of the part for different purposes. Typical values"},{"type":"text","text":" "},{"type":"text","text":"include score, parts, sound, and data. Ordering information can be derived from the ordering within a MusicXML"},{"type":"text","text":" "},{"type":"text","text":"score or opus."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"group","kind":"identifier"},{"text":": [","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"]","kind":"text"}],"platforms":["macOS"]}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"inlineContent":[{"text":"Maps to nested MusicXML ","type":"text"},{"code":"<group>","type":"codeVoice"},{"text":" elements.","type":"text"}],"type":"paragraph"}]}],"kind":"symbol","sections":[],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePart\/group","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePart"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlscorepart\/group"]}],"metadata":{"modules":[{"name":"IvorMXL"}],"externalID":"s:7IvorMXL12MXLScorePartV5groupSaySSGvp","roleHeading":"Instance Property","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"group","kind":"identifier"},{"text":": [","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"]","kind":"text"}],"title":"group","symbolKind":"property"},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLScorePart/group":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePart\/group","title":"group