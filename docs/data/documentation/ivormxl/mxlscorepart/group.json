{"abstract":[{"type":"text","text":"The group element allows the use of different versions of the part for different purposes. Typical values"},{"type":"text","text":" "},{"type":"text","text":"include score, parts, sound, and data. Ordering information can be derived from the ordering within a MusicXML"},{"type":"text","text":" "},{"type":"text","text":"score or opus."}],"metadata":{"title":"group","modules":[{"name":"IvorMXL"}],"role":"symbol","externalID":"s:7IvorMXL12MXLScorePartV5groupSaySSGvp","symbolKind":"property","roleHeading":"Instance Property","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"group"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"]"}]},"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePart"]]},"variants":[{"paths":["\/documentation\/ivormxl\/mxlscorepart\/group"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"group"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"]"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Maps to nested MusicXML "},{"type":"codeVoice","code":"<group>"},{"type":"text","text":" elements."}]}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePart\/group"},"sections":[],"kind":"symbol","references":{"doc://IvorMXL/documentation/IvorMXL/MXLScorePart":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlscorepart","identifier":"doc:\/\/IvorMXL\/do