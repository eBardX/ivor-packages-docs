ruct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNameDisplay","kind":"identifier"}],"navigatorTitle":[{"text":"MXLNameDisplay","kind":"identifier"}],"abstract":[{"text":"The name-display type is used for exact formatting of multi-font text in part and group names to the left of","type":"text"},{"text":" ","type":"text"},{"text":"the system. The print-object attribute can be used to determine what, if anything, is printed at the start of","type":"text"},{"text":" ","type":"text"},{"text":"each system. Enclosure for the display-text element is none by default. Language for the display-text element","type":"text"},{"text":" ","type":"text"},{"text":"is Italian (“it”) by default.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNameDisplay"},"doc://IvorMXL/documentation/IvorMXL/MXLScorePart":{"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLScorePart","kind":"identifier"}],"title":"MXLScorePart","navigatorTitle":[{"text":"MXLScorePart","kind":"identifier"}],"abstract":[{"type":"text","text":"The score-part type collects part-wide information for each part in a score. Often, each MusicXML part"},{"type":"text","text":" "},{"type":"text","text":"corresponds to a track in a Standard MIDI Format 1 file. In this case, the midi-device element is used to make"},{"type":"text","text":" "},{"type":"text","text":"a MIDI device or port assignment for the given track or specific MIDI instruments. Initial midi-instrument"},{"type":"text","text":" "},{"type":"text","text":"assignments may be made here as well. The score-instrument elements are used when there are multiple"},{"type":"text","text":" "},{"type":"text","text":"instruments per track."}],"url":"\/documentation\/ivormxl\/mxlscorepart","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePart","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLScorePart/abbreviationDisplay":{"identifier"