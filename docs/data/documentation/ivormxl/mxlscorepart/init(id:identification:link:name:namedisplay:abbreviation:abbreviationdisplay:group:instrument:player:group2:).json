:"text"},{"text":" ","type":"text"},{"text":"each score-instrument has a required ID attribute, a name, and an optional abbreviation.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlscoreinstrument","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLScoreInstrument","kind":"identifier"}],"kind":"symbol","title":"MXLScoreInstrument","navigatorTitle":[{"text":"MXLScoreInstrument","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScoreInstrument","role":"symbol"}}}