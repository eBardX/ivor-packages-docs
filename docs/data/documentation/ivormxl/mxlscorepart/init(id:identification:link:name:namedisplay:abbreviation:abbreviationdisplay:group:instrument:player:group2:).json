ind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPartLink","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"MXLPartLink"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlpartlink","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartLink"},"doc://IvorMXL/documentation/IvorMXL/MXLScoreInstrument":{"title":"MXLScoreInstrument","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLScoreInstrument"}],"kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxlscoreinstrument","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScoreInstrument","abstract":[{"text":"The score-instrument type represents a single instrument within a score-part. As with the score-part type,","type":"text"},{"text":" ","type":"text"},{"text":"each score-instrument has a required ID attribute, a name, and an optional abbreviation.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"MXLScoreInstrument"}]},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLScorePart":{"abstract":[{"type":"text","text":"The score-part type collects part-wide information for each part in a score. Often, each MusicXML part"},{"type":"text","text":" "},{"type":"text","text":"corresponds to a track in a Standard MIDI Format 1 file. In this case, the midi-device element is used to make"},{"type":"text","text":" "},{"type":"text","text":"a MIDI device or port assignment for the given track or specific MIDI instruments. Initial midi-instrument"},{"type":"text","text":" "},{"type":"text","text":"assignments may be made here as well. The score-instrument elements are used when there are multiple"},{"type":"text","text":" "},{"type":"text","text":"instruments per track."}],"title":"MXLScorePart","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLScorePart"}],"navigatorTitle":[{"kind":"identifier","text":"MXLScorePart"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlscorepart","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePart"},"doc://IvorMXL/documentation/IvorMXL/MXLPartName":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartName","title":"MXLPartName","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPartName","kind":"identifier"}],"navigatorTitle":[{"text":"MXLPartName","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlpartname","abstract":[{"text":"The part-name type describes the name or abbreviation of a score-part element. Formatting attributes for the","type":"text"},{"text":" ","type":"text"},{"text":"part-name element are deprecated in Version 2.0 in favor of the new part-name-display and part-abbreviation-","type":"text"},{"text":" ","type":"text"},{"text":"display elements.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLPlayer":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPlayer","title":"MXLPlayer","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPlayer","kind":"identifier"}],"navigatorTitle":[{"text":"MXLPlayer","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlplayer","abstract":[{"text":"The player type allows for multiple players per score-part for use in listening applications. One player may","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"play multiple instruments, while a single instrument may include multiple players in divisi sections."}]},"doc://IvorMXL/documentation/IvorMXL/MXLScorePart/Group2-swift.struct":{"