ction"},"doc://IvorMXL/documentation/IvorMXL/MXLScorePart":{"abstract":[{"type":"text","text":"The score-part type collects part-wide information for each part in a score. Often, each MusicXML part"},{"type":"text","text":" "},{"type":"text","text":"corresponds to a track in a Standard MIDI Format 1 file. In this case, the midi-device element is used to make"},{"type":"text","text":" "},{"type":"text","text":"a MIDI device or port assignment for the given track or specific MIDI instruments. Initial midi-instrument"},{"type":"text","text":" "},{"type":"text","text":"assignments may be made here as well. The score-instrument elements are used when there are multiple"},{"type":"text","text":" "},{"type":"text","text":"instruments per track."}],"title":"MXLScorePart","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLScorePart"}],"navigatorTitle":[{"kind":"identifier","text":"MXLScorePart"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlscorepart","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePart"},"doc://IvorMXL/documentation/IvorMXL/MXLScorePart/link":{"abstract":[{"text":"Links this score-part to MusicXML documents that contain parts data.","type":"text"}],"title":"link","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePart\/link","kind":"symbol","url":"\/documentation\/ivormxl\/mxlscorepart\/link","type":"topic","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"link"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:7IvorMXL11MXLPartLinkV","kind":"typeIdentifier","text":"MXLPartLink"},{"kind":"text","text":"]"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLPartLink":{"abstract":[{"text":"The part-link type allows MusicXML data for both score and parts to be contained within a single compressed","type":"text"},{"text":" ","type":"text"},{"text":"MusicXML file. It links a score-part from a score document to MusicXML documents that contain parts data. In","type":"text"},{"text":" ","type":"text"},{"text":"the case of a single compressed MusicXML file, the link href values are paths that are relative to the root","type":"text"},{"text":" ","type":"text"},{"text":"folder of the zip file.","type":"text"}],"title":"MXLPartLink","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPartLink","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"MXLPartLink"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlpartlink","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartLink"}}}