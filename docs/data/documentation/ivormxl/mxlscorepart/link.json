{"kind":"symbol","abstract":[{"type":"text","text":"Links this score-part to MusicXML documents that contain parts data."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"link","kind":"identifier"},{"text":": [","kind":"text"},{"text":"MXLPartLink","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLPartLinkV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartLink"},{"text":"]","kind":"text"}],"platforms":["macOS"]}]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Maps to a nested MusicXML "},{"type":"codeVoice","code":"<part-link>"},{"type":"text","text":" element."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlscorepart\/link"]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePart"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePart\/link"},"metadata":{"symbolKind":"property","role":"symbol","roleHeading":"Instance Property","modules":[{"name":"IvorMXL"}],"title":"link","externalID":"s:7IvorMXL12MXLScorePartV4linkSayAA11MXLPartLinkVGvp","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"link"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:7IvorMXL11MXLPartLinkV","kind":"typeIdentifier","text":"MXLPartLink"},{"kind":"text","text":"]"}]},"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLPartLink":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartLink","url":"\/documentation\/ivormxl\/mxlpartlink","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPartLink"}],"abstract":[{"type":"text","text":"The part-link type allows MusicXML data for both score and parts to be contained within a single compressed"},{"type":"text","text":" "},{"type":"text","text":"MusicXML file. It links a score-part from a score document to MusicXML documents that contain parts data. In"},{"type":"text","text":" "},{"type":"text","text":"the case of a single compressed MusicXML file, the link href values are paths that are relative to the root"},{"type":"text","text":" "},{"type":"text","text":"folder of the zip file."}],"navigatorTitle":[{"text":"MXLPartLink","kind":"identifier"}],"title":"MXLPartLink","type":"topic","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLScorePart":{"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLScorePart","kind":"identifier"}],"title":"MXLScorePart","navigatorTitle":[{"text":"MXLScorePart","kind":"identifier"}],"abstract":[{"type":"text","text":"The score-part type collects part-wide information for each part in a score. Often, each MusicXML part"},{"type":"text","text":" "},{"type":"text","text":"corresponds to a track in a Standard MIDI Format 1 file. In this case, the midi-device element is used to make"},{"type":"text","text":" "},{"type":"text","text":"a MIDI device or port assignment for the given track or specific MIDI instruments. Initial midi-instrument"},{"type":"text","text":" "},{"type":"text","text":"assignments may be made here as well. The score-instrument elements are used when there are multiple"},{"type":"text","text":" "},{"type":"text","text":"instruments per track."}],"url":"\/documentation\/ivormxl\/mxlscorepart","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePart","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLScorePart/link":{"title":"link","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"link"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:7IvorMXL11MXLPartLinkV","kind":"typeIdentifier","text":"MXLPartLink"},{"kind":"text","text":"]"}],"type":"topic","abstract":[{"type":"text","text":"Links this score-part to MusicXML documents that contain parts data."}],"url":"\/documentation\/ivormxl\/mxlscorepart\/link","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePart\/link"}}}