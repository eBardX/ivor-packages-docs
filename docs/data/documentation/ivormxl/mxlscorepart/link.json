ormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLScorePart":{"type":"topic","title":"MXLScorePart","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePart","abstract":[{"text":"The score-part type collects part-wide information for each part in a score. Often, each MusicXML part","type":"text"},{"text":" ","type":"text"},{"text":"corresponds to a track in a Standard MIDI Format 1 file. In this case, the midi-device element is used to make","type":"text"},{"text":" ","type":"text"},{"text":"a MIDI device or port assignment for the given track or specific MIDI instruments. Initial midi-instrument","type":"text"},{"text":" ","type":"text"},{"text":"assignments may be made here as well. The score-instrument elements are used when there are multiple","type":"text"},{"text":" ","type":"text"},{"text":"instruments per track.","type":"text"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLScorePart"}],"navigatorTitle":[{"kind":"identifier","text":"MXLScorePart"}],"url":"\/documentation\/ivormxl\/mxlscorepart"},"doc://IvorMXL/documentation/IvorMXL/MXLPartLink":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartLink","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLPartLink"}],"type":"topic","title":"MXLPartLink","kind":"symbol","url":"\/documentation\/ivormxl\/mxlpartlink","abstract":[{"type":"text","text":"The part-link type allows MusicXML data for both score and parts to be contained within a single compressed"},{"type":"text","text":" "},{"type":"text","text":"MusicXML file. It links a score-part from a score document to MusicXML documents that contain parts data. In"},{"type":"text","text":" "},{"type":"text","text":"the case of a single compressed MusicXML file, the link href values are paths that are relative to the root"},{"type":"text","text":" "},{"type":"text","text":"folder of the zip file."}],"fragments":[{"kind":"keyword","text":"s