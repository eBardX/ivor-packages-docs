:"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLScorePart/nameDisplay":{"type":"topic","role":"symbol","abstract":[{"text":"Formatting for the display of the part name.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePart\/nameDisplay","title":"nameDisplay","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"nameDisplay","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLNameDisplay","preciseIdentifier":"s:7IvorMXL14MXLNameDisplayV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"url":"\/documentation\/ivormxl\/mxlscorepart\/namedisplay"},"doc://IvorMXL/documentation/IvorMXL/MXLScorePart":{"abstract":[{"type":"text","text":"The score-part type collects part-wide information for each part in a score. Often, each MusicXML part"},{"type":"text","text":" "},{"type":"text","text":"corresponds to a track in a Standard MIDI Format 1 file. In this case, the midi-device element is used to make"},{"type":"text","text":" "},{"type":"text","text":"a MIDI device or port assignment for the given track or specific MIDI instruments. Initial midi-instrument"},{"type":"text","text":" "},{"type":"text","text":"assignments may be made here as well. The score-instrument elements are used when there are multiple"},{"type":"text","text":" "},{"text":"instruments per track.","type":"text"}],"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLScorePart"}],"navigatorTitle":[{"kind":"identifier","text":"MXLScorePart"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlscorepart","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePart","title":"MXLScorePart"},"doc://IvorMXL/documentation/IvorMXL/MXLNameDisplay":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNameDisplay"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLNameDisplay"}],"url":"\/documentation\/ivormxl\/mxlnamedisplay","role":"symbol","title":"MXLNameDisplay","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNameDisplay","type":"topic","abstract":[{"type":"text","text":"The name-display type is used for exact formatting of multi-font text in part and group names to the left of"},{"type":"text","text":" "},{"type":"text","text":"the system. The print-object attribute can be used to determine what, if anything, is printed at the start of"},{"type":"text","text":" "},{"type":"text","text":"each system. Enclosure for the display-text element is none by default. Language for the display-text element"},{"type":"text","text":" "},{"type":"text","text":"is Italian (“it”) by default."}]}}}