:"the system. The print-object attribute can be used to determine what, if anything, is printed at the start of"},{"type":"text","text":" "},{"type":"text","text":"each system. Enclosure for the display-text element is none by default. Language for the display-text element"},{"text":" ","type":"text"},{"text":"is Italian (“it”) by default.","type":"text"}],"title":"MXLNameDisplay","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNameDisplay"}],"navigatorTitle":[{"text":"MXLNameDisplay","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlnamedisplay","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNameDisplay"},"doc://IvorMXL/documentation/IvorMXL/MXLScorePart/nameDisplay":{"title":"nameDisplay","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"nameDisplay"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL14MXLNameDisplayV","kind":"typeIdentifier","text":"MXLNameDisplay"},{"kind":"text","text":"?"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlscorepart\/namedisplay","abstract":[{"type":"text","text":"Formatting for the display of the part name."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePart\/nameDisplay"},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLScorePart":{"abstract":[{"type":"text","text":"The score-part type collects part-wide information for each part in a score. Often, each MusicXML part"},{"type":"text","text":" "},{"type":"text","text":"corresponds to a track in a Standard MIDI Format 1 file. In this case, the midi-device element is used to make"},{"type":"text","text":" "},{"type":"text","text":"a MIDI device or port assignment for the given track or specific MIDI instruments. Initial midi-instrument"},{"type":"text","text":" "},{"type":"text","text":"assignments may be made here as well. The score-instrument elements are used when there are multiple"},{"type":"text","text":" "},{"type":"text","text":"instruments per track."}],"title":"MXLScorePart","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLScorePart"}],"navigatorTitle":[{"kind":"identifier","text":"MXLScorePart"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlscorepart","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePart"}}}