or each part in a score. Often, each MusicXML part","type":"text"},{"text":" ","type":"text"},{"text":"corresponds to a track in a Standard MIDI Format 1 file. In this case, the midi-device element is used to make","type":"text"},{"text":" ","type":"text"},{"text":"a MIDI device or port assignment for the given track or specific MIDI instruments. Initial midi-instrument","type":"text"},{"text":" ","type":"text"},{"text":"assignments may be made here as well. The score-instrument elements are used when there are multiple","type":"text"},{"text":" ","type":"text"},{"text":"instruments per track.","type":"text"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLScorePart"}],"navigatorTitle":[{"kind":"identifier","text":"MXLScorePart"}],"url":"\/documentation\/ivormxl\/mxlscorepart"},"doc://IvorMXL/documentation/IvorMXL/MXLScorePart/nameDisplay":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePart\/nameDisplay","title":"nameDisplay","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"nameDisplay","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLNameDisplay","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL14MXLNameDisplayV"},{"text":"?","kind":"text"}],"abstract":[{"type":"text","text":"Formatting for the display of the part name."}],"url":"\/documentation\/ivormxl\/mxlscorepart\/namedisplay","kind":"symbol","type":"topic","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLNameDisplay":{"type":"topic","title":"MXLNameDisplay","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNameDisplay","abstract":[{"type":"text","text":"The name-display type is used for exact formatting of multi-font text in part and group names to the left of"},{"type":"text","text":" "},{"type":"text","text":"the system. The print-object attribute can be used to determine what, if anything, is printed at the start of"},{"type":"text","text":" "},{"type":"text","text":"each system. Enclosure for the display-text element is none by default. Language for the display-text element"},{"type":"text","text":" "},{"type":"text","text":"is Italian (“it”) by default."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNameDisplay"}],"navigatorTitle":[{"kind":"identifier","text":"MXLNameDisplay"}],"url":"\/documentation\/ivormxl\/mxlnamedisplay"}}}