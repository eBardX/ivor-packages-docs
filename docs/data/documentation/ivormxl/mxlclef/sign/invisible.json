dicates that the music that"},{"type":"text","text":" "},{"type":"text","text":"follows should be in jianpu numbered notation, just as the TAB sign indicates that the music that follows"},{"text":" ","type":"text"},{"text":"should be in tablature notation. Unlike TAB, a jianpu sign does not correspond to a visual clef notation.","type":"text"}],"role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sign","kind":"identifier"}],"navigatorTitle":[{"text":"Sign","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlclef\/sign"},"doc://IvorMXL/documentation/IvorMXL/MXLClef":{"type":"topic","title":"MXLClef","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLClef","abstract":[{"text":"Clefs are represented by a combination of sign, line, and clef-octave-change elements. The optional number","type":"text"},{"text":" ","type":"text"},{"text":"attribute refers to staff numbers within the part. A value of 1 is assumed if not present.","type":"text"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLClef","kind":"identifier"}],"navigatorTitle":[{"text":"MXLClef","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlclef"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"}}}