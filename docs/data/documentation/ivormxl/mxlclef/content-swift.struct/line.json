xl\/mxlstafflineposition","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLStaffLinePosition","kind":"identifier"}],"title":"MXLStaffLinePosition","abstract":[{"type":"text","text":"The staff-line-position type indicates the line position on a given staff. Staff lines are numbered from"},{"type":"text","text":" "},{"type":"text","text":"bottom to top, with 1 being the bottom line on a staff. A staff-line-position value can extend beyond the"},{"type":"text","text":" "},{"type":"text","text":"range of the lines on the current staff."}],"navigatorTitle":[{"text":"MXLStaffLinePosition","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffLinePosition","type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLClef/Content-swift.struct/line":{"kind":"symbol","abstract":[{"type":"text","text":"Line numbers are counted from the bottom of the staff. They are only needed with the G, F, and C signs in"},{"type":"text","text":" "},{"type":"text","text":"order to position a pitch correctly on the staff. Standard values are 2 for the G sign (treble clef), 4 for"},{"type":"text","text":" "},{"type":"text","text":"the F sign (bass clef), and 3 for the C sign (alto clef). Line values can be used to specify positions"},{"type":"text","text":" "},{"type":"text","text":"outside the staff, such as a C clef positioned in the middle of a grand staff."}],"title":"line","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLClef\/Content-swift.struct\/line","role":"symbol","url":"\/documentation\/ivormxl\/mxlclef\/content-swift.struct\/line","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"line","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLStaffLinePosition","preciseIdentifier":"s:7IvorMXL20MXLStaffLinePositionV","kind":"typeIdentifier"},{"text":"?","kind":"text"}]}}}