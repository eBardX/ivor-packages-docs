d with the G, F, and C signs in"},{"type":"text","text":" "},{"type":"text","text":"order to position a pitch correctly on the staff. Standard values are 2 for the G sign (treble clef), 4 for"},{"type":"text","text":" "},{"type":"text","text":"the F sign (bass clef), and 3 for the C sign (alto clef). Line values can be used to specify positions outside"},{"type":"text","text":" "},{"type":"text","text":"the staff, such as a C clef positioned in the middle of a grand staff."}],"role":"symbol","type":"topic","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLClef\/Content-swift.struct\/line","url":"\/documentation\/ivormxl\/mxlclef\/content-swift.struct\/line","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"line"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL20MXLStaffLinePositionV","text":"MXLStaffLinePosition"},{"kind":"text","text":"?"}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLClef":{"url":"\/documentation\/ivormxl\/mxlclef","abstract":[{"type":"text","text":"Clefs are represented by a combination of sign, line, and clef-octave-change elements. The optional number"},{"type":"text","text":" "},{"type":"text","text":"attribute refers to staff numbers within the part. A value of 1 is assumed if not present."}],"title":"MXLClef","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLClef"}],"navigatorTitle":[{"kind":"identifier","text":"MXLClef"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLClef","kind":"symbol","type":"topic"}}}