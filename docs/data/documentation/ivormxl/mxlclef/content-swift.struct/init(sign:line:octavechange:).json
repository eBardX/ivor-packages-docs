ocumentation\/IvorMXL\/MXLOctaveChange","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL15MXLOctaveChangeV","text":"MXLOctaveChange"},{"kind":"text","text":"? = nil)"}]}]},{"parameters":[{"name":"sign","content":[{"type":"paragraph","inlineContent":[{"text":"The sign element represents the clef symbol.","type":"text"}]}]},{"name":"line","content":[{"type":"paragraph","inlineContent":[{"text":"Line numbers are counted from the bottom of the staff. They are only needed with","type":"text"},{"text":" ","type":"text"},{"text":"the G, F, and C signs in order to position a pitch correctly on the staff.","type":"text"},{"text":" ","type":"text"},{"text":"Standard values are 2 for the G sign (treble clef), 4 for the F sign (bass clef),","type":"text"},{"text":" ","type":"text"},{"text":"and 3 for the C sign (alto clef). Line values can be used to specify positions","type":"text"},{"text":" ","type":"text"},{"text":"outside the staff, such as a C clef positioned in the middle of a grand staff.","type":"text"}]}]},{"name":"octaveChange","content":[{"type":"paragraph","inlineContent":[{"text":"The clef-octave-change element is used for transposing clefs. A treble clef for","type":"text"},{"text":" ","type":"text"},{"text":"tenors would have a value of -1.","type":"text"}]}]}],"kind":"parameters"}],"abstract":[{"type":"text","text":"Creates a new "},{"code":"MXLClef.Content","type":"codeVoice"},{"type":"text","text":"."}],"sections":[],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLClef\/Content-swift.struct\/init(sign:line:octaveChange:)","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLClef","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLClef\/Content-swift.struct"]]},"references":{"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicX