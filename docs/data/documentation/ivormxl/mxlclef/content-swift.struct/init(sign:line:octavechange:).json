{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlclef\/content-swift.struct\/init(sign:line:octavechange:)"]}],"kind":"symbol","identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLClef\/Content-swift.struct\/init(sign:line:octaveChange:)","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"modules":[{"name":"IvorMXL"}],"role":"symbol","roleHeading":"Initializer","title":"init(sign:line:octaveChange:)","externalID":"s:7IvorMXL7MXLClefV7ContentV4sign4line12octaveChangeAeC4SignO_AA20MXLStaffLinePositionVSgAA09MXLOctaveH0VSgtcfc","symbolKind":"init","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"sign","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Sign","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL7MXLClefV4SignO"},{"text":", ","kind":"text"},{"text":"line","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLStaffLinePosition","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL20MXLStaffLinePositionV"},{"text":"?, ","kind":"text"},{"text":"octaveChange","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLOctaveChange","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL15MXLOctaveChangeV"},{"text":"?)","kind":"text"}]},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLClef","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLClef\/Content-swift.struct"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"init","kind":"keyword"},{"text":"(","kind":"text"},{"text":"sign","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Sign","preciseIdentifier":"s:7IvorMXL7MXLClefV4SignO","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLClef\/Sign","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"line","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffLinePosition","text":"MXLStaffLinePosition","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL20MXLStaffLinePositionV"},{"kind":"text","text":"? = nil, "},{"text":"octaveChange","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLOctaveChange","preciseIdentifier":"s:7IvorMXL15MXLOctaveChangeV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOctaveChange","kind":"typeIdentifier"},{"text":"? = nil)","kind":"text"}]}]},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The sign element represents the clef symbol."}]}],"name":"sign"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Line numbers are counted from the bottom of the staff. They are only needed with the G, F, and C signs in order to position a pitch correctly on the staff. Standard values are 2 for the G sign (treble clef), 4 for the F sign (bass clef), and 3 for the C sign (alto clef). Line values can be used to specify positions outside the staff, such as a C clef positioned in the middle of a grand staff."}]}],"name":"line"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The clef-octave-change element is used for transposing clefs. A treble clef for tenors would have a value of -1."}]}],"name":"octaveChange"}],"kind":"parameters"}],"abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLClef.Content"},{"type":"text","text":"."}],"sections":[],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLClef/Sign":{"title":"MXLClef.Sign","kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sign","kind":"identifier"}],"navigatorTitle":[{"text":"Sign","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLClef\/Sign","url":"\/documentation\/ivormxl\/mxlclef\/sign","abstract":[{"type":"text","text":"The clef-sign type represents the different clef symbols. The jianpu sign indicates that the music that"},{"type":"text","text":" "},{"type":"text","text":"follows should be in jianpu numbered notation, just as the TAB sign indicates that the music that follows"},{"type":"text","text":" "},{"type":"text","text":"should be in tablature notation. Unlike TAB, a jianpu sign does not correspond to a visual clef notation."}],"type":"topic","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLClef/Content-swift.struct":{"title":"MXLClef.Content","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Content","kind":"identifier"}],"navigatorTitle":[{"text":"Content","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLClef\/Content-swift.struct","url":"\/documentation\/ivormxl\/mxlclef\/content-swift.struct","abstract":[{"type":"text","text":"Clefs are represented by a combination of sign, line, and clef-octave-change elements."}],"type":"topic","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLOctaveChange":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLOctaveChange"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLOctaveChange"}],"url":"\/documentation\/ivormxl\/mxloctavechange","abstract":[{"text":"The number of octaves to shift a pitch or clef, such as when transposing a written pitch to a sounding pitch","type":"text"},{"text":" ","type":"text"},{"text":"(the octave-change element) or positioning a treble clef for tenors, which would use a value of -1 (the","type":"text"},{"text":" ","type":"text"},{"text":"clef-octave-change element).","type":"text"}],"title":"MXLOctaveChange","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOctaveChange","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLClef":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlclef","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLClef","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLClef","kind":"identifier"}],"abstract":[{"type":"text","text":"Clefs are represented by a combination of sign, line, and clef-octave-change elements. The optional number"},{"type":"text","text":" "},{"type":"text","text":"attribute refers to staff numbers within the part. A value of 1 is assumed if not present."}],"kind":"symbol","type":"topic","navigatorTitle":[{"text":"MXLClef","kind":"identifier"}],"title":"MXLClef"},"doc://IvorMXL/documentation/IvorMXL/MXLStaffLinePosition":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlstafflineposition","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffLinePosition","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLStaffLinePosition"}],"kind":"symbol","abstract":[{"text":"The staff-line-position type indicates the line position on a given staff. Staff lines are numbered from","type":"text"},{"text":" ","type":"text"},{"text":"bottom to top, with 1 being the bottom line on a staff. A staff-line-position value can extend beyond the","type":"text"},{"text":" ","type":"text"},{"text":"range of the lines on the current staff.","type":"text"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLStaffLinePosition"}],"title":"MXLStaffLinePosition"},"doc://IvorMXL/documentation/IvorMXL/MXLClef/Content-swift.struct/init(sign:line:octaveChange:)":{"fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"sign","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Sign","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL7MXLClefV4SignO"},{"t