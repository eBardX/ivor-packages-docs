":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"size"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLSymbolSize","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSymbolSize","preciseIdentifier":"s:7IvorMXL13MXLSymbolSizeO"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"isAfterBarline"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"position"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLPosition","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","preciseIdentifier":"s:7IvorMXL11MXLPositionV"},{"kind":"text","text":" = MXLPosition(), "},{"kind":"externalParam","text":"font"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLFont","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","preciseIdentifier":"s:7IvorMXL7MXLFontV"},{"kind":"text","text":" = MXLFont(), "},{"kind":"externalParam","text":"color"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLColor","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","preciseIdentifier":"s:7IvorMXL8MXLColorV"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"printsObject"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":"? = nil)"}],"platforms":["macOS"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The optional-unique-id attribute group allows an element to optionally specify an","type":"text"},{"text":" ","type":"text"},{"text":"ID that is unique to the entire document. This attribute group is not used for a","type":"text"},{"text":" ","type":"text"},{"text":"required id attribute, or for an id attribute that specifies an id reference.","type":"text"}]}],"name":"id"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Clefs are represented by a combination of sign, line, and clef-octave-change","type":"text"},{"text":" ","type":"text"},{"text":"elements.","type":"text"}]}],"name":"content"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The staff number within the part that this element applies to. A value of 1 is","type":"text"},{"text":" ","type":"text"},{"text":"assumed if not present.","type":"text"}]}],"name":"number"},{"content":[{"type":"paragraph","inlineContent":[{"text":"A Boolean value indicating whether this clef is in a non-standard line position,","type":"text"},{"text":" ","type":"text"},{"text":"such as for a cue passage or when multiple clefs are present on one staff","type":"text"},{"text":" ","type":"text"},{"text":"simultaneously.","type":"text"}]}],"name":"isAdditional"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The size of the clef, used when ","type":"text"},{"type":"codeVoice","code":"additional"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"true"},{"text":", typically to indicate cue","type":"text"},{"text":" ","type":"text"},{"text":"clefs.","type":"text"}]}],"name":"size"},{"content":[{"type":"paragraph","inlineContent":[{"text":"A Boolean value indicating whether this clef appears after the barline rather than","type":"text"},{"text":" ","type":"text"},{"text":"before it, as for cues or after a repeated section.","type":"text"}]}],"name":"isAfterBarline"},{"content":[{"type":"paragraph","inlineContent":[{"text":"For most elements, any program will compute a default x and y position. The","type":"text"},{"text":" ","type":"text"},{"text":"position attributes let this be changed two ways.","type":"text"}]}],"name":"position"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The font attribute group gathers together attributes for determining the font","type":"text"},{"text":" ","type":"text"},{"text":"within a credit or direction. They are based on the text styles for Cascading Style","type":"text"},{"text":" ","type":"text"},{"text":"Sheets. The font-family is a comma-separated list of font names. The font-style can","type":"text"},{"text":" ","type":"text"},{"text":"be normal or italic. The font-size can be one of the CSS sizes or a numeric point","type":"text"},{"text":" ","type":"text"},{"text":"size. The font-weight can be normal or bold. The default is application-dependent,","type":"text"},{"text":" ","type":"text"},{"text":"but is a text font vs. a music font.","type":"text"}]}],"name":"font"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The color attribute group indicates the color of an element.","type":"text"}]}],"name":"color"},{"content":[{"type":"paragraph","inlineContent":[{"text":"A Boolean value indicating whether to print an object (e.g. a note or a rest).","type":"text"},{"text":" ","type":"text"},{"text":"Defaults to ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" if not specified.","type":"text"}]}],"name":"printsObject"}]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLStaffNumber":{"type":"topic","title":"MXLStaffNumber","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffNumber","abstract":[{"type":"text","text":"The staff-number type indicates staff numbers within a multi-staff part. Staves are numbered from top to"},{"type":"text","text":" "},{"type":"text","text":"bottom, with 1 being the top staff on a part."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLStaffNumber"}],"navigatorTitle":[{"kind":"identifier","text":"MXLStaffNumber"}],"url":"\/documentation\/ivormxl\/mxlstaffnumber"},"doc://IvorMXL/documentation/IvorMXL/MXLClef/init(id:content:number:isAdditional:size:isAfterBarline:position:font:color:printsObject:)":{"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"id"},{"kind":"te