r":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLClef\/init(id:content:number:isAdditional:size:isAfterBarline:position:font:color:printsObject:)","role":"symbol","url":"\/documentation\/ivormxl\/mxlclef\/init(id:content:number:isadditional:size:isafterbarline:position:font:color:printsobject:)","kind":"symbol","type":"topic"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLPosition":{"type":"topic","abstract":[{"type":"text","text":"For most elements, any program will compute a default x and y position. The position attributes let this be"},{"type":"text","text":" "},{"type":"text","text":"changed two ways."}],"url":"\/documentation\/ivormxl\/mxlposition","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPosition"}],"kind":"symbol","title":"MXLPosition","navigatorTitle":[{"kind":"identifier","text":"MXLPosition"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"type":"topic","abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"type":"text","text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is"},{"type":"text","text":" "},{"type":"text","text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF."}],"url":"\/documentation\/ivormxl\/mxlcolor","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"kind":"symbol","title":"MXLColor","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLClef/Content-swift.struct":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Content"}],"title":"MXLClef.Content","abstract":[{"text":"Clefs are represented by a combination of sign, line, and clef-octave-change elements.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLClef\/Content-swift.struct","role":"symbol","url":"\/documentation\/ivormxl\/mxlclef\/content-swift.struct","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Content"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLSymbolSize":{"type":"topic","title":"MXLSymbolSize","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSymbolSize","abstract":[{"text":"The symbol-size type is used to distinguish between full, cue sized, grace cue sized, and oversized symbols.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLSymbolSize"}],"navigatorTitle":[{"kind":"identifier","text":"MXLSymbolSize"}],"url":"\/documentation\/ivormxl\/mxlsymbolsize"},"doc://IvorMXL/documentation/IvorMXL/MXLClef":{"type":"topic","title":"MXLClef","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLClef","abstract":[{"text":"Clefs are represented by a combination of sign, line, and clef-octave-change elements. The optional number","type":"text"},{"text":" ","type":"text"},{"text":"attribute refers to staff numbers within the part. A value of 1 is assumed if not present.","type":"text"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLClef","kind":"identifier"}],"navigatorTitle":[{"text":"MXLClef","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlclef"},"doc://IvorMXL/documentation/IvorMXL/MXLFont":{"type":"topic","title":"MXLFont","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","abstract":[{"type":"text","text":"The font attribute group gathers together attributes for determining the font within a credit or direction."},{"type":"text","text":" "},{"type":"text","text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of"},{"type":"text","text":" "},{"type":"text","text":"font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric"},{"type":"text","text":" "},{"type":"text","text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font"},{"type":"text","text":" "},{"type":"text","text":"vs. a music font."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFont"}],"navigatorTitle":[{"kind":"identifier","text":"MXLFont"}],"url":"\/documentation\/ivormxl\/mxlfont"}}}