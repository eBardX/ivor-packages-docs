"text"}],"role":"symbol","title":"init(version:work:movementNumber:movementTitle:identification:defaults:credit:partList:parts:)","url":"\/documentation\/ivormxl\/mxlscorepartwise\/init(version:work:movementnumber:movementtitle:identification:defaults:credit:partlist:parts:)"},"doc://IvorMXL/documentation/IvorMXL/MXLDocument/Version":{"role":"symbol","url":"\/documentation\/ivormxl\/mxldocument\/version","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Version","kind":"identifier"}],"navigatorTitle":[{"text":"Version","kind":"identifier"}],"abstract":[{"type":"text","text":"A MusicXML version number."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDocument\/Version","title":"MXLDocument.Version","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLIdentification":{"type":"topic","title":"MXLIdentification","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLIdentification","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlidentification","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLIdentification","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"MXLIdentification","kind":"identifier"}],"abstract":[{"text":"Identification contains basic metadata about the score. It includes information that may apply at a score-","type":"text"},{"text":" ","type":"text"},{"text":"wide, movement-wide, or part-wide level. The creator, rights, source, and relation elements are based on","type":"text"},{"text":" ","type":"text"},{"text":"Dublin Core.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLDocument":{"type":"topic","title":"MXLDocument","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLDocument"}],"url":"\/documentation\/ivormxl\/mxldocument","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDocument","role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLDocument"}],"abstract":[{"type":"text","text":"A top-level document parsed from a MusicXML file."}]},"doc://IvorMXL/documentation/IvorMXL/MXLDefaults":{"navigatorTitle":[{"text":"MXLDefaults","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLDefaults","kind":"identifier"}],"abstract":[{"type":"text","text":"The defaults type specifies score-wide defaults for scaling; whether or not the file is a concert score;"},{"type":"text","text":" "},{"type":"text","text":"layout; and default values for the music font, word font, lyric font, and lyric language. Except for the"},{"type":"text","text":" "},{"type":"text","text":"concert-score element, if any defaults are missing, the choice of what to use is determined by the"},{"type":"text","text":" "},{"type":"text","text":"application."}],"role":"symbol","url":"\/documentation\/ivormxl\/mxldefaults","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDefaults","title":"MXLDefaults","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLScorePartwise":{"type":"topic","title":"MXLScorePartwise","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLScorePartwise","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlscorepartwise","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePartwise","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"MXLScorePartwise","kind":"identifier"}],"abstract":[{"type":"text","text":"The score-partwise element is the root element for a partwise MusicXML score. It includes a score-header group"},{"type":"text","text":" "},{"type":"text","text":"followed by a series of parts with measures inside. The document-attributes attribute group includes the"},{"type":"text","text":" "},{"type":"text","text":"version attribute."}]},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLCredit":{"url":"\/documentation\/ivormxl\/mxlcredit","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCredit","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLCredit"}],"title":"MXLCredit","abstract":[{"type":"text","text":"The credit type represents the appearance of the title, composer, arranger, lyricist, copyright, dedication,"},{"type":"text","text":" "},{"type":"text","text":"and other text, symbols, and graphics that commonly appear on the first page of a score. The credit-words,"},{"type":"text","text":" "},{"type":"text","text":"credit-symbol, and credit-image elements are similar to the words, symbol, and image elements for directions."},{"type":"text","text":" "},{"type":"text","text":"However, since the credit is not part of a measure, the default-x and default-y attributes adjust the origin"},{"type":"text","text":" "},{"type":"text","text":"relative to the bottom left-hand corner of the page. The enclosure for credit-words and credit-symbol is none"},{"type":"text","text":" "},{"type":"text","text":"by default."}],"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLCredit"}]},"doc://IvorMXL/documentation/IvorMXL/MXLPartList":{"type":"topic","title":"MXLPartList","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPartList"}],"url":"\/documentation\/ivormxl\/mxlpartlist","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartList","role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLPartList"}],"abstract":[{"type":"text","text":"The part-list identifies the different musical parts in this document. Each part has an ID that is used later"},{"type":"text","text":" "},{"type":"text","text":"within the musical data. Since parts may be encoded separately and combined later, identification elements are"},{"type":"text","text":" "},{"type":"text","text":"present at both the score and score-part levels. There must be at least one score-part, combined as desired"},{"type":"text","text":" "},{"type":"text","text":"with part-group elements that indicate braces and brackets. Parts are ordered from top to bottom in a score"},{"type":"text","text":" "},{"type":"text","text":"based on the order in which they appear in the part-list."}]},"doc://IvorMXL/documentation/IvorMXL/MXLScorePartwise/Part":{"type":"topic","title":"MXLScorePartwise.Part","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Part","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlscorepartwise\/part","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePartwise\/Part","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"Part","kind":"identifier"}],"abstract":[{"type":"text","text":"Maps the MusicXML "},{"type":"codeVoice","code":"<part>"},{"type":"text","text":" element."}]},"doc://IvorMXL/documentation/IvorMXL/MXLWork":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlwork","title":"MXLWork","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLWork"}],"navigatorTitle":[{"text":"MXLWork","kind":"identifier"}],"abstract":[{"type":"text","text":"Works are optionally identified by number and title. The work type also may indicate a link to the opus"},{"type":"text","text":" "},{"type":"text","text":"document that composes multiple scores into a collection."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLWork"}}}