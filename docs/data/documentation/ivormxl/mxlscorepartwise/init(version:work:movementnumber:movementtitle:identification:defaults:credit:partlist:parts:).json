ge. Except for the","type":"text"},{"text":" ","type":"text"},{"text":"concert-score element, if any defaults are missing, the choice of what to use is determined by the","type":"text"},{"text":" ","type":"text"},{"text":"application.","type":"text"}],"title":"MXLDefaults","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDefaults","kind":"symbol","url":"\/documentation\/ivormxl\/mxldefaults","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLDefaults","kind":"identifier"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLScorePartwise/Part":{"title":"MXLScorePartwise.Part","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Part","kind":"identifier"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlscorepartwise\/part","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePartwise\/Part","abstract":[{"type":"text","text":"Maps the MusicXML "},{"type":"codeVoice","code":"<part>"},{"type":"text","text":" element."}],"navigatorTitle":[{"text":"Part","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLDocument/Version":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDocument\/Version","title":"MXLDocument.Version","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Version","kind":"identifier"}],"navigatorTitle":[{"text":"Version","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxldocument\/version","abstract":[{"text":"A MusicXML version number.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLScorePartwise":{"abstract":[{"type":"text","text":"The score-partwise element is the root element for a partwise MusicXML score. It includes a score-header group"},{"type":"text","text":" "},{"type":"text","text":"followed by a series of parts with measures inside. The document-attributes attribute group includes the"},{"type":"text","text":" "},{"type":"text","text":"version attribute."}],"title":"MXLScorePartwise","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLScorePartwise"}],"navigatorTitle":[{"kind":"identifier","text":"MXLScorePartwise"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlscorepartwise","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePartwise"},"doc://IvorMXL/documentation/IvorMXL/MXLIdentification":{"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLIdentification"}],"title":"MXLIdentification","url":"\/documentation\/ivormxl\/mxlidentification","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLIdentification"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLIdentification","abstract":[{"type":"text","text":"Identification contains basic metadata about the score. It includes information that may apply at a score-"},{"type":"text","text":" "},{"type":"text","text":"wide, movement-wide, or part-wide level. The creator, rights, source, and relation elements are based on"},{"type":"text","text":" "},{"type":"text","text":"Dublin Core."}]},"doc://IvorMXL/documentation/IvorMXL/MXLCredit":{"navigatorTitle":[{"kind":"identifier","text":"MXLCredit"}],"abstract":[{"text":"The credit type represents the appearance of the title, composer, arranger, lyricist, copyright, dedication,","type":"text"},{"text":" ","type":"text"},{"text":"and other text, symbols, and graphics that commonly appear on the first page of a score. The credit-words,","type":"text"},{"text":" ","type":"text"},{"text":"credit-symbol, and credit-image elements are similar to the words, symbol, and image elements for directions.","type":"text"},{"text":" ","type":"text"},{"text":"However, since the credit is not part of a measure, the default-x and default-y attributes adjust the origin","type":"text"},{"text":" ","type":"text"},{"text":"relative to the bottom left-hand corner of the page. The enclosure for credit-words and credit-symbol is none","type":"text"},{"text":" ","type":"text"},{"text":"by default.","type":"text"}],"title":"MXLCredit","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCredit","kind":"symbol","url":"\/documentation\/ivormxl\/mxlcredit","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLCredit"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLPartList":{"navigatorTitle":[{"kind":"identifier","text":"MXLPartList"}],"abstract":[{"text":"The part-list identifies the different musical parts in this document. Each part has an ID that is used later","type":"text"},{"text":" ","type":"text"},{"text":"within the musical data. Since parts may be encoded separately and combined later, identification elements are","type":"text"},{"text":" ","type":"text"},{"text":"present at both the score and score-part levels. There must be at least one score-part, combined as desired","type":"text"},{"text":" ","type":"text"},{"text":"with part-group elements that indicate braces and brackets. Parts are ordered from top to bottom in a score","type":"text"},{"text":" ","type":"text"},{"text":"based on the order in which they appear in the part-list.","type":"text"}],"title":"MXLPartList","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartList","kind":"symbol","url":"\/documentation\/ivormxl\/mxlpartlist","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPartList"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLDocument":{"navigatorTitle":[{"kind":"identifier","text":"MXLDocument"}],"abstract":[{"type":"text","text":"A top-level document parsed from a MusicXML file."}],"title":"MXLDocument","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDocument","kind":"symbol","url":"\/documentation\/ivormxl\/mxldocument","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLDocument"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLWork":{"abstract":[{"type":"text","text":"Works are optionally identified by number and title. The work type also may indicate a link to the opus"},{"type":"text","text":" "},{"type":"text","text":"document that composes multiple scores into a collection."}],"title":"MXLWork","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLWork","kind":"identifier"}],"navigatorTitle":[{"text":"MXLWork","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlwork","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLWork"},"doc://IvorMXL/documentation/IvorMXL/MXLScorePartwise/init(version:work:movementNumber:movementTitle:identification:defaults:credit:partList:parts:)":{"kind":"symbol","url":"\/documentation\/ivormxl\/mxlscorepartwise\/init(version:work:movementnumber:movementtitle:identification:defaults:credit:partlist:parts:)","title":"init(version:work:movementNumber:movementTitle:identification:defaults:credit:partList:parts:)","role":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"version","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLDocument","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLDocumentV"},{"text":".","kind":"text"},{"text":"Version","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLDocumentV7VersionV"},{"text":"?, ","kind":"text"},{"text":"work","kind":"externalParam"