ext":" if not specified.","type":"text"}]}],"name":"version"},{"content":[{"inlineContent":[{"type":"text","text":"The work that identifies the piece, optionally including its number and title."}],"type":"paragraph"}],"name":"work"},{"content":[{"inlineContent":[{"text":"The movement-number element specifies the number of a movement.","type":"text"}],"type":"paragraph"}],"name":"movementNumber"},{"name":"movementTitle","content":[{"type":"paragraph","inlineContent":[{"text":"The movement-title element specifies the title of a movement, not including its number.","type":"text"}]}]},{"name":"identification","content":[{"type":"paragraph","inlineContent":[{"text":"The identification metadata for the score, such as creators, rights, source, and relation information.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"The score-wide defaults for scaling, layout, and default font and language values."}],"type":"paragraph"}],"name":"defaults"},{"content":[{"inlineContent":[{"type":"text","text":"The credits — such as title, composer, and copyright notices — that appear on the first or following pages of the score."}],"type":"paragraph"}],"name":"credit"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The list of parts that make up the score, along with the part-group elements that indicate braces and brackets between them.","type":"text"}]}],"name":"partList"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The parts that make up the score, in the same order as they appear in the part list.","type":"text"}]}],"name":"parts"}],"kind":"parameters"}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLPartList":{"title":"MXLPartList","navigatorTitle":[{"text":"MXLPartList","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"The part-list identifies the different musical parts in this document. Each part has an ID that is used later"},{"type":"text","text":" "},{"type":"text","text":"within the musical data. Since parts may be encoded separately and combined later, identification elements are"},{"type":"text","text":" "},{"type":"text","text":"present at both the score and score-part levels. There must be at least one score-part, combined as desired"},{"type":"text","text":" "},{"type":"text","text":"with part-group elements that indicate braces and brackets. Parts are ordered from top to bottom in a score"},{"type":"text","text":" "},{"type":"text","text":"based on the order in which they appear in the part-list."}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPartList","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartList","url":"\/documentation\/ivormxl\/mxlpartlist"},"doc://IvorMXL/documentation/IvorMXL/MXLScorePartwise/Part":{"title":"MXLScorePartwise.Part","navigatorTitle":[{"text":"Part","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"Maps the MusicXML "},{"code":"<part>","type":"codeVoice"},{"type":"text","text":" element."}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Part","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePartwise\/Part","url":"\/documentation\/ivormxl\/mxlscorepartwise\/part"},"doc://IvorMXL/documentation/IvorMXL/MXLDocument/Version":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDocument\/Version","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Version"}],"abstract":[{"text":"A MusicXML version number.","type":"text"}],"title":"MXLDocument.Version","kind":"symbol","url":"\/documentation\/ivormxl\/mxldocument\/version","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Version"}]},"doc://IvorMXL/documentation/IvorMXL/MXLIdentification":{"kind":"symbol","title":"MXLIdentification","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLIdentification"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlidentification","navigatorTitle":[{"text":"MXLIdentification","kind":"identifier"}],"abstract":[{"text":"Identification contains basic metadata about the score. It includes information that may apply at a score-","type":"text"},{"text":" ","type":"text"},{"text":"wide, movement-wide, or part-wide level. The creator, rights, source, and relation elements are based on","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Dublin Core."}],"role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLIdentification"},"doc://IvorMXL/documentation/IvorMXL/MXLCredit":{"type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLCredit","kind":"identifier"}],"navigatorTitle":[{"text":"MXLCredit","kind":"identifier"}],"abstract":[{"text":"The credit type represents the appearance of the title, composer, arranger, lyricist, copyright, dedication,","type":"text"},{"text":" ","type":"text"},{"text":"and other text, symbols, and graphics that commonly appear on the first page of a score. The credit-words,","type":"text"},{"text":" ","type":"text"},{"text":"credit-symbol, and credit-image elements are similar to the words, symbol, and image elements for directions.","type":"text"},{"text":" ","type":"text"},{"text":"However, since the credit is not part of a measure, the default-x and default-y attributes adjust the origin","type":"text"},{"text":" ","type":"text"},{"text":"relative to the bottom left-hand corner of the page. The enclosure for credit-words and credit-symbol is none","type":"text"},{"text":" ","type":"text"},{"text":"by default.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCredit","title":"MXLCredit","role":"symbol","url":"\/documentation\/ivormxl\/mxlcredit"},"doc://IvorMXL/documentation/IvorMXL/MXLWork":{"navigatorTitle":[{"text":"MXLWork","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLWork","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlwork","abstract":[{"type":"text","text":"Works are optionally identified by number and title. The work type also may indicate a link to the opus"},{"type":"text","text":" "},{"type":"text","text":"document that composes multiple scores into a collection."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLWork","kind":"symbol","title":"MXLWork","type":"topic","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLScorePartwise/init(version:work:movementNumber:movementTitle:identification:defaults:credit:partList:parts:)":{"title":"init(version:work:movementNumber:movementTitle:identification:defaults:credit:partList:parts:)","type":"topic","abstract":[{"type":"text","text":"Creates a new "},{"code":"MXLScorePartwise","type":"codeVoice"},{"type":"text","text":"."}],"role":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"version","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLDocument","preciseIdentifier":"s:7IvorMXL11MXLDocumentV","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Version","preciseIdentifier":"s:7IvorMXL11MXLDocumentV7VersionV","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"work","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLWork","preciseIdentifier":"s:7IvorMXL7MXLWorkV","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"movementNumber","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"movementTitle","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"identification","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLIdentification","preciseIdentifier":"s:7IvorMXL17MXLIdentificationV","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"defaults","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLDefaults","preciseIdentifier":"s:7IvorMXL11MXLDefaultsV","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"credit","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"MXLCredit","preciseIdentifier":"s:7IvorMXL9MXLCreditV","kind":"typeIdentifier"},{"text":"], ","kind":"text"},{"text":"partList","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLPartList","preciseIdentifier":"s:7IvorMXL11MXLPartListV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"parts","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"Part","preciseIdentifier":"s:7IvorMXL16MXLScorePartwiseV4PartV","kind":"typeIdentifier"},{"text":"])","kind":"text"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePartwise\/init(version:work:movementNumber:movementTitle:identification:defaults:credit:partList:parts:)","url":"\/documentation\/ivormxl\/mxlscorepartwise\/init(version:work:movementnumber:movementtitle:identification:defaults:credit:partlist:parts:)"},"doc://IvorMXL/documentation/IvorMXL/MXLDocument":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDocument","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLDocument"}],"abstract":[{"text":"A top-level document parsed from a MusicXML file.","type":"text"}],"title":"MXLDocument","kind":"symbol","url":"\/documentation\/ivormxl\/mxldocument","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLDocument"}]},"doc://IvorMXL/documentation/IvorMXL/MXLScorePartwise":{"url":"\/documentation\/ivormxl\/mxlscorepartwise","title":"MXLScorePartwise","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLScorePartwise"}],"navigatorTitle":[{"kind":"identifier","text":"MXLScorePartwise"}],"abstract":[{"type":"text","text":"The score-partwise element is the root element for a partwise MusicXML score. It includes a score-header group"},{"type":"text","text":" "},{"type":"text","text":"followed by a series of parts with measures inside. The document-attributes attribute group includes the"},{"type":"text","text":" "},{"type":"text","text":"version attribute."}],"kind":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePartwise"},"doc://IvorMXL/documentation/IvorMXL/MXLDefaults":{"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxldefaults","abstract":[{"type":"text","text":"The defaults type specifies score-wide defaults for scaling; whether or not the file is a concert score;"},{"type":"text","text":" "},{"type":"text","text":"layout; and default values for the music font, word font, lyric font, and lyric language. Except for the"},{"type":"text","text":" "},{"type":"text","text":"concert-score element, if any defaults are missing, the choice of what to use is determined by the"},{"type":"text","text":" "},{"type":"text","text":"application."}],"navigatorTitle":[{"text":"MXLDefaults","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLDefaults","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDefaults","title":"MXLDefaults"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"}}}