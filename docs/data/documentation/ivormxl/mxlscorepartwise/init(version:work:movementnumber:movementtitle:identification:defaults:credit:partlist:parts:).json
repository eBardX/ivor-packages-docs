fferent musical parts in this document. Each part has an ID that is used later","type":"text"},{"text":" ","type":"text"},{"text":"within the musical data. Since parts may be encoded separately and combined later, identification elements are","type":"text"},{"text":" ","type":"text"},{"text":"present at both the score and score-part levels. There must be at least one score-part, combined as desired","type":"text"},{"text":" ","type":"text"},{"text":"with part-group elements that indicate braces and brackets. Parts are ordered from top to bottom in a score","type":"text"},{"text":" ","type":"text"},{"text":"based on the order in which they appear in the part-list.","type":"text"}],"kind":"symbol","type":"topic","navigatorTitle":[{"text":"MXLPartList","kind":"identifier"}],"title":"MXLPartList"},"doc://IvorMXL/documentation/IvorMXL/MXLScorePartwise":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePartwise","type":"topic","title":"MXLScorePartwise","kind":"symbol","url":"\/documentation\/ivormxl\/mxlscorepartwise","abstract":[{"type":"text","text":"The score-partwise element is the root element for a partwise MusicXML score. It includes a score-header group"},{"type":"text","text":" "},{"type":"text","text":"followed by a series of parts with measures inside. The document-attributes attribute group includes the"},{"type":"text","text":" "},{"type":"text","text":"version attribute."}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLScorePartwise","kind":"identifier"}],"navigatorTitle":[{"text":"MXLScorePartwise","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLScorePartwise/Part":{"title":"MXLScorePartwise.Part","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Part","kind":"identifier"}],"navigatorTitle":[{"text":"Part","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePartwise\/Part","url":"\/document