{"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePartwise"]]},"metadata":{"role":"symbol","modules":[{"name":"IvorMXL"}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"credit","kind":"identifier"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLCreditV","text":"MXLCredit"},{"text":"]","kind":"text"}],"symbolKind":"property","externalID":"s:7IvorMXL16MXLScorePartwiseV6creditSayAA9MXLCreditVGvp","title":"credit","roleHeading":"Instance Property"},"abstract":[{"type":"text","text":"The credits — such as title, composer, and copyright notices — that appear on the first or following pages"},{"type":"text","text":" "},{"type":"text","text":"of the score."}],"sections":[],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"credit","kind":"identifier"},{"text":": [","kind":"text"},{"text":"MXLCredit","preciseIdentifier":"s:7IvorMXL9MXLCreditV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCredit","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Maps to nested MusicXML "},{"type":"codeVoice","code":"<credit>"},{"type":"text","text":" elements."}]}],"kind":"content"}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlscorepartwise\/credit"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePartwise\/credit","interfaceLanguage":"swift"},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLScorePartwise":{"type":"topic","title":"MXLScorePartwise","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePartwise","abstract":[{"text":"The score-partwise element is the root element for a partwise MusicXML score. It includes a score-header group","type":"text"},{"text":" ","type":"text"},{"text":"followed by a series of parts with measures inside. The document-attributes attribute group includes the","type":"text"},{"text":" ","type":"text"},{"text":"version attribute.","type":"text"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLScorePartwise"}],"navigatorTitle":[{"kind":"identifier","text":"MXLScorePartwise"}],"url":"\/documentation\/ivormxl\/mxlscorepartwise"},"doc://IvorMXL/documentation/IvorMXL/MXLCredit":{"type":"topic","abstract":[{"text":"The credit type represents the appearance of the title, composer, arranger, lyricist, copyright, dedication,","type":"text"},{"text":" ","type":"text"},{"text":"and other text, symbols, and graphics that commonly appear on the first page of a score. The credit-words,","type":"text"},{"text":" ","type":"text"},{"text":"credit-symbol, and credit-image elements are similar to the words, symbol, and image elements for directions.","type":"text"},{"text":" ","type":"text"},{"text":"However, since the credit is not part of a measure, the default-x and default-y attributes adjust the origin","type":"text"},{"text":" ","type":"text"},{"text":"relative to the bottom left-hand corner of the page. The enclosure for credit-words and credit-symbol is none","type":"text"},{"text":" ","type":"text"},{"text":"by default.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlcredit","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLCredit"}],"kind":"symbol","title":"MXLCredit","navigatorTitle":[{"kind":"identifier","text":"MXLCredit"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCredit","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","