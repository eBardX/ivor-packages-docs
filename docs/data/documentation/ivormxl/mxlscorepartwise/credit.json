 or following pages","type":"text"},{"text":" ","type":"text"},{"text":"of the score.","type":"text"}],"kind":"symbol","role":"symbol","type":"topic","title":"credit","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePartwise\/credit","url":"\/documentation\/ivormxl\/mxlscorepartwise\/credit","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"credit","kind":"identifier"},{"text":": [","kind":"text"},{"text":"MXLCredit","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLCreditV"},{"text":"]","kind":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLScorePartwise":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePartwise","type":"topic","title":"MXLScorePartwise","kind":"symbol","url":"\/documentation\/ivormxl\/mxlscorepartwise","abstract":[{"type":"text","text":"The score-partwise element is the root element for a partwise MusicXML score. It includes a score-header group"},{"type":"text","text":" "},{"type":"text","text":"followed by a series of parts with measures inside. The document-attributes attribute group includes the"},{"type":"text","text":" "},{"type":"text","text":"version attribute."}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLScorePartwise","kind":"identifier"}],"navigatorTitle":[{"text":"MXLScorePartwise","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLCredit":{"title":"MXLCredit","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLCredit"}],"abstract":[{"text":"The credit type represents the appearance of the title, composer, arranger, lyricist, copyright, dedication,","type":"text"},{"text":" ","type":"text"},{"text":"and other text, symbols, and graphics that commonly appear on the first page of a score. The credit-words,","type":"text"},{"text":" ","type":"text"},{"text":"credit-symbol, and credit-image elements are similar to the words, symbol, and image elements for directions.","type":"text"},{"text":" ","type":"text"},{"text":"However, since the credit is not part of a measure, the default-x and default-y attributes adjust the origin","type":"text"},{"text":" ","type":"text"},{"text":"relative to the bottom left-hand corner of the page. The enclosure for credit-words and credit-symbol is none","type":"text"},{"text":" ","type":"text"},{"text":"by default.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCredit","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLCredit"}],"url":"\/documentation\/ivormxl\/mxlcredit"}}}