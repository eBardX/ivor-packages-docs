{"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"credit"},{"kind":"text","text":": ["},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCredit","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLCreditV","text":"MXLCredit"},{"kind":"text","text":"]"}]}],"kind":"declarations"},{"content":[{"anchor":"discussion","text":"Discussion","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Maps to nested MusicXML "},{"type":"codeVoice","code":"<credit>"},{"type":"text","text":" elements."}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"text":"The credits — such as title, composer, and copyright notices — that appear on the first or following pages","type":"text"},{"text":" ","type":"text"},{"text":"of the score.","type":"text"}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePartwise\/credit","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePartwise"]]},"metadata":{"roleHeading":"Instance Property","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"credit"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:7IvorMXL9MXLCreditV","kind":"typeIdentifier","text":"MXLCredit"},{"kind":"text","text":"]"}],"modules":[{"name":"IvorMXL"}],"externalID":"s:7IvorMXL16MXLScorePartwiseV6creditSayAA9MXLCreditVGvp","role":"symbol","symbolKind":"property","title":"credit"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlscorepartwise\/credit"]}],"sections":[],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLScorePartwise/credit":{"title":"credit","type":"topic","abstract":[{"type":"text","text":"The credits — such as title, composer, and copyright notices — that appear on the first or following pages"},{"type":"text","text":" "},{"type":"text","text":"of the score."}],"role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"credit","kind":"identifier"},{"text":": [","kind":"text"},{"text":"MXLCredit","preciseIdentifier":"s:7IvorMXL9MXLCreditV","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePartwise\/credit","url":"\/documentation\/ivormxl\/mxlscorepartwise\/credit"},"doc://IvorMXL/documentation/IvorMXL/MXLScorePartwise":{"url":"\/documentation\/ivormxl\/mxlscorepartwise","title":"MXLScorePartwise","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLScorePartwise"}],"navigatorTitle":[{"kind":"identifier","text":"MXLScorePartwise"}],"abstract":[{"type":"text","text":"The score-partwise element is the root element for a partwise MusicXML score. It includes a score-header group"},{"type":"text","text":" "},{"type":"text","text":"followed by a series of parts with measures inside. The document-attributes attribute group includes the"},{"type":"text","text":" "},{"type":"text","text":"version attribute."}],"kind":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePartwise"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLCredit":{"type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLCredit","kind":"identifier"}],"navigatorTitle":[{"text":"MXLCredit","kind":"identifier"}],"abstract":[{"text":"The credit type represents the appearance of the title, composer, arranger, lyricist, copyright, dedication,","type":"text"},{"text":" ","type":"text"},{"text":"and other text, symbols, and graphics that commonly appear on the first page of a score. The credit-words,","type":"text"},{"text":" ","type":"text"},{"text":"credit-symbol, and credit-image elements are similar to the words, symbol, and image elements for directions.","type":"text"},{"text":" ","type":"text"},{"text":"However, since the credit is not part of a measure, the default-x and default-y attributes adjust the origin","type":"text"},{"text":" ","type":"text"},{"text":"relative to the bottom left-hand corner of the page. The enclosure for credit-words and credit-symbol is none","type":"text"},{"text":" ","type":"text"},{"text":"by default.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCredit","title":"MXLCredit","role":"symbol","url":"\/documentation\/ivormxl\/mxlcredit"}}}