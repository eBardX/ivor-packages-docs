","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlscorepartwise","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePartwise","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"MXLScorePartwise","kind":"identifier"}],"abstract":[{"type":"text","text":"The score-partwise element is the root element for a partwise MusicXML score. It includes a score-header group"},{"type":"text","text":" "},{"type":"text","text":"followed by a series of parts with measures inside. The document-attributes attribute group includes the"},{"type":"text","text":" "},{"type":"text","text":"version attribute."}]},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLScorePartwise/partList":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePartwise\/partList","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"partList"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLPartList","preciseIdentifier":"s:7IvorMXL11MXLPartListV"}],"title":"partList","abstract":[{"type":"text","text":"The list of parts that make up the score, along with the part-group elements that indicate braces and"},{"type":"text","text":" "},{"type":"text","text":"brackets between them."}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlscorepartwise\/partlist"},"doc://IvorMXL/documentation/IvorMXL/MXLPartList":{"type":"topic","title":"MXLPartList","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPartList"}],"url":"\/documentation\/ivormxl\/mxlpartlist","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartList","role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLPartList"}],"abstract":[{"type":"text","text":"The part-list identifies the different musical parts in this document. Each part has an ID that is used later"},{"type":"text","text":" "},{"type":"text","text":"within the musical data. Since parts may be encoded separately and combined later, identification elements are"},{"type":"text","text":" "},{"type":"text","text":"present at both the score and score-part levels. There must be at least one score-part, combined as desired"},{"type":"text","text":" "},{"type":"text","text":"with part-group elements that indicate braces and brackets. Parts are ordered from top to bottom in a score"},{"type":"text","text":" "},{"type":"text","text":"based on the order in which they appear in the part-list."}]}}}