ion","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLScorePartwise/partList":{"title":"partList","type":"topic","abstract":[{"type":"text","text":"The list of parts that make up the score, along with the part-group elements that indicate braces and"},{"type":"text","text":" "},{"type":"text","text":"brackets between them."}],"role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"partList","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLPartList","preciseIdentifier":"s:7IvorMXL11MXLPartListV","kind":"typeIdentifier"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePartwise\/partList","url":"\/documentation\/ivormxl\/mxlscorepartwise\/partlist"},"doc://IvorMXL/documentation/IvorMXL/MXLScorePartwise":{"url":"\/documentation\/ivormxl\/mxlscorepartwise","title":"MXLScorePartwise","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLScorePartwise"}],"navigatorTitle":[{"kind":"identifier","text":"MXLScorePartwise"}],"abstract":[{"type":"text","text":"The score-partwise element is the root element for a partwise MusicXML score. It includes a score-header group"},{"type":"text","text":" "},{"type":"text","text":"followed by a series of parts with measures inside. The document-attributes attribute group includes the"},{"type":"text","text":" "},{"type":"text","text":"version attribute."}],"kind":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePartwise"},"doc://IvorMXL/documentation/IvorMXL/MXLPartList":{"title":"MXLPartList","navigatorTitle":[{"text":"MXLPartList","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"The part-list identifies the different musical parts in this document. Each part has an ID that is used later"},{"type":"text","text":" "},{"type":"text","text":"within the musical data. Since parts may be encoded separately and combined later, identification elements are"},{"type":"text","text":" "},{"type":"text","text":"present at both the score and score-part levels. There must be at least one score-part, combined as desired"},{"type":"text","text":" "},{"type":"text","text":"with part-group elements that indicate braces and brackets. Parts are ordered from top to bottom in a score"},{"type":"text","text":" "},{"type":"text","text":"based on the order in which they appear in the part-list."}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPartList","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartList","url":"\/documentation\/ivormxl\/mxlpartlist"}}}