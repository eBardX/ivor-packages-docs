IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLPartList":{"navigatorTitle":[{"kind":"identifier","text":"MXLPartList"}],"abstract":[{"text":"The part-list identifies the different musical parts in this document. Each part has an ID that is used later","type":"text"},{"text":" ","type":"text"},{"text":"within the musical data. Since parts may be encoded separately and combined later, identification elements are","type":"text"},{"text":" ","type":"text"},{"text":"present at both the score and score-part levels. There must be at least one score-part, combined as desired","type":"text"},{"text":" ","type":"text"},{"text":"with part-group elements that indicate braces and brackets. Parts are ordered from top to bottom in a score","type":"text"},{"text":" ","type":"text"},{"text":"based on the order in which they appear in the part-list.","type":"text"}],"title":"MXLPartList","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartList","kind":"symbol","url":"\/documentation\/ivormxl\/mxlpartlist","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPartList"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLScorePartwise/partList":{"url":"\/documentation\/ivormxl\/mxlscorepartwise\/partlist","abstract":[{"type":"text","text":"The list of parts that make up the score, along with the part-group elements that indicate braces and"},{"text":" ","type":"text"},{"type":"text","text":"brackets between them."}],"kind":"symbol","title":"partList","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePartwise\/partList","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"partList","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLPartList","preciseIdentifier":"s:7IvorMXL11MXLPartListV","kind":"typeIdentifier"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLScorePartwise":{"abstract":[{"type":"text","text":"The score-partwise element is the root element for a partwise MusicXML score. It includes a score-header group"},{"type":"text","text":" "},{"type":"text","text":"followed by a series of parts with measures inside. The document-attributes attribute group includes the"},{"type":"text","text":" "},{"type":"text","text":"version attribute."}],"title":"MXLScorePartwise","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLScorePartwise"}],"navigatorTitle":[{"kind":"identifier","text":"MXLScorePartwise"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlscorepartwise","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePartwise"}}}