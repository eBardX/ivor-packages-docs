ureText":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLMeasureText"}],"title":"MXLMeasureText","abstract":[{"text":"The measure-text type is used for the text attribute of measure elements. It has at least one character. The","type":"text"},{"text":" ","type":"text"},{"text":"implicit attribute of the measure element should be set to “yes” rather than setting the text attribute to an","type":"text"},{"text":" ","type":"text"},{"text":"empty string.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMeasureText","role":"symbol","url":"\/documentation\/ivormxl\/mxlmeasuretext","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLMeasureText"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLScorePartwise/Part":{"type":"topic","abstract":[{"type":"text","text":"A part within a part-wise score, containing that part’s measures."}],"url":"\/documentation\/ivormxl\/mxlscorepartwise\/part","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Part"}],"kind":"symbol","title":"MXLScorePartwise.Part","navigatorTitle":[{"kind":"identifier","text":"Part"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePartwise\/Part","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLScorePartwise":{"type":"topic","title":"MXLScorePartwise","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePartwise","abstract":[{"text":"The score-partwise element is the root element for a partwise MusicXML score. It includes a score-header group","type":"text"},{"text":" ","type":"text"},{"text":"followed by a series of parts with measures inside. The document-attributes attribute group includes the","type":"text"},{"text":" ","type":"text"},{"text":"version attribute.","type":"text"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLScorePartwise"}],"navigatorTitle":[{"kind":"identifier","text":"MXLScorePartwise"}],"url":"\/documentation\/ivormxl\/mxlscorepartwise"},"doc://IvorMXL/documentation/IvorMXL/MXLMusicItem":{"type":"topic","title":"MXLMusicItem","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMusicItem","abstract":[{"type":"text","text":"One of the alternatives for a music item."}],"role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLMusicItem","kind":"identifier"}],"navigatorTitle":[{"text":"MXLMusicItem","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlmusicitem"},"doc://IvorMXL/documentation/IvorMXL/MXLTenths":{"type":"topic","abstract":[{"type":"text","text":"The tenths type is a number representing tenths of interline staff space (positive or negative). Both integer"},{"type":"text","text":" "},{"type":"text","text":"and decimal values are allowed, such as 5 for a half space and 2.5 for a quarter space. Interline space is"},{"type":"text","text":" "},{"type":"text","text":"measured from the middle of a staff line."}],"url":"\/documentation\/ivormxl\/mxltenths","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTenths"}],"kind":"symbol","title":"MXLTenths","navigatorTitle":[{"kind":"identifier","text":"MXLTenths"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLScorePartwise/Part/Measure":{"type":"topic","abstract":[{"type":"text","text":"A measure within a part of a part-wise score."}],"url":"\/documentation\/ivormxl\/mxlscorepartwise\/part\/measure","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Measure"}],"kind":"symbol","title":"MXLScorePartwise.Part.Measure","navigatorTitle":[{"kind":"identifier","text":"Measure"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePartwise\/Part\/Measure","role":"symbol"}}}