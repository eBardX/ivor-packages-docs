},{"text":"] = [])","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}]},{"parameters":[{"content":[{"inlineContent":[{"text":"The optional-unique-id attribute group allows an element to optionally","type":"text"},{"text":" ","type":"text"},{"text":"specify an ID that is unique to the entire document. This attribute group is","type":"text"},{"text":" ","type":"text"},{"text":"not used for a required id attribute, or for an id attribute that specifies","type":"text"},{"text":" ","type":"text"},{"text":"an id reference.","type":"text"}],"type":"paragraph"}],"name":"id"},{"content":[{"inlineContent":[{"text":"The measure number. In partwise files, this should be the same for measures","type":"text"},{"text":" ","type":"text"},{"text":"in different parts that share the same left barline. Often numeric, but not","type":"text"},{"text":" ","type":"text"},{"text":"required to be; non-numeric values are typically combined with ","type":"text"},{"code":"implicit","type":"codeVoice"},{"text":" or","type":"text"},{"text":" ","type":"text"},{"code":"nonControlling","type":"codeVoice"},{"text":" set to ","type":"text"},{"code":"true","type":"codeVoice"},{"text":". For a pickup measure, this is typically ","type":"text"},{"code":"\"0\"","type":"codeVoice"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"code":"implicit","type":"codeVoice"},{"text":" set to ","type":"text"},{"code":"true","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"name":"number"},{"content":[{"inlineContent":[{"text":"A Boolean value indicating whether the measure number should never appear,","type":"text"},{"text":" ","type":"text"},{"text":"such as for pickup measures and the last half of mid-measure repeats.","type":"text"},{"text":" ","type":"text"},{"text":"Defaults to ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" if not specified.","type":"text"}],"type":"paragraph"}],"name":"isImplicit"},{"content":[{"inlineContent":[{"text":"A Boolean value indicating whether the left barline in this measure does not","type":"text"},{"text":" ","type":"text"},{"text":"coincide with the left barline of measures in other parts, as in multimetric","type":"text"},{"text":" ","type":"text"},{"text":"music like the Don Giovanni minuet. Defaults to ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" if not specified.","type":"text"}],"type":"paragraph"}],"name":"isNonControlling"},{"content":[{"inlineContent":[{"text":"The displayed measure number, when different from the value of ","type":"text"},{"code":"number","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Ignored when ","type":"text"},{"code":"implicit","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"name":"text"},{"content":[{"inlineContent":[{"text":"The width of the measure, in tenths, from barline or system start to barline","type":"text"},{"text":" ","type":"text"},{"text":"or system end. These are the global tenths defined by the scaling element,","type":"text"},{"text":" ","type":"text"},{"text":"not local tenths as modified by the staff-size element.","type":"text"}],"type":"paragraph"}],"name":"width"},{"content":[{"inlineContent":[{"text":"The music-data group that contains the basic musical data associated with","type":"text"},{"text":" ","type":"text"},{"text":"this measure.","type":"text"}],"type":"paragraph"}],"name":"items"}],"kind":"parameters"}],"abstract":[{"text":"Creates a new ","type":"text"},{"code":"MXLScorePartwise.Part.Measure","type":"codeVoice"},{"text":".","type":"text"}],"references":{"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXL