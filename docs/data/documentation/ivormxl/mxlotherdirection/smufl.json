]]},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLSmuflGlyphName":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSmuflGlyphName","kind":"identifier"}],"title":"MXLSmuflGlyphName","abstract":[{"type":"text","text":"The smufl-glyph-name type is used for attributes that reference a specific Standard Music Font Layout (SMuFL)"},{"text":" ","type":"text"},{"type":"text","text":"character. The value is a SMuFL canonical glyph name, not a code point. For instance, the value for a standard"},{"type":"text","text":" "},{"text":"piano pedal mark would be keyboardPedalPed, not U+E650.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSmuflGlyphName","role":"symbol","url":"\/documentation\/ivormxl\/mxlsmuflglyphname","kind":"symbol","navigatorTitle":[{"text":"MXLSmuflGlyphName","kind":"identifier"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLOtherDirection/smufl":{"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"smufl"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLSmuflGlyphName","preciseIdentifier":"s:7IvorMXL17MXLSmuflGlyphNameV"},{"kind":"text","text":"?"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlotherdirection\/smufl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOtherDirection\/smufl","title":"smufl","abstract":[{"type":"text","text":"The smufl attribute group is used to indicate a particular Standard Music Font Layout (SMuFL) character."},{"type":"text","text":" "},{"type":"text","text":"Sometimes this is a formatting choice, and sometimes this is a refinement of the semantic meaning of an"},{"type":"text","text":" "},{"type":"text","text":"element."}],"role":"symbol","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLOtherDirection":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLOtherDirection"}],"title":"MXLOtherDirection","abstract":[{"text":"The other-direction type is used to define any direction symbols not yet in the MusicXML format. The smufl","type":"text"},{"text":" ","type":"text"},{"text":"attribute can be used to specify a particular direction symbol, allowing application interoperability without","type":"text"},{"text":" ","type":"text"},{"text":"requiring every SMuFL glyph to have a MusicXML element equivalent. Using the other-direction type without the","type":"text"},{"text":" ","type":"text"},{"text":"smufl attribute allows for extended representation, though without application interoperability.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOtherDirection","role":"symbol","url":"\/documentation\/ivormxl\/mxlotherdirection","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLOtherDirection"}],"type":"topic"}}}