\/color","role":"symbol","title":"color","type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"title":"MXLColor","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"abstract":[{"text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in","type":"text"},{"text":" ","type":"text"},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"url":"\/documentation\/ivormxl\/mxlcolor"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLOtherDirection":{"kind":"symbol","abstract":[{"type":"text","text":"The other-direction type is used to define any direction symbols not yet in the MusicXML format. The smufl"},{"type":"text","text":" "},{"type":"text","text":"attribute can be used to specify a particular direction symbol, allowing application interoperability without"},{"type":"text","text":" "},{"type":"text","text":"requiring every SMuFL glyph to have a MusicXML element equivalent. Using the other-direction type without the"},{"type":"text","text":" "},{"type":"text","text":"smufl attribute allows for extended representation, though without application interoperability."}],"url":"\/documentation\/ivormxl\/mxlotherdirection","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\