xt":"?","kind":"text"}],"kind":"symbol","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLColor","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","title":"MXLColor","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlcolor"},"doc://IvorMXL/documentation/IvorMXL/MXLOtherDirection":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLOtherDirection"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOtherDirection","title":"MXLOtherDirection","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLOtherDirection"}],"abstract":[{"type":"text","text":"The other-direction type is used to define any direction symbols not yet in the MusicXML format. The smufl"},{"type":"text","text":" "},{"type":"text","text":"attribute can be used to specify a particular direction symbol, allowing application interoperability without"},{"type":"text","text":" "},{"type":"text","text":"requiring every SMuFL glyph to have a MusicXML element equivalent. Using the other-direction type without the"},{"type":"text","text":" "},{"type":"text","text":"smufl attribute allows for extended representation, though without application interoperability."}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlotherdirection"}}}