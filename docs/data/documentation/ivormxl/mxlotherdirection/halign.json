{"abstract":[{"type":"text","text":"In cases where text extends over more than one line, horizontal alignment and justify values can be different."},{"type":"text","text":" "},{"type":"text","text":"The most typical case is for credits, such as:"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"text":"halign","kind":"identifier"},{"kind":"text","text":": "},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLeftCenterRight","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL18MXLLeftCenterRightO","text":"MXLLeftCenterRight"},{"kind":"text","text":"?"}]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Words and music by Pat Songwriter"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Typically this type of credit is aligned to the right, so that the position information refers to the right-"},{"type":"text","text":" "},{"type":"text","text":"most part of the text. But in this example, the text is center-justified, not right-justified."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The halign attribute is used in these situations. If it is not present, its value is the same as for the"},{"type":"text","text":" "},{"type":"text","text":"justify attribute. For elements where a justify attribute is not allowed, the default is implementation-"},{"type":"text","text":" "},{"type":"text","text":"dependent."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Maps to the MusicXML "},{"type":"codeVoice","code":"halign"},{"type":"text","text":" attribute."}]}]}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOtherDirection"]]},"kind":"symbol","metadata":{"symbolKind":"property","title":"halign","role":"symbol","externalID":"s:7IvorMXL17MXLOtherDirectionV6halignAA18MXLLeftCenterRightOSgvp","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"halign"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL18MXLLeftCenterRightO","text":"MXLLeftCenterRight"},{"kind":"text","text":"?"}],"modules":[{"name":"IvorMXL"}],"roleHeading":"Instance Property"},"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOtherDirection\/halign","interfaceLanguage":"swift"},"sections":[],"variants":[{"paths":["\/documentation\/ivormxl\/mxlotherdirection\/halign"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLLeftCenterRight":{"url":"\/documentation\/ivormxl\/mxlleftcenterright","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLeftCenterRight","abstract":[{"type":"text","text":"The left-center-right type is used to define horizontal alignment and text justification."}],"title":"MXLLeftCenterRight","kind":"symbol","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLLeftCenterRight"}],"navigatorTitle":[{"kind":"identifier","text":"MXLLeftCenterRight"}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLOtherDirection/halign":{"kind":"symbol","abstract":[{"type":"text","text":"In cases where text extends over more than one line, horizontal alignment and justify values can be different."},{"type":"text","text":" "},{"type":"text","text":"The most typical case is for credits, such as:"}],"url":"\/documentation\/ivormxl\/mxlotherdirection\/halign","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOtherDirection\/halign","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"text":"halign","kind":"identifier"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL18MXLLeftCenterRightO","text":"MXLLeftCenterRight"},{"text":"?","kind":"text"}],"title":"halign","type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLOtherDirection":{"kind":"symbol","abstract":[{"type":"text","text":"The other-direction type is used to define any direction symbols not yet in the MusicXML format. The smufl"},{"type":"text","text":" "},{"type":"text","text":"attribute can be used to specify a particular direction symbol, allowing application interoperability without"},{"type":"text","text":" "},{"type":"text","text":"requiring every SMuFL glyph to have a MusicXML element equivalent. Using the other-direction type without the"},{"type":"text","text":" "},{"type":"text","text":"smufl attribute allows for extended representation, though without application interoperability."}],"url":"\/documentation\/ivormxl\/mxlotherdirection","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOtherDirection","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLOtherDirection","kind":"identifier"}],"title":"MXLOtherDirection","navigatorTitle":[{"text":"MXLOtherDirection","kind":"identifier"}],"type":"topic"}}}