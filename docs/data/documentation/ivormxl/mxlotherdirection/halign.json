":" ","type":"text"},{"text":"most part of the text. But in this example, the text is center-justified, not right-justified.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The halign attribute is used in these situations. If it is not present, its value is the same as for the","type":"text"},{"text":" ","type":"text"},{"text":"justify attribute. For elements where a justify attribute is not allowed, the default is implementation-","type":"text"},{"text":" ","type":"text"},{"text":"dependent.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Maps to the MusicXML ","type":"text"},{"type":"codeVoice","code":"halign"},{"text":" attribute.","type":"text"}]}],"kind":"content"}],"references":{"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLOtherDirection/halign":{"role":"symbol","kind":"symbol","url":"\/documentation\/ivormxl\/mxlotherdirection\/halign","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOtherDirection\/halign","abstract":[{"type":"text","text":"In cases where text extends over more than one line, horizontal alignment and justify values can be different."},{"type":"text","text":" "},{"type":"text","text":"The most typical case is for credits, such as:"}],"type":"topic","title":"halign","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"halign"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL18MXLLeftCenterRightO","text":"MXLLeftCenterRight"},{"kind":"text","text":"?"}]},"doc://IvorMXL/documentation/IvorMXL/MXLOtherDirection":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLOtherDirection"}],"identi