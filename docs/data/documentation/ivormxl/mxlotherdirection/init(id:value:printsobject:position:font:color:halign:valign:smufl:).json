mentation\/IvorMXL\/MXLValign","text":"MXLValign","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"smufl","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL17MXLSmuflGlyphNameV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSmuflGlyphName","text":"MXLSmuflGlyphName","kind":"typeIdentifier"},{"text":"? = nil)","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The optional-unique-id attribute group allows an element to optionally specify an ID"},{"type":"text","text":" "},{"type":"text","text":"that is unique to the entire document. This attribute group is not used for a"},{"type":"text","text":" "},{"type":"text","text":"required id attribute, or for an id attribute that specifies an id reference."}]}],"name":"id"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The value of this element."}]}],"name":"value"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A Boolean value indicating whether to print an object (e.g. a note or a rest)."},{"type":"text","text":" "},{"type":"text","text":"Defaults to "},{"type":"codeVoice","code":"true"},{"type":"text","text":" if not specified."}]}],"name":"printsObject"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For most elements, any program will compute a default x and y position. The position"},{"type":"text","text":" "},{"type":"text","text":"attributes let this be changed two ways."}]}],"name":"position"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The font attribute group gathers together attributes for determining the font within"},{"type":"text","text":" "},{"type":"text","text":"a credit or direction. They are based on the text styles for Cascading Style Sheets."},{"type":"text","text":" "},{"type":"text","text":"The font-family is a comma-separated list of font names. The font-style can be normal"},{"type":"text","text":" "},{"type":"text","text":"or italic. The font-size can be one of the CSS sizes or a numeric point size. The"},{"type":"text","text":" "},{"type":"text","text":"font-weight can be normal or bold. The default is application-dependent, but is a"},{"type":"text","text":" "},{"type":"text","text":"text font vs. a music font."}]}],"name":"font"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The color attribute group indicates the color of an element."}]}],"name":"color"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In cases where text extends over more than one line, horizontal alignment and justify"},{"type":"text","text":" "},{"type":"text","text":"values can be different."}]}],"name":"halign"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The valign attribute is used to indicate vertical alignment to the top, middle,"},{"type":"text","text":" "},{"type":"text","text":"bottom, or baseline of the text. Defaults are implementation-dependent."}]}],"name":"valign"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The smufl attribute group is used to indicate a particular Standard Music Font Layout"},{"type":"text","text":" "},{"type":"text","text":"(SMuFL) character. Sometimes this is a formatting choice, and sometimes this is a"},{"type":"text","text":" "},{"type":"text","text":"refinement of the semantic meaning of an element."}]}],"name":"smufl"}]}],"variants":[{"paths":["\/documentation\/ivormxl\/mxlotherdirection\/init(id:value:printsobject:position:font:color:halign:valign:smufl:)"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"roleHeading":"Initializer","modules":[{"name":"IvorMXL"}],"symbolKind":"init","externalID":"s:7IvorMXL17MXLOtherDirectionV2id5value12printsObject8position4font5color6halign6valign5smuflACSSSg_SSSbSgAA11MXLPositionVAA7MXLFontVAA8MXLColorVSgAA18MXLLeftC