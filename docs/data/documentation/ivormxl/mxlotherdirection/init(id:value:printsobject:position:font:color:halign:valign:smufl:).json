:"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOtherDirection","url":"\/documentation\/ivormxl\/mxlotherdirection","navigatorTitle":[{"text":"MXLOtherDirection","kind":"identifier"}]}}}