{"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"paths":["\/documentation\/ivormxl\/mxlelision"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"The elision type represents an elision between lyric syllables. The text content specifies the symbol used to","type":"text"},{"text":" ","type":"text"},{"text":"display the elision. Common values are a no-break space (Unicode 00A0), an underscore (Unicode 005F), or an","type":"text"},{"text":" ","type":"text"},{"text":"undertie (Unicode 203F). If the text content is empty, the smufl attribute is used to specify the symbol to","type":"text"},{"text":" ","type":"text"},{"text":"use. Its value is a SMuFL canonical glyph name that starts with lyrics. The SMuFL attribute is ignored if the","type":"text"},{"text":" ","type":"text"},{"text":"elision glyph is already specified by the text content. If neither text content nor a smufl attribute are","type":"text"},{"text":" ","type":"text"},{"text":"present, the elision glyph is application-specific.","type":"text"}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL"]]},"sections":[],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLElision","interfaceLanguage":"swift"},"topicSections":[{"generated":true,"title":"Initializers","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLElision\/init(value:font:color:smufl:)"],"anchor":"Initializers"},{"generated":true,"title":"Instance Properties","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLElision\/color","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLElision\/font","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLElision\/smufl","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLElision\/value"],"anchor":"Instance-Properties"},{"generated":true,"title":"Default Implementations","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLElision\/Equatable-Implementations"],"anchor":"Default-Implementations"}],"relationshipsSections":[{"type":"conformsTo