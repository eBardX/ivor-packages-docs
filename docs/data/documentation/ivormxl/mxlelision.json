"MXLFont","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL7MXLFontV"}],"abstract":[{"type":"text","text":"The font attribute group gathers together attributes for determining the font within a credit or direction."},{"type":"text","text":" "},{"type":"text","text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of"},{"type":"text","text":" "},{"type":"text","text":"font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric"},{"type":"text","text":" "},{"type":"text","text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font"},{"type":"text","text":" "},{"type":"text","text":"vs. a music font."}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlelision\/font","title":"font"},"doc://IvorMXL/documentation/IvorMXL/MXLElision/Equatable-Implementations":{"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLElision\/Equatable-Implementations","role":"collectionGroup","abstract":[],"kind":"article","url":"\/documentation\/ivormxl\/mxlelision\/equatable-implementations","title":"Equatable Implementations"},"doc://IvorMXL/documentation/IvorMXL/MXLElision/smufl":{"abstract":[{"text":"The SMuFL canonical glyph name used to specify the elision symbol when the text content is empty.","type":"text"}],"title":"smufl","kind":"symbol","url":"\/documentation\/ivormxl\/mxlelision\/smufl","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"smufl","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLSmuflLyricsGlyphName","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL23MXLSmuflLyricsGlyphNameV"},{"text":"?","kind":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLElision\/smufl"},"doc://IvorMXL/SQ":{"type":"unresolvable","identifier":"doc:\/\/IvorMXL\/SQ","title":"Swift.Equatable"}}}