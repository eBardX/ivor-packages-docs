{"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL"]]},"kind":"symbol","schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"type":"text","text":"The full-note group is a sequence of the common note elements between cue\/grace notes and regular (full)"},{"type":"text","text":" "},{"type":"text","text":"notes: pitch, chord, and rest information, but not duration (cue and grace notes do not have duration"},{"type":"text","text":" "},{"type":"text","text":"encoded). Unpitched elements are used for unpitched percussion, speaking voice, and other musical elements"},{"type":"text","text":" "},{"type":"text","text":"lacking determinate pitch."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFullNote"}],"platforms":["macOS"]}]}],"topicSections":[{"title":"Initializers","generated":true,"anchor":"Initializers","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFullNote\/init(isChord:content:)"]},{"title":"Instance Properties","generated":true,"anchor":"Instance-Properties","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFullNote\/content-swift.property","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFullNote\/isChord"]},{"title":"Enumerations","generated":true,"anchor":"Enumerations","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFullNote\/Content-swift.enum"]},{"title":"Default Implementations","generated":true,"anchor":"Default-Implementations","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFullNote\/Equatable-Implementations"]}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlfullnote"]}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFullNote","interfaceLanguage":"swift"},"relationshipsSections":[{"title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/IvorMXL\/s8CopyableP","doc:\/\/IvorMXL\/SQ","doc:\/\/IvorMXL\/s9EscapableP","doc:\/\/IvorMXL\/SH","doc:\/\/IvorMXL\/s8SendableP","doc:\/\/IvorMXL\/s16SendableMetatypeP"],"type":"conformsTo"}],"metadata":{"roleHeading":"Structure","title":"MXLFullNote","symbolKind":"struct","modules":[{"name":"IvorMXL"}],"externalID":"s:7IvorMXL11MXLFullNoteV","navigatorTitle":[{"text":"MXLFullNote","kind":"identifier"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFullNote"}],"role":"symbol"},"seeAlsoSections":[{"title":"Music","generated":true,"anchor":"Music","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMusicItem","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRest","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPitch","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound"]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLSound":{"abstract":[{"text":"The sound element contains general playback parameters. They can stand alone within a part\/measure, or be a","type":"text"},{"text":" ","type":"text"},{"text":"component element within a direction.","type":"text"}],"title":"MXLSound","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLSound"}],"navigatorTitle":[{"kind":"identifier","text":"MXLSound"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlsound","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound"},"doc://IvorMXL/documentation/IvorMXL/MXLFullNote":{"abstract":[{"text":"The full-note group is a sequence of the common note elements between cue\/grace notes and regular (full)","type":"text"},{"text":" ","type":"text"},{"text":"notes: pitch, chord, and rest information, but not duration (cue and grace notes do not have duration","type":"text"},{"text":" ","type":"text"},{"text":"encoded). Unpitched elements are used for unpitched percussion, speaking voice, and other musical elements","type":"text"},{"text":" ","type":"text"},{"text":"lacking determinate pitch.","type":"text"}],"title":"MXLFullNote","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFullNote"}],"navigatorTitle":[{"kind":"identifier","text":"MXLFullNote"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlfullnote","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFullNote"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes":{"abstract":[{"text":"The attributes element contains musical information that typically changes on measure boundaries. This","type":"text"},{"text":" ","type":"text"},{"text":"includes key and time signatures, clefs, transpositions, and staving. When attributes are changed mid-measure,","type":"text"},{"text":" ","type":"text"},{"text":"it affects the music in score order, not in MusicXML document order.","type":"text"}],"title":"MXLAttributes","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLAttributes"}],"navigatorTitle":[{"kind":"identifier","text":"MXLAttributes"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlattributes","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes"},"doc://IvorMXL/documentation/IvorMXL/MXLRest":{"kind":"symbol","navigatorTitle":[{"text":"MXLRest","kind":"identifier"}],"title":"MXLRest","url":"\/documentation\/ivormxl\/mxlrest","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLRest","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRest","abstract":[{"text":"The rest element indicates notated rests or silences. Rest elements are usually empty, but placement on the","type":"text"},{"text":" ","type":"text"},{"text":"staff can be specified using display-step and display-octave elements. If the measure attribute is set to yes,","type":"text"},{"text":" ","type":"text"},{"text":"this indicates this is a complete measure rest.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLDirection":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection","title":"MXLDirection","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLDirection","kind":"identifier"}],"navigatorTitle":[{"text":"MXLDirection","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxldirection","abstract":[{"text":"A direction is a musical indication that is not necessarily attached to a specific note. Two or more may be","type":"text"},{"type":"text","text":" "},{"type":"text","text":"combined to indicate words followed by the start of a dashed line, the end of a wedge followed by dynamics,"},{"type":"text","text":" "},{"type":"text","text":"etc. For applications where a specific direction is indeed attached to a specific note, the direction element"},{"type":"text","text":" "},{"type":"text","text":"can be associated with the first note element that follows it in score order that is not in a different voice."}]},"doc://IvorMXL/s8CopyableP":{"identifier":"doc:\/\/IvorMXL\/s8CopyableP","title":"Swift.Copyable","type":"unresolvable"},"doc://IvorMXL/documentation/IvorMXL/MXLFullNote/Content-swift.enum":{"title":"MXLFullNote.Content","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Content","kind":"identifier"}],"kind":"symbol","type":"topic","abstract":[{"type":"text","text":"One of the alternatives for FullNote."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFullNote\/Content-swift.enum","url":"\/documentation\/ivormxl\/mxlfullnote\/content-swift.enum","navigatorTitle":[{"text":"Content","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"navigatorTitle":[{"kind":"identifier","text":"MXLNote"}],"abstract":[{"text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for","type":"text"},{"text":" ","type":"text"},{"text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation).","type":"text"},{"text":" ","type":"text"},{"text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,","type":"text"},{"text":" ","type":"text"},{"text":"but no tie elements. Having these two types of information available can make interchange easier, as some","type":"text"},{"text":" ","type":"text"},{"text":"programs handle one type of information more readily than the other.","type":"text"}],"title":"MXLNote","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","kind":"symbol","url":"\/documentation\/ivormxl\/mxlnote","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNote"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLMusicItem":{"abstract":[{"text":"One of the alternatives for a music item.","type":"text"}],"title":"MXLMusicItem","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLMusicItem"}],"navigatorTitle":[{"kind":"identifier","text":"MXLMusicItem"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlmusicitem","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMusicItem"},"doc://IvorMXL/SQ":{"identifier":"doc:\/\/IvorMXL\/SQ","type":"unresolvable","title":"Swift.Equatable"},"doc://IvorMXL/documentation/IvorMXL/MXLFullNote/init(isChord:content:)":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFullNote\/init(isChord:content:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"isChord"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":", "},{"kind":"externalParam","text":"content"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Content","preciseIdentifier":"s:7IvorMXL11MXLFullNoteV7ContentO"},{"kind":"text","text":")"}],"role":"symbol","type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlfullnote\/init(ischord:content:)","abstract":[{"text":"Creates a new ","type":"text"},{"code":"MXLFullNote","type":"codeVoice"},{"text":".","type":"text"}],"title":"init(isChord:content:)"},"doc://IvorMXL/s16SendableMetatypeP":{"type":"unresolvable","title":"Swift.SendableMetatype","identifier":"doc:\/\/IvorMXL\/s16SendableMetatypeP"},"doc://IvorMXL/s8SendableP":{"identifier":"doc:\/\/IvorMXL\/s8SendableP","title":"Swift.Sendable","type":"unresolvable"},"doc://IvorMXL/SH":{"identifier":"doc:\/\/IvorMXL\/SH","title":"Swift.Hashable","type":"unresolvable"},"doc://IvorMXL/documentation/IvorMXL/MXLFullNote/Equatable-Implementations":{"url":"\/documentation\/ivormxl\/mxlfullnote\/equatable-implementations","abstract":[],"title":"Equatable Implementations","kind":"article","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFullNote\/Equatable-Implementations","type":"topic","role":"collectionGroup"},"doc://IvorMXL/documentation/IvorMXL/MXLFullNote/content-swift.property":{"url":"\/documentation\/ivormxl\/mxlfullnote\/content-swift.property","abstract":[{"type":"text","text":"One of the alternatives for FullNote."}],"title":"content","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFullNote\/content-swift.property","type":"topic","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"content"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLFullNoteV7ContentO","text":"Content"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLFullNote/isChord":{"url":"\/documentation\/ivormxl\/mxlfullnote\/ischord","abstract":[{"type":"text","text":"A Boolean value indicating whether this note is an additional chord tone with the preceding note."}],"title":"isChord","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFullNote\/isChord","type":"topic","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"isChord"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline":{"navigatorTitle":[{"text":"MXLBarline","kind":"identifier"}],"abstract":[{"text":"If a barline is other than a normal single barline, it should be represented by a barline type that describes","type":"text"},{"text":" ","type":"text"},{"text":"it. This includes information about repeats and multiple endings, as well as line style. Barline data is on","type":"text"},{"text":" ","type":"text"},{"text":"the same level as the other musical data in a score — a child of a measure in a partwise score, or a part in a","type":"text"},{"text":" ","type":"text"},{"text":"timewise score. This allows for barlines within measures, as in dotted barlines that subdivide measures in","type":"text"},{"text":" ","type":"text"},{"text":"complex meters. The two fermata elements allow for fermatas on both sides of the barline (the lower one","type":"text"},{"text":" ","type":"text"},{"text":"inverted).","type":"text"}],"title":"MXLBarline","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline","kind":"symbol","url":"\/documentation\/ivormxl\/mxlbarline","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLBarline","kind":"identifier"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLPitch":{"navigatorTitle":[{"text":"MXLPitch","kind":"identifier"}],"abstract":[{"type":"text","text":"Pitch is represented as a combination of the step of the diatonic scale, the chromatic alteration, and the"},{"type":"text","text":" "},{"type":"text","text":"octave."}],"title":"MXLPitch","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPitch","kind":"symbol","url":"\/documentation\/ivormxl\/mxlpitch","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPitch","kind":"identifier"}],"role":"symbol"},"doc://IvorMXL/s9EscapableP":{"identifier":"doc:\/\/IvorMXL\/s9EscapableP","title":"Swift.Escapable","type":"unresolvable"}}}