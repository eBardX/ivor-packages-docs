{"relationshipsSections":[{"identifiers":["doc:\/\/IvorMXL\/s8CopyableP","doc:\/\/IvorMXL\/SQ","doc:\/\/IvorMXL\/s9EscapableP","doc:\/\/IvorMXL\/SH","doc:\/\/IvorMXL\/s8SendableP","doc:\/\/IvorMXL\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships","title":"Conforms To"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"role":"symbol","title":"MXLStartStopContinue","roleHeading":"Enumeration","externalID":"s:7IvorMXL20MXLStartStopContinueO","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLStartStopContinue"}],"modules":[{"name":"IvorMXL"}],"symbolKind":"enum","navigatorTitle":[{"text":"MXLStartStopContinue","kind":"identifier"}]},"topicSections":[{"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStartStopContinue\/continue","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStartStopContinue\/start","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStartStopContinue\/stop"],"generated":true,"anchor":"Enumeration-Cases","title":"Enumeration Cases"},{"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStartStopContinue\/Equatable-Implementations"],"generated":true,"anchor":"Default-Implementations","title":"Default Implementations"}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL"]]},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLStartStopContinue"}]}]},{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The values of start, stop, and continue refer to how an element appears in musical score order, not in"},{"type":"text","text":" "},{"type":"text","text":"MusicXML document order. An element with a stop attribute may precede the corresponding element with a start"},{"type":"text","text":" "},{"type":"text","text":"attribute within a MusicXML document. This is particularly common in multi-staff music. For example, the"},{"type":"text","text":" "},{"type":"text","text":"stopping point for a slur may appear in staff 1 before the starting point for the slur appears in staff 2"},{"type":"text","text":" "},{"type":"text","text":"later in the document."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When multiple elements with the same tag are used within the same note, their order within the MusicXML"},{"type":"text","text":" "},{"type":"text","text":"document should match the musical score order. For example, a note that marks both the end of one slur and the"},{"type":"text","text":" "},{"type":"text","text":"start of a new slur should have the incoming slur element with a type of stop precede the outgoing slur"},{"type":"text","text":" "},{"type":"text","text":"element with a type of start."}]}]}],"abstract":[{"text":"The start-stop-continue type is used for an attribute of musical elements that can either start or stop, but","type":"text"},{"text":" ","type":"text"},{"text":"also need to refer to an intermediate point in the symbol, as for complex slurs or for formatting of symbols","type":"text"},{"text":" ","type":"text"},{"text":"across system breaks.","type":"text"}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStartStopContinue","interfaceLanguage":"swift"},"sections":[],"variants":[{"paths":["\/documentation\/ivormxl\/mxlstartstopcontinue"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://IvorMXL/SH":{"title":"Swift.Hashable","identifier":"doc:\/\/IvorMXL\/SH","type":"unresolvable"},"doc://IvorMXL/s8SendableP":{"identifier":"doc:\/\/IvorMXL\/s8SendableP","type":"unresolvable","title":"Swift.Sendable"},"doc://IvorMXL/documentation/IvorMXL/MXLStartStopContinue/continue":{"title":"MXLStartStopContinue.continue","role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"