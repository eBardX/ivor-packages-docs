{"abstract":[{"type":"text","text":"The start-stop-continue type is used for an attribute of musical elements that can either start or stop, but"},{"type":"text","text":" "},{"type":"text","text":"also need to refer to an intermediate point in the symbol, as for complex slurs or for formatting of symbols"},{"type":"text","text":" "},{"type":"text","text":"across system breaks."}],"metadata":{"modules":[{"name":"IvorMXL"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLStartStopContinue"}],"roleHeading":"Enumeration","symbolKind":"enum","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLStartStopContinue"}],"title":"MXLStartStopContinue","externalID":"s:7IvorMXL20MXLStartStopContinueO"},"relationshipsSections":[{"kind":"relationships","type":"conformsTo","identifiers":["doc:\/\/IvorMXL\/s8CopyableP","doc:\/\/IvorMXL\/SQ","doc:\/\/IvorMXL\/s9EscapableP","doc:\/\/IvorMXL\/SH","doc:\/\/IvorMXL\/s8SendableP","doc:\/\/IvorMXL\/s16SendableMetatypeP"],"title":"Conforms To"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlstartstopcontinue"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLStartStopContinue"}]}]},{"content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The values of start, stop, and continue refer to how an element appears in musical score order, not in"},{"type":"text","text":" "},{"type":"text","text":"MusicXML document order. An element with a stop attribute may precede the corresponding element with a start"},{"type":"text","text":" "},{"type":"text","text":"attribute within a MusicXML document. This is particularly common in multi-staff music. For example, the"},{"type":"text","text":" "},{"type":"text","text":"stopping point for a slur may appear in staff 1 before the starting point for the slur appears in staff 2"},{"type":"text","text":" "},{"type":"text","text":"later in the document."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When multiple elements with the same tag are used within the same note, their order within the MusicXML"},{"type":"text","text":" "},{"type":"text","text":"document should match the musical score order. For example, a note that marks both the end of one slur and the"},{"type":"text","text":" "},{"type":"text","text":"start of a new slur should have the incoming slur element with a type of stop precede the outgoing slur"},{"type":"text","text":" "},{"type":"text","text":"element with a type of start."}]}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL"]]},"kind":"symbol","sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStartStopContinue"},"topicSections":[{"title":"Enumeration Cases","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStartStopContinue\/continue","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStartStopContinue\/start","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStartStopContinue\/stop"],"generated":true,"anchor":"Enumeration-Cases"},{"generated":true,"anchor":"Default-Implementations","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStartStopContinue\/Equatable-Implementations"],"title":"Default Implementations"}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLStartStopContinue/start":{"abstract":[{"type":"text","text":"The start of the element."}],"url":"\/documentation\/ivormxl\/mxlstartstopcontinue\/start","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"start","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStartStopContinue\/start","role":"symb