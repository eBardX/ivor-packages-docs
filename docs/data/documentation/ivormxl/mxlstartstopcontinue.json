ue"}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLStartStopContinue/continue":{"kind":"symbol","url":"\/documentation\/ivormxl\/mxlstartstopcontinue\/continue","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStartStopContinue\/continue","abstract":[{"type":"text","text":"An intermediate point in the symbol, such as across a system break."}],"type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"`continue`"}],"title":"MXLStartStopContinue.continue"},"doc://IvorMXL/documentation/IvorMXL/MXLStartStopContinue/stop":{"abstract":[{"text":"The end of the element.","type":"text"}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"stop"}],"role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStartStopContinue\/stop","url":"\/documentation\/ivormxl\/mxlstartstopcontinue\/stop","title":"MXLStartStopContinue.stop","kind":"symbol","type":"topic"}}}