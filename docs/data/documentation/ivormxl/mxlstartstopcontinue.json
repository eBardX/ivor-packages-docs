{"abstract":[{"type":"text","text":"The start-stop-continue type is used for an attribute of musical elements that can either start or stop, but"},{"type":"text","text":" "},{"type":"text","text":"also need to refer to an intermediate point in the symbol, as for complex slurs or for formatting of symbols"},{"type":"text","text":" "},{"type":"text","text":"across system breaks."}],"topicSections":[{"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStartStopContinue\/continue","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStartStopContinue\/start","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStartStopContinue\/stop"],"generated":true,"title":"Enumeration Cases","anchor":"Enumeration-Cases"},{"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStartStopContinue\/Equatable-Implementations"],"generated":true,"title":"Default Implementations","anchor":"Default-Implementations"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLStartStopContinue","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"inlineContent":[{"text":"The values of start, stop, and continue refer to how an element appears in musical score order, not in","type":"text"},{"text":" ","type":"text"},{"text":"MusicXML document order. An element with a stop attribute may precede the corresponding element with a start","type":"text"},{"text":" ","type":"text"},{"text":"attribute within a MusicXML document. This is particularly common in multi-staff music. For example, the","type":"text"},{"text":" ","type":"text"},{"text":"stopping point for a slur may appear in staff 1 before the starting point for the slur appears in staff 2","type":"text"},{"text":" ","type":"text"},{"text":"later in the document.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"When multiple elements with the same tag are used within the same note, their order within the MusicXML","type":"text"},{"text":" ","type":"text"},{"text":"document should match the musical score order. For example, a note that marks both the end of one slur and the","type":"text"},{"text":" ","type":"text"},{"text":"start of a new slur should have the incoming slur element with a type of stop precede the outgoing slur","type":"text"},{"text":" ","type":"text"},{"text":"element with a type of start.","type":"text"}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/ivormxl\/mxlstartstopcontinue"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"roleHeading":"Enumeration","modules":[{"name":"IvorMXL"}],"symbolKind":"enum","role":"symbol","title":"MXLStartStopContinue","externalID":"s:7IvorMXL20MXLStartStopContinueO","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLStartStopContinue","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"MXLStartStopContinue"}]},"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL"]]},"kind":"symbol","relationshipsSections":[{"type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/IvorMXL\/s8CopyableP","doc:\/\/IvorMXL\/SQ","doc:\/\/IvorMXL\/s9EscapableP","doc:\/\/IvorMXL\/SH","doc:\/\/IvorMXL\/s8SendableP","doc:\/\/IvorMXL\/s16SendableMetatypeP"],"title":"Conforms To"}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStartStopContinue","interfaceLanguage":"swift"},"sections":[],"references":{"doc://IvorMXL/s16SendableMetatypeP":{"type":"unresolvable","identifier":"doc:\/\/IvorMXL\/s16SendableMetatypeP","title":"Swift.SendableMetatype"},"doc://IvorMXL/SH":{"type":"unresolvable","identifier":"doc:\/\/IvorMXL\/SH","title":"Swift.Hashable"},"doc://IvorMXL/documentation/IvorMXL/MXLStartStopContinue":{"type":"topic","abstract":[{"type":"text","text":"The start-stop-continue type is used for an attribute of musical elements that can either start or stop, but"},{"type":"text","text":" "},{"type":"text","text":"also need to refer to an intermediate point in the symbol, as for complex slurs or for formatting of symbols"},{"type":"text","text":" "},{"type":"text","text":"across system breaks."}],"url":"\/documentation\/ivormxl\/mxlstartstopcontinue","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLStartStopContinue"}],"kind":"symbol","title":"MXLStartStopContinue","navigatorTitle":[{"text":"MXLStartStopContinue","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStartStopContinue","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLStartStopContinue/start":{"title":"MXLStartStopContinue.start","role":"symbol","url":"\/documentation\/ivormxl\/mxlstartstopcontinue\/start","abstract":[{"type":"text","text":"The start of the element."}],"type":"topic","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"start","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStartStopContinue\/start","kind":"symbol"},"doc://IvorMXL/SQ":{"type":"unresolvable","identifier":"doc:\/\/IvorMXL\/SQ","title":"Swift.Equatable"},"doc://IvorMXL/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/IvorMXL\/s8SendableP","title":"Swift.Sendable"},"doc://IvorMXL/documentation/IvorMXL/MXLStartStopContinue/Equatable-Implementations":{"type":"topic","abstract":[],"role":"collectionGroup","title":"Equatable Implementations","kind":"article","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStartStopContinue\/Equatable-Implementations","url":"\/documentation\/ivormxl\/mxlstartstopcontinue\/equatable-implementations"},"doc://IvorMXL/s8CopyableP":{"type":"unresolvable","identifier":"doc:\/\/IvorMXL\/s8CopyableP","title":"Swift.Copyable"},"doc://IvorMXL/documentation/IvorMXL/MXLStartStopContinue/stop":{"type":"topic","abstract":[{"type":"text","text":"The end of the element."}],"url":"\/documentation\/ivormxl\/mxlstartstopcontinue\/stop","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"stop"}],"kind":"symbol","title":"MXLStartStopContinue.stop","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStartStopContinue\/stop","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLStartStopContinue/continue":{"abstract":[{"type":"text","text":"An intermediate point in the symbol, such as across a system break."}],"role":"symbol","title":"MXLStartStopContinue.continue","kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxlstartstopcontinue\/continue","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStartStopContinue\/continue","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"`continue`","kind":"identifier"}]},"doc://IvorMXL/s9EscapableP":{"type":"unresolvable","identifier":"doc:\/\/IvorMXL\/s9EscapableP","title":"Swift.Escapable"}}}