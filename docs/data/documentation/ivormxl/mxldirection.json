{"seeAlsoSections":[{"title":"Music","generated":true,"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMusicItem","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFullNote","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRest","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPitch","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound"],"anchor":"Music"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLDirection","kind":"identifier"}],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"inlineContent":[{"text":"By default, a series of direction-type elements and a series of child elements of a direction-type within a","type":"text"},{"text":" ","type":"text"},{"text":"single direction element follow one another in sequence visually. For a series of direction-type children,","type":"text"},{"text":" ","type":"text"},{"text":"non-positional formatting attributes are carried over from the previous element by default.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Maps the MusicXML ","type":"text"},{"code":"<direction>","type":"codeVoice"},{"text":" element.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"type":"text","text":"A direction is a musical indication that is not necessarily attached to a specific note. Two or more may be"},{"type":"text","text":" "},{"type":"text","text":"combined to indicate words followed by the start of a dashed line, the end of a wedge followed by dynamics,"},{"type":"text","text":" "},{"type":"text","text":"etc. For applications where a specific direction is indeed attached to a specific note, the direction element"},{"type":"text","text":" "},{"type":"text","text":"can be associated with the first note element that follows it in score order that is not in a different voice."}],"variants":[{"paths":["\/documentation\/ivormxl\/mxldirection"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL"]]},"sections":[],"metadata":{"modules":[{"name":"IvorMXL"}],"externalID":"s:7IvorMXL12MXLDirectionV","roleHeading":"Structure","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLDirection"}],"title":"MXLDirection","symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"MXLDirection"}]},"kind":"symbol","topicSections":[{"title":"Structures","generated":true,"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/Kind-swift.struct"],"anchor":"Structures"},{"title":"Initializers","generated":true,"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/init(id:kind:offset:footnote:level:voice:staff:sound:listening:placement:isDirective:system:)"],"anchor":"Initializers"},{"title":"Instance Properties","generated":true,"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/footnote","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/id","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/isDirective","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/kind-swift.property","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/level","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/listening","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/offset","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/placement","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/sound","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/staff","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/system","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/voice"],"anchor":"Instance-Properti