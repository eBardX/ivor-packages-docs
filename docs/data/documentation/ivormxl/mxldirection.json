lacement","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLAboveBelow","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL13MXLAboveBelowO"},{"text":"?, ","kind":"text"},{"text":"isDirective","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":"?, ","kind":"text"},{"text":"system","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL17MXLSystemRelationO","text":"MXLSystemRelation","kind":"typeIdentifier"},{"text":"?)","kind":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLSound":{"type":"topic","title":"MXLSound","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound","abstract":[{"type":"text","text":"The sound element contains general playback parameters. They can stand alone within a part\/measure, or be a"},{"type":"text","text":" "},{"type":"text","text":"component element within a direction."}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSound","kind":"identifier"}],"navigatorTitle":[{"text":"MXLSound","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlsound"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection/isDirective":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/isDirective","abstract":[{"text":"A Boolean value indicating whether this direction is a directive, changing its default horizontal position so","type":"text"},{"text":" ","type":"text"},{"text":"its left-hand side aligns with the left-hand side of the time signature (or, if no time signature is present,","type":"text"},{"text":" ","type":"text"},{"text":"the first music notational element in the measure). A default-x, justify, or halign attribute, if present,","type":"text"},{"text":" ","type":"text"},{"text":"overrides this.","type":"text"}],"title":"isDirective","role":"symbol","kind":"symbol","url":"\/documentation\/ivormxl\/mxldirection\/isdirective","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isDirective","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":"?","kind":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLRest":{"title":"MXLRest","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLRest","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"MXLRest","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlrest","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRest","abstract":[{"type":"text","text":"The rest element indicates notated rests or silences. Rest elements are usually empty, but placement on the"},{"type":"text","text":" "},{"text":"staff can be specified using display-step and display-octave elements. If the measure attribute is set to yes,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"this indicates this is a complete measure rest."}],"type":"topic","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection":{"type":"topic","title":"MXLDirection","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection","abstract":[{"type":"text","text":"A direction is a musical indication that is not necessarily attached to a specific note. Two or more may be"},{"type":"text","text":" "},{"type":"text","text":"combined to indicate words followed by the start of a dashed line, the end of a wedge followed by dynamics,"},{"type":"text","text":" "},{"type":"text","text":"etc. For applications where a specific direction is indeed attached to a specific note, the direction element"},{"type":"text","text":" "},{"type":"text","text":"can be associated with the first note element that follows it in score order that is not in a different voice."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLDirection"}],"navigatorTitle":[{"kind":"identifier","text":"MXLDirection"}],"url":"\/documentation\/ivormxl\/mxldirection"},"doc://IvorMXL/s16SendableMetatypeP":{"type":"unresolvable","identifier":"doc:\/\/IvorMXL\/s16SendableMetatypeP","title":"Swift.SendableMetatype"},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNote","kind":"identifier"}],"title":"MXLNote","abstract":[{"text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for","type":"text"},{"text":" ","type":"text"},{"text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation).","type":"text"},{"text":" ","type":"text"},{"text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,","type":"text"},{"text":" ","type":"text"},{"text":"but no tie elements. Having these two types of information available can make interchange easier, as some","type":"text"},{"text":" ","type":"text"},{"text":"programs handle one type of information more readily than the other.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","role":"symbol","url":"\/documentation\/ivormxl\/mxlnote","kind":"symbol","navigatorTitle":[{"text":"MXLNote","kind":"identifier"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection/staff":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/staff","abstract":[{"text":"The staff element is defined within a group due to its use by both notes and direction elements.","type":"text"}],"title":"staff","role":"symbol","kind":"symbol","url":"\/documentation\/ivormxl\/mxldirection\/staff","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"staff","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL8MXLStaffV","text":"MXLStaff","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"type":"topic"},"doc://IvorMXL/SH":{"type":"unresolvable","identifier":"doc:\/\/IvorMXL\/SH","title":"Swift.Hashable"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection/voice":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/voice","abstract":[{"text":"A voice is a sequence of musical events (e.g. notes, chords, rests) that proceeds linearly in time. The voice","type":"text"},{"text":" ","type":"text"},{"text":"element is used to distinguish between multiple voices in individual parts. It is defined within a group due","type":"text"},{"type":"text","text":" "},{"text":"to its multiple uses within the MusicXML schema.","type":"text"}],"title":"voice","role":"symbol","kind":"symbol","url":"\/documentation\/ivormxl\/mxldirection\/voice","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"voice","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL8MXLVoiceV","text":"MXLVoice","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLPitch":{"title":"MXLPitch","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPitch","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlpitch","role":"symbol","navigatorTitle":[{"text":"MXLPitch","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPitch","abstract":[{"type":"text","text":"Pitch is represented as a combination of the step of the diatonic scale, the chromatic alteration, and the"},{"type":"text","text":" "},{"type":"text","text":"octave."}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection/sound":{"abstract":[{"type":"text","text":"General playback parameters associated with this direction."}],"role":"symbol","title":"sound","kind":"symbol","url":"\/documentation\/ivormxl\/mxldirection\/sound","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/sound","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sound","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL8MXLSoundV","text":"MXLSound","kind":"typeIdentifier"},{"kind":"text","text":"?"}]},"doc://IvorMXL/documentation/IvorMXL/MXLDirection/offset":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"offset","kind":"identifier"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL9MXLOffsetV","kind":"typeIdentifier","text":"MXLOffset"},{"kind":"text","text":"?"}],"abstract":[{"type":"text","text":"The position of the direction relative to the current musical location, in divisions."}],"type":"topic","url":"\/documentation\/ivormxl\/mxldirection\/offset","title":"offset","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/offset","kind":"symbol","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection/Kind-swift.struct":{"type":"topic","title":"MXLDirection.Kind","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/Kind-swift.struct","abstract":[{"type":"text","text":"Textual direction types may have more than 1 component due to multiple fonts. The dynamics element may also be"},{"type":"text","text":" "},{"type":"text","text":"used in the notations element. Attribute groups related to print suggestions apply to the individual"},{"type":"text","text":" "},{"type":"text","text":"direction-type, not to the overall direction."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Kind"}],"navigatorTitle":[{"kind":"identifier","text":"Kind"}],"url":"\/documentation\/ivormxl\/mxldirection\/kind-swift.struct"},"doc://IvorMXL/documentation/IvorMXL/MXLMusicItem":{"type":"topic","title":"MXLMusicItem","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMusicItem","abstract":[{"type":"text","text":"One of the alternatives for a music item."}],"role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLMusicItem","kind":"identifier"}],"navigatorTitle":[{"text":"MXLMusicItem","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlmusicitem"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection/id":{"title":"id","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"id","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?","kind":"text"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxldirection\/id","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/id","abstract":[{"type":"text","text":"The optional-unique-id attribute group allows an element to optionally specify an ID that is unique to the"},{"type":"text","text":" "},{"type":"text","text":"entire document. This attribute group is not used for a required id attribute, or for an id attribute that"},{"type":"text","text":" "},{"type":"text","text":"specifies an id reference."}],"type":"topic","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection/placement":{"abstract":[{"text":"The placement attribute indicates whether something is above or below another element, such as a note or a","type":"text"},{"type":"text","text":" "},{"text":"notation.","type":"text"}],"role":"symbol","title":"placement","kind":"symbol","url":"\/documentation\/ivormxl\/mxldirection\/placement","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/placement","fragments":[{"kind":"keyword","text":"let"},{"text":" ","kind":"text"},{"text":"placement","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL13MXLAboveBelowO","text":"MXLAboveBelow","kind":"typeIdentifier"},{"text":"?","kind":"text"}]},"doc://IvorMXL/SQ":{"title":"Swift.Equatable","type":"unresolvable","identifier":"doc:\/\/IvorMXL\/SQ"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection/listening":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/listening","abstract":[{"text":"How a score-following or machine-listening application should interact with a performer, from this point in the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"performance onward."}],"title":"listening","role":"symbol","kind":"symbol","url":"\/documentation\/ivormxl\/mxldirection\/listening","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"listening","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL12MXLListeningV","text":"MXLListening","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLBarline"}],"abstract":[{"text":"If a barline is other than a normal single barline, it should be represented by a barline type that describes","type":"text"},{"text":" ","type":"text"},{"text":"it. This includes information about repeats and multiple endings, as well as line style. Barline data is on","type":"text"},{"text":" ","type":"text"},{"text":"the same level as the other musical data in a score — a child of a measure in a partwise score, or a part in a","type":"text"},{"text":" ","type":"text"},{"text":"timewise score. This allows for barlines within measures, as in dotted barlines that subdivide measures in","type":"text"},{"text":" ","type":"text"},{"text":"complex meters. The two fermata elements allow for fermatas on both sides of the barline (the lower one","type":"text"},{"text":" ","type":"text"},{"text":"inverted).","type":"text"}],"title":"MXLBarline","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline","role":"symbol","url":"\/documentation\/ivormxl\/mxlbarline","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLBarline"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection/Equatable-Implementations":{"abstract":[],"role":"collectionGroup","title":"Equatable Implementations","kind":"article","url":"\/documentation\/ivormxl\/mxldirection\/equatable-implementations","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/Equatable-Implementations"},"doc://IvorMXL/s9EscapableP":{"type":"unresolvable","identifier":"doc:\/\/IvorMXL\/s9EscapableP","title":"Swift.Escapable"},"doc://IvorMXL/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/IvorMXL\/s8SendableP","title":"Swift.Sendable"}}}