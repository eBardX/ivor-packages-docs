{"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"roleHeading":"Structure","symbolKind":"struct","modules":[{"name":"IvorMXL"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLDirection"}],"title":"MXLDirection","navigatorTitle":[{"kind":"identifier","text":"MXLDirection"}],"externalID":"s:7IvorMXL12MXLDirectionV","role":"symbol"},"kind":"symbol","variants":[{"paths":["\/documentation\/ivormxl\/mxldirection"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLDirection"}],"platforms":["macOS"],"languages":["swift"]}]},{"content":[{"text":"Overview","type":"heading","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"By default, a series of direction-type elements and a series of child elements of a direction-type within a"},{"type":"text","text":" "},{"type":"text","text":"single direction element follow one another in sequence visually. For a series of direction-type children,"},{"type":"text","text":" "},{"text":"non-positional formatting attributes are carried over from the previous element by default.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Maps the MusicXML ","type":"text"},{"code":"<direction>","type":"codeVoice"},{"text":" element.","type":"text"}]}],"kind":"content"}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL"]]},"sections":[],"abstract":[{"type":"text","text":"A direction is a musical indication that is not necessarily attached to a specific note. Two or more may be"},{"type":"text","text":" "},{"type":"text","text":"combined to indicate words followed by the start of a dashed line, the end of a wedge followed by dynamics,"},{"type":"text","text":" "},{"type":"text","text":"etc. For applications where a specific direction is indeed attached to a specific note, the direction element"},{"type":"text","text":" "},{"type":"text","text":"can be associated with the first note element that follows it in score order that is not in a different voice."}],"topicSections":[{"title":"Structures","anchor":"Structures","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/Kind-swift.struct"],"generated":true},{"title":"Initializers","anchor":"Initializers","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/init(id:kind:offset:footnote:level:voice:staff:sound:listening:placement:isDirective:system:)"],"generated":true},{"title":"Instance Properties","anchor":"Instance-Properties","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/footnote","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/id","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/isDirective","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/kind-swift.property","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/level","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/listening","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/offset","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/placement","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/sound","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/staff","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/system","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/voice"],"generated":true},{"title":"Default Implementations","anchor":"Default-Implementations","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/Equatable-Implementations"],"generated":true}],"relationshipsSections":[{"kind":"relationships","title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/IvorMXL\/s8CopyableP","doc:\/\/IvorMXL\/SQ","doc:\/\/IvorMXL\/s9EscapableP","doc:\/\/IvorMXL\/SH","doc: