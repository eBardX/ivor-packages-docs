{"kind":"symbol","hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL"]]},"topicSections":[{"title":"Structures","anchor":"Structures","generated":true,"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/Kind-swift.struct"]},{"title":"Initializers","anchor":"Initializers","generated":true,"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/init(id:kind:offset:footnote:level:voice:staff:sound:listening:placement:isDirective:system:)"]},{"title":"Instance Properties","anchor":"Instance-Properties","generated":true,"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/footnote","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/id","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/isDirective","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/kind-swift.property","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/level","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/listening","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/offset","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/placement","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/sound","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/staff","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/system","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/voice"]},{"title":"Default Implementations","anchor":"Default-Implementations","generated":true,"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/Equatable-Implementations"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLDirection"}],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"inlineContent":[{"type":"text","text":"By default, a series of direction-type elements and a series of child elements of a direction-type within a"},{"type":"text","text":" "},{"type":"text","text":"single direction element follow one another in sequence visually. For a series of direction-type children,"},{"type":"text","text":" "},{"type":"text","text":"non-positional formatting attributes are carried over from the previous element by default."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Maps the MusicXML "},{"type":"codeVoice","code":"<direction>"},{"type":"text","text":" element."}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/ivormxl\/mxldirection"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection","interfaceLanguage":"swift"},"seeAlsoSections":[{"title":"Music","anchor":"Music","generated":true,"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMusicItem","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFullNote","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRest","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPitch","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound"]}],"relationshipsSections":[{"kind":"relationships","title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/IvorMXL\/s8CopyableP","doc:\/\/IvorMXL\/SQ","doc:\/\/IvorMXL\/s9EscapableP","doc:\/\/IvorMXL\/SH","doc:\/\/IvorMXL\/s8SendableP","doc:\/\/IvorMXL\/s16SendableMetatypeP"]}],"sections":[],"metadata":{"navigatorTitle":[{"kind":"identifier","text":"MXLDirection"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLDirection"}],"roleHeading":"Structure","title":"MXLDirection","modules":[{"name":"IvorMXL"}],"role":"symbol","symbolKind":"struct","externalID":"s:7IvorMXL12MXLDirectionV"},"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"type":"text","text":"A direction is a musical indication that is not necessarily attached to a specific note. Two or more may be"},{"type":"text","text":" "},{"type":"text","text":"combined to indicate words followed by the start of a dashed line, the end of a wedge followed by dynamics,"},{"type":"text","text":" "},{"type":"text","text":"etc. For applications where a specific direction is indeed attached to a specific note, the direction element"},{"type":"text","text":" "},{"type":"text","text":"can be associated with the first note element that follows it in score order that is not in a different voice."}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLFullNote":{"url":"\/documentation\/ivormxl\/mxlfullnote","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFullNote"}],"title":"MXLFullNote","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFullNote","navigatorTitle":[{"kind":"identifier","text":"MXLFullNote"}],"role":"symbol","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The full-note group is a sequence of the common note elements between cue\/grace notes and regular (full)"},{"type":"text","text":" "},{"type":"text","text":"notes: pitch, chord, and rest information, but not duration (cue and grace notes do not have duration"},{"type":"text","text":" "},{"type":"text","text":"encoded). Unpitched elements are used for unpitched percussion, speaking voice, and other musical elements"},{"type":"text","text":" "},{"type":"text","text":"lacking determinate pitch."}]},"doc://IvorMXL/documentation/IvorMXL/MXLRest":{"url":"\/documentation\/ivormxl\/mxlrest","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLRest"}],"title":"MXLRest","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRest","navigatorTitle":[{"kind":"identifier","text":"MXLRest"}],"role":"symbol","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The rest element indicates notated rests or silences. Rest elements are usually empty, but placement on the"},{"type":"text","text":" "},{"type":"text","text":"staff can be specified using display-step and display-octave elements. If the measure attribute is set to yes,"},{"type":"text","text":" "},{"type":"text","text":"this indicates this is a complete measure rest."}]},"doc://IvorMXL/documentation/IvorMXL/MXLDirection/footnote":{"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"footnote"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL16MXLFormattedTextV","text":"MXLFormattedText"},{"kind":"text","text":"?"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/footnote","url":"\/documentation\/ivormxl\/mxldirection\/footnote","title":"footnote","abstract":[{"type":"text","text":"The footnote element specifies editorial information that appears in footnotes in the printed score. It is"},{"type":"text","text":" "},{"type":"text","text":"defined within a group due to its multiple uses within the MusicXML schema."}],"type":"topic","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection/sound":{"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"sound"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLSoundV","text":"MXLSound"},{"kind":"text","text":"?"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/sound","url":"\/documentation\/ivormxl\/mxldirection\/sound","title":"sound","abstract":[{"type":"text","text":"General playback parameters associated with this direction."}],"type":"topic","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLMusicItem":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLMusicItem"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLMusicItem"}],"url":"\/documentation\/ivormxl\/mxlmusicitem","role":"symbol","title":"MXLMusicItem","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMusicItem","type":"topic","abstract":[{"type":"text","text":"One of the alternatives for a music item."}]},"doc://IvorMXL/documentation/IvorMXL/MXLDirection/Kind-swift.struct":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Kind","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/Kind-swift.struct","title":"MXLDirection.Kind","kind":"symbol","navigatorTitle":[{"text":"Kind","kind":"identifier"}],"abstract":[{"text":"Textual direction types may have more than 1 component due to multiple fonts. The dynamics element may also be","type":"text"},{"type":"text","text":" "},{"text":"used in the notations element. Attribute groups related to print suggestions apply to the individual","type":"text"},{"text":" ","type":"text"},{"text":"direction-type, not to the overall direction.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxldirection\/kind-swift.struct"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection/staff":{"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"staff"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLStaffV","text":"MXLStaff"},{"kind":"text","text":"?"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/staff","url":"\/documentation\/ivormxl\/mxldirection\/staff","title":"staff","abstract":[{"type":"text","text":"The staff element is defined within a group due to its use by both notes and direction elements."}],"type":"topic","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection/id":{"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/id","url":"\/documentation\/ivormxl\/mxldirection\/id","abstract":[{"text":"The optional-unique-id attribute group allows an element to optionally specify an ID that is unique to the","type":"text"},{"text":" ","type":"text"},{"text":"entire document. This attribute group is not used for a required id attribute, or for an id attribute that","type":"text"},{"text":" ","type":"text"},{"text":"specifies an id reference.","type":"text"}],"type":"topic","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"id","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"title":"id"},"doc://IvorMXL/documentation/IvorMXL/MXLSound":{"url":"\/documentation\/ivormxl\/mxlsound","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLSound"}],"title":"MXLSound","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound","navigatorTitle":[{"kind":"identifier","text":"MXLSound"}],"role":"symbol","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The sound element contains general playback parameters. They can stand alone within a part\/measure, or be a"},{"type":"text","text":" "},{"type":"text","text":"component element within a direction."}]},"doc://IvorMXL/documentation/IvorMXL/MXLDirection/placement":{"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"placement"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL13MXLAboveBelowO","text":"MXLAboveBelow"},{"kind":"text","text":"?"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/placement","title":"placement","kind":"symbol","abstract":[{"text":"The placement attribute indicates whether something is above or below another element, such as a note or a","type":"text"},{"text":" ","type":"text"},{"text":"notation.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxldirection\/placement"},"doc://IvorMXL/s16SendableMetatypeP":{"type":"unresolvable","title":"Swift.SendableMetatype","identifier":"doc:\/\/IvorMXL\/s16SendableMetatypeP"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection/level":{"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"level"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLLevelV","text":"MXLLevel"},{"kind":"text","text":"?"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/level","url":"\/documentation\/ivormxl\/mxldirection\/level","title":"level","abstract":[{"type":"text","text":"The level element specifies editorial information for different MusicXML elements. It is defined within a"},{"type":"text","text":" "},{"type":"text","text":"group due to its multiple uses within the MusicXML schema."}],"type":"topic","role":"symbol"},"doc://IvorMXL/s9EscapableP":{"type":"unresolvable","title":"Swift.Escapable","identifier":"doc:\/\/IvorMXL\/s9EscapableP"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection/Equatable-Implementations":{"kind":"article","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/Equatable-Implementations","url":"\/documentation\/ivormxl\/mxldirection\/equatable-implementations","title":"Equatable Implementations","abstract":[],"type":"topic","role":"collectionGroup"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes":{"type":"topic","abstract":[{"type":"text","text":"The attributes element contains musical information that typically changes on measure boundaries. This"},{"text":" ","type":"text"},{"type":"text","text":"includes key and time signatures, clefs, transpositions, and staving. When attributes are changed mid-measure,"},{"type":"text","text":" "},{"type":"text","text":"it affects the music in score order, not in MusicXML document order."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLAttributes","kind":"identifier"}],"navigatorTitle":[{"text":"MXLAttributes","kind":"identifier"}],"title":"MXLAttributes","kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlattributes","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection/offset":{"title":"offset","url":"\/documentation\/ivormxl\/mxldirection\/offset","role":"symbol","abstract":[{"type":"text","text":"Indicates where the direction will appear relative to the current musical location, in divisions."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/offset","kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"offset","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL9MXLOffsetV","text":"MXLOffset","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection/kind-swift.property":{"kind":"symbol","url":"\/documentation\/ivormxl\/mxldirection\/kind-swift.property","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/kind-swift.property","abstract":[{"text":"The direction-type elements that make up this direction.","type":"text"}],"type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"kind"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL12MXLDirectionV4KindV","text":"Kind"},{"kind":"text","text":"]"}],"title":"kind"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection/system":{"kind":"symbol","url":"\/documentation\/ivormxl\/mxldirection\/system","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/system","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"system","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLSystemRelation","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL17MXLSystemRelationO"},{"text":"?","kind":"text"}],"role":"symbol","abstract":[{"type":"text","text":"The system-relation attribute group distinguishes elements that are associated with a system rather than the"},{"type":"text","text":" "},{"type":"text","text":"particular part where the element appears."}],"type":"topic","title":"system"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection/isDirective":{"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"isDirective"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":"?"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/isDirective","url":"\/documentation\/ivormxl\/mxldirection\/isdirective","title":"isDirective","abstract":[{"type":"text","text":"A Boolean value indicating whether this direction is a directive, changing its default horizontal position so"},{"type":"text","text":" "},{"type":"text","text":"its left-hand side aligns with the left-hand side of the time signature (or, if no time signature is present,"},{"type":"text","text":" "},{"type":"text","text":"the first music notational element in the measure). A default-x, justify, or halign attribute, if present,"},{"type":"text","text":" "},{"type":"text","text":"overrides this."}],"type":"topic","role":"symbol"},"doc://IvorMXL/SQ":{"type":"unresolvable","title":"Swift.Equatable","identifier":"doc:\/\/IvorMXL\/SQ"},"doc://IvorMXL/s8SendableP":{"type":"unresolvable","title":"Swift.Sendable","identifier":"doc:\/\/IvorMXL\/s8SendableP"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection/listening":{"role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/listening","kind":"symbol","title":"listening","abstract":[{"text":"Specifies how a score-following or machine-listening application should interact with a performer, from this","type":"text"},{"text":" ","type":"text"},{"text":"point in the performance onward.","type":"text"}],"type":"topic","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"listening"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLListening","preciseIdentifier":"s:7IvorMXL12MXLListeningV"},{"kind":"text","text":"?"}],"url":"\/documentation\/ivormxl\/mxldirection\/listening"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection/voice":{"title":"voice","role":"symbol","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"voice","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLVoice","preciseIdentifier":"s:7IvorMXL8MXLVoiceV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"url":"\/documentation\/ivormxl\/mxldirection\/voice","abstract":[{"type":"text","text":"A voice is a sequence of musical events (e.g. notes, chords, rests) that proceeds linearly in time. The voice"},{"type":"text","text":" "},{"type":"text","text":"element is used to distinguish between multiple voices in individual parts. It is defined within a group due"},{"type":"text","text":" "},{"type":"text","text":"to its multiple uses within the MusicXML schema."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/voice","kind":"symbol"},"doc://IvorMXL/SH":{"type":"unresolvable","title":"Swift.Hashable","identifier":"doc:\/\/IvorMXL\/SH"},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNote"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLNote"}],"url":"\/documentation\/ivormxl\/mxlnote","role":"symbol","title":"MXLNote","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","type":"topic","abstract":[{"type":"text","text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for"},{"type":"text","text":" "},{"type":"text","text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation)."},{"type":"text","text":" "},{"type":"text","text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,"},{"type":"text","text":" "},{"type":"text","text":"but no tie elements. Having these two types of information available can make interchange easier, as some"},{"type":"text","text":" "},{"type":"text","text":"programs handle one type of information more readily than the other."}]},"doc://IvorMXL/documentation/IvorMXL/MXLBarline":{"role":"symbol","abstract":[{"type":"text","text":"If a barline is other than a normal single barline, it should be represented by a barline type that describes"},{"text":" ","type":"text"},{"type":"text","text":"it. This includes information about repeats and multiple endings, as well as line style. Barline data is on"},{"type":"text","text":" "},{"type":"text","text":"the same level as the other musical data in a score — a child of a measure in a partwise score, or a part in a"},{"text":" ","type":"text"},{"type":"text","text":"timewise score. This allows for barlines within measures, as in dotted barlines that subdivide measures in"},{"text":" ","type":"text"},{"type":"text","text":"complex meters. The two fermata elements allow for fermatas on both sides of the barline (the lower one"},{"type":"text","text":" "},{"type":"text","text":"inverted)."}],"title":"MXLBarline","url":"\/documentation\/ivormxl\/mxlbarline","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline","navigatorTitle":[{"text":"MXLBarline","kind":"identifier"}],"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLBarline"}]},"doc://IvorMXL/s8CopyableP":{"type":"unresolvable","title":"Swift.Copyable","identifier":"doc:\/\/IvorMXL\/s8CopyableP"},"doc://IvorMXL/documentation/IvorMXL/MXLPitch":{"role":"symbol","abstract":[{"type":"text","text":"Pitch is represented as a combination of the step of the diatonic scale, the chromatic alteration, and the"},{"type":"text","text":" "},{"type":"text","text":"octave."}],"title":"MXLPitch","url":"\/documentation\/ivormxl\/mxlpitch","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPitch","navigatorTitle":[{"text":"MXLPitch","kind":"identifier"}],"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPitch"}]},"doc://IvorMXL/documentation/IvorMXL/MXLDirection":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLDirection"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection","title":"MXLDirection","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLDirection"}],"abstract":[{"text":"A direction is a musical indication that is not necessarily attached to a specific note. Two or more may be","type":"text"},{"type":"text","text":" "},{"text":"combined to indicate words followed by the start of a dashed line, the end of a wedge followed by dynamics,","type":"text"},{"type":"text","text":" "},{"text":"etc. For applications where a specific direction is indeed attached to a specific note, the direction element","type":"text"},{"type":"text","text":" "},{"text":"can be associated with the first note element that follows it in score order that is not in a different voice.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxldirection"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection/init(id:kind:offset:footnote:level:voice:staff:sound:listening:placement:isDirective:system:)":{"url":"\/documentation\/ivormxl\/mxldirection\/init(id:kind:offset:footnote:level:voice:staff:sound:listening:placement:isdirective:system:)","title":"init(id:kind:offset:footnote:level:voice:staff:sound:listening:placement:isDirective:system:)","role":"symbol","fragments":[{"text":"init","kind":"identifier"},{"tex