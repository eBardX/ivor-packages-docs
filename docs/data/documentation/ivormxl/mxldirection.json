{"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection","interfaceLanguage":"swift"},"relationshipsSections":[{"title":"Conforms To","kind":"relationships","type":"conformsTo","identifiers":["doc:\/\/IvorMXL\/s8CopyableP","doc:\/\/IvorMXL\/SQ","doc:\/\/IvorMXL\/s9EscapableP","doc:\/\/IvorMXL\/SH","doc:\/\/IvorMXL\/s8SendableP","doc:\/\/IvorMXL\/s16SendableMetatypeP"]}],"seeAlsoSections":[{"title":"Music","generated":true,"anchor":"Music","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMusicItem","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFullNote","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRest","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPitch","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound"]}],"variants":[{"paths":["\/documentation\/ivormxl\/mxldirection"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","metadata":{"title":"MXLDirection","role":"symbol","externalID":"s:7IvorMXL12MXLDirectionV","roleHeading":"Structure","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLDirection"}],"navigatorTitle":[{"text":"MXLDirection","kind":"identifier"}],"modules":[{"name":"IvorMXL"}],"symbolKind":"struct"},"topicSections":[{"title":"Structures","generated":true,"anchor":"Structures","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/Kind-swift.struct"]},{"title":"Initializers","generated":true,"anchor":"Initializers","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/init(id:kind:offset:footnote:level:voice:staff:sound:listening:placement:isDirective:system:)"]},{"title":"Instance Properties","generated":true,"anchor":"Instance-Properties","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/footnote","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/id","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/isDirective","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/kind-swift.property","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/level","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/listening","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/offset","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/placement","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/sound","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/staff","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/system","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/voice"]},{"title":"Default Implementations","generated":true,"anchor":"Default-Implementations","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/Equatable-Implementations"]}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLDirection"}]}]},{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"By default, a series of direction-type elements and a series of child elements of a direction-type within a","type":"text"},{"text":" ","type":"text"},{"text":"single direction element follow one another in sequence visually. For a series of direction-type children,","type":"text"},{"text":" ","type":"text"},{"text":"non-positional formatting attributes are carried over from the previous element by default.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Maps the MusicXML ","type":"text"},{"code":"<direction>","type":"codeVoice"},{"text":" element.","type":"text"}]}],"kind":"content"}],"abstract":[{"text":"A direction is a musical indication that is not necessarily attached to a specific note. Two or more may be","type":"text"},{"text":" ","type":"text"},{"text":"combined to indicate words followed by the start of a dashed line, the end of a wedge followed by dynamics,","type":"text"},{"text":" ","type":"text"},{"text":"etc. For applications where a specific direction is indeed attached to a specific note, the direction element","type":"text"},{"text":" ","type":"text"},{"text":"can be associated with the first note element that follows it in score order that is not in a different voice.","type":"text"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLSound":{"abstract":[{"type":"text","text":"The sound element contains general playback parameters. They can stand alone within a part\/measure, or be a"},{"type":"text","text":" "},{"type":"text","text":"component element within a direction."}],"title":"MXLSound","url":"\/documentation\/ivormxl\/mxlsound","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSound","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"MXLSound","kind":"identifier"}],"type":"topic","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection/offset":{"title":"offset","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/offset","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"offset","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLOffset","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLOffsetV"},{"text":"?","kind":"text"}],"kind":"symbol","abstract":[{"text":"Indicates where the direction will appear relative to the current musical location, in divisions.","type":"text"}],"role":"symbol","url":"\/documentation\/ivormxl\/mxldirection\/offset"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection":{"role":"symbol","url":"\/documentation\/ivormxl\/mxldirection","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLDirection","kind":"identifier"}],"navigatorTitle":[{"text":"MXLDirection","kind":"identifier"}],"abstract":[{"text":"A direction is a musical indication that is not necessarily attached to a specific note. Two or more may be","type":"text"},{"text":" ","type":"text"},{"text":"combined to indicate words followed by the start of a dashed line, the end of a wedge followed by dynamics,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"etc. For applications where a specific direction is indeed attached to a specific note, the direction element"},{"text":" ","type":"text"},{"type":"text","text":"can be associated with the first note element that follows it in score order that is not in a different voice."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection","title":"MXLDirection","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLBarline"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLBarline"}],"title":"MXLBarline","abstract":[{"type":"text","text":"If a barline is other than a normal single barline, it should be represented by a barline type that describes"},{"type":"text","text":" "},{"type":"text","text":"it. This includes information about repeats and multiple endings, as well as line style. Barline data is on"},{"type":"text","text":" "},{"type":"text","text":"the same level as the other musical data in a score — a child of a measure in a partwise score, or a part in a"},{"type":"text","text":" "},{"type":"text","text":"timewise score. This allows for barlines within measures, as in dotted barlines that subdivide measures in"},{"type":"text","text":" "},{"type":"text","text":"complex meters. The two fermata elements allow for fermatas on both sides of the barline (the lower one"},{"type":"text","text":" "},{"type":"text","text":"inverted)."}],"url":"\/documentation\/ivormxl\/mxlbarline"},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlnote","title":"MXLNote","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNote","kind":"identifier"}],"navigatorTitle":[{"text":"MXLNote","kind":"identifier"}],"abstract":[{"type":"text","text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for"},{"type":"text","text":" "},{"type":"text","text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation)."},{"type":"text","text":" "},{"type":"text","text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,"},{"type":"text","text":" "},{"text":"but no tie elements. Having these two types of information available can make interchange easier, as some","type":"text"},{"type":"text","text":" "},{"type":"text","text":"programs handle one type of information more readily than the other."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection/isDirective":{"title":"isDirective","role":"symbol","kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isDirective","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"type":"topic","abstract":[{"text":"A Boolean value indicating whether this direction is a directive, changing its default horizontal position so","type":"text"},{"text":" ","type":"text"},{"text":"its left-hand side aligns with the left-hand side of the time signature (or, if no time signature is present,","type":"text"},{"text":" ","type":"text"},{"text":"the first music notational element in the measure). A default-x, justify, or halign attribute, if present,","type":"text"},{"text":" ","type":"text"},{"text":"overrides this.","type":"text"}],"url":"\/documentation\/ivormxl\/mxldirection\/isdirective","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/isDirective"},"doc://IvorMXL/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","type":"unresolvable","identifier":"doc:\/\/IvorMXL\/s16SendableMetatypeP"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection/footnote":{"title":"footnote","role":"symbol","kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"footnote","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL16MXLFormattedTextV","text":"MXLFormattedText","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"type":"topic","abstract":[{"text":"The footnote element specifies editorial information that appears in footnotes in the printed score. It is","type":"text"},{"text":" ","type":"text"},{"text":"defined within a group due to its multiple uses within the MusicXML schema.","type":"text"}],"url":"\/documentation\/ivormxl\/mxldirection\/footnote","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/footnote"},"doc://IvorMXL/documentation/IvorMXL/MXLFullNote":{"url":"\/documentation\/ivormxl\/mxlfullnote","role":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFullNote","abstract":[{"type":"text","text":"The full-note group is a sequence of the common note elements between cue\/grace notes and regular (full)"},{"type":"text","text":" "},{"type":"text","text":"notes: pitch, chord, and rest information, but not duration (cue and grace notes do not have duration"},{"type":"text","text":" "},{"type":"text","text":"encoded). Unpitched elements are used for unpitched percussion, speaking voice, and other musical elements"},{"type":"text","text":" "},{"type":"text","text":"lacking determinate pitch."}],"title":"MXLFullNote","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLFullNote","kind":"identifier"}],"navigatorTitle":[{"text":"MXLFullNote","kind":"identifier"}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/s9EscapableP":{"title":"Swift.Escapable","type":"unresolvable","identifier":"doc:\/\/IvorMXL\/s9EscapableP"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection/placement":{"title":"placement","role":"symbol","kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"placement","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL13MXLAboveBelowO","text":"MXLAboveBelow","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"type":"topic","abstract":[{"text":"The placement attribute indicates whether something is above or below another element, such as a note or a","type":"text"},{"text":" ","type":"text"},{"text":"notation.","type":"text"}],"url":"\/documentation\/ivormxl\/mxldirection\/placement","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/placement"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection/staff":{"title":"staff","role":"symbol","kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"staff","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL8MXLStaffV","text":"MXLStaff","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"type":"topic","abstract":[{"text":"The staff element is defined within a group due to its use by both notes and direction elements.","type":"text"}],"url":"\/documentation\/ivormxl\/mxldirection\/staff","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/staff"},"doc://IvorMXL/s8CopyableP":{"title":"Swift.Copyable","type":"unresolvable","identifier":"doc:\/\/IvorMXL\/s8CopyableP"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection/Kind-swift.struct":{"role":"symbol","url":"\/documentation\/ivormxl\/mxldirection\/kind-swift.struct","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Kind","kind":"identifier"}],"navigatorTitle":[{"text":"Kind","kind":"identifier"}],"abstract":[{"type":"text","text":"Textual direction types may have more than 1 component due to multiple fonts. The dynamics element may also be"},{"type":"text","text":" "},{"type":"text","text":"used in the notations element. Attribute groups related to print suggestions apply to the individual"},{"type":"text","text":" "},{"type":"text","text":"direction-type, not to the overall direction."}],"title":"MXLDirection.Kind","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/Kind-swift.struct","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection/system":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/system","url":"\/documentation\/ivormxl\/mxldirection\/system","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"system","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL17MXLSystemRelationO","text":"MXLSystemRelation","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"abstract":[{"type":"text","text":"The system-relation attribute group distinguishes elements that are associated with a system rather than the"},{"type":"text","text":" "},{"type":"text","text":"particular part where the element appears."}],"title":"system","type":"topic","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection/listening":{"abstract":[{"text":"Specifies how a score-following or machine-listening application should interact with a performer, from this","type":"text"},{"text":" ","type":"text"},{"text":"point in the performance onward.","type":"text"}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"listening","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL12MXLListeningV","text":"MXLListening","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"title":"listening","url":"\/documentation\/ivormxl\/mxldirection\/listening","kind":"symbol","type":"topic","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/listening"},"doc://IvorMXL/documentation/IvorMXL/MXLMusicItem":{"navigatorTitle":[{"text":"MXLMusicItem","kind":"identifier"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLMusicItem","kind":"identifier"}],"abstract":[{"type":"text","text":"One of the alternatives for a music item."}],"role":"symbol","url":"\/documentation\/ivormxl\/mxlmusicitem","type":"topic","title":"MXLMusicItem","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMusicItem","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection/level":{"abstract":[{"type":"text","text":"The level element specifies editorial information for different MusicXML elements. It is defined within a"},{"type":"text","text":" "},{"type":"text","text":"group due to its multiple uses within the MusicXML schema."}],"url":"\/documentation\/ivormxl\/mxldirection\/level","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/level","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"level"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLLevelV","text":"MXLLevel"},{"kind":"text","text":"?"}],"title":"level","type":"topic","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection/init(id:kind:offset:footnote:level:voice:staff:sound:listening:placement:isDirective:system:)":{"abstract":[{"text":"Creates a new ","type":"text"},{"type":"codeVoice","code":"MXLDirection"},{"text":".","type":"text"}],"type":"topic","title":"init(id:kind:offset:footnote:level:voice:staff:sound:listening:placement:isDirective:system:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"kind","kind":"externalParam"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:7IvorMXL12MXLDirectionV4KindV","text":"Kind","kind":"typeIdentifier"},{"text":"], ","kind":"text"},{"text":"offset","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL9MXLOffsetV","text":"MXLOffset","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"footnote","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL16MXLFormattedTextV","text":"MXLFormattedText","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"level","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL8MXLLevelV","text":"MXLLevel","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"voice","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL8MXLVoiceV","text":"MXLVoice","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"staff","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL8MXLStaffV","text":"MXLStaff","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"sound","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL8MXLSoundV","text":"MXLSound","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"listening","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL12MXLListeningV","text":"MXLListening","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"placement","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL13MXLAboveBelowO","text":"MXLAboveBelow","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"isDirective","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"system","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL17MXLSystemRelationO","text":"MXLSystemRelation","kind":"typeIdentifier"},{"text":"?)","kind":"text"}],"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxldirection\/init(id:kind:offset:footnote:level:voice:staff:sound:listening:placement:isdirective:system:)","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/init(id:kind:offset:footnote:level:voice:staff:sound:listening:placement:isDirective:system:)"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection/sound":{"title":"sound","role":"symbol","kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sound","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL8MXLSoundV","text":"MXLSound","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"type":"topic","abstract":[{"text":"General playback parameters associated with this direction.","type":"text"}],"url":"\/documentation\/ivormxl\/mxldirection\/sound","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/sound"},"doc://IvorMXL/documentation/IvorMXL/MXLPitch":{"navigatorTitle":[{"text":"MXLPitch","kind":"identifier"}],"title":"MXLPitch","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPitch","type":"topic","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPitch","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlpitch","abstract":[{"text":"Pitch is represented as a combination of the step of the diatonic scale, the chromatic alteration, and the","type":"text"},{"text":" ","type":"text"},{"text":"octave.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLRest":{"url":"\/documentation\/ivormxl\/mxlrest","role":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRest","abstract":[{"type":"text","text":"The rest element indicates notated rests or silences. Rest elements are usually empty, but placement on the"},{"type":"text","text":" "},{"type":"text","text":"staff can be specified using display-step and display-octave elements. If the measure attribute is set to yes,"},{"type":"text","text":" "},{"type":"text","text":"this indicates this is a complete measure rest."}],"title":"MXLRest","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLRest","kind":"identifier"}],"navigatorTitle":[{"text":"MXLRest","kind":"identifier"}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection/id":{"abstract":[{"text":"The optional-unique-id attribute group allows an element to optionally specify an ID that is unique to the","type":"text"},{"text":" ","type":"text"},{"text":"entire document. This attribute group is not used for a required id attribute, or for an id attribute that","type":"text"},{"text":" ","type":"text"},{"text":"specifies an id reference.","type":"text"}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"id","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"title":"id","url":"\/documentation\/ivormxl\/mxldirection\/id","kind":"symbol","type":"topic","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/id"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes":{"title":"MXLAttributes","url":"\/documentation\/ivormxl\/mxlattributes","abstract":[{"type":"text","text":"The attributes element contains musical information that typically changes on measure boundaries. This"},{"type":"text","text":" "},{"type":"text","text":"includes key and time signatures, clefs, transpositions, and staving. When attributes are changed mid-measure,"},{"type":"text","text":" "},{"type":"text","text":"it affects the music in score order, not in MusicXML document order."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLAttributes","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"MXLAttributes","kind":"identifier"}],"type":"topic","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection/voice":{"abstract":[{"text":"A voice is a sequence of musical events (e.g. notes, chords, rests) that proceeds linearly in time. The voice","type":"text"},{"text":" ","type":"text"},{"text":"element is used to distinguish between multiple voices in individual parts. It is defined within a group due","type":"text"},{"text":" ","type":"text"},{"text":"to its multiple uses within the MusicXML schema.","type":"text"}],"title":"voice","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/voice","url":"\/documentation\/ivormxl\/mxldirection\/voice","kind":"symbol","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"voice"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLVoiceV","text":"MXLVoice"},{"kind":"text","text":"?"}]},"doc://IvorMXL/SQ":{"title":"Swift.Equatable","type":"unresolvable","identifier":"doc:\/\/IvorMXL\/SQ"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection/Equatable-Implementations":{"abstract":[],"kind":"article","type":"topic","role":"collectionGroup","title":"Equatable Implementations","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/Equatable-Implementations","url":"\/documentation\/ivormxl\/mxldirection\/equatable-implementations"},"doc://IvorMXL/SH":{"title":"Swift.Hashable","type":"unresolvable","identifier":"doc:\/\/IvorMXL\/SH"},"doc://IvorMXL/s8SendableP":{"title":"Swift.Sendable","type":"unresolvable","identifier":"doc:\/\/IvorMXL\/s8SendableP"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection/kind-swift.property":{"type":"topic","title":"kind","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/kind-swift.property","abstract":[{"type":"text","text":"The direction-type elements that make up this direction."}],"url":"\/documentation\/ivormxl\/mxldirection\/kind-swift.property","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"kind"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"Kind","preciseIdentifier":"s:7IvorMXL12MXLDirectionV4KindV"},{"kind":"text","text":"]"}],"kind":"symbol"}}}