fier","text":"MXLSound","preciseIdentifier":"s:7IvorMXL8MXLSoundV"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"listening"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLListening","preciseIdentifier":"s:7IvorMXL12MXLListeningV"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"placement"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLAboveBelow","preciseIdentifier":"s:7IvorMXL13MXLAboveBelowO"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"isDirective"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"system"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLSystemRelation","preciseIdentifier":"s:7IvorMXL17MXLSystemRelationO"},{"kind":"text","text":"?)"}],"role":"symbol"}}}