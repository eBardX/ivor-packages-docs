ype":"text"},{"code":"other-notation","type":"codeVoice"},{"text":" alternative.","type":"text"}],"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"otherNotation","kind":"identifier"},{"text":"(","kind":"text"},{"text":"MXLOtherNotation","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL16MXLOtherNotationV"},{"text":")","kind":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLNotations":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNotations"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLNotations"}],"abstract":[{"text":"Notations refer to musical notations, not XML notations. Multiple notations are allowed in order to represent","type":"text"},{"text":" ","type":"text"},{"text":"multiple editorial levels. The print-object attribute, added in Version 3.0, allows notations to represent","type":"text"},{"text":" ","type":"text"},{"text":"details of performance technique, such as fingerings, without having them appear in the score.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlnotations","title":"MXLNotations","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNotations","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNotations/Item":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Item"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"Item"}],"url":"\/documentation\/ivormxl\/mxlnotations\/item","abstract":[{"text":"One of the alternatives for Notations.","type":"text"}],"title":"MXLNotations.Item","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNotations\/Item","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLOtherNotation":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlothernotation","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOtherNotation","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLOtherNotation","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"The other-notation type is used to define any notations not yet in the MusicXML format. It handles notations","type":"text"},{"text":" ","type":"text"},{"text":"where more specific extension elements such as other-dynamics and other-technical are not appropriate. The","type":"text"},{"text":" ","type":"text"},{"text":"smufl attribute can be used to specify a particular notation, allowing application interoperability without","type":"text"},{"text":" ","type":"text"},{"text":"requiring every SMuFL glyph to have a MusicXML element equivalent. Using the other-notation type without the","type":"text"},{"text":" ","type":"text"},{"text":"smufl attribute allows for extended representation, though without application interoperability.","type":"text"}],"type":"topic","navigatorTitle":[{"text":"MXLOtherNotation","kind":"identifier"}],"title":"MXLOtherNotation"}}}