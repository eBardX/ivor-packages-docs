"Item","kind":"identifier"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Item","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLOtherNotation":{"fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"kind":"identifier","text":"MXLOtherNotation"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOtherNotation","title":"MXLOtherNotation","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLOtherNotation"}],"abstract":[{"type":"text","text":"The other-notation type is used to define any notations not yet in the MusicXML format. It handles notations"},{"type":"text","text":" "},{"text":"where more specific extension elements such as other-dynamics and other-technical are not appropriate. The","type":"text"},{"type":"text","text":" "},{"text":"smufl attribute can be used to specify a particular notation, allowing application interoperability without","type":"text"},{"text":" ","type":"text"},{"text":"requiring every SMuFL glyph to have a MusicXML element equivalent. Using the other-notation type without the","type":"text"},{"text":" ","type":"text"},{"text":"smufl attribute allows for extended representation, though without application interoperability.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlothernotation"},"doc://IvorMXL/documentation/IvorMXL/MXLNotations/Item/otherNotation(_:)":{"type":"topic","kind":"symbol","abstract":[{"text":"The ","type":"text"},{"code":"other-notation","type":"codeVoice"},{"text":" alternative.","type":"text"}],"role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNotations\/Item\/otherNotation(_:)","title":"MXLNotations.Item.otherNotation(_:)","url":"\/documentation\/ivormxl\/mxlnotations\/item\/othernotation(_:)","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"otherNotation","kind":"identifier"},{"text":"(","kind":"text"},{"text":"MXLOtherNotation","preciseIdentifier":"s:7IvorMXL16MXLOtherNotationV","kind":"typeIdentifier"},{"text":")","kind":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLNotations":{"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlnotations","abstract":[{"type":"text","text":"Notations refer to musical notations, not XML notations. Multiple notations are allowed in order to represent"},{"type":"text","text":" "},{"type":"text","text":"multiple editorial levels. The print-object attribute, added in Version 3.0, allows notations to represent"},{"type":"text","text":" "},{"type":"text","text":"details of performance technique, such as fingerings, without having them appear in the score."}],"navigatorTitle":[{"kind":"identifier","text":"MXLNotations"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNotations"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNotations","title":"MXLNotations"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"}}}