notations not yet in the MusicXML format. It handles notations","type":"text"},{"text":" ","type":"text"},{"text":"where more specific extension elements such as other-dynamics and other-technical are not appropriate. The","type":"text"},{"type":"text","text":" "},{"type":"text","text":"smufl attribute can be used to specify a particular notation, allowing application interoperability without"},{"type":"text","text":" "},{"type":"text","text":"requiring every SMuFL glyph to have a MusicXML element equivalent. Using the other-notation type without the"},{"type":"text","text":" "},{"type":"text","text":"smufl attribute allows for extended representation, though without application interoperability."}],"navigatorTitle":[{"text":"MXLOtherNotation","kind":"identifier"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlothernotation"},"doc://IvorMXL/documentation/IvorMXL/MXLNotations/Item":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNotations\/Item","title":"MXLNotations.Item","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"text":"Item","kind":"identifier"}],"abstract":[{"type":"text","text":"One of the alternatives for Notations."}],"url":"\/documentation\/ivormxl\/mxlnotations\/item","kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Item"}]},"doc://IvorMXL/documentation/IvorMXL/MXLNotations":{"url":"\/documentation\/ivormxl\/mxlnotations","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNotations","role":"symbol","navigatorTitle":[{"text":"MXLNotations","kind":"identifier"}],"title":"MXLNotations","abstract":[{"type":"text","text":"Notations refer to musical notations, not XML notations. Multiple notations are allowed in order to represent"},{"type":"text","text":" "},{"text":"multiple editorial levels. The print-object attribute, added in Version 3.0, allows notations to represent","type":"text"},{"text":" ","type":"text"},{"text":"details of performance technique, such as fingerings, without having them appear in the score.","type":"text"}],"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"MXLNotations","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLNotations/Item/otherNotation(_:)":{"url":"\/documentation\/ivormxl\/mxlnotations\/item\/othernotation(_:)","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"otherNotation"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"MXLOtherNotation","preciseIdentifier":"s:7IvorMXL16MXLOtherNotationV"},{"kind":"text","text":")"}],"type":"topic","title":"MXLNotations.Item.otherNotation(_:)","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNotations\/Item\/otherNotation(_:)","kind":"symbol","abstract":[{"type":"text","text":"The "},{"code":"other-notation","type":"codeVoice"},{"type":"text","text":" alternative."}]}}}