XL\/documentation\/IvorMXL\/MXLNotations\/Item\/otherNotation(_:)","type":"topic","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"otherNotation"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL16MXLOtherNotationV","text":"MXLOtherNotation"},{"kind":"text","text":")"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLOtherNotation":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOtherNotation","title":"MXLOtherNotation","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLOtherNotation","kind":"identifier"}],"navigatorTitle":[{"text":"MXLOtherNotation","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlothernotation","abstract":[{"text":"The other-notation type is used to define any notations not yet in the MusicXML format. It handles notations","type":"text"},{"text":" ","type":"text"},{"text":"where more specific extension elements such as other-dynamics and other-technical are not appropriate. The","type":"text"},{"text":" ","type":"text"},{"text":"smufl attribute can be used to specify a particular notation, allowing application interoperability without","type":"text"},{"text":" ","type":"text"},{"text":"requiring every SMuFL glyph to have a MusicXML element equivalent. Using the other-notation type without the","type":"text"},{"text":" ","type":"text"},{"text":"smufl attribute allows for extended representation, though without application interoperability.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLNotations":{"navigatorTitle":[{"text":"MXLNotations","kind":"identifier"}],"abstract":[{"text":"Notations refer to musical notations, not XML notations. Multiple notations are allowed in order to represent","type":"text"},{"text":" ","type":"text"},{"text":"multiple editorial levels. The print-object attribute, added in Version 3.0, allows notations to represent","type":"text"},{"text":" ","type":"text"},{"text":"details of performance technique, such as fingerings, without having them appear in the score.","type":"text"}],"title":"MXLNotations","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNotations","kind":"symbol","url":"\/documentation\/ivormxl\/mxlnotations","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNotations","kind":"identifier"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLNotations/Item":{"navigatorTitle":[{"text":"Item","kind":"identifier"}],"abstract":[{"text":"One of the alternatives for Notations.","type":"text"}],"title":"MXLNotations.Item","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNotations\/Item","kind":"symbol","url":"\/documentation\/ivormxl\/mxlnotations\/item","type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Item","kind":"identifier"}],"role":"symbol"}}}