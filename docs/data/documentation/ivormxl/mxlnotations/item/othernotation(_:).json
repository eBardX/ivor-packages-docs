","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNotations\/Item","navigatorTitle":[{"kind":"identifier","text":"Item"}],"url":"\/documentation\/ivormxl\/mxlnotations\/item","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Item"}],"title":"MXLNotations.Item","abstract":[{"text":"One of the alternatives for Notations.","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLNotations":{"type":"topic","title":"MXLNotations","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNotations","abstract":[{"text":"Notations refer to musical notations, not XML notations. Multiple notations are allowed in order to represent","type":"text"},{"text":" ","type":"text"},{"text":"multiple editorial levels. The print-object attribute, added in Version 3.0, allows notations to represent","type":"text"},{"text":" ","type":"text"},{"text":"details of performance technique, such as fingerings, without having them appear in the score.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNotations"}],"navigatorTitle":[{"kind":"identifier","text":"MXLNotations"}],"url":"\/documentation\/ivormxl\/mxlnotations"},"doc://IvorMXL/documentation/IvorMXL/MXLNotations/Item/otherNotation(_:)":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNotations\/Item\/otherNotation(_:)","url":"\/documentation\/ivormxl\/mxlnotations\/item\/othernotation(_:)","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"otherNotation"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL16MXLOtherNotationV","text":"MXLOtherNotation"},{"kind":"text","text":")"}],"title":"MXLNotations.Item.otherNotation(_:)","abstract":[{"type":"text","text":"The "},{"type":"codeVoice","code":"other-notation"},{"type":"text","text":" alternative."}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLOtherNotation":{"type":"topic","abstract":[{"type":"text","text":"The other-notation type is used to define any notations not yet in the MusicXML format. It handles notations"},{"type":"text","text":" "},{"type":"text","text":"where more specific extension elements such as other-dynamics and other-technical are not appropriate. The"},{"type":"text","text":" "},{"type":"text","text":"smufl attribute can be used to specify a particular notation, allowing application interoperability without"},{"type":"text","text":" "},{"type":"text","text":"requiring every SMuFL glyph to have a MusicXML element equivalent. Using the other-notation type without the"},{"type":"text","text":" "},{"type":"text","text":"smufl attribute allows for extended representation, though without application interoperability."}],"url":"\/documentation\/ivormxl\/mxlothernotation","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLOtherNotation","kind":"identifier"}],"kind":"symbol","title":"MXLOtherNotation","navigatorTitle":[{"text":"MXLOtherNotation","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOtherNotation","role":"symbol"}}}