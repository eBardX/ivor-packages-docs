"type":"topic","abstract":[{"text":"One of the alternatives for Notations.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlnotations\/item","role":"symbol","kind":"symbol","title":"MXLNotations.Item","navigatorTitle":[{"text":"Item","kind":"identifier"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Item","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLDynamics":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLDynamics"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLDynamics"}],"url":"\/documentation\/ivormxl\/mxldynamics","role":"symbol","title":"MXLDynamics","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDynamics","type":"topic","abstract":[{"type":"text","text":"Dynamics can be associated either with a note or a general musical direction. To avoid inconsistencies between"},{"type":"text","text":" "},{"type":"text","text":"and among the letter abbreviations for dynamics (what is sf vs. sfz, standing alone or with a trailing"},{"type":"text","text":" "},{"type":"text","text":"dynamic that is not always piano), we use the actual letters as the names of these dynamic elements. The"},{"type":"text","text":" "},{"type":"text","text":"other-dynamics element allows other dynamic marks that are not covered here. Dynamics elements may also be"},{"type":"text","text":" "},{"type":"text","text":"combined to create marks not covered by a single element, such as sfmp."}]},"doc://IvorMXL/documentation/IvorMXL/MXLNotations":{"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlnotations","abstract":[{"type":"text","text":"Notations refer to musical notations, not XML notations. Multiple notations are allowed in order to represent"},{"type":"text","text":" "},{"type":"text","text":"multiple editorial levels. The print-object attribute, added in Version 3.0, allows notations to represent"},{"type":"text","text":" "},{"type":"text","text":"details of performance technique, such as fingerings, without having them appear in the score."}],"navigatorTitle":[{"kind":"identifier","text":"MXLNotations"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNotations"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNotations","title":"MXLNotations"},"doc://IvorMXL/documentation/IvorMXL/MXLNotations/Item/dynamics(_:)":{"kind":"symbol","url":"\/documentation\/ivormxl\/mxlnotations\/item\/dynamics(_:)","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNotations\/Item\/dynamics(_:)","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"dynamics"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"MXLDynamics","preciseIdentifier":"s:7IvorMXL11MXLDynamicsV"},{"kind":"text","text":")"}],"type":"topic","role":"symbol","abstract":[{"text":"The ","type":"text"},{"code":"dynamics","type":"codeVoice"},{"text":" alternative.","type":"text"}],"title":"MXLNotations.Item.dynamics(_:)"}}}