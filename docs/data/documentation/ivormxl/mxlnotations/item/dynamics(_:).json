er-dynamics element allows other dynamic marks that are not covered here. Dynamics elements may also be","type":"text"},{"text":" ","type":"text"},{"text":"combined to create marks not covered by a single element, such as sfmp.","type":"text"}],"navigatorTitle":[{"text":"MXLDynamics","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDynamics","type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLNotations/Item/dynamics(_:)":{"kind":"symbol","abstract":[{"type":"text","text":"The "},{"type":"codeVoice","code":"dynamics"},{"text":" alternative.","type":"text"}],"title":"MXLNotations.Item.dynamics(_:)","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNotations\/Item\/dynamics(_:)","role":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxlnotations\/item\/dynamics(_:)","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"dynamics"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLDynamicsV","text":"MXLDynamics"},{"kind":"text","text":")"}]}}}