ments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"dynamics"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLDynamicsV","text":"MXLDynamics"},{"kind":"text","text":")"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLDynamics":{"abstract":[{"text":"Dynamics can be associated either with a note or a general musical direction. To avoid inconsistencies between","type":"text"},{"text":" ","type":"text"},{"text":"and among the letter abbreviations for dynamics (what is sf vs. sfz, standing alone or with a trailing","type":"text"},{"text":" ","type":"text"},{"text":"dynamic that is not always piano), we use the actual letters as the names of these dynamic elements. The","type":"text"},{"text":" ","type":"text"},{"text":"other-dynamics element allows other dynamic marks that are not covered here. Dynamics elements may also be","type":"text"},{"text":" ","type":"text"},{"text":"combined to create marks not covered by a single element, such as sfmp.","type":"text"}],"title":"MXLDynamics","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLDynamics","kind":"identifier"}],"navigatorTitle":[{"text":"MXLDynamics","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxldynamics","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDynamics"},"doc://IvorMXL/documentation/IvorMXL/MXLNotations/Item":{"navigatorTitle":[{"text":"Item","kind":"identifier"}],"abstract":[{"text":"One of the alternatives for Notations.","type":"text"}],"title":"MXLNotations.Item","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNotations\/Item","kind":"symbol","url":"\/documentation\/ivormxl\/mxlnotations\/item","type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Item","kind":"identifier"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNotations":{"navigatorTitle":[{"text":"MXLNotations","kind":"identifier"}],"abstract":[{"text":"Notations refer to musical notations, not XML notations. Multiple notations are allowed in order to represent","type":"text"},{"text":" ","type":"text"},{"text":"multiple editorial levels. The print-object attribute, added in Version 3.0, allows notations to represent","type":"text"},{"text":" ","type":"text"},{"text":"details of performance technique, such as fingerings, without having them appear in the score.","type":"text"}],"title":"MXLNotations","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNotations","kind":"symbol","url":"\/documentation\/ivormxl\/mxlnotations","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNotations","kind":"identifier"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"}}}