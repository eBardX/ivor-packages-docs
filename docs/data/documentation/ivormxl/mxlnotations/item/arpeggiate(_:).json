{"variants":[{"paths":["\/documentation\/ivormxl\/mxlnotations\/item\/arpeggiate(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNotations\/Item\/arpeggiate(_:)"},"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNotations","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNotations\/Item"]]},"abstract":[{"text":"The ","type":"text"},{"code":"arpeggiate","type":"codeVoice"},{"text":" alternative.","type":"text"}],"metadata":{"role":"symbol","externalID":"s:7IvorMXL12MXLNotationsV4ItemO10arpeggiateyAeA13MXLArpeggiateVcAEmF","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"arpeggiate","kind":"identifier"},{"text":"(","kind":"text"},{"text":"MXLArpeggiate","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL13MXLArpeggiateV"},{"text":")","kind":"text"}],"symbolKind":"case","title":"MXLNotations.Item.arpeggiate(_:)","roleHeading":"Case","modules":[{"name":"IvorMXL"}]},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"arpeggiate","kind":"identifier"},{"text":"(","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArpeggiate","text":"MXLArpeggiate","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL13MXLArpeggiateV"},{"text":")","kind":"text"}],"platforms":["macOS"]}],"kind":"declarations"}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLArpeggiate":{"type":"topic","title":"MXLArpeggiate","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLArpeggiate","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlarpeggiate","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArpeggiate","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"MXLArpeggiate","kind":"identifier"}],"abstract":[{"type":"text","text":"The arpeggiate type indicates that this note is part of an arpeggiated chord. The number attribute can be used"},{"type":"text","text":" "},{"type":"text","text":"to distinguish between two simultaneous chords arpeggiated separately (different numbers) or together (same"},{"type":"text","text":" "},{"type":"text","text":"number). The direction attribute is used if there is an arrow on the arpeggio sign. By default, arpeggios go"},{"type":"text","text":" "},{"type":"text","text":"from the lowest to highest note. The length of the sign can be determined from the position attributes for the"},{"type":"text","text":" "},{"type":"text","text":"arpeggiate elements used with the top and bottom notes of the arpeggiated chord. If the unbroken attribute is"},{"type":"text","text":" "},{"type":"text","text":"set to yes, it indicates that the arpeggio continues onto another staff within the part. This serves as a hint"},{"type":"text","text":" "},{"type":"text","text":"to applications and is not required for cross-staff arpeggios."}]},"doc://IvorMXL/documentation/IvorMXL/MXLNotations/Item/arpeggiate(_:)":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNotations\/Item\/arpeggiate(_:)","kind":"symbol","title":"MXLNotations.Item.arpeggiate(_:)","url":"\/documentation\/ivormxl\/mxlnotations\/item\/arpeggiate(_:)","type":"topic","role":"symbol","abstract":[{"text":"The ","type":"text"},{"code":"arpeggiate","type":"codeVoice"},{"text":" alternative.","type":"text"}],"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"arpeggiate","kind":"identifier"},{"text":"(","kind":"text"},{"text":"MXLArpeggiate","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL13MXLArpeggiateV"},{"text":")","kind":"text"}]},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLNotations":{"url":"\/documentation\/ivormxl\/mxlnotations","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNotations","role":"symbol","navigatorTitle":[{"text":"MXLNotations","kind":"identifier"}],"title":"MXLNotations","abstract":[{"type":"text","text":"Notations refer to musical notations, not XML notations. Multiple notations are allowed in order to represent"},{"type":"text","text":" "},{"text":"multiple editorial levels. The print-object attribute, added in Version 3.0, allows notations to represent","type":"text"},{"text":" ","type":"text"},{"text":"details of performance technique, such as fingerings, without having them appear in the score.","type":"text"}],"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"MXLNotations","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLNotations/Item":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNotations\/Item","title":"MXLNotations.Item","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"text":"Item","kind":"identifier"}],"abstract":[{"type":"text","text":"One of the alternatives for Notations."}],"url":"\/documentation\/ivormxl\/mxlnotations\/item","kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Item"}]}}}