 attribute group gathers together attributes for determining the font within a credit or direction.","type":"text"},{"text":" ","type":"text"},{"text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric"},{"type":"text","text":" "},{"type":"text","text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font"},{"type":"text","text":" "},{"type":"text","text":"vs. a music font."}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLFont","kind":"identifier"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLFont/Size-swift.enum":{"type":"topic","title":"MXLFont.Size","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Size"}],"url":"\/documentation\/ivormxl\/mxlfont\/size-swift.enum","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont\/Size-swift.enum","role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Size"}],"abstract":[{"type":"text","text":"The font-size can be one of the CSS font sizes (xx-small, x-small, small, medium, large, x-large, xx-large) or"},{"type":"text","text":" "},{"type":"text","text":"a numeric point size."}]},"doc://IvorMXL/documentation/IvorMXL/MXLFont/Family-swift.typealias":{"type":"topic","title":"MXLFont.Family","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"Family"}],"url":"\/documentation\/ivormxl\/mxlfont\/family-swift.typealias","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont\/Family-swift.typealias","role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Family"}],"abstract":[{"type":"text","text":"The font-family is a list of font names. These can be specific font styles such as Maestro or Opus, or one of"},{"type":"text","text":" "},{"type":"text","text":"several generic font styles: music, engraved, handwritten, text, serif, sans-serif, handwritten, cursive,"},{"type":"text","text":" "},{"type":"text","text":"fantasy, and monospace. The music, engraved, and handwritten values refer to music fonts; the rest refer to"},{"type":"text","text":" "},{"type":"text","text":"text fonts. The fantasy style refers to decorative text such as found in older German-style printing."}]},"doc://IvorMXL/documentation/IvorMXL/MXLFont/Style-swift.enum":{"type":"topic","title":"MXLFont.Style","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Style","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlfont\/style-swift.enum","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont\/Style-swift.enum","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"Style","kind":"identifier"}],"abstract":[{"text":"The font-style type represents a simplified version of the CSS font-style property.","type":"text"}]}}}