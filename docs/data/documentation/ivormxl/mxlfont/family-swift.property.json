"preciseIdentifier":"s:7IvorMXL7MXLFontV6Familya","kind":"typeIdentifier","text":"Family"},{"kind":"text","text":"?"}],"role":"symbol","kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxlfont\/family-swift.property","abstract":[{"type":"text","text":"A comma-separated list of font names."}],"title":"family"},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLFont/Family-swift.typealias":{"url":"\/documentation\/ivormxl\/mxlfont\/family-swift.typealias","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont\/Family-swift.typealias","navigatorTitle":[{"kind":"identifier","text":"Family"}],"fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"Family"}],"title":"MXLFont.Family","abstract":[{"type":"text","text":"The font-family is a list of font names. These can be specific font styles such as Maestro or Opus, or one of"},{"type":"text","text":" "},{"type":"text","text":"several generic font styles: music, engraved, handwritten, text, serif, sans-serif, handwritten, cursive,"},{"type":"text","text":" "},{"type":"text","text":"fantasy, and monospace. The music, engraved, and handwritten values refer to music fonts; the rest refer to"},{"type":"text","text":" "},{"type":"text","text":"text fonts. The fantasy style refers to decorative text such as found in older German-style printing."}],"type":"topic","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLFont":{"navigatorTitle":[{"text":"MXLFont","kind":"identifier"}],"abstract":[{"text":"The font attribute group gathers together attributes for determining the font within a credit or direction.","type":"text"},{"text":" ","type":"text"},{"text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of","type":"text"},{"text":" ","type":"text"},{"text":"font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric","type":"text"},{"text":" ","type":"text"},{"text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font","type":"text"},{"text":" ","type":"text"},{"text":"vs. a music font.","type":"text"}],"title":"MXLFont","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","kind":"symbol","url":"\/documentation\/ivormxl\/mxlfont","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLFont","kind":"identifier"}],"role":"symbol"}}}