{"sections":[],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"text":"family","kind":"identifier"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont\/Family-swift.typealias","preciseIdentifier":"s:7IvorMXL7MXLFontV6Familya","text":"Family","kind":"typeIdentifier"},{"kind":"text","text":"?"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"Maps to the MusicXML ","type":"text"},{"type":"codeVoice","code":"font-family"},{"text":" attribute.","type":"text"}]}]}],"metadata":{"symbolKind":"property","externalID":"s:7IvorMXL7MXLFontV6familySaySSGSgvp","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"family","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL7MXLFontV6Familya","text":"Family","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"role":"symbol","modules":[{"name":"IvorMXL"}],"title":"family","roleHeading":"Instance Property"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont\/family-swift.property"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlfont\/family-swift.property"]}],"kind":"symbol","abstract":[{"text":"A comma-separated list of font names.","type":"text"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLFont/family-swift.property":{"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont\/family-swift.property","url":"\/documentation\/ivormxl\/mxlfont\/family-swift.property","kind":"symbol","abstract":[{"type":"text","text":"A comma-separated list of font names."}],"role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"family"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL7MXLFontV6Familya","text":"Family"},{"kind":"text","text":"?"}],"title":"family"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLFont":{"type":"topic","title":"MXLFont","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","abstract":[{"type":"text","text":"The font attribute group gathers together attributes for determining the font within a credit or direction."},{"type":"text","text":" "},{"type":"text","text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of"},{"type":"text","text":" "},{"type":"text","text":"font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric"},{"type":"text","text":" "},{"type":"text","text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font"},{"type":"text","text":" "},{"type":"text","text":"vs. a music font."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFont"}],"navigatorTitle":[{"kind":"identifier","text":"MXLFont"}],"url":"\/documentation\/ivormxl\/mxlfont"},"doc://IvorMXL/documentation/IvorMXL/MXLFont/Family-swift.typealias":{"title":"MXLFont.Family","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"Family"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlfont\/family-swift.typealias","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Family"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont\/Family-swift.typealias","abstract":[{"type":"text","text":"The font-family is a list of font names. These can be specific font styles such as Maestro or Opus, or one of"},{"type":"text","text":" "},{"type":"text","text":"several generic font styles: music, engraved, handwritten, text, serif, sans-serif, handwritten, cursive,"},{"type":"text","text":" "},{"type":"text","text":"fantasy, and monospace. The music, engraved, and handwritten values refer to music fonts; the rest refer to"},{"type":"text","text":" "},{"type":"text","text":"text fonts. The fantasy style refers to decorative text such as found in older German-style printing."}],"type":"topic"}}}