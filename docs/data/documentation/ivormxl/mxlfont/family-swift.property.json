r"},{"text":"?","kind":"text"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlfont\/family-swift.property","abstract":[{"type":"text","text":"A comma-separated list of font names."}],"title":"family","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont\/family-swift.property","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLFont/Family-swift.typealias":{"fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Family","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"Family","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlfont\/family-swift.typealias","abstract":[{"type":"text","text":"The font-family is a list of font names. These can be specific font styles such as Maestro or Opus, or one of"},{"type":"text","text":" "},{"type":"text","text":"several generic font styles: music, engraved, handwritten, text, serif, sans-serif, handwritten, cursive,"},{"type":"text","text":" "},{"type":"text","text":"fantasy, and monospace. The music, engraved, and handwritten values refer to music fonts; the rest refer to"},{"type":"text","text":" "},{"type":"text","text":"text fonts. The fantasy style refers to decorative text such as found in older German-style printing."}],"title":"MXLFont.Family","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont\/Family-swift.typealias","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLFont":{"title":"MXLFont","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFont"}],"abstract":[{"text":"The font attribute group gathers together attributes for determining the font within a credit or direction.","type":"text"},{"text":" ","type":"text"},{"text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of","type":"text"},{"text":" ","type":"text"},{"text":"font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric","type":"text"},{"text":" ","type":"text"},{"text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font","type":"text"},{"text":" ","type":"text"},{"text":"vs. a music font.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLFont"}],"url":"\/documentation\/ivormxl\/mxlfont"}}}