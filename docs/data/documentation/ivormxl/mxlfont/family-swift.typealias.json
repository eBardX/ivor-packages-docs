{"kind":"symbol","abstract":[{"type":"text","text":"The font-family is a list of font names. These can be specific font styles such as Maestro or Opus, or one of"},{"type":"text","text":" "},{"type":"text","text":"several generic font styles: music, engraved, handwritten, text, serif, sans-serif, handwritten, cursive,"},{"type":"text","text":" "},{"type":"text","text":"fantasy, and monospace. The music, engraved, and handwritten values refer to music fonts; the rest refer to"},{"type":"text","text":" "},{"type":"text","text":"text fonts. The fantasy style refers to decorative text such as found in older German-style printing."}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont"]]},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Family","kind":"identifier"},{"text":" = ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL21MXLCommaSeparatedTexta","text":"MXLCommaSeparatedText","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCommaSeparatedText","kind":"typeIdentifier"}],"platforms":["macOS"]}],"kind":"declarations"}],"variants":[{"paths":["\/documentation\/ivormxl\/mxlfont\/family-swift.typealias"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"modules":[{"name":"IvorMXL"}],"symbolKind":"typealias","role":"symbol","extendedModule":"IvorMXL","title":"MXLFont.Family","roleHeading":"Type Alias","navigatorTitle":[{"kind":"identifier","text":"Family"}],"fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"Family"}],"externalID":"s:7IvorMXL7MXLFontV6Familya"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont\/Family-swift.typealias"},"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLCommaSeparatedText":{"type":"topic","abstract":[{"type":"text","text":"The comma-separated-text type is used to specify a list of text elements, as is used by the font-family"},{"type":"text","text":" "},{"type":"text","text":"attribute."}],"url":"\/documentation\/ivormxl\/mxlcommaseparatedtext","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLCommaSeparatedText"}],"kind":"symbol","title":"MXLCommaSeparatedText","navigatorTitle":[{"kind":"identifier","text":"MXLCommaSeparatedText"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCommaSeparatedText","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLFont":{"type":"topic","title":"MXLFont","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","abstract":[{"type":"text","text":"The font attribute group gathers together attributes for determining the font within a credit or direction."},{"type":"text","text":" "},{"type":"text","text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of"},{"type":"text","text":" "},{"type":"text","text":"font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric"},{"type":"text","text":" "},{"type":"text","text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font"},{"type":"text","text":" "},{"type":"text","text":"vs. a music font."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFont"}],"navigatorTitle":[{"kind":"identifier","text":"MXLFont"}],"url":"\/documentation\/ivormxl\/mxlfont"},"doc://IvorMXL/documentation/IvorMXL/MXLFont/Family-swift.typealias":{"title":"MXLFont.Family","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"Family"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlfont\/family-swift.typealias","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Family"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont\/Family-swift.typealias","abstract":[{"type":"text","text":"The font-family is a list of font names. These can be specific font styles such as Maestro or Opus, or one of"},{"type":"text","text":" "},{"type":"text","text":"several generic font styles: music, engraved, handwritten, text, serif, sans-serif, handwritten, cursive,"},{"type":"text","text":" "},{"type":"text","text":"fantasy, and monospace. The music, engraved, and handwritten values refer to music fonts; the rest refer to"},{"type":"text","text":" "},{"type":"text","text":"text fonts. The fantasy style refers to decorative text such as found in older German-style printing."}],"type":"topic"}}}