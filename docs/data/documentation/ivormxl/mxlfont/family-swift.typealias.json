tle":[{"kind":"identifier","text":"MXLFont"}],"url":"\/documentation\/ivormxl\/mxlfont"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLCommaSeparatedText":{"type":"topic","title":"MXLCommaSeparatedText","navigatorTitle":[{"text":"MXLCommaSeparatedText","kind":"identifier"}],"fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLCommaSeparatedText","kind":"identifier"}],"abstract":[{"text":"The comma-separated-text type is used to specify a list of text elements, as is used by the font-family","type":"text"},{"text":" ","type":"text"},{"text":"attribute.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlcommaseparatedtext","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCommaSeparatedText","kind":"symbol","role":"symbol"}}}