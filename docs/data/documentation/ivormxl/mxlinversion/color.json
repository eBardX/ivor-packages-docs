ency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlcolor"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLInversion/color":{"kind":"symbol","title":"color","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"color"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL8MXLColorV","kind":"typeIdentifier","text":"MXLColor"},{"kind":"text","text":"?"}],"url":"\/documentation\/ivormxl\/mxlinversion\/color","type":"topic","abstract":[{"text":"The color attribute group indicates the color of an element.","type":"text"}],"role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLInversion\/color"},"doc://IvorMXL/documentation/IvorMXL/MXLInversion":{"role":"symbol","kind":"symbol","url":"\/documentation\/ivormxl\/mxlinversion","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLInversion","abstract":[{"type":"text","text":"The inversion type represents harmony inversions. The value is a number indicating which inversion is used: 0"},{"type":"text","text":" "},{"type":"text","text":"for root position, 1 for first inversion, etc. The text attribute indicates how the inversion should be"},{"type":"text","text":" "},{"type":"text","text":"displayed in a score."}],"type":"topic","title":"MXLInversion","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLInversion"}],"navigatorTitle":[{"kind":"identifier","text":"MXLInversion"}]}}}