xt":"?)","kind":"text"}],"modules":[{"name":"IvorMXL"}],"roleHeading":"Initializer","role":"symbol"},"kind":"symbol","identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHole\/init(kind:closed:shape:position:font:color:placement:)","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"init","kind":"keyword"},{"text":"(","kind":"text"},{"text":"kind","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"closed","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHole\/Closed-swift.struct","preciseIdentifier":"s:7IvorMXL7MXLHoleV6ClosedV","text":"Closed","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"shape","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"position","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","preciseIdentifier":"s:7IvorMXL11MXLPositionV","text":"MXLPosition","kind":"typeIdentifier"},{"text":" = MXLPosition(), ","kind":"text"},{"text":"font","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","preciseIdentifier":"s:7IvorMXL7MXLFontV","text":"MXLFont","kind":"typeIdentifier"},{"text":" = MXLFont(), ","kind":"text"},{"text":"color","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","preciseIdentifier":"s:7IvorMXL8MXLColorV","text":"MXLColor","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"placement","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAboveBelow","preciseIdentifier":"s:7IvorMXL13MXLAboveBelowO","text":"MXLAboveBelow","kind":"typeIdentifier"},{"text":"? = nil)","kind":"text"}]}]},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The content of the optional hole-type element indicates what the hole symbol represents in terms of instrument fingering or other techniques.","type":"text"}]}],"name":"kind"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Whether the hole is closed, open, or half-open.","type":"text"}]}],"name":"closed"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The optional hole-shape element indicates the shape of the hole symbol; the default is a circle.","type":"text"}]}],"name":"shape"},{"content":[{"type":"paragraph","inlineContent":[{"text":"For most elements, any program will compute a default x and y position. The position attributes let this be changed two ways.","type":"text"}]}],"name":"position"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The font attribute group gathers together attributes for determining the font within a credit or direction. They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font vs. a music font.","type":"text"}]}],"name":"font"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The color attribute group indicates the color of an element.","type":"text"}]}],"name":"color"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The placement attribute indicates whether something is above or below another element, such as a note or a notation.","type":"text"}]}],"name":"placement"}],"kind":"parameters"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLColor","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","title":"MXLColor","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlcolor"},"doc://IvorMXL/documentation/IvorMXL/MXLFont":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLFont"}],"abstract":[{"text":"The font attribute group gathers together attributes for determining the font within a credit or direction.","type":"text"},{"text":" ","type":"text"},{"text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of","type":"text"},{"text":" ","type":"text"},{"text":"font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric","type":"text"},{"text":" ","type":"text"},{"text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font","type":"text"},{"text":" ","type":"text"},{"text":"vs. a music font.","type":"text"}],"kind":"symbol","title":"MXLFont","url":"\/documentation\/ivormxl\/mxlfont","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFont"}]},"doc://IvorMXL/documentation/IvorMXL/MXLHole/init(kind:closed:shape:position:font:color:placement:)":{"abstract":[{"type":"text","text"