"The color attribute group indicates the color of an element.","type":"text"}]}],"name":"color"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The placement attribute indicates whether something is above or below another element,","type":"text"},{"text":" ","type":"text"},{"text":"such as a note or a notation.","type":"text"}]}],"name":"placement"}],"kind":"parameters"}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLHole":{"type":"topic","title":"MXLHole","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHole","abstract":[{"type":"text","text":"The hole type represents the symbols used for woodwind and brass fingerings as well as other notations."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLHole"}],"navigatorTitle":[{"kind":"identifier","text":"MXLHole"}],"url":"\/documentation\/ivormxl\/mxlhole"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLHole/Closed-swift.struct":{"type":"topic","title":"MXLHole.Closed","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHole\/Closed-swift.struct","abstract":[{"text":"The hole-closed type represents whether the hole is closed, open, or half-open. The optional location","type":"text"},{"text":" ","type":"text"},{"text":"attribute indicates which portion of the hole is filled in when the element value is half.","type":"text"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"Closed"}],"navigatorTitle":[{"kind":"identifier","text":"Closed"}],"url":"\/documentation\/ivormxl\/mxlhole\/closed-swift.struct"},"doc://IvorMXL/documentation/Ivo