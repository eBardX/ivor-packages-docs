xt":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"font"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL7MXLFontV","kind":"typeIdentifier","text":"MXLFont"},{"kind":"text","text":", "},{"kind":"externalParam","text":"color"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL8MXLColorV","kind":"typeIdentifier","text":"MXLColor"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"underline"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL16MXLNumberOfLinesV","kind":"typeIdentifier","text":"MXLNumberOfLines"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"overline"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL16MXLNumberOfLinesV","kind":"typeIdentifier","text":"MXLNumberOfLines"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"lineThrough"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL16MXLNumberOfLinesV","kind":"typeIdentifier","text":"MXLNumberOfLines"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"rotation"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL18MXLRotationDegreesa","kind":"typeIdentifier","text":"MXLRotationDegrees"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"letterSpacing"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL17MXLNumberOrNormalO","kind":"typeIdentifier","text":"MXLNumberOrNormal"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"xmlLang"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"dir"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL16MXLTextDirectionO","kind":"typeIdentifier","text":"MXLTextDirection"},{"kind":"text","text":"?)"}]},"doc://IvorMXL/documentation/IvorMXL/MXLRotationDegrees":{"role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRotationDegrees","kind":"symbol","url":"\/documentation\/ivormxl\/mxlrotationdegrees","title":"MXLRotationDegrees","navigatorTitle":[{"kind":"identifier","text":"MXLRotationDegrees"}],"fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLRotationDegrees"}],"type":"topic","abstract":[{"text":"The rotation-degrees type specifies rotation, pan, and elevation values in degrees. Values range from -180 to","type":"text"},{"text":" ","type":"text"},{"text":"180.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLColor","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","title":"MXLColor","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlcolor"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLTextDirection":{"url":"\/documentation\/ivormxl\/mxltextdirection","title":"MXLTextDirection","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTextDirection"}],"navigatorTitle":[{"kind":"identifier","text":"MXLTextDirection"}],"abstract":[{"type":"text","text":"The text-direction type is used to adjust and override the Unicode bidirectional text algorithm, similar to"},{"type":"text","text":" "},{"type":"text","text":"the Directionality data category in the W3C Internationalization Tag Set recommendation. Values are ltr (left-"},{"type":"text","text":" "},{"type":"text","text":"to-right embed), rtl (right-to-left embed), lro (left-to-right bidi-override), and rlo (right-to-left bidi-"},{"type":"text","text":" "},{"type":"text","text":"override). The default value is ltr. This type is typically used by applications that store text in left-to-"},{"type":"text","text":" "},{"type":"text","text":"right visual order rather than logical order. Such applications can use the lro value to better communicate"},{"type":"text","text":" "},{"type":"text","text":"with other applications that more fully support bidirectional text."}],"kind":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTextDirection"},"doc://IvorMXL/documentation/IvorMXL/MXLFont":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLFont"}],"abstract":[{"text":"The font attribute group gathers together attributes for determining the font within a credit or direction.","type":"text"},{"text":" ","type":"text"},{"text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of","type":"text"},{"text":" ","type":"text"},{"text":"font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric","type":"text"},{"text":" ","type":"text"},{"text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font","type":"text"},{"text":" ","type":"text"},{"text":"vs. a music font.","type":"text"}],"kind":"symbol","title":"MXLFont","url":"\/documentation\/ivormxl\/mxlfont","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFont"}]},"doc://IvorMXL/documentation/IvorMXL/MXLTextElementData":{"url":"\/documentation\/ivormxl\/mxltextelementdata","abstract":[{"type":"text","text":"The text-element-data type represents a syllable or portion of a syllable for lyric text underlay. A hyphen in"},{"type":"text","text":" "},{"type":"text","text":"the string content should only be used for an actual hyphenated word. Language names for text elements come"},{"type":"text","text":" "},{"type":"text","text":"from ISO 639, with optional country subcodes from ISO 3166."}],"title":"MXLTextElementData","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTextElementData"}],"navigatorTitle":[{"kind":"identifier","text":"MXLTextElementData"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTextElementData","kind":"symbol","type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLNumberOfLines":{"role":"symbol","abstract":[{"text":"The number-of-lines type is used to specify the number of lines in text decoration attributes.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumberOfLines","url":"\/documentation\/ivormxl\/mxlnumberoflines","title":"MXLNumberOfLines","navigatorTitle":[{"kind":"identifier","text":"MXLNumberOfLines"}],"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNumberOfLines"}]},"doc://IvorMXL/documentation/IvorMXL/MXLNumberOrNormal":{"type":"topic","abstract":[{"type":"text","text":"The number-or-normal values can be either a decimal number or the string “normal”. This is used by the line-"},{"type":"text","text":" "},{"type":"text","text":"height and letter-spacing attributes."}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNumberOrNormal","kind":"identifier"}],"navigatorTitle":[{"text":"MXLNumberOrNormal","kind":"identifier"}],"title":"MXLNumberOrNormal","kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlnumberornormal","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumberOrNormal"}}}