type":"paragraph","inlineContent":[{"type":"text","text":"The value of this element."}]}]},{"name":"font","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The font attribute group gathers together attributes for determining the font within a credit or direction. They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font vs. a music font."}]}]},{"name":"color","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The color attribute group indicates the color of an element."}]}]},{"name":"underline","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The number of lines used to underline the text: "},{"type":"codeVoice","code":"0"},{"type":"text","text":" (none), "},{"type":"codeVoice","code":"1"},{"type":"text","text":", "},{"type":"codeVoice","code":"2"},{"type":"text","text":", or "},{"type":"codeVoice","code":"3"},{"type":"text","text":"."}]}]},{"name":"overline","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The number of lines used to overline the text: "},{"type":"codeVoice","code":"0"},{"type":"text","text":" (none), "},{"type":"codeVoice","code":"1"},{"type":"text","text":", "},{"type":"codeVoice","code":"2"},{"type":"text","text":", or "},{"type":"codeVoice","code":"3"},{"type":"text","text":"."}]}]},{"name":"lineThrough","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The number of lines used to strike through the text: "},{"type":"codeVoice","code":"0"},{"type":"text","text":" (none), "},{"type":"codeVoice","code":"1"},{"type":"text","text":", "},{"type":"codeVoice","code":"2"},{"type":"text","text":", or "},{"type":"codeVoice","code":"3"},{"type":"text","text":"."}]}]},{"name":"rotation","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The rotation attribute is used to rotate text around the alignment point specified by the halign and valign attributes. Positive values are clockwise rotations, while negative values are counter-clockwise rotations."}]}]},{"name":"letterSpacing","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The letter-spacing attribute specifies text tracking. Values are either “normal” or a number representing the number of ems to add between each letter. The number may be negative in order to subtract space. The default is normal, which allows flexibility of letter-spacing for purposes of text justification."}]}]},{"name":"xmlLang","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The xml:lang attribute value."}]}]},{"name":"dir","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The text-direction attribute is used to adjust and override the Unicode bidirectional text algorithm, similar to the Directionality data category in the W3C Internationalization Tag Set recommendation."}]}]}]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLTextElementData":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTextElementData","navigatorTitle":[{"kind":"identifier","text":"MXLTextElementData"}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTextElementData"}],"url":"\/documentation\/ivormxl\/mxltextelementdata","type":"topic","kind":"symbol","title":"MXLTextElementData","abstract":[{"text":"The text-element-data type represents a syllable or portion of a syllable for lyric text underlay. A hyphen in","type":"text"},{"text":" ","type":"text"},{"text":"the string content should only be used for an actual hyphenated word. Language names for text elements come","type":"text"},{"text":" ","type":"text"},{"text":"from ISO 639, with optional country subcodes from ISO 3166.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLFont":{"title":"MXLFont","url":"\/documentation\/ivormxl\/mxlfont","role":"symbol","navigatorTitle":[{"text":"MXLFont","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","abstract":[{"text":"The font attribute group gathers together attributes for determining the font within a credit or direction.","type":"text"},{"text":" ","type":"text"},{"text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric"},{"type":"text","text":" "},{"type":"text","text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font"},{"type":"text","text":" "},{"type":"text","text":"vs. a music font."}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLFont","kind":"identifier"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLRotationDegrees":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRotationDegrees","abstract":[{"type":"text","text":"The rotation-degrees type specifies rotation, pan, and elevation values in degrees. Values range from -180 to"},{"text":" ","type":"text"},{"text":"180.","type":"text"}],"title":"MXLRotationDegrees","navigatorTitle":[{"text":"MXLRotationDegrees","kind":"identifier"}],"type":"topic","kind":"symbol","role":"symbol","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLRotationDegrees","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlrotationdegrees"},"doc://IvorMXL/documentation/IvorMXL/MXLTextDirection":{"kind":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTextDirection"}],"url":"\/documentation\/ivormxl\/mxltextdirection","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTextDirection","navigatorTitle":[{"text":"MXLTextDirection","kind":"identifier"}],"abstract":[{"type":"text","text":"The text-direction type is used to adjust and override the Unicode bidirectional text algorithm, similar to"},{"text":" ","type":"text"},{"type":"text","text":"the Directionality data category in the W3C Internationalization Tag Set recommendation. Values are ltr (left-"},{"type":"text","text":" "},{"type":"text","text":"to-right embed), rtl (right-to-left embed), lro (left-to-right bidi-override), and rlo (right-to-left bidi-"},{"type":"text","text":" "},{"type":"text","text":"override). The default value is ltr. This type is typically used by applications that store text in left-to-"},{"type":"text","text":" "},{"type":"text","text":"right visual order rather than logical order. Such applications can use the lro value to better communicate"},{"type":"text","text":" "},{"type":"text","text":"with other applications that more fully support bidirectional text."}],"title":"MXLTextDirection","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNumberOrNormal":{"navigatorTitle":[{"kind":"identifier","text":"MXLNumberOrNormal"}],"url":"\/documentation\/ivormxl\/mxlnumberornormal","kind":"symbol","type":"topic","role":"symbol","title":"MXLNumberOrNormal","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumberOrNormal","abstract":[{"text":"The number-or-normal values can be either a decimal number or the string “normal”. This is used by the line-","type":"text"},{"text":" ","type":"text"},{"text":"height and letter-spacing attributes.","type":"text"}],"fragments":[{"kind":"keywor