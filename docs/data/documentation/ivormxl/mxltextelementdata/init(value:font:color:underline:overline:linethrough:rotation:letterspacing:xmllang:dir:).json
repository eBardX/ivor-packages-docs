}],"name":"letterSpacing"},{"content":[{"inlineContent":[{"type":"text","text":"The xml:lang attribute value."}],"type":"paragraph"}],"name":"xmlLang"},{"content":[{"inlineContent":[{"type":"text","text":"The text-direction attribute is used to adjust and override the Unicode bidirectional text algorithm, similar to the Directionality data category in the W3C Internationalization Tag Set recommendation."}],"type":"paragraph"}],"name":"dir"}],"kind":"parameters"}],"metadata":{"modules":[{"name":"IvorMXL"}],"fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"value","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"font","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLFont","preciseIdentifier":"s:7IvorMXL7MXLFontV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"color","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLColor","preciseIdentifier":"s:7IvorMXL8MXLColorV","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"underline","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLNumberOfLines","preciseIdentifier":"s:7IvorMXL16MXLNumberOfLinesV","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"overline","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLNumberOfLines","preciseIdentifier":"s:7IvorMXL16MXLNumberOfLinesV","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"lineThrough","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLNumberOfLines","preciseIdentifier":"s:7IvorMXL16MXLNumberOfLinesV","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"rotation","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLRotationDegrees","preciseIdentifier":"s:7IvorMXL18MXLRotationDegreesa","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"letterSpacing","kind":"externalParam"},{"text":": "