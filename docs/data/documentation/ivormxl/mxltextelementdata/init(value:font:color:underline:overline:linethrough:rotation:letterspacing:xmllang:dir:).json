,{"content":[{"inlineContent":[{"type":"text","text":"The letter-spacing attribute specifies text tracking. Values are either “normal” or a number representing the number of ems to add between each letter. The number may be negative in order to subtract space. The default is normal, which allows flexibility of letter-spacing for purposes of text justification."}],"type":"paragraph"}],"name":"letterSpacing"},{"content":[{"inlineContent":[{"type":"text","text":"The xml:lang attribute value."}],"type":"paragraph"}],"name":"xmlLang"},{"content":[{"inlineContent":[{"type":"text","text":"The text-direction attribute is used to adjust and override the Unicode bidirectional text algorithm, similar to the Directionality data category in the W3C Internationalization Tag Set recommendation."}],"type":"paragraph"}],"name":"dir"}],"kind":"parameters"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxltextelementdata\/init(value:font:color:underline:overline:linethrough:rotation:letterspacing:xmllang:dir:)"]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLRotationDegrees":{"abstract":[{"type":"text","text":"The rotation-degrees type specifies rotation, pan, and elevation values in degrees. Values range from -180 to"},{"text":" ","type":"text"},{"type":"text","text":"180."}],"title":"MXLRotationDegrees","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"text":"MXLRotationDegrees","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"MXLRotationDegrees"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlrotationdegrees","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRotationDegrees"},"doc://IvorMXL/documentation/IvorMXL/MXLTextDirection":{"kind":"symbol","navigatorTitle":[{"text":"MXLTextDirection","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxltextdirection","title":"MXL