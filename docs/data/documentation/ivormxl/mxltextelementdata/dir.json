ata","navigatorTitle":[{"kind":"identifier","text":"MXLTextElementData"}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTextElementData"}],"url":"\/documentation\/ivormxl\/mxltextelementdata","type":"topic","kind":"symbol","title":"MXLTextElementData","abstract":[{"text":"The text-element-data type represents a syllable or portion of a syllable for lyric text underlay. A hyphen in","type":"text"},{"text":" ","type":"text"},{"text":"the string content should only be used for an actual hyphenated word. Language names for text elements come","type":"text"},{"text":" ","type":"text"},{"text":"from ISO 639, with optional country subcodes from ISO 3166.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLTextElementData/dir":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTextElementData\/dir","kind":"symbol","title":"dir","url":"\/documentation\/ivormxl\/mxltextelementdata\/dir","type":"topic","role":"symbol","abstract":[{"type":"text","text":"The text-direction attribute is used to adjust and override the Unicode bidirectional text algorithm, similar"},{"type":"text","text":" "},{"type":"text","text":"to the Directionality data category in the W3C Internationalization Tag Set recommendation."}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dir","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL16MXLTextDirectionO","text":"MXLTextDirection","kind":"typeIdentifier"}]},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLTextDirection":{"kind":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTextDirection"}],"url":"\/documentation\/ivormxl\/mxltextdirection","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTextDirection","navigatorTitle":[{"text":"MXLTextDirection","kind":"identifier"}],"abstract":[{"type":"text","text":"The text-direction type is used to adjust and override the Unicode bidirectional text algorithm, similar to"},{"text":" ","type":"text"},{"type":"text","text":"the Directionality data category in the W3C Internationalization Tag Set recommendation. Values are ltr (left-"},{"type":"text","text":" "},{"type":"text","text":"to-right embed), rtl (right-to-left embed), lro (left-to-right bidi-override), and rlo (right-to-left bidi-"},{"type":"text","text":" "},{"type":"text","text":"override). The default value is ltr. This type is typically used by applications that store text in left-to-"},{"type":"text","text":" "},{"type":"text","text":"right visual order rather than logical order. Such applications can use the lro value to better communicate"},{"type":"text","text":" "},{"type":"text","text":"with other applications that more fully support bidirectional text."}],"title":"MXLTextDirection","role":"symbol"}}}