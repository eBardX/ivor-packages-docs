r":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTextElementData","abstract":[{"text":"The text-element-data type represents a syllable or portion of a syllable for lyric text underlay. A hyphen in","type":"text"},{"text":" ","type":"text"},{"text":"the string content should only be used for an actual hyphenated word. Language names for text elements come","type":"text"},{"text":" ","type":"text"},{"text":"from ISO 639, with optional country subcodes from ISO 3166.","type":"text"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTextElementData","kind":"identifier"}],"navigatorTitle":[{"text":"MXLTextElementData","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxltextelementdata"},"doc://IvorMXL/documentation/IvorMXL/MXLTextElementData/dir":{"title":"dir","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dir","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLTextDirection","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL16MXLTextDirectionO"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxltextelementdata\/dir","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTextElementData\/dir","abstract":[{"text":"The text-direction attribute is used to adjust and override the Unicode bidirectional text algorithm, similar","type":"text"},{"text":" ","type":"text"},{"text":"to the Directionality data category in the W3C Internationalization Tag Set recommendation.","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLTextDirection":{"title":"MXLTextDirection","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTextDirection","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxltextdirection","role":"symbol","navigatorTitle":[{"text":"MXLTextDirection","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTextDirection","abstract":[{"text":"The text-direction type is used to adjust and override the Unicode bidirectional text algorithm, similar to","type":"text"},{"text":" ","type":"text"},{"text":"the Directionality data category in the W3C Internationalization Tag Set recommendation. Values are ltr (left-","type":"text"},{"text":" ","type":"text"},{"text":"to-right embed), rtl (right-to-left embed), lro (left-to-right bidi-override), and rlo (right-to-left bidi-","type":"text"},{"text":" ","type":"text"},{"text":"override). The default value is ltr. This type is typically used by applications that store text in left-to-","type":"text"},{"text":" ","type":"text"},{"text":"right visual order rather than logical order. Such applications can use the lro value to better communicate","type":"text"},{"text":" ","type":"text"},{"text":"with other applications that more fully support bidirectional text.","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"}}}