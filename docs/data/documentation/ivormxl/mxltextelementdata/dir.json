{"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTextElementData"]]},"abstract":[{"type":"text","text":"The text-direction attribute is used to adjust and override the Unicode bidirectional text algorithm, similar"},{"type":"text","text":" "},{"type":"text","text":"to the Directionality data category in the W3C Internationalization Tag Set recommendation."}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxltextelementdata\/dir"]}],"kind":"symbol","metadata":{"symbolKind":"property","externalID":"s:7IvorMXL18MXLTextElementDataV3dirAA0C9DirectionOvp","title":"dir","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dir","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL16MXLTextDirectionO","text":"MXLTextDirection","kind":"typeIdentifier"}],"roleHeading":"Instance Property","modules":[{"name":"IvorMXL"}],"role":"symbol"},"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTextElementData\/dir","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dir","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL16MXLTextDirectionO","text":"MXLTextDirection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTextDirection","kind":"typeIdentifier"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"Maps to the MusicXML "},{"type":"codeVoice","code":"dir"},{"type":"text","text":" attribute."}],"type":"paragraph"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"references":{"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLTextElementData":{"url":"\/documentation\/ivormxl\/mxltextelementdata","abstract":[{"type":"text","text":"The text-element-data type represents a syllable or portion of a syllable for lyric text underlay. A hyphen in"},{"type":"text","text":" "},{"type":"text","text":"the string content should only be used for an actual hyphenated word. Language names for text elements come"},{"type":"text","text":" "},{"type":"text","text":"from ISO 639, with optional country subcodes from ISO 3166."}],"title":"MXLTextElementData","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTextElementData"}],"navigatorTitle":[{"kind":"identifier","text":"MXLTextElementData"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTextElementData","kind":"symbol","type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLTextDirection":{"url":"\/documentation\/ivormxl\/mxltextdirection","title":"MXLTextDirection","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTextDirection"}],"navigatorTitle":[{"kind":"identifier","text":"MXLTextDirection"}],"abstract":[{"type":"text","text":"The text-direction type is used to adjust and override the Unicode bidirectional text algorithm, similar to"},{"type":"text","text":" "},{"type":"text","text":"the Directionality data category in the W3C Internationalization Tag Set recommendation. Values are ltr (left-"},{"type":"text","text":" "},{"type":"text","text":"to-right embed), rtl (right-to-left embed), lro (left-to-right bidi-override), and rlo (right-to-left bidi-"},{"type":"text","text":" "},{"type":"text","text":"override). The default value is ltr. This type is typically used by applications that store text in left-to-"},{"type":"text","text":" "},{"type":"text","text":"right visual order rather than logical order. Such applications can use the lro value to better communicate"},{"type":"text","text":" "},{"type":"text","text":"with other applications that more fully support bidirectional text."}],"kind":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTextDirection"},"doc://IvorMXL/documentation/IvorMXL/MXLTextElementData/dir":{"role":"symbol","kind":"symbol","title":"dir","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTextElementData\/dir","abstract":[{"text":"The text-direction attribute is used to adjust and override the Unicode bidirectional text algorithm, similar","type":"text"},{"text":" ","type":"text"},{"text":"to the Directionality data category in the W3C Internationalization Tag Set recommendation.","type":"text"}],"url":"\/documentation\/ivormxl\/mxltextelementdata\/dir","fragments":[{"text":"let","kind":"keyword"},{"kind":"text","text":" "},{"text":"dir","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLTextDirection","preciseIdentifier":"s:7IvorMXL16MXLTextDirectionO","kind":"typeIdentifier"}]}}}