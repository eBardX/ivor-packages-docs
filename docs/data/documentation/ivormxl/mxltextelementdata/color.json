{"kind":"symbol","abstract":[{"text":"The color attribute group indicates the color of an element.","type":"text"}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTextElementData\/color","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"color"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL8MXLColorV","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","text":"MXLColor"},{"kind":"text","text":"?"}]}],"kind":"declarations"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTextElementData"]]},"metadata":{"roleHeading":"Instance Property","title":"color","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"color"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLColor","preciseIdentifier":"s:7IvorMXL8MXLColorV"},{"kind":"text","text":"?"}],"externalID":"s:7IvorMXL18MXLTextElementDataV5colorAA8MXLColorVSgvp","modules":[{"name":"IvorMXL"}],"symbolKind":"property","role":"symbol"},"sections":[],"variants":[{"paths":["\/documentation\/ivormxl\/mxltextelementdata\/color"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLTextElementData":{"url":"\/documentation\/ivormxl\/mxltextelementdata","abstract":[{"type":"text","text":"The text-element-data type represents a syllable or portion of a syllable for lyric text underlay. A hyphen in"},{"type":"text","text":" "},{"type":"text","text":"the string content should only be used for an actual hyphenated word. Language names for text elements come"},{"type":"text","text":" "},{"type":"text","text":"from ISO 639, with optional country subcodes from ISO 3166."}],"title":"MXLTextElementData","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTextElementData"}],"navigatorTitle":[{"kind":"identifier","text":"MXLTextElementData"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTextElementData","kind":"symbol","type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLColor","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","title":"MXLColor","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlcolor"},"doc://IvorMXL/documentation/IvorMXL/MXLTextElementData/color":{"role":"symbol","kind":"symbol","url":"\/documentation\/ivormxl\/mxltextelementdata\/color","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTextElementData\/color","abstract":[{"type":"text","text":"The color attribute group indicates the color of an element."}],"type":"topic","title":"color","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"color"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL8M