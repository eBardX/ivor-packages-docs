symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLElementPosition":{"type":"topic","title":"MXLElementPosition","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLElementPosition"}],"url":"\/documentation\/ivormxl\/mxlelementposition","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLElementPosition","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"MXLElementPosition","kind":"identifier"}],"abstract":[{"type":"text","text":"The element and position attributes are new as of Version 2.0. They allow for bookmarks and links to be"},{"type":"text","text":" "},{"type":"text","text":"positioned at higher resolution than the level of music-data elements. When no element and position attributes"},{"type":"text","text":" "},{"type":"text","text":"are present, the bookmark or link element refers to the next sibling element in the MusicXML file. The element"},{"type":"text","text":" "},{"text":"attribute specifies an element type for a descendant of the next sibling element that is not a link or","type":"text"},{"text":" ","type":"text"},{"text":"bookmark. The position attribute specifies the position of this descendant element, where the first position","type":"text"},{"text":" ","type":"text"},{"text":"is 1. The position attribute is ignored if the element attribute is not present. For instance, an element","type":"text"},{"type":"text","text":" "},{"text":"value of “beam” and a position value of “2” defines the link or bookmark to refer to the second beam","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"descendant of the next sibling element that is not a link or bookmark. This is equivalent to an XPath test of"},{"type":"text","text":" "},{"type":"text","text":"[.\/\/beam[2]] done in the context of the sibling element."}]},"doc://IvorMXL/documentation/IvorMXL/MXLElementPosition/position":{"kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"position","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":"?","kind":"text"}],"title":"position","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLElementPosition\/position","url":"\/documentation\/ivormxl\/mxlelementposition\/position","role":"symbol","type":"topic","abstract":[{"type":"text","text":"The position of the descendant element specified by "},{"type":"codeVoice","code":"element"},{"type":"text","text":", where the first position is "},{"type":"codeVoice","code":"1"},{"type":"text","text":". Ignored if"},{"type":"text","text":" "},{"type":"codeVoice","code":"element"},{"type":"text","text":" is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}]}}}