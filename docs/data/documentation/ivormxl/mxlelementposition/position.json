","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLElementPosition\/position","title":"position","url":"\/documentation\/ivormxl\/mxlelementposition\/position","abstract":[{"type":"text","text":"The position of the descendant element specified by "},{"type":"codeVoice","code":"element"},{"type":"text","text":", where the first position is "},{"type":"codeVoice","code":"1"},{"type":"text","text":". Ignored if"},{"type":"text","text":" "},{"type":"codeVoice","code":"element"},{"type":"text","text":" is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"position","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"kind":"symbol","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLElementPosition":{"type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLElementPosition","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"MXLElementPosition"}],"abstract":[{"type":"text","text":"The element and position attributes are new as of Version 2.0. They allow for bookmarks and links to be"},{"type":"text","text":" "},{"type":"text","text":"positioned at higher resolution than the level of music-data elements. When no element and position attributes"},{"type":"text","text":" "},{"type":"text","text":"are present, the bookmark or link element refers to the next sibling element in the MusicXML file. The element"},{"type":"text","text":" "},{"type":"text","text":"attribute specifies an element type for a descendant of the next sibling element that is not a link or"},{"type":"text","text":" "},{"type":"text","text":"bookmark. The position attribute specifies the position of this descendant element, where the first position"},{"type":"text","text":" "},{"type":"text","text":"is 1. The position attribute is ignored if the element attribute is not present. For instance, an element"},{"type":"text","text":" "},{"type":"text","text":"value of “beam” and a position value of “2” defines the link or bookmark to refer to the second beam"},{"type":"text","text":" "},{"type":"text","text":"descendant of the next sibling element that is not a link or bookmark. This is equivalent to an XPath test of"},{"type":"text","text":" "},{"type":"text","text":"[.\/\/beam[2]] done in the context of the sibling element."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLElementPosition","title":"MXLElementPosition","role":"symbol","url":"\/documentation\/ivormxl\/mxlelementposition"}}}