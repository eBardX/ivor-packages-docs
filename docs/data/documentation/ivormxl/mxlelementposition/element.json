{"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLElementPosition"]]},"kind":"symbol","abstract":[{"text":"The element type for a descendant of the next sibling element that is not a link or bookmark.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"element","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?","kind":"text"}]}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"inlineContent":[{"text":"Maps to the MusicXML ","type":"text"},{"code":"element","type":"codeVoice"},{"text":" attribute.","type":"text"}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlelementposition\/element"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLElementPosition\/element"},"metadata":{"modules":[{"name":"IvorMXL"}],"role":"symbol","roleHeading":"Instance Property","externalID":"s:7IvorMXL18MXLElementPositionV7elementSSSgvp","symbolKind":"property","title":"element","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"element","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?","kind":"text"}]},"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"references":{"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLElementPosition/element":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLElementPosition\/element","url":"\/documentation\/ivormxl\/mxlelementposition\/element","abstract":[{"text":"The element type for a descendant of the next sibling element that is not a link or bookmark.","type":"text"}],"type":"topic","role":"symbol","kind":"symbol","title":"element","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"element"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?","kind":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLElementPosition":{"type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLElementPosition","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"MXLElementPosition"}],"abstract":[{"type":"text","text":"The element and position attributes are new as of Version 2.0. They allow for bookmarks and links to be"},{"type":"text","text":" "},{"type":"text","text":"positioned at higher resolution than the level of music-data elements. When no element and position attributes"},{"type":"text","text":" "},{"type":"text","text":"are present, the bookmark or link element refers to the next sibling element in the MusicXML file. The element"},{"type":"text","text":" "},{"type":"text","text":"attribute specifies an element type for a descendant of the next sibling element that is not a link or"},{"type":"text","text":" "},{"type":"text","text":"bookmark. The position attribute specifies the position of this descendant element, where the first position"},{"type":"text","text":" "},{"type":"text","text":"is 1. The position attribute is ignored if the element attribute is not present. For instance, an element"},{"type":"text","text":" "},{"type":"text","text":"value of “beam” and a position value of “2” defines the link or bookmark to refer to the second beam"},{"type":"text","text":" "},{"type":"text","text":"descendant of the next sibling element that is not a link or bookmark. This is equivalent to an XPath test of"},{"type":"text","text":" "},{"type":"text","text":"[.\/\/beam[2]] done in the context of the sibling element."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLElementPosition","title":"MXLElementPosition","role":"symbol","url":"\/documentation\/ivormxl\/mxlelementposition"}}}