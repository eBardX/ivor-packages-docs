{"variants":[{"paths":["\/documentation\/ivormxl\/mxlelementposition\/init(element:position:)"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"kind":"symbol","primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"element"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"position"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":"? = nil)"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The element type for a descendant of the next sibling element that is not a link or bookmark."}],"type":"paragraph"}],"name":"element"},{"content":[{"inlineContent":[{"type":"text","text":"The position of the descendant element specified by "},{"type":"codeVoice","code":"element"},{"type":"text","text":", where the first position is "},{"type":"codeVoice","code":"1"},{"type":"text","text":". Ignored if "},{"type":"codeVoice","code":"element"},{"type":"text","text":" is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}],"type":"paragraph"}],"name":"position"}],"kind":"parameters"}],"metadata":{"modules":[{"name":"IvorMXL"}],"symbolKind":"init","role":"symbol","externalID":"s:7IvorMXL18MXLElementPositionV7element8positionACSSSg_SiSgtcfc","title":"init(element:position:)","roleHeading":"Initializer","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"element"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"position"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":"?)"}]},"abstract":[{"type":"text","text":"Creates a new "},{"code":"MXLElementPosition","type":"codeVoice"},{"type":"text","text":"."}],"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLElementPosition\/init(element:position:)","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLElementPosition"]]},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLElementPosition/init(element:position:)":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlelementposition\/init(element:position:)","title":"init(element:position:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"element","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"position","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":"?)","kind":"text"}],"abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLElementPosition"},{"type":"text","text":"."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLElementPosition\/init(element:position:)"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLElementPosition":{"type":"topic","title":"MXLElementPosition","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLElementPosition"}],"url":"\/documentation\/ivormxl\/mxlelementposition","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLElementPosition","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"MXLElementPosition","kind":"identifier"}],"abstract":[{"type":"text","text":"The element and position attributes are new as of Version 2.0. They allow for bookmarks and links to be"},{"type":"text","text":" "},{"type":"text","text":"positioned at higher resolution than the level of music-data elements. When no element and position attributes"},{"type":"text","text":" "},{"type":"text","text":"are present, the bookmark or link element refers to the next sibling element in the MusicXML file. The element"},{"type":"text","text":" "},{"text":"attribute specifies an element type for a descendant of the next sibling element that is not a link or","type":"text"},{"text":" ","type":"text"},{"text":"bookmark. The position attribute specifies the position of this descendant element, where the first position","type":"text"},{"text":" ","type":"text"},{"text":"is 1. The position attribute is ignored if the element attribute is not present. For instance, an element","type":"text"},{"type":"text","text":" "},{"text":"value of “beam” and a position value of “2” defines the link or bookmark to refer to the second beam","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"descendant of the next sibling element that is not a link or bookmark. This is equivalent to an XPath test of"},{"type":"text","text":" "},{"type":"text","text":"[.\/\/beam[2]] done in the context of the sibling element."}]}}}