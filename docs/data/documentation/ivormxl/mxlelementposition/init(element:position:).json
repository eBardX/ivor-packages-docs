stract":[{"text":"Creates a new ","type":"text"},{"type":"codeVoice","code":"MXLElementPosition"},{"text":".","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlelementposition\/init(element:position:)"]}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLElementPosition"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLElementPosition":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLElementPosition","url":"\/documentation\/ivormxl\/mxlelementposition","title":"MXLElementPosition","type":"topic","kind":"symbol","abstract":[{"text":"The element and position attributes are new as of Version 2.0. They allow for bookmarks and links to be","type":"text"},{"text":" ","type":"text"},{"text":"positioned at higher resolution than the level of music-data elements. When no element and position attributes","type":"text"},{"text":" ","type":"text"},{"text":"are present, the bookmark or link element refers to the next sibling element in the MusicXML file. The element","type":"text"},{"text":" ","type":"text"},{"text":"attribute specifies an element type for a descendant of the next sibling element that is not a link or","type":"text"},{"text":" ","type":"text"},{"text":"bookmark. The position attribute specifies the position of this descendant element, where the first position","type":"text"},{"text":" ","type":"text"},{"text":"is 1. The position attribute is ignored if the element attribute is not present. For instance, an element","type":"text"},{"text":" ","type":"text"},{"text":"value of “beam” and a position value of “2” defines the link or bookmark to refer to the second beam","type":"text"},{"text":" ","type":"text"},{"text":"descendant of the next sibling element that is not a link or bookmark. This is equivalent to an XPath test of","type":"text"},{"text":" ","type":"text"},{"text":"[.\/\/