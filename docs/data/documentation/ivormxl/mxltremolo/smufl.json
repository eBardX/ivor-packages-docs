{"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo"]]},"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"text":"The smufl attribute group is used to indicate a particular Standard Music Font Layout (SMuFL) character.","type":"text"},{"text":" ","type":"text"},{"text":"Sometimes this is a formatting choice, and sometimes this is a refinement of the semantic meaning of an","type":"text"},{"text":" ","type":"text"},{"text":"element.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"smufl","kind":"identifier"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSmuflGlyphName","preciseIdentifier":"s:7IvorMXL17MXLSmuflGlyphNameV","text":"MXLSmuflGlyphName","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Maps to the MusicXML "},{"type":"codeVoice","code":"smufl"},{"type":"text","text":" attribute."}]}]}],"variants":[{"paths":["\/documentation\/ivormxl\/mxltremolo\/smufl"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo\/smufl","interfaceLanguage":"swift"},"metadata":{"roleHeading":"Instance Property","title":"smufl","symbolKind":"property","externalID":"s:7IvorMXL10MXLTremoloV5smuflAA17MXLSmuflGlyphNameVSgvp","modules":[{"name":"IvorMXL"}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"smufl","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL17MXLSmuflGlyphNameV","text":"MXLSmuflGlyphName","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"role":"symbol"},"references":{"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLTremolo/smufl":{"abstract":[{"type":"text","text":"The smufl attribute group is used to indicate a particular Standard Music Font Layout (SMuFL) character."},{"type":"text","text":" "},{"type":"text","text":"Sometimes this is a formatting choice, and sometimes this is a refinement of the semantic meaning of an"},{"type":"text","text":" "},{"type":"text","text":"element."}],"title":"smufl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo\/smufl","kind":"symbol","url":"\/documentation\/ivormxl\/mxltremolo\/smufl","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"smufl","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLSmuflGlyphName","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL17MXLSmuflGlyphNameV"},{"text":"?","kind":"text"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLTremolo":{"abstract":[{"type":"text","text":"The tremolo ornament can be used to indicate single-note, double-note, or unmeasured tremolos. Single-note"},{"type":"text","text":" "},{"type":"text","text":"tremolos use the single type, double-note tremolos use the start and stop types, and unmeasured tremolos use"},{"type":"text","text":" "},{"type":"text","text":"the unmeasured type. The default is “single” for compatibility with Version 1.1. The text of the element"},{"type":"text","text":" "},{"type":"text","text":"indicates the number of tremolo marks and is an integer from 0 to 8. Note that the number of attached beams is"},{"type":"text","text":" "},{"type":"text","text":"not included in this value, but is represented separately using the beam element. The value should be 0 for"},{"type":"text","text":" "},{"type":"text","text":"unmeasured tremolos."}],"title":"MXLTremolo","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTremolo","kind":"identifier"}],"navigatorTitle":[{"text":"MXLTremolo","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxltremolo","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo"},"doc://IvorMXL/documentation/IvorMXL/MXLSmuflGlyphName":{"abstract":[{"text":"The smufl-glyph-name type is used for attributes that reference a specific Standard Music Font Layout (SMuFL)","type":"text"},{"text":" ","type":"text"},{"text":"character. The value is a SMuFL canonical glyph name, not a code point. For instance, the value for a standard","type":"text"},{"text":" ","type":"text"},{"text":"piano pedal mark would be keyboardPedalPed, not U+E650.","type":"text"}],"title":"MXLSmuflGlyphName","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLSmuflGlyphName"}],"navigatorTitle":[{"kind":"identifier","text":"MXLSmuflGlyphName"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlsmuflglyphname","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSmuflGlyphName"}}}