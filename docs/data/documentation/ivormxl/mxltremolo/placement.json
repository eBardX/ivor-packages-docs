{"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"placement","kind":"identifier"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAboveBelow","preciseIdentifier":"s:7IvorMXL13MXLAboveBelowO","text":"MXLAboveBelow","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"inlineContent":[{"type":"text","text":"Maps to the MusicXML "},{"code":"placement","type":"codeVoice"},{"type":"text","text":" attribute."}],"type":"paragraph"}]}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo\/placement","interfaceLanguage":"swift"},"kind":"symbol","variants":[{"paths":["\/documentation\/ivormxl\/mxltremolo\/placement"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo"]]},"sections":[],"abstract":[{"type":"text","text":"The placement attribute indicates whether something is above or below another element, such as a note or a"},{"type":"text","text":" "},{"type":"text","text":"notation."}],"metadata":{"symbolKind":"property","externalID":"s:7IvorMXL10MXLTremoloV9placementAA13MXLAboveBelowOSgvp","modules":[{"name":"IvorMXL"}],"roleHeading":"Instance Property","role":"symbol","title":"placement","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"placement","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL13MXLAboveBelowO","text":"MXLAboveBelow","kind":"typeIdentifier"},{"text":"?","kind":"text"}]},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLTremolo":{"type":"topic","abstract":[{"text":"The tremolo ornament can be used to indicate single-note, double-note, or unmeasured tremolos. Single-note","type":"text"},{"text":" ","type":"text"},{"text":"tremolos use the single type, double-note tremolos use the start and stop types, and unmeasured tremolos use","type":"text"},{"text":" ","type":"text"},{"text":"the unmeasured type. The default is “single” for compatibility with Version 1.1. The text of the element","type":"text"},{"text":" ","type":"text"},{"text":"indicates the number of tremolo marks and is an integer from 0 to 8. Note that the number of attached beams is","type":"text"},{"text":" ","type":"text"},{"text":"not included in this value, but is represented separately using the beam element. The value should be 0 for","type":"text"},{"text":" ","type":"text"},{"text":"unmeasured tremolos.","type":"text"}],"url":"\/documentation\/ivormxl\/mxltremolo","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTremolo"}],"kind":"symbol","title":"MXLTremolo","navigatorTitle":[{"kind":"identifier","text":"MXLTremolo"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLTremolo/placement":{"kind":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo\/placement","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"placement"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL13MXLAboveBelowO","text":"MXLAboveBelow"},{"kind":"text","text":"?"}],"title":"placement","url":"\/documentation\/ivormxl\/mxltremolo\/placement","abstract":[{"text":"The placement attribute indicates whether something is above or below another element, such as a note or a","type":"text"},{"text":" ","type":"text"},{"text":"notation.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLAboveBelow":{"type":"topic","title":"MXLAboveBelow","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAboveBelow","abstract":[{"type":"text","text":"The above-below type is used to indicate whether one element appears above or below another element."}],"role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLAboveBelow"}],"navigatorTitle":[{"kind":"identifier","text":"MXLAboveBelow"}],"url":"\/documentation\/ivormxl\/mxlabovebelow"}}}