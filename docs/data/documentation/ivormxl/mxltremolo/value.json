{"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo\/value"},"kind":"symbol","metadata":{"modules":[{"name":"IvorMXL"}],"title":"value","role":"symbol","roleHeading":"Instance Property","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"value","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL15MXLTremoloMarksV","text":"MXLTremoloMarks","kind":"typeIdentifier"}],"externalID":"s:7IvorMXL10MXLTremoloV5valueAA0C5MarksVvp","symbolKind":"property"},"variants":[{"paths":["\/documentation\/ivormxl\/mxltremolo\/value"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"abstract":[{"type":"text","text":"The value of this element."}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"value"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLTremoloMarks","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremoloMarks","preciseIdentifier":"s:7IvorMXL15MXLTremoloMarksV"}]}],"kind":"declarations"}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLTremolo":{"type":"topic","abstract":[{"text":"The tremolo ornament can be used to indicate single-note, double-note, or unmeasured tremolos. Single-note","type":"text"},{"text":" ","type":"text"},{"text":"tremolos use the single type, double-note tremolos use the start and stop types, and unmeasured tremolos use","type":"text"},{"text":" ","type":"text"},{"text":"the unmeasured type. The default is “single” for compatibility with Version 1.1. The text of the element","type":"text"},{"text":" ","type":"text"},{"text":"indicates the number of tremolo marks and is an integer from 0 to 8. Note that the number of attached beams is","type":"text"},{"text":" ","type":"text"},{"text":"not included in this value, but is represented separately using the beam element. The value should be 0 for","type":"text"},{"text":" ","type":"text"},{"text":"unmeasured tremolos.","type":"text"}],"url":"\/documentation\/ivormxl\/mxltremolo","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTremolo"}],"kind":"symbol","title":"MXLTremolo","navigatorTitle":[{"kind":"identifier","text":"MXLTremolo"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLTremoloMarks":{"type":"topic","title":"MXLTremoloMarks","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremoloMarks","abstract":[{"type":"text","text":"The number of tremolo marks is represented by a number from 0 to 8: the same as beam-level with 0 added."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTremoloMarks"}],"navigatorTitle":[{"kind":"identifier","text":"MXLTremoloMarks"}],"url":"\/documentation\/ivormxl\/mxltremolomarks"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLTremolo/value":{"kind":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo\/value","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"value"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL15MXLTremoloMarksV","text":"MXLTremoloMarks"}],"title":"value","url":"\/documentation\/ivormxl\/mxltremolo\/value","abstract":[{"