{"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"value","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLTremoloMarks","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremoloMarks","preciseIdentifier":"s:7IvorMXL15MXLTremoloMarksV"}]}],"kind":"declarations"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxltremolo\/value"]}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo\/value","interfaceLanguage":"swift"},"kind":"symbol","abstract":[{"text":"The value of this element.","type":"text"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo"]]},"metadata":{"title":"value","symbolKind":"property","modules":[{"name":"IvorMXL"}],"externalID":"s:7IvorMXL10MXLTremoloV5valueAA0C5MarksVvp","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"value","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLTremoloMarks","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL15MXLTremoloMarksV"}],"role":"symbol","roleHeading":"Instance Property"},"references":{"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLTremolo/value":{"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo\/value","type":"topic","url":"\/documentation\/ivormxl\/mxltremolo\/value","role":"symbol","title":"value","abstract":[{"type":"text","text":"The value of this element."}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"value"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL15MXLTremoloMarksV","kind":"typeIdentifier","text":"MXLTremoloMarks"}]},"doc://IvorMXL/documentation/IvorMXL/MXLTremolo":{"role":"symbol","url":"\/documentation\/ivormxl\/mxltremolo","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTremolo","kind":"identifier"}],"abstract":[{"type":"text","text":"The tremolo ornament can be used to indicate single-note, double-note, or unmeasured tremolos. Single-note"},{"type":"text","text":" "},{"type":"text","text":"tremolos use the single type, double-note tremolos use the start and stop types, and unmeasured tremolos use"},{"type":"text","text":" "},{"type":"text","text":"the unmeasured type. The default is “single” for compatibility with Version 1.1. The text of the element"},{"type":"text","text":" "},{"type":"text","text":"indicates the number of tremolo marks and is an integer from 0 to 8. Note that the number of attached beams is"},{"type":"text","text":" "},{"type":"text","text":"not included in this value, but is represented separately using the beam element. The value should be 0 for"},{"type":"text","text":" "},{"type":"text","text":"unmeasured tremolos."}],"kind":"symbol","type":"topic","navigatorTitle":[{"text":"MXLTremolo","kind":"identifier"}],"title":"MXLTremolo"},"doc://IvorMXL/documentation/IvorMXL/MXLTremoloMarks":{"url":"\/documentation\/ivormxl\/mxltremolomarks","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremoloMarks","abstract":[{"type":"text","text":"The number of tremolo marks is represented by a number from 0 to 8: the same as beam-level with 0 added."}],"title":"MXLTremoloMarks","kind":"symbol","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTremoloMarks"}],"navigatorTitle":[{"kind":"identifier","text":"MXLTremoloMarks"}]}}}