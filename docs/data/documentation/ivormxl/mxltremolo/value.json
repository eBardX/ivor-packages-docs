{"kind":"symbol","identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo\/value","interfaceLanguage":"swift"},"metadata":{"externalID":"s:7IvorMXL10MXLTremoloV5valueAA0C5MarksVvp","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"value","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL15MXLTremoloMarksV","text":"MXLTremoloMarks","kind":"typeIdentifier"}],"roleHeading":"Instance Property","role":"symbol","title":"value","modules":[{"name":"IvorMXL"}],"symbolKind":"property"},"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"type":"text","text":"The value of this element."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxltremolo\/value"]}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo"]]},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"value","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL15MXLTremoloMarksV","text":"MXLTremoloMarks","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremoloMarks","kind":"typeIdentifier"}],"languages":["swift"]}],"kind":"declarations"}],"sections":[],"references":{"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLTremolo":{"url":"\/documentation\/ivormxl\/mxltremolo","abstract":[{"type":"text","text":"The tremolo ornament can be used to indicate single-note, double-note, or unmeasured tremolos. Single-note"},{"type":"text","text":" "},{"type":"text","text":"tremolos use the single type, double-note tremolos use the start and stop types, and unmeasured tremolos use"},{"type":"text","text":" "},{"type":"text","text":"the unmeasured type. The default is “single” for compatibility with Version 1.1. The text of the element"},{"type":"text","text":" "},{"type":"text","text":"indicates the number of tremolo marks and is an integer from 0 to 8. Note that the number of attached beams is"},{"type":"text","text":" "},{"type":"text","text":"not included in this value, but is represented separately using the beam element. The value should be 0 for"},{"type":"text","text":" "},{"type":"text","text":"unmeasured tremolos."}],"title":"MXLTremolo","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTremolo"}],"navigatorTitle":[{"kind":"identifier","text":"MXLTremolo"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo","kind":"symbol","type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLTremolo/value":{"abstract":[{"type":"text","text":"The value of this element."}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo\/value","url":"\/documentation\/ivormxl\/mxltremolo\/value","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"value","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLTremoloMarks","preciseIdentifier":"s:7IvorMXL15MXLTremoloMarksV","kind":"typeIdentifier"}],"title":"value","role":"symbol","type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLTremoloMarks":{"url":"\/documentation\/ivormxl\/mxltremolomarks","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"text":"MXLTremoloMarks","kind":"identifier"}],"title":"MXLTremoloMarks","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremoloMarks","navigatorTitle":[{"kind":"identifier","text":"MXLTremoloMarks"}],"role":"symbol","type":"topic","kind":"symbol","abstract":[{"text":"The number of tremolo marks is represented by a number from 0 to 8: the same as beam-level with 0 added.","type":"text"}]}}}