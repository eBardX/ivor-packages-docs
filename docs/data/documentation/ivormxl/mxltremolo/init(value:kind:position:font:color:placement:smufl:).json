n/IvorMXL/MXLTremolo/Kind-swift.enum":{"abstract":[{"text":"The tremolo-type is used to distinguish double-note, single-note, and unmeasured tremolos.","type":"text"}],"title":"MXLTremolo.Kind","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Kind"}],"navigatorTitle":[{"kind":"identifier","text":"Kind"}],"type":"topic","url":"\/documentation\/ivormxl\/mxltremolo\/kind-swift.enum","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo\/Kind-swift.enum"},"doc://IvorMXL/documentation/IvorMXL/MXLSmuflGlyphName":{"abstract":[{"text":"The smufl-glyph-name type is used for attributes that reference a specific Standard Music Font Layout (SMuFL)","type":"text"},{"text":" ","type":"text"},{"text":"character. The value is a SMuFL canonical glyph name, not a code point. For instance, the value for a standard","type":"text"},{"text":" ","type":"text"},{"text":"piano pedal mark would be keyboardPedalPed, not U+E650.","type":"text"}],"title":"MXLSmuflGlyphName","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLSmuflGlyphName"}],"navigatorTitle":[{"kind":"identifier","text":"MXLSmuflGlyphName"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlsmuflglyphname","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSmuflGlyphName"},"doc://IvorMXL/documentation/IvorMXL/MXLTremoloMarks":{"navigatorTitle":[{"kind":"identifier","text":"MXLTremoloMarks"}],"abstract":[{"text":"The number of tremolo marks is represented by a number from 0 to 8: the same as beam-level with 0 added.","type":"text"}],"title":"MXLTremoloMarks","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremoloMarks","kind":"symbol","url":"\/documentation\/ivormxl\/mxltremolomarks","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTremoloMarks"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLPosition":{"title":"MXLPosition","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPosition"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlposition","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","abstract":[{"text":"For most elements, any program will compute a default x and y position. The position attributes let this be","type":"text"},{"text":" ","type":"text"},{"text":"changed two ways.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"MXLPosition"}]},"doc://IvorMXL/documentation/IvorMXL/MXLTremolo":{"abstract":[{"type":"text","text":"The tremolo ornament can be used to indicate single-note, double-note, or unmeasured tremolos. Single-note"},{"type":"text","text":" "},{"type":"text","text":"tremolos use the single type, double-note tremolos use the start and stop types, and unmeasured tremolos use"},{"type":"text","text":" "},{"type":"text","text":"the unmeasured type. The default is “single” for compatibility with Version 1.1. The text of the element"},{"type":"text","text":" "},{"type":"text","text":"indicates the number of tremolo marks and is an integer from 0 to 8. Note that the number of attached beams is"},{"type":"text","text":" "},{"type":"text","text":"not included in this value, but is represented separately using the beam element. The value should be 0 for"},{"type":"text","text":" "},{"type":"text","text":"unmeasured tremolos."}],"title":"MXLTremolo","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTremolo","kind":"identifier"}],"navigatorTitle":[{"text":"MXLTremolo","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxltremolo","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo"},"doc://IvorMXL/documentation/IvorMXL/MXLFont":{"navigatorTitle":[{"text":"MXLFont","kind":"identifier"}],"abstract":[{"text":"The font attribute group gathers together attributes for determining the font within a credit or direction.","type":"text"},{"text":" ","type":"text"},{"text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of","type":"text"},{"text":" ","type":"text"},{"text":"font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric","type":"text"},{"text":" ","type":"text"},{"text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font","type":"text"},{"text":" ","type":"text"},{"text":"vs. a music font.","type":"text"}],"title":"MXLFont","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","kind":"symbol","url":"\/documentation\/ivormxl\/mxlfont","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLFont","kind":"identifier"}],"role":"symbol"}}}