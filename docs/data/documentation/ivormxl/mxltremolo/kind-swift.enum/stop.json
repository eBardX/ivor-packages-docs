ier"}],"abstract":[{"type":"text","text":"The tremolo ornament can be used to indicate single-note, double-note, or unmeasured tremolos. Single-note"},{"type":"text","text":" "},{"type":"text","text":"tremolos use the single type, double-note tremolos use the start and stop types, and unmeasured tremolos use"},{"type":"text","text":" "},{"type":"text","text":"the unmeasured type. The default is “single” for compatibility with Version 1.1. The text of the element"},{"type":"text","text":" "},{"type":"text","text":"indicates the number of tremolo marks and is an integer from 0 to 8. Note that the number of attached beams is"},{"type":"text","text":" "},{"type":"text","text":"not included in this value, but is represented separately using the beam element. The value should be 0 for"},{"type":"text","text":" "},{"type":"text","text":"unmeasured tremolos."}],"kind":"symbol","type":"topic","navigatorTitle":[{"text":"MXLTremolo","kind":"identifier"}],"title":"MXLTremolo"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLTremolo/Kind-swift.enum/stop":{"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo\/Kind-swift.enum\/stop","url":"\/documentation\/ivormxl\/mxltremolo\/kind-swift.enum\/stop","abstract":[{"text":"The end of a double-note tremolo.","type":"text"}],"type":"topic","role":"symbol","title":"MXLTremolo.Kind.stop","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"stop"}]}}}