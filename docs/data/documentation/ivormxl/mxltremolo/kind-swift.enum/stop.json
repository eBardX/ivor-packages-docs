{"kind":"symbol","abstract":[{"type":"text","text":"The end of a double-note tremolo."}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo\/Kind-swift.enum"]]},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"stop"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxltremolo\/kind-swift.enum\/stop"]}],"metadata":{"symbolKind":"case","modules":[{"name":"IvorMXL"}],"role":"symbol","roleHeading":"Case","title":"MXLTremolo.Kind.stop","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"stop"}],"externalID":"s:7IvorMXL10MXLTremoloV4KindO4stopyA2EmF"},"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo\/Kind-swift.enum\/stop","interfaceLanguage":"swift"},"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLTremolo/Kind-swift.enum/stop":{"abstract":[{"type":"text","text":"The end of a double-note tremolo."}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxltremolo\/kind-swift.enum\/stop","role":"symbol","title":"MXLTremolo.Kind.stop","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo\/Kind-swift.enum\/stop","type":"topic","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"stop","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLTremolo":{"type":"topic","abstract":[{"text":"The tremolo ornament can be used to indicate single-note, double-note, or unmeasured tremolos. Single-note","type":"text"},{"text":" ","type":"text"},{"text":"tremolos use the single type, double-note tremolos use the start and stop types, and unmeasured tremolos use","type":"text"},{"text":" ","type":"text"},{"text":"the unmeasured type. The default is “single” for compatibility with Version 1.1. The text of the element","type":"text"},{"text":" ","type":"text"},{"text":"indicates the number of tremolo marks and is an integer from 0 to 8. Note that the number of attached beams is","type":"text"},{"text":" ","type":"text"},{"text":"not included in this value, but is represented separately using the beam element. The value should be 0 for","type":"text"},{"text":" ","type":"text"},{"text":"unmeasured tremolos.","type":"text"}],"url":"\/documentation\/ivormxl\/mxltremolo","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTremolo"}],"kind":"symbol","title":"MXLTremolo","navigatorTitle":[{"kind":"identifier","text":"MXLTremolo"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLTremolo/Kind-swift.enum":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo\/Kind-swift.enum","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Kind"}],"title":"MXLTremolo.Kind","kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxltremolo\/kind-swift.enum","abstract":[{"type":"text","text":"The tremolo-type is used to distinguish double-note, single-note, and unmeasured tremolos."}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Kind"}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"}}}