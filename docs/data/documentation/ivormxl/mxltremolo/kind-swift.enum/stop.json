{"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxltremolo\/kind-swift.enum\/stop"]}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo\/Kind-swift.enum\/stop","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo\/Kind-swift.enum"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"type":"text","text":"The end of a double-note tremolo."}],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"stop"}]}]}],"metadata":{"title":"MXLTremolo.Kind.stop","role":"symbol","externalID":"s:7IvorMXL10MXLTremoloV4KindO4stopyA2EmF","fragments":[{"kind":"keyword","text":"case"},{"text":" ","kind":"text"},{"kind":"identifier","text":"stop"}],"modules":[{"name":"IvorMXL"}],"symbolKind":"case","roleHeading":"Case"},"references":{"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLTremolo/Kind-swift.enum/stop":{"type":"topic","abstract":[{"text":"The end of a double-note tremolo.","type":"text"}],"title":"MXLTremolo.Kind.stop","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo\/Kind-swift.enum\/stop","kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxltremolo\/kind-swift.enum\/stop","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"stop","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLTremolo":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTremolo"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo","navigatorTitle":[{"kind":"identifier","text":"MXLTremolo"}],"url":"\/documentation\/ivormxl\/mxltremolo","title":"MXLTremolo","type":"topic","abstract":[{"type":"text","text":"The tremolo ornament can be used to indicate single-note, double-note, or unmeasured tremolos. Single-note"},{"type":"text","text":" "},{"type":"text","text":"tremolos use the single type, double-note tremolos use the start and stop types, and unmeasured tremolos use"},{"type":"text","text":" "},{"type":"text","text":"the unmeasured type. The default is “single” for compatibility with Version 1.1. The text of the element"},{"type":"text","text":" "},{"type":"text","text":"indicates the number of tremolo marks and is an integer from 0 to 8. Note that the number of attached beams is"},{"type":"text","text":" "},{"type":"text","text":"not included in this value, but is represented separately using the beam element. The value should be 0 for"},{"type":"text","text":" "},{"type":"text","text":"unmeasured tremolos."}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLTremolo/Kind-swift.enum":{"type":"topic","abstract":[{"text":"The tremolo-type is used to distinguish double-note, single-note, and unmeasured tremolos.","type":"text"}],"title":"MXLTremolo.Kind","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo\/Kind-swift.enum","kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxltremolo\/kind-swift.enum","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Kind","kind":"identifier"}],"navigatorTitle":[{"text":"Kind","kind":"identifier"}]}}}