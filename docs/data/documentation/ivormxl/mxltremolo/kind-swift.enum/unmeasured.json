{"abstract":[{"text":"An unmeasured tremolo.","type":"text"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"title":"MXLTremolo.Kind.unmeasured","modules":[{"name":"IvorMXL"}],"externalID":"s:7IvorMXL10MXLTremoloV4KindO10unmeasuredyA2EmF","role":"symbol","symbolKind":"case","roleHeading":"Case","fragments":[{"text":"case","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"unmeasured"}]},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo\/Kind-swift.enum"]]},"variants":[{"paths":["\/documentation\/ivormxl\/mxltremolo\/kind-swift.enum\/unmeasured"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"unmeasured","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}]}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo\/Kind-swift.enum\/unmeasured","interfaceLanguage":"swift"},"sections":[],"kind":"symbol","references":{"doc://IvorMXL/documentation/IvorMXL/MXLTremolo/Kind-swift.enum":{"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo\/Kind-swift.enum","url":"\/documentation\/ivormxl\/mxltremolo\/kind-swift.enum","abstract":[{"text":"The tremolo-type is used to distinguish double-note, single-note, and unmeasured tremolos.","type":"text"}],"type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Kind"}],"title":"MXLTremolo.Kind","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Kind"}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLTremolo/Kind-swift.enum/unmeasured":{"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo\/Kind-swift.enum\/unmeasured","url":"\/documentation\/ivormxl\/mxltremolo\/kind-swift.enum\/unmeasured","abstract":[{"text":"An unmeasured tremolo.","type":"text"}],"type":"topic","role":"symbol","title":"MXLTremolo.Kind.unmeasured","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"unmeasured"}]},"doc://IvorMXL/documentation/IvorMXL/MXLTremolo":{"role":"symbol","url":"\/documentation\/ivormxl\/mxltremolo","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTremolo","kind":"identifier"}],"abstract":[{"type":"text","text":"The tremolo ornament can be used to indicate single-note, double-note, or unmeasured tremolos. Single-note"},{"type":"text","text":" "},{"type":"text","text":"tremolos use the single type, double-note tremolos use the start and stop types, and unmeasured tremolos use"},{"type":"text","text":" "},{"type":"text","text":"the unmeasured type. The default is “single” for compatibility with Version 1.1. The text of the element"},{"type":"text","text":" "},{"type":"text","text":"indicates the number of tremolo marks and is an integer from 0 to 8. Note that the number of attached beams is"},{"type":"text","text":" "},{"type":"text","text":"not included in this value, but is represented separately using the beam element. The value should be 0 for"},{"type":"text","text":" "},{"type":"text","text":"unmeasured tremolos."}],"kind":"symbol","type":"topic","navigatorTitle":[{"text":"MXLTremolo","kind":"identifier"}],"title":"MXLTremolo"}}}