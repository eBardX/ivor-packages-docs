XL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLTremolo":{"url":"\/documentation\/ivormxl\/mxltremolo","abstract":[{"type":"text","text":"The tremolo ornament can be used to indicate single-note, double-note, or unmeasured tremolos. Single-note"},{"type":"text","text":" "},{"type":"text","text":"tremolos use the single type, double-note tremolos use the start and stop types, and unmeasured tremolos use"},{"type":"text","text":" "},{"type":"text","text":"the unmeasured type. The default is “single” for compatibility with Version 1.1. The text of the element"},{"type":"text","text":" "},{"type":"text","text":"indicates the number of tremolo marks and is an integer from 0 to 8. Note that the number of attached beams is"},{"type":"text","text":" "},{"type":"text","text":"not included in this value, but is represented separately using the beam element. The value should be 0 for"},{"type":"text","text":" "},{"type":"text","text":"unmeasured tremolos."}],"title":"MXLTremolo","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTremolo"}],"navigatorTitle":[{"kind":"identifier","text":"MXLTremolo"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo","kind":"symbol","type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLTremolo/Kind-swift.enum/unmeasured":{"url":"\/documentation\/ivormxl\/mxltremolo\/kind-swift.enum\/unmeasured","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"An unmeasured tremolo."}],"role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo\/Kind-swift.enum\/unmeasured","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"unmeasured","kind":"identifier"}],"title":"MXLTremolo.Kind.unmeasured"}}}