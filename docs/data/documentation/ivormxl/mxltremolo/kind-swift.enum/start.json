tifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLTremolo":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTremolo"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo","navigatorTitle":[{"kind":"identifier","text":"MXLTremolo"}],"url":"\/documentation\/ivormxl\/mxltremolo","title":"MXLTremolo","type":"topic","abstract":[{"type":"text","text":"The tremolo ornament can be used to indicate single-note, double-note, or unmeasured tremolos. Single-note"},{"type":"text","text":" "},{"type":"text","text":"tremolos use the single type, double-note tremolos use the start and stop types, and unmeasured tremolos use"},{"type":"text","text":" "},{"type":"text","text":"the unmeasured type. The default is “single” for compatibility with Version 1.1. The text of the element"},{"type":"text","text":" "},{"type":"text","text":"indicates the number of tremolo marks and is an integer from 0 to 8. Note that the number of attached beams is"},{"type":"text","text":" "},{"type":"text","text":"not included in this value, but is represented separately using the beam element. The value should be 0 for"},{"type":"text","text":" "},{"type":"text","text":"unmeasured tremolos."}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLTremolo/Kind-swift.enum/start":{"type":"topic","abstract":[{"text":"The start of a double-note tremolo.","type":"text"}],"title":"MXLTremolo.Kind.start","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo\/Kind-swift.enum\/start","kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxltremolo\/kind-swift.enum\/start","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"start","kind":"identifier"}]}}}