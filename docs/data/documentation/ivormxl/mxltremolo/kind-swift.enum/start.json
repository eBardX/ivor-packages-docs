{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo\/Kind-swift.enum\/start"},"sections":[],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"start"}]}]}],"metadata":{"roleHeading":"Case","modules":[{"name":"IvorMXL"}],"externalID":"s:7IvorMXL10MXLTremoloV4KindO5startyA2EmF","role":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"start"}],"symbolKind":"case","title":"MXLTremolo.Kind.start"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo\/Kind-swift.enum"]]},"abstract":[{"type":"text","text":"The start of a double-note tremolo."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"paths":["\/documentation\/ivormxl\/mxltremolo\/kind-swift.enum\/start"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLTremolo/Kind-swift.enum":{"abstract":[{"text":"The tremolo-type is used to distinguish double-note, single-note, and unmeasured tremolos.","type":"text"}],"title":"MXLTremolo.Kind","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Kind"}],"navigatorTitle":[{"kind":"identifier","text":"Kind"}],"type":"topic","url":"\/documentation\/ivormxl\/mxltremolo\/kind-swift.enum","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo\/Kind-swift.enum"},"doc://IvorMXL/documentation/IvorMXL/MXLTremolo/Kind-swift.enum/start":{"url":"\/documentation\/ivormxl\/mxltremolo\/kind-swift.enum\/start","abstract":[{"type":"text","text":"The start of a double-note tremolo."}],"kind":"symbol","title":"MXLTremolo.Kind.start","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo\/Kind-swift.enum\/start","type":"topic","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"start","kind":"identifier"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLTremolo":{"abstract":[{"type":"text","text":"The tremolo ornament can be used to indicate single-note, double-note, or unmeasured tremolos. Single-note"},{"type":"text","text":" "},{"type":"text","text":"tremolos use the single type, double-note tremolos use the start and stop types, and unmeasured tremolos use"},{"type":"text","text":" "},{"type":"text","text":"the unmeasured type. The default is “single” for compatibility with Version 1.1. The text of the element"},{"type":"text","text":" "},{"type":"text","text":"indicates the number of tremolo marks and is an integer from 0 to 8. Note that the number of attached beams is"},{"type":"text","text":" "},{"type":"text","text":"not included in this value, but is represented separately using the beam element. The value should be 0 for"},{"type":"text","text":" "},{"type":"text","text":"unmeasured tremolos."}],"title":"MXLTremolo","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTremolo","kind":"identifier"}],"navigatorTitle":[{"text":"MXLTremolo","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxltremolo","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo"}}}