um"]]},"sections":[],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLTremolo":{"type":"topic","abstract":[{"text":"The tremolo ornament can be used to indicate single-note, double-note, or unmeasured tremolos. Single-note","type":"text"},{"text":" ","type":"text"},{"text":"tremolos use the single type, double-note tremolos use the start and stop types, and unmeasured tremolos use","type":"text"},{"text":" ","type":"text"},{"text":"the unmeasured type. The default is “single” for compatibility with Version 1.1. The text of the element","type":"text"},{"text":" ","type":"text"},{"text":"indicates the number of tremolo marks and is an integer from 0 to 8. Note that the number of attached beams is","type":"text"},{"text":" ","type":"text"},{"text":"not included in this value, but is represented separately using the beam element. The value should be 0 for","type":"text"},{"text":" ","type":"text"},{"text":"unmeasured tremolos.","type":"text"}],"url":"\/documentation\/ivormxl\/mxltremolo","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTremolo"}],"kind":"symbol","title":"MXLTremolo","navigatorTitle":[{"kind":"identifier","text":"MXLTremolo"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLTremolo/Kind-swift.enum/!=(_:_:)":{"abstract":[],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo\/Kind-swift.enum\/!=(_:_:)","title":"!=(_:_:)","url":"\/documentation\/ivormxl\/mxltremolo\/kind-swift.enum\/!=(_:_:)","type":"topic","role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"!=","kind":"identifier"},{"text":" ","kind":"text"},{"text":"(","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Bool