{"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo\/Kind-swift.enum\/single","interfaceLanguage":"swift"},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo\/Kind-swift.enum"]]},"abstract":[{"text":"A single-note tremolo.","type":"text"}],"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"single"}]}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"single"}],"symbolKind":"case","modules":[{"name":"IvorMXL"}],"roleHeading":"Case","externalID":"s:7IvorMXL10MXLTremoloV4KindO6singleyA2EmF","title":"MXLTremolo.Kind.single","role":"symbol"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxltremolo\/kind-swift.enum\/single"]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLTremolo/Kind-swift.enum/single":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo\/Kind-swift.enum\/single","kind":"symbol","abstract":[{"text":"A single-note tremolo.","type":"text"}],"url":"\/documentation\/ivormxl\/mxltremolo\/kind-swift.enum\/single","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"single"}],"type":"topic","title":"MXLTremolo.Kind.single","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLTremolo/Kind-swift.enum":{"url":"\/documentation\/ivormxl\/mxltremolo\/kind-swift.enum","abstract":[{"type":"text","text":"The tremolo-type is used to distinguish double-note, single-note, and unmeasured tremolos."}],"title":"MXLTremolo.Kind","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Kind"}],"navigatorTitle":[{"kind":"identifier","text":"Kind"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo\/Kind-swift.enum","kind":"symbol","type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLTremolo":{"url":"\/documentation\/ivormxl\/mxltremolo","abstract":[{"type":"text","text":"The tremolo ornament can be used to indicate single-note, double-note, or unmeasured tremolos. Single-note"},{"type":"text","text":" "},{"type":"text","text":"tremolos use the single type, double-note tremolos use the start and stop types, and unmeasured tremolos use"},{"type":"text","text":" "},{"type":"text","text":"the unmeasured type. The default is “single” for compatibility with Version 1.1. The text of the element"},{"type":"text","text":" "},{"type":"text","text":"indicates the number of tremolo marks and is an integer from 0 to 8. Note that the number of attached beams is"},{"type":"text","text":" "},{"type":"text","text":"not included in this value, but is represented separately using the beam element. The value should be 0 for"},{"type":"text","text":" "},{"type":"text","text":"unmeasured tremolos."}],"title":"MXLTremolo","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTremolo"}],"navigatorTitle":[{"kind":"identifier","text":"MXLTremolo"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo","kind":"symbol","type":"topic"}}}