{"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"roleHeading":"Structure","symbolKind":"struct","modules":[{"name":"IvorMXL"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLCredit","kind":"identifier"}],"title":"MXLCredit","navigatorTitle":[{"kind":"identifier","text":"MXLCredit"}],"externalID":"s:7IvorMXL9MXLCreditV","role":"symbol"},"kind":"symbol","variants":[{"paths":["\/documentation\/ivormxl\/mxlcredit"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLCredit","kind":"identifier"}]}]},{"kind":"content","content":[{"anchor":"overview","text":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"By default, a series of credit-words and credit-symbol elements within a single credit element follow one"},{"type":"text","text":" "},{"type":"text","text":"another in sequence visually. Non-positional formatting attributes are carried over from the previous element"},{"type":"text","text":" "},{"type":"text","text":"by default."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The page attribute for the credit element specifies the page number where the credit should appear. This is an"},{"type":"text","text":" "},{"type":"text","text":"integer value that starts with 1 for the first page. Its value is 1 by default. Since credits occur before the"},{"type":"text","text":" "},{"type":"text","text":"music, these page numbers do not refer to the page numbering specified by the print element’s page-number"},{"type":"text","text":" "},{"type":"text","text":"attribute."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The credit-type element indicates the purpose behind a credit. Multiple types of data may be combined in a"},{"type":"text","text":" "},{"type":"text","text":"single credit, so multiple elements may be used. Standard values include page number, title, subtitle,"},{"type":"text","text":" "},{"type":"text","text":"composer, arranger, lyricist, rights, and part name."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Maps the MusicXML "},{"type":"codeVoice","code":"<credit>"},{"type":"text","text":" element."}]}]}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCredit","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL"]]},"sections":[],"abstract":[{"text":"The credit type represents the appearance of the title, composer, arranger, lyricist, copyright, dedication,","type":"text"},{"text":" ","type":"text"},{"text":"and other text, symbols, and graphics that commonly appear on the first page of a score. The credit-words,","type":"text"},{"text":" ","type":"text"},{"text":"credit-symbol, and credit-image elements are similar to the words, symbol, and image elements for directions.","type":"text"},{"text":" ","type":"text"},{"text":"However, since the credit is not part of a measure, the default-x and default-y attributes adjust the origin","type":"text"},{"text":" ","type":"text"},{"text":"relative to the bottom left-hand corner of the page. The enclosure for credit-words and credit-symbol is none","type":"text"},{"text":" ","type":"text"},{"text":"by default.","type":"text"}],"topicSections":[{"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCredit\/init(id:kind:link:bookmark:content:page:)"],"title":"Initializers","generated":true,"anchor":"Initializers"},{"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCredit\/bookmark","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCredit\/content-swift.property","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCredit\/id","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCredit\/kind","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCredit\/link","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCredit\/pa