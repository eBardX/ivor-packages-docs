ext":" "},{"type":"text","text":"and other text, symbols, and graphics that commonly appear on the first page of a score. The credit-words,"},{"type":"text","text":" "},{"type":"text","text":"credit-symbol, and credit-image elements are similar to the words, symbol, and image elements for directions."},{"type":"text","text":" "},{"type":"text","text":"However, since the credit is not part of a measure, the default-x and default-y attributes adjust the origin"},{"type":"text","text":" "},{"type":"text","text":"relative to the bottom left-hand corner of the page. The enclosure for credit-words and credit-symbol is none"},{"type":"text","text":" "},{"type":"text","text":"by default."}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCredit","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLCredit"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"inlineContent":[{"type":"text","text":"By default, a series of credit-words and credit-symbol elements within a single credit element follow one"},{"type":"text","text":" "},{"type":"text","text":"another in sequence visually. Non-positional formatting attributes are carried over from the previous element"},{"type":"text","text":" "},{"type":"text","text":"by default."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The page attribute for the credit element specifies the page number where the credit should appear. This is an"},{"type":"text","text":" "},{"type":"text","text":"integer value that starts with 1 for the first page. Its value is 1 by default. Since credits occur before the"},{"type":"text","text":" "},{"type":"text","text":"music, these page numbers do not refer to the page numbering specified by the print element’s page-number"},{"type":"text","text":" "},{"type":"text","text":"attribute."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The credit-type element indicates the purpose behind a credit. Multiple types of data may be combined in a"},{"type":"text","text":" "},{"type":"text","text":"single credit, so multiple elements may be used. Standard values include page number, title, subtitle,"},{"type":"text","text":" "},{"type":"text","text":"composer, arranger, lyricist, rights, and part name."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Maps the MusicXML "},{"code":"<credit>","type":"codeVoice"},{"type":"text","text":" element."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLCredit/content-swift.property":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCredit\/content-swift.property","abstract":[{"type":"text","text":"One of the alternatives for Credit."}],"type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"content","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL9MXLCreditV7ContentO","text":"Content","kind":"typeIdentifier"}],"title":"content","url":"\/documentation\/ivormxl\/mxlcredit\/content-swift.property","role":"symbol","kind":"symbol"},"doc://IvorMXL/s8CopyableP":{"type":"unresolvable","identifier":"doc:\/\/IvorMXL\/s8CopyableP","title":"Swift.Copyable"},"doc://IvorMXL/documentation/IvorMXL/MXLCredit/id":{"abstract":[{"text":"The optional-unique-id attribute group allows an element to optionally specify an ID that is unique to the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"entire document. This attribute group is not used for a required id attribute, or for an id attribute that"},{"text":" ","type":"text"},{"type":"text","text":"specifies an id reference."}],"url":"\/documentation\/ivormxl\/mxlcredit\/id","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"