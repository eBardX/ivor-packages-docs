orMXL/MXLEnding/textX":{"role":"symbol","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"The horizontal offset specifying where the baseline of the start of the ending text appears, relative to the"},{"type":"text","text":" "},{"type":"text","text":"start of the ending line."}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"textX","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLTenths","preciseIdentifier":"s:7IvorMXL9MXLTenthsa","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"url":"\/documentation\/ivormxl\/mxlending\/textx","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/textX","title":"textX"},"doc://IvorMXL/documentation/IvorMXL/MXLEnding/system":{"kind":"symbol","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"system","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL17MXLSystemRelationO","text":"MXLSystemRelation","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/system","type":"topic","abstract":[{"text":"The system-relation attribute group distinguishes elements that are associated with a system rather than the","type":"text"},{"text":" ","type":"text"},{"text":"particular part where the element appears.","type":"text"}],"title":"system","url":"\/documentation\/ivormxl\/mxlending\/system"},"doc://IvorMXL/documentation/IvorMXL/MXLEnding/kind":{"kind":"symbol","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"kind","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL23MXLStartStopDiscontinueO","text":"MXLStartStopDiscontinue","kind":"typeIdentifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/kind","type":"topic","abstract":[{"text":"Whether this ending starts, stops, or discontinues, determining which barline it is associated with