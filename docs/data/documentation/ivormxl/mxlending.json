{"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLEnding"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"inlineContent":[{"type":"text","text":"The number attribute indicates which times the ending is played, similar to the time-only attribute used by"},{"type":"text","text":" "},{"type":"text","text":"other elements. While this often represents the numeric values for what is under the ending line, it can also"},{"type":"text","text":" "},{"type":"text","text":"indicate whether an ending is played during a larger dal segno or da capo repeat. Single endings such as “1”"},{"type":"text","text":" "},{"type":"text","text":"or comma-separated multiple endings such as “1,2” may be used. The ending element text is used when the text"},{"type":"text","text":" "},{"type":"text","text":"displayed in the ending is different than what appears in the number attribute. The print-object attribute is"},{"type":"text","text":" "},{"type":"text","text":"used to indicate when an ending is present but not printed, as is often the case for many parts in a full"},{"type":"text","text":" "},{"type":"text","text":"score."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Maps the MusicXML "},{"type":"codeVoice","code":"<ending>"},{"type":"text","text":" element."}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL"]]},"metadata":{"roleHeading":"Structure","symbolKind":"struct","navigatorTitle":[{"text":"MXLEnding","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLEnding","kind":"identifier"}],"title":"MXLEnding","externalID":"s:7IvorMXL9MXLEndingV","modules":[{"name":"IvorMXL"}],"role":"symbol"},"relationshipsSections":[{"type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/IvorMXL\/s8CopyableP","doc:\/\/IvorMXL\/SQ","doc:\/\/IvorMXL\/s9EscapableP","doc:\/\/IvorMXL\/SH","doc:\/\/IvorMXL\/s8SendableP","doc:\/\/IvorMXL\/s16SendableMetatypeP"],"kind":"relationships"}],"abstract":[{"type":"text","text":"The ending type represents multiple (e.g. first and second) endings. Typically, the start type is associated"},{"type":"text","text":" "},{"type":"text","text":"with the left barline of the first measure in an ending. The stop and discontinue types are associated with"},{"type":"text","text":" "},{"text":"the right barline of the last measure in an ending. Stop is used when the ending mark concludes with a","type":"text"},{"text":" ","type":"text"},{"text":"downward jog, as is typical for first endings. Discontinue is used when there is no downward jog, as is","type":"text"},{"text":" ","type":"text"},{"text":"typical for second endings that do not conclude a piece. The length of the jog can be specified using the end-","type":"text"},{"text":" ","type":"text"},{"text":"length attribute. The text-x and text-y attributes are offsets that specify where the baseline of the start of","type":"text"},{"text":" ","type":"text"},{"text":"the ending text appears, relative to the start of the ending line.","type":"text"}],"sections":[],"topicSections":[{"title":"Initializers","anchor":"Initializers","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/init(value:number:kind:printsObject:position:font:color:system:endLength:textX:textY:)"],"generated":true},{"title":"Instance Properties","anchor":"Instance-Properties","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/color","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/endLength","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/font","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/kind","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/number-swift.property","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/position","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/printsObject","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/system","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/textX","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/textY","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/value"],"generated":true},{"anchor":"Type-Aliases","title":"Type Aliases","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/Number-swift.typealias"],"generated":true},{"title":"Default Implementations","anchor":"Default-Implementations","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/Equatable-Implementations"],"generated":true}],"variants":[{"paths":["\/documentation\/ivormxl\/mxlending"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://IvorMXL/SQ":{"identifier":"doc:\/\/IvorMXL\/SQ","title":"Swift.Equatable","type":"unresolvable"},"doc://IvorMXL/documentation/IvorMXL/MXLEnding/position":{"url":"\/documentation\/ivormxl\/mxlending\/position","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/position","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"position"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLPosition","preciseIdentifier":"s:7IvorMXL11MXLPositionV"}],"kind":"symbol","abstract":[{"text":"For most elements, any program will compute a default x and y position. The position attributes let this be","type":"text"},{"text":" ","type":"text"},{"text":"changed two ways.","type":"text"}],"type":"topic","title":"position"},"doc://IvorMXL/documentation/IvorMXL/MXLEnding/system":{"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlending\/system","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"system","kind":"identifi