{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlending"]}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL"]]},"sections":[],"kind":"symbol","topicSections":[{"generated":true,"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/init(value:number:kind:printsObject:position:font:color:system:endLength:textX:textY:)"]},{"generated":true,"anchor":"Instance-Properties","title":"Instance Properties","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/color","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/endLength","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/font","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/kind","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/number-swift.property","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/position","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/printsObject","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/system","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/textX","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/textY","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/value"]},{"generated":true,"anchor":"Type-Aliases","title":"Type Aliases","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/Number-swift.typealias"]},{"generated":true,"anchor":"Default-Implementations","title":"Default Implementations","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/Equatable-Implementations"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding"},"abstract":[{"type":"text","text":"The ending type represents multiple (e.g. first and second) endings. Typically, the start type is associated"},{"type":"text","text":" "},{"type":"text","text":"with the left barline of the first measure in an ending. The stop and discontinue types are associated with"},{"type":"text","text":" "},{"type":"text","text":"the right barline of the last measure in an ending. Stop is used when the ending mark concludes with a"},{"type":"text","text":" "},{"type":"text","text":"downward jog, as is typical for first endings. Discontinue is used when there is no downward jog, as is"},{"type":"text","text":" "},{"type":"text","text":"typical for second endings that do not conclude a piece. The length of the jog can be specified using the end-"},{"type":"text","text":" "},{"type":"text","text":"length attribute. The text-x and text-y attributes are offsets that specify where the baseline of the start of"},{"type":"text","text":" "},{"type":"text","text":"the ending text appears, relative to the start of the ending line."}],"schemaVersion":{"minor":3,"major":0,"patch":0},"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/IvorMXL\/s8CopyableP","doc:\/\/IvorMXL\/SQ","doc:\/\/IvorMXL\/s9EscapableP","doc:\/\/IvorMXL\/SH","doc:\/\/IvorMXL\/s8SendableP","doc:\/\/IvorMXL\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships"}],"metadata":{"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLEnding","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"MXLEnding"}],"externalID":"s:7IvorMXL9MXLEndingV","roleHeading":"Structure","symbolKind":"struct","title":"MXLEnding","modules":[{"name":"IvorMXL"}]},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLEnding","kind":"identifier"}],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"The number attribute indicates which times the ending is played, similar to the time-only attribute used by","type":"text"},{"text":" ","type":"text"},{"text":"other elements. While this often represents the numeric values for what is under the ending line, it can also","type":"text"},{"text":" ","type":"text"},{"text":"indicate whether an ending is played during a larger dal segno or da capo repeat. Single endings such as “1”","type":"text"},{"text":" ","type":"text"},{"text":"or comma-separated multiple endings such as “1,2” may be used. The ending element text is used when the text","type":"text"},{"text":" ","type":"text"},{"text":"displayed in the ending is different than what appears in the number attribute. The print-object attribute is","type":"text"},{"text":" ","type":"text"},{"text":"used to indicate when an ending is present but not printed, as is often the case for many parts in a full","type":"text"},{"text":" ","type":"text"},{"text":"score.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Maps the MusicXML "},{"type":"codeVoice","code":"<ending>"},{"type":"text","text":" element."}]}],"kind":"content"}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLEnding/font":{"type":"topic","role":"symbol","abstract":[{"type":"text","text":"The font attribute group gathers together attributes for determining the font within a credit or direction."},{"type":"text","text":" "},{"type":"text","text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of"},{"type":"text","text":" "},{"type":"text","text":"font names.The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric"},{"type":"text","text":" "},{"type":"text","text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font"},{"type":"text","text":" "},{"type":"text","text":"vs. a music font."}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/font","title":"font","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"font"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL7MXLFontV","kind":"typeIdentifier","text":"MXLFont"}],"url":"\/documentation\/ivormxl\/mxlending\/font"},"doc://IvorMXL/SH":{"type":"unresolvable","title":"Swift.Hashable","identifier":"doc:\/\/IvorMXL\/SH"},"doc://IvorMXL/documentation/IvorMXL/MXLEnding/textY":{"url":"\/documentation\/ivormxl\/mxlending\/texty","role":"symbol","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"textY","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLTenths","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLTenthsa"},{"text":"?","kind":"text"}],"abstract":[{"type":"text","text":"The vertical offset specifying where the baseline of the start of the ending text appears, relative to the"},{"type":"text","text":" "},{"type":"text","text":"start of the ending line."}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/textY","title":"textY"},"doc://IvorMXL/documentation/IvorMXL/MXLEnding/Number-swift.typealias":{"title":"MXLEnding.Number","url":"\/documentation\/ivormxl\/mxlending\/number-swift.typealias","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/Number-swift.typealias","type":"topic","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Number","kind":"identifier"}],"navigatorTitle":[{"text":"Number","kind":"identifier"}],"role":"symbol","abstract":[{"type":"text","text":"The ending-number type is used to specify the positive integers (without leading zeros) of the ending element."},{"type":"text","text":" "},{"type":"text","text":"An empty array is used when software knows that an ending is present, but cannot determine the type of the"},{"type":"text","text":" "},{"type":"text","text":"ending."}]},"doc://IvorMXL/documentation/IvorMXL/MXLEnding/position":{"kind":"symbol","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/position","fragments":[{"kind":"keyword","text":"let"},{"text":" ","kind":