r"},{"text":"?","kind":"text"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLEnding/textX":{"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlending\/textx","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"textX","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLTenths","preciseIdentifier":"s:7IvorMXL9MXLTenthsa","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"title":"textX","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/textX","abstract":[{"text":"The horizontal offset specifying where the baseline of the start of the ending text appears, relative to the","type":"text"},{"text":" ","type":"text"},{"text":"start of the ending line.","type":"text"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLEnding/font":{"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlending\/font","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"font","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLFont","preciseIdentifier":"s:7IvorMXL7MXLFontV","kind":"typeIdentifier"}],"title":"font","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/font","abstract":[{"text":"The font attribute group gathers together attributes for determining the font within a credit or direction.","type":"text"},{"text":" ","type":"text"},{"text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of","type":"text"},{"text":" ","type":"text"},{"text":"font names.The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric","type":"text"},{"text":" ","type":"text"},{"text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font","type":"text"},{"text":" ","type":"text"},{"text":"vs. a music font.","type":"text"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLEnding":{"title":"MXLEnding","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLEnding"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlending","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding","abstract":[{"text":"The ending type represents multiple (e.g. first and second) endings. Typically, the start type is associated","type":"text"},{"text":" ","type":"text"},{"text":"with the left barline of the first measure in an ending. The stop and discontinue types are associated with","type":"text"},{"text":" ","type":"text"},{"text":"the right barline of the last measure in an ending. Stop is used when the ending mark concludes with a","type":"text"},{"text":" ","type":"text"},{"text":"downward jog, as is typical for first endings. Discontinue is used when there is no downward jog, as is","type":"text"},{"text":" ","type":"text"},{"text":"typical for second endings that do not conclude a piece. The length of the jog can be specified using the end-","type":"text"},{"text":" ","type":"text"},{"text":"length attribute. The text-x and text-y attributes are offsets that specify where the baseline of the start of","type":"text"},{"text":" ","type":"text"},{"text":"the ending text appears, relative to the start of the ending line.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"MXLEnding"}]}}}