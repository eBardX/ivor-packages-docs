{"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","relationshipsSections":[{"type":"conformsTo","identifiers":["doc:\/\/IvorMXL\/s8CopyableP","doc:\/\/IvorMXL\/SQ","doc:\/\/IvorMXL\/s9EscapableP","doc:\/\/IvorMXL\/SH","doc:\/\/IvorMXL\/s8SendableP","doc:\/\/IvorMXL\/s16SendableMetatypeP"],"title":"Conforms To","kind":"relationships"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL"]]},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLEnding","kind":"identifier"}]}],"kind":"declarations"},{"content":[{"text":"Overview","level":2,"type":"heading","anchor":"overview"},{"inlineContent":[{"text":"The number attribute indicates which times the ending is played, similar to the time-only attribute used by","type":"text"},{"text":" ","type":"text"},{"text":"other elements. While this often represents the numeric values for what is under the ending line, it can also","type":"text"},{"text":" ","type":"text"},{"text":"indicate whether an ending is played during a larger dal segno or da capo repeat. Single endings such as “1”","type":"text"},{"text":" ","type":"text"},{"text":"or comma-separated multiple endings such as “1,2” may be used. The ending element text is used when the text","type":"text"},{"text":" ","type":"text"},{"text":"displayed in the ending is different than what appears in the number attribute. The print-object attribute is","type":"text"},{"text":" ","type":"text"},{"text":"used to indicate when an ending is present but not printed, as is often the case for many parts in a full","type":"text"},{"text":" ","type":"text"},{"text":"score.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Maps the MusicXML ","type":"text"},{"code":"<ending>","type":"codeVoice"},{"text":" element.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlending"]}],"abstract":[{"text":"The ending type represents multiple (e.g. first and second) endings. Typically, the start type is associated","type":"text"},{"text":" ","type":"text"},{"text":"with the left barline of the first measure in an ending. The stop and discontinue types are associated with","type":"text"},{"text":" ","type":"text"},{"text":"the right barline of the last measure in an ending. Stop is used when the ending mark concludes with a","type":"text"},{"text":" ","type":"text"},{"text":"downward jog, as is typical for first endings. Discontinue is used when there is no downward jog, as is","type":"text"},{"text":" ","type":"text"},{"text":"typical for second endings that do not conclude a piece. The length of the jog can be specified using the end-","type":"text"},{"text":" ","type":"text"},{"text":"length attribute. The text-x and text-y attributes are offsets that specify where the baseline of the start of","type":"text"},{"text":" ","type":"text"},{"text":"the ending text appears, relative to the start of the ending line.","type":"text"}],"topicSections":[{"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/init(value:number:kind:printsObject:position:font:color:system:endLength:textX:textY:)"],"title":"Initializers","generated":true,"anchor":"Initializers"},{"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/color","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/endLength","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/font","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/kind","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/number-swift.property","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/position","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/printsObject","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/system","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/textX","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/textY","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/value"],"title":"Instance Properties","generated":true,"anchor":"Instance-Properties"},{"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/Number-swift.typealias"],"title":"Type Aliases","generated":true,"anchor":"Type-Aliases"},{"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/Equatable-Implementations"],"title":"Default Implementations","generated":true,"anchor":"Default-Implementations"}],"metadata":{"symbolKind":"struct","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLEnding","kind":"identifier"}],"roleHeading":"Structure","modules":[{"name":"IvorMXL"}],"title":"MXLEnding","externalID":"s:7IvorMXL9MXLEndingV","navigatorTitle":[{"text":"MXLEnding","kind":"identifier"}]},"references":{"doc://IvorMXL/SH":{"type":"unresolvable","identifier":"doc:\/\/IvorMXL\/SH","title":"Swift.Hashable"},"doc://IvorMXL/documentation/IvorMXL/MXLEnding/Number-swift.typealias":{"kind":"symbol","role":"symbol","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Number","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/Number-swift.typealias","type":"topic","abstract":[{"text":"The ending-number type is used to specify the positive integers (without leading zeros) of the ending element.","type":"text"},{"text":" ","type":"text"},{"text":"An empty array is used when software knows that an ending is present, but cannot determine the type of the","type":"text"},{"text":" ","type":"text"},{"text":"ending.","type":"text"}],"title":"MXLEnding.Number","url":"\/documentation\/ivormxl\/mxlending\/number-swift.typealias","navigatorTitle":[{"text":"Number","kind":"identifier"}]},"doc://IvorMXL/s9EscapableP":{"type":"unresolvable","identifier":"doc:\/\/IvorMXL\/s9EscapableP","title"