e":"topic","title":"MXLPartLink","kind":"symbol","url":"\/documentation\/ivormxl\/mxlpartlink","abstract":[{"type":"text","text":"The part-link type allows MusicXML data for both score and parts to be contained within a single compressed"},{"type":"text","text":" "},{"type":"text","text":"MusicXML file. It links a score-part from a score document to MusicXML documents that contain parts data. In"},{"type":"text","text":" "},{"type":"text","text":"the case of a single compressed MusicXML file, the link href values are paths that are relative to the root"},{"type":"text","text":" "},{"type":"text","text":"folder of the zip file."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPartLink"}]},"doc://IvorMXL/documentation/IvorMXL/MXLInstrumentLink":{"abstract":[{"type":"text","text":"Multiple part-link elements can link a condensed part within a score file to multiple MusicXML parts files."},{"type":"text","text":" "},{"type":"text","text":"For example, a “Clarinet 1 and 2” part in a score file could link to separate “Clarinet 1” and “Clarinet 2”"},{"type":"text","text":" "},{"type":"text","text":"part files. The instrument-link type distinguishes which of the score-instruments within a score-part are in"},{"type":"text","text":" "},{"type":"text","text":"which part file. The instrument-link id attribute refers to a score-instrument id attribute."}],"navigatorTitle":[{"kind":"identifier","text":"MXLInstrumentLink"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLInstrumentLink","title":"MXLInstrumentLink","url":"\/documentation\/ivormxl\/mxlinstrumentlink","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLInstrumentLink"}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"