ext":"let","kind":"keyword"},{"kind":"text","text":" "},{"text":"instrumentLink","kind":"identifier"},{"text":": [","kind":"text"},{"text":"MXLInstrumentLink","preciseIdentifier":"s:7IvorMXL17MXLInstrumentLinkV","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartLink\/instrumentLink","abstract":[{"text":"Identifies the instruments used in the linked document.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLPartLink":{"abstract":[{"text":"The part-link type allows MusicXML data for both score and parts to be contained within a single compressed","type":"text"},{"text":" ","type":"text"},{"text":"MusicXML file. It links a score-part from a score document to MusicXML documents that contain parts data. In","type":"text"},{"text":" ","type":"text"},{"text":"the case of a single compressed MusicXML file, the link href values are paths that are relative to the root","type":"text"},{"text":" ","type":"text"},{"text":"folder of the zip file.","type":"text"}],"title":"MXLPartLink","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPartLink","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"MXLPartLink"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlpartlink","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartLink"},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLInstrumentLink":{"title":"MXLInstrumentLink","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLInstrumentLink","kind":"identifier"}],"kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxlinstrumentlink","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLInstrumentLink","abstract":[{"text":"Multiple part-link elements can link a condensed part within a score file to multiple MusicXML parts files.","type":"text"},{"text":" ","type":"text"},{"text":"For example, a “Clarinet 1 and 2” part in a score file could link to separate “Clarinet 1” and “Clarinet 2”","type":"text"},{"text":" ","type":"text"},{"text":"part files. The instrument-link type distinguishes which of the score-instruments within a score-part are in","type":"text"},{"text":" ","type":"text"},{"text":"which part file. The instrument-link id attribute refers to a score-instrument id attribute.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"MXLInstrumentLink"}]}}}