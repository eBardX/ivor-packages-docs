ract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLPartLink/instrumentLink":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartLink\/instrumentLink","type":"topic","abstract":[{"text":"Identifies the instruments used in the linked document.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlpartlink\/instrumentlink","role":"symbol","title":"instrumentLink","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"instrumentLink","kind":"identifier"},{"text":": [","kind":"text"},{"text":"MXLInstrumentLink","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL17MXLInstrumentLinkV"},{"text":"]","kind":"text"}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLPartLink":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartLink","url":"\/documentation\/ivormxl\/mxlpartlink","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPartLink"}],"abstract":[{"type":"text","text":"The part-link type allows MusicXML data for both score and parts to be contained within a single compressed"},{"type":"text","text":" "},{"type":"text","text":"MusicXML file. It links a score-part from a score document to MusicXML documents that contain parts data. In"},{"type":"text","text":" "},{"type":"text","text":"the case of a single compressed MusicXML file, the link href values are paths that are relative to the root"},{"type":"text","text":" "},{"type":"text","text":"folder of the zip file."}],"navigatorTitle":[{"text":"MXLPartLink","kind":"identifier"}],"title":"MXLPartLink","type":"topic","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLInstrumentLink":{"abstract":[{"type":"text","text":"Multiple part-link elements can link a condensed part within a score file to multiple MusicXML parts files."},{"type":"text","text":" "},{"type":"text","text":"For example, a “Clarinet 1 and 2” part in a score file could link to separate “Clarinet 1” and “Clarinet 2”"},{"type":"text","text":" "},{"type":"text","text":"part files. The instrument-link type distinguishes which of the score-instruments within a score-part are in"},{"type":"text","text":" "},{"type":"text","text":"which part file. The instrument-link id attribute refers to a score-instrument id attribute."}],"url":"\/documentation\/ivormxl\/mxlinstrumentlink","navigatorTitle":[{"text":"MXLInstrumentLink","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLInstrumentLink","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLInstrumentLink","kind":"identifier"}],"title":"MXLInstrumentLink","type":"topic","kind":"symbol"}}}