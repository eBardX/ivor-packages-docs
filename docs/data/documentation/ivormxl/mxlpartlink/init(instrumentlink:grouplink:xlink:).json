:\/\/IvorMXL\/documentation\/IvorMXL\/MXLXLink","kind":"typeIdentifier"},{"text":")","kind":"text"}],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"name":"instrumentLink","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Identifies the instruments used in the linked document."}]}]},{"name":"groupLink","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Multiple part-link elements can reference different types of linked documents, such"},{"type":"text","text":" "},{"type":"text","text":"as parts and condensed score. The optional group-link elements identify the groups"},{"type":"text","text":" "},{"type":"text","text":"used in the linked document. The content of a group-link element should match the"},{"type":"text","text":" "},{"type":"text","text":"content of a group element in the linked document."}]}]},{"name":"xlink","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The link-attributes group includes all the simple XLink attributes supported in the"},{"type":"text","text":" "},{"type":"text","text":"MusicXML format. It is also used to connect a MusicXML score with MusicXML parts or"},{"type":"text","text":" "},{"type":"text","text":"a MusicXML opus."}]}]}],"kind":"parameters"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlpartlink\/init(instrumentlink:grouplink:xlink:)"]}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartLink"]]},"sections":[],"references":{"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLPartLink/init(instrumentLink:groupLink:xlink:)":{"abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLPartLink"},{"type":"text","text":"."}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartLink\/init(instrumentLink:groupLink:xlink:)","title":"init(instrumentLink:groupLink:xlink:)","url":"\/documentation\/ivormxl\/mxlpartlink\/init(instrumentlink:grouplink:xlink:)","type":"topic","role":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"instrumentLink"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:7IvorMXL17MXLInstrumentLinkV","kind":"typeIdentifier","text":"MXLInstrumentLink"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"groupLink"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"xlink"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL8MXLXLinkV","kind":"typeIdentifier","text":"MXLXLink"},{"kind":"text","text":")"}]},"doc://IvorMXL/documentation/IvorMXL/MXLXLink":{"type":"topic","title":"MXLXLink","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLXLink","abstract":[{"type":"text","text":"The simple XLink attributes supported in the MusicXML format. It is also used to connect a MusicXML score with"},{"type":"text","text":" "},{"type":"text","text":"MusicXML parts or a MusicXML opus."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLXLink"}],"navigatorTitle":[{"kind":"identifier","text":"MXLXLink"}],"url":"\/documentation\/ivormxl\/mxlxlink"},"doc://IvorMXL/documentation/IvorMXL/MXLPartLink":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartLink","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLPartLink"}],"type":"topic","title":"MXLPartLink","kind":"symbol","url":"\/documentation\/ivormxl\/mxlpartlink","abstract":[{"type":"text","text":"The part-link type allows MusicXML data for both score and parts to be contained within a single compressed"},{"type":"text","text":" "},{"type":"text","text":"MusicXML file. It links a score-part from a score document to MusicXML documents that contain parts data. In"},{"type":"text","text":" "},{"type":"text","text":"the case of a single compressed MusicXML file, the link href values are paths that are relative to the root"},{"type":"text","text":" "},{"type":"text","text":"folder of the zip file."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPartLink"}]},"doc://IvorMXL/documentation/IvorMXL/MXLInstrumentLink":{"abstract":[{"type":"text","text":"Multiple part-link elements can link a condensed part within a score file to multiple MusicXML parts files."},{"type":"text","text":" "},{"type":"text","text":"For example, a “Clarinet 1 and 2” part in a score file could link to separate “Clarinet 1” and “Clarinet 2”"},{"type":"text","text":" "},{"type":"text","text":"part files. The instrument-link type distinguishes which of the score-instruments within a score-part are in"},{"type":"text","text":" "},{"type":"text","text":"which part file. The instrument-link id attribute refers to a score-instrument id attribute."}],"navigatorTitle":[{"kind":"identifier","text":"MXLInstrumentLink"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLInstrumentLink","title":"MXLInstrumentLink","url":"\/documentation\/ivormxl\/mxlinstrumentlink","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLInstrumentLink"}]}}}