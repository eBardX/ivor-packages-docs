": ","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLXLink","text":"MXLXLink","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLXLinkV"},{"text":")","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"content":[{"inlineContent":[{"text":"Identifies the instruments used in the linked document.","type":"text"}],"type":"paragraph"}],"name":"instrumentLink"},{"content":[{"inlineContent":[{"text":"Multiple part-link elements can reference different types of linked documents, such as parts and condensed score. The optional group-link elements identify the groups used in the linked document. The content of a group-link element should match the content of a group element in the linked document.","type":"text"}],"type":"paragraph"}],"name":"groupLink"},{"content":[{"inlineContent":[{"text":"The link-attributes group includes all the simple XLink attributes supported in the MusicXML format. It is also used to connect a MusicXML score with MusicXML parts or a MusicXML opus.","type":"text"}],"type":"paragraph"}],"name":"xlink"}],"kind":"parameters"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlpartlink\/init(instrumentlink:grouplink:xlink:)"]}],"kind":"symbol","references":{"doc://IvorMXL/documentation/IvorMXL/MXLXLink":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlxlink","title":"MXLXLink","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLXLink"}],"navigatorTitle":[{"text":"MXLXLink","kind":"identifier"}],"abstract":[{"text":"The simple XLink attributes supported in the MusicXML format. It is also used to connect a MusicXML score with","type":"text"},{"text":" ","type":"text"},{"text":"MusicXML parts or a MusicXML opus.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLXLink"},"doc://IvorMXL/documentation/IvorMXL/MXLInstrumentLink":{"abstract":[{"type":"text","text":"Multiple part-link elements can link a condensed part within a score file to multiple MusicXML parts files."},{"type":"text","text":" "},{"type":"text","text":"For example, a “Clarinet 1 and 2” part in a score file could link to separate “Clarinet 1” and “Clarinet 2”"},{"type":"text","text":" "},{"type":"text","text":"part files. The instrument-link type distinguishes which of the score-instruments within a score-part are in"},{"type":"text","text":" "},{"type":"text","text":"which part file. The instrument-link id attribute refers to a score-instrument id attribute."}],"url":"\/documentation\/ivormxl\/mxlinstrumentlink","navigatorTitle":[{"text":"MXLInstrumentLink","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLInstrumentLink","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLInstrumentLink","kind":"identifier"}],"title":"MXLInstrumentLink","type":"topic","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLPartLink":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartLink","url":"\/documentation\/ivormxl\/mxlpartlink","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPartLink"}],"abstract":[{"type":"text","text":"The part-link type allows MusicXML data for both score and parts to be contained within a single compressed"},{"type":"text","text":" "},{"type":"text","text":"MusicXML file. It links a score-part from a score document to MusicXML documents that contain parts data. In"},{"type":"text","text":" "},{"type":"text","text":"the case of a single compressed MusicXML file, the link href values are paths that are relative to the root"},{"type":"text","text":" "},{"type":"text","text":"folder of the zip file."}],"navigatorTitle":[{"text":"MXLPartLink","kind":"identifier"}],"title":"MXLPartLink","type":"topic","kind":"symbol"},"doc://IvorMXL/documentation