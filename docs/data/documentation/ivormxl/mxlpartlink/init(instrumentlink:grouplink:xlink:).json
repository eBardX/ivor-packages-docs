xt":"MXLXLink","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLXLinkV"},{"text":")","kind":"text"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlpartlink\/init(instrumentlink:grouplink:xlink:)","abstract":[{"text":"Creates a new ","type":"text"},{"code":"MXLPartLink","type":"codeVoice"},{"text":".","type":"text"}],"role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartLink\/init(instrumentLink:groupLink:xlink:)"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLInstrumentLink":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLInstrumentLink","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLInstrumentLink"}],"title":"MXLInstrumentLink","navigatorTitle":[{"kind":"identifier","text":"MXLInstrumentLink"}],"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlinstrumentlink","abstract":[{"text":"Multiple part-link elements can link a condensed part within a score file to multiple MusicXML parts files.","type":"text"},{"text":" ","type":"text"},{"text":"For example, a “Clarinet 1 and 2” part in a score file could link to separate “Clarinet 1” and “Clarinet 2”","type":"text"},{"text":" ","type":"text"},{"text":"part files. The instrument-link type distinguishes which of the score-instruments within a score-part are in","type":"text"},{"text":" ","type":"text"},{"text":"which part file. The instrument-link id attribute refers to a score-instrument id attribute.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLPartLink":{"kind":"symbol","title":"MXLPartLink","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPartLink","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlpartlink","navigatorTitle":[{"text":"MXLPartLink","kind":"identifier"}],"abstract":[{"text":"The part-link type allows MusicXML data for both score and parts to be contained within a single compressed","type":"text"},{"text":" ","type":"text"},{"text":"MusicXML file. It links a score-part from a score document to MusicXML documents that contain parts data. In","type":"text"},{"text":" ","type":"text"},{"text":"the case of a single compressed MusicXML file, the link href values are paths that are relative to the root","type":"text"},{"text":" ","type":"text"},{"text":"folder of the zip file.","type":"text"}],"role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartLink"},"doc://IvorMXL/documentation/IvorMXL/MXLXLink":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLXLink"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLXLink","title":"MXLXLink","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLXLink"}],"abstract":[{"type":"text","text":"The simple XLink attributes supported in the MusicXML format. It is also used to connect a MusicXML score with"},{"type":"text","text":" "},{"type":"text","text":"MusicXML parts or a MusicXML opus."}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlxlink"}}}