kind":"typeIdentifier"},{"text":")","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"name":"instrumentLink","content":[{"type":"paragraph","inlineContent":[{"text":"Identifies the instruments used in the linked document.","type":"text"}]}]},{"name":"groupLink","content":[{"type":"paragraph","inlineContent":[{"text":"Multiple part-link elements can reference different types of linked documents, such as parts and condensed score. The optional group-link elements identify the groups used in the linked document. The content of a group-link element should match the content of a group element in the linked document.","type":"text"}]}]},{"name":"xlink","content":[{"type":"paragraph","inlineContent":[{"text":"The link-attributes group includes all the simple XLink attributes supported in the MusicXML format. It is also used to connect a MusicXML score with MusicXML parts or a MusicXML opus.","type":"text"}]}]}]}],"kind":"symbol","abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLPartLink"},{"type":"text","text":"."}],"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"paths":["\/documentation\/ivormxl\/mxlpartlink\/init(instrumentlink:grouplink:xlink:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLPartLink/init(instrumentLink:groupLink:xlink:)":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlpartlink\/init(instrumentlink:grouplink:xlink:)","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartLink\/init(instrumentLink:groupLink:xlink:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"instrumentLink","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"MXLInstrumentLink","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL17MXLInstrumentLinkV"},{"text":"], ","kind":"text"},{"text":"groupLink","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"], ","kind":"text"},{"text":"xlink","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLXLink","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLXLinkV"},{"text":")","kind":"text"}],"kind":"symbol","abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLPartLink"},{"type":"text","text":"."}],"type":"topic","title":"init(instrumentLink:groupLink:xlink:)"},"doc://IvorMXL/documentation/IvorMXL/MXLInstrumentLink":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlinstrumentlink","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLInstrumentLink","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLInstrumentLink","kind":"identifier"}],"kind":"symbol","abstract":[{"type":"text","text":"Multiple part-link elements can link a condensed part within a score file to multiple MusicXML parts files."},{"type":"text","text":" "},{"type":"text","text":"For example, a “Clarinet 1 and 2” part in a score file could link to separate “Clarinet 1” and “Clarinet 2”"},{"type":"text","text":" "},{"type":"text","text":"part files. The instrument-link type distinguishes which of the score-instruments within a score-part are in"},{"type":"text","text":" "},{"type":"text","text":"which part file. The instrument-link id attribute refers to a score-instrument id attribute."}],"type":"topic","navigatorTitle":[{"text":"MXLInstrumentLink","kind":"identifier"}],"title":"MXLInstrumentLink"},"doc://IvorMXL/documentation/IvorMXL/MXLXLink":{"title":"MXLXLink","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLXLink"}],"abstract":[{"text":"The simple XLink attributes supported in the MusicXML format. It is also used to connect a MusicXML score with","type":"text"},{"text":" ","type":"text"},{"text":"MusicXML parts or a MusicXML opus.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLXLink","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLXLink"}],"url":"\/documentation\/ivormxl\/mxlxlink"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLPartLink":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlpartlink","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartLink","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPartLink"}],"abstract":[{"type":"text","text":"The part-link type allows MusicXML data for both score and parts to be contained within a single compressed"},{"type":"text","text":" "},{"type":"text","text":"MusicXML file. It links a score-part from a score document to MusicXML documents that contain parts data. In"},{"type":"text","text":" "},{"type":"text","text":"the case of a single compressed MusicXML file, the link href values are paths that are relative to the root"},{"type":"text","text":" "},{"type":"text","text":"folder of the zip file."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLPartLink"}],"title":"MXLPartLink"}}}