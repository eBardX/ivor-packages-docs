{"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTied\/kind-swift.property","interfaceLanguage":"swift"},"abstract":[{"text":"Whether this element marks the start, stop, or continuation of the tie, or indicates that the note should be","type":"text"},{"text":" ","type":"text"},{"text":"undamped.","type":"text"}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxltied\/kind-swift.property"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"kind"},{"kind":"text","text":": "},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTied\/Kind-swift.enum","preciseIdentifier":"s:7IvorMXL7MXLTiedV4KindO","kind":"typeIdentifier","text":"Kind"}],"languages":["swift"]}]},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Maps to the MusicXML "},{"type":"codeVoice","code":"type"},{"type":"text","text":" attribute."}],"type":"paragraph"}],"kind":"content"}],"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTied"]]},"metadata":{"symbolKind":"property","title":"kind","role":"symbol","roleHeading":"Instance Property","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"kind"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL7MXLTiedV4KindO","kind":"typeIdentifier","text":"Kind"}],"externalID":"s:7IvorMXL7MXLTiedV4kindAC4KindOvp","modules":[{"name":"IvorMXL"}]},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLTied/Kind-swift.enum":{"abstract":[{"text":"The tied-type type is used as an attribute of the tied element to specify where the visual representation","type":"text"},{"text":" ","type":"text"},{"text":"of a tie