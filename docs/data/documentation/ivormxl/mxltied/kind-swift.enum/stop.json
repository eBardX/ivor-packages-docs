{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxltied\/kind-swift.enum\/stop"]}],"kind":"symbol","metadata":{"modules":[{"name":"IvorMXL"}],"roleHeading":"Case","role":"symbol","title":"MXLTied.Kind.stop","externalID":"s:7IvorMXL7MXLTiedV4KindO4stopyA2EmF","symbolKind":"case","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"stop","kind":"identifier"}]},"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTied\/Kind-swift.enum\/stop"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTied","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTied\/Kind-swift.enum"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"stop","kind":"identifier"}]}]}],"abstract":[{"type":"text","text":"The end of the visual representation of a tie."}],"sections":[],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLTied":{"title":"MXLTied","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTied"}],"abstract":[{"type":"text","text":"The tied element represents the notated tie. The tie element represents the tie sound."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTied","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLTied"}],"url":"\/documentation\/ivormxl\/mxltied"},"doc://IvorMXL/documentation/IvorMXL/MXLTied/Kind-swift.enum":{"url":"\/documentation\/ivormxl\/mxltied\/kind-swift.enum","kind":"symbol","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Kind","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTied\/Kind-swift.enum","title":"MXLTied.Kind","abstract":[{"type":"text","text":"The tied-type type is used as an attribute of the tied element to specify where the visual representation"},{"type":"text","text":" "},{"type":"text","text":"of a tie begins and ends. A tied element which joins two notes of the same pitch can be specified with"},{"type":"text","text":" "},{"type":"text","text":"tied-type start on the first note and tied-type stop on the second note. To indicate a note should be"},{"type":"text","text":" "},{"type":"text","text":"undamped, use a single tied element with tied-type let-ring. For other ties that are visually attached to a"},{"type":"text","text":" "},{"type":"text","text":"single note, such as a tie leading into or out of a repeated section or coda, use two tied elements on the"},{"type":"text","text":" "},{"type":"text","text":"same note, one start and one stop."}],"navigatorTitle":[{"text":"Kind","kind":"identifier"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLTied/Kind-swift.enum/stop":{"url":"\/documentation\/ivormxl\/mxltied\/kind-swift.enum\/stop","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTied\/Kind-swift.enum\/stop","abstract":[{"type":"text","text":"The end of the visual representation of a tie."}],"kind":"symbol","type":"topic","title":"MXLTied.Kind.stop","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"stop"}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"}}}