ation/IvorMXL/MXLTied":{"abstract":[{"text":"The tied element represents the notated tie. The tie element represents the tie sound.","type":"text"}],"kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTied","kind":"identifier"}],"navigatorTitle":[{"text":"MXLTied","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTied","url":"\/documentation\/ivormxl\/mxltied","title":"MXLTied"},"doc://IvorMXL/documentation/IvorMXL/MXLTied/Kind-swift.enum":{"abstract":[{"text":"The tied-type type is used as an attribute of the tied element to specify where the visual representation","type":"text"},{"text":" ","type":"text"},{"text":"of a tie begins and ends. A tied element which joins two notes of the same pitch can be specified with","type":"text"},{"type":"text","text":" "},{"type":"text","text":"tied-type start on the first note and tied-type stop on the second note. To indicate a note should be"},{"type":"text","text":" "},{"type":"text","text":"undamped, use a single tied element with tied-type let-ring. For other ties that are visually attached to a"},{"type":"text","text":" "},{"type":"text","text":"single note, such as a tie leading into or out of a repeated section or coda, use two tied elements on the"},{"type":"text","text":" "},{"type":"text","text":"same note, one start and one stop."}],"kind":"symbol","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Kind","kind":"identifier"}],"navigatorTitle":[{"text":"Kind","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTied\/Kind-swift.enum","url":"\/documentation\/ivormxl\/mxltied\/kind-swift.enum","title":"MXLTied.Kind"}}}