ollection"},"doc://IvorMXL/documentation/IvorMXL/MXLTied/Kind-swift.enum/continue":{"url":"\/documentation\/ivormxl\/mxltied\/kind-swift.enum\/continue","abstract":[{"text":"An intermediate point in the tie, typically used to specify the formatting of cross-system ties.","type":"text"}],"title":"MXLTied.Kind.continue","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTied\/Kind-swift.enum\/continue","type":"topic","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"`continue`","kind":"identifier"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLTied/Kind-swift.enum":{"abstract":[{"text":"The tied-type type is used as an attribute of the tied element to specify where the visual representation","type":"text"},{"text":" ","type":"text"},{"text":"of a tie begins and ends. A tied element which joins two notes of the same pitch can be specified with","type":"text"},{"text":" ","type":"text"},{"text":"tied-type start on the first note and tied-type stop on the second note. To indicate a note should be","type":"text"},{"text":" ","type":"text"},{"text":"undamped, use a single tied element with tied-type let-ring. For other ties that are visually attached to a","type":"text"},{"text":" ","type":"text"},{"text":"single note, such as a tie leading into or out of a repeated section or coda, use two tied elements on the","type":"text"},{"text":" ","type":"text"},{"text":"same note, one start and one stop.","type":"text"}],"title":"MXLTied.Kind","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Kind"}],"navigatorTitle":[{"kind":"identifier","text":"Kind"}],"type":"topic","url":"\/documentation\/ivormxl\/mxltied\/kind-swift.enum","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTied\/Kind-swift.enum"}}}