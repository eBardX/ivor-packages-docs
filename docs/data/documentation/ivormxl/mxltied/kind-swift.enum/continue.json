ments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTied"}],"kind":"symbol","title":"MXLTied","navigatorTitle":[{"kind":"identifier","text":"MXLTied"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTied","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLTied/Kind-swift.enum":{"kind":"symbol","abstract":[{"type":"text","text":"The tied-type type is used as an attribute of the tied element to specify where the visual representation"},{"type":"text","text":" "},{"type":"text","text":"of a tie begins and ends. A tied element which joins two notes of the same pitch can be specified with"},{"type":"text","text":" "},{"type":"text","text":"tied-type start on the first note and tied-type stop on the second note. To indicate a note should be"},{"type":"text","text":" "},{"type":"text","text":"undamped, use a single tied element with tied-type let-ring. For other ties that are visually attached to a"},{"type":"text","text":" "},{"type":"text","text":"single note, such as a tie leading into or out of a repeated section or coda, use two tied elements on the"},{"type":"text","text":" "},{"type":"text","text":"same note, one start and one stop."}],"title":"MXLTied.Kind","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTied\/Kind-swift.enum","navigatorTitle":[{"kind":"identifier","text":"Kind"}],"role":"symbol","url":"\/documentation\/ivormxl\/mxltied\/kind-swift.enum","type":"topic","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Kind"}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"}}}