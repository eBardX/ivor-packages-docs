"type":"text","text":"of a tie begins and ends. A tied element which joins two notes of the same pitch can be specified with"},{"text":" ","type":"text"},{"type":"text","text":"tied-type start on the first note and tied-type stop on the second note. To indicate a note should be"},{"text":" ","type":"text"},{"type":"text","text":"undamped, use a single tied element with tied-type let-ring. For other ties that are visually attached to a"},{"type":"text","text":" "},{"type":"text","text":"single note, such as a tie leading into or out of a repeated section or coda, use two tied elements on the"},{"type":"text","text":" "},{"type":"text","text":"same note, one start and one stop."}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Kind","kind":"identifier"}],"title":"MXLTied.Kind","role":"symbol","type":"topic","navigatorTitle":[{"text":"Kind","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxltied\/kind-swift.enum","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTied\/Kind-swift.enum"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLTied":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTied","title":"MXLTied","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"text":"MXLTied","kind":"identifier"}],"abstract":[{"type":"text","text":"The tied element represents the notated tie. The tie element represents the tie sound."}],"url":"\/documentation\/ivormxl\/mxltied","kind":"symbol","type":"topic","navigatorTitle":[{"text":"MXLTied","kind":"identifier"}]}}}