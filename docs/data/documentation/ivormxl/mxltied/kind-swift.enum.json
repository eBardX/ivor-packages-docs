{"sections":[],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Kind","kind":"identifier"}],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In start-stop cases, ties can add more elements using a continue type. This is typically used to specify the"},{"type":"text","text":" "},{"type":"text","text":"formatting of cross-system ties."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When multiple elements with the same tag are used within the same note, their order within the MusicXML"},{"type":"text","text":" "},{"type":"text","text":"document should match the musical score order. For example, a note with a tie at the end of a first ending"},{"type":"text","text":" "},{"type":"text","text":"should have the tied element with a type of start precede the tied element with a type of stop."}]}],"kind":"content"}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTied\/Kind-swift.enum","interfaceLanguage":"swift"},"metadata":{"navigatorTitle":[{"kind":"identifier","text":"Kind"}],"title":"MXLTied.Kind","symbolKind":"enum","modules":[{"name":"IvorMXL"}],"externalID":"s:7IvorMXL7MXLTiedV4KindO","role":"symbol","extendedModule":"IvorMXL","roleHeading":"Enumeration","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Kind"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxltied\/kind-swift.enum"]}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTied"]]},"abstract":[{"type":"text","text":"The tied-type type is used as an attribute of the tied element to specify where the visual representation"},{"type":"text","text":" "},{"type":"text","text":"of a tie begins and e