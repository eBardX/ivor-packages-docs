eciseIdentifier":"s:7IvorMXL11MXLPositionV","kind":"typeIdentifier","text":"MXLPosition"},{"kind":"text","text":" = MXLPosition(), "},{"kind":"externalParam","text":"placement"},{"kind":"text","text":": "},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAboveBelow","preciseIdentifier":"s:7IvorMXL13MXLAboveBelowO","kind":"typeIdentifier","text":"MXLAboveBelow"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"orientation"},{"kind":"text","text":": "},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOverUnder","preciseIdentifier":"s:7IvorMXL12MXLOverUnderO","kind":"typeIdentifier","text":"MXLOverUnder"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"bezierX"},{"kind":"text","text":": "},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths","preciseIdentifier":"s:7IvorMXL9MXLTenthsa","kind":"typeIdentifier","text":"MXLTenths"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"bezierY"},{"kind":"text","text":": "},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths","preciseIdentifier":"s:7IvorMXL9MXLTenthsa","kind":"typeIdentifier","text":"MXLTenths"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"bezierX2"},{"kind":"text","text":": "},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths","preciseIdentifier":"s:7IvorMXL9MXLTenthsa","kind":"typeIdentifier","text":"MXLTenths"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"bezierY2"},{"kind":"text","text":": "},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths","preciseIdentifier":"s:7IvorMXL9MXLTenthsa","kind":"typeIdentifier","text":"MXLTenths"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"bezierOffset"},{"kind":"text","text":": "},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDivisions","preciseIdentifier":"s:7IvorMXL12MXLDivisionsV","kind":"typeIdentifier","text":"MXLDivisions"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"bezierOffset2"},{"kind":"text","text":": "},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDivisions","preciseIdentifier":"s:7IvorMXL12MXLDivisionsV","kind":"typeIdentifier","text":"MXLDivisions"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"color"},{"kind":"text","text":": "},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","preciseIdentifier":"s:7IvorMXL8MXLColorV","kind":"typeIdentifier","text":"MXLColor"},{"kind":"text","text":"? = nil)"}]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The optional-unique-id attribute group allows an element to optionally specify an ID that is unique to the entire document. This attribute group is not used for a required id attribute, or for an id attribute that specifies an id reference.","type":"text"}]}],"name":"id"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Whether this element marks the start, stop, or continuation of the tie, or indicates that the note should be undamped.","type":"text"}]}],"name":"kind"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Distinguishes this tie from other ties that might be active at the same time.","type":"text"}]}],"name":"number"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The line-type attribute distinguishes between solid, dashed, dotted, and wavy lines.","type":"text"}]}],"name":"lineKind"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The length, in tenths, of the dashes in a dashed line. Ignored if the corresponding line-type attribute is not dashed.","type":"text"}]}],"name":"dashLength"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The length, in tenths, of the spaces in a dashed line. Ignored if the corresponding line-type attribute is not dashed.","type":"text"}]}],"name":"spaceLength"},{"content":[{"type":"paragraph","inlineContent":[{"text":"For most elements, any program will compute a default x and y position. The position attributes let this be changed two ways.","type":"text"}]}],"name":"position"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The placement attribute indicates whether something is above or below another element, such as a note or a notation.","type":"text"}]}],"name":"placement"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The orientation attribute indicates whether slurs and ties are overhand (tips down) or underhand (tips up). This is distinct from the placement attribute used by any notation type.","type":"text"}]}],"name":"orientation"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The x-coordinate, in tenths relative to any position settings, of the outgoing bezier control point for a slur or tie with a start type, or the incoming control point for one with a stop or continue type.","type":"text"}]}],"name":"bezierX"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The y-coordinate, in tenths relative to any position settings, of the outgoing bezier control point for a slur or tie with a start type, or the incoming control point for one with a stop or continue type.","type":"text"}]}],"name":"bezierY"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The x-coordinate, in tenths, of the outgoing bezier control point for a slur with a continue type.","type":"text"}]}],"name":"bezierX2"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The y-coordinate, in tenths, of the outgoing bezier control point for a slur with a continue type.","type":"text"}]}],"name":"bezierY2"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The outgoing bezier control point offset, in musical divisions, for a slur or tie with a start type, or the incoming control point offset for one with a stop or continue type. Deprecated as of MusicXML 3.1 in favor of ","type":"text"},{"code":"bezierX","type":"codeVoice"},{"text":".","type":"text"}]}],"name":"bezierOffset"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The outgoing bezier control point offset, in musical divisions, for a slur with a continue type. Deprecated as of MusicXML 3.1 in favor of ","type":"text"},{"code":"bezierX2","type":"codeVoice"},{"text":".","type":"text"}]}],"name":"bezierOffset2"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The color attribute group indicates the color of an element.","type":"text"}]}],"name":"color"}]}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTied\/init(id:kind:number:lineKind:dashLength:spaceLength:position:placement:orientation:bezierX:bezierY:bezierX2:bezierY2:bezierOffset:bezierOffset2:color:)","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLTied"},{"type":"text","text":"."}],"references":{"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLNumberLevel":{"title":"MXLNumberLevel","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNumberLevel"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlnumberlevel","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumberLevel","abstract":[{"text":"Slurs, tuplets, and many other features can be concurrent and overlap within a single musical part. The","type":"text"},{"text":" ","type":"text"},{"text":"number-level entity distinguishes up to 16 concurrent objects of the same type when the objects overlap in","type":"text"},{"text":" ","type":"text"},{"text":"MusicXML document order. Values greater than 6 are usually only needed for music with a large number of divisi","type":"text"},{"text":" ","type":"text"},{"text":"staves in a single part, or if there are more than 6 cross-staff arpeggios in a single measure. When a number-","type":"text"},{"text":" ","type":"text"},{"text":"level value is implied, the value is 1 by default.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"MXLNumberLevel"}]},"doc://IvorMXL/documentation/IvorMXL/MXLTied/Kind-swift.enum":{"abstract":[{"text":"The tied-type type is used as an attribute of the tied element to specify where the visual representation","type":"text"},{"text":" ","type":"text"},{"text":"of a tie begins and ends. A tied element which joins two notes of the same pitch can be specified with","type":"text"},{"text":" ","type":"text"},{"text":"tied-type start on the first note and tied-type stop on the second note. To indicate a note should be","type":"text"},{"text":" ","type":"text"},{"text":"undamped, use a single tied element with tied-type let-ring. For other ties that are visually attached to a","type":"text"},{"text":" ","type":"text"},{"text":"single note, such as a tie leading into or out of a repeated section or coda, use two tied elements on the","type":"text"},{"text":" ","type":"text"},{"text":"same note, one start and one stop.","type":"text"}],"title":"MXLTied.Kind","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Kind"}],"navigatorTitle":[{"kind":"identifier","text":"Kind"}],"type":"topic","url":"\/documentation\/ivormxl\/mxltied\/kind-swift.enum","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTied\/Kind-swift.enum"},"doc://IvorMXL/documentation/IvorMXL/MXLTenths":{"abstract":[{"text":"The tenths type is a number representing tenths of interline staff space (positive or negative). Both integer","type":"text"},{"text":" ","type":"text"},{"text":"and decimal values are allowed, such as 5 for a half space and 2.5 for a quarter space. Interline space is","type":"text"},{"text":" ","type":"text"},{"text":"measured from the middle of a staff line.","type":"text"}],"title":"MXLTenths","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTenths"}],"navigatorTitle":[{"kind":"identifier","text":"MXLTenths"}],"type":"topic","url":"\/documentation\/ivormxl\/mxltenths","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths"},"doc://IvorMXL/documentation/IvorMXL/MXLTied":{"navigatorTitle":[{"text":"MXLTied","kind":"identifier"}],"abstract":[{"text":"The tied element represents the notated tie. The tie element represents the tie sound.","type":"text"}],"title":"MXLTied","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTied","kind":"symbol","url":"\/documentation\/ivormxl\/mxltied","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTied","kind":"identifier"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLTied/init(id:kind:number:lineKind:dashLength:spaceLength:position:placement:orientation:bezierX:bezierY:bezierX2:bezierY2:bezierOffset:bezierOffset2:color:)":{"abstract":[{"text":"Creates a new ","type":"text"},{"code":"MXLTied","type":"codeVoice"},{"text":".","type":"text"}],"title":"init(id:kind:number:lineKind:dashLength:spaceLength:position:placement:orientation:bezierX:bezierY:bezierX2:bezierY2:bezierOffset:bezierOffset2:color:)","kind":"symbol","role":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"id"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"kind"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL7MXLTiedV4KindO","kind":"typeIdentifier","text":"Kind"},{"kind":"text","text":", "},{"kind":"externalParam","text":"number"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL14MXLNumberLevelV","text"