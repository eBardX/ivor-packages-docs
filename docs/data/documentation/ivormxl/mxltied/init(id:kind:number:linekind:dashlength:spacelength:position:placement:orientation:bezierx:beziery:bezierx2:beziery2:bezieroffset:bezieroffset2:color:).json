rhand"},{"type":"text","text":" "},{"type":"text","text":"(tips down) or underhand (tips up)."}],"url":"\/documentation\/ivormxl\/mxloverunder","navigatorTitle":[{"text":"MXLOverUnder","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOverUnder","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLOverUnder","kind":"identifier"}],"title":"MXLOverUnder","type":"topic","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLLineKind":{"abstract":[{"text":"The line-type type distinguishes between solid, dashed, dotted, and wavy lines.","type":"text"}],"title":"MXLLineKind","url":"\/documentation\/ivormxl\/mxllinekind","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLLineKind","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"MXLLineKind","kind":"identifier"}],"type":"topic","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLineKind"}}}