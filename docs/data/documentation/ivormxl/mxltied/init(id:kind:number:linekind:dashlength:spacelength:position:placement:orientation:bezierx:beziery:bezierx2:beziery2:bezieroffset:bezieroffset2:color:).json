er type is used to indicate whether the tips of curved lines such as slurs and ties are overhand","type":"text"},{"text":" ","type":"text"},{"text":"(tips down) or underhand (tips up).","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLDivisions":{"title":"MXLDivisions","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLDivisions","kind":"identifier"}],"kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxldivisions","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDivisions","abstract":[{"type":"text","text":"The divisions type is used to express values in terms of the musical divisions defined by the divisions"},{"type":"text","text":" "},{"type":"text","text":"element. It is preferred that these be integer values both for MIDI interoperability and to avoid roundoff"},{"type":"text","text":" "},{"type":"text","text":"errors."}],"navigatorTitle":[{"text":"MXLDivisions","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLLineKind":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLineKind","title":"MXLLineKind","kind":"symbol","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLLineKind","kind":"identifier"}],"navigatorTitle":[{"text":"MXLLineKind","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxllinekind","abstract":[{"text":"The line-type type distinguishes between solid, dashed, dotted, and wavy lines.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"abstract":[{"text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in","type":"text"},{"type":"text","text":" "},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"title":"MXLColor","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlcolor","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor"},"doc://IvorMXL/documentation/IvorMXL/MXLPosition":{"title":"MXLPosition","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPosition"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlposition","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","abstract":[{"text":"For most elements, any program will compute a default x and y position. The position attributes let this be","type":"text"},{"text":" ","type":"text"},{"text":"changed two ways.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"MXLPosition"}]}}}