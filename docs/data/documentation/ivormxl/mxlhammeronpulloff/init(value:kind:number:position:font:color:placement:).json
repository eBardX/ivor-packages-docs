L/documentation/IvorMXL/MXLPosition":{"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPosition","kind":"identifier"}],"title":"MXLPosition","navigatorTitle":[{"text":"MXLPosition","kind":"identifier"}],"abstract":[{"type":"text","text":"For most elements, any program will compute a default x and y position. The position attributes let this be"},{"type":"text","text":" "},{"type":"text","text":"changed two ways."}],"url":"\/documentation\/ivormxl\/mxlposition","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLHammerOnPullOff":{"type":"topic","title":"MXLHammerOnPullOff","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLHammerOnPullOff"}],"url":"\/documentation\/ivormxl\/mxlhammeronpulloff","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHammerOnPullOff","role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLHammerOnPullOff"}],"abstract":[{"text":"The hammer-on and pull-off elements are used in guitar and fretted instrument notation. Since a single slur","type":"text"},{"text":" ","type":"text"},{"text":"can be marked over many notes, the hammer-on and pull-off elements are separate so the individual pair of","type":"text"},{"text":" ","type":"text"},{"text":"notes can be specified. The element content can be used to specify how the hammer-on or pull-off should be","type":"text"},{"text":" ","type":"text"},{"text":"notated. An empty element leaves this choice up to the application.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLNumberLevel":{"type":"topic","url":"\/documentation\/ivormxl\/mxlnumberlevel","role":"symbol","title":"MXLNumberLevel","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumberLevel","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNumberLevel","kind":"identifier"}],"abstract":[{"text":"Slurs, tuplets, and many other features can be concurrent and overlap within a single musical part. The","type":"text"},{"text":" ","type":"text"},{"text":"number-level entity distinguishes up to 16 concurrent objects of the same type when the objects overlap in","type":"text"},{"text":" ","type":"text"},{"text":"MusicXML document order. Values greater than 6 are usually only needed for music with a large number of divisi","type":"text"},{"text":" ","type":"text"},{"text":"staves in a single part, or if there are more than 6 cross-staff arpeggios in a single measure. When a number-","type":"text"},{"text":" ","type":"text"},{"text":"level value is implied, the value is 1 by default.","type":"text"}],"navigatorTitle":[{"text":"MXLNumberLevel","kind":"identifier"}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLStartStop":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlstartstop","title":"MXLStartStop","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLStartStop","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"MXLStartStop"}],"abstract":[{"type":"text","text":"The start-stop type is used for an attribute of musical elements that can either start or stop, such as"},{"type":"text","text":" "},{"type":"text","text":"tuplets."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStartStop"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlcolor","title":"MXLColor","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"type":"text","text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is"},{"type":"text","text":" "},{"type":"text","text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor"},"doc://IvorMXL/documentation/IvorMXL/MXLAboveBelow":{"title":"MXLAboveBelow","type":"topic","fragments":[{"kind":"keyword","text":"enum"},{"text":" ","kind":"text"},{"kind":"identifier","text":"MXLAboveBelow"}],"url":"\/documentation\/ivormxl\/mxlabovebelow","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAboveBelow","role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLAboveBelow"}],"abstract":[{"type":"text","text":"The above-below type is used to indicate whether one element appears above or below another element."}]},"doc://IvorMXL/documentation/IvorMXL/MXLFont":{"title":"MXLFont","url":"\/documentation\/ivormxl\/mxlfont","role":"symbol","navigatorTitle":[{"text":"MXLFont","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","abstract":[{"text":"The font attribute group gathers together attributes for determining the font within a credit or direction.","type":"text"},{"text":" ","type":"text"},{"text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric"},{"type":"text","text":" "},{"type":"text","text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font"},{"type":"text","text":" "},{"type":"text","text":"vs. a music font."}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLFont","kind":"identifier"}],"type":"topic"}}}