"role":"symbol","url":"\/documentation\/ivormxl\/mxlposition","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPosition"}],"kind":"symbol","abstract":[{"text":"For most elements, any program will compute a default x and y position. The position attributes let this be","type":"text"},{"text":" ","type":"text"},{"text":"changed two ways.","type":"text"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLPosition"}],"title":"MXLPosition"},"doc://IvorMXL/documentation/IvorMXL/MXLHammerOnPullOff":{"abstract":[{"type":"text","text":"The hammer-on and pull-off elements are used in guitar and fretted instrument notation. Since a single slur"},{"type":"text","text":" "},{"type":"text","text":"can be marked over many notes, the hammer-on and pull-off elements are separate so the individual pair of"},{"type":"text","text":" "},{"type":"text","text":"notes can be specified. The element content can be used to specify how the hammer-on or pull-off should be"},{"type":"text","text":" "},{"type":"text","text":"notated. An empty element leaves this choice up to the application."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHammerOnPullOff","url":"\/documentation\/ivormxl\/mxlhammeronpulloff","navigatorTitle":[{"text":"MXLHammerOnPullOff","kind":"identifier"}],"title":"MXLHammerOnPullOff","role":"symbol","type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLHammerOnPullOff","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLHammerOnPullOff/init(value:kind:number:position:font:color:placement:)":{"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"value"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam",