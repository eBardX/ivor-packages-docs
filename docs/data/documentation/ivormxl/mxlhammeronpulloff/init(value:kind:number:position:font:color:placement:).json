orMXL\/documentation\/IvorMXL\/MXLNumberLevel","abstract":[{"text":"Slurs, tuplets, and many other features can be concurrent and overlap within a single musical part. The","type":"text"},{"text":" ","type":"text"},{"text":"number-level entity distinguishes up to 16 concurrent objects of the same type when the objects overlap in","type":"text"},{"text":" ","type":"text"},{"text":"MusicXML document order. Values greater than 6 are usually only needed for music with a large number of divisi","type":"text"},{"text":" ","type":"text"},{"text":"staves in a single part, or if there are more than 6 cross-staff arpeggios in a single measure. When a number-","type":"text"},{"text":" ","type":"text"},{"text":"level value is implied, the value is 1 by default.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"MXLNumberLevel"}]},"doc://IvorMXL/documentation/IvorMXL/MXLStartStop":{"navigatorTitle":[{"text":"MXLStartStop","kind":"identifier"}],"abstract":[{"text":"The start-stop type is used for an attribute of musical elements that can either start or stop, such as","type":"text"},{"text":" ","type":"text"},{"text":"tuplets.","type":"text"}],"title":"MXLStartStop","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStartStop","kind":"symbol","url":"\/documentation\/ivormxl\/mxlstartstop","type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLStartStop","kind":"identifier"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLHammerOnPullOff/init(value:kind:number:position:font:color:placement:)":{"abstract":[{"text":"Creates a new ","type":"text"},{"code":"MXLHammerOnPullOff","type":"codeVoice"},{"text":".","type":"text"}],"title":"init(value:kind:number:position:font:color:placement:)","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHammerOnPullOff\/init(value:kind:number:position:font:color:placement:)","kind":"symbol","url":"\/documentation\/ivormxl\/mxlhammeronpulloff\/init(value:kind:number:posi