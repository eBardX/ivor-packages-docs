vorMXL8MXLColorV"},{"text":"?","kind":"text"}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLHammerOnPullOff":{"abstract":[{"type":"text","text":"The hammer-on and pull-off elements are used in guitar and fretted instrument notation. Since a single slur"},{"type":"text","text":" "},{"type":"text","text":"can be marked over many notes, the hammer-on and pull-off elements are separate so the individual pair of"},{"type":"text","text":" "},{"type":"text","text":"notes can be specified. The element content can be used to specify how the hammer-on or pull-off should be"},{"type":"text","text":" "},{"type":"text","text":"notated. An empty element leaves this choice up to the application."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHammerOnPullOff","kind":"symbol","url":"\/documentation\/ivormxl\/mxlhammeronpulloff","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLHammerOnPullOff"}],"title":"MXLHammerOnPullOff","role":"symbol","navigatorTitle":[{"text":"MXLHammerOnPullOff","kind":"identifier"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLColor","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","title":"MXLColor","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlcolor"}}}