an element."}],"kind":"symbol","role":"symbol","title":"color"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLHammerOnPullOff":{"abstract":[{"type":"text","text":"The hammer-on and pull-off elements are used in guitar and fretted instrument notation. Since a single slur"},{"type":"text","text":" "},{"type":"text","text":"can be marked over many notes, the hammer-on and pull-off elements are separate so the individual pair of"},{"type":"text","text":" "},{"type":"text","text":"notes can be specified. The element content can be used to specify how the hammer-on or pull-off should be"},{"type":"text","text":" "},{"type":"text","text":"notated. An empty element leaves this choice up to the application."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHammerOnPullOff","url":"\/documentation\/ivormxl\/mxlhammeronpulloff","navigatorTitle":[{"text":"MXLHammerOnPullOff","kind":"identifier"}],"title":"MXLHammerOnPullOff","role":"symbol","type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLHammerOnPullOff","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"title":"MXLColor","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"abstract":[{"text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in","type":"text"},{"text":" ","type":"text"},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"url":"\/documentation\/ivormxl\/mxlcolor"}}}