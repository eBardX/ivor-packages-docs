{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHammerOnPullOff\/color"},"kind":"symbol","abstract":[{"type":"text","text":"The color attribute group indicates the color of an element."}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHammerOnPullOff"]]},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"color"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL8MXLColorV","kind":"typeIdentifier","text":"MXLColor","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor"},{"kind":"text","text":"?"}],"platforms":["macOS"]}],"kind":"declarations"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlhammeronpulloff\/color"]}],"metadata":{"roleHeading":"Instance Property","modules":[{"name":"IvorMXL"}],"role":"symbol","title":"color","symbolKind":"property","externalID":"s:7IvorMXL18MXLHammerOnPullOffV5colorAA8MXLColorVSgvp","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"color","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLColor","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLColorV"},{"text":"?","kind":"text"}]},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLHammerOnPullOff/color":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHammerOnPullOff\/color","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"The color attribute group indicates the color of an element."}],"title":"color","role":"symbol","url":"\/documentation\/ivormxl\/mxlhammeronpulloff\/color","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"color"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL8MXLColorV","kind":"typeIdentifier","text":"MXLColor"},{"kind":"text","text":"?"}]},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"type":"topic","abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"type":"text","text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is"},{"type":"text","text":" "},{"type":"text","text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF."}],"url":"\/documentation\/ivormxl\/mxlcolor","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"kind":"symbol","title":"MXLColor","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLHammerOnPullOff":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHammerOnPullOff","navigatorTitle":[{"kind":"identifier","text":"MXLHammerOnPullOff"}],"url":"\/documentation\/ivormxl\/mxlhammeronpulloff","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLHammerOnPullOff"}],"title":"MXLHammerOnPullOff","abstract":[{"type":"text","text":"The hammer-on and pull-off elements are used in guitar and fretted instrument notation. Since a single slur"},{"type":"text","text":" "},{"type":"text","text":"can be marked over many notes, the hammer-on and pull-off elements are separate so the individual pair of"},{"type":"text","text":" "},{"type":"text","text":"notes can be specified. The element content can be used to specify how the hammer-on or pull-off should be"},{"type":"text","text":" "},{"type":"text","text":"notated. An empty element leaves this choice up to the application."}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"}}}