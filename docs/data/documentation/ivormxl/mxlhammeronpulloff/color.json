bute group indicates the color of an element.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLHammerOnPullOff":{"type":"topic","title":"MXLHammerOnPullOff","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLHammerOnPullOff"}],"url":"\/documentation\/ivormxl\/mxlhammeronpulloff","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHammerOnPullOff","role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLHammerOnPullOff"}],"abstract":[{"text":"The hammer-on and pull-off elements are used in guitar and fretted instrument notation. Since a single slur","type":"text"},{"text":" ","type":"text"},{"text":"can be marked over many notes, the hammer-on and pull-off elements are separate so the individual pair of","type":"text"},{"text":" ","type":"text"},{"text":"notes can be specified. The element content can be used to specify how the hammer-on or pull-off should be","type":"text"},{"text":" ","type":"text"},{"text":"notated. An empty element leaves this choice up to the application.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlcolor","title":"MXLColor","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"type":"text","text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is"},{"type":"text","text":" "},{"type":"text","text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/