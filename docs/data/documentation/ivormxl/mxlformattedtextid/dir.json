rmattedTextID\/dir","kind":"symbol","type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlformattedtextid\/dir","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dir","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLTextDirection","preciseIdentifier":"s:7IvorMXL16MXLTextDirectionO","kind":"typeIdentifier"}],"title":"dir","abstract":[{"type":"text","text":"The text-direction attribute is used to adjust and override the Unicode bidirectional text algorithm, similar"},{"type":"text","text":" "},{"type":"text","text":"to the Directionality data category in the W3C Internationalization Tag Set recommendation."}]},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLTextDirection":{"kind":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTextDirection"}],"url":"\/documentation\/ivormxl\/mxltextdirection","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTextDirection","navigatorTitle":[{"text":"MXLTextDirection","kind":"identifier"}],"abstract":[{"type":"text","text":"The text-direction type is used to adjust and override the Unicode bidirectional text algorithm, similar to"},{"text":" ","type":"text"},{"type":"text","text":"the Directionality data category in the W3C Internationalization Tag Set recommendation. Values are ltr (left-"},{"type":"text","text":" "},{"type":"text","text":"to-right embed), rtl (right-to-left embed), lro (left-to-right bidi-override), and rlo (right-to-left bidi-"},{"type":"text","text":" "},{"type":"text","text":"override). The default value is ltr. This type is typically used by applications that store text in left-to-"},{"type":"text","text":" "},{"type":"text","text":"right visual order rather than logical order. Such applications can use the lro value to better communicate"},{"type":"text","text":" "},{"type":"text","text":"with other applications that more fully support bidirectional text."}],"title":"MXLTextDirection","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLFormattedTextID":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFormattedTextID","title":"MXLFormattedTextID","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"MXLFormattedTextID","kind":"identifier"}],"abstract":[{"text":"The formatted-text-id type represents a text element with text-formatting and id attributes.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlformattedtextid","kind":"symbol","type":"topic","navigatorTitle":[{"text":"MXLFormattedTextID","kind":"identifier"}]}}}