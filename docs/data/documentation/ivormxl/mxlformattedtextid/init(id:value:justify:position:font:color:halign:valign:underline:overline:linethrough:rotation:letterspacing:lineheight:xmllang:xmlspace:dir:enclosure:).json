"lineHeight","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLNumberOrNormal","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumberOrNormal","preciseIdentifier":"s:7IvorMXL17MXLNumberOrNormalO","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"xmlLang","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"xmlSpace","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLXmlSpace","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLXmlSpace","preciseIdentifier":"s:7IvorMXL11MXLXmlSpaceO","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"dir","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLTextDirection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTextDirection","preciseIdentifier":"s:7IvorMXL16MXLTextDirectionO","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"enclosure","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLEnclosureShape","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnclosureShape","preciseIdentifier":"s:7IvorMXL17MXLEnclosureShapeO","kind":"typeIdentifier"},{"text":"? = nil)","kind":"text"}],"platforms":["macOS"]}],"kind":"declarations"},{"parameters":[{"name":"id","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The optional-unique-id attribute group allows an element to optionally specify an ID"},{"type":"text","text":" "},{"type":"text","text":"that is unique to the entire document. This attribute group is not used for a"},{"type":"text","text":" "},{"type":"text","text":"required id attribute, or for an id attribute that specifies an id reference."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The value of this element."}]}],"name":"value"},{"name":"justify","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The justify attribute is used to indicate left, center, or right justification. The"},{"type":"text","text":" "},{"type":"text","text":"default value varies for different elements. For elements where the justify"},{"type":"text","text":" "},{"type":"text","text":"attribute is present but the halign attribute is not, the justify attribute"},{"type":"text","text":" "},{"type":"text","text":"indicates horizontal alignment as well as justification."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For most elements, any program will compute a default x and y position. The position"},{"type":"text","text":" "},{"type":"text","text":"attributes let this be changed two ways."}]}],"name":"position"},{"name":"font","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The font attribute group gathers together attributes for determining the font within"},{"type":"text","text":" "},{"type":"text","text":"a credit or direction. They are based on the text styles for Cascading Style Sheets."},{"type":"text","text":" "},{"type":"text","text":"The font-family is a comma-separated list of font names. The font-style can be"},{"type":"text","text":" "},{"type":"text","text":"normal or italic. The font-size can be one of the CSS sizes or a numeric point size."},{"type":"text","text":" "},{"type":"text","text":"The font-weight can be normal or bold. The default is application-dependent, but is"},{"type":"text","text":" "},{"type":"text","text":"a text font vs. a music font."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The color attribute group indicates the color of an element."}]}],"name":"color"},{"name":"halign","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In cases where text extends over more than one line, horizontal alignment and"},{"type":"text","text":" "},{"type":"text","text":"justify values can be different."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The valign attribute is used to indicate vertical alignment to the top, middle,"},{"type":"text","text":" "},{"type":"text","text":"bottom, or baseline of the text. Defaults are implementation-dependent."}]}],"name":"valign"},{"name":"underline","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The number of lines used to underline the text: "},{"type":"codeVoice","code":"0"},{"type":"text","text":" (none), "},{"type":"codeVoice","code":"1"},{"type":"text","text":", "},{"type":"codeVoice","code":"2"},{"type":"text","text":", or "},{"type":"codeVoice","code":"3"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The number of lines used to overline the text: "},{"type":"codeVoice","code":"0"},{"type":"text","text":" (none), "},{"type":"codeVoice","code":"1"},{"type":"text","text":", "},{"type":"codeVoice","code":"2"},{"type":"text","text":", or "},{"type":"codeVoice","code":"3"},{"type":"text","text":"."}]}],"name":"overline"},{"name":"lineThrough","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The number of lines used to strike through the text: "},{"type":"codeVoice","code":"0"},{"type":"text","text":" (none), "},{"type":"codeVoice","code":"1"},{"type":"text","text":", "},{"type":"codeVoice","code":"2"},{"type":"text","text":", or "},{"type":"codeVoice","code":"3"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The rotation attribute is used to rotate text around the alignment point specified"},{"type":"text","text":" "},{"type":"text","text":"by the halign and valign attributes. Positive values are clockwise rotations, while"},{"type":"text","text":" "},{"type":"text","text":"negative values are counter-clockwise rotations."}]}],"name":"rotation"},{"name":"letterSpacing","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The letter-spacing attribute specifies text tracking. Values are either “normal” or"},{"type":"text","text":" "},{"type":"text","text":"a number representing the number of ems to add between each letter. The number may"},{"type":"text","text":" "},{"type":"text","text":"be negative in order to subtract space. The default is normal, which allows"},{"type":"text","text":" "},{"type":"text","text":"flexibility of letter-spacing for purposes of text justification."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The line-height attribute specifies text leading. Values are either “normal” or a"},{"type":"text","text":" "},{"type":"text","text":"number representing the percentage of the current font height to use for leading."},{"type":"text","text":" "},{"type":"text","text":"The default is “normal”. The exact normal value is implementation-dependent, but"},{"type":"text","text":" "},{"type":"text","text":"values between 100 and 120 are recommended."}]}],"name":"lineHeight"},{"name":"xmlLang","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The xml:lang attribute value."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The xml:space attribute value."}]}],"name":"xmlSpace"},{"name":"dir","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The text-direction attribute is used to adjust and override the Unicode"},{"type":"text","text":" "},{"type":"text","text":"bidirectional text algorithm, similar to the Directionality data category in the W3C"},{"type":"text","text":" "},{"type":"text","text":"Internationalization Tag Set recommendation."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The enclosure attribute group is used to specify the formatting of an enclosure"},{"type":"text","text":" "},{"type":"text","text":"around text or symbols."}]}],"name":"enclosure"}],"kind":"parameters"}],"abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLFormattedTextID"},{"type":"text","text":"."}],"variants":[{"paths":["\/documentation\/ivormxl\/mxlformattedtextid\/init(id:value:justify:position:font:color:halign:valign:underline:overline:linethrough:rotation:letterspacing:lineheight:xmllang:xmlspace:dir:enclosure:)"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFormattedTextID\/init(id:value:justify:position:font:color:halign:valign:underline:overline:lineThrough:rotation:letterSpacing:lineHeight:xmlLang:xmlSpace:dir:enclosure:)","interfaceLanguage":"swift"},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLXmlSpace":{"title":"MXLXmlSpace","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLXmlSpace","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"MXLXmlSpace","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlxmlspace","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLXmlSpace","abstract":[{"type":"text","text":"The xml:space attribute value, as defined by the XML 1.0 specification."}],"type":"topic","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"type":"topic","abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"type":"text","text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is"},{"type":"text","text":" "},{"type":"text","text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF."}],"url":"\/documentation\/ivormxl\/mxlcolor","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"kind":"symbol","title":"MXLColor","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLEnclosureShape":{"title":"MXLEnclosureShape","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLEnclosureShape","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlenclosureshape","role":"symbol","navigatorTitle":[{"text":"MXLEnclosureShape","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnclosureShape","abstract":[{"type":"text","text":"The enclosure-shape type describes the shape and presence \/ absence of an enclosure around text or symbols. A"},{"type":"text","text":" "},{"type":"text","text":"bracket enclosure is similar to a rectangle with the bottom line missing, as is common in jazz notation. An"},{"type":"text","text":" "},{"type":"text","text":"inverted-bracket enclosure is similar to a rectangle with the top line missing."}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLTextDirection":{"title":"MXLTextDirection","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTextDirection","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxltextdirection","role":"symbol","navigatorTitle":[{"text":"MXLTextDirection","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTextDirection","abstract":[{"text":"The text-direction type is used to adjust and override the Unicode bidirectional text algorithm, similar to","type":"text"},{"text":" ","type":"text"},{"text":"the Directionality data category in the W3C Internationalization Tag Set recommendation. Values are ltr (left-","type":"text"},{"text":" ","type":"text"},{"text":"to-right embed), rtl (right-to-left embed), lro (left-to-right bidi-override), and rlo (right-to-left bidi-","type":"text"},{"text":" ","type":"text"},{"text":"override). The default value is ltr. This type is typically used by applications that store text in left-to-","type":"text"},{"text":" ","type":"text"},{"text":"right visual order rather than logical order. Such applications can use the lro value to better communicate","type":"text"},{"text":" ","type":"text"},{"text":"with other applications that more fully support bidirectional text.","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLRotationDegrees":{"type":"topic","abstract":[{"type":"text","text":"The rotation-degrees type specifies rotation, pan, and elevation values in degrees. Values range from -180 to"},{"type":"text","text":" "},{"type":"text","text":"180."}],"url":"\/documentation\/ivormxl\/mxlrotationdegrees","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLRotationDegrees"}],"kind":"symbol","title":"MXLRotationDegrees","navigatorTitle":[{"kind":"identifier","text":"MXLRotationDegrees"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRotationDegrees","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNumberOfLines":{"url":"\/documentation\/ivormxl\/mxlnumberoflines","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNumberOfLines","kind":"identifier"}],"title":"MXLNumberOfLines","abstract":[{"text":"The number-of-lines type is used to specify the number of lines in text decoration attributes.","type":"text"}],"navigatorTitle":[{"text":"MXLNumberOfLines","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumberOfLines","type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLLeftCenterRight":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLLeftCenterRight"}],"title":"MXLLeftCenterRight","abstract":[{"text":"The left-center-right type is used to define horizontal alignment and text justification.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLeftCenterRight","role":"symbol","url":"\/documentation\/ivormxl\/mxlleftcenterright","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLLeftCenterRight"}],"type":"topic"},"doc://