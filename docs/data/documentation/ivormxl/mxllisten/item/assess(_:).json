nd":"typeIdentifier"},{"text":")","kind":"text"}],"abstract":[{"text":"The assess element overrides the default assessment of a note for a score following or machine","type":"text"},{"text":" ","type":"text"},{"text":"listening application.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLListen\/Item\/assess(_:)","kind":"symbol","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLListen":{"title":"MXLListen","navigatorTitle":[{"text":"MXLListen","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"The listen and listening types, new in Version 4.0, specify different ways that a score following or machine"},{"type":"text","text":" "},{"type":"text","text":"listening application can interact with a performer. The listen type handles interactions that are specific to"},{"type":"text","text":" "},{"type":"text","text":"a note. If multiple child elements of the same type are present, they should have distinct player and\/or time-"},{"type":"text","text":" "},{"type":"text","text":"only attributes."}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLListen","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLListen","url":"\/documentation\/ivormxl\/mxllisten"},"doc://IvorMXL/documentation/IvorMXL/MXLAssess":{"url":"\/documentation\/ivormxl\/mxlassess","navigatorTitle":[{"kind":"identifier","text":"MXLAssess"}],"type":"topic","kind":"symbol","abstract":[{"type":"text","text":"By default, an assessment application should assess all notes without a cue child element, and not assess any"},{"type":"text","text":" "},{"type":"text","text":"note with a cue child element. The assess type allows this default assessment to be overridden for individual"},{"type":"text","text":" "},{"type":"text","text":"notes. The optional player and time-only attributes restrict the type to apply to a single player or set of"},{"type":"text","text":" "},{"type":"text","text":"times through a repeated section, respectively. If missing, the type applies to all players or all times"},{"type":"text","text":" "},{"type":"text","text":"through the repeated section, respectively. The player attribute references the id attribute of a player"},{"type":"text","text":" "},{"type":"text","text":"element defined within the matching score-part."}],"role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAssess","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLAssess"}],"title":"MXLAssess"},"doc://IvorMXL/documentation/IvorMXL/MXLListen/Item":{"title":"MXLListen.Item","navigatorTitle":[{"text":"Item","kind":"identifier"}],"type":"topic","abstract":[{"text":"One of the alternatives for Listen.","type":"text"}],"role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Item","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLListen\/Item","url":"\/documentation\/ivormxl\/mxllisten\/item"}}}