torTitle":[{"kind":"identifier","text":"Item"}],"title":"MXLListen.Item","type":"topic","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLListen/Item/assess(_:)":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLListen\/Item\/assess(_:)","type":"topic","abstract":[{"type":"text","text":"The assess element overrides the default assessment of a note for a score following or machine"},{"type":"text","text":" "},{"type":"text","text":"listening application."}],"url":"\/documentation\/ivormxl\/mxllisten\/item\/assess(_:)","role":"symbol","title":"MXLListen.Item.assess(_:)","fragments":[{"kind":"keyword","text":"case"},{"text":" ","kind":"text"},{"kind":"identifier","text":"assess"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"MXLAssess","preciseIdentifier":"s:7IvorMXL9MXLAssessV"},{"kind":"text","text":")"}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLListen":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLListen","role":"symbol","navigatorTitle":[{"text":"MXLListen","kind":"identifier"}],"type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLListen","kind":"identifier"}],"abstract":[{"type":"text","text":"The listen and listening types, new in Version 4.0, specify different ways that a score following or machine"},{"type":"text","text":" "},{"type":"text","text":"listening application can interact with a performer. The listen type handles interactions that are specific to"},{"type":"text","text":" "},{"type":"text","text":"a note. If multiple child elements of the same type are present, they should have distinct player and\/or time-"},{"type":"text","text":" "},{"type":"text","text":"only attributes."}],"url":"\/documentation\/ivormxl\/mxllisten","title":"MXLListen"},"doc://IvorMXL/documentation/IvorMXL/MXLAssess":{"abstract":[{"type":"text","text":"By default, an assessment application should assess all notes without a cue child element, and not assess any"},{"type":"text","text":" "},{"type":"text","text":"note with a cue child element. The assess type allows this default assessment to be overridden for individual"},{"type":"text","text":" "},{"type":"text","text":"notes. The optional player and time-only attributes restrict the type to apply to a single player or set of"},{"type":"text","text":" "},{"type":"text","text":"times through a repeated section, respectively. If missing, the type applies to all players or all times"},{"type":"text","text":" "},{"type":"text","text":"through the repeated section, respectively. The player attribute references the id attribute of a player"},{"type":"text","text":" "},{"type":"text","text":"element defined within the matching score-part."}],"url":"\/documentation\/ivormxl\/mxlassess","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAssess","type":"topic","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"text":"MXLAssess","kind":"identifier"}],"title":"MXLAssess","navigatorTitle":[{"text":"MXLAssess","kind":"identifier"}]}}}