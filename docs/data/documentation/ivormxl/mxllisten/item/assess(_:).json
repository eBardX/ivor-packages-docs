ype":"text"},{"text":"note with a cue child element. The assess type allows this default assessment to be overridden for individual","type":"text"},{"text":" ","type":"text"},{"text":"notes. The optional player and time-only attributes restrict the type to apply to a single player or set of","type":"text"},{"text":" ","type":"text"},{"text":"times through a repeated section, respectively. If missing, the type applies to all players or all times","type":"text"},{"text":" ","type":"text"},{"text":"through the repeated section, respectively. The player attribute references the id attribute of a player","type":"text"},{"text":" ","type":"text"},{"text":"element defined within the matching score-part.","type":"text"}],"title":"MXLAssess","url":"\/documentation\/ivormxl\/mxlassess","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLAssess","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLListen/Item/assess(_:)":{"role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLListen\/Item\/assess(_:)","kind":"symbol","type":"topic","abstract":[{"text":"The assess element overrides the default assessment of a note for a score following or machine","type":"text"},{"text":" ","type":"text"},{"text":"listening application.","type":"text"}],"title":"MXLListen.Item.assess(_:)","url":"\/documentation\/ivormxl\/mxllisten\/item\/assess(_:)","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"assess","kind":"identifier"},{"text":"(","kind":"text"},{"text":"MXLAssess","preciseIdentifier":"s:7IvorMXL9MXLAssessV","kind":"typeIdentifier"},{"text":")","kind":"text"}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLListe