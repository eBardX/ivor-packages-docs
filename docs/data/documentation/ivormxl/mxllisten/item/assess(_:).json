{"abstract":[{"type":"text","text":"The assess element overrides the default assessment of a note for a score following or machine"},{"type":"text","text":" "},{"type":"text","text":"listening application."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"assess"},{"kind":"text","text":"("},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAssess","preciseIdentifier":"s:7IvorMXL9MXLAssessV","text":"MXLAssess"},{"kind":"text","text":")"}],"languages":["swift"]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxllisten\/item\/assess(_:)"]}],"metadata":{"roleHeading":"Case","modules":[{"name":"IvorMXL"}],"symbolKind":"case","role":"symbol","externalID":"s:7IvorMXL9MXLListenV4ItemO6assessyAeA9MXLAssessVcAEmF","title":"MXLListen.Item.assess(_:)","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"assess"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLAssessV","text":"MXLAssess"},{"kind":"text","text":")"}]},"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLListen","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLListen\/Item"]]},"kind":"symbol","sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLListen\/Item\/assess(_:)"},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLListen/Item/assess(_:)":{"type":"topic","abstract":[{"type":"text","text":"The assess element overrides the default assessment of a note for a score following or machine"},{"type":"text","text":" "},{"type":"text","text":"listening application."}],"role":"symbol","title":"MXLListen.Item.assess(_:)","kind":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"assess"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLAssessV","text":"MXLAssess"},{"kind":"text","text":")"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLListen\/Item\/assess(_:)","url":"\/documentation\/ivormxl\/mxllisten\/item\/assess(_:)"},"doc://IvorMXL/documentation/IvorMXL/MXLAssess":{"type":"topic","abstract":[{"type":"text","text":"By default, an assessment application should assess all notes without a cue child element, and not assess any"},{"type":"text","text":" "},{"type":"text","text":"note with a cue child element. The assess type allows this default assessment to be overridden for individual"},{"type":"text","text":" "},{"type":"text","text":"notes. The optional player and time-only attributes restrict the type to apply to a single player or set of"},{"type":"text","text":" "},{"type":"text","text":"times through a repeated section, respectively. If missing, the type applies to all players or all times"},{"type":"text","text":" "},{"type":"text","text":"through the repeated section, respectively. The player attribute references the id attribute of a player"},{"type":"text","text":" "},{"type":"text","text":"element defined within the matching score-part."}],"url":"\/documentation\/ivormxl\/mxlassess","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLAssess"}],"kind":"symbol","title":"MXLAssess","navigatorTitle":[{"kind":"identifier","text":"MXLAssess"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAssess","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLListen/Item":{"type":"topic","title":"MXLListen.Item","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLListen\/Item","abstract":[{"type":"text","text":"One of the alternatives for Listen."}],"role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Item","kind":"identifier"}],"navigatorTitle":[{"text":"Item","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxllisten\/item"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLListen":{"type":"topic","title":"MXLListen","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLListen","abstract":[{"type":"text","text":"The listen and listening types, new in Version 4.0, specify different ways that a score following or machine"},{"type":"text","text":" "},{"type":"text","text":"listening application can interact with a performer. The listen type handles interactions that are specific to"},{"type":"text","text":" "},{"type":"text","text":"a note. If multiple child elements of the same type are present, they should have distinct player and\/or time-"},{"type":"text","text":" "},{"type":"text","text":"only attributes."}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLListen","kind":"identifier"}],"navigatorTitle":[{"text":"MXLListen","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxllisten"}}}