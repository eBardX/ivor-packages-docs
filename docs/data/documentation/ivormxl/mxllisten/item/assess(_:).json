ivormxl\/mxllisten","abstract":[{"text":"The listen and listening types, new in Version 4.0, specify different ways that a score following or machine","type":"text"},{"text":" ","type":"text"},{"text":"listening application can interact with a performer. The listen type handles interactions that are specific to","type":"text"},{"text":" ","type":"text"},{"text":"a note. If multiple child elements of the same type are present, they should have distinct player and\/or time-","type":"text"},{"text":" ","type":"text"},{"text":"only attributes.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLListen/Item":{"abstract":[{"text":"One of the alternatives for Listen.","type":"text"}],"title":"MXLListen.Item","kind":"symbol","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Item","kind":"identifier"}],"navigatorTitle":[{"text":"Item","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxllisten\/item","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLListen\/Item"},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLListen/Item/assess(_:)":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLListen\/Item\/assess(_:)","fragments":[{"kind":"keyword","text":"case"},{"text":" ","kind":"text"},{"kind":"identifier","text":"assess"},{"kind":"text","text":"("},{"text":"MXLAssess","preciseIdentifier":"s:7IvorMXL9MXLAssessV","kind":"typeIdentifier"},{"kind":"text","text":")"}],"role":"symbol","type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxllisten\/item\/assess(_:)","title":"MXLListen.Item.assess(_:)","abstract":[{"type":"text","text":"The assess element overrides the default assessment of a note for a score following or machine"},{"type":"text","text":" "},{"type":"text","text":"listening application."}]},"doc://IvorMXL/documentation/IvorMXL/MXLAssess":{"title":"MXLAssess","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLAssess","kind":"identifier"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlassess","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAssess","abstract":[{"type":"text","text":"By default, an assessment application should assess all notes without a cue child element, and not assess any"},{"type":"text","text":" "},{"type":"text","text":"note with a cue child element. The assess type allows this default assessment to be overridden for individual"},{"type":"text","text":" "},{"type":"text","text":"notes. The optional player and time-only attributes restrict the type to apply to a single player or set of"},{"type":"text","text":" "},{"type":"text","text":"times through a repeated section, respectively. If missing, the type applies to all players or all times"},{"type":"text","text":" "},{"type":"text","text":"through the repeated section, respectively. The player attribute references the id attribute of a player"},{"type":"text","text":" "},{"type":"text","text":"element defined within the matching score-part."}],"navigatorTitle":[{"text":"MXLAssess","kind":"identifier"}]}}}