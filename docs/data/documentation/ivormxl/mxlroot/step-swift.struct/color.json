xt":" ","type":"text"},{"text":"text attribute indicates how the root should appear in a score if not using the element contents.","type":"text"}],"navigatorTitle":[{"text":"Step","kind":"identifier"}],"title":"MXLRoot.Step","type":"topic","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLRoot":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRoot","url":"\/documentation\/ivormxl\/mxlroot","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLRoot","kind":"identifier"}],"abstract":[{"text":"The root type indicates a pitch like C, D, E vs. a scale degree like 1, 2, 3. It is used with chord symbols in","type":"text"},{"text":" ","type":"text"},{"text":"popular music. The root element has a root-step and optional root-alter element similar to the step and alter","type":"text"},{"text":" ","type":"text"},{"text":"elements, but renamed to distinguish the different musical meanings.","type":"text"}],"navigatorTitle":[{"text":"MXLRoot","kind":"identifier"}],"title":"MXLRoot","type":"topic","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLRoot/Step-swift.struct/color":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRoot\/Step-swift.struct\/color","url":"\/documentation\/ivormxl\/mxlroot\/step-swift.struct\/color","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"color","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLColor","preciseIdentifier":"s:7IvorMXL8MXLColorV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"abstract":[{"text":"The color attribute group indicates the color of an element.","type":"text"}],"title":"color","type":"topic","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlcolor","title":"MXLColor","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"type":"text","text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is"},{"type":"text","text":" "},{"type":"text","text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]}}}