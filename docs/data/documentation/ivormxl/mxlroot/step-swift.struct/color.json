nd":"text"},{"text":"MXLColor","preciseIdentifier":"s:7IvorMXL8MXLColorV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"type":"topic","role":"symbol","title":"color","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRoot\/Step-swift.struct\/color","abstract":[{"text":"The color attribute group indicates the color of an element.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlroot\/step-swift.struct\/color"},"doc://IvorMXL/documentation/IvorMXL/MXLRoot/Step-swift.struct":{"title":"MXLRoot.Step","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"Step","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"Step"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRoot\/Step-swift.struct","url":"\/documentation\/ivormxl\/mxlroot\/step-swift.struct","type":"topic","abstract":[{"text":"The root-step type represents the pitch step of the root of the current chord within the harmony element. The","type":"text"},{"text":" ","type":"text"},{"text":"text attribute indicates how the root should appear in a score if not using the element contents.","type":"text"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"title":"MXLColor","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"abstract":[{"text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in","type":"text"},{"text":" ","type":"text"},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"url":"\/documentation\/ivormxl\/mxlcolor"},"doc://IvorMXL/documentation/IvorMXL/MXLRoot":{"title":"MXLRoot","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLRoot"}],"navigatorTitle":[{"text":"MXLRoot","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRoot","url":"\/documentation\/ivormxl\/mxlroot","type":"topic","abstract":[{"type":"text","text":"The root type indicates a pitch like C, D, E vs. a scale degree like 1, 2, 3. It is used with chord symbols in"},{"type":"text","text":" "},{"type":"text","text":"popular music. The root element has a root-step and optional root-alter element similar to the step and alter"},{"type":"text","text":" "},{"type":"text","text":"elements, but renamed to distinguish the different musical meanings."}],"role":"symbol"}}}