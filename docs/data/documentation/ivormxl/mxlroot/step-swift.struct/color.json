color","role":"symbol","title":"color"},"doc://IvorMXL/documentation/IvorMXL/MXLRoot":{"type":"topic","abstract":[{"type":"text","text":"The root type indicates a pitch like C, D, E vs. a scale degree like 1, 2, 3. It is used with chord symbols in"},{"type":"text","text":" "},{"type":"text","text":"popular music. The root element has a root-step and optional root-alter element similar to the step and alter"},{"type":"text","text":" "},{"type":"text","text":"elements, but renamed to distinguish the different musical meanings."}],"url":"\/documentation\/ivormxl\/mxlroot","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLRoot"}],"kind":"symbol","title":"MXLRoot","navigatorTitle":[{"kind":"identifier","text":"MXLRoot"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRoot","role":"symbol"}}}