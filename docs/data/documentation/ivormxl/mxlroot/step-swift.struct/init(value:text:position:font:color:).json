nlineContent":[{"type":"text","text":"The font attribute group gathers together attributes for determining the font within"},{"type":"text","text":" "},{"type":"text","text":"a credit or direction. They are based on the text styles for Cascading Style Sheets."},{"type":"text","text":" "},{"type":"text","text":"The font-family is a comma-separated list of font names. The font-style can be normal"},{"type":"text","text":" "},{"type":"text","text":"or italic. The font-size can be one of the CSS sizes or a numeric point size. The"},{"type":"text","text":" "},{"type":"text","text":"font-weight can be normal or bold. The default is application-dependent, but is a"},{"type":"text","text":" "},{"type":"text","text":"text font vs. a music font."}]}]},{"name":"color","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The color attribute group indicates the color of an element."}]}]}],"kind":"parameters"}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLRoot/Step-swift.struct/init(value:text:position:font:color:)":{"url":"\/documentation\/ivormxl\/mxlroot\/step-swift.struct\/init(value:text:position:font:color:)","type":"topic","abstract":[{"text":"Creates a new ","type":"text"},{"code":"MXLRoot.Step","type":"codeVoice"},{"text":".","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRoot\/Step-swift.struct\/init(value:text:position:font:color:)","kind":"symbol","title":"init(value:text:position:font:color:)","role":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"value","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLStep","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL7MXLStepO"},{"text":", ","kind":"text"},{"text":"text","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?, ","kind":"text"},{"text":"position","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLPosition","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLPositionV"},{"text":", ","kind":"text"},{"text":"font","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLFont","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL7MXLFontV"},{"text":", ","kind":"text"},{"text":"color","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLColor","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLColorV"},{"text":"?)","kind":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLPosition":{"type":"topic","abstract":[{"type":"text","text":"For most elements, any program will compute a default x and y position. The position attributes let this be"},{"type":"text","text":" "},{"type":"text","text":"changed two ways."}],"url":"\/documentation\/ivormxl\/mxlposition","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPosition"}],"kind":"symbol","title":"MXLPosition","navigatorTitle":[{"kind":"identifier","text":"MXLPosition"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLRoot":{"type":"topic","abstract":[{"type":"text","text":"The root type indicates a pitch like C, D, E vs. a scale degree like 1, 2, 3. It is used with chord symbols in"},{"type":"text","text":" "},{"type":"text","text":"popular music. The root element has a root-step and optional root-alter element similar to the step and alter"},{"type":"text","text":" "},{"type":"text","text":"elements, but renamed to distinguish the different musical meanings."}],"url":"\/documentation\/ivormxl\/mxlroot","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLRoot"}],"kind":"symbol","title":"MXLRoot","navigatorTitle":[{"kind":"identifier","text":"MXLRoot"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRoot","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"type":"topic","abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"type":"text","text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is"},{"type":"text","text":" "},{"type":"text","text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF."}],"url":"\/documentation\/ivormxl\/mxlcolor","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"kind":"symbol","title":"MXLColor","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLStep":{"title":"MXLStep","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLStep","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlstep","role":"symbol","navigatorTitle":[{"text":"MXLStep","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStep","abstract":[{"text":"The step type represents a step of the diatonic scale, represented using the English letters A through G.","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLRoot/Step-swift.struct":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRoot\/Step-swift.struct","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Step","kind":"identifier"}],"role":"symbol","abstract":[{"text":"The root-step type represents the pitch step of the root of the current chord within the harmony element. The","type":"text"},{"text":" ","type":"text"},{"text":"text attribute indicates how the root should appear in a score if not using the element contents.","type":"text"}],"navigatorTitle":[{"text":"Step","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlroot\/step-swift.struct","kind":"symbol","title":"MXLRoot.Step"},"doc://IvorMXL/documentation/IvorMXL/MXLFont":{"type":"topic","title":"MXLFont","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","abstract":[{"type":"text","text":"The font attribute group gathers together attributes for determining the font within a credit or direction."},{"type":"text","text":" "},{"type":"text","text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of"},{"type":"text","text":" "},{"type":"text","text":"font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric"},{"type":"text","text":" "},{"type":"text","text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font"},{"type":"text","text":" "},{"type":"text","text":"vs. a music font."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFont"}],"navigatorTitle":[{"kind":"identifier","text":"MXLFont"}],"url":"\/documentation\/ivormxl\/mxlfont"}}}