on\/ivormxl\/mxlroot\/step-swift.struct","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Step","kind":"identifier"}],"abstract":[{"text":"The root-step type represents the pitch step of the root of the current chord within the harmony element. The","type":"text"},{"text":" ","type":"text"},{"text":"text attribute indicates how the root should appear in a score if not using the element contents.","type":"text"}],"navigatorTitle":[{"text":"Step","kind":"identifier"}],"title":"MXLRoot.Step","type":"topic","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLRoot":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRoot","url":"\/documentation\/ivormxl\/mxlroot","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLRoot","kind":"identifier"}],"abstract":[{"text":"The root type indicates a pitch like C, D, E vs. a scale degree like 1, 2, 3. It is used with chord symbols in","type":"text"},{"text":" ","type":"text"},{"text":"popular music. The root element has a root-step and optional root-alter element similar to the step and alter","type":"text"},{"text":" ","type":"text"},{"text":"elements, but renamed to distinguish the different musical meanings.","type":"text"}],"navigatorTitle":[{"text":"MXLRoot","kind":"identifier"}],"title":"MXLRoot","type":"topic","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLHarmonyAlter":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLHarmonyAlter","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmonyAlter","type":"topic","role":"symbol","navigatorTitle":[{"text":"MXLHarmonyAlter","kind":"identifier"}],"title":"MXLHarmonyAlter","abstract":[{"type":"text","text":"The harmony-alter type represents the chromatic alteration of the root, numeral, or bass of the current"},{"type":"text","text":" "},{"type":"text","text":"harmony-chord group within the harmony element. In some chord styles, the text of the preceding element may"},{"type":"text","text":" "},{"type":"text","text":"include alteration information. In that case, the print-object attribute of this type can be set to no. The"},{"type":"text","text":" "},{"type":"text","text":"location attribute indicates whether the alteration should appear to the left or the right of the preceding"},{"type":"text","text":" "},{"type":"text","text":"element. Its default value varies by element."}],"url":"\/documentation\/ivormxl\/mxlharmonyalter"}}}