{"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRoot"]]},"variants":[{"paths":["\/documentation\/ivormxl\/mxlroot\/init(step:alter:)"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"Creates a new ","type":"text"},{"code":"MXLRoot","type":"codeVoice"},{"text":".","type":"text"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"init","kind":"keyword"},{"text":"(","kind":"text"},{"text":"step","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL7MXLRootV4StepV","text":"Step","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRoot\/Step-swift.struct","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"alter","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL15MXLHarmonyAlterV","text":"MXLHarmonyAlter","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmonyAlter","kind":"typeIdentifier"},{"text":"? = nil)","kind":"text"}],"platforms":["macOS"]}],"kind":"declarations"},{"parameters":[{"name":"step","content":[{"type":"paragraph","inlineContent":[{"text":"The pitch step of the root of the current chord.","type":"text"}]}]},{"name":"alter","content":[{"type":"paragraph","inlineContent":[{"text":"The root-alter element represents the chromatic alteration of the root of the current chord","type":"text"},{"text":" ","type":"text"},{"text":"within the harmony element. In some chord styles, the text for the root-step element may","type":"text"},{"text":" ","type":"text"},{"text":"include root-alter information. In that case, the print-object attribute of the root-alter","type":"text"},{"text":" ","type":"text"},{"text":"element can be set to no. The location attribute indicates whether the alteration should","type":"text"},{"text":" ","type":"text"},{"text":"appear to the left or the right of the root-step; it is right by default.","type":"text"}]}]}],"kind":"parameters"}],