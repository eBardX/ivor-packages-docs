/documentation\/IvorMXL\/MXLRoot","url":"\/documentation\/ivormxl\/mxlroot","type":"topic","abstract":[{"type":"text","text":"The root type indicates a pitch like C, D, E vs. a scale degree like 1, 2, 3. It is used with chord symbols in"},{"type":"text","text":" "},{"type":"text","text":"popular music. The root element has a root-step and optional root-alter element similar to the step and alter"},{"type":"text","text":" "},{"type":"text","text":"elements, but renamed to distinguish the different musical meanings."}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLHarmonyAlter":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLHarmonyAlter","kind":"identifier"}],"navigatorTitle":[{"text":"MXLHarmonyAlter","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmonyAlter","type":"topic","url":"\/documentation\/ivormxl\/mxlharmonyalter","abstract":[{"type":"text","text":"The harmony-alter type represents the chromatic alteration of the root, numeral, or bass of the current"},{"type":"text","text":" "},{"type":"text","text":"harmony-chord group within the harmony element. In some chord styles, the text of the preceding element may"},{"type":"text","text":" "},{"type":"text","text":"include alteration information. In that case, the print-object attribute of this type can be set to no. The"},{"type":"text","text":" "},{"type":"text","text":"location attribute indicates whether the alteration should appear to the left or the right of the preceding"},{"type":"text","text":" "},{"type":"text","text":"element. Its default value varies by element."}],"title":"MXLHarmonyAlter","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLRoot/init(step:alter:)":{"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRoot\/init(step:alter:)","abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLRoot"},{"type":"text","text":"."}],"role":"symbol","ti