{"metadata":{"externalID":"s:7IvorMXL7MXLRootV4step5alterA2C4StepV_AA15MXLHarmonyAlterVSgtcfc","title":"init(step:alter:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"step"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Step","preciseIdentifier":"s:7IvorMXL7MXLRootV4StepV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"alter"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLHarmonyAlter","preciseIdentifier":"s:7IvorMXL15MXLHarmonyAlterV"},{"kind":"text","text":"?)"}],"symbolKind":"init","roleHeading":"Initializer","modules":[{"name":"IvorMXL"}],"role":"symbol"},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"step"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Step","preciseIdentifier":"s:7IvorMXL7MXLRootV4StepV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRoot\/Step-swift.struct"},{"kind":"text","text":", "},{"kind":"externalParam","text":"alter"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLHarmonyAlter","preciseIdentifier":"s:7IvorMXL15MXLHarmonyAlterV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmonyAlter"},{"kind":"text","text":"? = nil)"}]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"step","content":[{"inlineContent":[{"type":"text","text":"The pitch step of the root of the current chord."}],"type":"paragraph"}]},{"name":"alter","content":[{"inlineContent":[{"type":"text","text":"The root-alter element represents the chromatic alteration of the root of the current chord within the harmony element. In some chord styles, the text for the root-step element may include root-alter information. In that case, the print-object attribute of the root-alter element can be set to no. The location attribute indicates whether the alteration