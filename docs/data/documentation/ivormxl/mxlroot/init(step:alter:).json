LRoot","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLRoot/Step-swift.struct":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRoot\/Step-swift.struct","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Step","kind":"identifier"}],"role":"symbol","abstract":[{"text":"The root-step type represents the pitch step of the root of the current chord within the harmony element. The","type":"text"},{"text":" ","type":"text"},{"text":"text attribute indicates how the root should appear in a score if not using the element contents.","type":"text"}],"navigatorTitle":[{"text":"Step","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlroot\/step-swift.struct","kind":"symbol","title":"MXLRoot.Step"}}}