{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNormalizer\/normalize(_:)"},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"normalize"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"document"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLDocument","preciseIdentifier":"s:7IvorMXL11MXLDocumentV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDocument"},{"kind":"text","text":") -> ("},{"kind":"typeIdentifier","text":"MXLDocument","preciseIdentifier":"s:7IvorMXL11MXLDocumentV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDocument"},{"kind":"text","text":", ["},{"kind":"typeIdentifier","text":"Change","preciseIdentifier":"s:7IvorMXL13MXLNormalizerV6ChangeO","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNormalizer\/Change"},{"kind":"text","text":"])"}],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"name":"document","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The document to normalize."}]}]}]},{"kind":"content","content":[{"level":2,"anchor":"return-value","text":"Return Value","type":"heading"},{"inlineContent":[{"type":"text","text":"A tuple of a new "},{"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDocument","isActive":true},{"type":"text","text":" whose"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDocument\/isNormalized","isActive":true},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":", and an array of"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNormalizer\/Change","isActive":true},{"type":"text","text":" values describing each normalization applied."}],"type":"paragraph"}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Normalization is idempotent: calling "},{"type":"codeVoice","code":"normalize(_:)"},{"type":"text","text":" on an"},{"type":"text","text":" "},{"type":"text","text":"already-normalized document returns it immediately with an empty changes"},{"type":"text","text":" "},{"type":"text","text":"array."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A part-wise score is run through an ordered chain of per-version"},{"type":"text","text":" "},{"type":"text","text":"migration passes, entering at its declared version and stamping the"},{"type":"text","text":" "},{"type":"text","text":"result with the most recent supported version. A time-wise score is first"},{"type":"text","text":" "},{"type":"text","text":"converted to part-wise — that conversion is itself a deprecation"},{"type":"text","text":" "},{"type":"text","text":"migration — and then run through the same chain, so a normalized document"},{"type":"text","text":" "},{"type":"text","text":"is never time-wise. An opus has no migration passes — the opus schema has"},{"type":"text","text":" "},{"type":"text","text":"never changed structurally — but it does take the same closing version"},{"type":"text","text":" "},{"type":"text","text":"stamp, applied at every level of nesting. Normalizing a document whose"},{"type":"text","text":" "},{"type":"text","text":"content changes clears"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDocument\/isValidated","isActive":true},{"type":"text","text":", since any prior validation no longer applies."}],"type":"paragraph"}]}],"metadata":{"symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"normalize","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIde