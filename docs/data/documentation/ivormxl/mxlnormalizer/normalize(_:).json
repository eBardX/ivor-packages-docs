:" "},{"type":"text","text":"stamp, applied at every level of nesting. Normalizing a document whose"},{"type":"text","text":" "},{"type":"text","text":"content changes clears"},{"type":"text","text":" "},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDocument\/isValidated","type":"reference","isActive":true},{"type":"text","text":", since any prior validation no longer applies."}]}],"kind":"content"}],"metadata":{"modules":[{"name":"IvorMXL"}],"role":"symbol","roleHeading":"Instance Method","extendedModule":"IvorMXL","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"normalize","kind":"identifier"},{"text":"(","kind":"text"},{"text":"MXLDocument","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLDocumentV"},{"text":") -> (","kind":"text"},{"text":"MXLDocument","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLDocumentV"},{"text":", [","kind":"text"},{"text":"Change","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL13MXLNormalizerV6ChangeO"},{"text":"])","kind":"text"}],"symbolKind":"method","externalID":"s:7IvorMXL13MXLNormalizerV9normalizeyAA11MXLDocumentV_SayAC6ChangeOGtAFF","title":"normalize(_:)"},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLDocument/isValidated":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDocument\/isValidated","type":"topic","abstract":[{"text":"A Boolean value indicating whether this document has been validated by","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValidator\/validate(_:)","isActive":true,"type":"reference"},{"text":".","type":"text"}],"kind":"symbol","title":"isValidated","url":"\/documentation\/ivormxl\/mxldocument\/isvalidated","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"isValidated"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}]},"doc://IvorMXL/documentation/Iv