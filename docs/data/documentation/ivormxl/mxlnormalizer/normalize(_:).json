{"abstract":[{"type":"text","text":"Returns a copy of the provided document normalized to the most recent"},{"type":"text","text":" "},{"type":"text","text":"supported MusicXML version, along with an array describing each change"},{"type":"text","text":" "},{"type":"text","text":"applied."}],"metadata":{"modules":[{"name":"IvorMXL"}],"extendedModule":"IvorMXL","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"normalize","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:7IvorMXL11MXLDocumentV","text":"MXLDocument","kind":"typeIdentifier"},{"text":") -> (","kind":"text"},{"preciseIdentifier":"s:7IvorMXL11MXLDocumentV","text":"MXLDocument","kind":"typeIdentifier"},{"text":", [","kind":"text"},{"preciseIdentifier":"s:7IvorMXL13MXLNormalizerV6ChangeO","text":"Change","kind":"typeIdentifier"},{"text":"])","kind":"text"}],"roleHeading":"Instance Method","symbolKind":"method","role":"symbol","title":"normalize(_:)","externalID":"s:7IvorMXL13MXLNormalizerV9normalizeyAA11MXLDocumentV_SayAC6ChangeOGtAFF"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlnormalizer\/normalize(_:)"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"normalize","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"document","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"MXLDocument","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDocument","preciseIdentifier":"s:7IvorMXL11MXLDocumentV"},{"text":") -> (","kind":"text"},{"text":"MXLDocument","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDocument","preciseIdentifier":"s:7IvorMXL11MXLDocumentV"},{"text":", [","kind":"text"},{"text":"Change","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNormalizer\/Change","preciseIdentifier":"s:7IvorMXL13MXLNormalizerV6ChangeO"},{"text":"])","kind":"text"}],"languages":["swift"]}]},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The document to normalize."}]}],"name":"document"}],"kind":"parameters"},{"content":[{"level":2,"type":"heading","text":"Return Value","anchor":"return-value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A tuple of a new "},{"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDocument","isActive":true},{"type":"text","text":" whose"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDocument\/isNormalized","isActive":true},{"type":"text","text":" is "},{"code":"true","type":"codeVoice"},{"type":"text","text":", and an array of"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNormalizer\/Change","isActive":true},{"type":"text","text":" values describing each normalization applied."}]}],"kind":"content"},{"content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Normalization is idempotent: calling "},{"type":"codeVoice","code":"normalize(_:)"},{"type":"text","text":" on an"},{"type":"text","text":" "},{"type":"text","text":"already-normalized document returns it immediately with an empty changes"},{"type":"text","text":" "},{"type":"text","text":"array."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A part-wise score is run through an ordered chain of per-version"},{"type":"text","text":" "},{"type":"text","text":"migration passes, entering at its declared version and stamping the"},{"type":"text","text":" "},{"type":"text","text":"result with the most recent supported version. A time-wise score is first"},{"type":"text","text":" "},{"type":"text","text":"converted to part-wise — that conversion is itself a deprecation"},{"type":"text","text":" "},{"type":"text","text":"migration — and then run through the same chain, so a normalized document"},{"type":"text","text":" "},{"type":"text","text":"is never time-wise. An opus has no migration passes — the opus schema has"},{"type":"text","text":" "},{"type":"text","text":"never changed structurally — but it does take the same closing version"},{"type":"text","text":" "},{"type":"text","text":"stamp, applied at every level of nesting. Normalizing a document whose"},{"type":"text","text":" "},{"type":"text","text":"content changes clears"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDocument\/isValidated"},{"type":"text","text":", since any prior validation no longer applies."}]}],"kind":"content"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNormalizer"]]},"kind":"symbol","schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNormalizer\/normalize(_:)"},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLValidator/validate(_:)":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlvalidator\/validate(_:)","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValidator\/validate(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"validate","kind":"identifier"},{"text":"(","kind":"text"},{"text":"MXLDocument","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLDocumentV"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"Error","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL12MXLValidatorV5ErrorO"},{"text":") -> (","kind":"text"},{"text":"MXLDocument","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLDocumentV"},{"text":", [","kind":"text"