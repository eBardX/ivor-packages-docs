{"abstract":[{"type":"text","text":"Creates a new "},{"code":"MXLBookmark","type":"codeVoice"},{"type":"text","text":"."}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"init","kind":"keyword"},{"text":"(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"name","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"elementPosition","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL18MXLElementPositionV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLElementPosition","text":"MXLElementPosition","kind":"typeIdentifier"},{"text":" = MXLElementPosition())","kind":"text"}]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A unique identifier for this bookmark, used as the target of an incoming XLink."}]}],"name":"id"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A name for this bookmark."}]}],"name":"name"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The element and position attributes are new as of Version 2.0. They allow for"},{"type":"text","text":" "},{"type":"text","text":"bookmarks and links to be positioned at higher resolution than the level of"},{"type":"text","text":" "},{"type":"text","text":"music-data elements. When no element and position attributes are present, the"},{"type":"text","text":" "},{"type":"text","text":"bookmark or link element refers to the next sibling element in the MusicXML file."},{"type":"text","text":" "},{"type":"text","text":"The element attribute specifies an element type for a descendant of the next"},{"type":"text","text":" "},{"type":"text","text":"sibling element that is not a link or bookmark. The position attribute specifies"},{"type":"text","text":" "},{"type":"text","text":"the position of this descendant element, where the first position is 1. The"},{"type":"text","text":" "},{"type":"text","text":"position attribute is ignored if the element attribute is not present. For"},{"type":"text","text":" "},{"type":"text","text":"instance, an element value of “beam” and a position value of “2” defines the link"},{"type":"text","text":" "},{"type":"text","text":"or bookmark to refer to the second beam descendant of the next sibling element"},{"type":"text","text":" "},{"type":"text","text":"that is not a link or bookmark. This is equivalent to an XPath test of"},{"type":"text","text":" "},{"type":"text","text":"[.\/\/beam[2]] done in the context of the sibling element."}]}],"name":"elementPosition"}]}],"kind":"symbol","sections":[],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBookmark\/init(id:name:elementPosition:)","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBookmark"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"paths":["\/documentation\/ivormxl\/mxlbookmark\/init(id:name:elementposition:)"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"modules":[{"name":"IvorMXL"}],"externalID":"s:7IvorMXL11MXLBookmarkV2id4name15elementPositionACSS_SSSgAA010MXLElementG0Vtcfc","roleHeading":"Initializer","role":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"name","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"elementPosition","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL18MXLElementPositionV","text":"MXLElementPosition","kind":"typeIdentifier"},{"text":")","kind":"text"}],"title":"init(id:name:elementPosition:)","symbolKind":"init"},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLElementPosition":{"abstract":[{"type":"text","text":"The element and position attributes are new as of Version 2.0. They allow for bookmarks and links to be"},{"type":"text","text":" "},{"type":"text","text":"positioned at higher resolution than the level of music-data elements. When no element and position attributes"},{"type":"text","text":" "},{"type":"text","text":"are present, the bookmark or link element refers to the next sibling element in the MusicXML file. The element"},{"type":"text","text":" "},{"type":"text","text":"attribute specifies an element type for a descendant of the next sibling element that is not a link or"},{"type":"text","text":" "},{"type":"text","text":"bookmark. The position attribute specifies the position of this descendant element, where the first position"},{"type":"text","text":" "},{"type":"text","text":"is 1. The position attribute is ignored if the element attribute is not present. For instance, an element"},{"type":"text","text":" "},{"type":"text","text":"value of “beam” and a position value of “2” defines the link or bookmark to refer to the second beam"},{"type":"text","text":" "},{"type":"text","text":"descendant of the next sibling element that is not a link or bookmark. This is equivalent to an XPath test of"},{"type":"text","text":" "},{"type":"text","text":"[.\/\/beam[2]] done in the context of the sibling element."}],"navigatorTitle":[{"kind":"identifier","text":"MXLElementPosition"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLElementPosition","title":"MXLElementPosition","url":"\/documentation\/ivormxl\/mxlelementposition","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLElementPosition"}]},"doc://IvorMXL/documentation/IvorMXL/MXLBookmark/init(id:name:elementPosition:)":{"kind":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBookmark\/init(id:name:elementPosition:)","role":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"id"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"name"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"elementPosition"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL18MXLElementPositionV","kind":"typeIdentifier","text":"MXLElementPosition"},{"kind":"text","text":")"}],"title":"init(id:name:elementPosition:)","url":"\/documentation\/ivormxl\/mxlbookmark\/init(id:name:elementposition:)","abstract":[{"type":"text","text":"Creates a new "},{"code":"MXLBookmark","type":"codeVoice"},{"type":"text","text":"."}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLBookmark":{"title":"MXLBookmark","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLBookmark"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlbookmark","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLBookmark"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBookmark","abstract":[{"text":"The bookmark type serves as a well-defined target for an incoming simple XLink.","type":"text"}],"type":"topic"}}}