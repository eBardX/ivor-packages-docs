\/ivormxl\/mxlscoretimewise\/partlist","abstract":[{"type":"text","text":"The list of parts that make up the score, along with the part-group elements that indicate braces and"},{"type":"text","text":" "},{"type":"text","text":"brackets between them."}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"partList"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLPartListV","text":"MXLPartList"}],"kind":"symbol","role":"symbol","title":"partList","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScoreTimewise\/partList","type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLScoreTimewise/work":{"url":"\/documentation\/ivormxl\/mxlscoretimewise\/work","abstract":[{"type":"text","text":"The work that identifies the piece, optionally including its number and title."}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"work"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL7MXLWorkV","text":"MXLWork"},{"kind":"text","text":"?"}],"kind":"symbol","role":"symbol","title":"work","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScoreTimewise\/work","type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLPartList":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlpartlist","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartList","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPartList","kind":"identifier"}],"abstract":[{"text":"The part-list identifies the different musical parts in this document. Each part has an ID that is used later","type":"text"},{"text":" ","type":"text"},{"text":"within the musical data. Since parts may be encoded separately and combined later, identification elements are","type":"text"},{"text":" ","type":"text"},{"text":"present at both the score and score-part levels. There must be at least one score-part, combined as desired","type":"text"},{"text":" ","type":"text"},{"text":"with part-group elements that indicate braces and brackets. Parts are ordered from top to bottom in a score","type":"text"},{"text":" ","type":"text"},{"text":"based on the order in which they appear in the part-list.","type":"text"}],"kind":"symbol","type":"topic","navigatorTitle":[{"text":"MXLPartList","kind":"identifier"}],"title":"MXLPartList"},"doc://IvorMXL/documentation/IvorMXL/MXLOpus":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlopus","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOpus","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLOpus"}],"abstract":[{"type":"text","text":"The opus type is used for the root element of a MusicXML opus. Each opus is made up of a series of score,"},{"type":"text","text":" "},{"type":"text","text":"opus-link, and\/or nested opus elements. The document-attributes attribute group includes the version"},{"type":"text","text":" "},{"type":"text","text":"attribute. Future versions may include more metadata elements. In this version, we just include the title of"},{"type":"text","text":" "},{"type":"text","text":"the opus."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLOpus"}],"title":"MXLOpus"},"doc://IvorMXL/documentation/IvorMXL/MXLScoreTimewise/Measure":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Measure","kind":"identifier"}],"navigatorTitle":[{"text":"Measure","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScoreTimewise\/Measure","kind":"symbol","role":"symbol","title":"MXLScoreTimewise.Measure","abstract":[{"text":"Maps the MusicXML ","type":"text"},{"type":"codeVoice","code":"<measure>"},{"text":" element.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlscoretimewise\/measure"}}}