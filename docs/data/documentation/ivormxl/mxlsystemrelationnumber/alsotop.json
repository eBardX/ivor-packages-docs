{"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemRelationNumber"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"symbolKind":"case","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"alsoTop","kind":"identifier"}],"roleHeading":"Case","title":"MXLSystemRelationNumber.alsoTop","role":"symbol","externalID":"s:7IvorMXL23MXLSystemRelationNumberO7alsoTopyA2CmF","modules":[{"name":"IvorMXL"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlsystemrelationnumber\/alsotop"]}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemRelationNumber\/alsoTop"},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"alsoTop","kind":"identifier"}],"languages":["swift"],"platforms":["macOS"]}]}],"abstract":[{"type":"text","text":"The number appears on both the current part and the top part of the current system."}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLSystemRelationNumber/alsoTop":{"type":"topic","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"alsoTop","kind":"identifier"}],"title":"MXLSystemRelationNumber.alsoTop","url":"\/documentation\/ivormxl\/mxlsystemrelationnumber\/alsotop","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemRelationNumber\/alsoTop","role":"symbol","abstract":[{"type":"text","text":"The number appears on both the current part and the top part of the current system."}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLSystemRelationNumber":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemRelationNumber","abstract":[{"type":"text","text":"The system-relation-number type distinguishes measure numbers that are associated with a system rather than"},{"type":"text","text":" "},{"type":"text","text":"the particular part where the element appears. A value of only-top or only-bottom indicates that the number"},{"type":"text","text":" "},{"type":"text","text":"should appear only on the top or bottom part of the current system, respectively. A value of also-top or also-"},{"type":"text","text":" "},{"type":"text","text":"bottom indicates that the number should appear on both the current part and the top or bottom part of the"},{"type":"text","text":" "},{"type":"text","text":"current system, respectively. If these values appear in a score, when parts are created the number should only"},{"type":"text","text":" "},{"type":"text","text":"appear once in this part, not twice. A value of none indicates that the number is associated only with the"},{"type":"text","text":" "},{"type":"text","text":"current part, not with the system."}],"type":"topic","kind":"symbol","title":"MXLSystemRelationNumber","role":"symbol","url":"\/documentation\/ivormxl\/mxlsystemrelationnumber","navigatorTitle":[{"kind":"identifier","text":"MXLSystemRelationNumber"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLSystemRelationNumber"}]}}}