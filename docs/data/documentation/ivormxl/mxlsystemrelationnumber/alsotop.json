numbers that are associated with a system rather than","type":"text"},{"text":" ","type":"text"},{"text":"the particular part where the element appears. A value of only-top or only-bottom indicates that the number","type":"text"},{"text":" ","type":"text"},{"text":"should appear only on the top or bottom part of the current system, respectively. A value of also-top or also-","type":"text"},{"text":" ","type":"text"},{"text":"bottom indicates that the number should appear on both the current part and the top or bottom part of the","type":"text"},{"text":" ","type":"text"},{"text":"current system, respectively. If these values appear in a score, when parts are created the number should only","type":"text"},{"text":" ","type":"text"},{"text":"appear once in this part, not twice. A value of none indicates that the number is associated only with the","type":"text"},{"text":" ","type":"text"},{"text":"current part, not with the system.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLSystemRelationNumber/alsoTop":{"kind":"symbol","title":"MXLSystemRelationNumber.alsoTop","url":"\/documentation\/ivormxl\/mxlsystemrelationnumber\/alsotop","role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"alsoTop","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemRelationNumber\/alsoTop","abstract":[{"text":"The number appears on both the current part and the top part of the current system.","type":"text"}]}}}