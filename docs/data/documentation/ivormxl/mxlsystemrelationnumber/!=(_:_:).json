tion/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLSystemRelationNumber":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlsystemrelationnumber","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemRelationNumber","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSystemRelationNumber","kind":"identifier"}],"abstract":[{"type":"text","text":"The system-relation-number type distinguishes measure numbers that are associated with a system rather than"},{"type":"text","text":" "},{"type":"text","text":"the particular part where the element appears. A value of only-top or only-bottom indicates that the number"},{"type":"text","text":" "},{"type":"text","text":"should appear only on the top or bottom part of the current system, respectively. A value of also-top or also-"},{"type":"text","text":" "},{"type":"text","text":"bottom indicates that the number should appear on both the current part and the top or bottom part of the"},{"type":"text","text":" "},{"type":"text","text":"current system, respectively. If these values appear in a score, when parts are created the number should only"},{"type":"text","text":" "},{"type":"text","text":"appear once in this part, not twice. A value of none indicates that the number is associated only with the"},{"type":"text","text":" "},{"type":"text","text":"current part, not with the system."}],"kind":"symbol","type":"topic","navigatorTitle":[{"text":"MXLSystemRelationNumber","kind":"identifier"}],"title":"MXLSystemRelationNumber"},"doc://IvorMXL/documentation/IvorMXL/MXLSystemRelationNumber/!=(_:_:)":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlsystemrelationnumber\/!=(_:_:)","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\