tion/IvorMXL/MXLSystemRelationNumber":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemRelationNumber","abstract":[{"type":"text","text":"The system-relation-number type distinguishes measure numbers that are associated with a system rather than"},{"type":"text","text":" "},{"type":"text","text":"the particular part where the element appears. A value of only-top or only-bottom indicates that the number"},{"type":"text","text":" "},{"type":"text","text":"should appear only on the top or bottom part of the current system, respectively. A value of also-top or also-"},{"type":"text","text":" "},{"type":"text","text":"bottom indicates that the number should appear on both the current part and the top or bottom part of the"},{"type":"text","text":" "},{"type":"text","text":"current system, respectively. If these values appear in a score, when parts are created the number should only"},{"type":"text","text":" "},{"type":"text","text":"appear once in this part, not twice. A value of none indicates that the number is associated only with the"},{"type":"text","text":" "},{"type":"text","text":"current part, not with the system."}],"type":"topic","kind":"symbol","title":"MXLSystemRelationNumber","role":"symbol","url":"\/documentation\/ivormxl\/mxlsystemrelationnumber","navigatorTitle":[{"kind":"identifier","text":"MXLSystemRelationNumber"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLSystemRelationNumber"}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLSystemRelationNumber/!=(_:_:)":{"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"t