{"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"text":"The number is associated only with the current part, not with the system.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlsystemrelationnumber\/onlypart"]}],"kind":"symbol","primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"onlyPart","kind":"identifier"}]}],"kind":"declarations"}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemRelationNumber"]]},"metadata":{"fragments":[{"kind":"keyword","text":"case"},{"text":" ","kind":"text"},{"kind":"identifier","text":"onlyPart"}],"symbolKind":"case","modules":[{"name":"IvorMXL"}],"roleHeading":"Case","role":"symbol","title":"MXLSystemRelationNumber.onlyPart","externalID":"s:7IvorMXL23MXLSystemRelationNumberO8onlyPartyA2CmF"},"sections":[],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemRelationNumber\/onlyPart","interfaceLanguage":"swift"},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLSystemRelationNumber/onlyPart":{"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlsystemrelationnumber\/onlypart","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"onlyPart"}],"abstract":[{"text":"The number is associated only with the current part, not with the system.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemRelationNumber\/onlyPart","kind":"symbol","title":"MXLSystemRelationNumber.onlyPart"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLSystemRelationNumber":{"type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLSystemRelationNumber"}],"url":"\/documentation\/ivormxl\/mxlsystemrelationnumber","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLSystemRelationNumber"}],"abstract":[{"text":"The system-relation-number type distinguishes measure numbers that are associated with a system rather than","type":"text"},{"text":" ","type":"text"},{"text":"the particular part where the element appears. A value of only-top or only-bottom indicates that the number","type":"text"},{"text":" ","type":"text"},{"text":"should appear only on the top or bottom part of the current system, respectively. A value of also-top or also-","type":"text"},{"text":" ","type":"text"},{"text":"bottom indicates that the number should appear on both the current part and the top or bottom part of the","type":"text"},{"text":" ","type":"text"},{"text":"current system, respectively. If these values appear in a score, when parts are created the number should only","type":"text"},{"text":" ","type":"text"},{"text":"appear once in this part, not twice. A value of none indicates that the number is associated only with the","type":"text"},{"text":" ","type":"text"},{"text":"current part, not with the system.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemRelationNumber","kind":"symbol","title":"MXLSystemRelationNumber"}}}