orMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLSystemRelationNumber":{"type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLSystemRelationNumber"}],"url":"\/documentation\/ivormxl\/mxlsystemrelationnumber","role":"symbol","abstract":[{"text":"The system-relation-number type distinguishes measure numbers that are associated with a system rather than","type":"text"},{"text":" ","type":"text"},{"text":"the particular part where the element appears. A value of only-top or only-bottom indicates that the number","type":"text"},{"type":"text","text":" "},{"text":"should appear only on the top or bottom part of the current system, respectively. A value of also-top or also-","type":"text"},{"text":" ","type":"text"},{"text":"bottom indicates that the number should appear on both the current part and the top or bottom part of the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"current system, respectively. If these values appear in a score, when parts are created the number should only"},{"type":"text","text":" "},{"type":"text","text":"appear once in this part, not twice. A value of none indicates that the number is associated only with the"},{"type":"text","text":" "},{"type":"text","text":"current part, not with the system."}],"kind":"symbol","title":"MXLSystemRelationNumber","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemRelationNumber","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLSystemRelationNumber"}]}}}