{"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemRelationNumber"]]},"metadata":{"role":"symbol","externalID":"s:7IvorMXL23MXLSystemRelationNumberO10alsoBottomyA2CmF","modules":[{"name":"IvorMXL"}],"symbolKind":"case","roleHeading":"Case","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"alsoBottom"}],"title":"MXLSystemRelationNumber.alsoBottom"},"sections":[],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemRelationNumber\/alsoBottom","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"alsoBottom"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"}],"kind":"symbol","abstract":[{"type":"text","text":"The number appears on both the current part and the bottom part of the current system."}],"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlsystemrelationnumber\/alsobottom"]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLSystemRelationNumber/alsoBottom":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlsystemrelationnumber\/alsobottom","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemRelationNumber\/alsoBottom","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"alsoBottom","kind":"identifier"}],"abstract":[{"type":"text","text":"The number appears on both the current part and the bottom part of the current system."}],"kind":"symbol","type":"topic","title":"MXLSystemRelationNumber.alsoBottom"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLSystemRelationNumber":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlsystemrelationnumber","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemRelationNumber","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSystemRelationNumber","kind":"identifier"}],"abstract":[{"type":"text","text":"The system-relation-number type distinguishes measure numbers that are associated with a system rather than"},{"type":"text","text":" "},{"type":"text","text":"the particular part where the element appears. A value of only-top or only-bottom indicates that the number"},{"type":"text","text":" "},{"type":"text","text":"should appear only on the top or bottom part of the current system, respectively. A value of also-top or also-"},{"type":"text","text":" "},{"type":"text","text":"bottom indicates that the number should appear on both the current part and the top or bottom part of the"},{"type":"text","text":" "},{"type":"text","text":"current system, respectively. If these values appear in a score, when parts are created the number should only"},{"type":"text","text":" "},{"type":"text","text":"appear once in this part, not twice. A value of none indicates that the number is associated only with the"},{"type":"text","text":" "},{"type":"text","text":"current part, not with the system."}],"kind":"symbol","type":"topic","navigatorTitle":[{"text":"MXLSystemRelationNumber","kind":"identifier"}],"title":"MXLSystemRelationNumber"}}}