{"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemRelationNumber\/alsoBottom","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemRelationNumber"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"alsoBottom","kind":"identifier"}],"platforms":["macOS"]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlsystemrelationnumber\/alsobottom"]}],"abstract":[{"type":"text","text":"The number appears on both the current part and the bottom part of the current system."}],"metadata":{"symbolKind":"case","role":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"alsoBottom"}],"title":"MXLSystemRelationNumber.alsoBottom","modules":[{"name":"IvorMXL"}],"roleHeading":"Case","externalID":"s:7IvorMXL23MXLSystemRelationNumberO10alsoBottomyA2CmF"},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLSystemRelationNumber/alsoBottom":{"kind":"symbol","role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"alsoBottom","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemRelationNumber\/alsoBottom","type":"topic","abstract":[{"text":"The number appears on both the current part and the bottom part of the current system.","type":"text"}],"title":"MXLSystemRelationNumber.alsoBottom","url":"\/documentation\/ivormxl\/mxlsystemrelationnumber\/alsobottom"},"doc://IvorMXL/documentation/IvorMXL/MXLSystemRelationNumber":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemRelationNumber","abstract":[{"type":"text","text":"The system-relation-number type distinguishes measure numbers that are associated with a system rather than"},{"type":"text","text":" "},{"type":"text","text":"the particular part where the element appears. A value of only-top or only-bottom indicates that the number"},{"type":"text","text":" "},{"type":"text","text":"should appear only on the top or bottom part of the current system, respectively. A value of also-top or also-"},{"type":"text","text":" "},{"type":"text","text":"bottom indicates that the number should appear on both the current part and the top or bottom part of the"},{"type":"text","text":" "},{"type":"text","text":"current system, respectively. If these values appear in a score, when parts are created the number should only"},{"type":"text","text":" "},{"type":"text","text":"appear once in this part, not twice. A value of none indicates that the number is associated only with the"},{"type":"text","text":" "},{"type":"text","text":"current part, not with the system."}],"type":"topic","kind":"symbol","title":"MXLSystemRelationNumber","role":"symbol","url":"\/documentation\/ivormxl\/mxlsystemrelationnumber","navigatorTitle":[{"kind":"identifier","text":"MXLSystemRelationNumber"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLSystemRelationNumber"}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"}}}