{"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScaling\/tenths","interfaceLanguage":"swift"},"kind":"symbol","schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"variants":[{"paths":["\/documentation\/ivormxl\/mxlscaling\/tenths"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"tenths"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLTenths","preciseIdentifier":"s:7IvorMXL9MXLTenthsa","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Maps to a nested MusicXML ","type":"text"},{"type":"codeVoice","code":"<tenths>"},{"text":" element.","type":"text"}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScaling"]]},"metadata":{"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"tenths"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLTenths","preciseIdentifier":"s:7IvorMXL9MXLTenthsa"}],"symbolKind":"property","externalID":"s:7IvorMXL10MXLScalingV6tenthsSdvp","modules":[{"name":"IvorMXL"}],"role":"symbol","title":"tenths","roleHeading":"Instance Property"},"abstract":[{"text":"The number of tenths that correspond to the given number of millimeters.","type":"text"}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLScaling":{"abstract":[{"type":"text","text":"Margins, page sizes, and distances are all measured in tenths to keep MusicXML data in a consistent coordinate"},{"type":"text","text":" "},{"type":"text","text":"system as much as possible. The translation to absolute units is done with the scaling type, which specifies"},{"type":"text","text":" "},{"type":"text","text":"how many millimeters are equal to how many tenths. For a staff height of 7 mm, millimeters would be set to 7"},{"type":"text","text":" "},{"type":"text","text":"while tenths is set to 40. The ability to set a formula rather than a single scaling factor helps avoid"},{"type":"text","text":" "},{"type":"text","text":"roundoff errors."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLScaling","kind":"identifier"}],"title":"MXLScaling","role":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLScaling"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlscaling","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScaling"},"doc://IvorMXL/documentation/IvorMXL/MXLScaling/tenths":{"title":"tenths","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScaling\/tenths","type":"topic","abstract":[{"text":"The number of tenths that correspond to the given number of millimeters.","type":"text"}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"tenths"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLTenthsa","text":"MXLTenths"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlscaling\/tenths"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLTenths":{"title":"MXLTenths","type":"topic","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTenths","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxltenths","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"MXLTenths","kind":"identifier"}],"abstract":[{"type":"text","text":"The tenths type is a number representing tenths of interline staff space (positive or negative). Both integer"},{"type":"text","text":" "},{"type":"text","text":"and decimal values are allowed, such as 5 for a half space and 2.5 for a quarter space. Interline space is"},{"type":"text","text":" "},{"type":"text","text":"measured from the middle of a staff line."}]}}}