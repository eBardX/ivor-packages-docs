{"abstract":[{"type":"text","text":"The number of tenths that correspond to the given number of millimeters."}],"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"symbol","metadata":{"symbolKind":"property","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"tenths"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLTenthsa","text":"MXLTenths"}],"role":"symbol","modules":[{"name":"IvorMXL"}],"externalID":"s:7IvorMXL10MXLScalingV6tenthsSdvp","title":"tenths","roleHeading":"Instance Property"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScaling"]]},"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScaling\/tenths","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/ivormxl\/mxlscaling\/tenths"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"let","kind":"keyword"},{"kind":"text","text":" "},{"text":"tenths","kind":"identifier"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL9MXLTenthsa","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths","text":"MXLTenths","kind":"typeIdentifier"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Maps to a nested MusicXML "},{"code":"<tenths>","type":"codeVoice"},{"type":"text","text":" element."}]}]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLTenths":{"title":"MXLTenths","kind":"symbol","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTenths"}],"abstract":[{"type":"text","text":"The tenths type is a number representing tenths of interline staff space (positive or negative). Both integer"},{"type":"text","text":" "},{"type":"text","text":"and decimal values are allowed, such as 5 for a half space and 2.5 for a quarter space. Interline space is"},{"type":"text","text":" "},{"type":"text","text":"measured from the middle of a staff line."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLTenths"}],"url":"\/documentation\/ivormxl\/mxltenths"},"doc://IvorMXL/documentation/IvorMXL/MXLScaling/tenths":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlscaling\/tenths","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScaling\/tenths","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"tenths","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLTenths","preciseIdentifier":"s:7IvorMXL9MXLTenthsa","kind":"typeIdentifier"}],"abstract":[{"text":"The number of tenths that correspond to the given number of millimeters.","type":"text"}],"kind":"symbol","type":"topic","title":"tenths"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLScaling":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlscaling","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScaling","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLScaling","kind":"identifier"}],"abstract":[{"text":"Margins, page sizes, and distances are all measured in tenths to keep MusicXML data in a consistent coordinate","type":"text"},{"text":" ","type":"text"},{"text":"system as much as possible. The translation to absolute units is done with the scaling type, which specifies","type":"text"},{"text":" ","type":"text"},{"text":"how many millimeters are equal to how many tenths. For a staff height of 7 mm, millimeters would be set to 7","type":"text"},{"text":" ","type":"text"},{"text":"while tenths is set to 40. The ability to set a formula rather than a single scaling factor helps avoid","type":"text"},{"text":" ","type":"text"},{"text":"roundoff errors.","type":"text"}],"kind":"symbol","type":"topic","navigatorTitle":[{"text":"MXLScaling","kind":"identifier"}],"title":"MXLScaling"}}}