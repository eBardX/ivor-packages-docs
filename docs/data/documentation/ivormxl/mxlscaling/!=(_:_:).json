,"text":"Margins, page sizes, and distances are all measured in tenths to keep MusicXML data in a consistent coordinate"},{"type":"text","text":" "},{"type":"text","text":"system as much as possible. The translation to absolute units is done with the scaling type, which specifies"},{"type":"text","text":" "},{"type":"text","text":"how many millimeters are equal to how many tenths. For a staff height of 7 mm, millimeters would be set to 7"},{"type":"text","text":" "},{"type":"text","text":"while tenths is set to 40. The ability to set a formula rather than a single scaling factor helps avoid"},{"type":"text","text":" "},{"type":"text","text":"roundoff errors."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLScaling","kind":"identifier"}],"title":"MXLScaling","role":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLScaling"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlscaling","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScaling"},"doc://IvorMXL/documentation/IvorMXL/MXLScaling/!=(_:_:)":{"abstract":[],"kind":"symbol","type":"topic","role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"!=","kind":"identifier"},{"text":" ","kind":"text"},{"text":"(","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"title":"!=(_:_:)","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScaling\/!=(_:_:)","url":"\/documentation\/ivormxl\/mxlscaling\/!=(_:_:)"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, valida