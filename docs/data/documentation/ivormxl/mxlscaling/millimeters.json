rMXL/documentation/IvorMXL/MXLScaling/millimeters":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScaling\/millimeters","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"millimeters"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL14MXLMillimetersa","kind":"typeIdentifier","text":"MXLMillimeters"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlscaling\/millimeters","kind":"symbol","title":"millimeters","abstract":[{"text":"The number of millimeters that correspond to the given number of tenths.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLScaling":{"abstract":[{"type":"text","text":"Margins, page sizes, and distances are all measured in tenths to keep MusicXML data in a consistent coordinate"},{"type":"text","text":" "},{"type":"text","text":"system as much as possible. The translation to absolute units is done with the scaling type, which specifies"},{"type":"text","text":" "},{"type":"text","text":"how many millimeters are equal to how many tenths. For a staff height of 7 mm, millimeters would be set to 7"},{"type":"text","text":" "},{"type":"text","text":"while tenths is set to 40. The ability to set a formula rather than a single scaling factor helps avoid"},{"type":"text","text":" "},{"type":"text","text":"roundoff errors."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLScaling","kind":"identifier"}],"title":"MXLScaling","role":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLScaling"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlscaling","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScaling"},"doc://IvorMXL/documentation/IvorMXL/MXLMillimeters":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMillimeters","navigatorTitle":[{"kind":"identifier","text":"MXLMillimeters"}],"role":"symbol","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLMillimeters"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlmillimeters","kind":"symbol","title":"MXLMillimeters","abstract":[{"text":"The millimeters type is a number representing millimeters. This is used in the scaling element to provide a","type":"text"},{"text":" ","type":"text"},{"text":"default scaling from tenths to physical units.","type":"text"}]}}}