xt"},{"text":" ","type":"text"},{"text":"while tenths is set to 40. The ability to set a formula rather than a single scaling factor helps avoid","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"roundoff errors."}],"kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLScaling","kind":"identifier"}],"title":"MXLScaling"}}}