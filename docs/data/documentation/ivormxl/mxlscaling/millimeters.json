 ","type":"text"},{"text":"default scaling from tenths to physical units.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlmillimeters","kind":"symbol","navigatorTitle":[{"text":"MXLMillimeters","kind":"identifier"}],"type":"topic","title":"MXLMillimeters","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLMillimeters","kind":"identifier"}],"role":"symbol"}}}