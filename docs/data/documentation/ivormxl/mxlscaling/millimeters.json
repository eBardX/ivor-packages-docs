rMXL/documentation/IvorMXL/MXLScaling/millimeters":{"abstract":[{"type":"text","text":"The number of millimeters that correspond to the given number of tenths."}],"title":"millimeters","kind":"symbol","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"millimeters","kind":"identifier"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"MXLMillimeters","preciseIdentifier":"s:7IvorMXL14MXLMillimetersa"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlscaling\/millimeters","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScaling\/millimeters"},"doc://IvorMXL/documentation/IvorMXL/MXLScaling":{"abstract":[{"type":"text","text":"Margins, page sizes, and distances are all measured in tenths to keep MusicXML data in a consistent coordinate"},{"text":" ","type":"text"},{"type":"text","text":"system as much as possible. The translation to absolute units is done with the scaling type, which specifies"},{"text":" ","type":"text"},{"text":"how many millimeters are equal to how many tenths. For a staff height of 7 mm, millimeters would be set to 7","type":"text"},{"text":" ","type":"text"},{"text":"while tenths is set to 40. The ability to set a formula rather than a single scaling factor helps avoid","type":"text"},{"text":" ","type":"text"},{"text":"roundoff errors.","type":"text"}],"title":"MXLScaling","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLScaling","kind":"identifier"}],"navigatorTitle":[{"text":"MXLScaling","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlscaling","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScaling"},"doc://IvorMXL/documentation/IvorMXL/MXLMillimeters":{"abstract":[{"type":"text","text":"The millimeters type is a number representing millimeters. This is used in the scaling element to provide a"},{"type":"text","text":" "},{"type":"text","text":"default scaling from tenths to physical units."}],"title":"MXLMillimeters","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLMillimeters"}],"navigatorTitle":[{"kind":"identifier","text":"MXLMillimeters"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlmillimeters","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMillimeters"}}}