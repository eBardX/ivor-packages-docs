ontent":[{"type":"paragraph","inlineContent":[{"text":"The number of tenths that correspond to the given number of millimeters.","type":"text"}]}],"name":"tenths"}],"kind":"parameters"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScaling\/init(millimeters:tenths:)"},"sections":[],"kind":"symbol","references":{"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLScaling/init(millimeters:tenths:)":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScaling\/init(millimeters:tenths:)","role":"symbol","kind":"symbol","url":"\/documentation\/ivormxl\/mxlscaling\/init(millimeters:tenths:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"millimeters"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLMillimeters","preciseIdentifier":"s:7IvorMXL14MXLMillimetersa"},{"kind":"text","text":", "},{"kind":"externalParam","text":"tenths"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLTenths","preciseIdentifier":"s:7IvorMXL9MXLTenthsa"},{"kind":"text","text":")"}],"type":"topic","title":"init(millimeters:tenths:)","abstract":[{"text":"Creates a new ","type":"text"},{"code":"MXLScaling","type":"codeVoice"},{"text":".","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLMillimeters":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMillimeters","abstract":[{"text":"The millimeters type is a number representing millimeters. This is used in the scaling element to provide a","type":"text"},{"text":" ","type":"text"},{"text":"default scaling from tenths to physical units.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlmillimeters","kind":"symbol","navigatorTitle":[{"text":"MXLMillimeters","kind":"identifier"}],"type":"topic","title":"MXLMillimeters","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLMillimeters","kind":"identifier"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLScaling":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlscaling","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScaling","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLScaling","kind":"identifier"}],"abstract":[{"text":"Margins, page sizes, and distances are all measured in tenths to keep MusicXML data in a consistent coordinate","type":"text"},{"text":" ","type":"text"},{"text":"system as much as possible. The translation to absolute units is done with the scaling type, which specifies","type":"text"},{"text":" ","type":"text"},{"text":"how many millimeters are equal to how many tenths. For a staff height of 7 mm, millimeters would be set to 7","type":"text"},{"text":" ","type":"text"},{"text":"while tenths is set to 40. The ability to set a formula rather than a single scaling factor helps avoid","type":"text"},{"text":" ","type":"text"},{"text":"roundoff errors.","type":"text"}],"kind":"symbol","type":"topic","navigatorTitle":[{"text":"MXLScaling","kind":"identifier"}],"title":"MXLScaling"},"doc://IvorMXL/documentation/IvorMXL/MXLTenths":{"title":"MXLTenths","kind":"symbol","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTenths"}],"abstract":[{"type":"text","text":"The tenths type is a number representing tenths of interline staff space (positive or negative). Both integer"},{"type":"text","text":" "},{"type":"text","text":"and decimal values are allowed, such as 5 for a half space and 2.5 for a quarter space. Interline space is"},{"type":"text","text":" "},{"type":"text","text":"measured from the middle of a staff line."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLTenths"}],"url":"\/documentation\/ivormxl\/mxltenths"}}}