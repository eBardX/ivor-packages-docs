rs":[{"name":"millimeters","content":[{"type":"paragraph","inlineContent":[{"text":"The number of millimeters that correspond to the given number of tenths.","type":"text"}]}]},{"name":"tenths","content":[{"type":"paragraph","inlineContent":[{"text":"The number of tenths that correspond to the given number of millimeters.","type":"text"}]}]}]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLTenths":{"title":"MXLTenths","type":"topic","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTenths","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxltenths","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"MXLTenths","kind":"identifier"}],"abstract":[{"type":"text","text":"The tenths type is a number representing tenths of interline staff space (positive or negative). Both integer"},{"type":"text","text":" "},{"type":"text","text":"and decimal values are allowed, such as 5 for a half space and 2.5 for a quarter space. Interline space is"},{"type":"text","text":" "},{"type":"text","text":"measured from the middle of a staff line."}]},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLScaling/init(millimeters:tenths:)":{"title":"init(millimeters:tenths:)","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScaling\/init(millimeters:tenths:)","type":"topic","abstract":[{"text":"Creates a new ","type":"text"},{"code":"MXLScaling","type":"codeVoice"},{"text":".","type":"text"}],"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"millimeters"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL14MXLMillimetersa","text":"MXLMillimeters"},{"kind":"text","text":", "},{"kind":"externalParam","text":"tenths"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLTenthsa","text":"MXLTenths"},{"kind":"text","text":")"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlscaling\/init(millimeters:tenths:)"},"doc://IvorMXL/documentation/IvorMXL/MXLScaling":{"abstract":[{"type":"text","text":"Margins, page sizes, and distances are all measured in tenths to keep MusicXML data in a consistent coordinate"},{"type":"text","text":" "},{"type":"text","text":"system as much as possible. The translation to absolute units is done with the scaling type, which specifies"},{"type":"text","text":" "},{"type":"text","text":"how many millimeters are equal to how many tenths. For a staff height of 7 mm, millimeters would be set to 7"},{"type":"text","text":" "},{"type":"text","text":"while tenths is set to 40. The ability to set a formula rather than a single scaling factor helps avoid"},{"type":"text","text":" "},{"type":"text","text":"roundoff errors."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLScaling","kind":"identifier"}],"title":"MXLScaling","role":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLScaling"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlscaling","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScaling"},"doc://IvorMXL/documentation/IvorMXL/MXLMillimeters":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMillimeters","navigatorTitle":[{"kind":"identifier","text":"MXLMillimeters"}],"role":"symbol","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLMillimeters"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlmillimeters","kind":"symbol","title":"MXLMillimeters","abstract":[{"text":"The millimeters type is a number representing millimeters. This is used in the scaling element to provide a","type":"text"},{"text":" ","type":"text"},{"text":"default scaling from tenths to physical units.","type":"text"}]}}}