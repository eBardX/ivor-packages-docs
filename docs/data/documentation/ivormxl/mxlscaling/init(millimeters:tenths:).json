":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLTenths"}],"abstract":[{"type":"text","text":"The tenths type is a number representing tenths of interline staff space (positive or negative). Both integer"},{"type":"text","text":" "},{"type":"text","text":"and decimal values are allowed, such as 5 for a half space and 2.5 for a quarter space. Interline space is"},{"type":"text","text":" "},{"type":"text","text":"measured from the middle of a staff line."}],"kind":"symbol","title":"MXLTenths","url":"\/documentation\/ivormxl\/mxltenths","role":"symbol","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTenths"}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLScaling":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScaling","url":"\/documentation\/ivormxl\/mxlscaling","navigatorTitle":[{"text":"MXLScaling","kind":"identifier"}],"type":"topic","abstract":[{"text":"Margins, page sizes, and distances are all measured in tenths to keep MusicXML data in a consistent coordinate","type":"text"},{"text":" ","type":"text"},{"text":"system as much as possible. The translation to absolute units is done with the scaling type, which specifies","type":"text"},{"type":"text","text":" "},{"text":"how many millimeters are equal to how many tenths. For a staff height of 7 mm, millimeters would be set to 7","type":"text"},{"text":" ","type":"text"},{"text":"while tenths is set to 40. The ability to set a formula rather than a single scaling factor helps avoid","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"roundoff errors."}],"kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLScaling","kind":"identifier"}],"title":"MXLScaling"}}}