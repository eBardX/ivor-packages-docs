t","text":": "},{"text":"MXLMillimeters","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL14MXLMillimetersa"},{"text":", ","kind":"text"},{"text":"tenths","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLTenths","preciseIdentifier":"s:7IvorMXL9MXLTenthsa","kind":"typeIdentifier"},{"text":")","kind":"text"}],"role":"symbol"},"references":{"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLScaling/init(millimeters:tenths:)":{"url":"\/documentation\/ivormxl\/mxlscaling\/init(millimeters:tenths:)","abstract":[{"text":"Creates a new ","type":"text"},{"code":"MXLScaling","type":"codeVoice"},{"type":"text","text":"."}],"kind":"symbol","title":"init(millimeters:tenths:)","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScaling\/init(millimeters:tenths:)","type":"topic","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"millimeters"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLMillimeters","preciseIdentifier":"s:7IvorMXL14MXLMillimetersa"},{"kind":"text","text":", "},{"kind":"externalParam","text":"tenths"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLTenths","preciseIdentifier":"s:7IvorMXL9MXLTenthsa"},{"kind":"text","text":")"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLScaling":{"abstract":[{"type":"text","text":"Margins, page sizes, and distances are all measured in tenths to keep MusicXML data in a consistent coordinate"},{"text":" ","type":"text"},{"type":"text","text":"system as much as possible. The translation to absolute units is done with the scaling type, which specifies"},{"text":" ","type":"text"},{"text":"how many millimeters are equal to how many tenths. For a staff height of 7 mm, millimeters would be set to 7","type":"text"},{"text":" ","type":"text"},{"text":"while tenths is set to 40. The ability to set a formula rather than a single scaling factor helps avoid","type":"text"},{"text":" ","type":"text"},{"text":"roundoff errors.","type":"text"}],"title":"MXLScaling","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLScaling","kind":"identifier"}],"navigatorTitle":[{"text":"MXLScaling","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlscaling","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScaling"},"doc://IvorMXL/documentation/IvorMXL/MXLMillimeters":{"abstract":[{"type":"text","text":"The millimeters type is a number representing millimeters. This is used in the scaling element to provide a"},{"type":"text","text":" "},{"type":"text","text":"default scaling from tenths to physical units."}],"title":"MXLMillimeters","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLMillimeters"}],"navigatorTitle":[{"kind":"identifier","text":"MXLMillimeters"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlmillimeters","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMillimeters"},"doc://IvorMXL/documentation/IvorMXL/MXLTenths":{"abstract":[{"text":"The tenths type is a number representing tenths of interline staff space (positive or negative). Both integer","type":"text"},{"text":" ","type":"text"},{"text":"and decimal values are allowed, such as 5 for a half space and 2.5 for a quarter space. Interline space is","type":"text"},{"text":" ","type":"text"},{"text":"measured from the middle of a staff line.","type":"text"}],"title":"MXLTenths","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTenths"}],"navigatorTitle":[{"kind":"identifier","text":"MXLTenths"}],"type":"topic","url":"\/documentation\/ivormxl\/mxltenths","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths"}}}