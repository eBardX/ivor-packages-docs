entifier":"s:7IvorMXL8MXLColorV"},{"kind":"text","text":"?)"}],"abstract":[{"text":"Creates a new ","type":"text"},{"code":"MXLMeasureStyle","type":"codeVoice"},{"text":".","type":"text"}],"type":"topic","title":"init(id:content:number:font:color:)"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlcolor","title":"MXLColor","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"type":"text","text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is"},{"type":"text","text":" "},{"type":"text","text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor"},"doc://IvorMXL/documentation/IvorMXL/MXLMeasureStyle":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlmeasurestyle","title":"MXLMeasureStyle","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLMeasureStyle"}],"navigatorTitle":[{"kind":"identifier","text":"MXLMeasureStyle"}],"abstract":[{"type":"text","text":"A measure-style indicates a special way to print partial to multiple measures within a part. This includes"},{"type":"text","text":" "},{"type":"text","text":"multiple rests over several measures, repeats of beats, single, or multiple measures, and use of slash"},{"type":"text","text":" "},{"type":"text","text":"notation."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMeasureStyle"},"doc://IvorMXL/documentation/IvorMXL/MXLFont":{"title":"MXLFont","url":"\/documentation\/ivormxl\/mxlfont","role":"symbol","navigatorTitle":[{"text":"MXLFont","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","abstract":[{"text":"The font attribute group gathers together attributes for determining the font within a credit or direction.","type":"text"},{"text":" ","type":"text"},{"text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric"},{"type":"text","text":" "},{"type":"text","text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font"},{"type":"text","text":" "},{"type":"text","text":"vs. a music font."}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLFont","kind":"identifier"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLStaffNumber":{"type":"topic","title":"MXLStaffNumber","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLStaffNumber"}],"url":"\/documentation\/ivormxl\/mxlstaffnumber","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffNumber","role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLStaffNumber"}],"abstract":[{"text":"The staff-number type indicates staff numbers within a multi-staff part. Staves are numbered from top to","type":"text"},{"text":" ","type":"text"},{"text":"bottom, with 1 being the top staff on a part.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLMeasureStyle/Content-swift.enum":{"url":"\/documentation\/ivormxl\/mxlmeasurestyle\/content-swift.enum","title":"MXLMeasureStyle.Content","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMeasureStyle\/Content-swift.enum","abstract":[{"type":"text","text":"One of the alternatives for MeasureStyle."}],"type":"topic","role":"symbol","navigatorTitle":[{"text":"Content","kind":"identifier"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Content","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]}}}