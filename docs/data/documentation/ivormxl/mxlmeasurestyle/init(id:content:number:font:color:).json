{"abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLMeasureStyle"},{"type":"text","text":"."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"id"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"content"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMeasureStyle\/Content-swift.enum","preciseIdentifier":"s:7IvorMXL15MXLMeasureStyleV7ContentO","text":"Content"},{"kind":"text","text":", "},{"kind":"externalParam","text":"number"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffNumber","preciseIdentifier":"s:7IvorMXL14MXLStaffNumberV","text":"MXLStaffNumber"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"font"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","preciseIdentifier":"s:7IvorMXL7MXLFontV","text":"MXLFont"},{"kind":"text","text":" = MXLFont(), "},{"kind":"externalParam","text":"color"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","preciseIdentifier":"s:7IvorMXL8MXLColorV","text":"MXLColor"},{"kind":"text","text":"? = nil)"}],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"text":"The optional-unique-id attribute group allows an element to optionally specify an ID that","type":"text"},{"text":" ","type":"text"},{"text":"is unique to the entire document. This attribute group is not used for a required id","type":"text"},{"text":" ","type":"text"},{"text":"attribute, or for an id attribute that specifies an id reference.","type":"text"}],"type":"paragraph"}],"name":"id"},{"content":[{"inlineContent":[{"text":"One of the alternatives for MeasureStyle.","type":"text"}],"type":"paragraph"}],"name":"content"},{"content":[{"inlineContent":[{"text":"The staff number, from top to bottom on the system, that this element applies to.","type":"text"}],"type":"paragraph"}],"name":"number"},{"content":[{"inlineContent":[{"text":"The font attribute group gathers together attributes for determining the font within a","type":"text"},{"text":" ","type":"text"},{"text":"credit or direction. They are based on the text styles for Cascading Style Sheets. The","type":"text"},{"text":" ","type":"text"},{"text":"font-family is a comma-separated list of font names. The font-style can be normal or","type":"text"},{"text":" ","type":"text"},{"text":"italic. The font-size can be one of the CSS sizes or a numeric point size. The font-weight","type":"text"},{"text":" ","type":"text"},{"text":"can be normal or bold. The default is application-dependent, but is a text font vs. a","type":"text"},{"text":" ","type":"text"},{"text":"music font.","type":"text"}],"type":"paragraph"}],"name":"font"},{"content":[{"inlineContent":[{"text":"The color attribute group indicates the color of an element.","type":"text"}],"type":"paragraph"}],"name":"color"}]}],"variants":[{"paths":["\/documentation\/ivormxl\/mxlmeasurestyle\/init(id:content:number:font:color:)"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"roleHeading":"Initializer","modules":[{"name":"IvorMXL"}],"symbolKind":"init","role":"symbol","externalID":"s:7IvorMXL15MXLMeasureStyleV2id7content6number4font5colorACSSSg_AC7ContentOAA14MXLStaffNumberVSgAA7MXLFontVAA8MXLColorVSgtcfc","title":"init(id:content:number:font:color:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"id"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam