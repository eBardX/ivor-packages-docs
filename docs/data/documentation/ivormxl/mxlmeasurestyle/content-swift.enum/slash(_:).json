d","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLMeasureStyle"}],"abstract":[{"text":"A measure-style indicates a special way to print partial to multiple measures within a part. This includes","type":"text"},{"text":" ","type":"text"},{"text":"multiple rests over several measures, repeats of beats, single, or multiple measures, and use of slash","type":"text"},{"text":" ","type":"text"},{"text":"notation.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMeasureStyle","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLMeasureStyle"}],"url":"\/documentation\/ivormxl\/mxlmeasurestyle"},"doc://IvorMXL/documentation/IvorMXL/MXLSlash":{"type":"topic","title":"MXLSlash","navigatorTitle":[{"text":"MXLSlash","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSlash","kind":"identifier"}],"abstract":[{"type":"text","text":"The slash type is used to indicate that slash notation is to be used. If the slash is on every beat, use-stems"},{"type":"text","text":" "},{"type":"text","text":"is no (the default). To indicate rhythms but not pitches, use-stems is set to yes. The type attribute"},{"type":"text","text":" "},{"type":"text","text":"indicates whether this is the start or stop of a slash notation style. The use-dots attribute works as for the"},{"type":"text","text":" "},{"type":"text","text":"beat-repeat element, and only has effect if use-stems is no."}],"url":"\/documentation\/ivormxl\/mxlslash","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSlash","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLMeasureStyle/Content-swift.enum/slash(_:)":{"role":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxlmeasurestyle\/content-swift.enum\/slash(_:)","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMeasureStyle\/Content-swift.enum\/slash(_:)","abstract":[{"type":"text","tex