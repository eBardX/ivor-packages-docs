{"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"roleHeading":"Case","symbolKind":"case","modules":[{"name":"IvorMXL"}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"supports"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLSupportsV","text":"MXLSupports"},{"kind":"text","text":")"}],"title":"MXLEncoding.Item.supports(_:)","externalID":"s:7IvorMXL11MXLEncodingV4ItemO8supportsyAeA11MXLSupportsVcAEmF","role":"symbol"},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlencoding\/item\/supports(_:)"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"supports"},{"kind":"text","text":"("},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSupports","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLSupportsV","text":"MXLSupports"},{"kind":"text","text":")"}],"platforms":["macOS"],"languages":["swift"]}]}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEncoding\/Item\/supports(_:)","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEncoding","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEncoding\/Item"]]},"sections":[],"abstract":[{"type":"text","text":"Indicates whether a MusicXML encoding supports a particular MusicXML element, attribute, or value."}],"references":{"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLEncoding":{"abstract":[{"text":"The encoding element contains information about who did the digital encoding, when, with what software, and in","type":"text"},{"text":" ","type":"text"},{"text":"what aspects. Standard type values for the encoder element are music, words, and arrangement, but other types","type":"text"},{"text":" ","type":"text"},{"text":"may be used. The type attribute is only needed when there are multiple encoder elements.","type":"text"}],"title":"MXLEncoding","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLEncoding","kind":"identifier"}],"navigatorTitle":[{"text":"MXLEncoding","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlencoding","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEncoding"},"doc://IvorMXL/documentation/IvorMXL/MXLSupports":{"title":"MXLSupports","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSupports","kind":"identifier"}],"kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxlsupports","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSupports","abstract":[{"type":"text","text":"The supports type indicates if a MusicXML encoding supports a particular MusicXML element. This is recommended"},{"type":"text","text":" "},{"type":"text","text":"for elements like beam, stem, and accidental, where the absence of an element is ambiguous if you do not know"},{"type":"text","text":" "},{"type":"text","text":"if the encoding supports that element. For Version 2.0, the supports element is expanded to allow programs to"},{"type":"text","text":" "},{"type":"text","text":"indicate support for particular attributes or particular values. This lets applications communicate, for"},{"type":"text","text":" "},{"type":"text","text":"example, that all system and\/or page breaks are contained in the MusicXML file."}],"navigatorTitle":[{"text":"MXLSupports","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLEncoding/Item":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEncoding\/Item","title":"MXLEncoding.Item","kind":"symbol","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Item","kind":"identifier"}],"navigatorTitle":[{"text":"Item","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlencoding\/item","abstract":[{"text":"One of the alternatives for Encoding.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLEncoding/Item/supports(_:)":{"url":"\/documentation\/ivormxl\/mxlencoding\/item\/supports(_:)","kind":"symbol","title":"MXLEncoding.Item.supports(_:)","abstract":[{"type":"text","text":"Indicates whether a MusicXML encoding supports a particular MusicXML element, attribute, or value."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEncoding\/Item\/supports(_:)","type":"topic","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"supports","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:7IvorMXL11MXLSupportsV","text":"MXLSupports","kind":"typeIdentifier"},{"text":")","kind":"text"}],"role":"symbol"}}}