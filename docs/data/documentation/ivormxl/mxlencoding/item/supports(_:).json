ports"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLSupportsV","text":"MXLSupports"},{"kind":"text","text":")"}],"title":"MXLEncoding.Item.supports(_:)","url":"\/documentation\/ivormxl\/mxlencoding\/item\/supports(_:)","role":"symbol","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLEncoding/Item":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEncoding\/Item","abstract":[{"type":"text","text":"One of the alternatives for Encoding."}],"type":"topic","kind":"symbol","title":"MXLEncoding.Item","url":"\/documentation\/ivormxl\/mxlencoding\/item","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Item","kind":"identifier"}],"navigatorTitle":[{"text":"Item","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLEncoding":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEncoding","abstract":[{"type":"text","text":"The encoding element contains information about who did the digital encoding, when, with what software, and in"},{"type":"text","text":" "},{"type":"text","text":"what aspects. Standard type values for the encoder element are music, words, and arrangement, but other types"},{"type":"text","text":" "},{"type":"text","text":"may be used. The type attribute is only needed when there are multiple encoder elements."}],"type":"topic","kind":"symbol","title":"MXLEncoding","url":"\/documentation\/ivormxl\/mxlencoding","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLEncoding","kind":"identifier"}],"navigatorTitle":[{"text":"MXLEncoding","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLSupports":{"type":"topic","title":"MXLSupports","navigatorTitle":[{"kind":"identifier","text":"MXLSupports"}],"fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLSupports"}],"abstract":[{"text":"The supports type indicates if a MusicXML encoding supports a particular MusicXML element. This is recommended","type":"text"},{"text":" ","type":"text"},{"text":"for elements like beam, stem, and accidental, where the absence of an element is ambiguous if you do not know","type":"text"},{"text":" ","type":"text"},{"text":"if the encoding supports that element. For Version 2.0, the supports element is expanded to allow programs to","type":"text"},{"text":" ","type":"text"},{"text":"indicate support for particular attributes or particular values. This lets applications communicate, for","type":"text"},{"text":" ","type":"text"},{"text":"example, that all system and\/or page breaks are contained in the MusicXML file.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlsupports","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSupports","role":"symbol"}}}