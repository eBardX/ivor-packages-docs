{"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEncoding","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEncoding\/Item"]]},"metadata":{"role":"symbol","modules":[{"name":"IvorMXL"}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"supports"},{"kind":"text","text":"("},{"preciseIdentifier":"s:7IvorMXL11MXLSupportsV","kind":"typeIdentifier","text":"MXLSupports"},{"kind":"text","text":")"}],"symbolKind":"case","externalID":"s:7IvorMXL11MXLEncodingV4ItemO8supportsyAeA11MXLSupportsVcAEmF","title":"MXLEncoding.Item.supports(_:)","roleHeading":"Case"},"abstract":[{"type":"text","text":"Indicates whether a MusicXML encoding supports a particular MusicXML element, attribute, or value."}],"sections":[],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"supports"},{"kind":"text","text":"("},{"preciseIdentifier":"s:7IvorMXL11MXLSupportsV","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSupports","text":"MXLSupports"},{"kind":"text","text":")"}],"platforms":["macOS"]}],"kind":"declarations"}],"kind":"symbol","variants":[{"paths":["\/documentation\/ivormxl\/mxlencoding\/item\/supports(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEncoding\/Item\/supports(_:)","interfaceLanguage":"swift"},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLEncoding":{"type":"topic","abstract":[{"type":"text","text":"The encoding element contains information about who did the digital encoding, when, with what software, and in"},{"type":"text","text":" "},{"type":"text","text":"what aspects. Standard type values for the encoder element are music, words, and arrangement, but other types"},{"type":"text","text":" "},{"type":"text","text":"may be used. The type attribute is only needed when there are multiple encoder elements."}],"url":"\/documentation\/ivormxl\/mxlencoding","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLEncoding"}],"kind":"symbol","title":"MXLEncoding","navigatorTitle":[{"kind":"identifier","text":"MXLEncoding"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEncoding","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLEncoding/Item/supports(_:)":{"type":"topic","abstract":[{"type":"text","text":"Indicates whether a MusicXML encoding supports a particular MusicXML element, attribute, or value."}],"url":"\/documentation\/ivormxl\/mxlencoding\/item\/supports(_:)","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"supports"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLSupportsV","text":"MXLSupports"},{"kind":"text","text":")"}],"kind":"symbol","title":"MXLEncoding.Item.supports(_:)","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEncoding\/Item\/supports(_:)","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLEncoding/Item":{"type":"topic","abstract":[{"type":"text","text":"One of the alternatives for Encoding."}],"url":"\/documentation\/ivormxl\/mxlencoding\/item","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Item"}],"kind":"symbol","title":"MXLEncoding.Item","navigatorTitle":[{"kind":"identifier","text":"Item"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEncoding\/Item","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLSupports":{"type":"topic","abstract":[{"type":"text","text":"The supports type indicates if a MusicXML encoding supports a particular MusicXML element. This is recommended"},{"type":"text","text":" "},{"type":"text","text":"for elements like beam, stem, and accidental, where the absence of an element is ambiguous if you do not know"},{"type":"text","text":" "},{"type":"text","text":"if the encoding supports that element. For Version 2.0, the supports element is expanded to allow programs to"},{"type":"text","text":" "},{"type":"text","text":"indicate support for particular attributes or particular values. This lets applications communicate, for"},{"type":"text","text":" "},{"type":"text","text":"example, that all system and\/or page breaks are contained in the MusicXML file."}],"url":"\/documentation\/ivormxl\/mxlsupports","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLSupports"}],"kind":"symbol","title":"MXLSupports","navigatorTitle":[{"kind":"identifier","text":"MXLSupports"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSupports","role":"symbol"}}}