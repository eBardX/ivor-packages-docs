cumentation\/ivormxl\/mxlencoding\/item","type":"topic","title":"MXLEncoding.Item"},"doc://IvorMXL/documentation/IvorMXL/MXLEncoding/Item/supports(_:)":{"abstract":[{"type":"text","text":"Indicates whether a MusicXML encoding supports a particular MusicXML element, attribute, or value."}],"url":"\/documentation\/ivormxl\/mxlencoding\/item\/supports(_:)","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEncoding\/Item\/supports(_:)","type":"topic","role":"symbol","kind":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"supports","kind":"identifier"},{"text":"(","kind":"text"},{"text":"MXLSupports","preciseIdentifier":"s:7IvorMXL11MXLSupportsV","kind":"typeIdentifier"},{"text":")","kind":"text"}],"title":"MXLEncoding.Item.supports(_:)"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLSupports":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSupports","role":"symbol","navigatorTitle":[{"text":"MXLSupports","kind":"identifier"}],"type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSupports","kind":"identifier"}],"abstract":[{"type":"text","text":"The supports type indicates if a MusicXML encoding supports a particular MusicXML element. This is recommended"},{"type":"text","text":" "},{"type":"text","text":"for elements like beam, stem, and accidental, where the absence of an element is ambiguous if you do not know"},{"type":"text","text":" "},{"type":"text","text":"if the encoding supports that element. For Version 2.0, the supports element is expanded to allow programs to"},{"type":"text","text":" "},{"type":"text","text":"indicate support for particular attributes or particular values. This lets applications communicate, for"},{"type":"text","text":" "},{"type":"text","text":"example, that all system and\/or page breaks are contained in the MusicXML file."}],"url":"\/documentation\/ivormxl\/mxlsupports","title":"MXLSupports"},"doc://IvorMXL/documentation/IvorMXL/MXLEncoding":{"type":"topic","title":"MXLEncoding","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLEncoding"}],"url":"\/documentation\/ivormxl\/mxlencoding","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEncoding","role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLEncoding"}],"abstract":[{"text":"The encoding element contains information about who did the digital encoding, when, with what software, and in","type":"text"},{"text":" ","type":"text"},{"text":"what aspects. Standard type values for the encoder element are music, words, and arrangement, but other types","type":"text"},{"text":" ","type":"text"},{"text":"may be used. The type attribute is only needed when there are multiple encoder elements.","type":"text"}]}}}