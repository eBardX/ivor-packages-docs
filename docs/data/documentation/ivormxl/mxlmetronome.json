parentheses attribute indicates","type":"text"},{"text":" ","type":"text"},{"text":"whether or not to put the metronome mark in parentheses; its value is no if not specified. The print-object","type":"text"},{"text":" ","type":"text"},{"text":"attribute is set to no in cases where the metronome element represents a relationship or range that is not","type":"text"},{"text":" ","type":"text"},{"text":"displayed in the music notation.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlmetronome"},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome/Equatable-Implementations":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/Equatable-Implementations","url":"\/documentation\/ivormxl\/mxlmetronome\/equatable-implementations","abstract":[],"kind":"article","title":"Equatable Implementations","type":"topic","role":"collectionGroup"},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome/halign":{"type":"topic","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"halign","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLLeftCenterRight","preciseIdentifier":"s:7IvorMXL18MXLLeftCenterRightO","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/halign","abstract":[{"text":"In cases where text extends over more than one line, horizontal alignment and justify values can be different.","type":"text"},{"type":"text","text":" "},{"text":"The most typical case is for credits, such as:","type":"text"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlmetronome\/halign","title":"halign"},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome/id":{"url":"\/documentation\/ivormxl\/mxlmetronome\/id","title":"id","type":"topic","abstract":[{"type":"text","text":"The optional-unique-id attribute group allows an element to optionally specify an ID that is unique to the"},{"type":"text","text":" "},{"type":"text","text":"entire