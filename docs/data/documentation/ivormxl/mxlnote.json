ccidental":{"url":"\/documentation\/ivormxl\/mxlnote\/accidental","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/accidental","kind":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"accidental"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL13MXLAccidentalV","kind":"typeIdentifier","text":"MXLAccidental"},{"kind":"text","text":"?"}],"title":"accidental","abstract":[{"text":"The accidental to be displayed for this note, if any.","type":"text"}],"type":"topic","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline":{"navigatorTitle":[{"text":"MXLBarline","kind":"identifier"}],"abstract":[{"text":"If a barline is other than a normal single barline, it should be represented by a barline type that describes","type":"text"},{"text":" ","type":"text"},{"text":"it. This includes information about repeats and multiple endings, as well as line style. Barline data is on","type":"text"},{"text":" ","type":"text"},{"text":"the same level as the other musical data in a score — a child of a measure in a partwise score, or a part in a","type":"text"},{"text":" ","type":"text"},{"text":"timewise score. This allows for barlines within measures, as in dotted barlines that subdivide measures in","type":"text"},{"text":" ","type":"text"},{"text":"complex meters. The two fermata elements allow for fermatas on both sides of the barline (the lower one","type":"text"},{"text":" ","type":"text"},{"text":"inverted).","type":"text"}],"title":"MXLBarline","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline","kind":"symbol","url":"\/documentation\/ivormxl\/mxlbarline","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLBarline","kind":"identifier"}],"role":"symbol"},"doc://IvorMXL/SH":{"title":"Swift.Hashable","identifier":"doc:\/\/IvorMXL\/SH","type":"unresolvable"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/printsLeger":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/printsLeger","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"printsLeger"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}],"role":"symbol","type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlnote\/printsleger","title":"printsLeger","abstract":[{"type":"text","text":"A Boolean value indicating whether leger lines are printed. Notes without leger lines indicate indeterminate"},{"type":"text","text":" "},{"type":"text","text":"high and low notes. Defaults to "},{"type":"codeVoice","code":"true"},{"type":"text","text":"; ignored for rests."}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote/beam":{"url":"\/documentation\/ivormxl\/mxlnote\/beam","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/beam","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"beam","kind":"identifier"},{"text":": [","kind":"text"},{"text":"MXLBeam","preciseIdentifier":"s:7IvorMXL7MXLBeamV","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"kind":"symbol","abstract":[{"text":"The beam markings associated with this note.","type":"text"}],"type":"topic","title":"beam"},"doc://IvorMXL/documentation/IvorMXL/MXLRest":{"kind":"symbol","navigatorTitle":[{"text":"MXLRest","kind":"identifier"}],"title":"MXLRest","url":"\/documentation\/ivormxl\/mxlrest","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLRest","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRest","abstract":[{"text":"The rest element indicates notated rests or silences. Rest elements are usually empty, but placement on the","type":"text"},{"text":" ","type":"text"},{"text":"staff can be specified using display-step and display-octave elements. If the measure attribute is set to yes,","type":"text"},{"text":" ","type":"text"},{"text":"this indicates this is a complete measure rest.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote/dot":{"title":"dot","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"dot"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:7IvorMXL17MXLEmptyPlacementV","kind":"typeIdentifier","text":"MXLEmptyPlacement"},{"kind":"text","text":"]"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlnote\/dot","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/dot","abstract":[{"text":"One dot element is used for each dot of prolongation. The placement attribute is used to specify whether the","type":"text"},{"text":" ","type":"text"},{"text":"dot should appear above or below the staff line. It is ignored for notes that appear on a staff space.","type":"text"}]},"doc://IvorMXL/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","identifier":"doc:\/\/IvorMXL\/s16SendableMetatypeP","type":"unresolvable"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/stem":{"url":"\/documentation\/ivormxl\/mxlnote\/stem","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/stem","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"stem","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLStem","preciseIdentifier":"s:7IvorMXL7MXLStemV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"kind":"symbol","abstract":[{"text":"The direction of the stem for this note, if any.","type":"text"}],"type":"topic","title":"stem"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/font":{"url":"\/documentation\/ivormxl\/mxlnote\/font","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/font","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"font"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL7MXLFontV","text":"MXLFont"}],"title":"font","abstract":[{"type":"text","text":"The font attribute group gathers together attributes for determining the font within a credit or direction."},{"type":"text","text":" "},{"type":"text","text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of"},{"type":"text","text":" "},{"type":"text","text":"font names.The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric"},{"type":"text","text":" "},{"type":"text","text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font"},{"type":"text","text":" "},{"type":"text","text":"vs. a music font."}],"type":"topic","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/lyric":{"url":"\/documentation\/ivormxl\/mxlnote\/lyric","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/lyric","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lyric","kind":"identifier"},{"text":": [","kind":"text"},{"text":"MXLLyric","preciseIdentifier":"s:7IvorMXL8MXLLyricV","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"kind":"symbol","abstract":[{"text":"The lyrics associated with this note.","type":"text"}],"type":"topic","title":"lyric"},"doc://IvorMXL/documentation/IvorMXL/MXLMusicItem":{"abstract":[{"text":"One of the alternatives for a music item.","type":"text"}],"title":"MXLMusicItem","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLMusicItem"}],"navigatorTitle":[{"kind":"identifier","text":"MXLMusicItem"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlmusicitem","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMusicItem"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/isPizzicato":{"url":"\/documentation\/ivormxl\/mxlnote\/ispizzicato","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/isPizzicato","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isPizzicato","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"kind":"symbol","abstract":[{"text":"A Boolean value indicating whether just this note is sounded pizzicato, as opposed to the pizzicato element,","type":"text"},{"text":" ","type":"text"},{"text":"which changes overall playback between pizzicato and arco.","type":"text"}],"type":"topic","title":"isPizzicato"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/printout":{"url":"\/documentation\/ivormxl\/mxlnote\/printout","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/printout","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"printout","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLPrintout","preciseIdentifier":"s:7IvorMXL11MXLPrintoutV","kind":"typeIdentifier"}],"kind":"symbol","abstract":[{"text":"The printout attribute group collects the different controls over printing an object (e.g. a note or rest) and","type":"text"},{"text":" ","type":"text"},{"text":"its parts, including augmentation dots and lyrics. This is especially useful for notes that overlap in","type":"text"},{"text":" ","type":"text"},{"text":"different voices, or for chord sheets that contain lyrics and chords but no melody.","type":"text"}],"type":"topic","title":"printout"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/timeOnly":{"title":"timeOnly","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"text":" ","kind":"text"},{"kind":"identifier","text":"timeOnly"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLTimeOnlya","text":"MXLTimeOnly"},{"kind":"text","text":"?"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlnote\/timeonly","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/timeOnly","abstract":[{"text":"Indicates which times through a repeat this note is played, if only particular times.","type":"text"}]},"doc://IvorMXL/SQ":{"title":"Swift.Equatable","identifier":"doc:\/\/IvorMXL\/SQ","type":"unresolvable"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/notehead-swift.property":{"title":"notehead","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"notehead","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Notehead","preciseIdentifier":"s:7IvorMXL7MXLNoteV8NoteheadV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxlnote\/notehead-swift.property","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/notehead-swift.property","abstract":[{"text":"The notehead shape used for this note, if any.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote/level":{"url":"\/documentation\/ivormxl\/mxlnote\/level","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/level","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"level","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLLevel","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLLevelV"},{"kind":"text","text":"?"}],"abstract":[{"type":"text","text":"The level element specifies editorial information for different MusicXML elements. It is defined within a"},{"type":"text","text":" "},{"type":"text","text":"group due to its multiple uses within the MusicXML schema."}],"title":"level","type":"topic","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"navigatorTitle":[{"kind":"identifier","text":"MXLNote"}],"abstract":[{"text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for","type":"text"},{"text":" ","type":"text"},{"text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation).","type":"text"},{"text":" ","type":"text"},{"text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,","type":"text"},{"text":" ","type":"text"},{"text":"but no tie elements. Having these two types of information available can make interchange easier, as some","type":"text"},{"text":" ","type":"text"},{"text":"programs handle one type of information more readily than the other.","type":"text"}],"title":"MXLNote","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","kind":"symbol","url":"\/documentation\/ivormxl\/mxlnote","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNote"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/release":{"url":"\/documentation\/ivormxl\/mxlnote\/release","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/release","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"release"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL12MXLDivisionsV","text":"MXLDivisions"},{"kind":"text","text":"?"}],"title":"release","abstract":[{"type":"text","text":"Alters the stopping time of the note from when it would otherwise occur, expressed in divisions. A note that"},{"type":"text","text":" "},{"type":"text","text":"starts a tie should not have a release attribute."}],"type":"topic","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes":{"abstract":[{"text":"The attributes element contains musical information that typically changes on measure boundaries. This","type":"text"},{"text":" ","type":"text"},{"text":"includes key and time signatures, clefs, transpositions, and staving. When attributes are changed mid-measure,","type":"text"},{"text":" ","type":"text"},{"text":"it affects the music in score order, not in MusicXML document order.","type":"text"}],"title":"MXLAttributes","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLAttributes"}],"navigatorTitle":[{"kind":"identifier","text":"MXLAttributes"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlattributes","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/endDynamics":{"abstract":[{"text":"The Note Off velocity, corresponding to MIDI 1.0’s Note Off velocity, expressed as a percentage of the","type":"text"},{"text":" ","type":"text"},{"text":"default forte value (90 for MIDI 1.0).","type":"text"}],"title":"endDynamics","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"endDynamics"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL21MXLNonNegativeDecimala","text":"MXLNonNegativeDecimal"},{"kind":"text","text":"?"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlnote\/enddynamics","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/endDynamics"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/Equatable-Implementations":{"url":"\/documentation\/ivormxl\/mxlnote\/equatable-implementations","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Equatable-Implementations","role":"collectionGroup","kind":"article","abstract":[],"type":"topic","title":"Equatable Implementations"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/kind-swift.property":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/kind-swift.property","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"kind"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL7MXLNoteV4KindV","kind":"typeIdentifier","text":"Kind"},{"kind":"text","text":"?"}],"role":"symbol","type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlnote\/kind-swift.property","title":"kind","abstract":[{"text":"The graphic note type (e.g. quarter, eighth), if specified.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote/Notehead-swift.struct":{"abstract":[{"type":"text","text":"The notehead type indicates shapes other than the open and closed ovals associated with note durations."}],"title":"MXLNote.Notehead","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Notehead","kind":"identifier"}],"navigatorTitle":[{"text":"Notehead","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlnote\/notehead-swift.struct","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Notehead-swift.struct"}}}