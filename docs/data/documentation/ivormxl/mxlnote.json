s:endDynamics:attack:release:timeOnly:isPizzicato:)","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/init(id:content:instrument:footnote:level:voice:kind:dot:accidental:timeModification:stem:notehead:noteheadText:staff:beam:notations:lyric:play:listen:xPosition:font:color:printout:printsLeger:dynamics:endDynamics:attack:release:timeOnly:isPizzicato:)","type":"topic","abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLNote"},{"type":"text","text":"."}]},"doc://IvorMXL/documentation/IvorMXL/MXLBarline":{"role":"symbol","abstract":[{"type":"text","text":"If a barline is other than a normal single barline, it should be represented by a barline type that describes"},{"text":" ","type":"text"},{"type":"text","text":"it. This includes information about repeats and multiple endings, as well as line style. Barline data is on"},{"type":"text","text":" "},{"type":"text","text":"the same level as the other musical data in a score — a child of a measure in a partwise score, or a part in a"},{"text":" ","type":"text"},{"type":"text","text":"timewise score. This allows for barlines within measures, as in dotted barlines that subdivide measures in"},{"text":" ","type":"text"},{"type":"text","text":"complex meters. The two fermata elements allow for fermatas on both sides of the barline (the lower one"},{"type":"text","text":" "},{"type":"text","text":"inverted)."}],"title":"MXLBarline","url":"\/documentation\/ivormxl\/mxlbarline","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline","navigatorTitle":[{"text":"MXLBarline","kind":"identifier"}],"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLBarline"}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote/listen":{"role":"symbol","abstract":[{"text":"Listening information associated with this note, if any.","type":"text"}],"title":"listen","url":"\/documentation\/ivormxl\/mxlnote\/listen","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/listen","kind":"symbol","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"listen","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLListen","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLListenV"},{"text":"?","kind":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote/dot":{"role":"symbol","abstract":[{"type":"text","text":"One dot element is used for each dot of prolongation. The placement attribute is used to specify whether the"},{"type":"text","text":" "},{"type":"text","text":"dot should appear above or below the staff line. It is ignored for notes that appear on a staff space."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/dot","title":"dot","url":"\/documentation\/ivormxl\/mxlnote\/dot","kind":"symbol","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dot","kind":"identifier"},{"text":": [","kind":"text"},{"text":"MXLEmptyPlacement","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL17MXLEmptyPlacementV"},{"text":"]","kind":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote/xPosition":{"role":"symbol","abstract":[{"type":"text","text":"The x-position attribute group is used for elements like notes where specifying x position is common, but"},{"type":"text","text":" "},{"type":"text","text":"specifying y position is rare."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/xPosition","title":"xPosition","url":"\/documentation\/ivormxl\/mxlnote\/xposition","kind":"symbol","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"xPosition","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL12MXLXPositionV","text":"MXLXPosition","kind":"typeIdentifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote/dynamics":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dynamics","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL21MXLNonNegativeDecimala","text":"MXLNonNegativeDecimal","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlnote\/dynamics","role":"symbol","title":"dynamics","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/dynamics","type":"topic","abstract":[{"text":"The Note On velocity, corresponding to MIDI 1.0’s Note On velocity, expressed as a percentage of the default","type":"text"},{"text":" ","type":"text"},{"text":"forte value (90 for MIDI 1.0).","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote/timeOnly":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"timeOnly","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL11MXLTimeOnlya","text":"MXLTimeOnly","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlnote\/timeonly","role":"symbol","title":"timeOnly","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/timeOnly","type":"topic","abstract":[{"text":"Indicates which times through a repeat this note is played, if only particular times.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote/staff":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"staff","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL8MXLStaffV","text":"MXLStaff","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlnote\/staff","role":"symbol","title":"staff","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/staff","type":"topic","abstract":[{"text":"The staff element is defined within a group due to its use by both notes and direction elements.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote/Notehead-swift.struct":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Notehead","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"Notehead","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlnote\/notehead-swift.struct","role":"symbol","title":"MXLNote.Notehead","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Notehead-swift.struct","type":"topic","abstract":[{"text":"The notehead type indicates shapes other than the open and closed ovals associated with note durations.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLMusicItem":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLMusicItem"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLMusicItem"}],"url":"\/documentation\/ivormxl\/mxlmusicitem","role":"symbol","title":"MXLMusicItem","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMusicItem","type":"topic","abstract":[{"type":"text","text":"One of the alternatives for a music item."}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNote"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLNote"}],"url":"\/documentation\/ivormxl\/mxlnote","role":"symbol","title":"MXLNote","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","type":"topic","abstract":[{"type":"text","text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for"},{"type":"text","text":" "},{"type":"text","text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation)."},{"type":"text","text":" "},{"type":"text","text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,"},{"type":"text","text":" "},{"type":"text","text":"but no tie elements. Having these two types of information available can make interchange easier, as some"},{"type":"text","text":" "},{"type":"text","text":"programs handle one type of information more readily than the other."}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote/voice":{"role":"symbol","abstract":[{"type":"text","text":"A voice is a sequence of musical events (e.g. notes, chords, rests) that proceeds linearly in time. The voice"},{"type":"text","text":" "},{"type":"text","text":"element is used to distinguish between multiple voices in individual parts. It is defined within a group due"},{"type":"text","text":" "},{"type":"text","text":"to its multiple uses within the MusicXML schema."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/voice","url":"\/documentation\/ivormxl\/mxlnote\/voice","title":"voice","kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"voice"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLVoice","preciseIdentifier":"s:7IvorMXL8MXLVoiceV"},{"kind":"text","text":"?"}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote/printsLeger":{"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"printsLeger"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlnote\/printsleger","role":"symbol","title":"printsLeger","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/printsLeger","type":"topic","abstract":[{"type":"text","text":"A Boolean value indicating whether leger lines are printed. Notes without leger lines indicate indeterminate"},{"type":"text","text":" "},{"type":"text","text":"high and low notes. Defaults to "},{"type":"codeVoice","code":"true"},{"type":"text","text":"; ignored for rests."}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote/noteheadText-swift.property":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"noteheadText","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL7MXLNoteV12NoteheadTextV","text":"NoteheadText","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlnote\/noteheadtext-swift.property","role":"symbol","title":"noteheadText","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/noteheadText-swift.property","type":"topic","abstract":[{"type":"text","text":"The text displayed inside the notehead, if any."}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote/notehead-swift.property":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"notehead","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Notehead","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL7MXLNoteV8NoteheadV"},{"text":"?","kind":"text"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlnote\/notehead-swift.property","role":"symbol","title":"notehead","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/notehead-swift.property","type":"topic","abstract":[{"type":"text","text":"The notehead shape used for this note, if any."}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote/NoteheadText-swift.struct":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"NoteheadText"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NoteheadText"}],"url":"\/documentation\/ivormxl\/mxlnote\/noteheadtext-swift.struct","role":"symbol","title":"MXLNote.NoteheadText","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/NoteheadText-swift.struct","type":"topic","abstract":[{"type":"text","text":"The notehead-text type represents text that is displayed inside a notehead, as is done in some educational"},{"type":"text","text":" "},{"type":"text","text":"music. It is not needed for the numbers used in tablature or jianpu notation. The presence of a TAB or jianpu"},{"type":"text","text":" "},{"type":"text","text":"clefs is sufficient to indicate that numbers are used. The display-text and accidental-text elements allow"},{"type":"text","text":" "},{"type":"text","text":"display of fully formatted text and accidentals."}]},"doc://IvorMXL/documentation/IvorMXL/MXLPitch":{"role":"symbol","abstract":[{"type":"text","text":"Pitch is represented as a combination of the step of the diatonic scale, the chromatic alteration, and the"},{"type":"text","text":" "},{"type":"text","text":"octave."}],"title":"MXLPitch","url":"\/documentation\/ivormxl\/mxlpitch","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPitch","navigatorTitle":[{"text":"MXLPitch","kind":"identifier"}],"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPitch"}]},"doc://IvorMXL/s16SendableMetatypeP":{"type":"unresolvable","identifier":"doc:\/\/IvorMXL\/s16SendableMetatypeP","title":"Swift.SendableMetatype"},"doc://IvorMXL/SH":{"title":"Swift.Hashable","type":"unresolvable","identifier":"doc:\/\/IvorMXL\/SH"},"doc://IvorMXL/s9EscapableP":{"type":"unresolvable","identifier":"doc:\/\/IvorMXL\/s9EscapableP","title":"Swift.Escapable"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/stem":{"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"stem"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLStem","preciseIdentifier":"s:7IvorMXL7MXLStemV"},{"kind":"text","text":"?"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlnote\/stem","role":"symbol","title":"stem","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/stem","type":"topic","abstract":[{"type":"text","text":"The direction of the stem for this note, if any."}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote/font":{"url":"\/documentation\/ivormxl\/mxlnote\/font","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"font","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL7MXLFontV","text":"MXLFont","kind":"typeIdentifier"}],"title":"font","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/font","role":"symbol","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The font attribute group gathers together attributes for determining the font within a credit or direction."},{"type":"text","text":" "},{"type":"text","text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of"},{"type":"text","text":" "},{"type":"text","text":"font names.The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric"},{"type":"text","text":" "},{"type":"text","text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font"},{"type":"text","text":" "},{"type":"text","text":"vs. a music font."}]},"doc://IvorMXL/s8SendableP":{"title":"Swift.Sendable","type":"unresolvable","identifier":"doc:\/\/IvorMXL\/s8SendableP"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/instrument":{"url":"\/documentation\/ivormxl\/mxlnote\/instrument","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"instrument"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:7IvorMXL13MXLInstrumentV","text":"MXLInstrument","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"title":"instrument","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/instrument","role":"symbol","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The instruments used to play this note, for parts with multiple instruments."}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote/isPizzicato":{"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"text":"isPizzicato","kind":"identifier"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"kind":"text","text":"?"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlnote\/ispizzicato","role":"symbol","title":"isPizzicato","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/isPizzicato","type":"topic","abstract":[{"type":"text","text":"A Boolean value indicating whether just this note is sounded pizzicato, as opposed to the pizzicato element,"},{"text":" ","type":"text"},{"text":"which changes overall playback between pizzicato and arco.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote/Content-swift.enum":{"url":"\/documentation\/ivormxl\/mxlnote\/content-swift.enum","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Content"}],"title":"MXLNote.Content","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Content-swift.enum","navigatorTitle":[{"kind":"identifier","text":"Content"}],"role":"symbol","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"One of the alternatives for Note."}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote/timeModification":{"url":"\/documentation\/ivormxl\/mxlnote\/timemodification","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"timeModification"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLTimeModification","preciseIdentifier":"s:7IvorMXL19MXLTimeModificationV"},{"kind":"text","text":"?"}],"title":"timeModification","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/timeModification","role":"symbol","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The time modification (e.g. for tuplets) applied to this note, if any."}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote/play":{"url":"\/documentation\/ivormxl\/mxlnote\/play","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"play"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLPlay","preciseIdentifier":"s:7IvorMXL7MXLPlayV"},{"kind":"text","text":"?"}],"title":"play","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/play","role":"symbol","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Playback information associated with this note, if any."}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote/beam":{"url":"\/documentation\/ivormxl\/mxlnote\/beam","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"beam"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"MXLBeam","preciseIdentifier":"s:7IvorMXL7MXLBeamV"},{"kind":"text","text":"]"}],"title":"beam","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/beam","role":"symbol","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The beam markings associated with this note."}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/footnote":{"url":"\/documentation\/ivormxl\/mxlnote\/footnote","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"footnote"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLFormattedText","preciseIdentifier":"s:7IvorMXL16MXLFormattedTextV"},{"kind":"text","text":"?"}],"title":"footnote","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/footnote","role":"symbol","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The footnote element specifies editorial information that appears in footnotes in the printed score. It is"},{"type":"text","text":" "},{"type":"text","text":"defined within a group due to its multiple uses within the MusicXML schema."}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote/accidental":{"url":"\/documentation\/ivormxl\/mxlnote\/accidental","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"accidental"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLAccidental","preciseIdentifier":"s:7IvorMXL13MXLAccidentalV"},{"kind":"text","text":"?"}],"title":"accidental","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/accidental","role":"symbol","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The accidental to be displayed for this note, if any."}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote/Equatable-Implementations":{"url":"\/documentation\/ivormxl\/mxlnote\/equatable-implementations","title":"Equatable Implementations","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Equatable-Implementations","role":"collectionGroup","type":"topic","kind":"article","abstract":[]},"doc://IvorMXL/documentation/IvorMXL/MXLNote/color":{"url":"\/documentation\/ivormxl\/mxlnote\/color","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"color"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLColor","preciseIdentifier":"s:7IvorMXL8MXLColorV"},{"kind":"text","text":"?"}],"title":"color","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/color","role":"symbol","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The color attribute group indicates the color of an element."}]},"doc://IvorMXL/documentation/IvorMXL/MXLRest":{"url":"\/documentation\/ivormxl\/mxlrest","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLRest"}],"title":"MXLRest","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRest","navigatorTitle":[{"kind":"identifier","text":"MXLRest"}],"role":"symbol","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The rest element indicates notated rests or silences. Rest elements are usually empty, but placement on the"},{"type":"text","text":" "},{"type":"text","text":"staff can be specified using display-step and display-octave elements. If the measure attribute is set to yes,"},{"type":"text","text":" "},{"type":"text","text":"this indicates this is a complete measure rest."}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote/id":{"url":"\/documentation\/ivormxl\/mxlnote\/id","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"id"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?"}],"title":"id","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/id","role":"symbol","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The optional-unique-id attribute group allows an element to optionally specify an ID that is unique to the"},{"type":"text","text":" "},{"type":"text","text":"entire document. This attribute group is not used for a required id attribute, or for an id attribute that"},{"type":"text","text":" "},{"type":"text","text":"specifies an id reference."}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote/level":{"url":"\/documentation\/ivormxl\/mxlnote\/level","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"level"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLLevel","preciseIdentifier":"s:7IvorMXL8MXLLevelV"},{"kind":"text","text":"?"}],"title":"level","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/level","role":"symbol","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The level element specifies editorial information for different MusicXML elements. It is defined within a"},{"type":"text","text":" "},{"type":"text","text":"group due to its multiple uses within the MusicXML schema."}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote/content-swift.property":{"url":"\/documentation\/ivormxl\/mxlnote\/content-swift.property","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"content"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Content","preciseIdentifier":"s:7IvorMXL7MXLNoteV7ContentO"}],"title":"content","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/content-swift.property","role":"symbol","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"One of the alternatives for Note."}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote/notations":{"url":"\/documentation\/ivormxl\/mxlnote\/notations","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"notations"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"MXLNotations","preciseIdentifier":"s:7IvorMXL12MXLNotationsV"},{"kind":"text","text":"]"}],"title":"notations","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/notations","role":"symbol","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The notations (e.g. articulations, ornaments) associated with this note."}]},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes":{"type":"topic","abstract":[{"type":"text","text":"The attributes element contains musical information that typically changes on measure boundaries. This"},{"text":" ","type":"text"},{"type":"text","text":"includes key and time signatures, clefs, transpositions, and staving. When attributes are changed mid-measure,"},{"type":"text","text":" "},{"type":"text","text":"it affects the music in score order, not in MusicXML document order."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLAttributes","kind":"identifier"}],"navigatorTitle":[{"text":"MXLAttributes","kind":"identifier"}],"title":"MXLAttributes","kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlattributes","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes"},"doc://IvorMXL/documentation/IvorMXL/MXLSound":{"url":"\/documentation\/ivormxl\/mxlsound","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLSound"}],"title":"MXLSound","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound","navigatorTitle":[{"kind":"identifier","text":"MXLSound"}],"role":"symbol","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The sound element contains general playback parameters. They can stand alone within a part\/measure, or be a"},{"type":"text","text":" "},{"type":"text","text":"component element within a direction."}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote/Kind-swift.struct":{"url":"\/documentation\/ivormxl\/mxlnote\/kind-swift.struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Kind"}],"title":"MXLNote.Kind","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Kind-swift.struct","navigatorTitle":[{"kind":"identifier","text":"Kind"}],"role":"symbol","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The note-type type indicates the graphic note type. Values range from 1024th to maxima. The size attribute"},{"type":"text","text":" "},{"type":"text","text":"indicates full, cue, grace-cue, or large size. The default is full for regular notes, grace-cue for notes that"},{"type":"text","text":" "},{"type":"text","text":"contain both grace and cue elements, and cue for notes that contain either a cue or a grace element, but not"},{"type":"text","text":" "},{"type":"text","text":"both."}]},"doc://IvorMXL/documentation/IvorMXL/MXLFullNote":{"url":"\/documentation\/ivormxl\/mxlfullnote","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFullNote"}],"title":"MXLFullNote","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFullNote","navigatorTitle":[{"kind":"identifier","text":"MXLFullNote"}],"role":"symbol","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The full-note group is a sequence of the common note elements between cue\/grace notes and regular (full)"},{"type":"text","text":" "},{"type":"text","text":"notes: pitch, chord, and rest information, but not duration (cue and grace notes do not have duration"},{"type":"text","text":" "},{"type":"text","text":"encoded). Unpitched elements are used for unpitched percussion, speaking voice, and other musical elements"},{"type":"text","text":" "},{"type":"text","text":"lacking determinate pitch."}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote/kind-swift.property":{"url":"\/documentation\/ivormxl\/mxlnote\/kind-swift.property","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"kind"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Kind","preciseIdentifier":"s:7IvorMXL7MXLNoteV4KindV"},{"kind":"text","text":"?"}],"title":"kind","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/kind-swift.property","role":"symbol","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The graphic note type (e.g. quarter, eighth), if specified."}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote/release":{"url":"\/documentation\/ivormxl\/mxlnote\/release","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"release"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLDivisions","preciseIdentifier":"s:7IvorMXL12MXLDivisionsV"},{"kind":"text","text":"?"}],"title":"release","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/release","role":"symbol","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Alters the stopping time of the note from when it would otherwise occur, expressed in divisions. A note that"},{"type":"text","text":" "},{"type":"text","text":"starts a tie should not have a release attribute."}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote/printout":{"url":"\/documentation\/ivormxl\/mxlnote\/printout","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"printout"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLPrintout","preciseIdentifier":"s:7IvorMXL11MXLPrintoutV"}],"title":"printout","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/printout","role":"symbol","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The printout attribute group collects the different controls over printing an object (e.g. a note or rest) and"},{"type":"text","text":" "},{"type":"text","text":"its parts, including augmentation dots and lyrics. This is especially useful for notes that overlap in"},{"type":"text","text":" "},{"type":"text","text":"different voices, or for chord sheets that contain lyrics and chords but no melody."}]}}}