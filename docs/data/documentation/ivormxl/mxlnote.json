l":"\/documentation\/ivormxl\/mxlnote\/beam","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"beam","kind":"identifier"},{"text":": [","kind":"text"},{"text":"MXLBeam","preciseIdentifier":"s:7IvorMXL7MXLBeamV","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"title":"beam","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/beam"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/release":{"kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"Alters the stopping time of the note from when it would otherwise occur, expressed in divisions. A note that"},{"type":"text","text":" "},{"type":"text","text":"starts a tie should not have a release attribute."}],"url":"\/documentation\/ivormxl\/mxlnote\/release","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"release","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLDivisions","preciseIdentifier":"s:7IvorMXL12MXLDivisionsV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"title":"release","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/release"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/font":{"kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"The font attribute group gathers together attributes for determining the font within a credit or direction. They"},{"type":"text","text":" "},{"type":"text","text":"are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of font"},{"type":"text","text":" "},{"type":"text","text":"names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric point"},{"type":"text","text":" "},{"type":"text","text":"size. The font-weight can be normal or bold. The default is application-dependent, but is a text font vs. a"},{"type":"text","text":" "},{"type":"text","text":"music font."}],"url":"\/documentation\/ivormxl\/mxlnote\/font","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"font","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLFont","preciseIdentifier":"s:7IvorMXL7MXLFontV","kind":"typeIdentifier"}],"title":"font","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/font"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/footnote":{"kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"The footnote element specifies editorial information that appears in footnotes in the printed score. It is"},{"type":"text","text":" "},{"type":"text","text":"defined within a group due to its multiple uses within the MusicXML schema."}],"url":"\/documentation\/ivormxl\/mxlnote\/footnote","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"footnote","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLFormattedText","preciseIdentifier":"s:7IvorMXL16MXLFormattedTextV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"title":"footnote","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/footnote"},"doc://IvorMXL/documentation/IvorMXL/MXLFullNote":{"title":"MXLFullNote","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFullNote"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlfullnote","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLFullNote"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFullNote","abstract":[{"text":"The full-note group is a sequence of the common note elements between cue\/grace notes and regular (full)","type":"text"},{"text":" ","type":"text"},{"text":"notes: pitch, chord, and rest information, but not duration (cue and grace notes do not have duration","type":"text"},{"text":" ","type":"text"},{"text":"encoded). Unpitched elements are used for unpitched percussion, speaking voice, and other musical elements","type":"text"},{"text":" ","type":"text"},{"text":"lacking determinate pitch.","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/content-swift.property":{"kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"One of the alternatives for Note."}],"url":"\/documentation\/ivormxl\/mxlnote\/content-swift.property","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"content","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Content","preciseIdentifier":"s:7IvorMXL7MXLNoteV7ContentO","kind":"typeIdentifier"}],"title":"content","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/content-swift.property"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/color":{"abstract":[{"text":"The color attribute group indicates the color of an element.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/color","title":"color","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"color"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL8MXLColorV","kind":"typeIdentifier","text":"MXLColor"},{"kind":"text","text":"?"}],"url":"\/documentation\/ivormxl\/mxlnote\/color","type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/play":{"kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"Playback information associated with this note, if any."}],"url":"\/documentation\/ivormxl\/mxlnote\/play","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"play","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLPlay","preciseIdentifier":"s:7IvorMXL7MXLPlayV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"title":"play","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/play"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/level":{"type":"topic","abstract":[{"type":"text","text":"The level element specifies editorial information for different MusicXML elements. It is defined within a"},{"type":"text","text":" "},{"type":"text","text":"group due to its multiple uses within the MusicXML schema."}],"url":"\/documentation\/ivormxl\/mxlnote\/level","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"level","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLLevel","preciseIdentifier":"s:7IvorMXL8MXLLevelV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"kind":"symbol","title":"level","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/level","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/Content-swift.enum":{"title":"MXLNote.Content","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Content"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlnote\/content-swift.enum","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Content"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Content-swift.enum","abstract":[{"text":"One of the alternatives for Note.","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLSound":{"type":"topic","title":"MXLSound","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound","abstract":[{"type":"text","text":"The sound element contains general playback parameters. They can stand alone within a part\/measure, or be a"},{"type":"text","text":" "},{"type":"text","text":"component element within a direction."}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSound","kind":"identifier"}],"navigatorTitle":[{"text":"MXLSound","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlsound"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/lyric":{"kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"The lyrics associated with this note."}],"url":"\/documentation\/ivormxl\/mxlnote\/lyric","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","k