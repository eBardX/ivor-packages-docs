bstract":[{"type":"text","text":"The direction of the stem for this note, if any."}],"url":"\/documentation\/ivormxl\/mxlnote\/stem","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"stem","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLStem","preciseIdentifier":"s:7IvorMXL7MXLStemV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"title":"stem","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/stem"},"doc://IvorMXL/SQ":{"type":"unresolvable","identifier":"doc:\/\/IvorMXL\/SQ","title":"Swift.Equatable"},"doc://IvorMXL/s8CopyableP":{"type":"unresolvable","identifier":"doc:\/\/IvorMXL\/s8CopyableP","title":"Swift.Copyable"},"doc://IvorMXL/documentation/IvorMXL/MXLPitch":{"title":"MXLPitch","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPitch","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlpitch","role":"symbol","navigatorTitle":[{"text":"MXLPitch","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPitch","abstract":[{"type":"text","text":"Pitch is represented as a combination of the step of the diatonic scale, the chromatic alteration, and the"},{"type":"text","text":" "},{"type":"text","text":"octave."}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/notehead-swift.property":{"kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"The notehead shape used for this note, if any."}],"url":"\/documentation\/ivormxl\/mxlnote\/notehead-swift.property","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"notehead","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Notehead","preciseIdentifier":"s:7IvorMXL7MXLNoteV8NoteheadV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"title":"notehead","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/notehead-swift.property"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/notations":{"kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"The notations (e.g. articulations, ornaments) associated with this note."}],"url":"\/documentation\/ivormxl\/mxlnote\/notations","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"notations","kind":"identifier"},{"text":": [","kind":"text"},{"text":"MXLNotations","preciseIdentifier":"s:7IvorMXL12MXLNotationsV","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"title":"notations","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/notations"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/kind-swift.property":{"title":"kind","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"kind"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL7MXLNoteV4KindV","text":"Kind"},{"kind":"text","text":"?"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlnote\/kind-swift.property","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/kind-swift.property","abstract":[{"text":"The graphic note type (e.g. quarter, eighth), if specified.","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/xPosition":{"abstract":[{"type":"text","text":"The x-position attribute group is used for elements like notes where specifying x position is common, but"},{"type":"text","text":" "},{"type":"text","text":"specifying y position is rare."}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/xPosition","url":"\/documentation\/ivormxl\/mxlnote\/xposition","role":"symbol","title":"xPosition","type":"topic","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"xPosition"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL12MXLXPositionV","kind":"typeIdentifier","text":"MXLXPosition"}]},"doc://IvorMXL/documentation/IvorMXL/MXLMusicItem":{"type":"topic","title":"MXLMusicItem","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMusicItem","abstract":[{"type":"text","text":"One of the alternatives for a music item."}],"role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLMusicItem","kind":"identifier"}],"navigatorTitle":[{"text":"MXLMusicItem","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlmusicitem"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/endDynamics":{"kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"The Note Off velocity, corresponding to MIDI 1.0’s Note Off velocity, expressed as a percentage of the"},{"type":"text","text":" "},{"type":"text","text":"default forte value (90 for MIDI 1.0)."}],"url":"\/documentation\/ivormxl\/mxlnote\/enddynamics","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"endDynamics","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLNonNegativeDecimal","preciseIdentifier":"s:7IvorMXL21MXLNonNegativeDecimala","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"title":"endDynamics","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/endDynamics"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/instrument":{"kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"The instruments used to play this note, for parts with multiple instruments."}],"url":"\/documentation\/ivormxl\/mxlnote\/instrument","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"instrument","kind":"identifier"},{"text":": [","kind":"text"},{"text":"MXLInstrument","preciseIdentifier":"s:7IvorMXL13MXLInstrumentV","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"title":"instrument","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/instrument"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection":{"type":"topic","title":"MXLDirection","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection","abstract":[{"type":"text","text":"A direction is a musical indication that is not necessarily attached to a specific note. Two or more may be"},{"type":"text","text":" "},{"type":"text","text":"combined to indicate words followed by the start of a dashed line, the end of a wedge followed by dynamics,"},{"type":"text","text":" "},{"type":"text","text":"etc. For applications where a specific direction is indeed attached to a specific note, the direction element"},{"type":"text","text":" "},{"type":"text","text":"can be associated with the first note element that follows it in score order that is not in a different voice."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLDirection"}],"navigatorTitle":[{"kind":"identifier","text":"MXLDirection"}],"url":"\/documentation\/ivormxl\/mxldirection"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/voice":{"kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"A voice is a sequence of musical events (e.g. notes, chords, rests) that proceeds linearly in time. The voice"},{"type":"text","text":" "},{"type":"text","text":"element is used to distinguish between multiple voices in individual parts. It is defined within a group due"},{"type":"text","text":" "},{"type":"text","text":"to its multiple uses within the MusicXML schema."}],"url":"\/documentation\/ivormxl\/mxlnote\/voice","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"voice","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLVoice","preciseIdentifier":"s:7IvorMXL8MXLVoiceV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"title":"voice","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/voice"},"doc://IvorMXL/s16SendableMetatypeP":{"type":"unresolvable","identifier":"doc:\/\/IvorMXL\/s16SendableMetatypeP","title":"Swift.SendableMetatype"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/printout":{"kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"The printout attribute group collects the different controls over printing an object (e.g. a note or rest) and"},{"type":"text","text":" "},{"type":"text","text":"its parts, including augmentation dots and lyrics. This is especially useful for notes that overlap in"},{"type":"text","text":" "},{"type":"text","text":"different voices, or for chord sheets that contain lyrics and chords but no melody."}],"url":"\/documentation\/ivormxl\/mxlnote\/printout","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"printout","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLPrintout","preciseIdentifier":"s:7IvorMXL11MXLPrintoutV","kind":"typeIdentifier"}],"title":"printout","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/printout"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/dot":{"kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"One dot element is used for each dot of prolongation. The placement attribute is used to specify whether the"},{"type":"text","text":" "},{"type":"text","text":"dot should appear above or below the staff line. It is ignored for notes that appear on a staff space."}],"url":"\/documentation\/ivormxl\/mxlnote\/dot","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dot","kind":"identifier"},{"text":": [","kind":"text"},{"text":"MXLEmptyPlacement","preciseIdentifier":"s:7IvorMXL17MXLEmptyPlacementV","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"title":"dot","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/dot"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/accidental":{"kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"The accidental to be displayed for this note, if any."}],"url":"\/documentation\/ivormxl\/mxlnote\/accidental","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"accidental","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLAccidental","preciseIdentifier":"s:7IvorMXL13MXLAccidentalV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"title":"accidental","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/accidental"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/id":{"kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"The optional-unique-id attribute group allows an element to optionally specify an ID that is unique to the"},{"type":"text","text":" "},{"type":"text","text":"entire document. This attribute group is not used for a required id attribute, or for an id attribute that"},{"type":"text","text":" "},{"type":"text","text":"specifies an id reference."}],"url":"\/documentation\/ivormxl\/mxlnote\/id","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"id","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"title":"id","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/id"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLBarline"}],"abstract":[{"text":"If a barline is other than a normal single barline, it should be represented by a barline type that describes","type":"text"},{"text":" ","type":"text"},{"text":"it. This includes information about repeats and multiple endings, as well as line style. Barline data is on","type":"text"},{"text":" ","type":"text"},{"text":"the same level as the other musical data in a score — a child of a measure in a partwise score, or a part in a","type":"text"},{"text":" ","type":"text"},{"text":"timewise score. This allows for barlines within measures, as in dotted barlines that subdivide measures in","type":"text"},{"text":" ","type":"text"},{"text":"complex meters. The two fermata elements allow for fermatas on both sides of the barline (the lower one","type":"text"},{"text":" ","type":"text"},{"text":"inverted).","type":"text"}],"title":"MXLBarline","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline","role":"symbol","url":"\/documentation\/ivormxl\/mxlbarline","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLBarline"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLRest":{"title":"MXLRest","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLRest","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"MXLRest","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlrest","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRest","abstract":[{"type":"text","text":"The rest element indicates notated rests or silences. Rest elements are usually empty, but placement on the"},{"type":"text","text":" "},{"text":"staff can be specified using display-step and display-octave elements. If the measure attribute is set to yes,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"this indicates this is a complete measure rest."}],"type":"topic","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/Kind-swift.struct":{"type":"topic","title":"MXLNote.Kind","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Kind-swift.struct","abstract":[{"text":"The note-type type indicates the graphic note type. Values range from 1024th to maxima. The size attribute","type":"text"},{"text":" ","type":"text"},{"text":"indicates full, cue, grace-cue, or large size. The default is full for regular notes, grace-cue for notes that","type":"text"},{"text":" ","type":"text"},{"text":"contain both grace and cue elements, and cue for notes that contain either a cue or a grace element, but not","type":"text"},{"text":" ","type":"text"},{"text":"both.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Kind"}],"navigatorTitle":[{"kind":"identifier","text":"Kind"}],"url":"\/documentation\/ivormxl\/mxlnote\/kind-swift.struct"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/listen":{"kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"Listening information associated with this note, if any."}],"url":"\/documentation\/ivormxl\/mxlnote\/listen","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"listen","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLListen","preciseIdentifier":"s:7IvorMXL9MXLListenV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"title":"listen","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/listen"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/noteheadText-swift.property":{"kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"The text displayed inside the notehead, if any."}],"url":"\/documentation\/ivormxl\/mxlnote\/noteheadtext-swift.property","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"noteheadText","kind":"identifier"},{"text":": ","kind":"text"},{"text":"NoteheadText","preciseIdentifier":"s:7IvorMXL7MXLNoteV12NoteheadTextV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"title":"noteheadText","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/noteheadText-swift.property"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/staff":{"kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"The staff element is defined within a group due to its use by both notes and direction elements."}],"url":"\/documentation\/ivormxl\/mxlnote\/staff","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"staff","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLStaff","preciseIdentifier":"s:7IvorMXL8MXLStaffV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"title":"staff","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/staff"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/NoteheadText-swift.struct":{"type":"topic","title":"MXLNote.NoteheadText","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/NoteheadText-swift.struct","abstract":[{"type":"text","text":"The notehead-text type represents text that is displayed inside a notehead, as is done in some educational"},{"type":"text","text":" "},{"type":"text","text":"music. It is not needed for the numbers used in tablature or jianpu notation. The presence of a TAB or jianpu"},{"type":"text","text":" "},{"type":"text","text":"clefs is sufficient to indicate that numbers are used. The display-text and accidental-text elements allow"},{"type":"text","text":" "},{"type":"text","text":"display of fully formatted text and accidentals."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"NoteheadText"}],"navigatorTitle":[{"kind":"identifier","text":"NoteheadText"}],"url":"\/documentation\/ivormxl\/mxlnote\/noteheadtext-swift.struct"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes":{"type":"topic","title":"MXLAttributes","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes","abstract":[{"text":"The attributes element contains musical information that typically changes on measure boundaries. This","type":"text"},{"text":" ","type":"text"},{"text":"includes key and time signatures, clefs, transpositions, and staving. When attributes are changed mid-measure,","type":"text"},{"text":" ","type":"text"},{"text":"it affects the music in score order, not in MusicXML document order.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLAttributes"}],"navigatorTitle":[{"kind":"identifier","text":"MXLAttributes"}],"url":"\/documentation\/ivormxl\/mxlattributes"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/isPizzicato":{"kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"A Boolean value indicating whether just this note is sounded pizzicato, as opposed to the pizzicato element,"},{"type":"text","text":" "},{"type":"text","text":"which changes overall playback between pizzicato and arco."}],"url":"\/documentation\/ivormxl\/mxlnote\/ispizzicato","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isPizzicato","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"title":"isPizzicato","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/isPizzicato"}}}