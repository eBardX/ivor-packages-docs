{"schemaVersion":{"minor":3,"major":0,"patch":0},"relationshipsSections":[{"kind":"relationships","type":"conformsTo","identifiers":["doc:\/\/IvorMXL\/s8CopyableP","doc:\/\/IvorMXL\/SQ","doc:\/\/IvorMXL\/s9EscapableP","doc:\/\/IvorMXL\/SH","doc:\/\/IvorMXL\/s8SendableP","doc:\/\/IvorMXL\/s16SendableMetatypeP"],"title":"Conforms To"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNote","kind":"identifier"}],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The print-leger attribute is used to indicate whether leger lines are printed. Notes without leger lines are"},{"type":"text","text":" "},{"type":"text","text":"used to indicate indeterminate high and low notes. By default, it is set to yes. If print-object is set to no,"},{"type":"text","text":" "},{"type":"text","text":"print-leger is interpreted to also be set to no if not present. This attribute is ignored for rests."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The dynamics and end-dynamics attributes correspond to MIDI 1.0’s Note On and Note Off velocities,"},{"type":"text","text":" "},{"type":"text","text":"respectively. They are expressed in terms of percentages of the default forte value (90 for MIDI 1.0)."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The attack and release attributes are used to alter the starting and stopping time of the note from when it"},{"type":"text","text":" "},{"type":"text","text":"would otherwise occur based on the flow of durations - information that is specific to a performance. They are"},{"type":"text","text":" "},{"type":"text","text":"expressed in terms of divisions, either positive or negative. A note that starts a tie should not have a"},{"type":"text","text":" "},{"type":"text","text":"release attribute, and a note that stops a tie should not have an attack attribute. The attack and release"},{"type":"text","text":" "},{"type":"text","text":"attributes are independent of each other. The attack attribute only changes the starting time of a note, and"},{"type":"text","text":" "},{"type":"text","text":"the release attribute only changes the stopping time of a note."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If a note is played only particular times through a repeat, the time-only attribute shows which times to play"},{"type":"text","text":" "},{"type":"text","text":"the note."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The pizzicato attribute is used when just this note is sounded pizzicato, vs. the pizzicato element which"},{"type":"text","text":" "},{"type":"text","text":"changes overall playback between pizzicato and arco."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Maps the MusicXML "},{"type":"codeVoice","code":"<note>"},{"type":"text","text":" element."}]}]}],"kind":"symbol","metadata":{"symbolKind":"struct","externalID":"s:7IvorMXL7MXLNoteV","roleHeading":"Structure","modules":[{"name":"IvorMXL"}],"title":"MXLNote","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNote","kind":"identifier"}],"navigatorTitle":[{"text":"MXLNote","kind":"identifier"}],"role":"symbol"},"topicSections":[{"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Kind-swift.struct","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Notehead-swift.struct","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/NoteheadText-swift.struct"],"generated":true,"title":"Structures","anchor":"Structures"},{"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/init(id:content:instrument:footnote:level:voice:kind:dot:accidental:timeModification:stem:notehead:noteheadText:staff:beam:notations:lyric:play:listen:xPosition:font:color:printout:printsLeger:dynamics:endDynamics:attack:release:timeOnly:isPizzicato:)"],"generated":true,"title":"Initializers","anchor":"Initializers"},{"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/accidental","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/attack","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/beam","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/color","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/content-swift.property","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/dot","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/dynamics","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/endDynamics","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/font","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/footnote","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/id","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/instrument","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/isPizzicato","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/kind-swift.property","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/level","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/listen","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/lyric","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/notations","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/notehead-swift.property","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/noteheadText-swift.property","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/play","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/printout","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/printsLeger","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/release","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/staff","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/stem","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/timeModification","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/timeOnly","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/voice","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/xPosition"],"generated":true,"title":"Instance Properties","anchor":"Instance-Properties"},{"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Content-swift.enum"],"generated":true,"title":"Enumerations","anchor":"Enumerations"},{"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Equatable-Implementations"],"generated":true,"title":"Default Implementations","anchor":"Default-Implementations"}],"variants":[{"paths":["\/documentation\/ivormxl\/mxlnote"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"seeAlsoSections":[{"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMusicItem","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRest","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPitch","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound"],"generated":true,"title":"Music","anchor":"Music"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote"},"abstract":[{"text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for","type":"text"},{"text":" ","type":"text"},{"text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation).","type":"text"},{"text":" ","type":"text"},{"text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,","type":"text"},{"text":" ","type":"text"},{"text":"but no tie elements. Having these two types of information available can make interchange easier, as some","type":"text"},{"text":" ","type":"text"},{"text":"programs handle one type of information more readily than the other.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL"]]},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLRest":{"role":"symbol","navigatorTitle":[{"text":"MXLRest","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLRest","kind":"identifier"}],"kind":"symbol","title":"MXLRest","url":"\/documentation\/ivormxl\/mxlrest","type":"topic","abstract":[{"text":"The rest element indicates notated rests or silences. Rest elements are usually empty, but placement on the","type":"text"},{"text":" ","type":"text"},{"text":"staff can be specified using display-step and display-octave elements. If the measure attribute is set to yes,","type":"text"},{"text":" ","type":"text"},{"text":"this indicates this is a complete measure rest.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRest"},"doc://IvorMXL/SQ":{"identifier":"doc:\/\/IvorMXL\/SQ","type":"unresolvable","title":"Swift.Equatable"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/notations":{"title":"notations","kind":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"notations"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"MXLNotations","preciseIdentifier":"s:7IvorMXL12MXLNotationsV"},{"kind":"text","text":"]"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/notations","url":"\/documentation\/ivormxl\/mxlnote\/notations","type":"topic","abstract":[{"type":"text","text":"The notations (e.g. articulations, ornaments) associated with this note."}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/s8CopyableP":{"identifier":"doc:\/\/IvorMXL\/s8CopyableP","type":"unresolvable","title":"Swift.Copyable"},"doc://IvorMXL/documentation/IvorMXL/MXLMusicItem":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlmusicitem","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMusicItem","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLMusicItem"}],"abstract":[{"type":"text","text":"One of the alternatives for a music item."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLMusicItem"}],"title":"MXLMusicItem"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/level":{"title":"level","kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"level","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLLevel","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLLevelV"},{"text":"?","kind":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/level","url":"\/documentation\/ivormxl\/mxlnote\/level","type":"topic","abstract":[{"type":"text","text":"The level element specifies editorial information for different MusicXML elements. It is defined within a"},{"type":"text","text":" "},{"type":"text","text":"group due to its multiple uses within the MusicXML schema."}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLSound":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlsound","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLSound"}],"abstract":[{"type":"text","text":"The sound element contains general playback parameters. They can stand alone within a part\/measure, or be a"},{"type":"text","text":" "},{"type":"text","text":"component element within a direction."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLSound"}],"title":"MXLSound"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/instrument":{"title":"instrument","kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"instrument","kind":"identifier"},{"text":": [","kind":"text"},{"text":"MXLInstrument","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL13MXLInstrumentV"},{"text":"]","kind":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/instrument","url":"\/documentation\/ivormxl\/mxlnote\/instrument","type":"topic","abstract":[{"type":"text","text":"The instruments used to play this note, for parts with multiple instruments."}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/color":{"title":"color","kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"color","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLColor","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLColorV"},{"text":"?","kind":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/color","url":"\/documentation\/ivormxl\/mxlnote\/color","type":"topic","abstract":[{"type":"text","text":"The color attribute group indicates the color of an element."}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection":{"role":"symbol","url":"\/documentation\/ivormxl\/mxldirection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLDirection","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"A direction is a musical indication that is not necessarily attached to a specific note. Two or more may be","type":"text"},{"text":" ","type":"text"},{"text":"combined to indicate words followed by the start of a dashed line, the end of a wedge followed by dynamics,","type":"text"},{"text":" ","type":"text"},{"text":"etc. For applications where a specific direction is indeed attached to a specific note, the direction element","type":"text"},{"text":" ","type":"text"},{"text":"can be associated with the first note element that follows it in score order that is not in a different voice.","type":"text"}],"type":"topic","navigatorTitle":[{"text":"MXLDirection","kind":"identifier"}],"title":"MXLDirection"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/voice":{"title":"voice","kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"voice","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLVoice","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLVoiceV"},{"text":"?","kind":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/voice","url":"\/documentation\/ivormxl\/mxlnote\/voice","type":"topic","abstract":[{"type":"text","text":"A voice is a sequence of musical events (e.g. notes, chords, rests) that proceeds linearly in time. The voice"},{"type":"text","text":" "},{"type":"text","text":"element is used to distinguish between multiple voices in individual parts. It is defined within a group due"},{"type":"text","text":" "},{"type":"text","text":"to its multiple uses within the MusicXML schema."}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes":{"role":"symbol","navigatorTitle":[{"text":"MXLAttributes","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLAttributes","kind":"identifier"}],"kind":"symbol","title":"MXLAttributes","url":"\/documentation\/ivormxl\/mxlattributes","type":"topic","abstract":[{"text":"The attributes element contains musical information that typically changes on measure boundaries. This","type":"text"},{"text":" ","type":"text"},{"text":"includes key and time signatures, clefs, transpositions, and staving. When attributes are changed mid-measure,","type":"text"},{"text":" ","type":"text"},{"text":"it affects the music in score order, not in MusicXML document order.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/printsLeger":{"title":"printsLeger","kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"printsLeger","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/printsLeger","url":"\/documentation\/ivormxl\/mxlnote\/printsleger","type":"topic","abstract":[{"type":"text","text":"A Boolean value indicating whether leger lines are printed. Notes without leger lines indicate indeterminate"},{"type":"text","text":" "},{"type":"text","text":"high and low notes. Defaults to "},{"type":"codeVoice","code":"true"},{"type":"text","text":"; ignored for rests."}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/accidental":{"type":"topic","abstract":[{"type":"text","text":"The accidental to be displayed for this note, if any."}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"accidental","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLAccidental","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL13MXLAccidentalV"},{"text":"?","kind":"text"}],"role":"symbol","title":"accidental","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/accidental","url":"\/documentation\/ivormxl\/mxlnote\/accidental","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/noteheadText-swift.property":{"title":"noteheadText","kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"noteheadText","kind":"identifier"},{"text":": ","kind":"text"},{"text":"NoteheadText","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL7MXLNoteV12NoteheadTextV"},{"text":"?","kind":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/noteheadText-swift.property","url":"\/documentation\/ivormxl\/mxlnote\/noteheadtext-swift.property","type":"topic","abstract":[{"type":"text","text":"The text displayed inside the notehead, if any."}],"role":"symbol"},"doc://IvorMXL/SH":{"identifier":"doc:\/\/IvorMXL\/SH","type":"unresolvable","title":"Swift.Hashable"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/NoteheadText-swift.struct":{"title":"MXLNote.NoteheadText","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NoteheadText","kind":"identifier"}],"navigatorTitle":[{"text":"NoteheadText","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/NoteheadText-swift.struct","url":"\/documentation\/ivormxl\/mxlnote\/noteheadtext-swift.struct","type":"topic","abstract":[{"type":"text","text":"The notehead-text type represents text that is displayed inside a notehead, as is done in some educational"},{"type":"text","text":" "},{"type":"text","text":"music. It is not needed for the numbers used in tablature or jianpu notation. The presence of a TAB or jianpu"},{"type":"text","text":" "},{"type":"text","text":"clefs is sufficient to indicate that numbers are used. The display-text and accidental-text elements allow"},{"type":"text","text":" "},{"type":"text","text":"display of fully formatted text and accidentals."}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/footnote":{"title":"footnote","kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"footnote","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLFormattedText","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL16MXLFormattedTextV"},{"text":"?","kind":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/footnote","url":"\/documentation\/ivormxl\/mxlnote\/footnote","type":"topic","abstract":[{"type":"text","text":"The footnote element specifies editorial information that appears in footnotes in the printed score. It is"},{"type":"text","text":" "},{"type":"text","text":"defined within a group due to its multiple uses within the MusicXML schema."}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/xPosition":{"title":"xPosition","kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"xPositi