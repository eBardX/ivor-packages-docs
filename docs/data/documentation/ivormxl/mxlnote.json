/noteheadText-swift.property","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"noteheadText"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL7MXLNoteV12NoteheadTextV","text":"NoteheadText"},{"kind":"text","text":"?"}],"title":"noteheadText","abstract":[{"type":"text","text":"The text displayed inside the notehead, if any."}],"type":"topic","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/Content-swift.enum":{"abstract":[{"text":"One of the alternatives for Note.","type":"text"}],"title":"MXLNote.Content","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Content"}],"navigatorTitle":[{"kind":"identifier","text":"Content"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlnote\/content-swift.enum","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Content-swift.enum"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/Kind-swift.struct":{"abstract":[{"type":"text","text":"The note-type type indicates the graphic note type. Values range from 1024th to maxima. The size attribute"},{"type":"text","text":" "},{"type":"text","text":"indicates full, cue, grace-cue, or large size. The default is full for regular notes, grace-cue for notes that"},{"type":"text","text":" "},{"type":"text","text":"contain both grace and cue elements, and cue for notes that contain either a cue or a grace element, but not"},{"type":"text","text":" "},{"type":"text","text":"both."}],"title":"MXLNote.Kind","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Kind","kind":"identifier"}],"navigatorTitle":[{"text":"Kind","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlnote\/kind-swift.struct","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Kind-swift.struct"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/id":{"url":"\/documentation\/ivormxl\/mxlnote\/id","abstract":[{"type":"text","text":"The optional-unique-id attribute group allows an element to optionally specify an ID that is unique to the"},{"type":"text","text":" "},{"type":"text","text":"entire document. This attribute group is not used for a required id attribute, or for an id attribute that"},{"type":"text","text":" "},{"type":"text","text":"specifies an id reference."}],"kind":"symbol","title":"id","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/id","type":"topic","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"id"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/dynamics":{"url":"\/documentation\/ivormxl\/mxlnote\/dynamics","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/dynamics","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"dynamics"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL21MXLNonNegativeDecimala","text":"MXLNonNegativeDecimal"},{"kind":"text","text":"?"}],"title":"dynamics","abstract":[{"type":"text","text":"The Note On velocity, corresponding to MIDI 1.0’s Note On velocity, expressed as a percentage of the default"},{"type":"text","text":" "},{"type":"text","text":"forte value (90 for MIDI 1.0)."}],"type":"topic","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection","title":"MXLDirection","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLDirection","kind":"identifier"}],"navigatorTitle":[{"text":"MXLDirection","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxldirection","abstract":[{"text":"A direction is a musical indication that is not necessarily attached to a specific note. Two or more may be","type":"text"},{"type":"text","text":" "},{"type":"text","text":"combined to indicate words followed by the start of a dashed line, the end of a wedge followed by dynamics,"},{"type":"text","text":" "},{"type":"text","text":"etc. For applications where a specific direction is indeed attached to a specific note, the direction element"},{"type":"text","text":" "},{"type":"text","text":"can be associated with the first note element that follows it in score order that is not in a different voice."}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote/color":{"url":"\/documentation\/ivormxl\/mxlnote\/color","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/color","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"color"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLColorV","text":"MXLColor"},{"kind":"text","text":"?"}],"title":"color","abstract":[{"type":"text","text":"The color attribute group indicates the color of an element."}],"type":"topic","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/listen":{"url":"\/documentation\/ivormxl\/mxlnote\/listen","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/listen","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"listen"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLListenV","text":"MXLListen"},{"kind":"text","text":"?"}],"title":"listen","abstract":[{"type":"text","text":"Listening information associated with this note, if any."}],"type":"topic","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/notations":{"abstract":[{"type":"text","text":"The notations (e.g. articulations, ornaments) associated with this note."}],"title":"notations","kind":"symbol","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"notations","kind":"identifier"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:7IvorMXL12MXLNotationsV","text":"MXLNotations","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlnote\/notations","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/notations"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/NoteheadText-swift.struct":{"abstract":[{"text":"The notehead-text type represents text that is displayed inside a notehead, as is done in some educational","type":"text"},{"text":" ","type":"text"},{"text":"music. It is not needed for the numbers used in tablature or jianpu notation. The presence of a TAB or jianpu","type":"text"},{"text":" ","type":"text"},{"text":"clefs is sufficient to indicate that numbers are used. The display-text and accidental-text elements allow","type":"text"},{"text":" ","type":"text"},{"text":"display of fully formatted text and accidentals.","type":"text"}],"title":"MXLNote.NoteheadText","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"NoteheadText"}],"navigatorTitle":[{"kind":"identifier","text":"NoteheadText"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlnote\/noteheadtext-swift.struct","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/NoteheadText-swift.struct"},"doc://IvorMXL/s8CopyableP":{"title":"Swift.Copyable","identifier":"doc:\/\/IvorMXL\/s8CopyableP","type":"unresolvable"},"doc://IvorMXL/s9EscapableP":{"identifier":"doc:\/\/IvorMXL\/s9EscapableP","type":"unresolvable","title":"Swift.Escapable"},"doc://IvorMXL/s8SendableP":{"identifier":"doc:\/\/IvorMXL\/s8SendableP","type":"unresolvable","title":"Swift.Sendable"},"doc://IvorMXL/documentation/IvorMXL/MXLFullNote":{"abstract":[{"text":"The full-note group is a sequence of the common note elements between cue\/grace notes and regular (full)","type":"text"},{"text":" ","type":"text"},{"text":"notes: pitch, chord, and rest information, but not duration (cue and grace notes do not have duration","type":"text"},{"text":" ","type":"text"},{"text":"encoded). Unpitched elements are used for unpitched percussion, speaking voice, and other musical elements","type":"text"},{"text":" ","type":"text"},{"text":"lacking determinate pitch.","type":"text"}],"title":"MXLFullNote","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFullNote"}],"navigatorTitle":[{"kind":"identifier","text":"MXLFullNote"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlfullnote","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFullNote"},"doc://IvorMXL/documentation/IvorMXL/MXLSound":{"abstract":[{"text":"The sound element contains general playback parameters. They can stand alone within a part\/measure, or be a","type":"text"},{"text":" ","type":"text"},{"text":"component element within a direction.","type":"text"}],"title":"MXLSound","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLSound"}],"navigatorTitle":[{"kind":"identifier","text":"MXLSound"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlsound","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/voice":{"url":"\/documentation\/ivormxl\/mxlnote\/voice","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/voice","kind":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier