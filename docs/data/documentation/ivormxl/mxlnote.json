bol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLBarline"}],"title":"MXLBarline","abstract":[{"type":"text","text":"If a barline is other than a normal single barline, it should be represented by a barline type that describes"},{"type":"text","text":" "},{"type":"text","text":"it. This includes information about repeats and multiple endings, as well as line style. Barline data is on"},{"type":"text","text":" "},{"type":"text","text":"the same level as the other musical data in a score — a child of a measure in a partwise score, or a part in a"},{"type":"text","text":" "},{"type":"text","text":"timewise score. This allows for barlines within measures, as in dotted barlines that subdivide measures in"},{"type":"text","text":" "},{"type":"text","text":"complex meters. The two fermata elements allow for fermatas on both sides of the barline (the lower one"},{"type":"text","text":" "},{"type":"text","text":"inverted)."}],"url":"\/documentation\/ivormxl\/mxlbarline"},"doc://IvorMXL/s8CopyableP":{"title":"Swift.Copyable","identifier":"doc:\/\/IvorMXL\/s8CopyableP","type":"unresolvable"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/init(id:content:instrument:footnote:level:voice:kind:dot:accidental:timeModification:stem:notehead:noteheadText:staff:beam:notations:lyric:play:listen:xPosition:font:color:printout:printsLeger:dynamics:endDynamics:attack:release:timeOnly:isPizzicato:)":{"url":"\/documentation\/ivormxl\/mxlnote\/init(id:content:instrument:footnote:level:voice:kind:dot:accidental:timemodification:stem:notehead:noteheadtext:staff:beam:notations:lyric:play:listen:xposition:font:color:printout:printsleger:dynamics:enddynamics:attack:release:timeonly:is-7urwc","role":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/init(id:content:instrument:footnote:level:voice:kind:dot:accidental:timeModification:stem:notehead:noteheadText:sta