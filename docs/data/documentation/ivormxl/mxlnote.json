ollectionGroup"},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"title":"MXLNote","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNote"}],"abstract":[{"type":"text","text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for"},{"type":"text","text":" "},{"type":"text","text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation)."},{"type":"text","text":" "},{"type":"text","text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,"},{"type":"text","text":" "},{"type":"text","text":"but no tie elements. Having these two types of information available can make interchange easier, as some"},{"type":"text","text":" "},{"type":"text","text":"programs handle one type of information more readily than the other."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLNote"}],"url":"\/documentation\/ivormxl\/mxlnote"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/content-swift.property":{"title":"content","kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"content","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Content","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL7MXLNoteV7ContentO"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/content-swift.property","url":"\/documentation\/ivormxl\/mxlnote\/content-swift.property","type":"topic","abstract":[{"text":"One of the alternatives for Note.","type":"text"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/Notehead-swift.struct":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlnote\/notehead-swift.struct","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Notehead-swift.struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Notehead"}],"abstract":[{"type":"text","text":"The notehead type indicates shapes other than the open and closed ovals associated with note durations."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Notehead"}],"title":"MXLNote.Notehead"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/kind-swift.property":{"abstract":[{"type":"text","text":"The graphic note type (e.g. quarter, eighth), if specified."}],"title":"kind","url":"\/documentation\/ivormxl\/mxlnote\/kind-swift.property","kind":"symbol","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"kind","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Kind","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL7MXLNoteV4KindV"},{"text":"?","kind":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/kind-swift.property"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/attack":{"abstract":[{"type":"text","text":"Alters the starting time of the note from when it would otherwise occur, expressed in divisions. A note that"},{"type":"text","text":" "},{"type":"text","text":"stops a tie should not have an attack attribute."}],"title":"attack","url":"\/documentation\/ivormxl\/mxlnote\/attack","kind":"symbol","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"attack","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLDivisions","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL12MXLDivisionsV"},{"text":"?","kind":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/attack"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/isPizzicato":{"title":"isPizzicato","kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isPizzicato","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":"?","kind":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/isPizzicato","url":"\/documentation\/ivormxl\/mxlnote\/ispizzicato","type":"topic","abstract":[{"type":"text","text":"A Boolean value indicating whether just this note is sounded pizzicato, as opposed to the pizzicato element,"},{"type":"text","text":" "},{"type":"text","text":"which changes overall playback between pizzicato and arco."}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/beam":{"title":"beam","kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"beam","kind":"identifier"},{"text":": [","kind":"text"},{"text":"MXLBeam","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL7MXLBeamV"},{"text":"]","kind":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/beam","url":"\/documentation\/ivormxl\/mxlnote\/beam","type":"topic","abstract":[{"type":"text","text":"The beam markings associated with this note."}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/listen":{"title":"listen","kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"listen","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLListen","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLListenV"},{"text":"?","kind":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/listen","url":"\/documentation\/ivormxl\/mxlnote\/listen","type":"topic","abstract":[{"type":"text","text":"Listening information associated with this note, if any."}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/stem":{"title":"stem","kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"stem","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLStem","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL7MXLStemV"},{"text":"?","kind":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/stem","url":"\/documentation\/ivormxl\/mxlnote\/stem","type":"topic","abstract":[{"type":"text","text":"The direction of the stem for this note, if any."}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/font":{"title":"font","kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"font","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLFont","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL7MXLFontV"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/font","url":"\/documentation\/ivormxl\/mxlnote\/font","type":"topic","abstract":[{"type":"text","text":"The font attribute group gathers together attributes for determining the font within a credit or direction."},{"type":"text","text":" "},{"type":"text","text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of"},{"type":"text","text":" "},{"type":"text","text":"font names.The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric"},{"type":"text","text":" "},{"type":"text","text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font"},{"type":"text","text":" "},{"type":"text","text":"vs. a music font."}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/play":{"title":"play","kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"play","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLPlay","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL7MXLPlayV"},{"text":"?","kind":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/play","url":"\/documentation\/ivormxl\/mxlnote\/play","type":"topic","abstract":[{"type":"text","text":"Playback information associated with this note, if any."}],"role":"symbol"},"doc://IvorMXL/s9EscapableP":{"identifier":"doc:\/\/IvorMXL\/s9EscapableP","type":"unresolvable","title":"Swift.Escapable"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/notehead-swift.property":{"title":"notehead","kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"notehead","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Notehead","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL7MXLNoteV8NoteheadV"},{"text":"?","kind":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/notehead-swift.property","url":"\/documentation\/ivormxl\/mxlnote\/notehead-swift.property","type":"topic","abstract":[{"type":"text","text":"The notehead shape used for this note, if any."}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/dot":{"title":"dot","kind":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"dot"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:7IvorMXL17MXLEmptyPlacementV","kind":"typeIdentifier","text":"MXLEmptyPlacement"},{"kind":"text","text":"]"}],"abstract":[{"type":"text","text":"One dot element is used for each dot of prolongation. The placement attribute is used to specify whether the"},{"type":"text","text":" "},{"type":"text","text":"dot should appear above or below the staff line. It is ignored for notes that appear on a staff space."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/dot","role":"symbol","url":"\/documentation\/ivormxl\/mxlnote\/dot"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/printout":{"title":"printout","kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"printout","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLPrintout","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLPrintoutV"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/printout","url":"\/documentation\/ivormxl\/mxlnote\/printout","type":"topic","abstract":[{"type":"text","text":"The printout attribute group collects the different controls over printing an object (e.g. a note or rest) and"},{"type":"text","text":" "},{"type":"text","text":"its parts, including augmentation dots and lyrics. This is especially useful for notes that overlap in"},{"type":"text","text":" "},{"type":"text","text":"different voices, or for chord sheets that contain lyrics and chords but no melody."}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/timeModification":{"title":"timeModification","kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"timeModification","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLTimeModification","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL19MXLTimeModificationV"},{"text":"?","kind":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/timeModification","url":"\/documentation\/ivormxl\/mxlnote\/timemodification","type":"topic","abstract":[{"type":"text","text":"The time modification (e.g. for tuplets) applied to this note, if any."}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/dynamics":{"title":"dynamics","kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dynamics","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLNonNegativeDecimal","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL21MXLNonNegativeDecimala"},{"text":"?","kind":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/dynamics","url":"\/documentation\/ivormxl\/mxlnote\/dynamics","type":"topic","abstract":[{"type":"text","text":"The Note On velocity, corresponding to MIDI 1.0’s Note On velocity, expressed as a percentage of the default"},{"type":"text","text":" "},{"type":"text","text":"forte value (90 for MIDI 1.0)."}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/lyric":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlnote\/lyric","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/lyric","fragments":[{"kind":"keyword","text":"let"},{"text":" ","kind":"text"},{"text":"lyric","kind":"identifier"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:7IvorMXL8MXLLyricV","text":"MXLLyric","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"abstract":[{"type":"text","text":"The lyrics associated with this note."}],"kind":"symbol","type":"topic","title":"lyric"},"doc://IvorMXL/s16SendableMetatypeP":{"identifier":"doc:\/\/IvorMXL\/s16SendableMetatypeP","type":"unresolvable","title":"Swift.SendableMetatype"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/endDynamics":{"title":"endDynamics","kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"endDynamics","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLNonNegativeDecimal","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL21MXLNonNegativeDecimala"},{"text":"?","kind":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/endDynamics","url":"\/documentation\/ivormxl\/mxlnote\/enddynamics","type":"topic","abstract":[{"type":"text","text":"The Note Off velocity, corresponding to MIDI 1.0’s Note Off velocity, expressed as a percentage of the"},{"type":"text","text":" "},{"type":"text","text":"default forte value (90 for MIDI 1.0)."}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlbarline","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLBarline"}],"abstract":[{"type":"text","text":"If a barline is other than a normal single barline, it should be represented by a barline type that describes"},{"type":"text","text":" "},{"type":"text","text":"it. This includes information about repeats and multiple endings, as well as line style. Barline data is on"},{"type":"text","text":" "},{"type":"text","text":"the same level as the other musical data in a score — a child of a measure in a partwise score, or a part in a"},{"type":"text","text":" "},{"type":"text","text":"timewise score. This allows for barlines within measures, as in dotted barlines that subdivide measures in"},{"type":"text","text":" "},{"type":"text","text":"complex meters. The two fermata elements allow for fermatas on both sides of the barline (the lower one"},{"type":"text","text":" "},{"type":"text","text":"inverted)."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLBarline"}],"title":"MXLBarline"},"doc://IvorMXL/s8SendableP":{"identifier":"doc:\/\/IvorMXL\/s8SendableP","type":"unresolvable","title":"Swift.Sendable"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/Kind-swift.struct":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlnote\/kind-swift.struct","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Kind-swift.struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Kind"}],"abstract":[{"type":"text","text":"The note-type type indicates the graphic note type. Values range from 1024th to maxima. The size attribute"},{"type":"text","text":" "},{"type":"text","text":"indicates full, cue, grace-cue, or large size. The default is full for regular notes, grace-cue for notes that"},{"type":"text","text":" "},{"type":"text","text":"contain both grace and cue elements, and cue for notes that contain either a cue or a grace element, but not"},{"type":"text","text":" "},{"type":"text","text":"both."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Kind"}],"title":"MXLNote.Kind"}}}