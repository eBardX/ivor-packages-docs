":"keyword"},{"text":" ","kind":"text"},{"text":"stem","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL7MXLStemV","text":"MXLStem","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes":{"title":"MXLAttributes","url":"\/documentation\/ivormxl\/mxlattributes","abstract":[{"type":"text","text":"The attributes element contains musical information that typically changes on measure boundaries. This"},{"type":"text","text":" "},{"type":"text","text":"includes key and time signatures, clefs, transpositions, and staving. When attributes are changed mid-measure,"},{"type":"text","text":" "},{"type":"text","text":"it affects the music in score order, not in MusicXML document order."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLAttributes","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"MXLAttributes","kind":"identifier"}],"type":"topic","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/kind-swift.property":{"url":"\/documentation\/ivormxl\/mxlnote\/kind-swift.property","role":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/kind-swift.property","abstract":[{"type":"text","text":"The graphic note type (e.g. quarter, eighth), if specified."}],"title":"kind","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"kind","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL7MXLNoteV4KindV","text":"Kind","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlnote","title":"MXLNote","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNote","kind":"identifier"}],"navigatorTitle":[{"text":"MXLNote","kind":"identifier"}],"abstract":[{"type":"text","text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for"},{"type":"text","text":" "},{"type":"text","text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation)."},{"type":"text","text":" "},{"type":"text","text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,"},{"type":"text","text":" "},{"text":"but no tie elements. Having these two types of information available can make interchange easier, as some","type":"text"},{"type":"text","text":" "},{"type":"text","text":"programs handle one type of information more readily than the other."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/Kind-swift.struct":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlnote\/kind-swift.struct","title":"MXLNote.Kind","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Kind"}],"navigatorTitle":[{"kind":"identifier","text":"Kind"}],"abstract":[{"type":"text","text":"The note-type type indicates the graphic note type. Values range from 1024th to maxima. The size attribute"},{"type":"text","text":" "},{"type":"text","text":"indicates full, cue, grace-cue, or large size. The default is full for regular notes, grace-cue for notes that"},{"type":"text","text":" "},{"type":"text","text":"contain both grace and cue elements, and cue for notes that contain either a cue or a grace element, but not"},{"type":"text","text":" "},{"type":"text","text":"both."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Kind-swift.struct"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection":{"role":"symbol","url":"\/documentation\/ivormxl\/mxldirection","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLDirection","kind":"identifier"}],"navigatorTitle":[{"text":"MXLDirection","kind":"identifier"}],"abstract":[{"text":"A direction is a musical indication that is not necessarily attached to a specific note. Two or more may be","type":"text"},{"text":" ","type":"text"},{"text":"combined to indicate words followed by the start of a dashed line, the end of a wedge followed by dynamics,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"etc. For applications where a specific direction is indeed attached to a specific note, the direction element"},{"text":" ","type":"text"},{"type":"text","text":"can be associated with the first note element that follows it in score order that is not in a different voice."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection","title":"MXLDirection","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLSound":{"abstract":[{"type":"text","text":"The sound element contains general playback parameters. They can stand alone within a part\/measure, or be a"},{"type":"text","text":" "},{"type":"text","text":"component element within a direction."}],"title":"MXLSound","url":"\/documentation\/ivormxl\/mxlsound","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSound","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"MXLSound","kind":"identifier"}],"type":"topic","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound"},"doc://IvorMXL/documentation/IvorMXL/MXLFullNote":{"url":"\/documentation\/ivormxl\/mxlfullnote","role":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFullNote","abstract":[{"type":"text","text":"The full-note group is a sequence of the common note elements between cue\/grace notes and regular (full)"},{"type":"text","text":" "},{"type":"text","text":"notes: pitch, chord, and rest information, but not duration (cue and grace notes do not have duration"},{"type":"text","text":" "},{"type":"text","text":"encoded). Unpitched elements are used for unpitched percussion, speaking voice, and other musical elements"},{"type":"text","text":" "},{"type":"text","text":"lacking determinate pitch."}],"title":"MXLFullNote","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLFullNote","kind":"identifier"}],"navigatorTitle":[{"text":"MXLFullNote","kind":"identifier"}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLRest":{"url":"\/documentation\/ivormxl\/mxlrest","role":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRest","abstract":[{"type":"text","text":"The rest element indicates notated rests or silences. Rest elements are usually empty, but placement on the"},{"type":"text","text":" "},{"type":"text","text":"staff can be specified using display-step and display-octave elements. If the measure attribute is set to yes,"},{"type":"text","text":" "},{"type":"text","text":"this indicates this is a complete measure rest."}],"title":"MXLRest","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLRest","kind":"identifier"}],"navigatorTitle":[{"text":"MXLRest","kind":"identifier"}],"kind":"symbol"},"doc://IvorMXL/s9EscapableP":{"title":"Swift.Escapable","identifier":"doc:\/\/IvorMXL\/s9EscapableP","type":"unresolvable"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/dot":{"url":"\/documentation\/ivormxl\/mxlnote\/dot","role":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/dot","abstract":[{"type":"text","text":"One dot element is used for each dot of prolongation. The placement attribute is used to specify whether the"},{"type":"text","text":" "},{"type":"text","text":"dot should appear above or below the staff line. It is ignored for notes that appear on a staff space."}],"title":"dot","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dot","kind":"identifier"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:7IvorMXL17MXLEmptyPlacementV","text":"MXLEmptyPlacement","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/Notehead-swift.struct":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Notehead-swift.struct","role":"symbol","navigatorTitle":[{"text":"Notehead","kind":"identifier"}],"kind":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Notehead","kind":"identifier"}],"abstract":[{"text":"The notehead type indicates shapes other than the open and closed ovals associated with note durations.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlnote\/notehead-swift.struct","title":"MXLNote.Notehead"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/endDynamics":{"url":"\/documentation\/ivormxl\/mxlnote\/enddynamics","role":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/endDynamics","abstract":[{"type":"text","text":"The Note Off velocity, corresponding to MIDI 1.0’s Note Off velocity, expressed as a percentage of the"},{"type":"text","text":" "},{"type":"text","text":"default forte value (90 for MIDI 1.0)."}],"title":"endDynamics","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"endDynamics","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL21MXLNonNegativeDecimala","text":"MXLNonNegativeDecimal","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/dynamics":{"url":"\/documentation\/ivormxl\/mxlnote\/dynamics","role":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/dynamics","abstract":[{"type":"text","text":"The Note On velocity, corresponding to MIDI 1.0’s Note On velocity, expressed as a percentage of the default"},{"type":"text","text":" "},{"type":"text","text":"forte value (90 for MIDI 1.0)."}],"title":"dynamics","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dynamics","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL21MXLNonNegativeDecimala","text":"MXLNonNegativeDecimal","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/staff":{"url":"\/documentation\/ivormxl\/mxlnote\/staff","role":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/staff","abstract":[{"text":"The staff element is defined within a group due to its use by both notes and direction elements.","type":"text"}],"title":"staff","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"staff","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL8MXLStaffV","text":"MXLStaff","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"kind":"symbol"},"doc://IvorMXL/SH":{"title":"Swift.Hashable","identifier":"doc:\/\/IvorMXL\/SH","type":"unresolvable"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/Equatable-Implementations":{"url":"\/documentation\/ivormxl\/mxlnote\/equatable-implementations","role":"collectionGroup","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Equatable-Implementations","abstract":[],"title":"Equatable Implementations","kind":"article"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/NoteheadText-swift.struct":{"url":"\/documentation\/ivormxl\/mxlnote\/noteheadtext-swift.struct","role":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/NoteheadText-swift.struct","abstract":[{"type":"text","text":"The notehead-text type represents text that is displayed inside a notehead, as is done in some educational"},{"type":"text","text":" "},{"type":"text","text":"music. It is not needed for the numbers used in tablature or jianpu notation. The presence of a TAB or jianpu"},{"type":"text","text":" "},{"type":"text","text":"clefs is sufficient to indicate that numbers are used. The display-text and accidental-text elements allow"},{"type":"text","text":" "},{"type":"text","text":"display of fully formatted text and accidentals."}],"title":"MXLNote.NoteheadText","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NoteheadText","kind":"identifier"}],"navigatorTitle":[{"text":"NoteheadText","kind":"identifier"}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/printout":{"url":"\/documentation\/ivormxl\/mxlnote\/printout","role":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/printout","abstract":[{"type":"text","text":"The printout attribute group collects the different controls over printing an object (e.g. a note or rest) and"},{"type":"text","text":" "},{"type":"text","text":"its parts, including augmentation dots and lyrics. This is especially useful for notes that overlap in"},{"type":"text","text":" "},{"type":"text","text":"different voices, or for chord sheets that contain lyrics and chords but no melody."}],"title":"printout","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"printout","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL11MXLPrintoutV","text":"MXLPrintout","kind":"typeIdentifier"}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/Content-swift.enum":{"url":"\/documentation\/ivormxl\/mxlnote\/content-swift.enum","role":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Content-swift.enum","abstract":[{"type":"text","text":"One of the alternatives for Note."}],"title":"MXLNote.Content","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Content","kind":"identifier"}],"navigatorTitle":[{"text":"Content","kind":"identifier"}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/level":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/level","url":"\/documentation\/ivormxl\/mxlnote\/level","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"level","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL8MXLLevelV","text":"MXLLevel","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"abstract":[{"type":"text","text":"The level element specifies editorial information for different MusicXML elements. It is defined within a"},{"type":"text","text":" "},{"type":"text","text":"group due to its multiple uses within the MusicXML schema."}],"title":"level","type":"topic","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/font":{"url":"\/documentation\/ivormxl\/mxlnote\/font","role":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/font","abstract":[{"type":"text","text":"The font attribute group gathers together attributes for determining the font within a credit or direction."},{"type":"text","text":" "},{"type":"text","text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of"},{"type":"text","text":" "},{"type":"text","text":"font names.The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric"},{"type":"text","text":" "},{"type":"text","text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font"},{"type":"text","text":" "},{"type":"text","text":"vs. a music font."}],"title":"font","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"font","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL7MXLFontV","text":"MXLFont","kind":"typeIdentifier"}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/listen":{"url":"\/documentation\/ivormxl\/mxlnote\/listen","role":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/listen","abstract":[{"type":"text","text":"Listening information associated with this note, if any."}],"title":"listen","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"listen","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL9MXLListenV","text":"MXLListen","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/xPosition":{"url":"\/documentation\/ivormxl\/mxlnote\/xposition","role":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/xPosition","abstract":[{"type":"text","text":"The x-position attribute group is used for elements like notes where specifying x position is common, but"},{"type":"text","text":" "},{"type":"text","text":"specifying y position is rare."}],"title":"xPosition","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"xPosition","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL12MXLXPositionV","text":"MXLXPosition","kind":"typeIdentifier"}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/footnote":{"url":"\/documentation\/ivormxl\/mxlnote\/footnote","role":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/footnote","abstract":[{"type":"text","text":"The footnote element specifies editorial information that appears in footnotes in the printed score. It is"},{"type":"text","text":" "},{"type":"text","text":"defined within a group due to its multiple uses within the MusicXML schema."}],"title":"footnote","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"footnote","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL16MXLFormattedTextV","text":"MXLFormattedText","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLMusicItem":{"navigatorTitle":[{"text":"MXLMusicItem","kind":"identifier"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLMusicItem","kind":"identifier"}],"abstract":[{"type":"text","text":"One of the alternatives for a music item."}],"role":"symbol","url":"\/documentation\/ivormxl\/mxlmusicitem","type":"topic","title":"MXLMusicItem","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMusicItem","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/timeOnly":{"url":"\/documentation\/ivormxl\/mxlnote\/timeonly","role":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/timeOnly","abstract":[{"type":"text","text":"Indicates which times through a repeat this note is played, if only particular times."}],"title":"timeOnly","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"timeOnly","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLTimeOnly","preciseIdentifier":"s:7IvorMXL11MXLTimeOnlya","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/noteheadText-swift.property":{"url":"\/documentation\/ivormxl\/mxlnote\/noteheadtext-swift.property","role":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/noteheadText-swift.property","abstract":[{"text":"The text displayed inside the notehead, if any.","type":"text"}],"title":"noteheadText","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"noteheadText","kind":"identifier"},{"text":": ","kind":"text"},{"text":"NoteheadText","preciseIdentifier":"s:7IvorMXL7MXLNoteV12NoteheadTextV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/voice":{"url":"\/documentation\/ivormxl\/mxlnote\/voice","role":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/voice","abstract":[{"text":"A voice is a sequence of musical events (e.g. notes, chords, rests) that proceeds linearly in time. The voice","type":"text"},{"text":" ","type":"text"},{"text":"element is used to distinguish between multiple voices in individual parts. It is defined within a group due","type":"text"},{"text":" ","type":"text"},{"text":"to its multiple uses within the MusicXML schema.","type":"text"}],"title":"voice","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"voice","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLVoice","preciseIdentifier":"s:7IvorMXL8MXLVoiceV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/notations":{"url":"\/documentation\/ivormxl\/mxlnote\/notations","role":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/notations","abstract":[{"text":"The notations (e.g. articulations, ornaments) associated with this note.","type":"text"}],"title":"notations","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"notations","kind":"identifier"},{"text":": [","kind":"text"},{"text":"MXLNotations","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL12MXLNotationsV"},{"text":"]","kind":"text"}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNote/play":{"title":"play","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/play","type":"topic","kind":"symbol","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"play","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLPlay","preciseIdentifier":"s:7IvorMXL7MXLPlayV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"url":"\/documentation\/ivormxl\/mxlnote\/play","abstract":[{"type":"text","text":"Playback information associated with this note, if any."}]},"doc://IvorMXL/documentation/IvorMXL/MXLPitch":{"navigatorTitle":[{"text":"MXLPitch","kind":"identifier"}],"title":"MXLPitch","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPitch","type":"topic","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPitch","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlpitch","abstract":[{"text":"Pitch is represented as a combination of the step of the diatonic scale, the chromatic alteration, and the","type":"text"},{"text":" ","type":"text"},{"text":"octave.","type":"text"}]}}}