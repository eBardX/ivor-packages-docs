{"topicSections":[{"title":"Structures","anchor":"Structures","generated":true,"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Kind-swift.struct","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Notehead-swift.struct","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/NoteheadText-swift.struct"]},{"title":"Initializers","anchor":"Initializers","generated":true,"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/init(id:content:instrument:footnote:level:voice:kind:dot:accidental:timeModification:stem:notehead:noteheadText:staff:beam:notations:lyric:play:listen:xPosition:font:color:printout:printsLeger:dynamics:endDynamics:attack:release:timeOnly:isPizzicato:)"]},{"title":"Instance Properties","anchor":"Instance-Properties","generated":true,"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/accidental","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/attack","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/beam","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/color","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/content-swift.property","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/dot","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/dynamics","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/endDynamics","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/font","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/footnote","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/id","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/instrument","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/isPizzicato","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/kind-swift.property","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/level","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/listen","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/lyric","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/notations","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/notehead-swift.property","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/noteheadText-swift.property","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/play","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/printout","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/printsLeger","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/release","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/staff","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/stem","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/timeModification","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/timeOnly","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/voice","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/xPosition"]},{"title":"Enumerations","anchor":"Enumerations","generated":true,"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Content-swift.enum"]},{"title":"Default Implementations","anchor":"Default-Implementations","generated":true,"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote\/Equatable-Implementations"]}],"kind":"symbol","relationshipsSections":[{"title":"Conforms To","kind":"relationships","type":"conformsTo","identifiers":["doc:\/\/IvorMXL\/s8CopyableP","doc:\/\/IvorMXL\/SQ","doc:\/\/IvorMXL\/s9EscapableP","doc:\/\/IvorMXL\/SH","doc:\/\/IvorMXL\/s8SendableP","doc:\/\/IvorMXL\/s16SendableMetatypeP"]}],"metadata":{"modules":[{"name":"IvorMXL"}],"role":"symbol","externalID":"s:7IvorMXL7MXLNoteV","symbolKind":"struct","roleHeading":"Structure","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNote","kind":"identifier"}],"title":"MXLNote","navigatorTitle":[{"kind":"identifier","text":"MXLNote"}]},"abstract":[{"type":"text","text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for"},{"type":"text","text":" "},{"type":"text","text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation)."},{"type":"text","text":" "},{"type":"text","text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,"},{"type":"text","text":" "},{"type":"text","text":"but no tie elements. Having these two types of information available can make interchange easier, as some"},{"type":"text","text":" "},{"type":"text","text":"programs handle one type of information more readily than the other."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlnote"]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"seeAlsoSections":[{"title":"Music","anchor":"Music","generated":true,"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMusicItem","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFullNote","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRest","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPitch","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound"]}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNote","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The print-leger attribute is used to indicate whether leger lines are printed. Notes without leger lines are"},{"type":"text","text":" "},{"type":"text","text":"used to indicate indeterminate high and low notes. By default, it is set to yes. If print-object is set to no,"},{"type":"text","text":" "},{"type":"text","text":"print-leger is interpreted to also be set to no if not present. This attribute is ignored for rests."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The dynamics and end-dynamics attributes correspond to MIDI 1.0’s Note On and Note Off velocities,"},{"type":"text","text":" "},{"type":"text","text":"respectively. They are expressed in terms of percentages of the default forte value (90 for MIDI 1.0)."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The attack and release attributes are used to alter the starting and stopping time of the note from when it"},{"type":"text","text":" "},{"type":"text","text":"would otherwise occur based on the flow of durations - information that is specific to a performance. They are"},{"type":"text","text":" "},{"type":"text","text":"expressed in terms of divisions, either positive or negative. A note that starts a tie should not have a"},{"type":"text","text":" "},{"type":"text","text":"release attribute, and a note that stops a tie should not have an attack attribute. The attack and release"},{"type":"text","text":" "},{"type":"text","text":"attributes are independent of each other. The attack attribute only changes the starting time of a note, and"},{"type":"text","text":" "},{"type":"text","text":"the release attribute only changes the stopping time of a note."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If a note is played only particular times through a repeat, the time-only attribute shows which times to play"},{"type":"text","text":" "},{"type":"text","text":"the note."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The pizzicato attribute is used when just this note is sounded pizzicato, vs. the pizzicato element which"},{"type":"text","text":" "},{"type":"text","text":"changes overall playback between pizzicato and arco."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Maps the MusicXML "},{"type":"codeVoice","code":"<note>"},{"type":"text","text":" element."}]}],"kind":"content"}],"sections":[],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL"]]},"references":{"doc://IvorMXL/docume