lement, such as a note or a notation.","type":"text"}],"type":"paragraph"}]},{"name":"orientation","content":[{"inlineContent":[{"text":"The orientation attribute indicates whether slurs and ties are overhand (tips down) or underhand (tips up). This is distinct from the placement attribute used by any notation type.","type":"text"}],"type":"paragraph"}]},{"name":"bezierX","content":[{"inlineContent":[{"text":"The x-coordinate, in tenths relative to any position settings, of the outgoing bezier control point for a slur or tie with a start type, or the incoming control point for one with a stop or continue type.","type":"text"}],"type":"paragraph"}]},{"name":"bezierY","content":[{"inlineContent":[{"text":"The y-coordinate, in tenths relative to any position settings, of the outgoing bezier control point for a slur or tie with a start type, or the incoming control point for one with a stop or continue type.","type":"text"}],"type":"paragraph"}]},{"name":"bezierX2","content":[{"inlineContent":[{"text":"The x-coordinate, in tenths, of the outgoing bezier control point for a slur with a continue type.","type":"text"}],"type":"paragraph"}]},{"name":"bezierY2","content":[{"inlineContent":[{"text":"The y-coordinate, in tenths, of the outgoing bezier control point for a slur with a continue type.","type":"text"}],"type":"paragraph"}]},{"name":"bezierOffset","content":[{"inlineContent":[{"text":"The outgoing bezier control point offset, in musical divisions, for a slur or tie with a start type, or the incoming control point offset for one with a stop or continue type. Deprecated as of MusicXML 3.1 in favor of ","type":"text"},{"code":"bezierX","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"name":"bezierOffset2","content":[{"inlineContent":[{"text":"The outgoing bezier control point offset, in musical divisions, for a slur with a continue type. Deprecated as of MusicXML 3.1 in favor of ","type":"text"},{"code":"bezierX2","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"name":"color","content":[{"inlineContent":[{"text":"The color attribute group indicates the color of an element.","type":"text"}],"type":"paragraph"}]}]}],"abstract":[{"text":"Creates a new ","type":"text"},{"code":"MXLSlur","type":"codeVoice"},{"text":".","type":"text"}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSlur\/init(id:kind:number:lineKind:dashLength:spaceLength:position:placement:orientation:bezierX:bezierY:bezierX2:bezierY2:bezierOffset:bezierOffset2:color:)","interfaceLanguage":"swift"},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlslur\/init(id:kind:number:linekind:dashlength:spacelength:position:placement:orientation:bezierx:beziery:bezierx2:beziery2:bezieroffset:bezieroffset2:color:)"]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLStartStopContinue":{"abstract":[{"type":"text","text":"The start-stop-continue type is used for an attribute of musical elements that can either start or stop, but"},{"type":"text","text":" "},{"type":"text","text":"also need to refer to an intermediate point in the symbol, as for complex slurs or for formatting of symbols"},{"type":"text","text":" "},{"type":"text","text":"across system breaks."}],"title":"MXLStartStopContinue","kind":"symbol","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLStartStopContinue","kind":"identifier"}],"navigatorTitle":[{"text":"MXLStartStopContinue","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlstartstopcontinue","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStartStopContinue"},"doc://IvorMXL/documentation/IvorMXL/MXLPosition":{"title":"MXLPosition","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPosition"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlposition","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","abstract":[{"text":"For most elements, any program will compute a default x and y position. The position attributes let this be","type":"text"},{"text":" ","type":"text"},{"text":"changed two ways.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"MXLPosition"}]},"doc://IvorMXL/documentation/IvorMXL/MXLNumberLevel":{"title":"MXLNumberLevel","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNumberLevel"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlnumberlevel","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumberLevel","abstract":[{"text":"Slurs, tuplets, and many other features can be concurrent and overlap within a single musical part. The","type":"text"},{"text":" ","type":"text"},{"text":"number-level entity distinguishes up to 16 concurrent objects of the same type when the objects overlap in","type":"text"},{"text":" ","type":"text"},{"text":"MusicXML document order. Values greater than 6 are usually only needed for music with a large number of divisi","type":"text"},{"text":" ","type":"text"},{"text":"staves in a single part, or if there are more than 6 cross-staff arpeggios in a single measure. When a number-","type":"text"},{"text":" ","type":"text"},{"text":"level value is implied, the value is 1 by default.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"MXLNumberLevel"}]},"doc://IvorMXL/documentation/IvorMXL/MXLDivisions":{"title":"MXLDivisions","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLDivisions","kind":"identifier"}],"kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxldivisions","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDivisions","abstract":[{"type":"text","text":"The divisions type is used to express values in terms of the musical divisions defined by the divisions"},{"type":"text","text":" "},{"type":"text","text":"element. It is preferred that these be integer values both for MIDI interoperability and to avoid roundoff"},{"type":"text","text":" "},{"type":"text","text":"errors."}],"navigatorTitle":[{"text":"MXLDivisions","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLLineKind":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLineKind","title":"MXLLineKind","kind":"symbol","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLLineKind","kind":"identifier"}],"navigatorTitle":[{"text":"MXLLineKind","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxllinekind","abstract":[{"text":"The line-type type distinguishes between solid, dashed, dotted, and wavy lines.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLSlur":{"title":"MXLSlur","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSlur","kind":"identifier"}],"kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxlslur","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSlur","abstract":[{"text":"Slur types are empty. Most slurs are represented with two elements: one with a start type, and one with a stop","type":"text"},{"text":" ","type":"text"},{"text":"type. Slurs can add more elements using a continue type. This is typically used to specify the formatting of","type":"text"},{"text":" ","type":"text"},{"text":"cross-system slurs, or to specify the shape of very complex slurs.","type":"text"}],"navigatorTitle":[{"text":"MXLSlur","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLTenths":{"abstract":[{"text":"The tenths type is a number representing tenths of interline staff space (positive or negative). Both integer","type":"text"},{"text":" ","type":"text"},{"text":"and decimal values are allowed, such as 5 for a half space and 2.5 for a quarter space. Interline space is","type":"text"},{"text":" ","type":"text"},{"text":"measured from the middle of a staff line.","type":"text"}],"title":"MXLTenths","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTenths"}],"navigatorTitle":[{"kind":"identifier","text":"MXLTenths"}],"type":"topic","url":"\/documentation\/ivormxl\/mxltenths","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths"},"doc://IvorMXL/documentation/IvorMXL/MXLOverUnder":{"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLOverUnder"}],"title":"MXLOverUnder","url":"\/documentation\/ivormxl\/mxloverunder","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLOverUnder"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOverUnder","abstract":[{"text":"The over-under type is used to indicate whether the tips of curved lines such as slurs and ties are overhand","type":"text"},{"text":" ","type":"text"},{"text":"(tips down) or underhand (tips up).","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLSlur/init(id:kind:number:lineKind:dashLength:spaceLength:position:placement:orientation:bezierX:bezierY:bezierX2:bezierY2:bezierOffset:bezierOffset2:color:)":{"title":"init(id:kind:number:lineKind:dashLength:spaceLength:position:placement:orientation:bezierX:bezierY:bezierX2:bezierY2:bezierOffset:bezierOffset2:color:)","role":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?, ","kind":"text"