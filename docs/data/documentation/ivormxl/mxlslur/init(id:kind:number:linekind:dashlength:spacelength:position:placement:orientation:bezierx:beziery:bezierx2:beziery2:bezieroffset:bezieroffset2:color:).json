lor:)","type":"topic","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLStartStopContinue":{"title":"MXLStartStopContinue","abstract":[{"text":"The start-stop-continue type is used for an attribute of musical elements that can either start or stop, but","type":"text"},{"text":" ","type":"text"},{"text":"also need to refer to an intermediate point in the symbol, as for complex slurs or for formatting of symbols","type":"text"},{"text":" ","type":"text"},{"text":"across system breaks.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlstartstopcontinue","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLStartStopContinue"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLStartStopContinue"}],"type":"topic","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStartStopContinue"},"doc://IvorMXL/documentation/IvorMXL/MXLPosition":{"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPosition","kind":"identifier"}],"title":"MXLPosition","navigatorTitle":[{"text":"MXLPosition","kind":"identifier"}],"abstract":[{"type":"text","text":"For most elements, any program will compute a default x and y position. The position attributes let this be"},{"type":"text","text":" "},{"type":"text","text":"changed two ways."}],"url":"\/documentation\/ivormxl\/mxlposition","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLAboveBelow":{"title":"MXLAboveBelow","type":"topic","fragments":[{"kind":"keyword","text":"enum"},{"text":" ","kind":"text"},{"kind":"identifier","text":"MXLAboveBelow"}],"url":"\/documentation\/ivormxl\/mxlabovebelow","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAboveBelow","role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLAboveBelow"}],"abstract":[{"type":"text","text":"The above-below type is used to indicate whether one element appears above or below another element."}]},"doc://IvorMXL/documentation/IvorMXL/MXLOverUnder":{"abstract":[{"type":"text","text":"The over-under type is used to indicate whether the tips of curved lines such as slurs and ties are overhand"},{"type":"text","text":" "},{"type":"text","text":"(tips down) or underhand (tips up)."}],"url":"\/documentation\/ivormxl\/mxloverunder","navigatorTitle":[{"text":"MXLOverUnder","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOverUnder","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLOverUnder","kind":"identifier"}],"title":"MXLOverUnder","type":"topic","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLDivisions":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDivisions","role":"symbol","navigatorTitle":[{"text":"MXLDivisions","kind":"identifier"}],"type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLDivisions","kind":"identifier"}],"abstract":[{"type":"text","text":"The divisions type is used to express values in terms of the musical divisions defined by the divisions"},{"type":"text","text":" "},{"type":"text","text":"element. It is preferred that these be integer values both for MIDI interoperability and to avoid roundoff"},{"type":"text","text":" "},{"type":"text","text":"errors."}],"url":"\/documentation\/ivormxl\/mxldivisions","title":"MXLDivisions"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlcolor","title":"MXLColor","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"type":"text","text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is"},{"type":"text","text":" "},{"type":"text","text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor"},"doc://IvorMXL/documentation/IvorMXL/MXLLineKind":{"abstract":[{"text":"The line-type type distinguishes between solid, dashed, dotted, and wavy lines.","type":"text"}],"title":"MXLLineKind","url":"\/documentation\/ivormxl\/mxllinekind","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLLineKind","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"MXLLineKind","kind":"identifier"}],"type":"topic","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLineKind"},"doc://IvorMXL/documentation/IvorMXL/MXLSlur":{"navigatorTitle":[{"text":"MXLSlur","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSlur","kind":"identifier"}],"abstract":[{"type":"text","text":"Slur types are empty. Most slurs are represented with two elements: one with a start type, and one with a stop"},{"type":"text","text":" "},{"type":"text","text":"type. Slurs can add more elements using a continue type. This is typically used to specify the formatting of"},{"type":"text","text":" "},{"type":"text","text":"cross-system slurs, or to specify the shape of very complex slurs."}],"role":"symbol","url":"\/documentation\/ivormxl\/mxlslur","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSlur","title":"MXLSlur","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNumberLevel":{"type":"topic","url":"\/documentation\/ivormxl\/mxlnumberlevel","role":"symbol","title":"MXLNumberLevel","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumberLevel","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNumberLevel","kind":"identifier"}],"abstract":[{"text":"Slurs, tuplets, and many other features can be concurrent and overlap within a single musical part. The","type":"text"},{"text":" ","type":"text"},{"text":"number-level entity distinguishes up to 16 concurrent objects of the same type when the objects overlap in","type":"text"},{"text":" ","type":"text"},{"text":"MusicXML document order. Values greater than 6 are usually only needed for music with a large number of divisi","type":"text"},{"text":" ","type":"text"},{"text":"staves in a single part, or if there are more than 6 cross-staff arpeggios in a single measure. When a number-","type":"text"},{"text":" ","type":"text"},{"text":"level value is implied, the value is 1 by default.","type":"text"}],"navigatorTitle":[{"text":"MXLNumberLevel","kind":"identifier"}],"kind":"symbol"}}}