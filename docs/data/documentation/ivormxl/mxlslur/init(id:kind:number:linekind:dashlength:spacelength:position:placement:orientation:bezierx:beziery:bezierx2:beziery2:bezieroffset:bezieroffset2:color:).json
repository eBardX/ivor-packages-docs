eIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths"},{"kind":"text","text":"? = nil, "},{"text":"bezierOffset","kind":"externalParam"},{"kind":"text","text":": "},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDivisions","preciseIdentifier":"s:7IvorMXL12MXLDivisionsV","kind":"typeIdentifier","text":"MXLDivisions"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"bezierOffset2"},{"kind":"text","text":": "},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDivisions","preciseIdentifier":"s:7IvorMXL12MXLDivisionsV","kind":"typeIdentifier","text":"MXLDivisions"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"color"},{"kind":"text","text":": "},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","preciseIdentifier":"s:7IvorMXL8MXLColorV","kind":"typeIdentifier","text":"MXLColor"},{"kind":"text","text":"? = nil)"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The optional-unique-id attribute group allows an element to optionally specify an ID"},{"type":"text","text":" "},{"type":"text","text":"that is unique to the entire document. This attribute group is not used for a"},{"type":"text","text":" "},{"type":"text","text":"required id attribute, or for an id attribute that specifies an id reference."}]}],"name":"id"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Whether this element marks the start, stop, or continuation of the slur."}]}],"name":"kind"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Defaults to "},{"type":"codeVoice","code":"1"},{"type":"text","text":"."}]}],"name":"number"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The line-type attribute distinguishes between solid, dashed, dotted, and wavy lines."}]}],"name":"lineKind"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The length, in tenths, of the dashes in a dashed line. Ignored if the corresponding"},{"type":"text","text":" "},{"type":"text","text":"line-type attribute is not dashed."}]}],"name":"dashLength"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The length, in tenths, of the spaces in a dashed line. Ignored if the corresponding"},{"type":"text","text":" "},{"type":"text","text":"line-type attribute is not dashed."}]}],"name":"spaceLength"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For most elements, any program will compute a default x and y position. The position"},{"type":"text","text":" "},{"type":"text","text":"attributes let this be changed two ways."}]}],"name":"position"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The placement attribute indicates whether something is above or below another"},{"type":"text","text":" "},{"type":"text","text":"element, such as a note or a notation."}]}],"name":"placement"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The orientation attribute indicates whether slurs and ties are overhand (tips down)"},{"type":"text","text":" "},{"type":"text","text":"or underhand (tips up). This is distinct from the placement attribute used by any"},{"type":"text","text":" "},{"type":"text","text":"notation type."}]}],"name":"orientation"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The x-coordinate, in tenths relative to any position settings, of the outgoing"},{"type":"text","text":" "},{"type":"text","text":"bezier control point for a slur or tie with a start type, or the incoming control"},{"type":"text","text":" "},{"type":"text","text":"point for one with a stop or continue type."}]}],"name":"bezierX"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The y-coordinate, in tenths relative to any position settings, of the outgoing"},{"type":"text","text":" "},{"type":"text","text":"bezier control point for a slur or tie with a start type, or the incoming control"},{"type":"text","text":" "},{"type":"text","text":"point for one with a stop or continue type."}]}],"name":"bezierY"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The x-coordinate, in tenths, of the outgoing bezier control point for a slur with a"},{"type":"text","text":" "},{"type":"text","text":"continue type."}]}],"name":"bezierX2"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The y-coordinate, in tenths, of the outgoing bezier control point for a slur with a"},{"type":"text","text":" "},{"type":"text","text":"continue type."}]}],"name":"bezierY2"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The outgoing bezier control point offset, in musical divisions, for a slur or tie"},{"type":"text","text":" "},{"type":"text","text":"with a start type, or the incoming control point offset for one with a stop or"},{"type":"text","text":" "},{"type":"text","text":"continue type. Deprecated as of MusicXML 3.1 in favor of "},{"type":"codeVoice","code":"bezierX"},{"type":"text","text":"."}]}],"name":"bezierOffset"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The outgoing bezier control point offset, in musical divisions, for a slur with a"},{"type":"text","text":" "},{"type":"text","text":"continue type. Deprecated as of MusicXML 3.1 in favor of "},{"code":"bezierX2","type":"codeVoice"},{"text":".","type":"text"}]}],"name":"bezierOffset2"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The color attribute group indicates the color of an element.","type":"text"}]}],"name":"color"}]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLAboveBelow":{"type":"topic","title":"MXLAboveBelow","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAboveBelow","abstract":[{"type":"text","text":"The above-below type is used to indicate whether one element appears above or below another element."}],"role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLAboveBelow"}],"navigatorTitle":[{"kind":"identifier","text":"MXLAboveBelow"}],"url":"\/documentation\/ivormxl\/mxlabovebelow"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLSlur":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSlur","kind":"identifier"}],"title":"MXLSlur","abstract":[{"text":"Slur types are empty. Most slurs are represented with two elements: one with a start type, and one with a stop","type":"text"},{"text":" ","type":"text"},{"text":"type. Slurs can add more elements using a continue type. This is typically used to specify the formatting of","type":"text"},{"text":" ","type":"text"},{"text":"cross-system slurs, or to specify the shape of very complex slurs.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSlur","role":"symbol","url":"\/documentation\/ivormxl\/mxlslur","kind":"symbol","navigatorTitle":[{"text":"MXLSlur","kind":"identifier"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLOverUnder":{"title":"MXLOverUnder","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLOverUnder","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxloverunder","role":"symbol","navigatorTitle":[{"text":"MXLOverUnder","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOverUnder","abstract":[{"type":"text","text":"The over-under type is used to indicate whether the tips of curved lines such as slurs and ties are overhand"},{"type":"text","text":" "},{"type":"text","text":"(tips down) or underhand (tips up)."}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"type":"topic","abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"type":"text","text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is"},{"type":"text","text":" "},{"type":"text","text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF."}],"url":"\/documentation\/ivormxl\/mxlcolor","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"kind":"symbol","title":"MXLColor","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNumberLevel":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumberLevel","navigatorTitle":[{"kind":"identifier","text":"MXLNumberLevel"}],"url":"\/documentation\/ivormxl\/mxlnumberlevel","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNumberLevel"}],"title":"MXLNumberLevel","abstract":[{"text":"Slurs, tuplets, and many other features can be concurrent and overlap within a single musical part. The","type":"text"},{"text":" ","type":"text"},{"text":"number-level entity distinguishes up to 16 concurrent objects of the same type when the objects overlap in","type":"text"},{"text":" ","type":"text"},{"text":"MusicXML document order. Values greater than 6 are usually only needed for music with a large number of divisi","type":"text"},{"text":" ","type":"text"},{"text":"staves in a single part, or if there are more than 6 cross-staff arpeggios in a single measure. When a number-","type":"text"},{"text":" ","type":"text"},{"text":"level value is implied, the value is 1 by default.","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLStartStopContinue":{"type":"topic","abstract":[{"type":"text","text":"The start-stop-continue type is used for an attribute of musical elements that can either start or stop, but"},{"type":"text","text":" "},{"type":"text","text":"also need to refer to an intermediate point in the symbol, as for complex slurs or for formatting of symbols"},{"type":"text","text":" "},{"type":"text","text":"across system breaks."}],"url":"\/documentation\/ivormxl\/mxlstartstopcontinue","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLStartStopContinue"}],"kind":"symbol","title":"MXLStartStopContinue","navigatorTitle":[{"text":"MXLStartStopContinue","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStartStopContinue","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLLineKind":{"type":"topic","title":"MXLLineKind","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLineKind","abstract":[{"text":"The line-type type distinguishes between solid, dashed, dotted, and wavy lines.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLLineKind"}],"navigatorTitle":[{"kind":"identifier","text":"MXLLineKind"}],"url":"\/documentation\/ivormxl\/mxllinekind"},"doc://IvorMXL/documentation/IvorMXL/MXLSlur/init(id:kind:number:lineKind:dashLength:spaceLength:position:placement:orientation:bezierX:bezierY:bezierX2:bezierY2:bezierOffset:bezierOffset2:color:)":{"kind":"symbol","type":"topic","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"id"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"kind","kind":"externalParam"},{"kind":"text","text":": "},{"pre