lative to any position settings, of the outgoing bezier control point for a"},{"type":"text","text":" "},{"type":"text","text":"slur or tie with a start type, or the incoming control point for one with a stop or continue type."}],"url":"\/documentation\/ivormxl\/mxlslur\/beziery","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"bezierY","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLTenths","preciseIdentifier":"s:7IvorMXL9MXLTenthsa","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"kind":"symbol","title":"bezierY","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSlur\/bezierY","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLSlur":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSlur","kind":"identifier"}],"title":"MXLSlur","abstract":[{"text":"Slur types are empty. Most slurs are represented with two elements: one with a start type, and one with a stop","type":"text"},{"text":" ","type":"text"},{"text":"type. Slurs can add more elements using a continue type. This is typically used to specify the formatting of","type":"text"},{"text":" ","type":"text"},{"text":"cross-system slurs, or to specify the shape of very complex slurs.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSlur","role":"symbol","url":"\/documentation\/ivormxl\/mxlslur","kind":"symbol","navigatorTitle":[{"text":"MXLSlur","kind":"identifier"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLTenths":{"type":"topic","abstract":[{"type":"text","text":"The tenths type is a number representing tenths of interline staff space (positive or negative). Both integer"},{"type":"text","text":" "},{"type":"text","text":"and decimal values are allowed, such as 5 for a half space and 2.5 for a quarter space. Interline space is"},{"type":"text","text":" "},{"type":"text","text":"measured from the middle of a staff line."}],"url":"\/documentation\/ivormxl\/mxltenths","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTenths"}],"kind":"symbol","title":"MXLTenths","navigatorTitle":[{"kind":"identifier","text":"MXLTenths"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths","role":"symbol"}}}