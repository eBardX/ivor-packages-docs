/documentation/IvorMXL/MXLColor":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlcolor","title":"MXLColor","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"type":"text","text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is"},{"type":"text","text":" "},{"type":"text","text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLSlur":{"navigatorTitle":[{"text":"MXLSlur","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSlur","kind":"identifier"}],"abstract":[{"type":"text","text":"Slur types are empty. Most slurs are represented with two elements: one with a start type, and one with a stop"},{"type":"text","text":" "},{"type":"text","text":"type. Slurs can add more elements using a continue type. This is typically used to specify the formatting of"},{"type":"text","text":" "},{"type":"text","text":"cross-system slurs, or to specify the shape of very complex slurs."}],"role":"symbol","url":"\/documentation\/ivormxl\/mxlslur","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSlur","title":"MXLSlur","kind":"symbol"}}}