:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSlur","abstract":[{"text":"Slur types are empty. Most slurs are represented with two elements: one with a start type, and one with a stop","type":"text"},{"text":" ","type":"text"},{"text":"type. Slurs can add more elements using a continue type. This is typically used to specify the formatting of","type":"text"},{"text":" ","type":"text"},{"text":"cross-system slurs, or to specify the shape of very complex slurs.","type":"text"}],"navigatorTitle":[{"text":"MXLSlur","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLSlur/bezierX2":{"title":"bezierX2","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"bezierX2","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLTenths","preciseIdentifier":"s:7IvorMXL9MXLTenthsa","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxlslur\/bezierx2","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSlur\/bezierX2","abstract":[{"text":"The x-coordinate, in tenths, of the outgoing bezier control point for a slur with a continue type.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLTenths":{"abstract":[{"text":"The tenths type is a number representing tenths of interline staff space (positive or negative). Both integer","type":"text"},{"text":" ","type":"text"},{"text":"and decimal values are allowed, such as 5 for a half space and 2.5 for a quarter space. Interline space is","type":"text"},{"text":" ","type":"text"},{"text":"measured from the middle of a staff line.","type":"text"}],"title":"MXLTenths","kind":"symbol","role":"symbol","fragments":[{"kind":"keywor