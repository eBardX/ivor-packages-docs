xt":" ","kind":"text"},{"text":"dashLength","kind":"identifier"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLTenthsa","text":"MXLTenths"},{"text":"?","kind":"text"}],"title":"dashLength","abstract":[{"text":"The length, in tenths, of the dashes in a dashed line. Ignored if the corresponding line-type attribute is","type":"text"},{"text":" ","type":"text"},{"text":"not dashed.","type":"text"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlslur\/dashlength"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLSlur":{"navigatorTitle":[{"text":"MXLSlur","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSlur","kind":"identifier"}],"abstract":[{"type":"text","text":"Slur types are empty. Most slurs are represented with two elements: one with a start type, and one with a stop"},{"type":"text","text":" "},{"type":"text","text":"type. Slurs can add more elements using a continue type. This is typically used to specify the formatting of"},{"type":"text","text":" "},{"type":"text","text":"cross-system slurs, or to specify the shape of very complex slurs."}],"role":"symbol","url":"\/documentation\/ivormxl\/mxlslur","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSlur","title":"MXLSlur","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLTenths":{"title":"MXLTenths","type":"topic","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTenths","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxltenths","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"MXLTenths","kind":"identifier"}],"abstract":[{"type":"text","text":"The tenths type is a number representing tenths of interline staff space (positive or negative). Both integer"},{"type":"text","text":" "},{"type":"text","text":"and decimal values are allowed, such as 5 for a half space and 2.5 for a quarter space. Interline space is"},{"type":"text","text":" "},{"type":"text","text":"measured from the middle of a staff line."}]}}}