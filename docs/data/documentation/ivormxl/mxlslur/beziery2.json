{"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSlur"]]},"kind":"symbol","sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"bezierY2","kind":"identifier"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths","preciseIdentifier":"s:7IvorMXL9MXLTenthsa","text":"MXLTenths","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Maps to the MusicXML ","type":"text"},{"code":"bezier-y2","type":"codeVoice"},{"text":" attribute.","type":"text"}]}]}],"metadata":{"externalID":"s:7IvorMXL7MXLSlurV8bezierY2SdSgvp","modules":[{"name":"IvorMXL"}],"title":"bezierY2","roleHeading":"Instance Property","role":"symbol","symbolKind":"property","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"bezierY2","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL9MXLTenthsa","text":"MXLTenths","kind":"typeIdentifier"},{"text":"?","kind":"text"}]},"variants":[{"paths":["\/documentation\/ivormxl\/mxlslur\/beziery2"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSlur\/bezierY2","interfaceLanguage":"swift"},"abstract":[{"text":"The y-coordinate, in tenths, of the outgoing bezier control point for a slur with a continue type.","type":"text"}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLTenths":{"title":"MXLTenths","type":"topic","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTenths","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxltenths","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"MXLTenths","kind":"identifier"}],"abstract":[{"type":"text","text":"The tenths type is a number representing tenths of interline staff space (positive or negative). Both integer"},{"type":"text","text":" "},{"type":"text","text":"and decimal values are allowed, such as 5 for a half space and 2.5 for a quarter space. Interline space is"},{"type":"text","text":" "},{"type":"text","text":"measured from the middle of a staff line."}]},"doc://IvorMXL/documentation/IvorMXL/MXLSlur":{"navigatorTitle":[{"text":"MXLSlur","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSlur","kind":"identifier"}],"abstract":[{"type":"text","text":"Slur types are empty. Most slurs are represented with two elements: one with a start type, and one with a stop"},{"type":"text","text":" "},{"type":"text","text":"type. Slurs can add more elements using a continue type. This is typically used to specify the formatting of"},{"type":"text","text":" "},{"type":"text","text":"cross-system slurs, or to specify the shape of very complex slurs."}],"role":"symbol","url":"\/documentation\/ivormxl\/mxlslur","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSlur","title":"MXLSlur","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLSlur/bezierY2":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"bezierY2","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL9MXLTenthsa","text":"MXLTenths","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSlur\/bezierY2","url":"\/documentation\/ivormxl\/mxlslur\/beziery2","title":"bezierY2","type":"topic","abstract":[{"type":"text","text":"The y-coordinate, in tenths, of the outgoing bezier control point for a slur with a continue type."}],"role":"symbol"},"doc://IvorMXL