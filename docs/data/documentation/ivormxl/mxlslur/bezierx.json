ur","abstract":[{"text":"Slur types are empty. Most slurs are represented with two elements: one with a start type, and one with a stop","type":"text"},{"text":" ","type":"text"},{"text":"type. Slurs can add more elements using a continue type. This is typically used to specify the formatting of","type":"text"},{"text":" ","type":"text"},{"text":"cross-system slurs, or to specify the shape of very complex slurs.","type":"text"}],"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLSlur"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSlur","navigatorTitle":[{"text":"MXLSlur","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLTenths":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLTenths"}],"abstract":[{"type":"text","text":"The tenths type is a number representing tenths of interline staff space (positive or negative). Both integer"},{"type":"text","text":" "},{"type":"text","text":"and decimal values are allowed, such as 5 for a half space and 2.5 for a quarter space. Interline space is"},{"type":"text","text":" "},{"type":"text","text":"measured from the middle of a staff line."}],"kind":"symbol","title":"MXLTenths","url":"\/documentation\/ivormxl\/mxltenths","role":"symbol","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTenths"}]},"doc://IvorMXL/documentation/IvorMXL/MXLSlur/bezierX":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSlur\/bezierX","kind":"symbol","role":"symbol","title":"bezierX","type":"topic","abstract":[{"text":"