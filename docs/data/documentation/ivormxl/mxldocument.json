s the different musical parts in this document. Each part has an ID that is used later"},{"type":"text","text":" "},{"type":"text","text":"within the musical data. Since parts may be encoded separately and combined later, identification elements are"},{"type":"text","text":" "},{"type":"text","text":"present at both the score and score-part levels. There must be at least one score-part, combined as desired"},{"type":"text","text":" "},{"type":"text","text":"with part-group elements that indicate braces and brackets. Parts are ordered from top to bottom in a score"},{"type":"text","text":" "},{"type":"text","text":"based on the order in which they appear in the part-list."}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPartList","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartList","url":"\/documentation\/ivormxl\/mxlpartlist"},"doc://IvorMXL/documentation/IvorMXL/MXLDocument/Equatable-Implementations":{"abstract":[],"type":"topic","title":"Equatable Implementations","kind":"article","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDocument\/Equatable-Implementations","url":"\/documentation\/ivormxl\/mxldocument\/equatable-implementations","role":"collectionGroup"},"doc://IvorMXL/documentation/IvorMXL/MXLDocument/init(content:)":{"fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"content","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Content","preciseIdentifier":"s:7IvorMXL11MXLDocumentV7ContentO","kind":"typeIdentifier"},{"text":")","kind":"text"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxldocument\/init(content:)","title":"init(content:)","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDocument\/init(content:)","type":"topic","abstract":[{"text":"Creates a new document with the provided content.","type":"text"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLDocument":{"