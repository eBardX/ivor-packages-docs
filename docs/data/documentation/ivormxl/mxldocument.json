formation for each part in a score. Often, each MusicXML part"},{"type":"text","text":" "},{"type":"text","text":"corresponds to a track in a Standard MIDI Format 1 file. In this case, the midi-device element is used to make"},{"type":"text","text":" "},{"type":"text","text":"a MIDI device or port assignment for the given track or specific MIDI instruments. Initial midi-instrument"},{"type":"text","text":" "},{"type":"text","text":"assignments may be made here as well. The score-instrument elements are used when there are multiple"},{"type":"text","text":" "},{"type":"text","text":"instruments per track."}],"url":"\/documentation\/ivormxl\/mxlscorepart","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePart","role":"symbol"},"doc://IvorMXL/SH":{"title":"Swift.Hashable","identifier":"doc:\/\/IvorMXL\/SH","type":"unresolvable"},"doc://IvorMXL/s8SendableP":{"title":"Swift.Sendable","identifier":"doc:\/\/IvorMXL\/s8SendableP","type":"unresolvable"},"doc://IvorMXL/documentation/IvorMXL/MXLNormalizer/normalize(_:)":{"type":"topic","role":"symbol","title":"normalize(_:)","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNormalizer\/normalize(_:)","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"normalize"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"MXLDocument","preciseIdentifier":"s:7IvorMXL11MXLDocumentV"},{"text":") -> (","kind":"text"},{"kind":"typeIdentifier","text":"MXLDocument","preciseIdentifier":"s:7IvorMXL11MXLDocumentV"},{"text":", [","kind":"text"},{"kind":"typeIdentifier","text":"Change","preciseIdentifier":"s:7IvorMXL13MXLNormalizerV6ChangeO"},{"kind":"text","text":"])"}],"url":"\/documentation\/ivormxl\/mxlnormalizer\/normalize(_:)","abstract":[{"type":"text","text":"Returns a copy of the provided document normalized to the most recent"},{"type":"text","text":" "},{"type":"text","text":"supported MusicXML version, along with an array describing each change"},{"type":"text","text":" "},{"type":"text","text":"applied."}]},"doc://IvorMXL/documentation/IvorMXL/UsingIvorMXL":{"url":"\/documentation\/ivormxl\/usingivormxl","abstract":[{"type":"text","text":"Take a MusicXML document from "},{"code":"Data","type":"codeVoice"},{"type":"text","text":" to a validated syntax tree, and back to"},{"type":"text","text":" "},{"type":"codeVoice","code":"Data"},{"type":"text","text":"."}],"type":"topic","role":"article","kind":"article","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/UsingIvorMXL","title":"Using IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLDocument/content-swift.property":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDocument\/content-swift.property","url":"\/documentation\/ivormxl\/mxldocument\/content-swift.property","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"content","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Content","preciseIdentifier":"s:7IvorMXL11MXLDocumentV7ContentO","kind":"typeIdentifier"}],"abstract":[{"text":"The content of this document.","type":"text"}],"title":"content","type":"topic","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLDocument/Equatable-Implementations":{"title":"Equatable Implementations","url":"\/documentation\/ivormxl\/mxldocument\/equatable-implementations","role":"collectionGroup","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDocument\/Equatable-Implementations","type":"topic","kind":"article","abstract":[]},"doc://IvorMXL/documentation/IvorMXL/MXLOpus":{"title":"MXLOpus","url":"\/documentation\/ivormxl\/mxlopus","abstract":[{"type":"text","text":"The opus type is used for the root element of a MusicXML opus. Each opus is made up of a series of score,"},{"type":"text","text":" "},{"type":"text","text":"opus-link, and\/or nested opus elements. The document-attributes attribute group includes the version"},{"type":"text","text":" "},{"type":"text","text":