/ivormxl\/mxlpartname","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPartName"}]},"doc://IvorMXL/documentation/IvorMXL/MXLScorePartwise":{"url":"\/documentation\/ivormxl\/mxlscorepartwise","title":"MXLScorePartwise","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLScorePartwise"}],"navigatorTitle":[{"kind":"identifier","text":"MXLScorePartwise"}],"abstract":[{"type":"text","text":"The score-partwise element is the root element for a partwise MusicXML score. It includes a score-header group"},{"type":"text","text":" "},{"type":"text","text":"followed by a series of parts with measures inside. The document-attributes attribute group includes the"},{"type":"text","text":" "},{"type":"text","text":"version attribute."}],"kind":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePartwise"},"doc://IvorMXL/documentation/IvorMXL/MXLDocument/content-swift.property":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDocument\/content-swift.property","type":"topic","abstract":[{"text":"The content of this document.","type":"text"}],"kind":"symbol","title":"content","url":"\/documentation\/ivormxl\/mxldocument\/content-swift.property","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"content"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL11MXLDocumentV7ContentO","kind":"typeIdentifier","text":"Content"}]},"doc://IvorMXL/documentation/IvorMXL/MXLDocument/Version":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDocument\/Version","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Version"}],"abstract":[{"text":"A MusicXML version number.","type":"text"}],"title":"MXLDocument.Version","kind":"symbol","url":"\/documentation\/ivormxl\/mxldocument\/version","role":"symbol","fragments":[{"kin