"symbol","url":"\/documentation\/ivormxl\/mxlnormalizer\/normalize(_:)","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNormalizer\/normalize(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"normalize","kind":"identifier"},{"text":"(","kind":"text"},{"text":"MXLDocument","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLDocumentV"},{"text":") -> (","kind":"text"},{"text":"MXLDocument","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLDocumentV"},{"text":", [","kind":"text"},{"text":"Change","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL13MXLNormalizerV6ChangeO"},{"text":"])","kind":"text"}],"kind":"symbol","abstract":[{"type":"text","text":"Returns a copy of the provided document normalized to the most recent"},{"type":"text","text":" "},{"type":"text","text":"supported MusicXML version, along with an array describing each change"},{"type":"text","text":" "},{"type":"text","text":"applied."}],"type":"topic","title":"normalize(_:)"},"doc://IvorMXL/documentation/IvorMXL/MXLOpus":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlopus","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOpus","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLOpus"}],"abstract":[{"type":"text","text":"The opus type is used for the root element of a MusicXML opus. Each opus is made up of a series of score,"},{"type":"text","text":" "},{"type":"text","text":"opus-link, and\/or nested opus elements. The document-attributes attribute group includes the version"},{"type":"text","text":" "},{"type":"text","text":"attribute. Future versions may include more metadata elements. In this version, we just include the title of"},{"type":"text","text":" "},{"type":"text","text":"the opus."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLOpus"}],"title":"MXLOpus"},"doc://IvorMXL/documentation/IvorMXL/MXLDocument/Equatable-Implementations":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDocument\/Equatable-Implementations","kind":"article","title":"Equatable Implementations","type":"topic","url":"\/documentation\/ivormxl\/mxldocument\/equatable-implementations","abstract":[],"role":"collectionGroup"},"doc://IvorMXL/documentation/IvorMXL/MXLDocument/Version":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Version"}],"navigatorTitle":[{"text":"Version","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDocument\/Version","kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxldocument\/version","abstract":[{"text":"A MusicXML version number.","type":"text"}],"title":"MXLDocument.Version","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLDocument/init(content:)":{"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDocument\/init(content:)","title":"init(content:)","url":"\/documentation\/ivormxl\/mxldocument\/init(content:)","role":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"content"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Content","preciseIdentifier":"s:7IvorMXL11MXLDocumentV7ContentO"},{"kind":"text","text":")"}],"kind":"symbol","abstract":[{"type":"text","text":"Creates a new document with the provided content."}]},"doc://IvorMXL/documentation/IvorMXL/MXLPartList":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlpartlist","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartList","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPartList","kind":"identifier"}],"abstract":[{"text":"The part-list identifies the different musical parts in this document. Each part has an ID that is used later","type":"text"},{"text":" ","type":"text"},{"text":"within the musical data. Since parts may be encoded separately and combined later, identification elements are","type":"text"},{"text":" ","type":"text"},{"text":"present at both the score and score-part levels. There must be at least one score-part, combined as desired","type":"text"},{"text":" ","type":"text"},{"text":"with part-group elements that indicate braces and brackets. Parts are ordered from top to bottom in a score","type":"text"},{"text":" ","type":"text"},{"text":"based on the order in which they appear in the part-list.","type":"text"}],"kind":"symbol","type":"topic","navigatorTitle":[{"text":"MXLPartList","kind":"identifier"}],"title":"MXLPartList"},"doc://IvorMXL/documentation/IvorMXL/MXLScorePart":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlscorepart","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePart","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLScorePart","kind":"identifier"}],"abstract":[{"text":"The score-part type collects part-wide information for each part in a score. Often, each MusicXML part","type":"text"},{"text":" ","type":"text"},{"text":"corresponds to a track in a Standard MIDI Format 1 file. In this case, the midi-device element is used to make","type":"text"},{"text":" ","type":"text"},{"text":"a MIDI device or port assignment for the given track or specific MIDI instruments. Initial midi-instrument","type":"text"},{"text":" ","type":"text"},{"text":"assignments may be made here as well. The score-instrument elements are used when there are multiple","type":"text"},{"text":" ","type":"text"},{"text":"instruments per track.","type":"text"}],"kind":"symbol","type":"topic","navigatorTitle":[{"text":"MXLScorePart","kind":"identifier"}],"title":"MXLScorePart"},"doc://IvorMXL/s8SendableP":{"title":"Swift.Sendable","type":"unresolvable","identifier":"doc:\/\/IvorMXL\/s8SendableP"},"doc://IvorMXL/documentation/IvorMXL/MXLScoreTimewise":{"title":"MXLScoreTimewise","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text