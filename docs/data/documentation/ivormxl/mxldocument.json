nt has been validated by"},{"type":"text","text":" "},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValidator\/validate(_:)","isActive":true,"type":"reference"},{"type":"text","text":"."}],"role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"isValidated"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}],"url":"\/documentation\/ivormxl\/mxldocument\/isvalidated"},"doc://IvorMXL/documentation/IvorMXL/MXLScorePart":{"type":"topic","title":"MXLScorePart","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePart","abstract":[{"text":"The score-part type collects part-wide information for each part in a score. Often, each MusicXML part","type":"text"},{"text":" ","type":"text"},{"text":"corresponds to a track in a Standard MIDI Format 1 file. In this case, the midi-device element is used to make","type":"text"},{"text":" ","type":"text"},{"text":"a MIDI device or port assignment for the given track or specific MIDI instruments. Initial midi-instrument","type":"text"},{"text":" ","type":"text"},{"text":"assignments may be made here as well. The score-instrument elements are used when there are multiple","type":"text"},{"text":" ","type":"text"},{"text":"instruments per track.","type":"text"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLScorePart"}],"navigatorTitle":[{"kind":"identifier","text":"MXLScorePart"}],"url":"\/documentation\/ivormxl\/mxlscorepart"},"doc://IvorMXL/s8CopyableP":{"title":"Swift.Copyable","type":"unresolvable","identifier":"doc:\/\/IvorMXL\/s8CopyableP"},"doc://IvorMXL/documentation/IvorMXL/MXLDocument/Version":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML version number."}],"url":"\/documentation\/ivormxl\/mxldocument\/version","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":