{"seeAlsoSections":[{"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMusicItem","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFullNote","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRest","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPitch","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound"],"generated":true,"anchor":"Music","title":"Music"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLBarline","kind":"identifier"}],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Barlines have a location attribute to make it easier to process barlines independently of the other musical"},{"type":"text","text":" "},{"type":"text","text":"data in a score. It is often easier to set up measures separately from entering notes. The location attribute"},{"text":" ","type":"text"},{"type":"text","text":"must match where the barline element occurs within the rest of the musical data in the score. If location is"},{"type":"text","text":" "},{"type":"text","text":"left, it should be the first element in the measure, aside from the print, bookmark, and link elements. If"},{"type":"text","text":" "},{"type":"text","text":"location is right, it should be the last element, again with the possible exception of the print, bookmark,"},{"type":"text","text":" "},{"type":"text","text":"and link elements. If no location is specified, the right barline is the default. The segno, coda, and"},{"type":"text","text":" "},{"type":"text","text":"divisions attributes work the same way as in the sound element. They are used for playback when barline"},{"type":"text","text":" "},{"type":"text","text":"elements contain segno or coda child elements."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Maps the MusicXML "},{"type":"codeVoice","code":"<barline>"},{"type":"text","text":" element."}]}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"topicSections":[{"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/StyleColor"],"generated":true,"anchor":"Structures","title":"Structures"},{"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/init(id:barStyle:footnote:level:wavyLine:segno:coda:fermata:ending:repeat:location:segnoAttribute:codaAttribute:divisions:)"],"generated":true,"anchor":"Initializers","title":"Initializers"},{"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/barStyle","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/coda","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/codaAttribute","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/divisions","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/ending","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/fermata","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/footnote","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/id","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/level","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/location","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/repeat","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/segno","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/segnoAttribute","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/wavyLine"],"generated":true,"anchor":"Instance-Properties","title":"Instance Properties"},{"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/Equatable-Implementations"],"generated":true,"anchor":"Default-Implementations","title":"Default Implementations"}],"relationshipsSections":[{"kind":"relationships","title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/IvorMXL\/s8CopyableP","doc:\/\/IvorMXL\/SQ","doc:\/\/IvorMXL\/s9EscapableP","doc:\/\/IvorMXL\/SH","doc:\/\/IvorMXL\/s8SendableP","doc:\/\/IvorMXL\/s16SendableMetatypeP"]}],"variants":[{"paths":["\/documentation\/ivormxl\/mxlbarline"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL"]]},"abstract":[{"type":"text","text":"If a barline is other than a normal single barline, it should be represented by a barline type that describes"},{"type":"text","text":" "},{"type":"text","text":"it. This includes information about repeats and multiple endings, as well as line style. Barline data is on"},{"type":"text","text":" "},{"type":"text","text":"the same level as the other musical data in a score — a child of a measure in a partwise score, or a part in a"},{"type":"text","text":" "},{"type":"text","text":"timewise score. This allows for barlines within measures, as in dotted barlines that subdivide measures in"},{"type":"text","text":" "},{"type":"text","text":"complex meters. The two fermata elements allow for fermatas on both sides of the barline (the lower one"},{"type":"text","text":" "},{"type":"text","text":"inverted)."}],"metadata":{"modules":[{"name":"IvorMXL"}],"symbolKind":"struct","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLBarline","kind":"identifier"}],"title":"MXLBarline","navigatorTitle":[{"kind":"identifier","text":"MXLBarline"}],"externalID":"s:7IvorMXL10MXLBarlineV","roleHeading":"Structure"},"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline"},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLBarline/wavyLine":{"kind":"symbol","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/wavyLine","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"wavyLine"},{"kind":"text","text":": "},{"kind":"typeIdentifie