jumps to a coda"},{"type":"text","text":" "},{"type":"text","text":"sign for playback."}],"role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"codaAttribute"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?"}],"url":"\/documentation\/ivormxl\/mxlbarline\/codaattribute"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/wavyLine":{"title":"wavyLine","role":"symbol","url":"\/documentation\/ivormxl\/mxlbarline\/wavyline","abstract":[{"text":"A wavy line associated with the barline, such as for a trill or vibrato that continues across it.","type":"text"}],"type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"wavyLine","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL11MXLWavyLineV","text":"MXLWavyLine","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/wavyLine","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/segnoAttribute":{"role":"symbol","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Used the same way as the segno attribute of the sound element, to name and distinguish forward jumps to a"},{"type":"text","text":" "},{"type":"text","text":"segno sign for playback."}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"segnoAttribute"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/segnoAttribute","title":"segnoAttribute","url":"\/documentation\/ivormxl\/mxlbarline\/segnoattribute"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/level":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/level","role":"symbol","type":"topic","title":"level","kind":"symbol","url":"\/documentation\/ivormxl\/mxlbarline\/level","abstract":[{"type":"text","text":"The level element specifies editorial information for different MusicXML elements. It is defined within a"},{"type":"text","text":" "},{"type":"text","text":"group due to its multiple uses within the MusicXML schema."}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"level"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL8MXLLevelV","kind":"typeIdentifier","text":"MXLLevel"},{"kind":"text","text":"?"}]},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes":{"type":"topic","title":"MXLAttributes","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes","abstract":[{"text":"The attributes element contains musical information that typically changes on measure boundaries. This","type":"text"},{"text":" ","type":"text"},{"text":"includes key and time signatures, clefs, transpositions, and staving. When attributes are changed mid-measure,","type":"text"},{"text":" ","type":"text"},{"text":"it affects the music in score order, not in MusicXML document order.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLAttributes"}],"navigatorTitle":[{"kind":"identifier","text":"MXLAttributes"}],"url":"\/documentation\/ivormxl\/mxlattributes"},"doc://IvorMXL/s8CopyableP":{"type":"unresolvable","title":"Swift.Copyable","identifier":"doc:\/\/IvorMXL\/s8CopyableP"},"doc://IvorMXL/documentation/IvorMXL/MXLFullNote":{"title":"MXLFullNote","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFullNote"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlfullnote","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLFullNote"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFullNote","abstract":[{"text":"The full-note group is a sequence of the common note elements between cue\/grace notes and regular (full)","type":"text"},{"text":" ","type":"text"},{"text":"notes: pitch, chord, and rest information, but not duration (cue and grace notes do not have duration","type":"text"},{"text":" ","type":"text"},{"text":"encoded). Unpitched elements are used for unpitched percussion, speaking voice, and other musical elements","type":"text"},{"text":" ","type":"text"},{"text":"lacking determinate pitch.","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLSound":{"type":"topic","title":"MXLSound","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound","abstract":[{"type":"text","text":"The sound element contains general playback parameters. They can stand alone within a part\/measure, or be a"},{"type":"text","text":" "},{"type":"text","text":"component element within a direction."}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSound","kind":"identifier"}],"navigatorTitle":[{"text":"MXLSound","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlsound"},"doc://IvorMXL/documentation/IvorMXL/MXLRest":{"title":"MXLRest","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLRest","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"MXLRest","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlrest","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRest","abstract":[{"type":"text","text":"The rest element indicates notated rests or silences. Rest elements are usually empty, but placement on the"},{"type":"text","text":" "},{"text":"staff can be specified using display-step and display-octave elements. If the measure attribute is set to yes,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"this indicates this is a complete measure rest."}],"type":"topic","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/StyleColor":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"StyleColor"}],"abstract":[{"text":"The bar-style-color type contains barline style and color information.","type":"text"}],"title":"MXLBarline.StyleColor","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/StyleColor","role":"symbol","url":"\/documentation\/ivormxl\/mxlbarline\/stylecolor","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"StyleColor"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection":{"type":"topic","title":"MXLDirection","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection","abstract":[{"type":"text","text":"A direction is a musical indication that is not necessarily attached to a specific note. Two or more may be"},{"type":"text","text":" "},{"type":"text","text":"combined to indicate words followed by the start of a dashed line, the end of a wedge followed by dynamics,"},{"type":"text","text":" "},{"type":"text","text":"etc. For applications where a specific direction is indeed attached to a specific note, the direction element"},{"type":"text","text":" "},{"type":"text","text":"can be associated with the first note element that follows it in score order that is not in a different voice."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLDirection"}],"navigatorTitle":[{"kind":"identifier","text":"MXLDirection"}],"url":"\/documentation\/ivormxl\/mxldirection"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/segno":{"abstract":[{"type":"text","text":"The visual indicator of a segno sign appearing at this barline."}],"type":"topic","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"segno","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL8MXLSegnoV","text":"MXLSegno","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/segno","kind":"symbol","url":"\/documentation\/ivormxl\/mxlbarline\/segno","title":"segno"},"doc://IvorMXL/s16SendableMetatypeP":{"type":"unresolvable","title":"Swift.SendableMetatype","identifier":"doc:\/\/IvorMXL\/s16SendableMetatypeP"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/barStyle":{"role":"symbol","title":"barStyle","kind":"symbol","url":"\/documentation\/ivormxl\/mxlbarline\/barstyle","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/barStyle","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"barStyle"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"StyleColor","preciseIdentifier":"s:7IvorMXL10MXLBarlineV10StyleColorV"},{"kind":"text","text":"?"}],"abstract":[{"text":"The style and color of the barline.","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNote","kind":"identifier"}],"title":"MXLNote","abstract":[{"text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for","type":"text"},{"text":" ","type":"text"},{"text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation).","type":"text"},{"text":" ","type":"text"},{"text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,","type":"text"},{"text":" ","type":"text"},{"text":"but no tie elements. Having these two types of information available can make interchange easier, as some","type":"text"},{"text":" ","type":"text"},{"text":"programs handle one type of information more readily than the other.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","role":"symbol","url":"\/documentation\/ivormxl\/mxlnote","kind":"symbol","navigatorTitle":[{"text":"MXLNote","kind":"identifier"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/coda":{"role":"symbol","title":"coda","kind":"symbol","url":"\/documentation\/ivormxl\/mxlbarline\/coda","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/coda","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"coda"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLCoda","preciseIdentifier":"s:7IvorMXL7MXLCodaV"},{"kind":"text","text":"?"}],"abstract":[{"text":"The visual indicator of a coda sign appearing at this barline.","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/ending":{"abstract":[{"text":"The multiple-ending bracket associated with this barline.","type":"text"}],"kind":"symbol","title":"ending","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/ending","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"ending"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLEndingV","text":"MXLEnding"},{"kind":"text","text":"?"}],"role":"symbol","url":"\/documentation\/ivormxl\/mxlbarline\/ending"},"doc://IvorMXL/documentation/IvorMXL/MXLPitch":{"title":"MXLPitch","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPitch","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlpitch","role":"symbol","navigatorTitle":[{"text":"MXLPitch","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPitch","abstract":[{"type":"text","text":"Pitch is represented as a combination of the step of the diatonic scale, the chromatic alteration, and the"},{"type":"text","text":" "},{"type":"text","text":"octave."}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/id":{"kind":"symbol","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"id","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/id","type":"topic","abstract":[{"type":"text","text":"The optional-unique-id attribute group allows an element to optionally specify an ID that is unique to the"},{"type":"text","text":" "},{"type":"text","text":"entire document. This attribute group is not used for a required id attribute, or for an id attribute that"},{"type":"text","text":" "},{"type":"text","text":"specifies an id reference."}],"title":"id","url":"\/documentation\/ivormxl\/mxlbarline\/id"},"doc://IvorMXL/SH":{"type":"unresolvable","title":"Swift.Hashable","identifier":"doc:\/\/IvorMXL\/SH"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/repeat":{"role":"symbol","title":"repeat","kind":"symbol","url":"\/documentation\/ivormxl\/mxlbarline\/repeat","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/repeat","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"`repeat`"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLRepeat","preciseIdentifier":"s:7IvorMXL9MXLRepeatV"},{"kind":"text","text":"?"}],"abstract":[{"text":"The repeat mark associated with this barline.","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/Equatable-Implementations":{"role":"collectionGroup","title":"Equatable Implementations","kind":"article","url":"\/documentation\/ivormxl\/mxlbarline\/equatable-implementations","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/Equatable-Implementations","abstract":[],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/divisions":{"role":"symbol","title":"divisions","kind":"symbol","url":"\/documentation\/ivormxl\/mxlbarline\/divisions","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/divisions","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"divisions"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLDivisions","preciseIdentifier":"s:7IvorMXL12MXLDivisionsV"},{"kind":"text","text":"?"}],"abstract":[{"text":"Used the same way as the divisions attribute of the sound element, to indicate the number of divisions per","type":"text"},{"text":" ","type":"text"},{"text":"quarter note for playback when this barline contains a segno or coda child element.","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLMusicItem":{"type":"topic","title":"MXLMusicItem","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMusicItem","abstract":[{"type":"text","text":"One of the alternatives for a music item."}],"role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLMusicItem","kind":"identifier"}],"navigatorTitle":[{"text":"MXLMusicItem","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlmusicitem"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/footnote":{"title":"footnote","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"footnote","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLFormattedText","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL16MXLFormattedTextV"},{"text":"?","kind":"text"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlbarline\/footnote","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/footnote","abstract":[{"text":"The footnote element specifies editorial information that appears in footnotes in the printed score. It is","type":"text"},{"text":" ","type":"text"},{"text":"defined within a group due to its multiple uses within the MusicXML schema.","type":"text"}],"type":"topic"},"doc://IvorMXL/SQ":{"type":"unresolvable","title":"Swift.Equatable","identifier":"doc:\/\/IvorMXL\/SQ"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLBarline"}],"abstract":[{"text":"If a barline is other than a normal single barline, it should be represented by a barline type that describes","type":"text"},{"text":" ","type":"text"},{"text":"it. This includes information about repeats and multiple endings, as well as line style. Barline data is on","type":"text"},{"text":" ","type":"text"},{"text":"the same level as the other musical data in a score — a child of a measure in a partwise score, or a part in a","type":"text"},{"text":" ","type":"text"},{"text":"timewise score. This allows for barlines within measures, as in dotted barlines that subdivide measures in","type":"text"},{"text":" ","type":"text"},{"text":"complex meters. The two fermata elements allow for fermatas on both sides of the barline (the lower one","type":"text"},{"text":" ","type":"text"},{"text":"inverted).","type":"text"}],"title":"MXLBarline","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline","role":"symbol","url":"\/documentation\/ivormxl\/mxlbarline","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLBarline"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/fermata":{"title":"fermata","url":"\/documentation\/ivormxl\/mxlbarline\/fermata","role":"symbol","kind":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/fermata","abstract":[{"type":"text","text":"The fermata signs on either side of the barline, allowing fermatas on both sides (the lower one inverted)."}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"fermata"},