{"relationshipsSections":[{"identifiers":["doc:\/\/IvorMXL\/s8CopyableP","doc:\/\/IvorMXL\/SQ","doc:\/\/IvorMXL\/s9EscapableP","doc:\/\/IvorMXL\/SH","doc:\/\/IvorMXL\/s8SendableP","doc:\/\/IvorMXL\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships","title":"Conforms To"}],"seeAlsoSections":[{"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMusicItem","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFullNote","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRest","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPitch","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound"],"generated":true,"anchor":"Music","title":"Music"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"role":"symbol","title":"MXLBarline","roleHeading":"Structure","externalID":"s:7IvorMXL10MXLBarlineV","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"text":"MXLBarline","kind":"identifier"}],"modules":[{"name":"IvorMXL"}],"symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"MXLBarline"}]},"topicSections":[{"generated":true,"anchor":"Structures","title":"Structures","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/StyleColor"]},{"generated":true,"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/init(id:barStyle:footnote:level:wavyLine:segno:coda:fermata:ending:repeat:location:segnoAttribute:codaAttribute:divisions:)"]},{"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/barStyle","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/coda","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/codaAttribute","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/divisions","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/ending","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/fermata","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/footnote","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/id","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/level","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/location","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/repeat","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/segno","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/segnoAttribute","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/wavyLine"],"generated":true,"anchor":"Instance-Properties","title":"Instance Properties"},{"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/Equatable-Implementations"],"generated":true,"anchor":"Default-Implementations","title":"Default Implementations"}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL"]]},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"kind":"identifier","text":"MXLBarline"}],"languages":["swift"],"platforms":["macOS"]}]},{"content":[{"level":2,"anchor":"overview","text":"Overview","type":"heading"},{"inlineContent":[{"text":"Barlines have a location attribute to make it easier to process barlines independently of the other musical","type":"text"},{"text":" ","type":"text"},{"text":"data in a score. It is often easier to set up measures separately from entering notes. The location attribute","type":"text"},{"text":" ","type":"text"},{"text":"must match where the barline element occurs within the rest of the musical data in the score. If location is","type":"text"},{"text":" ","type":"text"},{"text":"left, it should be the first element in the measure, aside from the print, bookmark, and link elements. If","type":"text"},{"text":" ","type":"text"},{"text":"location is right, it should be the last element, again with the possible exception of the print, bookmark,","type":"text"},{"text":" ","type":"text"},{"text":"and link elements. If no location is specified, the right barline is the default. The segno, coda, and","type":"text"},{"type":"text","text":" "},{"type":"text","text":"divisions attributes work the same way as in the sound element. They are used for playback when barline"},{"type":"text","text":" "},{"type":"text","text":"elements contain segno or coda child elements."}],"type":"paragraph"},{"inlineContent":[{"text":"Maps the MusicXML ","type":"text"},{"code":"<barline>","type":"codeVoice"},{"text":" element.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"type":"text","text":"If a barline is other than a normal single barline, it should be represented by a barline type that describes"},{"text":" ","type":"text"},{"type":"text","text":"it. This includes information about repeats and multiple endings, as well as line style. Barline data is on"},{"text":" ","type":"text"},{"type":"text","text":"the same level as the other musical data in a score — a child of a measure in a partwise score, or a part in a"},{"text":" ","type":"text"},{"type":"text","text":"timewise score. This allows for barlines within measures, as in dotted barlines that subdivide measures in"},{"type":"text","text":" "},{"type":"text","text":"complex meters. The two fermata elements allow for fermatas on both sides of the barline (the lower one"},{"type":"text","text":" "},{"type":"text","text":"inverted)."}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline","interfaceLanguage":"swift"},"sections":[],"variants":[{"paths":["\/documentation\/ivormxl\/mxlbarline"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLAttributes":{"abstract":[{"text":"The attributes element contains musical information that typically changes on measure boundaries. This","type":"text"},{"text":" ","type":"text"},{"text":"includes key and time signatures, clefs, transpositions, and staving. When attributes are changed mid-measure,","type":"text"},{"text":" ","type":"text"},{"text":"it affects the music in score order, not in MusicXML document order.","type":"text"}],"title":"MXLAttributes","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLAttributes"}],"navigatorTitle":[{"kind":"identifier","text":"MXLAttributes"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlattributes","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes"},"doc://IvorMXL/SQ":{"title":"Swift.Equatable","identifier":"doc:\/\/IvorMXL\/SQ","type":"unresolvable"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/init(id:barStyle:footnote:level:wavyLine:segno:coda:fermata:ending:repeat:location:segnoAttribute:codaAttribute:divisions:)":{"kind":"symbol","url":"\/documentation\/ivormxl\/mxlbarline\/init(id:barstyle:footnote:level:wavyline:segno:coda:fermata:ending:repeat:location:segnoattribute:codaattribute:divisions:)","title":"init(id:barStyle:footnote:level:wavyLine:segno:coda:fermata:ending:repeat:location:segnoAttribute:codaAttribute:divisions:)","role":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"id"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"barStyle"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL10MXLBarlineV10StyleColorV","kind":"typeIdentifier","text":"StyleColor"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"footnote"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL16MXLFormattedTextV","kind":"typeIdentifier","text":"MXLFormattedText"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"level"},{"kind":"text","text":": "},{"text":"MXLLevel","preciseIdentifier":"s:7IvorMXL8MXLLevelV","kind":"typeIdentifier"},{"kind":"text","text":"?, "},{"text":"wavyLine","kind":"externalParam"},{"kind":"text","text":": "},{"text":"MXLWavyLine","preciseIdentifier":"s:7IvorMXL11MXLWavyLineV","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"segno","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLSegno","preciseIdentifier":"s:7IvorMXL8MXLSegnoV","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"coda","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLCoda","preciseIdentifier":"s:7IvorMXL7MXLCodaV","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"fermata","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"MXLFermata","preciseIdentifier":"s:7IvorMXL10MXLFermataV","kind":"typeIdentifier"},{"text":"], ","kind":"text"},{"text":"ending","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLEnding","preciseIdentifier":"s:7IvorMXL9MXLEndingV","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"repeat","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLRepeat","preciseIdentifier":"s:7IvorMXL9MXLRepeatV","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"location","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLRightLeftMiddle","preciseIdentifier":"s:7IvorMXL18MXLRightLeftMiddleO","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"segnoAttribute","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"codaAttribute","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"divisions","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLDivisions","preciseIdentifier":"s:7IvorMXL12MXLDivisionsV","kind":"typeIdentifier"},{"text":"?)","kind":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/init(id:barStyle:footnote:level:wavyLine:segno:coda:fermata:ending:repeat:location:segnoAttribute:codaAttribute:divisions:)","abstract":[{"text":"Creates a new ","type":"text"},{"code":"MXLBarline","type":"codeVoice"},{"text":".","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/segnoAttribute":{"kind":"symbol","title":"segnoAttribute","url":"\/documentation\/ivormxl\/mxlbarline\/segnoattribute","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"segnoAttribute","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/segnoAttribute","abstract":[{"text":"Used the same way as the segno attribute of the sound element, to name and distinguish forward jumps to a","type":"text"},{"text":" ","type":"text"},{"text":"segno sign for playback.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLFullNote":{"abstract":[{"text":"The full-note group is a sequence of the common note elements between cue\/grace notes and regular (full)","type":"text"},{"text":" ","type":"text"},{"text":"notes: pitch, chord, and rest information, but not duration (cue and grace notes do not have duration","type":"text"},{"text":" ","type":"text"},{"text":"encoded). Unpitched elements are used for unpitched percussion, speaking voice, and other musical elements","type":"text"},{"text":" ","type":"text"},{"text":"lacking determinate pitch.","type":"text"}],"title":"MXLFullNote","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFullNote"}],"navigatorTitle":[{"kind":"identifier","text":"MXLFullNote"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlfullnote","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFullNote"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/fermata":{"kind":"symbol","title":"fermata","url":"\/documentation\/ivormxl\/mxlbarline\/fermata","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"fermata","kind":"identifier"},{"text":": [","kind":"text"},{"text":"MXLFermata","preciseIdentifier":"s:7IvorMXL10MXLFermataV","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/fermata","abstract":[{"text":"The fermata signs on either side of the barline, allowing fermatas on both sides (the lower one inverted).","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLDirection":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection","title":"MXLDirection","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLDirection","kind":"identifier"}],"navigatorTitle":[{"text":"MXLDirection","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxldirection","abstract":[{"text":"A direction is a musical indication that is not necessarily attached to a specific note. Two or more may be","type":"text"},{"type":"text","text":" "},{"type":"text","text":"combined to indicate words followed by the start of a dashed line, the end of a wedge followed by dynamics,"},{"type":"text","text":" "},{"type":"text","text":"etc. For applications where a specific direction is indeed attached to a specific note, the direction element"},{"type":"text","text":" "},{"type":"text","text":"can be associated with the first note element that follows it in score order that is not in a different voice."}]},"doc://IvorMXL/SH":{"title":"Swift.Hashable","identifier":"doc:\/\/IvorMXL\/SH","type":"unresolvable"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/id":{"kind":"symbol","title":"id","url":"\/documentation\/ivormxl\/mxlbarline\/id","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"id","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/id","abstract":[{"text":"The optional-unique-id attribute group allows an element to optionally specify an ID that is unique to the","type":"text"},{"text":" ","type":"text"},{"text":"entire document. This attribute group is not used for a required id attribute, or for an id attribute that","type":"text"},{"text":" ","type":"text"},{"text":"specifies an id reference.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/coda":{"kind":"symbol","title":"coda","url":"\/documentation\/ivormxl\/mxlbarline\/coda","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"coda","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLCoda","preciseIdentifier":"s:7IvorMXL7MXLCodaV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/coda","abstract":[{"text":"The visual indicator of a coda sign appearing at this barline.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"navigatorTitle":[{"kind":"identifier","text":"MXLNote"}],"abstract":[{"text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for","type":"text"},{"text":" ","type":"text"},{"text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation).","type":"text"},{"text":" ","type":"text"},{"text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,","type":"text"},{"text":" ","type":"text"},{"text":"but no tie elements. Having these two types of information available can make interchange easier, as some","type":"text"},{"text":" ","type":"text"},{"text":"programs handle one type of information more readily than the other.","type":"text"}],"title":"MXLNote","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","kind":"symbol","url":"\/documentation\/ivormxl\/mxlnote","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNote"}],"role":"symbol"},"doc://IvorMXL/s9EscapableP":{"title":"Swift.Escapable","identifier":"doc:\/\/IvorMXL\/s9EscapableP","type":"unresolvable"},"doc://IvorMXL/s8SendableP":{"title":"Swift.Sendable","identifier":"doc:\/\/IvorMXL\/s8SendableP","type":"unresolvable"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/StyleColor":{"navigatorTitle":[{"text":"StyleColor","kind":"identifier"}],"abstract":[{"text":"The bar-style-color type contains barline style and color information.","type":"text"}],"title":"MXLBarline.StyleColor","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/StyleColor","kind":"symbol","url":"\/documentation\/ivormxl\/mxlbarline\/stylecolor","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"StyleColor","kind":"identifier"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/ending":{"kind":"symbol","title":"ending","url":"\/documentation\/ivormxl\/mxlbarline\/ending","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ending","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLEnding","preciseIdentifier":"s:7IvorMXL9MXLEndingV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/ending","abstract":[{"text":"The multiple-ending bracket associated with this barline.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/divisions":{"kind":"symbol","title":"divisions","url":"\/documentation\/ivormxl\/mxlbarline\/divisions","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"divisions","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLDivisions","preciseIdentifier":"s:7IvorMXL12MXLDivisionsV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/divisions","abstract":[{"text":"Used the same way as the divisions attribute of the sound element, to indicate the number of divisions per","type":"text"},{"text":" ","type":"text"},{"text":"quarter note for playback when this barline contains a segno or coda child element.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/footnote":{"kind":"symbol","title":"footnote","url":"\/documentation\/ivormxl\/mxlbarline\/footnote","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"footnote","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLFormattedText","preciseIdentifier":"s:7IvorMXL16MXLFormattedTextV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/footnote","abstract":[{"text":"The footnote element specifies editorial information that appears in footnotes in the printed score. It is","type":"text"},{"text":" ","type":"text"},{"text":"defined within a group due to its multiple uses within the MusicXML schema.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLMusicItem":{"abstract":[{"text":"One of the alternatives for a music item.","type":"text"}],"title":"MXLMusicItem","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLMusicItem"}],"navigatorTitle":[{"kind":"identifier","text":"MXLMusicItem"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlmusicitem","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMusicItem"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/wavyLine":{"kind":"symbol","title":"wavyLine","url":"\/documentation\/ivormxl\/mxlbarline\/wavyline","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"wavyLine","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLWavyLine","preciseIdentifier":"s:7IvorMXL11MXLWavyLineV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/wavyLine","abstract":[{"text":"A wavy line associated with the barline, such as for a trill or vibrato that continues across it.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/location":{"kind":"symbol","title":"location","url":"\/documentation\/ivormxl\/mxlbarline\/location","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"location","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLRightLeftMiddle","preciseIdentifier":"s:7IvorMXL18MXLRightLeftMiddleO","kind":"typeIdentifier"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/location","abstract":[{"text":"Defaults to ","type":"text"},{"code":"right","type":"codeVoice"},{"text":".","type":"text"}]},"doc://IvorMXL/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","identifier":"doc:\/\/IvorMXL\/s16SendableMetatypeP","type":"unresolvable"},"doc://IvorMXL/documentation/IvorMXL/MXLSound":{"abstract":[{"text":"The sound element contains general playback parameters. They can stand alone within a part\/measure, or be a","type":"text"},{"text":" ","type":"text"},{"text":"component element within a direction.","type":"text"}],"title":"MXLSound","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLSound"}],"navigatorTitle":[{"kind":"identifier","text":"MXLSound"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlsound","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound"},"doc://IvorMXL/documentation/IvorMXL/MXLRest":{"kind":"symbol","navigatorTitle":[{"text":"MXLRest","kind":"identifier"}],"title":"MXLRest","url":"\/documentation\/ivormxl\/mxlrest","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLRest","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRest","abstract":[{"text":"The rest element indicates notated rests or silences. Rest elements are usually empty, but placement on the","type":"text"},{"text":" ","type":"text"},{"text":"staff can be specified using display-step and display-octave elements. If the measure attribute is set to yes,","type":"text"},{"text":" ","type":"text"},{"text":"this indicates this is a complete measure rest.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/barStyle":{"kind":"symbol","title":"barStyle","url":"\/documentation\/ivormxl\/mxlbarline\/barstyle","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"barStyle","kind":"identifier"},{"text":": ","kind":"text"},{"text":"StyleColor","preciseIdentifier":"s:7IvorMXL10MXLBarlineV10StyleColorV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/barStyle","abstract":[{"text":"The style and color of the barline.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/codaAttribute":{"kind":"symbol","url":"\/documentation\/ivormxl\/mxlbarline\/codaattribute","title":"codaAttribute","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"codaAttribute"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"text":"?","kind":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/codaAttribute","abstract":[{"type":"text","text":"Used the same way as the coda attribute of the sound element, to name and distinguish forward jumps to a coda"},{"type":"text","text":" "},{"type":"text","text":"sign for playback."}]},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/repeat":{"kind":"symbol","title":"repeat","url":"\/documentation\/ivormxl\/mxlbarline\/repeat","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"`repeat`"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL9MXLRepeatV","kind":"typeIdentifier","text":"MXLRepeat"},{"kind":"text","text":"?"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/repeat","abstract":[{"type":"text","text":"The repeat mark associated with this barline."}]},"doc://IvorMXL/documentation/IvorMXL/MXLPitch":{"navigatorTitle":[{"text":"MXLPitch","kind":"identifier"}],"abstract":[{"type":"text","text":"Pitch is represented as a combination of the step of the diatonic scale, the chromatic alteration, and the"},{"type":"text","text":" "},{"type":"text","text":"octave."}],"title":"MXLPitch","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPitch","kind":"symbol","url":"\/documentation\/ivormxl\/mxlpitch","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPitch","kind":"identifier"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/Equatable-Implementations":{"kind":"article","title":"Equatable Implementations","url":"\/documentation\/ivormxl\/mxlbarline\/equatable-implementations","role":"collectionGroup","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/Equatable-Implementations","abstract":[]},"doc://IvorMXL/s8CopyableP":{"title":"Swift.Copyable","type":"unresolvable","identifier":"doc:\/\/IvorMXL\/s8CopyableP"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/segno":{"kind":"symbol","title":"segno","url":"\/documentation\/ivormxl\/mxlbarline\/segno","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"segno"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL8MXLSegnoV","kind":"typeIdentifier","text":"MXLSegno"},{"kind":"text","text":"?"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/segno","abstract":[{"type":"text","text":"The visual indicator of a segno sign appearing at this barline."}]},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/level":{"kind":"symbol","url":"\/documentation\/ivormxl\/mxlbarline\/level","title":"level","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"level"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL8MXLLevelV","kind":"typeIdentifier","text":"MXLLevel"},{"text":"?","kind":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/level","abstract":[{"type":"text","text":"The level element specifies editorial information for different MusicXML elements. It is defined within a"},{"type":"text","text":" "},{"type":"text","text":"group due to its multiple uses within the MusicXML schema."}]},"doc://IvorMXL/documentation/IvorMXL/MXLBarline":{"navigatorTitle":[{"text":"MXLBarline","kind":"identifier"}],"abstract":[{"text":"If a barline is other than a normal single barline, it should be represented by a barline type that describes","type":"text"},{"text":" ","type":"text"},{"text":"it. This includes information about repeats and multiple endings, as well as line style. Barline data is on","type":"text"},{"text":" ","type":"text"},{"text":"the same level as the other musical data in a score — a child of a measure in a partwise score, or a part in a","type":"text"},{"text":" ","type":"text"},{"text":"timewise score. This allows for barlines within measures, as in dotted barlines that subdivide measures in","type":"text"},{"text":" ","type":"text"},{"text":"complex meters. The two fermata elements allow for fermatas on both sides of the barline (the lower one","type":"text"},{"text":" ","type":"text"},{"text":"inverted).","type":"text"}],"title":"MXLBarline","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline","kind":"symbol","url":"\/documentation\/ivormxl\/mxlbarline","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLBarline","kind":"identifier"}],"role":"symbol"}}}