an stand alone within a part\/measure, or be a"},{"type":"text","text":" "},{"type":"text","text":"component element within a direction."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLSound"}],"title":"MXLSound"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/segnoAttribute":{"abstract":[{"text":"Used the same way as the segno attribute of the sound element, to name and distinguish forward jumps to a","type":"text"},{"text":" ","type":"text"},{"text":"segno sign for playback.","type":"text"}],"title":"segnoAttribute","url":"\/documentation\/ivormxl\/mxlbarline\/segnoattribute","kind":"symbol","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"segnoAttribute","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?","kind":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/segnoAttribute"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/barStyle":{"abstract":[{"text":"The style and color of the barline.","type":"text"}],"title":"barStyle","url":"\/documentation\/ivormxl\/mxlbarline\/barstyle","kind":"symbol","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"barStyle","kind":"identifier"},{"text":": ","kind":"text"},{"text":"StyleColor","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL10MXLBarlineV10StyleColorV"},{"text":"?","kind":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/barStyle"},"doc://IvorMXL/SQ":{"title":"Swift.Equatable","type":"unresolvable","identifier":"doc:\/\/IvorMXL\/SQ"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes":{"role":"symbol","navigatorTitle":[{"text":"MXLAttributes","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLAttributes","kind":"identifier"}],"kind":"symbol","title":"MXLAttributes","url":"\/documentation\/ivormxl\/mxlattributes","type":"topic","abstract":[{"text":"The attributes element contains musical information that typically changes on measure boundaries. This","type":"text"},{"text":" ","type":"text"},{"text":"includes key and time signatures, clefs, transpositions, and staving. When attributes are changed mid-measure,","type":"text"},{"text":" ","type":"text"},{"text":"it affects the music in score order, not in MusicXML document order.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/ending":{"abstract":[{"text":"The multiple-ending bracket associated with this barline.","type":"text"}],"title":"ending","url":"\/documentation\/ivormxl\/mxlbarline\/ending","kind":"symbol","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ending","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLEnding","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLEndingV"},{"text":"?","kind":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/ending"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/location":{"abstract":[{"text":"Defaults to ","type":"text"},{"code":"right","type":"codeVoice"},{"text":".","type":"text"}],"title":"location","url":"\/documentation\/ivormxl\/mxlbarline\/location","kind":"symbol","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"location","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLRightLeftMiddle","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL18MXLRightLeftMiddleO"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/location"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection":{"role":"symbol","url":"\/documentation\/ivormxl\/mxldirection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLDirection","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"A direction is a musical indication that is not necessarily attached to a specific note. Two or more may be","type":"text"},{"text":" ","type":"text"},{"text":"combined to indicate words followed by the start of a dashed line, the end of a wedge followed by dynamics,","type":"text"},{"text":" ","type":"text"},{"text":"etc. For applications where a specific direction is indeed attached to a specific note, the direction element","type":"text"},{"text":" ","type":"text"},{"text":"can be associated with the first note element that follows it in score order that is not in a different voice.","type":"text"}],"type":"topic","navigatorTitle":[{"text":"MXLDirection","kind":"identifier"}],"title":"MXLDirection"},"doc://IvorMXL/SH":{"title":"Swift.Hashable","type":"unresolvable","identifier":"doc:\/\/IvorMXL\/SH"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/repeat":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlbarline\/repeat","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/repeat","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"`repeat`","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL9MXLRepeatV","text":"MXLRepeat","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"abstract":[{"text":"The repeat mark associated with this barline.","type":"text"}],"kind":"symbol","type":"topic","title":"repeat"},"doc://IvorMXL/s8SendableP":{"title":"Swift.Sendable","type":"unresolvable","identifier":"doc:\/\/IvorMXL\/s8SendableP"},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"title":"MXLNote","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNote"}],"abstract":[{"type":"text","text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for"},{"type":"text","text":" "},{"type":"text","text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation)."},{"type":"text","text":" "},{"type":"text","text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,"},{"type":"text","text":" "},{"type":"text","text":"but no tie elements. Having these two types of information available can make interchange easier, as some"},{"type":"text","text":" "},{"type":"text","text":"programs handle one type of information more readily than the other."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLNote"}],"url":"\/documentation\/ivormxl\/mxlnote"},"doc://IvorMXL/documentation/IvorMXL/MXLMusicItem":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlmusicitem","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMusicItem","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLMusicItem"}],"abstract":[{"type":"text","text":"One of the alternatives for a music item."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLMusicItem"}],"title":"MXLMusicItem"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/wavyLine":{"abstract":[{"text":"A wavy line associated with the barline, such as for a trill or vibrato that continues across it.","type":"text"}],"title":"wavyLine","url":"\/documentation\/ivormxl\/mxlbarline\/wavyline","kind":"symbol","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"wavyLine","kind":"identifier"},{"text