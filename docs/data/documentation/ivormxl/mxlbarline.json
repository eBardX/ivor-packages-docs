{"topicSections":[{"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/StyleColor"],"generated":true,"title":"Structures","anchor":"Structures"},{"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/init(id:barStyle:footnote:level:wavyLine:segno:coda:fermata:ending:repeat:location:segnoAttribute:codaAttribute:divisions:)"],"generated":true,"title":"Initializers","anchor":"Initializers"},{"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/barStyle","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/coda","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/codaAttribute","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/divisions","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/ending","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/fermata","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/footnote","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/id","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/level","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/location","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/repeat","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/segno","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/segnoAttribute","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/wavyLine"],"generated":true,"title":"Instance Properties","anchor":"Instance-Properties"},{"anchor":"Default-Implementations","title":"Default Implementations","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/Equatable-Implementations"],"generated":true}],"variants":[{"paths":["\/documentation\/ivormxl\/mxlbarline"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"MXLBarline","kind":"identifier"}],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"text":"Barlines have a location attribute to make it easier to process barlines independently of the other musical","type":"text"},{"text":" ","type":"text"},{"text":"data in a score. It is often easier to set up measures separately from entering notes. The location attribute","type":"text"},{"text":" ","type":"text"},{"text":"must match where the barline element occurs within the rest of the musical data in the score. If location is","type":"text"},{"text":" ","type":"text"},{"text":"left, it should be the first element in the measure, aside from the print, bookmark, and link elements. If","type":"text"},{"text":" ","type":"text"},{"text":"location is right, it should be the last element, again with the possible exception of the print, bookmark,","type":"text"},{"text":" ","type":"text"},{"text":"and link elements. If no location is specified, the right barline is the default. The segno, coda, and","type":"text"},{"text":" ","type":"text"},{"text":"divisions attributes work the same way as in the sound element. They are used for playback when barline","type":"text"},{"text":" ","type":"text"},{"text":"elements contain segno or coda child elements.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Maps the MusicXML ","type":"text"},{"code":"<barline>","type":"codeVoice"},{"text":" element.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"sections":[],"relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/IvorMXL\/s8CopyableP","doc:\/\/IvorMXL\/SQ","doc:\/\/IvorMXL\/s9EscapableP","doc:\/\/IvorMXL\/SH","doc:\/\/IvorMXL\/s8SendableP","doc:\/\/IvorMXL\/s16SendableMetatypeP"],"type":"conformsTo"}],"seeAlsoSections":[{"title":"Music","generated":true,"anchor":"Music","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMusicItem","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFullNote","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRest","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPitch","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"text":"If a barline is other than a normal single barline, it should be represented by a barline type that describes","type":"text"},{"text":" ","type":"text"},{"text":"it. This includes information about repeats and multiple endings, as well as line style. Barline data is on","type":"text"},{"text":" ","type":"text"},{"text":"the same level as the other musical data in a score — a child of a measure in a partwise score, or a part in a","type":"text"},{"text":" ","type":"text"},{"text":"timewise score. This allows for barlines within measures, as in dotted barlines that subdivide measures in","type":"text"},{"text":" ","type":"text"},{"text":"complex meters. The two fermata elements allow for fermatas on both sides of the barline (the lower one","type":"text"},{"text":" ","type":"text"},{"text":"inverted).","type":"text"}],"metadata":{"title":"MXLBarline","symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"MXLBarline"}],"roleHeading":"Structure","modules":[{"name":"IvorMXL"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLBarline","kind":"identifier"}],"externalID":"s:7IvorMXL10MXLBarlineV","role":"symbol"},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL"]]},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLBarline/segnoAttribute":{"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"segnoAttribute"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/segnoAttribute","type":"topic","abstract":[{"type":"text","text":"Used the same way as the segno attribute of the sound element, to name and distinguish forward jumps to a"},{"type":"text","text":" "},{"type":"text","text":"segno sign for playback."}],"role":"symbol","title":"segnoAttribute","url":"\/documentation\/ivormxl\/mxlbarline\/segnoattribute"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes":{"title":"MXLAttributes","url":"\/documentation\/ivormxl\/mxlattributes","abstract":[{"type":"text","text":"The attributes element contains musical information that typically changes on measure boundaries. This"},{"type":"text","text":" "},{"type":"text","text":"includes key and time signatures, clefs, transpositions, and staving. When attributes are changed mid-measure,"},{"type":"text","text":" "},{"type":"text","text":"it affects the music in score order, not in MusicXML document order."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLAttributes","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"MXLAttributes","kind":"identifier"}],"type":"topic","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes"},"doc://IvorMXL/documentation/IvorMXL/MXLMusicItem":{"navigatorTitle":[{"text":"MXLMusicItem","kind":"identifier"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLMusicItem","kind":"identifier"}],"abstract":[{"type":"text","text":"One of the alternatives for a music item."}],"role":"symbol","url":"\/documentation\/ivormxl\/mxlmusicitem","type":"topic","title":"MXLMusicItem","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMusicItem","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/repeat":{"abstract":[{"text":"The repeat mark associated with this barline.","type":"text"}],"title":"repeat","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/repeat","url":"\/documentation\/ivormxl\/mxlbarline\/repeat","kind":"symbol","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"`repeat`"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL9MXLRepeatV","kind":"typeIdentifier","text":"MXLRepeat"},{"kind":"text","text":"?"}]},"doc://IvorMXL/documentation/IvorMXL/MXLBarline":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLBarline"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLBarline"}],"title":"MXLBarline","abstract":[{"type":"text","text":"If a barline is other than a normal single barline, it should be represented by a barline type that describes"},{"type":"text","text":" "},{"type":"text","text":"it. This includes information about repeats and multiple endings, as well as line style. Barline data is on"},{"type":"text","text":" "},{"type":"text","text":"the same level as the other musical data in a score — a child of a measure in a partwise score, or a part in a"},{"type":"text","text":" "},{"type":"text","text":"timewise score. This allows for barlines within measures, as in dotted barlines that subdivide measures in"},{"type":"text","text":" "},{"type":"text","text":"complex meters. The two fermata elements allow for fermatas on both sides of the barline (the lower one"},{"type":"text","text":" "},{"type":"text","text":"inverted)."}],"url":"\/documentation\/ivormxl\/mxlbarline"},"doc://IvorMXL/s9EscapableP":{"title":"Swift.Escapable","type":"unresolvable","identifier":"doc:\/\/IvorMXL\/s9EscapableP"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/id":{"title":"id","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/id","type":"topic","abstract":[{"text":"The optional-unique-id attribute group allows an element to optionally specify an ID that is unique to the","type":"text"},{"text":" ","type":"text"},{"text":"entire document. This attribute group is not used for a required id attribute, or for an id attribute that","type":"text"},{"text":" ","type":"text"},{"text":"specifies an id reference.","type":"text"}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"id"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlbarline\/id"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/codaAttribute":{"url":"\/documentation\/ivormxl\/mxlbarline\/codaattribute","kind":"symbol","title":"codaAttribute","abstract":[{"type":"text","text":"Used the same way as the coda attribute of the sound element, to name and distinguish forward jumps to a coda"},{"type":"text","text":" "},{"type":"text","text":"sign for playback."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/codaAttribute","type":"topic","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"codaAttribute"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?"}]},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/divisions":{"title":"divisions","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/divisions","type":"topic","abstract":[{"text":"Used the same way as the divisions attribute of the sound element, to indicate the number of divisions per","type":"text"},{"text":" ","type":"text"},{"text":"quarter note for playback when this barline contains a segno or coda child element.","type":"text"}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"divisions"},{"text":": ","kind":"text"},{"text":"MXLDivisions","preciseIdentifier":"s:7IvorMXL12MXLDivisionsV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlbarline\/divisions"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/location":{"abstract":[{"text":"Defaults to ","type":"text"},{"code":"right","type":"codeVoice"},{"text":".","type":"text"}],"type":"topic","title":"location","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"location","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLRightLeftMiddle","preciseIdentifier":"s:7IvorMXL18MXLRightLeftMiddleO","kind":"typeIdentifier"}],"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlbarline\/location","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/location"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/Equatable-Implementations":{"title":"Equatable Implementations","role":"collectionGroup","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/Equatable-Implementations","type":"topic","abstract":[],"kind":"article","url":"\/documentation\/ivormxl\/mxlbarline\/equatable-implementations"},"doc://IvorMXL/documentation/IvorMXL/MXLFullNote":{"url":"\/documentation\/ivormxl\/mxlfullnote","role":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFullNote","abstract":[{"type":"text","text":"The full-note group is a sequence of the common note elements between cue\/grace notes and regular (full)"},{"type":"text","text":" "},{"type":"text","text":"notes: pitch, chord, and rest information, but not duration (cue and grace notes do not have duration"},{"type":"text","text":" "},{"type":"text","text":"encoded). Unpitched elements are used for unpitched percussion, speaking voice, and other musical elements"},{"type":"text","text":" "},{"type":"text","text":"lacking determinate pitch."}],"title":"MXLFullNote","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLFullNote","kind":"identifier"}],"navigatorTitle":[{"text":"MXLFullNote","kind":"identifier"}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection":{"role":"symbol","url":"\/documentation\/ivormxl\/mxldirection","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLDirection","kind":"identifier"}],"navigatorTitle":[{"text":"MXLDirection","kind":"identifier"}],"abstract":[{"text":"A direction is a musical indication that is not necessarily attached to a specific note. Two or more may be","type":"text"},{"text":" ","type":"text"},{"text":"combined to indicate words followed by the start of a dashed line, the end of a wedge followed by dynamics,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"etc. For applications where a specific direction is indeed attached to a specific note, the direction element"},{"text":" ","type":"text"},{"type":"text","text":"can be associated with the first note element that follows it in score order that is not in a different voice."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection","title":"MXLDirection","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLRest":{"url":"\/documentation\/ivormxl\/mxlrest","role":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRest","abstract":[{"type":"text","text":"The rest element indicates notated rests or silences. Rest elements are usually empty, but placement on the"},{"type":"text","text":" "},{"type":"text","text":"staff can be specified using display-step and display-octave elements. If the measure attribute is set to yes,"},{"type":"text","text":" "},{"type":"text","text":"this indicates this is a complete measure rest."}],"title":"MXLRest","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLRest","kind":"identifier"}],"navigatorTitle":[{"text":"MXLRest","kind":"identifier"}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/barStyle":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/barStyle","abstract":[{"text":"The style and color of the barline.","type":"text"}],"title":"barStyle","type":"topic","kind":"symbol","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"barStyle","kind":"identifier"},{"text":": ","kind":"text"},{"text":"StyleColor","preciseIdentifier":"s:7IvorMXL10MXLBarlineV10StyleColorV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"url":"\/documentation\/ivormxl\/mxlbarline\/barstyle"},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlnote","title":"MXLNote","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNote","kind":"identifier"}],"navigatorTitle":[{"text":"MXLNote","kind":"identifier"}],"abstract":[{"type":"text","text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for"},{"type":"text","text":" "},{"type":"text","text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation)."},{"type":"text","text":" "},{"type":"text","text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,"},{"type":"text","text":" "},{"text":"but no tie elements. Having these two types of information available can make interchange easier, as some","type":"text"},{"type":"text","text":" "},{"type":"text","text":"programs handle one type of information more readily than the other."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/footnote":{"title":"footnote","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/footnote","type":"topic","abstract":[{"text":"The footnote element specifies editorial information that appears in footnotes in the printed score. It is","type":"text"},{"text":" ","type":"text"},{"text":"defined within a group due to its multiple uses within the MusicXML schema.","type":"text"}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"footnote"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLFormattedText","preciseIdentifier":"s:7IvorMXL16MXLFormattedTextV"},{"kind":"text","text":"?"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlbarline\/footnote"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/segno":{"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"text":"segno","kind":"identifier"},{"kind":"text","text":": "},{"text":"MXLSegno","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLSegnoV"},{"kind":"text","text":"?"}],"kind":"symbol","type":"topic","abstract":[{"text":"The visual indicator of a segno sign appearing at this barline.","type":"text"}],"role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/segno","title":"segno","url":"\/documentation\/ivormxl\/mxlbarline\/segno"},"doc://IvorMXL/documentation/IvorMXL/MXLSound":{"abstract":[{"type":"text","text":"The sound element contains general playback parameters. They can stand alone within a part\/measure, or be a"},{"type":"text","text":" "},{"type":"text","text":"component element within a direction."}],"title":"MXLSound","url":"\/documentation\/ivormxl\/mxlsound","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSound","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"MXLSound","kind":"identifier"}],"type":"topic","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound"},"doc://IvorMXL/SH":{"identifier":"doc:\/\/IvorMXL\/SH","title":"Swift.Hashable","type":"unresolvable"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/wavyLine":{"title":"wavyLine","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/wavyLine","type":"topic","abstract":[