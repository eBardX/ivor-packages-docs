reciseIdentifier":"s:7IvorMXL8MXLColorV","text":"MXLColor"},{"kind":"text","text":"?"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlslide\/color","kind":"symbol","title":"color","abstract":[{"type":"text","text":"The color attribute group indicates the color of an element."}]},"doc://IvorMXL/documentation/IvorMXL/MXLSlide":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSlide","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSlide","kind":"identifier"}],"title":"MXLSlide","abstract":[{"type":"text","text":"Glissando and slide types both indicate rapidly moving from one pitch to the other so that individual notes"},{"type":"text","text":" "},{"type":"text","text":"are not discerned. A slide is continuous between the two pitches and defaults to a solid line. The optional"},{"type":"text","text":" "},{"type":"text","text":"text for a slide is printed alongside the line."}],"navigatorTitle":[{"text":"MXLSlide","kind":"identifier"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlslide"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlcolor","title":"MXLColor","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"type":"text","text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is"},{"type":"text","text":" "},{"type":"text","text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor"}}}