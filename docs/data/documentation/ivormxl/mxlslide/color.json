{"abstract":[{"type":"text","text":"The color attribute group indicates the color of an element."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"color","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLColor","preciseIdentifier":"s:7IvorMXL8MXLColorV","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor"},{"text":"?","kind":"text"}]}]}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSlide"]]},"kind":"symbol","metadata":{"roleHeading":"Instance Property","title":"color","role":"symbol","externalID":"s:7IvorMXL8MXLSlideV5colorAA8MXLColorVSgvp","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"color","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLColor","preciseIdentifier":"s:7IvorMXL8MXLColorV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"modules":[{"name":"IvorMXL"}],"symbolKind":"property"},"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSlide\/color","interfaceLanguage":"swift"},"sections":[],"variants":[{"paths":["\/documentation\/ivormxl\/mxlslide\/color"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLSlide":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlslide","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSlide","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLSlide"}],"abstract":[{"text":"Glissando and slide types both indicate rapidly moving from one pitch to the other so that individual notes","type":"text"},{"text":" ","type":"text"},{"text":"are not discerned. A slide is continuous between the two pitches and defaults to a solid line. The optional","type":"text"},{"text":" ","type":"text"},{"text":"text for a slide is printed alongside the line.","type":"text"}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLSlide"}],"title":"MXLSlide"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"title":"MXLColor","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"abstract":[{"text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in","type":"text"},{"text":" ","type":"text"},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"url":"\/documentation\/ivormxl\/mxlcolor"},"doc://IvorMXL/documentation/IvorMXL/MXLSlide/color":{"abstract":[{"type":"text","text":"The color attribute group indicates the color of an element."}],"title":"color","url":"\/documentation\/ivormxl\/mxlslide\/color","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"color"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLColor","preciseIdentifier":"s:7IvorMXL8MXLColorV"},{"kind":"text","text":"?"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSlide\/color"}}}