ext":"color"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLColorV","text":"MXLColor"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"bendSound"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL12MXLBendSoundV","text":"MXLBendSound"},{"kind":"text","text":")"}]},"doc://IvorMXL/documentation/IvorMXL/MXLStartStop":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStartStop","navigatorTitle":[{"text":"MXLStartStop","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlstartstop","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLStartStop","kind":"identifier"}],"title":"MXLStartStop","abstract":[{"text":"The start-stop type is used for an attribute of musical elements that can either start or stop, such as","type":"text"},{"text":" ","type":"text"},{"text":"tuplets.","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLLineKind":{"type":"topic","title":"MXLLineKind","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLineKind","abstract":[{"text":"The line-type type distinguishes between solid, dashed, dotted, and wavy lines.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLLineKind"}],"navigatorTitle":[{"kind":"identifier","text":"MXLLineKind"}],"url":"\/documentation\/ivormxl\/mxllinekind"},"doc://IvorMXL/documentation/IvorMXL/MXLFont":{"type":"topic","title":"MXLFont","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","abstract":[{"type":"text","text":"The font attribute group gathers together attributes for determining the font within a credit or direction."},{"type":"text","text":" "},{"type":"text","text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of"},{"type":"text","text":" "},{"type":"text","text":"font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric"},{"type":"text","text":" "},{"type":"text","text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font"},{"type":"text","text":" "},{"type":"text","text":"vs. a music font."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFont"}],"navigatorTitle":[{"kind":"identifier","text":"MXLFont"}],"url":"\/documentation\/ivormxl\/mxlfont"},"doc://IvorMXL/documentation/IvorMXL/MXLTenths":{"type":"topic","abstract":[{"type":"text","text":"The tenths type is a number representing tenths of interline staff space (positive or negative). Both integer"},{"type":"text","text":" "},{"type":"text","text":"and decimal values are allowed, such as 5 for a half space and 2.5 for a quarter space. Interline space is"},{"type":"text","text":" "},{"type":"text","text":"measured from the middle of a staff line."}],"url":"\/documentation\/ivormxl\/mxltenths","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTenths"}],"kind":"symbol","title":"MXLTenths","navigatorTitle":[{"kind":"identifier","text":"MXLTenths"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLBendSound":{"url":"\/documentation\/ivormxl\/mxlbendsound","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBendSound","title":"MXLBendSound","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLBendSound","kind":"identifier"}],"abstract":[{"text":"The bend-sound type is used for bend and slide elements, and is similar to the trill-sound attribute group.","type":"text"},{"text":" ","type":"text"},{"text":"Here the beats element refers to the number of discrete elements (like MIDI pitch bends) used to represent a","type":"text"},{"text":" ","type":"text"},{"text":"continuous bend or slide. The first-beat indicates the percentage of the duration for starting a bend; the","type":"text"},{"text":" ","type":"text"},{"text":"last-beat the percentage for ending it. The default choices are:","type":"text"}],"role":"symbol","navigatorTitle":[{"text":"MXLBendSound","kind":"identifier"}],"type":"topic","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNumberLevel":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumberLevel","navigatorTitle":[{"kind":"identifier","text":"MXLNumberLevel"}],"url":"\/documentation\/ivormxl\/mxlnumberlevel","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNumberLevel"}],"title":"MXLNumberLevel","abstract":[{"text":"Slurs, tuplets, and many other features can be concurrent and overlap within a single musical part. The","type":"text"},{"text":" ","type":"text"},{"text":"number-level entity distinguishes up to 16 concurrent objects of the same type when the objects overlap in","type":"text"},{"text":" ","type":"text"},{"text":"MusicXML document order. Values greater than 6 are usually only needed for music with a large number of divisi","type":"text"},{"text":" ","type":"text"},{"text":"staves in a single part, or if there are more than 6 cross-staff arpeggios in a single measure. When a number-","type":"text"},{"text":" ","type":"text"},{"text":"level value is implied, the value is 1 by default.","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLSlide":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSlide","navigatorTitle":[{"text":"MXLSlide","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlslide","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSlide","kind":"identifier"}],"title":"MXLSlide","abstract":[{"text":"Glissando and slide types both indicate rapidly moving from one pitch to the other so that individual notes","type":"text"},{"text":" ","type":"text"},{"text":"are not discerned. A slide is continuous between the two pitches and defaults to a solid line. The optional","type":"text"},{"text":" ","type":"text"},{"text":"text for a slide is printed alongside the line.","type":"text"}],"type":"topic"}}}