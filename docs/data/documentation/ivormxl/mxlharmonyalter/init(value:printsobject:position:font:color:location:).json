ype":"text","text":"changed two ways."}],"url":"\/documentation\/ivormxl\/mxlposition","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPosition"}],"kind":"symbol","title":"MXLPosition","navigatorTitle":[{"kind":"identifier","text":"MXLPosition"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"type":"topic","abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"type":"text","text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is"},{"type":"text","text":" "},{"type":"text","text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF."}],"url":"\/documentation\/ivormxl\/mxlcolor","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"kind":"symbol","title":"MXLColor","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLLeftRight":{"title":"MXLLeftRight","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLLeftRight"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlleftright","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLLeftRight"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLeftRight","abstract":[{"type":"text","text":"The left-right type is used to indicate whether one element appears to the left or the right of another"},{"type":"text","text":" "},{"type":"text","text":"element."}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLHarmonyAlter":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLHarmonyAlter","kind":"identifier"}],"title":"MXLHarmonyAlter","abstract":[{"text":"The harmony-alter type represents the chromatic alteration of the root, numeral, or bass of the current","type":"text"},{"text":" ","type":"text"},{"text":"harmony-chord group within the harmony element. In some chord styles, the text of the preceding element may","type":"text"},{"text":" ","type":"text"},{"text":"include alteration information. In that case, the print-object attribute of this type can be set to no. The","type":"text"},{"text":" ","type":"text"},{"text":"location attribute indicates whether the alteration should appear to the left or the right of the preceding","type":"text"},{"text":" ","type":"text"},{"text":"element. Its default value varies by element.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmonyAlter","role":"symbol","url":"\/documentation\/ivormxl\/mxlharmonyalter","kind":"symbol","navigatorTitle":[{"text":"MXLHarmonyAlter","kind":"identifier"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLFont":{"type":"topic","title":"MXLFont","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","abstract":[{"type":"text","text":"The font attribute group gathers together attributes for determining the font within a credit or direction."},{"type":"text","text":" "},{"type":"text","text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of"},{"type":"text","text":" "},{"type":"text","text":"font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric"},{"type":"text","text":" "},{"type":"text","text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font"},{"type":"text","text":" "},{"type":"text","text":"vs. a music font."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFont"}],"navigatorTitle":[{"kind":"identifier","text":"MXLFont"}],"url":"\/documentation\/ivormxl\/mxlfont"}}}