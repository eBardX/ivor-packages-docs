t"}]}],"name":"position"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The font attribute group gathers together attributes for determining the font within","type":"text"},{"text":" ","type":"text"},{"text":"a credit or direction. They are based on the text styles for Cascading Style Sheets.","type":"text"},{"text":" ","type":"text"},{"text":"The font-family is a comma-separated list of font names. The font-style can be normal","type":"text"},{"text":" ","type":"text"},{"text":"or italic. The font-size can be one of the CSS sizes or a numeric point size. The","type":"text"},{"text":" ","type":"text"},{"text":"font-weight can be normal or bold. The default is application-dependent, but is a","type":"text"},{"text":" ","type":"text"},{"text":"text font vs. a music font.","type":"text"}]}],"name":"font"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The color attribute group indicates the color of an element.","type":"text"}]}],"name":"color"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Indicates whether the alteration should appear to the left or the right of the","type":"text"},{"text":" ","type":"text"},{"text":"preceding element.","type":"text"}]}],"name":"location"}],"kind":"parameters"}],"variants":[{"paths":["\/documentation\/ivormxl\/mxlharmonyalter\/init(value:printsobject:position:font:color:location:)"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmonyAlter\/init(value:printsObject:position:font:color:location:)","interfaceLanguage":"swift"},"abstract":[{"text":"Creates a new ","type":"text"},{"type":"codeVoice","code":"MXLHarmonyAlter"},{"text":".","type":"text"}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLHarmonyAlter/init(value:printsObject:position:font:color:location:)":{"fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"value","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","preciseId