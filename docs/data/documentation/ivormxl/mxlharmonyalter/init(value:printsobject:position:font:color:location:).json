XL\/MXLLeftRight"},{"text":"? = nil)","kind":"text"}]}]},{"parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The value of this element."}],"type":"paragraph"}],"name":"value"},{"content":[{"inlineContent":[{"text":"A Boolean value indicating whether to print an object (e.g. a note or a rest). Defaults to ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" if not specified.","type":"text"}],"type":"paragraph"}],"name":"printsObject"},{"content":[{"inlineContent":[{"text":"For most elements, any program will compute a default x and y position. The position attributes let this be changed two ways.","type":"text"}],"type":"paragraph"}],"name":"position"},{"content":[{"inlineContent":[{"text":"The font attribute group gathers together attributes for determining the font within a credit or direction. They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of font names.The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font vs. a music font.","type":"text"}],"type":"paragraph"}],"name":"font"},{"content":[{"inlineContent":[{"text":"The color attribute group indicates the color of an element.","type":"text"}],"type":"paragraph"}],"name":"color"},{"content":[{"inlineContent":[{"text":"Indicates whether the alteration should appear to the left or the right of the preceding element.","type":"text"}],"type":"paragraph"}],"name":"location"}],"kind":"parameters"}],"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmonyAlter"]]},"metadata":{"symbolKind":"init","title":"init(value:printsObject:position:font:color:location:)","roleHeading":"Initializer","role":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("}