ivormxl\/mxlrest","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRest","abstract":[{"type":"text","text":"The rest element indicates notated rests or silences. Rest elements are usually empty, but placement on the"},{"type":"text","text":" "},{"text":"staff can be specified using display-step and display-octave elements. If the measure attribute is set to yes,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"this indicates this is a complete measure rest."}],"type":"topic","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLMusicItem/Equatable-Implementations":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMusicItem\/Equatable-Implementations","role":"collectionGroup","title":"Equatable Implementations","type":"topic","kind":"article","url":"\/documentation\/ivormxl\/mxlmusicitem\/equatable-implementations","abstract":[]},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNote","kind":"identifier"}],"title":"MXLNote","abstract":[{"text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for","type":"text"},{"text":" ","type":"text"},{"text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation).","type":"text"},{"text":" ","type":"text"},{"text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,","type":"text"},{"text":" ","type":"text"},{"text":"but no tie elements. Having these two types of information available can make interchange easier, as some","type":"text"},{"text":" ","type":"text"},{"text":"programs handle one type of information more readily than the other.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","role":"symbol","url":"\/documentation\/ivormxl\/mxlnote","kind":"symbol","navigatorTitle":[{"text":"MXLNote","kind":"identifier"}],"type":"topic"},"doc://IvorMXL/s8CopyableP":{"title":"Swift.Copyable","type":"unresolvable","identifier":"doc:\/\/IvorMXL\/s8CopyableP"},"doc://IvorMXL/s9EscapableP":{"title":"Swift.Escapable","type":"unresolvable","identifier":"doc:\/\/IvorMXL\/s9EscapableP"},"doc://IvorMXL/documentation/IvorMXL/MXLMusicItem/grouping(_:)":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMusicItem\/grouping(_:)","role":"symbol","title":"MXLMusicItem.grouping(_:)","type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlmusicitem\/grouping(_:)","abstract":[{"type":"text","text":"The "},{"type":"codeVoice","code":"grouping"},{"type":"text","text":" alternative."}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"grouping"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"MXLGrouping","preciseIdentifier":"s:7IvorMXL11MXLGroupingV"},{"kind":"text","text":")"}]},"doc://IvorMXL/documentation/IvorMXL/MXLBarline":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLBarline"}],"abstract":[{"text":"If a barline is other than a normal single barline, it should be represented by a barline type that describes","type":"text"},{"text":" ","type":"text"},{"text":"it. This includes information about repeats and multiple endings, as well as line style. Barline data is on","type":"text"},{"text":" ","type":"text"},{"text":"the same level as the other musical data in a score — a child of a measure in a partwise score, or a part in a","type":"text"},{"text":" ","type":"text"},{"text":"timewise score. This allows for barlines within measures, as in dotted barlines that subdivide measures in","type":"text"},{"text":" ","type":"text"},{"text":"complex meters. The two fermata elements allow for fermatas on both sides of the barline (the lower one","type":"text"},{"text":" ","type":"text"},{"text":"inverted).","type":"text"}],"title":"MXLBarline","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline","role":"symbol","url":"\/documentation\/ivormxl\/mxlbarline","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLBarline"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLMusicItem/barline(_:)":{"type":"topic","title":"MXLMusicItem.barline(_:)","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMusicItem\/barline(_:)","abstract":[{"type":"text","text":"The "},{"code":"barline","type":"codeVoice"},{"type":"text","text":" alternative."}],"role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"barline","kind":"identifier"},{"text":"(","kind":"text"},{"text":"MXLBarline","preciseIdentifier":"s:7IvorMXL10MXLBarlineV","kind":"typeIdentifier"},{"text":")","kind":"text"}],"url":"\/documentation\/ivormxl\/mxlmusicitem\/barline(_:)"},"doc://IvorMXL/documentation/IvorMXL/MXLMusicItem/link(_:)":{"url":"\/documentation\/ivormxl\/mxlmusicitem\/link(_:)","kind":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"link"},{"kind":"text","text":"("},{"preciseIdentifier":"s:7IvorMXL7MXLLinkV","kind":"typeIdentifier","text":"MXLLink"},{"kind":"text","text":")"}],"title":"MXLMusicItem.link(_:)","abstract":[{"text":"The ","type":"text"},{"code":"link","type":"codeVoice"},{"type":"text","text":" alternative."}],"role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMusicItem\/link(_:)","type":"topic"},"doc://IvorMXL/s8SendableP":{"title":"Swift.Sendable","type":"unresolvable","identifier":"doc:\/\/IvorMXL\/s8SendableP"}}}