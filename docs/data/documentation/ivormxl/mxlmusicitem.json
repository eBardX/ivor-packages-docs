text","text":"includes key and time signatures, clefs, transpositions, and staving. When attributes are changed mid-measure,"},{"type":"text","text":" "},{"type":"text","text":"it affects the music in score order, not in MusicXML document order."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLAttributes","kind":"identifier"}],"navigatorTitle":[{"text":"MXLAttributes","kind":"identifier"}],"title":"MXLAttributes","kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlattributes","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes"},"doc://IvorMXL/documentation/IvorMXL/MXLMusicItem/attributes(_:)":{"abstract":[{"text":"The ","type":"text"},{"code":"attributes","type":"codeVoice"},{"text":" alternative.","type":"text"}],"role":"symbol","url":"\/documentation\/ivormxl\/mxlmusicitem\/attributes(_:)","kind":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"attributes","kind":"identifier"},{"text":"(","kind":"text"},{"text":"MXLAttributes","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL13MXLAttributesV"},{"text":")","kind":"text"}],"title":"MXLMusicItem.attributes(_:)","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMusicItem\/attributes(_:)","type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNote"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLNote"}],"url":"\/documentation\/ivormxl\/mxlnote","role":"symbol","title":"MXLNote","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","type":"topic","abstract":[{"type":"text","text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for"},{"type":"text","text":" "},{"type":"text","text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation)."},{"type":"text","text":" "},{"type":"text","text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,"},{"type":"text","text":" "},{"type":"text","text":"but no tie elements. Having these two types of information available can make interchange easier, as some"},{"type":"text","text":" "},{"type":"text","text":"programs handle one type of information more readily than the other."}]},"doc://IvorMXL/documentation/IvorMXL/MXLPitch":{"role":"symbol","abstract":[{"type":"text","text":"Pitch is represented as a combination of the step of the diatonic scale, the chromatic alteration, and the"},{"type":"text","text":" "},{"type":"text","text":"octave."}],"title":"MXLPitch","url":"\/documentation\/ivormxl\/mxlpitch","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPitch","navigatorTitle":[{"text":"MXLPitch","kind":"identifier"}],"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPitch"}]},"doc://IvorMXL/documentation/IvorMXL/MXLMusicItem/sound(_:)":{"title":"MXLMusicItem.sound(_:)","type":"topic","abstract":[{"type":"text","text":"The "},{"code":"sound","type":"codeVoice"},{"type":"text","text":" alternative."}],"role":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"sound"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"MXLSound","preciseIdentifier":"s:7IvorMXL8MXLSoundV"},{"kind":"text","text":")"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMusicItem\/sound(_:)","url":"\/documentation\/ivormxl\/mxlmusicitem\/sound(_:)"},"doc://IvorMXL/documentation/IvorMXL/MXLMusicItem/grouping(_:)":{"title":"MXLMusicItem.grouping(_:)","type":"topic","abstract":[{"type":"text","text":"The "},{"code":"grouping","type":"codeVoice"},{"type":"text","text":" alternative."}],"role":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kin