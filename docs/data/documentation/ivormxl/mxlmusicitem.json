mentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection","title":"MXLDirection","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLDirection","kind":"identifier"}],"navigatorTitle":[{"text":"MXLDirection","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxldirection","abstract":[{"text":"A direction is a musical indication that is not necessarily attached to a specific note. Two or more may be","type":"text"},{"type":"text","text":" "},{"type":"text","text":"combined to indicate words followed by the start of a dashed line, the end of a wedge followed by dynamics,"},{"type":"text","text":" "},{"type":"text","text":"etc. For applications where a specific direction is indeed attached to a specific note, the direction element"},{"type":"text","text":" "},{"type":"text","text":"can be associated with the first note element that follows it in score order that is not in a different voice."}]},"doc://IvorMXL/documentation/IvorMXL/MXLSound":{"abstract":[{"text":"The sound element contains general playback parameters. They can stand alone within a part\/measure, or be a","type":"text"},{"text":" ","type":"text"},{"text":"component element within a direction.","type":"text"}],"title":"MXLSound","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLSound"}],"navigatorTitle":[{"kind":"identifier","text":"MXLSound"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlsound","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound"},"doc://IvorMXL/documentation/IvorMXL/MXLMusicItem/sound(_:)":{"abstract":[{"text":"The ","type":"text"},{"code":"sound","type":"codeVoice"},{"text":" alternative.","type":"text"}],"title":"MXLMusicItem.sound(_:)","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMusicItem\/sound(_:)","kind":"symbol","url":"\/documentation\/ivormxl\/mxlmusicitem\/sound(_:)","type":"topic","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sound","kind":"identifier"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLSoundV","text":"MXLSound"},{"kind":"text","text":")"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes":{"abstract":[{"text":"The attributes element contains musical information that typically changes on measure boundaries. This","type":"text"},{"text":" ","type":"text"},{"text":"includes key and time signatures, clefs, transpositions, and staving. When attributes are changed mid-measure,","type":"text"},{"text":" ","type":"text"},{"text":"it affects the music in score order, not in MusicXML document order.","type":"text"}],"title":"MXLAttributes","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLAttributes"}],"navigatorTitle":[{"kind":"identifier","text":"MXLAttributes"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlattributes","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes"},"doc://IvorMXL/documentation/IvorMXL/MXLMusicItem/backup(_:)":{"title":"MXLMusicItem.backup(_:)","role":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"backup"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLBackupV","text":"MXLBackup"},{"kind":"text","text":")"}],"kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxlmusicitem\/backup(_:)","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMusicItem\/backup(_:)","abstract":[{"text":"The ","type":"text"},{"code":"backup","type":"codeVoice"},{"text":" alternative.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLBarline":{"navigatorTitle":[{"text":"MXLBarline","kind":"identifier"}],"abstract":[{"text":"If a barline is other than a normal single barline, it should be represented by a barline type that describes","type":"text"},{"text":" ","type":"text"},{"text":"it. This includes information about repeats and multiple endings, as well as line style. Barline data is on","type":"text"},{"text":" ","type":"text"},{"text":"the same level as the other musical data in a score — a child of a measure in a partwise score, or a part in a","type":"text"},{"text":" ","type":"text"},{"text":"timewise score. This allows for barlines within measures, as in dotted barlines that subdivide measures in","type":"text"},{"text":" ","type":"text"},{"text":"complex meters. The two fermata elements allow for fermatas on both sides of the barline (the lower one","type":"text"},{"text":" ","type":"text"},{"text":"inverted).","type":"text"}],"title":"MXLBarline","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline","kind":"symbol","url":"\/documentation\/ivormxl\/mxlbarline","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLBarline","kind":"identifier"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLMusicItem/harmony(_:)":{"title":"MXLMusicItem.harmony(_:)","role":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"harmony"},{"kind":"text","text":"("},{"preciseIdentifier":"s:7IvorMXL10MXLHarmonyV","kind":"typeIdentifier","text":"MXLHarmony"},{"kind":"text","text":")"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlmusicitem\/harmony(_:)","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMusicItem\/harmony(_:)","abstract":[{"text":"The ","type":"text"},{"code":"harmony","type":"codeVoice"},{"text":" alternative.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLMusicItem/note(_:)":{"abstract":[{"type":"text","text":"The "},{"type":"codeVoice","code":"note"},{"type":"text","text":" alternative."}],"title":"MXLMusicItem.note(_:)","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMusicItem\/note(_:)","kind":"symbol","url":"\/documentation\/ivormxl\/mxlmusicitem\/note(_:)","type":"topic","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"note","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:7IvorMXL7MXLNoteV","kind":"typeIdentifier","text":"MXLNote"},{"text":")","kind":"text"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLFullNote":{"abstract":[{"text":"The full-note group is a sequence of the common note elements between cue\/grace notes and regular (full)","type":"text"},{"text":" ","type":"text"},{"text":"notes: pitch, chord, and rest information, but not duration (cue and grace notes do not have duration","type":"text"},{"text":" ","type":"text"},{"text":"encoded). Unpitched elements are used for unpitched percussion, speaking voice, and other musical elements","type":"text"},{"text":" ","type":"text"},{"text":"lacking determinate pitch.","type":"text"}],"title":"MXLFullNote","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFullNote"}],"navigatorTitle":[{"kind":"identifier","text":"MXLFullNote"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlfullnote","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFullNote"},"doc://IvorMXL/documentation/IvorMXL/MXLMusicItem/direction(_:)":{"abstract":[{"type":"text","text":"The "},{"type":"codeVoice","code":"direction"},{"type":"text","text":" alternative."}],"title":"MXLMusicItem.direction(_:)","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"direction"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL12MXLDirectionV","text":"MXLDirection"},{"kind":"text","text":")"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlmusicitem\/direction(_:)","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMusicItem\/direction(_:)"},"doc://IvorMXL/documentation/IvorMXL/MXLRest":{"kind":"symbol","navigatorTitle":[{"text":"MXLRest","kind":"identifier"}],"title":"MXLRest","url":"\/documentation\/ivormxl\/mxlrest","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLRest","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRest","abstract":[{"text":"The rest element indicates notated rests or silences. Rest elements are usually empty, but placement on the","type":"text"},{"text":" ","type":"text"},{"text":"staff can be specified using display-step and display-octave elements. If the measure attribute is set to yes,","type":"text"},{"text":" ","type":"text"},{"text":"this indicates this is a complete measure rest.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"navigatorTitle":[{"kind":"identifier","text":"MXLNote"}],"abstract":[{"text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for","type":"text"},{"text":" ","type":"text"},{"text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation).","type":"text"},{"text":" ","type":"text"},{"text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,","type":"text"},{"text":" ","type":"text"},{"text":"but no tie elements. Having these two types of information available can make interchange easier, as some","type":"text"},{"text":" ","type":"text"},{"text":"programs handle one type of information more readily than the other.","type":"text"}],"title":"MXLNote","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","kind":"symbol","url":"\/documentation\/ivormxl\/mxlnote","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNote"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLMusicItem/listening(_:)":{"abstract":[{"type":"text","text":"The "},{"code":"listening","type":"codeVoice"},{"text":" alternative.","type":"text"}],"title":"MXLMusicItem.listening(_:)","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMusicItem\/listening(_:)","kind":"symbol","url":"\/documentation\/ivormxl\/mxlmusicitem\/listening(_:)","type":"topic","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"listening"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"MXLListening","preciseIdentifier":"s:7IvorMXL12MXLListeningV"},{"kind":"text","text":")"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLMusicItem/grouping(_:)":{"title":"MXLMusicItem.grouping(_:)","role":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"grouping"},{"kind":"text","text":"("},{"preciseIdentifier":"s:7IvorMXL11MXLGroupingV","kind":"typeIdentifier","text":"MXLGrouping"},{"kind":"text","text":")"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlmusicitem\/grouping(_:)","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMusicItem\/grouping(_:)","abstract":[{"text":"The ","type":"text"},{"code":"grouping","type":"codeVoice"},{"text":" alternative.","type":"text"}]}}}