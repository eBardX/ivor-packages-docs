XLDirection":{"role":"symbol","url":"\/documentation\/ivormxl\/mxldirection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLDirection","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"A direction is a musical indication that is not necessarily attached to a specific note. Two or more may be","type":"text"},{"text":" ","type":"text"},{"text":"combined to indicate words followed by the start of a dashed line, the end of a wedge followed by dynamics,","type":"text"},{"text":" ","type":"text"},{"text":"etc. For applications where a specific direction is indeed attached to a specific note, the direction element","type":"text"},{"text":" ","type":"text"},{"text":"can be associated with the first note element that follows it in score order that is not in a different voice.","type":"text"}],"type":"topic","navigatorTitle":[{"text":"MXLDirection","kind":"identifier"}],"title":"MXLDirection"},"doc://IvorMXL/documentation/IvorMXL/MXLMusicItem/harmony(_:)":{"role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"harmony","kind":"identifier"},{"text":"(","kind":"text"},{"text":"MXLHarmony","preciseIdentifier":"s:7IvorMXL10MXLHarmonyV","kind":"typeIdentifier"},{"text":")","kind":"text"}],"kind":"symbol","title":"MXLMusicItem.harmony(_:)","url":"\/documentation\/ivormxl\/mxlmusicitem\/harmony(_:)","type":"topic","abstract":[{"text":"The ","type":"text"},{"code":"harmony","type":"codeVoice"},{"text":" alternative.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMusicItem\/harmony(_:)"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentat