{"abstract":[{"type":"text","text":"The part-group element indicates groupings of parts in the score, usually indicated by braces and brackets."},{"type":"text","text":" "},{"type":"text","text":"Braces that are used for multi-staff parts should be defined in the attributes element for that part. The"},{"type":"text","text":" "},{"type":"text","text":"part-group start element appears before the first score-part in the group. The part-group stop element appears"},{"type":"text","text":" "},{"type":"text","text":"after the last score-part in the group."}],"topicSections":[{"title":"Initializers","anchor":"Initializers","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartGroup\/init(name:nameDisplay:abbreviation:abbreviationDisplay:symbol:barline:stretchesTimeSignature:footnote:level:kind:number:)"],"generated":true},{"title":"Instance Properties","anchor":"Instance-Properties","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartGroup\/abbreviation","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartGroup\/abbreviationDisplay","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartGroup\/barline","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartGroup\/footnote","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartGroup\/kind","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartGroup\/level","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartGroup\/name","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartGroup\/nameDisplay","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartGroup\/number","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartGroup\/stretchesTimeSignature","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartGroup\/symbol"],"generated":true},{"title":"Default Implementations","anchor":"Default-Implementations","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartGroup\/Equatable-Implementations"],"generated":true}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"