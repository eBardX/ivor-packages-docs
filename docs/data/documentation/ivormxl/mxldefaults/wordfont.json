tion/IvorMXL/MXLDefaults":{"navigatorTitle":[{"text":"MXLDefaults","kind":"identifier"}],"abstract":[{"text":"The defaults type specifies score-wide defaults for scaling; whether or not the file is a concert score;","type":"text"},{"text":" ","type":"text"},{"text":"layout; and default values for the music font, word font, lyric font, and lyric language. Except for the","type":"text"},{"text":" ","type":"text"},{"text":"concert-score element, if any defaults are missing, the choice of what to use is determined by the","type":"text"},{"text":" ","type":"text"},{"text":"application.","type":"text"}],"title":"MXLDefaults","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDefaults","kind":"symbol","url":"\/documentation\/ivormxl\/mxldefaults","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLDefaults","kind":"identifier"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLFont":{"navigatorTitle":[{"text":"MXLFont","kind":"identifier"}],"abstract":[{"text":"The font attribute group gathers together attributes for determining the font within a credit or direction.","type":"text"},{"text":" ","type":"text"},{"text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of","type":"text"},{"text":" ","type":"text"},{"text":"font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric","type":"text"},{"text":" ","type":"text"},{"text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font","type":"text"},{"text":" ","type":"text"},{"text":"vs. a music font.","type":"text"}],"title":"MXLFont","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","kind":"symbol","url":"\/documentation\/ivormxl\/mxlfont","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLFont","kind":"identifier"}],"role":"symbol"},"doc:/