[{"type":"text","text":"The lyric-language type specifies the default language for a particular name and number of lyric."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLLyricLanguage"}]},"doc://IvorMXL/documentation/IvorMXL/MXLLayout":{"navigatorTitle":[{"kind":"identifier","text":"MXLLayout"}],"abstract":[{"text":"The layout group specifies the sequence of page, system, and staff layout elements that is common to both the","type":"text"},{"text":" ","type":"text"},{"text":"defaults and print elements.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLayout","url":"\/documentation\/ivormxl\/mxllayout","role":"symbol","title":"MXLLayout","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLLayout"}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLLyricFont":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyricFont","navigatorTitle":[{"text":"MXLLyricFont","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxllyricfont","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLLyricFont","kind":"identifier"}],"title":"MXLLyricFont","abstract":[{"type":"text","text":"The lyric-font type specifies the default font for a particular name and number of lyric."}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLFont":{"type":"topic","title":"MXLFont","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","abstract":[{"type":"text","text":"The font attribute group gathers together attributes for determining the font within a credit or direction."},{"type":"text","text":" "},{"type":"text","text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of"},{"type":"text","text":" "},{"type":"text","text":"font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric"},{"type":"text","text":" "},{"type":"text","text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font"},{"type":"text","text":" "},{"type":"text","text":"vs. a music font."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFont"}],"navigatorTitle":[{"kind":"identifier","text":"MXLFont"}],"url":"\/documentation\/ivormxl\/mxlfont"},"doc://IvorMXL/documentation/IvorMXL/MXLAppearance":{"url":"\/documentation\/ivormxl\/mxlappearance","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAppearance","title":"MXLAppearance","abstract":[{"text":"The appearance type controls general graphical settings for the music’s final form appearance on a printed","type":"text"},{"text":" ","type":"text"},{"text":"page of display. This includes support for line widths, definitions for note sizes, and standard distances","type":"text"},{"text":" ","type":"text"},{"text":"between notation elements, plus an extension element for other aspects of appearance.","type":"text"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLAppearance"}],"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLAppearance"}]},"doc://IvorMXL/documentation/IvorMXL/MXLScaling":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScaling","navigatorTitle":[{"text":"MXLScaling","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlscaling","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLScaling","kind":"identifier"}],"title":"MXLScaling","abstract":[{"text":"Margins, page sizes, and distances are all measured in tenths to keep MusicXML data in a consistent coordinate","type":"text"},{"text":" ","type":"text"},{"text":"system as much as possible. The translation to absolute units is done with the scaling type, which specifies","type":"text"},{"text":" ","type":"text"},{"text":"how many millimeters are equal to how many tenths. For a staff height of 7 mm, millimeters would be set to 7","type":"text"},{"text":" ","type":"text"},{"text":"while tenths is set to 40. The ability to set a formula rather than a single scaling factor helps avoid","type":"text"},{"text":" ","type":"text"},{"text":"roundoff errors.","type":"text"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLDefaults/init(scaling:isConcertScore:layout:appearance:musicFont:wordFont:lyricFont:lyricLanguage:)":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDefaults\/init(scaling:isConcertScore:layout:appearance:musicFont:wordFont:lyricFont:lyricLanguage:)","type":"topic","url":"\/documentation\/ivormxl\/mxldefaults\/init(scaling:isconcertscore:layout:appearance:musicfont:wordfont:lyricfont:lyriclanguage:)","kind":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"scaling","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLScaling","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL10MXLScalingV"},{"text":"?, ","kind":"text"},{"text":"isConcertScore","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":", ","kind":"text"},{"text":"layout","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLLayout","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLLayoutV"},{"text":", ","kind":"text"},{"text":"appearance","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLAppearance","kind":"typeIdentifi