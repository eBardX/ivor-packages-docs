MXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLLyricFont":{"role":"symbol","url":"\/documentation\/ivormxl\/mxllyricfont","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyricFont","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLLyricFont","kind":"identifier"}],"kind":"symbol","abstract":[{"type":"text","text":"The lyric-font type specifies the default font for a particular name and number of lyric."}],"type":"topic","navigatorTitle":[{"text":"MXLLyricFont","kind":"identifier"}],"title":"MXLLyricFont"},"doc://IvorMXL/documentation/IvorMXL/MXLLayout":{"role":"symbol","url":"\/documentation\/ivormxl\/mxllayout","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLayout","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLLayout","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"The layout group specifies the sequence of page, system, and staff layout elements that is common to both the","type":"text"},{"text":" ","type":"text"},{"text":"defaults and print elements.","type":"text"}],"type":"topic","navigatorTitle":[{"text":"MXLLayout","kind":"identifier"}],"title":"MXLLayout"},"doc://IvorMXL/documentation/IvorMXL/MXLAppearance":{"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAppearance","title":"MXLAppearance","navigatorTitle":[{"text":"MXLAppearance","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLAppearance","kind":"identifier"}],"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlappearance","abstract":[{"text":"The appearance type controls general graphical settings for the music’s final form appearance on a printed","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"page of display. This includes support for line widths, definitions for note sizes, and standard distances"},{"type":"text","text":" "},{"type":"text","text":"between notation elements, plus an extension element for other aspects of appearance."}]},"doc://IvorMXL/documentation/IvorMXL/MXLLyricLanguage":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLLyricLanguage","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"MXLLyricLanguage","kind":"identifier"}],"abstract":[{"text":"The lyric-language type specifies the default language for a particular name and number of lyric.","type":"text"}],"url":"\/documentation\/ivormxl\/mxllyriclanguage","title":"MXLLyricLanguage","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyricLanguage","kind":"symbol"}}}