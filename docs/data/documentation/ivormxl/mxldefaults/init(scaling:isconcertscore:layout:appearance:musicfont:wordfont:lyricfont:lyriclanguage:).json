 group specifies the sequence of page, system, and staff layout elements that is common to both the"},{"type":"text","text":" "},{"type":"text","text":"defaults and print elements."}],"title":"MXLLayout","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLLayout"}],"navigatorTitle":[{"kind":"identifier","text":"MXLLayout"}],"type":"topic","url":"\/documentation\/ivormxl\/mxllayout","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLayout"},"doc://IvorMXL/documentation/IvorMXL/MXLLyricLanguage":{"abstract":[{"type":"text","text":"The lyric-language type specifies the default language for a particular name and number of lyric."}],"title":"MXLLyricLanguage","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLLyricLanguage","kind":"identifier"}],"navigatorTitle":[{"text":"MXLLyricLanguage","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxllyriclanguage","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyricLanguage"},"doc://IvorMXL/documentation/IvorMXL/MXLLyricFont":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyricFont","title":"MXLLyricFont","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLLyricFont","kind":"identifier"}],"navigatorTitle":[{"text":"MXLLyricFont","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxllyricfont","abstract":[{"text":"The lyric-font type specifies the default font for a particular name and number of lyric.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLDefaults":{"navigatorTitle":[{"text":"MXLDefaults","kind":"identifier"}],"abstract":[{"text":"The defaults type specifies score-wide defaults for scaling; whether or not the file is a concert score;","type":"text"},{"text":" ","type":"text"},{"text":"layout; and default values for the music font, word font, lyric font, and lyric language. Except for the","type":"text"},{"text":" ","type":"text"},{"text":"concert-score element, if any defaults are missing, the choice of what to use is determined by the","type":"text"},{"text":" ","type":"text"},{"text":"application.","type":"text"}],"title":"MXLDefaults","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDefaults","kind":"symbol","url":"\/documentation\/ivormxl\/mxldefaults","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLDefaults","kind":"identifier"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLAppearance":{"abstract":[{"type":"text","text":"The appearance type controls general graphical settings for the music’s final form appearance on a printed"},{"type":"text","text":" "},{"type":"text","text":"page of display. This includes support for line widths, definitions for note sizes, and standard distances"},{"type":"text","text":" "},{"type":"text","text":"between notation elements, plus an extension element for other aspects of appearance."}],"title":"MXLAppearance","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLAppearance"}],"navigatorTitle":[{"kind":"identifier","text":"MXLAppearance"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlappearance","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAppearance"},"doc://IvorMXL/documentation/IvorMXL/MXLDefaults/init(scaling:isConcertScore:layout:appearance:musicFont:wordFont:lyricFont:lyricLanguage:)":{"url":"\/documentation\/ivormxl\/mxldefaults\/init(scaling:isconcertscore:layout:appearance:musicfont:wordfont:lyricfont:lyriclanguage:)","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDefaults\/init(scaling:isConcertScore:layout:appearance:musicFont:wordFont:lyricFont:lyricLanguage:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"scaling","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLScaling","preciseIdentifier":"s:7IvorMXL10MXLScalingV","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"isConcertScore","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"layout","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLLayout","preciseIdentifier":"s:7IvorMXL9MXLLayoutV","kind":"typeIdentifier"},{"kind":"text","text":", "},{"kind":"externalParam","text":"appearance"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL13MXLAppearanceV","text":"MXLAppearance"},{"text":"?, ","kind":"text"},{"text":"musicFont","kind":"externalParam"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL7MXLFontV","text":"MXLFont"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"wordFont"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL7MXLFontV","text":"MXLFont"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"lyricFont"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL12MXLLyricFontV","text":"MXLLyricFont"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"lyricLanguage"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL16MXLLyricLanguageV","text":"MXLLyricLanguage"},{"kind":"text","text":"])"}],"abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLDefaults"},{"type":"text","text":"."}],"title":"init(scaling:isConcertScore:layout:appearance:musicFont:wordFont:lyricFont:lyricLanguage:)","type":"topic","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLScaling":{"abstract":[{"type":"text","text":"Margins, page sizes, and distances are all measured in tenths to keep MusicXML data in a consistent coordinate"},{"text":" ","type":"text"},{"type":"text","text":"system as much as possible. The translation to absolute units is done with the scaling type, which specifies"},{"text":" ","type":"text"},{"text":"how many millimeters are equal to how many tenths. For a staff height of 7 mm, millimeters would be set to 7","type":"text"},{"text":" ","type":"text"},{"text":"while tenths is set to 40. The ability to set a formula rather than a single scaling factor helps avoid","type":"text"},{"text":" ","type":"text"},{"text":"roundoff errors.","type":"text"}],"title":"MXLScaling","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLScaling","kind":"identifier"}],"navigatorTitle":[{"text":"MXLScaling","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlscaling","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScaling"}}}