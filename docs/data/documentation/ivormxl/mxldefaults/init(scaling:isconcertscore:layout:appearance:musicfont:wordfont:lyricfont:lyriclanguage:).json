7IvorMXL9MXLLayoutV"},{"text":", ","kind":"text"},{"text":"appearance","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLAppearance","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL13MXLAppearanceV"},{"text":"?, ","kind":"text"},{"text":"musicFont","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL7MXLFontV","text":"MXLFont","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"wordFont","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL7MXLFontV","text":"MXLFont","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"lyricFont","kind":"externalParam"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:7IvorMXL12MXLLyricFontV","text":"MXLLyricFont","kind":"typeIdentifier"},{"text":"], ","kind":"text"},{"text":"lyricLanguage","kind":"externalParam"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:7IvorMXL16MXLLyricLanguageV","text":"MXLLyricLanguage","kind":"typeIdentifier"},{"text":"])","kind":"text"}],"title":"init(scaling:isConcertScore:layout:appearance:musicFont:wordFont:lyricFont:lyricLanguage:)","url":"\/documentation\/ivormxl\/mxldefaults\/init(scaling:isconcertscore:layout:appearance:musicfont:wordfont:lyricfont:lyriclanguage:)","kind":"symbol","type":"topic","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDefaults\/init(scaling:isConcertScore:layout:appearance:musicFont:wordFont:lyricFont:lyricLanguage:)"},"doc://IvorMXL/documentation/IvorMXL/MXLFont":{"title":"MXLFont","url":"\/documentation\/ivormxl\/mxlfont","role":"symbol","navigatorTitle":[{"text":"MXLFont","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","abstract":[{"text":"The font attribute group gathers together attributes for determining the font within a credit or direction.","type":"text"},{"text":" ","type":"text"},{"text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric"},{"type":"text","text":" "},{"type":"text","text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font"},{"type":"text","text":" "},{"type":"text","text":"vs. a music font."}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLFont","kind":"identifier"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLAppearance":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAppearance","abstract":[{"type":"text","text":"The appearance type controls general graphical settings for the music’s final form appearance on a printed"},{"type":"text","text":" "},{"type":"text","text":"page of display. This includes support for line widths, definitions for note sizes, and standard distances"},{"type":"text","text":" "},{"type":"text","text":"between notation elements, plus an extension element for other aspects of appearance."}],"title":"MXLAppearance","navigatorTitle":[{"text":"MXLAppearance","kind":"identifier"}],"kind":"symbol","type":"topic","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLAppearance","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlappearance"},"doc://IvorMXL/documentation/IvorMXL/MXLDefaults":{"navigatorTitle":[{"text":"MXLDefaults","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLDefaults","kind":"identifier"}],"abstract":[{"type":"text","text":"The defaults type specifies score-wide defaults for scaling; whether or not the file is a concert score;"},{"type":"text","text":" "},{"type":"text","text":"layout; and default values for the music font, word font, lyric font, and lyric language. Except for the"},{"type":"text","text":" "},{"type":"text","text":"concert-score element, if any defaults are missing, the choice of what to use is determined by the"},{"type":"text","text":" "},{"type":"text","text":"application."}],"role":"symbol","url":"\/documentation\/ivormxl\/mxldefaults","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDefaults","title":"MXLDefaults","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLScaling":{"abstract":[{"type":"text","text":"Margins, page sizes, and distances are all measured in tenths to keep MusicXML data in a consistent coordinate"},{"type":"text","text":" "},{"type":"text","text":"system as much as possible. The translation to absolute units is done with the scaling type, which specifies"},{"type":"text","text":" "},{"type":"text","text":"how many millimeters are equal to how many tenths. For a staff height of 7 mm, millimeters would be set to 7"},{"type":"text","text":" "},{"type":"text","text":"while tenths is set to 40. The ability to set a formula rather than a single scaling factor helps avoid"},{"type":"text","text":" "},{"type":"text","text":"roundoff errors."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLScaling","kind":"identifier"}],"title":"MXLScaling","role":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLScaling"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlscaling","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScaling"},"doc://IvorMXL/documentation/IvorMXL/MXLLyricFont":{"navigatorTitle":[{"text":"MXLLyricFont","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLLyricFont","kind":"identifier"}],"abstract":[{"type":"text","text":"The lyric-font type specifies the default font for a particular name and number of lyric."}],"role":"symbol","url":"\/documentation\/ivormxl\/mxllyricfont","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyricFont","title":"MXLLyricFont","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLLyricLanguage":{"abstract":[{"type":"text","text":"The lyric-language type specifies the default language for a particular name and number of lyric."}],"url":"\/documentation\/ivormxl\/mxllyriclanguage","title":"MXLLyricLanguage","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"MXLLyricLanguage"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLLyricLanguage"}],"type":"topic","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyricLanguage"}}}