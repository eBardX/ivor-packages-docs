},{"text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of","type":"text"},{"text":" ","type":"text"},{"text":"font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric","type":"text"},{"text":" ","type":"text"},{"text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font","type":"text"},{"text":" ","type":"text"},{"text":"vs. a music font.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLFont"}],"url":"\/documentation\/ivormxl\/mxlfont"},"doc://IvorMXL/documentation/IvorMXL/MXLDefaults/init(scaling:isConcertScore:layout:appearance:musicFont:wordFont:lyricFont:lyricLanguage:)":{"kind":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDefaults\/init(scaling:isConcertScore:layout:appearance:musicFont:wordFont:lyricFont:lyricLanguage:)","url":"\/documentation\/ivormxl\/mxldefaults\/init(scaling:isconcertscore:layout:appearance:musicfont:wordfont:lyricfont:lyriclanguage:)","role":"symbol","title":"init(scaling:isConcertScore:layout:appearance:musicFont:wordFont:lyricFont:lyricLanguage:)","abstract":[{"text":"Creates a new ","type":"text"},{"code":"MXLDefaults","type":"codeVoice"},{"text":".","type":"text"}],"fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"scaling","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLScaling","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL10MXLScalingV"},{"text":"?, ","kind":"text"},{"text":"isConcertScore","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":", ","kind":"text"},{"text":"layout","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLLayout","kind":"typeIdentifier","preciseIdentifier