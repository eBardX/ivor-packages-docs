{"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxldefaults\/scaling"]}],"abstract":[{"type":"text","text":"Specifies how many millimeters are equal to how many tenths, translating tenths to absolute units."}],"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDefaults\/scaling"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDefaults"]]},"metadata":{"externalID":"s:7IvorMXL11MXLDefaultsV7scalingAA10MXLScalingVSgvp","modules":[{"name":"IvorMXL"}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"scaling"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLScaling","preciseIdentifier":"s:7IvorMXL10MXLScalingV"},{"kind":"text","text":"?"}],"roleHeading":"Instance Property","role":"symbol","title":"scaling","symbolKind":"property"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"scaling"},{"kind":"text","text":": "},{"text":"MXLScaling","preciseIdentifier":"s:7IvorMXL10MXLScalingV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScaling","kind":"typeIdentifier"},{"kind":"text","text":"?"}],"platforms":["macOS"]}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Maps to a nested MusicXML "},{"code":"<scaling>","type":"codeVoice"},{"type":"text","text":" element."}],"type":"paragraph"}]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLDefaults/scaling":{"abstract":[{"type":"text","text":"Specifies how many millimeters are equal to how many tenths, translating tenths to absolute units."}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"scaling"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL10MXLScalingV","text":"MXLScaling"},{"kind":"text","text":"?"}],"title":"scaling","url":"\/documentation\/ivormxl\/mxldefaults\/scaling","kind":"symbol","type":"topic","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDefaults\/scaling"},"doc://IvorMXL/documentation/IvorMXL/MXLDefaults":{"navigatorTitle":[{"text":"MXLDefaults","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLDefaults","kind":"identifier"}],"abstract":[{"type":"text","text":"The defaults type specifies score-wide defaults for scaling; whether or not the file is a concert score;"},{"type":"text","text":" "},{"type":"text","text":"layout; and default values for the music font, word font, lyric font, and lyric language. Except for the"},{"type":"text","text":" "},{"type":"text","text":"concert-score element, if any defaults are missing, the choice of what to use is determined by the"},{"type":"text","text":" "},{"type":"text","text":"application."}],"role":"symbol","url":"\/documentation\/ivormxl\/mxldefaults","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDefaults","title":"MXLDefaults","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLScaling":{"abstract":[{"type":"text","text":"Margins, page sizes, and distances are all measured in tenths to keep MusicXML data in a consistent coordinate"},{"type":"text","text":" "},{"type":"text","text":"system as much as possible. The translation to absolute units is done with the scaling type, which specifies"},{"type":"text","text":" "},{"type":"text","text":"how many millimeters are equal to how many tenths. For a staff height of 7 mm, millimeters would be set to 7"},{"type":"text","text":" "},{"type":"text","text":"while tenths is set to 40. The ability to set a formula rather than a single scaling factor helps avoid"},{"type":"text","text":" "},{"type":"text","text":"roundoff errors."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLScaling","kind":"identifier"}],"title":"MXLScaling","role":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLScaling"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlscaling","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScaling"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]}}}