c:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLDefaults/scaling":{"abstract":[{"type":"text","text":"Specifies how many millimeters are equal to how many tenths, translating tenths to absolute units."}],"kind":"symbol","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"scaling","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLScaling","preciseIdentifier":"s:7IvorMXL10MXLScalingV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDefaults\/scaling","url":"\/documentation\/ivormxl\/mxldefaults\/scaling","title":"scaling"},"doc://IvorMXL/documentation/IvorMXL/MXLDefaults":{"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxldefaults","abstract":[{"type":"text","text":"The defaults type specifies score-wide defaults for scaling; whether or not the file is a concert score;"},{"type":"text","text":" "},{"type":"text","text":"layout; and default values for the music font, word font, lyric font, and lyric language. Except for the"},{"type":"text","text":" "},{"type":"text","text":"concert-score element, if any defaults are missing, the choice of what to use is determined by the"},{"type":"text","text":" "},{"type":"text","text":"application."}],"navigatorTitle":[{"text":"MXLDefaults","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLDefaults","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDefaults","title":"MXLDefaults"},"doc://IvorMXL/documentation/IvorMXL/MXLScaling":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScaling","url":"\/documentation\/ivormxl\/mxlscaling","navigatorTitle":[{"text":"MXLScaling","kind":"identifier"}],"type":"topic","abstract":[{"text":"Margins, page sizes, and distances are all measured in tenths to keep MusicXML data in a consistent coordinate","type":"text"},{"text":" ","type":"text"},{"text":"system as much as possible. The translation to absolute units is done with the scaling type, which specifies","type":"text"},{"type":"text","text":" "},{"text":"how many millimeters are equal to how many tenths. For a staff height of 7 mm, millimeters would be set to 7","type":"text"},{"text":" ","type":"text"},{"text":"while tenths is set to 40. The ability to set a formula rather than a single scaling factor helps avoid","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"roundoff errors."}],"kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLScaling","kind":"identifier"}],"title":"MXLScaling"}}}