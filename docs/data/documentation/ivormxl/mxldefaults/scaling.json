d":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL10MXLScalingV","text":"MXLScaling"},{"kind":"text","text":"?"}],"role":"symbol","type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxldefaults\/scaling","title":"scaling","abstract":[{"type":"text","text":"Specifies how many millimeters are equal to how many tenths, translating tenths to absolute units."}]},"doc://IvorMXL/documentation/IvorMXL/MXLDefaults":{"navigatorTitle":[{"text":"MXLDefaults","kind":"identifier"}],"abstract":[{"text":"The defaults type specifies score-wide defaults for scaling; whether or not the file is a concert score;","type":"text"},{"text":" ","type":"text"},{"text":"layout; and default values for the music font, word font, lyric font, and lyric language. Except for the","type":"text"},{"text":" ","type":"text"},{"text":"concert-score element, if any defaults are missing, the choice of what to use is determined by the","type":"text"},{"text":" ","type":"text"},{"text":"application.","type":"text"}],"title":"MXLDefaults","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDefaults","kind":"symbol","url":"\/documentation\/ivormxl\/mxldefaults","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLDefaults","kind":"identifier"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLScaling":{"abstract":[{"type":"text","text":"Margins, page sizes, and distances are all measured in tenths to keep MusicXML data in a consistent coordinate"},{"text":" ","type":"text"},{"type":"text","text":"system as much as possible. The translation to absolute units is done with the scaling type, which specifies"},{"text":" ","type":"text"},{"text":"how many millimeters are equal to how many tenths. For a staff height of 7 mm, millimeters would be set to 7","type":"text"},{"text":" ","type":"text"},{"text":"while tenths is set to 40. The ability to set a formula rather than a single scaling factor helps avoid","type":"text"},{"text":" ","type":"text"},{"text":"roundoff errors.","type":"text"}],"title":"MXLScaling","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLScaling","kind":"identifier"}],"navigatorTitle":[{"text":"MXLScaling","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlscaling","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScaling"},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"}}}