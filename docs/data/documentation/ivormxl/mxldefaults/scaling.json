ts":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLScaling","kind":"identifier"}],"title":"MXLScaling","abstract":[{"text":"Margins, page sizes, and distances are all measured in tenths to keep MusicXML data in a consistent coordinate","type":"text"},{"text":" ","type":"text"},{"text":"system as much as possible. The translation to absolute units is done with the scaling type, which specifies","type":"text"},{"text":" ","type":"text"},{"text":"how many millimeters are equal to how many tenths. For a staff height of 7 mm, millimeters would be set to 7","type":"text"},{"text":" ","type":"text"},{"text":"while tenths is set to 40. The ability to set a formula rather than a single scaling factor helps avoid","type":"text"},{"text":" ","type":"text"},{"text":"roundoff errors.","type":"text"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLDefaults/scaling":{"abstract":[{"text":"How many millimeters are equal to how many tenths, translating tenths to absolute units.","type":"text"}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"scaling","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLScaling","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL10MXLScalingV"},{"text":"?","kind":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDefaults\/scaling","type":"topic","role":"symbol","kind":"symbol","url":"\/documentation\/ivormxl\/mxldefaults\/scaling","title":"scaling"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLDefaults":{"navigatorTitle":[{"kind":"identifier","text":"MXLDefaults"}],"abstract":[{"text":"The defaults type specifies score-wide defaults for scaling; whether or not the file is a concert score;","type":"text"},{"text":" ","type":"text"},{"text":"layout; and default values for the music font, word font, lyric font, and lyric language. Except for the","type":"text"},{"text":" ","type":"text"},{"text":"concert-score element, if any defaults are missing, the choice of what to use is determined by the","type":"text"},{"text":" ","type":"text"},{"text":"application.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDefaults","url":"\/documentation\/ivormxl\/mxldefaults","role":"symbol","title":"MXLDefaults","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLDefaults"}]}}}