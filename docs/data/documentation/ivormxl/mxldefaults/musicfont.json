, word font, lyric font, and lyric language. Except for the","type":"text"},{"text":" ","type":"text"},{"text":"concert-score element, if any defaults are missing, the choice of what to use is determined by the","type":"text"},{"text":" ","type":"text"},{"text":"application.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDefaults","url":"\/documentation\/ivormxl\/mxldefaults","role":"symbol","title":"MXLDefaults","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLDefaults"}]}}}