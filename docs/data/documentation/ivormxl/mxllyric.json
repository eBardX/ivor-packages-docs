{"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric"},"sections":[],"metadata":{"role":"symbol","symbolKind":"struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLLyric","kind":"identifier"}],"title":"MXLLyric","navigatorTitle":[{"kind":"identifier","text":"MXLLyric"}],"externalID":"s:7IvorMXL8MXLLyricV","modules":[{"name":"IvorMXL"}],"roleHeading":"Structure"},"kind":"symbol","topicSections":[{"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric\/init(id:content:endsLine:endsParagraph:footnote:level:number:name:justify:position:placement:color:printsObject:timeOnly:)"],"title":"Initializers","anchor":"Initializers","generated":true},{"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric\/color","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric\/content-swift.property","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric\/endsLine","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric\/endsParagraph","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric\/footnote","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric\/id","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric\/justify","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric\/level","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric\/name","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric\/number","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric\/placement","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric\/position","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric\/printsObject","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric\/timeOnly"],"title":"Instance Properties","anchor":"Instance-Properties","generated":true},{"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric\/Content-swift.enum"],"title":"Enumerations","anchor":"Enumerations","generated":true},{"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric\/Equatable-Implementations"],"title":"Default Implementations","anchor":"Default-Implementations","generated":true}],"abstract":[{"type":"text","text":"The lyric type represents text underlays for lyrics. Two text elements that are not separated by an elision"},{"type":"text","text":" "},{"type":"text","text":"element are part of the same syllable, but may have different text formatting. The MusicXML XSD is more strict"},{"type":"text","text":" "},{"type":"text","text":"than the DTD in enforcing this by disallowing a second syllabic element unless preceded by an elision element."},{"type":"text","text":" "},{"type":"text","text":"The lyric number indicates multiple lines, though a name can be used as well. Common name examples are verse"},{"type":"text","text":" "},{"type":"text","text":"and chorus."}],"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLLyric","kind":"identifier"}]}]},{"kind":"content","content":[{"anchor":"overview","text":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Justification is center by default; placement is below by default. Vertical alignment is to the baseline of"},{"type":"text","text":" "},{"type":"text","text":"the text and horizontal alignment matches justification. The print-object attribute can override a note’s"},{"type":"text","text":" "},{"type":"text","text":"print-lyric attribute in cases where only some lyrics on a note are printed, as when lyrics for later verses"},{"type":"text","text":" "},{"type":"text","text":"are printed in a block of text rather than with each note. The time-only attribute precisely specifies which"},{"type":"text","text":" "},{"type":"text","text":"lyrics are to be sung which time through a repeated section."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Maps the MusicXML "},{"code":"<lyric>","type":"codeVoice"},{"text":" element.","type":"text"}]}]}],"relationshipsSections":[{"identifiers":["doc:\/\/IvorMXL\/s8CopyableP","doc:\/\/IvorMXL\/SQ","doc:\/\/IvorMXL\/s9EscapableP","doc:\/\/IvorMXL\/SH","doc:\/\/IvorMXL\/s8SendableP","doc:\/\/IvorMXL\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships","title":"Conforms To"}],"variants":[{"paths":["\/documentation\/ivormxl\/mxllyric"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLLyric/number":{"type":"topic","title":"number","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"number"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?"}],"url":"\/documentation\/ivormxl\/mxllyric\/number","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric\/number","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"Identifies this lyric among multiple lines, such as when the same lyric applies to both a stem-up and a"},{"type":"text","text":" "},{"type":"text","text":"stem-down voice."}]},"doc://IvorMXL/documentation/IvorMXL/MXLLyric/Content-swift.enum":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric\/Content-swift.enum","title":"MXLLyric.Content","type":"topic","kind":"symbol","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Content","kind":"identifier"}],"abstract":[{"type":"text","text":"One of the alternatives for Lyric."}],"url":"\/documentation\/ivormxl\/mxllyric\/content-swift.enum","navigatorTitle":[{"text":"Content","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLLyric/endsLine":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLyric\/endsLine","type":"topic","title":"endsLine","kind":"symbol","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind"