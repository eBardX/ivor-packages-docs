orepartwise\/equatable-implementations","kind":"article","abstract":[],"title":"Equatable Implementations","role":"collectionGroup","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePartwise\/Equatable-Implementations","type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLScorePartwise/work":{"fragments":[{"text":"let","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"work"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLWork","preciseIdentifier":"s:7IvorMXL7MXLWorkV"},{"kind":"text","text":"?"}],"abstract":[{"text":"The work that identifies the piece, optionally including its number and title.","type":"text"}],"role":"symbol","kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxlscorepartwise\/work","title":"work","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePartwise\/work"},"doc://IvorMXL/documentation/IvorMXL/MXLOpus":{"title":"MXLOpus","url":"\/documentation\/ivormxl\/mxlopus","abstract":[{"type":"text","text":"The opus type is used for the root element of a MusicXML opus. Each opus is made up of a series of score,"},{"type":"text","text":" "},{"type":"text","text":"opus-link, and\/or nested opus elements. The document-attributes attribute group includes the version"},{"type":"text","text":" "},{"type":"text","text":"attribute. Future versions may include more metadata elements. In this version, we just include the title of"},{"type":"text","text":" "},{"type":"text","text":"the opus."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLOpus"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLOpus"}],"type":"topic","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOpus"},"doc://IvorMXL/documentation/IvorMXL/MXLScorePart":{"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLScorePart","kind":"identifier"}],"title":"MXLScorePart","navigatorTitle":[{"text":"MXLScorePart","kind":"identifier"}],"abstract":[{"type":"text","text":"The score-part type collects part-wide information for each part in a score. Often, each MusicXML part"},{"type":"text","text":" "},{"type":"text","text":"corresponds to a track in a Standard MIDI Format 1 file. In this case, the midi-device element is used to make"},{"type":"text","text":" "},{"type":"text","text":"a MIDI device or port assignment for the given track or specific MIDI instruments. Initial midi-instrument"},{"type":"text","text":" "},{"type":"text","text":"assignments may be made here as well. The score-instrument elements are used when there are multiple"},{"type":"text","text":" "},{"type":"text","text":"instruments per track."}],"url":"\/documentation\/ivormxl\/mxlscorepart","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePart","role":"symbol"},"doc://IvorMXL/s16SendableMetatypeP":{"identifier":"doc:\/\/IvorMXL\/s16SendableMetatypeP","type":"unresolvable","title":"Swift.SendableMetatype"},"doc://IvorMXL/documentation/IvorMXL/MXLPartList":{"type":"topic","title":"MXLPartList","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPartList"}],"url":"\/documentation\/ivormxl\/mxlpartlist","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartList","role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLPartList"}],"abstract":[{"type":"text","text":"The part-list identifies the different musical parts in this document. Each part has an ID that is used later"},{"type":"text","text":" "},{"type":"text","text":"within the musical data. Since parts may be encoded separately and combined later, identification elements are"},{"type":"text","text":" "},{"type":"text","text":"present at both the score and score-part levels. There must be at least one score-part, combined as desired"},{"type":"text","text":" "},{"type":"text","text":"with part-group elements that indicate braces and brackets. Parts are ordered from top to bottom in a score"},{"type":"text","text":" "},{"type":"text","text":"based on the order in which they appear in the part-list."}]},"doc://IvorMXL/documentation/IvorMXL/MXLScorePartwise/movementNumber":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"movementNumber","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePartwise\/movementNumber","type":"topic","abstract":[{"text":"The movement-number element specifies the number of a movement.","type":"text"}],"role":"symbol","title":"movementNumber","url":"\/documentation\/ivormxl\/mxlscorepartwise\/movementnumber"},"doc://IvorMXL/documentation/IvorMXL/MXLScorePartwise/identification":{"abstract":[{"type":"text","text":"The identification metadata for the score, such as creators, rights, source, and relation information."}],"fragments":[{"text":"let","kind":"keyword"},{"kind":"text","text":" "},{"text":"identification","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLIdentification","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL17MXLIdentificationV"},{"kind":"text","text":"?"}],"role":"symbol","title":"identification","url":"\/documentation\/ivormxl\/mxlscorepartwise\/identification","type":"topic","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePartwise\/identification"},"doc://IvorMXL/documentation/IvorMXL/MXLScorePartwise/parts":{"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePartwise\/parts","url":"\/documentation\/ivormxl\/mxlscorepartwise\/parts","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"parts"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL16MXLScorePartwiseV4