{"abstract":[{"text":"Creates a new ","type":"text"},{"code":"MXLRest","type":"codeVoice"},{"text":".","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"init","kind":"keyword"},{"text":"(","kind":"text"},{"text":"displayStepOctave","kind":"externalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL20MXLDisplayStepOctaveV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDisplayStepOctave","text":"MXLDisplayStepOctave"},{"kind":"text","text":"? = nil, "},{"text":"measure","kind":"externalParam"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":"? = nil)"}],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The display-step-octave group contains the sequence of elements used by both the rest and unpitched elements. This group is used to place rests and unpitched elements on the staff without implying that these elements have pitch. Positioning follows the current clef. If percussion clef is used, the display-step and display-octave elements are interpreted as if in treble clef, with a G in octave 4 on line 2."}],"type":"paragraph"}],"name":"displayStepOctave"},{"name":"measure","content":[{"inlineContent":[{"type":"text","text":"A Boolean value indicating whether this represents a complete measure rest."}],"type":"paragraph"}]}]}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRest"]]},"kind":"symbol","metadata":{"symbolKind":"init","title":"init(displayStepOctave:measure:)","role":"symbol","externalID":"s:7IvorMXL7MXLRestV17displayStepOctave7measureAcA010MXLDisplayeF0VSg_SbSgtcfc","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"displayStepOctave","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLDisplayStep