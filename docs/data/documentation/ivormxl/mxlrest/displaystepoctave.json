{"sections":[],"abstract":[{"type":"text","text":"The display-step-octave group contains the sequence of elements used by both the rest and unpitched elements."},{"type":"text","text":" "},{"type":"text","text":"This group is used to place rests and unpitched elements on the staff without implying that these elements"},{"type":"text","text":" "},{"type":"text","text":"have pitch. Positioning follows the current clef. If percussion clef is used, the display-step and display-"},{"type":"text","text":" "},{"type":"text","text":"octave elements are interpreted as if in treble clef, with a G in octave 4 on line 2."}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRest\/displayStepOctave","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"paths":["\/documentation\/ivormxl\/mxlrest\/displaystepoctave"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"displayStepOctave","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLDisplayStepOctave","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDisplayStepOctave","preciseIdentifier":"s:7IvorMXL20MXLDisplayStepOctaveV"},{"text":"?","kind":"text"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"inlineContent":[{"type":"text","text":"Maps to nested MusicXML "},{"type":"codeVoice","code":"<display-step>"},{"type":"text","text":" and "},{"type":"codeVoice","code":"<display-octave>"},{"type":"text","text":" elements."}],"type":"paragraph"}],"kind":"content"}],"metadata":{"role":"symbol","roleHeading":"Instance Property","modules":[{"name":"IvorMXL"}],"symbolKind":"property","title":"displayStepOctave","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"displayStepOctave","kind":"identifier"}