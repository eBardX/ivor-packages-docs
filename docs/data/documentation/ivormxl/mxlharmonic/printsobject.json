r a rest). Defaults to "},{"type":"codeVoice","code":"true"},{"type":"text","text":" if not"},{"type":"text","text":" "},{"type":"text","text":"specified."}],"title":"printsObject","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmonic\/printsObject","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"printsObject","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLHarmonic":{"navigatorTitle":[{"text":"MXLHarmonic","kind":"identifier"}],"abstract":[{"type":"text","text":"The harmonic type indicates natural and artificial harmonics. Allowing the type of pitch to be specified,"},{"type":"text","text":" "},{"type":"text","text":"combined with controls for appearance\/playback differences, allows both the notation and the sound to be"},{"type":"text","text":" "},{"type":"text","text":"represented. Artificial harmonics can add a notated touching pitch; artificial pinch harmonics will usually"},{"type":"text","text":" "},{"type":"text","text":"not notate a touching pitch. The attributes for the harmonic element refer to the use of the circular harmonic"},{"type":"text","text":" "},{"type":"text","text":"symbol, typically but not always used with natural harmonics."}],"title":"MXLHarmonic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmonic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlharmonic","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLHarmonic","kind":"identifier"}],"role":"symbol"}}}