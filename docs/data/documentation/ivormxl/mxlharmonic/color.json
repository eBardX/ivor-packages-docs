{"sections":[],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmonic"]]},"abstract":[{"type":"text","text":"The color attribute group indicates the color of an element."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"color","kind":"identifier"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","preciseIdentifier":"s:7IvorMXL8MXLColorV","text":"MXLColor","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlharmonic\/color"]}],"metadata":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"color","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL8MXLColorV","text":"MXLColor","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"title":"color","externalID":"s:7IvorMXL11MXLHarmonicV5colorAA8MXLColorVSgvp","modules":[{"name":"IvorMXL"}],"roleHeading":"Instance Property","role":"symbol","symbolKind":"property"},"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmonic\/color"},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLHarmonic/color":{"url":"\/documentation\/ivormxl\/mxlharmonic\/color","abstract":[{"type":"text","text":"The color attribute group indicates the color of an element."}],"title":"color","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmonic\/color","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"color","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLColor","preciseIdentifier":"s:7IvorMXL8MXLColorV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"abstract":[{"text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in","type":"text"},{"type":"text","text":" "},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"title":"MXLColor","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlcolor","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor"},"doc://IvorMXL/documentation/IvorMXL/MXLHarmonic":{"navigatorTitle":[{"text":"MXLHarmonic","kind":"identifier"}],"abstract":[{"type":"text","text":"The harmonic type indicates natural and artificial harmonics. Allowing the type of pitch to be specified,"},{"type":"text","text":" "},{"type":"text","text":"combined with controls for appearance\/playback differences, allows both the notation and the sound to be"},{"type":"text","text":" "},{"type":"text","text":"represented. Artificial harmonics can add a notated touching pitch; artificial pinch harmonics will usually"},{"type":"text","text":" "},{"type":"text","text":"not notate a touching pitch. The attributes for the harmonic element refer to the use of the circular harmonic"},{"type":"text","text":" "},{"type":"text","text":"symbol, typically but not always used with natural harmonics."}],"title":"MXLHarmonic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmonic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlharmonic","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLHarmonic","kind":"identifier"}],"role":"symbol"}}}