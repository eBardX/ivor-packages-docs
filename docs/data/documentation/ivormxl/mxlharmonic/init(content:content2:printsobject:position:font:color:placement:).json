"swift"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"One of the alternatives for Harmonic.","type":"text"}]}],"name":"content"},{"content":[{"type":"paragraph","inlineContent":[{"text":"One of the alternatives for Harmonic.","type":"text"}]}],"name":"content2"},{"content":[{"type":"paragraph","inlineContent":[{"text":"A Boolean value indicating whether to print an object (e.g. a note or a rest). Defaults to ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" if not specified.","type":"text"}]}],"name":"printsObject"},{"content":[{"type":"paragraph","inlineContent":[{"text":"For most elements, any program will compute a default x and y position. The position attributes let this be changed two ways.","type":"text"}]}],"name":"position"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The font attribute group gathers together attributes for determining the font within a credit or direction. They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font vs. a music font.","type":"text"}]}],"name":"font"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The color attribute group indicates the color of an element.","type":"text"}]}],"name":"color"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The placement attribute indicates whether something is above or below another element, such as a note or a notation.","type":"text"}]}],"name":"placement"}]}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmonic\/init(content:content2:printsObject:position:font:color:placement:)","interfaceLanguage":"swift"},"sections":[],"kind":"symbol","schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"traits":[{"interfa