lor","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"kind":"symbol","title":"MXLColor","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLHarmonic":{"type":"topic","abstract":[{"text":"The harmonic type indicates natural and artificial harmonics. Allowing the type of pitch to be specified,","type":"text"},{"text":" ","type":"text"},{"text":"combined with controls for appearance\/playback differences, allows both the notation and the sound to be","type":"text"},{"text":" ","type":"text"},{"text":"represented. Artificial harmonics can add a notated touching pitch; artificial pinch harmonics will usually","type":"text"},{"text":" ","type":"text"},{"text":"not notate a touching pitch. The attributes for the harmonic element refer to the use of the circular harmonic","type":"text"},{"text":" ","type":"text"},{"text":"symbol, typically but not always used with natural harmonics.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlharmonic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLHarmonic"}],"kind":"symbol","title":"MXLHarmonic","navigatorTitle":[{"kind":"identifier","text":"MXLHarmonic"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmonic","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLAboveBelow":{"type":"topic","title":"MXLAboveBelow","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAboveBelow","abstract":[{"type":"text","text":"The above-below type is used to indicate whether one element appears above or below another element."}],"role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLAboveBelow"}],"navigatorTitle":[{"kind":"identifier","text":"MXLAboveBelow"}],"url":"\/documentation\/ivormxl\