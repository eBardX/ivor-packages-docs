"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLFont"}],"abstract":[{"text":"The font attribute group gathers together attributes for determining the font within a credit or direction.","type":"text"},{"text":" ","type":"text"},{"text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of","type":"text"},{"text":" ","type":"text"},{"text":"font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric","type":"text"},{"text":" ","type":"text"},{"text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font","type":"text"},{"text":" ","type":"text"},{"text":"vs. a music font.","type":"text"}],"kind":"symbol","title":"MXLFont","url":"\/documentation\/ivormxl\/mxlfont","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFont"}]},"doc://IvorMXL/documentation/IvorMXL/MXLAboveBelow":{"type":"topic","abstract":[{"text":"The above-below type is used to indicate whether one element appears above or below another element.","type":"text"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLAboveBelow"}],"navigatorTitle":[{"kind":"identifier","text":"MXLAboveBelow"}],"title":"MXLAboveBelow","kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlabovebelow","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAboveBelow"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLHarmonic":{"url":"\/documentation\/ivormxl\/mxlharmonic","title":"MXLHarmonic","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLHarmonic"}],"navigatorTitle":[{"kind":"identifier","text":"MXLHarmonic"}],"abstract":[{"type":"text","text":"The harmonic type indicates natural and artificial harmonics. Allowing the type of pitch to be specified,"},{"type":"text","text":" "},{"type":"text","text":"combined with controls for appearance\/playback differences, allows both the notation and the sound to be"},{"type":"text","text":" "},{"type":"text","text":"represented. Artificial harmonics can add a notated touching pitch; artificial pinch harmonics will usually"},{"type":"text","text":" "},{"type":"text","text":"not notate a touching pitch. The attributes for the harmonic element refer to the use of the circular harmonic"},{"type":"text","text":" "},{"type":"text","text":"symbol, typically but not always used with natural harmonics."}],"kind":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmonic"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLColor","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","title":"MXLColor","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlcolor"}}}