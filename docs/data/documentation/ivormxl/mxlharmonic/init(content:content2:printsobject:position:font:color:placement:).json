,"type":"text"},{"type":"text","text":" "},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"title":"MXLColor","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlcolor","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor"},"doc://IvorMXL/documentation/IvorMXL/MXLPosition":{"title":"MXLPosition","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPosition"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlposition","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","abstract":[{"text":"For most elements, any program will compute a default x and y position. The position attributes let this be","type":"text"},{"text":" ","type":"text"},{"text":"changed two ways.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"MXLPosition"}]},"doc://IvorMXL/documentation/IvorMXL/MXLAboveBelow":{"title":"MXLAboveBelow","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLAboveBelow"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlabovebelow","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAboveBelow","abstract":[{"text":"The above-below type is used to indicate whether one element appears above or below another element.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"MXLAboveBelow"}]},"doc://IvorMXL/documentation/IvorMXL/MXLHarmonic":{"navigatorTitle":[{"text":"MXLHarmonic","kind":"identifier"}],"abstract":[{"type":"