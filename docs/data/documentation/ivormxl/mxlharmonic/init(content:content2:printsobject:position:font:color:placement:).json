\/IvorMXL\/documentation\/IvorMXL\/MXLHarmonic"]]},"abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLHarmonic"},{"type":"text","text":"."}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLHarmonic":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLHarmonic","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"MXLHarmonic","kind":"identifier"}],"abstract":[{"type":"text","text":"The harmonic type indicates natural and artificial harmonics. Allowing the type of pitch to be specified,"},{"type":"text","text":" "},{"type":"text","text":"combined with controls for appearance\/playback differences, allows both the notation and the sound to be"},{"type":"text","text":" "},{"type":"text","text":"represented. Artificial harmonics can add a notated touching pitch; artificial pinch harmonics will usually"},{"type":"text","text":" "},{"type":"text","text":"not notate a touching pitch. The attributes for the harmonic element refer to the use of the circular harmonic"},{"type":"text","text":" "},{"type":"text","text":"symbol, typically but not always used with natural harmonics."}],"url":"\/documentation\/ivormxl\/mxlharmonic","title":"MXLHarmonic","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmonic","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLHarmonic/init(content:content2:printsObject:position:font:color:placement:)":{"abstract":[{"text":"Creates a new ","type":"text"},{"code":"MXLHarmonic","type":"codeVoice"},{"text":".","type":"text"}],"url":"\/documentation\/ivormxl\/mxlharmonic\/init(content:content2:printsobject:position:font:color:placement:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"content"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL11MXLHarmonicV7ContentO","kind":"typeIdentifier","text":"Content"},{"kind":"text","text":"?, "},{"kind":"externalParam","text"