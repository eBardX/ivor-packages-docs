orMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLTranspose/Content-swift.struct":{"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTranspose\/Content-swift.struct","abstract":[{"text":"The transpose group represents what must be added to a written pitch to get a correct sounding pitch.","type":"text"}],"url":"\/documentation\/ivormxl\/mxltranspose\/content-swift.struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Content","kind":"identifier"}],"navigatorTitle":[{"text":"Content","kind":"identifier"}],"title":"MXLTranspose.Content","role":"symbol","type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLTranspose":{"type":"topic","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTranspose","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTranspose","title":"MXLTranspose","abstract":[{"type":"text","text":"The transpose type represents what must be added to a written pitch to get a correct sounding pitch. The"},{"type":"text","text":" "},{"type":"text","text":"optional number attribute refers to staff numbers, from top to bottom on the system. If absent, the"},{"type":"text","text":" "},{"type":"text","text":"transposition applies to all staves in the part. Per-staff transposition is most often used in parts that"},{"type":"text","text":" "},{"type":"text","text":"represent multiple instruments."}],"navigatorTitle":[{"text":"MXLTranspose","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxltranspose"}}}