new "},{"code":"MXLForPart","type":"codeVoice"},{"type":"text","text":"."}]},"doc://IvorMXL/documentation/IvorMXL/MXLTranspose":{"type":"topic","abstract":[{"type":"text","text":"The transpose type represents what must be added to a written pitch to get a correct sounding pitch. The"},{"type":"text","text":" "},{"type":"text","text":"optional number attribute refers to staff numbers, from top to bottom on the system. If absent, the"},{"type":"text","text":" "},{"type":"text","text":"transposition applies to all staves in the part. Per-staff transposition is most often used in parts that"},{"type":"text","text":" "},{"type":"text","text":"represent multiple instruments."}],"url":"\/documentation\/ivormxl\/mxltranspose","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTranspose","kind":"identifier"}],"kind":"symbol","title":"MXLTranspose","navigatorTitle":[{"text":"MXLTranspose","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTranspose","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLClef":{"type":"topic","title":"MXLClef","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLClef","abstract":[{"text":"Clefs are represented by a combination of sign, line, and clef-octave-change elements. The optional number","type":"text"},{"text":" ","type":"text"},{"text":"attribute refers to staff numbers within the part. A value of 1 is assumed if not present.","type":"text"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLClef","kind":"identifier"}],"navigatorTitle":[{"text":"MXLClef","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlclef"},"doc://IvorMXL/documentation/IvorMXL/MXLForPart":{"type":"topic","title":"MXLForPart","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLForPart","abstract":[{"type":"text","text":"The for-part type is used in a concert score to indicate the transposition for a transposed part created from"},{"type":"text","text":" "},{"type":"text","text":"that score. It is only used in score files that contain a concert-score element in the defaults. This allows"},{"type":"text","text":" "},{"type":"text","text":"concert scores with transposed parts to be represented in a single uncompressed MusicXML file."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLForPart"}],"navigatorTitle":[{"kind":"identifier","text":"MXLForPart"}],"url":"\/documentation\/ivormxl\/mxlforpart"},"doc://IvorMXL/documentation/IvorMXL/MXLClef/Content-swift.struct":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Content"}],"title":"MXLClef.Content","abstract":[{"text":"Clefs are represented by a combination of sign, line, and clef-octave-change elements.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLClef\/Content-swift.struct","role":"symbol","url":"\/documentation\/ivormxl\/mxlclef\/content-swift.struct","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Content"}],"type":"topic"}}}