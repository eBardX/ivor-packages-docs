color of an element.","type":"text"}],"kind":"symbol","title":"color"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlcolor","title":"MXLColor","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"type":"text","text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is"},{"type":"text","text":" "},{"type":"text","text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor"},"doc://IvorMXL/documentation/IvorMXL/MXLMeasureNumbering":{"abstract":[{"type":"text","text":"The measure-numbering type describes how frequently measure numbers are displayed on this part. The text"},{"type":"text","text":" "},{"type":"text","text":"attribute from the measure element is used for display, or the number attribute if the text attribute is not"},{"type":"text","text":" "},{"type":"text","text":"present. Measures with an implicit attribute set to “yes” never display a measure number, regardless of the"},{"type":"text","text":" "},{"type":"text","text":"measure-numbering setting."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMeasureNumbering","kind":"symbol","type":"topic","navigatorTitle":[{"text":"MXLMeasureNumbering","kind":"identifier"}],"title":"MX