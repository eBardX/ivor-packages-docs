{"abstract":[{"type":"text","text":"Distinguishes measure numbers that are associated with a system rather than the particular part where this"},{"type":"text","text":" "},{"type":"text","text":"element appears."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlmeasurenumbering\/system"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"system"},{"kind":"text","text":": "},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemRelationNumber","preciseIdentifier":"s:7IvorMXL23MXLSystemRelationNumberO","kind":"typeIdentifier","text":"MXLSystemRelationNumber"},{"kind":"text","text":"?"}],"platforms":["macOS"]}]},{"content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Maps to the MusicXML "},{"type":"codeVoice","code":"system"},{"text":" attribute.","type":"text"}]}],"kind":"content"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMeasureNumbering\/system","interfaceLanguage":"swift"},"kind":"symbol","metadata":{"externalID":"s:7IvorMXL19MXLMeasureNumberingV6systemAA23MXLSystemRelationNumberOSgvp","modules":[{"name":"IvorMXL"}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"system"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL23MXLSystemRelationNumberO","kind":"typeIdentifier","text":"MXLSystemRelationNumber"},{"kind":"text","text":"?"}],"symbolKind":"property","roleHeading":"Instance Property","role":"symbol","title":"system"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMeasureNumbering"]]},"references":{"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLMeasureNumbering/system":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMeasureNumbering\/system","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"system","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLSystemRelationNumber","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL23MXLSystemRelationNumberO"},{"text":"?","kind":"text"}],"url":"\/documentation\/ivormxl\/mxlmeasurenumbering\/system","role":"symbol","type":"topic","abstract":[{"text":"Distinguishes measure numbers that are associated with a system rather than the particular part where this","type":"text"},{"text":" ","type":"text"},{"text":"element appears.","type":"text"}],"kind":"symbol","title":"system"},"doc://IvorMXL/documentation/IvorMXL/MXLMeasureNumbering":{"abstract":[{"type":"text","text":"The measure-numbering type describes how frequently measure numbers are displayed on this part. The text"},{"type":"text","text":" "},{"type":"text","text":"attribute from the measure element is used for display, or the number attribute if the text attribute is not"},{"type":"text","text":" "},{"type":"text","text":"present. Measures with an implicit attribute set to “yes” never display a measure number, regardless of the"},{"type":"text","text":" "},{"type":"text","text":"measure-numbering setting."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMeasureNumbering","kind":"symbol","type":"topic","navigatorTitle":[{"text":"MXLMeasureNumbering","kind":"identifier"}],"title":"MXLMeasureNumbering","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLMeasureNumbering","kind":"identifier"}],"role":"symbol","url":"\/documentation\/ivormxl\/mxlmeasurenumbering"},"doc://IvorMXL/documentation/IvorMXL/MXLSystemRelationNumber":{"type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLSystemRelationNumber"}],"url":"\/documentation\/ivormxl\/mxlsystemrelationnumber","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLSystemRelationNumber"}],"abstract":[{"text":"The system-relation-number type distinguishes measure numbers that are associated with a system rather than","type":"text"},{"text":" ","type":"text"},{"text":"the particular part where the element appears. A value of only-top or only-bottom indicates that the number","type":"text"},{"text":" ","type":"text"},{"text":"should appear only on the top or bottom part of the current system, respectively. A value of also-top or also-","type":"text"},{"text":" ","type":"text"},{"text":"bottom indicates that the number should appear on both the current part and the top or bottom part of the","type":"text"},{"text":" ","type":"text"},{"text":"current system, respectively. If these values appear in a score, when parts are created the number should only","type":"text"},{"text":" ","type":"text"},{"text":"appear once in this part, not twice. A value of none indicates that the number is associated only with the","type":"text"},{"text":" ","type":"text"},{"text":"current part, not with the system.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemRelationNumber","kind":"symbol","title":"MXLSystemRelationNumber"}}}