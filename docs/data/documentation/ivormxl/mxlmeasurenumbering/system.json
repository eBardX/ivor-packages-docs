t":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLMeasureNumbering","kind":"identifier"}],"navigatorTitle":[{"text":"MXLMeasureNumbering","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMeasureNumbering","kind":"symbol","role":"symbol","title":"MXLMeasureNumbering","abstract":[{"text":"The measure-numbering type describes how frequently measure numbers are displayed on this part. The text","type":"text"},{"text":" ","type":"text"},{"text":"attribute from the measure element is used for display, or the number attribute if the text attribute is not","type":"text"},{"text":" ","type":"text"},{"text":"present. Measures with an implicit attribute set to “yes” never display a measure number, regardless of the","type":"text"},{"text":" ","type":"text"},{"text":"measure-numbering setting.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlmeasurenumbering"},"doc://IvorMXL/documentation/IvorMXL/MXLSystemRelationNumber":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlsystemrelationnumber","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemRelationNumber","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSystemRelationNumber","kind":"identifier"}],"abstract":[{"type":"text","text":"The system-relation-number type distinguishes measure numbers that are associated with a system rather than"},{"type":"text","text":" "},{"type":"text","text":"the particular part where the element appears. A value of only-top or only-bottom indicates that the number"},{"type":"text","text":" "},{"type":"text","text":"should appear only on the top or bottom part of the current system, respectively. A value of also-top or also-"},{"type":"text","text":" "},{"type":"text","text":"bottom indicates that the number should appear on both the current part and the top or bottom part of the"},{"type":"text","text":" "},{"type":"text","text":"current system, respectively. If these values appear in a score, when parts are created the number should only"},{"type":"text","text":" "},{"type":"text","text":"appear once in this part, not twice. A value of none indicates that the number is associated only with the"},{"type":"text","text":" "},{"type":"text","text":"current part, not with the system."}],"kind":"symbol","type":"topic","navigatorTitle":[{"text":"MXLSystemRelationNumber","kind":"identifier"}],"title":"MXLSystemRelationNumber"},"doc://IvorMXL/documentation/IvorMXL/MXLMeasureNumbering/system":{"role":"symbol","type":"topic","title":"system","url":"\/documentation\/ivormxl\/mxlmeasurenumbering\/system","kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"system","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLSystemRelationNumber","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL23MXLSystemRelationNumberO"},{"text":"?","kind":"text"}],"abstract":[{"type":"text","text":"Distinguishes measure numbers that are associated with a system rather than the particular part where this"},{"type":"text","text":" "},{"type":"text","text":"element appears."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMeasureNumbering\/system"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"}}}