nV","kind":"typeIdentifier"},{"text":" = MXLPosition(), ","kind":"text"},{"text":"font","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLFont","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","preciseIdentifier":"s:7IvorMXL7MXLFontV","kind":"typeIdentifier"},{"text":" = MXLFont(), ","kind":"text"},{"text":"color","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLColor","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","preciseIdentifier":"s:7IvorMXL8MXLColorV","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"halign","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLLeftCenterRight","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLeftCenterRight","preciseIdentifier":"s:7IvorMXL18MXLLeftCenterRightO","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"valign","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLValign","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValign","preciseIdentifier":"s:7IvorMXL9MXLValignO","kind":"typeIdentifier"},{"text":"? = nil)","kind":"text"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"parameters":[{"name":"value","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The value of this element."}]}]},{"name":"system","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Distinguishes measure numbers that are associated with a system rather"},{"type":"text","text":" "},{"type":"text","text":"than the particular part where this element appears."}]}]},{"name":"staff","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The staff used as the reference point for vertical positioning. Refers"},{"type":"text","text":" "},{"type":"text","text":"to staff numbers within the part, from top to bottom on the system. A"},{"type":"text","text":" "},{"type":"text","text":"value of "},{"code":"1","type":"codeVoice"},{"type":"text","text":" is assumed if not present."}]}]},{"name":"alwaysShowsOnMultipleRest","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A Boolean value indicating whether the measure number should always be"},{"type":"text","text":" "},{"type":"text","text":"shown on a multiple rest, even if the multiple rest starts midway"},{"type":"text","text":" "},{"type":"text","text":"through a system when measure numbering is set to system level."}]}]},{"name":"showsRangeOnMultipleRest","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A Boolean value indicating whether measure numbers on multiple rests"},{"type":"text","text":" "},{"type":"text","text":"display the range of numbers for the first and last measure, rather than"},{"type":"text","text":" "},{"type":"text","text":"just the number of the first measure."}]}]},{"name":"position","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For most elements, any program will compute a default x and y position."},{"type":"text","text":" "},{"type":"text","text":"The position attributes let this be changed two ways."}]}]},{"name":"font","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The font attribute group gathers together attributes for determining the"},{"type":"text","text":" "},{"type":"text","text":"font within a credit or direction. They are based on the text styles for"},{"type":"text","text":" "},{"type":"text","text":"Cascading Style Sheets. The font-family is a comma-separated list of"},{"type":"text","text":" "},{"type":"text","text":"font names. The font-style can be normal or italic. The font-size can be"},{"type":"text","text":" "},{"type":"text","text":"one of the CSS sizes or a numeric point size. The font-weight can be"},{"type":"text","text":" "},{"type":"text","text":"normal or bold. The default is application-dependent, but is a text font"},{"type":"text","text":" "},{"type":"text","text":"vs. a music font."}]}]},{"name":"color","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The color attribute group indicates the color of an element."}]}]},{"name":"halign","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In cases where text extends over more than one line, horizontal"},{"type":"text","text":" "},{"type":"text","text":"alignment and justify values can be different."}]}]},{"name":"valign","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The valign attribute is used to indicate vertical alignment to the top,"},{"type":"text","text":" "},{"type":"text","text":"middle, bottom, or baseline of the text. Defaults are"},{"type":"text","text":" "},{"type":"text","text":"implementation-dependent."}]}]}],"kind":"parameters"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlmeasurenumbering\/init(value:system:staff:alwaysshowsonmultiplerest:showsrangeonmultiplerest:position:font:color:halign:valign:)"]}],"abstract":[{"text":"Creates a new ","type":"text"},{"code":"MXLMeasureNumbering","type":"codeVoice"},{"text":".","type":"text"}],"metadata":{"symbolKind":"init","role":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"value"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL19MXLMeasureNumberingV5ValueO","kind":"typeIdentifier","text":"Value"},{"kind":"text","text":", "},{"kind":"externalParam","text":"system"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL23MXLSystemRelationNumberO","kind":"typeIdentifier","text":"MXLSystemRelationNumber"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"staff"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL14MXLStaffNumberV","kind":"typeIdentifier","text":"MXLStaffNumber"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"alwaysShowsOnMultipleRest"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":