"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"showsRangeOnMultipleRest","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"position","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLPosition","preciseIdentifier":"s:7IvorMXL11MXLPositionV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","kind":"typeIdentifier"},{"text":" = MXLPosition(), ","kind":"text"},{"text":"font","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLFont","preciseIdentifier":"s:7IvorMXL7MXLFontV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","kind":"typeIdentifier"},{"text":" = MXLFont(), ","kind":"text"},{"text":"color","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLColor","preciseIdentifier":"s:7IvorMXL8MXLColorV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"halign","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLLeftCenterRight","preciseIdentifier":"s:7IvorMXL18MXLLeftCenterRightO","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLeftCenterRight","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"valign","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLValign","preciseIdentifier":"s:7IvorMXL9MXLValignO","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValign","kind":"typeIdentifier"},{"text":"? = nil)","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The value of this element.","type":"text"}]}],"name":"value"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Distinguishes measure numbers that are associated with a system rather than the particular part where this element appears.","type":"text"}]}],"name":"system"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The staff used as the reference point for vertical positioning. Refers to staff numbers within the part, from top to bottom on the system. A value of ","type":"text"},{"type":"codeVoice","code":"1"},{"text":" is assumed if not present.","type":"text"}]}],"name":"staff"},{"content":[{"type":"paragraph","inlineContent":[{"text":"A Boolean value indicating whether the measure number should always be shown on a multiple rest, even if the multiple rest starts midway through a system when measure numbering is set to system level.","type":"text"}]}],"name":"alwaysShowsOnMultipleRest"},{"content":[{"type":"paragraph","inlineContent":[{"text":"A Boolean value indicating whether measure numbers on multiple rests display the range of numbers for the first and last measure, rather than just the number of the first measure.","type":"text"}]}],"name":"showsRangeOnMultipleRest"},{"content":[{"type":"paragraph","inlineContent":[{"text":"For most elements, any program will compute a default x and y position. The position attributes let this be changed two ways.","type":"text"}]}],"name":"position"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The font attribute group gathers together attributes for determining the font within a credit or direction. They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font vs. a music font.","type":"text"}]}],"name":"font"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The color attribute group indicates the color of an element.","type":"text"}]}],"name":"color"},{"content":[{"type":"paragraph","inlineContent":[{"text":"In cases where text extends over more than one line, horizontal alignment and justify values can be different. The most typical case is for credits, such as:","type":"text"}]}],"name":"halign"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The valign attribute is used to indicate vertical alignment to the top, middle, bottom, or baseline of the text. Defaults are implementation-dependent.","type":"text"}]}],"name":"valign"}]}],"abstract":[{"text":"Creates a new ","type":"text"},{"code":"MXLMeasureNumbering","type":"codeVoice"},{"text":".","type":"text"}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMeasureNumbering\/init(value:system:staff:alwaysShowsOnMultipleRest:showsRangeOnMultipleRest:position:font:color:halign:valign:)","interfaceLanguage":"swift"},"kind":"symbol","schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLLeftCenterRight":{"type":"topic","kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLLeftCenterRight","kind":"identifier"}],"navigatorTitle":[{"text":"MXLLeftCenterRight","kind":"identifier"}],"abstract":[{"text":"The left-center-right type is used to define horizontal alignment and text justification.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLeftCenterRight","title":"MXLLeftCenterRight","role":"symbol","url":"\/documentation\/ivormxl\/mxlleftcenterright"},"doc://IvorMXL/documentation/IvorMXL/MXLMeasureNumbering/init(value:system:staff:alwaysShowsOnMultipleRest:showsRangeOnMultipleRest:position:font:color:halign:valign:)":{"title":"init(value:system:staff:alwaysShowsOnMultipleRest:showsRangeOnMultipleRest:position:font:color:halign:valign:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"value","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Value","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL19MXLMeasureNumberingV5ValueO"},{"text":", ","kind":"text"},{"text":"system","kind":"externalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL23MXLSystemRelationNumberO","text":"MXLSystemRelationNumber"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"staff"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL14MXLStaffNumberV","text":"MXLStaffNumber"},{"text":"?, ","kind":"text"},{"kind":"externalParam","text":"alwaysShowsOnMultipleRest"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"showsRangeOnMultipleRest","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"position","kind":"externalParam"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLPositionV","text":"MXLPosition"},{"kind":"text","text":", "},{"kind":"externalParam","text":"font"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL7MXLFontV","text":"MXLFont"},{"kind":"text","text":", "},{"kind":"externalParam","text":"color"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLColorV","text":"MXLColor"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"halign"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL18MXLLeftCenterRightO","text":"MXLLeftCenterRight"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"valign"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLValignO","text":"MXLValign"},{"kind":"text","text":"?)"}],"url":"\/documentation\/ivormxl\/mxlmeasurenumbering\/init(value:system:staff:alwaysshowsonmultiplerest:showsrangeonmultiplerest:position:font:color:halign:valign:)","abstract":[{"text":"Creates a new ","type":"text"},{"code":"MXLMeasureNumbering","type":"codeVoice"},{"text":".","type":"text"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMeasureNumbering\/init(value:system:staff:alwaysShowsOnMultipleRest:showsRangeOnMultipleRest:position:font:color:halign:valign:)","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLMeasureNumbering":{"role":"symbol","kind":"symbol","title":"MXLMeasureNumbering","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMeasureNumbering","abstract":[{"text":"The measure-numbering type describes how frequently measure numbers are displayed on this part. The text","type":"text"},{"text":" ","type":"text"},{"text":"attribute from the measure element is used for display, or the number attribute if the text attribute is not","type":"text"},{"text":" ","type":"text"},{"text":"present. Measures with an implicit attribute set to “yes” never display a measure number, regardless of the","type":"text"},{"text":" ","type":"text"},{"text":"measure-numbering setting.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlmeasurenumbering","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLMeasureNumbering"}],"navigatorTitle":[{"kind":"identifier","text":"MXLMeasureNumbering"}]},"doc://IvorMXL/documentation/IvorMXL/MXLStaffNumber":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffNumber","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLStaffNumber"}],"abstract":[{"text":"The staff-number type indicates staff numbers within a multi-staff part. Staves are numbered from top to","type":"text"},{"text":" ","type":"text"},{"text":"bottom, with 1 being the top staff on a part.","type":"text"}],"title":"MXLStaffNumber","kind":"symbol","url":"\/documentation\/ivormxl\/mxlstaffnumber","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLStaffNumber"}]},"doc://IvorMXL/documentation/IvorMXL/MXLPosition":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLPosition"}],"abstract":[{"text":"For most elements, any program will compute a default x and y position. The position attributes let this be","type":"text"},{"text":" ","type":"text"},{"text":"changed two ways.","type":"text"}],"kind":"symbol","title":"MXLPosition","url":"\/documentation\/ivormxl\/mxlposition","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPosition"}]},"doc://IvorMXL/documentation/IvorMXL/MXLFont":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLFont"}],"abstract":[{"text":"The font attribute group gathers together attributes for determining the font within a credit or direction.","type":"text"},{"text":" ","type":"text"},{"text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of","type":"text"},{"text":" ","type":"text"},{"text":"font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric","type":"text"},{"text":" ","type":"text"},{"text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font","type":"text"},{"text":" ","type":"text"},{"text":"vs. a music font.","type":"text"}],"kind":"symbol","title":"MXLFont","url":"\/documentation\/ivormxl\/mxlfont","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFont"}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLSystemRelationNumber":{"type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLSystemRelationNumber"}],"url":"\/documentation\/ivormxl\/mxlsystemrelationnumber","role":"symbol","abstract":[{"text":"The system-relation-number type distinguishes measure numbers that are associated with a system rather than","type":"text"},{"text":" ","type":"text"},{"text":"the particular part where the element appears. A value of only-top or only-bottom indicates that the number","type":"text"},{"type":"text","text":" "},{"text":"should appear only on the top or bottom part of the current system, respectively. A value of also-top or also-","type":"text"},{"text":" ","type":"text"},{"text":"bottom indicates that the number should appear on both the current part and the top or bottom part of the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"current system, respectively. If these values appear in a score, when parts are created the number should only"},{"type":"text","text":" "},{"type":"text","text":"appear once in this part, not twice. A value of none indicates that the number is associated only with the"},{"type":"text","text":" "},{"type":"text","text":"current part, not with the system."}],"kind":"symbol","title":"MXLSystemRelationNumber","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemRelationNumber","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLSystemRelationNumber"}]},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLColor","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","title":"MXLColor","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlcolor"},"doc://IvorMXL/documentation/IvorMXL/MXLMeasureNumbering/Value-swift.enum":{"title":"MXLMeasureNumbering.Value","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Value"}],"url":"\/documentation\/ivormxl\/mxlmeasurenumbering\/value-swift.enum","abstract":[{"text":"The measure-numbering-value type describes how measure numbers are displayed on this part: no numbers, numbers","type":"text"},{"text":" ","type":"text"},{"text":"every measure, or numbers every system.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"Value"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMeasureNumbering\/Value-swift.enum","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLValign":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLValign"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValign","title":"MXLValign","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLValign"}],"abstract":[{"type":"text","text":"The valign type is used to indicate vertical alignment to the top, middle, bottom, or baseline of the text. If"},{"type":"text","text":" "},{"type":"text","text":"the text is on multiple lines, baseline alignment refers to the baseline of the lowest line of text. Defaults"},{"type":"text","text":" "},{"type":"text","text":"are implementation-dependent."}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlvalign"}}}