"text"},{"text":"MXLColor","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","preciseIdentifier":"s:7IvorMXL8MXLColorV","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"halign","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLLeftCenterRight","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLeftCenterRight","preciseIdentifier":"s:7IvorMXL18MXLLeftCenterRightO","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"valign","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLValign","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValign","preciseIdentifier":"s:7IvorMXL9MXLValignO","kind":"typeIdentifier"},{"text":"? = nil)","kind":"text"}],"platforms":["macOS"]}]},{"kind":"parameters","parameters":[{"name":"value","content":[{"type":"paragraph","inlineContent":[{"text":"The value of this element.","type":"text"}]}]},{"name":"system","content":[{"type":"paragraph","inlineContent":[{"text":"Distinguishes measure numbers that are associated with a system rather than the particular part where this element appears.","type":"text"}]}]},{"name":"staff","content":[{"type":"paragraph","inlineContent":[{"text":"The staff used as the reference point for vertical positioning. Refers to staff numbers within the part, from top to bottom on the system. A value of ","type":"text"},{"code":"1","type":"codeVoice"},{"text":" is assumed if not present.","type":"text"}]}]},{"name":"alwaysShowsOnMultipleRest","content":[{"type":"paragraph","inlineContent":[{"text":"A Boolean value indicating whether the measure number should always be shown on a multiple rest, even if the multiple rest starts midway through a system when measure numbering is set to system level.","type":"text"}]}]},{"name":"showsRangeOnMultipleRest","content":[{"type":"paragraph","inlineContent":[{"text":"A Boolean value indicating whether measure numbers on multiple rests display the range of numbers for the first and last measure, rather than just the number of the first measure.","type":"text"}]}]},{"name":"position","content":[{"type":"paragraph","inlineContent":[{"text":"For most elements, any program will compute a default x and y position. The position attributes let this be changed two ways.","type":"text"}]}]},{"name":"font","content":[{"type":"paragraph","inlineContent":[{"text":"The font attribute group gathers together attributes for determining the font within a credit or direction. They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font vs. a music font.","type":"text"}]}]},{"name":"color","content":[{"type":"paragraph","inlineContent":[{"text":"The color attribute group indicates the color of an element.","type":"text"}]}]},{"name":"halign","content":[{"type":"paragraph","inlineContent":[{"text":"In cases where text extends over more than one line, horizontal alignment and justify values can be different. The most typical case is for credits, such as:","type":"text"}]}]},{"name":"valign","content":[{"type":"paragraph","inlineContent":[{"text":"The valign attribute is used to indicate vertical alignment to the top, middle, bottom, or baseline of the text. Defaults are implementation-dependent.","type":"text"}]}]}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","metadata":{"roleHeading":"Initializer","symbolKind":"init","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"value","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Value","preciseIdentifier":"s:7IvorMXL19MXLMeasureNumberingV5ValueO","kind":"typeIdentifier"},{"kind":"text","text":", "},{"text":"system","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLSystemRelationNumber","precis