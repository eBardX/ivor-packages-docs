text":": ","kind":"text"},{"text":"MXLFont","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL7MXLFontV"},{"text":", ","kind":"text"},{"text":"color","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLColor","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLColorV"},{"text":"?, ","kind":"text"},{"text":"halign","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLLeftCenterRight","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL18MXLLeftCenterRightO"},{"text":"?, ","kind":"text"},{"text":"valign","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLValign","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLValignO"},{"text":"?)","kind":"text"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlmeasurenumbering\/init(value:system:staff:alwaysshowsonmultiplerest:showsrangeonmultiplerest:position:font:color:halign:valign:)","abstract":[{"text":"Creates a new ","type":"text"},{"code":"MXLMeasureNumbering","type":"codeVoice"},{"text":".","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLMeasureNumbering/Value-swift.enum":{"navigatorTitle":[{"text":"Value","kind":"identifier"}],"abstract":[{"text":"The measure-numbering-value type describes how measure numbers are displayed on this part: no numbers, numbers","type":"text"},{"text":" ","type":"text"},{"text":"every measure, or numbers every system.","type":"text"}],"title":"MXLMeasureNumbering.Value","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMeasureNumbering\/Value-swift.enum","kind":"symbol","url":"\/documentation\/ivormxl\/mxlmeasurenumbering\/value-swift.enum","type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"kind":"text","text":" "},{"text":"Value","kind":"identifier"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLMeasureNumbering":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMeasureNumbering","title":"MXLMeasureNumbering","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLMeasureNumbering","kind":"identifier"}],"navigatorTitle":[{"text":"MXLMeasureNumbering","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlmeasurenumbering","abstract":[{"text":"The measure-numbering type describes how frequently measure numbers are displayed on this part. The text","type":"text"},{"text":" ","type":"text"},{"text":"attribute from the measure element is used for display, or the number attribute if the text attribute is not","type":"text"},{"text":" ","type":"text"},{"text":"present. Measures with an implicit attribute set to “yes” never display a measure number, regardless of the","type":"text"},{"text":" ","type":"text"},{"text":"measure-numbering setting.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"abstract":[{"text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in","type":"text"},{"type":"text","text":" "},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"title":"MXLColor","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlcolor","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor"},"doc://IvorMXL/documentation/IvorMXL/MXLPosition":{"title":"MXLPosition","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPosition"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlposition","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","abstract":[{"text":"For most elements, any program will compute a default x and y position. The position attributes let this be","type":"text"},{"text":" ","type":"text"},{"text":"changed two ways.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"MXLPosition"}]},"doc://IvorMXL/documentation/IvorMXL/MXLStaffNumber":{"navigatorTitle":[{"text":"MXLStaffNumber","kind":"identifier"}],"abstract":[{"text":"The staff-number type indicates staff numbers within a multi-staff part. Staves are numbered from top to","type":"text"},{"text":" ","type":"text"},{"text":"bottom, with 1 being the top staff on a part.","type":"text"}],"title":"MXLStaffNumber","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffNumber","kind":"symbol","url":"\/documentation\/ivormxl\/mxlstaffnumber","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLStaffNumber","kind":"identifier"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLSystemRelationNumber":{"kind":"symbol","navigatorTitle":[{"text":"MXLSystemRelationNumber","kind":"identifier"}],"title":"MXLSystemRelationNumber","url":"\/documentation\/ivormxl\/mxlsystemrelationnumber","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSystemRelationNumber","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemRelationNumber","abstract":[{"text":"The system-relation-number type distinguishes measure numbers that are associated with a system rather than","type":"text"},{"text":" ","type":"text"},{"text":"the particular part where the element appears. A value of only-top or only-bottom indicates that the number","type":"text"},{"text":" ","type":"text"},{"text":"should appear only on the top or bottom part of the current system, respectively. A value of also-top or also-","type":"text"},{"text":" ","type":"text"},{"text":"bottom indicates that the number should appear on both the current part and the top or bottom part of the","type":"text"},{"text":" ","type":"text"},{"text":"current system, respectively. If these values appear in a score, when parts are created the number should only","type":"text"},{"text":" ","type":"text"},{"text":"appear once in this part, not twice. A value of none indicates that the number is associated only with the","type":"text"},{"text":" ","type":"text"},{"text":"current part, not with the system.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLFont":{"navigatorTitle":[{"text":"MXLFont","kind":"identifier"}],"abstract":[{"text":"The font attribute group gathers together attributes for determining the font within a credit or direction.","type":"text"},{"text":" ","type":"text"},{"text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of","type":"text"},{"text":" ","type":"text"},{"text":"font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric","type":"text"},{"text":" ","type":"text"},{"text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font","type":"text"},{"text":" ","type":"text"},{"text":"vs. a music font.","type":"text"}],"title":"MXLFont","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","kind":"symbol","url":"\/documentation\/ivormxl\/mxlfont","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLFont","kind":"identifier"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"}}}