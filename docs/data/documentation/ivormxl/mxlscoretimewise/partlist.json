h the part-group elements that indicate braces and","type":"text"},{"text":" ","type":"text"},{"text":"brackets between them.","type":"text"}],"title":"partList","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScoreTimewise\/partList","type":"topic","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"partList"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL11MXLPartListV","kind":"typeIdentifier","text":"MXLPartList"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLScoreTimewise":{"abstract":[{"type":"text","text":"The score-timewise element is the root element for a timewise MusicXML score. It includes a score-header group"},{"type":"text","text":" "},{"text":"followed by a series of measures with parts inside. The document-attributes attribute group includes the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"version attribute."}],"title":"MXLScoreTimewise","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLScoreTimewise","kind":"identifier"}],"navigatorTitle":[{"text":"MXLScoreTimewise","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlscoretimewise","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScoreTimewise"},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLPartList":{"navigatorTitle":[{"kind":"identifier","text":"MXLPartList"}],"abstract":[{"text":"The part-list identifies the different musical parts in this document. Each part has an ID that is used later","type":"text"},{"text":" ","type":"text"},{"text":"within the musical data. Since parts may be encoded separately and combined later, identification elements are","type":"text"},{"text":" ","type":"text"},{"text":"present at both the score and score-part levels. There must be at least one score-part, combined as desired","type":"text"},{"text":" ","type":"text"},{"text":"with part-group elements that indicate braces and brackets. Parts are ordered from top to bottom in a score","type":"text"},{"text":" ","type":"text"},{"text":"based on the order in which they appear in the part-list.","type":"text"}],"title":"MXLPartList","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartList","kind":"symbol","url":"\/documentation\/ivormxl\/mxlpartlist","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPartList"}],"role":"symbol"}}}