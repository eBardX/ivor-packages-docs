ation/IvorMXL/MXLScoreTimewise":{"type":"topic","title":"MXLScoreTimewise","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLScoreTimewise"}],"url":"\/documentation\/ivormxl\/mxlscoretimewise","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScoreTimewise","role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLScoreTimewise"}],"abstract":[{"type":"text","text":"The score-timewise element is the root element for a timewise MusicXML score. It includes a score-header group"},{"type":"text","text":" "},{"type":"text","text":"followed by a series of measures with parts inside. The document-attributes attribute group includes the"},{"type":"text","text":" "},{"type":"text","text":"version attribute."}]}}}