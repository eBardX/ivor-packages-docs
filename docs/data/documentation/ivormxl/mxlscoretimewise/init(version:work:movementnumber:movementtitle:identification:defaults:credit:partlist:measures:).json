t/Version":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Version"}],"navigatorTitle":[{"text":"Version","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDocument\/Version","kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxldocument\/version","abstract":[{"text":"A MusicXML version number.","type":"text"}],"title":"MXLDocument.Version","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLWork":{"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLWork","title":"MXLWork","navigatorTitle":[{"kind":"identifier","text":"MXLWork"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLWork"}],"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlwork","abstract":[{"type":"text","text":"Works are optionally identified by number and title. The work type also may indicate a link to the opus"},{"type":"text","text":" "},{"type":"text","text":"document that composes multiple scores into a collection."}]},"doc://IvorMXL/documentation/IvorMXL/MXLPartList":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlpartlist","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartList","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPartList","kind":"identifier"}],"abstract":[{"text":"The part-list identifies the different musical parts in this document. Each part has an ID that is used later","type":"text"},{"text":" ","type":"text"},{"text":"within the musical data. Since parts may be encoded separately and combined later, identification elements are","type":"text"},{"text":" ","type":"text"},{"text":"present at both the score and score-part levels. There must be at least one score-part, combined as desired","type":"text"},{"text":" ","type":"text"},{"text":"with part-group elements that indicate braces and brackets. Parts are ordered from top to bottom in a score","type":"text"},{"text":" ","type":"text"},{"text":"based on the order in which they appear in the part-list.","type":"text"}],"kind":"symbol","type":"topic","navigatorTitle":[{"text":"MXLPartList","kind":"identifier"}],"title":"MXLPartList"},"doc://IvorMXL/documentation/IvorMXL/MXLScoreTimewise/Measure":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Measure","kind":"identifier"}],"navigatorTitle":[{"text":"Measure","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScoreTimewise\/Measure","kind":"symbol","role":"symbol","title":"MXLScoreTimewise.Measure","abstract":[{"text":"Maps the MusicXML ","type":"text"},{"type":"codeVoice","code":"<measure>"},{"text":" element.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlscoretimewise\/measure"},"doc://IvorMXL/documentation/IvorMXL/MXLScoreTimewise":{"title":"MXLScoreTimewise","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLScoreTimewise"}],"abstract":[{"text":"The score-timewise element is the root element for a timewise MusicXML score. It includes a score-header group","type":"text"},{"text":" ","type":"text"},{"text":"followed by a series of measures with parts inside. The document-attributes attribute group includes the","type":"text"},{"text":" ","type":"text"},{"text":"version attribute.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScoreTimewise","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLScoreTimewise"}],"url":"\/documentation\/ivormxl\/mxlscoretimewise"},"doc://IvorMXL/documentation/IvorMXL/MXLIdentification":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlidentification","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLIdentification","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLIdentification"}],"kind":"symbol","abstract":[{"text":"Identification contains basic metadata about the score. It includes information that may apply at a score-","type":"text"},{"text":" ","type":"text"},{"text":"wide, movement-wide, or part-wide level. The creator, rights, source, and relation elements are based on","type":"text"},{"text":" ","type":"text"},{"text":"Dublin Core.","type":"text"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLIdentification"}],"title":"MXLIdentification"},"doc://IvorMXL/documentation/IvorMXL/MXLDefaults":{"role":"symbol","url":"\/documentation\/ivormxl\/mxldefaults","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDefaults","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLDefaults","kind":"identifier"}],"abstract":[{"text":"The defaults type specifies score-wide defaults for scaling; whether or not the file is a concert score;","type":"text"},{"text":" ","type":"text"},{"text":"layout; and default values for the music font, word font, lyric font, and lyric language. Except for the","type":"text"},{"text":" ","type":"text"},{"text":"concert-score element, if any defaults are missing, the choice of what to use is determined by the","type":"text"},{"text":" ","type":"text"},{"text":"application.","type":"text"}],"kind":"symbol","type":"topic","navigatorTitle":[{"text":"MXLDefaults","kind":"identifier"}],"title":"MXLDefaults"},"doc://IvorMXL/documentation/IvorMXL/MXLCredit":{"title":"MXLCredit","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLCredit"}],"abstract":[{"text":"The credit type represents the appearance of the title, composer, arranger, lyricist, copyright, dedication,","type":"text"},{"text":" ","type":"text"},{"text":"and other text, symbols, and graphics that commonly appear on the first page of a score. The credit-words,","type":"text"},{"text":" ","type":"text"},{"text":"credit-symbol, and credit-image elements are similar to the words, symbol, and image elements for directions.","type":"text"},{"text":" ","type":"text"},{"text":"However, since the credit is not part of a measure, the default-x and default-y attributes adjust the origin","type":"text"},{"text":" ","type":"text"},{"text":"relative to the bottom left-hand corner of the page. The enclosure for credit-words and credit-symbol is none","type":"text"},{"text":" ","type":"text"},{"text":"by default.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCredit","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLCredit"}],"url":"\/documentation\/ivormxl\/mxlcredit"},"doc://IvorMXL/documentation/IvorMXL/MXLScoreTimewise/init(version:work:movementNumber:movementTitle:identification:defaults:credit:partList:measures:)":{"url":"\/documentation\/ivormxl\/mxlscoretimewise\/init(version:work:movementnumber:movementtitle:identification:defaults:credit:partlist:measures:)","abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLScoreTimewise"},{"type":"text","text":"."}],"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"version"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLDocumentV","text":"MXLDocument"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLDocumentV7VersionV","text":"Version"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"work"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL7MXLWorkV","text":"MXLWork"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"movementNumber"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"movementTitle"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","t