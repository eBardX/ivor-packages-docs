am"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL11MXLDefaultsV","text":"MXLDefaults","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"credit","kind":"externalParam"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:7IvorMXL9MXLCreditV","text":"MXLCredit","kind":"typeIdentifier"},{"text":"], ","kind":"text"},{"text":"partList","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL11MXLPartListV","text":"MXLPartList","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"measures","kind":"externalParam"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:7IvorMXL16MXLScoreTimewiseV7MeasureV","text":"Measure","kind":"typeIdentifier"},{"text":"])","kind":"text"}],"abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLScoreTimewise"},{"type":"text","text":"."}],"title":"init(version:work:movementNumber:movementTitle:identification:defaults:credit:partList:measures:)"},"doc://IvorMXL/documentation/IvorMXL/MXLDocument":{"type":"topic","title":"MXLDocument","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDocument","abstract":[{"text":"A top-level document parsed from a MusicXML file.","type":"text"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLDocument"}],"navigatorTitle":[{"kind":"identifier","text":"MXLDocument"}],"url":"\/documentation\/ivormxl\/mxldocument"},"doc://IvorMXL/documentation/IvorMXL/MXLScoreTimewise":{"type":"topic","title":"MXLScoreTimewise","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScoreTimewise","abstract":[{"text":"The score-timewise element is the root element for a timewise MusicXML score. It includes a score-header group","type":"text"},{"text":" ","type":"text"},{"text":"followed by a series of measures with parts inside. The document-attributes attribute group includes the","type":"text"},{"text":" ","type":"text"},{"text":"version attribute.","type":"text"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLScoreTimewise"}],"navigatorTitle":[{"kind":"identifier","text":"MXLScoreTimewise"}],"url":"\/documentation\/ivormxl\/mxlscoretimewise"},"doc://IvorMXL/documentation/IvorMXL/MXLIdentification":{"title":"MXLIdentification","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLIdentification","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlidentification","role":"symbol","navigatorTitle":[{"text":"MXLIdentification","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLIdentification","abstract":[{"text":"Identification contains basic metadata about the score. It includes information that may apply at a score-","type":"text"},{"text":" ","type":"text"},{"text":"wide, movement-wide, or part-wide level. The creator, rights, source, and relation elements are based on","type":"text"},{"text":" ","type":"text"},{"text":"Dublin Core.","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLWork":{"type":"topic","title":"MXLWork","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLWork","abstract":[{"type":"text","text":"Works are optionally identified by number and title. The work type also may indicate a link to the opus"},{"type":"text","text":" "},{"type":"text","text":"document that composes multiple scores into a collection."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLWork"}],"navigatorTitle":[{"kind":"identifier","text":"MXLWork"}],"url":"\/documentation\/ivormxl\/mxlwork"},"doc://IvorMXL/documentation/IvorMXL/MXLCredit":{"type":"topic","abstract":[{"text":"The credit type represents the appearance of the title, composer, arranger, lyricist, copyright, dedication,","type":"text"},{"text":" ","type":"text"},{"text":"and other text, symbols, and graphics that commonly appear on the first page of a score. The credit-words,","type":"text"},{"text":" ","type":"text"},{"text":"credit-symbol, and credit-image elements are similar to the words, symbol, and image elements for directions.","type":"text"},{"text":" ","type":"text"},{"text":"However, since the credit is not part of a measure, the default-x and default-y attributes adjust the origin","type":"text"},{"text":" ","type":"text"},{"text":"relative to the bottom left-hand corner of the page. The enclosure for credit-words and credit-symbol is none","type":"text"},{"text":" ","type":"text"},{"text":"by default.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlcredit","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLCredit"}],"kind":"symbol","title":"MXLCredit","navigatorTitle":[{"kind":"identifier","text":"MXLCredit"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCredit","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLDocument/Version":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML version number."}],"url":"\/documentation\/ivormxl\/mxldocument\/version","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Version"}],"kind":"symbol","title":"MXLDocument.Version","navigatorTitle":[{"kind":"identifier","text":"Version"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDocument\/Version","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLScoreTimewise/Measure":{"type":"topic","title":"MXLScoreTimewise.Measure","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScoreTimewise\/Measure","abstract":[{"text":"A measure within a time-wise score, containing each part’s music for that measure.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Measure"}],"n