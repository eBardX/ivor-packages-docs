externalParam"},{"text":": [","kind":"text"},{"text":"Measure","preciseIdentifier":"s:7IvorMXL16MXLScoreTimewiseV7MeasureV","kind":"typeIdentifier"},{"text":"])","kind":"text"}],"type":"topic","abstract":[{"text":"Creates a new ","type":"text"},{"code":"MXLScoreTimewise","type":"codeVoice"},{"text":".","type":"text"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLScoreTimewise":{"role":"symbol","abstract":[{"text":"The score-timewise element is the root element for a timewise MusicXML score. It includes a score-header group","type":"text"},{"text":" ","type":"text"},{"text":"followed by a series of measures with parts inside. The document-attributes attribute group includes the","type":"text"},{"text":" ","type":"text"},{"text":"version attribute.","type":"text"}],"title":"MXLScoreTimewise","url":"\/documentation\/ivormxl\/mxlscoretimewise","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScoreTimewise","navigatorTitle":[{"kind":"identifier","text":"MXLScoreTimewise"}],"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLScoreTimewise"}]},"doc://IvorMXL/documentation/IvorMXL/MXLDocument/Version":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDocument\/Version","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Version"}],"abstract":[{"text":"A MusicXML version number.","type":"text"}],"title":"MXLDocument.Version","kind":"symbol","url":"\/documentation\/ivormxl\/mxldocument\/version","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Version"}]},"doc://IvorMXL/documentation/IvorMXL/MXLIdentification":{"kind":"symbol","title":"MXLIdentification","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLIdentification"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlidentification","navigatorTitle":[{"text":"MXLIdentification","kind":"identifier"}],"abstract":[{"text":"Identification contains basic metadata about the score. It includes information that may apply at a score-","type":"text"},{"text":" ","type":"text"},{"text":"wide, movement-wide, or part-wide level. The creator, rights, source, and relation elements are based on","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Dublin Core."}],"role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLIdentification"},"doc://IvorMXL/documentation/IvorMXL/MXLCredit":{"type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLCredit","kind":"identifier"}],"navigatorTitle":[{"text":"MXLCredit","kind":"identifier"}],"abstract":[{"text":"The credit type represents the appearance of the title, composer, arranger, lyricist, copyright, dedication,","type":"text"},{"text":" ","type":"text"},{"text":"and other text, symbols, and graphics that commonly appear on the first page of a score. The credit-words,","type":"text"},{"text":" ","type":"text"},{"text":"credit-symbol, and credit-image elements are similar to the words, symbol, and image elements for directions.","type":"text"},{"text":" ","type":"text"},{"text":"However, since the credit is not part of a measure, the default-x and default-y attributes adjust the origin","type":"text"},{"text":" ","type":"text"},{"text":"relative to the bottom left-hand corner of the page. The enclosure for credit-words and credit-symbol is none","type":"text"},{"text":" ","type":"text"},{"text":"by default.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCredit","title":"MXLCredit","role":"symbol","url":"\/documentation\/ivormxl\/mxlcredit"},"doc://IvorMXL/documentation/IvorMXL/MXLWork":{"navigatorTitle":[{"text":"MXLWork","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLWork","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlwork","abstract":[{"type":"text","text":"Works are optionally identified by number and title. The work type also may indicate a link to the opus"},{"type":"text","text":" "},{"type":"text","text":"document that composes multiple scores into a collection."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLWork","kind":"symbol","title":"MXLWork","type":"topic","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLScoreTimewise/Measure":{"role":"symbol","abstract":[{"text":"Maps the MusicXML ","type":"text"},{"type":"codeVoice","code":"<measure>"},{"text":" element.","type":"text"}],"title":"MXLScoreTimewise.Measure","url":"\/documentation\/ivormxl\/mxlscoretimewise\/measure","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScoreTimewise\/Measure","navigatorTitle":[{"kind":"identifier","text":"Measure"}],"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Measure"}]},"doc://IvorMXL/documentation/IvorMXL/MXLDocument":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDocument","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLDocument"}],"abstract":[{"text":"A top-level document parsed from a MusicXML file.","type":"text"}],"title":"MXLDocument","kind":"symbol","url":"\/documentation\/ivormxl\/mxldocument","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLDocument"}]},"doc://IvorMXL/documentation/IvorMXL/MXLDefaults":{"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxldefaults","abstract":[{"type":"text","text":"The defaults type specifies score-wide defaults for scaling; whether or not the file is a concert score;"},{"type":"text","text":" "},{"type":"text","text":"layout; and default values for the music font, word font, lyric font, and lyric language. Except for the"},{"type":"text","text":" "},{"type":"text","text":"concert-score element, if any defaults are missing, the choice of what to use is determined by the"},{"type":"text","text":" "},{"type":"text","text":"application."}],"navigatorTitle":[{"text":"MXLDefaults","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLDefaults","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDefaults","title":"MXLDefaults"},"doc://IvorMXL/documentation/IvorMXL/MXLPartList":{"title":"MXLPartList","navigatorTitle":[{"text":"MXLPartList","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"The part-list identifies the different musical parts in this document. Each part has an ID that is used later"},{"type":"text","text":" "},{"type":"text","text":"within the musical data. Since parts may be encoded separately and combined later, identification elements are"},{"type":"text","text":" "},{"type":"text","text":"present at both the score and score-part levels. There must be at least one score-part, combined as desired"},{"type":"text","text":" "},{"type":"text","text":"with part-group elements that indicate braces and brackets. Parts are ordered from top to bottom in a score"},{"type":"text","text":" "},{"type":"text","text":"based on the order in which they appear in the part-list."}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPartList","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartList","url":"\/documentation\/ivormxl\/mxlpartlist"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"}}}