,"type":"text"},{"code":"1.0","type":"codeVoice"},{"text":" if not specified.","type":"text"}]}]},{"name":"work","content":[{"type":"paragraph","inlineContent":[{"text":"The work that identifies the piece, optionally including its number and title.","type":"text"}]}]},{"name":"movementNumber","content":[{"type":"paragraph","inlineContent":[{"text":"The movement-number element specifies the number of a movement.","type":"text"}]}]},{"name":"movementTitle","content":[{"type":"paragraph","inlineContent":[{"text":"The movement-title element specifies the title of a movement, not including its number.","type":"text"}]}]},{"name":"identification","content":[{"type":"paragraph","inlineContent":[{"text":"The identification metadata for the score, such as creators, rights, source, and relation information.","type":"text"}]}]},{"name":"defaults","content":[{"type":"paragraph","inlineContent":[{"text":"The score-wide defaults for scaling, layout, and default font and language values.","type":"text"}]}]},{"name":"credit","content":[{"type":"paragraph","inlineContent":[{"text":"The credits — such as title, composer, and copyright notices — that appear on the first or following pages of the score.","type":"text"}]}]},{"name":"partList","content":[{"type":"paragraph","inlineContent":[{"text":"The list of parts that make up the score, along with the part-group elements that indicate braces and brackets between them.","type":"text"}]}]},{"name":"measures","content":[{"type":"paragraph","inlineContent":[{"text":"The measures that make up the score, in the same order as they appear in the score.","type":"text"}]}]}],"kind":"parameters"}],"references":{"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLScoreTimewise":{"type":"topic","title":"MXLScoreTimewise","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLScoreTimewise"}],"url":"\/documentation\/ivormxl\/mxlscoretimewise","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScoreTimewise","role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLScoreTimewise"}],"abstract":[{"type":"text","text":"The score-timewise element is the root element for a timewise MusicXML score. It includes a score-header group"},{"type":"text","text":" "},{"type":"text","text":"followed by a series of measures with parts inside. The document-attributes attribute group includes the"},{"type":"text","text":" "},{"type":"text","text":"version attribute."}]},"doc://IvorMXL/documentation/IvorMXL/MXLDocument":{"type":"topic","title":"MXLDocument","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLDocument"}],"url":"\/documentation\/ivormxl\/mxldocument","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDocument","role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLDocument"}],"abstract":[{"type":"text","text":"A top-level document parsed from a MusicXML file."}]},"doc://IvorMXL/documentation/IvorMXL/MXLWork":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlwork","title":"MXLWork","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLWork"}],"navigatorTitle":[{"text":"MXLWork","kind":"identifier"}],"abstract":[{"type":"text","text":"Works are optionally identified by number and title. The work type also may indicate a link to the opus"},{"type":"text","text":" "},{"type":"text","text":"document that composes multiple scores into a collection."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLWork"},"doc://IvorMXL/documentation/IvorMXL/MXLDocument/Version":{"role":"symbol","url":"\/documentation\/ivormxl\/mxldocument\/version","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Version","kind":"identifier"}],"navigatorTitle":[{"text":"Version","kind":"identifier"}],"abstract":[{"type":"text","text":"A MusicXML version number."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDocument\/Version","title":"MXLDocument.Version","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLCredit":{"url":"\/documentation\/ivormxl\/mxlcredit","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCredit","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLCredit"}],"title":"MXLCredit","abstract":[{"type":"text","text":"The credit type represents the appearance of the title, composer, arranger, lyricist, copyright, dedication,"},{"type":"text","text":" "},{"type":"text","text":"and other text, symbols, and graphics that commonly appear on the first page of a score. The credit-words,"},{"type":"text","text":" "},{"type":"text","text":"credit-symbol, and credit-image elements are similar to the words, symbol, and image elements for directions."},{"type":"text","text":" "},{"type":"text","text":"However, since the credit is not part of a measure, the default-x and default-y attributes adjust the origin"},{"type":"text","text":" "},{"type":"text","text":"relative to the bottom left-hand corner of the page. The enclosure for credit-words and credit-symbol is none"},{"type":"text","text":" "},{"type":"text","text":"by default."}],"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLCredit"}]},"doc://IvorMXL/documentation/IvorMXL/MXLPartList":{"type":"topic","title":"MXLPartList","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPartList"}],"url":"\/documentation\/ivormxl\/mxlpartlist","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartList","role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLPartList"}],"abstract":[{"type":"text","text":"The part-list identifies the different musical parts in this document. Each part has an ID that is used later"},{"type":"text","text":" "},{"type":"text","text":"within the musical data. Since parts may be encoded separately and combined later, identification elements are"},{"type":"text","text":" "},{"type":"text","text":"present at both the score and score-part levels. There must be at least one score-part, combined as desired"},{"type":"text","text":" "},{"type":"text","text":"with part-group elements that indicate braces and brackets. Parts are ordered from top to bottom in a score"},{"type":"text","text":" "},{"type":"text","text":"based on the order in which they appear in the part-list."}]},"doc://IvorMXL/documentation/IvorMXL/MXLScoreTimewise/init(version:work:movementNumber:movementTitle:identification:defaults:credit:partList:measures:)":{"title":"init(version:work:movementNumber:movementTitle:identification:defaults:credit:partList:measures:)","url":"\/documentation\/ivormxl\/mxlscoretimewise\/init(version:work:movementnumber:movementtitle:identification:defaults:credit:partlist:measures:)","abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLScoreTimewise"},{"type":"text","text":"."}],"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"version"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLDocument","preciseIdentifier":"s:7IvorMXL11MXLDocumentV"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Version","preciseIdentifier":"s:7IvorMXL11MXLDocumentV7VersionV"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"work"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLWork","preciseIdentifier":"s:7IvorMXL7MXLWorkV"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"movementNumber"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"movementTitle"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"identification"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLIdentification","preciseIdentifier":"s:7IvorMXL17MXLIdentificationV"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"defaults"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLDefaults","preciseIdentifier":"s:7IvorMXL11MXLDefaultsV"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"credit"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"MXLCredit","preciseIdentifier":"s:7IvorMXL9MXLCreditV"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"partList"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLPartList","preciseIdentifier":"s:7IvorMXL11MXLPartListV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"measures"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"Measure","preciseIdentifier":"s:7IvorMXL16MXLScoreTimewiseV7MeasureV"},{"kind":"text","text":"])"}],"kind":"symbol","type":"topic","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScoreTimewise\/init(version:work:movementNumber:movementTitle:identification:defaults:credit:partList:measures:)"},"doc://IvorMXL/documentation/IvorMXL/MXLIdentification":{"type":"topic","title":"MXLIdentification","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLIdentification","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlidentification","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLIdentification","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"MXLIdentification","kind":"identifier"}],"abstract":[{"text":"Identification contains basic metadata about the score. It includes information that may apply at a score-","type":"text"},{"text":" ","type":"text"},{"text":"wide, movement-wide, or part-wide level. The creator, rights, source, and relation elements are based on","type":"text"},{"text":" ","type":"text"},{"text":"Dublin Core.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLScoreTimewise/Measure":{"type":"topic","title":"MXLScoreTimewise.Measure","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Measure"}],"url":"\/documentation\/ivormxl\/mxlscoretimewise\/measure","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScoreTimewise\/Measure","role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Measure"}],"abstract":[{"type":"text","text":"Maps the MusicXML "},{"type":"codeVoice","code":"<measure>"},{"type":"text","text":" element."}]},"doc://IvorMXL/documentation/IvorMXL/MXLDefaults":{"navigatorTitle":[{"text":"MXLDefaults","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLDefaults","kind":"identifier"}],"abstract":[{"type":"text","text":"The defaults type specifies score-wide defaults for scaling; whether or not the file is a concert score;"},{"type":"text","text":" "},{"type":"text","text":"layout; and default values for the music font, word font, lyric font, and lyric language. Except for the"},{"type":"text","text":" "},{"type":"text","text":"concert-score element, if any defaults are missing, the choice of what to use is determined by the"},{"type":"text","text":" "},{"type":"text","text":"application."}],"role":"symbol","url":"\/documentation\/ivormxl\/mxldefaults","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDefaults","title":"MXLDefaults","kind":"symbol"}}}