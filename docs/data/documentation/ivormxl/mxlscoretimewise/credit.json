entifier","text":"MXLCredit"}],"abstract":[{"text":"The credit type represents the appearance of the title, composer, arranger, lyricist, copyright, dedication,","type":"text"},{"text":" ","type":"text"},{"text":"and other text, symbols, and graphics that commonly appear on the first page of a score. The credit-words,","type":"text"},{"text":" ","type":"text"},{"text":"credit-symbol, and credit-image elements are similar to the words, symbol, and image elements for directions.","type":"text"},{"text":" ","type":"text"},{"text":"However, since the credit is not part of a measure, the default-x and default-y attributes adjust the origin","type":"text"},{"text":" ","type":"text"},{"text":"relative to the bottom left-hand corner of the page. The enclosure for credit-words and credit-symbol is none","type":"text"},{"text":" ","type":"text"},{"text":"by default.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCredit","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLCredit"}],"url":"\/documentation\/ivormxl\/mxlcredit"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLScoreTimewise/credit":{"title":"credit","kind":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"credit"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:7IvorMXL9MXLCreditV","kind":"typeIdentifier","text":"MXLCredit"},{"kind":"text","text":"]"}],"abstract":[{"text":"The credits — such as title, composer, and copyright notices — that appear on the first or following pages","type":"text"},{"text":" ","type":"text"},{"text":"of the score.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScoreTimewise\/credit","role":"symbol","url":"\/documentation\/ivormxl\/mxlscoretimewise\/credit"},"doc://IvorMXL/documentation/IvorMXL/MXLScoreTimewise":{"title":"MXLScoreTimewise","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLScoreTimewise"}],"abstract":[{"text":"The score-timewise element is the root element for a timewise MusicXML score. It includes a score-header group","type":"text"},{"text":" ","type":"text"},{"text":"followed by a series of measures with parts inside. The document-attributes attribute group includes the","type":"text"},{"text":" ","type":"text"},{"text":"version attribute.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScoreTimewise","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLScoreTimewise"}],"url":"\/documentation\/ivormxl\/mxlscoretimewise"}}}