nd":"identifier","text":"credit"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:7IvorMXL9MXLCreditV","kind":"typeIdentifier","text":"MXLCredit"},{"kind":"text","text":"]"}],"url":"\/documentation\/ivormxl\/mxlscoretimewise\/credit","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScoreTimewise\/credit","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"The credits — such as title, composer, and copyright notices — that appear on the first or following pages"},{"type":"text","text":" "},{"type":"text","text":"of the score."}]},"doc://IvorMXL/documentation/IvorMXL/MXLScoreTimewise":{"type":"topic","title":"MXLScoreTimewise","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLScoreTimewise"}],"url":"\/documentation\/ivormxl\/mxlscoretimewise","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScoreTimewise","role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLScoreTimewise"}],"abstract":[{"type":"text","text":"The score-timewise element is the root element for a timewise MusicXML score. It includes a score-header group"},{"type":"text","text":" "},{"type":"text","text":"followed by a series of measures with parts inside. The document-attributes attribute group includes the"},{"type":"text","text":" "},{"type":"text","text":"version attribute."}]},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLCredit":{"url":"\/documentation\/ivormxl\/mxlcredit","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCredit","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLCredit"}],"title":"MXLCredit","abstract":[{"type":"text","text":"The credit type represents the appearance of the title, composer, arranger, lyricist, copyright, dedication,"},{"type":"text","text":" "},{"type":"text","text":"and other text, symbols, and graphics that commonly appear on the first page of a score. The credit-words,"},{"type":"text","text":" "},{"type":"text","text":"credit-symbol, and credit-image elements are similar to the words, symbol, and image elements for directions."},{"type":"text","text":" "},{"type":"text","text":"However, since the credit is not part of a measure, the default-x and default-y attributes adjust the origin"},{"type":"text","text":" "},{"type":"text","text":"relative to the bottom left-hand corner of the page. The enclosure for credit-words and credit-symbol is none"},{"type":"text","text":" "},{"type":"text","text":"by default."}],"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLCredit"}]}}}