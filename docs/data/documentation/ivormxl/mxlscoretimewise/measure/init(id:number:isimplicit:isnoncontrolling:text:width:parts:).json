","text":"Part","kind":"typeIdentifier"},{"text":"] = [])","kind":"text"}]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The optional-unique-id attribute group allows an element to optionally"},{"type":"text","text":" "},{"type":"text","text":"specify an ID that is unique to the entire document. This attribute group is"},{"type":"text","text":" "},{"type":"text","text":"not used for a required id attribute, or for an id attribute that specifies"},{"type":"text","text":" "},{"type":"text","text":"an id reference."}]}],"name":"id"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The measure number. In partwise files, this should be the same for measures"},{"type":"text","text":" "},{"type":"text","text":"in different parts that share the same left barline. Often numeric, but not"},{"type":"text","text":" "},{"type":"text","text":"required to be; non-numeric values are typically combined with "},{"type":"codeVoice","code":"implicit"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"codeVoice","code":"nonControlling"},{"type":"text","text":" set to "},{"type":"codeVoice","code":"true"},{"type":"text","text":". For a pickup measure, this is typically "},{"type":"codeVoice","code":"\"0\""},{"type":"text","text":" "},{"type":"text","text":"with "},{"type":"codeVoice","code":"implicit"},{"type":"text","text":" set to "},{"type":"codeVoice","code":"true"},{"type":"text","text":"."}]}],"name":"number"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A Boolean value indicating whether the measure number should never appear,"},{"type":"text","text":" "},{"type":"text","text":"such as for pickup measures and the last half of mid-measure repeats."},{"type":"text","text":" "},{"type":"text","text":"Defaults to "},{"type":"codeVoice","code":"false"},{"type":"text","text":" if not specified."}]}],"name":"isImplicit"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A Boolean value indicating whether the left barline in this measure does not"},{"text":" ","type":"text"},{"text":"coincide with the left barline of measures in other parts, as in multimetric","type":"text"},{"text":" ","type":"text"},{"text":"music like the Don Giovanni minuet. Defaults to ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" if not specified.","type":"text"}]}],"name":"isNonControlling"},{"content":[{"inlineContent":[{"type":"text","text":"The displayed measure number, when different from the value of "},{"type":"codeVoice","code":"number"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Ignored when "},{"type":"codeVoice","code":"implicit"},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":"."}],"type":"paragraph"}],"name":"text"},{"content":[{"inlineContent":[{"type":"text","text":"The width of the measure, in tenths, from barline or system start to barline"},{"text":" ","type":"text"},{"text":"or system end. These are the global tenths defined by the scaling element,","type":"text"},{"text":" ","type":"text"},{"text":"not local tenths as modified by the staff-size element.","type":"text"}],"type":"paragraph"}],"name":"width"},{"content":[{"inlineContent":[{"text":"The parts that make up this measure.","type":"text"}],"type":"paragraph"}],"name":"parts"}]}],"metadata":{"symbolKind":"init","title":"init(id:number:isImplicit:isNonControlling:text:width:parts:)","modules":[{"name":"IvorMXL"}],"roleHeading":"Initializer","externalID":"s:7IvorMXL16MXLScoreTimewiseV7MeasureV2id6number10isImplicit0H14NonControlling4text5width5partsAESSSg_SSSbSgAnA14MXLMeasureTextVSgSdSgSayAE4PartVGtcfc","role":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"id"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","t