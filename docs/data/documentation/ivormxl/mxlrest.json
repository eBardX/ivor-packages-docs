{"sections":[],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRest","interfaceLanguage":"swift"},"topicSections":[{"generated":true,"anchor":"Initializers","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRest\/init(displayStepOctave:measure:)"],"title":"Initializers"},{"generated":true,"anchor":"Instance-Properties","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRest\/displayStepOctave","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRest\/measure"],"title":"Instance Properties"},{"generated":true,"anchor":"Default-Implementations","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRest\/Equatable-Implementations"],"title":"Default Implementations"}],"seeAlsoSections":[{"generated":true,"anchor":"Music","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMusicItem","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFullNote","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPitch","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound"],"title":"Music"}],"variants":[{"paths":["\/documentation\/ivormxl\/mxlrest"],"traits":[{"interfaceLanguage":"swift"}]}],"relationshipsSections":[{"identifiers":["doc:\/\/IvorMXL\/s8CopyableP","doc:\/\/IvorMXL\/SQ","doc:\/\/IvorMXL\/s9EscapableP","doc:\/\/IvorMXL\/SH","doc:\/\/IvorMXL\/s8SendableP","doc:\/\/IvorMXL\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships","title":"Conforms To"}],"abstract":[{"type":"text","text":"The rest element indicates notated rests or silences. Rest elements are usually empty, but placement on the"},{"type":"text","text":" "},{"type":"text","text":"staff can be specified using display-step and display-octave elements. If the measure attribute is set to yes,"},{"type":"text","text":" "},{"type":"text","text":"this indicates this is a complete measure rest."}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLRest","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"inlineContent":[{"text":"Maps the MusicXML ","type":"text"},{"code":"<rest>","type":"codeVoice"},{"text":" element.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"metadata":{"title":"MXLRest","navigatorTitle":[{"text":"MXLRest","kind":"identifier"}],"role":"symbol","externalID":"s:7IvorMXL7MXLRestV","roleHeading":"Structure","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLRest","kind":"identifier"}],"modules":[{"name":"IvorMXL"}],"symbolKind":"struct"},"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL"]]},"references":{"doc://IvorMXL/s8SendableP":{"title":"Swift.Sendable","identifier":"doc:\/\/IvorMXL\/s8SendableP","type":"unresolvable"},"doc://IvorMXL/documentation/IvorMXL/MXLMusicItem":{"type":"topic","title":"MXLMusicItem","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMusicItem","abstract":[{"type":"text","text":"One of the alternatives for a music item."}],"role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLMusicItem","kind":"identifier"}],"navigatorTitle":[{"text":"MXLMusicItem","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlmusicitem"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection":{"type":"topic","title":"MXLDirection","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection","abstract":[{"type":"text","text":"A direction is a musical indication that is not necessarily attached to a specific note. Two or more may be"},{"type":"text","text":" "},{"type":"text","text":"combined to indicate words followed by the start of a dashed line, the end of a wedge followed by dynamics,"},{"type":"text","text":" "},{"type":"text","text":"etc. For applications where a specific direction is indeed attached to a specific note, the direction element"},{"type":"text","text":" "},{"type":"text","text":"can be associated with the first note element that follows it in score order that is not in a different voice."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLDirection"}],"navigatorTitle":[{"kind":"identifier","text":"MXLDirection"}],"url":"\/documentation\/ivormxl\/mxldirection"},"doc://IvorMXL/s9EscapableP":{"title":"Swift.Escapable","identifier":"doc:\/\/IvorMXL\/s9EscapableP","type":"unresolvable"},"doc://IvorMXL/documentation/IvorMXL/MXLRest/Equatable-Implementations":{"title":"Equatable Implementations","role":"collectionGroup","url":"\/documentation\/ivormxl\/mxlrest\/equatable-implementations","abstract":[],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRest\/Equatable-Implementations","kind":"article"},"doc://IvorMXL/documentation/IvorMXL/MXLFullNote":{"title":"MXLFullNote","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFullNote"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlfullnote","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLFullNote"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFullNote","abstract":[{"text":"The full-note group is a sequence of the common note elements between cue\/grace notes and regular (full)","type":"text"},{"text":" ","type":"text"},{"text":"notes: pitch, chord, and rest information, but not duration (cue and grace notes do not have duration","type":"text"},{"text":" ","type":"text"},{"text":"encoded). Unpitched elements are used for unpitched percussion, speaking voice, and other musical elements","type":"text"},{"text":" ","type":"text"},{"text":"lacking determinate pitch.","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLRest/measure":{"title":"measure","role":"symbol","url":"\/documentation\/ivormxl\/mxlrest\/measure","abstract":[{"type":"text","text":"A Boolean value indicating whether this represents a complete measure rest."}],"type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"measure","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":"?","kind":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRest\/measure","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLRest/init(displayStepOctave:measure:)":{"title":"init(displayStepOctave:measure:)","role":"symbol","url":"\/documentation\/ivormxl\/mxlrest\/init(displaystepoctave:measure:)","abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLRest"},{"type":"text","text":"."}],"type":"topic","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"displayStepOctave","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLDisplayStepOctave","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL20MXLDisplayStepOctaveV"},{"text":"?, ","kind":"text"},{"text":"measure","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":"?)","kind":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRest\/init(displayStepOctave:measure:)","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLPitch":{"title":"MXLPitch","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPitch","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlpitch","role":"symbol","navigatorTitle":[{"text":"MXLPitch","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPitch","abstract":[{"type":"text","text":"Pitch is represented as a combination of the step of the diatonic scale, the chromatic alteration, and the"},{"type":"text","text":" "},{"type":"text","text":"octave."}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLBarline"}],"abstract":[{"text":"If a barline is other than a normal single barline, it should be represented by a barline type that describes","type":"text"},{"text":" ","type":"text"},{"text":"it. This includes information about repeats and multiple endings, as well as line style. Barline data is on","type":"text"},{"text":" ","type":"text"},{"text":"the same level as the other musical data in a score — a child of a measure in a partwise score, or a part in a","type":"text"},{"text":" ","type":"text"},{"text":"timewise score. This allows for barlines within measures, as in dotted barlines that subdivide measures in","type":"text"},{"text":" ","type":"text"},{"text":"complex meters. The two fermata elements allow for fermatas on both sides of the barline (the lower one","type":"text"},{"text":" ","type":"text"},{"text":"inverted).","type":"text"}],"title":"MXLBarline","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline","role":"symbol","url":"\/documentation\/ivormxl\/mxlbarline","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLBarline"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLRest":{"title":"MXLRest","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLRest","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"MXLRest","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlrest","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRest","abstract":[{"type":"text","text":"The rest element indicates notated rests or silences. Rest elements are usually empty, but placement on the"},{"type":"text","text":" "},{"text":"staff can be specified using display-step and display-octave elements. If the measure attribute is set to yes,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"this indicates this is a complete measure rest."}],"type":"topic","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes":{"type":"topic","title":"MXLAttributes","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes","abstract":[{"text":"The attributes element contains musical information that typically changes on measure boundaries. This","type":"text"},{"text":" ","type":"text"},{"text":"includes key and time signatures, clefs, transpositions, and staving. When attributes are changed mid-measure,","type":"text"},{"text":" ","type":"text"},{"text":"it affects the music in score order, not in MusicXML document order.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLAttributes"}],"navigatorTitle":[{"kind":"identifier","text":"MXLAttributes"}],"url":"\/documentation\/ivormxl\/mxlattributes"},"doc://IvorMXL/SQ":{"title":"Swift.Equatable","identifier":"doc:\/\/IvorMXL\/SQ","type":"unresolvable"},"doc://IvorMXL/s8CopyableP":{"title":"Swift.Copyable","identifier":"doc:\/\/IvorMXL\/s8CopyableP","type":"unresolvable"},"doc://IvorMXL/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","identifier":"doc:\/\/IvorMXL\/s16SendableMetatypeP","type":"unresolvable"},"doc://IvorMXL/documentation/IvorMXL/MXLRest/displayStepOctave":{"title":"displayStepOctave","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"displayStepOctave"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL20MXLDisplayStepOctaveV","kind":"typeIdentifier","text":"MXLDisplayStepOctave"},{"kind":"text","text":"?"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlrest\/displaystepoctave","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRest\/displayStepOctave","type":"topic","abstract":[{"text":"The display-step-octave group contains the sequence of elements used by both the rest and unpitched elements.","type":"text"},{"text":" ","type":"text"},{"text":"This group is used to place rests and unpitched elements on the staff without implying that these elements","type":"text"},{"text":" ","type":"text"},{"text":"have pitch. Positioning follows the current clef. If percussion clef is used, the display-step and display-","type":"text"},{"text":" ","type":"text"},{"text":"octave elements are interpreted as if in treble clef, with a G in octave 4 on line 2.","type":"text"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNote","kind":"identifier"}],"title":"MXLNote","abstract":[{"text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for","type":"text"},{"text":" ","type":"text"},{"text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation).","type":"text"},{"text":" ","type":"text"},{"text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,","type":"text"},{"text":" ","type":"text"},{"text":"but no tie elements. Having these two types of information available can make interchange easier, as some","type":"text"},{"text":" ","type":"text"},{"text":"programs handle one type of information more readily than the other.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","role":"symbol","url":"\/documentation\/ivormxl\/mxlnote","kind":"symbol","navigatorTitle":[{"text":"MXLNote","kind":"identifier"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLSound":{"type":"topic","title":"MXLSound","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound","abstract":[{"type":"text","text":"The sound element contains general playback parameters. They can stand alone within a part\/measure, or be a"},{"type":"text","text":" "},{"type":"text","text":"component element within a direction."}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSound","kind":"identifier"}],"navigatorTitle":[{"text":"MXLSound","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlsound"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/SH":{"title":"Swift.Hashable","identifier":"doc:\/\/IvorMXL\/SH","type":"unresolvable"}}}