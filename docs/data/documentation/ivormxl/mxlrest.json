{"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","abstract":[{"type":"text","text":"The rest element indicates notated rests or silences. Rest elements are usually empty, but placement on the"},{"type":"text","text":" "},{"type":"text","text":"staff can be specified using display-step and display-octave elements. If the measure attribute is set to yes,"},{"type":"text","text":" "},{"type":"text","text":"this indicates this is a complete measure rest."}],"seeAlsoSections":[{"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMusicItem","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPitch","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound"],"generated":true,"title":"Music","anchor":"Music"}],"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLRest"}],"languages":["swift"],"platforms":["macOS"]}]},{"content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Maps the MusicXML ","type":"text"},{"code":"<rest>","type":"codeVoice"},{"text":" element.","type":"text"}]}],"kind":"content"}],"relationshipsSections":[{"identifiers":["doc:\/\/IvorMXL\/s8CopyableP","doc:\/\/IvorMXL\/SQ","doc:\/\/IvorMXL\/s9EscapableP","doc:\/\/IvorMXL\/SH","doc:\/\/IvorMXL\/s8SendableP","doc:\/\/IvorMXL\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships","title":"Conforms To"}],"topicSections":[{"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRest\/init(displayStepOctave:measure:)"],"generated":true,"title":"Initializers","anchor":"Initializers"},{"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRest\/displayStepOctave","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRest\/measure"],"generated":true,"title":"Instance Properties","anchor":"Instance-Properties"},{"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRest\/Equatable-Implementations"],"generated":true,"title":"Default Implementations","anchor":"Default-Implementations"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRest"},"metadata":{"role":"symbol","externalID":"s:7IvorMXL7MXLRestV","symbolKind":"struct","roleHeading":"Structure","title":"MXLRest","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLRest"}],"modules":[{"name":"IvorMXL"}],"navigatorTitle":[{"kind":"identifier","text":"MXLRest"}]},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlrest"]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLAttributes":{"role":"symbol","navigatorTitle":[{"text":"MXLAttributes","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLAttributes","kind":"identifier"}],"kind":"symbol","title":"MXLAttributes","url":"\/documentation\/ivormxl\/mxlattributes","type":"topic","abstract":[{"text":"The attributes element contains musical information that typically changes on measure boundaries. This","type":"text"},{"text":" ","type":"text"},{"text":"includes key and time signatures, clefs, transpositions, and staving. When attributes are changed mid-measure,","type":"text"},{"text":" ","type":"text"},{"text":"it affects the music in score order, not in MusicXML document order.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes"},"doc://IvorMXL/s8CopyableP":{"type":"unresolvable","identifier":"doc:\/\/IvorMXL\/s8CopyableP","title":"Swift.Copyable"},"doc://IvorMXL/s16SendableMetatypeP":{"type":"unresolvable","identifier":"doc:\/\/IvorMXL\/s16SendableMetatypeP","title":"Swift.SendableMetatype"},"doc://IvorMXL/documentation/IvorMXL/MXLRest/displayStepOctave":{"abstract":[{"type":"text","text":"The display-step-octave group contains the sequence of elements used by both the rest and unpitched elements."},{"type":"text","text":" "},{"type":"text","text":"This group is used to place rests and unpitched elements on the staff without implying that these elements"},{"type":"text","text":" "},{"type":"text","text":"have pitch. Positioning follows the current clef. If percussion clef is used, the display-step and display-"},{"type":"text","text":" "},{"type":"text","text":"octave elements are interpreted as if in treble clef, with a G in octave 4 on line 2."}],"kind":"symbol","role":"symbol","type":"topic","title":"displayStepOctave","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRest\/displayStepOctave","url":"\/documentation\/ivormxl\/mxlrest\/displaystepoctave","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"displayStepOctave","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLDisplayStepOctave","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL20MXLDisplayStepOctaveV"},{"text":"?","kind":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLRest":{"role":"symbol","navigatorTitle":[{"text":"MXLRest","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLRest","kind":"identifier"}],"kind":"symbol","title":"MXLRest","url":"\/documentation\/ivormxl\/mxlrest","type":"topic","abstract":[{"text":"The rest element indicates notated rests or silences. Rest elements are usually empty, but placement on the","type":"text"},{"text":" ","type":"text"},{"text":"staff can be specified using display-step and display-octave elements. If the measure attribute is set to yes,","type":"text"},{"text":" ","type":"text"},{"text":"this indicates this is a complete measure rest.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRest"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection":{"role":"symbol","url":"\/documentation\/ivormxl\/mxldirection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLDirection","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"A direction is a musical indication that is not necessarily attached to a specific note. Two or more may be","type":"text"},{"text":" ","type":"text"},{"text":"combined to indicate words followed by the start of a dashed line, the end of a wedge followed by dynamics,","type":"text"},{"text":" ","type":"text"},{"text":"etc. For applications where a specific direction is indeed attached to a specific note, the direction element","type":"text"},{"text":" ","type":"text"},{"text":"can be associated with the first note element that follows it in score order that is not in a different voice.","type":"text"}],"type":"topic","navigatorTitle":[{"text":"MXLDirection","kind":"identifier"}],"title":"MXLDirection"},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"title":"MXLNote","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNote"}],"abstract":[{"type":"text","text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for"},{"type":"text","text":" "},{"type":"text","text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation)."},{"type":"text","text":" "},{"type":"text","text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,"},{"type":"text","text":" "},{"type":"text","text":"but no tie elements. Having these two types of information available can make interchange easier, as some"},{"type":"text","text":" "},{"type":"text","text":"programs handle one type of information more readily than the other."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLNote"}],"url":"\/documentation\/ivormxl\/mxlnote"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/s9EscapableP":{"type":"unresolvable","identifier":"doc:\/\/IvorMXL\/s9EscapableP","title":"Swift.Escapable"},"doc://IvorMXL/documentation/IvorMXL/MXLRest/measure":{"abstract":[{"type":"text","text":"A Boolean value indicating whether this represents a complete measure rest."}],"kind":"symbol","role":"symbol","type":"topic","title":"measure","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRest\/measure","url":"\/documentation\/ivormxl\/mxlrest\/measure","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"measure","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":"?","kind":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLBarline":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlbarline","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLBarline"}],"abstract":[{"type":"text","text":"If a barline is other than a normal single barline, it should be represented by a barline type that describes"},{"type":"text","text":" "},{"type":"text","text":"it. This includes information about repeats and multiple endings, as well as line style. Barline data is on"},{"type":"text","text":" "},{"type":"text","text":"the same level as the other musical data in a score — a child of a measure in a partwise score, or a part in a"},{"type":"text","text":" "},{"type":"text","text":"timewise score. This allows for barlines within measures, as in dotted barlines that subdivide measures in"},{"type":"text","text":" "},{"type":"text","text":"complex meters. The two fermata elements allow for fermatas on both sides of the barline (the lower one"},{"type":"text","text":" "},{"type":"text","text":"inverted)."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLBarline"}],"title":"MXLBarline"},"doc://IvorMXL/documentation/IvorMXL/MXLSound":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlsound","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLSound"}],"abstract":[{"type":"text","text":"The sound element contains general playback parameters. They can stand alone within a part\/measure, or be a"},{"type":"text","text":" "},{"type":"text","text":"component element within a direction."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLSound"}],"title":"MXLSound"},"doc://IvorMXL/documentation/IvorMXL/MXLPitch":{"role":"symbol","navigatorTitle":[{"text":"MXLPitch","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPitch","kind":"identifier"}],"kind":"symbol","title":"MXLPitch","url":"\/documentation\/ivormxl\/mxlpitch","type":"topic","abstract":[{"text":"Pitch is represented as a combination of the step of the diatonic scale, the chromatic alteration, and the","type":"text"},{"text":" ","type":"text"},{"text":"octave.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPitch"},"doc://IvorMXL/SQ":{"type":"unresolvable","identifier":"doc:\/\/IvorMXL\/SQ","title":"Swift.Equatable"},"doc://IvorMXL/documentation/IvorMXL/MXLMusicItem":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlmusicitem","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMusicItem","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLMusicItem"}],"abstract":[{"type":"text","text":"One of the alternatives for a music item."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLMusicItem"}],"title":"MXLMusicItem"},"doc://IvorMXL/SH":{"type":"unresolvable","identifier":"doc:\/\/IvorMXL\/SH","title":"Swift.Hashable"},"doc://IvorMXL/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/IvorMXL\/s8SendableP","title":"Swift.Sendable"},"doc://IvorMXL/documentation/IvorMXL/MXLRest/init(displayStepOctave:measure:)":{"abstract":[{"text":"Creates a new ","type":"text"},{"code":"MXLRest","type":"codeVoice"},{"text":".","type":"text"}],"title":"init(displayStepOctave:measure:)","url":"\/documentation\/ivormxl\/mxlrest\/init(displaystepoctave:measure:)","kind":"symbol","role":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"displayStepOctave","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL20MXLDisplayStepOctaveV","text":"MXLDisplayStepOctave","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"measure","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":"?)","kind":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRest\/init(displayStepOctave:measure:)"},"doc://IvorMXL/documentation/IvorMXL/MXLRest/Equatable-Implementations":{"abstract":[],"kind":"article","role":"collectionGroup","type":"topic","title":"Equatable Implementations","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRest\/Equatable-Implementations","url":"\/documentation\/ivormxl\/mxlrest\/equatable-implementations"}}}