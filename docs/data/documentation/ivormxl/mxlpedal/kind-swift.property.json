For compatibility"},{"type":"text","text":" "},{"type":"text","text":"with older versions, the sign attribute is yes by default if the line attribute is no, and is no by default if"},{"type":"text","text":" "},{"type":"text","text":"the line attribute is yes. If the sign attribute is set to yes and the type is start or sostenuto, the"},{"type":"text","text":" "},{"type":"text","text":"abbreviated attribute is yes if the short P and S signs are used, and no if the full Ped and Sost signs are"},{"type":"text","text":" "},{"type":"text","text":"used. It is no by default. Otherwise the abbreviated attribute is ignored. The alignment attributes are"},{"type":"text","text":" "},{"type":"text","text":"ignored if the sign attribute is no."}],"title":"MXLPedal","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPedal","kind":"identifier"}],"navigatorTitle":[{"text":"MXLPedal","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlpedal","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPedal"},"doc://IvorMXL/documentation/IvorMXL/MXLPedal/Kind-swift.enum":{"kind":"symbol","navigatorTitle":[{"text":"Kind","kind":"identifier"}],"title":"MXLPedal.Kind","url":"\/documentation\/ivormxl\/mxlpedal\/kind-swift.enum","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"text":" ","kind":"text"},{"kind":"identifier","text":"Kind"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPedal\/Kind-swift.enum","abstract":[{"text":"The pedal-type simple type is used to distinguish types of pedal directions. The start value indicates the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"start of a damper pedal, while the sostenuto value indicates the start of a sostenuto pedal. The other values"},{"text":" ","type":"text"},{"type":"text","text":"can be used with either the damper or sostenuto pedal. The soft pedal is not included here because there is"},{"type":"text","text":" "},{"type":"text","text":"no special symbol or graphic used for it beyond what can be specified with words and bracket elements."}]},"doc://IvorMXL/documentation/IvorMXL/MXLPedal/kind-swift.property":{"abstract":[{"type":"text","text":"Indicates the type of pedal mark, such as start, stop, sostenuto, or change."}],"title":"kind","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPedal\/kind-swift.property","kind":"symbol","url":"\/documentation\/ivormxl\/mxlpedal\/kind-swift.property","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"kind","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Kind","preciseIdentifier":"s:7IvorMXL8MXLPedalV4KindO","kind":"typeIdentifier"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"}}}