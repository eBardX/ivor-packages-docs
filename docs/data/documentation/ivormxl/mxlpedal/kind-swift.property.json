{"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPedal\/kind-swift.property","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"kind"},{"kind":"text","text":": "},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPedal\/Kind-swift.enum","kind":"typeIdentifier","text":"Kind","preciseIdentifier":"s:7IvorMXL8MXLPedalV4KindO"}]}]},{"content":[{"type":"heading","anchor":"discussion","text":"Discussion","level":2},{"inlineContent":[{"type":"text","text":"Maps to the MusicXML "},{"code":"type","type":"codeVoice"},{"type":"text","text":" attribute."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/ivormxl\/mxlpedal\/kind-swift.property"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPedal"]]},"abstract":[{"type":"text","text":"Indicates the type of pedal mark, such as start, stop, sostenuto, or change."}],"sections":[],"metadata":{"modules":[{"name":"IvorMXL"}],"title":"kind","symbolKind":"property","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"kind"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Kind","preciseIdentifier":"s:7IvorMXL8MXLPedalV4KindO"}],"externalID":"s:7IvorMXL8MXLPedalV4kindAC4KindOvp","role":"symbol","roleHeading":"Instance Property"},"kind":"symbol","references":{"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLPedal":{"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlpedal","abstract":[{"type":"text","text":"The pedal type represents piano pedal marks, including damper and sostenuto pedal marks. The line attribute is"},{"type":"text","text":" "},{"type":"text","text":"yes if pedal lines are used. The sign attribute is yes if Ped, Sost, and * signs are used. For compatibility"},{"type":"text","text":" "},{"type":"text","text":"with older versions, the sign attribute is yes by default if the line attribute is no, and is no by default if"},{"type":"text","text":" "},{"type":"text","text":"the line attribute is yes. If the sign attribute is set to yes and the type is start or sostenuto, the"},{"text":" ","type":"text"},{"text":"abbreviated attribute is yes if the short P and S signs are used, and no if the full Ped and Sost signs are","type":"text"},{"text":" ","type":"text"},{"text":"used. It is no by default. Otherwise the abbreviated attribute is ignored. The alignment attributes are","type":"text"},{"text":" ","type":"text"},{"text":"ignored if the sign attribute is no.","type":"text"}],"navigatorTitle":[{"text":"MXLPedal","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPedal","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPedal","title":"MXLPedal"},"doc://IvorMXL/documentation/IvorMXL/MXLPedal/Kind-swift.enum":{"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlpedal\/kind-swift.enum","abstract":[{"type":"text","text":"The pedal-type simple type is used to distinguish types of pedal directions. The start value indicates the"},{"type":"text","text":" "},{"type":"text","text":"start of a damper pedal, while the sostenuto value indicates the start of a sostenuto pedal. The other values"},{"type":"text","text":" "},{"type":"text","text":"can be used with either the damper or sostenuto pedal. The soft pedal is not included here because there is"},{"type":"text","text":" "},{"type":"text","text":"no special symbol or graphic used for it beyond what can be specified with words and bracket elements."}],"navigatorTitle":[{"text":"Kind","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Kind","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPedal\/Kind-swift.enum","title":"MXLPedal.Kind"},"doc://IvorMXL/documentation/IvorMXL/MXLPedal/kind-swift.property":{"type":"topic","role":"symbol","abstract":[{"type":"text","text":"Indicates the type of pedal mark, such as start, stop, sostenuto, or change."}],"kind":"symbol","title":"kind","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPedal\/kind-swift.property","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"kind","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL8MXLPedalV4KindO","kind":"typeIdentifier","text":"Kind"}],"url":"\/documentation\/ivormxl\/mxlpedal\/kind-swift.property"}}}