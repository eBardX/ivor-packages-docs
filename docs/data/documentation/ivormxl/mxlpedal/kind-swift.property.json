{"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPedal\/kind-swift.property","interfaceLanguage":"swift"},"sections":[],"metadata":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"kind","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Kind","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLPedalV4KindO"}],"modules":[{"name":"IvorMXL"}],"role":"symbol","externalID":"s:7IvorMXL8MXLPedalV4kindAC4KindOvp","roleHeading":"Instance Property","symbolKind":"property","title":"kind"},"kind":"symbol","variants":[{"paths":["\/documentation\/ivormxl\/mxlpedal\/kind-swift.property"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPedal"]]},"abstract":[{"type":"text","text":"Indicates the type of pedal mark, such as start, stop, sostenuto, or change."}],"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"kind"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPedal\/Kind-swift.enum","preciseIdentifier":"s:7IvorMXL8MXLPedalV4KindO","text":"Kind"}]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Maps to the MusicXML "},{"type":"codeVoice","code":"type"},{"type":"text","text":" attribute."}]}]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLPedal/Kind-swift.enum":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Kind"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPedal\/Kind-swift.enum","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Kind"}],"title":"MXLPedal.Kind","abstract":[{"type":"text","text":"The pedal-type simple type is used to distinguish types of pedal directions. The start value indicates the"},{"type":"text","text":" "},{"type":"text","text":"start of a damper pedal, while the sostenuto value indicates the start of a sostenuto pedal. The other values"},{"type":"text","text":" "},{"type":"text","text":"can be used with either the damper or sostenuto pedal. The soft pedal is not included here because there is"},{"type":"text","text":" "},{"type":"text","text":"no special symbol or graphic used for it beyond what can be specified with words and bracket elements."}],"url":"\/documentation\/ivormxl\/mxlpedal\/kind-swift.enum"},"doc://IvorMXL/documentation/IvorMXL/MXLPedal":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPedal"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPedal","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLPedal"}],"title":"MXLPedal","abstract":[{"type":"text","text":"The pedal type represents piano pedal marks, including damper and sostenuto pedal marks. The line attribute is"},{"type":"text","text":" "},{"type":"text","text":"yes if pedal lines are used. The sign attribute is yes if Ped, Sost, and * signs are used. For compatibility"},{"type":"text","text":" "},{"type":"text","text":"with older versions, the sign attribute is yes by default if the line attribute is no, and is no by default if"},{"type":"text","text":" "},{"type":"text","text":"the line attribute is yes. If the sign attribute is set to yes and the type is start or sostenuto, the"},{"type":"text","text":" "},{"type":"text","text":"abbreviated attribute is yes if the short P and S signs are used, and no if the full Ped and Sost signs are"},{"type":"text","text":" "},{"type":"text","text":"used. It is no by default. Otherwise the abbreviated attribute is ignored. The alignment attributes are"},{"type":"text","text":" "},{"type":"text","text":"ignored if the sign attribute is no."}],"url":"\/documentation\/ivormxl\/mxlpedal"},"doc://IvorMXL/documentation/IvorMXL/MXLPedal/kind-swift.property":{"title":"kind","abstract":[{"type":"text","text":"Indicates the type of pedal mark, such as start, stop, sostenuto, or change."}],"url":"\/documentation\/ivormxl\/mxlpedal\/kind-swift.property","fragments":[{"text":"let","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"kind"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLPedalV4KindO","text":"Kind"}],"kind":"symbol","type":"topic","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPedal\/kind-swift.property"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]}}}