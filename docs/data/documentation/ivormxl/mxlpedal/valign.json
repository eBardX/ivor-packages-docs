{"metadata":{"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"valign"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLValignO","text":"MXLValign"},{"kind":"text","text":"?"}],"title":"valign","roleHeading":"Instance Property","symbolKind":"property","externalID":"s:7IvorMXL8MXLPedalV6valignAA9MXLValignOSgvp","role":"symbol","modules":[{"name":"IvorMXL"}]},"abstract":[{"type":"text","text":"The valign attribute is used to indicate vertical alignment to the top, middle, bottom, or baseline of the"},{"type":"text","text":" "},{"type":"text","text":"text. Defaults are implementation-dependent."}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlpedal\/valign"]}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"valign"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValign","preciseIdentifier":"s:7IvorMXL9MXLValignO","text":"MXLValign"},{"text":"?","kind":"text"}]}],"kind":"declarations"},{"content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Maps to the MusicXML "},{"code":"valign","type":"codeVoice"},{"type":"text","text":" attribute."}]}],"kind":"content"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPedal"]]},"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPedal\/valign","interfaceLanguage":"swift"},"kind":"symbol","references":{"doc://IvorMXL/documentation/IvorMXL/MXLPedal/valign":{"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPedal\/valign","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"valign","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL9MXLValignO","text":"MXLValign","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"kind":"symbol","title":"valign","role":"symbol","url":"\/documentation\/ivormxl\/mxlpedal\/valign","abstract":[{"text":"The valign attribute is used to indicate vertical alignment to the top, middle, bottom, or baseline of the","type":"text"},{"text":" ","type":"text"},{"text":"text. Defaults are implementation-dependent.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLPedal":{"url":"\/documentation\/ivormxl\/mxlpedal","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPedal","abstract":[{"type":"text","text":"The pedal type represents piano pedal marks, including damper and sostenuto pedal marks. The line attribute is"},{"type":"text","text":" "},{"type":"text","text":"yes if pedal lines are used. The sign attribute is yes if Ped, Sost, and * signs are used. For compatibility"},{"type":"text","text":" "},{"type":"text","text":"with older versions, the sign attribute is yes by default if the line attribute is no, and is no by default if"},{"type":"text","text":" "},{"type":"text","text":"the line attribute is yes. If the sign attribute is set to yes and the type is start or sostenuto, the"},{"type":"text","text":" "},{"type":"text","text":"abbreviated attribute is yes if the short P and S signs are used, and no if the full Ped and Sost signs are"},{"type":"text","text":" "},{"type":"text","text":"used. It is no by default. Otherwise the abbreviated attribute is ignored. The alignment attributes are"},{"type":"text","text":" "},{"type":"text","text":"ignored if the sign attribute is no."}],"title":"MXLPedal","kind":"symbol","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPedal"}],"navigatorTitle":[{"kind":"identifier","text":"MXLPedal"}]},"doc://Iv