{"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","sections":[],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPedal\/valign","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPedal"]]},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"valign","kind":"identifier"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValign","text":"MXLValign","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLValignO"},{"text":"?","kind":"text"}]}],"kind":"declarations"},{"content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"inlineContent":[{"text":"Maps to the MusicXML ","type":"text"},{"code":"valign","type":"codeVoice"},{"text":" attribute.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlpedal\/valign"]}],"abstract":[{"type":"text","text":"The valign attribute is used to indicate vertical alignment to the top, middle, bottom, or baseline of the"},{"type":"text","text":" "},{"type":"text","text":"text. Defaults are implementation-dependent."}],"metadata":{"symbolKind":"property","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"valign","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL9MXLValignO","text":"MXLValign","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"title":"valign","modules":[{"name":"IvorMXL"}],"roleHeading":"Instance Property","externalID":"s:7IvorMXL8MXLPedalV6valignAA9MXLValignOSgvp"},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLPedal":{"url":"\/documentation\/ivormxl\/mxlpedal","abstract":[{"text":"The pedal type represents piano pedal marks, including damper and sostenuto pedal marks. The line attribute is","type":"text"},{"text":" ","type":"text"},{"text":"yes if pedal lines are used. The sign attribute is yes if Ped, Sost, and * signs are used. For compatibility","type":"text"},{"type":"text","text":" "},{"type":"text","text":"with older versions, the sign attribute is yes by default if the line attribute is no, and is no by default if"},{"type":"text","text":" "},{"type":"text","text":"the line attribute is yes. If the sign attribute is set to yes and the type is start or sostenuto, the"},{"type":"text","text":" "},{"text":"abbreviated attribute is yes if the short P and S signs are used, and no if the full Ped and Sost signs are","type":"text"},{"type":"text","text":" "},{"type":"text","text":"used. It is no by default. Otherwise the abbreviated attribute is ignored. The alignment attributes are"},{"type":"text","text":" "},{"type":"text","text":"ignored if the sign attribute is no."}],"title":"MXLPedal","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPedal","type":"topic","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPedal","kind":"identifier"}],"navigatorTitle":[{"text":"MXLPedal","kind":"identifier"}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLPedal/valign":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPedal\/valign","role":"symbol","type":"topic","title":"valign","kind":"symbol","url":"\/documentation\/ivormxl\/mxlpedal\/valign","abstract":[{"type":"text","text":"The valign attribute is used to indicate vertical alignment to the top, middle, bottom, or baseline of the"},{"type":"text","text":" "},{"type":"text","text":"text. Defaults are implementation-dependent."}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"valign"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL9MXLValignO","kind":"typeIdentifier","text":"MXLValign"},{"kind":"text","text":"?"}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLValign":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLValign","kind":"identifier"}],"title":"MXLValign","abstract":[{"type":"text","text":"The valign type is used to indicate vertical alignment to the top, middle, bottom, or baseline of the text. If"},{"type":"text","text":" "},{"type":"text","text":"the text is on multiple lines, baseline alignment refers to the baseline of the lowest line of text. Defaults"},{"type":"text","text":" "},{"type":"text","text":"are implementation-dependent."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValign","role":"symbol","url":"\/documentation\/ivormxl\/mxlvalign","kind":"symbol","navigatorTitle":[{"text":"MXLValign","kind":"identifier"}],"type":"topic"}}}