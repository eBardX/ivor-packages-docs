:" "},{"type":"text","text":"used. It is no by default. Otherwise the abbreviated attribute is ignored. The alignment attributes are"},{"type":"text","text":" "},{"type":"text","text":"ignored if the sign attribute is no."}],"url":"\/documentation\/ivormxl\/mxlpedal"}}}