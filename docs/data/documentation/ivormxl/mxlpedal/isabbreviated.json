mxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLPedal":{"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlpedal","abstract":[{"type":"text","text":"The pedal type represents piano pedal marks, including damper and sostenuto pedal marks. The line attribute is"},{"type":"text","text":" "},{"type":"text","text":"yes if pedal lines are used. The sign attribute is yes if Ped, Sost, and * signs are used. For compatibility"},{"type":"text","text":" "},{"type":"text","text":"with older versions, the sign attribute is yes by default if the line attribute is no, and is no by default if"},{"type":"text","text":" "},{"type":"text","text":"the line attribute is yes. If the sign attribute is set to yes and the type is start or sostenuto, the"},{"text":" ","type":"text"},{"text":"abbreviated attribute is yes if the short P and S signs are used, and no if the full Ped and Sost signs are","type":"text"},{"text":" ","type":"text"},{"text":"used. It is no by default. Otherwise the abbreviated attribute is ignored. The alignment attributes are","type":"text"},{"text":" ","type":"text"},{"text":"ignored if the sign attribute is no.","type":"text"}],"navigatorTitle":[{"text":"MXLPedal","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPedal","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPedal","title":"MXLPedal"},"doc://IvorMXL/documentation/IvorMXL/MXLPedal/isAbbreviated":{"type":"topic","role":"symbol","abstract":[{"type":"text","text":"A Boolean value indicating whether the short P and S signs are used instead of the full Ped and Sost signs,"},{"type":"text","text":" "},{"type":"text","text":"when the sign attribute is set and the type is start or sostenuto."}],"kind":"symbol","title":"isAbbreviated","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPedal\/isAbbreviated","fragments":[{"text":"let","ki