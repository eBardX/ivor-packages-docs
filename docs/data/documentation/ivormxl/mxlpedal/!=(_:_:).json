c","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPedal\/!=(_:_:)","role":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"!="},{"kind":"text","text":" "},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"url":"\/documentation\/ivormxl\/mxlpedal\/!=(_:_:)","title":"!=(_:_:)","abstract":[]},"doc://IvorMXL/documentation/IvorMXL/MXLPedal":{"url":"\/documentation\/ivormxl\/mxlpedal","abstract":[{"text":"The pedal type represents piano pedal marks, including damper and sostenuto pedal marks. The line attribute is","type":"text"},{"text":" ","type":"text"},{"text":"yes if pedal lines are used. The sign attribute is yes if Ped, Sost, and * signs are used. For compatibility","type":"text"},{"type":"text","text":" "},{"type":"text","text":"with older versions, the sign attribute is yes by default if the line attribute is no, and is no by default if"},{"type":"text","text":" "},{"type":"text","text":"the line attribute is yes. If the sign attribute is set to yes and the type is start or sostenuto, the"},{"type":"text","text":" "},{"text":"abbreviated attribute is yes if the short P and S signs are used, and no if the full Ped and Sost signs are","type":"text"},{"type":"text","text":" "},{"type":"text","text":"used. It is no by default. Otherwise the abbreviated attribute is ignored. The alignment attributes are"},{"type":"text","text":" "},{"type":"text","text":"ignored if the sign attribute is no."}],"title":"MXLPedal","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPedal","type":"topic","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPedal","kind":"identifier"}],"navigatorTitle":[{"text":"MXLPeda