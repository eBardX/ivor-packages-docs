,{"type":"text","text":"yes if pedal lines are used. The sign attribute is yes if Ped, Sost, and * signs are used. For compatibility"},{"type":"text","text":" "},{"type":"text","text":"with older versions, the sign attribute is yes by default if the line attribute is no, and is no by default if"},{"type":"text","text":" "},{"type":"text","text":"the line attribute is yes. If the sign attribute is set to yes and the type is start or sostenuto, the"},{"text":" ","type":"text"},{"text":"abbreviated attribute is yes if the short P and S signs are used, and no if the full Ped and Sost signs are","type":"text"},{"text":" ","type":"text"},{"text":"used. It is no by default. Otherwise the abbreviated attribute is ignored. The alignment attributes are","type":"text"},{"text":" ","type":"text"},{"text":"ignored if the sign attribute is no.","type":"text"}],"navigatorTitle":[{"text":"MXLPedal","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPedal","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPedal","title":"MXLPedal"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLNumberLevel":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumberLevel","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLNumberLevel"}],"abstract":[{"type":"text","text":"Slurs, tuplets, and many other features can be concurrent and overlap within a single musical part. The"},{"type":"text","text":" "},{"type":"text","text":"number-level entity distinguishes up to 16 concurrent objects of the same type when the objects overlap in"},{"type":"text","text":" "},{"type":"text","text":"MusicXML document order. Values greater than 6 are usually only needed for music with a large number of divisi"},{"type":"text","text":" "},{"type":"text","text":"staves in a single part, or if there are more than 6 cross-staff arpeggios in a single measure. When a number-"},{"type":"text","text":" "},{"type":"text","text":"level value is implied, the value is 1 by default."}],"kind":"symbol","title":"MXLNumberLevel","url":"\/documentation\/ivormxl\/mxlnumberlevel","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNumberLevel"}]},"doc://IvorMXL/documentation/IvorMXL/MXLPedal/number":{"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"number"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL14MXLNumberLevelV","text":"MXLNumberLevel","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"type":"topic","abstract":[{"type":"text","text":"Distinguishes multiple pedals occurring simultaneously."}],"url":"\/documentation\/ivormxl\/mxlpedal\/number","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPedal\/number","title":"number","kind":"symbol"}}}