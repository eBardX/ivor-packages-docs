,"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"text":"The change, continue, discontinue, and resume types are used when the line attribute is yes. The change type","type":"text"},{"text":" ","type":"text"},{"text":"indicates a pedal lift and retake indicated with an inverted V marking. The continue type allows more","type":"text"},{"text":" ","type":"text"},{"text":"precise formatting across system breaks and for more complex pedaling lines. The discontinue type indicates","type":"text"},{"text":" ","type":"text"},{"text":"the end of a pedal line that does not include the explicit lift represented by the stop type. The resume","type":"text"},{"text":" ","type":"text"},{"text":"type indicates the start of a pedal line that does not include the downstroke represented by the start","type":"text"},{"text":" ","type":"text"},{"text":"type. It can be used when a line resumes after being discontinued, or to start a pedal line that is","type":"text"},{"text":" ","type":"text"},{"text":"preceded by a text or symbol representation of the pedal.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPedal\/Kind-swift.enum","interfaceLanguage":"swift"},"abstract":[{"text":"The pedal-type simple type is used to distinguish types of pedal directions. The start value indicates the","type":"text"},{"text":" ","type":"text"},{"text":"start of a damper pedal, while the sostenuto value indicates the start of a sostenuto pedal. The other values","type":"text"},{"text":" ","type":"text"},{"text":"can be used with either the damper or sostenuto pedal. The soft pedal is not included here because there is","type":"text"},{"text":" ","type":"text"},{"text":"no special symbol or graphic used for it beyond what can be specified with words and bracket elements.","type":"text"}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLPedal/Kind-swift.enum/Equatable-Implementations":{"kind":"article","title":"Equatable Implementations","url":"\/documentation\/ivormxl\/mxlpedal\/kind-swift.enum\/equatable-implementations","role":"collectionGroup","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPedal\/Kind-swift.enum\/Equatable-Implementations","abstract":[]},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLPedal/Kind-swift.enum/discontinue":{"kind":"symbol","title":"MXLPedal.Kind.discontinue","url":"\/documentation\/ivormxl\/mxlpedal\/kind-swift.enum\/discontinue","role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"discontinue","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPedal\/Kind-swift.enum\/discontinue","abstract":[{"text":"The end of a pedal line that does not include the explicit lift represented by ","type":"text"},{"code":"stop","type":"codeVoice"},{"text":".","type":"text"}]},"doc://IvorMXL/s16SendableMetatypeP":{"identifier":"doc:\/\/IvorMXL\/s16SendableMetatypeP","title":"Swift.SendableMetatype","type":"unresolvable"},"doc://IvorMXL/s8SendableP":{"title":"Swift.Sendable","identifier":"doc:\/\/IvorMXL\/s8SendableP","type":"unresolvable"},"doc://IvorMXL/SQ":{"title":"Swift.Equatable","type":"unresolvable","identifier":"doc:\/\/IvorMXL\/SQ"},"doc://IvorMXL/SH":{"title":"Swift.Hashable","identifier":"doc:\/\/IvorMXL\/SH","type":"unresolvable"},"doc://IvorMXL/documentation/IvorMXL/MXLPedal/Kind-swift.enum/stop":{"kind":"symbol","title":"MXLPedal.Kind.stop","url":"\/documentation\/ivormxl\/mxlpedal\/kind-swift.enum\/stop","role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"stop","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPedal\/Kind-swift.enum\/stop","abstract":[{"type":"text","text":"The end of a pedal, with an explicit lift."}]},"doc://IvorMXL/documentation/IvorMXL/MXLPedal":{"abstract":[{"type":"text","text":"The pedal type represents piano pedal marks, including damper and sostenuto pedal marks. The line attribute is"},{"type":"text","text":" "},{"type":"text","text":"yes if pedal lines are used. The sign attribute is yes if Ped, Sost, and * signs are used. For compatibility"},{"type":"text","text":" "},{"type":"text","text":"with older versions, the sign attribute is yes by default if the line attribute is no, and is no by default if"},{"type":"text","text":" "},{"type":"text","text":"the line attribute is yes. If the sign attribute is set to yes and the type is start or sostenuto, the"},{"type":"text","text":" "},{"type":"text","text":"abbreviated attribute is yes if the short P and S signs are used, and no if the full Ped and Sost signs are"},{"type":"text","text":" "},{"type":"text","text":"used. It is no by default. Otherwise the abbreviated attribute is ignored. The alignment attributes are"},{"type":"text","text":" "},{"type":"text","text":"ignored if the sign attribute is no."}],"title":"MXLPedal","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPedal","kind":"identifier"}],"navigatorTitle":[{"text":"MXLPedal","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlpedal","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPedal"},"doc://IvorMXL/documentation/IvorMXL/MXLPedal/Kind-swift.enum/resume":{"kind":"symbol","url":"\/documentation\/ivormxl\/mxlpedal\/kind-swift.enum\/resume","title":"MXLPedal.Kind.resume","role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"resume","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPedal\/Kind-swift.enum\/resume","abstract":[{"type":"text","text":"The start of a pedal line that does not include the downstroke represented by "},{"code":"start","type":"codeVoice"},{"text":".","type":"text"}]},"doc://IvorMXL/s8CopyableP":{"title":"Swift.Copyable","identifier":"doc:\/\/IvorMXL\/s8CopyableP","type":"unresolvable"},"doc://IvorMXL/documentation/IvorMXL/MXLPedal/Kind-swift.enum":{"kind":"symbol","navigatorTitle":[{"text":"Kind","kind":"identifier"}],"title":"MXLPedal.Kind","url":"\/documentation\/ivormxl\/mxlpedal\/kind-swift.enum","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"text":" ","kind":"text"},{"kind":"identifier","text":"Kind"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPedal\/Kind-swift.enum","abstract":[{"text":"The pedal-type simple type is used to distinguish types of pedal directions. The start value indicates the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"start of a damper pedal, while the sostenuto value indicates the start of a sostenuto pedal. The other values"},{"text":" ","type":"text"},{"type":"text","text":"can be used with either the damper or sostenuto pedal. The soft pedal is not included here because there is"},{"type":"text","text":" "},{"type":"text","text":"no special symbol or graphic used for it beyond what can be specified with words and bracket elements."}]},"doc://IvorMXL/documentation/IvorMXL/MXLPedal/Kind-swift.enum/sostenuto":{"kind":"symbol","title":"MXLPedal.Kind.sostenuto","url":"\/documentation\/ivormxl\/mxlpedal\/kind-swift.enum\/sostenuto","role":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"text":"sostenuto","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPedal\/Kind-swift.enum\/sostenuto","abstract":[{"text":"The start of a sostenuto pedal.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MX