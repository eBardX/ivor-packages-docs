{"topicSections":[{"title":"Enumeration Cases","anchor":"Enumeration-Cases","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPedal\/Kind-swift.enum\/change","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPedal\/Kind-swift.enum\/continue","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPedal\/Kind-swift.enum\/discontinue","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPedal\/Kind-swift.enum\/resume","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPedal\/Kind-swift.enum\/sostenuto","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPedal\/Kind-swift.enum\/start","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPedal\/Kind-swift.enum\/stop"],"generated":true},{"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPedal\/Kind-swift.enum\/Equatable-Implementations"],"generated":true,"anchor":"Default-Implementations","title":"Default Implementations"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Kind","kind":"identifier"}],"platforms":["macOS"]}]},{"content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"The change, continue, discontinue, and resume types are used when the line attribute is yes. The change type","type":"text"},{"text":" ","type":"text"},{"text":"indicates a pedal lift and retake indicated with an inverted V marking. The continue type allows more","type":"text"},{"text":" ","type":"text"},{"text":"precise formatting across system breaks and for more complex pedaling lines. The discontinue type indicates","type":"text"},{"text":" ","type":"text"},{"text":"the end of a pedal line that does not include the explicit lift represented by the stop type. The resume","type":"text"},{"text":" ","type":"text"},{"text":"type indicates the start of a pedal line that does not include the downstroke represented by the start","type":"text"},{"text":" ","type":"text"},{"text":"type. It can be used when a line resumes after being discontinued, or to start a pedal line that is","type":"text"},{"text":" ","type":"text"},{"text":"preceded by a text or symbol representation of the pedal.","type":"text"}]}],"kind":"content"}],"sections":[],"metadata":{"roleHeading":"Enumeration","role":"symbol","title":"MXLPedal.Kind","symbolKind":"enum","navigatorTitle":[{"kind":"identifier","text":"Kind"}],"externalID":"s:7IvorMXL8MXLPedalV4KindO","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Kind","kind":"identifier"}],"modules":[{"name":"IvorMXL"}],"extendedModule":"IvorMXL"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPedal\/Kind-swift.enum"},"relationshipsSections":[{"identifiers":["doc:\/\/IvorMXL\/s8CopyableP","doc:\/\/IvorMXL\/SQ","doc:\/\/IvorMXL\/s9EscapableP","doc:\/\/IvorMXL\/SH","doc:\/\/IvorMXL\/s8SendableP","doc:\/\/IvorMXL\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships","title":"Conforms To"}],"variants":[{"paths":["\/documentation\/ivormxl\/mxlpedal\/kind-swift.enum"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPedal"]]},"abstract":[{"type":"text","text":"The pedal-type simple type is used to distinguish types of pedal directions. The start value indicates the"},{"type":"text","text":" "},{"type":"text","text":"start of a damper pedal, while the sostenuto value indicates the start of a sostenuto pedal. The other values"},{"type":"text","text":" "},{"type":"text","text":"can be used with either the damper or sostenuto pedal. The soft pedal is not included here because there is"},{"type":"text","text":" "},{"type":"text","text":"no special symbol or graphic used for it beyond what can be specified with words and bracket elements."}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLPedal/Kind-swift.enum/continue":{"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlpedal\/kind-swift.enum\/continue","abstract":[{"type":"text","text":"A continuation of a pedal line, allowing more precise formatting across system breaks."}],"kind":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"`continue`","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPedal\/Kind-swift.enum\/continue","title":"MXLPedal.Kind.continue"},"doc://IvorMXL/SH":{"title":"Swift.Hashable","type":"unresolvable","identifier":"doc:\/\/IvorMXL\/SH"},"doc://IvorMXL/documentation/IvorMXL/MXLPedal/Kind-swift.enum/discontinue":{"url":"\/documentation\/ivormxl\/mxlpedal\/kind-swift.enum\/discontinue","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"discontinue","kind":"identifier"}],"title":"MXLPedal.Kind.discontinue","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPedal\/Kind-swift.enum\/discontinue","role":"symbol","type":"topic","kind":"symbol","abstract":[{"text":"The end of a pedal line that does not include the explicit lift represented by ","type":"text"},{"code":"stop","type":"codeVoice"},{"text":".","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLPedal/Kind-swift.enum/start":{"url":"\/documentation\/ivormxl\/mxlpedal\/kind-swift.enum\/start","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"start","kind":"identifier"}],"title":"MXLPedal.Kind.start","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPedal\/Kind-swift.enum\/start","role":"symbol","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The start of a damper pedal."}]},"doc://IvorMXL/s8SendableP":{"identifier":"doc:\/\/IvorMXL\/s8SendableP","title":"Swift.Sendable","type":"unresolvable"},"doc://IvorMXL/documentation/IvorMXL/MXLPedal":{"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlpedal","abstract":[{"type":"text","text":"The pedal type represents piano pedal marks, including damper and sostenuto pedal marks. The line attribute is"},{"type":"text","text":" "},{"type":"text","text":"yes if pedal lines are used. The sign attribute is yes if Ped, Sost, and * signs are used. For compatibility"},{"type":"text","text":" "},{"type":"text","text":"with older versions, the sign attribute is yes by default if the line attribute is no, and is no by default if"},{"type":"text","text":" "},{"type":"text","text":"the line attribute is yes. If the sign attribute is set to yes and the type is start or sostenuto, the"},{"text":" ","type":"text"},{"text":"abbreviated attribute is yes if the short P and S signs are used, and no if the full Ped and Sost signs are","type":"text"},{"text":" ","type":"text"},{"text":"used. It is no by default. Otherwise the abbreviated attribute is ignored. The alignment attributes are","type":"text"},{"text":" ","type":"text"},{"text":"ignored if the sign attribute is no.","type":"text"}],"navigatorTitle":[{"text":"MXLPedal","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPedal","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPedal","title":"MXLPedal"},"doc://IvorMXL/documentation/IvorMXL/MXLPedal/Kind-swift.enum/resume":{"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlpedal\/kind-swift.enum\/resume","abstract":[{"type":"text","text":"The start of a pedal line that does not include the downstroke represented by "},{"type":"codeVoice","code":"start"},{"type":"text","text":"."}],"kind":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"resume","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPedal\/Kind-swift.enum\/resume","title":"MXLPedal.Kind.resume"},"doc://IvorMXL/documentation/IvorMXL/MXLPedal/Kind-swift.enum/stop":{"type":"topic","role":"symbol","url":"\/documentat