{"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","sections":[],"metadata":{"title":"usesLines","externalID":"s:7IvorMXL8MXLPedalV9usesLinesSbSgvp","symbolKind":"property","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"usesLines","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":"?","kind":"text"}],"role":"symbol","modules":[{"name":"IvorMXL"}],"roleHeading":"Instance Property"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"usesLines","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":"?","kind":"text"}],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"anchor":"discussion","text":"Discussion","level":2,"type":"heading"},{"inlineContent":[{"text":"Maps to the MusicXML ","type":"text"},{"type":"codeVoice","code":"line"},{"text":" attribute.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"text":"A Boolean value indicating whether pedal lines are used.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPedal"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPedal\/usesLines"},"variants":[{"paths":["\/documentation\/ivormxl\/mxlpedal\/useslines"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLPedal":{"url":"\/documentation\/ivormxl\/mxlpedal","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPedal","abstract":[{"type":"text","text":"The pedal type represents piano pedal marks, including damper and sostenuto pedal marks. The line attribute is"},{"type":"text","text":" "},{"type":"text","text":"yes if pedal lines are used. The sign attribute is yes if Ped, Sost, and * signs are used. For compatibility"},{"type":"text","text":" "},{"type":"text","text":"with older versions, the sign attribute is yes by default if the line attribute is no, and is no by default if"},{"type":"text","text":" "},{"type":"text","text":"the line attribute is yes. If the sign attribute is set to yes and the type is start or sostenuto, the"},{"type":"text","text":" "},{"type":"text","text":"abbreviated attribute is yes if the short P and S signs are used, and no if the full Ped and Sost signs are"},{"type":"text","text":" "},{"type":"text","text":"used. It is no by default. Otherwise the abbreviated attribute is ignored. The alignment attributes are"},{"type":"text","text":" "},{"type":"text","text":"ignored if the sign attribute is no."}],"title":"MXLPedal","kind":"symbol","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPedal"}],"navigatorTitle":[{"kind":"identifier","text":"MXLPedal"}]},"doc://IvorMXL/documentation/IvorMXL/MXLPedal/usesLines":{"abstract":[{"type":"text","text":"A Boolean value indicating whether pedal lines are used."}],"title":"usesLines","url":"\/documentation\/ivormxl\/mxlpedal\/useslines","kind":"symbol","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"usesLines","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPedal\/usesLines"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"}}}