major":0},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLPedal/Kind-swift.enum/!=(_:_:)":{"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"!="},{"kind":"text","text":" "},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPedal\/Kind-swift.enum\/!=(_:_:)","role":"symbol","title":"!=(_:_:)","abstract":[],"url":"\/documentation\/ivormxl\/mxlpedal\/kind-swift.enum\/!=(_:_:)"},"doc://IvorMXL/documentation/IvorMXL/MXLPedal":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPedal"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPedal","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLPedal"}],"title":"MXLPedal","abstract":[{"type":"text","text":"The pedal type represents piano pedal marks, including damper and sostenuto pedal marks. The line attribute is"},{"type":"text","text":" "},{"type":"text","text":"yes if pedal lines are used. The sign attribute is yes if Ped, Sost, and * signs are used. For compatibility"},{"type":"text","text":" "},{"type":"text","text":"with older versions, the sign attribute is yes by default if the line attribute is no, and is no by default if"},{"type":"text","text":" "},{"type":"text","text":"the line attribute is yes. If the sign attribute is set to yes and the type is start or sostenuto, the"},{"type":"text","text":" "},{"type":"text","text":"abbreviated attribute is yes if the short P and S signs are used, and no if the full Ped and Sost signs are"},{"type":"text","text":" "},{"type":"text","text":"used. It is no by default. Otherwise the abbreviated attribute is ignored. The alignment attributes are"},{"type":"text","text":" "},{"type":"text","text":"ignored if the sign attribute is no."}],"url":"\/documentation\/ivormxl\/mxlpedal"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLPedal/Kind-swift.enum":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Kind"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPedal\/Kind-swift.enum","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Kind"}],"title":"MXLPedal.Kind","abstract":[{"type":"text","text":"The pedal-type simple type is used to distinguish types of pedal directions. The start value indicates the"},{"type":"text","text":" "},{"type":"text","text":"start of a damper pedal, while the sostenuto value indicates the start of a sostenuto pedal. The other values"},{"type":"text","text":" "},{"type":"text","text":"can be used with either the damper or sostenuto pedal. The soft pedal is not included here because there is"},{"type":"text","text":" "},{"type":"text","text":"no special symbol or graphic used for it beyond what can be specified with words and bracket elements."}],"url":"\/documentation\/ivormxl\/mxlpedal\/kind-swift.enum"}}}