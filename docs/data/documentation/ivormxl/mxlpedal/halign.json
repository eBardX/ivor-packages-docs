{"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","abstract":[{"text":"In cases where text extends over more than one line, horizontal alignment and justify values can be different.","type":"text"},{"text":" ","type":"text"},{"text":"The most typical case is for credits, such as:","type":"text"}],"sections":[],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"halign","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLLeftCenterRight","preciseIdentifier":"s:7IvorMXL18MXLLeftCenterRightO","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLeftCenterRight"},{"text":"?","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"anchor":"discussion","text":"Discussion","level":2,"type":"heading"},{"inlineContent":[{"text":"Words and music by Pat Songwriter","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Typically this type of credit is aligned to the right, so that the position information refers to the right-","type":"text"},{"text":" ","type":"text"},{"text":"most part of the text. But in this example, the text is center-justified, not right-justified.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The halign attribute is used in these situations. If it is not present, its value is the same as for the","type":"text"},{"text":" ","type":"text"},{"text":"justify attribute. For elements where a justify attribute is not allowed, the default is implementation-","type":"text"},{"text":" ","type":"text"},{"text":"dependent.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Maps to the MusicXML ","type":"text"},{"code":"halign","type":"codeVoice"},{"text":" attribute.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPedal\/halign","interfaceLanguage":"swift"},"metadata":{"role":"symbol","externalID":"s:7IvorMXL8MXLPedalV6halignAA18MXLLeftCenterRightOSgvp","symbolKind":"property","roleHeading":"Instance Property","title":"halign","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"halign","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLLeftCenterRight","preciseIdentifier":"s:7IvorMXL18MXLLeftCenterRightO","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"modules":[{"name":"IvorMXL"}]},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPedal"]]},"variants":[{"paths":["\/documentation\/ivormxl\/mxlpedal\/halign"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLPedal":{"url":"\/documentation\/ivormxl\/mxlpedal","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPedal","abstract":[{"type":"text","text":"The pedal type represents piano pedal marks, including damper and sostenuto pedal marks. The line attribute is"},{"type":"text","text":" "},{"type":"text","text":"yes if pedal lines are used. The sign attribute is yes if Ped, Sost, and * signs are used. For compatibility"},{"type":"text","text":" "},{"type":"text","text":"with older versions, the sign attribute is yes by default if the line attribute is no, and is no by default if"},{"type":"text","text":" "},{"type":"text","text":"the line attribute is yes. If the sign attribute is set to yes and the type is start or sostenuto, the"},{"type":"text","text":" "},{"type":"text","text":"abbreviated attribute is yes if the short P and S signs are used, and no if the full Ped and Sost signs are"},{"type":"text","text":" "},{"type":"text","text":"used. It is no by default. Otherwise the abbreviated attribute is ignored. The alignment attributes are"},{"type":"text","text":" "},{"type":"text","text":"ignored if the sign attribute is no."}],"title":"MXLPedal","kind":"symbol","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPedal"}],"navigatorTitle":[{"kind":"identifier","text":"MXLPedal"}]},"doc://IvorMXL/documentation/IvorMXL/MXLLeftCenterRight":{"url":"\/documentation\/ivormxl\/mxlleftcenterright","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLeftCenterRight","abstract":[{"type":"text","text":"The left-center-right type is used to define horizontal alignment and text justification."}],"title":"MXLLeftCenterRight","kind":"symbol","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLLeftCenterRight"}],"navigatorTitle":[{"kind":"identifier","text":"MXLLeftCenterRight"}]},"doc://IvorMXL/documentation/IvorMXL/MXLPedal/halign":{"title":"halign","kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"halign","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL18MXLLeftCenterRightO","text":"MXLLeftCenterRight","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPedal\/halign","url":"\/documentation\/ivormxl\/mxlpedal\/halign","type":"topic","abstract":[{"type":"text","text":"In cases where text extends over more than one line, horizontal alignment and justify values can be different."},{"type":"text","text":" "},{"type":"text","text":"The most typical case is for credits, such as:"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"}}}