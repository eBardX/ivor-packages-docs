{"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL"]]},"relationshipsSections":[{"identifiers":["doc:\/\/IvorMXL\/s8CopyableP","doc:\/\/IvorMXL\/SQ","doc:\/\/IvorMXL\/s9EscapableP","doc:\/\/IvorMXL\/SH","doc:\/\/IvorMXL\/s8SendableP","doc:\/\/IvorMXL\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships","title":"Conforms To"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffSize"},"abstract":[{"type":"text","text":"The staff-size element indicates how large a staff space is on this staff, expressed as a percentage of the"},{"type":"text","text":" "},{"type":"text","text":"work’s default scaling. Values less than 100 make the staff space smaller while values over 100 make the staff"},{"type":"text","text":" "},{"text":"space larger. A staff-type of cue, ossia, or editorial implies a staff-size of less than 100, but the exact","type":"text"},{"text":" ","type":"text"},{"text":"value is implementation-dependent unless specified here. Staff size affects staff height only, not the","type":"text"},{"type":"text","text":" "},{"text":"relationship of the staff to the left and right margins.","type":"text"}],"metadata":{"modules":[{"name":"IvorMXL"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLStaffSize"}],"externalID":"s:7IvorMXL12MXLStaffSizeV","roleHeading":"Structure","role":"symbol","title":"MXLStaffSize","symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"MXLStaffSize"}]},"sections":[],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLStaffSize","kind":"identifier"}],"languages":["swift"],"platforms":["macOS"]}]},{"content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"In some cases, a staff-