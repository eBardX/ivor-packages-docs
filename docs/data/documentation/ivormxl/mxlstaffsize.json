{"relationshipsSections":[{"identifiers":["doc:\/\/IvorMXL\/s8CopyableP","doc:\/\/IvorMXL\/SQ","doc:\/\/IvorMXL\/s9EscapableP","doc:\/\/IvorMXL\/SH","doc:\/\/IvorMXL\/s8SendableP","doc:\/\/IvorMXL\/s16SendableMetatypeP"],"title":"Conforms To","kind":"relationships","type":"conformsTo"}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLStaffSize"}],"platforms":["macOS"],"languages":["swift"]}]},{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In some cases, a staff-size different than 100 also scales the notation on the staff, such as with a cue"},{"type":"text","text":" "},{"type":"text","text":"staff. In other cases, such as percussion staves, the lines may be more widely spaced without scaling the"},{"type":"text","text":" "},{"type":"text","text":"notation on the staff. The scaling attribute allows these two cases to be distinguished. It specifies the"},{"text":" ","type":"text"},{"text":"percentage scaling that applies to the notation. Values less that 100 make the notation smaller while values","type":"text"},{"text":" ","type":"text"},{"text":"over 100 make the notation larger. The staff-size content and scaling attribute are both non-negative decimal","type":"text"},{"text":" ","type":"text"},{"text":"values.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Maps the MusicXML ","type":"text"},{"code":"<staff-size>","type":"codeVoice"},{"type":"text","text":" element."}]}],"kind":"content"}],"metadata":{"symbolKind":"struct","title":"MXLStaffSize","modules":[{"name":"IvorMXL"}],"role":"symbol","roleHeading":"Structure","externalID":"s:7IvorMXL12MXLStaffSizeV","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLStaffSize","kind":"identifier"}],"navigatorTitle":[{"text":"MXLStaffSize","kind":"identifier"}]},"variants":[{"paths":["\/documentation\/ivormxl\/mxlstaffsize"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffSize","interfaceLanguage":"swift"},"kind":"symbol","topicSections":[{"generated":true,"title":"Initializers","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffSize\/init(value:scaling:)"],"anchor":"Initializers"},{"generated":true,"title":"Instance Properties","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffSize\/scaling","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffSize\/value"],"anchor":"Instance-Properties"},{"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffSize\/Equatable-Implementations"],"title":"Default Implementations","generated":true,"anchor":"Default-Implementations"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"text":"The staff-size element indicates how large a staff space is on this staff, expressed as a percentage of the","type":"text"},{"text":" ","type":"text"},{"text":"work’s default scaling. Values less than 100 make the staff space smaller while values over 100 make the staff","type":"text"},{"text":" ","type":"text"},{"text":"space larger. A staff-type of cue, ossia, or editorial implies a staff-size of less than 100, but the exact","type":"text"},{"text":" ","type":"text"},{"text":"value is implementation-dependent unless specified here. Staff size affects staff height only, not the","type":"text"},{"text":" ","type":"text"},{"text":"relationship of the staff to the left and right margins.","type":"text"}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLStaffSize":{"title":"MXLStaffSize","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLStaffSize","kind":"identifier"}],"abstract":[{"type":"text","text":"The staff-size element indicates how large a staff space is on this staff, expressed as a percentage of the"},{"text":" ","type":"text"},{"text":"work’s default scaling. Values less than 100 make the staff space smaller while values over 100 make the staff","type":"text"},{"type":"text","text":" "},{"type":"text","text":"space larger. A staff-type of cue, ossia, or editorial implies a staff-size of less than 100, but the exact"},{"type":"text","text":" "},{"type":"text","text":"value is implementation-dependent unless specified here. Staff size affects staff height only, not the"},{"type":"text","text":" "},{"type":"text","text":"relationship of the staff to the left and right margins."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffSize","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLStaffSize"}],"url":"\/documentation\/ivormxl\/mxlstaffsize"},"doc://IvorMXL/SQ":{"identifier":"doc:\/\/IvorMXL\/SQ","type":"unresolvable","title":"Swift.Equatable"},"doc://IvorMXL/s8CopyableP":{"identifier":"doc:\/\/IvorMXL\/s8CopyableP","type":"unresolvable","title":"Swift.Copyable"},"doc://IvorMXL/s16SendableMetatypeP":{"identifier":"doc:\/\/IvorMXL\/s16SendableMetatypeP","type":"unresolvable","title":"Swift.SendableMetatype"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/s8SendableP":{"identifier":"doc:\/\/IvorMXL\/s8SendableP","title":"Swift.Sendable","type":"unresolvable"},"doc://IvorMXL/SH":{"identifier":"doc:\/\/IvorMXL\/SH","title":"Swift.Hashable","type":"unresolvable"},"doc://IvorMXL/documentation/IvorMXL/MXLStaffSize/value":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlstaffsize\/value","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffSize\/value","fragments":[{"text":"let","kind":"keyword"},{"text":" ","