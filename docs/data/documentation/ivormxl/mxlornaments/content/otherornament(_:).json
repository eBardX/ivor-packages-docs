{"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOrnaments","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOrnaments\/Content"]]},"metadata":{"modules":[{"name":"IvorMXL"}],"externalID":"s:7IvorMXL12MXLOrnamentsV7ContentO13otherOrnamentyAeA21MXLOtherPlacementTextVcAEmF","role":"symbol","title":"MXLOrnaments.Content.otherOrnament(_:)","symbolKind":"case","roleHeading":"Case","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"otherOrnament"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"MXLOtherPlacementText","preciseIdentifier":"s:7IvorMXL21MXLOtherPlacementTextV"},{"kind":"text","text":")"}]},"kind":"symbol","abstract":[{"type":"text","text":"The other-ornament element is used to define any ornaments not yet in the MusicXML format. The smufl"},{"type":"text","text":" "},{"type":"text","text":"attribute can be used to specify a particular ornament, allowing application interoperability without"},{"type":"text","text":" "},{"type":"text","text":"requiring every SMuFL ornament to have a MusicXML element equivalent. Using the other-ornament element"},{"type":"text","text":" "},{"type":"text","text":"without the smufl attribute allows for extended representation, though without application interoperability."}],"variants":[{"paths":["\/documentation\/ivormxl\/mxlornaments\/content\/otherornament(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOrnaments\/Content\/otherOrnament(_:)"},"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"otherOrnament"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"MXLOtherPlacementText","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/M