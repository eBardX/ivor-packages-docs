"text":"individually, or repeated alternation between two notes or chords."}],"title":"MXLOrnaments.Content.tremolo(_:)","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOrnaments\/Content-swift.enum\/tremolo(_:)","kind":"symbol","url":"\/documentation\/ivormxl\/mxlornaments\/content-swift.enum\/tremolo(_:)","type":"topic","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"tremolo","kind":"identifier"},{"text":"(","kind":"text"},{"text":"MXLTremolo","preciseIdentifier":"s:7IvorMXL10MXLTremoloV","kind":"typeIdentifier"},{"text":")","kind":"text"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLOrnaments/Content-swift.enum":{"title":"MXLOrnaments.Content","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Content","kind":"identifier"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlornaments\/content-swift.enum","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOrnaments\/Content-swift.enum","abstract":[{"type":"text","text":"One of the alternatives for Ornaments."}],"navigatorTitle":[{"text":"Content","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLTremolo":{"abstract":[{"type":"text","text":"The tremolo ornament can be used to indicate single-note, double-note, or unmeasured tremolos. Single-note"},{"type":"text","text":" "},{"type":"text","text":"tremolos use the single type, double-note tremolos use the start and stop types, and unmeasured tremolos use"},{"type":"text","text":" "},{"type":"text","text":"the unmeasured type. The default is “single” for compatibility with Version 1.1. The text of the element"},{"type":"text","text":" "},{"type":"text","text":"indicates the number of tremolo marks and is an integer from 0 to 8. Note that the number of attached beams is"},{"type":"text","text":" "},{"type":"text","text":"not included in this value, but is represented separately using the beam element. The value should be 0 for"},{"type":"text","text":" "},{"type":"text","text":"unmeasured tremolos."}],"title":"MXLTremolo","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTremolo","kind":"identifier"}],"navigatorTitle":[{"text":"MXLTremolo","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxltremolo","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo"},"doc://IvorMXL/documentation/IvorMXL/MXLOrnaments":{"title":"MXLOrnaments","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLOrnaments"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlornaments","abstract":[{"text":"Ornaments can be any of several types, followed optionally by accidentals. The accidental-mark element’s","type":"text"},{"text":" ","type":"text"},{"text":"content is represented the same as an accidental element, but with a different name to reflect the different","type":"text"},{"text":" ","type":"text"},{"text":"musical meaning.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOrnaments","navigatorTitle":[{"kind":"identifier","text":"MXLOrnaments"}]}}}