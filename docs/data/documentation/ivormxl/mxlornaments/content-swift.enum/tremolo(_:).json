{"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOrnaments\/Content-swift.enum\/tremolo(_:)","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/ivormxl\/mxlornaments\/content-swift.enum\/tremolo(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"title":"MXLOrnaments.Content.tremolo(_:)","roleHeading":"Case","externalID":"s:7IvorMXL12MXLOrnamentsV7ContentO7tremoloyAeA10MXLTremoloVcAEmF","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"tremolo","kind":"identifier"},{"text":"(","kind":"text"},{"text":"MXLTremolo","preciseIdentifier":"s:7IvorMXL10MXLTremoloV","kind":"typeIdentifier"},{"text":")","kind":"text"}],"role":"symbol","modules":[{"name":"IvorMXL"}],"symbolKind":"case"},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOrnaments","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOrnaments\/Content-swift.enum"]]},"abstract":[{"text":"The tremolo element represents tremolo marks used to indicate a note or chord that is repeated","type":"text"},{"text":" ","type":"text"},{"text":"individually, or repeated alternation between two notes or chords.","type":"text"}],"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"tremolo","kind":"identifier"},{"text":"(","kind":"text"},{"text":"MXLTremolo","preciseIdentifier":"s:7IvorMXL10MXLTremoloV","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo"},{"text":")","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLOrnaments/Content-swift.enum":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlornaments\/content-swift.enum","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOrnaments\/Content-swift.enum","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Content"}],"kind":"symbol","abstract":[{"type":"text","text":"One of the alternatives for Ornaments."}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"Content"}],"title":"MXLOrnaments.Content"},"doc://IvorMXL/documentation/IvorMXL/MXLTremolo":{"role":"symbol","url":"\/documentation\/ivormxl\/mxltremolo","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTremolo","kind":"identifier"}],"abstract":[{"type":"text","text":"The tremolo ornament can be used to indicate single-note, double-note, or unmeasured tremolos. Single-note"},{"type":"text","text":" "},{"type":"text","text":"tremolos use the single type, double-note tremolos use the start and stop types, and unmeasured tremolos use"},{"type":"text","text":" "},{"type":"text","text":"the unmeasured type. The default is “single” for compatibility with Version 1.1. The text of the element"},{"type":"text","text":" "},{"type":"text","text":"indicates the number of tremolo marks and is an integer from 0 to 8. Note that the number of attached beams is"},{"type":"text","text":" "},{"type":"text","text":"not included in this value, but is represented separately using the beam element. The value should be 0 for"},{"type":"text","text":" "},{"type":"text","text":"unmeasured tremolos."}],"kind":"symbol","type":"topic","navigatorTitle":[{"text":"MXLTremolo","kind":"identifier"}],"title":"MXLTremolo"},"doc://IvorMXL/documentation/IvorMXL/MXLOrnaments/Content-swift.enum/tremolo(_:)":{"abstract":[{"type":"text","text":"The tremolo element represents tremolo marks used to indicate a note or chord that is repeated"},{"type":"text","text":" "},{"type":"text","text":"individually, or repeated alternation between two notes or chords."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOrnaments\/Content-swift.enum\/tremolo(_:)","url":"\/documentation\/ivormxl\/mxlornaments\/content-swift.enum\/tremolo(_:)","title":"MXLOrnaments.Content.tremolo(_:)","role":"symbol","type":"topic","kind":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"tremolo","kind":"identifier"},{"text":"(","kind":"text"},{"text":"MXLTremolo","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL10MXLTremoloV"},{"text":")","kind":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLOrnaments":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlornaments","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOrnaments","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLOrnaments"}],"kind":"symbol","abstract":[{"type":"text","text":"Ornaments can be any of several types, followed optionally by accidentals. The accidental-mark element’s"},{"type":"text","text":" "},{"type":"text","text":"content is represented the same as an accidental element, but with a different name to reflect the different"},{"type":"text","text":" "},{"type":"text","text":"musical meaning."}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLOrnaments"}],"title":"MXLOrnaments"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"}}}