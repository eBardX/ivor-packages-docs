/documentation/IvorMXL/MXLColor":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlcolor","title":"MXLColor","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"type":"text","text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is"},{"type":"text","text":" "},{"type":"text","text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLStem":{"abstract":[{"type":"text","text":"Stems can be down, up, none, or double. For down and up stems, the position attributes can be used to specify"},{"type":"text","text":" "},{"type":"text","text":"stem length. The relative values specify the end of the stem relative to the program default. Default values"},{"type":"text","text":" "},{"type":"text","text":"specify an absolute end stem position. Negative values of relative-y that would flip a stem instead of"},{"type":"text","text":" "},{"type":"text","text":"shortening it are ignored. A stem element associated with a rest refers to a stemlet."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLStem"}],"title":"MXLStem","navigatorTitle":[{"kind":"identifier","text":"MXLStem"}],"kind":"symbol","url":"\/documentat