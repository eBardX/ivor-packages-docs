ion\/IvorMXL\/MXLStem","abstract":[{"type":"text","text":"Stems can be down, up, none, or double. For down and up stems, the position attributes can be used to specify"},{"type":"text","text":" "},{"type":"text","text":"stem length. The relative values specify the end of the stem relative to the program default. Default values"},{"type":"text","text":" "},{"type":"text","text":"specify an absolute end stem position. Negative values of relative-y that would flip a stem instead of"},{"type":"text","text":" "},{"type":"text","text":"shortening it are ignored. A stem element associated with a rest refers to a stemlet."}],"navigatorTitle":[{"text":"MXLStem","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"abstract":[{"text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in","type":"text"},{"type":"text","text":" "},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"title":"MXLColor","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlcolor","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor"},"doc://IvorMXL/documentation/IvorMXL/MXLStem/color":{"title":"color","url":"\/documentation\/ivormxl\/mxlstem\/color","type":"topic","abstract":[{"text":"The color attribute group indicates the color of an element.","type":"text"}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"color"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLColor","preciseIdentifier":"s:7IvorMXL8MXLColorV"},{"kind":"text