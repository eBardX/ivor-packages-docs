":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"octaveChange","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLOctaveChange","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL15MXLOctaveChangeV"},{"text":"?","kind":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTranspose\/Content-swift.struct\/octaveChange"},"doc://IvorMXL/documentation/IvorMXL/MXLTranspose":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTranspose"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLTranspose"}],"url":"\/documentation\/ivormxl\/mxltranspose","role":"symbol","title":"MXLTranspose","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTranspose","type":"topic","abstract":[{"type":"text","text":"The transpose type represents what must be added to a written pitch to get a correct sounding pitch. The"},{"type":"text","text":" "},{"type":"text","text":"optional number attribute refers to staff numbers, from top to bottom on the system. If absent, the"},{"type":"text","text":" "},{"type":"text","text":"transposition applies to all staves in the part. Per-staff transposition is most often used in parts that"},{"type":"text","text":" "},{"type":"text","text":"represent multiple instruments."}]},"doc://IvorMXL/documentation/IvorMXL/MXLTranspose/Content-swift.struct":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Content"}],"kind":"symbol","navigatorTitle":[{"text":"Content","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxltranspose\/content-swift.struct","role":"symbol","title":"MXLTranspose.Content","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTranspose\/Content-swift.struct","type":"topic","abstract":[{"type":"text","text":"The transpose group represents what must be added to a written pitch to get a correct sounding pitch."}]}}}