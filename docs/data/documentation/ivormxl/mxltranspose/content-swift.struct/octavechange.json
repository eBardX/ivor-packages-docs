{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxltranspose\/content-swift.struct\/octavechange"]}],"abstract":[{"type":"text","text":"The octave-change element indicates how many octaves to add to get from written pitch to sounding pitch. The"},{"type":"text","text":" "},{"type":"text","text":"octave-change element should be included when using transposition intervals of an octave or more, and should"},{"type":"text","text":" "},{"type":"text","text":"not be present for intervals of less than an octave."}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTranspose\/Content-swift.struct\/octaveChange"},"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"symbolKind":"property","modules":[{"name":"IvorMXL"}],"externalID":"s:7IvorMXL12MXLTransposeV7ContentV12octaveChangeAA09MXLOctaveF0VSgvp","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"octaveChange"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL15MXLOctaveChangeV","kind":"typeIdentifier","text":"MXLOctaveChange"},{"kind":"text","text":"?"}],"title":"octaveChange","roleHeading":"Instance Property","role":"symbol"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTranspose","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTranspose\/Content-swift.struct"]]},"kind":"symbol","primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"octaveChange"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL15MXLOctaveChangeV","kind":"typeIdentifier","text":"MXLOctaveChange","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOctaveChange"},{"kind":"text","text":"?"}],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Discussion","anchor":"discuss