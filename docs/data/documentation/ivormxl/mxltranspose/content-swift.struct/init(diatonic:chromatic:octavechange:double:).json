eclarations":[{"tokens":[{"kind":"keyword","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"diatonic"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLDiatonicSteps","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDiatonicSteps","preciseIdentifier":"s:7IvorMXL16MXLDiatonicStepsV"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"chromatic"},{"kind":"text","text":": "},{"text":"MXLSemitones","preciseIdentifier":"s:7IvorMXL12MXLSemitonesa","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSemitones"},{"text":", ","kind":"text"},{"text":"octaveChange","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL15MXLOctaveChangeV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOctaveChange","text":"MXLOctaveChange","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"double","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL9MXLDoubleV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDouble","text":"MXLDouble","kind":"typeIdentifier"},{"text":"? = nil)","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The diatonic element specifies the number of pitch steps needed to go from written to sounding pitch. This allows for correct spelling of enharmonic transpositions. This value does not include octave-change values; the values for both elements need to be added to the written pitch to get the correct sounding pitch."}]}],"name":"diatonic"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The chromatic element represents the number of semitones needed to get from written to sounding pitch. This value does not include octave-change values; the values for both elements need to be added to the written pitch to get the correct sounding pitch."}]}],"name":"chromatic"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The octave-change element indicates how many octaves to add to get from written pitch to sounding pitch. The octave-change element should be included when using transposition intervals of an octave or more, and should not be present for intervals of less than an octave."}]}],"name":"octaveChange"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If the double element is present, it indicates that the music is doubled one octave from what is currently written."}]}],"name":"double"}]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLDiatonicSteps":{"url":"\/documentation\/ivormxl\/mxldiatonicsteps","role":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLDiatonicSteps","kind":"identifier"}],"abstract":[{"type":"text","text":"The number of diatonic pitch steps needed to go from a written to a sounding pitch. This allows for correct"},{"type":"text","text":" "},{"type":"text","text":"spelling of enharmonic transpositions. This value does not include octave-change values; the values for both"},{"type":"text","text":" "},{"type":"text","text":"need to be added to the written pitch to get the correct sounding pitch."}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDiatonicSteps","title":"MXLDiatonicSteps","navigatorTitle":[{"text":"MXLDiatonicSteps","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLDouble":{"url":"\/documentation\/ivormxl\/mxldouble","navigatorTitle":[{"kind":"identifier","text":"MXLDouble"}],"type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The double type indicates that the music is doubled one octave from what is currently written. If the above"},{"type":"text","text":" "},{"type":"text","text":"attribute is set to yes, the doubling is one octave above what is written, as for mixed flute \/ piccolo parts"},{"type":"text","text":" "},{"type":"text","text":"in band literature. Otherwise the doubling is one octave below what is written, as for mixed cello \/ bass"},{"type":"text","text":" "},{"type":"text","text":"parts in orchestral literature."}],"role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDouble","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLDouble"}],"title":"MXLDouble"},"doc://IvorMXL/documentation/IvorMXL/MXLTranspose/Content-swift.struct/init(diatonic:chromatic:octaveChange:double:)":{"url":"\/documentation\/ivormxl\/mxltranspose\/content-swift.struct\/init(diatonic:chromatic:octavechange:double:)","type":"topic","kind":"symbol","abstract":[{"text":"Creates a new ","type":"text"},{"code":"MXLTranspose.Content","type":"codeVoice"},{"text":".","type":"text"}],"role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTranspose\/Content-swift.struct\/init(diatonic:chromatic:octaveChange:double:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"diatonic","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLDiatonicSteps","preciseIdentifier":"s:7IvorMXL16MXLDiatonicStepsV","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"chromatic","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLSemitones","preciseIdentifier":"s:7IvorMXL12MXLSemitonesa","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"octaveChange","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLOctaveChange","preciseIdentifier":"s:7IvorMXL15MXLOctaveChangeV","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"double","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLDouble","preciseIdentifier":"s:7IvorMXL9MXLDoubleV","kind":"typeIdentifier"},{"text":"?)","kind":"text"}],"title":"init(diatonic:chromatic:octaveChange:double:)"},"doc://IvorMXL/documentation/IvorMXL/MXLOctaveChange":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLOctaveChange","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"MXLOctaveChange","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxloctavechange","role":"symbol","title":"MXLOctaveChange","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOctaveChange","type":"topic","abstract":[{"type":"text","text":"The number of octaves to shift a pitch or clef, such as when transposing a written pitch to a sounding pitch"},{"type":"text","text":" "},{"type":"text","text":"(the octave-change element) or positioning a treble clef for tenors, which would use a value of -1 (the"},{"type":"text","text":" "},{"type":"text","text":"clef-octave-change element)."}]},"doc://IvorMXL/documentation/IvorMXL/MXLSemitones":{"kind":"symbol","title":"MXLSemitones","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSemitones","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlsemitones","navigatorTitle":[{"text":"MXLSemitones","kind":"identifier"}],"abstract":[{"type":"text","text":"The semitones type is a number representing semitones, used for chromatic alteration. A value of -1"},{"type":"text","text":" "},{"type":"text","text":"corresponds to a flat and a value of 1 to a sharp. Decimal values like 0.5 (quarter tone sharp) are used for"},{"type":"text","text":" "},{"type":"text","text":"microtones."}],"role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSemitones"},"doc://IvorMXL/documentation/IvorMXL/MXLTranspose/Content-swift.struct":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Content"}],"kind":"symbol","navigatorTitle":[{"text":"Content","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxltranspose\/content-swift.struct","role":"symbol","title":"MXLTranspose.Content","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTranspose\/Content-swift.struct","type":"topic","abstract":[{"type":"text","text":"The transpose group represents what must be added to a written pitch to get a correct sounding pitch."}]},"doc://IvorMXL/documentation/IvorMXL/MXLTranspose":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTranspose"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLTranspose"}],"url":"\/documentation\/ivormxl\/mxltranspose","role":"symbol","title":"MXLTranspose","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTranspose","type":"topic","abstract":[{"type":"text","text":"The transpose type represents what must be added to a written pitch to get a correct sounding pitch. The"},{"type":"text","text":" "},{"type":"text","text":"optional number attribute refers to staff numbers, from top to bottom on the system. If absent, the"},{"type":"text","text":" "},{"type":"text","text":"transposition applies to all staves in the part. Per-staff transposition is most often used in parts that"},{"type":"text","text":" "},{"type":"text","text":"represent multiple instruments."}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"}}}