kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL12MXLSemitonesa","kind":"typeIdentifier","text":"MXLSemitones","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSemitones"},{"kind":"text","text":", "},{"kind":"externalParam","text":"octaveChange"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL15MXLOctaveChangeV","kind":"typeIdentifier","text":"MXLOctaveChange","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOctaveChange"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"double"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL9MXLDoubleV","kind":"typeIdentifier","text":"MXLDouble","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDouble"},{"kind":"text","text":"? = nil)"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"parameters":[{"name":"diatonic","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The diatonic element specifies the number of pitch steps needed to go from"},{"type":"text","text":" "},{"type":"text","text":"written to sounding pitch. This allows for correct spelling of enharmonic"},{"type":"text","text":" "},{"type":"text","text":"transpositions. This value does not include octave-change values; the values for"},{"type":"text","text":" "},{"type":"text","text":"both elements need to be added to the written pitch to get the correct sounding"},{"type":"text","text":" "},{"type":"text","text":"pitch."}]}]},{"name":"chromatic","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The chromatic element represents the number of semitones needed to get from"},{"type":"text","text":" "},{"type":"text","text":"written to sounding pitch. This value does not include octave-change values; the"},{"type":"text","text":" "},{"type":"text","text":"values for both elements need to be added to the written pitch to get the correct"},{"type":"text","text":" "},{"type":"text","text":"sounding pitch."}]}]},{"name":"octaveChange","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The octave-change element indicates how many octaves to add to get from written"},{"type":"text","text":" "},{"type":"text","text":"pitch to sounding pitch. The octave-change element should be included when using"},{"type":"text","text":" "},{"type":"text","text":"transposition intervals of an octave or more, and should not be present for"},{"type":"text","text":" "},{"type":"text","text":"intervals of less than an octave."}]}]},{"name":"double","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If the double element is present, it indicates that the music is doubled one"},{"type":"text","text":" "},{"type":"text","text":"octave from what is currently written."}]}]}],"kind":"parameters"}],"variants":[{"paths":["\/documentation\/ivormxl\/mxltranspose\/content-swift.struct\/init(diatonic:chromatic:octavechange:double:)"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTranspose","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTranspose\/Content-swift.struct"]]},"sections":[],"references":{"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLTranspose/Content-swift.struct/init(diatonic:chromatic:octaveChange:double:)":{"abstract":[{"type":"text","text":"Creates a new "},{"code":"MXLTranspose.Content","type":"codeVoice"},{"type":"text","text":"."}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTranspose\/Content-swift.struct\/init(diatonic:chromatic:octaveChange:double:)","title":"init(diatonic:chromatic:octaveChange:double:)","url":"\/documentation\/ivormxl\/mxltranspose\/content-swift.struct\/init(diatonic:chromatic:octavechange:double:)","type":"topic","role":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"diatonic","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLDiatonicSteps","preciseIdentifier":"s:7IvorMXL16MXLDiatonicStepsV","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"chromatic","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLSemitones","preciseIdentifier":"s:7IvorMXL12MXLSemitonesa","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"octaveChange","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLOctaveChange","preciseIdentifier":"s:7IvorMXL15MXLOctaveChangeV","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"double","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLDouble","preciseIdentifier":"s:7IvorMXL9MXLDoubleV","kind":"typeIdentifier"},{"text":"?)","kind":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLTranspose":{"type":"topic","abstract":[{"type":"text","text":"The transpose type represents what must be added to a written pitch to get a correct sounding pitch. The"},{"type":"text","text":" "},{"type":"text","text":"optional number attribute refers to staff numbers, from top to bottom on the system. If absent, the"},{"type":"text","text":" "},{"type":"text","text":"transposition applies to all staves in the part. Per-staff transposition is most often used in parts that"},{"type":"text","text":" "},{"type":"text","text":"represent multiple instruments."}],"url":"\/documentation\/ivormxl\/mxltranspose","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTranspose","kind":"identifier"}],"kind":"symbol","title":"MXLTranspose","navigatorTitle":[{"text":"MXLTranspose","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTranspose","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLOctaveChange":{"type":"topic","abstract":[{"type":"text","text":"The number of octaves to shift a pitch or clef, such as when transposing a written pitch to a sounding pitch"},{"type":"text","text":" "},{"type":"text","text":"(the octave-change element) or positioning a treble clef for tenors, which would use a value of -1 (the"},{"type":"text","text":" "},{"type":"text","text":"clef-octave-change element)."}],"url":"\/documentation\/ivormxl\/mxloctavechange","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLOctaveChange"}],"kind":"symbol","title":"MXLOctaveChange","navigatorTitle":[{"kind":"identifier","text":"MXLOctaveChange"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOctaveChange","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLDouble":{"type":"topic","abstract":[{"text":"The double type indicates that the music is doubled one octave from what is currently written. If the above","type":"text"},{"text":" ","type":"text"},{"text":"attribute is set to yes, the doubling is one octave above what is written, as for mixed flute \/ piccolo parts","type":"text"},{"text":" ","type":"text"},{"text":"in band literature. Otherwise the doubling is one octave below what is written, as for mixed cello \/ bass","type":"text"},{"text":" ","type":"text"},{"text":"parts in orchestral literature.","type":"text"}],"url":"\/documentation\/ivormxl\/mxldouble","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLDouble"}],"kind":"symbol","title":"MXLDouble","navigatorTitle":[{"kind":"identifier","text":"MXLDouble"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDouble","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLDiatonicSteps":{"type":"topic","title":"MXLDiatonicSteps","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDiatonicSteps","abstract":[{"text":"The number of diatonic pitch steps needed to go from a written to a sounding pitch. This allows for correct","type":"text"},{"text":" ","type":"text"},{"text":"spelling of enharmonic transpositions. This value does not include octave-change values; the values for both","type":"text"},{"text":" ","type":"text"},{"text":"need to be added to the written pitch to get the correct sounding pitch.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLDiatonicSteps"}],"navigatorTitle":[{"kind":"identifier","text":"MXLDiatonicSteps"}],"url":"\/documentation\/ivormxl\/mxldiatonicsteps"},"doc://IvorMXL/documentation/IvorMXL/MXLTranspose/Content-swift.struct":{"type":"topic","abstract":[{"type":"text","text":"The transpose group represents what must be added to a written pitch to get a correct sounding pitch."}],"url":"\/documentation\/ivormxl\/mxltranspose\/content-swift.struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Content","kind":"identifier"}],"kind":"symbol","title":"MXLTranspose.Content","navigatorTitle":[{"text":"Content","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTranspose\/Content-swift.struct","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLSemitones":{"navigatorTitle":[{"kind":"identifier","text":"MXLSemitones"}],"abstract":[{"text":"The semitones type is a number representing semitones, used for chromatic alteration. A value of -1","type":"text"},{"text":" ","type":"text"},{"text":"corresponds to a flat and a value of 1 to a sharp. Decimal values like 0.5 (quarter tone sharp) are used for","type":"text"},{"text":" ","type":"text"},{"text":"microtones.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSemitones","url":"\/documentation\/ivormxl\/mxlsemitones","role":"symbol","title":"MXLSemitones","type":"topic","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLSemitones"}]}}}