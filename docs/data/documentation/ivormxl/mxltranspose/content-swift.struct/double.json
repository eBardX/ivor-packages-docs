","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLTranspose/Content-swift.struct":{"title":"MXLTranspose.Content","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Content"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxltranspose\/content-swift.struct","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTranspose\/Content-swift.struct","abstract":[{"text":"The transpose group represents what must be added to a written pitch to get a correct sounding pitch.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"Content"}]},"doc://IvorMXL/documentation/IvorMXL/MXLTranspose/Content-swift.struct/double":{"title":"double","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"double"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL9MXLDoubleV","kind":"typeIdentifier","text":"MXLDouble"},{"kind":"text","text":"?"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxltranspose\/content-swift.struct\/double","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTranspose\/Content-swift.struct\/double","abstract":[{"text":"If the double element is present, it indicates that the music is doubled one octave from what is currently","type":"text"},{"text":" ","type":"text"},{"text":"written.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLTranspose":{"title":"MXLTranspose","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTranspose"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxltranspose","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTranspose","abstract":[{"text":"The transpose type represents what must be added to a written pitch to get a correct sounding pitch. The","type":"text"},{"text":" ","type":"text"},{"text":"optional number attribute refers to staff numbers, from top to bottom on the system. If absent, the","type":"text"},{"text":" ","type":"text"},{"text":"transposition applies to all staves in the part. Per-staff transposition is most often used in parts that","type":"text"},{"text":" ","type":"text"},{"text":"represent multiple instruments.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"MXLTranspose"}]},"doc://IvorMXL/documentation/IvorMXL/MXLDouble":{"title":"MXLDouble","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLDouble"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxldouble","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDouble","abstract":[{"text":"The double type indicates that the music is doubled one octave from what is currently written. If the above","type":"text"},{"text":" ","type":"text"},{"text":"attribute is set to yes, the doubling is one octave above what is written, as for mixed flute \/ piccolo parts","type":"text"},{"text":" ","type":"text"},{"text":"in band literature. Otherwise the doubling is one octave below what is written, as for mixed cello \/ bass","type":"text"},{"text":" ","type":"text"},{"text":"parts in orchestral literature.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"MXLDouble"}]}}}