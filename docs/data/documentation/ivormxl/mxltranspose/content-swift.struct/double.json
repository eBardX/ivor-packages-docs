struct":{"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTranspose\/Content-swift.struct","abstract":[{"text":"The transpose group represents what must be added to a written pitch to get a correct sounding pitch.","type":"text"}],"url":"\/documentation\/ivormxl\/mxltranspose\/content-swift.struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Content","kind":"identifier"}],"navigatorTitle":[{"text":"Content","kind":"identifier"}],"title":"MXLTranspose.Content","role":"symbol","type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLTranspose":{"type":"topic","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTranspose","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTranspose","title":"MXLTranspose","abstract":[{"type":"text","text":"The transpose type represents what must be added to a written pitch to get a correct sounding pitch. The"},{"type":"text","text":" "},{"type":"text","text":"optional number attribute refers to staff numbers, from top to bottom on the system. If absent, the"},{"type":"text","text":" "},{"type":"text","text":"transposition applies to all staves in the part. Per-staff transposition is most often used in parts that"},{"type":"text","text":" "},{"type":"text","text":"represent multiple instruments."}],"navigatorTitle":[{"text":"MXLTranspose","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxltranspose"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLTranspose/Content-swift.struct/double":{"kind":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTranspose\/Content-swift.struct\/double","url":"\/documentation\/ivormxl\/mxltranspose\/content-swift.struct\/double","role":"symbol","title":"double","abstract":[{"text":"If the double element is present, it indicates that the music is doubled one octave from what is currently","type":"text"},{"text":" ","type":"text"},{"text":"written.","type":"text"}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"double","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLDouble","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLDoubleV"},{"text":"?","kind":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLDouble":{"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDouble","url":"\/documentation\/ivormxl\/mxldouble","abstract":[{"text":"The double type indicates that the music is doubled one octave from what is currently written. If the above","type":"text"},{"text":" ","type":"text"},{"text":"attribute is set to yes, the doubling is one octave above what is written, as for mixed flute \/ piccolo parts","type":"text"},{"text":" ","type":"text"},{"text":"in band literature. Otherwise the doubling is one octave below what is written, as for mixed cello \/ bass","type":"text"},{"text":" ","type":"text"},{"text":"parts in orchestral literature.","type":"text"}],"type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLDouble"}],"title":"MXLDouble","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLDouble"}]}}}