struct":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTranspose\/Content-swift.struct","role":"symbol","navigatorTitle":[{"text":"Content","kind":"identifier"}],"type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Content","kind":"identifier"}],"abstract":[{"text":"The transpose group represents what must be added to a written pitch to get a correct sounding pitch.","type":"text"}],"url":"\/documentation\/ivormxl\/mxltranspose\/content-swift.struct","title":"MXLTranspose.Content"},"doc://IvorMXL/documentation/IvorMXL/MXLTranspose/Content-swift.struct/double":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"double","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLDouble","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLDoubleV"},{"text":"?","kind":"text"}],"role":"symbol","title":"double","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTranspose\/Content-swift.struct\/double","abstract":[{"type":"text","text":"If the double element is present, it indicates that the music is doubled one octave from what is currently"},{"type":"text","text":" "},{"type":"text","text":"written."}],"url":"\/documentation\/ivormxl\/mxltranspose\/content-swift.struct\/double","type":"topic","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLDouble":{"role":"symbol","url":"\/documentation\/ivormxl\/mxldouble","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLDouble","kind":"identifier"}],"navigatorTitle":[{"text":"MXLDouble","kind":"identifier"}],"abstract":[{"type":"text","text":"The double type indicates that the music is doubled one octave from what is currently written. If the above"},{"type":"text","text":" "},{"type":"text","text":"attribute is set to yes, the doubling is one octave above what is written, as for mixed flute \/ piccolo parts"},{"type":"text","text":" "},{"type":"text","text":"in band literature. Otherwise the doubling is one octave below what is written, as for mixed cello \/ bass"},{"type":"text","text":" "},{"type":"text","text":"parts in orchestral literature."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDouble","title":"MXLDouble","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLTranspose":{"navigatorTitle":[{"text":"MXLTranspose","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTranspose","kind":"identifier"}],"abstract":[{"text":"The transpose type represents what must be added to a written pitch to get a correct sounding pitch. The","type":"text"},{"text":" ","type":"text"},{"text":"optional number attribute refers to staff numbers, from top to bottom on the system. If absent, the","type":"text"},{"text":" ","type":"text"},{"text":"transposition applies to all staves in the part. Per-staff transposition is most often used in parts that","type":"text"},{"text":" ","type":"text"},{"text":"represent multiple instruments.","type":"text"}],"role":"symbol","url":"\/documentation\/ivormxl\/mxltranspose","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTranspose","title":"MXLTranspose","kind":"symbol"}}}