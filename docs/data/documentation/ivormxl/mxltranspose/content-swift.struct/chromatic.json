bol","title":"MXLTranspose","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTranspose","type":"topic","abstract":[{"type":"text","text":"The transpose type represents what must be added to a written pitch to get a correct sounding pitch. The"},{"type":"text","text":" "},{"type":"text","text":"optional number attribute refers to staff numbers, from top to bottom on the system. If absent, the"},{"type":"text","text":" "},{"type":"text","text":"transposition applies to all staves in the part. Per-staff transposition is most often used in parts that"},{"type":"text","text":" "},{"type":"text","text":"represent multiple instruments."}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLSemitones":{"kind":"symbol","title":"MXLSemitones","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSemitones","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlsemitones","navigatorTitle":[{"text":"MXLSemitones","kind":"identifier"}],"abstract":[{"type":"text","text":"The semitones type is a number representing semitones, used for chromatic alteration. A value of -1"},{"type":"text","text":" "},{"type":"text","text":"corresponds to a flat and a value of 1 to a sharp. Decimal values like 0.5 (quarter tone sharp) are used for"},{"type":"text","text":" "},{"type":"text","text":"microtones."}],"role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSemitones"}}}