{"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTranspose\/Content-swift.struct\/chromatic"},"metadata":{"symbolKind":"property","externalID":"s:7IvorMXL12MXLTransposeV7ContentV9chromaticSdvp","role":"symbol","title":"chromatic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"chromatic","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLSemitones","preciseIdentifier":"s:7IvorMXL12MXLSemitonesa","kind":"typeIdentifier"}],"modules":[{"name":"IvorMXL"}],"roleHeading":"Instance Property"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTranspose","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTranspose\/Content-swift.struct"]]},"sections":[],"abstract":[{"type":"text","text":"The chromatic element represents the number of semitones needed to get from written to sounding pitch. This"},{"type":"text","text":" "},{"type":"text","text":"value does not include octave-change values; the values for both elements need to be added to the written"},{"type":"text","text":" "},{"type":"text","text":"pitch to get the correct sounding pitch."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"chromatic","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLSemitones","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSemitones","preciseIdentifier":"s:7IvorMXL12MXLSemitonesa","kind":"typeIdentifier"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"inlineContent":[{"text":"Maps to a nested MusicXML ","type":"text"},{"code":"<chromatic>","type":"codeVoice"},{"text":" element.","type":"text"}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"p