":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLSemitones":{"abstract":[{"type":"text","text":"The semitones type is a number representing semitones, used for chromatic alteration. A value of -1"},{"type":"text","text":" "},{"type":"text","text":"corresponds to a flat and a value of 1 to a sharp. Decimal values like 0.5 (quarter tone sharp) are used for"},{"type":"text","text":" "},{"type":"text","text":"microtones."}],"title":"MXLSemitones","url":"\/documentation\/ivormxl\/mxlsemitones","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLSemitones"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSemitones","navigatorTitle":[{"kind":"identifier","text":"MXLSemitones"}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLTranspose/Content-swift.struct":{"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTranspose\/Content-swift.struct","abstract":[{"text":"The transpose group represents what must be added to a written pitch to get a correct sounding pitch.","type":"text"}],"url":"\/documentation\/ivormxl\/mxltranspose\/content-swift.struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Content","kind":"identifier"}],"navigatorTitle":[{"text":"Content","kind":"identifier"}],"title":"MXLTranspose.Content","role":"symbol","type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLTranspose":{"type":"topic","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTranspose",