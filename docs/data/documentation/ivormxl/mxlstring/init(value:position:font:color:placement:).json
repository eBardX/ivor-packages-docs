ype":"paragraph","inlineContent":[{"text":"The font attribute group gathers together attributes for determining the font within a credit or direction. They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font vs. a music font.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The color attribute group indicates the color of an element."}]}],"name":"color"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The placement attribute indicates whether something is above or below another element, such as a note or a notation.","type":"text"}]}],"name":"placement"}]}],"sections":[],"abstract":[{"text":"Creates a new ","type":"text"},{"type":"codeVoice","code":"MXLString"},{"text":".","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlstring\/init(value:position:font:color:placement:)"]}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLString\/init(value:position:font:color:placement:)","interfaceLanguage":"swift"},"metadata":{"modules":[{"name":"IvorMXL"}],"role":"symbol","roleHeading":"Initializer","title":"init(value:position:font:color:placement:)","symbolKind":"init","externalID":"s:7IvorMXL9MXLStringV5value8position4font5color9placementACSi_AA11MXLPositionVAA7MXLFontVAA8MXLColorVSgAA13MXLAboveBelowOSgtcfc","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"value","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"position","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLPosition","preciseIdentifier":"s:7IvorMXL11MXLPositionV","kind":"t