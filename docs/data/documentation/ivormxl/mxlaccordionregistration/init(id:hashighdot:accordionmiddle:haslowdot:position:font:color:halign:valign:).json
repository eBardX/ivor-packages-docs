doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"halign"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL18MXLLeftCenterRightO","text":"MXLLeftCenterRight","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLeftCenterRight"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"valign"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLValignO","text":"MXLValign","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValign"},{"kind":"text","text":"? = nil)"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The optional-unique-id attribute group allows an element to optionally specify an"},{"type":"text","text":" "},{"type":"text","text":"ID that is unique to the entire document. This attribute group is not used for a"},{"type":"text","text":" "},{"type":"text","text":"required id attribute, or for an id attribute that specifies an id reference."}],"type":"paragraph"}],"name":"id"},{"content":[{"inlineContent":[{"type":"text","text":"A Boolean value indicating whether the high (4′) section of the registration"},{"type":"text","text":" "},{"type":"text","text":"symbol has a dot."}],"type":"paragraph"}],"name":"hasHighDot"},{"content":[{"inlineContent":[{"type":"text","text":"The accordion-middle element indicates the presence of 1 to 3 dots in the middle"},{"type":"text","text":" "},{"type":"text","text":"(8′) section of the registration symbol. This element is omitted if no dots are"},{"type":"text","text":" "},{"type":"text","text":"present."}],"type":"paragraph"}],"name":"accordionMiddle"},{"content":[{"inlineContent":[{"type":"text","text":"A Boolean value indicating whether the low (16′) section of the registration"},{"type":"text","text":" "},{"type":"text","text":"symbol has a dot."}],"type":"paragraph"}],"name":"hasLowDot"},{"content":[{"inlineContent":[{"type":"text","text":"For most elements, any program will compute a default x and y position. The"},{"type":"text","text":" "},{"type":"text","text":"position attributes let this be changed two ways."}],"type":"paragraph"}],"name":"position"},{"content":[{"inlineContent":[{"type":"text","text":"The font attribute group gathers together attributes for determining the font"},{"type":"text","text":" "},{"type":"text","text":"within a credit or direction. They are based on the text styles for Cascading"},{"type":"text","text":" "},{"type":"text","text":"Style Sheets. The font-family is a comma-separated list of font names. The"},{"type":"text","text":" "},{"type":"text","text":"font-style can be normal or italic. The font-size can be one of the CSS sizes or a"},{"type":"text","text":" "},{"type":"text","text":"numeric point size. The font-weight can be normal or bold. The default is"},{"type":"text","text":" "},{"type":"text","text":"application-dependent, but is a text font vs. a music font."}],"type":"paragraph"}],"name":"font"},{"content":[{"inlineContent":[{"type":"text","text":"The color attribute group indicates the color of an element."}],"type":"paragraph"}],"name":"color"},{"content":[{"inlineContent":[{"type":"text","text":"In cases where text extends over more than one line, horizontal alignment and"},{"type":"text","text":" "},{"type":"text","text":"justify values can be different."}],"type":"paragraph"}],"name":"halign"},{"content":[{"inlineContent":[{"type":"text","text":"The valign attribute is used to indicate vertical alignment to the top, middle,"},{"type":"text","text":" "},{"type":"text","text":"bottom, or baseline of the text. Defaults are implementation-dependent."}],"type":"paragraph"}],"name":"valign"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlaccordionregistration\/init(id:hashighdot:accordionmiddle:haslowdot:position:font:color:halign:valign:)"]}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccordionRegistration\/init(id:hasHighDot:accordionMiddle:hasLowDot:position:font:color:halign:valign:)","interfaceLanguage":"swift"},"abstract":[{"text":"Creates a new ","type":"text"},{"code":"MXLAccordionRegistration","type":"codeVoice"},{"text":".","type":"text"}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLLeftCenterRight":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLLeftCenterRight"}],"title":"MXLLeftCenterRight","abstract":[{"text":"The left-center-right type is used to define horizontal alignment and text justification.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLeftCenterRight","role":"symbol","url":"\/documentation\/ivormxl\/mxlleftcenterright","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLLeftCenterRight"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLAccordionMiddle":{"type":"topic","title":"MXLAccordionMiddle","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccordionMiddle","abstract":[{"text":"The accordion-middle type may have values of 1, 2, or 3, corresponding to having 1 to 3 dots in the middle","type":"text"},{"text":" ","type":"text"},{"text":"section of the accordion registration symbol. This type is not used if no dots are present.","type":"text"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLAccordionMiddle","kind":"identifier"}],"navigatorTitle":[{"text":"MXLAccordionMiddle","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlaccordionmiddle"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLPosition":{"type":"topic","abstract":[{"type":"text","text":"For most elements, any program will compute a default x and y position. The position attributes let this be"},{"type":"text","text":" "},{"type":"text","text":"changed two ways."}],"url":"\/documentation\/ivormxl\/mxlposition","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPosition"}],"kind":"symbol","title":"MXLPosition","navigatorTitle":[{"kind":"identifier","text":"MXLPosition"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLAccordionRegistration":{"url":"\/documentation\/ivormxl\/mxlaccordionregistration","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLAccordionRegistration"}],"title":"MXLAccordionRegistration","abstract":[{"type":"text","text":"The accordion-registration type is used for accordion registration symbols. These are circular symbols divided"},{"type":"text","text":" "},{"type":"text","text":"horizontally into high, middle, and low sections that correspond to 4′, 8′, and 16′ pipes. Each accordion-"},{"type":"text","text":" "},{"type":"text","text":"high, accordion-middle, and accordion-low element represents the presence of one or more dots in the"},{"type":"text","text":" "},{"type":"text","text":"registration diagram. An accordion-registration element needs to have at least one of the child elements"},{"type":"text","text":" "},{"type":"text","text":"present."}],"navigatorTitle":[{"kind":"identifier","text":"MXLAccordionRegistration"}],"role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccordionRegistration","type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"type":"topic","abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"type":"text","text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is"},{"type":"text","text":" "},{"type":"text","text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF."}],"url":"\/documentation\/ivormxl\/mxlcolor","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"kind":"symbol","title":"MXLColor","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLValign":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLValign","kind":"identifier"}],"title":"MXLValign","abstract":[{"type":"text","text":"The valign type is used to indicate vertical alignment to the top, middle, bottom, or baseline of the text. If"},{"type":"text","text":" "},{"type":"text","text":"the text is on multiple lines, baseline alignment refers to the baseline of the lowest line of text. Defaults"},{"type":"text","text":" "},{"type":"text","text":"are implementation-dependent."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValign","role":"symbol","url":"\/documentation\/ivormxl\/mxlvalign","kind":"symbol","navigatorTitle":[{"text":"MXLValign","kind":"identifier"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLFont":{"type":"topic","title":"MXLFont","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","abstract":[{"type":"text","text":"The font attribute group gathers together attributes for determining the font within a credit or direction."},{"type":"text","text":" "},{"type":"text","text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of"},{"type":"text","text":" "},{"type":"text","text":"font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric"},{"type":"text","text":" "},{"type":"text","text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font"},{"type":"text","text":" "},{"type":"text","text":"vs. a music font."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFont"}],"navigatorTitle":[{"kind":"identifier","text":"MXLFont"}],"url":"\/documentation\/ivormxl\/mxlfont"},"doc://IvorMXL/documentation/IvorMXL/MXLAccordionRegistration/init(id:hasHighDot:accordionMiddle:hasLowDot:position:font:color:halign:valign:)":{"title":"init(id:hasHighDot:accordionMiddle:hasLowDot:position:font:color:halign:valign:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"hasHighDot","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"accordionMiddle","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLAccordionMiddle","preciseIdentifier":"s:7IvorMXL18MXLAccordionMiddleV","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"hasLowDot","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"position","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLPosition","preciseIdentifier":"s:7IvorMXL11MXLPositionV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"font","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLFont","preciseIdentifier":"s:7IvorMXL7MXLFontV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"color","kind":"externalParam"},{"text":": ","kind":"text"},{"tex