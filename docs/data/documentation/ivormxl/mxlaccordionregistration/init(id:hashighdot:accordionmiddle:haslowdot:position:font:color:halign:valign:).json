gistration type is used for accordion registration symbols. These are circular symbols divided"},{"text":" ","type":"text"},{"text":"horizontally into high, middle, and low sections that correspond to 4’, 8’, and 16’ pipes. Each accordion-","type":"text"},{"text":" ","type":"text"},{"text":"high, accordion-middle, and accordion-low element represents the presence of one or more dots in the","type":"text"},{"text":" ","type":"text"},{"text":"registration diagram. An accordion-registration element needs to have at least one of the child elements","type":"text"},{"text":" ","type":"text"},{"text":"present.","type":"text"}],"navigatorTitle":[{"text":"MXLAccordionRegistration","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLAccordionMiddle":{"title":"MXLAccordionMiddle","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLAccordionMiddle","kind":"identifier"}],"kind":"symbol","type":"topic","abstract":[{"text":"The accordion-middle type may have values of 1, 2, or 3, corresponding to having 1 to 3 dots in the middle","type":"text"},{"text":" ","type":"text"},{"text":"section of the accordion registration symbol. This type is not used if no dots are present.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccordionMiddle","url":"\/documentation\/ivormxl\/mxlaccordionmiddle","navigatorTitle":[{"text":"MXLAccordionMiddle","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"abstract":[{"text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in","type":"text"},{"type":"text","text":" "},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"title":"MXLColor","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlcolor","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor"},"doc://IvorMXL/documentation/IvorMXL/MXLLeftCenterRight":{"title":"MXLLeftCenterRight","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"kind":"text","text":" "},{"text":"MXLLeftCenterRight","kind":"identifier"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlleftcenterright","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLeftCenterRight","abstract":[{"text":"The left-center-right type is used to define horizontal alignment and text justification.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"MXLLeftCenterRight"}]},"doc://IvorMXL/documentation/IvorMXL/MXLPosition":{"title":"MXLPosition","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPosition"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlposition","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","abstract":[{"text":"For most elements, any program will compute a default x and y position. The position attributes let this be","type":"text"},{"text":" ","type":"text"},{"text":"changed two ways.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"MXLPosition"}]},"doc://IvorMXL/documentation/IvorMXL/MXLValign":{"abstract":[{"type":"text","text":"The valign type is used to indicate vertical alignment to the top, middle, bottom, or baseline of the text. If"},{"text":" ","type":"text"},{"text":"the text is on multiple lines, baseline alignment refers to the baseline of the lowest line of text. Defaults","type":"text"},{"text":" ","type":"text"},{"text":"are implementation-dependent.","type":"text"}],"title":"MXLValign","kind":"symbol","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLValign","kind":"identifier"}],"navigatorTitle":[{"text":"MXLValign","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlvalign","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValign"}}}