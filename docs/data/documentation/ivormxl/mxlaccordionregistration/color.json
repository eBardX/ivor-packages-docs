vorMXL8MXLColorV","text":"MXLColor","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"abstract":[{"text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in","type":"text"},{"type":"text","text":" "},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"title":"MXLColor","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlcolor","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor"},"doc://IvorMXL/documentation/IvorMXL/MXLAccordionRegistration":{"title":"MXLAccordionRegistration","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLAccordionRegistration","kind":"identifier"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlaccordionregistration","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccordionRegistration","abstract":[{"type":"text","text":"The accordion-registration type is used for accordion registration symbols. These are circular symbols divided"},{"text":" ","type":"text"},{"text":"horizontally into high, middle, and low sections that correspond to 4’, 8’, and 16’ pipes. Each accordion-","type":"text"},{"text":" ","type":"text"},{"text":"high, accordion-middle, and accordion-low element represents the presence of one or more dots in the","type":"text"},{"text":" ","type":"text"},{"text":"registration diagram. An accordion-registration element needs to have at least one of the child elements","type":"text"},{"text":" ",