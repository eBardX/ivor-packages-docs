xt":"MXLColor"}],"navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"type":"text","text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is"},{"type":"text","text":" "},{"type":"text","text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor"},"doc://IvorMXL/documentation/IvorMXL/MXLAccordionRegistration/color":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccordionRegistration\/color","url":"\/documentation\/ivormxl\/mxlaccordionregistration\/color","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"color"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL8MXLColorV","kind":"typeIdentifier","text":"MXLColor"},{"kind":"text","text":"?"}],"abstract":[{"type":"text","text":"The color attribute group indicates the color of an element."}],"title":"color","type":"topic","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLAccordionRegistration":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlaccordionregistration","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLAccordionRegistration"}],"navigatorTitle":[{"kind":"identifier","text":"MXLAccordionRegistration"}],"abstract":[{"type":"text","text":"The accordion-registration type is used for accordion registration symbols. These are circular symbols divided"},{"type":"text","text":" "},{"type":"text","text":"horizontally into high, middle, and low sections that correspond to 4’, 8’, and 16’ pipes. Each accordion-"},{"type":"text","text":" "},{"type":"text","text":"high, accordion-middle, and accordion-low element represents the presence of one or more dots in the"},{"type":"text","text":" "},{"type":"text","text":"registration diagram. An accordion-registration element needs to have at least one of the child elements"},{"type":"text","text":" "},{"type":"text","text":"present."}],"title":"MXLAccordionRegistration","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccordionRegistration","kind":"symbol"}}}