n\/ivormxl\/mxlcolor","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"kind":"symbol","title":"MXLColor","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLAccordionRegistration/color":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccordionRegistration\/color","type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlaccordionregistration\/color","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"color","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLColor","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLColorV"},{"text":"?","kind":"text"}],"title":"color","abstract":[{"text":"The color attribute group indicates the color of an element.","type":"text"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLAccordionRegistration":{"url":"\/documentation\/ivormxl\/mxlaccordionregistration","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLAccordionRegistration"}],"title":"MXLAccordionRegistration","abstract":[{"type":"text","text":"The accordion-registration type is used for accordion registration symbols. These are circular symbols divided"},{"type":"text","text":" "},{"type":"text","text":"horizontally into high, middle, and low sections that correspond to 4′, 8′, and 16′ pipes. Each accordion-"},{"type":"text","text":" "},{"type":"text","text":"high, accordion-middle, and accordion-low element represents the presence of one or more dots in the"},{"type":"text","text":" "},{"type":"text","text":"registration diagram. An accordion-registration element needs to have at least one of the child elements"},{"type":"text","text":" "},{"type":"text","text":"present."}],"navigatorTitle":[{"kind":"identifier","text":"MXLAccordionRegistration"}],"role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccordionRegistration","type":"topic"}}}