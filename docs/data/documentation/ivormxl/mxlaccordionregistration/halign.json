{"sections":[],"abstract":[{"text":"In cases where text extends over more than one line, horizontal alignment and justify values can be different.","type":"text"},{"text":" ","type":"text"},{"text":"The most typical case is for credits, such as:","type":"text"}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccordionRegistration"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccordionRegistration\/halign"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"halign"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLLeftCenterRight","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLeftCenterRight","preciseIdentifier":"s:7IvorMXL18MXLLeftCenterRightO"},{"kind":"text","text":"?"}],"platforms":["macOS"]}]},{"content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"inlineContent":[{"type":"text","text":"Words and music by Pat Songwriter"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Typically this type of credit is aligned to the right, so that the position information refers to the right-"},{"type":"text","text":" "},{"type":"text","text":"most part of the text. But in this example, the text is center-justified, not right-justified."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The halign attribute is used in these situations. If it is not present, its value is the same as for the"},{"type":"text","text":" "},{"type":"text","text":"justify attribute. For elements where a justify attribute is not allowed, the default is implementation-"},{"type":"text","text":" "},{"type":"text","text":"dependent."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Maps to the MusicXML "},{"code":"halign","type":"codeVoice"},{"type":"text","text":" attribute."}],"type":"paragraph"}],"kind":"content"}],"metadata":{"symbolKind":"property","externalID":"s:7IvorMXL24MXLAccordionRegistrationV6halignAA18MXLLeftCenterRightOSgvp","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"halign"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLLeftCenterRight","preciseIdentifier":"s:7IvorMXL18MXLLeftCenterRightO"},{"kind":"text","text":"?"}],"role":"symbol","title":"halign","roleHeading":"Instance Property","modules":[{"name":"IvorMXL"}]},"variants":[{"paths":["\/documentation\/ivormxl\/mxlaccordionregistration\/halign"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","references":{"doc://IvorMXL/documentation/IvorMXL/MXLLeftCenterRight":{"type":"topic","kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLLeftCenterRight","kind":"identifier"}],"navigatorTitle":[{"text":"MXLLeftCenterRight","kind":"identifier"}],"abstract":[{"text":"The left-center-right type is used to define horizontal alignment and text justification.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLeftCenterRight","title":"MXLLeftCenterRight","role":"symbol","url":"\/documentation\/ivormxl\/mxlleftcenterright"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLAccordionRegistration/halign":{"type":"topic","kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"halign","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL18MXLLeftCenterRightO","text":"MXLLeftCenterRight","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"abstract":[{"text":"In cases where text extends over more than one line, horizontal alignment and justify values can be different.","type":"text"},{"text":" ","type":"text"},{"text":"The most typical case is for credits, such as:","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccordionRegistration\/halign","title":"halign","role":"symbol","url":"\/documentation\/ivormxl\/mxlaccordionregistration\/halign"},"doc://IvorMXL/documentation/IvorMXL/MXLAccordionRegistration":{"type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLAccordionRegistration","kind":"identifier"}],"navigatorTitle":[{"text":"MXLAccordionRegistration","kind":"identifier"}],"abstract":[{"text":"The accordion-registration type is used for accordion registration symbols. These are circular symbols divided","type":"text"},{"text":" ","type":"text"},{"text":"horizontally into high, middle, and low sections that correspond to 4’, 8’, and 16’ pipes. Each accordion-","type":"text"},{"text":" ","type":"text"},{"text":"high, accordion-middle, and accordion-low element represents the presence of one or more dots in the","type":"text"},{"text":" ","type":"text"},{"text":"registration diagram. An accordion-registration element needs to have at least one of the child elements","type":"text"},{"text":" ","type":"text"},{"text":"present.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccordionRegistration","title":"MXLAccordionRegistration","role":"symbol","url":"\/documentation\/ivormxl\/mxlaccordionregistration"}}}