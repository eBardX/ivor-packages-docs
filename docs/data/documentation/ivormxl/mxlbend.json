rMXL\/MXLBend\/Content-swift.enum","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Content","kind":"identifier"}],"role":"symbol","kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxlbend\/content-swift.enum","navigatorTitle":[{"text":"Content","kind":"identifier"}],"title":"MXLBend.Content","abstract":[{"text":"One of the alternatives for Bend.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLBend/sound":{"abstract":[{"text":"The bend-sound type is used for bend and slide elements, and is similar to the trill-sound attribute group.","type":"text"},{"text":" ","type":"text"},{"text":"Here the beats element refers to the number of discrete elements (like MIDI pitch bends) used to represent a","type":"text"},{"text":" ","type":"text"},{"text":"continuous bend or slide. The first-beat indicates the percentage of the duration for starting a bend; the","type":"text"},{"text":" ","type":"text"},{"text":"last-beat the percentage for ending it. The default choices are:","type":"text"}],"title":"sound","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBend\/sound","kind":"symbol","url":"\/documentation\/ivormxl\/mxlbend\/sound","type":"topic","fragments":[{"kind":"keyword","text":"let"},{"text":" ","kind":"text"},{"text":"sound","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLBendSound","preciseIdentifier":"s:7IvorMXL12MXLBendSoundV","kind":"typeIdentifier"}],"role":"symbol"},"doc://IvorMXL/SH":{"title":"Swift.Hashable","type":"unresolvable","identifier":"doc:\/\/IvorMXL\/SH"},"doc://IvorMXL/documentation/IvorMXL/MXLBend/font":{"url":"\/documentation\/ivormxl\/mxlbend\/font","kind":"symbol","title":"font","abstract":[{"type":"text","text":"The font attribute group gathers together attributes for determining the font within a credit or direction."},{"type":"text","text":" "},{"type":"text","text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of"},{"type":"text","text":" "},{"type":"text","text":"font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric"},{"type":"text","text":" "},{"type":"text","text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font"},{"text":" ","type":"text"},{"text":"vs. a music font.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBend\/font","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"font","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL7MXLFontV","text":"MXLFont","kind":"typeIdentifier"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLBend/position":{"url":"\/documentation\/ivormxl\/mxlbend\/position","kind":"symbol","title":"position","abstract":[{"text":"For most elements, any program will compute a default x and y position. The position attributes let this be","type":"text"},{"text":" ","type":"text"},{"text":"changed two ways.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBend\/position","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"position","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL11MXLPositionV","text":"MXLPosition","kind":"typeIdentifier"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLBend/color":{"kind":"symbol","title":"color","url":"\/documentation\/ivormxl\/mxlbend\/color","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"color","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL8MXLColorV","text":"MXLColor","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBend\/color","abstract":[{"text":"The color attribute group indicates the color of an element.","type":"text"}]}}}