\/MXLBend\/alter","abstract":[{"type":"text","text":"The bend-alter element indicates the number of semitones in the bend, similar to the alter element. As with"},{"type":"text","text":" "},{"type":"text","text":"the alter element, numbers like 0.5 can be used to indicate microtones. Negative values indicate pre-bends or"},{"type":"text","text":" "},{"type":"text","text":"releases. The pre-bend and release elements are used to distinguish what is intended. Because the bend-alter"},{"type":"text","text":" "},{"type":"text","text":"element represents the number of steps in the bend, a release after a bend has a negative bend-alter value,"},{"type":"text","text":" "},{"type":"text","text":"not a zero value."}]},"doc://IvorMXL/documentation/IvorMXL/MXLBend":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBend","title":"MXLBend","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLBend","kind":"identifier"}],"navigatorTitle":[{"text":"MXLBend","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlbend","abstract":[{"text":"The bend type is used in guitar notation and tablature. A single note with a bend and release will contain two","type":"text"},{"text":" ","type":"text"},{"text":"bend elements: the first to represent the bend and the second to represent the release. The shape attribute","type":"text"},{"text":" ","type":"text"},{"text":"distinguishes between the angled bend symbols commonly used in standard notation and the curved bend symbols","type":"text"},{"text":" ","type":"text"},{"text":"commonly used in both tablature and standard notation.","type":"text"}]},"doc://IvorMXL/s8SendableP":{"title":"Swift.Sendable","type":"unresolvable","identifier":"doc:\/\/IvorMXL\/s8SendableP"},"doc://IvorMXL/documentation/IvorMXL/MXLBend/Shape-swift.enum":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBend\/Shape-swift.enum","title":"MXLBend.Shape","kind":"symbol","role"