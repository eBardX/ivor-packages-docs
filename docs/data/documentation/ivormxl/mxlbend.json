und","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL12MXLBendSoundV","text":"MXLBendSound","kind":"typeIdentifier"},{"text":")","kind":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLBend/sound":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBend\/sound","abstract":[{"type":"text","text":"The bend-sound type is used for bend and slide elements, and is similar to the trill-sound attribute group."},{"text":" ","type":"text"},{"type":"text","text":"Here the beats element refers to the number of discrete elements (like MIDI pitch bends) used to represent a"},{"text":" ","type":"text"},{"type":"text","text":"continuous bend or slide. The first-beat indicates the percentage of the duration for starting a bend; the"},{"text":" ","type":"text"},{"text":"last-beat the percentage for ending it. The default choices are:","type":"text"}],"title":"sound","type":"topic","kind":"symbol","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sound","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLBendSound","preciseIdentifier":"s:7IvorMXL12MXLBendSoundV","kind":"typeIdentifier"}],"url":"\/documentation\/ivormxl\/mxlbend\/sound"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/s16SendableMetatypeP":{"identifier":"doc:\/\/IvorMXL\/s16SendableMetatypeP","title":"Swift.SendableMetatype","type":"unresolvable"},"doc://IvorMXL/SQ":{"identifier":"doc:\/\/IvorMXL\/SQ","type":"unresolvable","title":"Swift.Equatable"},"doc://IvorMXL/s9EscapableP":{"identifier":"doc:\/\/IvorMXL\/s9EscapableP","title":"Swift.Escapable","type":"unresolvable"},"doc://IvorMXL/documentation/IvorMXL/MXLBend/withBar":{"type":"topic","abstract":[{"type":"text","text":"The with-bar element indicates that the bend is to be done at the bridge with a whammy or vibrato bar. The"},{"type":"text","text":" "},{"type":"text","text":"content of the element indicates how this should be notated. Content values of “scoop” and “dip” refer to the"},{"type":"text","text":" "},{"type":"text","text":"SMuFL guitarVibratoBarScoop and guitarVibratoBarDip glyphs."}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"withBar","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLPlacementText","preciseIdentifier":"s:7IvorMXL16MXLPlacementTextV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"url":"\/documentation\/ivormxl\/mxlbend\/withbar","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBend\/withBar","kind":"symbol","role":"symbol","title":"withBar"},"doc://IvorMXL/documentation/IvorMXL/MXLBend/alter":{"abstract":[{"type":"text","text":"The bend-alter element indicates the number of semitones in the bend, similar to the alter element. As with"},{"type":"text","text":" "},{"type":"text","text":"the alter element, numbers like 0.5 can be used to indicate microtones. Negative values indicate pre-bends or"},{"type":"text","text":" "},{"type":"text","text":"releases. The pre-bend and release elements are used to distinguish what is intended. Because the bend-alter"},{"type":"text","text":" "},{"type":"text","text":"element represents the number of steps in the bend, a release after a bend has a negative bend-alter value,"},{"type":"text","text":" "},{"type":"text","text":"not a zero value."}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"alter","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL12MXLSemitonesa","kind":"typeIdentifier","text":"MXLSemitones"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBend\/alter","type":"topic","url":"\/documentation\/ivormxl\/mxlbend\/alter","role":"symbol","title":"alter"}}}