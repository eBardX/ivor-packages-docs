ion","preciseIdentifier":"s:7IvorMXL11MXLPositionV"}],"role":"symbol","abstract":[{"text":"For most elements, any program will compute a default x and y position. The position attributes let this be","type":"text"},{"text":" ","type":"text"},{"text":"changed two ways.","type":"text"}],"kind":"symbol","title":"position","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBend\/position"},"doc://IvorMXL/documentation/IvorMXL/MXLBend/font":{"url":"\/documentation\/ivormxl\/mxlbend\/font","title":"font","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"font","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLFont","preciseIdentifier":"s:7IvorMXL7MXLFontV","kind":"typeIdentifier"}],"abstract":[{"text":"The font attribute group gathers together attributes for determining the font within a credit or direction.","type":"text"},{"text":" ","type":"text"},{"text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of","type":"text"},{"text":" ","type":"text"},{"text":"font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric","type":"text"},{"text":" ","type":"text"},{"text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font","type":"text"},{"text":" ","type":"text"},{"text":"vs. a music font.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBend\/font","kind":"symbol","role":"symbol","type":"topic"},"doc://IvorMXL/s8SendableP":{"identifier":"doc:\/\/IvorMXL\/s8SendableP","type":"unresolvable","title":"Swift.Sendable"},"doc://IvorMXL/documentation/IvorMXL/MXLBend/Equatable-Implementations":{"abstract":[],"kind":"article","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBend\/Equatable-Implementations","type":"topic","url":"\/documentation\/ivormxl\/mxlbend\/equatable-implementations","role":"collectionGroup","title":"Equatable Implementat