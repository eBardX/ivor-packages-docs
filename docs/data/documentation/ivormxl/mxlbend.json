","text":"SMuFL guitarVibratoBarScoop and guitarVibratoBarDip glyphs."}],"title":"withBar","kind":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBend\/withBar","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"withBar","kind":"identifier"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL16MXLPlacementTextV","kind":"typeIdentifier","text":"MXLPlacementText"},{"kind":"text","text":"?"}],"role":"symbol","url":"\/documentation\/ivormxl\/mxlbend\/withbar"},"doc://IvorMXL/documentation/IvorMXL/MXLBend/font":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBend\/font","url":"\/documentation\/ivormxl\/mxlbend\/font","fragments":[{"text":"let","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"font"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL7MXLFontV","kind":"typeIdentifier","text":"MXLFont"}],"title":"font","abstract":[{"text":"The font attribute group gathers together attributes for determining the font within a credit or direction.","type":"text"},{"text":" ","type":"text"},{"text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of","type":"text"},{"text":" ","type":"text"},{"text":"font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric","type":"text"},{"type":"text","text":" "},{"type":"text","text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font"},{"type":"text","text":" "},{"text":"vs. a music font.","type":"text"}],"type":"topic"},"doc://IvorMXL/SQ":{"type":"unresolvable","title":"Swift.Equatable","identifier":"doc:\/\/IvorMXL\/SQ"},"doc://IvorMXL/documentation/IvorMXL/MXLBend/Content-swift.enum":{"type":"topic","abstract":[{"text":"One of the alternatives for Bend.","type":"text"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlbend\/co