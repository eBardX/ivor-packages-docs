" "},{"type":"text","text":"information to an application reading a file than encoding the same music in separate parts, so its use is"},{"type":"text","text":" "},{"type":"text","text":"preferred in this situation if feasible. A regular staff is the standard default staff-type."}]},"doc://IvorMXL/documentation/IvorMXL/MXLStaffDetails/printsObject":{"title":"printsObject","type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlstaffdetails\/printsobject","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"printsObject","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails\/printsObject","abstract":[{"text":"A Boolean value indicating whether to print an object (e.g. a note or a rest). Defaults to ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" if not","type":"text"},{"text":" ","type":"text"},{"text":"specified.","type":"text"}]},"doc://IvorMXL/SH":{"identifier":"doc:\/\/IvorMXL\/SH","title":"Swift.Hashable","type":"unresolvable"},"doc://IvorMXL/documentation/IvorMXL/MXLStaffDetails/staffSize":{"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails\/staffSize","url":"\/documentation\/ivormxl\/mxlstaffdetails\/staffsize","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"staffSize","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL12MXLStaffSizeV","text":"MXLStaffSize","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"abstract":[{"type":"text","text":"How large a staff space is on this staff."}],"kind":"symbol","role":"symbol","title":"staffSize"},"doc://IvorMXL/documentation/IvorMXL/MXLStaffDetails/number":{"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"number"},{"kind":"text","text":": "},{"