","text":"preferred in this situation if feasible. A regular staff is the standard default staff-type."}],"url":"\/documentation\/ivormxl\/mxlstaffdetails\/kind","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Kind"}],"kind":"symbol","title":"MXLStaffDetails.Kind","navigatorTitle":[{"kind":"identifier","text":"Kind"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails\/Kind","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLStaffDetails/staffTuning":{"abstract":[{"type":"text","text":"The tunings for each line of a tablature staff."}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails\/staffTuning","url":"\/documentation\/ivormxl\/mxlstaffdetails\/stafftuning","role":"symbol","title":"staffTuning","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"staffTuning"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:7IvorMXL14MXLStaffTuningV","kind":"typeIdentifier","text":"MXLStaffTuning"},{"kind":"text","text":"]"}]},"doc://IvorMXL/s9EscapableP":{"title":"Swift.Escapable","identifier":"doc:\/\/IvorMXL\/s9EscapableP","type":"unresolvable"},"doc://IvorMXL/documentation/IvorMXL/MXLStaffDetails":{"type":"topic","abstract":[{"type":"text","text":"The staff-details element is used to indicate different types of staves. The optional number attribute"},{"type":"text","text":" "},{"type":"text","text":"specifies the staff number from top to bottom on the system, as with clef. The print-object attribute is used"},{"type":"text","text":" "},{"type":"text","text":"to indicate when a staff is not printed in a part, usually in large scores where empty parts are omitted. It"},{"type":"text","text":" "},{"type":"text","text":"is yes by default. If print-spacing is yes while print-object is no, the score is printed in cutaway format"},{"type":"text","text":" "},{"type":"text","text":"where vertical space 