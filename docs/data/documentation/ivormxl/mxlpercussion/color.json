text":"?"}],"title":"color"},"doc://IvorMXL/documentation/IvorMXL/MXLPercussion":{"role":"symbol","kind":"symbol","title":"MXLPercussion","abstract":[{"text":"The percussion element is used to define percussion pictogram symbols. Definitions for these symbols can be","type":"text"},{"text":" ","type":"text"},{"text":"found in Kurt Stone’s “Music Notation in the Twentieth Century” on pages 206-212 and 223. Some values are","type":"text"},{"text":" ","type":"text"},{"text":"added to these based on how usage has evolved in the 30 years since Stone’s book was published.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlpercussion","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPercussion","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPercussion","navigatorTitle":[{"text":"MXLPercussion","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLColor","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","title":"MXLColor","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlcolor"}}}