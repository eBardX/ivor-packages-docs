reciseIdentifier":"s:7IvorMXL8MXLColorV","text":"MXLColor","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"abstract":[{"type":"text","text":"The color attribute group indicates the color of an element."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPercussion\/color","title":"color","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLPercussion":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPercussion","title":"MXLPercussion","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPercussion"}],"abstract":[{"text":"The percussion element is used to define percussion pictogram symbols. Definitions for these symbols can be","type":"text"},{"text":" ","type":"text"},{"text":"found in Kurt Stone’s “Music Notation in the Twentieth Century” on pages 206-212 and 223. Some values are","type":"text"},{"text":" ","type":"text"},{"text":"added to these based on how usage has evolved in the 30 years since Stone’s book was published.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlpercussion","kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLPercussion"}]},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlcolor","title":"MXLColor","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"type":"text","text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is"},{"type":"text","text":" "},{"type":"text","text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor"}}}