tion\/ivormxl\/mxlpercussion\/color","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"kind":"text","text":" "},{"text":"color","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLColor","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLColorV"},{"text":"?","kind":"text"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"abstract":[{"text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in","type":"text"},{"type":"text","text":" "},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"title":"MXLColor","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlcolor","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor"},"doc://IvorMXL/documentation/IvorMXL/MXLPercussion":{"navigatorTitle":[{"text":"MXLPercussion","kind":"identifier"}],"abstract":[{"type":"text","text":"The percussion element is used to define percussion pictogram symbols. Definitions for these symbols can be"},{"type":"text","text":" "},{"type":"text","text":"found in Kurt Stone’s “Music Notation in the Twentieth Century” on pages 206-212 and 223. Some values are"},{"type":"text","text":" "},{"type":"text","text":"added to these based on how usage has evolved in the 30 years since Stone’s book was published."}],"title":"MXLPercussion","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPercussion","kind":"symbol","url":"\/documentation\/ivormxl\/mxlpercussion","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPer