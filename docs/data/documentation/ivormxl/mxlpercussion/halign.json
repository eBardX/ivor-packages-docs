{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"halign"},{"kind":"text","text":": "},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLeftCenterRight","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL18MXLLeftCenterRightO","text":"MXLLeftCenterRight"},{"kind":"text","text":"?"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"inlineContent":[{"type":"text","text":"Words and music by Pat Songwriter"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Typically this type of credit is aligned to the right, so that the position information refers to the right-"},{"type":"text","text":" "},{"type":"text","text":"most part of the text. But in this example, the text is center-justified, not right-justified."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The halign attribute is used in these situations. If it is not present, its value is the same as for the"},{"type":"text","text":" "},{"type":"text","text":"justify attribute. For elements where a justify attribute is not allowed, the default is implementation-"},{"type":"text","text":" "},{"type":"text","text":"dependent."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Maps to the MusicXML "},{"type":"codeVoice","code":"halign"},{"type":"text","text":" attribute."}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlpercussion\/halign"]}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPercussion\/halign"},"metadata":{"roleHeading":"Instance Property","externalID":"s:7IvorMXL13MXLPercussionV6halignAA18MXLLeftCenterRightOSgvp","role":"symbol","title":"halign","modules":[{"name":"IvorMXL"}],"symbolKind":"property","fragments":[{"k