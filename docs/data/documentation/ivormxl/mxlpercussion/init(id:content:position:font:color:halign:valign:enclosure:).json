int size. The font-weight can be normal or bold. The default is application-dependent, but is a text font vs. a music font."}]}],"name":"font"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The color attribute group indicates the color of an element."}]}],"name":"color"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In cases where text extends over more than one line, horizontal alignment and justify values can be different. The most typical case is for credits, such as:"}]}],"name":"halign"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The valign attribute is used to indicate vertical alignment to the top, middle, bottom, or baseline of the text. Defaults are implementation-dependent."}]}],"name":"valign"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The enclosure attribute group is used to specify the formatting of an enclosure around text or symbols."}]}],"name":"enclosure"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLColor","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","title":"MXLColor","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlcolor"},"doc://IvorMXL/documentation/IvorMXL/MXLFont":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLFont"}],"abstract":[{"text":"The font attribute group gathers together attributes for determining the font within a credit or direction.","type":"text"},{"text":" ","type":"text"},{"text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of","type":"text"},{"text":" ","type":"text"},{"text":"font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric","type":"text"},{"text":" ","type":"text"},{"text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font","type":"text"},{"text":" ","type":"text"},{"text":"vs. a music font.","type":"text"}],"kind":"symbol","title":"MXLFont","url":"\/documentation\/ivormxl\/mxlfont","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFont"}]},"doc://IvorMXL/documentation/IvorMXL/MXLValign":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLValign"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValign","title":"MXLValign","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLValign"}],"abstract":[{"type":"text","text":"The valign type is used to indicate vertical alignment to the top, middle, bottom, or baseline of the text. If"},{"type":"text","text":" "},{"type":"text","text":"the text is on multiple lines, baseline alignment refers to the baseline of the lowest line of text. Defaults"},{"type":"text","text":" "},{"type":"text","text":"are implementation-dependent."}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlvalign"},"doc://IvorMXL/documentation/IvorMXL/MXLEnclosureShape":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnclosureShape","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLEnclosureShape"}],"abstract":[{"text":"The enclosure-shape type describes the shape and presence \/ absence of an enclosure around text or symbols. A","type":"text"},{"text":" ","type":"text"},{"text":"bracket enclosure is similar to a rectangle with the bottom line missing, as is common in jazz notation. An","type":"text"},{"text":" ","type":"text"},{"text":"inverted-bracket enclosure is similar to a rectangle with the top line missing.","type":"text"}],"kind":"symbol","title":"MXLEnclosureShape","url":"\/documentation\/ivormxl\/mxlenclosureshape","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLEnclosureShape"}]},"doc://IvorMXL/documentation/IvorMXL/MXLPosition":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLPosition"}],"abstract":[{"text":"For most elements, any program will compute a default x and y position. The position attributes let this be","type":"text"},{"text":" ","type":"text"},{"text":"changed two ways.","type":"text"}],"kind":"symbol","title":"MXLPosition","url":"\/documentation\/ivormxl\/mxlposition","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPosition"}]},"doc://IvorMXL/documentation/IvorMXL/MXLPercussion":{"role":"symbol","kind":"symbol","title":"MXLPercussion","abstract":[{"text":"The percussion element is used to define percussion pictogram symbols. Definitions for these symbols can be","type":"text"},{"text":" ","type":"text"},{"text":"found in Kurt Stone’s “Music Notation in the Twentieth Century” on pages 206-212 and 223. Some values are","type":"text"},{"text":" ","type":"text"},{"text":"added to these based on how usage has evolved in the 30 years since Stone’s book was published.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlpercussion","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","ki