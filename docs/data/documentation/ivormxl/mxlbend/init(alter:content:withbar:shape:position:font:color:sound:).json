,"kind":"text"},{"text":"MXLBendSound","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL12MXLBendSoundV"},{"text":")","kind":"text"}]},"abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLBend"},{"type":"text","text":"."}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBend"]]},"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"init","kind":"keyword"},{"text":"(","kind":"text"},{"text":"alter","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSemitones","preciseIdentifier":"s:7IvorMXL12MXLSemitonesa","text":"MXLSemitones","kind":"typeIdentifier"},{"kind":"text","text":", "},{"kind":"externalParam","text":"content"},{"kind":"text","text":": "},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBend\/Content-swift.enum","preciseIdentifier":"s:7IvorMXL7MXLBendV7ContentO","text":"Content","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"withBar","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPlacementText","preciseIdentifier":"s:7IvorMXL16MXLPlacementTextV","text":"MXLPlacementText","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"shape","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBend\/Shape-swift.enum","preciseIdentifier":"s:7IvorMXL7MXLBendV5ShapeO","text":"Shape","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"kind":"externalParam","text":"position"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","preciseIdentifier":"s:7IvorMXL11MXLPositionV","text":"MXLPosition","kind":"typeIdentifier"},{"text":" = MXLPosition(), ","kind":"text"},{"text":"font","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","preciseIdentifier":"s:7IvorMXL7MXLFontV","text":"MXLFont","kind":"typeIdentifier"},{"text":" = MXLFont(), ","kind":"text"},{"text":"color","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","preciseIdentifier":"s:7IvorMXL8MXLColorV","text":"MXLColor","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"sound","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBendSound","preciseIdentifier":"s:7IvorMXL12MXLBendSoundV","text":"MXLBendSound","kind":"typeIdentifier"},{"text":" = MXLBendSound())","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The bend-alter element indicates the number of semitones in the bend, similar to the alter element. As with the alter element, numbers like 0.5 can be used to indicate microtones. Negative values indicate pre-bends or releases. The pre-bend and release elements are used to distinguish what is intended. Because the bend-alter element represents the number of steps in the bend, a release after a bend has a negative bend-alter value, not a zero value."}]}],"name":"alter"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"One of the alternatives for Bend."}]}],"name":"content"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The with-bar element indicates that the bend is to be done at the bridge with a whammy or vibrato bar. The content of the element indicates how this should be notated. Content values of “scoop” and “dip” refer to the SMuFL guitarVibratoBarScoop and guitarVibratoBarDip glyphs."}]}],"name":"withBar"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Distinguishes between the angled bend symbols commonly used in standard notation and the curved bend symbols commonly used in both tablature and standard notation."}]}],"name":"shape"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For most elements, any program will compute a default x and y position. The position attributes let this be changed two ways."}]}],"name":"position"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The font attribute group gathers together attributes for determining the font within a credit or direction. They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font vs. a music font."}]}],"name":"font"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The color attribute group indicates the color of an element."}]}],"name":"color"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The bend-sound type is used for bend and slide elements, and is similar to the trill-sound attribute group. Here the beats element refers to the number of discrete elements (like MIDI pitch bends) used to represent a continuous bend or slide. The first-beat indicates the percentage of the duration for starting a bend; the last-beat the percentage for ending it. The default choices are:"}]}],"name":"sound"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBend\/init(alter:content:withBar:shape:position:font:color:sound:)"},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLFont":{"title":"MXLFont","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFont"}],"abstract":[{"text":"The font attribute group gathers together attributes for determining the font within a credit or direction.","type":"text"},{"text":" ","type":"text"},{"text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of","type":"text"},{"text":" ","type":"text"},{"text":"font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric","type":"text"},{"text":" ","type":"text"},{"text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font","type":"text"},{"text":" ","type":"text"},{"text":"vs. a music font.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLFont"}],"url":"\/documentation\/ivormxl\/mxlfont"},"doc://IvorMXL/documentation/IvorMXL/MXLBendSound":{"abstract":[{"type":"text","text":"The bend-sound type is used for bend and slide elements, and is similar to the trill-sound attribute group."},{"type":"text","text":" "},{"type":"text","text":"Here the beats element refers to the number of discrete elements (like MIDI pitch bends) used to represent a"},{"type":"text","text":" "},{"type":"text","text":"continuous bend or slide. The first-beat indicates the percentage of the duration for starting a bend; the"},{"type":"text","text":" "},{"type":"text","text":"last-beat the percentage for ending it. The default choices are:"}],"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlbendsound","title":"MXLBendSound","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBendSound","navigatorTitle":[{"kind":"identifier","text":"MXLBendSound"}],"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLBendSound"}]},"doc://IvorMXL/documentation/IvorMXL/MXLBend/Content-swift.enum":{"title":"MXLBend.Content","kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Content","kind":"identifier"}],"navigatorTitle":[{"text":"Content","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBend\/Content-swift.enum","url":"\/documentation\/ivormxl\/mxlbend\/content-swift.enum","abstract":[{"type":"text","text":"One of the alternatives for Bend."}],"type":"topic","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLPlacementText":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlplacementtext","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPlacementText","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPlacementText","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"The placement-text type represents a text element with print-style and placement attribute groups.","type":"text"}],"type":"topic","navigatorTitle":[{"text":"MXLPlacementText","kind":"identifier"}],"title":"MXLPlacementText"},"doc://IvorMXL/documentation/IvorMXL/MXLPosition":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlposition","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPosition"}],"kind":"symbol","abstract":[{"text":"For most elements, any program will compute a default x and y position. The position attributes let this be","type":"text"},{"text":" ","type":"text"},{"text":"changed two ways.","type":"text"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLPosition"}],"title":"MXLPosition"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLBend/Shape-swift.enum":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Shape"}],"navigatorTitle":[{"kind":"identifier","text":"Shape"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBend\/Shape-swift.enum","kind":"symbol","role":"symbol","title":"MXLBend.Shape","abstract":[{"text":"The bend-shape type distinguishes between the angled bend symbols commonly used in standard notation and the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"curved bend symbols commonly used in both tablature and standard notation."}],"url":"\/documentation\/ivormxl\/mxlbend\/shape-swift.enum"},"doc://IvorMXL/documentation/IvorMXL/MXLBend":{"title":"MXLBend","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLBend"}],"abstract":[{"text":"The bend type is used in guitar notation and tablature. A single note with a bend and release will contain two","type":"text"},{"type":"text","text":" "},{"text":"bend elements: the first to represent the bend and the second to represent the release. The shape attribute","type":"text"},{"type":"text","text":" "},{"type":"text","text":"distinguishes between the angled bend symbols commonly used in standard notation and the curved bend symbols"},{"type":"text","text":" "},{"text":"commonly used in both tablature and standard notation.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBend","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLBend"}],"url":"\/documentation\/ivormxl\/mxlbend"},"doc://IvorMXL/documentation/IvorMXL/MXLSemitones":{"abstract":[{"type":"text","text":"The semitones type is a number representing semitones, used for chromatic alteration. A value of -1"},{"type":"text","text":" "},{"type":"text","text":"corresponds to a flat and a value of 1 to a sharp. Decimal values like 0.5 (quarter tone sharp) are used for"},{"type":"text","text":" "},{"type":"text","text":"microtones."}],"title":"MXLSemitones","url":"\/documentation\/ivormxl\/mxlsemitones","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLSemitones"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSemitones","navigatorTitle":[{"kind":"identifier","text":"MXLSemitones"}]},"doc://IvorMXL/documentation/IvorMXL/MXLBend/init(alter:content:withBar:shape:position:font:color:sound:)":{"url":"\/documentation\/ivormxl\/mxlbend\/init(alter:content:withbar:shape:position:font:color:sound:)","abstract":[{"type":"text","text":"Creates a new "},{"code":"MXLBend","type":"codeVoice"},{"text":".","type":"text"}],"fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"alter","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLSemitones","preciseIdentifier":"s:7IvorMXL12MXLSemitonesa","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"content","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Content","preciseIdentifier":"s:7IvorMXL7MXLBendV7ContentO","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"withBar","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLPlacementText","preciseIdentifier":"s:7IvorMXL16MXLPlacementTextV","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"shape","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Shape","preciseIdentifier":"s:7IvorMXL7MXLBendV5ShapeO","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"position","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLPosition","preciseIdentifier":"s:7IvorMXL11MXLPositionV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"font","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLFont","preciseIdentifier":"s:7IvorMXL7MXLFontV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"color","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLColor","preciseIdentifier":"s:7IvorMXL8MXLColorV","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"sound","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLBendSound","preciseIdentifier":"s:7IvorMXL12MXLBendSoundV","kind":"typeIdentifier"},{"text":")","kind":"text"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBend\/init(alter:content:withBar:shape:position:font:color:sound:)","title":"init(alter:content:withBar:shape:position:font:color:sound:)","type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"title":"MXLColor","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"abstract":[{"text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in","type":"text"},{"text":" ","type":"text"},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"url":"\/documentation\/ivormxl\/mxlcolor"}}}