{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlbend\/init(alter:content:withbar:shape:position:font:color:sound:)"]}],"abstract":[{"text":"Creates a new ","type":"text"},{"type":"codeVoice","code":"MXLBend"},{"text":".","type":"text"}],"metadata":{"externalID":"s:7IvorMXL7MXLBendV5alter7content7withBar5shape8position4font5color5soundACSd_AC7ContentOSgAA16MXLPlacementTextVSgAC5ShapeOSgAA11MXLPositionVAA7MXLFontVAA8MXLColorVSgAA0C5SoundVtcfc","role":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"alter","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLSemitones","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL12MXLSemitonesa"},{"text":", ","kind":"text"},{"text":"content","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Content","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL7MXLBendV7ContentO"},{"text":"?, ","kind":"text"},{"text":"withBar","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLPlacementText","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL16MXLPlacementTextV"},{"text":"?, ","kind":"text"},{"text":"shape","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Shape","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL7MXLBendV5ShapeO"},{"text":"?, ","kind":"text"},{"text":"position","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLPosition","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLPositionV"},{"text":", ","kind":"text"},{"text":"font","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLFont","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL7MXLFontV"},{"text":", ","kind":"text"},{"text":"color","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLColor","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLColorV"},{"text":"?, ","kind":"text"},{"text":"sound","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLBendSound","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL12MXLBendSoundV"},{"text":")","kind":"text"}],"modules":[{"name":"IvorMXL"}],"title":"init(alter:content:withBar:shape:position:font:color:sound:)","symbolKind":"init","roleHeading":"Initializer"},"sections":[],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBend\/init(alter:content:withBar:shape:position:font:color:sound:)","interfaceLanguage":"swift"},"kind":"symbol","primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"init","kind":"keyword"},{"text":"(","kind":"text"},{"text":"alter","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLSemitones","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSemitones","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL12MXLSemitonesa"},{"text":", ","kind":"text"},{"text":"content","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Content","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBend\/Content-swift.enum","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL7MXLBendV7ContentO"},{"text":"? = nil, ","kind":"text"},{"text":"withBar","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLPlacementText","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPlacementText","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL16MXLPlacementTextV"},{"text":"? = nil, ","kind":"text"},{"text":"shape","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Shape","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBend\/Shape-swift.enum","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL7MXLBendV5ShapeO"},{"text":"? = nil, ","kind":"text"},{"text":"position","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLPosition","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLPositionV"},{"text":" = MXLPosition(), ","kind":"text"},{"text":"font","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLFont","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL7MXLFontV"},{"text":" = MXLFont(), ","kind":"text"},{"text":"color","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLColor","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLColorV"},{"text":"? = nil, ","kind":"text"},{"text":"sound","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLBendSound","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBendSound","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL12MXLBendSoundV"},{"text":" = MXLBendSound())","kind":"text"}]}],"kind":"declarations"},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The bend-alter element indicates the number of semitones in the bend, similar to the","type":"text"},{"text":" ","type":"text"},{"text":"alter element. As with the alter element, numbers like 0.5 can be used to indicate","type":"text"},{"text":" ","type":"text"},{"text":"microtones. Negative values indicate pre-bends or releases. The pre-bend and release","type":"text"},{"text":" ","type":"text"},{"text":"elements are used to distinguish what is intended. Because the bend-alter element","type":"text"},{"text":" ","type":"text"},{"text":"represents the number of steps in the bend, a release after a bend has a negative","type":"text"},{"text":" ","type":"text"},{"text":"bend-alter value, not a zero value.","type":"text"}]}],"name":"alter"},{"content":[{"type":"paragraph","inlineContent":[{"text":"One of the alternatives for Bend.","type":"text"}]}],"name":"content"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The with-bar element indicates that the bend is to be done at the bridge with a whammy or","type":"text"},{"text":" ","type":"text"},{"text":"vibrato bar. The content of the element indicates how this should be notated. Content","type":"text"},{"text":" ","type":"text"},{"text":"values of “scoop” and “dip” refer to the SMuFL guitarVibratoBarScoop and","type":"text"},{"text":" ","type":"text"},{"text":"guitarVibratoBarDip glyphs.","type":"text"}]}],"name":"withBar"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Distinguishes between the angled bend symbols commonly used in standard notation and the","type":"text"},{"text":" ","type":"text"},{"text":"curved bend symbols commonly used in both tablature and standard notation.","type":"text"}]}],"name":"shape"},{"content":[{"type":"paragraph","inlineContent":[{"text":"For most elements, any program will compute a default x and y position. The position","type":"text"},{"text":" ","type":"text"},{"text":"attributes let this be changed two ways.","type":"text"}]}],"name":"position"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The font attribute group gathers together attributes for determining the font within a","type":"text"},{"text":" ","type":"text"},{"text":"credit or direction. They are based on the text styles for Cascading Style Sheets. The","type":"text"},{"text":" ","type":"text"},{"text":"font-family is a comma-separated list of font names. The font-style can be normal or","type":"text"},{"text":" ","type":"text"},{"text":"italic. The font-size can be one of the CSS sizes or a numeric point size. The","type":"text"},{"text":" ","type":"text"},{"text":"font-weight can be normal or bold. The default is application-dependent, but is a text","type":"text"},{"text":" ","type":"text"},{"text":"font vs. a music font.","type":"text"}]}],"name":"font"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The color attribute group indicates the color of an element.","type":"text"}]}],"name":"color"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The bend-sound type is used for bend and slide elements, and is similar to the","type":"text"},{"text":" ","type":"text"},{"text":"trill-sound attribute group. Here the beats element refers to the number of discrete","type":"text"},{"text":" ","type":"text"},{"text":"elements (like MIDI pitch bends) used to represent a continuous bend or slide. The","type":"text"},{"text":" ","type":"text"},{"text":"first-beat indicates the percentage of the duration for starting a bend; the last-beat","type":"text"},{"text":" ","type":"text"},{"text":"the percentage for ending it. The default choices are:","type":"text"}]}],"name":"sound"}],"kind":"parameters"}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBend"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLSemitones":{"navigatorTitle":[{"kind":"identifier","text":"MXLSemitones"}],"abstract":[{"text":"The semitones type is a number representing semitones, used for chromatic alteration. A value of -1","type":"text"},{"text":" ","type":"text"},{"text":"corresponds to a flat and a value of 1 to a sharp. Decimal values like 0.5 (quarter tone sharp) are used for","type":"text"},{"text":" ","type":"text"},{"text":"microtones.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSemitones","url":"\/documentation\/ivormxl\/mxlsemitones","role":"symbol","title":"MXLSemitones","type":"topic","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLSemitones"}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLBend/Content-swift.enum":{"type":"topic","abstract":[{"text":"One of the alternatives for Bend.","type":"text"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlbend\/content-swift.enum","title":"MXLBend.Content","navigatorTitle":[{"text":"Content","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBend\/Content-swift.enum","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Content"}]},"doc://IvorMXL/documentation/IvorMXL/MXLBend/Shape-swift.enum":{"navigatorTitle":[{"kind":"identifier","text":"Shape"}],"abstract":[{"type":"text","text":"The bend-shape type distinguishes between the angled bend symbols commonly used in standard notation and the"},{"type":"text","text":" "},{"type":"text","text":"curved bend symbols commonly used in both tablature and standard notation."}],"role":"symbol","kind":"symbol","title":"MXLBend.Shape","url":"\/documentation\/ivormxl\/mxlbend\/shape-swift.enum","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBend\/Shape-swift.enum","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Shape"}]},"doc://IvorMXL/documentation/IvorMXL/MXLFont":{"type":"topic","title":"MXLFont","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","abstract":[{"type":"text","text":"The font attribute group gathers together attributes for determining the font within a credit or direction."},{"type":"text","text":" "},{"type":"text","text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of"},{"type":"text","text":" "},{"type":"text","text":"font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric"},{"type":"text","text":" "},{"type":"text","text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font"},{"type":"text","text":" "},{"type":"text","text":"vs. a music font."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFont"}],"navigatorTitle":[{"kind":"identifier","text":"MXLFont"}],"url":"\/documentation\/ivormxl\/mxlfont"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"type":"topic","abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"type":"text","text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is"},{"type":"text","text":" "},{"type":"text","text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF."}],"url":"\/documentation\/ivormxl\/mxlcolor","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"kind":"symbol","title":"MXLColor","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLBendSound":{"url":"\/documentation\/ivormxl\/mxlbendsound","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBendSound","title":"MXLBendSound","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLBendSound","kind":"identifier"}],"abstract":[{"text":"The bend-sound type is used for bend and slide elements, and is similar to the trill-sound attribute group.","type":"text"},{"text":" ","type":"text"},{"text":"Here the beats element refers to the number of discrete elements (like MIDI pitch bends) used to represent a","type":"text"},{"text":" ","type":"text"},{"text":"continuous bend or slide. The first-beat indicates the percentage of the duration for starting a bend; the","type":"text"},{"text":" ","type":"text"},{"text":"last-beat the percentage for ending it. The default choices are:","type":"text"}],"role":"symbol","navigatorTitle":[{"text":"MXLBendSound","kind":"identifier"}],"type":"topic","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLBend/init(alter:content:withBar:shape:position:font:color:sound:)":{"abstract":[{"type":"text","text":"Creates a new "},{"code":"MXLBend","type":"codeVoice"},{"type":"text","text":"."}],"title":"init(alter:content:withBar:shape:position:font:color:sound:)","kind":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBend\/init(alter:content:withBar:shape:position:font:color:sound:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"alter","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL12MXLSemitonesa","text":"MXLSemitones","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"content","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL7MXLBendV7ContentO","text":"Content","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"withBar","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL16MXLPlacementTextV","text":"MXLPlacementText","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"shape","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL7MXLBendV5ShapeO","text":"Shape","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"position","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL11MXLPositionV","text":"MXLPosition","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"font","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL7MXLFontV","text":"MXLFont","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"color","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL8MXLColorV","text":"MXLColor","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"sound","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL12MXLBendSoundV","text":"MXLBendSound","kind":"typeIdentifier"},{"text":")","kind":"text"}],"role":"symbol","url":"\/documentation\/ivormxl\/mxlbend\/init(alter:content:withbar:shape:position:font:color:sound:)"},"doc://IvorMXL/documentation/IvorMXL/MXLPlacementText":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlplacementtext","title":"MXLPlacementText","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPlacementText","navigatorTitle":[{"kind":"identifier","text":"MXLPlacementText"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPlacementText"}],"abstract":[{"type":"text","text":"The placement-text type represents a text element with print-style and placement attribute groups."}],"type":"topic","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLPosition":{"type":"topic","abstract":[{"type":"text","text":"For most elements, any program will compute a default x and y position. The position attributes let this be"},{"type":"text","text":" "},{"type":"text","text":"changed two ways."}],"url":"\/documentation\/ivormxl\/mxlposition","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPosition"}],"kind":"symbol","title":"MXLPosition","navigatorTitle":[{"kind":"identifier","text":"MXLPosition"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLBend":{"type":"topic","abstract":[{"type":"text","text":"The bend type is used in guitar notation and tablature. A single note with a bend and release will contain two"},{"type":"text","text":" "},{"type":"text","text":"bend elements: the first to represent the bend and the second to represent the release. The shape attribute"},{"type":"text","text":" "},{"type":"text","text":"distinguishes between the angled bend symbols commonly used in standard notation and the curved bend symbols"},{"type":"text","text":" "},{"type":"text","text":"commonly used in both tablature and standard notation."}],"url":"\/documentation\/ivormxl\/mxlbend","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLBend"}],"kind":"symbol","title":"MXLBend","navigatorTitle":[{"kind":"identifier","text":"MXLBend"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBend","role":"symbol"}}}