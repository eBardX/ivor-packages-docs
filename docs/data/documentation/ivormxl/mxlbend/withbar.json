{"abstract":[{"type":"text","text":"The with-bar element indicates that the bend is to be done at the bridge with a whammy or vibrato bar. The"},{"type":"text","text":" "},{"type":"text","text":"content of the element indicates how this should be notated. Content values of “scoop” and “dip” refer to the"},{"type":"text","text":" "},{"type":"text","text":"SMuFL guitarVibratoBarScoop and guitarVibratoBarDip glyphs."}],"variants":[{"paths":["\/documentation\/ivormxl\/mxlbend\/withbar"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"withBar","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL16MXLPlacementTextV","text":"MXLPlacementText","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPlacementText","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Maps to a nested MusicXML "},{"type":"codeVoice","code":"<with-bar>"},{"type":"text","text":" element."}]}],"kind":"content"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBend\/withBar"},"kind":"symbol","metadata":{"externalID":"s:7IvorMXL7MXLBendV7withBarAA16MXLPlacementTextVSgvp","modules":[{"name":"IvorMXL"}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"withBar","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL16MXLPlacementTextV","text":"MXLPlacementText","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"symbolKind":"property","role":"symbol","roleHeading":"Instance Property","title":"withBar"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/