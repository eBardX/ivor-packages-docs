{"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"title":"alter","modules":[{"name":"IvorMXL"}],"roleHeading":"Instance Property","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"alter","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL12MXLSemitonesa","text":"MXLSemitones","kind":"typeIdentifier"}],"externalID":"s:7IvorMXL7MXLBendV5alterSdvp","role":"symbol","symbolKind":"property"},"kind":"symbol","abstract":[{"type":"text","text":"The bend-alter element indicates the number of semitones in the bend, similar to the alter element. As with"},{"type":"text","text":" "},{"type":"text","text":"the alter element, numbers like 0.5 can be used to indicate microtones. Negative values indicate pre-bends or"},{"type":"text","text":" "},{"type":"text","text":"releases. The pre-bend and release elements are used to distinguish what is intended. Because the bend-alter"},{"type":"text","text":" "},{"type":"text","text":"element represents the number of steps in the bend, a release after a bend has a negative bend-alter value,"},{"type":"text","text":" "},{"type":"text","text":"not a zero value."}],"variants":[{"paths":["\/documentation\/ivormxl\/mxlbend\/alter"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"alter","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL12MXLSemitonesa","text":"MXLSemitones","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSemitones","kind":"typeIdentifier"}]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"Maps to a nested MusicXML ","type":"text"},{"type":"codeVoice","code":"<bend-alter>"},{"text":" element.","type":"text"}]}]}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBend"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBend\/alter"},"sections":[],"references":{"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLBend/alter":{"title":"alter","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBend\/alter","kind":"symbol","abstract":[{"text":"The bend-alter element indicates the number of semitones in the bend, similar to the alter element. As with","type":"text"},{"text":" ","type":"text"},{"text":"the alter element, numbers like 0.5 can be used to indicate microtones. Negative values indicate pre-bends or","type":"text"},{"text":" ","type":"text"},{"text":"releases. The pre-bend and release elements are used to distinguish what is intended. Because the bend-alter","type":"text"},{"text":" ","type":"text"},{"text":"element represents the number of steps in the bend, a release after a bend has a negative bend-alter value,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"not a zero value."}],"url":"\/documentation\/ivormxl\/mxlbend\/alter","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"text":" ","kind":"text"},{"kind":"identifier","text":"alter"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL12MXLSemitonesa","text":"MXLSemitones"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLBend":{"role":"symbol","kind":"symbol","url":"\/documentation\/ivormxl\/mxlbend","title":"MXLBend","abstract":[{"type":"text","text":"The bend type is used in guitar notation and tablature. A single note with a bend and release will contain two"},{"type":"text","text":" "},{"type":"text","text":"bend elements: the first to represent the bend and the second to represent the release. The shape attribute"},{"type":"text","text":" "},{"type":"text","text":"distinguishes between the angled bend symbols commonly used in standard notation and the curved bend symbols"},{"type":"text","text":" "},{"type":"text","text":"commonly used in both tablature and standard notation."}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLBend","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBend","navigatorTitle":[{"text":"MXLBend","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLSemitones":{"kind":"symbol","title":"MXLSemitones","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSemitones","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlsemitones","navigatorTitle":[{"text":"MXLSemitones","kind":"identifier"}],"abstract":[{"type":"text","text":"The semitones type is a number representing semitones, used for chromatic alteration. A value of -1"},{"type":"text","text":" "},{"type":"text","text":"corresponds to a flat and a value of 1 to a sharp. Decimal values like 0.5 (quarter tone sharp) are used for"},{"type":"text","text":" "},{"type":"text","text":"microtones."}],"role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSemitones"}}}