{"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"roleHeading":"Instance Property","title":"alter","symbolKind":"property","externalID":"s:7IvorMXL7MXLBendV5alterSdvp","modules":[{"name":"IvorMXL"}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"text":"alter","kind":"identifier"},{"kind":"text","text":": "},{"text":"MXLSemitones","preciseIdentifier":"s:7IvorMXL12MXLSemitonesa","kind":"typeIdentifier"}],"role":"symbol"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBend"]]},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"alter"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL12MXLSemitonesa","kind":"typeIdentifier","text":"MXLSemitones","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSemitones"}]}]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Maps to a nested MusicXML "},{"type":"codeVoice","code":"<bend-alter>"},{"type":"text","text":" element."}]}]}],"abstract":[{"type":"text","text":"The bend-alter element indicates the number of semitones in the bend, similar to the alter element. As with"},{"type":"text","text":" "},{"type":"text","text":"the alter element, numbers like 0.5 can be used to indicate microtones. Negative values indicate pre-bends or"},{"type":"text","text":" "},{"type":"text","text":"releases. The pre-bend and release elements are used to distinguish what is intended. Because the bend-alter"},{"type":"text","text":" "},{"type":"text","text":"element represents the number of steps in the bend, a release after a bend has a negative bend-alter value,"},{"type":"text","text":" "},{"type":"text","text":"not a zero value."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBend\/alter"},"sections":[],"variants":[{"paths":["\/documentation\/ivormxl\/mxlbend\/alter"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLBend":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBend","title":"MXLBend","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLBend","kind":"identifier"}],"navigatorTitle":[{"text":"MXLBend","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlbend","abstract":[{"text":"The bend type is used in guitar notation and tablature. A single note with a bend and release will contain two","type":"text"},{"text":" ","type":"text"},{"text":"bend elements: the first to represent the bend and the second to represent the release. The shape attribute","type":"text"},{"text":" ","type":"text"},{"text":"distinguishes between the angled bend symbols commonly used in standard notation and the curved bend symbols","type":"text"},{"text":" ","type":"text"},{"text":"commonly used in both tablature and standard notation.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLBend/alter":{"title":"alter","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"alter","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLSemitones","preciseIdentifier":"s:7IvorMXL12MXLSemitonesa","kind":"typeIdentifier"}],"kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxlbend\/alter","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBend\/alter","abstract":[{"type":"text","text":"The bend-alter element indicates the number of semitones in the bend, similar to the alter element. As with"},{"type":"text","text":" "},{"type":"text","text":"the alter element, numbers like 0.5 can be used to indicate microtones. Negative values indicate pre-bends or"},{"type":"text","text":" "},{"type":"text","text":"releases. The pre-bend and release elements are used to distinguish what is intended. Because the bend-alter"},{"type":"text","text":" "},{"type":"text","text":"element represents the number of steps in the bend, a release after a bend has a negative bend-alter value,"},{"type":"text","text":" "},{"type":"text","text":"not a zero value."}]},"doc://IvorMXL/documentation/IvorMXL/MXLSemitones":{"abstract":[{"type":"text","text":"The semitones type is a number representing semitones, used for chromatic alteration. A value of -1"},{"type":"text","text":" "},{"type":"text","text":"corresponds to a flat and a value of 1 to a sharp. Decimal values like 0.5 (quarter tone sharp) are used for"},{"type":"text","text":" "},{"type":"text","text":"microtones."}],"title":"MXLSemitones","kind":"symbol","role":"symbol","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSemitones","kind":"identifier"}],"navigatorTitle":[{"text":"MXLSemitones","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlsemitones","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSemitones"},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"}}}