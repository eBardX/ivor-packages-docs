{"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBend"]]},"metadata":{"modules":[{"name":"IvorMXL"}],"externalID":"s:7IvorMXL7MXLBendV5alterSdvp","role":"symbol","title":"alter","roleHeading":"Instance Property","symbolKind":"property","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"alter"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL12MXLSemitonesa","kind":"typeIdentifier","text":"MXLSemitones"}]},"kind":"symbol","abstract":[{"type":"text","text":"The bend-alter element indicates the number of semitones in the bend, similar to the alter element. As with"},{"type":"text","text":" "},{"type":"text","text":"the alter element, numbers like 0.5 can be used to indicate microtones. Negative values indicate pre-bends or"},{"type":"text","text":" "},{"type":"text","text":"releases. The pre-bend and release elements are used to distinguish what is intended. Because the bend-alter"},{"type":"text","text":" "},{"type":"text","text":"element represents the number of steps in the bend, a release after a bend has a negative bend-alter value,"},{"type":"text","text":" "},{"type":"text","text":"not a zero value."}],"variants":[{"paths":["\/documentation\/ivormxl\/mxlbend\/alter"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBend\/alter"},"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"alter"},{"kind":"text","text":": "},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSemitones","preciseIdentifier":"s:7IvorMXL12MXLSemitonesa","kind":"typeIdentifier","text":"MXLSemitones"}],"platforms":["macOS"],"languages":["swift"]}]},{"content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Maps to a nested MusicXML "},{"type":"codeVoice","code":"<bend-alter>"},{"type":"text","text":" element."}]}],"kind":"content"}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLBend/alter":{"abstract":[{"type":"text","text":"The bend-alter element indicates the number of semitones in the bend, similar to the alter element. As with"},{"type":"text","text":" "},{"type":"text","text":"the alter element, numbers like 0.5 can be used to indicate microtones. Negative values indicate pre-bends or"},{"type":"text","text":" "},{"type":"text","text":"releases. The pre-bend and release elements are used to distinguish what is intended. Because the bend-alter"},{"type":"text","text":" "},{"type":"text","text":"element represents the number of steps in the bend, a release after a bend has a negative bend-alter value,"},{"type":"text","text":" "},{"type":"text","text":"not a zero value."}],"title":"alter","kind":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBend\/alter","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"alter","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL12MXLSemitonesa","text":"MXLSemitones","kind":"typeIdentifier"}],"role":"symbol","url":"\/documentation\/ivormxl\/mxlbend\/alter"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLBend":{"type":"topic","abstract":[{"type":"text","text":"The bend type is used in guitar notation and tablature. A single note with a bend and release will contain two"},{"type":"text","text":" "},{"type":"text","text":"bend elements: the first to represent the bend and the second to represent the release. The shape attribute"},{"type":"text","text":" "},{"type":"text","text":"distinguishes between the angled bend symbols commonly used in standard notation and the curved bend symbols"},{"type":"text","text":" "},{"type":"text","text":"commonly used in both tablature and standard notation."}],"url":"\/documentation\/ivormxl\/mxlbend","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLBend"}],"kind":"symbol","title":"MXLBend","navigatorTitle":[{"kind":"identifier","text":"MXLBend"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBend","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLSemitones":{"navigatorTitle":[{"kind":"identifier","text":"MXLSemitones"}],"abstract":[{"text":"The semitones type is a number representing semitones, used for chromatic alteration. A value of -1","type":"text"},{"text":" ","type":"text"},{"text":"corresponds to a flat and a value of 1 to a sharp. Decimal values like 0.5 (quarter tone sharp) are used for","type":"text"},{"text":" ","type":"text"},{"text":"microtones.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSemitones","url":"\/documentation\/ivormxl\/mxlsemitones","role":"symbol","title":"MXLSemitones","type":"topic","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLSemitones"}]}}}