/documentation/IvorMXL/MXLColor":{"abstract":[{"text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in","type":"text"},{"type":"text","text":" "},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"title":"MXLColor","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlcolor","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor"},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLBend":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBend","title":"MXLBend","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLBend","kind":"identifier"}],"navigatorTitle":[{"text":"MXLBend","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlbend","abstract":[{"text":"The bend type is used in guitar notation and tablature. A single note with a bend and release will contain two","type":"text"},{"text":" ","type":"text"},{"text":"bend elements: the first to represent the bend and the second to represent the release. The shape attribute","type":"text"},{"text":" ","type":"text"},{"text":"distinguishes between the angled bend symbols commonly used in standard notation and the curved bend symbols","type":"text"},{"text":" ","type":"text"},{"text":"commonly used in both tablature and standard notation.","type":"text"}]}}}