"MXLTimeSymbol"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxltimesymbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTimeSymbol","abstract":[{"type":"text","text":"The time-symbol type indicates how to display a time signature. The normal value is the usual fractional"},{"text":" ","type":"text"},{"type":"text","text":"display, and is the implied symbol type if none is specified. Other options are the common and cut time"},{"text":" ","type":"text"},{"text":"symbols, as well as a single number with an implied denominator. The note symbol indicates that the beat-type","type":"text"},{"text":" ","type":"text"},{"text":"should be represented with the corresponding downstem note rather than a number. The dotted-note symbol","type":"text"},{"text":" ","type":"text"},{"text":"indicates that the beat-type should be represented with a dotted downstem note that corresponds to three times","type":"text"},{"text":" ","type":"text"},{"text":"the beat-type value, and a numerator that is one third the beats value.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"MXLTimeSymbol"}]},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"}}}