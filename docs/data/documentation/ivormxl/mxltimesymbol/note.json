},{"text":"MXLTimeSymbol","kind":"identifier"}],"navigatorTitle":[{"text":"MXLTimeSymbol","kind":"identifier"}],"abstract":[{"type":"text","text":"The time-symbol type indicates how to display a time signature. The normal value is the usual fractional"},{"type":"text","text":" "},{"type":"text","text":"display, and is the implied symbol type if none is specified. Other options are the common and cut time"},{"type":"text","text":" "},{"type":"text","text":"symbols, as well as a single number with an implied denominator. The note symbol indicates that the beat-type"},{"text":" ","type":"text"},{"type":"text","text":"should be represented with the corresponding downstem note rather than a number. The dotted-note symbol"},{"text":" ","type":"text"},{"type":"text","text":"indicates that the beat-type should be represented with a dotted downstem note that corresponds to three times"},{"type":"text","text":" "},{"text":"the beat-type value, and a numerator that is one third the beats value.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTimeSymbol","title":"MXLTimeSymbol","role":"symbol","url":"\/documentation\/ivormxl\/mxltimesymbol"}}}