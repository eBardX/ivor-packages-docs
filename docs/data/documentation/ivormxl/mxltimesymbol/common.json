{"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"text":"The common time symbol.","type":"text"}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"common"}]}],"kind":"declarations"}],"metadata":{"roleHeading":"Case","title":"MXLTimeSymbol.common","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"common"}],"modules":[{"name":"IvorMXL"}],"role":"symbol","symbolKind":"case","externalID":"s:7IvorMXL13MXLTimeSymbolO6commonyA2CmF"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTimeSymbol"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxltimesymbol\/common"]}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTimeSymbol\/common","interfaceLanguage":"swift"},"sections":[],"kind":"symbol","references":{"doc://IvorMXL/documentation/IvorMXL/MXLTimeSymbol/common":{"abstract":[{"type":"text","text":"The common time symbol."}],"title":"MXLTimeSymbol.common","url":"\/documentation\/ivormxl\/mxltimesymbol\/common","type":"topic","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTimeSymbol\/common","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"common","kind":"identifier"}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLTimeSymbol":{"type":"topic","title":"MXLTimeSymbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTimeSymbol","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxltimesymbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTimeSymbol","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"MXLTimeSymbol","kind":"identifier"}],"abstract":[{"type":"text","text":"The time-symbol type indicates how to display a time signature. The normal value is the usual fractional"},{"type":"text","text":" "},{"type":"text","text":"display, and is the implied symbol type if none is specified. Other options are the common and cut time"},{"type":"text","text":" "},{"type":"text","text":"symbols, as well as a single number with an implied denominator. The note symbol indicates that the beat-type"},{"type":"text","text":" "},{"type":"text","text":"should be represented with the corresponding downstem note rather than a number. The dotted-note symbol"},{"type":"text","text":" "},{"type":"text","text":"indicates that the beat-type should be represented with a dotted downstem note that corresponds to three times"},{"type":"text","text":" "},{"type":"text","text":"the beat-type value, and a numerator that is one third the beats value."}]}}}