on and cut time","type":"text"},{"text":" ","type":"text"},{"text":"symbols, as well as a single number with an implied denominator. The note symbol indicates that the beat-type","type":"text"},{"text":" ","type":"text"},{"text":"should be represented with the corresponding downstem note rather than a number. The dotted-note symbol","type":"text"},{"text":" ","type":"text"},{"text":"indicates that the beat-type should be represented with a dotted downstem note that corresponds to three times","type":"text"},{"text":" ","type":"text"},{"text":"the beat-type value, and a numerator that is one third the beats value.","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLTimeSymbol/common":{"type":"topic","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"common","kind":"identifier"}],"title":"MXLTimeSymbol.common","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTimeSymbol\/common","abstract":[{"text":"The common time symbol.","type":"text"}],"url":"\/documentation\/ivormxl\/mxltimesymbol\/common","kind":"symbol","role":"symbol"}}}