":"text","text":"component element within a direction."}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSound","kind":"identifier"}],"navigatorTitle":[{"text":"MXLSound","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlsound"},"doc://IvorMXL/documentation/IvorMXL/MXLPlay":{"title":"MXLPlay","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPlay"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlplay","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLPlay"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPlay","abstract":[{"type":"text","text":"The play type specifies playback techniques to be used in conjunction with the instrument-sound element. When"},{"type":"text","text":" "},{"type":"text","text":"used as part of a sound element, it applies to all notes going forward in score order. In multi-instrument"},{"type":"text","text":" "},{"type":"text","text":"parts, the affected instrument should be specified using the id attribute. When used as part of a note"},{"type":"text","text":" "},{"type":"text","text":"element, it applies to the current note only."}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLMidiDevice":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMidiDevice","navigatorTitle":[{"kind":"identifier","text":"MXLMidiDevice"}],"url":"\/documentation\/ivormxl\/mxlmididevice","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLMidiDevice"}],"title":"MXLMidiDevice","abstract":[{"type":"text","text":"The midi-device type corresponds to the DeviceName meta event in Standard MIDI Files. The optional port"},{"type":"text","text":" "},{"type":"text","text":"attribute is a number from 1 to 16 that can be used with the unofficial MIDI 1.0 port (or cable) meta event."},{"type":"text","text":" "},{"type":"text","text":"Unlike the DeviceName meta event, there can be multiple midi-device elements per MusicXML part. The optional"},{"type":"text","text":" "},{"type":"text","text":"id attribute refers to the score-instrument assigned to this device. If missing, the device assignment affects"},{"type":"text","text":" "},{"type":"text","text":"all score-instrument elements in the score-part."}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLSound/Group-swift.struct":{"title":"MXLSound.Group","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Group","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"Group","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlsound\/group-swift.struct","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/Group-swift.struct","abstract":[{"text":"A grouping of instrument changes, MIDI device and instrument assignments, and playback techniques","type":"text"},{"text":" ","type":"text"},{"text":"associated with a single instrument within a sound element.","type":"text"}],"type":"topic","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLInstrumentChange":{"type":"topic","title":"MXLInstrumentChange","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLInstrumentChange","abstract":[{"type":"text","text":"The instrument-change element type represents a change to the virtual instrument sound for a given score-"},{"type":"text","text":" "},{"type":"text","text":"instrument. The id attribute refers to the score-instrument affected by the change. All instrument-change"},{"type":"text","text":" "},{"type":"text","text":"child elements can also be initially specified within the score-instrument element."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLInstrumentChange"}],"navigatorTitle":[{"kind":"identifier","text":"MXLInstrumentChange"}],"url":"\/documentation\/ivormxl\/mxlinstrumentchange"},"doc://IvorMXL/documentation/IvorMXL/MXLMidiInstrument":{"type":"topic","abstract":[{"type":"text","text":"The midi-instrument type defines MIDI 1.0 instrument playback. The midi-instrument element can be a part of"},{"type":"text","text":" "},{"type":"text","text":"either the score-instrument element at the start of a part, or the sound element within a part. The id"},{"type":"text","text":" "},{"type":"text","text":"attribute refers to the score-instrument affected by the change."}],"url":"\/documentation\/ivormxl\/mxlmidiinstrument","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLMidiInstrument"}],"kind":"symbol","title":"MXLMidiInstrument","navigatorTitle":[{"kind":"identifier","text":"MXLMidiInstrument"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMidiInstrument","role":"symbol"}}}