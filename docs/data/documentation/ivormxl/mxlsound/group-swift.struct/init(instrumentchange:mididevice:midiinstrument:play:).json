tifier","text":"MXLMidiDevice"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLMidiDevice"}],"url":"\/documentation\/ivormxl\/mxlmididevice","role":"symbol","title":"MXLMidiDevice","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMidiDevice","type":"topic","abstract":[{"type":"text","text":"The midi-device type corresponds to the DeviceName meta event in Standard MIDI Files. The optional port"},{"type":"text","text":" "},{"text":"attribute is a number from 1 to 16 that can be used with the unofficial MIDI 1.0 port (or cable) meta event.","type":"text"},{"text":" ","type":"text"},{"text":"Unlike the DeviceName meta event, there can be multiple midi-device elements per MusicXML part. The optional","type":"text"},{"text":" ","type":"text"},{"text":"id attribute refers to the score-instrument assigned to this device. If missing, the device assignment affects","type":"text"},{"type":"text","text":" "},{"type":"text","text":"all score-instrument elements in the score-part."}]},"doc://IvorMXL/documentation/IvorMXL/MXLSound":{"url":"\/documentation\/ivormxl\/mxlsound","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLSound"}],"title":"MXLSound","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound","navigatorTitle":[{"kind":"identifier","text":"MXLSound"}],"role":"symbol","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The sound element contains general playback parameters. They can stand alone within a part\/measure, or be a"},{"type":"text","text":" "},{"type":"text","text":"component element within a direction."}]},"doc://IvorMXL/documentation/IvorMXL/MXLSound/Group-swift.struct/init(instrumentChange:midiDevice:midiInstrument:play:)":{"kind":"symbol","url":"\/documentation\/ivormxl\/mxlsound\/group-swift.struct\/init(instrumentchange:mididevice:midiinstrument:play:)","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/Group-swift.struct\/init(instrumentChange:midiDevice:midiInstrument:play:)","role":"symbol","type":"topic","title":"init(instrumentChange:midiDevice:midiInstrument:play:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"instrumentChange"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL19MXLInstrumentChangeV","kind":"typeIdentifier","text":"MXLInstrumentChange"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"midiDevice"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL13MXLMidiDeviceV","kind":"typeIdentifier","text":"MXLMidiDevice"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"midiInstrument"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL17MXLMidiInstrumentV","kind":"typeIdentifier","text":"MXLMidiInstrument"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"play"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL7MXLPlayV","kind":"typeIdentifier","text":"MXLPlay"},{"kind":"text","text":"?)"}],"abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLSound.Group"},{"type":"text","text":"."}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLSound/Group-swift.struct":{"title":"MXLSound.Group","navigatorTitle":[{"text":"Group","kind":"identifier"}],"kind":"symbol","abstract":[{"type":"text","text":"A grouping of instrument changes, MIDI device and instrument assignments, and playback techniques"},{"type":"text","text":" "},{"type":"text","text":"associated with a single instrument within a sound element."}],"role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/Group-swift.struct","type":"topic","url":"\/documentation\/ivormxl\/mxlsound\/group-swift.struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Group","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLInstrumentChange":{"navigatorTitle":[{"kind":"identifier","text":"MXLInstrumentChange"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlinstrumentchange","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLInstrumentChange"}],"abstract":[{"type":"text","text":"The instrument-change element type represents a change to the virtual instrument sound for a given score-"},{"type":"text","text":" "},{"type":"text","text":"instrument. The id attribute refers to the score-instrument affected by the change. All instrument-change"},{"type":"text","text":" "},{"type":"text","text":"child elements can also be initially specified within the score-instrument element."}],"role":"symbol","title":"MXLInstrumentChange","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLInstrumentChange"},"doc://IvorMXL/documentation/IvorMXL/MXLMidiInstrument":{"type":"topic","kind":"symbol","abstract":[{"text":"The midi-instrument type defines MIDI 1.0 instrument playback. The midi-instrument element can be a part of","type":"text"},{"text":" ","type":"text"},{"text":"either the score-instrument element at the start of a part, or the sound element within a part. The id","type":"text"},{"text":" ","type":"text"},{"text":"attribute refers to the score-instrument affected by the change.","type":"text"}],"role":"symbol","navigatorTitle":[{"text":"MXLMidiInstrument","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMidiInstrument","title":"MXLMidiInstrument","url":"\/documentation\/ivormxl\/mxlmidiinstrument","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLMidiInstrument","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLPlay":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPlay","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPlay","title":"MXLPlay","kind":"symbol","navigatorTitle":[{"text":"MXLPlay","kind":"identifier"}],"abstract":[{"text":"The play type specifies playback techniques to be used in conjunction with the instrument-sound element. When","type":"text"},{"type":"text","text":" "},{"text":"used as part of a sound element, it applies to all notes going forward in score order. In multi-instrument","type":"text"},{"type":"text","text":" "},{"type":"text","text":"parts, the affected instrument should be specified using the id attribute. When used as part of a note"},{"type":"text","text":" "},{"type":"text","text":"element, it applies to the current note only."}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlplay"}}}