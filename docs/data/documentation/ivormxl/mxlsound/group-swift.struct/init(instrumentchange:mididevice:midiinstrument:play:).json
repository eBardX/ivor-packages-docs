c:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMidiInstrument","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLMidiInstrument"}],"abstract":[{"type":"text","text":"The midi-instrument type defines MIDI 1.0 instrument playback. The midi-instrument element can be a part of"},{"type":"text","text":" "},{"type":"text","text":"either the score-instrument element at the start of a part, or the sound element within a part. The id"},{"type":"text","text":" "},{"type":"text","text":"attribute refers to the score-instrument affected by the change."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLMidiInstrument"}],"title":"MXLMidiInstrument"},"doc://IvorMXL/documentation/IvorMXL/MXLSound/Group-swift.struct/init(instrumentChange:midiDevice:midiInstrument:play:)":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlsound\/group-swift.struct\/init(instrumentchange:mididevice:midiinstrument:play:)","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/Group-swift.struct\/init(instrumentChange:midiDevice:midiInstrument:play:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"instrumentChange"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL19MXLInstrumentChangeV","text":"MXLInstrumentChange"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"midiDevice"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL13MXLMidiDeviceV","text":"MXLMidiDevice"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"midiInstrument"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL17MXLMidiInstrumentV","text":"MXLMidiInstrument"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"play"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL7MXLPlayV","text":"MXLPlay"},{"kind":"text","text":"?)"}],"abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLSound.Group"},{"type":"text","text":"."}],"kind":"symbol","type":"topic","title":"init(instrumentChange:midiDevice:midiInstrument:play:)"},"doc://IvorMXL/documentation/IvorMXL/MXLSound/Group-swift.struct":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlsound\/group-swift.struct","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/Group-swift.struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Group"}],"abstract":[{"type":"text","text":"A grouping of instrument changes, MIDI device and instrument assignments, and playback techniques"},{"type":"text","text":" "},{"type":"text","text":"associated with a single instrument within a sound element."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Group"}],"title":"MXLSound.Group"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLPlay":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlplay","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPlay","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPlay"}],"kind":"symbol","abstract":[{"type":"text","text":"The play type specifies playback techniques to be used in conjunction with the instrument-sound element. When"},{"type":"text","text":" "},{"type":"text","text":"used as part of a sound element, it applies to all notes going forward in score order. In multi-instrument"},{"type":"text","text":" "},{"type":"text","text":"parts, the affected instrument should be specified using the id attribute. When used as part of a note"},{"type":"text","text":" "},{"type":"text","text":"element, it applies to the current note only."}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLPlay"}],"title":"MXLPlay"},"doc://IvorMXL/documentation/IvorMXL/MXLMidiDevice":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlmididevice","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMidiDevice","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLMidiDevice"}],"abstract":[{"type":"text","text":"The midi-device type corresponds to the DeviceName meta event in Standard MIDI Files. The optional port"},{"type":"text","text":" "},{"type":"text","text":"attribute is a number from 1 to 16 that can be used with the unofficial MIDI 1.0 port (or cable) meta event."},{"type":"text","text":" "},{"type":"text","text":"Unlike the DeviceName meta event, there can be multiple midi-device elements per MusicXML part. The optional"},{"type":"text","text":" "},{"type":"text","text":"id attribute refers to the score-instrument assigned to this device. If missing, the device assignment affects"},{"type":"text","text":" "},{"type":"text","text":"all score-instrument elements in the score-part."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLMidiDevice"}],"title":"MXLMidiDevice"},"doc://IvorMXL/documentation/IvorMXL/MXLSound":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlsound","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLSound"}],"abstract":[{"type":"text","text":"The sound element contains general playback parameters. They can stand alone within a part\/measure, or be a"},{"type":"text","text":" "},{"type":"text","text":"component element within a direction."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLSound"}],"title":"MXLSound"},"doc://IvorMXL/documentation/IvorMXL/MXLInstrumentChange":{"title":"MXLInstrumentChange","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLInstrumentChange","kind":"identifier"}],"abstract":[{"type":"text","text":"The instrument-change element type represents a change to the virtual instrument sound for a given score-"},{"type":"text","text":" "},{"type":"text","text":"instrument. The id attribute refers to the score-instrument affected by the change. All instrument-change"},{"type":"text","text":" "},{"type":"text","text":"child elements can also be initially specified within the score-instrument element."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLInstrumentChange","role":"symbol","navigatorTitle":[{"text":"MXLInstrumentChange","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlinstrumentchange"}}}