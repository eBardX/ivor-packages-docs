reciseIdentifier":"s:7IvorMXL7MXLPlayV"},{"kind":"text","text":"?)"}]},"doc://IvorMXL/documentation/IvorMXL/MXLInstrumentChange":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLInstrumentChange","type":"topic","abstract":[{"type":"text","text":"The instrument-change element type represents a change to the virtual instrument sound for a given score-"},{"type":"text","text":" "},{"type":"text","text":"instrument. The id attribute refers to the score-instrument affected by the change. All instrument-change"},{"type":"text","text":" "},{"type":"text","text":"child elements can also be initially specified within the score-instrument element."}],"url":"\/documentation\/ivormxl\/mxlinstrumentchange","role":"symbol","title":"MXLInstrumentChange","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLInstrumentChange","kind":"identifier"}],"navigatorTitle":[{"text":"MXLInstrumentChange","kind":"identifier"}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLMidiInstrument":{"title":"MXLMidiInstrument","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMidiInstrument","navigatorTitle":[{"text":"MXLMidiInstrument","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLMidiInstrument","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"The midi-instrument type defines MIDI 1.0 instrument playback. The midi-instrument element can be a part of","type":"text"},{"text":" ","type":"text"},{"text":"either the score-instrument element at the start of a part, or the sound element within a part. The id","type":"text"},{"text":" ","type":"text"},{"text":"attribute refers to the score-instrument affected by the change.","type":"text"}],"role":"symbol","url":"\/documentation\/ivormxl\/mxlmidiinstrument"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLSound":{"abstract":[{"type":"text","text":"The sound element contains general playback parameters. They can stand alone within a part\/measure, or be a"},{"type":"text","text":" "},{"type":"text","text":"component element within a direction."}],"title":"MXLSound","url":"\/documentation\/ivormxl\/mxlsound","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSound","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"MXLSound","kind":"identifier"}],"type":"topic","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound"},"doc://IvorMXL/documentation/IvorMXL/MXLPlay":{"abstract":[{"type":"text","text":"The play type specifies playback techniques to be used in conjunction with the instrument-sound element. When"},{"type":"text","text":" "},{"type":"text","text":"used as part of a sound element, it applies to all notes going forward in score order. In multi-instrument"},{"type":"text","text":" "},{"type":"text","text":"parts, the affected instrument should be specified using the id attribute. When used as part of a note"},{"type":"text","text":" "},{"type":"text","text":"element, it applies to the current note only."}],"url":"\/documentation\/ivormxl\/mxlplay","navigatorTitle":[{"kind":"identifier","text":"MXLPlay"}],"role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPlay","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPlay"}],"title":"MXLPlay","type":"topic","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLMidiDevice":{"type":"topic","title":"MXLMidiDevice","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLMidiDevice","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlmididevice","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMidiDevice","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"MXLMidiDevice","kind":"identifier"}],"abstract":[{"type":"text","text":"The midi-device type corresponds to the DeviceName meta event in Standard MIDI Files. The optional port"},{"type":"text","text":" "},{"type":"text","text":"attribute is a number from 1 to 16 that can be used with the unofficial MIDI 1.0 port (or cable) meta event."},{"type":"text","text":" "},{"type":"text","text":"Unlike the DeviceName meta event, there can be multiple midi-device elements per MusicXML part. The optional"},{"type":"text","text":" "},{"type":"text","text":"id attribute refers to the score-instrument assigned to this device. If missing, the device assignment affects"},{"type":"text","text":" "},{"type":"text","text":"all score-instrument elements in the score-part."}]}}}