xt","text":" "},{"type":"text","text":"current musical location. The current musical location is always within the current measure, even at the end"},{"type":"text","text":" "},{"type":"text","text":"of a measure."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOffset","title":"MXLOffset","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNonNegativeDecimal":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNonNegativeDecimal","url":"\/documentation\/ivormxl\/mxlnonnegativedecimal","role":"symbol","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNonNegativeDecimal"}],"abstract":[{"type":"text","text":"The non-negative-decimal type specifies a non-negative decimal value."}],"navigatorTitle":[{"kind":"identifier","text":"MXLNonNegativeDecimal"}],"title":"MXLNonNegativeDecimal","type":"topic","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLSwing":{"url":"\/documentation\/ivormxl\/mxlswing","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSwing","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLSwing"}],"title":"MXLSwing","abstract":[{"type":"text","text":"The swing element specifies whether or not to use swing playback, where consecutive on-beat \/ off-beat eighth"},{"type":"text","text":" "},{"type":"text","text":"or 16th notes are played with unequal nominal durations."}],"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLSwing"}]},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLDivisions":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDivisions","role":"symbol","navigat