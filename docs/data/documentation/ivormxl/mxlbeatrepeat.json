{"abstract":[{"type":"text","text":"The beat-repeat type is used to indicate that a single beat (but possibly many notes) is repeated. The slashes"},{"type":"text","text":" "},{"type":"text","text":"attribute specifies the number of slashes to use in the symbol. The use-dots attribute indicates whether or"},{"type":"text","text":" "},{"type":"text","text":"not to use dots as well (for instance, with mixed rhythm patterns). The value for slashes is 1 and the value"},{"type":"text","text":" "},{"type":"text","text":"for use-dots is no if not specified."}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL"]]},"sections":[],"variants":[{"paths":["\/documentation\/ivormxl\/mxlbeatrepeat"],"traits":[{"interfaceLanguage":"swift"}]}],"relationshipsSections":[{"title":"Conforms To","type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/IvorMXL\/s8CopyableP","doc:\/\/IvorMXL\/SQ","doc:\/\/IvorMXL\/s9EscapableP","doc:\/\/IvorMXL\/SH","doc:\/\/IvorMXL\/s8SendableP","doc:\/\/IvorMXL\/s16SendableMetatypeP"]}],"topicSections":[{"title":"Initializers","anchor":"Initializers","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBeatRepeat\/init(slashContent:kind:slashes:usesDots:)"],"generated":true},{"title":"Instance Properties","anchor":"Instance-Properties","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBeatRepeat\/kind","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBeatRepeat\/slashContent","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBeatRepeat\/slashes","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBeatRepeat\/usesDots"],"generated":true},{"title":"Default Implementations","anchor":"Default-Implementations","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBeatRepeat\/Equatable-Implementations"],"generated":true}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLBeatRepeat"}],"platforms":["macOS"]}]},{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"inlineContent":[{"text":"The stop type indicates the first beat where the repeats are no longer displayed. Both the start and stop of","type":"text"},{"text":" ","type":"text"},{"text":"the beat being repeated should be specified unless the repeats are displayed through the end of the part.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The beat-repeat element specifies a notation style for repetitions. The actual music being repeated needs to","type":"text"},{"text":" ","type":"text"},{"text":"be repeated within the MusicXML file. This element specifies the notation that indicates the repeat.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Maps the MusicXML ","type":"text"},{"type":"codeVoice","code":"<beat-repeat>"},{"text":" element.","type":"text"}],"type":"paragraph"}]}],"metadata":{"title":"MXLBeatRepeat","externalID":"s:7IvorMXL13MXLBeatRepeatV","symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"MXLBeatRepeat"}],"roleHeading":"Structure","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLBeatRepeat"}],"modules":[{"name":"IvorMXL"}],"role":"symbol"},"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBeatRepeat","interfaceLanguage":"swift"},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLBeatRepeat/kind":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlbeatrepeat\/kind","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBeatRepeat\/kind","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"kind"},{"text":": ","kind":"text"},{"text":"MXLStartStop","preciseIdentifier":"s:7IvorMXL12MXLStartStopO","kind":"typeIdentifier"}],"abstract":[{"text":"Whether this indicates the start or stop of the beat being rep