{"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLBeatRepeat"}]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"The stop type indicates the first beat where the repeats are no longer displayed. Both the start and stop of","type":"text"},{"text":" ","type":"text"},{"text":"the beat being repeated should be specified unless the repeats are displayed through the end of the part.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The beat-repeat element specifies a notation style for repetitions. The actual music being repeated needs to","type":"text"},{"text":" ","type":"text"},{"text":"be repeated within the MusicXML file. This element specifies the notation that indicates the repeat.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Maps the MusicXML ","type":"text"},{"code":"<beat-repeat>","type":"codeVoice"},{"text":" element.","type":"text"}]}],"kind":"content"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBeatRepeat"},"sections":[],"abstract":[{"type":"text","text":"The beat-repeat type is used to indicate that a single beat (but possibly many notes) is repeated. The slashes"},{"type":"text","text":" "},{"type":"text","text":"attribute specifies the number of slashes to use in the symbol. The use-dots attribute indicates whether or"},{"type":"text","text":" "},{"type":"text","text":"not to use dots as well (for instance, with mixed rhythm patterns). The value for slashes is 1 and the value"},{"type":"text","text":" "},{"type":"text","text":"for use-dots is no if not specified."}],"topicSections":[{"generated":true,"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/I