{"kind":"symbol","hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL"]]},"topicSections":[{"title":"Initializers","anchor":"Initializers","generated":true,"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition\/init(defaultX:defaultY:relativeX:relativeY:)"]},{"title":"Instance Properties","anchor":"Instance-Properties","generated":true,"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition\/defaultX","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition\/defaultY","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition\/relativeX","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition\/relativeY"]},{"title":"Default Implementations","anchor":"Default-Implementations","generated":true,"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition\/Equatable-Implementations"]}],"sections":[],"relationshipsSections":[{"identifiers":["doc:\/\/IvorMXL\/s8CopyableP","doc:\/\/IvorMXL\/SQ","doc:\/\/IvorMXL\/s9EscapableP","doc:\/\/IvorMXL\/SH","doc:\/\/IvorMXL\/s8SendableP","doc:\/\/IvorMXL\/s16SendableMetatypeP"],"title":"Conforms To","type":"conformsTo","kind":"relationships"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlposition"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition"},"abstract":[{"text":"For most elements, any program will compute a default x and y position. The position attributes let this be","type":"text"},{"text":" ","type":"text"},{"text":"changed two ways.","type":"text"}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPosition","kind":"identifier"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Overview","type":"heading","anchor":"overview","level":2},{"inlineContent":[{"text":"The default-x and default-y attributes change the computation of the default position. For most elements, the","type":"text"},{"text":" ","type":"text"},{"text":"origin is changed relative to the left-hand side of the note or the musical position within the bar (x) and","type":"text"},{"text":" ","type":"text"},{"text":"the top line of the staff (y).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For the following elements, the default-x value changes the origin relative to the start of the current","type":"text"},{"text":" ","type":"text"},{"text":"measure:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"note - figured-bass - harmony - link - directive - measure-numbering - all descendants of the part-list"},{"type":"text","text":" "},{"type":"text","text":"element - all children of the direction-type element"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"This origin is from the start of the entire measure, at either the left barline or the start of the system.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"When the default-x attribute is used within a child element of the part-name-display, part-abbreviation-","type":"text"},{"text":" ","type":"text"},{"text":"display, group-name-display, or group-abbreviation-display elements, it changes the origin relative to the","type":"text"},{"text":" ","type":"text"},{"text":"start of the first measure on the system. These values are used when the current measure or a succeeding","type":"text"},{"text":" ","type":"text"},{"text":"measure starts a new system. The same change of origin is used for the group-symbol element.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For the note, figured-bass, and harmony elements, the default-x value is considered to have adjusted the","type":"text"},{"text":" ","type":"text"},{"text":"musical position within the bar for its descendant elements.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Since the credit-words and credit-image elements are not related to a measure, in these cases the default-x","type":"text"},{"text":" ","type":"text"},{"text":"and default-y attributes adjust the origin relative to the bottom left-hand corner of the specified page.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The relative-x and relative-y attributes change the position relative to the default position, either as","type":"text"},{"text":" ","type":"text"},{"text":"computed by the individual program, or as overridden by the default-x and default-y attributes.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Positive x is right, negative x is left; positive y is up, negative y is down. All units are in tenths of","type":"text"},{"text":" ","type":"text"},{"text":"interline space. For stems, positive relative-y lengthens a stem while negative relative-y shortens it.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The default-x and default-y position attributes provide higher-resolution positioning data than related","type":"text"},{"text":" ","type":"text"},{"text":"features such as the placement attribute and the offset element. Applications reading a MusicXML file that can","type":"text"},{"text":" ","type":"text"},{"text":"understand both features should generally rely on the default-x and default-y attributes for their greater","type":"text"},{"text":" ","type":"text"},{"text":"accuracy. For the relative-x and relative-y attributes, the offset element, placement attribute, and directive","type":"text"},{"text":" ","type":"text"},{"text":"attribute provide context for the relative position information, so the two features should be interpreted","type":"text"},{"text":" ","type":"text"},{"text":"together.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"As elsewhere in the MusicXML format, tenths are the global tenths defined by the scaling element, not the","type":"text"},{"text":" ","type":"text"},{"text":"local tenths of a staff resized by the staff-size element.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"metadata":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPosition","kind":"identifier"}],"modules":[{"name":"IvorMXL"}],"title":"MXLPosition","navigatorTitle":[{"text":"MXLPosition","kind":"identifier"}],"symbolKind":"struct","externalID":"s:7IvorMXL11MXLPositionV","roleHeading":"Structure","role":"symbol"},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLPosition/Equatable-Implementations":{"kind":"article","url":"\/documentation\/ivormxl\/mxlposition\/equatable-implementations","title":"Equatable Implementations","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition\/Equatable-Implementations","abstract":[],"type":"topic","role":"collectionGroup"},"doc://IvorMXL/SH":{"title":"Swift.Hashable","identifier":"doc:\/\/IvorMXL\/SH","type":"unresolvable"},"doc://IvorMXL/documentation/IvorMXL/MXLPosition/defaultX":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"defaultX","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLTenths","preciseIdentifier":"s:7IvorMXL9MXLTenthsa","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlposition\/defaultx","title":"defaultX","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition\/defaultX","abstract":[{"text":"The default horizontal position, in tenths, changing the computation of the default position relative to the","type":"text"},{"text":" ","type":"text"},{"text":"left-hand side of the note or the musical position within the measure.","type":"text"}],"type":"topic","role":"symbol"},"doc://IvorMXL/s8SendableP":{"title":"Swift.Sendable","identifier":"doc:\/\/IvorMXL\/s8SendableP","type":"unresolvable"},"doc://IvorMXL/documentation/IvorMXL/MXLPosition":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","type":"topic","navigatorTitle":[{"kin