l":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLPosition/relativeY":{"kind":"symbol","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition\/relativeY","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"relativeY","kind":"identifier"},{"kind":"text","text":": "},{"text":"MXLTenths","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLTenthsa"},{"text":"?","kind":"text"}],"type":"topic","abstract":[{"text":"The vertical position, in tenths, relative to the default position, either as computed by the application or","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"as overridden by "},{"code":"defaultY","type":"codeVoice"},{"type":"text","text":". Positive values are up, negative values down; for stems, a positive value"},{"type":"text","text":" "},{"type":"text","text":"lengthens the stem while a negative value shortens it."}],"url":"\/documentation\/ivormxl\/mxlposition\/relativey","title":"relativeY"},"doc://IvorMXL/s16SendableMetatypeP":{"type":"unresolvable","identifier":"doc:\/\/IvorMXL\/s16SendableMetatypeP","title":"Swift.SendableMetatype"}}}