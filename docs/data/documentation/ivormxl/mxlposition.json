iseIdentifier":"s:7IvorMXL9MXLTenthsa"},{"text":"?","kind":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition\/relativeY","type":"topic","abstract":[{"text":"The vertical position, in tenths, relative to the default position, either as computed by the application or","type":"text"},{"text":" ","type":"text"},{"text":"as overridden by ","type":"text"},{"code":"defaultY","type":"codeVoice"},{"text":". Positive values are up, negative values down; for stems, a positive value","type":"text"},{"text":" ","type":"text"},{"text":"lengthens the stem while a negative value shortens it.","type":"text"}],"title":"relativeY","url":"\/documentation\/ivormxl\/mxlposition\/relativey"},"doc://IvorMXL/s8SendableP":{"identifier":"doc:\/\/IvorMXL\/s8SendableP","title":"Swift.Sendable","type":"unresolvable"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/SH":{"identifier":"doc:\/\/IvorMXL\/SH","title":"Swift.Hashable","type":"unresolvable"}}}