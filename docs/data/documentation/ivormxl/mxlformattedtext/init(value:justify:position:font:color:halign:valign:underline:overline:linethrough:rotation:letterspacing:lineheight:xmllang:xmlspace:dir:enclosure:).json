type":"text","text":"attribute is present but the halign attribute is not, the justify attribute"},{"type":"text","text":" "},{"type":"text","text":"indicates horizontal alignment as well as justification."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"For most elements, any program will compute a default x and y position. The position","type":"text"},{"text":" ","type":"text"},{"text":"attributes let this be changed two ways.","type":"text"}]}],"name":"position"},{"name":"font","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The font attribute group gathers together attributes for determining the font within"},{"type":"text","text":" "},{"type":"text","text":"a credit or direction. They are based on the text styles for Cascading Style Sheets."},{"type":"text","text":" "},{"type":"text","text":"The font-family is a comma-separated list of font names. The font-style can be"},{"type":"text","text":" "},{"type":"text","text":"normal or italic. The font-size can be one of the CSS sizes or a numeric point size."},{"type":"text","text":" "},{"type":"text","text":"The font-weight can be normal or bold. The default is application-dependent, but is"},{"type":"text","text":" "},{"type":"text","text":"a text font vs. a music font."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The color attribute group indicates the color of an element.","type":"text"}]}],"name":"color"},{"name":"halign","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In cases where text extends over more than one line, horizontal alignment and"},{"type":"text","text":" "},{"type":"text","text":"justify values can be different."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The valign attribute is used to indicate vertical alignment to the top, middle,","type":"text"},{"text":" ","type":"text"},{"text":"bottom, or baseline of the text. Defaults are implementation-dependent.","type":"text"}]}],"name":"valign"},{"name":"underline","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The number of lines used to underline the text: "},{"code":"0","type":"codeVoice"},{"type":"text","text":" (none), "},{"code":"1","type":"codeVoice"},{"type":"text","text":", "},{"code":"2","type":"codeVoice"},{"type":"text","text":", or "},{"code":"3","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The number of lines used to overline the text: ","type":"text"},{"code":"0","type":"codeVoice"},{"text":" (none), ","type":"text"},{"code":"1","type":"codeVoice"},{"text":", ","type":"text"},{"code":"2","type":"codeVoice"},{"text":", or ","type":"text"},{"code":"3","type":"codeVoice"},{"text":".","type":"text"}]}],"name":"overline"},{"name":"lineThrough","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The number of lines used to strike through the text: "},{"code":"0","type":"codeVoice"},{"type":"text","text":" (none), "},{"code":"1","type":"codeVoice"},{"type":"text","text":", "},{"code":"2","type":"codeVoice"},{"type":"text","text":", or "},{"code":"3","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The rotation attribute is used to rotate text around the alignment point specified","type":"text"},{"text":" ","type":"text"},{"text":"by the halign and valign attributes. Positive values are clockwise rotations, while","type":"text"},{"text":" ","type":"text"},{"text":"negative values are counter-clockwise rotations.","type":"text"}]}],"name":"rotation"},{"name":"letterSpacing","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The letter-spacing attribute specifies text tracking. Values are either “normal” or"},{"type":"text","text":" "},{"type":"text","text":"a number representing the number of ems to add between each letter. The number may"},{"type":"text","text":" "},{"type":"text","text":"be negative in order to subtract space. The default is normal, which allows"},{"type":"text","text":" "},{"type":"text","text":"flexibility of letter-spacing for purposes of text justification."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The line-height attribute specifies text leading. Values are either “normal” or a","type":"text"},{"text":" ","type":"text"},{"text":"number representing the percentage of the current font height to use for leading.","type":"text"},{"text":" ","type":"text"},{"text":"The default is “normal”. The exact normal value is implementation-dependent, but","type":"text"},{"text":" ","type":"text"},{"text":"values between 100 and 120 are recommended.","type":"text"}]}],"name":"lineHeight"},{"name":"xmlLang","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The xml:lang attribute value."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The xml:space attribute value.","type":"text"}]}],"name":"xmlSpace"},{"name":"dir","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The text-direction attribute is used to adjust and override the Unicode"},{"type":"text","text":" "},{"type":"text","text":"bidirectional text algorithm, similar to the Directionality data category in the W3C"},{"type":"text","text":" "},{"type":"text","text":"Internationalization Tag Set recommendation."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The enclosure attribute group is used to specify the formatting of an enclosure","type":"text"},{"text":" ","type":"text"},{"text":"around text or symbols.","type":"text"}]}],"name":"enclosure"}]}],"abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLFormattedText"},{"type":"text","text":"."}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLFormattedText":{"type":"topic","title":"MXLFormattedText","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFormattedText","abstract":[{"type":"text","text":"The formatted-text type represents a text element with text-formatting attributes."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFormattedText"}],"navigatorTitle":[{"kind":"identifier","text":"MXLFormattedText"}],"url":"\/documentation\/ivormxl\/mxlformattedtext"},"doc://IvorMXL/documentation/IvorMXL/MXLEnclosureShape":{"title":"MXLEnclosureShape","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLEnclosureShape","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlenclosureshape","role":"symbol","navigatorTitle":[{"text":"MXLEnclosureShape","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnclosureShape","abstract":[{"type":"text","text":"The enclosure-shape type describes the shape and presence \/ absence of an enclosure around text or symbols. A"},{"type":"text","text":" "},{"type":"text","text":"bracket enclosure is similar to a rectangle with the bottom line missing, as is common in jazz notation. An"},{"type":"text","text":" "},{"type":"text","text":"inverted-bracket enclosure is similar to a rectangle with the top line missing."}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLRotationDegrees":{"type":"topic","abstract":[{"type":"text","text":"The rotation-degrees type specifies rotation, pan, and elevation values in degrees. Values range from -180 to"},{"type":"text","text":" "},{"type":"text","text":"180."}],"url":"\/documentation\/ivormxl\/mxlrotationdegrees","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLRotationDegrees"}],"kind":"symbol","title":"MXLRotationDegrees","navigatorTitle":[{"kind":"identifier","text":"MXLRotationDegrees"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRotationDegrees","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLTextDirection":{"title":"MXLTextDirection","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTextDirection","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxltextdirection","role":"symbol","navigatorTitle":[{"text":"MXLTextDirection","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTextDirection","abstract":[{"text":"The text-direction type is used to adjust and override the Unicode bidirectional text algorithm, similar to","type":"text"},{"text":" ","type":"text"},{"text":"the Directionality data category in the W3C Internationalization Tag Set recommendation. Values are ltr (left-","type":"text"},{"text":" ","type":"text"},{"text":"to-right embed), rtl (right-to-left embed), lro (left-to-right bidi-override), and rlo (right-to-left bidi-","type":"text"},{"text":" ","type":"text"},{"text":"override). The default value is ltr. This type is typically used by applications that store text in left-to-","type":"text"},{"text":" ","type":"text"},{"text":"right visual order rather than logical order. Such applications can use the lro value to better communicate","type":"text"},{"text":" ","type":"text"},{"text":"with other applications that more fully support bidirectional text.","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLValign":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLValign","kind":"identifier"}],"title":"MXLValign","abstract":[{"type":"text","text":"The valign type is used to indicate vertical alignment to the top, middle, bottom, or baseline of the text. If"},{"type":"text","text":" "},{"type":"text","text":"the text is on multiple lines, baseline alignment refers to the baseline of the lowest line of text. Defaults"},{"type":"text","text":" "},{"type":"text","text":"are implementation-dependent."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValign","role":"symbol","url":"\/documentation\/ivormxl\/mxlvalign","kind":"symbol","navigatorTitle":[{"text":"MXLValign","kind":"i