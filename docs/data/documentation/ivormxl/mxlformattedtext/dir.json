url":"\/documentation\/ivormxl\/mxlformattedtext","abstract":[{"type":"text","text":"The formatted-text type represents a text element with text-formatting attributes."}],"type":"topic","role":"symbol","kind":"symbol","title":"MXLFormattedText","navigatorTitle":[{"text":"MXLFormattedText","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFormattedText"}]},"doc://IvorMXL/documentation/IvorMXL/MXLTextDirection":{"url":"\/documentation\/ivormxl\/mxltextdirection","title":"MXLTextDirection","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTextDirection"}],"navigatorTitle":[{"kind":"identifier","text":"MXLTextDirection"}],"abstract":[{"type":"text","text":"The text-direction type is used to adjust and override the Unicode bidirectional text algorithm, similar to"},{"type":"text","text":" "},{"type":"text","text":"the Directionality data category in the W3C Internationalization Tag Set recommendation. Values are ltr (left-"},{"type":"text","text":" "},{"type":"text","text":"to-right embed), rtl (right-to-left embed), lro (left-to-right bidi-override), and rlo (right-to-left bidi-"},{"type":"text","text":" "},{"type":"text","text":"override). The default value is ltr. This type is typically used by applications that store text in left-to-"},{"type":"text","text":" "},{"type":"text","text":"right visual order rather than logical order. Such applications can use the lro value to better communicate"},{"type":"text","text":" "},{"type":"text","text":"with other applications that more fully support bidirectional text."}],"kind":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTextDirection"},"doc://IvorMXL/documentation/IvorMXL/MXLFormattedText/dir":{"type":"topic","abstract":[{"type":"text","text":"The text-direction attribute is used to adjust and override the Unicode bidirectional text algorith