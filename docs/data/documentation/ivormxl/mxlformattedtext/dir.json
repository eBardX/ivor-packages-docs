ttribute is used to adjust and override the Unicode bidirectional text algorithm, similar"},{"type":"text","text":" "},{"type":"text","text":"to the Directionality data category in the W3C Internationalization Tag Set recommendation."}],"url":"\/documentation\/ivormxl\/mxlformattedtext\/dir","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFormattedText\/dir","kind":"symbol","title":"dir","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"dir"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL16MXLTextDirectionO","text":"MXLTextDirection"}]},"doc://IvorMXL/documentation/IvorMXL/MXLTextDirection":{"kind":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTextDirection"}],"url":"\/documentation\/ivormxl\/mxltextdirection","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTextDirection","navigatorTitle":[{"text":"MXLTextDirection","kind":"identifier"}],"abstract":[{"type":"text","text":"The text-direction type is used to adjust and override the Unicode bidirectional text algorithm, similar to"},{"text":" ","type":"text"},{"type":"text","text":"the Directionality data category in the W3C Internationalization Tag Set recommendation. Values are ltr (left-"},{"type":"text","text":" "},{"type":"text","text":"to-right embed), rtl (right-to-left embed), lro (left-to-right bidi-override), and rlo (right-to-left bidi-"},{"type":"text","text":" "},{"type":"text","text":"override). The default value is ltr. This type is typically used by applications that store text in left-to-"},{"type":"text","text":" "},{"type":"text","text":"right visual order rather than logical order. Such applications can use the lro value to better communicate"},{"type":"text","text":" "},{"type":"text","text":"with other applications that more fully support bidirectional text."}],"title":"MXLTextDirection","role