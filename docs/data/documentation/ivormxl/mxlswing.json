{"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSwing","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"The swing element specifies whether or not to use swing playback, where consecutive on-beat \/ off-beat eighth"},{"type":"text","text":" "},{"type":"text","text":"or 16th notes are played with unequal nominal durations."}],"topicSections":[{"title":"Initializers","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSwing\/init(content:style:)"],"generated":true,"anchor":"Initializers"},{"title":"Instance Properties","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSwing\/content-swift.property","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSwing\/style"],"generated":true,"anchor":"Instance-Properties"},{"title":"Enumerations","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSwing\/Content-swift.enum","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSwing\/Kind"],"generated":true,"anchor":"Enumerations"},{"title":"Default Implementations","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSwing\/Equatable-Implementations"],"generated":true,"anchor":"Default-Implementations"}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL"]]},"sections":[],"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/IvorMXL\/s8CopyableP","doc:\/\/IvorMXL\/SQ","doc:\/\/IvorMXL\/s9EscapableP","doc:\/\/IvorMXL\/SH","doc:\/\/IvorMXL\/s8SendableP","doc:\/\/IvorMXL\/s16SendableMetatypeP"],"kind":"relationships","type":"conformsTo"}],"variants":[{"paths":["\/documentation\/ivormxl\/mxlswing"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"symbolKind":"struct","role":"symbol","roleHeading":"Structure","externalID":"s:7IvorMXL8MXLSwingV","modules":[{"name":"IvorMXL"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLSwing"}],"title":"MXLSwing","navigatorTitle":[{"text":"MXLSwing","kind":"identifier"}]},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLSwing"}],"platforms":["macOS"]}]},{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The straight element specifies that no swing is present, so consecutive notes have equal durations."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The first and second elements are positive integers that specify the ratio between durations of consecutive"},{"type":"text","text":" "},{"type":"text","text":"notes. For example, a first element with a value of 2 and a second element with a value of 1 applied to eighth"},{"type":"text","text":" "},{"type":"text","text":"notes specifies a quarter note \/ eighth note tuplet playback, where the first note is twice as long as the"},{"type":"text","text":" "},{"type":"text","text":"second note. Ratios should be specified with the smallest integers possible. For example, a ratio of 6 to 4"},{"type":"text","text":" "},{"type":"text","text":"should be specified as 3 to 2 instead."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The optional swing-type element specifies the note type, either eighth or 16th, to which the ratio is applied."},{"type":"text","text":" "},{"type":"text","text":"The value is eighth if this element is not present."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The optional swing-style element is a string describing the style of swing used."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The swing element has no effect for playback of grace notes, notes where a type element is not present, and"},{"type":"text","text":" "},{"type":"text","text":"notes where the specified duration is different than the nominal value associated with the specified type. If"},{"type":"text","text":" "},{"type":"text","text":"a swung note has attack and release attributes, those values modify the swung playback."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Maps the MusicXML "},{"type":"codeVoice","code":"<swing>"},{"type":"text","text":" element."}]}],"kind":"content"}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLSwing/Kind":{"kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"The swing-type-value type specifies the note type, either eighth or 16th, to which the ratio defined in the"},{"type":"text","text":" "},{"type":"text","text":"swing element is applied."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSwing\/Kind","type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Kind","kind":"identifier"}],"title":"MXLSwing.Kind","url":"\/documentation\/ivormxl\/mxlswing\/kind","navigatorTitle":[{"text":"Kind","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLSwing/Content-swift.enum":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSwing\/Content-swift.enum","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Content"}],"abstract":[{"type":"text","text":"One of the alternatives for Swing."}],"kind":"symbol","title":"MXLSwing.Content","url":"\/documentation\/ivormxl\/mxlswing\/content-swift.enum","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Content"}]},"doc://IvorMXL/SH":{"title":"Swift.Hashable","type":"unresolvable","identifier":"doc:\/\/IvorMXL\/SH"},"doc://IvorMXL/documentation/IvorMXL/MXLSwing/Equatable-Implementations":{"kind":"article","role":"collectionGroup","abstract":[],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSwing\/Equatable-Implementations","type":"topic","title":"Equatable Implementations","url":"\/documentation\/ivormxl\/mxlswing\/equatable-implementations"},"doc://IvorMXL/documentation/IvorMXL/MXLSwing/in