{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlswing"]}],"abstract":[{"text":"The swing element specifies whether or not to use swing playback, where consecutive on-beat \/ off-beat eighth","type":"text"},{"text":" ","type":"text"},{"text":"or 16th notes are played with unequal nominal durations.","type":"text"}],"metadata":{"navigatorTitle":[{"kind":"identifier","text":"MXLSwing"}],"externalID":"s:7IvorMXL8MXLSwingV","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSwing","kind":"identifier"}],"modules":[{"name":"IvorMXL"}],"title":"MXLSwing","symbolKind":"struct","roleHeading":"Structure"},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSwing"},"kind":"symbol","topicSections":[{"title":"Initializers","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSwing\/init(content:style:)"],"generated":true,"anchor":"Initializers"},{"title":"Instance Properties","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSwing\/content-swift.property","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSwing\/style"],"generated":true,"anchor":"Instance-Properties"},{"title":"Enumerations","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSwing\/Content-swift.enum","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSwing\/Kind"],"generated":true,"anchor":"Enumerations"},{"title":"Default Implementations","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSwing\/Equatable-Implementations"],"generated":true,"anchor":"Default-Implementations"}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL"]]},"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/IvorMXL\/s8CopyableP","doc:\/\/IvorMXL\/SQ","doc:\/\/IvorMXL\/s9EscapableP","doc:\/\/IvorMXL\/SH","doc:\/\/IvorMXL\/s8SendableP","doc:\/\/IvorMXL\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSwing","kind":"identifier"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"The straight element specifies that no swing is present, so consecutive notes have equal durations.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The first and second elements are positive integers that specify the ratio between durations of consecutive","type":"text"},{"text":" ","type":"text"},{"text":"notes. For example, a first element with a value of 2 and a second element with a value of 1 applied to eighth","type":"text"},{"text":" ","type":"text"},{"text":"notes specifies a quarter note \/ eighth note tuplet playback, where the first note is twice as long as the","type":"text"},{"text":" ","type":"text"},{"text":"second note. Ratios should be specified with the smallest integers possible. For example, a ratio of 6 to 4","type":"text"},{"text":" ","type":"text"},{"text":"should be specified as 3 to 2 instead.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The optional swing-type element specifies the note type, either eighth or 16th, to which the ratio is applied.","type":"text"},{"text":" ","type":"text"},{"text":"The value is eighth if this element is not present.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The optional swing-style element is a string describing the style of swing used.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The swing element has no effect for playback of grace notes, notes where a type element is not present, and","type":"text"},{"text":" ","type":"text"},{"text":"notes where the specified duration is different than the nominal value associated with the specified type. If","type":"text"},{"text":" ","type":"text"},{"text":"a swung note has attack and release attributes, those values modify the swung playback.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Maps the MusicXML ","type":"text"},{"code":"<swing>","type":"codeVoice"},{"text":" element.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://IvorMXL/s8SendableP":{"title":"Swift.Sendable","identifier":"doc:\/\/IvorMXL\/s8SendableP","type":"unresolvable"},"doc://IvorMXL/documentation/IvorMXL/MXLSwing/Kind":{"type":"topic","abstract":[{"type":"text","text":"The swing-type-value type specifies the note type, either eighth or 16th, to which the ratio defined in the"},{"type":"text","text":" "},{"type":"text","text":"swing element is applied."}],"url":"\/documentation\/ivormxl\/mxlswing\/kind","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Kind"}],"kind":"symbol","title":"MXLSwing.Kind","navigatorTitle":[{"kind":"identifier","text":"Kind"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSwing\/Kind","role":"symbol"},"doc://IvorMXL/SQ":{"title":"Swift.Equatable","identifier":"doc:\/\/IvorMXL\/SQ","type":"unresolvable"},"doc://IvorMXL/documentation/IvorMXL/MXLSwing/init(content:style:)":{"url":"\/documentation\/ivormxl\/mxlswing\/init(content:style:)","abstract":[{"text":"Creates a new ","type":"text"},{"code":"MXLSwing","type":"codeVoice"},{"text":".","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSwing\/init(content:style:)","kind":"symbol","title":"init(content:style:)","role":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"content","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL8MXLSwingV7ContentO","text":"Content","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"style","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind