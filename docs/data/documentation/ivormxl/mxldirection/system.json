{"sections":[],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection"]]},"abstract":[{"type":"text","text":"The system-relation attribute group distinguishes elements that are associated with a system rather than the"},{"type":"text","text":" "},{"type":"text","text":"particular part where the element appears."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"system"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemRelation","text":"MXLSystemRelation","preciseIdentifier":"s:7IvorMXL17MXLSystemRelationO"},{"kind":"text","text":"?"}],"platforms":["macOS"],"languages":["swift"]}]},{"content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"Maps to the MusicXML ","type":"text"},{"code":"system","type":"codeVoice"},{"text":" attribute.","type":"text"}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/ivormxl\/mxldirection\/system"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"system"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLSystemRelation","preciseIdentifier":"s:7IvorMXL17MXLSystemRelationO"},{"kind":"text","text":"?"}],"title":"system","externalID":"s:7IvorMXL12MXLDirectionV6systemAA17MXLSystemRelationOSgvp","modules":[{"name":"IvorMXL"}],"roleHeading":"Instance Property","role":"symbol","symbolKind":"property"},"kind":"symbol","identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/system","interfaceLanguage":"swift"},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLDirection":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDir