{"kind":"symbol","sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/system"},"variants":[{"paths":["\/documentation\/ivormxl\/mxldirection\/system"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection"]]},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"system","kind":"identifier"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemRelation","text":"MXLSystemRelation","preciseIdentifier":"s:7IvorMXL17MXLSystemRelationO","kind":"typeIdentifier"},{"text":"?","kind":"text"}]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Maps to the MusicXML "},{"type":"codeVoice","code":"system"},{"type":"text","text":" attribute."}],"type":"paragraph"}]}],"abstract":[{"type":"text","text":"The system-relation attribute group distinguishes elements that are associated with a system rather than the"},{"type":"text","text":" "},{"type":"text","text":"particular part where the element appears."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"system","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLSystemRelation","preciseIdentifier":"s:7IvorMXL17MXLSystemRelationO","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"symbolKind":"property","externalID":"s:7IvorMXL12MXLDirectionV6systemAA17MXLSystemRelationOSgvp","role":"symbol","roleHeading":"Instance Property","modules":[{"name":"IvorMXL"}],"title":"system"},"references":{"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLDirection"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection","title":"MXLDirection","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLDirection"}],"abstract":[{"text":"A direction is a musical indication that is not necessarily attached to a specific note. Two or more may be","type":"text"},{"type":"text","text":" "},{"text":"combined to indicate words followed by the start of a dashed line, the end of a wedge followed by dynamics,","type":"text"},{"type":"text","text":" "},{"text":"etc. For applications where a specific direction is indeed attached to a specific note, the direction element","type":"text"},{"type":"text","text":" "},{"text":"can be associated with the first note element that follows it in score order that is not in a different voice.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxldirection"},"doc://IvorMXL/documentation/IvorMXL/MXLSystemRelation":{"url":"\/documentation\/ivormxl\/mxlsystemrelation","title":"MXLSystemRelation","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSystemRelation","kind":"identifier"}],"navigatorTitle":[{"text":"MXLSystemRelation","kind":"identifier"}],"abstract":[{"text":"The system-relation type distinguishes elements that are associated with a system rather than the particular","type":"text"},{"text":" ","type":"text"},{"text":"part where the element appears. A value of only-top indicates that the element should appear only on the top","type":"text"},{"text":" ","type":"text"},{"text":"part of the current system. A value of also-top indicates that the element should appear on both the current","type":"text"},{"text":" ","type":"text"},{"text":"part and the top part of the current system. If this value appears in a score, when parts are created the","type":"text"},{"text":" ","type":"text"},{"text":"element should only appear once in this part, not twice. A value of none indicates that the element is","type":"text"},{"text":" ","type":"text"},{"text":"associated only with the current part, not with the system.","type":"text"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemRelation"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection/system":{"kind":"symbol","url":"\/documentation\/ivormxl\/mxldirection\/system","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/system","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"system","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLSystemRelation","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL17MXLSystemRelationO"},{"text":"?","kind":"text"}],"role":"symbol","abstract":[{"type":"text","text":"The system-relation attribute group distinguishes elements that are associated with a system rather than the"},{"type":"text","text":" "},{"type":"text","text":"particular part where the element appears."}],"type":"topic","title":"system"}}}