{"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/system"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"system"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLSystemRelation","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemRelation","preciseIdentifier":"s:7IvorMXL17MXLSystemRelationO"},{"text":"?","kind":"text"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"text":"Maps to the MusicXML ","type":"text"},{"type":"codeVoice","code":"system"},{"text":" attribute.","type":"text"}],"type":"paragraph"}]}],"abstract":[{"text":"The system-relation attribute group distinguishes elements that are associated with a system rather than the","type":"text"},{"text":" ","type":"text"},{"text":"particular part where the element appears.","type":"text"}],"sections":[],"metadata":{"roleHeading":"Instance Property","title":"system","symbolKind":"property","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"system","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLSystemRelation","preciseIdentifier":"s:7IvorMXL17MXLSystemRelationO","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"role":"symbol","externalID":"s:7IvorMXL12MXLDirectionV6systemAA17MXLSystemRelationOSgvp","modules":[{"name":"IvorMXL"}]},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxldirection\/system"]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLDirection/system":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/system","url":"\/documentation\/ivormxl\/mxldirection\/system","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"system","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL17MXLSystemRelationO","text":"MXLSystemRelation","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"abstract":[{"type":"text","text":"The system-relation attribute group distinguishes elements that are associated with a system rather than the"},{"type":"text","text":" "},{"type":"text","text":"particular part where the element appears."}],"title":"system","type":"topic","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection":{"role":"symbol","url":"\/documentation\/ivormxl\/mxldirection","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLDirection","kind":"identifier"}],"navigatorTitle":[{"text":"MXLDirection","kind":"identifier"}],"abstract":[{"text":"A direction is a musical indication that is not necessarily attached to a specific note. Two or more may be","type":"text"},{"text":" ","type":"text"},{"text":"combined to indicate words followed by the start of a dashed line, the end of a wedge followed by dynamics,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"etc. For applications where a specific direction is indeed attached to a specific note, the direction element"},{"text":" ","type":"text"},{"type":"text","text":"can be associated with the first note element that follows it in score order that is not in a different voice."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection","title":"MXLDirection","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLSystemRelation":{"url":"\/documentation\/ivormxl\/mxlsystemrelation","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemRelation","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLSystemRelation"}],"title":"MXLSystemRelation","abstract":[{"text":"The system-relation type distinguishes elements that are associated with a system rather than the particular","type":"text"},{"text":" ","type":"text"},{"text":"part where the element appears. A value of only-top indicates that the element should appear only on the top","type":"text"},{"text":" ","type":"text"},{"text":"part of the current system. A value of also-top indicates that the element should appear on both the current","type":"text"},{"text":" ","type":"text"},{"text":"part and the top part of the current system. If this value appears in a score, when parts are created the","type":"text"},{"text":" ","type":"text"},{"text":"element should only appear once in this part, not twice. A value of none indicates that the element is","type":"text"},{"text":" ","type":"text"},{"text":"associated only with the current part, not with the system.","type":"text"}],"type":"topic","fragments":[{"kind":"keyword","text":"enum"},{"text":" ","kind":"text"},{"kind":"identifier","text":"MXLSystemRelation"}]},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]}}}