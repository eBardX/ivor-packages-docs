{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxldirection\/offset"]}],"abstract":[{"text":"The position of the direction relative to the current musical location, in divisions.","type":"text"}],"sections":[],"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection"]]},"metadata":{"externalID":"s:7IvorMXL12MXLDirectionV6offsetAA9MXLOffsetVSgvp","symbolKind":"property","modules":[{"name":"IvorMXL"}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"offset","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL9MXLOffsetV","text":"MXLOffset","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"roleHeading":"Instance Property","title":"offset","role":"symbol"},"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/offset","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"offset","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL9MXLOffsetV","text":"MXLOffset","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOffset","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Maps to a nested MusicXML "},{"type":"codeVoice","code":"<offset>"},{"type":"text","text":" element."}]}],"kind":"content"}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLDirection":{"type":"topic","title":"MXLDirection","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection","abstract":[{"type":"text","text":"A direction is a musical indication that is not necessarily attached to a specific note. Two or more may be"},{"type":"text","text":" "},{"type":"text","text":"combined to indicate words followed by the start of a dashed line, the end of a wedge followed by dynamics,"},{"type":"text","text":" "},{"type":"text","text":"etc. For applications where a specific direction is indeed attached to a specific note, the direction element"},{"type":"text","text":" "},{"type":"text","text":"can be associated with the first note element that follows it in score order that is not in a different voice."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLDirection"}],"navigatorTitle":[{"kind":"identifier","text":"MXLDirection"}],"url":"\/documentation\/ivormxl\/mxldirection"},"doc://IvorMXL/documentation/IvorMXL/MXLOffset":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOffset","role":"symbol","navigatorTitle":[{"text":"MXLOffset","kind":"identifier"}],"type":"topic","title":"MXLOffset","kind":"symbol","url":"\/documentation\/ivormxl\/mxloffset","abstract":[{"type":"text","text":"An offset is represented in terms of divisions, and indicates where the direction will appear relative to the"},{"type":"text","text":" "},{"type":"text","text":"current musical location. The current musical location is always within the current measure, even at the end"},{"type":"text","text":" "},{"type":"text","text":"of a measure."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLOffset","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection/offset":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"offset","kind