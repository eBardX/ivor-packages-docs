L parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLPercussion":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPercussion","title":"MXLPercussion","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPercussion"}],"abstract":[{"text":"The percussion element is used to define percussion pictogram symbols. Definitions for these symbols can be","type":"text"},{"text":" ","type":"text"},{"text":"found in Kurt Stone’s “Music Notation in the Twentieth Century” on pages 206-212 and 223. Some values are","type":"text"},{"text":" ","type":"text"},{"text":"added to these based on how usage has evolved in the 30 years since Stone’s book was published.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlpercussion","kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLPercussion"}]},"doc://IvorMXL/documentation/IvorMXL/MXLDirection/Kind-swift.struct/Content-swift.enum/percussion(_:)":{"title":"MXLDirection.Kind.Content.percussion(_:)","abstract":[{"type":"text","text":"One or more percussion pictogram symbols."}],"type":"topic","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"percussion","kind":"identifier"},{"text":"([","kind":"text"},{"text":"MXLPercussion","preciseIdentifier":"s:7IvorMXL13MXLPercussionV","kind":"typeIdentifier"},{"text":"])","kind":"text"}],"role":"symbol","url":"\/documentation\/ivormxl\/mxldirection\/kind-swift.struct\/content-swift.enum\/percussion(_:)","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/Kind-swift.struct\/Content-swift.enum\/percussion(_:)","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection/Kind-swift.struct":{"role":"symbol","url":"\/documentation\/ivormxl\/mxldirection\/kind-swift.struct","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Kind","kind":"identifier"}],"navigator