,"title":"MXLDirection","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLDirection"}],"abstract":[{"text":"A direction is a musical indication that is not necessarily attached to a specific note. Two or more may be","type":"text"},{"type":"text","text":" "},{"text":"combined to indicate words followed by the start of a dashed line, the end of a wedge followed by dynamics,","type":"text"},{"type":"text","text":" "},{"text":"etc. For applications where a specific direction is indeed attached to a specific note, the direction element","type":"text"},{"type":"text","text":" "},{"text":"can be associated with the first note element that follows it in score order that is not in a different voice.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxldirection"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection/Kind-swift.struct/Content-swift.enum":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Content","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/Kind-swift.struct\/Content-swift.enum","title":"MXLDirection.Kind.Content","kind":"symbol","navigatorTitle":[{"text":"Content","kind":"identifier"}],"abstract":[{"type":"text","text":"One of the alternatives for DirectionType."}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxldirection\/kind-swift.struct\/content-swift.enum"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection/Kind-swift.struct":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Kind","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/Kind-swift.struct","title":"MXLDirection.Kind","kind":"symbol","navigatorTitle":[{"text":"Kind","kind":"identifier"}],"abstract":[{"text":"Textual direction types may have more than 1 component due to multiple fonts. The dynamics element may also be","type":"text"},{"type":"text","text":" "},{"text":"used in the notations element. Attribute groups related to print suggestions apply to the individual","type":"text"},{"text":" ","type":"text"},{"text":"direction-type, not to the overall direction.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxldirection\/kind-swift.struct"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection/Kind-swift.struct/Content-swift.enum/percussion(_:)":{"role":"symbol","kind":"symbol","title":"MXLDirection.Kind.Content.percussion(_:)","url":"\/documentation\/ivormxl\/mxldirection\/kind-swift.struct\/content-swift.enum\/percussion(_:)","abstract":[{"type":"text","text":"One or more percussion pictogram symbols."}],"type":"topic","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"percussion"},{"kind":"text","text":"(["},{"kind":"typeIdentifier","text":"MXLPercussion","preciseIdentifier":"s:7IvorMXL13MXLPercussionV"},{"kind":"text","text":"])"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/Kind-swift.struct\/Content-swift.enum\/percussion(_:)"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLPercussion":{"role":"symbol","kind":"symbol","title":"MXLPercussion","abstract":[{"text":"The percussion element is used to define percussion pictogram symbols. Definitions for these symbols can be","type":"text"},{"text":" ","type":"text"},{"text":"found in Kurt Stone’s “Music Notation in the Twentieth Century” on pages 206-212 and 223. Some values are","type":"text"},{"text":" ","type":"text"},{"text":"added to these based on how usage has evolved in the 30 years since Stone’s book was published.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlpercussion","type":"topic","fragm