:"text"},{"text":"Kind","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"Textual direction types may have more than 1 component due to multiple fonts. The dynamics element may also be","type":"text"},{"text":" ","type":"text"},{"text":"used in the notations element. Attribute groups related to print suggestions apply to the individual","type":"text"},{"text":" ","type":"text"},{"text":"direction-type, not to the overall direction.","type":"text"}],"type":"topic","navigatorTitle":[{"text":"Kind","kind":"identifier"}],"title":"MXLDirection.Kind"},"doc://IvorMXL/documentation/IvorMXL/MXLPedal":{"url":"\/documentation\/ivormxl\/mxlpedal","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPedal","abstract":[{"type":"text","text":"The pedal type represents piano pedal marks, including damper and sostenuto pedal marks. The line attribute is"},{"type":"text","text":" "},{"type":"text","text":"yes if pedal lines are used. The sign attribute is yes if Ped, Sost, and * signs are used. For compatibility"},{"type":"text","text":" "},{"type":"text","text":"with older versions, the sign attribute is yes by default if the line attribute is no, and is no by default if"},{"type":"text","text":" "},{"type":"text","text":"the line attribute is yes. If the sign attribute is set to yes and the type is start or sostenuto, the"},{"type":"text","text":" "},{"type":"text","text":"abbreviated attribute is yes if the short P and S signs are used, and no if the full Ped and Sost signs are"},{"type":"text","text":" "},{"type":"text","text":"used. It is no by default. Otherwise the abbreviated attribute is ignored. The alignment attributes are"},{"type":"text","text":" "},{"type":"text","text":"ignored if the sign attribute is no."}],"title":"MXLPedal","kind":"symbol","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPedal"}],"navigatorTitle":[{"kind":"identifier","text":"MXLPedal"}]},"doc://IvorMXL/documentation/IvorMXL/MXLDirection/Kind-swift.struct/Content-swift.enum/pedal(_:)":{"role":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxldirection\/kind-swift.struct\/content-swift.enum\/pedal(_:)","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/Kind-swift.struct\/Content-swift.enum\/pedal(_:)","abstract":[{"type":"text","text":"A piano pedal mark, such as damper or sostenuto."}],"title":"MXLDirection.Kind.Content.pedal(_:)","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"pedal"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLPedalV","text":"MXLPedal"},{"kind":"text","text":")"}]},"doc://IvorMXL/documentation/IvorMXL/MXLDirection":{"role":"symbol","url":"\/documentation\/ivormxl\/mxldirection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLDirection","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"A direction is a musical indication that is not necessarily attached to a specific note. Two or more may be","type":"text"},{"text":" ","type":"text"},{"text":"combined to indicate words followed by the start of a dashed line, the end of a wedge followed by dynamics,","type":"text"},{"text":" ","type":"text"},{"text":"etc. For applications where a specific direction is indeed attached to a specific note, the direction element","type":"text"},{"text":" ","type":"text"},{"text":"can be associated with the first note element that follows it in score order that is not in a different voice.","type":"text"}],"type":"topic","navigatorTitle":[{"text":"MXLDirection","kind":"identifier"}],"title":"MXLDirection"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection/Kind-swift.struct/Content-swift.enum":{"abstract":[{"type":"text","text":"One of the alternatives for DirectionType."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/Kind-swift.struct\/Content-swift.enum","kind":"symbol","url":"\/documentation\/ivormxl\/mxldirection\/kind-swift.struct\/content-swift.enum","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Content","kind":"identifier"}],"navigatorTitle":[{"text":"Content","kind":"identifier"}],"title":"MXLDirection.Kind.Content","role":"symbol","type":"topic"}}}