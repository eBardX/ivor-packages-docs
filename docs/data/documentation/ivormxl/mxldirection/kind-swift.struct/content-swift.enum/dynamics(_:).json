swift.struct\/Content-swift.enum","title":"MXLDirection.Kind.Content","kind":"symbol","navigatorTitle":[{"text":"Content","kind":"identifier"}],"abstract":[{"type":"text","text":"One of the alternatives for DirectionType."}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxldirection\/kind-swift.struct\/content-swift.enum"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLDirection"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection","title":"MXLDirection","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLDirection"}],"abstract":[{"text":"A direction is a musical indication that is not necessarily attached to a specific note. Two or more may be","type":"text"},{"type":"text","text":" "},{"text":"combined to indicate words followed by the start of a dashed line, the end of a wedge followed by dynamics,","type":"text"},{"type":"text","text":" "},{"text":"etc. For applications where a specific direction is indeed attached to a specific note, the direction element","type":"text"},{"type":"text","text":" "},{"text":"can be associated with the first note element that follows it in score order that is not in a different voice.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxldirection"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection/Kind-swift.struct/Content-swift.enum/dynamics(_:)":{"type":"topic","title":"MXLDirection.Kind.Content.dynamics(_:)","url":"\/documentation\/ivormxl\/mxldirection\/kind-swift.struct\/content-swift.enum\/dynamics(_:)","abstract":[{"type":"text","text":"One or more dynamics markings."}],"role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dynamics","kind":"identifier"},{"text":"([","kind":"text"},{"text":"MXLDynamics","preciseIdentifier":"s:7IvorMXL11MXLDynamicsV","kind":"typeIdentifier"},{"text":"])","kind":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/Kind-swift.struct\/Content-swift.enum\/dynamics(_:)","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection/Kind-swift.struct":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Kind","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/Kind-swift.struct","title":"MXLDirection.Kind","kind":"symbol","navigatorTitle":[{"text":"Kind","kind":"identifier"}],"abstract":[{"text":"Textual direction types may have more than 1 component due to multiple fonts. The dynamics element may also be","type":"text"},{"type":"text","text":" "},{"text":"used in the notations element. Attribute groups related to print suggestions apply to the individual","type":"text"},{"text":" ","type":"text"},{"text":"direction-type, not to the overall direction.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxldirection\/kind-swift.struct"},"doc://IvorMXL/documentation/IvorMXL/MXLDynamics":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLDynamics"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLDynamics"}],"url":"\/documentation\/ivormxl\/mxldynamics","role":"symbol","title":"MXLDynamics","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDynamics","type":"topic","abstract":[{"type":"text","text":"Dynamics can be associated either with a note or a general musical direction. To avoid inconsistencies between"},{"type":"text","text":" "},{"type":"text","text":"and among the letter abbreviations for dynamics (what is sf vs. sfz, standing alone or with a trailing"},{"type":"text","text":" "},{"type":"text","text":"dynamic that is not always piano), we use the actual letters as the names of these dynamic elements. The"},{"type":"text","text":" "},{"type":"text","text":"other-dynamics element allows other dynamic marks that are not covered here. Dynamics elements may also be"},{"type":"text","text":" "},{"type":"text","text":"combined to create marks not covered by a single element, such as sfmp."}]}}}