ind-swift.struct","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Kind","kind":"identifier"}],"navigatorTitle":[{"text":"Kind","kind":"identifier"}],"abstract":[{"type":"text","text":"Textual direction types may have more than 1 component due to multiple fonts. The dynamics element may also be"},{"type":"text","text":" "},{"type":"text","text":"used in the notations element. Attribute groups related to print suggestions apply to the individual"},{"type":"text","text":" "},{"type":"text","text":"direction-type, not to the overall direction."}],"title":"MXLDirection.Kind","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/Kind-swift.struct","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLAccordionRegistration":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlaccordionregistration","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLAccordionRegistration"}],"navigatorTitle":[{"kind":"identifier","text":"MXLAccordionRegistration"}],"abstract":[{"type":"text","text":"The accordion-registration type is used for accordion registration symbols. These are circular symbols divided"},{"type":"text","text":" "},{"type":"text","text":"horizontally into high, middle, and low sections that correspond to 4’, 8’, and 16’ pipes. Each accordion-"},{"type":"text","text":" "},{"type":"text","text":"high, accordion-middle, and accordion-low element represents the presence of one or more dots in the"},{"type":"text","text":" "},{"type":"text","text":"registration diagram. An accordion-registration element needs to have at least one of the child elements"},{"type":"text","text":" "},{"type":"text","text":"present."}],"title":"MXLAccordionRegistration","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccordionRegistration","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection":{"role":"symbol","url":"\/documentation\/ivormxl\/mxldirection","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLDirection","kind":"identifier"}],"navigatorTitle":[{"text":"MXLDirection","kind":"identifier"}],"abstract":[{"text":"A direction is a musical indication that is not necessarily attached to a specific note. Two or more may be","type":"text"},{"text":" ","type":"text"},{"text":"combined to indicate words followed by the start of a dashed line, the end of a wedge followed by dynamics,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"etc. For applications where a specific direction is indeed attached to a specific note, the direction element"},{"text":" ","type":"text"},{"type":"text","text":"can be associated with the first note element that follows it in score order that is not in a different voice."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection","title":"MXLDirection","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection/Kind-swift.struct/Content-swift.enum/accordionRegistration(_:)":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/Kind-swift.struct\/Content-swift.enum\/accordionRegistration(_:)","role":"symbol","abstract":[{"text":"An accordion registration symbol.","type":"text"}],"title":"MXLDirection.Kind.Content.accordionRegistration(_:)","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"accordionRegistration"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"MXLAccordionRegistration","preciseIdentifier":"s:7IvorMXL24MXLAccordionRegistrationV"},{"kind":"text","text":")"}],"kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxldirection\/kind-swift.struct\/content-swift.enum\/accordionregistration(_:)"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"