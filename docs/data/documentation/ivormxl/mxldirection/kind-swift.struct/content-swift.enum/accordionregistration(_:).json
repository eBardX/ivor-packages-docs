on.Kind.Content.accordionRegistration(_:)","url":"\/documentation\/ivormxl\/mxldirection\/kind-swift.struct\/content-swift.enum\/accordionregistration(_:)","type":"topic","abstract":[{"type":"text","text":"An accordion registration symbol."}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"accordionRegistration"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL24MXLAccordionRegistrationV","text":"MXLAccordionRegistration"},{"kind":"text","text":")"}],"role":"symbol","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/Kind-swift.struct\/Content-swift.enum\/accordionRegistration(_:)"},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLAccordionRegistration":{"title":"MXLAccordionRegistration","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLAccordionRegistration","kind":"identifier"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlaccordionregistration","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccordionRegistration","abstract":[{"type":"text","text":"The accordion-registration type is used for accordion registration symbols. These are circular symbols divided"},{"text":" ","type":"text"},{"text":"horizontally into high, middle, and low sections that correspond to 4’, 8’, and 16’ pipes. Each accordion-","type":"text"},{"text":" ","type":"text"},{"text":"high, accordion-middle, and accordion-low element represents the presence of one or more dots in the","type":"text"},{"text":" ","type":"text"},{"text":"registration diagram. An accordion-registration element needs to have at least one of the child elements","type":"text"},{"text":" ","type":"text"},{"text":"present.","type":"text"}],"navigatorTitle":[{"text":"MXLAccordionRegistration","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLDirection/Kind-swift.struct/Content-swift.enum":{"title":"MXLDirection.Kind.Content","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Content"}],"kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxldirection\/kind-swift.struct\/content-swift.enum","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/Kind-swift.struct\/Content-swift.enum","abstract":[{"text":"One of the alternatives for DirectionType.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"Content"}]},"doc://IvorMXL/documentation/IvorMXL/MXLDirection/Kind-swift.struct":{"title":"MXLDirection.Kind","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Kind"}],"kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxldirection\/kind-swift.struct","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/Kind-swift.struct","abstract":[{"text":"Textual direction types may have more than 1 component due to multiple fonts. The dynamics element may also be","type":"text"},{"text":" ","type":"text"},{"text":"used in the notations element. Attribute groups related to print suggestions apply to the individual","type":"text"},{"text":" ","type":"text"},{"text":"direction-type, not to the overall direction.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"Kind"}]},"doc://IvorMXL/documentation/IvorMXL/MXLDirection":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection","title":"MXLDirection","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLDirection","kind":"identifier"}],"navigatorTitle":[{"text":"MXLDirection","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxldirection","abstract":[{"text":"A direction is a musical indication that is not necessarily attached to a specific note. Two or more may be","type":"text"},{"type":"text","text":" "},{"type":"text","text":"combined to indicate words followed by the start of a dashed line, the end of a wedge followed by dynamics,"},{"type":"text","text":" "},{"type":"text","text":"etc. For applications where a specific direction is indeed attached to a specific note, the direction element"},{"type":"text","text":" "},{"type":"text","text":"can be associated with the first note element that follows it in score order that is not in a different voice."}]}}}