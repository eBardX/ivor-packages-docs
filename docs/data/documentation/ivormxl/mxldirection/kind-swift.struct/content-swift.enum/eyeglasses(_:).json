":"symbol","url":"\/documentation\/ivormxl\/mxldirection\/kind-swift.struct"},"doc://IvorMXL/documentation/IvorMXL/MXLEmptyPrintStyleAlignID":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLEmptyPrintStyleAlignID"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLEmptyPrintStyleAlignID"}],"url":"\/documentation\/ivormxl\/mxlemptyprintstylealignid","role":"symbol","title":"MXLEmptyPrintStyleAlignID","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEmptyPrintStyleAlignID","type":"topic","abstract":[{"type":"text","text":"The empty-print-style-align-id type represents an empty element with print-style-align and optional-unique-id"},{"type":"text","text":" "},{"type":"text","text":"attribute groups."}]},"doc://IvorMXL/documentation/IvorMXL/MXLDirection/Kind-swift.struct/Content-swift.enum":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Content","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/Kind-swift.struct\/Content-swift.enum","title":"MXLDirection.Kind.Content","kind":"symbol","navigatorTitle":[{"text":"Content","kind":"identifier"}],"abstract":[{"type":"text","text":"One of the alternatives for DirectionType."}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxldirection\/kind-swift.struct\/content-swift.enum"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection/Kind-swift.struct/Content-swift.enum/eyeglasses(_:)":{"role":"symbol","kind":"symbol","title":"MXLDirection.Kind.Content.eyeglasses(_:)","abstract":[{"type":"text","text":"The eyeglasses element represents the eyeglasses symbol, common in commercial music."}],"url":"\/documentation\/ivormxl\/mxldirection\/kind-swift.struct\/content-swift.enum\/eyeglasses(_:)","type":"topic","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"eyeglasses","kind":"identifier"},{"text":"(","kind":"text"},{"text":"MXLEmpt