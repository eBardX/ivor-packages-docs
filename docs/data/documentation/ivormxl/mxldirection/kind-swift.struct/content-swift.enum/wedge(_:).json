bstract":[{"text":"A direction is a musical indication that is not necessarily attached to a specific note. Two or more may be","type":"text"},{"text":" ","type":"text"},{"text":"combined to indicate words followed by the start of a dashed line, the end of a wedge followed by dynamics,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"etc. For applications where a specific direction is indeed attached to a specific note, the direction element"},{"text":" ","type":"text"},{"type":"text","text":"can be associated with the first note element that follows it in score order that is not in a different voice."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection","title":"MXLDirection","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection/Kind-swift.struct/Content-swift.enum/wedge(_:)":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/Kind-swift.struct\/Content-swift.enum\/wedge(_:)","role":"symbol","abstract":[{"text":"A crescendo or diminuendo wedge symbol.","type":"text"}],"title":"MXLDirection.Kind.Content.wedge(_:)","fragments":[{"kind":"keyword","text":"case"},{"text":" ","kind":"text"},{"text":"wedge","kind":"identifier"},{"text":"(","kind":"text"},{"text":"MXLWedge","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLWedgeV"},{"text":")","kind":"text"}],"kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxldirection\/kind-swift.struct\/content-swift.enum\/wedge(_:)"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLDirection/Kind-swift.struct/Content-swift.enum":{"role":"symbol","url":"\/documentation\/ivormxl\/mxldirection\/kind-swift.struct\/content-swift.enum","type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Content","kind":"identifier"}],"navigatorTitle":[{"text":"Content","kind":"identifier"}],"abstract":[{"type":"text","text":"One of the alternatives for DirectionType."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/Kind-swift.struct\/Content-swift.enum","title":"MXLDirection.Kind.Content","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection/Kind-swift.struct":{"role":"symbol","url":"\/documentation\/ivormxl\/mxldirection\/kind-swift.struct","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Kind","kind":"identifier"}],"navigatorTitle":[{"text":"Kind","kind":"identifier"}],"abstract":[{"type":"text","text":"Textual direction types may have more than 1 component due to multiple fonts. The dynamics element may also be"},{"type":"text","text":" "},{"type":"text","text":"used in the notations element. Attribute groups related to print suggestions apply to the individual"},{"type":"text","text":" "},{"type":"text","text":"direction-type, not to the overall direction."}],"title":"MXLDirection.Kind","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/Kind-swift.struct","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLWedge":{"title":"MXLWedge","url":"\/documentation\/ivormxl\/mxlwedge","role":"symbol","navigatorTitle":[{"text":"MXLWedge","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLWedge","abstract":[{"text":"The wedge type represents crescendo and diminuendo wedge symbols. The type attribute is crescendo for the","type":"text"},{"text":" ","type":"text"},{"text":"start of a wedge that is closed at the left side, and diminuendo for the start of a wedge that is closed on","type":"text"},{"text":" ","type":"text"},{"text":"the right side. Spread values are measured in tenths; those at the start of a crescendo wedge or end of a","type":"text"},{"text":" ","type":"text"},{"text":"diminuendo wedge are ignored. The niente attribute is yes if a circle appears at the point of the wedge,","type":"text"},{"text":" ","type":"text"},{"text":"indicating a crescendo from nothing or diminuendo to nothing. It is no by default, and used only when the type","type":"text"},{"text":" ","type":"text"},{"text":"is crescendo, or the type is stop for a wedge that began with a diminuendo type. The line-type is solid if not","type":"text"},{"text":" ","type":"text"},{"text":"specified.","type":"text"}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLWedge","kind":"identifier"}],"type":"topic"}}}