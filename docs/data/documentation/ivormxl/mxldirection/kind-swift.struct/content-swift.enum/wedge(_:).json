bol","abstract":[{"text":"A direction is a musical indication that is not necessarily attached to a specific note. Two or more may be","type":"text"},{"text":" ","type":"text"},{"text":"combined to indicate words followed by the start of a dashed line, the end of a wedge followed by dynamics,","type":"text"},{"text":" ","type":"text"},{"text":"etc. For applications where a specific direction is indeed attached to a specific note, the direction element","type":"text"},{"text":" ","type":"text"},{"text":"can be associated with the first note element that follows it in score order that is not in a different voice.","type":"text"}],"type":"topic","navigatorTitle":[{"text":"MXLDirection","kind":"identifier"}],"title":"MXLDirection"},"doc://IvorMXL/documentation/IvorMXL/MXLWedge":{"title":"MXLWedge","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLWedge","kind":"identifier"}],"navigatorTitle":[{"text":"MXLWedge","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlwedge","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLWedge","abstract":[{"text":"The wedge type represents crescendo and diminuendo wedge symbols. The type attribute is crescendo for the","type":"text"},{"text":" ","type":"text"},{"text":"start of a wedge that is closed at the left side, and diminuendo for the start of a wedge that is closed on","type":"text"},{"text":" ","type":"text"},{"text":"the right side. Spread values are measured in tenths; those at the start of a crescendo wedge or end of a","type":"text"},{"text":" ","type":"text"},{"text":"diminuendo wedge are ignored. The niente attribute is yes if a circle appears at the point of the wedge,","type":"text"},{"text":" ","type":"text"},{"text":"indicating a crescendo from nothing or diminuendo to nothing. It is no by default, and used only when the type","type":"text"},{"text":" ","type":"text"},{"text":"is crescendo, or the type is stop for a wedge that began with a diminuendo type. The line-type is solid if not","type":"text"},{"text":" ","type":"text"},{"text":"specified.","type":"text"}],"type":"topic","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection/Kind-swift.struct/Content-swift.enum":{"abstract":[{"type":"text","text":"One of the alternatives for DirectionType."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/Kind-swift.struct\/Content-swift.enum","kind":"symbol","url":"\/documentation\/ivormxl\/mxldirection\/kind-swift.struct\/content-swift.enum","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Content","kind":"identifier"}],"navigatorTitle":[{"text":"Content","kind":"identifier"}],"title":"MXLDirection.Kind.Content","role":"symbol","type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection/Kind-swift.struct/Content-swift.enum/wedge(_:)":{"type":"topic","url":"\/documentation\/ivormxl\/mxldirection\/kind-swift.struct\/content-swift.enum\/wedge(_:)","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/Kind-swift.struct\/Content-swift.enum\/wedge(_:)","title":"MXLDirection.Kind.Content.wedge(_:)","role":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"wedge"},{"kind":"text","text":"("},{"preciseIdentifier":"s:7IvorMXL8MXLWedgeV","kind":"typeIdentifier","text":"MXLWedge"},{"kind":"text","text":")"}],"abstract":[{"text":"A crescendo or diminuendo wedge symbol.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLDirection/Kind-swift.struct":{"role":"symbol","url":"\/documentation\/ivormxl\/mxldirection\/kind-swift.struct","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/Kind-swift.struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Kind","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"Textual direction types may have more than 1 component due to multiple fonts. The dynamics element may also be","type":"text"},{"text":" ","type":"text"},{"text":"used in the notations element. Attribute groups related to print suggestions apply to the individual","type":"text"},{"text":" ","type":"text"},{"text":"direction-type, not to the overall direction.","type":"text"}],"type":"topic","navigatorTitle":[{"text":"Kind","kind":"identifier"}],"title":"MXLDirection.Kind"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"}}}