ind-swift.struct\/content-swift.enum","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/Kind-swift.struct\/Content-swift.enum","abstract":[{"text":"One of the alternatives for DirectionType.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"Content"}]},"doc://IvorMXL/documentation/IvorMXL/MXLDirection":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection","title":"MXLDirection","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLDirection","kind":"identifier"}],"navigatorTitle":[{"text":"MXLDirection","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxldirection","abstract":[{"text":"A direction is a musical indication that is not necessarily attached to a specific note. Two or more may be","type":"text"},{"type":"text","text":" "},{"type":"text","text":"combined to indicate words followed by the start of a dashed line, the end of a wedge followed by dynamics,"},{"type":"text","text":" "},{"type":"text","text":"etc. For applications where a specific direction is indeed attached to a specific note, the direction element"},{"type":"text","text":" "},{"type":"text","text":"can be associated with the first note element that follows it in score order that is not in a different voice."}]},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection/Kind-swift.struct":{"title":"MXLDirection.Kind","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Kind"}],"kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxldirection\/kind-swift.struct","identifier":"doc:\/\/IvorMXL\/documentation\/