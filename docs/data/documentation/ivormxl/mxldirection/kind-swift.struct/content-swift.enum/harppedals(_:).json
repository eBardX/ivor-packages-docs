":[{"type":"text","text":"One of the alternatives for DirectionType."}],"role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Content","kind":"identifier"}],"navigatorTitle":[{"text":"Content","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxldirection\/kind-swift.struct\/content-swift.enum"},"doc://IvorMXL/documentation/IvorMXL/MXLHarpPedals":{"type":"topic","abstract":[{"type":"text","text":"The harp-pedals type is used to create harp pedal diagrams. The pedal-step and pedal-alter elements use the"},{"type":"text","text":" "},{"type":"text","text":"same values as the step and alter elements. For easiest reading, the pedal-tuning elements should follow"},{"type":"text","text":" "},{"type":"text","text":"standard harp pedal order, with pedal-step values of D, C, B, E, F, G, and A."}],"url":"\/documentation\/ivormxl\/mxlharppedals","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLHarpPedals","kind":"identifier"}],"kind":"symbol","title":"MXLHarpPedals","navigatorTitle":[{"text":"MXLHarpPedals","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarpPedals","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection/Kind-swift.struct":{"type":"topic","title":"MXLDirection.Kind","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/Kind-swift.struct","abstract":[{"type":"text","text":"Textual direction types may have more than 1 component due to multiple fonts. The dynamics element may also be"},{"type":"text","text":" "},{"type":"text","text":"used in the notations element. Attribute groups related to print suggestions apply to the individual"},{"type":"text","text":" "},{"type":"text","text":"direction-type, not to the overall direction."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Kind"}],"navigatorTitle":[{"kind":"identifier","text":"K