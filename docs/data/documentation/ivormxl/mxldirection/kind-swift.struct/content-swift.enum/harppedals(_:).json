er"}],"navigatorTitle":[{"text":"Kind","kind":"identifier"}],"abstract":[{"type":"text","text":"Textual direction types may have more than 1 component due to multiple fonts. The dynamics element may also be"},{"type":"text","text":" "},{"type":"text","text":"used in the notations element. Attribute groups related to print suggestions apply to the individual"},{"type":"text","text":" "},{"type":"text","text":"direction-type, not to the overall direction."}],"title":"MXLDirection.Kind","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/Kind-swift.struct","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLHarpPedals":{"type":"topic","title":"MXLHarpPedals","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLHarpPedals","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlharppedals","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarpPedals","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"MXLHarpPedals","kind":"identifier"}],"abstract":[{"type":"text","text":"The harp-pedals type is used to create harp pedal diagrams. The pedal-step and pedal-alter elements use the"},{"type":"text","text":" "},{"type":"text","text":"same values as the step and alter elements. For easiest reading, the pedal-tuning elements should follow"},{"type":"text","text":" "},{"type":"text","text":"standard harp pedal order, with pedal-step values of D, C, B, E, F, G, and A."}]},"doc://IvorMXL/documentation/IvorMXL/MXLDirection/Kind-swift.struct/Content-swift.enum/harpPedals(_:)":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/Kind-swift.struct\/Content-swift.enum\/harpPedals(_:)","kind":"symbol","title":"MXLDirection.Kind.Content.harpPedals(_:)","url":"\/documentation\/ivormxl\/mxldirection\/kind-swift.struct\/content-swift.enum\/harppedals(_:)","type":"topic","role":"symbol","abstract":[{"type":"text","text":"A harp pedal diagram."}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"harpPedals"},{"kind":"text","text":"("},{"preciseIdentifier":"s:7IvorMXL13MXLHarpPedalsV","kind":"typeIdentifier","text":"MXLHarpPedals"},{"kind":"text","text":")"}]},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLDirection":{"role":"symbol","url":"\/documentation\/ivormxl\/mxldirection","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLDirection","kind":"identifier"}],"navigatorTitle":[{"text":"MXLDirection","kind":"identifier"}],"abstract":[{"text":"A direction is a musical indication that is not necessarily attached to a specific note. Two or more may be","type":"text"},{"text":" ","type":"text"},{"text":"combined to indicate words followed by the start of a dashed line, the end of a wedge followed by dynamics,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"etc. For applications where a specific direction is indeed attached to a specific note, the direction element"},{"text":" ","type":"text"},{"type":"text","text":"can be associated with the first note element that follows it in score order that is not in a different voice."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection","title":"MXLDirection","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection/Kind-swift.struct/Content-swift.enum":{"role":"symbol","url":"\/documentation\/ivormxl\/mxldirection\/kind-swift.struct\/content-swift.enum","type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Content","kind":"identifier"}],"navigatorTitle":[{"text":"Content","kind":"identifier"}],"abstract":[{"type":"text","text":"One of the alternatives for Dir