ing","abstract":[{"text":"How a score-following or machine-listening application should interact with a performer, from this point in the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"performance onward."}],"title":"listening","role":"symbol","kind":"symbol","url":"\/documentation\/ivormxl\/mxldirection\/listening","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"listening","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL12MXLListeningV","text":"MXLListening","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLListening":{"title":"MXLListening","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLListening"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxllistening","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLListening"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLListening","abstract":[{"type":"text","text":"The listen and listening types, new in Version 4.0, specify different ways that a score following or machine"},{"type":"text","text":" "},{"type":"text","text":"listening application can interact with a performer. The listening type handles interactions that change the"},{"type":"text","text":" "},{"type":"text","text":"state of the listening application from the specified point in the performance onward. If multiple child"},{"type":"text","text":" "},{"type":"text","text":"elements of the same type are present, they should have distinct player and\/or time-only attributes."}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection":{"type":"topic","title":"MXLDirection","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection","abstract":[{"type":"text","text":"A direction is a musical indication that is not necessarily attached to a specific note. Two or more may be"},{"type":"text","text":" "},{"type":"text","text":"combined to indicate words followed by the start of a dashed line, the end of a wedge followed by dynamics,"},{"type":"text","text":" "},{"type":"text","text":"etc. For applications where a specific direction is indeed attached to a specific note, the direction element"},{"type":"text","text":" "},{"type":"text","text":"can be associated with the first note element that follows it in score order that is not in a different voice."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLDirection"}],"navigatorTitle":[{"kind":"identifier","text":"MXLDirection"}],"url":"\/documentation\/ivormxl\/mxldirection"}}}