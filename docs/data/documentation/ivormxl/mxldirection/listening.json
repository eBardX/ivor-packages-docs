g or machine-listening application should interact with a performer, from this"},{"type":"text","text":" "},{"type":"text","text":"point in the performance onward."}],"url":"\/documentation\/ivormxl\/mxldirection\/listening","kind":"symbol","title":"listening","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/listening","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"listening","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLListening","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL12MXLListeningV"},{"text":"?","kind":"text"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection","title":"MXLDirection","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLDirection","kind":"identifier"}],"navigatorTitle":[{"text":"MXLDirection","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxldirection","abstract":[{"text":"A direction is a musical indication that is not necessarily attached to a specific note. Two or more may be","type":"text"},{"type":"text","text":" "},{"type":"text","text":"combined to indicate words followed by the start of a dashed line, the end of a wedge followed by dynamics,"},{"type":"text","text":" "},{"type":"text","text":"etc. For applications where a specific direction is indeed attached to a specific note, the direction element"},{"type":"text","text":" "},{"type":"text","text":"can be associated with the first note element that follows it in score order that is not in a different voice."}]},"doc://IvorMXL/documentation/IvorMXL/MXLListening":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLListening","title":"MXLListening","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLListening","kind":"identifier"}],"navigatorTitle":[{"text":"MXLListening","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxllistening","abstract":[{"text":"The listen and listening types, new in Version 4.0, specify different ways that a score following or machine","type":"text"},{"text":" ","type":"text"},{"text":"listening application can interact with a performer. The listening type handles interactions that change the","type":"text"},{"text":" ","type":"text"},{"text":"state of the listening application from the specified point in the performance onward. If multiple child","type":"text"},{"text":" ","type":"text"},{"text":"elements of the same type are present, they should have distinct player and\/or time-only attributes.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"}}}