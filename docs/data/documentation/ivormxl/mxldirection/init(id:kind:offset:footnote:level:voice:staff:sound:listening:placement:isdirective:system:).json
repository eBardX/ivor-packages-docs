\/MXLDirection\/init(id:kind:offset:footnote:level:voice:staff:sound:listening:placement:isDirective:system:)"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection":{"role":"symbol","url":"\/documentation\/ivormxl\/mxldirection","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLDirection","kind":"identifier"}],"navigatorTitle":[{"text":"MXLDirection","kind":"identifier"}],"abstract":[{"text":"A direction is a musical indication that is not necessarily attached to a specific note. Two or more may be","type":"text"},{"text":" ","type":"text"},{"text":"combined to indicate words followed by the start of a dashed line, the end of a wedge followed by dynamics,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"etc. For applications where a specific direction is indeed attached to a specific note, the direction element"},{"text":" ","type":"text"},{"type":"text","text":"can be associated with the first note element that follows it in score order that is not in a different voice."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection","title":"MXLDirection","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLOffset":{"role":"symbol","url":"\/documentation\/ivormxl\/mxloffset","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLOffset","kind":"identifier"}],"navigatorTitle":[{"text":"MXLOffset","kind":"identifier"}],"abstract":[{"type":"text","text":"An offset is represented in terms of divisions, and indicates where the direction will appear relative to the"},{"type":"text","text":" "},{"type":"text","text":"current musical location. The current musical location is always within the current measure, even at the end"},{"type":"text","text":" "},{"type":"text","text":"of a measure."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOffset","title":"MXLOffset","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLSystemRelation":{"url":"\/documentation\/ivormxl\/mxlsystemrelation","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemRelation","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLSystemRelation"}],"title":"MXLSystemRelation","abstract":[{"text":"The system-relation type distinguishes elements that are associated with a system rather than the particular","type":"text"},{"text":" ","type":"text"},{"text":"part where the element appears. A value of only-top indicates that the element should appear only on the top","type":"text"},{"text":" ","type":"text"},{"text":"part of the current system. A value of also-top indicates that the element should appear on both the current","type":"text"},{"text":" ","type":"text"},{"text":"part and the top part of the current system. If this value appears in a score, when parts are created the","type":"text"},{"text":" ","type":"text"},{"text":"element should only appear once in this part, not twice. A value of none indicates that the element is","type":"text"},{"text":" ","type":"text"},{"text":"associated only with the current part, not with the system.","type":"text"}],"type":"topic","fragments":[{"kind":"keyword","text":"enum"},{"text":" ","kind":"text"},{"kind":"identifier","text":"MXLSystemRelation"}]},"doc://IvorMXL/documentation/IvorMXL/MXLLevel":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxllevel","title":"MXLLevel","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLLevel"}],"navigatorTitle":[{"kind":"identifier","text":"MXLLevel"}],"abstract":[{"text":"The level type is used to specify editorial information for different MusicXML elements. The content contains","type":"text"},{"text":" ","type":"text"},{"text":"identifying and\/or descriptive text about the editorial status of the parent element.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLevel"},"doc://IvorMXL/documentation/IvorMXL/MXLListening":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxllistening","title":"MXLListening","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLListening","kind":"identifier"}],"navigatorTitle":[{"text":"MXLListening","kind":"identifier"}],"abstract":[{"type":"text","text":"The listen and listening types, new in Version 4.0, specify different ways that a score following or machine"},{"type":"text","text":" "},{"type":"text","text":"listening application can interact with a performer. The listening type handles interactions that change the"},{"type":"text","text":" "},{"type":"text","text":"state of the listening application from the specified point in the performance onward. If multiple child"},{"type":"text","text":" "},{"type":"text","text":"elements of the same type are present, they should have distinct player and\/or time-only attributes."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLListening"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLVoice":{"abstract":[{"text":"A voice is a sequence of musical events (e.g. notes, chords, rests) that proceeds linearly in time. The voice","type":"text"},{"text":" ","type":"text"},{"text":"element is used to distinguish between multiple voices in individual parts. It is defined within a group due","type":"text"},{"text":" ","type":"text"},{"text":"to its multiple uses within the MusicXML schema.","type":"text"}],"navigatorTitle":[{"text":"MXLVoice","kind":"identifier"}],"type":"topic","title":"MXLVoice","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLVoice","kind":"identifier"}],"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlvoice","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLVoice"}}}