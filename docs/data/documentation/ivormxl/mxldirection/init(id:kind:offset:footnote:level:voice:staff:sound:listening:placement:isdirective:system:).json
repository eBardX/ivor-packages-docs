"name":"kind","content":[{"inlineContent":[{"text":"The direction-type elements that make up this direction.","type":"text"}],"type":"paragraph"}]},{"name":"offset","content":[{"inlineContent":[{"text":"Indicates where the direction will appear relative to the current musical location, in","type":"text"},{"text":" ","type":"text"},{"text":"divisions.","type":"text"}],"type":"paragraph"}]},{"name":"footnote","content":[{"inlineContent":[{"text":"The footnote element specifies editorial information that appears in footnotes in the","type":"text"},{"text":" ","type":"text"},{"text":"printed score. It is defined within a group due to its multiple uses within the","type":"text"},{"text":" ","type":"text"},{"text":"MusicXML schema.","type":"text"}],"type":"paragraph"}]},{"name":"level","content":[{"inlineContent":[{"text":"The level element specifies editorial information for different MusicXML elements. It","type":"text"},{"text":" ","type":"text"},{"text":"is defined within a group due to its multiple uses within the MusicXML schema.","type":"text"}],"type":"paragraph"}]},{"name":"voice","content":[{"inlineContent":[{"text":"A voice is a sequence of musical events (e.g. notes, chords, rests) that proceeds","type":"text"},{"text":" ","type":"text"},{"text":"linearly in time. The voice element is used to distinguish between multiple voices in","type":"text"},{"text":" ","type":"text"},{"text":"individual parts. It is defined within a group due to its multiple uses within the","type":"text"},{"text":" ","type":"text"},{"text":"MusicXML schema.","type":"text"}],"type":"paragraph"}]},{"name":"staff","content":[{"inlineContent":[{"text":"The staff element is defined within a group due to its use by both notes and direction","type":"text"},{"text":" ","type":"text"},{"text":"elements.","type":"text"}],"type":"paragraph"}]},{"name":"sound","content":[{"inlineContent":[{"text":"General playback parameters associated with this direction.","type":"text"}],"type":"paragraph"}]},{"name":"listening","content":[{"inlineContent":[{"text":"Specifies how a score-following or machine-listening application should interact with","type":"text"},{"text":" ","type":"text"},{"text":"a performer, from this point in the performance onward.","type":"text"}],"type":"paragraph"}]},{"name":"placement","content":[{"inlineContent":[{"text":"The placement attribute indicates whether something is above or below another element,","type":"text"},{"text":" ","type":"text"},{"text":"such as a note or a notation.","type":"text"}],"type":"paragraph"}]},{"name":"isDirective","content":[{"inlineContent":[{"text":"A Boolean value indicating whether this direction is a directive, changing its default","type":"text"},{"text":" ","type":"text"},{"text":"horizontal position so its left-hand side aligns with the left-hand side of the time","type":"text"},{"text":" ","type":"text"},{"text":"signature (or, if no time signature is present, the first music notational element in","type":"text"},{"text":" ","type":"text"},{"text":"the measure). A default-x, justify, or halign attribute, if present, overrides this.","type":"text"}],"type":"paragraph"}]},{"name":"system","content":[{"inlineContent":[{"text":"The system-relation attribute group distinguishes elements that are associated with a","type":"text"},{"text":" ","type":"text"},{"text":"system rather than the particular part where the element appears.","type":"text"}],"type":"paragraph"}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxldirection\/init(id:kind:offset:footnote:level:voice:staff:sound:listening:placement:isdirective:system:)"]}],"metadata":{"symbolKind":"init","roleHeading":"Initializer","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"id"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"kind"},{"kind"