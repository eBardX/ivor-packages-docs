kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL12MXLListeningV"},{"text":"?, ","kind":"text"},{"text":"placement","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLAboveBelow","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL13MXLAboveBelowO"},{"text":"?, ","kind":"text"},{"text":"isDirective","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":"?, ","kind":"text"},{"text":"system","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL17MXLSystemRelationO","text":"MXLSystemRelation","kind":"typeIdentifier"},{"text":"?)","kind":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLAboveBelow":{"type":"topic","title":"MXLAboveBelow","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAboveBelow","abstract":[{"type":"text","text":"The above-below type is used to indicate whether one element appears above or below another element."}],"role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLAboveBelow"}],"navigatorTitle":[{"kind":"identifier","text":"MXLAboveBelow"}],"url":"\/documentation\/ivormxl\/mxlabovebelow"},"doc://IvorMXL/documentation/IvorMXL/MXLSystemRelation":{"role":"symbol","kind":"symbol","type":"topic","abstract":[{"text":"The system-relation type distinguishes elements that are associated with a system rather than the particular","type":"text"},{"text":" ","type":"text"},{"text":"part where the element appears. A value of only-top indicates that the element should appear only on the top","type":"text"},{"text":" ","type":"text"},{"text":"part of the current system. A value of also-top indicates that the element should appear on both the current","type":"text"},{"text":" ","type":"text"},{"text":"part and the top part of the current system. If this value appears in a score, when parts are created the","type":"text"},{"text":" ","type":"text"},{"text":"element should only appear once in this part, not twice. A value of none indicates that the element is","type":"text"},{"text":" ","type":"text"},{"text":"associated only with the current part, not with the system.","type":"text"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLSystemRelation"}],"navigatorTitle":[{"kind":"identifier","text":"MXLSystemRelation"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemRelation","title":"MXLSystemRelation","url":"\/documentation\/ivormxl\/mxlsystemrelation"},"doc://IvorMXL/documentation/IvorMXL/MXLListening":{"title":"MXLListening","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLListening"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxllistening","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLListening"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLListening","abstract":[{"type":"text","text":"The listen and listening types, new in Version 4.0, specify different ways that a score following or machine"},{"type":"text","text":" "},{"type":"text","text":"listening application can interact with a performer. The listening type handles interactions that change the"},{"type":"text","text":" "},{"type":"text","text":"state of the listening application from the specified point in the performance onward. If multiple child"},{"type":"text","text":" "},{"type":"text","text":"elements of the same type are present, they should have distinct player and\/or time-only attributes."}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLSound":{"type":"topic","title":"MXLSound","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound","abstract":[{"type":"text","text":"The sound element contains general playback parameters. They can stand alone within a part\/measure, or be a"},{"type":"text","text":" "},{"type":"text","text":"component element within a direction."}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSound","kind":"identifier"}],"navigatorTitle":[{"text":"MXLSound","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlsound"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection":{"type":"topic","title":"MXLDirection","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection","abstract":[{"type":"text","text":"A direction is a musical indication that is not necessarily attached to a specific note. Two or more may be"},{"type":"text","text":" "},{"type":"text","text":"combined to indicate words followed by the start of a dashed line, the end of a wedge followed by dynamics,"},{"type":"text","text":" "},{"type":"text","text":"etc. For applications where a specific direction is indeed attached to a specific note, the direction element"},{"type":"text","text":" "},{"type":"text","text":"can be associated with the first note element that follows it in score order that is not in a different voice."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLDirection"}],"navigatorTitle":[{"kind":"identifier","text":"MXLDirection"}],"url":"\/documentation\/ivormxl\/mxldirection"},"doc://IvorMXL/documentation/IvorMXL/MXLVoice":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLVoice","role":"symbol","navigatorTitle":[{"text":"MXLVoice","kind":"identifier"}],"title":"MXLVoice","kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxlvoice","abstract":[{"type":"text","text":"A voice is a sequence of musical events (e.g. notes, chords, rests) that proceeds linearly in time. The voice"},{"type":"text","text":" "},{"type":"text","text":"element is used to distinguish between multiple voices in individual parts. It is defined within a group due"},{"type":"text","text":" "},{"type":"text","text":"to its multiple uses within the MusicXML schema."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLVoice","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLStaff":{"type":"topic","abstract":[{"type":"text","text":"The staff element is defined within a group due to its use by both notes and direction elements."}],"url":"\/documentation\/ivormxl\/mxlstaff","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLStaff"}],"kind":"symbol","title":"MXLStaff","navigatorTitle":[{"kind":"identifier","text":"MXLStaff"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaff","role":"symbol"}}}