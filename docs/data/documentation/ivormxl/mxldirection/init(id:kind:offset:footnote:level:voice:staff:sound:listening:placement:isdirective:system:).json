ragraph"}]},{"name":"offset","content":[{"inlineContent":[{"type":"text","text":"Indicates where the direction will appear relative to the current musical location, in divisions."}],"type":"paragraph"}]},{"name":"footnote","content":[{"inlineContent":[{"type":"text","text":"The footnote element specifies editorial information that appears in footnotes in the printed score. It is defined within a group due to its multiple uses within the MusicXML schema."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The level element specifies editorial information for different MusicXML elements. It is defined within a group due to its multiple uses within the MusicXML schema."}],"type":"paragraph"}],"name":"level"},{"name":"voice","content":[{"type":"paragraph","inlineContent":[{"text":"A voice is a sequence of musical events (e.g. notes, chords, rests) that proceeds linearly in time. The voice element is used to distinguish between multiple voices in individual parts. It is defined within a group due to its multiple uses within the MusicXML schema.","type":"text"}]}]},{"name":"staff","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The staff element is defined within a group due to its use by both notes and direction elements."}]}]},{"name":"sound","content":[{"type":"paragraph","inlineContent":[{"text":"General playback parameters associated with this direction.","type":"text"}]}]},{"name":"listening","content":[{"type":"paragraph","inlineContent":[{"text":"Specifies how a score-following or machine-listening application should interact with a performer, from this point in the performance onward.","type":"text"}]}]},{"name":"placement","content":[{"type":"paragraph","inlineContent":[{"text":"The placement attribute indicates whether something is above or below another element, such as a note or a notation.","type":"text"}]}]},{"name":"isDirective","content":[{"type":"paragraph","inlineContent":[{"text":"A Boolean value indicating whether this direction is a directive, changing its default horizontal position so its left-hand side aligns with the left-hand side of the time signature (or, if no time signature is present, the first music notational element in the measure). A default-x, justify, or halign attribute, if present, overrides this.","type":"text"}]}]},{"name":"system","content":[{"type":"paragraph","inlineContent":[{"text":"The system-relation attribute group distinguishes elements that are associated with a system rather than the particular part where the element appears.","type":"text"}]}]}],"kind":"parameters"}],"variants":[{"paths":["\/documentation\/ivormxl\/mxldirection\/init(id:kind:offset:footnote:level:voice:staff:sound:listening:placement:isdirective:system:)"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/init(id:kind:offset:footnote:level:voice:staff:sound:listening:placement:isDirective:system:)","interfaceLanguage":"swift"},"metadata":{"roleHeading":"Initializer","symbolKind":"init","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"id"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"kind"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"Kind","preciseIdentifier":"s:7IvorMXL12MXLDirectionV4KindV"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"offset"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLOffset","preciseIdentifier":"s:7IvorMXL9MXLOffsetV"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"footnote"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLFormattedText","preciseIdentifier":"s:7IvorMXL16MXLFormattedTextV"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"level"},{"kind":"text","text":": "},{"kind":"typeIdentifier","