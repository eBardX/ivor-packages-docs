ier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFormattedText","preciseIdentifier":"s:7IvorMXL16MXLFormattedTextV","text":"MXLFormattedText"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"level"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLevel","preciseIdentifier":"s:7IvorMXL8MXLLevelV","text":"MXLLevel"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"voice"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLVoice","preciseIdentifier":"s:7IvorMXL8MXLVoiceV","text":"MXLVoice"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"staff"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaff","preciseIdentifier":"s:7IvorMXL8MXLStaffV","text":"MXLStaff"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"sound"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound","preciseIdentifier":"s:7IvorMXL8MXLSoundV","text":"MXLSound"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"listening"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL12MXLListeningV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLListening","text":"MXLListening","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"placement","kind":"externalParam"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAboveBelow","preciseIdentifier":"s:7IvorMXL13MXLAboveBelowO","text":"MXLAboveBelow"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"isDirective"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":"? = nil, ","kind":"text"},{"text":"system","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL17MXLSystemRelationO","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemRelation","text":"MXLSystemRelation","kind":"typeIdentifier"},{"text":"? = nil)","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The optional-unique-id attribute group allows an element to optionally specify an ID that is unique to the entire document. This attribute group is not used for a required id attribute, or for an id attribute that specifies an id reference."}]}],"name":"id"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The direction-type elements that make up this direction.","type":"text"}]}],"name":"kind"},{"name":"offset","content":[{"inlineContent":[{"type":"text","text":"Indicates where the direction will appear relative to the current musical location, in divisions."}],"type":"paragraph"}]},{"name":"footnote","content":[{"inlineContent":[{"type":"text","text":"The footnote element specifies editorial information that appears in footnotes in the printed score. It is defined within a group due to its multiple uses within the MusicXML schema."}],"type":"paragraph"}]},{"name":"level","content":[{"inlineContent":[{"type":"text","text":"The level element specifies editorial information for different MusicXML elements. It is defined within a group due to its multiple uses within the MusicXML schema."}],"type":"paragraph"}]},{"name":"voice","content":[{"inlineContent":[{"type":"text","text":"A voice is a sequence of musical events (e.g. notes, chords, rests) that proceeds linearly in time. The voice element is used to distinguish between multiple voices in individual parts. It is defined within a group due to its multiple uses within the MusicXML schema."}],"type":"paragraph"}]},{"name":"staff","content":[{"inlineContent":[{"text":"The staff element is defined within a group due to its use by both notes and direction elements.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"General playback parameters associated with this direction.","type":"text"}]}],"name":"sound"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Specifies how a score-following or machine-listening application should interact with a performer, from this point in the performance onward.","type":"text"}]}],"name":"listening"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The placement attribute indicates whether something is above or below another element, such as a note or a notation.","type":"text"}]}],"name":"placement"},{"content":[{"type":"paragraph","inlineContent":[{"text":"A Boolean value indicating whether this direction is a directive, changing its default horizontal position so its left-hand side aligns with the left-hand side of the time signature (or, if no time signature is present, the first music notational element in the measure). A default-x, justify, or halign attribute, if present, overrides this.","type":"text"}]}],"name":"isDirective"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The system-relation attribute group distinguishes elements that are associated with a system rather than the particular part where the element appears.","type":"text"}]}],"name":"system"}]}],"abstract":[{"type":"text","text":"Creates a new "},{"code":"MXLDirection","type":"codeVoice"},{"type":"text","text":"."}],"variants":[{"paths":["\/documentation\/ivormxl\/mxldirection\/init(id:kind:offset:footnote:level:voice:staff:sound:listening:placement:isdirective:system:)"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection"]]},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLSystemRelation":{"title":"MXLSystemRelation","kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSystemRelation","kind":"identifier"}],"abstract":[{"text":"The system-relation type distinguishes elements that are associated with a system rather than the particular","type":"text"},{"text":" ","type":"text"},{"text":"part where the element appears. A value of only-top indicates that the element should appear only on the top","type":"text"},{"text":" ","type":"text"},{"text":"part of the current system. A value of also-top indicates that the element should appear on both the current","type":"text"},{"text":" ","type":"text"},{"text":"part and the top part of the current system. If this value appears in a score, when parts are created the","type":"text"},{"text":" ","type":"text"},{"text":"element should only appear once in this part, not twice. A value of none indicates that the element is","type":"text"},{"text":" ","type":"text"},{"text":"associated only with the current part, not with the system.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemRelation","role":"symbol","navigatorTitle":[{"text":"MXLSystemRelation","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlsystemrelation"},"doc://IvorMXL/documentation/IvorMXL/MXLLevel":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLLevel","kind":"identifier"}],"navigatorTitle":[{"text":"MXLLevel","kind":"identifier"}],"title":"MXLLevel","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLevel","kind":"symbol","url":"\/documentation\/ivormxl\/mxllevel","type":"topic","abstract":[{"type":"text","text":"The level type is used to specify editorial information for different MusicXML elements. The content contains"},{"type":"text","text":" "},{"type":"text","text":"identifying and\/or descriptive text about the editorial status of the parent element."}]},"doc://IvorMXL/documentation/IvorMXL/MXLDirection/init(id:kind:offset:footnote:level:voice:staff:sound:listening:placement:isDirective:system:)":{"type":"topic","url":"\/documentation\/ivormxl\/mxldirection\/init(id:kind:offset:footnote:level:voice:staff:sound:listening:placement:isdirective:system:)","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/init(id:kind:offset:footnote:level:voice:staff:sound:listening:placement:isDirective:system:)","title":"init(id:kind:offset:footnote:level:voice:staff:sound:listening:placement:isDirective:system:)","role":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"kind","kind":"externalParam"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:7IvorMXL12MXLDirectionV4KindV","text":"Kind","kind":"typeIdentifier"},{"text":"], ","kind":"text"},{"text":"offset","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL9MXLOffsetV","text":"MXLOffset","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"footnote","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL16MXLFormattedTextV","text":"MXLFormattedText","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"level","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL8MXLLevelV","text":"MXLLevel","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"voice","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL8MXLVoiceV","text":"MXLVoice","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"staff","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL8MXLStaffV","text":"MXLStaff","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"sound","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL8MXLSoundV","text":"MXLSound","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"listening","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL12MXLListeningV","text":"MXLListening","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"placement","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL13MXLAboveBelowO","text":"MXLAboveBelow","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"isDirective","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"system","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLSystemRelation","preciseIdentifier":"s:7IvorMXL17MXLSystemRelationO","kind":"typeIdentifier"},{"text":"?)","kind":"text"}],"abstract":[{"text":"Creates a new ","type":"text"},{"code":"MXLDirection","type":"codeVoice"},{"text":".","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLDirection":{"role":"symbol","url":"\/documentation\/ivormxl\/mxldirection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLDirection","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"A direction is a musical indication that is not necessarily attached to a specific note. Two or more may be","type":"text"},{"text":" ","type":"text"},{"text":"combined to indicate words followed by the start of a dashed line, the end of a wedge followed by dynamics,","type":"text"},{"text":" ","type":"text"},{"text":"etc. For applications where a specific direction is indeed attached to a specific note, the direction element","type":"text"},{"text":" ","type":"text"},{"text":"can be associated with the first note element that follows it in score order that is not in a different voice.","type":"text"}],"type":"topic","navigatorTitle":[{"text":"MXLDirection","kind":"identifier"}],"title":"MXLDirection"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLListening":{"url":"\/documentation\/ivormxl\/mxllistening","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLListening","title":"MXLListening","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The listen and listening types, new in Version 4.0, specify different ways that a score following or machine"},{"type":"text","text":" "},{"type":"text","text":"listening application can interact with a performer. The listening type handles interactions that change the"},{"type":"text","text":" "},{"type":"text","text":"state of the listening application from the specified point in the performance onward. If multiple child"},{"type":"text","text":" "},{"type":"text","text":"elements of the same type are present, they should have distinct player and\/or time-only attributes."}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLListening","kind":"identifier"}],"navigatorTitle":[{"text":"MXLListening","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLOffset":{"role":"symbol","url":"\/documentation\/ivormxl\/mxloffset","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOffset","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLOffset"}],"abstract":[{"text":"An offset is represented in terms of divisions, and indicates where the direction will appear relative to the","type":"text"},{"text":" ","type":"text"},{"text":"current musical location. The current musical location is always within the current measure, even at the end","type":"text"},{"text":" ","type":"text"},{"text":"of a measure.","type":"text"}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLOffset"}],"title":"MXLOffset"},"doc://IvorMXL/documentation/IvorMXL/MXLAboveBelow":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlabovebelow","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAboveBelow","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLAboveBelow"}],"kind":"symbol","abstract":[{"text":"The above-below type is used to indicate whether one element appears above or below another element.","type":"text"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLAboveBelow"}],"title":"MXLAboveBelow"},"doc://IvorMXL/documentation/IvorMXL/MXLSound":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlsound","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLSound"}],"abstract":[{"type":"text","text":"The sound element contains general playback parameters. They can stand alone within a part\/measure, or be a"},{"type":"text","text":" "},{"type":"text","text":"component element within a direction."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLSound"}],"title":"MXLSound"},"doc://IvorMXL/documentation/IvorMXL/MXLVoice":{"navigatorTitle":[{"text":"MXLVoice","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlvoice","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLVoice","title":"MXLVoice","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLVoice","kind":"identifier"}],"abstract":[{"type":"text","text":"A voice is a sequence of musical events (e.g. notes, chords, rests) that proceeds linearly in time. The voice"},{"type":"text","text":" "},{"type":"text","text":"element is used to distinguish between multiple voices in individual parts. It is defined within a group due"},{"type":"text","text":" "},{"type":"text","text":"to its multiple uses within the MusicXML schema."}]},"doc://IvorMXL/documentation/IvorMXL/MXLDirection/Kind-swift.struct":{"role":"symbol","url":"\/documentation\/ivormxl\/mxldirection\/kind-swift.struct","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/Kind-swift.struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Kind","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"Textual direction types may have more than 1 component due to multiple fonts. The dynamics element may also be","type":"text"},{"text":" ","type":"text"},{"text":"used in the notations element. Attribute groups related to print suggestions apply to the individual","type":"text"},{"text":" ","type":"text"},{"text":"direction-type, not to the overall direction.","type":"text"}],"type":"topic","navigatorTitle":[{"text":"Kind","kind":"identifier"}],"title":"MXLDirection.Kind"},"doc://IvorMXL/documentation/IvorMXL/MXLFormattedText":{"type":"topic","abstract":[{"type":"text","text":"The formatted-text type represents a text element with text-formatting attributes."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"MXLFormattedText","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLFormattedText"}],"title":"MXLFormattedText","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFormattedText","url":"\/documentation\/ivormxl\/mxlformattedtext","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLStaff":{"role":"symbol","navigatorTitle":[{"text":"MXLStaff","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLStaff","kind":"identifier"}],"kind":"symbol","title":"MXLStaff","url":"\/documentation\/ivormxl\/mxlstaff","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaff","abstract":[{"text":"The staff element is defined within a group due to its use by both notes and direction elements.","type":"text"}]}}}