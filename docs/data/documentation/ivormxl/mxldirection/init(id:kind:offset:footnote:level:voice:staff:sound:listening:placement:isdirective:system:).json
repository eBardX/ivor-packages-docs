ext":"The optional-unique-id attribute group allows an element to optionally specify an ID that is unique to the entire document. This attribute group is not used for a required id attribute, or for an id attribute that specifies an id reference.","type":"text"}]}],"name":"id"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The direction-type elements that make up this direction.","type":"text"}]}],"name":"kind"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Indicates where the direction will appear relative to the current musical location, in divisions.","type":"text"}]}],"name":"offset"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The footnote element specifies editorial information that appears in footnotes in the printed score. It is defined within a group due to its multiple uses within the MusicXML schema.","type":"text"}]}],"name":"footnote"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The level element specifies editorial information for different MusicXML elements. It is defined within a group due to its multiple uses within the MusicXML schema.","type":"text"}]}],"name":"level"},{"content":[{"type":"paragraph","inlineContent":[{"text":"A voice is a sequence of musical events (e.g. notes, chords, rests) that proceeds linearly in time. The voice element is used to distinguish between multiple voices in individual parts. It is defined within a group due to its multiple uses within the MusicXML schema.","type":"text"}]}],"name":"voice"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The staff element is defined within a group due to its use by both notes and direction elements.","type":"text"}]}],"name":"staff"},{"content":[{"type":"paragraph","inlineContent":[{"text":"General playback parameters associated with this direction.","type":"text"}]}],"name":"sound"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Specifies how a score-following or machine-listening application should interact with a performer, from this point in the performance onward.","type":"text"}]}],"name":"listening"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The placement attribute indicates whether something is above or below another element, such as a note or a notation.","type":"text"}]}],"name":"placement"},{"content":[{"type":"paragraph","inlineContent":[{"text":"A Boolean value indicating whether this direction is a directive, changing its default horizontal position so its left-hand side aligns with the left-hand side of the time signature (or, if no time signature is present, the first music notational element in the measure). A default-x, justify, or halign attribute, if present, overrides this.","type":"text"}]}],"name":"isDirective"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The system-relation attribute group distinguishes elements that are associated with a system rather than the particular part where the element appears.","type":"text"}]}],"name":"system"}],"kind":"parameters"}],"metadata":{"modules":[{"name":"IvorMXL"}],"roleHeading":"Initializer","title":"init(id:kind:offset:footnote:level:voice:staff:sound:listening:placement:isDirective:system:)","symbolKind":"init","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"kind","kind":"externalParam"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:7IvorMXL12MXLDirectionV4KindV","text":"Kind","kind":"typeIdentifier"},{"text":"], ","kind":"text"},{"text":"offset","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL9MXLOffsetV","text":"MXLOffset","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"footnote","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL16MXLFormattedTextV","text":"MXLFormattedText","kind":"typeI