et","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection/Kind-swift.struct":{"title":"MXLDirection.Kind","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Kind"}],"kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxldirection\/kind-swift.struct","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection\/Kind-swift.struct","abstract":[{"text":"Textual direction types may have more than 1 component due to multiple fonts. The dynamics element may also be","type":"text"},{"text":" ","type":"text"},{"text":"used in the notations element. Attribute groups related to print suggestions apply to the individual","type":"text"},{"text":" ","type":"text"},{"text":"direction-type, not to the overall direction.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"Kind"}]},"doc://IvorMXL/documentation/IvorMXL/MXLStaff":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaff","title":"MXLStaff","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLStaff","kind":"identifier"}],"navigatorTitle":[{"text":"MXLStaff","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlstaff","abstract":[{"text":"The staff element is defined within a group due to its use by both notes and direction elements.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLListening":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLListening","title":"MXLListening","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLListening","kind":"identifier"}],"navigatorTitle":[{"text":"MXLListening","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxllistening","abstract":[{"text":"The listen and listening types, new in Version 4.0, specify different ways that a score following or machine","type":"text"},{"text":" ","type":"text"},{"text":"listening application can interact with a performer. The listening type handles interactions that change the","type":"text"},{"text":" ","type":"text"},{"text":"state of the listening application from the specified point in the performance onward. If multiple child","type":"text"},{"text":" ","type":"text"},{"text":"elements of the same type are present, they should have distinct player and\/or time-only attributes.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLSystemRelation":{"abstract":[{"text":"The system-relation type distinguishes elements that are associated with a system rather than the particular","type":"text"},{"text":" ","type":"text"},{"text":"part where the element appears. A value of only-top indicates that the element should appear only on the top","type":"text"},{"text":" ","type":"text"},{"text":"part of the current system. A value of also-top indicates that the element should appear on both the current","type":"text"},{"text":" ","type":"text"},{"text":"part and the top part of the current system. If this value appears in a score, when parts are created the","type":"text"},{"text":" ","type":"text"},{"text":"element should only appear once in this part, not twice. A value of none indicates that the element is","type":"text"},{"text":" ","type":"text"},{"text":"associated only with the current part, not with the system.","type":"text"}],"title":"MXLSystemRelation","kind":"symbol","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSystemRelation","kind":"identifier"}],"navigatorTitle":[{"text":"MXLSystemRelation","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlsystemrelation","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemRelation"},"doc://IvorMXL/documentation/IvorMXL/MXLVoice":{"title":"MXLVoice","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLVoice","kind":"identifier"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlvoice","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLVoice","abstract":[{"type":"text","text":"A voice is a sequence of musical events (e.g. notes, chords, rests) that proceeds linearly in time. The voice"},{"type":"text","text":" "},{"type":"text","text":"element is used to distinguish between multiple voices in individual parts. It is defined within a group due"},{"type":"text","text":" "},{"type":"text","text":"to its multiple uses within the MusicXML schema."}],"navigatorTitle":[{"text":"MXLVoice","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLSound":{"abstract":[{"text":"The sound element contains general playback parameters. They can stand alone within a part\/measure, or be a","type":"text"},{"text":" ","type":"text"},{"text":"component element within a direction.","type":"text"}],"title":"MXLSound","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLSound"}],"navigatorTitle":[{"kind":"identifier","text":"MXLSound"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlsound","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound"},"doc://IvorMXL/documentation/IvorMXL/MXLFormattedText":{"navigatorTitle":[{"text":"MXLFormattedText","kind":"identifier"}],"abstract":[{"type":"text","text":"The formatted-text type represents a text element with text-formatting attributes."}],"title":"MXLFormattedText","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFormattedText","kind":"symbol","url":"\/documentation\/ivormxl\/mxlformattedtext","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLFormattedText","kind":"identifier"}],"role":"symbol"}}}