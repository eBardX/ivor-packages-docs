ecify an ID","type":"text"},{"text":" ","type":"text"},{"text":"that is unique to the entire document. This attribute group is not used for a required","type":"text"},{"text":" ","type":"text"},{"text":"id attribute, or for an id attribute that specifies an id reference.","type":"text"}],"type":"paragraph"}],"name":"id"},{"content":[{"inlineContent":[{"text":"Whether this is the start, stop, or continuation of the bracket.","type":"text"}],"type":"paragraph"}],"name":"kind"},{"content":[{"inlineContent":[{"text":"Distinguishes this bracket from other brackets that might be active at the same time.","type":"text"}],"type":"paragraph"}],"name":"number"},{"content":[{"inlineContent":[{"text":"Specifies if there is a jog up or down (or both), an arrow, or nothing at the start or","type":"text"},{"text":" ","type":"text"},{"text":"end of the bracket.","type":"text"}],"type":"paragraph"}],"name":"lineEnd"},{"content":[{"inlineContent":[{"text":"The length of the jog, if the line-end is up or down.","type":"text"}],"type":"paragraph"}],"name":"endLength"},{"content":[{"inlineContent":[{"text":"The line-type attribute distinguishes between solid, dashed, dotted, and wavy lines.","type":"text"}],"type":"paragraph"}],"name":"lineKind"},{"content":[{"inlineContent":[{"text":"The length, in tenths, of the dashes in a dashed line. Ignored if the corresponding","type":"text"},{"text":" ","type":"text"},{"text":"line-type attribute is not dashed.","type":"text"}],"type":"paragraph"}],"name":"dashLength"},{"content":[{"inlineContent":[{"text":"The length, in tenths, of the spaces in a dashed line. Ignored if the corresponding","type":"text"},{"text":" ","type":"text"},{"text":"line-type attribute is not dashed.","type":"text"}],"type":"paragraph"}],"name":"spaceLength"},{"content":[{"inlineContent":[{"text":"For most elements, any program will compute a default x and y position. The position","type":"text"},{"text":" ","type":"text"},{"text":"attributes let this be changed two ways.","type":"text"}],"type":"paragraph"}],"name":"position"},{"content":[{"inlineContent":[{"text":"The color attribute group indicates the color of an element.","type":"text"}],"type":"paragraph"}],"name":"color"}],"kind":"parameters"}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLPosition":{"type":"topic","abstract":[{"type":"text","text":"For most elements, any program will compute a default x and y position. The position attributes let this be"},{"type":"text","text":" "},{"type":"text","text":"changed two ways."}],"url":"\/documentation\/ivormxl\/mxlposition","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPosition"}],"kind":"symbol","title":"MXLPosition","navigatorTitle":[{"kind":"identifier","text":"MXLPosition"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLStartStopContinue":{"type":"topic","abstract":[{"type":"text","text":"The start-stop-continue type is used for an attribute of musical elements that can either start or stop, but"},{"type":"text","text":" "},{"type":"text","text":"also need to refer to an intermediate point in the symbol, as for complex slurs or for formatting of symbols"},{"type":"text","text":" "},{"type":"text","text":"across system breaks."}],"url":"\/documentation\/ivormxl\/mxlstartstopcontinue","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLStartStopContinue"}],"kind":"symbol","title":"MXLStartStopContinue","navigatorTitle":[{"text":"MXLStartStopContinue","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStartStopContinue","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"type":"topic","abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"type":"text","text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is"},{"type":"text","text":" "},{"type":"text","text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF."}],"url":"\/documentation\/ivormxl\/mxlcolor","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"kind":"symbol","title":"MXLColor","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLBracket/init(id:kind:number:lineEnd:endLength:lineKind:dashLength:spaceLength:position:color:)":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBracket\/init(id:kind:number:lineEnd:endLength:lineKind:dashLength:spaceLength:position:color:)","url":"\/documentation\/ivormxl\/mxlbracket\/init(id:kind:number:lineend:endlength:linekind:dashlength:spacelength:position:color:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?, ","kind":"text"},{"text":"kind","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLStartStopContinue","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL20MXLStartStopContinueO"},{"text":", ","kind":"text"},{"text":"number","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLNumberLevel","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL14MXLNumberLevelV"},{"text":"?, ","kind":"text"},{"text":"lineEnd","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLLineEnd","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL10MXLLineEndO"},{"text":", ","kind":"text"},{"text":"endLength","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLTenths","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLTenthsa"},{"text":"?, ","kind":"text"},{"text":"lineKind","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLLineKind","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLLineKindO"},{"text":"?, ","kind":"text"},{"text":"dashLength","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLTenths","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLTenthsa"},{"text":"?, ","kind":"text"},{"text":"spaceLength","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLTenths","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLTenthsa"},{"text":"?, ","kind":"text"},{"text":"position","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLPosition","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLPositionV"},{"text":", ","kind":"text"},{"text":"color","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLColor","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLColorV"},{"text":"?)","kind":"text"}],"title":"init(id:kind:number:lineEnd:endLength:lineKind:dashLength:spaceLength:position:color:)","abstract":[{"text":"Creates a new ","type":"text"},{"code":"MXLBracket","type":"codeVoice"},{"text":".","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLLineEnd":{"kind":"symbol","abstract":[{"text":"The line-end type specifies if there is a jog up or down (or both), an arrow, or nothing at the start or end","type":"text"},{"text":" ","type":"text"},{"text":"of a bracket.","type":"text"}],"title":"MXLLineEnd","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLineEnd","navigatorTitle":[{"kind":"identifier","text":"MXLLineEnd"}],"role":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxllineend","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLLineEnd"}]},"doc://IvorMXL/documentation/IvorMXL/MXLBracket":{"type":"topic","title":"MXLBracket","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBracket","abstract":[{"text":"Brackets are combined with words in a variety of modern directions. The line-end attribute specifies if there","type":"text"},{"text":" ","type":"text"},{"text":"is a jog up or down (or both), an arrow, or nothing at the start or end of the bracket. If the line-end is up","type":"text"},{"text":" ","type":"text"},{"text":"or down, the length of the jog can be specified using the end-length attribute. The line-type is solid if not","type":"text"},{"text":" ","type":"text"},{"text":"specified.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLBracket"}],"navigatorTitle":[{"kind":"identifier","text":"MXLBracket"}],"url":"\/documentation\/ivormxl\/mxlbracket"},"doc://IvorMXL/documentation/IvorMXL/MXLLineKind":{"type":"topic","title":"MXLLineKind","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLineKind","abstract":[{"text":"The line-type type distinguishes between solid, dashed, dotted, and wavy lines.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLLineKind"}],"navigatorTitle":[{"kind":"identifier","text":"MXLLineKind"}],"url":"\/documentation\/ivormxl\/mxllinekind"},"doc://IvorMXL/documentation/IvorMXL/MXLTenths":{"type":"topic","abstract":[{"type":"text","text":"The tenths type is a number representing tenths of interline staff space (positive or negative). Both integer"},{"type":"text","text":" "},{"type":"text","text":"and decimal values are allowed, such as 5 for a half space and 2.5 for a quarter space. Interline space is"},{"type":"text","text":" "},{"type":"text","text":"measured from the middle of a staff line."}],"url":"\/documentation\/ivormxl\/mxltenths","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTenths"}],"kind":"symbol","title":"MXLTenths","navigatorTitle":[{"kind":"identifier","text":"MXLTenths"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNumberLevel":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumberLevel","navigatorTitle":[{"kind":"identifier","text":"MXLNumberLevel"}],"url":"\/documentation\/ivormxl\/mxlnumberlevel","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNumberLevel"}],"title":"MXLNumberLevel","abstract":[{"text":"Slurs, tuplets, and many other features can be concurrent and overlap within a single musical part. The","type":"text"},{"text":" ","type":"text"},{"text":"number-level entity distinguishes up to 16 concurrent objects of the same type when the objects overlap in","type":"text"},{"text":" ","type":"text"},{"text":"MusicXML document order. Values greater than 6 are usually only needed for music with a large number of divisi","type":"text"},{"text":" ","type":"text"},{"text":"staves in a single part, or if there are more than 6 cross-staff arpeggios in a single measure. When a number-","type":"text"},{"text":" ","type":"text"},{"text":"level value is implied, the value is 1 by default.","type":"text"}],"type":"topic"}}}