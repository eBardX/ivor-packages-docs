{"abstract":[{"type":"text","text":"The color attribute group indicates the color of an element."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","metadata":{"symbolKind":"property","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"color","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL8MXLColorV","text":"MXLColor","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"role":"symbol","modules":[{"name":"IvorMXL"}],"externalID":"s:7IvorMXL10MXLBracketV5colorAA8MXLColorVSgvp","title":"color","roleHeading":"Instance Property"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBracket"]]},"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBracket\/color","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/ivormxl\/mxlbracket\/color"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"color","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL8MXLColorV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","text":"MXLColor","kind":"typeIdentifier"},{"text":"?","kind":"text"}]}]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLBracket/color":{"abstract":[{"type":"text","text":"The color attribute group indicates the color of an element."}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"color"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLColor","preciseIdentifier":"s:7IvorMXL8MXLColorV"},{"kind":"text","text":"?"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBracket\/color","title":"color","url":"\/documentation\/ivormxl\/mxlbracket\/color","type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"title":"MXLColor","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"abstract":[{"text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in","type":"text"},{"text":" ","type":"text"},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"url":"\/documentation\/ivormxl\/mxlcolor"},"doc://IvorMXL/documentation/IvorMXL/MXLBracket":{"url":"\/documentation\/ivormxl\/mxlbracket","abstract":[{"text":"Brackets are combined with words in a variety of modern directions. The line-end attribute specifies if there","type":"text"},{"text":" ","type":"text"},{"text":"is a jog up or down (or both), an arrow, or nothing at the start or end of the bracket. If the line-end is up","type":"text"},{"text":" ","type":"text"},{"text":"or down, the length of the jog can be specified using the end-length attribute. The line-type is solid if not","type":"text"},{"text":" ","type":"text"},{"text":"specified.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLBracket","kind":"identifier"}],"kind":"symbol","role":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBracket","title":"MXLBracket","navigatorTitle":[{"text":"MXLBracket","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"}}}