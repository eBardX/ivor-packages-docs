","kind":"text"},{"text":"MXLColor","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLColorV"},{"kind":"text","text":"?"}],"abstract":[{"type":"text","text":"The color attribute group indicates the color of an element."}],"url":"\/documentation\/ivormxl\/mxlbracket\/color","title":"color"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlcolor","title":"MXLColor","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"type":"text","text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is"},{"type":"text","text":" "},{"type":"text","text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor"},"doc://IvorMXL/documentation/IvorMXL/MXLBracket":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBracket","role":"symbol","navigatorTitle":[{"text":"MXLBracket","kind":"identifier"}],"type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLBracket","kind":"identifier"}],"abstract":[{"type":"text","text":"Brackets are combined with words in a variety of modern directions. The line-end attribute specifies if there"},{"type":"text","text":" "},{"type":"text","text":"is a jog up or down (or both), an arrow, or nothing at the start or end of the bracket. If the line-end is up"},{"type":"text","text":" "},{"type":"text","text":"or down, the length of the jog can be specified using the end-length attribute. The line-type is solid if not"},{"type":"text","text":" "},{"type":"text","text":"specified."}],"url":"\/documentation\/ivormxl\/mxlbracket","title":"MXLBracket"}}}