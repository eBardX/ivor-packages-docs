documentation\/ivormxl\/mxlnumberlevel","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumberLevel","abstract":[{"text":"Slurs, tuplets, and many other features can be concurrent and overlap within a single musical part. The","type":"text"},{"text":" ","type":"text"},{"text":"number-level entity distinguishes up to 16 concurrent objects of the same type when the objects overlap in","type":"text"},{"text":" ","type":"text"},{"text":"MusicXML document order. Values greater than 6 are usually only needed for music with a large number of divisi","type":"text"},{"text":" ","type":"text"},{"text":"staves in a single part, or if there are more than 6 cross-staff arpeggios in a single measure. When a number-","type":"text"},{"text":" ","type":"text"},{"text":"level value is implied, the value is 1 by default.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"MXLNumberLevel"}]},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLBracket/number":{"url":"\/documentation\/ivormxl\/mxlbracket\/number","abstract":[{"type":"text","text":"Distinguishes this bracket from other brackets that might be active at the same time."}],"title":"number","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBracket\/number","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"number","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLNumberLevel","preciseIdentifier":"s:7IvorMXL14MXLNumberLevelV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLBracket":{"title":"MXLBracket","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"text":"MXLBracket","kind":"identifier"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlbracket","abstract":[{"type":"text","text":"Brackets are combined with words in a variety of modern directions. The line-end attribute specifies if there"},{"text":" ","type":"text"},{"text":"is a jog up or down (or both), an arrow, or nothing at the start or end of the bracket. If the line-end is up","type":"text"},{"text":" ","type":"text"},{"text":"or down, the length of the jog can be specified using the end-length attribute. The line-type is solid if not","type":"text"},{"text":" ","type":"text"},{"text":"specified.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBracket","navigatorTitle":[{"text":"MXLBracket","kind":"identifier"}]}}}