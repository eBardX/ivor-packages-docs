tation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLBracket/spaceLength":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBracket\/spaceLength","role":"symbol","type":"topic","kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"spaceLength","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLTenths","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLTenthsa"},{"text":"?","kind":"text"}],"abstract":[{"type":"text","text":"The length, in tenths, of the spaces in a dashed line. Ignored if the corresponding line-type attribute is"},{"type":"text","text":" "},{"type":"text","text":"not dashed."}],"url":"\/documentation\/ivormxl\/mxlbracket\/spacelength","title":"spaceLength"},"doc://IvorMXL/documentation/IvorMXL/MXLTenths":{"title":"MXLTenths","type":"topic","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTenths","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxltenths","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"MXLTenths","kind":"identifier"}],"abstract":[{"type":"text","text":"The tenths type is a number representing tenths of interline staff space (positive or negative). Both integer"},{"type":"text","text":" "},{"type":"text","text":"and decimal values are allowed, such as 5 for a half space and 2.5 for a quarter space. Interline space is"},{"type":"text","text":" "},{"type":"text","text":"measured from the middle of a staff line."}]},"doc://IvorMXL/documentation/IvorMXL/MXLBracket":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBracket","role":"symbol","navigatorTitle":[{"text":"MXLBracket","kind":"identifier"}],"type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLBracket","kind":"identifier"}],"abstract":[{"type":"text","text":"Brackets are combined with words in a variety of modern directions. The line-end attribute specifies if there"},{"type":"text","text":" "},{"type":"text","text":"is a jog up or down (or both), an arrow, or nothing at the start or end of the bracket. If the line-end is up"},{"type":"text","text":" "},{"type":"text","text":"or down, the length of the jog can be specified using the end-length attribute. The line-type is solid if not"},{"type":"text","text":" "},{"type":"text","text":"specified."}],"url":"\/documentation\/ivormxl\/mxlbracket","title":"MXLBracket"}}}