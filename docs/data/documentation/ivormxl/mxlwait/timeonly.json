XL/documentation/IvorMXL/MXLTimeOnly":{"fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTimeOnly"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTimeOnly","navigatorTitle":[{"kind":"identifier","text":"MXLTimeOnly"}],"type":"topic","title":"MXLTimeOnly","role":"symbol","abstract":[{"type":"text","text":"The time-only type is used to indicate that a particular playback- or listening-related element only applies"},{"type":"text","text":" "},{"type":"text","text":"particular times through a repeated section. The value is a list of positive integers arranged in ascending"},{"type":"text","text":" "},{"type":"text","text":"order, indicating which times through the repeated section that the element applies."}],"url":"\/documentation\/ivormxl\/mxltimeonly","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLWait":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLWait"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLWait","navigatorTitle":[{"kind":"identifier","text":"MXLWait"}],"type":"topic","title":"MXLWait","role":"symbol","url":"\/documentation\/ivormxl\/mxlwait","abstract":[{"type":"text","text":"The wait type specifies a point where the accompaniment should wait for a performer event before continuing."},{"type":"text","text":" "},{"type":"text","text":"This typically happens at the start of new sections or after a held note or indeterminate music. These waiting"},{"type":"text","text":" "},{"type":"text","text":"points cannot always be inferred reliably from the contents of the displayed score. The optional player and"},{"type":"text","text":" "},{"type":"text","text":"time-only attributes restrict the type to apply to a single player or set of times through a repeated section,"},{"type":"text","text":" "},{"type":"text","text":"respectively."}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLWait/timeOnly":{"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"timeOnly"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLTimeOnlya","text":"MXLTimeOnly"},{"kind":"text","text":"?"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLWait\/timeOnly","type":"topic","title":"timeOnly","role":"symbol","url":"\/documentation\/ivormxl\/mxlwait\/timeonly","abstract":[{"type":"text","text":"Restricts the wait to a set of times through a repeated section."}],"kind":"symbol"}}}