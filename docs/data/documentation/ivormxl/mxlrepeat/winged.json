peats that","type":"text"},{"text":" ","type":"text"},{"text":"are not part of an ending. The times attribute indicates the number of times the repeated section is played.","type":"text"},{"text":" ","type":"text"},{"text":"The after-jump attribute indicates if the repeats are played after a jump due to a da capo or dal segno.","type":"text"}],"title":"MXLRepeat","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRepeat","kind":"symbol","url":"\/documentation\/ivormxl\/mxlrepeat","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLRepeat","kind":"identifier"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLWinged":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLWinged","title":"MXLWinged","kind":"symbol","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLWinged","kind":"identifier"}],"navigatorTitle":[{"text":"MXLWinged","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlwinged","abstract":[{"text":"The winged attribute indicates whether the repeat has winged extensions that appear above and below the","type":"text"},{"text":" ","type":"text"},{"text":"barline. The straight and curved values represent single wings, while the double-straight and double-curved","type":"text"},{"text":" ","type":"text"},{"text":"values represent double wings. The none value indicates no wings and is the default.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLRepeat/winged":{"url":"\/documentation\/ivormxl\/mxlrepeat\/winged","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRepeat\/winged","fragments":[{"text":"let","