{"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRepeat"]]},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"text":"winged","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLWinged","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLWingedO","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLWinged"}]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Maps to the MusicXML ","type":"text"},{"code":"winged","type":"codeVoice"},{"text":" attribute.","type":"text"}]}],"kind":"content"}],"kind":"symbol","metadata":{"role":"symbol","externalID":"s:7IvorMXL9MXLRepeatV6wingedAA9MXLWingedOvp","fragments":[{"text":"let","kind":"keyword"},{"kind":"text","text":" "},{"text":"winged","kind":"identifier"},{"kind":"text","text":": "},{"text":"MXLWinged","preciseIdentifier":"s:7IvorMXL9MXLWingedO","kind":"typeIdentifier"}],"modules":[{"name":"IvorMXL"}],"title":"winged","roleHeading":"Instance Property","symbolKind":"property"},"sections":[],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRepeat\/winged","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"type":"text","text":"The style of the repeat sign’s wings, if any."}],"variants":[{"paths":["\/documentation\/ivormxl\/mxlrepeat\/winged"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLWinged":{"type":"topic","url":"\/documentation\/ivormxl\/mxlwinged","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLWinged","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLWinged"}],"title":"MXLWinged","kind":"symbol","abstract":[{"type":"text","text":"The winged attribute indicates whether the repeat has winged extensions that appear above and below the"},{"type":"text","text":" "},{"type":"text","text":"barline. The straight and curved values represent single wings, while the double-straight and double-curved"},{"type":"text","text":" "},{"type":"text","text":"values represent double wings. The none value indicates no wings and is the default."}],"navigatorTitle":[{"kind":"identifier","text":"MXLWinged"}]},"doc://IvorMXL/documentation/IvorMXL/MXLRepeat":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRepeat","role":"symbol","navigatorTitle":[{"text":"MXLRepeat","kind":"identifier"}],"type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLRepeat","kind":"identifier"}],"abstract":[{"type":"text","text":"The repeat type represents repeat marks. The start of the repeat has a forward direction while the end of the"},{"type":"text","text":" "},{"type":"text","text":"repeat has a backward direction. The times and after-jump attributes are only used with backward repeats that"},{"type":"text","text":" "},{"type":"text","text":"are not part of an ending. The times attribute indicates the number of times the repeated section is played."},{"type":"text","text":" "},{"type":"text","text":"The after-jump attribute indicates if the repeats are played after a jump due to a da capo or dal segno."}],"url":"\/documentation\/ivormxl\/mxlrepeat","title":"MXLRepeat"},"doc://IvorMXL/documentation/IvorMXL/MXLRepeat/winged":{"title":"winged","abstract":[{"type":"text","text":"The style of the repeat sign’s wings, if any."}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlrepeat\/winged","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"winged"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLWinged","preciseIdentifier":"s:7IvorMXL9MXLWingedO"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRepeat\/winged"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]}}}