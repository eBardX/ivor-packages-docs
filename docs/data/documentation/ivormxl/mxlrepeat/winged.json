ord","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"winged"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLWingedO","text":"MXLWinged"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlrepeat\/winged","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRepeat\/winged","abstract":[{"text":"The style of the repeat sign’s wings, if any.","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLRepeat":{"type":"topic","title":"MXLRepeat","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRepeat","abstract":[{"type":"text","text":"The repeat type represents repeat marks. The start of the repeat has a forward direction while the end of the"},{"type":"text","text":" "},{"type":"text","text":"repeat has a backward direction. The times and after-jump attributes are only used with backward repeats that"},{"type":"text","text":" "},{"type":"text","text":"are not part of an ending. The times attribute indicates the number of times the repeated section is played."},{"type":"text","text":" "},{"type":"text","text":"The after-jump attribute indicates if the repeats are played after a jump due to a da capo or dal segno."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLRepeat"}],"navigatorTitle":[{"kind":"identifier","text":"MXLRepeat"}],"url":"\/documentation\/ivormxl\/mxlrepeat"},"doc://IvorMXL/documentation/IvorMXL/MXLWinged":{"type":"topic","abstract":[{"type":"text","text":"The winged attribute indicates whether the repeat has winged extensions that appear above and below the"},{"type":"text","text":" "},{"type":"text","text":"barline. The straight and curved values represent single wings, while the double-straight and double-curved"},{"type":"text","text":" "},{"type":"text","text":"values represent double wings. The none value indicates no wings and is the default."}],"url":"\/documentation\/ivormxl\/mxlwinged","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLWinged"}],"kind":"symbol","title":"MXLWinged","navigatorTitle":[{"kind":"identifier","text":"MXLWinged"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLWinged","role":"symbol"}}}