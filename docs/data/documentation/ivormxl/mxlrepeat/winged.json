},{"text":" ","kind":"text"},{"text":"winged","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLWinged","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLWingedO"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRepeat\/winged","type":"topic","url":"\/documentation\/ivormxl\/mxlrepeat\/winged","abstract":[{"text":"The style of the repeat sign’s wings, if any.","type":"text"}],"title":"winged","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLWinged":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlwinged","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLWinged","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLWinged","kind":"identifier"}],"abstract":[{"type":"text","text":"The winged attribute indicates whether the repeat has winged extensions that appear above and below the"},{"type":"text","text":" "},{"type":"text","text":"barline. The straight and curved values represent single wings, while the double-straight and double-curved"},{"type":"text","text":" "},{"type":"text","text":"values represent double wings. The none value indicates no wings and is the default."}],"kind":"symbol","type":"topic","navigatorTitle":[{"text":"MXLWinged","kind":"identifier"}],"title":"MXLWinged"},"doc://IvorMXL/documentation/IvorMXL/MXLRepeat":{"kind":"symbol","url":"\/documentation\/ivormxl\/mxlrepeat","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLRepeat","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRepeat","title":"MXLRepeat","abstract":[{"type":"text","text":"The repeat type represents repeat marks. The start of the repeat has a forward direction while the end of the"},{"type":"text","text":" "},{"type":"text","text":"repeat has a backward direction. The times and after-jump attributes are only used with backward repeats that"},{"type":"text","text":" "},{"type":"text","text":"are not part of an ending. The times attribute indicates the number of times the repeated section is played."},{"text":" ","type":"text"},{"type":"text","text":"The after-jump attribute indicates if the repeats are played after a jump due to a da capo or dal segno."}],"navigatorTitle":[{"text":"MXLRepeat","kind":"identifier"}],"type":"topic"}}}