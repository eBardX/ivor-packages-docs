RGB is used, the A value is assumed to be FF.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"url":"\/documentation\/ivormxl\/mxlcolor"},"doc://IvorMXL/documentation/IvorMXL/MXLDynamics/color":{"abstract":[{"type":"text","text":"The color attribute group indicates the color of an element."}],"url":"\/documentation\/ivormxl\/mxldynamics\/color","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"color","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLColor","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLColorV"},{"text":"?","kind":"text"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDynamics\/color","role":"symbol","title":"color","type":"topic"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLDynamics":{"role":"symbol","url":"\/documentation\/ivormxl\/mxldynamics","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDynamics","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLDynamics","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"Dynamics can be associated either with a note or a general musical direction. To avoid inconsistencies between","type":"text"},{"text":" ","type":"text"},{"text":"and among the letter abbreviations for dynamics (what is sf vs. sfz, standing alone or with a trailing","type":"text"},{"text":" ","type":"text"},{"text":"dynamic that is not always piano), we use the actual letters as the names of these dynamic elements. The","type":"text"},{"text":" ","type":"text"},{"text":"other-dynamics element allows other dynamic marks that are not covered here. Dynamics elements may also be","type":"text"},{"text":" ","type":"text"},{"text":"combined to create marks not covered by a single element, such as sfmp.","type":"text"}],"type":"topic","navigatorTitle":[{"text":"MXLDynamics","kind":"identifier"}],"title":"MXLDynamics"}}}