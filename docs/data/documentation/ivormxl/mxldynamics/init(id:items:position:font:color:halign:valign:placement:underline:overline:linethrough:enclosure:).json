r":"s:7IvorMXL13MXLAboveBelowO","text":"MXLAboveBelow","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAboveBelow"},{"text":"? = nil, ","kind":"text"},{"text":"underline","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL16MXLNumberOfLinesV","text":"MXLNumberOfLines","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumberOfLines"},{"text":"? = nil, ","kind":"text"},{"text":"overline","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL16MXLNumberOfLinesV","text":"MXLNumberOfLines","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumberOfLines"},{"text":"? = nil, ","kind":"text"},{"text":"lineThrough","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL16MXLNumberOfLinesV","text":"MXLNumberOfLines","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumberOfLines"},{"text":"? = nil, ","kind":"text"},{"text":"enclosure","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL17MXLEnclosureShapeO","text":"MXLEnclosureShape","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnclosureShape"},{"text":"? = nil)","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}]},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The optional-unique-id attribute group allows an element to optionally specify an ID that is unique to the entire document. This attribute group is not used for a required id attribute, or for an id attribute that specifies an id reference.","type":"text"}]}],"name":"id"},{"content":[{"type":"paragraph","inlineContent":[{"text":"One of the alternatives for Dynamics.","type":"text"}]}],"name":"items"},{"content":[{"type":"paragraph","inlineContent":[{"text":"For most elements, any program will compute a default x and y position. The position attributes let this be changed two ways.","type":"text"}]}],"name":"position"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The font attribute group gathers together attributes for determining the font within a credit or direction. They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of font names.The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font vs. a music font.","type":"text"}]}],"name":"font"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The color attribute group indicates the color of an element.","type":"text"}]}],"name":"color"},{"content":[{"type":"paragraph","inlineContent":[{"text":"In cases where text extends over more than one line, horizontal alignment and justify values can be different. The most typical case is for credits, such as:","type":"text"}]}],"name":"halign"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The valign attribute is used to indicate vertical alignment to the top, middle, bottom, or baseline of the text. Defaults are implementation-dependent.","type":"text"}]}],"name":"valign"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The placement attribute indicates whether something is above or below another element, such as a note or a notation.","type":"text"}]}],"name":"placement"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The number of lines used to underline the text: ","type":"text"},{"code":"0","type":"codeVoice"},{"text":" (none), ","type":"text"},{"code":"1","type":"codeVoice"},{"text":", ","type":"text"},{"code":"2","type":"codeVoice"},{"text":", or ","type":"text"},{"code":"3","type":"codeVoice"},{"text":".","type":"text"}]}],"name":"underline"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The number of lines used to overline the text: ","type":"text"},{"code":"0","type":"codeVoice"},{"text":" (none), ","type":"text"},{"code":"1","type":"codeVoice"},{"text":", ","type":"text"},{"code":"2","type":"codeVoice"},{"text":", or ","type":"text"},{"code":"3","type":"codeVoice"},{"text":".","type":"text"}]}],"name":"overline"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The number of lines used to strike through the text: ","type":"text"},{"code":"0","type":"codeVoice"},{"text":" (none), ","type":"text"},{"code":"1","type":"codeVoice"},{"text":", ","type":"text"},{"code":"2","type":"codeVoice"},{"text":", or ","type":"text"},{"code":"3","type":"codeVoice"},{"text":".","type":"text"}]}],"name":"lineThrough"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The enclosure attribute group is used to specify the formatting of an enclosure around text or symbols.","type":"text"}]}],"name":"enclosure"}],"kind":"parameters"}],"kind":"symbol","metadata":{"externalID":"s:7IvorMXL11MXLDynamicsV2id5items8position4font5color6halign6valign9placement9underline8overline11lineThrough9enclosureACSSSg_SayAC4ItemOGAA11MXLPositionVAA7MXLFontVAA8MXLColorVSgAA18MXLLeftCenterRightOSgAA9MXLValignOSgAA13MXLAboveBelowOSgAA16MXLNumberOfLinesVSgA10_A10_AA17MXLEnclosureShapeOSgtcfc","symbolKind":"init","role":"symbol","modules":[{"name":"IvorMXL"}],"title":"init(id:items:position:font:color:halign:valign:placement:underline:overline:lineThrough:enclosure:)","roleHeading":"Initializer","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"items","kind":"externalParam"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:7IvorMXL11MXLDynamicsV4ItemO","text":"Item","kind":"typeIdentifier"},{"text":"], ","kind":"text"},{"text":"position","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL11MXLPositionV","text":"MXLPo