seIdentifier":"s:7IvorMXL17MXLEnclosureShapeO","text":"MXLEnclosureShape"},{"kind":"text","text":"?)"}],"url":"\/documentation\/ivormxl\/mxldynamics\/init(id:items:position:font:color:halign:valign:placement:underline:overline:linethrough:enclosure:)","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDynamics\/init(id:items:position:font:color:halign:valign:placement:underline:overline:lineThrough:enclosure:)","type":"topic","role":"symbol","abstract":[{"text":"Creates a new ","type":"text"},{"code":"MXLDynamics","type":"codeVoice"},{"text":".","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLFont":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLFont"}],"abstract":[{"text":"The font attribute group gathers together attributes for determining the font within a credit or direction.","type":"text"},{"text":" ","type":"text"},{"text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of","type":"text"},{"text":" ","type":"text"},{"text":"font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric","type":"text"},{"text":" ","type":"text"},{"text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font","type":"text"},{"text":" ","type":"text"},{"text":"vs. a music font.","type":"text"}],"kind":"symbol","title":"MXLFont","url":"\/documentation\/ivormxl\/mxlfont","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFont"}]},"doc://IvorMXL/documentation/IvorMXL/MXLDynamics/Item":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Item"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Item"}],"url":"\/documentation\/ivormxl\/mxldynamics\/item","role":"symbol","title":"MXLDynamics.Item","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDynamics\/Item","type":"topic","abstract":[{"type":"text","text":"One of the alternatives for Dynamics."}]},"doc://IvorMXL/documentation/IvorMXL/MXLPosition":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLPosition"}],"abstract":[{"text":"For most elements, any program will compute a default x and y position. The position attributes let this be","type":"text"},{"text":" ","type":"text"},{"text":"changed two ways.","type":"text"}],"kind":"symbol","title":"MXLPosition","url":"\/documentation\/ivormxl\/mxlposition","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPosition"}]},"doc://IvorMXL/documentation/IvorMXL/MXLValign":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLValign"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValign","title":"MXLValign","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLValign"}],"abstract":[{"type":"text","text":"The valign type is used to indicate vertical alignment to the top, middle, bottom, or baseline of the text. If"},{"type":"text","text":" "},{"type":"text","text":"the text is on multiple lines, baseline alignment refers to the baseline of the lowest line of text. Defaults"},{"type":"text","text":" "},{"type":"text","text":"are implementation-dependent."}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlvalign"},"doc://IvorMXL/documentation/IvorMXL/MXLNumberOfLines":{"role":"symbol","abstract":[{"text":"The number-of-lines type is used to specify the number of lines in text decoration attributes.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumberOfLines","url":"\/documentation\/ivormxl\/mxlnumberoflines","title":"MXLNumberOfLines","navigatorTitle":[{"kind":"identifier","text":"MXLNumberOfLines"}],"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNumberOfLines"}]},"doc://IvorMXL/documentation/IvorMXL/MXLDynamics":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLDynamics"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLDynamics"}],"url":"\/documentation\/ivormxl\/mxldynamics","role":"symbol","title":"MXLDynamics","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDynamics","type":"topic","abstract":[{"type":"text","text":"Dynamics can be associated either with a note or a general musical direction. To avoid inconsistencies between"},{"type":"text","text":" "},{"type":"text","text":"and among the letter abbreviations for dynamics (what is sf vs. sfz, standing alone or with a trailing"},{"type":"text","text":" "},{"type":"text","text":"dynamic that is not always piano), we use the actual letters as the names of these dynamic elements. The"},{"type":"text","text":" "},{"type":"text","text":"other-dynamics element allows other dynamic marks that are not covered here. Dynamics elements may also be"},{"type":"text","text":" "},{"type":"text","text":"combined to create marks not covered by a single element, such as sfmp."}]},"doc://IvorMXL/documentation/IvorMXL/MXLAboveBelow":{"type":"topic","abstract":[{"text":"The above-below type is used to indicate whether one element appears above or below another element.","type":"text"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLAboveBelow"}],"navigatorTitle":[{"kind":"identifier","text":"MXLAboveBelow"}],"title":"MXLAboveBelow","kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlabovebelow","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAboveBelow"},"doc://IvorMXL/documentation/IvorMXL/MXLEnclosureShape":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnclosureShape","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLEnclosureShape"}],"abstract":[{"text":"The enclosure-shape type describes the shape and presence \/ absence of an enclosure around text or symbols. A","type":"text"},{"text":" ","type":"text"},{"text":"bracket enclosure is similar to a rectangle with the bottom line missing, as is common in jazz notation. An","type":"text"},{"text":" ","type":"text"},{"text":"inverted-bracket enclosure is similar to a rectangle with the top line missing.","type":"text"}],"kind":"symbol","title":"MXLEnclosureShape","url":"\/documentation\/ivormxl\/mxlenclosureshape","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLEnclosureShape"}]},"doc://IvorMXL/documentation/IvorMXL/MXLLeftCenterRight":{"type":"topic","kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLLeftCenterRight","kind":"identifier"}],"navigatorTitle":[{"text":"MXLLeftCenterRight","kind":"identifier"}],"abstract":[{"text":"The left-center-right type is used to define horizontal alignment and text justification.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLeftCenterRight","title":"MXLLeftCenterRight","role":"symbol","url":"\/documentation\/ivormxl\/mxlleftcenterright"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"}}}