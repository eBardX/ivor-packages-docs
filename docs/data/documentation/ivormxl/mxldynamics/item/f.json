:"identifier"}],"title":"MXLDynamics","abstract":[{"text":"Dynamics can be associated either with a note or a general musical direction. To avoid inconsistencies between","type":"text"},{"text":" ","type":"text"},{"text":"and among the letter abbreviations for dynamics (what is sf vs. sfz, standing alone or with a trailing","type":"text"},{"text":" ","type":"text"},{"text":"dynamic that is not always piano), we use the actual letters as the names of these dynamic elements. The","type":"text"},{"text":" ","type":"text"},{"text":"other-dynamics element allows other dynamic marks that are not covered here. Dynamics elements may also be","type":"text"},{"text":" ","type":"text"},{"text":"combined to create marks not covered by a single element, such as sfmp.","type":"text"}],"navigatorTitle":[{"text":"MXLDynamics","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDynamics","type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLDynamics/Item":{"title":"MXLDynamics.Item","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Item","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxldynamics\/item","role":"symbol","navigatorTitle":[{"text":"Item","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDynamics\/Item","abstract":[{"text":"One of the alternatives for Dynamics.","type":"text"}],"type":"topic"}}}