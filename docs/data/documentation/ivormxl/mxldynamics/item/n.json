"kind":"keyword","text":"case"},{"text":" ","kind":"text"},{"kind":"identifier","text":"n"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxldynamics\/item\/n","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDynamics\/Item\/n","abstract":[{"type":"text","text":"Niente (nothing), used at the start or end of a hairpin."}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLDynamics":{"url":"\/documentation\/ivormxl\/mxldynamics","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLDynamics","kind":"identifier"}],"title":"MXLDynamics","abstract":[{"text":"Dynamics can be associated either with a note or a general musical direction. To avoid inconsistencies between","type":"text"},{"text":" ","type":"text"},{"text":"and among the letter abbreviations for dynamics (what is sf vs. sfz, standing alone or with a trailing","type":"text"},{"text":" ","type":"text"},{"text":"dynamic that is not always piano), we use the actual letters as the names of these dynamic elements. The","type":"text"},{"text":" ","type":"text"},{"text":"other-dynamics element allows other dynamic marks that are not covered here. Dynamics elements may also be","type":"text"},{"text":" ","type":"text"},{"text":"combined to create marks not covered by a single element, such as sfmp.","type":"text"}],"navigatorTitle":[{"text":"MXLDynamics","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDynamics","type":"topic"}}}