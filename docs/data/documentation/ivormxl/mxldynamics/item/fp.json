,"text":"Item"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Item"}],"url":"\/documentation\/ivormxl\/mxldynamics\/item","role":"symbol","title":"MXLDynamics.Item","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDynamics\/Item","type":"topic","abstract":[{"type":"text","text":"One of the alternatives for Dynamics."}]},"doc://IvorMXL/documentation/IvorMXL/MXLDynamics":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLDynamics"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLDynamics"}],"url":"\/documentation\/ivormxl\/mxldynamics","role":"symbol","title":"MXLDynamics","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDynamics","type":"topic","abstract":[{"type":"text","text":"Dynamics can be associated either with a note or a general musical direction. To avoid inconsistencies between"},{"type":"text","text":" "},{"type":"text","text":"and among the letter abbreviations for dynamics (what is sf vs. sfz, standing alone or with a trailing"},{"type":"text","text":" "},{"type":"text","text":"dynamic that is not always piano), we use the actual letters as the names of these dynamic elements. The"},{"type":"text","text":" "},{"type":"text","text":"other-dynamics element allows other dynamic marks that are not covered here. Dynamics elements may also be"},{"type":"text","text":" "},{"type":"text","text":"combined to create marks not covered by a single element, such as sfmp."}]}}}