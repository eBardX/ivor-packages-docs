{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"ffff"}],"platforms":["macOS"],"languages":["swift"]}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxldynamics\/item\/ffff"]}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDynamics","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDynamics\/Item"]]},"abstract":[{"text":"Quadruple forte.","type":"text"}],"metadata":{"modules":[{"name":"IvorMXL"}],"symbolKind":"case","role":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"ffff"}],"title":"MXLDynamics.Item.ffff","externalID":"s:7IvorMXL11MXLDynamicsV4ItemO4ffffyA2EmF","roleHeading":"Case"},"kind":"symbol","identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDynamics\/Item\/ffff","interfaceLanguage":"swift"},"references":{"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLDynamics/Item":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Item"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Item"}],"url":"\/documentation\/ivormxl\/mxldynamics\/item","role":"symbol","title":"MXLDynamics.Item","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDynamics\/Item","type":"topic","abstract":[{"type":"text","text":"One of the alternatives for Dynamics."}]},"doc://IvorMXL/documentation/IvorMXL/MXLDynamics/Item/ffff":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDynamics\/Item\/ffff","role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ffff","kind":"identifier"}],"title":"MXLDynamics.Item.ffff","url":"\/documentation\/ivormxl\/mxldynamics\/item\/ffff","abstract":[{"type":"text","text":"Quadruple forte."}],"kind":"symbol","type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLDynamics":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLDynamics"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLDynamics"}],"url":"\/documentation\/ivormxl\/mxldynamics","role":"symbol","title":"MXLDynamics","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDynamics","type":"topic","abstract":[{"type":"text","text":"Dynamics can be associated either with a note or a general musical direction. To avoid inconsistencies between"},{"type":"text","text":" "},{"type":"text","text":"and among the letter abbreviations for dynamics (what is sf vs. sfz, standing alone or with a trailing"},{"type":"text","text":" "},{"type":"text","text":"dynamic that is not always piano), we use the actual letters as the names of these dynamic elements. The"},{"type":"text","text":" "},{"type":"text","text":"other-dynamics element allows other dynamic marks that are not covered here. Dynamics elements may also be"},{"type":"text","text":" "},{"type":"text","text":"combined to create marks not covered by a single element, such as sfmp."}]}}}