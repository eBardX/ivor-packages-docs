ies between","type":"text"},{"text":" ","type":"text"},{"text":"and among the letter abbreviations for dynamics (what is sf vs. sfz, standing alone or with a trailing","type":"text"},{"text":" ","type":"text"},{"text":"dynamic that is not always piano), we use the actual letters as the names of these dynamic elements. The","type":"text"},{"text":" ","type":"text"},{"text":"other-dynamics element allows other dynamic marks that are not covered here. Dynamics elements may also be","type":"text"},{"text":" ","type":"text"},{"text":"combined to create marks not covered by a single element, such as sfmp.","type":"text"}],"title":"MXLDynamics","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLDynamics","kind":"identifier"}],"navigatorTitle":[{"text":"MXLDynamics","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxldynamics","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDynamics"},"doc://IvorMXL/documentation/IvorMXL/MXLDynamics/Item":{"abstract":[{"text":"One of the alternatives for Dynamics.","type":"text"}],"title":"MXLDynamics.Item","kind":"symbol","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Item","kind":"identifier"}],"navigatorTitle":[{"text":"Item","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxldynamics\/item","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDynamics\/Item"}}}