mics\/Item\/mp","role":"symbol","kind":"symbol","url":"\/documentation\/ivormxl\/mxldynamics\/item\/mp","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"mp","kind":"identifier"}],"type":"topic","title":"MXLDynamics.Item.mp","abstract":[{"type":"text","text":"Mezzo-piano (moderately soft)."}]},"doc://IvorMXL/documentation/IvorMXL/MXLDynamics":{"role":"symbol","url":"\/documentation\/ivormxl\/mxldynamics","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDynamics","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLDynamics","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"Dynamics can be associated either with a note or a general musical direction. To avoid inconsistencies between","type":"text"},{"text":" ","type":"text"},{"text":"and among the letter abbreviations for dynamics (what is sf vs. sfz, standing alone or with a trailing","type":"text"},{"text":" ","type":"text"},{"text":"dynamic that is not always piano), we use the actual letters as the names of these dynamic elements. The","type":"text"},{"text":" ","type":"text"},{"text":"other-dynamics element allows other dynamic marks that are not covered here. Dynamics elements may also be","type":"text"},{"text":" ","type":"text"},{"text":"combined to create marks not covered by a single element, such as sfmp.","type":"text"}],"type":"topic","navigatorTitle":[{"text":"MXLDynamics","kind":"identifier"}],"title":"MXLDynamics"}}}