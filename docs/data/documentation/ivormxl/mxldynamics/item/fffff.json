ff","role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"fffff","kind":"identifier"}],"title":"MXLDynamics.Item.fffff","abstract":[{"text":"Quintuple forte.","type":"text"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDynamics\/Item\/fffff"},"doc://IvorMXL/documentation/IvorMXL/MXLDynamics":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxldynamics","title":"MXLDynamics","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLDynamics","kind":"identifier"}],"navigatorTitle":[{"text":"MXLDynamics","kind":"identifier"}],"abstract":[{"type":"text","text":"Dynamics can be associated either with a note or a general musical direction. To avoid inconsistencies between"},{"type":"text","text":" "},{"type":"text","text":"and among the letter abbreviations for dynamics (what is sf vs. sfz, standing alone or with a trailing"},{"type":"text","text":" "},{"type":"text","text":"dynamic that is not always piano), we use the actual letters as the names of these dynamic elements. The"},{"type":"text","text":" "},{"type":"text","text":"other-dynamics element allows other dynamic marks that are not covered here. Dynamics elements may also be"},{"type":"text","text":" "},{"type":"text","text":"combined to create marks not covered by a single element, such as sfmp."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDynamics"}}}