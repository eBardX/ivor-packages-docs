e":[{"text":"Item","kind":"identifier"}],"title":"MXLDynamics.Item"},"doc://IvorMXL/documentation/IvorMXL/MXLOtherText":{"url":"\/documentation\/ivormxl\/mxlothertext","abstract":[{"text":"The other-text type represents a text element with a smufl attribute group. This type is used by MusicXML","type":"text"},{"text":" ","type":"text"},{"text":"direction extension elements to allow specification of specific SMuFL glyphs without needed to add every glyph","type":"text"},{"text":" ","type":"text"},{"text":"as a MusicXML element.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLOtherText","kind":"identifier"}],"kind":"symbol","role":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOtherText","title":"MXLOtherText","navigatorTitle":[{"text":"MXLOtherText","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLDynamics/Item/otherDynamics(_:)":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDynamics\/Item\/otherDynamics(_:)","abstract":[{"type":"text","text":"A dynamic mark not covered by the other cases."}],"url":"\/documentation\/ivormxl\/mxldynamics\/item\/otherdynamics(_:)","kind":"symbol","type":"topic","title":"MXLDynamics.Item.otherDynamics(_:)","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"otherDynamics"},{"kind":"text","text":"("},{"preciseIdentifier":"s:7IvorMXL12MXLOtherTextV","kind":"typeIdentifier","text":"MXLOtherText"},{"kind":"text","text":")"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLDynamics":{"role":"symbol","url":"\/documentation\/ivormxl\/mxldynamics","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDynamics","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLDynamics","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"Dynamics can be associated either with a note or a general musical direction. To avoid inconsistencies between","type":"text"},{"text":" ","type":"text"},{"text":"and among the letter abbreviations for dynamics (what is sf vs. sfz, standing alone or with a trailing","type":"text"},{"text":" ","type":"text"},{"text":"dynamic that is not always piano), we use the actual letters as the names of these dynamic elements. The","type":"text"},{"text":" ","type":"text"},{"text":"other-dynamics element allows other dynamic marks that are not covered here. Dynamics elements may also be","type":"text"},{"text":" ","type":"text"},{"text":"combined to create marks not covered by a single element, such as sfmp.","type":"text"}],"type":"topic","navigatorTitle":[{"text":"MXLDynamics","kind":"identifier"}],"title":"MXLDynamics"}}}