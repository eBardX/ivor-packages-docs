{"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDynamics\/Item\/otherDynamics(_:)"},"sections":[],"metadata":{"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"otherDynamics"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"MXLOtherText","preciseIdentifier":"s:7IvorMXL12MXLOtherTextV"},{"kind":"text","text":")"}],"symbolKind":"case","modules":[{"name":"IvorMXL"}],"role":"symbol","roleHeading":"Case","externalID":"s:7IvorMXL11MXLDynamicsV4ItemO13otherDynamicsyAeA12MXLOtherTextVcAEmF","title":"MXLDynamics.Item.otherDynamics(_:)"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDynamics","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDynamics\/Item"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxldynamics\/item\/otherdynamics(_:)"]}],"abstract":[{"text":"A dynamic mark not covered by the other cases.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"otherDynamics"},{"kind":"text","text":"("},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOtherText","text":"MXLOtherText","preciseIdentifier":"s:7IvorMXL12MXLOtherTextV"},{"kind":"text","text":")"}],"platforms":["macOS"]}]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLOtherText":{"title":"MXLOtherText","navigatorTitle":[{"text":"MXLOtherText","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"The other-text type represents a text element with a smufl attribute group. This type is used by MusicXML","type":"text"},{"text":" ","type":"text"},{"text":"direction extension elements to allow specification of specific SMuFL glyphs without needed to add every glyph","type":"text"},{"text":" ","type":"text"},{"text":"as a MusicXML element.","type":"text"}],"role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOtherText","url":"\/documentation\/ivormxl\/mxlothertext","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLOtherText","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLDynamics":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLDynamics"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLDynamics"}],"url":"\/documentation\/ivormxl\/mxldynamics","role":"symbol","title":"MXLDynamics","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDynamics","type":"topic","abstract":[{"type":"text","text":"Dynamics can be associated either with a note or a general musical direction. To avoid inconsistencies between"},{"type":"text","text":" "},{"type":"text","text":"and among the letter abbreviations for dynamics (what is sf vs. sfz, standing alone or with a trailing"},{"type":"text","text":" "},{"type":"text","text":"dynamic that is not always piano), we use the actual letters as the names of these dynamic elements. The"},{"type":"text","text":" "},{"type":"text","text":"other-dynamics element allows other dynamic marks that are not covered here. Dynamics elements may also be"},{"type":"text","text":" "},{"type":"text","text":"combined to create marks not covered by a single element, such as sfmp."}]},"doc://IvorMXL/documentation/IvorMXL/MXLDynamics/Item/otherDynamics(_:)":{"kind":"symbol","title":"MXLDynamics.Item.otherDynamics(_:)","role":"symbol","url":"\/documentation\/ivormxl\/mxldynamics\/item\/otherdynamics(_:)","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"otherDynamics","kind":"identifier"},{"text":"(","kind":"text"},{"text":"MXLOtherText","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL12MXLOtherTextV"},{"