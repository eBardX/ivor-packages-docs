ical direction. To avoid inconsistencies between"},{"type":"text","text":" "},{"type":"text","text":"and among the letter abbreviations for dynamics (what is sf vs. sfz, standing alone or with a trailing"},{"type":"text","text":" "},{"type":"text","text":"dynamic that is not always piano), we use the actual letters as the names of these dynamic elements. The"},{"type":"text","text":" "},{"type":"text","text":"other-dynamics element allows other dynamic marks that are not covered here. Dynamics elements may also be"},{"type":"text","text":" "},{"type":"text","text":"combined to create marks not covered by a single element, such as sfmp."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDynamics"},"doc://IvorMXL/documentation/IvorMXL/MXLDynamics/Item":{"navigatorTitle":[{"text":"Item","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Item","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxldynamics\/item","abstract":[{"type":"text","text":"One of the alternatives for Dynamics."}],"role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDynamics\/Item","type":"topic","title":"MXLDynamics.Item"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLDynamics/Item/otherDynamics(_:)":{"type":"topic","title":"MXLDynamics.Item.otherDynamics(_:)","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"otherDynamics","kind":"identifier"},{"text":"(","kind":"text"},{"text":"MXLOtherText","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL12MXLOtherTextV"},{"text":")","kind":"text"}],"abstract":[{"text":"A dynamic mark not covered by the other cases.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDynamics\/Item\/otherDynamics(_:)","kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxldynamics\/item\/otherdynamics(_:)"},"doc://IvorMXL/documentation/IvorMXL/MXLOtherText":{"navigatorTitle":[{"kind":"identifier","text":"MXLOtherText"}],"fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"text":"MXLOtherText","kind":"identifier"}],"abstract":[{"type":"text","text":"The other-text type represents a text element with a smufl attribute group. This type is used by MusicXML"},{"type":"text","text":" "},{"type":"text","text":"direction extension elements to allow specification of specific SMuFL glyphs without needed to add every glyph"},{"type":"text","text":" "},{"type":"text","text":"as a MusicXML element."}],"role":"symbol","url":"\/documentation\/ivormxl\/mxlothertext","type":"topic","title":"MXLOtherText","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOtherText","kind":"symbol"}}}