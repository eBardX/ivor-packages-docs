{"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"roleHeading":"Instance Property","symbolKind":"property","modules":[{"name":"IvorMXL"}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"enclosure"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL17MXLEnclosureShapeO","text":"MXLEnclosureShape"},{"kind":"text","text":"?"}],"title":"enclosure","externalID":"s:7IvorMXL11MXLDynamicsV9enclosureAA17MXLEnclosureShapeOSgvp","role":"symbol"},"kind":"symbol","variants":[{"paths":["\/documentation\/ivormxl\/mxldynamics\/enclosure"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"enclosure"},{"kind":"text","text":": "},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnclosureShape","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL17MXLEnclosureShapeO","text":"MXLEnclosureShape"},{"kind":"text","text":"?"}]}]},{"kind":"content","content":[{"type":"heading","anchor":"discussion","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"Maps to the MusicXML ","type":"text"},{"code":"enclosure","type":"codeVoice"},{"text":" attribute.","type":"text"}]}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDynamics\/enclosure"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDynamics"]]},"sections":[],"abstract":[{"type":"text","text":"The enclosure attribute group is used to specify the formatting of an enclosure around text or symbols."}],"references":{"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLDynamics/enclosure":{"title":"enclosure","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"enclosure","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLEnclosureShape","preciseIdentifier":"s:7IvorMXL17MXLEnclosureShapeO","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxldynamics\/enclosure","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDynamics\/enclosure","abstract":[{"text":"The enclosure attribute group is used to specify the formatting of an enclosure around text or symbols.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLEnclosureShape":{"navigatorTitle":[{"kind":"identifier","text":"MXLEnclosureShape"}],"abstract":[{"text":"The enclosure-shape type describes the shape and presence \/ absence of an enclosure around text or symbols. A","type":"text"},{"text":" ","type":"text"},{"text":"bracket enclosure is similar to a rectangle with the bottom line missing, as is common in jazz notation. An","type":"text"},{"text":" ","type":"text"},{"text":"inverted-bracket enclosure is similar to a rectangle with the top line missing.","type":"text"}],"title":"MXLEnclosureShape","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnclosureShape","kind":"symbol","url":"\/documentation\/ivormxl\/mxlenclosureshape","type":"topic","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLEnclosureShape"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLDynamics":{"abstract":[{"text":"Dynamics can be associated either with a note or a general musical direction. To avoid inconsistencies between","type":"text"},{"text":" ","type":"text"},{"text":"and among the letter abbreviations for dynamics (what is sf vs. sfz, standing alone or with a trailing","type":"text"},{"text":" ","type":"text"},{"text":"dynamic that is not always piano), we use the actual letters as the names of these dynamic elements. The","type":"text"},{"text":" ","type":"text"},{"text":"other-dynamics element allows other dynamic marks that are not covered here. Dynamics elements may also be","type":"text"},{"text":" ","type":"text"},{"text":"combined to create marks not covered by a single element, such as sfmp.","type":"text"}],"title":"MXLDynamics","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLDynamics","kind":"identifier"}],"navigatorTitle":[{"text":"MXLDynamics","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxldynamics","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDynamics"}}}