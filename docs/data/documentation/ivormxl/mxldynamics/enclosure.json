"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLEnclosureShape":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLEnclosureShape"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnclosureShape","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLEnclosureShape"}],"title":"MXLEnclosureShape","abstract":[{"type":"text","text":"The enclosure-shape type describes the shape and presence \/ absence of an enclosure around text or symbols. A"},{"type":"text","text":" "},{"type":"text","text":"bracket enclosure is similar to a rectangle with the bottom line missing, as is common in jazz notation. An"},{"type":"text","text":" "},{"type":"text","text":"inverted-bracket enclosure is similar to a rectangle with the top line missing."}],"url":"\/documentation\/ivormxl\/mxlenclosureshape"},"doc://IvorMXL/documentation/IvorMXL/MXLDynamics/enclosure":{"url":"\/documentation\/ivormxl\/mxldynamics\/enclosure","type":"topic","title":"enclosure","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDynamics\/enclosure","role":"symbol","abstract":[{"type":"text","text":"The enclosure attribute group is used to specify the formatting of an enclosure around text or symbols."}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"enclosure"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLEnclosureShape","preciseIdentifier":"s:7IvorMXL17MXLEnclosureShapeO"},{"kind":"text","text":"?"}]},"doc://IvorMXL/documentation/IvorMXL/MXLDynamics":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxldynamics","title":"MXLDynamics","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLDynamics","kind":"identifier"}],"navigatorTitle":[{"text":"MXLDynamics","kind":"identifier"}],"abstract":[{"type":"text","text":"Dynamics can be associated either with a note or a general musical direction. To avoid inconsistencies between"},{"type":"text","text":" "},{"type":"text","text":"and among the letter abbreviations for dynamics (what is sf vs. sfz, standing alone or with a trailing"},{"type":"text","text":" "},{"type":"text","text":"dynamic that is not always piano), we use the actual letters as the names of these dynamic elements. The"},{"type":"text","text":" "},{"type":"text","text":"other-dynamics element allows other dynamic marks that are not covered here. Dynamics elements may also be"},{"type":"text","text":" "},{"type":"text","text":"combined to create marks not covered by a single element, such as sfmp."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDynamics"}}}