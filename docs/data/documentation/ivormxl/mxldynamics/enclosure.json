"MXLDynamics","kind":"identifier"}],"title":"MXLDynamics","abstract":[{"text":"Dynamics can be associated either with a note or a general musical direction. To avoid inconsistencies between","type":"text"},{"text":" ","type":"text"},{"text":"and among the letter abbreviations for dynamics (what is sf vs. sfz, standing alone or with a trailing","type":"text"},{"text":" ","type":"text"},{"text":"dynamic that is not always piano), we use the actual letters as the names of these dynamic elements. The","type":"text"},{"text":" ","type":"text"},{"text":"other-dynamics element allows other dynamic marks that are not covered here. Dynamics elements may also be","type":"text"},{"text":" ","type":"text"},{"text":"combined to create marks not covered by a single element, such as sfmp.","type":"text"}],"navigatorTitle":[{"text":"MXLDynamics","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDynamics","type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLEnclosureShape":{"title":"MXLEnclosureShape","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLEnclosureShape","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlenclosureshape","role":"symbol","navigatorTitle":[{"text":"MXLEnclosureShape","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnclosureShape","abstract":[{"type":"text","text":"The enclosure-shape type describes the shape and presence \/ absence of an enclosure around text or symbols. A"},{"type":"text","text":" "},{"type":"text","text":"bracket enclosure is similar to a rectangle with the bottom line missing, as is common in jazz notation. An"},{"type":"text","text":" "},{"type":"text","text":"inverted-bracket enclosure is similar to a rectangle with the top line missing."}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLDynamics/enclosure":{"role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"enclosure","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLEnclosureShape","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL17MXLEnclosureShapeO"},{"text":"?","kind":"text"}],"type":"topic","title":"enclosure","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDynamics\/enclosure","url":"\/documentation\/ivormxl\/mxldynamics\/enclosure","abstract":[{"type":"text","text":"The enclosure attribute group is used to specify the formatting of an enclosure around text or symbols."}],"kind":"symbol"}}}