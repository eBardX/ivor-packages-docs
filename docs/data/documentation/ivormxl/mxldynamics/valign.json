{"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"valign","kind":"identifier"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValign","text":"MXLValign","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLValignO"},{"text":"?","kind":"text"}]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"Maps to the MusicXML "},{"type":"codeVoice","code":"valign"},{"type":"text","text":" attribute."}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxldynamics\/valign"]}],"abstract":[{"text":"The valign attribute is used to indicate vertical alignment to the top, middle, bottom, or baseline of the","type":"text"},{"text":" ","type":"text"},{"text":"text. Defaults are implementation-dependent.","type":"text"}],"kind":"symbol","sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDynamics\/valign"},"metadata":{"externalID":"s:7IvorMXL11MXLDynamicsV6valignAA9MXLValignOSgvp","roleHeading":"Instance Property","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"valign","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLValign","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLValignO"},{"text":"?","kind":"text"}],"modules":[{"name":"IvorMXL"}],"title":"valign","symbolKind":"property"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDynamics"]]},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLDynamics/valign":{"abstract":[{"text":"The valign attribute is used to indicate vertical alignment to the top, middle, bottom, or baseline of the","type":"text"},{"text":" ","type":"text"},{"text":"text. Defaults are implementation-dependent.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDynamics\/valign","title":"valign","url":"\/documentation\/ivormxl\/mxldynamics\/valign","type":"topic","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"valign","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLValign","preciseIdentifier":"s:7IvorMXL9MXLValignO","kind":"typeIdentifier"},{"text":"?","kind":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLDynamics":{"url":"\/documentation\/ivormxl\/mxldynamics","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLDynamics","kind":"identifier"}],"title":"MXLDynamics","abstract":[{"text":"Dynamics can be associated either with a note or a general musical direction. To avoid inconsistencies between","type":"text"},{"text":" ","type":"text"},{"text":"and among the letter abbreviations for dynamics (what is sf vs. sfz, standing alone or with a trailing","type":"text"},{"text":" ","type":"text"},{"text":"dynamic that is not always piano), we use the actual letters as the names of these dynamic elements. The","type":"text"},{"text":" ","type":"text"},{"text":"other-dynamics element allows other dynamic marks that are not covered here. Dynamics elements may also be","type":"text"},{"text":" ","type":"text"},{"text":"combined to create marks not covered by a single element, such as sfmp.","type":"text"}],"navigatorTitle":[{"text":"MXLDynamics","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDynamics","type":"topic"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection",