{"sections":[],"abstract":[{"text":"How the beats and beat-type values are arranged relative to one another. ","type":"text"},{"code":".stacked","type":"codeVoice"},{"text":" if not","type":"text"},{"text":" ","type":"text"},{"text":"specified.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLInterchangeable"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLInterchangeable\/separator"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"separator"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTimeSeparator","preciseIdentifier":"s:7IvorMXL16MXLTimeSeparatorO","text":"MXLTimeSeparator"}],"platforms":["macOS"]}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"inlineContent":[{"text":"Maps to the MusicXML ","type":"text"},{"code":"separator","type":"codeVoice"},{"text":" attribute.","type":"text"}],"type":"paragraph"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlinterchangeable\/separator"]}],"metadata":{"externalID":"s:7IvorMXL18MXLInterchangeableV9separatorAA16MXLTimeSeparatorOvp","symbolKind":"property","roleHeading":"Instance Property","modules":[{"name":"IvorMXL"}],"title":"separator","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"separator"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL16MXLTimeSeparatorO","kind":"typeIdentifier","text":"MXLTimeSeparator"}]},"kind":"symbol","references":{"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLInterchangeable/separator":{"role":"symbol","abstract":[{"type":"text","text":"How the beats and beat-type values are arranged relative to one another. "},{"code":".stacked","type":"codeVoice"},{"type":"text","text":" if not"},{"type":"text","text":" "},{"type":"text","text":"specified."}],"title":"separator","url":"\/documentation\/ivormxl\/mxlinterchangeable\/separator","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLInterchangeable\/separator","kind":"symbol","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"separator","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLTimeSeparator","preciseIdentifier":"s:7IvorMXL16MXLTimeSeparatorO","kind":"typeIdentifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLTimeSeparator":{"role":"symbol","abstract":[{"type":"text","text":"The time-separator type indicates how to display the arrangement between the beats and beat-type values in a"},{"type":"text","text":" "},{"type":"text","text":"time signature. The default value is none. The horizontal, diagonal, and vertical values represent horizontal,"},{"type":"text","text":" "},{"type":"text","text":"diagonal lower-left to upper-right, and vertical lines respectively. For these values, the beats and beat-type"},{"type":"text","text":" "},{"type":"text","text":"values are arranged on either side of the separator line. The none value represents no separator with the"},{"type":"text","text":" "},{"type":"text","text":"beats and beat-type arranged vertically. The adjacent value represents no separator with the beats and beat-"},{"type":"text","text":" "},{"type":"text","text":"type arranged horizontally."}],"title":"MXLTimeSeparator","url":"\/documentation\/ivormxl\/mxltimeseparator","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTimeSeparator","navigatorTitle":[{"text":"MXLTimeSeparator","kind":"identifier"}],"kind":"symbol","type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTimeSeparator","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLInterchangeable":{"role":"symbol","abstract":[{"type":"text","text":"The interchangeable type is used to represent the second in a pair of interchangeable dual time signatures,"},{"type":"text","text":" "},{"type":"text","text":"such as the 6\/8 in 3\/4 (6\/8). A separate symbol attribute value is available compared to the time element’s"},{"type":"text","text":" "},{"type":"text","text":"symbol attribute, which applies to the first of the dual time signatures."}],"title":"MXLInterchangeable","url":"\/documentation\/ivormxl\/mxlinterchangeable","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLInterchangeable","navigatorTitle":[{"text":"MXLInterchangeable","kind":"identifier"}],"kind":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLInterchangeable","kind":"identifier"}]}}}