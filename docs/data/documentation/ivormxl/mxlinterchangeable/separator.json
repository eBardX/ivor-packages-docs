":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTimeSeparator","abstract":[{"type":"text","text":"The time-separator type indicates how to display the arrangement between the beats and beat-type values in a"},{"type":"text","text":" "},{"type":"text","text":"time signature. The default value is none. The horizontal, diagonal, and vertical values represent horizontal,"},{"type":"text","text":" "},{"type":"text","text":"diagonal lower-left to upper-right, and vertical lines respectively. For these values, the beats and beat-type"},{"type":"text","text":" "},{"type":"text","text":"values are arranged on either side of the separator line. The none value represents no separator with the"},{"type":"text","text":" "},{"type":"text","text":"beats and beat-type arranged vertically. The adjacent value represents no separator with the beats and beat-"},{"type":"text","text":" "},{"type":"text","text":"type arranged horizontally."}],"role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTimeSeparator"}],"navigatorTitle":[{"kind":"identifier","text":"MXLTimeSeparator"}],"url":"\/documentation\/ivormxl\/mxltimeseparator"},"doc://IvorMXL/documentation/IvorMXL/MXLInterchangeable/separator":{"abstract":[{"text":"How the beats and beat-type values are arranged relative to one another. ","type":"text"},{"code":".stacked","type":"codeVoice"},{"text":" if not","type":"text"},{"text":" ","type":"text"},{"text":"specified.","type":"text"}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"separator","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL16MXLTimeSeparatorO","text":"MXLTimeSeparator","kind":"typeIdentifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLInterchangeable\/separator","type":"topic","role":"symbol","kind":"symbol","url":"\/documentation\/ivormxl\/mxlinterchangeable\/separator","title":"separator"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLInterchangeable":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLInterchangeable","abstract":[{"type":"text","text":"The interchangeable type is used to represent the second in a pair of interchangeable dual time signatures,"},{"type":"text","text":" "},{"type":"text","text":"such as the 6\/8 in 3\/4 (6\/8). A separate symbol attribute value is available compared to the time element’s"},{"type":"text","text":" "},{"type":"text","text":"symbol attribute, which applies to the first of the dual time signatures."}],"type":"topic","kind":"symbol","title":"MXLInterchangeable","role":"symbol","url":"\/documentation\/ivormxl\/mxlinterchangeable","navigatorTitle":[{"text":"MXLInterchangeable","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLInterchangeable","kind":"identifier"}]}}}