ol","abstract":[{"type":"text","text":"The symbol used to display this time signature, distinct from the symbol used for the first of the dual time"},{"type":"text","text":" "},{"type":"text","text":"signatures."}],"type":"topic","kind":"symbol","title":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlinterchangeable\/symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"symbol","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLTimeSymbol","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL13MXLTimeSymbolO"},{"text":"?","kind":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLInterchangeable":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLInterchangeable","abstract":[{"type":"text","text":"The interchangeable type is used to represent the second in a pair of interchangeable dual time signatures,"},{"type":"text","text":" "},{"type":"text","text":"such as the 6\/8 in 3\/4 (6\/8). A separate symbol attribute value is available compared to the time element’s"},{"type":"text","text":" "},{"type":"text","text":"symbol attribute, which applies to the first of the dual time signatures."}],"type":"topic","kind":"symbol","title":"MXLInterchangeable","role":"symbol","url":"\/documentation\/ivormxl\/mxlinterchangeable","navigatorTitle":[{"text":"MXLInterchangeable","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLInterchangeable","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLTimeSymbol":{"title":"MXLTimeSymbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTimeSymbol","kind":"identifier"}],"kind":"symbol