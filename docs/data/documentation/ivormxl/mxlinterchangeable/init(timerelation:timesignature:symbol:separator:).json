:"symbol","kind":"symbol","navigatorTitle":[{"text":"MXLTimeSymbol","kind":"identifier"}],"abstract":[{"type":"text","text":"The time-symbol type indicates how to display a time signature. The normal value is the usual fractional"},{"type":"text","text":" "},{"type":"text","text":"display, and is the implied symbol type if none is specified. Other options are the common and cut time"},{"type":"text","text":" "},{"type":"text","text":"symbols, as well as a single number with an implied denominator. The note symbol indicates that the beat-type"},{"type":"text","text":" "},{"type":"text","text":"should be represented with the corresponding downstem note rather than a number. The dotted-note symbol"},{"type":"text","text":" "},{"type":"text","text":"indicates that the beat-type should be represented with a dotted downstem note that corresponds to three times"},{"type":"text","text":" "},{"type":"text","text":"the beat-type value, and a numerator that is one third the beats value."}]},"doc://IvorMXL/documentation/IvorMXL/MXLInterchangeable/init(timeRelation:timeSignature:symbol:separator:)":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLInterchangeable\/init(timeRelation:timeSignature:symbol:separator:)","type":"topic","abstract":[{"text":"Creates a new ","type":"text"},{"code":"MXLInterchangeable","type":"codeVoice"},{"text":".","type":"text"}],"url":"\/documentation\/ivormxl\/mxlinterchangeable\/init(timerelation:timesignature:symbol:separator:)","role":"symbol","title":"init(timeRelation:timeSignature:symbol:separator:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"timeRelation"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL15MXLTimeRelationO","kind":"typeIdentifier","text":"MXLTimeRelation"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"timeSignature"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:7IvorMXL16MXLTimeSignatureV","kind":"typeIdentifier","text":