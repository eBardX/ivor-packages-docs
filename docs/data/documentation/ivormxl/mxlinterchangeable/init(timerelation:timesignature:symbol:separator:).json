tor"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL16MXLTimeSeparatorO","text":"MXLTimeSeparator"},{"kind":"text","text":"?)"}],"symbolKind":"init","role":"symbol"},"sections":[],"kind":"symbol","references":{"doc://IvorMXL/documentation/IvorMXL/MXLTimeRelation":{"role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTimeRelation"}],"title":"MXLTimeRelation","type":"topic","navigatorTitle":[{"text":"MXLTimeRelation","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTimeRelation","url":"\/documentation\/ivormxl\/mxltimerelation","abstract":[{"type":"text","text":"The time-relation type indicates the symbol used to represent the interchangeable aspect of dual time"},{"type":"text","text":" "},{"type":"text","text":"signatures."}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLTimeSymbol":{"title":"MXLTimeSymbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTimeSymbol","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxltimesymbol","role":"symbol","navigatorTitle":[{"text":"MXLTimeSymbol","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTimeSymbol","abstract":[{"text":"The time-symbol type indicates how to display a time signature. The normal value is the usual fractional","type":"text"},{"text":" ","type":"text"},{"text":"display, and is the implied symbol type if none is specified. Other options are the common and cut time","type":"text"},{"text":" ","type":"text"},{"text":"symbols, as well as a single number with an implied denominator. The note symbol indicates that the beat-type","type":"text"},{"text":" ","type":"text"},{"text":"should be represented with the corresponding downstem note rather than a number. The dotted-note symbol","type":"text"},{"text":" ","type":"text"},{"text":"indicates that the beat-type should be represented with a dotted downstem note that corresponds to three times","type":"text"},{"text":" ","type":"text"},{"text":"the beat-type value, and a numerator that is one third the beats value.","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLInterchangeable/init(timeRelation:timeSignature:symbol:separator:)":{"role":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"timeRelation","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLTimeRelation","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL15MXLTimeRelationO"},{"text":"?, ","kind":"text"},{"text":"timeSignature","kind":"externalParam"},{"kind":"text","text":": ["},{"text":"MXLTimeSignature","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL16MXLTimeSignatureV"},{"text":"], ","kind":"text"},{"text":"symbol","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLTimeSymbol","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL13MXLTimeSymbolO"},{"text":"?, ","kind":"text"},{"text":"separator","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLTimeSeparator","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL16MXLTimeSeparatorO"},{"text":"?)","kind":"text"}],"title":"init(timeRelation:timeSignature:symbol:separator:)","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLInterchangeable\/init(timeRelation:timeSignature:symbol:separator:)","url":"\/documentation\/ivormxl\/mxlinterchangeable\/init(timerelation:timesignature:symbol:separator:)","abstract":[{"type":"text","text":"Creates a new "},{"code":"MXLInterchangeable","type":"codeVoice"},{"type":"text","text":"."}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLTimeSeparator":{"type":"topic","title":"MXLTimeSeparator","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTimeSeparator","abstract":[{"type":"text","text":"The time-separator type indicates how to display the arrangement between the beats and beat-type values in a"},{"type":"text","text":" "},{"type":"text","text":"time signature. The default value is none. The horizontal, diagonal, and vertical values represent horizontal,"},{"type":"text","text":" "},{"type":"text","text":"diagonal lower-left to upper-right, and vertical lines respectively. For these values, the beats and beat-type"},{"type":"text","text":" "},{"type":"text","text":"values are arranged on either side of the separator line. The none value represents no separator with the"},{"type":"text","text":" "},{"type":"text","text":"beats and beat-type arranged vertically. The adjacent value represents no separator with the beats and beat-"},{"type":"text","text":" "},{"type":"text","text":"type arranged horizontally."}],"role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTimeSeparator"}],"navigatorTitle":[{"kind":"identifier","text":"MXLTimeSeparator"}],"url":"\/documentation\/ivormxl\/mxltimeseparator"},"doc://IvorMXL/documentation/IvorMXL/MXLTimeSignature":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTimeSignature","navigatorTitle":[{"text":"MXLTimeSignature","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxltimesignature","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTimeSignature","kind":"identifier"}],"title":"MXLTimeSignature","abstract":[{"type":"text","text":"Time signatures are represented by the beats element for the numerator and the beat-type element for the"},{"type":"text","text":" "},{"type":"text","text":"denominator."}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLInterchangeable":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLInterchangeable","abstract":[{"type":"text","text":"The interchangeable type is used to represent the second in a pair of interchangeable dual time signatures,"},{"type":"text","text":" "},{"type":"text","text":"such as the 6\/8 in 3\/4 (6\/8). A separate symbol attribute value is available compared to the time element’s"},{"type":"text","text":" "},{"type":"text","text":"symbol attribute, which applies to the first of the dual time signatures."}],"type":"topic","kind":"symbol","title":"MXLInterchangeable","role":"symbol","url":"\/documentation\/ivormxl\/mxlinterchangeable","navigatorTitle":[{"text":"MXLInterchangeable","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLInterchangeable","kind":"identifier"}]}}}