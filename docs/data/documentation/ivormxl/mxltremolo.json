{"primaryContentSections":[{"declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTremolo","kind":"identifier"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"anchor":"overview","level":2,"type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"When using double-note tremolos, the duration of each note in the tremolo should correspond to half of the","type":"text"},{"text":" ","type":"text"},{"text":"notated type value. A time-modification element should also be added with an actual-notes value of 2 and a","type":"text"},{"text":" ","type":"text"},{"text":"normal-notes value of 1. If used within a tuplet, this 2\/1 ratio should be multiplied by the existing tuplet","type":"text"},{"text":" ","type":"text"},{"text":"ratio.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The smufl attribute specifies the glyph to use from the SMuFL Tremolos range for an unmeasured tremolo. It is","type":"text"},{"text":" ","type":"text"},{"text":"ignored for other tremolo types. The SMuFL buzzRoll glyph is used by default if the attribute is missing.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Using repeater beams for indicating tremolos is deprecated as of MusicXML 3.0.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Maps the MusicXML ","type":"text"},{"type":"codeVoice","code":"<tremolo>"},{"text":" element.","type":"text"}]}],"kind":"content"}],"kind":"symbol","identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo","interfaceLanguage":"swift"},"topicSections":[{"title":"Initializers","generated":true,"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo\/init(value:kind:position:font:color:placement:smufl:)"],"anchor":"Initializers"},{"title":"Instance Properties","generated":true,"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo\/color","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo\/font","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo\/kind-swift.property","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo\/placement","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo\/position","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo\/smufl","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo\/value"],"anchor":"Instance-Properties"},{"title":"Enumerations","generated":true,"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo\/Kind-swift.enum"],"anchor":"Enumerations"},{"title":"Default Implementations","generated":true,"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo\/Equatable-Implementations"],"anchor":"Default-Implementations"}],"relationshipsSections":[{"kind":"relationships","title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/IvorMXL\/s8CopyableP","doc:\/\/IvorMXL\/SQ","doc:\/\/IvorMXL\/s9EscapableP","doc:\/\/IvorMXL\/SH","doc:\/\/IvorMXL\/s8SendableP","doc:\/\/IvorMXL\/s16SendableMetatypeP"]}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL"]]},"metadata":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTremolo","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLTremolo"}],"roleHeading":"Structure","title":"MXLTremolo","symbolKind":"struct","modules":[{"name":"IvorMXL"}],"externalID":"s:7IvorMXL10MXLTremoloV"},"sections":[],"variants":[{"paths":["\/documentation\/ivormxl\/mxltremolo"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"The tremolo ornament can be used to indicate single-note, double-note, or unmeasured tremolos. Single-note"},{"type":"text","text":" "},{"type":"text","text":"tremolos use the single type, double-note tremolos use the start and stop types, and unmeasured tremolos use"},{"type":"text","text":" "},{"type":"text","text":"the unmeasured type. The default is “single” for compatibility with Version 1.1. The text of the element"},{"type":"text","text":" "},{"type":"text","text":"indicates the number of tremolo marks and is an integer from 0 to 8. Note that the number of attached beams is"},{"type":"text","text":" "},{"type":"text","text":"not included in this value, but is represented separately using the beam element. The value should be 0 for"},{"type":"text","text":" "},{"type":"text","text":"unmeasured tremolos."}],"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://IvorMXL/s8CopyableP":{"title":"Swift.Copyable","identifier":"doc:\/\/IvorMXL\/s8CopyableP","type":"unresolvable"},"doc://IvorMXL/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","identifier":"doc:\/\/IvorMXL\/s16SendableMetatypeP","type":"unresolvable"},"doc://IvorMXL/documentation/IvorMXL/MXLTremolo/value":{"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo\/value","type":"topic","url":"\/documentation\/ivormxl\/mxltremolo\/value","role":"symbol","title":"value","abstract":[{"type":"text","text":"The value of this element."}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"value"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL15MXLTremoloMarksV","kind":"typeIdentifier","text":"MXLTremoloMarks"}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/s9EscapableP":{"title":"Swift.Escapable","identifier":"doc:\/\/IvorMXL\/s9EscapableP","type":"unresolvable"},"doc://IvorMXL/documentation/IvorMXL/MXLTremolo/smufl":{"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo\/smufl","type":"topic","url":"\/documentation\/ivormxl\/mxltremolo\/smufl","role":"symbol","title":"smufl","abstract":[{"type":"text","text":"The smufl attribute group is used to indicate a particular Standard Music Font Layout (SMuFL) character."},{"type":"text","text":" "},{"type":"text","text":"Sometimes this is a formatting choice, and sometimes this is a refinement of the semantic meaning of an"},{"type":"text","text":" "},{"type":"text","text":"element."}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"smufl"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL17MXLSmuflGlyphNameV","kind":"typeIdentifier","text":"MXLSmuflGlyphName"},{"kind":"text","text":"?"}]},"doc://IvorMXL/documentation/IvorMXL/MXLTremolo":{"role":"symbol","url":"\/documentation\/ivormxl\/mxltremolo","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTremolo","kind":"identifier"}],"abstract":[{"type":"text","text":"The tremolo ornament can be used to indicate single-note, double-note, or unmeasured tremolos. Single-note"},{"type":"text","text":" "},{"type":"text","text":"tremolos use the single type, double-note tremolos use the start and stop types, and unmeasured tremolos use"},{"type":"text","text":" "},{"type":"text","text":"the unmeasured type. The default is “single” for compatibility with Version 1.1. The text of the element"},{"type":"text","text":" "},{"type":"text","text":"indicates the number of tremolo marks and is an integer from 0 to 8. Note that the number of attached beams is"},{"type":"text","text":" "},{"type":"text","text":"not included in this value, but is represented separately using the beam element. The value should be 0 for"},{"type":"text","text":" "},{"type":"text","text":"unmeasured tremolos."}],"kind":"symbol","type":"topic","navigatorTitle":[{"text":"MXLTremolo","kind":"identifier"}],"title":"MXLTremolo"},"doc://IvorMXL/documentation/IvorMXL/MXLTremolo/color":{"kind":"symbol","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo\/c