{"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo","interfaceLanguage":"swift"},"metadata":{"symbolKind":"struct","externalID":"s:7IvorMXL10MXLTremoloV","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLTremolo"}],"roleHeading":"Structure","modules":[{"name":"IvorMXL"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTremolo"}],"title":"MXLTremolo"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL"]]},"topicSections":[{"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo\/init(value:kind:position:font:color:placement:smufl:)"],"generated":true},{"anchor":"Instance-Properties","title":"Instance Properties","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo\/color","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo\/font","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo\/kind-swift.property","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo\/placement","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo\/position","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo\/smufl","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo\/value"],"generated":true},{"anchor":"Enumerations","title":"Enumerations","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo\/Kind-swift.enum"],"generated":true},{"anchor":"Default-Implementations","title":"Default Implementations","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo\/Equatable-Implementations"],"generated":true}],"kind":"symbol","relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/IvorMXL\/s8CopyableP","doc:\/\/IvorMXL\/SQ","doc:\/\/IvorMXL\/s9EscapableP","doc:\/\/IvorMXL\/SH","doc:\/\/IvorMXL\/s8SendableP","doc:\/\/IvorMXL\/s16SendableMetatypeP"],"kind":"relationships","type":"conformsTo"}],"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTremolo"}],"languages":["swift"],"platforms":["macOS"]}]},{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"inlineContent":[{"type":"text","text":"When using double-note tremolos, the duration of each note in the tremolo should correspond to half of the"},{"type":"text","text":" "},{"type":"text","text":"notated type value. A time-modification element should also be added with an actual-notes value of 2 and a"},{"type":"text","text":" "},{"type":"text","text":"normal-notes value of 1. If used within a tuplet, this 2\/1 ratio should be multiplied by the existing tuplet"},{"type":"text","text":" "},{"type":"text","text":"ratio."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The smufl attribute specifies the glyph to use from the SMuFL Tremolos range for an unmeasured tremolo. It is"},{"type":"text","text":" "},{"type":"text","text":"ignored for other tremolo types. The SMuFL buzzRoll glyph is used by default if the attribute is missing."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Using repeater beams for indicating tremolos is deprecated as of MusicXML 3.0."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Maps the MusicXML "},{"type":"codeVoice","code":"<tremolo>"},{"type":"text","text":" element."}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"type":"text","text":"The tremolo ornament can be used to indicate single-note, double-note, or unmeasured tremolos. Single-note"},{"type":"text","text":" "},{"type":"text","text":"tremolos use the single type, double-note tremolos use the start and stop types, and unmeasured tremolos use"},{"type":"text","text":" "},{"type":"text","text":"the unmeasured type. The default is “single” for compatibility with Version 1.1. The text of the element"},{"type":"text","text":" "},{"type":"text","text":"indicates the number of tremolo marks and is an integer from 0 to 8. Note that the number of attached beams is"},{"type":"text","text":" "},{"type":"text","text":"not included in this value, but is represented separately using the beam element. The value should be 0 for"},{"type":"text","text":" "},{"type":"text","text":"unmeasured tremolos."}],"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxltremolo"]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLTremolo/placement":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo\/placement","url":"\/documentation\/ivormxl\/mxltremolo\/placement","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"The placement attribute indicates whether something is above or below another element, such as a note or a"},{"type":"text","text":" "},{"type":"text","text":"notation."}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"placement"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL13MXLAboveBelowO","kind":"typeIdentifier","text":"MXLAboveBelow"},{"kind":"text","text":"?"}],"type":"topic","title":"placement"},"doc://IvorMXL/documentation/IvorMXL/MXLTremolo/color":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo\/color","url":"\/documentation\/ivormxl\/mxltremolo\/color","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"The color attribute group indicates the color of an element."}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"color"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL8MXLColorV","kind":"typeIdentifier","text":"MXLColor"},{"kind":"text","text":"?"}],"type":"topic","title":"color"},"doc://IvorMXL/SH":{"type":"unresolvable","title":"Swift.Hashable","identifier":"doc:\/\/IvorMXL\/SH"},"doc://IvorMXL/documentation/IvorMXL/MXLTremolo/Equatable-Implementations":{"identifier":"doc:\/\/Ivo