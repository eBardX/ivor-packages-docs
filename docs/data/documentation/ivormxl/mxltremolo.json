{"primaryContentSections":[{"declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTremolo","kind":"identifier"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"text":"When using double-note tremolos, the duration of each note in the tremolo should correspond to half of the","type":"text"},{"text":" ","type":"text"},{"text":"notated type value. A time-modification element should also be added with an actual-notes value of 2 and a","type":"text"},{"text":" ","type":"text"},{"text":"normal-notes value of 1. If used within a tuplet, this 2\/1 ratio should be multiplied by the existing tuplet","type":"text"},{"text":" ","type":"text"},{"text":"ratio.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The smufl attribute specifies the glyph to use from the SMuFL Tremolos range for an unmeasured tremolo. It is","type":"text"},{"text":" ","type":"text"},{"text":"ignored for other tremolo types. The SMuFL buzzRoll glyph is used by default if the attribute is missing.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Using repeater beams for indicating tremolos is deprecated as of MusicXML 3.0.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Maps the MusicXML ","type":"text"},{"code":"<tremolo>","type":"codeVoice"},{"text":" element.","type":"text"}]}],"kind":"content"}],"metadata":{"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTremolo","kind":"identifier"}],"title":"MXLTremolo","navigatorTitle":[{"text":"MXLTremolo","kind":"identifier"}],"roleHeading":"Structure","modules":[{"name":"IvorMXL"}],"externalID":"s:7IvorMXL10MXLTremoloV","symbolKind":"struct"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL"]]},"kind":"symbol","variants":[{"paths":["\/documentation\/ivormxl\/mxltremolo"],"traits":[{"interfaceLanguage":"swift"}]}],"relationshipsSections":[{"identifiers":["doc:\/\/IvorMXL\/s8CopyableP","doc:\/\/IvorMXL\/SQ","doc:\/\/IvorMXL\/s9EscapableP","doc:\/\/IvorMXL\/SH","doc:\/\/IvorMXL\/s8SendableP","doc:\/\/IvorMXL\/s16SendableMetatypeP"],"type":"conformsTo","title":"Conforms To","kind":"relationships"}],"abstract":[{"type":"text","text":"The tremolo ornament can be used to indicate single-note, double-note, or unmeasured tremolos. Single-note"},{"type":"text","text":" "},{"type":"text","text":"tremolos use the single type, double-note tremolos use the start and stop types, and unmeasured tremolos use"},{"type":"text","text":" "},{"type":"text","text":"the unmeasured type. The default is “single” for compatibility with Version 1.1. The text of the element"},{"type":"text","text":" "},{"type":"text","text":"indicates the number of tremolo marks and is an integer from 0 to 8. Note that the number of attached beams is"},{"type":"text","text":" "},{"type":"text","text":"not included in this value, but is represented separately using the beam element. The value should be 0 for"},{"type":"text","text":" "},{"type":"text","text":"unmeasured tremolos."}],"topicSections":[{"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo\/init(value:kind:position:font:color:placement:smufl:)"],"generated":true,"anchor":"Initializers","title":"Initializers"},{"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo\/color","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo\/font","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo\/kind-swift.property","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo\/placement","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo\/position","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo\/smufl","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo\/value"],"generated":true,"anchor":"Instance-Properties","title":"Instance Properties"},{"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo\/Kind-swift.enum"],"generated":true,"anchor":"Enumerations","title":"Enumerations"},{"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo\/Equatable-Implementations"],"generated":true,"anchor":"Default-Implementations","title":"Default Implementations"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo"},"references":{"doc://IvorMXL/SH":{"identifier":"doc:\/\/IvorMXL\/SH","type":"unresolvable","title":"Swift.Hashable"},"doc://IvorMXL/documentation/IvorMXL/MXLTremolo/font":{"title":"font","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo\/font","kind":"symbol","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"font"},{"kind":"text","text":": "},{"text":"MXLFont","preciseIdentifier":"s:7IvorMXL7MXLFontV","kind":"typeIdentifier"}],"url":"\/documentation\/ivormxl\/mxltremolo\/font","abstract":[{"type":"text","text":"The font attribute group gathers together attributes for determining the font within a credit or direction."},{"type":"text","text":" "},{"type":"text","text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of"},{"type":"text","text":" "},{"type":"text","text":"font names.The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric"},{"type":"text","text":" "},{"type":"text","text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font"},{"type":"text","text":" "},{"type":"text","text":"vs. a music font."}]},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and 