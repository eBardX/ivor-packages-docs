imes this is a formatting choice, and sometimes this is a refinement of the semantic meaning of an"},{"type":"text","text":" "},{"type":"text","text":"element."}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"smufl"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL17MXLSmuflGlyphNameV","kind":"typeIdentifier","text":"MXLSmuflGlyphName"},{"kind":"text","text":"?"}],"type":"topic","title":"smufl"},"doc://IvorMXL/documentation/IvorMXL/MXLTremolo/font":{"abstract":[{"type":"text","text":"The font attribute group gathers together attributes for determining the font within a credit or direction."},{"type":"text","text":" "},{"type":"text","text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of"},{"type":"text","text":" "},{"type":"text","text":"font names.The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric"},{"type":"text","text":" "},{"type":"text","text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font"},{"type":"text","text":" "},{"type":"text","text":"vs. a music font."}],"kind":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTremolo\/font","title":"font","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"font","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL7MXLFontV","text":"MXLFont","kind":"typeIdentifier"}],"url":"\/documentation\/ivormxl\/mxltremolo\/font","role":"symbol"},"doc://IvorMXL/s8SendableP":{"type":"unresolvable","title":"Swift.Sendable","identifier":"doc:\/\/IvorMXL\/s8SendableP"},"doc://IvorMXL/documentation/IvorMXL/MXLTremolo/Kind-swift.enum":{"url":"\/documentation\/ivormxl\/mxltremolo\/kind-swift.enum","abstract":[{"type":"text","text":"The tremolo-type is used to distinguish double-note, single-note, and unmeasured tremolos."}]