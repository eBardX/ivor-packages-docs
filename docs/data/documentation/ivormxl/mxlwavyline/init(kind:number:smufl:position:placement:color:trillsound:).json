entation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLWavyLine":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLWavyLine"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLWavyLine"}],"url":"\/documentation\/ivormxl\/mxlwavyline","role":"symbol","title":"MXLWavyLine","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLWavyLine","type":"topic","abstract":[{"type":"text","text":"Wavy lines are one way to indicate trills and vibrato. When used with a barline element, they should always"},{"type":"text","text":" "},{"type":"text","text":"have type=“continue” set. The smufl attribute specifies a particular wavy line glyph from the SMuFL Multi-"},{"type":"text","text":" "},{"type":"text","text":"segment lines range."}]},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLColor","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","title":"MXLColor","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlcolor"},"doc://IvorMXL/documentation/IvorMXL/MXLNumberLevel":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumberLevel","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLNumberLevel"}],"abstract":[{"type":"text","text":"Slurs, tuplets, and many other features can be concurrent and overlap within a single musical part. The"},{"type":"text","text":" "},{"type":"text","text":"number-level entity distinguishes up to 16 concurrent objects of the same type when the objects overlap in"},{"type":"text","text":" "},{"type":"text","text":"MusicXML document order. Values greater than 6 are usually only needed for music with a large number of divisi"},{"type":"text","text":" "},{"type":"text","text":"staves in a single part, or if there are more than 6 cross-staff arpeggios in a single measure. When a number-"},{"type":"text","text":" "},{"type":"text","text":"level value is implied, the value is 1 by default."}],"kind":"symbol","title":"MXLNumberLevel","url":"\/documentation\/ivormxl\/mxlnumberlevel","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNumberLevel"}]},"doc://IvorMXL/documentation/IvorMXL/MXLTrillSound":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTrillSound"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLTrillSound"}],"url":"\/documentation\/ivormxl\/mxltrillsound","role":"symbol","title":"MXLTrillSound","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTrillSound","type":"topic","abstract":[{"type":"text","text":"The trill-sound attribute group includes attributes used to guide the sound of trills, mordents, turns,"},{"type":"text","text":" "},{"type":"text","text":"shakes, and wavy lines. The default choices are:"}]},"doc://IvorMXL/documentation/IvorMXL/MXLPosition":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLPosition"}],"abstract":[{"text":"For most elements, any program will compute a default x and y position. The position attributes let this be","type":"text"},{"text":" ","type":"text"},{"text":"changed two ways.","type":"text"}],"kind":"symbol","title":"MXLPosition","url":"\/documentation\/ivormxl\/mxlposition","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPosition"}]},"doc://IvorMXL/documentation/IvorMXL/MXLStartStopContinue":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStartStopContinue","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLStartStopContinue"}],"abstract":[{"type":"text","text":"The start-stop-continue type is used for an attribute of musical elements that can either start or stop, but"},{"type":"text","text":" "},{"type":"text","text":"also need to refer to an intermediate point in the symbol, as for complex slurs or for formatting of symbols"},{"type":"text","text":" "},{"type":"text","text":"across system breaks."}],"kind":"symbol","title":"MXLStartStopContinue","url":"\/documentation\/ivormxl\/mxlstartstopcontinue","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLStartStopContinue"}]}}}