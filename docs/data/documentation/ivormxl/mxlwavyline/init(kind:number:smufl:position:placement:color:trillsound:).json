lSound","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The trill-sound attribute group includes attributes used to guide the sound of trills,"},{"type":"text","text":" "},{"type":"text","text":"mordents, turns, shakes, and wavy lines. The default choices are:"}]}]}],"kind":"parameters"}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLPosition":{"type":"topic","abstract":[{"type":"text","text":"For most elements, any program will compute a default x and y position. The position attributes let this be"},{"type":"text","text":" "},{"type":"text","text":"changed two ways."}],"url":"\/documentation\/ivormxl\/mxlposition","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPosition"}],"kind":"symbol","title":"MXLPosition","navigatorTitle":[{"kind":"identifier","text":"MXLPosition"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLStartStopContinue":{"type":"topic","abstract":[{"type":"text","text":"The start-stop-continue type is used for an attribute of musical elements that can either start or stop, but"},{"type":"text","text":" "},{"type":"text","text":"also need to refer to an intermediate point in the symbol, as for complex slurs or for formatting of symbols"},{"type":"text","text":" "},{"type":"text","text":"across system breaks."}],"url":"\/documentation\/ivormxl\/mxlstartstopcontinue","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLStartStopContinue"}],"kind":"symbol","title":"MXLStartStopContinue","navigatorTitle":[{"text":"MXLStartStopContinue","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStartStopContinue","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLSmuflWavyLineGlyphName":{"type":"topic","abstract":[{"text":"The smufl-wavy-line-glyph-name type is used to reference a specific Standard Music Font Layout (SMuFL) wavy","type":"text"},{"text":" ","type":"text"},{"text":"line character. The value is a SMuFL canonical glyph name that either starts with wiggle, or begins with","type":"text"},{"type":"text","text":" "},{"type":"text","text":"guitar and ends with VibratoStroke. This includes all the glyphs in the Multi-segment lines range, excluding"},{"type":"text","text":" "},{"type":"text","text":"the beam glyphs."}],"url":"\/documentation\/ivormxl\/mxlsmuflwavylineglyphname","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLSmuflWavyLineGlyphName"}],"kind":"symbol","title":"MXLSmuflWavyLineGlyphName","navigatorTitle":[{"kind":"identifier","text":"MXLSmuflWavyLineGlyphName"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSmuflWavyLineGlyphName","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLAboveBelow":{"type":"topic","title":"MXLAboveBelow","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAboveBelow","abstract":[{"type":"text","text":"The above-below type is used to indicate whether one element appears above or below another element."}],"role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLAboveBelow"}],"navigatorTitle":[{"kind":"identifier","text":"MXLAboveBelow"}],"url":"\/documentation\/ivormxl\/mxlabovebelow"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"type":"topic","abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"type":"text","text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is"},{"type":"text","text":" "},{"type":"text","text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF."}],"url":"\/documentation\/ivormxl\/mxlcolor","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"kind":"symbol","title":"MXLColor","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLWavyLine":{"type":"topic","title":"MXLWavyLine","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLWavyLine","abstract":[{"type":"text","text":"Wavy lines are one way to indicate trills and vibrato. When used with a barline element, they should always"},{"type":"text","text":" "},{"type":"text","text":"have "},{"code":"type=\"continue\"","type":"codeVoice"},{"type":"text","text":" set. The smufl attribute specifies a particular wavy line glyph from the SMuFL Multi-"},{"type":"text","text":" "},{"type":"text","text":"segment lines range."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLWavyLine"}],"navigatorTitle":[{"kind":"identifier","text":"MXLWavyLine"}],"url":"\/documentation\/ivormxl\/mxlwavyline"},"doc://IvorMXL/documentation/IvorMXL/MXLTrillSound":{"type":"topic","abstract":[{"type":"text","text":"The trill-sound attribute group includes attributes used to guide the sound of trills, mordents, turns,"},{"type":"text","text":" "},{"type":"text","text":"shakes, and wavy lines. The default choices are:"}],"url":"\/documentation\/ivormxl\/mxltrillsound","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTrillSound"}],"kind":"symbol","title":"MXLTrillSound","navigatorTitle":[{"kind":"identifier","text":"MXLTrillSound"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTrillSound","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNumberLevel":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumberLevel","navigatorTitle":[{"kind":"identifier","text":"MXLNumberLevel"}],"url":"\/documentation\/ivormxl\/mxlnumberlevel","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNumberLevel"}],"title":"MXLNumberLevel","abstract":[{"text":"Slurs, tuplets, and many other features can be concurrent and overlap within a single musical part. The","type":"text"},{"text":" ","type":"text"},{"text":"number-level entity distinguishes up to 16 concurrent objects of the same type when the objects overlap in","type":"text"},{"text":" ","type":"text"},{"text":"MusicXML document order. Values greater than 6 are usually only needed for music with a large number of divisi","type":"text"},{"text":" ","type":"text"},{"text":"staves in a single part, or if there are more than 6 cross-staff arpeggios in a single measure. When a number-","type":"text"},{"text":" ","type":"text"},{"text":"level value is implied, the value is 1 by default.","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLWavyLine/init(kind:number:smufl:position:placement:color:trillSound:)":{"abstract":[{"type":"text","text":"Creates a new "},{"code":"MXLWavyLine","type":"codeVoice"},{"type":"text","text":"."}],"title":"init(kind:number:smufl:position:placement:color:trillSound:)","kind":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLWavyLine\/init(kind:number:smufl:position:placement:color:trillSound:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"kind","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLStartStopContinue","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL20MXLStartStopContinueO"},{"text":", ","kind":"text"},{"text":"number",