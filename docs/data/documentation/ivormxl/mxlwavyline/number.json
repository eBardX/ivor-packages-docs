url":"\/documentation\/ivormxl\/mxlwavyline","role":"symbol","title":"MXLWavyLine","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLWavyLine","type":"topic","abstract":[{"type":"text","text":"Wavy lines are one way to indicate trills and vibrato. When used with a barline element, they should always"},{"type":"text","text":" "},{"type":"text","text":"have type=“continue” set. The smufl attribute specifies a particular wavy line glyph from the SMuFL Multi-"},{"type":"text","text":" "},{"type":"text","text":"segment lines range."}]},"doc://IvorMXL/documentation/IvorMXL/MXLWavyLine/number":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLWavyLine\/number","type":"topic","kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"number","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLNumberLevel","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL14MXLNumberLevelV"},{"text":"?","kind":"text"}],"title":"number","role":"symbol","url":"\/documentation\/ivormxl\/mxlwavyline\/number","abstract":[{"text":"Distinguishes this wavy line from other wavy lines that might be active at the same time.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLNumberLevel":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumberLevel","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLNumberLevel"}],"abstract":[{"type":"text","text":"Slurs, tuplets, and many other features can be concurrent and overlap within a single musical part. The"},{"type":"text","text":" "},{"type":"text","text":"number-level entity distinguishes up to 16 concurrent objects of the same type when the objects overlap in"},{"type":"text","text":" "},{"type":"text","text":"MusicXML document order. Values greater than 6 are usually only needed for music with a large number of divisi"},{"type":"text","text":" "},{"type":"text","text":"staves in a single part, or if there are more than 6 cross-staff arpeggios in a single measure. When a number-"},{"type":"text","text":" "},{"type":"text","text":"level value is implied, the value is 1 by default."}],"kind":"symbol","title":"MXLNumberLevel","url":"\/documentation\/ivormxl\/mxlnumberlevel","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNumberLevel"}]}}}