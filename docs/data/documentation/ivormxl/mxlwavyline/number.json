ier","text":"number"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL14MXLNumberLevelV","kind":"typeIdentifier","text":"MXLNumberLevel"},{"text":"?","kind":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLWavyLine\/number","abstract":[{"type":"text","text":"Distinguishes this wavy line from other wavy lines that might be active at the same time."}]},"doc://IvorMXL/documentation/IvorMXL/MXLWavyLine":{"abstract":[{"text":"Wavy lines are one way to indicate trills and vibrato. When used with a barline element, they should always","type":"text"},{"text":" ","type":"text"},{"text":"have type=“continue” set. The smufl attribute specifies a particular wavy line glyph from the SMuFL Multi-","type":"text"},{"text":" ","type":"text"},{"text":"segment lines range.","type":"text"}],"title":"MXLWavyLine","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLWavyLine"}],"navigatorTitle":[{"kind":"identifier","text":"MXLWavyLine"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlwavyline","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLWavyLine"},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLNumberLevel":{"title":"MXLNumberLevel","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNumberLevel"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlnumberlevel","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumberLevel","abstract":[{"text":"Slurs, tuplets, and many other features can be concurrent and overlap within a single musical part. The","type":"text"},{"text":" ","type":"text"},{"text":"number-level entity distinguishes up to 16 concurrent objects of the same type when the objects overlap in","type":"text"},{"text":" ","type":"text"},{"text":"MusicXML document order. Values greater than 6 are usually only needed for music with a large number of divisi","type":"text"},{"text":" ","type":"text"},{"text":"staves in a single part, or if there are more than 6 cross-staff arpeggios in a single measure. When a number-","type":"text"},{"text":" ","type":"text"},{"text":"level value is implied, the value is 1 by default.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"MXLNumberLevel"}]}}}