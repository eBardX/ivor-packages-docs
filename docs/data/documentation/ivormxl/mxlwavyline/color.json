nd":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL8MXLColorV","kind":"typeIdentifier","text":"MXLColor"},{"kind":"text","text":"?"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlwavyline\/color","abstract":[{"type":"text","text":"The color attribute group indicates the color of an element."}]},"doc://IvorMXL/documentation/IvorMXL/MXLWavyLine":{"abstract":[{"text":"Wavy lines are one way to indicate trills and vibrato. When used with a barline element, they should always","type":"text"},{"text":" ","type":"text"},{"text":"have type=“continue” set. The smufl attribute specifies a particular wavy line glyph from the SMuFL Multi-","type":"text"},{"text":" ","type":"text"},{"text":"segment lines range.","type":"text"}],"title":"MXLWavyLine","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLWavyLine"}],"navigatorTitle":[{"kind":"identifier","text":"MXLWavyLine"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlwavyline","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLWavyLine"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"abstract":[{"text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in","type":"text"},{"type":"text","text":" "},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"title":"MXLColor","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlcolor","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor"}}}