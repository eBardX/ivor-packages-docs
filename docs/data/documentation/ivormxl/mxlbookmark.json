ion\/IvorMXL\/MXLBookmark\/elementPosition","kind":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"elementPosition"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL18MXLElementPositionV","kind":"typeIdentifier","text":"MXLElementPosition"}],"title":"elementPosition","abstract":[{"text":"The element and position attributes are new as of Version 2.0. They allow for bookmarks and links to be","type":"text"},{"text":" ","type":"text"},{"text":"positioned at higher resolution than the level of music-data elements. When no element and position attributes","type":"text"},{"text":" ","type":"text"},{"text":"are present, the bookmark or link element refers to the next sibling element in the MusicXML file. The element","type":"text"},{"text":" ","type":"text"},{"text":"attribute specifies an element type for a descendant of the next sibling element that is not a link or","type":"text"},{"text":" ","type":"text"},{"text":"bookmark. The position attribute specifies the position of this descendant element, where the first position","type":"text"},{"text":" ","type":"text"},{"text":"is 1. The position attribute is ignored if the element attribute is not present. For instance, an element","type":"text"},{"text":" ","type":"text"},{"text":"value of “beam” and a position value of “2” defines the link or bookmark to refer to the second beam","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"descendant of the next sibling element that is not a link or bookmark. This is equivalent to an XPath test of"},{"type":"text","text":" "},{"type":"text","text":"[.\/\/beam[2]] done in the context of the sibling element."}],"type":"topic","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLBookmark":{"title":"MXLBookmark","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLBookmark","kind":"identifier"}],"kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxlbookmark","abstract":[{"text":"The bookmark type serves as a well-defined target for an incoming simple XLink.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBookmark","navigatorTitle":[{"text":"MXLBookmark","kind":"identifier"}]}}}