{"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"The bookmark type serves as a well-defined target for an incoming simple XLink."}],"topicSections":[{"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBookmark\/init(id:name:elementPosition:)"],"generated":true},{"anchor":"Instance-Properties","title":"Instance Properties","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBookmark\/elementPosition","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBookmark\/id","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBookmark\/name"],"generated":true},{"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBookmark\/Equatable-Implementations"],"generated":true,"anchor":"Default-Implementations","title":"Default Implementations"}],"metadata":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLBookmark"}],"symbolKind":"struct","externalID":"s:7IvorMXL11MXLBookmarkV","role":"symbol","roleHeading":"Structure","navigatorTitle":[{"kind":"identifier","text":"MXLBookmark"}],"title":"MXLBookmark","modules":[{"name":"IvorMXL"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlbookmark"]}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBookmark","interfaceLanguage":"swift"},"sections":[],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLBookmark"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"inlineContent":[{"type":"text","text":"Maps the MusicXML "},{"type":"codeVoice","code":"<bookmark>"},{"type":"text","text":" element."}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL"]]},"relationshipsSections":[{"identifiers":["doc:\/\/IvorMXL\/s8CopyableP","doc:\/\/IvorMXL\/SQ","doc:\/\/IvorMXL\/s9EscapableP","doc:\/\/IvorMXL\/SH","doc:\/\/IvorMXL\/s8SendableP","doc:\/\/IvorMXL\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships","title":"Conforms To"}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLBookmark/elementPosition":{"type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"elementPosition","kind":"identifier"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"MXLElementPosition","preciseIdentifier":"s:7IvorMXL18MXLElementPositionV"}],"abstract":[{"type":"text","text":"The element and position attributes are new as of Version 2.0. They allow for bookmarks and links to be"},{"type":"text","text":" "},{"text":"positioned at higher resolution than the level of music-data elements. When no element and position attributes","type":"text"},{"text":" ","type":"text"},{"text":"are present, the bookmark or link element refers to the next sibling element in the MusicXML file. The element","type":"text"},{"text":" ","type":"text"},{"text":"attribute specifies an element type for a descendant of the next sibling element that is not a link or","type":"text"},{"text":" ","type":"text"},{"text":"bookmark. The position attribute specifies the position of this descendant element, where the first position","type":"text"},{"text":" ","type":"text"},{"text":"is 1. The position attribute is ignored if the element attribute is not present. For instance, an element","type":"text"},{"text":" ","type":"text"},{"text":"value of “beam” and a position value of “2” defines the link or bookmark to refer to the second beam","type":"text"},{"text":" ","type":"text"},{"text":"descendant of the next sibling element that is not a link or bookmark. This is equivalent to an XPath test of","type":"text"},{"text":" ","type":"text"},{"text":"[.\/\/beam[2]] done in the context of the sibling element.","type":"text"}],"identifier":"doc:\