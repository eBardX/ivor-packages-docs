scendant element, where the first position","type":"text"},{"text":" ","type":"text"},{"text":"is 1. The position attribute is ignored if the element attribute is not present. For instance, an element","type":"text"},{"text":" ","type":"text"},{"text":"value of “beam” and a position value of “2” defines the link or bookmark to refer to the second beam","type":"text"},{"text":" ","type":"text"},{"text":"descendant of the next sibling element that is not a link or bookmark. This is equivalent to an XPath test of","type":"text"},{"text":" ","type":"text"},{"text":"[.\/\/beam[2]] done in the context of the sibling element.","type":"text"}],"title":"elementPosition","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBookmark\/elementPosition","url":"\/documentation\/ivormxl\/mxlbookmark\/elementposition","kind":"symbol","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"elementPosition"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLElementPosition","preciseIdentifier":"s:7IvorMXL18MXLElementPositionV"}]},"doc://IvorMXL/SH":{"type":"unresolvable","title":"Swift.Hashable","identifier":"doc:\/\/IvorMXL\/SH"},"doc://IvorMXL/s8SendableP":{"type":"unresolvable","title":"Swift.Sendable","identifier":"doc:\/\/IvorMXL\/s8SendableP"},"doc://IvorMXL/documentation/IvorMXL/MXLBookmark":{"type":"topic","title":"MXLBookmark","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"kind":"identifier","text":"MXLBookmark"}],"url":"\/documentation\/ivormxl\/mxlbookmark","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBookmark","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"MXLBookmark","kind":"identifier"}],"abstract":[{"text":"The bookmark type serves as a well-defined target for an incoming simple XLink.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collectio