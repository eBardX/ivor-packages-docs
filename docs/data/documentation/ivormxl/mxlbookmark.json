lementPosition","abstract":[{"type":"text","text":"The element and position attributes are new as of Version 2.0. They allow for bookmarks and links to be"},{"type":"text","text":" "},{"type":"text","text":"positioned at higher resolution than the level of music-data elements. When no element and position attributes"},{"type":"text","text":" "},{"type":"text","text":"are present, the bookmark or link element refers to the next sibling element in the MusicXML file. The element"},{"type":"text","text":" "},{"type":"text","text":"attribute specifies an element type for a descendant of the next sibling element that is not a link or"},{"type":"text","text":" "},{"type":"text","text":"bookmark. The position attribute specifies the position of this descendant element, where the first position"},{"type":"text","text":" "},{"type":"text","text":"is 1. The position attribute is ignored if the element attribute is not present. For instance, an element"},{"type":"text","text":" "},{"type":"text","text":"value of “beam” and a position value of “2” defines the link or bookmark to refer to the second beam"},{"type":"text","text":" "},{"type":"text","text":"descendant of the next sibling element that is not a link or bookmark. This is equivalent to an XPath test of"},{"type":"text","text":" "},{"type":"text","text":"[.\/\/beam[2]] done in the context of the sibling element."}],"kind":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBookmark\/elementPosition"},"doc://IvorMXL/documentation/IvorMXL/MXLBookmark/id":{"url":"\/documentation\/ivormxl\/mxlbookmark\/id","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBookmark\/id","kind":"symbol","type":"topic","role":"symbol","abstract":[{"type":"text","text":"A unique identifier for this bookmark, used as the target of an incoming XLink."}],"title":"id","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"id","kind":"identifier"},{"text":": ","kind":"text"},{"text":"St