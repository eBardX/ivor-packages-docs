{"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrincipalVoice"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlprincipalvoice\/halign"]}],"sections":[],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrincipalVoice\/halign"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"halign"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLeftCenterRight","preciseIdentifier":"s:7IvorMXL18MXLLeftCenterRightO","text":"MXLLeftCenterRight"},{"kind":"text","text":"?"}],"languages":["swift"]}]},{"content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Words and music by Pat Songwriter"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Typically this type of credit is aligned to the right, so that the position information refers to the right-"},{"type":"text","text":" "},{"type":"text","text":"most part of the text. But in this example, the text is center-justified, not right-justified."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The halign attribute is used in these situations. If it is not present, its value is the same as for the"},{"type":"text","text":" "},{"type":"text","text":"justify attribute. For elements where a justify attribute is not allowed, the default is implementation-"},{"type":"text","text":" "},{"type":"text","text":"dependent."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Maps to the MusicXML "},{"type":"codeVoice","code":"halign"},{"type":"text","text":" attribute."}],"type":"paragraph"}],"kind":"content"}],"metadata":{"externalID":"s:7IvorMXL17MXLPrincipalVoiceV6halignAA18MXLLef