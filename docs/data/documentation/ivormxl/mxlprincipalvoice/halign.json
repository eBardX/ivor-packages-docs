{"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"text":"In cases where text extends over more than one line, horizontal alignment and justify values can be different.","type":"text"},{"text":" ","type":"text"},{"text":"The most typical case is for credits, such as:","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlprincipalvoice\/halign"]}],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"halign","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL18MXLLeftCenterRightO","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLeftCenterRight","text":"MXLLeftCenterRight","kind":"typeIdentifier"},{"text":"?","kind":"text"}]}]},{"content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"inlineContent":[{"text":"Words and music by Pat Songwriter","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Typically this type of credit is aligned to the right, so that the position information refers to the right-","type":"text"},{"text":" ","type":"text"},{"text":"most part of the text. But in this example, the text is center-justified, not right-justified.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The halign attribute is used in these situations. If it is not present, its value is the same as for the","type":"text"},{"text":" ","type":"text"},{"text":"justify attribute. For elements where a justify attribute is not allowed, the default is implementation-","type":"text"},{"text":" ","type":"text"},{"text":"dependent.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Maps to the MusicXML ","type":"text"},{"code":"halign","type":"codeVoice"},{"text":" attribute.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/IvorMX