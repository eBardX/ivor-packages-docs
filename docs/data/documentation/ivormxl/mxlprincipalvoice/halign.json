","text":" "},{"type":"text","text":"The most typical case is for credits, such as:"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLPrincipalVoice":{"type":"topic","title":"MXLPrincipalVoice","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrincipalVoice","abstract":[{"text":"The principal-voice type represents principal and secondary voices in a score, either for analysis or for","type":"text"},{"text":" ","type":"text"},{"text":"square bracket symbols that appear in a score. The element content is used for analysis and may be any text","type":"text"},{"text":" ","type":"text"},{"text":"value. The symbol attribute indicates the type of symbol used. When used for analysis separate from any","type":"text"},{"text":" ","type":"text"},{"text":"printed score markings, it should be set to none. Otherwise if the type is stop it should be set to plain.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPrincipalVoice"}],"navigatorTitle":[{"kind":"identifier","text":"MXLPrincipalVoice"}],"url":"\/documentation\/ivormxl\/mxlprincipalvoice"}}}