":"text","text":" "},{"text":"most part of the text. But in this example, the text is center-justified, not right-justified.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The halign attribute is used in these situations. If it is not present, its value is the same as for the"},{"type":"text","text":" "},{"type":"text","text":"justify attribute. For elements where a justify attribute is not allowed, the default is implementation-"},{"type":"text","text":" "},{"type":"text","text":"dependent."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Maps to the MusicXML "},{"type":"codeVoice","code":"halign"},{"type":"text","text":" attribute."}]}],"kind":"content"}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLLeftCenterRight":{"type":"topic","kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLLeftCenterRight","kind":"identifier"}],"navigatorTitle":[{"text":"MXLLeftCenterRight","kind":"identifier"}],"abstract":[{"text":"The left-center-right type is used to define horizontal alignment and text justification.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLeftCenterRight","title":"MXLLeftCenterRight","role":"symbol","url":"\/documentation\/ivormxl\/mxlleftcenterright"},"doc://IvorMXL/documentation/IvorMXL/MXLPrincipalVoice/halign":{"type":"topic","url":"\/documentation\/ivormxl\/mxlprincipalvoice\/halign","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrincipalVoice\/halign","title":"halign","kind":"symbol","abstract":[{"text":"In cases where text extends over more than one line, horizontal alignment and justify values can be different.","type":"text"},{"text":" ","type":"text"},{"text":"The most typical case is for credits, such as:","type":"text"}],"role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"halign","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL18MXLLeftCenterRightO","text":"MXLLeftCenterRight","kind":"typeIdentifier"},{"text":"?","kind":"text"}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLPrincipalVoice":{"role":"symbol","kind":"symbol","title":"MXLPrincipalVoice","url":"\/documentation\/ivormxl\/mxlprincipalvoice","abstract":[{"type":"text","text":"The principal-voice type represents principal and secondary voices in a score, either for analysis or for"},{"type":"text","text":" "},{"type":"text","text":"square bracket symbols that appear in a score. The element content is used for analysis and may be any text"},{"type":"text","text":" "},{"type":"text","text":"value. The symbol attribute indicates the type of symbol used. When used for analysis separate from any"},{"type":"text","text":" "},{"type":"text","text":"printed score markings, it should be set to none. Otherwise if the type is stop it should be set to plain."}],"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPrincipalVoice"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrincipalVoice","navigatorTitle":[{"kind":"identifier","text":"MXLPrincipalVoice"}]}}}