{"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrincipalVoice"]]},"sections":[],"metadata":{"roleHeading":"Instance Property","symbolKind":"property","externalID":"s:7IvorMXL17MXLPrincipalVoiceV6halignAA18MXLLeftCenterRightOSgvp","title":"halign","role":"symbol","modules":[{"name":"IvorMXL"}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"halign"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLLeftCenterRight","preciseIdentifier":"s:7IvorMXL18MXLLeftCenterRightO"},{"kind":"text","text":"?"}]},"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrincipalVoice\/halign","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"halign"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLeftCenterRight","text":"MXLLeftCenterRight","preciseIdentifier":"s:7IvorMXL18MXLLeftCenterRightO"},{"kind":"text","text":"?"}],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Words and music by Pat Songwriter"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Typically this type of credit is aligned to the right, so that the position information refers to the right-"},{"type":"text","text":" "},{"type":"text","text":"most part of the text. But in this example, the text is center-justified, not right-justified."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The halign attribute is used in these situations. If it is not present, its value is the same as for the"},{"type":"text","text":" "},{"type":"text","text":"justify attribute. For elements where a justify attribute is not allowed, the default is implementation-"},{"type":"text","text":" "},{"type":"text","text":"dependent."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Maps to the MusicXML "},{"code":"halign","type":"codeVoice"},{"type":"text","text":" attribute."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlprincipalvoice\/halign"]}],"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"In cases where text extends over more than one line, horizontal alignment and justify values can be different."},{"type":"text","text":" "},{"type":"text","text":"The most typical case is for credits, such as:"}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLPrincipalVoice/halign":{"title":"halign","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrincipalVoice\/halign","role":"symbol","url":"\/documentation\/ivormxl\/mxlprincipalvoice\/halign","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"halign"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLLeftCenterRight","preciseIdentifier":"s:7IvorMXL18MXLLeftCenterRightO"},{"kind":"text","text":"?"}],"abstract":[{"type":"text","text":"In cases where text extends over more than one line, horizontal alignment and justify values can be different."},{"type":"text","text":" "},{"type":"text","text":"The most typical case is for credits, such as:"}],"kind":"symbol","type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLLeftCenterRight":{"url":"\/documentation\/ivormxl\/mxlleftcenterright","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLeftCenterRight","abstract":[{"type":"text","text":"The left-center-right type is used to define horizontal alignment and text justification."}],"title":"MXLLeftCenterRight","kind":"symbol","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLLeftCenterRight"}],"navigatorTitle":[{"kind":"identifier","text":"MXLLeftCenterRight"}]},"doc://IvorMXL/documentation/IvorMXL/MXLPrincipalVoice":{"title":"MXLPrincipalVoice","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPrincipalVoice","kind":"identifier"}],"abstract":[{"type":"text","text":"The principal-voice type represents principal and secondary voices in a score, either for analysis or for"},{"type":"text","text":" "},{"type":"text","text":"square bracket symbols that appear in a score. The element content is used for analysis and may be any text"},{"type":"text","text":" "},{"type":"text","text":"value. The symbol attribute indicates the type of symbol used. When used for analysis separate from any"},{"type":"text","text":" "},{"type":"text","text":"printed score markings, it should be set to none. Otherwise if the type is stop it should be set to plain."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrincipalVoice","role":"symbol","navigatorTitle":[{"text":"MXLPrincipalVoice","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlprincipalvoice"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"}}}