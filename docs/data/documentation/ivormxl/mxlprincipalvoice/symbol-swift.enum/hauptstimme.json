L","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLPrincipalVoice":{"title":"MXLPrincipalVoice","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPrincipalVoice","kind":"identifier"}],"abstract":[{"type":"text","text":"The principal-voice type represents principal and secondary voices in a score, either for analysis or for"},{"type":"text","text":" "},{"type":"text","text":"square bracket symbols that appear in a score. The element content is used for analysis and may be any text"},{"type":"text","text":" "},{"type":"text","text":"value. The symbol attribute indicates the type of symbol used. When used for analysis separate from any"},{"type":"text","text":" "},{"type":"text","text":"printed score markings, it should be set to none. Otherwise if the type is stop it should be set to plain."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrincipalVoice","role":"symbol","navigatorTitle":[{"text":"MXLPrincipalVoice","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlprincipalvoice"},"doc://IvorMXL/documentation/IvorMXL/MXLPrincipalVoice/Symbol-swift.enum":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlprincipalvoice\/symbol-swift.enum","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrincipalVoice\/Symbol-swift.enum","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Symbol"}],"abstract":[{"type":"text","text":"The principal-voice-symbol type represents the type of symbol used to indicate a principal or secondary voice."},{"type":"text","text":" "},{"type":"text","text":"The “plain” value represents a plain square bracket. The value of “none” is used for analysis markup when the"},{"type":"text","text":" "},{"type":"text","text":"principal-voice element does not have a corresponding appearance in the score."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Symbol"}],"title":"MXLPrincipalVoice.Symbol"}}}