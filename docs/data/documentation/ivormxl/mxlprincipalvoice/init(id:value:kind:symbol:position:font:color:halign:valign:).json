ext","text":"are implementation-dependent."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValign","role":"symbol","url":"\/documentation\/ivormxl\/mxlvalign","kind":"symbol","navigatorTitle":[{"text":"MXLValign","kind":"identifier"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLLeftCenterRight":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLLeftCenterRight"}],"title":"MXLLeftCenterRight","abstract":[{"text":"The left-center-right type is used to define horizontal alignment and text justification.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLeftCenterRight","role":"symbol","url":"\/documentation\/ivormxl\/mxlleftcenterright","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLLeftCenterRight"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLStartStop":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStartStop","navigatorTitle":[{"text":"MXLStartStop","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlstartstop","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLStartStop","kind":"identifier"}],"title":"MXLStartStop","abstract":[{"text":"The start-stop type is used for an attribute of musical elements that can either start or stop, such as","type":"text"},{"text":" ","type":"text"},{"text":"tuplets.","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLPosition":{"type":"topic","abstract":[{"type":"text","text":"For most elements, any program will compute a default x and y position. The position attributes let this be"},{"type":"text","text":" "},{"type":"text","text":"changed two ways."}],"url":"\/documentation\/ivormxl\/mxlposition","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPosition"}],"kind":"symbol","title":"MXLPosition","navigatorTitle":[{"kind":"identifier","text":"MXLPosition"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLFont":{"type":"topic","title":"MXLFont","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","abstract":[{"type":"text","text":"The font attribute group gathers together attributes for determining the font within a credit or direction."},{"type":"text","text":" "},{"type":"text","text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of"},{"type":"text","text":" "},{"type":"text","text":"font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric"},{"type":"text","text":" "},{"type":"text","text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font"},{"type":"text","text":" "},{"type":"text","text":"vs. a music font."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFont"}],"navigatorTitle":[{"kind":"identifier","text":"MXLFont"}],"url":"\/documentation\/ivormxl\/mxlfont"}}}