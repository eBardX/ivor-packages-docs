e alignment refers to the baseline of the lowest line of text. Defaults","type":"text"},{"text":" ","type":"text"},{"text":"are implementation-dependent.","type":"text"}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLValign"}],"title":"MXLValign"},"doc://IvorMXL/documentation/IvorMXL/MXLPrincipalVoice":{"title":"MXLPrincipalVoice","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPrincipalVoice","kind":"identifier"}],"abstract":[{"type":"text","text":"The principal-voice type represents principal and secondary voices in a score, either for analysis or for"},{"type":"text","text":" "},{"type":"text","text":"square bracket symbols that appear in a score. The element content is used for analysis and may be any text"},{"type":"text","text":" "},{"type":"text","text":"value. The symbol attribute indicates the type of symbol used. When used for analysis separate from any"},{"type":"text","text":" "},{"type":"text","text":"printed score markings, it should be set to none. Otherwise if the type is stop it should be set to plain."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrincipalVoice","role":"symbol","navigatorTitle":[{"text":"MXLPrincipalVoice","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlprincipalvoice"},"doc://IvorMXL/documentation/IvorMXL/MXLPrincipalVoice/Symbol-swift.enum":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlprincipalvoice\/symbol-swift.enum","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrincipalVoice\/Symbol-swift.enum","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Symbol"}],"abstract":[{"type":"text","text":"The principal-voice-symbol type represents the type of symbol used to indicate a principal or secondary voice."},{"type":"text","text":" "},{"type":"text","text":"The “plain” value represents a plain square bracket. The value of “none” is used for analysis markup when the"},{"type":"text","text":" "},{"type":"text","text":"principal-voice element does not have a corresponding appearance in the score."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Symbol"}],"title":"MXLPrincipalVoice.Symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLPrincipalVoice/init(id:value:kind:symbol:position:font:color:halign:valign:)":{"title":"init(id:value:kind:symbol:position:font:color:halign:valign:)","type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlprincipalvoice\/init(id:value:kind:symbol:position:font:color:halign:valign:)","role":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"id"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"value"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam","text":"kind"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLStartStop","preciseIdentifier":"s:7IvorMXL12MXLStartStopO"},{"kind":"text","text":", "},{"kind":"externalParam","text":"symbol"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Symbol","preciseIdentifier":"s:7IvorMXL17MXLPrincipalVoiceV6SymbolO"},{"kind":"text","text":", "},{"kind":"externalParam","text":"position"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLPosition","preciseIdentifier":"s:7IvorMXL11MXLPositionV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"font"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLFont","preciseIdentifier":"s:7IvorMXL7MXLFontV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"color"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLColor","preciseIdentifier":"s:7IvorMXL8MXLColorV"},{"kind":"text","text":"?, "},{"kind":