","role":"symbol","url":"\/documentation\/ivormxl\/mxlleftcenterright"},"doc://IvorMXL/documentation/IvorMXL/MXLPrincipalVoice/Symbol-swift.enum":{"navigatorTitle":[{"text":"Symbol","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlprincipalvoice\/symbol-swift.enum","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrincipalVoice\/Symbol-swift.enum","title":"MXLPrincipalVoice.Symbol","kind":"symbol","abstract":[{"text":"The principal-voice-symbol type represents the type of symbol used to indicate a principal or secondary voice.","type":"text"},{"text":" ","type":"text"},{"text":"The “plain” value represents a plain square bracket. The value of “none” is used for analysis markup when the","type":"text"},{"text":" ","type":"text"},{"text":"principal-voice element does not have a corresponding appearance in the score.","type":"text"}],"role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Symbol","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLPosition":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLPosition"}],"abstract":[{"text":"For most elements, any program will compute a default x and y position. The position attributes let this be","type":"text"},{"text":" ","type":"text"},{"text":"changed two ways.","type":"text"}],"kind":"symbol","title":"MXLPosition","url":"\/documentation\/ivormxl\/mxlposition","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPosition"}]},"doc://IvorMXL/documentation/IvorMXL/MXLFont":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLFont"}],"abstract":[{"text":"The font attribute group gathers together attributes for determining the font within a credit or direction.","type":"text"},{"text":" ","type":"text"},{"text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of","type":"text"},{"text":" ","type":"text"},{"text":"font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric","type":"text"},{"text":" ","type":"text"},{"text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font","type":"text"},{"text":" ","type":"text"},{"text":"vs. a music font.","type":"text"}],"kind":"symbol","title":"MXLFont","url":"\/documentation\/ivormxl\/mxlfont","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFont"}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLColor","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","title":"MXLColor","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlcolor"},"doc://IvorMXL/documentation/IvorMXL/MXLStartStop":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStartStop","url":"\/documentation\/ivormxl\/mxlstartstop","abstract":[{"text":"The start-stop type is used for an attribute of musical elements that can either start or stop, such as","type":"text"},{"text":" ","type":"text"},{"text":"tuplets.","type":"text"}],"type":"topic","role":"symbol","kind":"symbol","title":"MXLStartStop","navigatorTitle":[{"kind":"identifier","text":"MXLStartStop"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLStartStop"}]},"doc://IvorMXL/documentation/IvorMXL/MXLPrincipalVoice":{"role":"symbol","kind":"symbol","title":"MXLPrincipalVoice","url":"\/documentation\/ivormxl\/mxlprincipalvoice","abstract":[{"type":"text","text":"The principal-voice type represents principal and secondary voices in a score, either for analysis or for"},{"type":"text","text":" "},{"type":"text","text":"square bracket symbols that appear in a score. The element content is used for analysis and may be any text"},{"type":"text","text":" "},{"type":"text","text":"value. The symbol attribute indicates the type of symbol used. When used for analysis separate from any"},{"type":"text","text":" "},{"type":"text","text":"printed score markings, it should be set to none. Otherwise if the type is stop it should be set to plain."}],"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPrincipalVoice"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrincipalVoice","navigatorTitle":[{"kind":"identifier","text":"MXLPrincipalVoice"}]},"doc://IvorMXL/documentation/IvorMXL/MXLPrincipalVoice/init(id:value:kind:symbol:position:font:color:halign:valign:)":{"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrincipalVoice\/init(id:value:kind:symbol:position:font:color:halign:valign:)","url":"\/documentation\/ivormxl\/mxlprincipalvoice\/init(id:value:kind:symbol:position:font:color:halign:valign:)","title":"init(id:value:kind:symbol:position:font:color:ha