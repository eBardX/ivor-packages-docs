e is used to indicate vertical alignment to the top, middle, bottom, or baseline of the text. If","type":"text"},{"text":" ","type":"text"},{"text":"the text is on multiple lines, baseline alignment refers to the baseline of the lowest line of text. Defaults","type":"text"},{"text":" ","type":"text"},{"text":"are implementation-dependent.","type":"text"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLValign"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLValign"}],"type":"topic","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValign"},"doc://IvorMXL/documentation/IvorMXL/MXLPrincipalVoice/Symbol-swift.enum":{"title":"MXLPrincipalVoice.Symbol","abstract":[{"text":"The principal-voice-symbol type represents the type of symbol used to indicate a principal or secondary voice.","type":"text"},{"text":" ","type":"text"},{"text":"The “plain” value represents a plain square bracket. The value of “none” is used for analysis markup when the","type":"text"},{"text":" ","type":"text"},{"text":"principal-voice element does not have a corresponding appearance in the score.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlprincipalvoice\/symbol-swift.enum","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Symbol"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Symbol"}],"type":"topic","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrincipalVoice\/Symbol-swift.enum"},"doc://IvorMXL/documentation/IvorMXL/MXLPosition":{"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPosition","kind":"identifier"}],"title":"MXLPosition","navigatorTitle":[{"text":"MXLPosition","kind":"identifier"}],"abstract":[{"type":"text","text":"For most elements, any program will compute a default x and y position. The position attributes let this be"},{"type":"text","text":" "},{"type":"text","text":"changed two ways."}],"url":"\/documentation\/ivormxl\/mxlposition","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLPrincipalVoice":{"title":"MXLPrincipalVoice","abstract":[{"text":"The principal-voice type represents principal and secondary voices in a score, either for analysis or for","type":"text"},{"text":" ","type":"text"},{"text":"square bracket symbols that appear in a score. The element content is used for analysis and may be any text","type":"text"},{"text":" ","type":"text"},{"text":"value. The symbol attribute indicates the type of symbol used. When used for analysis separate from any","type":"text"},{"text":" ","type":"text"},{"text":"printed score markings, it should be set to none. Otherwise if the type is stop it should be set to plain.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlprincipalvoice","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPrincipalVoice"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLPrincipalVoice"}],"type":"topic","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrincipalVoice"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLStartStop":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlstartstop","title":"MXLStartStop","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLStartStop","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"MXLStartStop"}],"abstract":[{"type":"text","text":"The start-stop type is used for an attribute of musical elements that can either start or stop, such as"},{"type":"text","text":" "},{"type":"text","text":"tuplets."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStartStop"},"doc://IvorMXL/documentation/IvorMXL/MXLFont":{"title":"MXLFont","url":"\/documentation\/ivormxl\/mxlfont","role":"symbol","navigatorTitle":[{"text":"MXLFont","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","abstract":[{"text":"The font attribute group gathers together attributes for determining the font within a credit or direction.","type":"text"},{"text":" ","type":"text"},{"text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric"},{"type":"text","text":" "},{"type":"text","text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font"},{"type":"text","text":" "},{"type":"text","text":"vs. a music font."}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLFont","kind":"identifier"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLLeftCenterRight":{"title":"MXLLeftCenterRight","url":"\/documentation\/ivormxl\/mxlleftcenterright","role":"symbol","navigatorTitle":[{"text":"MXLLeftCenterRight","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLeftCenterRight","abstract":[{"text":"The left-center-right type is used to define horizontal alignment and text justification.","type":"text"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"text":" ","kind":"text"},{"text":"MXLLeftCenterRight","kind":"identifier"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlcolor","title":"MXLColor","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"type":"text","text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is"},{"type":"text","text":" "},{"type":"text","text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor"}}}