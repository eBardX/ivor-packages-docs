Voice","abstract":[{"type":"text","text":"The principal-voice type represents principal and secondary voices in a score, either for analysis or for"},{"text":" ","type":"text"},{"type":"text","text":"square bracket symbols that appear in a score. The element content is used for analysis and may be any text"},{"type":"text","text":" "},{"type":"text","text":"value. The symbol attribute indicates the type of symbol used. When used for analysis separate from any"},{"type":"text","text":" "},{"text":"printed score markings, it should be set to none. Otherwise if the type is stop it should be set to plain.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"MXLPrincipalVoice"}]},"doc://IvorMXL/documentation/IvorMXL/MXLValign":{"abstract":[{"type":"text","text":"The valign type is used to indicate vertical alignment to the top, middle, bottom, or baseline of the text. If"},{"text":" ","type":"text"},{"text":"the text is on multiple lines, baseline alignment refers to the baseline of the lowest line of text. Defaults","type":"text"},{"text":" ","type":"text"},{"text":"are implementation-dependent.","type":"text"}],"title":"MXLValign","kind":"symbol","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLValign","kind":"identifier"}],"navigatorTitle":[{"text":"MXLValign","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlvalign","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValign"},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLPrincipalVoice/Symbol-swift.enum":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrincipalVoice\/Symbol-swift.enum","title":"MXLPrincipalVoice.Symbol","kind":"symbol","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Symbol","kind":"identifier"}],"navigatorTitle":[{"text":"Symbol","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlprincipalvoice\/symbol-swift.enum","abstract":[{"type":"text","text":"The principal-voice-symbol type represents the type of symbol used to indicate a principal or secondary voice."},{"type":"text","text":" "},{"type":"text","text":"The “plain” value represents a plain square bracket. The value of “none” is used for analysis markup when the"},{"type":"text","text":" "},{"type":"text","text":"principal-voice element does not have a corresponding appearance in the score."}]}}}