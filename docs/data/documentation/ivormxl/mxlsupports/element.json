tifier"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLSupports":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSupports","type":"topic","navigatorTitle":[{"text":"MXLSupports","kind":"identifier"}],"abstract":[{"type":"text","text":"The supports type indicates if a MusicXML encoding supports a particular MusicXML element. This is recommended"},{"type":"text","text":" "},{"type":"text","text":"for elements like beam, stem, and accidental, where the absence of an element is ambiguous if you do not know"},{"type":"text","text":" "},{"type":"text","text":"if the encoding supports that element. For Version 2.0, the supports element is expanded to allow programs to"},{"type":"text","text":" "},{"type":"text","text":"indicate support for particular attributes or particular values. This lets applications communicate, for"},{"type":"text","text":" "},{"type":"text","text":"example, that all system and\/or page breaks are contained in the MusicXML file."}],"title":"MXLSupports","kind":"symbol","url":"\/documentation\/ivormxl\/mxlsupports","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSupports","kind":"identifier"}]}}}