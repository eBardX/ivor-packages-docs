pe indicates if a MusicXML encoding supports a particular MusicXML element. This is recommended","type":"text"},{"text":" ","type":"text"},{"text":"for elements like beam, stem, and accidental, where the absence of an element is ambiguous if you do not know","type":"text"},{"text":" ","type":"text"},{"text":"if the encoding supports that element. For Version 2.0, the supports element is expanded to allow programs to","type":"text"},{"text":" ","type":"text"},{"text":"indicate support for particular attributes or particular values. This lets applications communicate, for","type":"text"},{"text":" ","type":"text"},{"text":"example, that all system and\/or page breaks are contained in the MusicXML file.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlsupports","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSupports","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLSupports/isSupported":{"kind":"symbol","title":"isSupported","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSupports\/isSupported","type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlsupports\/issupported","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"isSupported"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"abstract":[{"type":"text","text":"A Boolean value indicating whether the encoding does ("},{"type":"codeVoice","code":"true"},{"type":"text","text":") or does not ("},{"type":"codeVoice","code":"false"},{"type":"text","text":") support the element."}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"}}}