oc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSupports\/isSupported","type":"topic","abstract":[{"type":"text","text":"A Boolean value indicating whether the encoding does ("},{"code":"true","type":"codeVoice"},{"type":"text","text":") or does not ("},{"code":"false","type":"codeVoice"},{"text":") support the element.","type":"text"}],"role":"symbol","title":"isSupported","url":"\/documentation\/ivormxl\/mxlsupports\/issupported"},"doc://IvorMXL/documentation/IvorMXL/MXLSupports":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSupports","role":"symbol","navigatorTitle":[{"text":"MXLSupports","kind":"identifier"}],"type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSupports","kind":"identifier"}],"abstract":[{"type":"text","text":"The supports type indicates if a MusicXML encoding supports a particular MusicXML element. This is recommended"},{"type":"text","text":" "},{"type":"text","text":"for elements like beam, stem, and accidental, where the absence of an element is ambiguous if you do not know"},{"type":"text","text":" "},{"type":"text","text":"if the encoding supports that element. For Version 2.0, the supports element is expanded to allow programs to"},{"type":"text","text":" "},{"type":"text","text":"indicate support for particular attributes or particular values. This lets applications communicate, for"},{"type":"text","text":" "},{"type":"text","text":"example, that all system and\/or page breaks are contained in the MusicXML file."}],"url":"\/documentation\/ivormxl\/mxlsupports","title":"MXLSupports"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]}}}