lement."}],"role":"symbol","kind":"symbol","title":"isSupported","type":"topic","url":"\/documentation\/ivormxl\/mxlsupports\/issupported","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSupports\/isSupported","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"isSupported"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLSupports":{"type":"topic","abstract":[{"type":"text","text":"The supports type indicates if a MusicXML encoding supports a particular MusicXML element. This is recommended"},{"type":"text","text":" "},{"type":"text","text":"for elements like beam, stem, and accidental, where the absence of an element is ambiguous if you do not know"},{"type":"text","text":" "},{"type":"text","text":"if the encoding supports that element. For Version 2.0, the supports element is expanded to allow programs to"},{"type":"text","text":" "},{"type":"text","text":"indicate support for particular attributes or particular values. This lets applications communicate, for"},{"type":"text","text":" "},{"type":"text","text":"example, that all system and\/or page breaks are contained in the MusicXML file."}],"url":"\/documentation\/ivormxl\/mxlsupports","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLSupports"}],"kind":"symbol","title":"MXLSupports","navigatorTitle":[{"kind":"identifier","text":"MXLSupports"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSupports","role":"symbol"}}}