{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlsupports\/attribute"]}],"metadata":{"title":"attribute","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"attribute","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"externalID":"s:7IvorMXL11MXLSupportsV9attributeSSSgvp","roleHeading":"Instance Property","symbolKind":"property","role":"symbol","modules":[{"name":"IvorMXL"}]},"sections":[],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSupports"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSupports\/attribute"},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"attribute","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","level":2,"type":"heading"},{"inlineContent":[{"text":"Maps to the MusicXML ","type":"text"},{"code":"attribute","type":"codeVoice"},{"text":" attribute.","type":"text"}],"type":"paragraph"}]}],"abstract":[{"text":"The name of the specific attribute of the element for which support is being indicated.","type":"text"}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLSupports":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSupports","type":"topic","navigatorTitle":[{"text":"MXLSupports","kind":"identifier"}],"abstract":[{"type":"text","text":"The supports type indicates if a MusicXML encoding supports a particular MusicXML element. This is recommended"},{"type":"text","text":" "},{"type":"text","text":"for elements like beam, stem, and accidental, where the absence of an element is ambiguous if you do not know"},{"type":"text","text":" "},{"type":"text","text":"if the encoding supports that element. For Version 2.0, the supports element is expanded to allow programs to"},{"type":"text","text":" "},{"type":"text","text":"indicate support for particular attributes or particular values. This lets applications communicate, for"},{"type":"text","text":" "},{"type":"text","text":"example, that all system and\/or page breaks are contained in the MusicXML file."}],"title":"MXLSupports","kind":"symbol","url":"\/documentation\/ivormxl\/mxlsupports","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSupports","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLSupports/attribute":{"title":"attribute","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"attribute"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?"}],"url":"\/documentation\/ivormxl\/mxlsupports\/attribute","abstract":[{"text":"The name of the specific attribute of the element for which support is being indicated.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSupports\/attribute","kind":"symbol"}}}