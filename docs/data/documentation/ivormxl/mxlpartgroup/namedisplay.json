or, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLPartGroup/nameDisplay":{"abstract":[{"type":"text","text":"Formatting specified in the group-name-display element overrides formatting specified in the group-name"},{"type":"text","text":" "},{"type":"text","text":"element."}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlpartgroup\/namedisplay","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"nameDisplay"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLNameDisplay","preciseIdentifier":"s:7IvorMXL14MXLNameDisplayV"},{"kind":"text","text":"?"}],"type":"topic","role":"symbol","title":"nameDisplay","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartGroup\/nameDisplay"},"doc://IvorMXL/documentation/IvorMXL/MXLPartGroup":{"type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The part-group element indicates groupings of parts in the score, usually indicated by braces and brackets."},{"type":"text","text":" "},{"type":"text","text":"Braces that are used for multi-staff parts should be defined in the attributes element for that part. The"},{"type":"text","text":" "},{"type":"text","text":"part-group start element appears before the first score-part in the group. The part-group stop element appears"},{"type":"text","text":" "},{"type":"text","text":"after the last score-part in the group."}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLPartGroup"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartGroup","url":"\/documentation\/ivormxl\/mxlpartgroup","title":"MXLPartGroup","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPartGroup"}]},"doc://IvorMXL/documentation/IvorMXL/MXLNameDisplay":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNameDisplay"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLNameDisplay"}],"url":"\/documentation\/ivormxl\/mxlnamedisplay","role":"symbol","title":"MXLNameDisplay","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNameDisplay","type":"topic","abstract":[{"type":"text","text":"The name-display type is used for exact formatting of multi-font text in part and group names to the left of"},{"type":"text","text":" "},{"type":"text","text":"the system. The print-object attribute can be used to determine what, if anything, is printed at the start of"},{"type":"text","text":" "},{"type":"text","text":"each system. Enclosure for the display-text element is none by default. Language for the display-text element"},{"type":"text","text":" "},{"type":"text","text":"is Italian (“it”) by default."}]}}}