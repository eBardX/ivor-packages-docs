:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNameDisplay","abstract":[{"type":"text","text":"The name-display type is used for exact formatting of multi-font text in part and group names to the left of"},{"type":"text","text":" "},{"type":"text","text":"the system. The print-object attribute can be used to determine what, if anything, is printed at the start of"},{"type":"text","text":" "},{"type":"text","text":"each system. Enclosure for the display-text element is none by default. Language for the display-text element"},{"type":"text","text":" "},{"type":"text","text":"is Italian (“it”) by default."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNameDisplay"}],"navigatorTitle":[{"kind":"identifier","text":"MXLNameDisplay"}],"url":"\/documentation\/ivormxl\/mxlnamedisplay"},"doc://IvorMXL/documentation/IvorMXL/MXLPartGroup/nameDisplay":{"role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"nameDisplay","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLNameDisplay","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL14MXLNameDisplayV"},{"text":"?","kind":"text"}],"title":"nameDisplay","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartGroup\/nameDisplay","url":"\/documentation\/ivormxl\/mxlpartgroup\/namedisplay","abstract":[{"type":"text","text":"Formatting specified in the group-name-display element overrides formatting specified in the group-name"},{"type":"text","text":" "},{"type":"text","text":"element."}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLPartGroup":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartGroup","navigatorTitle":[{"kind":"identifier","text":"MXLPartGroup"}],"url":"\/documentation\/ivormxl\/mxlpartgroup","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPartGroup"}],"title":"MXLPartGroup","abstract":[{"type":"text","text":"The part-group element indicates groupings of parts in the score, usually indicated by braces and brackets."},{"type":"text","text":" "},{"type":"text","text":"Braces that are used for multi-staff parts should be defined in the attributes element for that part. The"},{"type":"text","text":" "},{"type":"text","text":"part-group start element appears before the first score-part in the group. The part-group stop element appears"},{"type":"text","text":" "},{"type":"text","text":"after the last score-part in the group."}],"type":"topic"}}}