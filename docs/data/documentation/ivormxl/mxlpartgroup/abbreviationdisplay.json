 of multi-font text in part and group names to the left of"},{"type":"text","text":" "},{"type":"text","text":"the system. The print-object attribute can be used to determine what, if anything, is printed at the start of"},{"type":"text","text":" "},{"type":"text","text":"each system. Enclosure for the display-text element is none by default. Language for the display-text element"},{"type":"text","text":" "},{"type":"text","text":"is Italian (“it”) by default."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNameDisplay"}],"navigatorTitle":[{"kind":"identifier","text":"MXLNameDisplay"}],"url":"\/documentation\/ivormxl\/mxlnamedisplay"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"}}}