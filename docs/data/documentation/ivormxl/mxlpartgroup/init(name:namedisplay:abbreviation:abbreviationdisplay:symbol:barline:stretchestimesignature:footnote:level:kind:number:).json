ent":[{"type":"text","text":"The footnote element specifies editorial information that appears in"},{"type":"text","text":" "},{"type":"text","text":"footnotes in the printed score. It is defined within a group due to its"},{"type":"text","text":" "},{"type":"text","text":"multiple uses within the MusicXML schema."}],"type":"paragraph"}]},{"name":"level","content":[{"type":"paragraph","inlineContent":[{"text":"The level element specifies editorial information for different MusicXML","type":"text"},{"text":" ","type":"text"},{"text":"elements. It is defined within a group due to its multiple uses within the","type":"text"},{"text":" ","type":"text"},{"text":"MusicXML schema.","type":"text"}]}]},{"name":"kind","content":[{"inlineContent":[{"type":"text","text":"Whether this element marks the start or the stop of the group."}],"type":"paragraph"}]},{"name":"number","content":[{"type":"paragraph","inlineContent":[{"text":"The number used to distinguish overlapping and nested part-groups, not the","type":"text"},{"text":" ","type":"text"},{"text":"sequence of groups. Defaults to ","type":"text"},{"type":"codeVoice","code":"1"},{"text":" if not specified.","type":"text"}]}]}]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLLevel":{"type":"topic","abstract":[{"type":"text","text":"The level type is used to specify editorial information for different MusicXML elements. The content contains"},{"type":"text","text":" "},{"type":"text","text":"identifying and\/or descriptive text about the editorial status of the parent element."}],"url":"\/documentation\/ivormxl\/mxllevel","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLLevel","kind":"identifier"}],"kind":"symbol","title":"MXLLevel","navigatorTitle":[{"text":"MXLLevel","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLevel","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLGroupBarline":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/I