":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLGroupSymbol","navigatorTitle":[{"kind":"identifier","text":"MXLGroupSymbol"}],"url":"\/documentation\/ivormxl\/mxlgroupsymbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLGroupSymbol"}],"title":"MXLGroupSymbol","abstract":[{"type":"text","text":"The group-symbol type indicates how the symbol for a group is indicated in the score. It is none if not"},{"type":"text","text":" "},{"type":"text","text":"specified."}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLPartGroup":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartGroup","navigatorTitle":[{"kind":"identifier","text":"MXLPartGroup"}],"url":"\/documentation\/ivormxl\/mxlpartgroup","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPartGroup"}],"title":"MXLPartGroup","abstract":[{"type":"text","text":"The part-group element indicates groupings of parts in the score, usually indicated by braces and brackets."},{"type":"text","text":" "},{"type":"text","text":"Braces that are used for multi-staff parts should be defined in the attributes element for that part. The"},{"type":"text","text":" "},{"type":"text","text":"part-group start element appears before the first score-part in the group. The part-group stop element appears"},{"type":"text","text":" "},{"type":"text","text":"after the last score-part in the group."}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLNameDisplay":{"type":"topic","title":"MXLNameDisplay","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNameDisplay","abstract":[{"type":"text","text":"The name-display type is used for exact formatting of multi-font text in part and group names to the left of"},{"type":"text","text":" "},{"type":"text","text":"the system. The print-object attribute can be used to determine what, if anything, is printed at the start of"},{"type":"text","text":" "},{"type":"text","text":"each system. Enclosure for the display-text element is none by default. Language for the display-text element"},{"type":"text","text":" "},{"type":"text","text":"is Italian (“it”) by default."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNameDisplay"}],"navigatorTitle":[{"kind":"identifier","text":"MXLNameDisplay"}],"url":"\/documentation\/ivormxl\/mxlnamedisplay"},"doc://IvorMXL/documentation/IvorMXL/MXLGroupName":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLGroupName","navigatorTitle":[{"text":"MXLGroupName","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlgroupname","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLGroupName","kind":"identifier"}],"title":"MXLGroupName","abstract":[{"type":"text","text":"The group-name type describes the name or abbreviation of a part-group element. Formatting attributes in the"},{"type":"text","text":" "},{"type":"text","text":"group-name type are deprecated in Version 2.0 in favor of the new group-name-display and group-abbreviation-"},{"type":"text","text":" "},{"type":"text","text":"display elements."}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLPartGroup/init(name:nameDisplay:abbreviation:abbreviationDisplay:symbol:barline:stretchesTimeSignature:footnote:level:kind:number:)":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartGroup\/init(name:nameDisplay:abbreviation:abbreviationDisplay:symbol:barline:stretchesTimeSignature:footnote:level:kind:number:)","url":"\/documentation\/ivormxl\/mxlpartgroup\/init(name:namedisplay:abbreviation:abbreviationdisplay:symbol:barline:stretchestimesignature:footnote:level:kind:number:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam",