MXLOverUnder","preciseIdentifier":"s:7IvorMXL12MXLOverUnderO"},{"kind":"text","text":"?"}],"abstract":[{"type":"text","text":"The orientation attribute indicates whether slurs and ties are overhand (tips down) or underhand (tips up)."},{"type":"text","text":" "},{"type":"text","text":"This is distinct from the placement attribute used by any notation type."}],"url":"\/documentation\/ivormxl\/mxltied\/orientation","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTied\/orientation","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLTied/number":{"type":"topic","title":"number","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"number"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLNumberLevel","preciseIdentifier":"s:7IvorMXL14MXLNumberLevelV"},{"kind":"text","text":"?"}],"abstract":[{"type":"text","text":"Distinguishes this tie from other ties that might be active at the same time."}],"url":"\/documentation\/ivormxl\/mxltied\/number","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTied\/number","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLTied/bezierX2":{"type":"topic","title":"bezierX2","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"bezierX2"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLTenths","preciseIdentifier":"s:7IvorMXL9MXLTenthsa"},{"kind":"text","text":"?"}],"abstract":[{"type":"text","text":"The x-coordinate, in tenths, of the outgoing bezier control point for a slur with a continue type."}],"url":"\/documentation\/ivormxl\/mxltied\/bezierx2","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTied\/bezierX2","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLTied/Kind-swift.enum":{"abstract":[{"type":"text","text":"The tied-type type is used as an attribute of the tied element to specify where the visual representation"},{"type":"text","text":" "},{"type":"text","text":"of a tie begins and ends. A tied element which joins two notes of the same pitch can be specified with"},{"text":" ","type":"text"},{"type":"text","text":"tied-type start on the first note and tied-type stop on the second note. To indicate a note should be"},{"text":" ","type":"text"},{"type":"text","text":"undamped, use a single tied element with tied-type let-ring. For other ties that are visually attached to a"},{"type":"text","text":" "},{"type":"text","text":"single note, such as a tie leading into or out of a repeated section or coda, use two tied elements on the"},{"type":"text","text":" "},{"type":"text","text":"same note, one start and one stop."}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Kind","kind":"identifier"}],"title":"MXLTied.Kind","role":"symbol","type":"topic","navigatorTitle":[{"text":"Kind","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxltied\/kind-swift.enum","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTied\/Kind-swift.enum"},"doc://IvorMXL/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","identifier":"doc:\/\/IvorMXL\/s16SendableMetatypeP","type":"unresolvable"},"doc://IvorMXL/documentation/IvorMXL/MXLTied/id":{"kind":"symbol","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTied\/id","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"id","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?","kind":"text"}],"type":"topic","abstract":[{"type":"text","text":"The optional-unique-id attribute group allows an element to optionally specify an ID that is unique to the"},{"type":"text","text":" "},{"type":"text","text":"entire document. This attribute group is not used for a required id attribute, or for an id attribute that"},{"type":"text","text":" "},{"type":"text","text":"specifies an id reference."}],"url":"\/documentation\/ivormxl\/mxltied\/id","title":"id"},"doc://IvorMXL/documentation/IvorMXL/MXLTied/bezierX":{"type":"topic","title":"bezierX","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"bezierX"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLTenths","preciseIdentifier":"s:7IvorMXL9MXLTenthsa"},{"kind":"text","text":"?"}],"abstract":[{"type":"text","text":"The x-coordinate, in tenths relative to any position settings, of the outgoing bezier control point for a"},{"type":"text","text":" "},{"type":"text","text":"slur or tie with a start type, or the incoming control point for one with a stop or continue type."}],"url":"\/documentation\/ivormxl\/mxltied\/bezierx","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTied\/bezierX","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLTied/bezierOffset":{"type":"topic","title":"bezierOffset","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"bezierOffset"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLDivisions","preciseIdentifier":"s:7IvorMXL12MXLDivisionsV"},{"kind":"text","text":"?"}],"abstract":[{"type":"text","text":"The outgoing bezier control point offset, in musical divisions, for a slur or tie with a start type, or the"},{"type":"text","text":" "},{"type":"text","text":"incoming control point offset for one with a stop or continue type. Deprecated as of MusicXML 3.1 in favor of"},{"type":"text","text":" "},{"type":"codeVoice","code":"bezierX"},{"type":"text","text":"."}],"url":"\/documentation\/ivormxl\/mxltied\/bezieroffset","role":"symbo