ied/color":{"type":"topic","abstract":[{"text":"The color attribute group indicates the color of an element.","type":"text"}],"url":"\/documentation\/ivormxl\/mxltied\/color","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTied\/color","title":"color","kind":"symbol","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"color","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLColor","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLColorV"},{"text":"?","kind":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLTied/lineKind":{"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"lineKind"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLLineKind","preciseIdentifier":"s:7IvorMXL11MXLLineKindO"},{"kind":"text","text":"?"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxltied\/linekind","role":"symbol","type":"topic","abstract":[{"text":"The line-type attribute distinguishes between solid, dashed, dotted, and wavy lines.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTied\/lineKind","title":"lineKind"},"doc://IvorMXL/documentation/IvorMXL/MXLTied/bezierX2":{"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"bezierX2"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLTenthsa","text":"MXLTenths"},{"kind":"text","text":"?"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxltied\/bezierx2","role":"symbol","type":"topic","abstract":[{"text":"The x-coordinate, in tenths, of the outgoing bezier control point for a slur with a continue type.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTied\/bezierX2","title":"bezierX2"},"doc://IvorMXL/documentation/IvorMXL/MXLTied/Kind-swift.enum":{"url":"\/documentation\/ivormxl\/mxltied\/kind-swift.enum","kind":"symbol","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Kind","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTied\/Kind-swift.enum","title":"MXLTied.Kind","abstract":[{"type":"text","text":"The tied-type type is used as an attribute of the tied element to specify where the visual representation"},{"type":"text","text":" "},{"type":"text","text":"of a tie begins and ends. A tied element which joins two notes of the same pitch can be specified with"},{"type":"text","text":" "},{"type":"text","text":"tied-type start on the first note and tied-type stop on the second note. To indicate a note should be"},{"type":"text","text":" "},{"type":"text","text":"undamped, use a single tied element with tied-type let-ring. For other ties that are visually attached to a"},{"type":"text","text":" "},{"type":"text","text":"single note, such as a tie leading into or out of a repeated section or coda, use two tied elements on the"},{"type":"text","text":" "},{"type":"text","text":"same note, one start and one stop."}],"navigatorTitle":[{"text":"Kind","kind":"identifier"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLTied/bezierOffset":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTied\/bezierOffset","kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxltied\/bezieroffset","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"bezierOffset"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL12MXLDivisionsV","kind":"typeIdentifier","text":"MXLDivisions"},{"kind":"text","text":"?"}],"abstract":[{"type":"text","text":"The outgoing bezier control point offset, in musical divisions, for a slur or tie with a start type, or the"},{"type":"text","text":" "},{"type":"text","text":"incoming control point offset for one with a stop or continue type. Deprecated as of MusicXML 3.1 in favor of"},{"type":"text","text":" "},{"type":"codeVoice","code":"bezierX"},{"type":"text","text":"."}],"role":"symbol","title":"bezierOffset"},"doc://IvorMXL/documentation/IvorMXL/MXLTied/placement":{"role":"symbol","url":"\/documentation\/ivormxl\/mxltied\/placement","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTied\/placement","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"placement"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL13MXLAboveBelowO","text":"MXLAboveBelow"},{"kind":"text","text":"?"}],"kind":"symbol","abstract":[{"text":"The placement attribute indicates whether something is above or below another element, such as a note or a","type":"text"},{"text":" ","type":"text"},{"text":"notation.","type":"text"}],"type":"topic","title":"placement"},"doc://IvorMXL/documentation/IvorMXL/MXLTied/bezierOffset2":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTied\/bezierOffset2","kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxltied\/bezieroffset2","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"bezierOffset2"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL12MXLDivisionsV","text":"MXLDivisions"},{"kind":"text","text":"?"}],"abstract":[{"type":"text","text":"The outgoing bezier control point offset, in musical divisions, for a slur with a continue type. Deprecated"},{"type":"text","text":" "},{"type":"text","text":"as of MusicXML 3.1 in favor of "},{"type":"codeVoice","code":"bezierX2"},{"type":"text","text":"."}],"role":"symbol","title":"bezierOffset2"},"doc://IvorMXL/documentation/IvorMXL/MXLTied/Equatable-Implementations":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTied\/Equatable-Implementations","kind":"article","type":"topic","url":"\/documentation\/ivormxl\/mxltied\/equatable-implementations","abstract":[],"role":"collectionGroup","title":"Equatable Implementations"}}}