,{"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTied\/Equatable-Implementations"],"generated":true,"anchor":"Default-Implementations","title":"Default Implementations"}],"kind":"symbol","variants":[{"paths":["\/documentation\/ivormxl\/mxltied"],"traits":[{"interfaceLanguage":"swift"}]}],"relationshipsSections":[{"identifiers":["doc:\/\/IvorMXL\/s8CopyableP","doc:\/\/IvorMXL\/SQ","doc:\/\/IvorMXL\/s9EscapableP","doc:\/\/IvorMXL\/SH","doc:\/\/IvorMXL\/s8SendableP","doc:\/\/IvorMXL\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships","title":"Conforms To"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTied","kind":"identifier"}],"platforms":["macOS"]}]},{"kind":"content","content":[{"anchor":"overview","text":"Overview","type":"heading","level":2},{"inlineContent":[{"text":"The number attribute is rarely needed to disambiguate ties, since note pitches will usually suffice. The","type":"text"},{"text":" ","type":"text"},{"text":"attribute is implied rather than defaulting to 1 as with most elements. It is available for use in more","type":"text"},{"text":" ","type":"text"},{"text":"complex tied notation situations.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Ties that join two notes of the same pitch together should be represented with a tied element on the first","type":"text"},{"text":" ","type":"text"},{"text":"note with type=“start” and a tied element on the second note with type=“stop”. This can also be done if the","type":"text"},{"text":" ","type":"text"},{"text":"two notes being tied are enharmonically equivalent, but have different step values. It is not recommended to","type":"text"},{"text":" ","type":"text"},{"text":"use tied elements to join two notes with enharmonically inequivalent pitches.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Ties that indicate that an instrument should be undamped are specified with a single tied element with","type":"text"},{"text":" ","type":"text"},{"text":"type=“let-ring”.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Ties that are visually attached to only one note, other than undamped ties, should be specified with two tied","type":"text"},{"text":" ","type":"text"},{"text":"elements on the same note, first type=“start” then type=“stop”. This can be used to represent ties into or out","type":"text"},{"text":" ","type":"text"},{"text":"of repeated sections or codas.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Maps the MusicXML ","type":"text"},{"code":"<tied>","type":"codeVoice"},{"text":" element.","type":"text"}],"type":"paragraph"}]}],"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL"]]},"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTied","interfaceLanguage":"swift"},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLTied/number":{"abstract":[{"text":"Distinguishes this tie from other ties that might be active at the same time.","type":"text"}],"title":"number","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"number"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL14MXLNumberLevelV","kind":"typeIdentifier","text":"MXLNumberLevel"},{"kind":"text","text":"?"}],"type":"topic","url":"\/documentation\/ivormxl\/mxltied\/number","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTied\/number"},"doc://IvorMXL/SQ":{"identifier":"doc:\/\/IvorMXL\/SQ","type":"unresolvable","title":"Swift.Equatable"},"doc://IvorMXL/documentation/IvorMXL/MXLTied/bezierY":{"abstract":[{"text":"The y-coordinate, in tenths relative to any position settings, of the outgoing bezier control point for a","type":"text"},{"text":" ","type":"text"},{"text":"slur or tie with a start type, or the 