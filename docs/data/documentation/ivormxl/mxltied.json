{"abstract":[{"text":"The tied element represents the notated tie. The tie element represents the tie sound.","type":"text"}],"topicSections":[{"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTied\/init(id:kind:number:lineKind:dashLength:spaceLength:position:placement:orientation:bezierX:bezierY:bezierX2:bezierY2:bezierOffset:bezierOffset2:color:)"],"anchor":"Initializers","generated":true,"title":"Initializers"},{"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTied\/bezierOffset","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTied\/bezierOffset2","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTied\/bezierX","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTied\/bezierX2","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTied\/bezierY","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTied\/bezierY2","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTied\/color","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTied\/dashLength","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTied\/id","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTied\/kind-swift.property","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTied\/lineKind","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTied\/number","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTied\/orientation","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTied\/placement","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTied\/position","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTied\/spaceLength"],"anchor":"Instance-Properties","generated":true,"title":"Instance Properties"},{"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTied\/Kind-swift.enum"],"anchor":"Enumerations","generated":true,"title":"Enumerations"},{"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTied\/Equatable-Implementations"],"anchor":"Default-Implementations","generated":true,"title":"Default Implementations"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTied"}]}]},{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The number attribute is rarely needed to disambiguate ties, since note pitches will usually suffice. The"},{"type":"text","text":" "},{"type":"text","text":"attribute is implied rather than defaulting to 1 as with most elements. It is available for use in more"},{"type":"text","text":" "},{"text":"complex tied notation situations.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Ties that join two notes of the same pitch together should be represented with a tied element on the first","type":"text"},{"text":" ","type":"text"},{"text":"note with ","type":"text"},{"type":"codeVoice","code":"type=\"start\""},{"text":" and a tied element on the second note with ","type":"text"},{"type":"codeVoice","code":"type=\"stop\""},{"text":". This can also be done if the","type":"text"},{"text":" ","type":"text"},{"text":"two notes being tied are enharmonically equivalent, but have different step values. It is not recommended to","type":"text"},{"text":" ","type":"text"},{"text":"use tied elements to join two notes with enharmonically inequivalent pitches.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Ties that indicate that an instrument should be undamped are specified with a single tied element with","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"type=\"let-ring\""},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Ties that are visually attached to only one note, other than undamped ties, should be specified with two tied","type":"text"},{"text":" ","type":"text"},{"text":"elements on the same note, first ","type":"text"},{"code":"type=\"start\"","type":"codeVoice"},{"type":"text","text":" then "},{"type":"codeVoice","code":"type=\"stop\""},{"type":"text","text":". This can be used to represent ties into or out"},{"type":"text","text":" "},{"text":"of repeated sections or codas.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Maps the MusicXML ","type":"text"},{"code":"<tied>","type":"codeVoice"},{"text":" element.","type":"text"}]}]}],"variants":[{"paths":["\/documentation\/ivormxl\/mxltied"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"roleHeading":"Structure","role":"symbol","title":"MXLTied","externalID":"s:7IvorMXL7MXLTiedV","symbolKind":"struct","navigatorTitle":[{"text":"MXLTied","kind":"identifier"}],"modules":[{"name":"IvorMXL"}],"fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"kind":"identifier","text":"MXLTied"}]},"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL"]]},"kind":"symbol","relationshipsSections":[{"identifiers":["doc:\/\/IvorMXL\/s8CopyableP","doc:\/\/IvorMXL\/SQ","doc:\/\/IvorMXL\/s9EscapableP","doc:\/\/IvorMXL\/SH","doc:\/\/IvorMXL\/s8SendableP","doc:\/\/IvorMXL\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships","title":"Conforms To"}],"sections":[],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTied","interfaceLanguage":"swift"},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLTied/bezierX2":{"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"bezierX2"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLTenths","preciseIdentifier":"s:7IvorMXL9MXLTenthsa"},{"kind":"text","text":"?"}],"kind":"symbol","title":"bezierX2","abstract":[{"type":"text","text":"The x-coordinate, in tenths, of the outgoing bezier control point for a slur with a continue type."}],"role":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTied\/bezierX2","url":"\/documentation\/ivormxl\/mxltied\/bezierx2"},"doc://IvorMXL/documentation/IvorMXL/MXLTied/bezierOffset2":{"identifier":"doc:\/\/Ivor