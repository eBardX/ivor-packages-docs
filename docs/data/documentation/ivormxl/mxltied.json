{"variants":[{"paths":["\/documentation\/ivormxl\/mxltied"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTied"},"sections":[],"metadata":{"role":"symbol","roleHeading":"Structure","externalID":"s:7IvorMXL7MXLTiedV","title":"MXLTied","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTied"}],"navigatorTitle":[{"kind":"identifier","text":"MXLTied"}],"modules":[{"name":"IvorMXL"}],"symbolKind":"struct"},"kind":"symbol","primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTied"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The number attribute is rarely needed to disambiguate ties, since note pitches will usually suffice. The"},{"type":"text","text":" "},{"type":"text","text":"attribute is implied rather than defaulting to 1 as with most elements. It is available for use in more"},{"type":"text","text":" "},{"type":"text","text":"complex tied notation situations."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Ties that join two notes of the same pitch together should be represented with a tied element on the first"},{"type":"text","text":" "},{"type":"text","text":"note with type=“start” and a tied element on the second note with type=“stop”. This can also be done if the"},{"type":"text","text":" "},{"type":"text","text":"two notes being tied are enharmonically equivalent, but have different step values. It is not recommended to"},{"type":"text","text":" "},{"type":"text","text":"use tied elements to join two notes with enharmonically inequivalent pitches."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Ties that indicate that an instrument should be undamped are specified with a single tied element with"},{"type":"text","text":" "},{"type":"text","text":"type=“let-ring”."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Ties that are visually attached to only one note, other than undamped ties, should be specified with two tied"},{"type":"text","text":" "},{"type":"text","text":"elements on the same note, first type=“start” then type=“stop”. This can be used to represent ties into or out"},{"type":"text","text":" "},{"type":"text","text":"of repeated sections or codas."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Maps the MusicXML "},{"code":"<tied>","type":"codeVoice"},{"type":"text","text":" element."}]}],"kind":"content"}],"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/IvorMXL\/s8CopyableP","doc:\/\/IvorMXL\/SQ","doc:\/\/IvorMXL\/s9EscapableP","doc:\/\/IvorMXL\/SH","doc:\/\/IvorMXL\/s8SendableP","doc:\/\/IvorMXL\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships"}],"abstract":[{"text":"The tied element represents the notated tie. The tie element represents the tie sound.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL"]]},"topicSections":[{"generated":true,"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTied\/init(id:kind:number:lineKind:dashLength:spaceLength:position:placement:orientation:bezierX:bezierY:bezierX2:bezierY2:bezierOffset:bezierOffset2:color:)"]},{"generated":true,"anchor":"Instance-Properties","title":"Instance Properties","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTied\/bezierOffset","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTied\/bezierOffset2","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTied\/bezierX","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTied\/bezierX2","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTied\/bezierY","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTied\/bezierY2","doc:\/\/IvorMX