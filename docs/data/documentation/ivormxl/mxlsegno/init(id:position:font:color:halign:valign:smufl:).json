tifier":"s:7IvorMXL22MXLSmuflSegnoGlyphNameV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSmuflSegnoGlyphName","kind":"typeIdentifier"},{"text":"? = nil)","kind":"text"}]}],"kind":"declarations"},{"parameters":[{"name":"id","content":[{"inlineContent":[{"text":"The optional-unique-id attribute group allows an element to optionally specify an ID that is unique to the entire document. This attribute group is not used for a required id attribute, or for an id attribute that specifies an id reference.","type":"text"}],"type":"paragraph"}]},{"name":"position","content":[{"inlineContent":[{"text":"For most elements, any program will compute a default x and y position. The position attributes let this be changed two ways.","type":"text"}],"type":"paragraph"}]},{"name":"font","content":[{"inlineContent":[{"text":"The font attribute group gathers together attributes for determining the font within a credit or direction. They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of font names.The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font vs. a music font.","type":"text"}],"type":"paragraph"}]},{"name":"color","content":[{"inlineContent":[{"text":"The color attribute group indicates the color of an element.","type":"text"}],"type":"paragraph"}]},{"name":"halign","content":[{"inlineContent":[{"text":"In cases where text extends over more than one line, horizontal alignment and justify values can be different. The most typical case is for credits, such as:","type":"text"}],"type":"paragraph"}]},{"name":"valign","content":[{"inlineContent":[{"text":"The valign attribute is used to indicate vertical alignment to the top, middle, bottom, or baseline of the text. Defaults are implementation-dependent.","type":"text"}],"type":"paragraph"}]},{"name":"smufl","content":[{"inlineContent":[{"text":"Specifies the exact segno glyph to use.","type":"text"}],"type":"paragraph"}]}],"kind":"parameters"}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSegno\/init(id:position:font:color:halign:valign:smufl:)","interfaceLanguage":"swift"},"kind":"symbol","references":{"doc://IvorMXL/documentation/IvorMXL/MXLValign":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlvalign","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValign","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLValign"}],"abstract":[{"text":"The valign type is used to indicate vertical alignment to the top, middle, bottom, or baseline of the text. If","type":"text"},{"text":" ","type":"text"},{"text":"the text is on multiple lines, baseline alignment refers to the baseline of the lowest line of text. Defaults","type":"text"},{"text":" ","type":"text"},{"text":"are implementation-dependent.","type":"text"}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLValign"}],"title":"MXLValign"},"doc://IvorMXL/documentation/IvorMXL/MXLSegno":{"url":"\/documentation\/ivormxl\/mxlsegno","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSegno","title":"MXLSegno","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The segno type is the visual indicator of a segno sign. The exact glyph can be specified with the smufl"},{"type":"text","text":" "},{"type":"text","text":"attribute. A sound element is also needed to guide playback applications reliably."}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSegno","kind":"identifier"}],"navigatorTitle":[{"text":"MXLSegno","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLSmuflSegnoGlyphName":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlsmuflsegnoglyphname","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSmuflSegnoGlyphName","fragment