erent. The most typical case is for credits, such as:"}],"type":"paragraph"}]},{"name":"valign","content":[{"type":"paragraph","inlineContent":[{"text":"The valign attribute is used to indicate vertical alignment to the top, middle, bottom, or baseline of the text. Defaults are implementation-dependent.","type":"text"}]}]},{"name":"smufl","content":[{"type":"paragraph","inlineContent":[{"text":"Specifies the exact segno glyph to use.","type":"text"}]}]}]}],"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"role":"symbol","symbolKind":"init","modules":[{"name":"IvorMXL"}],"roleHeading":"Initializer","externalID":"s:7IvorMXL8MXLSegnoV2id8position4font5color6halign6valign5smuflACSSSg_AA11MXLPositionVAA7MXLFontVAA8MXLColorVSgAA18MXLLeftCenterRightOSgAA9MXLValignOSgAA22MXLSmuflSegnoGlyphNameVSgtcfc","title":"init(id:position:font:color:halign:valign:smufl:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?, ","kind":"text"},{"text":"position","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLPosition","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLPositionV"},{"text":", ","kind":"text"},{"text":"font","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLFont","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL7MXLFontV"},{"text":", ","kind":"text"},{"text":"color","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLColor","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLColorV"},{"text":"?, ","kind":"text"},{"text":"halign","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLLeftCenterRight","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL18MXLLeftCenterRightO"},{"text":"?, ","kind":"text"},{"text":"valign","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLValign","kind":"typeIdentif