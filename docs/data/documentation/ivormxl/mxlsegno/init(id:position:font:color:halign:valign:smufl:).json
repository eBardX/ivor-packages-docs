sition","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLSmuflSegnoGlyphName":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlsmuflsegnoglyphname","title":"MXLSmuflSegnoGlyphName","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSmuflSegnoGlyphName","kind":"identifier"}],"navigatorTitle":[{"text":"MXLSmuflSegnoGlyphName","kind":"identifier"}],"abstract":[{"type":"text","text":"The smufl-segno-glyph-name type is used to reference a specific Standard Music Font Layout (SMuFL) segno"},{"type":"text","text":" "},{"type":"text","text":"character. The value is a SMuFL canonical glyph name that starts with segno."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSmuflSegnoGlyphName"},"doc://IvorMXL/documentation/IvorMXL/MXLSegno":{"title":"MXLSegno","url":"\/documentation\/ivormxl\/mxlsegno","abstract":[{"type":"text","text":"The segno type is the visual indicator of a segno sign. The exact glyph can be specified with the smufl"},{"type":"text","text":" "},{"type":"text","text":"attribute. A sound element is also needed to guide playback applications reliably."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSegno","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"MXLSegno","kind":"identifier"}],"type":"topic","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSegno"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlcolor","title":"MXLColor","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"type":"text","text":"HTML, or as hexadecimal ARGB tupl