MXLOpus":{"navigatorTitle":[{"kind":"identifier","text":"MXLOpus"}],"abstract":[{"text":"The opus type is used for the root element of a MusicXML opus. Each opus is made up of a series of score,","type":"text"},{"text":" ","type":"text"},{"text":"opus-link, and\/or nested opus elements. The document-attributes attribute group includes the version","type":"text"},{"text":" ","type":"text"},{"text":"attribute. Future versions may include more metadata elements. In this version, we just include the title of","type":"text"},{"text":" ","type":"text"},{"text":"the opus.","type":"text"}],"title":"MXLOpus","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOpus","kind":"symbol","url":"\/documentation\/ivormxl\/mxlopus","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLOpus"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"}}}