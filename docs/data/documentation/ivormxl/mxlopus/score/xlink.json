{"kind":"symbol","abstract":[{"text":"The link-attributes group includes all the simple XLink attributes supported in the MusicXML format. It is","type":"text"},{"text":" ","type":"text"},{"text":"also used to connect a MusicXML score with MusicXML parts or a MusicXML opus.","type":"text"}],"variants":[{"paths":["\/documentation\/ivormxl\/mxlopus\/score\/xlink"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOpus","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOpus\/Score"]]},"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOpus\/Score\/xlink","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"xlink"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLXLinkV","text":"MXLXLink","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLXLink"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"}],"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"role":"symbol","symbolKind":"property","modules":[{"name":"IvorMXL"}],"title":"xlink","roleHeading":"Instance Property","externalID":"s:7IvorMXL7MXLOpusV5ScoreV5xlinkAA8MXLXLinkVvp","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"xlink"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLXLink","preciseIdentifier":"s:7IvorMXL8MXLXLinkV"}]},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLOpus/Score/xlink":{"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"xlink"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLXLinkV","text":"MXLXLink"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlopus\/score\/xlink","role":"symbol","title":"xlink","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOpus\/Score\/xlink","type":"topic","abstract":[{"type":"text","text":"The link-attributes group includes all the simple XLink attributes supported in the MusicXML format. It is"},{"type":"text","text":" "},{"type":"text","text":"also used to connect a MusicXML score with MusicXML parts or a MusicXML opus."}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLOpus/Score":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOpus\/Score","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Score"}],"abstract":[{"type":"text","text":"The score elements provide the links to the individual scores within an opus. The new-page attribute, added in"},{"type":"text","text":" "},{"type":"text","text":"Version 2.0, is used to indicate if the first page of the score is different than the last page of the"},{"type":"text","text":" "},{"type":"text","text":"previous score. If new-page is “yes”, then a different page is used; if “no”, then the same page is used. The"},{"type":"text","text":" "},{"type":"text","text":"default value is implementation-dependent."}],"kind":"symbol","title":"MXLOpus.Score","url":"\/documentation\/ivormxl\/mxlopus\/score","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Score"}]},"doc://IvorMXL/documentation/IvorMXL/MXLXLink":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLXLink"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLXLink","title":"MXLXLink","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLXLink"}],"abstract":[{"type":"text","text":"The simple XLink attributes supported in the MusicXML format. It is also used to connect a MusicXML score with"},{"type":"text","text":" "},{"type":"text","text":"MusicXML parts or a MusicXML opus."}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlxlink"},"doc://IvorMXL/documentation/IvorMXL/MXLOpus":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOpus","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLOpus"}],"abstract":[{"text":"The opus type is used for the root element of a MusicXML opus. Each opus is made up of a series of score,","type":"text"},{"text":" ","type":"text"},{"text":"opus-link, and\/or nested opus elements. The document-attributes attribute group includes the version","type":"text"},{"text":" ","type":"text"},{"text":"attribute. Future versions may include more metadata elements. In this version, we just include the title of","type":"text"},{"text":" ","type":"text"},{"text":"the opus.","type":"text"}],"title":"MXLOpus","kind":"symbol","url":"\/documentation\/ivormxl\/mxlopus","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLOpus"}]}}}