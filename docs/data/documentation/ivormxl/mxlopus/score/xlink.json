{"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOpus","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOpus\/Score"]]},"sections":[],"metadata":{"role":"symbol","symbolKind":"property","modules":[{"name":"IvorMXL"}],"externalID":"s:7IvorMXL7MXLOpusV5ScoreV5xlinkAA8MXLXLinkVvp","roleHeading":"Instance Property","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"xlink","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLXLink","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLXLinkV"}],"title":"xlink"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOpus\/Score\/xlink"},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"xlink","kind":"identifier"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLXLink","text":"MXLXLink","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLXLinkV"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"}],"kind":"symbol","abstract":[{"text":"The link-attributes group includes all the simple XLink attributes supported in the MusicXML format. It is","type":"text"},{"text":" ","type":"text"},{"text":"also used to connect a MusicXML score with MusicXML parts or a MusicXML opus.","type":"text"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"paths":["\/documentation\/ivormxl\/mxlopus\/score\/xlink"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLOpus":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlopus","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOpus","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLOpus"}],"abstract":[{"type":"text","text":"The opus type is used for the root element of a MusicXML opus. Each opus is made up of a series of score,"},{"type":"text","text":" "},{"type":"text","text":"opus-link, and\/or nested opus elements. The document-attributes attribute group includes the version"},{"type":"text","text":" "},{"type":"text","text":"attribute. Future versions may include more metadata elements. In this version, we just include the title of"},{"type":"text","text":" "},{"type":"text","text":"the opus."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLOpus"}],"title":"MXLOpus"},"doc://IvorMXL/documentation/IvorMXL/MXLXLink":{"title":"MXLXLink","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLXLink"}],"abstract":[{"text":"The simple XLink attributes supported in the MusicXML format. It is also used to connect a MusicXML score with","type":"text"},{"text":" ","type":"text"},{"text":"MusicXML parts or a MusicXML opus.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLXLink","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLXLink"}],"url":"\/documentation\/ivormxl\/mxlxlink"},"doc://IvorMXL/documentation/IvorMXL/MXLOpus/Score/xlink":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlopus\/score\/xlink","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOpus\/Score\/xlink","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"xlink","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLXLink","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLXLinkV"}],"abstract":[{"text":"The link-attributes group includes all the simple XLink attributes supported in the MusicXML format. It is","type":"text"},{"text":" ","type":"text"},{"text":"also used to connect a MusicXML score with MusicXML parts or a MusicXML opus.","type":"text"}],"kind":"symbol","type":"topic","title":"xlink"},"doc://IvorMXL/documentation/IvorMXL/MXLOpus/Score":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlopus\/score","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOpus\/Score","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Score"}],"abstract":[{"type":"text","text":"The score elements provide the links to the individual scores within an opus. The new-page attribute, added in"},{"type":"text","text":" "},{"type":"text","text":"Version 2.0, is used to indicate if the first page of the score is different than the last page of the"},{"type":"text","text":" "},{"type":"text","text":"previous score. If new-page is “yes”, then a different page is used; if “no”, then the same page is used. The"},{"type":"text","text":" "},{"type":"text","text":"default value is implementation-dependent."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Score"}],"title":"MXLOpus.Score"}}}