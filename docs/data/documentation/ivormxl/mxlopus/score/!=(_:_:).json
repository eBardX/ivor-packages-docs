rMXL/documentation/IvorMXL/MXLOpus":{"type":"topic","title":"MXLOpus","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOpus","abstract":[{"text":"The opus type is used for the root element of a MusicXML opus. Each opus is made up of a series of score,","type":"text"},{"text":" ","type":"text"},{"text":"opus-link, and\/or nested opus elements. The document-attributes attribute group includes the version","type":"text"},{"text":" ","type":"text"},{"text":"attribute. Future versions may include more metadata elements. In this version, we just include the title of","type":"text"},{"text":" ","type":"text"},{"text":"the opus.","type":"text"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLOpus"}],"navigatorTitle":[{"kind":"identifier","text":"MXLOpus"}],"url":"\/documentation\/ivormxl\/mxlopus"},"doc://IvorMXL/documentation/IvorMXL/MXLOpus/Score":{"type":"topic","title":"MXLOpus.Score","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOpus\/Score","abstract":[{"type":"text","text":"The score elements provide the links to the individual scores within an opus. The new-page attribute, added in"},{"type":"text","text":" "},{"type":"text","text":"Version 2.0, is used to indicate if the first page of the score is different than the last page of the"},{"type":"text","text":" "},{"type":"text","text":"previous score. If new-page is “yes”, then a different page is used; if “no”, then the same page is used. The"},{"type":"text","text":" "},{"type":"text","text":"default value is implementation-dependent."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Score"}],"navigatorTitle":[{"kind":"identifier","text":"Score"}],"url":"\/documentation\/ivormxl\/mxlopus\/score"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/doc