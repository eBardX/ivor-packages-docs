rMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLOpus":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOpus","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLOpus"}],"abstract":[{"text":"The opus type is used for the root element of a MusicXML opus. Each opus is made up of a series of score,","type":"text"},{"text":" ","type":"text"},{"text":"opus-link, and\/or nested opus elements. The document-attributes attribute group includes the version","type":"text"},{"text":" ","type":"text"},{"text":"attribute. Future versions may include more metadata elements. In this version, we just include the title of","type":"text"},{"text":" ","type":"text"},{"text":"the opus.","type":"text"}],"title":"MXLOpus","kind":"symbol","url":"\/documentation\/ivormxl\/mxlopus","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLOpus"}]},"doc://IvorMXL/documentation/IvorMXL/MXLOpus/Score/!=(_:_:)":{"type":"topic","abstract":[],"kind":"symbol","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOpus\/Score\/!=(_:_:)","title":"!=(_:_:)","url":"\/documentation\/ivormxl\/mxlopus\/score\/!=(_:_:)","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"!=","kind":"identifier"},{"text":" ","kind":"text"},{"text":"(","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}]},"doc://IvorMXL/documentation/IvorMXL/MXLOpus/Score":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOpus\/Score","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Score"}],"abstract":[{"type":"text","text":"The score elements provide the links to the individual scores within an opus. The new-page attribute, added in"},{"type":"text","text":" "},{"type":"text","text":"Version 2.0, is used to indicate if the first page of the score is different than the last page of the"},{"type":"text","text":" "},{"type":"text","text":"previous score. If new-page is “yes”, then a different page is used; if “no”, then the same page is used. The"},{"type":"text","text":" "},{"type":"text","text":"default value is implementation-dependent."}],"kind":"symbol","title":"MXLOpus.Score","url":"\/documentation\/ivormxl\/mxlopus\/score","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Score"}]}}}