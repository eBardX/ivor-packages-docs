rMXL/documentation/IvorMXL/MXLOpus/Score":{"abstract":[{"text":"The score elements provide the links to the individual scores within an opus. The new-page attribute, added in","type":"text"},{"text":" ","type":"text"},{"text":"Version 2.0, is used to indicate if the first page of the score is different than the last page of the","type":"text"},{"text":" ","type":"text"},{"text":"previous score. If new-page is “yes”, then a different page is used; if “no”, then the same page is used. The","type":"text"},{"text":" ","type":"text"},{"text":"default value is implementation-dependent.","type":"text"}],"title":"MXLOpus.Score","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Score","kind":"identifier"}],"navigatorTitle":[{"text":"Score","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlopus\/score","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOpus\/Score"},"doc://IvorMXL/documentation/IvorMXL/MXLOpus/Score/!=(_:_:)":{"url":"\/documentation\/ivormxl\/mxlopus\/score\/!=(_:_:)","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOpus\/Score\/!=(_:_:)","kind":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"!="},{"kind":"text","text":" "},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}],"title":"!=(_:_:)","abstract":[],"type":"topic","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLOpus":{"navigatorTitle":[{"kind":"identifier","text":"MXLOpus"}],"abstract":[{"text":"The opus type is used for the root element of a MusicXML opus. Each opus is made up of a series of score,","type":"text"},{"text":" ","type":"text"},{"text":"opus-link, and\/or nested opus elements. The document-attributes attribute group includes the version","type":"text"},{"text":" ","type":"text"},{"text":"attribute. Future versions may include more metadata elements. In this version, we just include the title of","type":"text"},{"text":" ","type":"text"},{"text":"the opus.","type":"text"}],"title":"MXLOpus","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOpus","kind":"symbol","url":"\/documentation\/ivormxl\/mxlopus","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLOpus"}],"role":"symbol"}}}