nd":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Score"}],"abstract":[{"type":"text","text":"The score elements provide the links to the individual scores within an opus. The new-page attribute, added in"},{"type":"text","text":" "},{"type":"text","text":"Version 2.0, is used to indicate if the first page of the score is different than the last page of the"},{"type":"text","text":" "},{"type":"text","text":"previous score. If new-page is “yes”, then a different page is used; if “no”, then the same page is used. The"},{"type":"text","text":" "},{"type":"text","text":"default value is implementation-dependent."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Score"}],"title":"MXLOpus.Score"},"doc://IvorMXL/documentation/IvorMXL/MXLOpus/Score/newPage":{"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOpus\/Score\/newPage","abstract":[{"text":"A Boolean value indicating whether the first page of the score is different from the last page of the","type":"text"},{"text":" ","type":"text"},{"text":"previous score. The default value is implementation-dependent.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlopus\/score\/newpage","type":"topic","role":"symbol","title":"newPage","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"newPage","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":"?","kind":"text"}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLOpus":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlopus","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOpus","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLOpus"}],"abstract":[{"type":"text","text":"The opus type is used for the root element of a MusicXML opus. Each opus is made up of a series of score,"},{"type":"text","text":" "},{"type":"text","text":"opus-link, and\/or nested opus elements. The document-attributes attribute group includes the version"},{"type":"text","text":" "},{"type":"text","text":"attribute. Future versions may include more metadata elements. In this version, we just include the title of"},{"type":"text","text":" "},{"type":"text","text":"the opus."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLOpus"}],"title":"MXLOpus"}}}