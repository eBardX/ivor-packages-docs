ribute, added in"},{"type":"text","text":" "},{"type":"text","text":"Version 2.0, is used to indicate if the first page of the score is different than the last page of the"},{"type":"text","text":" "},{"type":"text","text":"previous score. If new-page is “yes”, then a different page is used; if “no”, then the same page is used. The"},{"type":"text","text":" "},{"type":"text","text":"default value is implementation-dependent."}],"url":"\/documentation\/ivormxl\/mxlopus\/score","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Score"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Score"}],"type":"topic","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOpus\/Score"},"doc://IvorMXL/documentation/IvorMXL/MXLOpus/Score/newPage":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOpus\/Score\/newPage","kind":"symbol","title":"newPage","url":"\/documentation\/ivormxl\/mxlopus\/score\/newpage","type":"topic","role":"symbol","abstract":[{"text":"A Boolean value indicating whether the first page of the score is different from the last page of the","type":"text"},{"text":" ","type":"text"},{"text":"previous score. The default value is implementation-dependent.","type":"text"}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"text":"newPage","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":"?","kind":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLOpus":{"title":"MXLOpus","url":"\/documentation\/ivormxl\/mxlopus","abstract":[{"type":"text","text":"The opus type is used for the root element of a MusicXML opus. Each opus is made up of a series of score,"},{"type":"text","text":" "},{"type":"text","text":"opus-link, and\/or nested opus elements. The document-attributes attribute group includes the version"},{"type":"text","text":" "},{"type":"text","text":"attribute. Future versi