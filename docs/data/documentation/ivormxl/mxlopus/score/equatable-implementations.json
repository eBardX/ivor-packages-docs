udes the version","type":"text"},{"text":" ","type":"text"},{"text":"attribute. Future versions may include more metadata elements. In this version, we just include the title of","type":"text"},{"text":" ","type":"text"},{"text":"the opus.","type":"text"}],"title":"MXLOpus","kind":"symbol","url":"\/documentation\/ivormxl\/mxlopus","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLOpus"}]},"doc://IvorMXL/documentation/IvorMXL/MXLOpus/Score":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOpus\/Score","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Score"}],"abstract":[{"type":"text","text":"The score elements provide the links to the individual scores within an opus. The new-page attribute, added in"},{"type":"text","text":" "},{"type":"text","text":"Version 2.0, is used to indicate if the first page of the score is different than the last page of the"},{"type":"text","text":" "},{"type":"text","text":"previous score. If new-page is “yes”, then a different page is used; if “no”, then the same page is used. The"},{"type":"text","text":" "},{"type":"text","text":"default value is implementation-dependent."}],"kind":"symbol","title":"MXLOpus.Score","url":"\/documentation\/ivormxl\/mxlopus\/score","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Score"}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"}}}