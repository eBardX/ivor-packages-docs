{"sections":[],"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOpus\/Score\/Equatable-Implementations"},"metadata":{"modules":[{"name":"IvorMXL"}],"role":"collectionGroup","title":"Equatable Implementations","roleHeading":"API Collection"},"topicSections":[{"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOpus\/Score\/!=(_:_:)"],"title":"Operators","anchor":"Operators","generated":true}],"variants":[{"paths":["\/documentation\/ivormxl\/mxlopus\/score\/equatable-implementations"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOpus","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOpus\/Score"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLOpus/Score":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlopus\/score","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOpus\/Score","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Score"}],"abstract":[{"type":"text","text":"The score elements provide the links to the individual scores within an opus. The new-page attribute, added in"},{"type":"text","text":" "},{"type":"text","text":"Version 2.0, is used to indicate if the first page of the score is different than the last page of the"},{"type":"text","text":" "},{"type":"text","text":"previous score. If new-page is “yes”, then a different page is used; if “no”, then the same page is used. The"},{"type":"text","text":" "},{"type":"text","text":"default value is implementation-dependent."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Score"}],"title":"MXLOpus.Score"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","tit