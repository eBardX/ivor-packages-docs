L\/documentation\/IvorMXL\/MXLPosition","preciseIdentifier":"s:7IvorMXL11MXLPositionV","kind":"typeIdentifier","text":"MXLPosition"},{"kind":"text","text":" = MXLPosition(), "},{"kind":"externalParam","text":"font"},{"kind":"text","text":": "},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","preciseIdentifier":"s:7IvorMXL7MXLFontV","kind":"typeIdentifier","text":"MXLFont"},{"kind":"text","text":" = MXLFont(), "},{"kind":"externalParam","text":"color"},{"kind":"text","text":": "},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","preciseIdentifier":"s:7IvorMXL8MXLColorV","kind":"typeIdentifier","text":"MXLColor"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"smufl"},{"kind":"text","text":": "},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSmuflAccidentalGlyphName","preciseIdentifier":"s:7IvorMXL27MXLSmuflAccidentalGlyphNameV","kind":"typeIdentifier","text":"MXLSmuflAccidentalGlyphName"},{"kind":"text","text":"? = nil)"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"name":"value","content":[{"inlineContent":[{"type":"text","text":"The value of this element."}],"type":"paragraph"}]},{"name":"isCautionary","content":[{"inlineContent":[{"type":"text","text":"A Boolean value indicating whether this accidental is cautionary."}],"type":"paragraph"}]},{"name":"isEditorial","content":[{"inlineContent":[{"type":"text","text":"A Boolean value indicating whether this accidental is editorial."}],"type":"paragraph"}]},{"name":"levelDisplay","content":[{"inlineContent":[{"type":"text","text":"The level-display attribute group specifies three common ways to indicate editorial indications: putting parentheses or square brackets around a symbol, or making the symbol a different size. If not specified, they are left to application defaults. It is used by the level and accidental elements."}],"type":"paragraph"}]},{"name":"position","content":[{"inlineContent":[{"type":"text","text":"For most elements, any program will compute a default x and y position. The position attributes let this be changed two ways."}],"type":"paragraph"}]},{"name":"font","content":[{"inlineContent":[{"type":"text","text":"The font attribute group gathers together attributes for determining the font within a credit or direction. They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of font names.The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font vs. a music font."}],"type":"paragraph"}]},{"name":"color","content":[{"inlineContent":[{"type":"text","text":"The color attribute group indicates the color of an element."}],"type":"paragraph"}]},{"name":"smufl","content":[{"inlineContent":[{"type":"text","text":"The SMuFL canonical glyph name used to specify a particular accidental character."}],"type":"paragraph"}]}]}],"variants":[{"paths":["\/documentation\/ivormxl\/mxlaccidental\/init(value:iscautionary:iseditorial:leveldisplay:position:font:color:smufl:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLColor","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","title":"MXLColor","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlcolor"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLLevel/Display-swift.struct":{"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLevel\/Display-swift.struct","url":"\/documentation\/ivormxl\/mxllevel\/display-swift.struct","navigatorTitle":[{"text":"Display","kind":"identifier"}],"title":"MXLLevel.Display","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Display","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"The level-display attribute group specifies three common ways to indicate editorial indications: putting"},{"type":"text","text":" "},{"type":"text","text":"parentheses or square brackets around a symbol, or making the symbol a different size. If not specified, they"},{"type":"text","text":" "},{"type":"text","text":"are left to application defaults. It is used by the level and accidental elements."}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLFont":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLFont"}],"abstract":[{"text":"The font attribute group gathers together attributes for determining the font within a credit or direction.","type":"text"},{"text":" ","type":"text"},{"text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of","type":"text"},{"text":" ","type":"text"},{"text":"font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric","type":"text"},{"text":" ","type":"text"},{"text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font","type":"text"},{"text":" ","type":"text"},{"text":"vs. a music font.","type":"text"}],"kind":"symbol","title":"MXLFont","url":"\/documentation\/ivormxl\/mxlfont","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFont"}]},"doc://IvorMXL/documentation/IvorMXL/MXLSmuflAccidentalGlyphName":{"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlsmuflaccidentalglyphname","abstract":[{"type":"text","text":"The smufl-accidental-glyph-name type is used to reference a specific Standard Music Font Layout (SMuFL)"},{"type":"text","text":" "},{"type":"text","text":"accidental character. The value is a SMuFL canonical glyph name that starts with one of the strings used at"},{"type":"text","text":" "},{"type":"text","text":"the start of glyph names for SMuFL accidentals."}],"navigatorTitle":[{"text":"MXLSmuflAccidentalGlyphName","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSmuflAccidentalGlyphName","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSmuflAccidentalGlyphName","title":"MXLSmuflAccidentalGlyphName"},"doc://IvorMXL/documentation/IvorMXL/MXLAccidental/init(value:isCautionary:isEditorial:levelDisplay:position:font:color:smufl:)":{"title":"init(value:isCautionary:isEditorial:levelDisplay:position:font:color:smufl:)","url":"\/documentation\/ivormxl\/mxlaccidental\/init(value:iscautionary:iseditorial:leveldisplay:position:font:color:smufl:)","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidental\/init(value:isCautionary:isEditorial:levelDisplay:position:font:color:smufl:)","abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLAccidental"},{"type":"text","text":"."}],"kind":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"value"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL18MXLAccidentalValueO","text":"MXLAccidentalValue"},{"kind":"text","text":", "},{"kind":"externalParam","text":"isCautionary"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"isEditorial"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"levelDisplay"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLLevelV","text":"MXLLevel"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLLevelV7DisplayV","text":"Display"},{"kind":"text","text":", "},{"kind":"externalParam","text":"position"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLPositionV","text":"MXLPosition"},{"kind":"text","text":", "},{"kind":"externalParam","text":"font"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL7MXLFontV","text":"MXLFont"},{"kind":"text","text":", "},{"kind":"externalParam","text":"color"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLColorV","text":"MXLColor"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"smufl"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL27MXLSmuflAccidentalGlyphNameV","text":"MXLSmuflAccidentalGlyphName"},{"kind":"text","text":"?)"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLAccidentalValue":{"abstract":[{"text":"The accidental-value type represents notated accidentals supported by MusicXML. In the MusicXML 2.0 DTD this","type":"text"},{"text":" ","type":"text"},{"text":"was a string with values that could be included. The XSD strengthens the data typing to an enumerated list.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"The quarter- and three-quarters- accidentals are Tartini-style quarter-tone accidentals. The -down and -up"},{"type":"text","text":" "},{"text":"accidentals are quarter-tone accidentals that include arrows pointing down or up. The slash- accidentals are","type":"text"},{"text":" ","type":"text"},{"text":"used in Turkish classical music. The numbered sharp and flat accidentals are superscripted versions of the","type":"text"},{"text":" ","type":"text"},{"text":"accidental signs, used in Turkish folk music. The sori and koron accidentals are microtonal sharp and flat","type":"text"},{"text":" ","type":"text"},{"text":"accidentals used in Iranian and Persian music. The other accidental covers accidentals other than those listed","type":"text"},{"text":" ","type":"text"},{"text":"here. It is usually used in combination with the smufl attribute to specify a particular SMuFL accidental. The","type":"text"},{"text":" ","type":"text"},{"text":"smufl attribute may be used with any accidental value to help specify the appearance of symbols that share the","type":"text"},{"text":" ","type":"text"},{"text":"same MusicXML semantics.","type":"text"}],"role":"symbol","navigatorTitle":[{"text":"MXLAccidentalValue","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlaccidentalvalue","kind":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"text":" ","kind":"text"},{"kind":"identifier","text":"MXLAccidentalValue"}],"title":"MXLAccidentalValue","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidentalValue","type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLAccidental":{"title":"MXLAccidental","navigatorTitle":[{"kind":"identifier","text":"MXLAccidental"}],"type":"topic","abstract":[{"type":"text","text":"The accidental type represents actual notated accidentals. Editorial and cautionary indications are indicated"},{"type":"text","text":" "},{"type":"text","text":"by attributes. Values for these attributes are “no” if not present. Specific graphic display such as"},{"type":"text","text":" "},{"type":"text","text":"parentheses, brackets, and size are controlled by the level-display attribute group."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLAccidental"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidental","url":"\/documentation\/ivormxl\/mxlaccidental"},"doc://IvorMXL/documentation/IvorMXL/MXLLevel":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLLevel"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLLevel"}],"url":"\/documentation\/ivormxl\/mxllevel","role":"symbol","title":"MXLLevel","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLevel","type":"topic","abstract":[{"text":"The level type is used to specify editorial information for different MusicXML elements. The content contains","type":"text"},{"text":" ","type":"text"},{"text":"identifying and\/or descriptive text about the editorial status of the parent element.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLPosition":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLPosition"}],"abstract":[{"text":"For most elements, any program will compute a default x and y position. The position attributes let this be","type":"text"},{"text":" ","type":"text"},{"text":"changed two ways.","type":"text"}],"kind":"symbol","title":"MXLPosition","url":"\/documentation\/ivormxl\/mxlposition","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPosition"}]}}}