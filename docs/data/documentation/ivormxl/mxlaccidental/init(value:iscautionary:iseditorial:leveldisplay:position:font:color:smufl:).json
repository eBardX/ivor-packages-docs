{"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"init","kind":"keyword"},{"text":"(","kind":"text"},{"text":"value","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL18MXLAccidentalValueO","text":"MXLAccidentalValue","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidentalValue","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"isCautionary","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"isEditorial","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"levelDisplay","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL8MXLLevelV","text":"MXLLevel","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLevel","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:7IvorMXL8MXLLevelV7DisplayV","text":"Display","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLevel\/Display-swift.struct","kind":"typeIdentifier"},{"text":" = MXLLevel.Display(), ","kind":"text"},{"text":"position","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL11MXLPositionV","text":"MXLPosition","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","kind":"typeIdentifier"},{"text":" = MXLPosition(), ","kind":"text"},{"text":"font","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL7MXLFontV","text":"MXLFont","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","kind":"typeIdentifier"},{"text":" = MXLFont(), ","kind":"text"},{"text":"color","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL8MXLColorV","text":"MXLColor","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"smufl","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL27MXLSmuflAccidentalGlyphNameV","text":"MXLSmuflAccidentalGlyphName","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSmuflAccidentalGlyphName","kind":"typeIdentifier"},{"text":"? = nil)","kind":"text"}],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The value of this element."}]}],"name":"value"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A Boolean value indicating whether this accidental is cautionary."}]}],"name":"isCautionary"},{"content":[{"type":"paragraph","inlineContent":[{"text":"A Boolean value indicating whether this accidental is editorial.","type":"text"}]}],"name":"isEditorial"},{"name":"levelDisplay","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The level-display attribute group specifies three common ways to indicate editorial indications: putting parentheses or square brackets around a symbol, or making the symbol a different size. If not specified, they are left to application defaults. It is used by the level and accidental elements."}]}]},{"name":"position","content":[{"inlineContent":[{"text":"For most elements, any program will compute a default x and y position. The position attributes let this be changed two ways.","type":"text"}],"type":"paragraph"}]},{"name":"font","content":[{"inlineContent":[{"text":"The font attribute group gathers together attributes for determining the font within a credit or direction. They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of font names.The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font vs. a music font.","type":"text"}],"type":"paragraph"}]},{"name":"color","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The color attribute group indicates the color of an element."}]}]},{"content":[{"inlineContent":[{"text":"The SMuFL canonical glyph name used to specify a particular accidental character.","type":"text"}],"type":"paragraph"}],"name":"smufl"}]}],"kind":"symbol","metadata":{"symbolKind":"init","externalID":"s:7IvorMXL13MXLAccidentalV5value12isCautionary0E9Editorial12levelDisplay8position4font5color5smuflAcA0C5ValueO_SbSgAnA8MXLLevelV0I0VAA11MXLPositionVAA7MXLFontVAA8MXLColorVSgAA27MXLSmuflAccidentalGlyphNameVSgtcfc","roleHeading":"Initializer","modules":[{"name":"IvorMXL"}],"title":"init(value:isCautionary:isEditorial:levelDisplay:position:font:color:smufl:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"value","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL18MXLAccidentalValueO","text":"MXLAccidentalValue","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"isCautionary","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"isEditorial","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"levelDisplay","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL8MXLLevelV","text":"MXLLevel","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:7IvorMXL8MXLLevelV7DisplayV","text":"Display","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"position","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL11MXLPositionV","text":"MXLPosition","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"font","kind":"exte