{"variants":[{"paths":["\/documentation\/ivormxl\/mxlaccidental\/init(value:iscautionary:iseditorial:leveldisplay:position:font:color:smufl:)"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"value"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLAccidentalValue","preciseIdentifier":"s:7IvorMXL18MXLAccidentalValueO","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidentalValue"},{"kind":"text","text":", "},{"kind":"externalParam","text":"isCautionary"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"isEditorial"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"levelDisplay"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLLevel","preciseIdentifier":"s:7IvorMXL8MXLLevelV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLevel"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Display","preciseIdentifier":"s:7IvorMXL8MXLLevelV7DisplayV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLevel\/Display-swift.struct"},{"kind":"text","text":" = MXLLevel.Display(), "},{"kind":"externalParam","text":"position"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLPosition","preciseIdentifier":"s:7IvorMXL11MXLPositionV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition"},{"kind":"text","text":" = MXLPosition(), "},{"kind":"externalParam","text":"font"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLFont","preciseIdentifier":"s:7IvorMXL7MXLFontV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont"},{"kind":"text","text":" = MXLFont(), "},{"kind":"externalParam","text":"color"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLColor","preciseIdentifier":"s:7IvorMXL8MXLColorV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"smufl"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLSmuflAccidentalGlyphName","preciseIdentifier":"s:7IvorMXL27MXLSmuflAccidentalGlyphNameV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSmuflAccidentalGlyphName"},{"kind":"text","text":"? = nil)"}]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The value of this element.","type":"text"}]}],"name":"value"},{"content":[{"type":"paragraph","inlineContent":[{"text":"A Boolean value indicating whether this accidental is cautionary.","type":"text"}]}],"name":"isCautionary"},{"content":[{"type":"paragraph","inlineContent":[{"text":"A Boolean value indicating whether this accidental is editorial.","type":"text"}]}],"name":"isEditorial"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The level-display attribute group specifies three common ways to indicate editorial indications: putting parentheses or square brackets around a symbol, or making the symbol a different size. If not specified, they are left to application defaults. It is used by the level and accidental elements.","type":"text"}]}],"name":"levelDisplay"},{"content":[{"type":"paragraph","inlineContent":[{"text":"For most elements, any program will compute a default x and y position. The position attributes let this be changed two ways.","type":"text"}]}],"name":"position"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The font attribute group gathers together attributes for determining the font within a credit or direction. They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of font names.The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font vs. a music font.","type":"text"}]}],"name":"font"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The color attribute group indicates the color of an element.","type":"text"}]}],"name":"color"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The SMuFL canonical glyph name used to specify a particular accidental character.","type":"text"}]}],"name":"smufl"}]}],"metadata":{"modules":[{"name":"IvorMXL"}],"symbolKind":"init","role":"symbol","externalID":"s:7IvorMXL13MXLAccidentalV5value12isCautionary0E9Editorial12levelDisplay8position4font5color5smuflAcA0C5ValueO_SbSgAnA8MXLLevelV0I0VAA11MXLPositionVAA7MXLFontVAA8MXLColorVSgAA27MXLSmuflAccidentalGlyphNameVSgtcfc","roleHeading":"Initializer","title":"init(value:isCautionary:isEditorial:levelDisplay:position:font:color:smufl:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"value"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLAccidentalValue","preciseIdentifier":"s:7IvorMXL18MXLAccidentalValueO"},{"kind":"text","text":", "},{"kind":"externalParam","text":"isCautionary"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"isEditorial"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"levelDisplay"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLLevel","preciseIdentifier":"s:7IvorMXL8MXLLevelV"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Display","preciseIdentifier":"s:7IvorMXL8MXLLevelV7DisplayV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"position"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLPosition","preciseIdentifier":"s:7IvorMXL11MXLPositionV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"font"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLFont","preciseIdentifier":"s:7IvorMXL7MXLFontV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"color"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLColor","preciseIdentifier":"s:7IvorMXL8MXLColorV"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"smufl"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLSmuflAccidentalGlyphName","preciseIdentifier":"s:7IvorMXL27MXLSmuflAccidentalGlyphNameV"},{"kind":"text","text":"?)"}]},"abstract":[{"text":"Creates a new ","type":"text"},{"type":"codeVoice","code":"MXLAccidental"},{"text":".","type":"text"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidental\/init(value:isCautionary:isEditorial:levelDisplay:position:font:color:smufl:)"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidental"]]},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLPosition":{"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPosition","kind":"identifier"}],"title":"MXLPosition","navigatorTitle":[{"text":"MXLPosition","kind":"identifier"}],"abstract":[{"type":"text","text":"For most elements, any program will compute a default x and y position. The position attributes let this be"},{"type":"text","text":" "},{"type":"text","text":"changed two ways."}],"url":"\/documentation\/ivormxl\/mxlposition","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLAccidental":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlaccidental","title":"MXLAccidental","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLAccidental"}],"navigatorTitle":[{"kind":"identifier","text":"MXLAccidental"}],"abstract":[{"text":"The accidental type represents actual notated accidentals. Editorial and cautionary indications are indicated","type":"text"},{"text":" ","type":"text"},{"text":"by attributes. Values for these attributes are “no” if not present. Specific graphic display such as","type":"text"},{"text":" ","type":"text"},{"text":"parentheses, brackets, and size are controlled by the level-display attribute group.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidental"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlcolor","title":"MXLColor","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"type":"text","text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is"},{"type":"text","text":" "},{"type":"text","text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor"},"doc://IvorMXL/documentation/IvorMXL/MXLSmuflAccidentalGlyphName":{"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSmuflAccidentalGlyphName","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlsmuflaccidentalglyphname","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSmuflAccidentalGlyphName","navigatorTitle":[{"text":"MXLSmuflAccidentalGlyphName","kind":"identifier"}],"abstract":[{"type":"text","text":"The smufl-accidental-glyph-name type is used to reference a specific Standard Music Font Layout (SMuFL)"},{"type":"text","text":" "},{"type":"text","text":"accidental character. The value is a SMuFL canonical glyph name that starts with one of the strings used at"},{"type":"text","text":" "},{"type":"text","text":"the start of glyph names for SMuFL accidentals."}],"title":"MXLSmuflAccidentalGlyphName","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLLevel":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxllevel","title":"MXLLevel","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLLevel"}],"navigatorTitle":[{"kind":"identifier","text":"MXLLevel"}],"abstract":[{"text":"The level type is used to specify editorial information for different MusicXML elements. The content contains","type":"text"},{"text":" ","type":"text"},{"text":"identifying and\/or descriptive text about the editorial status of the parent element.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLevel"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLAccidentalValue":{"title":"MXLAccidentalValue","url":"\/documentation\/ivormxl\/mxlaccidentalvalue","role":"symbol","navigatorTitle":[{"text":"MXLAccidentalValue","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidentalValue","kind":"symbol","abstract":[{"type":"text","text":"The accidental-value type represents notated accidentals supported by MusicXML. In the MusicXML 2.0 DTD this"},{"type":"text","text":" "},{"type":"text","text":"was a string with values that could be included. The XSD strengthens the data typing to an enumerated list."},{"type":"text","text":" "},{"type":"text","text":"The quarter- and three-quarters- accidentals are Tartini-style quarter-tone accidentals. The -down and -up"},{"type":"text","text":" "},{"type":"text","text":"accidentals are quarter-tone accidentals that include arrows pointing down or up. The slash- accidentals are"},{"type":"text","text":" "},{"type":"text","text":"used in Turkish classical music. The numbered sharp and flat accidentals are superscripted versions of the"},{"type":"text","text":" "},{"type":"text","text":"accidental signs, used in Turkish folk music. The sori and koron accidentals are microtonal sharp and flat"},{"type":"text","text":" "},{"type":"text","text":"accidentals used in Iranian and Persian music. The other accidental covers accidentals other than those listed"},{"type":"text","text":" "},{"type":"text","text":"here. It is usually used in combination with the smufl attribute to specify a particular SMuFL accidental. The"},{"type":"text","text":" "},{"type":"text","text":"smufl attribute may be used with any accidental value to help specify the appearance of symbols that share the"},{"type":"text","text":" "},{"type":"text","text":"same MusicXML semantics."}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLAccidentalValue","kind":"identifier"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLFont":{"title":"MXLFont","url":"\/documentation\/ivormxl\/mxlfont","role":"symbol","navigatorTitle":[{"text":"MXLFont","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","abstract":[{"text":"The font attribute group gathers together attributes for determining the font within a credit or direction.","type":"text"},{"text":" ","type":"text"},{"text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric"},{"type":"text","text":" "},{"type":"text","text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font"},{"type":"text","text":" "},{"type":"text","text":"vs. a music font."}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLFont","kind":"identifier"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLAccidental/init(value:isCautionary:isEditorial:levelDisplay:position:font:color:smufl:)":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlaccidental\/init(value:iscautionary:iseditorial:leveldisplay:position:font:color:smufl:)","title":"init(value:isCautionary:isEditorial:levelDisplay:position:font:color:smufl:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"value"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL18MXLAccidentalValueO","text":"MXLAccidentalValue"},{"kind":"text","text":", "},{"kind":"externalParam","text":"isCautionary"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"isEditorial"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"levelDisplay"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLLevelV","text":"MXLLevel"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLLevelV7DisplayV","text":"Display"},{"kind":"text","text":", "},{"kind":"externalParam","text":"position"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLPositionV","text":"MXLPosition"},{"kind":"text","text":", "},{"kind":"externalParam","text":"font"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL7MXLFontV","text":"MXLFont"},{"kind":"text","text":", "},{"kind":"externalParam","text":"color"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLColorV","text":"MXLColor"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"smufl"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL27MXLSmuflAccidentalGlyphNameV","text":"MXLSmuflAccidentalGlyphName"},{"kind":"text","text":"?)"}],"abstract":[{"text":"Creates a new ","type":"text"},{"type":"codeVoice","code":"MXLAccidental"},{"text":".","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidental\/init(value:isCautionary:isEditorial:levelDisplay:position:font:color:smufl:)"},"doc://IvorMXL/documentation/IvorMXL/MXLLevel/Display-swift.struct":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxllevel\/display-swift.struct","title":"MXLLevel.Display","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Display"}],"navigatorTitle":[{"kind":"identifier","text":"Display"}],"abstract":[{"text":"The level-display attribute group specifies three common ways to indicate editorial indications: putting","type":"text"},{"text":" ","type":"text"},{"text":"parentheses or square brackets around a symbol, or making the symbol a different size. If not specified, they","type":"text"},{"text":" ","type":"text"},{"text":"are left to application defaults. It is used by the level and accidental elements.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLevel\/Display-swift.struct"}}}