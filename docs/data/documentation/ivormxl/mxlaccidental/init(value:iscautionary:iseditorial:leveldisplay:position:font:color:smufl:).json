endent, but is a text font","type":"text"},{"text":" ","type":"text"},{"text":"vs. a music font.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLFont"}],"url":"\/documentation\/ivormxl\/mxlfont"},"doc://IvorMXL/documentation/IvorMXL/MXLAccidental/init(value:isCautionary:isEditorial:levelDisplay:position:font:color:smufl:)":{"abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLAccidental"},{"type":"text","text":"."}],"title":"init(value:isCautionary:isEditorial:levelDisplay:position:font:color:smufl:)","url":"\/documentation\/ivormxl\/mxlaccidental\/init(value:iscautionary:iseditorial:leveldisplay:position:font:color:smufl:)","kind":"symbol","role":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"value"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL18MXLAccidentalValueO","text":"MXLAccidentalValue"},{"kind":"text","text":", "},{"kind":"externalParam","text":"isCautionary"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"isEditorial"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"levelDisplay"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLLevelV","text":"MXLLevel"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLLevelV7DisplayV","text":"Display"},{"kind":"text","text":", "},{"kind":"externalParam","text":"position"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLPositionV","text":"MXLPosition"},{"kind":"text","text":", "},{"kind":"externalParam","text":"font"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL7MXLFontV","text":"MXLFont"},{"kind":"text","text":", "},{"kind":"externalParam","text":"color"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLColorV","text":"MXLColor"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"smufl"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL27MXLSmuflAccidentalGlyphNameV","text":"MXLSmuflAccidentalGlyphName"},{"kind":"text","text":"?)"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidental\/init(value:isCautionary:isEditorial:levelDisplay:position:font:color:smufl:)"},"doc://IvorMXL/documentation/IvorMXL/MXLLevel":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLLevel","kind":"identifier"}],"navigatorTitle":[{"text":"MXLLevel","kind":"identifier"}],"title":"MXLLevel","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLevel","kind":"symbol","url":"\/documentation\/ivormxl\/mxllevel","type":"topic","abstract":[{"type":"text","text":"The level type is used to specify editorial information for different MusicXML elements. The content contains"},{"type":"text","text":" "},{"type":"text","text":"identifying and\/or descriptive text about the editorial status of the parent element."}]},"doc://IvorMXL/documentation/IvorMXL/MXLPosition":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlposition","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPosition"}],"kind":"symbol","abstract":[{"text":"For most elements, any program will compute a default x and y position. The position attributes let this be","type":"text"},{"text":" ","type":"text"},{"text":"changed two ways.","type":"text"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLPosition"}],"title":"MXLPosition"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLLevel/Display-swift.struct":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Display","kind":"identifier"}],"navigatorTitle":[{"text":"Display","kind":"identifier"}],"title":"MXLLevel.Display","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLevel\/Display-swift.struct","kind":"symbol","url":"\/documentation\/ivormxl\/mxllevel\/display-swift.struct","type":"topic","abstract":[{"text":"The level-display attribute group specifies three common ways to indicate editorial indications: putting","type":"text"},{"text":" ","type":"text"},{"text":"parentheses or square brackets around a symbol, or making the symbol a different size. If not specified, they","type":"text"},{"text":" ","type":"text"},{"text":"are left to application defaults. It is used by the level and accidental elements.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLSmuflAccidentalGlyphName":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlsmuflaccidentalglyphname","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSmuflAccidentalGlyphName","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLSmuflAccidentalGlyphName"}],"abstract":[{"type":"text","text":"The smufl-accidental-glyph-name type is used to reference a specific Standard Music Font Layout (SMuFL)"},{"type":"text","text":" "},{"type":"text","text":"accidental character. The value is a SMuFL canonical glyph name that starts with one of the strings used at"},{"type":"text","text":" "},{"type":"text","text":"the start of glyph names for SMuFL accidentals."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLSmuflAccidentalGlyphName"}],"title":"MXLSmuflAccidentalGlyphName"},"doc://IvorMXL/documentation/IvorMXL/MXLAccidentalValue":{"title":"MXLAccidentalValue","kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLAccidentalValue","kind":"identifier"}],"abstract":[{"text":"The accidental-value type represents notated accidentals supported by MusicXML. In the MusicXML 2.0 DTD this","type":"text"},{"text":" ","type":"text"},{"text":"was a string with values that could be included. The XSD strengthens the data typing to an enumerated list.","type":"text"},{"text":" ","type":"text"},{"text":"The quarter- and three-quarters- accidentals are Tartini-style quarter-tone accidentals. The -down and -up","type":"text"},{"text":" ","type":"text"},{"text":"accidentals are quarter-tone accidentals that include arrows pointing down or up. The slash- accidentals are","type":"text"},{"text":" ","type":"text"},{"text":"used in Turkish classical music. The numbered sharp and flat accidentals are superscripted versions of the","type":"text"},{"text":" ","type":"text"},{"text":"accidental signs, used in Turkish folk music. The sori and koron accidentals are microtonal sharp and flat","type":"text"},{"text":" ","type":"text"},{"text":"accidentals used in Iranian and Persian music. The other accidental covers accidentals other than those listed","type":"text"},{"text":" ","type":"text"},{"text":"here. It is usually used in combination with the smufl attribute to specify a particular SMuFL accidental. The","type":"text"},{"text":" ","type":"text"},{"text":"smufl attribute may be used with any accidental value to help specify the appearance of symbols that share the","type":"text"},{"text":" ","type":"text"},{"text":"same MusicXML semantics.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidentalValue","role":"symbol","navigatorTitle":[{"text":"MXLAccidentalValue","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlaccidentalvalue"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"title":"MXLColor","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"abstract":[{"text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in","type":"text"},{"text":" ","type":"text"},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"url":"\/documentation\/ivormxl\/mxlcolor"},"doc://IvorMXL/documentation/IvorMXL/MXLAccidental":{"type":"topic","abstract":[{"type":"text","text":"The accidental type represents actual notated accidentals. Editorial and cautionary indications are indicated"},{"type":"text","text":" "},{"type":"text","text":"by attributes. Values for these attributes are “no” if not present. Specific graphic display such as"},{"type":"text","text":" "},{"type":"text","text":"parentheses, brackets, and size are controlled by the level-display attribute group."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLAccidental","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"text":"MXLAccidental","kind":"identifier"}],"title":"MXLAccidental","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidental","url":"\/documentation\/ivormxl\/mxlaccidental","kind":"symbol"}}}