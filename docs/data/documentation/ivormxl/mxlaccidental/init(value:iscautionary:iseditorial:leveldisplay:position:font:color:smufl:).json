f font names.The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font vs. a music font."}]}]},{"name":"color","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The color attribute group indicates the color of an element."}]}]},{"name":"smufl","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The SMuFL canonical glyph name used to specify a particular accidental character."}]}]}],"kind":"parameters"}],"metadata":{"title":"init(value:isCautionary:isEditorial:levelDisplay:position:font:color:smufl:)","modules":[{"name":"IvorMXL"}],"externalID":"s:7IvorMXL13MXLAccidentalV5value12isCautionary0E9Editorial12levelDisplay8position4font5color5smuflAcA0C5ValueO_SbSgAnA8MXLLevelV0I0VAA11MXLPositionVAA7MXLFontVAA8MXLColorVSgAA27MXLSmuflAccidentalGlyphNameVSgtcfc","role":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"value","kind":"externalParam"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLAccidentalValue","preciseIdentifier":"s:7IvorMXL18MXLAccidentalValueO"},{"kind":"text","text":", "},{"kind":"externalParam","text":"isCautionary"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"isEditorial"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"levelDisplay"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL8MXLLevelV","text":"MXLLevel","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:7IvorMXL8MXLLevelV7DisplayV","text":"Display","kind":"typeIdentifier"},{"kind":"text","text":", "},{"text":"position","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL11MXLPositionV","text":"MXLPosition","kind":"typeIdentifier"},{"kind":"text","text":", "},{"text":"font","kind":"externalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"MXLFont","preciseIdentifier":"s:7IvorMXL7MXLFontV"},{"text":", ","kind":"text"},{"kind":"externalParam","text":"color"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLColor","preciseIdentifier":"s:7IvorMXL8MXLColorV"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"smufl"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL27MXLSmuflAccidentalGlyphNameV","text":"MXLSmuflAccidentalGlyphName","kind":"typeIdentifier"},{"text":"?)","kind":"text"}],"symbolKind":"init","roleHeading":"Initializer"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidental"]]},"abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLAccidental"},{"type":"text","text":"."}],"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlaccidental\/init(value:iscautionary:iseditorial:leveldisplay:position:font:color:smufl:)"]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLPosition":{"title":"MXLPosition","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPosition"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlposition","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","abstract":[{"text":"For most elements, any program will compute a default x and y position. The position attributes let this be","type":"text"},{"text":" ","type":"text"},{"text":"changed two ways.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"MXLPosition"}]},"doc://IvorMXL/documentation/IvorMXL/MXLSmuflAccidentalGlyphName":{"title":"MXLSmuflAccidentalGlyphName","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSmuflAccidentalGlyphName","kind":"identifier"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlsmuflaccidentalglyphname","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSmuflAccidentalGlyphName","abstract":[{"text":"The smufl-accidental-glyph-name type is used to reference a specific Standard Music Font Layout (SMuFL)","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"accidental character. The value is a SMuFL canonical glyph name that starts with one of the strings used at"},{"type":"text","text":" "},{"text":"the start of glyph names for SMuFL accidentals.","type":"text"}],"navigatorTitle":[{"text":"MXLSmuflAccidentalGlyphName","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLLevel/Display-swift.struct":{"title":"MXLLevel.Display","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Display"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxllevel\/display-swift.struct","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLevel\/Display-swift.struct","abstract":[{"text":"The level-display attribute group specifies three common ways to indicate editorial indications: putting","type":"text"},{"text":" ","type":"text"},{"text":"parentheses or square brackets around a symbol, or making the symbol a different size. If not specified, they","type":"text"},{"text":" ","type":"text"},{"text":"are left to application defaults. It is used by the level and accidental elements.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"Display"}]},"doc://IvorMXL/documentation/IvorMXL/MXLAccidental/init(value:isCautionary:isEditorial:levelDisplay:position:font:color:smufl:)":{"url":"\/documentation\/ivormxl\/mxlaccidental\/init(value:iscautionary:iseditorial:leveldisplay:position:font:color:smufl:)","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidental\/init(value:isCautionary:isEditorial:levelDisplay:position:font:color:smufl:)","role":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"value","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL18MXLAccidentalValueO","text":"MXLAccidentalValue","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"isCautionary","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"isEditorial","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"levelDisplay","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL8MXLLevelV","text":"MXLLevel","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:7IvorMXL8MXLLevelV7DisplayV","text":"Display","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"position","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL11MXLPositionV","text":"MXLPosition","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"font","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL7MXLFontV","text":"MXLFont","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"color","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL8MXLColorV","text":"MXLColor","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"smufl","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL27MXLSmuflAccidentalGlyphNameV","text":"MXLSmuflAccidentalGlyphName","kind":"typeIdentifier"},{"text":"?)","kind":"text"}],"kind":"symbol","abstract":[{"text":"Creates a new ","type":"text"},{"code":"MXLAccidental","type":"codeVoice"},{"text":".","type":"text"}],"type":"topic","title":"init(value:isCautionary:isEditorial:levelDisplay:position:font:color:smufl:)"},"doc://IvorMXL/documentation/IvorMXL/MXLAccidentalValue":{"title":"MXLAccidentalValue","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLAccidentalValue","kind":"identifier"}],"kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxlaccidentalvalue","abstract":[{"text":"The accidental-value type represents notated accidentals supported by MusicXML. In the MusicXML 2.0 DTD this","type":"text"},{"text":" ","type":"text"},{"text":"was a string with values that could be included. The XSD strengthens the data typing to an enumerated list.","type":"text"},{"text":" ","type":"text"},{"text":"The quarter- and three-quarters- accidentals are Tartini-style quarter-tone accidentals. The -down and -up","type":"text"},{"type":"text","text":" "},{"type":"text","text":"accidentals are quarter-tone accidentals that include arrows pointing down or up. The slash- accidentals are"},{"type":"text","text":" "},{"type":"text","text":"used in Turkish classical music. The numbered sharp and flat accidentals are superscripted versions of the"},{"type":"text","text":" "},{"type":"text","text":"accidental signs, used in Turkish folk music. The sori and koron accidentals are microtonal sharp and flat"},{"type":"text","text":" "},{"type":"text","text":"accidentals used in Iranian and Persian music. The other accidental covers accidentals other than those listed"},{"type":"text","text":" "},{"type":"text","text":"here. It is usually used in combination with the smufl attribute to specify a particular SMuFL accidental. The"},{"type":"text","text":" "},{"type":"text","text":"smufl attribute may be used with any accidental value to help specify the appearance of symbols that share the"},{"type":"text","text":" "},{"type":"text","text":"same MusicXML semantics."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidentalValue","navigatorTitle":[{"text":"MXLAccidentalValue","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLFont":{"navigatorTitle":[{"text":"MXLFont","kind":"identifier"}],"abstract":[{"text":"The font attribute group gathers together attributes for determining the font within a credit or direction.","type":"text"},{"text":" ","type":"text"},{"text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of","type":"text"},{"text":" ","type":"text"},{"text":"font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric","type":"text"},{"text":" ","type":"text"},{"text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font","type":"text"},{"text":" ","type":"text"},{"text":"vs. a music font.","type":"text"}],"title":"MXLFont","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","kind":"symbol","url":"\/documentation\/ivormxl\/mxlfont","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLFont","kind":"identifier"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLAccidental":{"abstract":[{"type":"text","text":"The accidental type represents actual notated accidentals. Editorial and cautionary indications are indicated"},{"type":"text","text":" "},{"type":"text","text":"by attributes. Values for these attributes are “no” if not present. Specific graphic display such as"},{"type":"text","text":" "},{"type":"text","text":"parentheses, brackets, and size are controlled by the level-display attribute group."}],"title":"MXLAccidental","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLAccidental","kind":"identifier"}],"navigatorTitle":[{"text":"MXLAccidental","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlaccidental","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidental"},"doc://IvorMXL/documentation/IvorMXL/MXLLevel":{"navigatorTitle":[{"text":"MXLLevel","kind":"identifier"}],"abstract":[{"type":"text","text":"The level type is used to specify editorial information for different MusicXML elements. The content contains"},{"type":"text","text":" "},{"type":"text","text":"identifying and\/or descriptive text about the editorial status of the parent element."}],"title":"MXLLevel","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLevel","kind":"symbol","url":"\/documentation\/ivormxl\/mxllevel","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLLevel","kind":"identifier"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"abstract":[{"text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in","type":"text"},{"type":"text","text":" "},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"title":"MXLColor","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlcolor","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor"}}}