{"kind":"symbol","abstract":[{"text":"The value of this element.","type":"text"}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidental\/value","interfaceLanguage":"swift"},"metadata":{"symbolKind":"property","roleHeading":"Instance Property","externalID":"s:7IvorMXL13MXLAccidentalV5valueAA0C5ValueOvp","title":"value","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"value"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL18MXLAccidentalValueO","kind":"typeIdentifier","text":"MXLAccidentalValue"}],"modules":[{"name":"IvorMXL"}]},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"value"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL18MXLAccidentalValueO","kind":"typeIdentifier","text":"MXLAccidentalValue","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidentalValue"}],"languages":["swift"]}],"kind":"declarations"}],"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidental"]]},"variants":[{"paths":["\/documentation\/ivormxl\/mxlaccidental\/value"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLAccidental/value":{"type":"topic","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidental\/value","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"value","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLAccidentalValue","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL18MXLAccidentalValueO"}],"url":"\/documentation\/ivormxl\/mxlaccidental\/value","title":"value","abstract":[{"text":"The value of this element.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLAccidentalValue":{"type":"topic","abstract":[{"type":"text","text":"The accidental-value type represents notated accidentals supported by MusicXML. In the MusicXML 2.0 DTD this"},{"type":"text","text":" "},{"type":"text","text":"was a string with values that could be included. The XSD strengthens the data typing to an enumerated list."},{"type":"text","text":" "},{"type":"text","text":"The quarter- and three-quarters- accidentals are Tartini-style quarter-tone accidentals. The -down and -up"},{"type":"text","text":" "},{"type":"text","text":"accidentals are quarter-tone accidentals that include arrows pointing down or up. The slash- accidentals are"},{"type":"text","text":" "},{"type":"text","text":"used in Turkish classical music. The numbered sharp and flat accidentals are superscripted versions of the"},{"type":"text","text":" "},{"type":"text","text":"accidental signs, used in Turkish folk music. The sori and koron accidentals are microtonal sharp and flat"},{"type":"text","text":" "},{"type":"text","text":"accidentals used in Iranian and Persian music. The other accidental covers accidentals other than those listed"},{"type":"text","text":" "},{"type":"text","text":"here. It is usually used in combination with the smufl attribute to specify a particular SMuFL accidental. The"},{"type":"text","text":" "},{"type":"text","text":"smufl attribute may be used with any accidental value to help specify the appearance of symbols that share the"},{"type":"text","text":" "},{"type":"text","text":"same MusicXML semantics."}],"url":"\/documentation\/ivormxl\/mxlaccidentalvalue","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLAccidentalValue"}],"kind":"symbol","title":"MXLAccidentalValue","navigatorTitle":[{"kind":"identifier","text":"MXLAccidentalValue"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidentalValue","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLAccidental":{"type":"topic","abstract":[{"text":"The accidental type represents actual notated accidentals. Editorial and cautionary indications are indicated","type":"text"},{"text":" ","type":"text"},{"text":"by attributes. Values for these attributes are “no” if not present. Specific graphic display such as","type":"text"},{"text":" ","type":"text"},{"text":"parentheses, brackets, and size are controlled by the level-display attribute group.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlaccidental","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLAccidental"}],"kind":"symbol","title":"MXLAccidental","navigatorTitle":[{"kind":"identifier","text":"MXLAccidental"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidental","role":"symbol"}}}