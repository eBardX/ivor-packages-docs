ing alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"title":"MXLColor","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlcolor","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor"},"doc://IvorMXL/documentation/IvorMXL/MXLAccidental":{"abstract":[{"type":"text","text":"The accidental type represents actual notated accidentals. Editorial and cautionary indications are indicated"},{"type":"text","text":" "},{"type":"text","text":"by attributes. Values for these attributes are “no” if not present. Specific graphic display such as"},{"type":"text","text":" "},{"type":"text","text":"parentheses, brackets, and size are controlled by the level-display attribute group."}],"title":"MXLAccidental","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLAccidental","kind":"identifier"}],"navigatorTitle":[{"text":"MXLAccidental","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlaccidental","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidental"},"doc://IvorMXL/documentation/IvorMXL/MXLAccidental/color":{"title":"color","url":"\/documentation\/ivormxl\/mxlaccidental\/color","type":"topic","abstract":[{"type":"text","text":"The color attribute group indicates the color of an element."}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"color","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL8MXLColorV","text":"MXLColor","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"role":"symbol","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation