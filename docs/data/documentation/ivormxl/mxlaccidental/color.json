sparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlcolor"},"doc://IvorMXL/documentation/IvorMXL/MXLAccidental":{"title":"MXLAccidental","navigatorTitle":[{"kind":"identifier","text":"MXLAccidental"}],"type":"topic","abstract":[{"type":"text","text":"The accidental type represents actual notated accidentals. Editorial and cautionary indications are indicated"},{"type":"text","text":" "},{"type":"text","text":"by attributes. Values for these attributes are “no” if not present. Specific graphic display such as"},{"type":"text","text":" "},{"type":"text","text":"parentheses, brackets, and size are controlled by the level-display attribute group."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLAccidental"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidental","url":"\/documentation\/ivormxl\/mxlaccidental"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLAccidental/color":{"role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidental\/color","type":"topic","kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"color","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL8MXLColorV","text":"MXLColor","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"title":"color","abstract":[{"text":"The color attribute group indicates the color of an element.","type":"text"}],"url":"\/documentation