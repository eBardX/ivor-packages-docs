mxl\/mxlglissando\/init(id:value:kind:number:linekind:dashlength:spacelength:position:font:color:)","abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLGlissando"},{"type":"text","text":"."}],"kind":"symbol","title":"init(id:value:kind:number:lineKind:dashLength:spaceLength:position:font:color:)","type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLGlissando":{"url":"\/documentation\/ivormxl\/mxlglissando","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLGlissando"}],"title":"MXLGlissando","abstract":[{"type":"text","text":"Glissando and slide types both indicate rapidly moving from one pitch to the other so that individual notes"},{"type":"text","text":" "},{"type":"text","text":"are not discerned. A glissando sounds the distinct notes in between the two pitches and defaults to a wavy"},{"type":"text","text":" "},{"type":"text","text":"line. The optional text is printed alongside the line."}],"navigatorTitle":[{"kind":"identifier","text":"MXLGlissando"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLGlissando"},"doc://IvorMXL/documentation/IvorMXL/MXLLineKind":{"abstract":[{"text":"The line-type type distinguishes between solid, dashed, dotted, and wavy lines.","type":"text"}],"title":"MXLLineKind","url":"\/documentation\/ivormxl\/mxllinekind","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLLineKind","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"MXLLineKind","kind":"identifier"}],"type":"topic","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLineKind"},"doc://IvorMXL/documentation/IvorMXL/MXLStartStop":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlstartstop","title":"MXLStartStop","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLStartStop","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"MXLStartStop"}],"abstract":[{"type":"text","text":"The start-stop type is used for an attribute of musical elements that can either start or stop, such as"},{"type":"text","text":" "},{"type":"text","text":"tuplets."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStartStop"},"doc://IvorMXL/documentation/IvorMXL/MXLTenths":{"title":"MXLTenths","type":"topic","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTenths","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxltenths","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"MXLTenths","kind":"identifier"}],"abstract":[{"type":"text","text":"The tenths type is a number representing tenths of interline staff space (positive or negative). Both integer"},{"type":"text","text":" "},{"type":"text","text":"and decimal values are allowed, such as 5 for a half space and 2.5 for a quarter space. Interline space is"},{"type":"text","text":" "},{"type":"text","text":"measured from the middle of a staff line."}]},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlcolor","title":"MXLColor","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"type":"text","text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is"},{"type":"text","text":" "},{"type":"text","text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLNumberLevel":{"type":"topic","url":"\/documentation\/ivormxl\/mxlnumberlevel","role":"symbol","title":"MXLNumberLevel","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumberLevel","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNumberLevel","kind":"identifier"}],"abstract":[{"text":"Slurs, tuplets, and many other features can be concurrent and overlap within a single musical part. The","type":"text"},{"text":" ","type":"text"},{"text":"number-level entity distinguishes up to 16 concurrent objects of the same type when the objects overlap in","type":"text"},{"text":" ","type":"text"},{"text":"MusicXML document order. Values greater than 6 are usually only needed for music with a large number of divisi","type":"text"},{"text":" ","type":"text"},{"text":"staves in a single part, or if there are more than 6 cross-staff arpeggios in a single measure. When a number-","type":"text"},{"text":" ","type":"text"},{"text":"level value is implied, the value is 1 by default.","type":"text"}],"navigatorTitle":[{"text":"MXLNumberLevel","kind":"identifier"}],"kind":"symbol"}}}