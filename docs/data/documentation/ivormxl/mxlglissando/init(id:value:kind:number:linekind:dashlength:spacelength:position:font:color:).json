r direction.","type":"text"},{"text":" ","type":"text"},{"text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of","type":"text"},{"text":" ","type":"text"},{"text":"font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric","type":"text"},{"text":" ","type":"text"},{"text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font","type":"text"},{"text":" ","type":"text"},{"text":"vs. a music font.","type":"text"}],"kind":"symbol","title":"MXLFont","url":"\/documentation\/ivormxl\/mxlfont","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFont"}]},"doc://IvorMXL/documentation/IvorMXL/MXLGlissando":{"kind":"symbol","url":"\/documentation\/ivormxl\/mxlglissando","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLGlissando","navigatorTitle":[{"text":"MXLGlissando","kind":"identifier"}],"title":"MXLGlissando","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLGlissando","kind":"identifier"}],"type":"topic","abstract":[{"text":"Glissando and slide types both indicate rapidly moving from one pitch to the other so that individual notes","type":"text"},{"text":" ","type":"text"},{"text":"are not discerned. A glissando sounds the distinct notes in between the two pitches and defaults to a wavy","type":"text"},{"text":" ","type":"text"},{"text":"line. The optional text is printed alongside the line.","type":"text"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLStartStop":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStartStop","url":"\/documentation\/ivormxl\/mxlstartstop","abstract":[{"text":"The start-stop type is used for an attribute of musical elements that can either start or stop, such as","type":"text"},{"text":" ","type":"text"},{"text":"tuplets.","type":"text"}],"type":"t