":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL9MXLTenthsa","kind":"typeIdentifier","text":"MXLTenths","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"spaceLength"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL9MXLTenthsa","kind":"typeIdentifier","text":"MXLTenths","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"position"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL11MXLPositionV","kind":"typeIdentifier","text":"MXLPosition","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition"},{"kind":"text","text":" = MXLPosition(), "},{"kind":"externalParam","text":"font"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL7MXLFontV","kind":"typeIdentifier","text":"MXLFont","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont"},{"kind":"text","text":" = MXLFont(), "},{"kind":"externalParam","text":"color"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL8MXLColorV","kind":"typeIdentifier","text":"MXLColor","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor"},{"kind":"text","text":"? = nil)"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"parameters","parameters":[{"name":"id","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The optional-unique-id attribute group allows an element to optionally specify an ID that is unique to the entire document. This attribute group is not used for a required id attribute, or for an id attribute that specifies an id reference."}]}]},{"name":"value","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The value of this element."}]}]},{"name":"kind","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Whether this is the start or stop of the glissando."}]}]},{"name":"number","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Defaults to "},{"type":"codeVoice","code":"1"},{"type":"text","text":"."}]}]},{"name":"lineKind","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The line-type attribute distinguishes between solid, dashed, dotted, and wavy lines."}]}]},{"name":"dashLength","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The length, in tenths, of the dashes in a dashed line. Ignored if the corresponding line-type attribute is not dashed."}]}]},{"name":"spaceLength","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The length, in tenths, of the spaces in a dashed line. Ignored if the corresponding line-type attribute is not dashed."}]}]},{"name":"position","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For most elements, any program will compute a default x and y position. The position attributes let this be changed two ways."}]}]},{"name":"font","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The font attribute group gathers together attributes for determining the font within a credit or direction. They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of font names.The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font vs. a music font."}]}]},{"name":"color","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The color attribute group indicates the color of an element."}]}]}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLGlissando\/init(id:value:kind:number:lineKind:dashLength:spaceLength:position:font:color:)","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLGlissando"]]},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLGlissando":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLGlissando","title":"MXLGlissando","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLGlissando","kind":"identifier"}],"navigatorTitle":[{"text":"MXLGlissando","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlglissando","abstract":[{"text":"Glissando and slide types both indicate rapidly moving from one pitch to the other so that individual notes","type":"text"},{"text":" ","type":"text"},{"text":"are not discerned. A glissando sounds the distinct notes in between the two pitches and defaults to a wavy","type":"text"},{"text":" ","type":"text"},{"text":"line. The optional text is printed alongside the line.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLTenths":{"abstract":[{"text":"The tenths type is a number representing tenths of interline staff space (positive or negative). Both integer","type":"text"},{"text":" ","type":"text"},{"text":"and decimal values are allowed, such as 5 for a half space and 2.5 for a quarter space. Interline space is","type":"text"},{"text":" ","type":"text"},{"text":"measured from the middle of a staff line.","type":"text"}],"title":"MXLTenths","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTenths"}],"navigatorTitle":[{"kind":"identifier","text":"MXLTenths"}],"type":"topic","url":"\/documentation\/ivormxl\/mxltenths","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths"},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLLineKind":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLineKind","title":"MXLLineKind","kind":"symbol","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLLineKind","kind":"identifier"}],"navigatorTitle":[{"text":"MXLLineKind","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxllinekind","abstract":[{"text":"The line-type type distinguishes between solid, dashed, dotted, and wavy lines.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLNumberLevel":{"title":"MXLNumberLevel","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNumberLevel"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlnumberlevel","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumberLevel","abstract":[{"text":"Slurs, tuplets, and many other features can be concurrent and overlap within a single musical part. The","type":"text"},{"text":" ","type":"text"},{"text":"number-level entity distinguishes up to 16 concurrent objects of the same type when the objects overlap in","type":"text"},{"text":" ","type":"text"},{"text":"MusicXML document order. Values greater than 6 are usually only needed for music with a large number of divisi","type":"text"},{"text":" ","type":"text"},{"text":"staves in a single part, or if there are more than 6 cross-staff arpeggios in a single measure. When a number-","type":"text"},{"text":" ","type":"text"},{"text":"level value is implied, the value is 1 by default.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"MXLNumberLevel"}]},"doc://IvorMXL/documentation/IvorMXL/MXLPosition":{"title":"MXLPosition","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPosition"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlposition","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","abstract":[{"text":"For most elements, any program will compute a default x and y position. The position attributes let this be","type":"text"},{"text":" ","type":"text"},{"text":"changed two ways.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"MXLPosition"}]},"doc://IvorMXL/documentation/IvorMXL/MXLGlissando/init(id:value:kind:number:lineKind:dashLength:spaceLength:position:font:color:)":{"url":"\/documentation\/ivormxl\/mxlglissando\/init(id:value:kind:number:linekind:dashlength:spacelength:position:font:color:)","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLGlissando\/init(id:value:kind:number:lineKind:dashLength:spaceLength:position:font:color:)","role":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"value","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"kind","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLStartStop","preciseIdentifier":"s:7IvorMXL12MXLStartStopO","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"number","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLNumberLevel","preciseIdentifier":"s:7IvorMXL14MXLNumberLevelV","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"lineKind","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLLineKind","preciseIdentifier":"s:7IvorMXL11MXLLineKindO","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"dashLength","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLTenths","preciseIdentifier":"s:7IvorMXL9MXLTenthsa","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"spaceLength","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLTenths","preciseIdentifier":"s:7IvorMXL9MXLTenthsa","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"position","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLPosition","preciseIdentifier":"s:7IvorMXL11MXLPositionV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"font","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLFont","preciseIdentifier":"s:7IvorMXL7MXLFontV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"color","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLColor","preciseIdentifier":"s:7IvorMXL8MXLColorV","kind":"typeIdentifier"},{"text":"?)","kind":"text"}],"kind":"symbol","abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLGlissando"},{"type":"text","text":"."}],"type":"topic","title":"init(id:value:kind:number:lineKind:dashLength:spaceLength:position:font:color:)"},"doc://IvorMXL/documentation/IvorMXL/MXLFont":{"navigatorTitle":[{"text":"MXLFont","kind":"identifier"}],"abstract":[{"text":"The font attribute group gathers together attributes for determining the font within a credit or direction.","type":"text"},{"text":" ","type":"text"},{"text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of","type":"text"},{"text":" ","type":"text"},{"text":"font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric","type":"text"},{"text":" ","type":"text"},{"text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font","type":"text"},{"text":" ","type":"text"},{"text":"vs. a music font.","type":"text"}],"title":"MXLFont","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","kind":"symbol","url":"\/documentation\/ivormxl\/mxlfont","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLFont","kind":"identifier"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLStartStop":{"navigatorTitle":[{"text":"MXLStartStop","kind":"identifier"}],"abstract":[{"text":"The start-stop type is used for an attribute of musical elements that can either start or stop, such as","type":"text"},{"text":" ","type":"text"},{"text":"tuplets.","type":"text"}],"title":"MXLStartStop","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStartStop","kind":"symbol","url":"\/documentation\/ivormxl\/mxlstartstop","type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLStartStop","kind":"identifier"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"abstract":[{"text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in","type":"text"},{"type":"text","text":" "},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"title":"MXLColor","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlcolor","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor"}}}