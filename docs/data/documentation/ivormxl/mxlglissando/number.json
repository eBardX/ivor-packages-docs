/IvorMXL\/documentation\/IvorMXL\/MXLGlissando\/number","role":"symbol","url":"\/documentation\/ivormxl\/mxlglissando\/number","abstract":[{"text":"Defaults to ","type":"text"},{"code":"1","type":"codeVoice"},{"text":".","type":"text"}],"kind":"symbol","title":"number","type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLGlissando":{"url":"\/documentation\/ivormxl\/mxlglissando","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLGlissando"}],"title":"MXLGlissando","abstract":[{"type":"text","text":"Glissando and slide types both indicate rapidly moving from one pitch to the other so that individual notes"},{"type":"text","text":" "},{"type":"text","text":"are not discerned. A glissando sounds the distinct notes in between the two pitches and defaults to a wavy"},{"type":"text","text":" "},{"type":"text","text":"line. The optional text is printed alongside the line."}],"navigatorTitle":[{"kind":"identifier","text":"MXLGlissando"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLGlissando"},"doc://IvorMXL/documentation/IvorMXL/MXLNumberLevel":{"type":"topic","url":"\/documentation\/ivormxl\/mxlnumberlevel","role":"symbol","title":"MXLNumberLevel","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumberLevel","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNumberLevel","kind":"identifier"}],"abstract":[{"text":"Slurs, tuplets, and many other features can be concurrent and overlap within a single musical part. The","type":"text"},{"text":" ","type":"text"},{"text":"number-level entity distinguishes up to 16 concurrent objects of the same type when the objects overlap in","type":"text"},{"text":" ","type":"text"},{"text":"MusicXML document order. Values greater than 6 are usually only needed for music with a large number of divisi","type":"text"},{"text":" ","type":"text"},{"text":"staves in a single part, or if there are more than 6 cross-staff arpeggios in a single measure. When a number-","type":"text"},{"text":" ","type":"text"},{"text":"level value is implied, the value is 1 by default.","type":"text"}],"navigatorTitle":[{"text":"MXLNumberLevel","kind":"identifier"}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]}}}