"symbol","abstract":[{"type":"text","text":"Slurs, tuplets, and many other features can be concurrent and overlap within a single musical part. The"},{"type":"text","text":" "},{"type":"text","text":"number-level entity distinguishes up to 16 concurrent objects of the same type when the objects overlap in"},{"type":"text","text":" "},{"type":"text","text":"MusicXML document order. Values greater than 6 are usually only needed for music with a large number of divisi"},{"type":"text","text":" "},{"type":"text","text":"staves in a single part, or if there are more than 6 cross-staff arpeggios in a single measure. When a number-"},{"type":"text","text":" "},{"type":"text","text":"level value is implied, the value is 1 by default."}],"type":"topic","navigatorTitle":[{"text":"MXLNumberLevel","kind":"identifier"}],"title":"MXLNumberLevel"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLGlissando":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLGlissando"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLGlissando"}],"url":"\/documentation\/ivormxl\/mxlglissando","abstract":[{"type":"text","text":"Glissando and slide types both indicate rapidly moving from one pitch to the other so that individual notes"},{"type":"text","text":" "},{"type":"text","text":"are not discerned. A glissando sounds the distinct notes in between the two pitches and defaults to a wavy"},{"type":"text","text":" "},{"type":"text","text":"line. The optional text is printed alongside the line."}],"title":"MXLGlissando","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLGlissando","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLGlissando/number":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlglissando\/number","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLGlissando\/number","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"number"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL14MXLNumberLevelV","text":"MXLNumberLevel"}],"abstract":[{"type":"text","text":"Defaults to "},{"code":"1","type":"codeVoice"},{"type":"text","text":"."}],"kind":"symbol","type":"topic","title":"number"}}}