IvorMXL\/documentation\/IvorMXL\/MXLNumberLevel","abstract":[{"text":"Slurs, tuplets, and many other features can be concurrent and overlap within a single musical part. The","type":"text"},{"text":" ","type":"text"},{"text":"number-level entity distinguishes up to 16 concurrent objects of the same type when the objects overlap in","type":"text"},{"text":" ","type":"text"},{"text":"MusicXML document order. Values greater than 6 are usually only needed for music with a large number of divisi","type":"text"},{"text":" ","type":"text"},{"text":"staves in a single part, or if there are more than 6 cross-staff arpeggios in a single measure. When a number-","type":"text"},{"text":" ","type":"text"},{"text":"level value is implied, the value is 1 by default.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"MXLNumberLevel"}]},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLGlissando/number":{"abstract":[{"type":"text","text":"Defaults to "},{"type":"codeVoice","code":"1"},{"type":"text","text":"."}],"title":"number","kind":"symbol","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"number","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL14MXLNumberLevelV","kind":"typeIdentifier","text":"MXLNumberLevel"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlglissando\/number","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLGlissando\/number"},"doc://IvorMXL/documentation/IvorMXL/MXLGlissando":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLGlissando","title":"MXLGlissando","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLGlissando","kind":"identifier"}],"navigatorTitle":[{"text":"MXLGlissando","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlglissando","abstract":[{"text":"Glissando and slide types both indicate rapidly moving from one pitch to the other so that individual notes","type":"text"},{"text":" ","type":"text"},{"text":"are not discerned. A glissando sounds the distinct notes in between the two pitches and defaults to a wavy","type":"text"},{"text":" ","type":"text"},{"text":"line. The optional text is printed alongside the line.","type":"text"}]}}}