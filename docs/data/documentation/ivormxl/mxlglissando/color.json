":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLGlissando","kind":"identifier"}],"type":"topic","abstract":[{"text":"Glissando and slide types both indicate rapidly moving from one pitch to the other so that individual notes","type":"text"},{"text":" ","type":"text"},{"text":"are not discerned. A glissando sounds the distinct notes in between the two pitches and defaults to a wavy","type":"text"},{"text":" ","type":"text"},{"text":"line. The optional text is printed alongside the line.","type":"text"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLColor","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","title":"MXLColor","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlcolor"},"doc://IvorMXL/documentation/IvorMXL/MXLGlissando/color":{"kind":"symbol","url":"\/documentation\/ivormxl\/mxlglissando\/color","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLGlissando\/color","title":"color","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"color","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLColor","preciseIdentifier":"s:7IvorMXL8MXLColorV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"type":"topic","abstract":[{"text":"The color attribute group indicates the color of an element.","type":"text"}],"role":"symbol"}}}