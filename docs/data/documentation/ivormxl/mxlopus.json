{"abstract":[{"text":"The opus type is used for the root element of a MusicXML opus. Each opus is made up of a series of score,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"opus-link, and\/or nested opus elements. The document-attributes attribute group includes the version"},{"type":"text","text":" "},{"type":"text","text":"attribute. Future versions may include more metadata elements. In this version, we just include the title of"},{"type":"text","text":" "},{"text":"the opus.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLOpus"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"Maps the MusicXML ","type":"text"},{"type":"codeVoice","code":"<opus>"},{"text":" root element.","type":"text"}]}]}],"kind":"symbol","sections":[],"relationshipsSections":[{"title":"Conforms To","type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/IvorMXL\/s8CopyableP","doc:\/\/IvorMXL\/SQ","doc:\/\/IvorMXL\/s9EscapableP","doc:\/\/IvorMXL\/SH","doc:\/\/IvorMXL\/s8SendableP","doc:\/\/IvorMXL\/s16SendableMetatypeP"]}],"seeAlsoSections":[{"title":"Documents","generated":true,"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDocument","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePartwise","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScoreTimewise","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartList","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePart","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartName"],"anchor":"Documents"}],"topicSections":[{"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOpus\/Score"],"generated":true,"anchor":"Structures","title":"Structures"},{"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOpus\/init(version:title:i