type":"text","text":"part-name element are deprecated in Version 2.0 in favor of the new part-name-display and part-abbreviation-"},{"type":"text","text":" "},{"type":"text","text":"display elements."}],"kind":"symbol","title":"MXLPartName","url":"\/documentation\/ivormxl\/mxlpartname","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPartName"}]},"doc://IvorMXL/s8SendableP":{"identifier":"doc:\/\/IvorMXL\/s8SendableP","title":"Swift.Sendable","type":"unresolvable"},"doc://IvorMXL/documentation/IvorMXL/MXLOpus/Item":{"kind":"symbol","url":"\/documentation\/ivormxl\/mxlopus\/item","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOpus\/Item","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Item"}],"navigatorTitle":[{"kind":"identifier","text":"Item"}],"role":"symbol","abstract":[{"text":"One of the alternatives for Opus.","type":"text"}],"type":"topic","title":"MXLOpus.Item"},"doc://IvorMXL/documentation/IvorMXL/MXLOpus/version":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOpus\/version","type":"topic","abstract":[{"text":"The document-attributes attribute group is used to specify the attributes for an entire MusicXML document.","type":"text"},{"text":" ","type":"text"},{"text":"Currently this is used for the version attribute.","type":"text"}],"title":"version","kind":"symbol","url":"\/documentation\/ivormxl\/mxlopus\/version","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"version"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL11MXLDocumentV","kind":"typeIdentifier","text":"MXLDocument"},{"kind":"text","text":"."},{"preciseIdentifier":"s:7IvorMXL11MXLDocumentV7VersionV","kind":"typeIdentifier","text":"Version"}]},"doc://IvorMXL/documentation/IvorMXL/MXLDocument":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDocument","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLDocument"}],"abstract":[{"text":"A top-level document parsed from a MusicXML file.","type":"text"}],"title":"MXLDocument","kind":"symbol","url":"\/documentation\/ivormxl\/mxldocument","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLDocument"}]},"doc://IvorMXL/documentation/IvorMXL/MXLScorePart":{"abstract":[{"type":"text","text":"The score-part type collects part-wide information for each part in a score. Often, each MusicXML part"},{"type":"text","text":" "},{"type":"text","text":"corresponds to a track in a Standard MIDI Format 1 file. In this case, the midi-device element is used to make"},{"type":"text","text":" "},{"type":"text","text":"a MIDI device or port assignment for the given track or specific MIDI instruments. Initial midi-instrument"},{"type":"text","text":" "},{"type":"text","text":"assignments may be made here as well. The score-instrument elements are used when there are multiple"},{"type":"text","text":" "},{"text":"instruments per track.","type":"text"}],"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLScorePart"}],"navigatorTitle":[{"kind":"identifier","text":"MXLScorePart"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlscorepart","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePart","title":"MXLScorePart"},"doc://IvorMXL/documentation/IvorMXL/MXLPartList":{"title":"MXLPartList","navigatorTitle":[{"text":"MXLPartList","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"The part-list identifies the different musical parts in this document. Each part has an ID that is used later"},{"type":"text","text":" "},{"type":"text","text":"within the musical data. Since parts may be encoded separately and combined later, identification elements are"},{"type":"text","text":" "},{"type":"text","text":"present at both the score and score-part levels. There must be at least one score-part, combined as desired"},{"type":"text","text":" "},{"type":"text","text":"with part-group elements that indicate braces and brackets. Parts are ordered from top to bottom in a score"},{"type":"text","text":" "},{"type":"text","text":"based on the order in which they appear in the part-list."}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPartList","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartList","url":"\/documentation\/ivormxl\/mxlpartlist"},"doc://IvorMXL/s9EscapableP":{"type":"unresolvable","title":"Swift.Escapable","identifier":"doc:\/\/IvorMXL\/s9EscapableP"},"doc://IvorMXL/SQ":{"title":"Swift.Equatable","identifier":"doc:\/\/IvorMXL\/SQ","type":"unresolvable"},"doc://IvorMXL/s8CopyableP":{"title":"Swift.Copyable","identifier":"doc:\/\/IvorMXL\/s8CopyableP","type":"unresolvable"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","identifier":"doc:\/\/IvorMXL\/s16SendableMetatypeP","type":"unresolvable"}}}