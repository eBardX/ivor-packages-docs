nd score-part levels. There must be at least one score-part, combined as desired","type":"text"},{"text":" ","type":"text"},{"text":"with part-group elements that indicate braces and brackets. Parts are ordered from top to bottom in a score","type":"text"},{"text":" ","type":"text"},{"text":"based on the order in which they appear in the part-list.","type":"text"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPartList"}],"navigatorTitle":[{"kind":"identifier","text":"MXLPartList"}],"url":"\/documentation\/ivormxl\/mxlpartlist"},"doc://IvorMXL/SH":{"identifier":"doc:\/\/IvorMXL\/SH","type":"unresolvable","title":"Swift.Hashable"},"doc://IvorMXL/s9EscapableP":{"identifier":"doc:\/\/IvorMXL\/s9EscapableP","type":"unresolvable","title":"Swift.Escapable"},"doc://IvorMXL/documentation/IvorMXL/MXLOpus/init(version:title:items:)":{"title":"init(version:title:items:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"version","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLDocument","preciseIdentifier":"s:7IvorMXL11MXLDocumentV","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Version","preciseIdentifier":"s:7IvorMXL11MXLDocumentV7VersionV","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"title","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"items","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"Item","preciseIdentifier":"s:7IvorMXL7MXLOpusV4ItemO","kind":"typeIdentifier"},{"text":"])","kind":"text"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlopus\/init(version:title:items:)","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOpus\/init(version:title:items:)","abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLOpus"},{"type":"text","tex