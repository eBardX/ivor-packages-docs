{"sections":[],"abstract":[{"type":"text","text":"Specifies where the bass is displayed relative to what precedes it."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlbass\/arrangement"]}],"metadata":{"roleHeading":"Instance Property","modules":[{"name":"IvorMXL"}],"externalID":"s:7IvorMXL7MXLBassV11arrangementAA21MXLHarmonyArrangementOSgvp","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"arrangement"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL21MXLHarmonyArrangementO","text":"MXLHarmonyArrangement"},{"kind":"text","text":"?"}],"symbolKind":"property","title":"arrangement"},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"arrangement"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL21MXLHarmonyArrangementO","kind":"typeIdentifier","text":"MXLHarmonyArrangement","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmonyArrangement"},{"kind":"text","text":"?"}]}],"kind":"declarations"},{"content":[{"type":"heading","anchor":"discussion","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Maps to the MusicXML "},{"type":"codeVoice","code":"arrangement"},{"type":"text","text":" attribute."}]}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBass\/arrangement"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBass"]]},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLBass/arrangement":{"title":"arrangement","url":"\/documentation\/ivormxl\/mxlbass\/arrangement","type":"topic","abstract":[{"type":"text","text":"Specifies where the bass is displayed relative to what precedes it."}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"arrangement","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLHarmonyArrangement","preciseIdentifier":"s:7IvorMXL21MXLHarmonyArrangementO","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"role":"symbol","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBass\/arrangement"},"doc://IvorMXL/documentation/IvorMXL/MXLBass":{"navigatorTitle":[{"kind":"identifier","text":"MXLBass"}],"abstract":[{"type":"text","text":"The bass type is used to indicate a bass note in popular music chord symbols, e.g. G\/C. It is generally not"},{"type":"text","text":" "},{"type":"text","text":"used in functional harmony, as inversion is generally not used in pop chord symbols. As with root, it is"},{"type":"text","text":" "},{"type":"text","text":"divided into step and alter elements, similar to pitches. The arrangement attribute specifies where the bass"},{"type":"text","text":" "},{"type":"text","text":"is displayed relative to what precedes it."}],"title":"MXLBass","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBass","kind":"symbol","url":"\/documentation\/ivormxl\/mxlbass","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLBass"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLHarmonyArrangement":{"navigatorTitle":[{"kind":"identifier","text":"MXLHarmonyArrangement"}],"abstract":[{"type":"text","text":"The harmony-arrangement type indicates how stacked chords and bass notes are displayed within a harmony"},{"type":"text","text":" "},{"type":"text","text":"element. The vertical value specifies that the second element appears below the first. The horizontal value"},{"type":"text","text":" "},{"type":"text","text":"specifies that the second element appears to the right of the first. The diagonal value specifies that the"},{"type":"text","text":" "},{"type":"text","text":"second element appears both below and to the right of the first."}],"title":"MXLHarmonyArrangement","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmonyArrangement","kind":"symbol","url":"\/documentation\/ivormxl\/mxlharmonyarrangement","type":"topic","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLHarmonyArrangement"}],"role":"symbol"}}}