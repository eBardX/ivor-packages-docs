{"metadata":{"roleHeading":"Instance Property","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"arrangement"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLHarmonyArrangement","preciseIdentifier":"s:7IvorMXL21MXLHarmonyArrangementO"},{"kind":"text","text":"?"}],"externalID":"s:7IvorMXL7MXLBassV11arrangementAA21MXLHarmonyArrangementOSgvp","modules":[{"name":"IvorMXL"}],"symbolKind":"property","title":"arrangement"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"arrangement"},{"kind":"text","text":": "},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmonyArrangement","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL21MXLHarmonyArrangementO","text":"MXLHarmonyArrangement"},{"kind":"text","text":"?"}],"languages":["swift"],"platforms":["macOS"]}]},{"content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Maps to the MusicXML "},{"code":"arrangement","type":"codeVoice"},{"type":"text","text":" attribute."}]}],"kind":"content"}],"kind":"symbol","schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"text":"Specifies where the bass is displayed relative to what precedes it.","type":"text"}],"sections":[],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBass\/arrangement","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/ivormxl\/mxlbass\/arrangement"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBass"]]},"references":{"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLBass":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLBass"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBass","title":"MXLBass","kind":"symbol","navigatorTitle":[{"text":"MXLBass","kind":"identifier"}],"abstract":[{"text":"The bass type is used to indicate a bass note in popular music chord symbols, e.g. G\/C. It is generally not","type":"text"},{"text":" ","type":"text"},{"text":"used in functional harmony, as inversion is generally not used in pop chord symbols. As with root, it is","type":"text"},{"text":" ","type":"text"},{"text":"divided into step and alter elements, similar to pitches. The arrangement attribute specifies where the bass","type":"text"},{"text":" ","type":"text"},{"text":"is displayed relative to what precedes it.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlbass"},"doc://IvorMXL/documentation/IvorMXL/MXLHarmonyArrangement":{"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlharmonyarrangement","abstract":[{"type":"text","text":"The harmony-arrangement type indicates how stacked chords and bass notes are displayed within a harmony"},{"type":"text","text":" "},{"type":"text","text":"element. The vertical value specifies that the second element appears below the first. The horizontal value"},{"type":"text","text":" "},{"type":"text","text":"specifies that the second element appears to the right of the first. The diagonal value specifies that the"},{"type":"text","text":" "},{"text":"second element appears both below and to the right of the first.","type":"text"}],"navigatorTitle":[{"text":"MXLHarmonyArrangement","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLHarmonyArrangement","kind":"identifier"}],"identifier":"doc:\/\/Ivo