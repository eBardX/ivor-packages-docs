"kind":"externalParam","text":"step"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Step","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBass\/Step-swift.struct","preciseIdentifier":"s:7IvorMXL7MXLBassV4StepV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"alter"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLHarmonyAlter","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmonyAlter","preciseIdentifier":"s:7IvorMXL15MXLHarmonyAlterV"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"arrangement"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLHarmonyArrangement","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmonyArrangement","preciseIdentifier":"s:7IvorMXL21MXLHarmonyArrangementO"},{"kind":"text","text":"? = nil)"}],"platforms":["macOS"]}]},{"kind":"parameters","parameters":[{"name":"separator","content":[{"type":"paragraph","inlineContent":[{"text":"The optional bass-separator element indicates that text, rather than a line or slash, separates the bass from what precedes it.","type":"text"}]}]},{"name":"step","content":[{"type":"paragraph","inlineContent":[{"text":"The pitch step of the bass of the current chord.","type":"text"}]}]},{"name":"alter","content":[{"type":"paragraph","inlineContent":[{"text":"The bass-alter element represents the chromatic alteration of the bass of the current chord within the harmony element. In some chord styles, the text for the bass-step element may include bass-alter information. In that case, the print-object attribute of the bass-alter element can be set to no. The location attribute indicates whether the alteration should appear to the left or the right of the bass-step; it is right if not specified.","type":"text"}]}]},{"name":"arrangement","content":[{"type":"paragraph","inlineContent":[{"text":"Specifies where the bass is displayed relative to what precedes it.","type":"text"}]}]}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlbass\/init(separator:step:alter:arrangement:)"]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLBass/Step-swift.struct":{"navigatorTitle":[{"kind":"identifier","text":"Step"}],"abstract":[{"type":"text","text":"The bass-step type represents the pitch step of the bass of the current chord within the harmony element. The"},{"type":"text","text":" "},{"type":"text","text":"text attribute indicates how the bass should appear in a score if not using the element contents."}],"title":"MXLBass.Step","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBass\/Step-swift.struct","kind":"symbol","url":"\/documentation\/ivormxl\/mxlbass\/step-swift.struct","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Step"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLBass":{"navigatorTitle":[{"kind":"identifier","text":"MXLBass"}],"abstract":[{"type":"text","text":"The bass type is used to indicate a bass note in popular music chord symbols, e.g. G\/C. It is generally not"},{"type":"text","text":" "},{"type":"text","text":"used in functional harmony, as inversion is generally not used in pop chord symbols. As with root, it is"},{"type":"text","text":" "},{"type":"text","text":"divided into step and alter elements, similar to pitches. The arrangement attribute specifies where the bass"},{"type":"text","text":" "},{"type":"text","text":"is displayed relative to what precedes it."}],"title":"MXLBass","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBass","kind":"symbol","url":"\/documentation\/ivormxl\/mxlbass","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLBass"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLHarmonyArrangement":{"navigatorTitle":[{"kind":"identifier","text":"MXLHarmonyArrangement"}],"abstract":[{"type":"text","text":"The harmony-arrangement type indicates how stacked chords and bass notes are displayed within a harmony"},{"type":"text","text":" "},{"type":"text","text":"element. The vertical value specifies that the second element appears below the first. The horizontal value"},{"type":"text","text":" "},{"type":"text","text":"specifies that the second element appears to the right of the first. The diagonal value specifies that the"},{"type":"text","text":" "},{"type":"text","text":"second element appears both below and to the right of the first."}],"title":"MXLHarmonyArrangement","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmonyArrangement","kind":"symbol","url":"\/documentation\/ivormxl\/mxlharmonyarrangement","type":"topic","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLHarmonyArrangement"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLStyleText":{"navigatorTitle":[{"kind":"identifier","text":"MXLStyleText"}],"abstract":[{"type":"text","text":"The style-text type represents a text element with a print-style attribute group."}],"title":"MXLStyleText","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStyleText","kind":"symbol","url":"\/documentation\/ivormxl\/mxlstyletext","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLStyleText"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLBass/init(separator:step:alter:arrangement:)":{"abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLBass"},{"type":"text","text":"."}],"title":"init(separator:step:alter:arrangement:)","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBass\/init(separator:step:alter:arrangement:)","kind":"symbol","url":"\/documentation\/ivormxl\/mxlbass\/init(separator:step:alter:arrangement:)","type":"topic","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"separator"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL12MXLStyleTextV","text":"MXLStyleText"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"step"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL7MXLBassV4StepV","text":"Step"},{"kind":"text","text":", "},{"kind":"externalParam","text":"alter"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL15MXLHarmonyAlterV","text":"MXLHarmonyAlter"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"arrangement"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL21MXLHarmonyArrangementO","text":"MXLHarmonyArrangement"},{"kind":"text","text":"?)"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLHarmonyAlter":{"navigatorTitle":[{"kind":"identifier","text":"MXLHarmonyAlter"}],"abstract":[{"type":"text","text":"The harmony-alter type represents the chromatic alteration of the root, numeral, or bass of the current"},{"type":"text","text":" "},{"type":"text","text":"harmony-chord group within the harmony element. In some chord styles, the text of the preceding element may"},{"type":"text","text":" "},{"type":"text","text":"include alteration information. In that case, the print-object attribute of this type can be set to no. The"},{"type":"text","text":" "},{"type":"text","text":"location attribute indicates whether the alteration should appear to the left or the right of the preceding"},{"type":"text","text":" "},{"type":"text","text":"element. Its default value varies by element."}],"title":"MXLHarmonyAlter","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmonyAlter","kind":"symbol","url":"\/documentation\/ivormxl\/mxlharmonyalter","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLHarmonyAlter"}],"role":"symbol"}}}