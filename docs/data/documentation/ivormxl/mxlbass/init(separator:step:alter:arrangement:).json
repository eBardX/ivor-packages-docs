"externalParam","text":"step"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL7MXLBassV4StepV","kind":"typeIdentifier","text":"Step"},{"kind":"text","text":", "},{"kind":"externalParam","text":"alter"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL15MXLHarmonyAlterV","kind":"typeIdentifier","text":"MXLHarmonyAlter"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"arrangement"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLHarmonyArrangement","preciseIdentifier":"s:7IvorMXL21MXLHarmonyArrangementO"},{"kind":"text","text":"?)"}]},"doc://IvorMXL/documentation/IvorMXL/MXLHarmonyArrangement":{"navigatorTitle":[{"text":"MXLHarmonyArrangement","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlharmonyarrangement","type":"topic","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmonyArrangement","title":"MXLHarmonyArrangement","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLHarmonyArrangement","kind":"identifier"}],"abstract":[{"type":"text","text":"The harmony-arrangement type indicates how stacked chords and bass notes are displayed within a harmony"},{"type":"text","text":" "},{"type":"text","text":"element. The vertical value specifies that the second element appears below the first. The horizontal value"},{"type":"text","text":" "},{"type":"text","text":"specifies that the second element appears to the right of the first. The diagonal value specifies that the"},{"type":"text","text":" "},{"type":"text","text":"second element appears both below and to the right of the first."}]},"doc://IvorMXL/documentation/IvorMXL/MXLBass":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLBass","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"MXLBass","kind":"identifier"}],"abstract":[{"type":"text","text":"The bass type is used to indicate a bass note in popular music chord symbols, e.g. G\/C. It is generally not"},{"type":"text","text":" "},{"type":"text","text":"used in functional harmony, as inversion is generally not used in pop chord symbols. As with root, it is"},{"type":"text","text":" "},{"type":"text","text":"divided into step and alter elements, similar to pitches. The arrangement attribute specifies where the bass"},{"type":"text","text":" "},{"type":"text","text":"is displayed relative to what precedes it."}],"url":"\/documentation\/ivormxl\/mxlbass","title":"MXLBass","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBass","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLStyleText":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStyleText","type":"topic","abstract":[{"text":"The style-text type represents a text element with a print-style attribute group.","type":"text"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlstyletext","title":"MXLStyleText","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLStyleText"}],"navigatorTitle":[{"kind":"identifier","text":"MXLStyleText"}]},"doc://IvorMXL/documentation/IvorMXL/MXLHarmonyAlter":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLHarmonyAlter","kind":"identifier"}],"navigatorTitle":[{"text":"MXLHarmonyAlter","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmonyAlter","type":"topic","url":"\/documentation\/ivormxl\/mxlharmonyalter","abstract":[{"type":"text","text":"The harmony-alter type represents the chromatic alteration of the root, numeral, or bass of the current"},{"type":"text","text":" "},{"type":"text","text":"harmony-chord group within the harmony element. In some chord styles, the text of the preceding element may"},{"type":"text","text":" "},{"type":"text","text":"include alteration information. In that case, the print-object attribute of this type can be set to no. The"},{"type":"text","text":" "},{"type":"text","text":"location attribute indicates whether the alteration should appear to the left or the right of the preceding"},{"type":"text","text":" "},{"type":"text","text":"element. Its default value varies by element."}],"title":"MXLHarmonyAlter","role":"symbol"}}}