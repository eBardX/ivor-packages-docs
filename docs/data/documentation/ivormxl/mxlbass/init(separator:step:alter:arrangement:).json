{"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBass"]]},"metadata":{"role":"symbol","modules":[{"name":"IvorMXL"}],"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"separator"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL12MXLStyleTextV","kind":"typeIdentifier","text":"MXLStyleText"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"step"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL7MXLBassV4StepV","kind":"typeIdentifier","text":"Step"},{"kind":"text","text":", "},{"kind":"externalParam","text":"alter"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL15MXLHarmonyAlterV","kind":"typeIdentifier","text":"MXLHarmonyAlter"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"arrangement"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL21MXLHarmonyArrangementO","kind":"typeIdentifier","text":"MXLHarmonyArrangement"},{"kind":"text","text":"?)"}],"symbolKind":"init","externalID":"s:7IvorMXL7MXLBassV9separator4step5alter11arrangementAcA12MXLStyleTextVSg_AC4StepVAA15MXLHarmonyAlterVSgAA0K11ArrangementOSgtcfc","title":"init(separator:step:alter:arrangement:)","roleHeading":"Initializer"},"abstract":[{"type":"text","text":"Creates a new "},{"code":"MXLBass","type":"codeVoice"},{"type":"text","text":"."}],"sections":[],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"separator"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL12MXLStyleTextV","kind":"typeIdentifier","text":"MXLStyleText","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStyleText"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"step"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL7MXLBassV4StepV","kind":"typeIdentifier","text":"Step","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBass\/Step-swift.struct"},{"kind":"text","text":", "},{"kind":"externalParam","text":"alter"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL15MXLHarmonyAlterV","kind":"typeIdentifier","text":"MXLHarmonyAlter","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmonyAlter"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"arrangement"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL21MXLHarmonyArrangementO","kind":"typeIdentifier","text":"MXLHarmonyArrangement","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmonyArrangement"},{"kind":"text","text":"? = nil)"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The optional bass-separator element indicates that text, rather than a line or slash,","type":"text"},{"text":" ","type":"text"},{"text":"separates the bass from what precedes it.","type":"text"}]}],"name":"separator"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The pitch step of the bass of the current chord.","type":"text"}]}],"name":"step"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The bass-alter element represents the chromatic alteration of the bass of the current","type":"text"},{"text":" ","type":"text"},{"text":"chord within the harmony element. In some chord styles, the text for the bass-step","type":"text"},{"text":" ","type":"text"},{"text":"element may include bass-alter information. In that case, the print-object attribute","type":"text"},{"text":" ","type":"text"},{"text":"of the bass-alter element can be set to no. The location attribute indicates whether","type":"text"},{"text":" ","type":"text"},{"text":"the alteration should appear to the left or the right of the bass-step; it is right if","type":"text"},{"text":" ","type":"text"},{"text":"not specified.","type":"text"}]}],"name":"alter"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Specifies where the bass is displayed relative to what precedes it.","type":"text"}]}],"name":"arrangement"}]}],"kind":"symbol","variants":[{"paths":["\/documentation\/ivormxl\/mxlbass\/init(separator:step:alter:arrangement:)"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBass\/init(separator:step:alter:arrangement:)","interfaceLanguage":"swift"},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLBass":{"type":"topic","abstract":[{"type":"text","text":"The bass type is used to indicate a bass note in popular music chord symbols, e.g. G\/C. It is generally not"},{"type":"text","text":" "},{"type":"text","text":"used in functional harmony, as inversion is generally not used in pop chord symbols. As with root, it is"},{"type":"text","text":" "},{"type":"text","text":"divided into step and alter elements, similar to pitches. The arrangement attribute specifies where the bass"},{"type":"text","text":" "},{"type":"text","text":"is displayed relative to what precedes it."}],"url":"\/documentation\/ivormxl\/mxlbass","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLBass"}],"kind":"symbol","title":"MXLBass","navigatorTitle":[{"kind":"identifier","text":"MXLBass"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBass","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLStyleText":{"type":"topic","abstract":[{"type":"text","text":"The style-text type represents a text element with a print-style attribute group."}],"url":"\/documentation\/ivormxl\/mxlstyletext","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLStyleText"}],"kind":"symbol","title":"MXLStyleText","navigatorTitle":[{"kind":"identifier","text":"MXLStyleText"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStyleText","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLHarmonyArrangement":{"type":"topic","abstract":[{"type":"text","text":"The harmony-arrangement type indicates how stacked chords and bass notes are displayed within a harmony"},{"type":"text","text":" "},{"type":"text","text":"element. The vertical value specifies that the second element appears below the first. The horizontal value"},{"type":"text","text":" "},{"type":"text","text":"specifies that the second element appears to the right of the first. The diagonal value specifies that the"},{"type":"text","text":" "},{"type":"text","text":"second element appears both below and to the right of the first."}],"url":"\/documentation\/ivormxl\/mxlharmonyarrangement","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLHarmonyArrangement"}],"kind":"symbol","title":"MXLHarmonyArrangement","navigatorTitle":[{"kind":"identifier","text":"MXLHarmonyArrangement"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmonyArrangement","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLBass/Step-swift.struct":{"type":"topic","abstract":[{"type":"text","text":"The bass-step type represents the pitch step of the bass of the current chord within the harmony element. The"},{"type":"text","text":" "},{"type":"text","text":"text attribute indicates how the bass should appear in a score if not using the element contents."}],"url":"\/documentation\/ivormxl\/mxlbass\/step-swift.struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Step"}],"kind":"symbol","title":"MXLBass.Step","navigatorTitle":[{"kind":"identifier","text":"Step"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBass\/Step-swift.struct","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLBass/init(separator:step:alter:arrangement:)":{"type":"topic","abstract":[{"type":"text","text":"Creates a new "},{"code":"MXLBass","type":"codeVoice"},{"type":"text","text":"."}],"url":"\/documentation\/ivormxl\/mxlbass\/init(separator:step:alter:arrangement:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"separator"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL12MXLStyleTextV","text":"MXLStyleText"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"step"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL7MXLBassV4StepV","text":"Step"},{"kind":"text","text":", "},{"kind":"externalParam","text":"alter"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL15MXLHarmonyAlterV","text":"MXLHarmonyAlter"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"arrangement"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL21MXLHarmonyArrangementO","text":"MXLHarmonyArrangement"},{"kind":"text","text":"?)"}],"kind":"symbol","title":"init(separator:step:alter:arrangement:)","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBass\/init(separator:step:alter:arrangement:)","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLHarmonyAlter":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLHarmonyAlter","kind":"identifier"}],"title":"MXLHarmonyAlter","abstract":[{"text":"The harmony-alter type represents the chromatic alteration of the root, numeral, or bass of the current","type":"text"},{"text":" ","type":"text"},{"text":"harmony-chord group within the harmony element. In some chord styles, the text of the preceding element may","type":"text"},{"text":" ","type":"text"},{"text":"include alteration information. In that case, the print-object attribute of this type can be set to no. The","type":"text"},{"text":" ","type":"text"},{"text":"location attribute indicates whether the alteration should appear to the left or the right of the preceding","type":"text"},{"text":" ","type":"text"},{"text":"element. Its default value varies by element.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmonyAlter","role":"symbol","url":"\/documentation\/ivormxl\/mxlharmonyalter","kind":"symbol","navigatorTitle":[{"text":"MXLHarmonyAlter","kind":"identifier"}],"type":"topic"}}}