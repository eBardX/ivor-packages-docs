{"kind":"symbol","abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLBass"},{"type":"text","text":"."}],"variants":[{"paths":["\/documentation\/ivormxl\/mxlbass\/init(separator:step:alter:arrangement:)"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBass"]]},"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBass\/init(separator:step:alter:arrangement:)","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"init","kind":"keyword"},{"text":"(","kind":"text"},{"text":"separator","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStyleText","preciseIdentifier":"s:7IvorMXL12MXLStyleTextV","text":"MXLStyleText","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"step","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBass\/Step-swift.struct","preciseIdentifier":"s:7IvorMXL7MXLBassV4StepV","text":"Step","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"alter","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmonyAlter","preciseIdentifier":"s:7IvorMXL15MXLHarmonyAlterV","text":"MXLHarmonyAlter","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"arrangement","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmonyArrangement","preciseIdentifier":"s:7IvorMXL21MXLHarmonyArrangementO","text":"MXLHarmonyArrangement","kind":"typeIdentifier"},{"text":"? = nil)","kind":"text"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"parameters","parameters":[{"name":"separator","content":[{"inlineContent":[{"type":"text","text":"The optional bass-separator element indicates that text, rather than a line or slash, separates the bass from what precedes it."}],"type":"paragraph"}]},{"name":"step","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The pitch step of the bass of the current chord."}]}]},{"name":"alter","content":[{"inlineContent":[{"text":"The bass-alter element represents the chromatic alteration of the bass of the current chord within the harmony element. In some chord styles, the text for the bass-step element may include bass-alter information. In that case, the print-object attribute of the bass-alter element can be set to no. The location attribute indicates whether the alteration should appear to the left or the right of the bass-step; it is right if not specified.","type":"text"}],"type":"paragraph"}]},{"name":"arrangement","content":[{"inlineContent":[{"type":"text","text":"Specifies where the bass is displayed relative to what precedes it."}],"type":"paragraph"}]}]}],"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"externalID":"s:7IvorMXL7MXLBassV9separator4step5alter11arrangementAcA12MXLStyleTextVSg_AC4StepVAA15MXLHarmonyAlterVSgAA0K11ArrangementOSgtcfc","fragments":[{"kind":"identifier","text":"init"},{"text":"(","kind":"text"},{"text":"separator","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLStyleText","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL12MXLStyleTextV"},{"text":"?, ","kind":"text"},{"text":"step","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL7MXLBassV4StepV","text":"Step","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"alter","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL15MXLHarmonyAlterV","text":"MXLHarmonyAlter","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"arrangement","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLHarmonyArrangement","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL21MXLHarmonyArrangementO"},{"text":"?)","kind":"text"}],"title":"init(separator:step:alter:arrangement:)","role":"symbol","roleHeading":"Initializer","symbolKind":"init","modules":[{"name":"IvorMXL"}]},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLStyleText":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStyleText","abstract":[{"type":"text","text":"The style-text type represents a text element with a print-style attribute group."}],"url":"\/documentation\/ivormxl\/mxlstyletext","type":"topic","role":"symbol","kind":"symbol","title":"MXLStyleText","navigatorTitle":[{"text":"MXLStyleText","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLStyleText","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLBass":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLBass"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBass","title":"MXLBass","kind":"symbol","navigatorTitle":[{"text":"MXLBass","kind":"identifier"}],"abstract":[{"text":"The bass type is used to indicate a bass note in popular music chord symbols, e.g. G\/C. It is generally not","type":"text"},{"text":" ","type":"text"},{"text":"used in functional harmony, as inversion is generally not used in pop chord symbols. As with root, it is","type":"text"},{"text":" ","type":"text"},{"text":"divided into step and alter elements, similar to pitches. The arrangement attribute specifies where the bass","type":"text"},{"text":" ","type":"text"},{"text":"is displayed relative to what precedes it.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlbass"},"doc://IvorMXL/documentation/IvorMXL/MXLBass/Step-swift.struct":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Step"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBass\/Step-swift.struct","title":"MXLBass.Step","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Step"}],"abstract":[{"text":"The bass-step type represents the pitch step of the bass of the current chord within the harmony element. The","type":"text"},{"text":" ","type":"text"},{"text":"text attribute indicates how the bass should appear in a score if not using the element contents.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlbass\/step-swift.struct"},"doc://IvorMXL/documentation/IvorMXL/MXLHarmonyArrangement":{"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlharmonyarrangement","abstract":[{"type":"text","text":"The harmony-arrangement type indicates how stacked chords and bass notes are displayed within a harmony"},{"type":"text","text":" "},{"type":"text","text":"element. The vertical value specifies that the second element appears below the first. The horizontal value"},{"type":"text","text":" "},{"type":"text","text":"specifies that the second element appears to the right of the first. The diagonal value specifies that the"},{"type":"text","text":" "},{"text":"second element appears both below and to the right of the first.","type":"text"}],"navigatorTitle":[{"text":"MXLHarmonyArrangement","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLHarmonyArrangement","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmonyArrangement","title":"MXLHarmonyArrangement"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLBass/init(separator:step:alter:arrangement:)":{"type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLBass"},{"type":"text","text":"."}],"role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBass\/init(separator:step:alter:arrangement:)","url":"\/documentation\/ivormxl\/mxlbass\/init(separator:step:alter:arrangement:)","title":"init(separator:step:alter:arrangement:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"separator"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL12MXLStyleTextV","text":"MXLStyleText"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"step"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL7MXLBassV4StepV","text":"Step"},{"kind":"text","text":", "},{"kind":"externalParam","text":"alter"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL15MXLHarmonyAlterV","text":"MXLHarmonyAlter"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"arrangement"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL21MXLHarmonyArrangementO","text":"MXLHarmonyArrangement"},{"kind":"text","text":"?)"}]},"doc://IvorMXL/documentation/IvorMXL/MXLHarmonyAlter":{"url":"\/documentation\/ivormxl\/mxlharmonyalter","title":"MXLHarmonyAlter","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLHarmonyAlter","kind":"identifier"}],"navigatorTitle":[{"text":"MXLHarmonyAlter","kind":"identifier"}],"abstract":[{"type":"text","text":"The harmony-alter type represents the chromatic alteration of the root, numeral, or bass of the current"},{"type":"text","text":" "},{"type":"text","text":"harmony-chord group within the harmony element. In some chord styles, the text of the preceding element may"},{"type":"text","text":" "},{"type":"text","text":"include alteration information. In that case, the print-object attribute of this type can be set to no. The"},{"type":"text","text":" "},{"type":"text","text":"location attribute indicates whether the alteration should appear to the left or the right of the preceding"},{"type":"text","text":" "},{"type":"text","text":"element. Its default value varies by element."}],"kind":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmonyAlter"}}}