orMXL/MXLBass/Step-swift.struct":{"navigatorTitle":[{"kind":"identifier","text":"Step"}],"abstract":[{"type":"text","text":"The bass-step type represents the pitch step of the bass of the current chord within the harmony element. The"},{"type":"text","text":" "},{"type":"text","text":"text attribute indicates how the bass should appear in a score if not using the element contents."}],"title":"MXLBass.Step","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBass\/Step-swift.struct","kind":"symbol","url":"\/documentation\/ivormxl\/mxlbass\/step-swift.struct","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Step"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLBass":{"navigatorTitle":[{"kind":"identifier","text":"MXLBass"}],"abstract":[{"type":"text","text":"The bass type is used to indicate a bass note in popular music chord symbols, e.g. G\/C. It is generally not"},{"type":"text","text":" "},{"type":"text","text":"used in functional harmony, as inversion is generally not used in pop chord symbols. As with root, it is"},{"type":"text","text":" "},{"type":"text","text":"divided into step and alter elements, similar to pitches. The arrangement attribute specifies where the bass"},{"type":"text","text":" "},{"type":"text","text":"is displayed relative to what precedes it."}],"title":"MXLBass","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBass","kind":"symbol","url":"\/documentation\/ivormxl\/mxlbass","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLBass"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLBass/Step-swift.struct/text":{"url":"\/documentation\/ivormxl\/mxlbass\/step-swift.struct\/text","abstract":[{"type":"text","text":"Indicates how the bass should appear in a score if not using the element contents."}],"title":"text","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\