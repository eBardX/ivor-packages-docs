d list of font names.The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font vs. a music font."}]}]},{"name":"color","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The color attribute group indicates the color of an element."}]}]}],"kind":"parameters"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBass\/Step-swift.struct\/init(value:text:position:font:color:)"},"sections":[],"kind":"symbol","references":{"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLBass/Step-swift.struct/init(value:text:position:font:color:)":{"abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLBass.Step"},{"type":"text","text":"."}],"type":"topic","title":"init(value:text:position:font:color:)","kind":"symbol","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBass\/Step-swift.struct\/init(value:text:position:font:color:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"value"},{"text":": ","kind":"text"},{"text":"MXLStep","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL7MXLStepO"},{"kind":"text","text":", "},{"text":"text","kind":"externalParam"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"position"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLPosition","preciseIdentifier":"s:7IvorMXL11MXLPositionV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"font"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLFont","preciseIdentifier":"s:7IvorMXL7MXLFontV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"color"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLColor","preciseIdentifier":"s:7IvorMXL8MXLColorV"},{"kind":"text","text":"?)"}],"url":"\/documentation\/ivormxl\/mxlbass\/step-swift.struct\/init(value:text:position:font:color:)"},"doc://IvorMXL/documentation/IvorMXL/MXLPosition":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlposition","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPosition"}],"kind":"symbol","abstract":[{"text":"For most elements, any program will compute a default x and y position. The position attributes let this be","type":"text"},{"text":" ","type":"text"},{"text":"changed two ways.","type":"text"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLPosition"}],"title":"MXLPosition"},"doc://IvorMXL/documentation/IvorMXL/MXLFont":{"title":"MXLFont","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFont"}],"abstract":[{"text":"The font attribute group gathers together attributes for determining the font within a credit or direction.","type":"text"},{"text":" ","type":"text"},{"text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of","type":"text"},{"text":" ","type":"text"},{"text":"font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric","type":"text"},{"text":" ","type":"text"},{"text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font","type":"text"},{"text":" ","type":"text"},{"text":"vs. a music font.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLFont"}],"url":"\/documentation\/ivormxl\/mxlfont"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"title":"MXLColor","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"abstract":[{"text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in","type":"text"},{"text":" ","type":"text"},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"url":"\/documentation\/ivormxl\/mxlcolor"},"doc://IvorMXL/documentation/IvorMXL/MXLBass/Step-swift.struct":{"abstract":[{"type":"text","text":"The bass-step type represents the pitch step of the bass of the current chord within the harmony element. The"},{"type":"text","text":" "},{"type":"text","text":"text attribute indicates how the bass should appear in a score if not using the element contents."}],"kind":"symbol","role":"symbol","type":"topic","title":"MXLBass.Step","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBass\/Step-swift.struct","url":"\/documentation\/ivormxl\/mxlbass\/step-swift.struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"Step","kind":"identifier"}],"navigatorTitle":[{"text":"Step","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLStep":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlstep","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStep","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLStep","kind":"identifier"}],"abstract":[{"type":"text","text":"The step type represents a step of the diatonic scale, represented using the English letters A through G."}],"kind":"symbol","type":"topic","navigatorTitle":[{"text":"MXLStep","kind":"identifier"}],"title":"MXLStep"},"doc://IvorMXL/documentation/IvorMXL/MXLBass":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLBass","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"MXLBass","kind":"identifier"}],"abstract":[{"type":"text","text":"The bass type is used to indicate a bass note in popular music chord symbols, e.g. G\/C. It is generally not"},{"type":"text","text":" "},{"type":"text","text":"used in functional harmony, as inversion is generally not used in pop chord symbols. As with root, it is"},{"type":"text","text":" "},{"type":"text","text":"divided into step and alter elements, similar to pitches. The arrangement attribute specifies where the bass"},{"type":"text","text":" "},{"type":"text","text":"is displayed relative to what precedes it."}],"url":"\/documentation\/ivormxl\/mxlbass","title":"MXLBass","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBass","kind":"symbol"}}}