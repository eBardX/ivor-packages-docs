text"}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlcolor"},"doc://IvorMXL/documentation/IvorMXL/MXLBass":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLBass"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBass","title":"MXLBass","kind":"symbol","navigatorTitle":[{"text":"MXLBass","kind":"identifier"}],"abstract":[{"text":"The bass type is used to indicate a bass note in popular music chord symbols, e.g. G\/C. It is generally not","type":"text"},{"text":" ","type":"text"},{"text":"used in functional harmony, as inversion is generally not used in pop chord symbols. As with root, it is","type":"text"},{"text":" ","type":"text"},{"text":"divided into step and alter elements, similar to pitches. The arrangement attribute specifies where the bass","type":"text"},{"text":" ","type":"text"},{"text":"is displayed relative to what precedes it.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlbass"},"doc://IvorMXL/documentation/IvorMXL/MXLPosition":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLPosition"}],"abstract":[{"text":"For most elements, any program will compute a default x and y position. The position attributes let this be","type":"text"},{"text":" ","type":"text"},{"text":"changed two ways.","type":"text"}],"kind":"symbol","title":"MXLPosition","url":"\/documentation\/ivormxl\/mxlposition","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPosition"}]},"doc://IvorMXL/documentation/IvorMXL/MXLBass/Step-swift.struct":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Step"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBass\/Step-swift.struct","title":"MXLBass.Step","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Step"}],"abstract":[{"text":"The bass-step type represents the pitch step of the bass of the current chord within the harmony element. The","type":"text"},{"text":" ","type":"text"},{"text":"text attribute indicates how the bass should appear in a score if not using the element contents.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlbass\/step-swift.struct"},"doc://IvorMXL/documentation/IvorMXL/MXLStep":{"abstract":[{"text":"The step type represents a step of the diatonic scale, represented using the English letters A through G.","type":"text"}],"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLStep"}],"navigatorTitle":[{"kind":"identifier","text":"MXLStep"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlstep","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStep","title":"MXLStep"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"}}}