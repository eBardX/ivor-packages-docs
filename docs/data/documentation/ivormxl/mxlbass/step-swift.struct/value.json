c://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLBass/Step-swift.struct":{"type":"topic","abstract":[{"type":"text","text":"The bass-step type represents the pitch step of the bass of the current chord within the harmony element. The"},{"type":"text","text":" "},{"type":"text","text":"text attribute indicates how the bass should appear in a score if not using the element contents."}],"url":"\/documentation\/ivormxl\/mxlbass\/step-swift.struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Step"}],"kind":"symbol","title":"MXLBass.Step","navigatorTitle":[{"kind":"identifier","text":"Step"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBass\/Step-swift.struct","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLBass":{"type":"topic","abstract":[{"type":"text","text":"The bass type is used to indicate a bass note in popular music chord symbols, e.g. G\/C. It is generally not"},{"type":"text","text":" "},{"type":"text","text":"used in functional harmony, as inversion is generally not used in pop chord symbols. As with root, it is"},{"type":"text","text":" "},{"type":"text","text":"divided into step and alter elements, similar to pitches. The arrangement attribute specifies where the bass"},{"type":"text","text":" "},{"type":"text","text":"is displayed relative to what precedes it."}],"url":"\/documentation\/ivormxl\/mxlbass","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLBass"}],"kind":"symbol","title":"MXLBass","navigatorTitle":[{"kind":"identifier","text":"MXLBass"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBass","role":"symbol"},"doc://IvorMXL