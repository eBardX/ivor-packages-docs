e). Both integer","type":"text"},{"text":" ","type":"text"},{"text":"and decimal values are allowed, such as 5 for a half space and 2.5 for a quarter space. Interline space is","type":"text"},{"text":" ","type":"text"},{"text":"measured from the middle of a staff line.","type":"text"}],"title":"MXLTenths","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTenths"}],"navigatorTitle":[{"kind":"identifier","text":"MXLTenths"}],"type":"topic","url":"\/documentation\/ivormxl\/mxltenths","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths"},"doc://IvorMXL/documentation/IvorMXL/MXLOctaveShift/spaceLength":{"abstract":[{"text":"The length, in tenths, of the spaces in a dashed line. Ignored if the corresponding line-type attribute is","type":"text"},{"text":" ","type":"text"},{"text":"not dashed.","type":"text"}],"title":"spaceLength","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOctaveShift\/spaceLength","kind":"symbol","url":"\/documentation\/ivormxl\/mxloctaveshift\/spacelength","type":"topic","fragments":[{"kind":"keyword","text":"let"},{"text":" ","kind":"text"},{"kind":"identifier","text":"spaceLength"},{"text":": ","kind":"text"},{"text":"MXLTenths","preciseIdentifier":"s:7IvorMXL9MXLTenthsa","kind":"typeIdentifier"},{"kind":"text","text":"?"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLOctaveShift":{"title":"MXLOctaveShift","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLOctaveShift"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxloctaveshift","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOctaveShift","abstract":[{"text":"The octave shift type indicates where notes are shifted up or down from their true pitched values because of","type":"text"},{"text":" ","type":"text"},{"text":"printing difficulty. Thus a treble clef line noted with 8va will be indicated with an octave-shift down from","type":"text"},{"text":" ","type":"text"},{"text":"the pitch data indicated in the notes. A size of 8 indicates one octave; a size of 15 indicates two octaves.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"MXLOctaveShift"}]},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"}}}