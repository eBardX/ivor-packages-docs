 if the corresponding line-type attribute is"},{"type":"text","text":" "},{"type":"text","text":"not dashed."}],"kind":"symbol","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"spaceLength"},{"kind":"text","text":": "},{"text":"MXLTenths","preciseIdentifier":"s:7IvorMXL9MXLTenthsa","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"title":"spaceLength","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOctaveShift\/spaceLength","url":"\/documentation\/ivormxl\/mxloctaveshift\/spacelength"},"doc://IvorMXL/documentation/IvorMXL/MXLOctaveShift":{"abstract":[{"text":"The octave shift type indicates where notes are shifted up or down from their true pitched values because of","type":"text"},{"text":" ","type":"text"},{"text":"printing difficulty. Thus a treble clef line noted with 8va will be indicated with an octave-shift down from","type":"text"},{"text":" ","type":"text"},{"text":"the pitch data indicated in the notes. A size of 8 indicates one octave; a size of 15 indicates two octaves.","type":"text"}],"url":"\/documentation\/ivormxl\/mxloctaveshift","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOctaveShift","type":"topic","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"MXLOctaveShift","kind":"identifier"}],"title":"MXLOctaveShift","navigatorTitle":[{"text":"MXLOctaveShift","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLTenths":{"title":"MXLTenths","type":"topic","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTenths","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxltenths","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"MXLTenths","kind":"identifier"}],"abstract":[{"type":"text","text":"The tenths type is a number representing tenths of interline staff space (positive or negative). Both integer"},{"type":"text","text":" "},{"type":"text","text":"and decimal values are allowed, such as 5 for a half space and 2.5 for a quarter space. Interline space is"},{"type":"text","text":" "},{"type":"text","text":"measured from the middle of a staff line."}]}}}