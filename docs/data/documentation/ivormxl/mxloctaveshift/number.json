topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLNumberLevel":{"title":"MXLNumberLevel","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNumberLevel"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlnumberlevel","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumberLevel","abstract":[{"text":"Slurs, tuplets, and many other features can be concurrent and overlap within a single musical part. The","type":"text"},{"text":" ","type":"text"},{"text":"number-level entity distinguishes up to 16 concurrent objects of the same type when the objects overlap in","type":"text"},{"text":" ","type":"text"},{"text":"MusicXML document order. Values greater than 6 are usually only needed for music with a large number of divisi","type":"text"},{"text":" ","type":"text"},{"text":"staves in a single part, or if there are more than 6 cross-staff arpeggios in a single measure. When a number-","type":"text"},{"text":" ","type":"text"},{"text":"level value is implied, the value is 1 by default.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"MXLNumberLevel"}]},"doc://IvorMXL/documentation/IvorMXL/MXLOctaveShift":{"title":"MXLOctaveShift","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLOctaveShift"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxloctaveshift","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOctaveShift","abstract":[{"text":"The octave shift type indicates where notes are shifted up or down from their true pitched values because of","type":"text"},{"text":" ","type":"text"},{"text":"printing difficulty. Thus a treble clef line noted with 8va will be indicated with an octave-shift down from","type":"text"},{"text":" ","type":"text"},{"text":"the pitch data indicated in the notes. A size of 8 indicates one octave; a size of 15 indicates two octaves.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"MXLOctaveShift"}]},"doc://IvorMXL/documentation/IvorMXL/MXLOctaveShift/number":{"kind":"symbol","title":"number","url":"\/documentation\/ivormxl\/mxloctaveshift\/number","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"number","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL14MXLNumberLevelV","text":"MXLNumberLevel","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOctaveShift\/number","abstract":[{"text":"Distinguishes multiple octave shifts occurring simultaneously.","type":"text"}]}}}