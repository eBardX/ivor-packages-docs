":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"color"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL8MXLColorV","kind":"typeIdentifier","text":"MXLColor"},{"kind":"text","text":"?"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOctaveShift\/color","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLOctaveShift":{"role":"symbol","abstract":[{"type":"text","text":"The octave shift type indicates where notes are shifted up or down from their true pitched values because of"},{"type":"text","text":" "},{"type":"text","text":"printing difficulty. Thus a treble clef line noted with 8va will be indicated with an octave-shift down from"},{"type":"text","text":" "},{"type":"text","text":"the pitch data indicated in the notes. A size of 8 indicates one octave; a size of 15 indicates two octaves."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOctaveShift","url":"\/documentation\/ivormxl\/mxloctaveshift","title":"MXLOctaveShift","navigatorTitle":[{"kind":"identifier","text":"MXLOctaveShift"}],"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLOctaveShift"}]},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLColor","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","title":"MXLColor","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlcolor"}}}