t","text":"The color attribute group indicates the color of an element."}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"color","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL8MXLColorV","text":"MXLColor","kind":"typeIdentifier"},{"text":"?","kind":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLOctaveShift":{"title":"MXLOctaveShift","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLOctaveShift","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxloctaveshift","role":"symbol","navigatorTitle":[{"text":"MXLOctaveShift","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOctaveShift","abstract":[{"text":"The octave shift type indicates where notes are shifted up or down from their true pitched values because of","type":"text"},{"text":" ","type":"text"},{"text":"printing difficulty. Thus a treble clef line noted with 8va will be indicated with an octave-shift down from","type":"text"},{"text":" ","type":"text"},{"text":"the pitch data indicated in the notes. A size of 8 indicates one octave; a size of 15 indicates two octaves.","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"type":"topic","abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"type":"text","text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is"},{"type":"text","text":" "},{"type":"text","text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF."}],"url":"\/documentation\/ivormxl\/mxlcolor","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"kind":"symbol","title":"MXLColor","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","role":"symbol"}}}