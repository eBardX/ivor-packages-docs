tation\/IvorMXL\/MXLPosition","preciseIdentifier":"s:7IvorMXL11MXLPositionV","text":"MXLPosition"},{"kind":"text","text":" = MXLPosition(), "},{"kind":"externalParam","text":"font"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","preciseIdentifier":"s:7IvorMXL7MXLFontV","text":"MXLFont"},{"kind":"text","text":" = MXLFont(), "},{"kind":"externalParam","text":"color"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","preciseIdentifier":"s:7IvorMXL8MXLColorV","text":"MXLColor"},{"kind":"text","text":"? = nil)"}],"platforms":["macOS"],"languages":["swift"]}]},{"parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The optional-unique-id attribute group allows an element to optionally specify an ID that is unique to the entire document. This attribute group is not used for a required id attribute, or for an id attribute that specifies an id reference."}],"type":"paragraph"}],"name":"id"},{"content":[{"inlineContent":[{"type":"text","text":"Whether the shifted notes are up or down, and whether this element starts, stops, or continues the shift."}],"type":"paragraph"}],"name":"kind"},{"content":[{"inlineContent":[{"type":"text","text":"Distinguishes multiple octave shifts occurring simultaneously."}],"type":"paragraph"}],"name":"number"},{"content":[{"inlineContent":[{"type":"text","text":"Defaults to "},{"type":"codeVoice","code":"8"},{"type":"text","text":"."}],"type":"paragraph"}],"name":"size"},{"content":[{"inlineContent":[{"type":"text","text":"The length, in tenths, of the dashes in a dashed line. Ignored if the corresponding line-type attribute is not dashed."}],"type":"paragraph"}],"name":"dashLength"},{"content":[{"inlineContent":[{"type":"text","text":"The length, in tenths, of the spaces in a dashed line. Ignored if the corresponding line-type attribute is not dashed."}],"type":"paragraph"}],"name":"spaceLength"},{"content":[{"inlineContent":[{"type":"text","text":"For most elements, any program will compute a default x and y position. The position attributes let this be changed two ways."}],"type":"paragraph"}],"name":"position"},{"content":[{"inlineContent":[{"type":"text","text":"The font attribute group gathers together attributes for determining the font within a credit or direction. They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of font names.The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font vs. a music font."}],"type":"paragraph"}],"name":"font"},{"content":[{"inlineContent":[{"type":"text","text":"The color attribute group indicates the color of an element."}],"type":"paragraph"}],"name":"color"}],"kind":"parameters"}],"metadata":{"modules":[{"name":"IvorMXL"}],"role":"symbol","title":"init(id:kind:number:size:dashLength:spaceLength:position:font:color:)","fragments":[{"text":"init","kind":"identifier"},{"kind":"text","text":"("},{"text":"id","kind":"externalParam"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"kind"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLUpDownStopContinue","preciseIdentifier":"s:7IvorMXL21MXLUpDownStopContinueO"},{"kind":"text","text":", "},{"kind":"externalParam","text":"number"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL14MXLNumberLevelV","text":"MXLNumberLevel"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"size"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"dashLength"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLTenths","preciseIdentifier":"s:7IvorMXL9MXLTenthsa"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"spaceLength"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLTenths","preciseIdentifier":"s:7IvorMXL9MXLTenthsa"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"position"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLPosition","preciseIdentifier":"s:7IvorMXL11MXLPositionV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"font"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLFont","preciseIdentifier":"s:7IvorMXL7MXLFontV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"color"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL8MXLColorV","kind":"typeIdentifier","text":"MXLColor"},{"kind":"text","text":"?)"}],"roleHeading":"Initializer","externalID":"s:7IvorMXL14MXLOctaveShiftV2id4kind6number4size10dashLength05spaceJ08position4font5colorACSSSg_AA21MXLUpDownStopContinueOAA14MXLNumberLevelVSgSiSgSdSgAtA11MXLPositionVAA7MXLFontVAA8MXLColorVSgtcfc","symbolKind":"init"},"kind":"symbol","sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOctaveShift"]]},"variants":[{"paths":["\/documentation\/ivormxl\/mxloctaveshift\/init(id:kind:number:size:dashlength:spacelength:position:font:color:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLOctaveShift/init(id:kind:number:size:dashLength:spaceLength:position:font:color:)":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOctaveShift\/init(id:kind:number:size:dashLength:spaceLength:position:font:color:)","role":"symbol","abstract":[{"text":"Creates a new ","type":"text"},{"type":"codeVoice","code":"MXLOctaveShift"},{"text":".","type":"text"}],"title":"init(id:kind:number:size:dashLength:spaceLength:position:font:color:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?, ","kind":"text"},{"text":"kind","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLUpDownStopContinue","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL21MXLUpDownStopContinueO"},{"text":", ","kind":"text"},{"text":"number","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLNumberLevel","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL14MXLNumberLevelV"},{"text":"?, ","kind":"text"},{"text":"size","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":"?, ","kind":"text"},{"text":"dashLength","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLTenths","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLTenthsa"},{"text":"?, ","kind":"text"},{"text":"spaceLength","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLTenths","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLTenthsa"},{"text":"?, ","kind":"text"},{"text":"position","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLPosition","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLPositionV"},{"text":", ","kind":"text"},{"text":"font","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLFont","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL7MXLFontV"},{"text":", ","kind":"text"},{"text":"color","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLColor","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLColorV"},{"text":"?)","kind":"text"}],"kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxloctaveshift\/init(id:kind:number:size:dashlength:spacelength:position:font:color:)"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLTenths":{"title":"MXLTenths","type":"topic","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTenths","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxltenths","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"MXLTenths","kind":"identifier"}],"abstract":[{"type":"text","text":"The tenths type is a number representing tenths of interline staff space (positive or negative). Both integer"},{"type":"text","text":" "},{"type":"text","text":"and decimal values are allowed, such as 5 for a half space and 2.5 for a quarter space. Interline space is"},{"type":"text","text":" "},{"type":"text","text":"measured from the middle of a staff line."}]},"doc://IvorMXL/documentation/IvorMXL/MXLNumberLevel":{"type":"topic","url":"\/documentation\/ivormxl\/mxlnumberlevel","role":"symbol","title":"MXLNumberLevel","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumberLevel","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNumberLevel","kind":"identifier"}],"abstract":[{"text":"Slurs, tuplets, and many other features can be concurrent and overlap within a single musical part. The","type":"text"},{"text":" ","type":"text"},{"text":"number-level entity distinguishes up to 16 concurrent objects of the same type when the objects overlap in","type":"text"},{"text":" ","type":"text"},{"text":"MusicXML document order. Values greater than 6 are usually only needed for music with a large number of divisi","type":"text"},{"text":" ","type":"text"},{"text":"staves in a single part, or if there are more than 6 cross-staff arpeggios in a single measure. When a number-","type":"text"},{"text":" ","type":"text"},{"text":"level value is implied, the value is 1 by default.","type":"text"}],"navigatorTitle":[{"text":"MXLNumberLevel","kind":"identifier"}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLPosition":{"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPosition","kind":"identifier"}],"title":"MXLPosition","navigatorTitle":[{"text":"MXLPosition","kind":"identifier"}],"abstract":[{"type":"text","text":"For most elements, any program will compute a default x and y position. The position attributes let this be"},{"type":"text","text":" "},{"type":"text","text":"changed two ways."}],"url":"\/documentation\/ivormxl\/mxlposition","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLUpDownStopContinue":{"url":"\/documentation\/ivormxl\/mxlupdownstopcontinue","type":"topic","abstract":[{"type":"text","text":"The up-down-stop-continue type is used for octave-shift elements, indicating the direction of the shift from"},{"type":"text","text":" "},{"type":"text","text":"their true pitched values because of printing difficulty."}],"kind":"symbol","title":"MXLUpDownStopContinue","navigatorTitle":[{"kind":"identifier","text":"MXLUpDownStopContinue"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLUpDownStopContinue","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLUpDownStopContinue"}]},"doc://IvorMXL/documentation/IvorMXL/MXLOctaveShift":{"abstract":[{"text":"The octave shift type indicates where notes are shifted up or down from their true pitched values because of","type":"text"},{"text":" ","type":"text"},{"text":"printing difficulty. Thus a treble clef line noted with 8va will be indicated with an octave-shift down from","type":"text"},{"text":" ","type":"text"},{"text":"the pitch data indicated in the notes. A size of 8 indicates one octave; a size of 15 indicates two octaves.","type":"text"}],"url":"\/documentation\/ivormxl\/mxloctaveshift","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOctaveShift","type":"topic","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"MXLOctaveShift","kind":"identifier"}],"title":"MXLOctaveShift","navigatorTitle":[{"text":"MXLOctaveShift","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLFont":{"title":"MXLFont","url":"\/documentation\/ivormxl\/mxlfont","role":"symbol","navigatorTitle":[{"text":"MXLFont","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","abstract":[{"text":"The font attribute group gathers together attributes for determining the font within a credit or direction.","type":"text"},{"text":" ","type":"text"},{"text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric"},{"type":"text","text":" "},{"type":"text","text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font"},{"type":"text","text":" "},{"type":"text","text":"vs. a music font."}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLFont","kind":"identifier"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlcolor","title":"MXLColor","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"type":"text","text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is"},{"type":"text","text":" "},{"type":"text","text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor"}}}