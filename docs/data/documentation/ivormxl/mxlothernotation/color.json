d":"typeIdentifier"},{"text":"?","kind":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLOtherNotation":{"fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"kind":"identifier","text":"MXLOtherNotation"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOtherNotation","title":"MXLOtherNotation","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLOtherNotation"}],"abstract":[{"type":"text","text":"The other-notation type is used to define any notations not yet in the MusicXML format. It handles notations"},{"type":"text","text":" "},{"text":"where more specific extension elements such as other-dynamics and other-technical are not appropriate. The","type":"text"},{"type":"text","text":" "},{"text":"smufl attribute can be used to specify a particular notation, allowing application interoperability without","type":"text"},{"text":" ","type":"text"},{"text":"requiring every SMuFL glyph to have a MusicXML element equivalent. Using the other-notation type without the","type":"text"},{"text":" ","type":"text"},{"text":"smufl attribute allows for extended representation, though without application interoperability.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlothernotation"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLColor","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","title":"MXLColor","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlcolor"}}}