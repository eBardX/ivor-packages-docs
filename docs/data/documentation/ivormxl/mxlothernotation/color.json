{"abstract":[{"type":"text","text":"The color attribute group indicates the color of an element."}],"metadata":{"modules":[{"name":"IvorMXL"}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"color"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLColor","preciseIdentifier":"s:7IvorMXL8MXLColorV"},{"kind":"text","text":"?"}],"roleHeading":"Instance Property","symbolKind":"property","role":"symbol","externalID":"s:7IvorMXL16MXLOtherNotationV5colorAA8MXLColorVSgvp","title":"color"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlothernotation\/color"]}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"color"},{"kind":"text","text":": "},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","kind":"typeIdentifier","text":"MXLColor","preciseIdentifier":"s:7IvorMXL8MXLColorV"},{"kind":"text","text":"?"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOtherNotation"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOtherNotation\/color"},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLOtherNotation":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlothernotation","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOtherNotation","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLOtherNotation","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"The other-notation type is used to define any notations not yet in the MusicXML format. It handles notations","type":"text"},{"text":" ","type":"text"},{"text":"where more specific extension elements such as other-dynamics and other-technical are not appropriate. The","type":"text"},{"text":" ","type":"text"},{"text":"smufl attribute can be used to specify a particular notation, allowing application interoperability without","type":"text"},{"text":" ","type":"text"},{"text":"requiring every SMuFL glyph to have a MusicXML element equivalent. Using the other-notation type without the","type":"text"},{"text":" ","type":"text"},{"text":"smufl attribute allows for extended representation, though without application interoperability.","type":"text"}],"type":"topic","navigatorTitle":[{"text":"MXLOtherNotation","kind":"identifier"}],"title":"MXLOtherNotation"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"title":"MXLColor","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"abstract":[{"text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in","type":"text"},{"text":" ","type":"text"},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"url":"\/documentation\/ivormxl\/mxlcolor"},"doc://IvorMXL/documentation/IvorMXL/MXLOtherNotation/color":{"abstract":[{"type":"text","text":"The color attribute group indicates the color of an element."}],"url":"\/documentation\/ivormxl\/mxlothernotation\/color","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"color","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL8MXLColorV","text":"MXLColor","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOtherNotation\/color","role":"symbol","title":"color","type":"topic"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"}}}