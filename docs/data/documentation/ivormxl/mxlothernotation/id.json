{"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"type":"text","text":"The optional-unique-id attribute group allows an element to optionally specify an ID that is unique to the"},{"type":"text","text":" "},{"type":"text","text":"entire document. This attribute group is not used for a required id attribute, or for an id attribute that"},{"type":"text","text":" "},{"type":"text","text":"specifies an id reference."}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"id"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"Maps to the MusicXML ","type":"text"},{"code":"id","type":"codeVoice"},{"text":" attribute.","type":"text"}]}]}],"metadata":{"roleHeading":"Instance Property","title":"id","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"id","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?","kind":"text"}],"role":"symbol","modules":[{"name":"IvorMXL"}],"symbolKind":"property","externalID":"s:7IvorMXL16MXLOtherNotationV2idSSSgvp"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOtherNotation"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlothernotation\/id"]}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOtherNotation\/id","interfaceLanguage":"swift"},"sections":[],"kind":"symbol","references":{"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLOtherNotation":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOtherNotation","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"MXLOtherNotation"}],"title":"MXLOtherNotation","abstract":[{"text":"The other-notation type is used to define any notations not yet in the MusicXML format. It handles notations","type":"text"},{"text":" ","type":"text"},{"text":"where more specific extension elements such as other-dynamics and other-technical are not appropriate. The","type":"text"},{"type":"text","text":" "},{"type":"text","text":"smufl attribute can be used to specify a particular notation, allowing application interoperability without"},{"type":"text","text":" "},{"type":"text","text":"requiring every SMuFL glyph to have a MusicXML element equivalent. Using the other-notation type without the"},{"type":"text","text":" "},{"type":"text","text":"smufl attribute allows for extended representation, though without application interoperability."}],"navigatorTitle":[{"text":"MXLOtherNotation","kind":"identifier"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlothernotation"},"doc://IvorMXL/documentation/IvorMXL/MXLOtherNotation/id":{"abstract":[{"text":"The optional-unique-id attribute group allows an element to optionally specify an ID that is unique to the","type":"text"},{"text":" ","type":"text"},{"text":"entire document. This attribute group is not used for a required id attribute, or for an id attribute that","type":"text"},{"text":" ","type":"text"},{"text":"specifies an id reference.","type":"text"}],"title":"id","url":"\/documentation\/ivormxl\/mxlothernotation\/id","type":"topic","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOtherNotation\/id","fragments":[{"kind"