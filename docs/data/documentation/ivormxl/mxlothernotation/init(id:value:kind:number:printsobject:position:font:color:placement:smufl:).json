her attributes for determining the font within a credit or direction. They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of font names.The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font vs. a music font.","type":"text"}]}]},{"name":"color","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The color attribute group indicates the color of an element."}]}]},{"name":"placement","content":[{"type":"paragraph","inlineContent":[{"text":"The placement attribute indicates whether something is above or below another element, such as a note or a notation.","type":"text"}]}]},{"name":"smufl","content":[{"inlineContent":[{"type":"text","text":"The smufl attribute group is used to indicate a particular Standard Music Font Layout (SMuFL) character. Sometimes this is a formatting choice, and sometimes this is a refinement of the semantic meaning of an element."}],"type":"paragraph"}]}],"kind":"parameters"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOtherNotation\/init(id:value:kind:number:printsObject:position:font:color:placement:smufl:)","interfaceLanguage":"swift"},"metadata":{"roleHeading":"Initializer","symbolKind":"init","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"id"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"value"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"kind"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL18MXLStartStopSingleO","kind":"typeIdentifier","text":"MXLStartStopSing