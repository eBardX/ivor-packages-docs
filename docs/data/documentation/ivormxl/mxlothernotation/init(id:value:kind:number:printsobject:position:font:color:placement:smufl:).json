lParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","text":"MXLFont","preciseIdentifier":"s:7IvorMXL7MXLFontV","kind":"typeIdentifier"},{"text":" = MXLFont(), ","kind":"text"},{"text":"color","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","text":"MXLColor","preciseIdentifier":"s:7IvorMXL8MXLColorV","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"placement","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAboveBelow","text":"MXLAboveBelow","preciseIdentifier":"s:7IvorMXL13MXLAboveBelowO","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"smufl","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSmuflGlyphName","text":"MXLSmuflGlyphName","preciseIdentifier":"s:7IvorMXL17MXLSmuflGlyphNameV","kind":"typeIdentifier"},{"text":"? = nil)","kind":"text"}]}],"kind":"declarations"},{"parameters":[{"name":"id","content":[{"inlineContent":[{"text":"The optional-unique-id attribute group allows an element to optionally specify an ID that is unique to the entire document. This attribute group is not used for a required id attribute, or for an id attribute that specifies an id reference.","type":"text"}],"type":"paragraph"}]},{"name":"value","content":[{"inlineContent":[{"text":"The value of this element.","type":"text"}],"type":"paragraph"}]},{"name":"kind","content":[{"inlineContent":[{"text":"Whether this element starts, stops, or is a single occurrence of the notation.","type":"text"}],"type":"paragraph"}]},{"name":"number","content":[{"inlineContent":[{"text":"Defaults to ","type":"text"},{"code":"1","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"name":"printsObject","content":[{"inlineContent":[{"text":"A Boolean value indicating whether to print an object (e.g. a note or a rest). Defaults to ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" if not specified.","type":"text"}],"type":"paragraph"}]},{"name":"position","content":[{"inlineContent":[{"text":"For most elements, any program will compute a default x and y position. The position attributes let this be changed two ways.","type":"text"}],"type":"paragraph"}]},{"name":"font","content":[{"inlineContent":[{"text":"The font attribute group gathers together attributes for determining the font within a credit or direction. They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of font names.The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font vs. a music font.","type":"text"}],"type":"paragraph"}]},{"name":"color","content":[{"inlineContent":[{"text":"The color attribute group indicates the color of an element.","type":"text"}],"type":"paragraph"}]},{"name":"placement","content":[{"inlineContent":[{"text":"The placement attribute indicates whether something is above or below another element, such as a note or a notation.","type":"text"}],"type":"paragraph"}]},{"name":"smufl","content":[{"inlineContent":[{"text":"The smufl attribute group is used to indicate a particular Standard Music Font Layout (SMuFL) character. Sometimes this is a formatting choice, and sometimes this is a refinement of the semantic meaning of an element.","type":"text"}],"type":"paragraph"}]}],"kind":"parameters"}],"abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLOtherNotation"},{"type":"text","text":"."}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOtherNotation"]]},"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOtherNotation\/init(id:value:kind:number:printsObject:position:font:color:placement:smufl:)","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/ivormxl\/mxlothernotation\/init(id:value:kind:number:printsobject:position:font:color:placement:smufl:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLSmuflGlyphName":{"url":"\/documentation\/ivormxl\/mxlsmuflglyphname","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSmuflGlyphName","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSmuflGlyphName","title":"MXLSmuflGlyphName","abstract":[{"type":"text","text":"The smufl-glyph-name type is used for attributes that reference a specific Standard Music Font Layout (SMuFL)"},{"type":"text","text":" "},{"type":"text","text":"character. The value is a SMuFL canonical glyph name, not a code point. For instance, the value for a standard"},{"type":"text","text":" "},{"type":"text","text":"piano pedal mark would be keyboardPedalPed, not U+E650."}],"navigatorTitle":[{"text":"MXLSmuflGlyphName","kind":"identifier"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLAboveBelow":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlabovebelow","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAboveBelow","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLAboveBelow"}],"kind":"symbol","abstract":[{"text":"The above-below type is used to indicate whether one element appears above or below another element.","type":"text"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLAboveBelow"}],"title":"MXLAboveBelow"},"doc://IvorMXL/documentation/IvorMXL/MXLStartStopSingle":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlstartstopsingle","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStartStopSingle","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLStartStopSingle"}],"abstract":[{"type":"text","text":"The start-stop-single type is used for an attribute of musical elements that can be used for either multi-note"},{"type":"text","text":" "},{"type":"text","text":"or single-note musical elements, as for groupings."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLStartStopSingle"}],"title":"MXLStartStopSingle"},"doc://IvorMXL/documentation/IvorMXL/MXLFont":{"title":"MXLFont","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFont"}],"abstract":[{"text":"The font attribute group gathers together attributes for determining the font within a credit or direction.","type":"text"},{"text":" ","type":"text"},{"text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of","type":"text"},{"text":" ","type":"text"},{"text":"font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric","type":"text"},{"text":" ","type":"text"},{"text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font","type":"text"},{"text":" ","type":"text"},{"text":"vs. a music font.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLFont"}],"url":"\/documentation\/ivormxl\/mxlfont"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLOtherNotation/init(id:value:kind:number:printsObject:position:font:color:placement:smufl:)":{"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam"