{"abstract":[{"type":"text","text":"Defaults to "},{"code":"1","type":"codeVoice"},{"type":"text","text":"."}],"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOtherNotation"]]},"variants":[{"paths":["\/documentation\/ivormxl\/mxlothernotation\/number"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOtherNotation\/number"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"number"},{"kind":"text","text":": "},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumberLevel","preciseIdentifier":"s:7IvorMXL14MXLNumberLevelV","kind":"typeIdentifier","text":"MXLNumberLevel"}]}]},{"content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"inlineContent":[{"text":"Maps to the MusicXML ","type":"text"},{"type":"codeVoice","code":"number"},{"text":" attribute.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"metadata":{"modules":[{"name":"IvorMXL"}],"title":"number","externalID":"s:7IvorMXL16MXLOtherNotationV6numberAA14MXLNumberLevelVvp","roleHeading":"Instance Property","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"number"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL14MXLNumberLevelV","kind":"typeIdentifier","text":"MXLNumberLevel"}],"symbolKind":"property"},"references":{"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLNumberLevel":{"type":"topic","url":"\/documentation\/ivormxl\/mxlnumberlevel","role":"symbol","title":"MXLNumberLevel","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumberLevel","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNumberLevel","kind":"identifier"}],"abstract":[{"text":"Slurs, tuplets, and many other features can be concurrent and overlap within a single musical part. The","type":"text"},{"text":" ","type":"text"},{"text":"number-level entity distinguishes up to 16 concurrent objects of the same type when the objects overlap in","type":"text"},{"text":" ","type":"text"},{"text":"MusicXML document order. Values greater than 6 are usually only needed for music with a large number of divisi","type":"text"},{"text":" ","type":"text"},{"text":"staves in a single part, or if there are more than 6 cross-staff arpeggios in a single measure. When a number-","type":"text"},{"text":" ","type":"text"},{"text":"level value is implied, the value is 1 by default.","type":"text"}],"navigatorTitle":[{"text":"MXLNumberLevel","kind":"identifier"}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLOtherNotation":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOtherNotation","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"MXLOtherNotation"}],"title":"MXLOtherNotation","abstract":[{"text":"The other-notation type is used to define any notations not yet in the MusicXML format. It handles notations","type":"text"},{"text":" ","type":"text"},{"text":"where more specific extension elements such as other-dynamics and other-technical are not appropriate. The","type":"text"},{"type":"text","text":" "},{"type":"text","text":"smufl attribute can be used to specify a particular notation, allowing application interoperability without"},{"type":"text","text":" "},{"type":"text","text":"requiring every SMuFL glyph to have a MusicXML element equivalent. Using the other-notation type without the"},{"type":"text","text":" "},{"type":"text","text":"smufl attribute allows for extended representation, though without application interoperability."}],"navigatorTitle":[{"text":"MXLOtherNotation","kind":"identifier"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlothernotation"},"doc://IvorMXL/documentation/IvorMXL/MXLOtherNotation/number":{"abstract":[{"type":"text","text":"Defaults to "},{"type":"codeVoice","code":"1"},{"type":"text","text":"."}],"url":"\/documentation\/ivormxl\/mxlothernotation\/number","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"text":"number","kind":"identifier"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLNumberLevel","preciseIdentifier":"s:7IvorMXL14MXLNumberLevelV"}],"type":"topic","role":"symbol","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOtherNotation\/number","title":"number"}}}