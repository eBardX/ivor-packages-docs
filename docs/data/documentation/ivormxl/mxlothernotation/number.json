{"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOtherNotation"]]},"kind":"symbol","abstract":[{"text":"Defaults to ","type":"text"},{"code":"1","type":"codeVoice"},{"type":"text","text":"."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOtherNotation\/number"},"sections":[],"metadata":{"modules":[{"name":"IvorMXL"}],"symbolKind":"property","title":"number","roleHeading":"Instance Property","fragments":[{"kind":"keyword","text":"let"},{"text":" ","kind":"text"},{"kind":"identifier","text":"number"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLNumberLevel","preciseIdentifier":"s:7IvorMXL14MXLNumberLevelV"}],"role":"symbol","externalID":"s:7IvorMXL16MXLOtherNotationV6numberAA14MXLNumberLevelVvp"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"number"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLNumberLevel","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumberLevel","preciseIdentifier":"s:7IvorMXL14MXLNumberLevelV"}]}]},{"content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Maps to the MusicXML "},{"type":"codeVoice","code":"number"},{"type":"text","text":" attribute."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlothernotation\/number"]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLOtherNotation":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOtherNotation","title":"MXLOtherNotation","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLOtherNotation","kind":"identifier"}],"navigatorTitle":[{"text":"MXLOtherNotation","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlothernotation","abstract":[{"text":"The other-notation type is used to define any notations not yet in the MusicXML format. It handles notations","type":"text"},{"text":" ","type":"text"},{"text":"where more specific extension elements such as other-dynamics and other-technical are not appropriate. The","type":"text"},{"text":" ","type":"text"},{"text":"smufl attribute can be used to specify a particular notation, allowing application interoperability without","type":"text"},{"text":" ","type":"text"},{"text":"requiring every SMuFL glyph to have a MusicXML element equivalent. Using the other-notation type without the","type":"text"},{"text":" ","type":"text"},{"text":"smufl attribute allows for extended representation, though without application interoperability.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLNumberLevel":{"title":"MXLNumberLevel","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNumberLevel"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlnumberlevel","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumberLevel","abstract":[{"text":"Slurs, tuplets, and many other features can be concurrent and overlap within a single musical part. The","type":"text"},{"text":" ","type":"text"},{"text":"number-level entity distinguishes up to 16 concurrent objects of the same type when the objects overlap in","type":"text"},{"text":" ","type":"text"},{"text":"MusicXML document order. Values greater than 6 are usually only needed for music with a large number of divisi","type":"text"},{"text":" ","type":"text"},{"text":"staves in a single part, or if there are more than 6 cross-staff arpeggios in a single measure. When a number-","type":"text"},{"text":" ","type":"text"},{"text":"level value is implied, the value is 1 by default.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"MXLNumberLevel"}]},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLOtherNotation/number":{"url":"\/documentation\/ivormxl\/mxlothernotation\/number","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOtherNotation\/number","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"number"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLNumberLevel","preciseIdentifier":"s:7IvorMXL14MXLNumberLevelV"}],"kind":"symbol","abstract":[{"text":"Defaults to ","type":"text"},{"code":"1","type":"codeVoice"},{"text":".","type":"text"}],"type":"topic","title":"number"}}}