{"abstract":[{"text":"The smufl attribute group is used to indicate a particular Standard Music Font Layout (SMuFL) character.","type":"text"},{"text":" ","type":"text"},{"text":"Sometimes this is a formatting choice, and sometimes this is a refinement of the semantic meaning of an","type":"text"},{"text":" ","type":"text"},{"text":"element.","type":"text"}],"metadata":{"modules":[{"name":"IvorMXL"}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"smufl"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL17MXLSmuflGlyphNameV","text":"MXLSmuflGlyphName"},{"kind":"text","text":"?"}],"roleHeading":"Instance Property","symbolKind":"property","role":"symbol","externalID":"s:7IvorMXL16MXLOtherNotationV5smuflAA17MXLSmuflGlyphNameVSgvp","title":"smufl"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlothernotation\/smufl"]}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"smufl"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL17MXLSmuflGlyphNameV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSmuflGlyphName","text":"MXLSmuflGlyphName"},{"kind":"text","text":"?"}]}],"kind":"declarations"},{"content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Maps to the MusicXML "},{"code":"smufl","type":"codeVoice"},{"type":"text","text":" attribute."}]}],"kind":"content"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOtherNotation"]]},"kind":"symbol","sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOtherNotation\/smufl"},"references":{"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLOtherNotation":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlothernotation","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOtherNotation","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLOtherNotation","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"The other-notation type is used to define any notations not yet in the MusicXML format. It handles notations","type":"text"},{"text":" ","type":"text"},{"text":"where more specific extension elements such as other-dynamics and other-technical are not appropriate. The","type":"text"},{"text":" ","type":"text"},{"text":"smufl attribute can be used to specify a particular notation, allowing application interoperability without","type":"text"},{"text":" ","type":"text"},{"text":"requiring every SMuFL glyph to have a MusicXML element equivalent. Using the other-notation type without the","type":"text"},{"text":" ","type":"text"},{"text":"smufl attribute allows for extended representation, though without application interoperability.","type":"text"}],"type":"topic","navigatorTitle":[{"text":"MXLOtherNotation","kind":"identifier"}],"title":"MXLOtherNotation"},"doc://IvorMXL/documentation/IvorMXL/MXLOtherNotation/smufl":{"abstract":[{"text":"The smufl attribute group is used to indicate a particular Standard Music Font Layout (SMuFL) character.","type":"text"},{"text":" ","type":"text"},{"text":"Sometimes this is a formatting choice, and sometimes this is a refinement of the semantic meaning of an","type":"text"},{"text":" ","type":"text"},{"text":"element.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlothernotation\/smufl","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"smufl","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLSmuflGlyphName","preciseIdentifier":"s:7IvorMXL17MXLSmuflGlyphNameV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOtherNotation\/smufl","role":"symbol","title":"smufl","type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLSmuflGlyphName":{"url":"\/documentation\/ivormxl\/mxlsmuflglyphname","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSmuflGlyphName","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSmuflGlyphName","title":"MXLSmuflGlyphName","abstract":[{"type":"text","text":"The smufl-glyph-name type is used for attributes that reference a specific Standard Music Font Layout (SMuFL)"},{"type":"text","text":" "},{"type":"text","text":"character. The value is a SMuFL canonical glyph name, not a code point. For instance, the value for a standard"},{"type":"text","text":" "},{"type":"text","text":"piano pedal mark would be keyboardPedalPed, not U+E650."}],"navigatorTitle":[{"text":"MXLSmuflGlyphName","kind":"identifier"}],"type":"topic"}}}