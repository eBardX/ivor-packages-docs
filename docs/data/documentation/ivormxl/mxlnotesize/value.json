\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLNoteSize":{"title":"MXLNoteSize","navigatorTitle":[{"kind":"identifier","text":"MXLNoteSize"}],"type":"topic","abstract":[{"type":"text","text":"The note-size type indicates the percentage of the regular note size to use for notes with a cue and large"},{"type":"text","text":" "},{"type":"text","text":"size as defined in the type element. The grace type is used for notes of cue size that that include a grace"},{"type":"text","text":" "},{"type":"text","text":"element. The cue type is used for all other notes with cue size, whether defined explicitly or implicitly via"},{"type":"text","text":" "},{"type":"text","text":"a cue element. The large type is used for notes of large size. The text content represent the numeric"},{"type":"text","text":" "},{"type":"text","text":"percentage. A value of 100 would be identical to the size of a regular note as defined by the music font."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNoteSize"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNoteSize","url":"\/documentation\/ivormxl\/mxlnotesize"}}}