 defined explicitly or implicitly","type":"text"},{"text":" ","type":"text"},{"text":"via a cue element. The large type is used for notes of large size.","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLNoteSize":{"title":"MXLNoteSize","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNoteSize"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlnotesize","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLNoteSize"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNoteSize","abstract":[{"text":"The note-size type indicates the percentage of the regular note size to use for notes with a cue and large","type":"text"},{"text":" ","type":"text"},{"text":"size as defined in the type element. The grace type is used for notes of cue size that that include a grace","type":"text"},{"text":" ","type":"text"},{"text":"element. The cue type is used for all other notes with cue size, whether defined explicitly or implicitly via","type":"text"},{"text":" ","type":"text"},{"text":"a cue element. The large type is used for notes of large size. The text content represent the numeric","type":"text"},{"text":" ","type":"text"},{"text":"percentage. A value of 100 would be identical to the size of a regular note as defined by the music font.","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLNoteSize/Kind-swift.enum/graceCue":{"kind":"symbol","abstract":[{"text":"A note of grace-cue size.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlnotesize\/kind-swift.enum\/gracecue","role":"symbol","title":"MXLNoteSize.Kind.graceCue","identifier":"doc:\/\/IvorMXL\/documentation\/