ype":"paragraph","inlineContent":[{"text":"The color attribute group indicates the color of an element.","type":"text"}]}]},{"name":"smufl","content":[{"type":"paragraph","inlineContent":[{"text":"The SMuFL canonical glyph name used to specify the elision symbol when the text content is empty.","type":"text"}]}]}],"kind":"parameters"}],"sections":[],"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"Creates a new "},{"code":"MXLElision","type":"codeVoice"},{"type":"text","text":"."}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLElision"]]},"metadata":{"title":"init(value:font:color:smufl:)","modules":[{"name":"IvorMXL"}],"fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"value","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"font","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL7MXLFontV","text":"MXLFont","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"color","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL8MXLColorV","text":"MXLColor","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"smufl","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL23MXLSmuflLyricsGlyphNameV","text":"MXLSmuflLyricsGlyphName","kind":"typeIdentifier"},{"text":"?)","kind":"text"}],"roleHeading":"Initializer","externalID":"s:7IvorMXL10MXLElisionV5value4font5color5smuflACSS_AA7MXLFontVAA8MXLColorVSgAA23MXLSmuflLyricsGlyphNameVSgtcfc","symbolKind":"init","role":"symbol"},"variants":[{"paths":["\/documentation\/ivormxl\/mxlelision\/init(value:font:color:smufl:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLElision/init(value:font:color:smufl:)":{"title":"init(value:font:color:smufl:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"value","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"font","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLFont","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL7MXLFontV"},{"text":", ","kind":"text"},{"text":"color","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLColor","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLColorV"},{"text":"?, ","kind":"text"},{"text":"smufl","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLSmuflLyricsGlyphName","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL23MXLSmuflLyricsGlyphNameV"},{"text":"?)","kind":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLElision\/init(value:font:color:smufl:)","kind":"symbol","url":"\/documentation\/ivormxl\/mxlelision\/init(value:font:color:smufl:)","role":"symbol","abstract":[{"text":"Creates a new ","type":"text"},{"code":"MXLElision","type":"codeVoice"},{"text":".","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLElision":{"role":"symbol","navigatorTitle":[{"text":"MXLElision","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLElision","kind":"identifier"}],"kind":"symbol","title":"MXLElision","url":"\/documentation\/ivormxl\/mxlelision","type":"topic","abstract":[{"text":"The elision type represents an elision between lyric syllables. The text content specifies the symbol used to","type":"text"},{"text":" ","type":"text"},{"text":"display the elision. Common values are a no-break space (Unicode 00A0), an underscore (Unicode 005F), or an","type":"text"},{"text":" ","type":"text"},{"text":"undertie (Unicode 203F). If the text content is empty, the smufl attribute is used to specify the symbol to","type":"text"},{"text":" ","type":"text"},{"text":"use. Its value is a SMuFL canonical glyph name that starts with lyrics. The SMuFL attribute is ignored if the","type":"text"},{"text":" ","type":"text"},{"text":"elision glyph is already specified by the text content. If neither text content nor a smufl attribute are","type":"text"},{"text":" ","type":"text"},{"text":"present, the elision glyph is application-specific.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLElision"},"doc://IvorMXL/documentation/IvorMXL/MXLFont":{"title":"MXLFont","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFont"}],"abstract":[{"text":"The font attribute group gathers together attributes for determining the font within a credit or direction.","type":"text"},{"text":" ","type":"text"},{"text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of","type":"text"},{"text":" ","type":"text"},{"text":"font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric","type":"text"},{"text":" ","type":"text"},{"text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font","type":"text"},{"text":" ","type":"text"},{"text":"vs. a music font.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLFont"}],"url":"\/documentation\/ivormxl\/mxlfont"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"title":"MXLColor","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"abstract":[{"text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in","type":"text"},{"text":" ","type":"text"},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"url":"\/documentation\/ivormxl\/mxlcolor"},"doc://IvorMXL/documentation/IvorMXL/MXLSmuflLyricsGlyphName":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLSmuflLyricsGlyphName"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLSmuflLyricsGlyphName"}],"url":"\/documentation\/ivormxl\/mxlsmufllyricsglyphname","abstract":[{"type":"text","text":"The smufl-lyrics-glyph-name type is used to reference a specific Standard Music Font Layout (SMuFL) lyrics"},{"type":"text","text":" "},{"type":"text","text":"elision character. The value is a SMuFL canonical glyph name that starts with lyrics."}],"title":"MXLSmuflLyricsGlyphName","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSmuflLyricsGlyphName","kind":"symbol"}}}