{"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"init","kind":"keyword"},{"text":"(","kind":"text"},{"text":"value","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"font","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL7MXLFontV","text":"MXLFont","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont"},{"text":" = MXLFont(), ","kind":"text"},{"text":"color","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL8MXLColorV","text":"MXLColor","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor"},{"text":"? = nil, ","kind":"text"},{"text":"smufl","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL23MXLSmuflLyricsGlyphNameV","text":"MXLSmuflLyricsGlyphName","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSmuflLyricsGlyphName"},{"text":"? = nil)","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The value of this element."}]}],"name":"value"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The font attribute group gathers together attributes for determining the font within a credit or direction. They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font vs. a music font."}]}],"name":"font"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The color attribute group indicates the color of an element."}]}],"name":"color"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The SMuFL canonical glyph name used to specify the elision symbol when the text content is empty."}]}],"name":"smufl"}],"kind":"parameters"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLElision"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLElision\/init(value:font:color:smufl:)"},"abstract":[{"text":"Creates a new ","type":"text"},{"code":"MXLElision","type":"codeVoice"},{"text":".","type":"text"}],"variants":[{"paths":["\/documentation\/ivormxl\/mxlelision\/init(value:font:color:smufl:)"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"roleHeading":"Initializer","modules":[{"name":"IvorMXL"}],"title":"init(value:font:color:smufl:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"value","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"font","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL7MXLFontV","text":"MXLFont","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"color","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL8MXLColorV","text":"MXLColor","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"smufl","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL23MXLSmuflLyricsGlyphNameV","text":"MXLSmuflLyricsGlyphName","kind":"typeIdentifier"},{"text":"?)","kind":"text"}],"externalID":"s:7IvorMXL10MXLElisionV5value4font5color5smuflACSS_AA7MXLFontVAA8MXLColorVSgAA23MXLSmuflLyricsGlyphNameVSgtcfc","role":"symbol","symbolKind":"init"},"kind":"symbol","references":{"doc://IvorMXL/documentation/IvorMXL/MXLFont":{"title":"MXLFont","url":"\/documentation\/ivormxl\/mxlfont","role":"symbol","navigatorTitle":[{"text":"MXLFont","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","abstract":[{"text":"The font attribute group gathers together attributes for determining the font within a credit or direction.","type":"text"},{"text":" ","type":"text"},{"text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric"},{"type":"text","text":" "},{"type":"text","text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font"},{"type":"text","text":" "},{"type":"text","text":"vs. a music font."}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLFont","kind":"identifier"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLElision":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLElision","abstract":[{"type":"text","text":"The elision type represents an elision between lyric syllables. The text content specifies the symbol used to"},{"type":"text","text":" "},{"type":"text","text":"display the elision. Common values are a no-break space (Unicode 00A0), an underscore (Unicode 005F), or an"},{"type":"text","text":" "},{"type":"text","text":"undertie (Unicode 203F). If the text content is empty, the smufl attribute is used to specify the symbol to"},{"type":"text","text":" "},{"type":"text","text":"use. Its value is a SMuFL canonical glyph name that starts with lyrics. The SMuFL attribute is ignored if the"},{"type":"text","text":" "},{"type":"text","text":"elision glyph is already specified by the text content. If neither text content nor a smufl attribute are"},{"type":"text","text":" "},{"type":"text","text":"present, the elision glyph is application-specific."}],"title":"MXLElision","navigatorTitle":[{"text":"MXLElision","kind":"identifier"}],"type":"topic","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLElision","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlelision"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlcolor","title":"MXLColor","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"type":"text","text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is"},{"type":"text","text":" "},{"type":"text","text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor"},"doc://IvorMXL/documentation/IvorMXL/MXLSmuflLyricsGlyphName":{"url":"\/documentation\/ivormxl\/mxlsmufllyricsglyphname","navigatorTitle":[{"kind":"identifier","text":"MXLSmuflLyricsGlyphName"}],"abstract":[{"type":"text","text":"The smufl-lyrics-glyph-name type is used to reference a specific Standard Music Font Layout (SMuFL) lyrics"},{"type":"text","text":" "},{"type":"text","text":"elision character. The value is a SMuFL canonical glyph name that starts with lyrics."}],"type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLSmuflLyricsGlyphName"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSmuflLyricsGlyphName","title":"MXLSmuflLyricsGlyphName"},"doc://IvorMXL/documentation/IvorMXL/MXLElision/init(value:font:color:smufl:)":{"url":"\/do