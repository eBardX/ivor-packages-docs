ymbol"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"abstract":[{"text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in","type":"text"},{"type":"text","text":" "},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"title":"MXLColor","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlcolor","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor"},"doc://IvorMXL/documentation/IvorMXL/MXLElision":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLElision","title":"MXLElision","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLElision","kind":"identifier"}],"navigatorTitle":[{"text":"MXLElision","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlelision","abstract":[{"text":"The elision type represents an elision between lyric syllables. The text content specifies the symbol used to","type":"text"},{"text":" ","type":"text"},{"text":"display the elision. Common values are a no-break space (Unicode 00A0), an underscore (Unicode 005F), or an","type":"text"},{"text":" ","type":"text"},{"text":"undertie (Unicode 203F). If the text content is empty, the smufl attribute is used to specify the symbol to","type":"text"},{"text":" ","type":"text"},{"text":"use. Its value is a SMuFL canonical glyph name that starts with lyrics. The SMuFL attribute is ignored if the","type":"text"},{"text":" ","type":"text"},{"text":"elision glyph is already specified by the text content. If neither text content nor a smufl attribute are","type":"text"},{"text":" ","type":"text"},{"text":"present, the elision glyph is application-specific.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"}}}