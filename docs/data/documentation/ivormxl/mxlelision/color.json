{"abstract":[{"text":"The color attribute group indicates the color of an element.","type":"text"}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLElision\/color"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"color","kind":"identifier"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","text":"MXLColor","preciseIdentifier":"s:7IvorMXL8MXLColorV","kind":"typeIdentifier"},{"text":"?","kind":"text"}]}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlelision\/color"]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLElision"]]},"metadata":{"roleHeading":"Instance Property","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"color","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLColor","preciseIdentifier":"s:7IvorMXL8MXLColorV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"externalID":"s:7IvorMXL10MXLElisionV5colorAA8MXLColorVSgvp","title":"color","modules":[{"name":"IvorMXL"}],"symbolKind":"property"},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLElision/color":{"url":"\/documentation\/ivormxl\/mxlelision\/color","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLElision\/color","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"color","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL8MXLColorV","text":"MXLColor","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"kind":"symbol","title":"color","type":"topic","abstract":[{"type":"text","text":"The color attribute group indicates the color of an element."}]},"doc://IvorMXL/documentation/IvorMXL/MXLElision":{"title":"MXLElision","navigatorTitle":[{"text":"MXLElision","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"The elision type represents an elision between lyric syllables. The text content specifies the symbol used to"},{"type":"text","text":" "},{"type":"text","text":"display the elision. Common values are a no-break space (Unicode 00A0), an underscore (Unicode 005F), or an"},{"type":"text","text":" "},{"type":"text","text":"undertie (Unicode 203F). If the text content is empty, the smufl attribute is used to specify the symbol to"},{"type":"text","text":" "},{"type":"text","text":"use. Its value is a SMuFL canonical glyph name that starts with lyrics. The SMuFL attribute is ignored if the"},{"type":"text","text":" "},{"type":"text","text":"elision glyph is already specified by the text content. If neither text content nor a smufl attribute are"},{"type":"text","text":" "},{"type":"text","text":"present, the elision glyph is application-specific."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLElision"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLElision","url":"\/documentation\/ivormxl\/mxlelision"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLColor","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","title":"MXLColor","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlcolor"}}}