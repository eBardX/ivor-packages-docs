{"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLElision\/Equatable-Implementations"},"metadata":{"modules":[{"name":"IvorMXL"}],"role":"collectionGroup","roleHeading":"API Collection","title":"Equatable Implementations"},"topicSections":[{"generated":true,"anchor":"Operators","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLElision\/!=(_:_:)"],"title":"Operators"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlelision\/equatable-implementations"]}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLElision"]]},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLElision":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLElision","navigatorTitle":[{"kind":"identifier","text":"MXLElision"}],"url":"\/documentation\/ivormxl\/mxlelision","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLElision"}],"title":"MXLElision","abstract":[{"type":"text","text":"The elision type represents an elision between lyric syllables. The text content specifies the symbol used to"},{"type":"text","text":" "},{"type":"text","text":"display the elision. Common values are a no-break space (Unicode 00A0), an underscore (Unicode 005F), or an"},{"type":"text","text":" "},{"type":"text","text":"undertie (Unicode 203F). If the text content is empty, the smufl attribute is used to specify the symbol to"},{"type":"text","text":" "},{"type":"text","text":"use. Its value is a SMuFL canonical glyph name that starts with lyrics. The SMuFL attribute is ignored if the"},{"type":"text","text":" "},{"type":"text","text":"elision glyph is already specified by the text content. If neither text content nor a smufl attribute are"},{"type":"text","text":" "},{"type":"text","text":"present, the elision glyph is application-specific."}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLElision/!=(_:_:)":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLElision\/!=(_:_:)","type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlelision\/!=(_:_:)","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"!=","kind":"identifier"},{"text":" ","kind":"text"},{"text":"(","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"title":"!=(_:_:)","abstract":[],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"}}}