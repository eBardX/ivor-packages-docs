L canonical glyph name that starts with lyrics. The SMuFL attribute is ignored if the","type":"text"},{"text":" ","type":"text"},{"text":"elision glyph is already specified by the text content. If neither text content nor a smufl attribute are","type":"text"},{"text":" ","type":"text"},{"text":"present, the elision glyph is application-specific.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLElision/!=(_:_:)":{"url":"\/documentation\/ivormxl\/mxlelision\/!=(_:_:)","abstract":[],"kind":"symbol","title":"!=(_:_:)","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLElision\/!=(_:_:)","type":"topic","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"!=","kind":"identifier"},{"text":" ","kind":"text"},{"text":"(","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"role":"symbol"}}}