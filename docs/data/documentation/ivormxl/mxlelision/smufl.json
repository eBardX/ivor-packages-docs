text":" "},{"type":"text","text":"undertie (Unicode 203F). If the text content is empty, the smufl attribute is used to specify the symbol to"},{"type":"text","text":" "},{"type":"text","text":"use. Its value is a SMuFL canonical glyph name that starts with lyrics. The SMuFL attribute is ignored if the"},{"type":"text","text":" "},{"type":"text","text":"elision glyph is already specified by the text content. If neither text content nor a smufl attribute are"},{"type":"text","text":" "},{"type":"text","text":"present, the elision glyph is application-specific."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLElision"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLElision","url":"\/documentation\/ivormxl\/mxlelision"}}}