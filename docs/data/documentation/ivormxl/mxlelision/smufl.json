","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLSmuflLyricsGlyphName":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLSmuflLyricsGlyphName"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLSmuflLyricsGlyphName"}],"url":"\/documentation\/ivormxl\/mxlsmufllyricsglyphname","abstract":[{"type":"text","text":"The smufl-lyrics-glyph-name type is used to reference a specific Standard Music Font Layout (SMuFL) lyrics"},{"type":"text","text":" "},{"type":"text","text":"elision character. The value is a SMuFL canonical glyph name that starts with lyrics."}],"title":"MXLSmuflLyricsGlyphName","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSmuflLyricsGlyphName","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLElision":{"role":"symbol","navigatorTitle":[{"text":"MXLElision","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLElision","kind":"identifier"}],"kind":"symbol","title":"MXLElision","url":"\/documentation\/ivormxl\/mxlelision","type":"topic","abstract":[{"text":"The elision type represents an elision between lyric syllables. The text content specifies the symbol used to","type":"text"},{"text":" ","type":"text"},{"text":"display the elision. Common values are a no-break space (Unicode 00A0), an underscore (Unicode 005F), or an","type":"text"},{"text":" ","type":"text"},{"text":"undertie (Unicode 203F). If the text content is empty, the smufl attribute is used to specify the symbol to","type":"text"},{"text":" ","type":"text"},{"text":"use. Its value is a SMuFL canonical glyph name that starts with lyrics. The SMuFL attribute is ignored if the","type":"text"},{"text":" ","type":"text"},{"text":"elision glyph is already specified by the text content. If neither text content nor a smufl attribute are","type":"text"},{"text":" ","type":"text"},{"text":"present, the elision glyph is application-specific.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLElision"},"doc://IvorMXL/documentation/IvorMXL/MXLElision/smufl":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlelision\/smufl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLElision\/smufl","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"smufl","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL23MXLSmuflLyricsGlyphNameV","text":"MXLSmuflLyricsGlyphName","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"kind":"symbol","abstract":[{"text":"The SMuFL canonical glyph name used to specify the elision symbol when the text content is empty.","type":"text"}],"type":"topic","title":"smufl"}}}