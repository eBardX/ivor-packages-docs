{"kind":"symbol","hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"staffDetails","kind":"identifier"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:7IvorMXL15MXLStaffDetailsV","text":"MXLStaffDetails","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails"},{"text":"]","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Maps to nested MusicXML ","type":"text"},{"code":"<staff-details>","type":"codeVoice"},{"text":" elements.","type":"text"}]}]}],"variants":[{"paths":["\/documentation\/ivormxl\/mxlattributes\/staffdetails"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/staffDetails"},"sections":[],"metadata":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"staffDetails","kind":"identifier"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:7IvorMXL15MXLStaffDetailsV","text":"MXLStaffDetails","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"roleHeading":"Instance Property","title":"staffDetails","modules":[{"name":"IvorMXL"}],"role":"symbol","symbolKind":"property","externalID":"s:7IvorMXL13MXLAttributesV12staffDetailsSayAA08MXLStaffE0VGvp"},"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"type":"text","text":"The staff-details element is used to indicate different types of staves."}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLStaffDetails":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLStaffDetails","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails","title":"MXLStaffDetails","kind":"symbol","navigatorTitle":[{"text":"MXLStaffDetails","kind":"identifier"}],"abstract":[{"text":"The staff-details element is used to indicate different types of staves. The optional number attribute","type":"text"},{"text":" ","type":"text"},{"text":"specifies the staff number from top to bottom on the system, as with clef. The print-object attribute is used","type":"text"},{"text":" ","type":"text"},{"text":"to indicate when a staff is not printed in a part, usually in large scores where empty parts are omitted. It","type":"text"},{"text":" ","type":"text"},{"text":"is yes by default. If print-spacing is yes while print-object is no, the score is printed in cutaway format","type":"text"},{"text":" ","type":"text"},{"text":"where vertical space is left for the empty part.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlstaffdetails"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes":{"type":"topic","abstract":[{"type":"text","text":"The attributes element contains musical information that typically changes on measure boundaries. This"},{"text":" ","type":"text"},{"type":"text","text":"includes key and time signatures, clefs, transpositions, and staving. When attributes are changed mid-measure,"},{"type":"text","text":" "},{"type":"text","text":"it affects the music in score order, not in MusicXML document order."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLAttributes","kind":"identifier"}],"navigatorTitle":[{"text":"MXLAttributes","kind":"identifier"}],"title":"MXLAttributes","kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlattributes","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/staffDetails":{"title":"staffDetails","url":"\/documentation\/ivormxl\/mxlattributes\/staffdetails","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/staffDetails","abstract":[{"text":"The staff-details element is used to indicate different types of staves.","type":"text"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"staffDetails"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL15MXLStaffDetailsV","text":"MXLStaffDetails"},{"kind":"text","text":"]"}],"type":"topic"}}}