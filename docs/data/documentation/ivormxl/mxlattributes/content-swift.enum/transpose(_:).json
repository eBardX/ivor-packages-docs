":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes":{"type":"topic","abstract":[{"type":"text","text":"The attributes element contains musical information that typically changes on measure boundaries. This"},{"text":" ","type":"text"},{"type":"text","text":"includes key and time signatures, clefs, transpositions, and staving. When attributes are changed mid-measure,"},{"type":"text","text":" "},{"type":"text","text":"it affects the music in score order, not in MusicXML document order."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLAttributes","kind":"identifier"}],"navigatorTitle":[{"text":"MXLAttributes","kind":"identifier"}],"title":"MXLAttributes","kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlattributes","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/Content-swift.enum/transpose(_:)":{"kind":"symbol","title":"MXLAttributes.Content.transpose(_:)","role":"symbol","url":"\/documentation\/ivormxl\/mxlattributes\/content-swift.enum\/transpose(_:)","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"transpose","kind":"identifier"},{"text":"([","kind":"text"},{"text":"MXLTranspose","preciseIdentifier":"s:7IvorMXL12MXLTransposeV","kind":"typeIdentifier"},{"text":"])","kind":"text"}],"abstract":[{"type":"text","text":"If the part is being encoded for a transposing instrument in written vs. concert pitch, the transposition must"},{"type":"text","text":" "},{"type":"text","text":"be encoded in the transpose element using the transpose type."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/Content-swift.enum\/transpose(_:)","type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/Content-swift.enum":{"abstract":[{"type":"text","text":"One of the alternatives for Attributes."}],"identifier":"