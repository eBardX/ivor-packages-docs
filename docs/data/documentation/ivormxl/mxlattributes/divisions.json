{"abstract":[{"text":"Musical notation duration is commonly represented as fractions. The divisions element indicates how many","type":"text"},{"text":" ","type":"text"},{"text":"divisions per quarter note are used to indicate a note’s duration. For example, if duration = 1 and divisions","type":"text"},{"text":" ","type":"text"},{"text":"= 2, this is an eighth note duration. Duration and divisions are used directly for generating sound output, so","type":"text"},{"text":" ","type":"text"},{"text":"they must be chosen to take tuplets into account. Using a divisions element lets us use just one number to","type":"text"},{"text":" ","type":"text"},{"text":"represent a duration for each note in the score, while retaining the full power of a fractional","type":"text"},{"text":" ","type":"text"},{"text":"representation. If maximum compatibility with Standard MIDI 1.0 files is important, do not have the divisions","type":"text"},{"text":" ","type":"text"},{"text":"value exceed 16383.","type":"text"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"divisions","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLPositiveDivisions","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL20MXLPositiveDivisionsV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPositiveDivisions"},{"text":"?","kind":"text"}]}]},{"kind":"content","content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"inlineContent":[{"text":"Maps to a nested MusicXML ","type":"text"},{"code":"<divisions>","type":"codeVoice"},{"text":" element.","type":"text"}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes"]]},"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/divisions","interfaceLanguage":"swift"},"metadata":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"divisions","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLPositiveDivisions","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL20MXLPositiveDivisionsV"},{"text":"?","kind":"text"}],"role":"symbol","roleHeading":"Instance Property","title":"divisions","externalID":"s:7IvorMXL13MXLAttributesV9divisionsAA20MXLPositiveDivisionsVSgvp","symbolKind":"property","modules":[{"name":"IvorMXL"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlattributes\/divisions"]}],"sections":[],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/divisions":{"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"divisions"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL20MXLPositiveDivisionsV","text":"MXLPositiveDivisions"},{"kind":"text","text":"?"}],"abstract":[{"text":"Musical notation duration is commonly represented as fractions. The divisions element indicates how many","type":"text"},{"text":" ","type":"text"},{"text":"divisions per quarter note are used to indicate a note’s duration. For example, if duration = 1 and divisions","type":"text"},{"text":" ","type":"text"},{"text":"= 2, this is an eighth note duration. Duration and divisions are used directly for generating sound output, so","type":"text"},{"text":" ","type":"text"},{"text":"they must be chosen to take tuplets into account. Using a divisions element lets us use just one number to","type":"text"},{"text":" ","type":"text"},{"text":"represent a duration for each note in the score, while retaining the full power of a fractional","type":"text"},{"text":" ","type":"text"},{"text":"representation. If maximum compatibility with Standard MIDI 1.0 files is important, do not have the divisions","type":"text"},{"text":" ","type":"text"},{"text":"value exceed 16383.","type":"text"}],"role":"symbol","url":"\/documentation\/ivormxl\/mxlattributes\/divisions","type":"topic","kind":"symbol","title":"divisions","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/divisions"},"doc://IvorMXL/documentation/IvorMXL/MXLPositiveDivisions":{"type":"topic","title":"MXLPositiveDivisions","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPositiveDivisions","abstract":[{"type":"text","text":"The positive-divisions type restricts divisions values to positive numbers."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPositiveDivisions"}],"navigatorTitle":[{"kind":"identifier","text":"MXLPositiveDivisions"}],"url":"\/documentation\/ivormxl\/mxlpositivedivisions"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes":{"type":"topic","title":"MXLAttributes","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes","abstract":[{"text":"The attributes element contains musical information that typically changes on measure boundaries. This","type":"text"},{"text":" ","type":"text"},{"text":"includes key and time signatures, clefs, transpositions, and staving. When attributes are changed mid-measure,","type":"text"},{"text":" ","type":"text"},{"text":"it affects the music in score order, not in MusicXML document order.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLAttributes"}],"navigatorTitle":[{"kind":"identifier","text":"MXLAttributes"}],"url":"\/documentation\/ivormxl\/mxlattributes"}}}