{"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"let"},{"text":" ","kind":"text"},{"text":"divisions","kind":"identifier"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLPositiveDivisions","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPositiveDivisions","preciseIdentifier":"s:7IvorMXL20MXLPositiveDivisionsV"},{"kind":"text","text":"?"}]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"inlineContent":[{"type":"text","text":"Maps to a nested MusicXML "},{"code":"<divisions>","type":"codeVoice"},{"type":"text","text":" element."}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"text":"Musical notation duration is commonly represented as fractions. The divisions element indicates how many","type":"text"},{"text":" ","type":"text"},{"text":"divisions per quarter note are used to indicate a note’s duration. For example, if duration = 1 and divisions","type":"text"},{"text":" ","type":"text"},{"text":"= 2, this is an eighth note duration. Duration and divisions are used directly for generating sound output, so","type":"text"},{"text":" ","type":"text"},{"text":"they must be chosen to take tuplets into account. Using a divisions element lets us use just one number to","type":"text"},{"text":" ","type":"text"},{"text":"represent a duration for each note in the score, while retaining the full power of a fractional","type":"text"},{"text":" ","type":"text"},{"text":"representation. If maximum compatibility with Standard MIDI 1.0 files is important, do not have the divisions","type":"text"},{"text":" ","type":"text"},{"text":"value exceed 16383.","type":"text"}],"metadata":{"modules":[{"name":"IvorMXL"}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"divisions"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL20MXLPositiveDivisionsV","kind":"typeIdentifier","text":"MXLPositiveDivisions"},{"kind":"text","text":"?"}],"externalID":"s:7IvorMXL13MXLAttributesV9divisionsAA20MXLPositiveDivisionsVSgvp","role":"symbol","roleHeading":"Instance Property","title":"divisions","symbolKind":"property"},"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"paths":["\/documentation\/ivormxl\/mxlattributes\/divisions"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/divisions","interfaceLanguage":"swift"},"sections":[],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes"]]},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLPositiveDivisions":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPositiveDivisions","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"MXLPositiveDivisions","kind":"identifier"}],"abstract":[{"type":"text","text":"The positive-divisions type restricts divisions values to positive numbers."}],"url":"\/documentation\/ivormxl\/mxlpositivedivisions","title":"MXLPositiveDivisions","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPositiveDivisions","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/divisions":{"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/divisions","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"divisions"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL20MXLPositiveDivisionsV","kind":"typeIdentifier","text":"MXLPositiveDivisions"},{"kind":"text","text":"?"}],"url":"\/documentation\/ivormxl\/mxlattributes\/divisions","title":"divisions","type":"topic","abstract":[{"type":"text","text":"Musical notation duration is commonly represented as fractions. The divisions element indicates how many"},{"type":"text","text":" "},{"type":"text","text":"divisions per quarter note are used to indicate a note’s duration. For example, if duration = 1 and divisions"},{"type":"text","text":" "},{"type":"text","text":"= 2, this is an eighth note duration. Duration and divisions are used directly for generating sound output, so"},{"type":"text","text":" "},{"type":"text","text":"they must be chosen to take tuplets into account. Using a divisions element lets us use just one number to"},{"type":"text","text":" "},{"type":"text","text":"represent a duration for each note in the score, while retaining the full power of a fractional"},{"type":"text","text":" "},{"type":"text","text":"representation. If maximum compatibility with Standard MIDI 1.0 files is important, do not have the divisions"},{"type":"text","text":" "},{"type":"text","text":"value exceed 16383."}]},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes":{"role":"symbol","navigatorTitle":[{"text":"MXLAttributes","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLAttributes","kind":"identifier"}],"kind":"symbol","title":"MXLAttributes","url":"\/documentation\/ivormxl\/mxlattributes","type":"topic","abstract":[{"text":"The attributes element contains musical information that typically changes on measure boundaries. This","type":"text"},{"text":" ","type":"text"},{"text":"includes key and time signatures, clefs, transpositions, and staving. When attributes are changed mid-measure,","type":"text"},{"text":" ","type":"text"},{"text":"it affects the music in score order, not in MusicXML document order.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes"}}}