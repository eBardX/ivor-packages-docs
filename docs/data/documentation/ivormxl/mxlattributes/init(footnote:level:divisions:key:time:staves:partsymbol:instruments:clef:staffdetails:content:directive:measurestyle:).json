{"kind":"symbol","abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLAttributes"},{"type":"text","text":"."}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"init","kind":"keyword"},{"text":"(","kind":"text"},{"text":"footnote","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL16MXLFormattedTextV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFormattedText","text":"MXLFormattedText","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"level","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL8MXLLevelV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLevel","text":"MXLLevel","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"divisions","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL20MXLPositiveDivisionsV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPositiveDivisions","text":"MXLPositiveDivisions","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"key","kind":"externalParam"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:7IvorMXL6MXLKeyV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLKey","text":"MXLKey","kind":"typeIdentifier"},{"text":"] = [], ","kind":"text"},{"text":"time","kind":"externalParam"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:7IvorMXL7MXLTimeV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTime","text":"MXLTime","kind":"typeIdentifier"},{"text":"] = [], ","kind":"text"},{"text":"staves","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"partSymbol","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL13MXLPartSymbolV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartSymbol","text":"MXLPartSymbol","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"instruments","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"clef","kind":"externalParam"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:7IvorMXL7MXLClefV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLClef","text":"MXLClef","kind":"typeIdentifier"},{"text":"] = [], ","kind":"text"},{"text":"staffDetails","kind":"externalParam"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:7IvorMXL15MXLStaffDetailsV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails","text":"MXLStaffDetails","kind":"typeIdentifier"},{"text":"] = [], ","kind":"text"},{"text":"content","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL13MXLAttributesV7ContentO","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/Content-swift.enum","text":"Content","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"directive","kind":"externalParam"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:7IvorMXL13MXLAttributesV9DirectiveV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/Directive-swift.struct","text":"Directive","kind":"typeIdentifier"},{"text":"] = [], ","kind":"text"},{"text":"measureStyle","kind":"externalParam"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:7IvorMXL15MXLMeasureStyleV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMeasureStyle","text":"MXLMeasureStyle","kind":"typeIdentifier"},{"text":"] = [])","kind":"text"}],"platforms":["macOS"]}]},{"kind":"parameters","parameters":[{"name":"footnote","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The footnote element specifies editorial information that appears in footnotes in the"},{"type":"text","text":" "},{"type":"text","text":"printed score. It is defined within a group due to its multiple uses within the"},{"type":"text","text":" "},{"type":"text","text":"MusicXML schema."}]}]},{"name":"level","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The level element specifies editorial information for different MusicXML elements. It"},{"type":"text","text":" "},{"type":"text","text":"is defined within a group due to its multiple uses within the MusicXML schema."}]}]},{"name":"divisions","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Musical notation duration is commonly represented as fractions. The divisions element"},{"type":"text","text":" "},{"type":"text","text":"indicates how many divisions per quarter note are used to indicate a note’s duration."},{"type":"text","text":" "},{"type":"text","text":"For example, if duration = 1 and divisions = 2, this is an eighth note duration."},{"type":"text","text":" "},{"type":"text","text":"Duration and divisions are used directly for generating sound output, so they must be"},{"type":"text","text":" "},{"type":"text","text":"chosen to take tuplets into account. Using a divisions element lets us use just one"},{"type":"text","text":" "},{"type":"text","text":"number to represent a duration for each note in the score, while retaining the full"},{"type":"text","text":" "},{"type":"text","text":"power of a fractional representation. If maximum compatibility with Standard MIDI 1.0"},{"type":"text","text":" "},{"type":"text","text":"files is important, do not have the divisions value exceed 16383."}]}]},{"name":"key","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The key element represents a key signature. Both traditional and non-traditional key"},{"type":"text","text":" "},{"type":"text","text":"signatures are supported. The optional number attribute refers to staff numbers. If"},{"type":"text","text":" "},{"type":"text","text":"absent, the key signature applies to all staves in the part."}]}]},{"name":"time","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Time signatures are represented by the beats element for the numerator and the"},{"type":"text","text":" "},{"type":"text","text":"beat-type element for the denominator."}]}]},{"name":"staves","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The staves element is used if there is more than one staff represented in the given"},{"type":"text","text":" "},{"type":"text","text":"part (e.g., 2 staves for typical piano parts). If absent, a value of 1 is assumed."},{"type":"text","text":" "},{"type":"text","text":"Staves are ordered from top to bottom in a part in numerical order, with staff 1"},{"type":"text","text":" "},{"type":"text","text":"above staff 2."}]}]},{"name":"partSymbol","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The part-symbol element indicates how a symbol for a multi-staff part is indicated in"},{"type":"text","text":" "},{"type":"text","text":"the score."}]}]},{"name":"instruments","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The instruments element is only used if more than one instrument is represented in"},{"type":"text","text":" "},{"type":"text","text":"the part (e.g., oboe I and II where they play together most of the time). If absent,"},{"type":"text","text":" "},{"type":"text","text":"a value of 1 is assumed."}]}]},{"name":"clef","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Clefs are represented by a combination of sign, line, and clef-octave-change"},{"type":"text","text":" "},{"type":"text","text":"elements."}]}]},{"name":"staffDetails","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The staff-details element is used to indicate different types of staves."}]}]},{"name":"content","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"One of the alternatives for Attributes."}]}]},{"name":"directive","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Directives are like directions, but can be grouped together with attributes for"},{"type":"text","text":" "},{"type":"text","text":"convenience. This is typically used for tempo markings at the beginning of a piece of"},{"type":"text","text":" "},{"type":"text","text":"music. This element was deprecated in Version 2.0 in favor of the direction element’s"},{"type":"text","text":" "},{"type":"text","text":"directive attribute. Language names come from ISO 639, with optional country subcodes"},{"type":"text","text":" "},{"type":"text","text":"from ISO 3166."}]}]},{"name":"measureStyle","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A measure-style indicates a special way to print partial to multiple measures within"},{"type":"text","text":" "},{"type":"text","text":"a part. This includes multiple rests over several measures, repeats of beats, single,"},{"type":"text","text":" "},{"type":"text","text":"or multiple measures, and use of slash notation."}]}]}]}],"variants":[{"paths":["\/documentation\/ivormxl\/mxlattributes\/init(footnote:level:divisions:key:time:staves:partsymbol:instruments:clef:staffdetails:content:directive:measurestyle:)"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"modules":[{"name":"IvorMXL"}],"symbolKind":"init","role":"symbol","roleHeading":"Initializer","title":"init(footnote:level:divisions:key:time:staves:partSymbol:instruments:clef:staffDetails:content:directive:measureStyle:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"footnote","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL16MXLFormattedTextV","text":"MXLFormattedText","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"level","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL8MXLLevelV","text":"MXLLevel","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"divisions","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL20MXLPositiveDivisionsV","text":"MXLPositiveDivisions","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"key","kind":"externalParam"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:7IvorMXL6MXLKeyV","text":"MXLKey","kind":"typeIdentifier"},{"text":"], ","kind":"text"},{"text":"time","kind":"externalParam"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:7IvorMXL7MXLTimeV","text":"MXLTime","kind":"typeIdentifier"},{"text":"], ","kind":"text"},{"text":"staves","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"partSymbol","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL13MXLPartSymbolV","text":"MXLPartSymbol","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"instruments","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"clef","kind":"externalParam"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:7IvorMXL7MXLClefV","text":"MXLClef","kind":"typeIdentifier"},{"text":"], ","kind":"text"},{"text":"staffDetails","kind":"externalParam"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:7IvorMXL15MXLStaffDetailsV","text":"MXLStaffDetails","kind":"typeIdentifier"},{"text":"], ","kind":"text"},{"text":"content","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL13MXLAttributesV7ContentO","text":"Content","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"directive","kind":"externalParam"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:7IvorMXL13MXLAttributesV9DirectiveV","text":"Directive","kind":"typeIdentifier"},{"text":"], ","kind":"text"},{"text":"measureStyle","kind":"externalParam"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:7IvorMXL15MXLMeasureStyleV","text":"MXLMeasureStyle","kind":"typeIdentifier"},{"text":"])","kind":"text"}],"externalID":"s:7IvorMXL13MXLAttributesV8footnote5level9divisions3key4time6staves10partSymbol11instruments4clef12staffDetails7content9directive12measureStyleAcA16MXLFormattedTextVSg_AA8MXLLevelVSgAA20MXLPositiveDivisionsVSgSayAA6MXLKeyVGSayAA7MXLTimeVGSiSgAA07MXLPartK0VSgA4_SayAA7MXLClefVGSayAA08MXLStaffO0VGAC7ContentOSayAC9DirectiveVGSayAA010MXLMeasureS0VGtcfc"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/init(footnote:level:divisions:key:time:staves:partSymbol:instruments:clef:staffDetails:content:directive:measureStyle:)"},"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLStaffDetails":{"type":"topic","abstract":[{"type":"text","text":"The staff-details element is used to indicate different types of staves. The optional number attribute"},{"type":"text","text":" "},{"type":"text","text":"specifies the staff number from top to bottom on the system, as with clef. The print-object attribute is used"},{"type":"text","text":" "},{"type":"text","text":"to indicate when a staff is not printed in a part, usually in large scores where empty parts are omitted. It"},{"type":"text","text":" "},{"type":"text","text":"is yes by default. If print-spacing is yes while print-object is no, the score is printed in cutaway format"},{"type":"text","text":" "},{"type":"text","text":"where vertical space is left for the empty part."}],"url":"\/documentation\/ivormxl\/mxlstaffdetails","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLStaffDetails"}],"kind":"symbol","title":"MXLStaffDetails","navigatorTitle":[{"kind":"identifier","text":"MXLStaffDetails"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLKey":{"type":"topic","abstract":[{"text":"The key type represents a key signature. Both traditional and non-traditional key signatures are supported.","type":"text"},{"text":" ","type":"text"},{"text":"The optional number attribute refers to staff numbers. If absent, the key signature applies to all staves in","type":"text"},{"text":" ","type":"text"},{"text":"the part. Key signatures appear at the start of each system unless the print-object attribute has been set to","type":"text"},{"text":" ","type":"text"},{"text":"“no”.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlkey","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLKey","kind":"identifier"}],"kind":"symbol","title":"MXLKey","navigatorTitle":[{"text":"MXLKey","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLKey","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLFormattedText":{"type":"topic","title":"MXLFormattedText","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFormattedText","abstract":[{"type":"text","text":"The formatted-text type represents a text element with text-formatting attributes."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFormattedText"}],"navigatorTitle":[{"kind":"identifier","text":"MXLFormattedText"}],"url":"\/documentation\/ivormxl\/mxlformattedtext"},"doc://IvorMXL/documentation/IvorMXL/MXLLevel":{"type":"topic","abstract":[{"type":"text","text":"The level type is used to specify editorial information for different MusicXML elements. The content contains"},{"type":"text","text":" "},{"type":"text","text":"identifying and\/or descriptive text about the editorial status of the parent element."}],"url":"\/documentation\/ivormxl\/mxllevel","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLLevel","kind":"identifier"}],"kind":"symbol","title":"MXLLevel","navigatorTitle":[{"text":"MXLLevel","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLevel","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/Directive-swift.struct":{"type":"topic","title":"MXLAttributes.Directive","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/Directive-swift.struct","abstract":[{"text":"Directives are like directions, but can be grouped together with attributes for convenience. This is typically","type":"text"},{"text":" ","type":"text"},{"text":"used for tempo markings at the beginning of a piece of music. This element was deprecated in Version 2.0 in","type":"text"},{"text":" ","type":"text"},{"text":"favor of the direction element’s directive attribute. Language names come from ISO 639, with optional country","type":"text"},{"text":" ","type":"text"},{"text":"subcodes from ISO 3166.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Directive"}],"navigatorTitle":[{"kind":"identifier","text":"Directive"}],"url":"\/documentation\/ivormxl\/mxlattributes\/directive-swift.struct"},"doc://IvorMXL/documentation/IvorMXL/MXLClef":{"type":"topic","title":"MXLClef","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLClef","abstract":[{"text":"Clefs are represented by a combination of sign, line, and clef-octave-change elements. The optional number","type":"text"},{"text":" ","type":"text"},{"text":"attribute refers to staff numbers within the part. A value of 1 is assumed if not present.","type":"text"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLClef","kind":"identifier"}],"navigatorTitle":[{"text":"MXLClef","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlclef"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/Content-swift.enum":{"title":"MXLAttributes.Content","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Content"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlattributes\/content-swift.enum","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Content"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/Content-swift.enum","abstract":[{"type":"text","text":"One of the alternatives for Attributes."}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes":{"type":"topic","title":"MXLAttributes","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes","abstract":[{"text":"The attributes element contains musical information that typically changes on measure boundaries. This","type":"text"},{"text":" ","type":"text"},{"text":"includes key and time signatures, clefs, transpositions, and staving. When attributes are changed mid-measure,","type":"text"},{"text":" ","type":"text"},{"text":"it affects the music in score order, not in MusicXML document order.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLAttributes"}],"navigatorTitle":[{"kind":"identifier","text":"MXLAttributes"}],"url":"\/documentation\/ivormxl\/mxlattributes"},"doc://IvorMXL/documentation/IvorMXL/MXLPartSymbol":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartSymbol","navigatorTitle":[{"text":"MXLPartSymbol","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlpartsymbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPartSymbol","kind":"identifier"}],"title":"MXLPartSymbol","abstract":[{"text":"The part-symbol type indicates how a symbol for a multi-staff part is indicated in the score; brace is the","type":"text"},{"text":" ","type":"text"},{"text":"default value. The top-staff and bottom-staff attributes are used when the brace does not extend across the","type":"text"},{"text":" ","type":"text"},{"text":"entire part. For example, in a 3-staff organ part, the top-staff will typically be 1 for the right hand, while","type":"text"},{"text":" ","type":"text"},{"text":"the bottom-staff will typically be 2 for the left hand. Staff 3 for the pedals is usually outside the brace.","type":"text"},{"text":" ","type":"text"},{"text":"By default, the presence of a part-symbol element that does not extend across the entire part also indicates a","type":"text"},{"text":" ","type":"text"},{"text":"corresponding change in the common barlines within a part.","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLPositiveDivisions":{"type":"topic","title":"MXLPositiveDivisions","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPositiveDivisions","abstract":[{"type":"text","text":"The positive-divisions type restricts divisions values to positive numbers."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPositiveDivisions"}],"navigatorTitle":[{"kind":"identifier","text":"MXLPositiveDivisions"}],"url":"\/documentation\/ivormxl\/mxlpositivedivisions"},"doc://IvorMXL/documentation/IvorMXL/MXLMeasureStyle":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMeasureStyle","navigatorTitle":[{"kind":"identifier","text":"MXLMeasureStyle"}],"url":"\/documentation\/ivormxl\/mxlmeasurestyle","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLMeasureStyle"}],"title":"MXLMeasureStyle","abstract":[{"type":"text","text":"A measure-style indicates a special way to print partial to multiple measures within a part. This includes"},{"type":"text","text":" "},{"type":"text","text":"multiple rests over several measures, repeats of beats, single, or multiple measures, and use of slash"},{"type":"text","text":" "},{"type":"text","text":"notation."}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/init(footnote:level:divisions:key:time:staves:partSymbol:instruments:clef:staffDetails:content:directive:measureStyle:)":{"url":"\/documentation\/ivormxl\/mxlattributes\/init(footnote:level:divisions:key:time:staves:partsymbol:instruments:clef:staffdetails:content:directive:measurestyle:)","kind":"symbol","abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLAttributes"},{"type":"text","text":"."}],"role":"symbol","title":"init(footnote:level:divisions:key:time:staves:partSymbol:instruments:clef:staffDetails:content:directive:measureStyle:)","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/init(footnote:level:divisions:key:time:staves:partSymbol:instruments:clef:staffDetails:content:directive:measureStyle:)","type":"topic","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"footnote"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLFormattedText","preciseIdentifier":"s:7IvorMXL16MXLFormattedTextV"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"level"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLLevel","preciseIdentifier":"s:7IvorMXL8MXLLevelV"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"divisions"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLPositiveDivisions","preciseIdentifier":"s:7IvorMXL20MXLPositiveDivisionsV"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"key"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"MXLKey","preciseIdentifier":"s:7IvorMXL6MXLKeyV"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"time"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"MXLTime","preciseIdentifier":"s:7IvorMXL7MXLTimeV"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"staves"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"partSymbol"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLPartSymbol","preciseIdentifier":"s:7IvorMXL13MXLPartSymbolV"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"instruments"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"clef"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"MXLClef","preciseIdentifier":"s:7IvorMXL7MXLClefV"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"staffDetails"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"MXLStaffDetails","preciseIdentifier":"s:7IvorMXL15MXLStaffDetailsV"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"content"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Content","preciseIdentifier":"s:7IvorMXL13MXLAttributesV7ContentO"},{"kind":"text","text":", "},{"kind":"externalParam","text":"directive"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"Directive","preciseIdentifier":"s:7IvorMXL13MXLAttributesV9DirectiveV"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"measureStyle"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"MXLMeasureStyle","preciseIdentifier":"s:7IvorMXL15MXLMeasureStyleV"},{"kind":"text","text":"])"}]},"doc://IvorMXL/documentation/IvorMXL/MXLTime":{"title":"MXLTime","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTime"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxltime","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLTime"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTime","abstract":[{"type":"text","text":"Time signatures are represented by the beats element for the numerator and the beat-type element for the"},{"type":"text","text":" "},{"type":"text","text":"denominator. The symbol attribute is used to indicate common and cut time symbols as well as a single number"},{"type":"text","text":" "},{"type":"text","text":"display. Multiple pairs of beat and beat-type elements are used for composite time signatures with multiple"},{"type":"text","text":" "},{"type":"text","text":"denominators, such as 2\/4 + 3\/8. A composite such as 3+2\/8 requires only one beat\/beat-type pair."}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"}}}