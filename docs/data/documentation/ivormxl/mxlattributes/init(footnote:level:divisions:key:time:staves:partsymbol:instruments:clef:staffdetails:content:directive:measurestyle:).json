{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"footnote"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL16MXLFormattedTextV","kind":"typeIdentifier","text":"MXLFormattedText","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFormattedText"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"level"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL8MXLLevelV","kind":"typeIdentifier","text":"MXLLevel","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLevel"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"divisions"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL20MXLPositiveDivisionsV","kind":"typeIdentifier","text":"MXLPositiveDivisions","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPositiveDivisions"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"key"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:7IvorMXL6MXLKeyV","kind":"typeIdentifier","text":"MXLKey","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLKey"},{"kind":"text","text":"] = [], "},{"kind":"externalParam","text":"time"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:7IvorMXL7MXLTimeV","kind":"typeIdentifier","text":"MXLTime","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTime"},{"kind":"text","text":"] = [], "},{"kind":"externalParam","text":"staves"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"partSymbol"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL13MXLPartSymbolV","kind":"typeIdentifier","text":"MXLPartSymbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartSymbol"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"instruments"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"clef"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:7IvorMXL7MXLClefV","kind":"typeIdentifier","text":"MXLClef","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLClef"},{"kind":"text","text":"] = [], "},{"kind":"externalParam","text":"staffDetails"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:7IvorMXL15MXLStaffDetailsV","kind":"typeIdentifier","text":"MXLStaffDetails","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails"},{"kind":"text","text":"] = [], "},{"kind":"externalParam","text":"content"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL13MXLAttributesV7ContentO","kind":"typeIdentifier","text":"Content","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/Content-swift.enum"},{"kind":"text","text":", "},{"kind":"externalParam","text":"directive"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:7IvorMXL13MXLAttributesV9DirectiveV","kind":"typeIdentifier","text":"Directive","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/Directive-swift.struct"},{"kind":"text","text":"] = [], "},{"kind":"externalParam","text":"measureStyle"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:7IvorMXL15MXLMeasureStyleV","kind":"typeIdentifier","text":"MXLMeasureStyle","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMeasureStyle"},{"kind":"text","text":"] = [])"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"parameters","parameters":[{"name":"footnote","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The footnote element specifies editorial information that appears in footnotes in the printed score. It is defined within a group due to its multiple uses within the MusicXML schema."}]}]},{"name":"level","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The level element specifies editorial information for different MusicXML elements. It is defined within a group due to its multiple uses within the MusicXML schema."}]}]},{"name":"divisions","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Musical notation duration is commonly represented as fractions. The divisions element indicates how many divisions per quarter note are used to indicate a note’s duration. For example, if duration = 1 and divisions = 2, this is an eighth note duration. Duration and divisions are used directly for generating sound output, so they must be chosen to take tuplets into account. Using a divisions element lets us use just one number to represent a duration for each note in the score, while retaining the full power of a fractional representation. If maximum compatibility with Standard MIDI 1.0 files is important, do not have the divisions value exceed 16383."}]}]},{"name":"key","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The key element represents a key signature. Both traditional and non-traditional key signatures are supported. The optional number attribute refers to staff numbers. If absent, the key signature applies to all staves in the part."}]}]},{"name":"time","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Time signatures are represented by the beats element for the numerator and the beat-type element for the denominator."}]}]},{"name":"staves","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The staves element is used if there is more than one staff represented in the given part (e.g., 2 staves for typical piano parts). If absent, a value of 1 is assumed. Staves are ordered from top to bottom in a part in numerical order, with staff 1 above staff 2."}]}]},{"name":"partSymbol","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The part-symbol element indicates how a symbol for a multi-staff part is indicated in the score."}]}]},{"name":"instruments","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The instruments element is only used if more than one instrument is represented in the part (e.g., oboe I and II where they play together most of the time). If absent, a value of 1 is assumed."}]}]},{"name":"clef","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Clefs are represented by a combination of sign, line, and clef-octave-change elements."}]}]},{"name":"staffDetails","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The staff-details element is used to indicate different types of staves."}]}]},{"name":"content","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"One of the alternatives for Attributes."}]}]},{"name":"directive","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Directives are like directions, but can be grouped together with attributes for convenience. This is typically used for tempo markings at the beginning of a piece of music. This element was deprecated in Version 2.0 in favor of the direction element’s directive attribute. Language names come from ISO 639, with optional country subcodes from ISO 3166."}]}]},{"name":"measureStyle","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A measure-style indicates a special way to print partial to multiple measures within a part. This includes multiple rests over several measures, repeats of beats, single, or multiple measures, and use of slash notation."}]}]}]}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/init(footnote:level:divisions:key:time:staves:partSymbol:instruments:clef:staffDetails:content:directive:measureStyle:)","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"title":"init(footnote:level:divisions:key:time:staves:partSymbol:instruments:clef:staffDetails:content:directive:measureStyle:)","externalID":"s:7IvorMXL13MXLAttributesV8footnote5level9divisions3key4time6staves10partSymbol11instruments4clef12staffDetails7content9directive12measureStyleAcA16MXLFormattedTextVSg_AA8MXLLevelVSgAA20MXLPositiveDivisionsVSgSayAA6MXLKeyVGSayAA7MXLTimeVGSiSgAA07MXLPartK0VSgA4_SayAA7MXLClefVGSayAA08MXLStaffO0VGAC7ContentOSayAC9DirectiveVGSayAA010MXLMeasureS0VGtcfc","fragments":[{"kind":"identifier","text":"init"},{"text":"(","kind":"text"},{"text":"footnote","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLFormattedText","preciseIdentifier":"s:7IvorMXL16MXLFormattedTextV","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"level","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLLevel","preciseIdentifier":"s:7IvorMXL8MXLLevelV","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"divisions","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLPositiveDivisions","preciseIdentifier":"s:7IvorMXL20MXLPositiveDivisionsV","kind":"typeIdentifier"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"key"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL6MXLKeyV","text":"MXLKey"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"time"},{"text":": [","kind":"text"},{"text":"MXLTime","preciseIdentifier":"s:7IvorMXL7MXLTimeV","kind":"typeIdentifier"},{"kind":"text","text":"], "},{"text":"staves","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"partSymbol","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLPartSymbol","preciseIdentifier":"s:7IvorMXL13MXLPartSymbolV","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"instruments","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"clef"},{"kind":"text","text":": ["},{"text":"MXLClef","preciseIdentifier":"s:7IvorMXL7MXLClefV","kind":"typeIdentifier"},{"text":"], ","kind":"text"},{"text":"staffDetails","kind":"externalParam"},{"text":": [","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL15MXLStaffDetailsV","text":"MXLStaffDetails"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"content"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL13MXLAttributesV7ContentO","text":"Content"},{"kind":"text","text":", "},{"kind":"externalParam","text":"directive"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL13MXLAttributesV9DirectiveV","text":"Directive"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"measureStyle"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL15MXLMeasureStyleV","text":"MXLMeasureStyle"},{"kind":"text","text":"])"}],"role":"symbol","roleHeading":"Initializer","modules":[{"name":"IvorMXL"}],"symbolKind":"init"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes"]]},"kind":"symbol","variants":[{"paths":["\/documentation\/ivormxl\/mxlattributes\/init(footnote:level:divisions:key:time:staves:partsymbol:instruments:clef:staffdetails:content:directive:measurestyle:)"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLAttributes"},{"type":"text","text":"."}],"sections":[],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLLevel":{"navigatorTitle":[{"text":"MXLLevel","kind":"identifier"}],"abstract":[{"type":"text","text":"The level type is used to specify editorial information for different MusicXML elements. The content contains"},{"type":"text","text":" "},{"type":"text","text":"identifying and\/or descriptive text about the editorial status of the parent element."}],"title":"MXLLevel","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLevel","kind":"symbol","url":"\/documentation\/ivormxl\/mxllevel","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLLevel","kind":"identifier"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/Directive-swift.struct":{"abstract":[{"text":"Directives are like directions, but can be grouped together with attributes for convenience. This is typically","type":"text"},{"text":" ","type":"text"},{"text":"used for tempo markings at the beginning of a piece of music. This element was deprecated in Version 2.0 in","type":"text"},{"text":" ","type":"text"},{"text":"favor of the direction element’s directive attribute. Language names come from ISO 639, with optional country","type":"text"},{"text":" ","type":"text"},{"text":"subcodes from ISO 3166.","type":"text"}],"title":"MXLAttributes.Directive","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Directive"}],"navigatorTitle":[{"kind":"identifier","text":"Directive"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlattributes\/directive-swift.struct","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/Directive-swift.struct"},"doc://IvorMXL/documentation/IvorMXL/MXLStaffDetails":{"abstract":[{"text":"The staff-details element is used to indicate different types of staves. The optional number attribute","type":"text"},{"text":" ","type":"text"},{"text":"specifies the staff number from top to bottom on the system, as with clef. The print-object attribute is used","type":"text"},{"text":" ","type":"text"},{"text":"to indicate when a staff is not printed in a part, usually in large scores where empty parts are omitted. It","type":"text"},{"text":" ","type":"text"},{"text":"is yes by default. If print-spacing is yes while print-object is no, the score is printed in cutaway format","type":"text"},{"text":" ","type":"text"},{"text":"where vertical space is left for the empty part.","type":"text"}],"title":"MXLStaffDetails","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLStaffDetails","kind":"identifier"}],"navigatorTitle":[{"text":"MXLStaffDetails","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlstaffdetails","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails"},"doc://IvorMXL/documentation/IvorMXL/MXLClef":{"abstract":[{"text":"Clefs are represented by a combination of sign, line, and clef-octave-change elements. The optional number","type":"text"},{"text":" ","type":"text"},{"text":"attribute refers to staff numbers within the part. A value of 1 is assumed if not present.","type":"text"}],"title":"MXLClef","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLClef"}],"navigatorTitle":[{"kind":"identifier","text":"MXLClef"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlclef","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLClef"},"doc://IvorMXL/documentation/IvorMXL/MXLMeasureStyle":{"title":"MXLMeasureStyle","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLMeasureStyle","kind":"identifier"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlmeasurestyle","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMeasureStyle","abstract":[{"type":"text","text":"A measure-style indicates a special way to print partial to multiple measures within a part. This includes"},{"type":"text","text":" "},{"type":"text","text":"multiple rests over several measures, repeats of beats, single, or multiple measures, and use of slash"},{"type":"text","text":" "},{"type":"text","text":"notation."}],"navigatorTitle":[{"text":"MXLMeasureStyle","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/init(footnote:level:divisions:key:time:staves:partSymbol:instruments:clef:staffDetails:content:directive:measureStyle:)":{"url":"\/documentation\/ivormxl\/mxlattributes\/init(footnote:level:divisions:key:time:staves:partsymbol:instruments:clef:staffdetails:content:directive:measurestyle:)","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/init(footnote:level:divisions:key:time:staves:partSymbol:instruments:clef:staffDetails:content:directive:measureStyle:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"footnote","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL16MXLFormattedTextV","text":"MXLFormattedText","kind":"typeIdentifier"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"level"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL8MXLLevelV","kind":"typeIdentifier","text":"MXLLevel"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"divisions"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL20MXLPositiveDivisionsV","kind":"typeIdentifier","text":"MXLPositiveDivisions"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"key"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:7IvorMXL6MXLKeyV","kind":"typeIdentifier","text":"MXLKey"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"time"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:7IvorMXL7MXLTimeV","kind":"typeIdentifier","text":"MXLTime"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"staves"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"partSymbol"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL13MXLPartSymbolV","kind":"typeIdentifier","text":"MXLPartSymbol"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"instruments"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"clef","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"MXLClef","preciseIdentifier":"s:7IvorMXL7MXLClefV","kind":"typeIdentifier"},{"text":"], ","kind":"text"},{"text":"staffDetails","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"MXLStaffDetails","preciseIdentifier":"s:7IvorMXL15MXLStaffDetailsV","kind":"typeIdentifier"},{"text":"], ","kind":"text"},{"text":"content","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Content","preciseIdentifier":"s:7IvorMXL13MXLAttributesV7ContentO","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"directive","kind":"externalParam"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:7IvorMXL13MXLAttributesV9DirectiveV","text":"Directive","kind":"typeIdentifier"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"measureStyle"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:7IvorMXL15MXLMeasureStyleV","kind":"typeIdentifier","text":"MXLMeasureStyle"},{"kind":"text","text":"])"}],"title":"init(footnote:level:divisions:key:time:staves:partSymbol:instruments:clef:staffDetails:content:directive:measureStyle:)","abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLAttributes"},{"type":"text","text":"."}],"type":"topic","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLKey":{"kind":"symbol","navigatorTitle":[{"text":"MXLKey","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlkey","title":"MXLKey","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLKey","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLKey","abstract":[{"text":"The key type represents a key signature. Both traditional and non-traditional key signatures are supported.","type":"text"},{"text":" ","type":"text"},{"text":"The optional number attribute refers to staff numbers. If absent, the key signature applies to all staves in","type":"text"},{"text":" ","type":"text"},{"text":"the part. Key signatures appear at the start of each system unless the print-object attribute has been set to","type":"text"},{"text":" ","type":"text"},{"text":"“no”.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/Content-swift.enum":{"navigatorTitle":[{"text":"Content","kind":"identifier"}],"abstract":[{"type":"text","text":"One of the alternatives for Attributes."}],"title":"MXLAttributes.Content","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/Content-swift.enum","kind":"symbol","url":"\/documentation\/ivormxl\/mxlattributes\/content-swift.enum","type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Content","kind":"identifier"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes":{"abstract":[{"text":"The attributes element contains musical information that typically changes on measure boundaries. This","type":"text"},{"text":" ","type":"text"},{"text":"includes key and time signatures, clefs, transpositions, and staving. When attributes are changed mid-measure,","type":"text"},{"text":" ","type":"text"},{"text":"it affects the music in score order, not in MusicXML document order.","type":"text"}],"title":"MXLAttributes","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLAttributes"}],"navigatorTitle":[{"kind":"identifier","text":"MXLAttributes"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlattributes","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes"},"doc://IvorMXL/documentation/IvorMXL/MXLPartSymbol":{"title":"MXLPartSymbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPartSymbol","kind":"identifier"}],"kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxlpartsymbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartSymbol","abstract":[{"text":"The part-symbol type indicates how a symbol for a multi-staff part is indicated in the score; brace is the","type":"text"},{"text":" ","type":"text"},{"text":"default value. The top-staff and bottom-staff attributes are used when the brace does not extend across the","type":"text"},{"text":" ","type":"text"},{"text":"entire part. For example, in a 3-staff organ part, the top-staff will typically be 1 for the right hand, while","type":"text"},{"text":" ","type":"text"},{"text":"the bottom-staff will typically be 2 for the left hand. Staff 3 for the pedals is usually outside the brace.","type":"text"},{"text":" ","type":"text"},{"text":"By default, the presence of a part-symbol element that does not extend across the entire part also indicates a","type":"text"},{"text":" ","type":"text"},{"text":"corresponding change in the common barlines within a part.","type":"text"}],"navigatorTitle":[{"text":"MXLPartSymbol","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLTime":{"abstract":[{"type":"text","text":"Time signatures are represented by the beats element for the numerator and the beat-type element for the"},{"type":"text","text":" "},{"type":"text","text":"denominator. The symbol attribute is used to indicate common and cut time symbols as well as a single number"},{"text":" ","type":"text"},{"text":"display. Multiple pairs of beat and beat-type elements are used for composite time signatures with multiple","type":"text"},{"text":" ","type":"text"},{"text":"denominators, such as 2\/4 + 3\/8. A composite such as 3+2\/8 requires only one beat\/beat-type pair.","type":"text"}],"title":"MXLTime","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTime","kind":"identifier"}],"navigatorTitle":[{"text":"MXLTime","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxltime","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTime"},"doc://IvorMXL/documentation/IvorMXL/MXLPositiveDivisions":{"title":"MXLPositiveDivisions","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPositiveDivisions"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlpositivedivisions","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPositiveDivisions","abstract":[{"text":"The positive-divisions type restricts divisions values to positive numbers.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"MXLPositiveDivisions"}]},"doc://IvorMXL/documentation/IvorMXL/MXLFormattedText":{"navigatorTitle":[{"text":"MXLFormattedText","kind":"identifier"}],"abstract":[{"type":"text","text":"The formatted-text type represents a text element with text-formatting attributes."}],"title":"MXLFormattedText","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFormattedText","kind":"symbol","url":"\/documentation\/ivormxl\/mxlformattedtext","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLFormattedText","kind":"identifier"}],"role":"symbol"}}}