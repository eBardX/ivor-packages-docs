{"abstract":[{"text":"The part-symbol element indicates how a symbol for a multi-staff part is indicated in the score.","type":"text"}],"metadata":{"modules":[{"name":"IvorMXL"}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"partSymbol","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLPartSymbol","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL13MXLPartSymbolV"},{"text":"?","kind":"text"}],"roleHeading":"Instance Property","symbolKind":"property","role":"symbol","externalID":"s:7IvorMXL13MXLAttributesV10partSymbolAA07MXLPartE0VSgvp","title":"partSymbol"},"variants":[{"paths":["\/documentation\/ivormxl\/mxlattributes\/partsymbol"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"partSymbol","kind":"identifier"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartSymbol","text":"MXLPartSymbol","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL13MXLPartSymbolV"},{"text":"?","kind":"text"}]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"inlineContent":[{"text":"Maps to a nested MusicXML ","type":"text"},{"type":"codeVoice","code":"<part-symbol>"},{"text":" element.","type":"text"}],"type":"paragraph"}]}],"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/partSymbol"},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/partSymbol":{"abstract":[{"text":"The part-symbol element indicates how a symbol for a multi-staff part is indicated in the score.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlattributes\/partsymbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"partSymbol","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLPartSymbol","preciseIdentifier":"s:7IvorMXL13MXLPartSymbolV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/partSymbol","role":"symbol","title":"partSymbol","type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLPartSymbol":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlpartsymbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartSymbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPartSymbol","kind":"identifier"}],"abstract":[{"type":"text","text":"The part-symbol type indicates how a symbol for a multi-staff part is indicated in the score; brace is the"},{"type":"text","text":" "},{"type":"text","text":"default value. The top-staff and bottom-staff attributes are used when the brace does not extend across the"},{"type":"text","text":" "},{"type":"text","text":"entire part. For example, in a 3-staff organ part, the top-staff will typically be 1 for the right hand, while"},{"type":"text","text":" "},{"type":"text","text":"the bottom-staff will typically be 2 for the left hand. Staff 3 for the pedals is usually outside the brace."},{"type":"text","text":" "},{"type":"text","text":"By default, the presence of a part-symbol element that does not extend across the entire part also indicates a"},{"type":"text","text":" "},{"type":"text","text":"corresponding change in the common barlines within a part."}],"kind":"symbol","type":"topic","navigatorTitle":[{"text":"MXLPartSymbol","kind":"identifier"}],"title":"MXLPartSymbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes":{"role":"symbol","navigatorTitle":[{"text":"MXLAttributes","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLAttributes","kind":"identifier"}],"kind":"symbol","title":"MXLAttributes","url":"\/documentation\/ivormxl\/mxlattributes","type":"topic","abstract":[{"text":"The attributes element contains musical information that typically changes on measure boundaries. This","type":"text"},{"text":" ","type":"text"},{"text":"includes key and time signatures, clefs, transpositions, and staving. When attributes are changed mid-measure,","type":"text"},{"text":" ","type":"text"},{"text":"it affects the music in score order, not in MusicXML document order.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes"}}}