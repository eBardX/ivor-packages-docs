bstract":[{"type":"text","text":"Directives are like directions, but can be grouped together with attributes for convenience. This is typically"},{"type":"text","text":" "},{"type":"text","text":"used for tempo markings at the beginning of a piece of music. This element was deprecated in Version 2.0 in"},{"type":"text","text":" "},{"type":"text","text":"favor of the direction element’s directive attribute. Language names come from ISO 639, with optional country"},{"type":"text","text":" "},{"type":"text","text":"subcodes from ISO 3166."}],"type":"topic","title":"MXLAttributes.Directive","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/Directive-swift.struct/color":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/Directive-swift.struct\/color","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"color"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL8MXLColorV","kind":"typeIdentifier","text":"MXLColor"},{"kind":"text","text":"?"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlattributes\/directive-swift.struct\/color","kind":"symbol","title":"color","abstract":[{"type":"text","text":"The color attribute group indicates the color of an element."}]},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes":{"title":"MXLAttributes","url":"\/documentation\/ivormxl\/mxlattributes","abstract":[{"type":"text","text":"The attributes element contains musical information that typically changes on measure boundaries. This"},{"type":"text","text":" "},{"type":"text","text":"includes key and time signatures, clefs, transpositions, and staving. When attributes are changed mid-measure,"},{"type":"text","text":" "},{"type":"text","text":"it affects the music in score order, not in MusicXML document order."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLAttributes","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"MXLAttributes","kind":"identifier"}],"type":"topic","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlcolor","title":"MXLColor","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"type":"text","text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is"},{"type":"text","text":" "},{"type":"text","text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor"}}}