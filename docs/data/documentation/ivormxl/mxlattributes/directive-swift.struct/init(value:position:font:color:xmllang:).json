ctions":[{"declarations":[{"tokens":[{"kind":"keyword","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"value"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam","text":"position"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","text":"MXLPosition","preciseIdentifier":"s:7IvorMXL11MXLPositionV"},{"kind":"text","text":" = MXLPosition(), "},{"kind":"externalParam","text":"font"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","text":"MXLFont","preciseIdentifier":"s:7IvorMXL7MXLFontV"},{"kind":"text","text":" = MXLFont(), "},{"kind":"externalParam","text":"color"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","text":"MXLColor","preciseIdentifier":"s:7IvorMXL8MXLColorV"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"xmlLang"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"? = nil)"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"content":[{"inlineContent":[{"text":"The value of this element.","type":"text"}],"type":"paragraph"}],"name":"value"},{"content":[{"inlineContent":[{"text":"For most elements, any program will compute a default x and y position. The position attributes let this be changed two ways.","type":"text"}],"type":"paragraph"}],"name":"position"},{"content":[{"inlineContent":[{"text":"The font attribute group gathers together attributes for determining the font within a credit or direction. They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font vs. a music font.","type":"text"}],"type":"paragraph"}],"name":"font"},{"content":[{"inlineContent":[{"text":"The color attribute group indicates the color of an element.","type":"text"}],"type":"paragraph"}],"name":"color"},{"content":[{"inlineContent":[{"text":"The xml:lang attribute value.","type":"text"}],"type":"paragraph"}],"name":"xmlLang"}],"kind":"parameters"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLColor","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","title":"MXLColor","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlcolor"},"doc://IvorMXL/documentation/IvorMXL/MXLFont":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLFont"}],"abstract":[{"text":"The font attribute group gathers together attributes for determining the font within a credit or direction.","type":"text"},{"text":" ","type":"text"},{"text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of","type":"text"},{"text":" ","type":"text"},{"text":"font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric","type":"text"},{"text":" ","type":"text"},{"text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font","type":"text"},{"text":" ","type":"text"},{"text":"vs. a music font.","type":"text"}],"kind":"symbol","title":"MXLFont","url":"\/documentation\/ivormxl\/mxlfont","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFont"}]},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes":{"type":"topic","abstract":[{"type":"text","text":"The attributes element contains musical information that typically changes on measure boundaries. This"},{"text":" ","type":"text"},{"type":"text","text":"includes key and time signatures, clefs, transpositions, and staving. When attributes are changed mid-measure,"},{"type":"text","text":" "},{"type":"text","text":"it affects the music in score order, not in MusicXML document order."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLAttributes","kind":"identifier"}],"navigatorTitle":[{"text":"MXLAttributes","kind":"identifier"}],"title":"MXLAttributes","kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlattributes","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes"},"doc://IvorMXL/documentation/IvorMXL/MXLPosition":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLPosition"}],"abstract":[{"text":"For most elements, any program will compute a default x and y position. The position attributes let this be","type":"text"},{"text":" ","type":"text"},{"text":"changed two ways.","type":"text"}],"kind":"symbol","title":"MXLPosition","url":"\/documentation\/ivormxl\/mxlposition","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPosition"}]},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/Directive-swift.struct":{"type":"topic","abstract":[{"type":"text","text":"Directives are like directions, but can be grouped together with attributes for convenience. This is typically"},{"type":"text","text":" "},{"type":"text","text":"used for tempo markings at the beginning of a piece of music. This element was deprecated in Version 2.0 in"},{"type":"text","text":" "},{"type":"text","text":"favor of the direction element’s directive attribute. Language names come from ISO 639, with optional country"},{"type":"text","text":" "},{"type":"text","text":"subcodes from ISO 3166."}],"kind":"symbol","role":"symbol","navigatorTitle":[{"text":"Directive","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes\/Directive-swift.struct","title":"MXLAttributes.Directive","url":"\/documentation\/ivormxl\/mxlattributes\/directive-swift.struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Directive","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes/Directive-swift.struct/init(value:position:font:color:xmlLang:)":{"abstract":[{"text":"Creates a new ","type":"text"},{"code":"MXLAttributes.Directive","type":"codeVoice"},{"text":".","type":"text"}],"type":"topic","title":"init(value:position:font:color:xmlLang:)","kind":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"value"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"position"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL11MXLPositionV","kind":"typeIdentifier","text":"MXLPosition"},{"kind":"text","text":", "},{"kind":"externalParam","text":"font"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL7MXLFontV","kind":"typeIdentifier","text":"MXLFont"},{"kind":"text","text":", "},{"kind":"externalParam","text":"c