mbol","fragments":[{"kind":"keyword","text":"case"},{"text":" ","kind":"text"},{"text":"quarterFlat","kind":"identifier"}],"title":"MXLAccidentalValue.quarterFlat"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLAccidentalValue":{"title":"MXLAccidentalValue","url":"\/documentation\/ivormxl\/mxlaccidentalvalue","role":"symbol","navigatorTitle":[{"text":"MXLAccidentalValue","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidentalValue","kind":"symbol","abstract":[{"type":"text","text":"The accidental-value type represents notated accidentals supported by MusicXML. In the MusicXML 2.0 DTD this"},{"type":"text","text":" "},{"type":"text","text":"was a string with values that could be included. The XSD strengthens the data typing to an enumerated list."},{"type":"text","text":" "},{"type":"text","text":"The quarter- and three-quarters- accidentals are Tartini-style quarter-tone accidentals. The -down and -up"},{"type":"text","text":" "},{"type":"text","text":"accidentals are quarter-tone accidentals that include arrows pointing down or up. The slash- accidentals are"},{"type":"text","text":" "},{"type":"text","text":"used in Turkish classical music. The numbered sharp and flat accidentals are superscripted versions of the"},{"type":"text","text":" "},{"type":"text","text":"accidental signs, used in Turkish folk music. The sori and koron accidentals are microtonal sharp and flat"},{"type":"text","text":" "},{"type":"text","text":"accidentals used in Iranian and Persian music. The other accidental covers accidentals other than those listed"},{"type":"text","text":" "},{"type":"text","text":"here. It is usually used in combination with the smufl attribute to specify a particular SMuFL accidental. The"},{"type":"text","text":" "},{"type":"text","text":"smufl attribute may be used with any accidental value to help specify the appearance of symbols that share the"},{"type":"text","text":" "},{"type":"text","text":"same MusicXML semantics."}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLAccidentalValue","kind":"identifier"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLAccidentalValue/sharpSharp":{"kind":"symbol","abstract":[{"type":"text","text":"A double sharp accidental notated as two sharp signs."}],"type":"topic","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sharpSharp","kind":"identifier"}],"role":"symbol","url":"\/documentation\/ivormxl\/mxlaccidentalvalue\/sharpsharp","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidentalValue\/sharpSharp","title":"MXLAccidentalValue.sharpSharp"},"doc://IvorMXL/documentation/IvorMXL/MXLAccidentalValue/flat2":{"url":"\/documentation\/ivormxl\/mxlaccidentalvalue\/flat2","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidentalValue\/flat2","abstract":[{"text":"A superscripted flat accidental with a numeral 2, used in Turkish folk music.","type":"text"}],"title":"MXLAccidentalValue.flat2","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"flat2"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLAccidentalValue/doubleSharpDown":{"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"doubleSharpDown"}],"role":"symbol","title":"MXLAccidentalValue.doubleSharpDown","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidentalValue\/doubleSharpDown","url":"\/documentation\/ivormxl\/mxlaccidentalvalue\/doublesharpdown","type":"topic","abstract":[{"type":"text","text":"A double sharp accidental with an arrow pointing down."}],"kind":"symbol"},