 in Turkish classical music. The numbered sharp and flat accidentals are superscripted versions of the","type":"text"},{"text":" ","type":"text"},{"text":"accidental signs, used in Turkish folk music. The sori and koron accidentals are microtonal sharp and flat","type":"text"},{"text":" ","type":"text"},{"text":"accidentals used in Iranian and Persian music. The other accidental covers accidentals other than those listed","type":"text"},{"text":" ","type":"text"},{"text":"here. It is usually used in combination with the smufl attribute to specify a particular SMuFL accidental. The","type":"text"},{"text":" ","type":"text"},{"text":"smufl attribute may be used with any accidental value to help specify the appearance of symbols that share the","type":"text"},{"text":" ","type":"text"},{"text":"same MusicXML semantics.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidentalValue","role":"symbol","navigatorTitle":[{"text":"MXLAccidentalValue","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlaccidentalvalue"},"doc://IvorMXL/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","identifier":"doc:\/\/IvorMXL\/s16SendableMetatypeP","type":"unresolvable"},"doc://IvorMXL/documentation/IvorMXL/MXLAccidentalValue/sharpUp":{"type":"topic","title":"MXLAccidentalValue.sharpUp","url":"\/documentation\/ivormxl\/mxlaccidentalvalue\/sharpup","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidentalValue\/sharpUp","role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sharpUp","kind":"identifier"}],"kind":"symbol","abstract":[{"type":"text","text":"A quarter-tone sharp accidental with an arrow pointing up."}]},"doc://IvorMXL/documentation/IvorMXL/MXLAccidentalValue/flat2":{"type":"topic","title":"MXLAccidentalValue.flat2","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidentalValue\/flat2","url":"\/documentation\/ivormxl\/mxlaccidentalvalue\/flat2","role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"flat2","kind":"identifier"}],"kind":"symbol","abstract":[{"type":"text","text":"A superscripted flat accidental with a numeral 2, used in Turkish folk music."}]},"doc://IvorMXL/documentation/IvorMXL/MXLAccidentalValue/doubleSharpDown":{"role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidentalValue\/doubleSharpDown","kind":"symbol","type":"topic","abstract":[{"text":"A double sharp accidental with an arrow pointing down.","type":"text"}],"title":"MXLAccidentalValue.doubleSharpDown","url":"\/documentation\/ivormxl\/mxlaccidentalvalue\/doublesharpdown","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"doubleSharpDown","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLAccidentalValue/flatFlatUp":{"role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidentalValue\/flatFlatUp","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"A double flat accidental with an arrow pointing up."}],"title":"MXLAccidentalValue.flatFlatUp","url":"\/documentation\/ivormxl\/mxlaccidentalvalue\/flatflatup","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"flatFlatUp","kind":"identifier"}]},"doc://IvorMXL/s8SendableP":{"type":"unresolvable","title":"Swift.Sendable","identifier":"doc:\/\/IvorMXL\/s8SendableP"},"doc://IvorMXL/documentation/IvorMXL/MXLAccidentalValue/doubleSharpUp":{"role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidentalValue\/doubleSharpUp","kind":"symbol","type":"topic","abstract":[{"text":"A double sharp accidental with an arrow pointing up.","type":"text"}],"title":"MXLAccidentalValue.doubleSharpUp","url":"\/documentation\/ivormxl\/mxlaccidentalvalue\/doublesharpup","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"doubleSharpUp","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLAccide