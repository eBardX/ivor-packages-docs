{"abstract":[{"text":"The link type serves as an outgoing simple XLink. If a relative link is used within a document that is part of","type":"text"},{"text":" ","type":"text"},{"text":"a compressed MusicXML file, the link is relative to the root folder of the zip file.","type":"text"}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLLink","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"text":"Maps the MusicXML ","type":"text"},{"code":"<link>","type":"codeVoice"},{"text":" element.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","sections":[],"relationshipsSections":[{"title":"Conforms To","type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/IvorMXL\/s8CopyableP","doc:\/\/IvorMXL\/SQ","doc:\/\/IvorMXL\/s9EscapableP","doc:\/\/IvorMXL\/SH","doc:\/\/IvorMXL\/s8SendableP","doc:\/\/IvorMXL\/s16SendableMetatypeP"]}],"topicSections":[{"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLink\/init(xlink:name:elementPosition:position:)"],"generated":true},{"anchor":"Instance-Properties","title":"Instance Properties","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLink\/elementPosition","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLink\/name","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLink\/position","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLink\/xlink"],"generated":true},{"title":"Default Implementations","anchor":"Default-Implementations","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLink\/Equatable-Implementations"],"generated":true}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLink"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"paths":["\/documentation\/ivormxl\/mxllink"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"modules":[{"name":"IvorMXL"}],"externalID":"s:7IvorMXL7MXLLinkV","roleHeading":"Structure","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLLink","kind":"identifier"}],"title":"MXLLink","symbolKind":"struct","navigatorTitle":[{"text":"MXLLink","kind":"identifier"}]},"references":{"doc://IvorMXL/s8SendableP":{"title":"Swift.Sendable","type":"unresolvable","identifier":"doc:\/\/IvorMXL\/s8SendableP"},"doc://IvorMXL/s9EscapableP":{"title":"Swift.Escapable","type":"unresolvable","identifier":"doc:\/\/IvorMXL\/s9EscapableP"},"doc://IvorMXL/documentation/IvorMXL/MXLLink/elementPosition":{"type":"topic","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLink\/elementPosition","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"elementPosition","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLElementPosition","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL18MXLElementPositionV"}],"title":"elementPosition","url":"\/documentation\/ivormxl\/mxllink\/elementposition","abstract":[{"text":"The element and position attributes are new as of Version 2.0. They allow for bookmarks and links to be","type":"text"},{"text":" ","type":"text"},{"text":"positioned at higher resolution than the level of music-data elements. When no element and position attributes","type":"text"},{"text":" ","type":"text"},{"text":"are present, the bookmark or link element refers to the next sibling element in the MusicXML file. The element","type":"text"},{"text":" ","type":"text"},{"text":"attribute specifies an element type for a descendant of the next sibling element that is not a link or","type":"text"},{"text":" ","type":"text"},{"text":"bookmark. The position attribute specifies the position of this descendant element, where the first position","type":"text"},{"text":" ","type":"text"},{"text":"is 1. The position attribute is ignored if the element attribute is not present. For instance, an element","type":"text"},{"text":" ","type":"text"},{"text":"value of “beam” and a position value of “2” defines the link or bookmark to refer to the second beam","type":"text"},{"text":" ","type":"text"},{"text":"descendant of the next sibling element that is not a link or bookmark. This is equivalent to an XPath test of","type":"text"},{"text":" ","type":"text"},{"text":"[.\/\/beam[2]] done in the context of the sibling element.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLLink/position":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLink\/position","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"position","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL11MXLPositionV","text":"MXLPosition","kind":"typeIdentifier"}],"role":"symbol","abstract":[{"text":"For most elements, any program will compute a default x and y position. The position attributes let this be","type":"text"},{"text":" ","type":"text"},{"text":"changed two ways.","type":"text"}],"url":"\/documentation\/ivormxl\/mxllink\/position","kind":"symbol","title":"position"},"doc://IvorMXL/documentation/IvorMXL/MXLLink":{"type":"topic","abstract":[{"type":"text","text":"The link type serves as an outgoing simple XLink. If a relative link is used within a document that is part of"},{"type":"text","text":" "},{"type":"text","text":"a compressed MusicXML file, the link is relative to the root folder of the zip file."}],"url":"\/documentation\/ivormxl\/mxllink","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLLink"}],"kind":"symbol","title":"MXLLink","navigatorTitle":[{"kind":"identifier","text":"MXLLink"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLink","role":"symbol"},"doc://Ivo