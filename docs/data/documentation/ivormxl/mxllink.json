te is ignored if the element attribute is not present. For instance, an element","type":"text"},{"text":" ","type":"text"},{"text":"value of “beam” and a position value of “2” defines the link or bookmark to refer to the second beam","type":"text"},{"text":" ","type":"text"},{"text":"descendant of the next sibling element that is not a link or bookmark. This is equivalent to an XPath test of","type":"text"},{"text":" ","type":"text"},{"text":"[.\/\/beam[2]] done in the context of the sibling element.","type":"text"}],"kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"elementPosition","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLElementPosition","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL18MXLElementPositionV"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLLink/init(xlink:name:elementPosition:position:)":{"title":"init(xlink:name:elementPosition:position:)","url":"\/documentation\/ivormxl\/mxllink\/init(xlink:name:elementposition:position:)","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLink\/init(xlink:name:elementPosition:position:)","abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLLink"},{"type":"text","text":"."}],"kind":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"xlink","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLXLink","preciseIdentifier":"s:7IvorMXL8MXLXLinkV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"name","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"elementPosition","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLElementPosition","preciseIdentifier":"s:7IvorMXL18MXLElementPositionV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"position","kind":"externalParam"},{"text":": ","kind":"