lementPosition","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLink\/name","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLink\/position","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLink\/xlink"],"anchor":"Instance-Properties","title":"Instance Properties"},{"generated":true,"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLink\/Equatable-Implementations"],"anchor":"Default-Implementations","title":"Default Implementations"}],"sections":[],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLLink/position":{"kind":"symbol","url":"\/documentation\/ivormxl\/mxllink\/position","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"position","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLPosition","preciseIdentifier":"s:7IvorMXL11MXLPositionV","kind":"typeIdentifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLink\/position","title":"position","abstract":[{"type":"text","text":"For most elements, any program will compute a default x and y position. The position attributes let this be"},{"type":"text","text":" "},{"type":"text","text":"changed two ways."}],"type":"topic"},"doc://IvorMXL/s8CopyableP":{"type":"unresolvable","title":"Swift.Copyable","identifier":"doc:\/\/IvorMXL\/s8CopyableP"},"doc://IvorMXL/documentation/IvorMXL/MXLLink":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLLink","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"MXLLink","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxllink","abstract":[{"type":"text","text":"The link type serves as an outgoing simple XLink. If a relative link is used within a document that is part of"},{"type":"text","text":" "},{"type":"text","text":"a compressed MusicXML file, the link is relative to the root folder of the zip file."}],"title":"MXLLink","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLink","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLLink/xlink":{"kind":"symbol","url":"\/documentation\/ivormxl\/mxllink\/xlink","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"xlink","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLXLink","preciseIdentifier":"s:7IvorMXL8MXLXLinkV","kind":"typeIdentifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLink\/xlink","title":"xlink","abstract":[{"type":"text","text":"The link-attributes group includes all the simple XLink attributes supported in the MusicXML format. It is"},{"type":"text","text":" "},{"type":"text","text":"also used to connect a MusicXML score with MusicXML parts or a MusicXML opus."}],"type":"topic"},"doc://IvorMXL/s16SendableMetatypeP":{"type":"unresolvable","title":"Swift.SendableMetatype","identifier":"doc:\/\/IvorMXL\/s16SendableMetatypeP"},"doc://IvorMXL/documentation/IvorMXL/MXLLink/elementPosition":{"kind":"symbol","url":"\/documentation\/ivormxl\/mxllink\/elementposition","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"elementPosition","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLElementPosition","preciseIdentifier":"s:7IvorMXL18MXLElementPositionV","kind":"typeIdentifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLink\/elementPosition","title":"elementPosition","abstract":[{"type":"text","text":"The element and position attributes are new as of Version 2.0. They allow for bookmarks and links to be"},{"type":"text","text":" "},{"type":"text","text":"positioned at higher resolution than the level of music-data elements. When no element and position attributes"},{"type":"text","text":" "},{"type":"text","text":"are present, the bookmark or link element refers to the next sibling element in the MusicXML file. The element"},{"type":"text","text":" "},{"type":"text","text":"attribute specifies an element type for a descendant of the next sibling element that is not a link or"},{"type":"text","text":" "},{"type":"text","text":"bookmark. The position attribute specifies the position of this descendant element, where the first position"},{"type":"text","text":" "},{"type":"text","text":"is 1. The position attribute is ignored if the element attribute is not present. For instance, an element"},{"type":"text","text":" "},{"type":"text","text":"value of “beam” and a position value of “2” defines the link or bookmark to refer to the second beam"},{"type":"text","text":" "},{"type":"text","text":"descendant of the next sibling element that is not a link or bookmark. This is equivalent to an XPath test of"},{"type":"text","text":" "},{"type":"text","text":"[.\/\/beam[2]] done in the context of the sibling element."}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/s9EscapableP":{"type":"unresolvable","title":"Swift.Escapable","identifier":"doc:\/\/IvorMXL\/s9EscapableP"},"doc://IvorMXL/documentation/IvorMXL/MXLLink/name":{"kind":"symbol","url":"\/documentation\/ivormxl\/mxllink\/name","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"name","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLink\/name","title":"name","abstract":[{"type":"text","text":"A name for this link, usable by applications for any purpose."}],"type":"topic"},"doc://IvorMXL/SQ":{"type":"unresolvable","title":"Swift.Equatable","identifier":"doc:\/\/IvorMXL\/SQ"},"doc://IvorMXL/s8SendableP":{"type":"unresolvable","title":"Swift.Sendable","identifier":"doc:\/\/IvorMXL\/s8SendableP"},"doc://IvorMXL/SH":{"type":"unresolvable","