ion"},{"kind":"text","text":")"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLLink/xlink":{"title":"xlink","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"xlink"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL8MXLXLinkV","kind":"typeIdentifier","text":"MXLXLink"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxllink\/xlink","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLink\/xlink","abstract":[{"type":"text","text":"The link-attributes group includes all the simple XLink attributes supported in the MusicXML format. It is"},{"type":"text","text":" "},{"text":"also used to connect a MusicXML score with MusicXML parts or a MusicXML opus.","type":"text"}]},"doc://IvorMXL/s9EscapableP":{"identifier":"doc:\/\/IvorMXL\/s9EscapableP","type":"unresolvable","title":"Swift.Escapable"},"doc://IvorMXL/documentation/IvorMXL/MXLLink":{"abstract":[{"type":"text","text":"The link type serves as an outgoing simple XLink. If a relative link is used within a document that is part of"},{"type":"text","text":" "},{"type":"text","text":"a compressed MusicXML file, the link is relative to the root folder of the zip file."}],"title":"MXLLink","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLLink"}],"navigatorTitle":[{"kind":"identifier","text":"MXLLink"}],"type":"topic","url":"\/documentation\/ivormxl\/mxllink","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLink"},"doc://IvorMXL/s8SendableP":{"identifier":"doc:\/\/IvorMXL\/s8SendableP","type":"unresolvable","title":"Swift.Sendable"},"doc://IvorMXL/documentation/IvorMXL/MXLLink/elementPosition":{"abstract":[{"type":"text","text":"The element and position attributes are new as of Version 2.0. They allow for bookmarks and links to be"},{"type":"text","text":" "},{"type":"text","text":"positioned at higher resolution than the level of music-data elements. When no element and position attributes"},{"type":"text","text":" "},{"type":"text","text":"are present, the bookmark or link element refers to the next sibling element in the MusicXML file. The element"},{"type":"text","text":" "},{"type":"text","text":"attribute specifies an element type for a descendant of the next sibling element that is not a link or"},{"type":"text","text":" "},{"type":"text","text":"bookmark. The position attribute specifies the position of this descendant element, where the first position"},{"type":"text","text":" "},{"type":"text","text":"is 1. The position attribute is ignored if the element attribute is not present. For instance, an element"},{"type":"text","text":" "},{"type":"text","text":"value of “beam” and a position value of “2” defines the link or bookmark to refer to the second beam"},{"type":"text","text":" "},{"type":"text","text":"descendant of the next sibling element that is not a link or bookmark. This is equivalent to an XPath test of"},{"type":"text","text":" "},{"type":"text","text":"[.\/\/beam[2]] done in the context of the sibling element."}],"title":"elementPosition","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLink\/elementPosition","kind":"symbol","url":"\/documentation\/ivormxl\/mxllink\/elementposition","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"elementPosition","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLElementPosition","preciseIdentifier":"s:7IvorMXL18MXLElementPositionV","kind":"typeIdentifier"}],"role":"symbol"},"doc://IvorMXL/SH":{"title":"Swift.Hashable","type":"unresolvable","identifier":"doc:\/\/IvorMXL\/SH"},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLLink/position":{"abstract":[{"text":"For most elements, any program will compute a default x and y position. The position attributes let this be","type":"text"},{"text":" ","type":"text"},{"text":"changed two ways.","type":"text"}],"title":"position","kind":"symbol","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"position","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL11MXLPositionV","text":"MXLPosition","kind":"typeIdentifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxllink\/position","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLink\/position"},"doc://IvorMXL/documentation/IvorMXL/MXLLink/name":{"abstract":[{"type":"text","text":"A name for this link, usable by applications for any purpose."}],"title":"name","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLink\/name","kind":"symbol","url":"\/documentation\/ivormxl\/mxllink\/name","type":"topic","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"name"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLLink/Equatable-Implementations":{"abstract":[],"title":"Equatable Implementations","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLink\/Equatable-Implementations","kind":"article","url":"\/documentation\/ivormxl\/mxllink\/equatable-implementations","type":"topic","role":"collectionGroup"},"doc://IvorMXL/s8CopyableP":{"title":"Swift.Copyable","type":"unresolvable","identifier":"doc:\/\/IvorMXL\/s8CopyableP"}}}