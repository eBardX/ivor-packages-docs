/documentation/IvorMXL/MXLSlash":{"type":"topic","title":"MXLSlash","navigatorTitle":[{"text":"MXLSlash","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSlash","kind":"identifier"}],"abstract":[{"type":"text","text":"The slash type is used to indicate that slash notation is to be used. If the slash is on every beat, use-stems"},{"type":"text","text":" "},{"type":"text","text":"is no (the default). To indicate rhythms but not pitches, use-stems is set to yes. The type attribute"},{"type":"text","text":" "},{"type":"text","text":"indicates whether this is the start or stop of a slash notation style. The use-dots attribute works as for the"},{"type":"text","text":" "},{"type":"text","text":"beat-repeat element, and only has effect if use-stems is no."}],"url":"\/documentation\/ivormxl\/mxlslash","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSlash","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLSlash/usesStems":{"type":"topic","title":"usesStems","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"usesStems","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"abstract":[{"type":"text","text":"A Boolean value indicating whether to use stems to indicate rhythms rather than pitches. Defaults to"},{"type":"text","text":" "},{"code":"false","type":"codeVoice"},{"type":"text","text":", indicating the slash is used on every beat."}],"url":"\/documentation\/ivormxl\/mxlslash\/usesstems","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSlash\/usesStems","role":"symbol"}}}