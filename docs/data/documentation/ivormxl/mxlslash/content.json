{"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSlash"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"content"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL15MXLSlashContentV","text":"MXLSlashContent","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSlashContent"},{"kind":"text","text":"?"}]}]}],"sections":[],"kind":"symbol","variants":[{"paths":["\/documentation\/ivormxl\/mxlslash\/content"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSlash\/content"},"abstract":[{"text":"The slash group combines elements used for more complete specification of the slash and beat-repeat measure-","type":"text"},{"text":" ","type":"text"},{"text":"style elements. They have the same values as the type and dot elements, and define what the beat is for the","type":"text"},{"text":" ","type":"text"},{"text":"display of repetition marks. If not present, the beat is based on the current time signature.","type":"text"}],"metadata":{"modules":[{"name":"IvorMXL"}],"role":"symbol","externalID":"s:7IvorMXL8MXLSlashV7contentAA0C7ContentVSgvp","title":"content","roleHeading":"Instance Property","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"content"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL15MXLSlashContentV","text":"MXLSlashContent"},{"kind":"text","text":"?"}],"symbolKind":"property"},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLSlash/content":{"role":"symbol","title":"content","kind":"symbol","url":"\/documentation\/ivormxl\/mxlslash\/content","identifier":"doc:\/\/IvorMXL\/docum