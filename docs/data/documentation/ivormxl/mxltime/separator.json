[{"kind":"identifier","text":"MXLTime"}],"url":"\/documentation\/ivormxl\/mxltime","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTime"}],"title":"MXLTime","abstract":[{"type":"text","text":"Time signatures are represented by the beats element for the numerator and the beat-type element for the"},{"type":"text","text":" "},{"type":"text","text":"denominator. The symbol attribute is used to indicate common and cut time symbols as well as a single number"},{"type":"text","text":" "},{"type":"text","text":"display. Multiple pairs of beat and beat-type elements are used for composite time signatures with multiple"},{"type":"text","text":" "},{"type":"text","text":"denominators, such as 2\/4 + 3\/8. A composite such as 3+2\/8 requires only one beat\/beat-type pair."}]},"doc://IvorMXL/documentation/IvorMXL/MXLTime/separator":{"abstract":[{"type":"text","text":"How the beats and beat-type values are displayed relative to one another. "},{"code":".stacked","type":"codeVoice"},{"type":"text","text":" if not"},{"type":"text","text":" "},{"type":"text","text":"specified."}],"title":"separator","url":"\/documentation\/ivormxl\/mxltime\/separator","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"text":"separator","kind":"identifier"},{"kind":"text","text":": "},{"text":"MXLTimeSeparator","preciseIdentifier":"s:7IvorMXL16MXLTimeSeparatorO","kind":"typeIdentifier"}],"kind":"symbol","type":"topic","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTime\/separator"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLTimeSeparator":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTimeSeparator","kind":"symbol","type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLTimeSeparator"}],"url":"\/documentation\/ivormxl\/mxltimeseparator","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTimeSeparator","kind":"identifier"}],"title":"MXLTimeSeparator","abstract":[{"type":"text","text":"The time-separator type indicates how to display the arrangement between the beats and beat-type values in a"},{"type":"text","text":" "},{"type":"text","text":"time signature. The default value is none. The horizontal, diagonal, and vertical values represent horizontal,"},{"type":"text","text":" "},{"text":"diagonal lower-left to upper-right, and vertical lines respectively. For these values, the beats and beat-type","type":"text"},{"text":" ","type":"text"},{"text":"values are arranged on either side of the separator line. The none value represents no separator with the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"beats and beat-type arranged vertically. The adjacent value represents no separator with the beats and beat-"},{"type":"text","text":" "},{"type":"text","text":"type arranged horizontally."}]}}}