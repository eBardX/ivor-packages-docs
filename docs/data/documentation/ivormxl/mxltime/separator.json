ormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLTime/separator":{"abstract":[{"type":"text","text":"How the beats and beat-type values are displayed relative to one another. "},{"code":".stacked","type":"codeVoice"},{"type":"text","text":" if not"},{"type":"text","text":" "},{"type":"text","text":"specified."}],"url":"\/documentation\/ivormxl\/mxltime\/separator","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"separator","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLTimeSeparator","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL16MXLTimeSeparatorO"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTime\/separator","role":"symbol","title":"separator","type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLTimeSeparator":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTimeSeparator"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLTimeSeparator"}],"url":"\/documentation\/ivormxl\/mxltimeseparator","abstract":[{"text":"The time-separator type indicates how to display the arrangement between the beats and beat-type values in a","type":"text"},{"text":" ","type":"text"},{"text":"time signature. The default value is none. The horizontal, diagonal, and vertical values represent horizontal,","type":"text"},{"text":" ","type":"text"},{"text":"diagonal lower-left to upper-right, and vertical lines respectively. For these values, the beats and beat-type","type":"text"},{"text":" ","type":"text"},{"text":"values are arranged on either side of the separator line. The none value represents no separator with the","type":"text"},{"text":" ","type":"text"},{"text":"beats and beat-type arranged vertically. The adjacent value represents no separator with the beats and beat-","type":"text"},{"text":" ","type":"text"},{"text":"type arranged horizontally.","type":"text"}],"title":"MXLTimeSeparator","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTimeSeparator","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLTime":{"role":"symbol","navigatorTitle":[{"text":"MXLTime","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTime","kind":"identifier"}],"kind":"symbol","title":"MXLTime","url":"\/documentation\/ivormxl\/mxltime","type":"topic","abstract":[{"type":"text","text":"Time signatures are represented by the beats element for the numerator and the beat-type element for the"},{"type":"text","text":" "},{"type":"text","text":"denominator. The symbol attribute is used to indicate common and cut time symbols as well as a single number"},{"type":"text","text":" "},{"type":"text","text":"display. Multiple pairs of beat and beat-type elements are used for composite time signatures with multiple"},{"type":"text","text":" "},{"type":"text","text":"denominators, such as 2\/4 + 3\/8. A composite such as 3+2\/8 requires only one beat\/beat-type pair."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTime"}}}