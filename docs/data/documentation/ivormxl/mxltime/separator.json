":".stacked","type":"codeVoice"},{"text":" if not","type":"text"},{"text":" ","type":"text"},{"text":"specified.","type":"text"}],"title":"separator","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTime\/separator","kind":"symbol","url":"\/documentation\/ivormxl\/mxltime\/separator","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"separator","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLTimeSeparator","preciseIdentifier":"s:7IvorMXL16MXLTimeSeparatorO","kind":"typeIdentifier"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLTimeSeparator":{"abstract":[{"text":"The time-separator type indicates how to display the arrangement between the beats and beat-type values in a","type":"text"},{"text":" ","type":"text"},{"text":"time signature. The default value is none. The horizontal, diagonal, and vertical values represent horizontal,","type":"text"},{"text":" ","type":"text"},{"text":"diagonal lower-left to upper-right, and vertical lines respectively. For these values, the beats and beat-type","type":"text"},{"text":" ","type":"text"},{"text":"values are arranged on either side of the separator line. The none value represents no separator with the","type":"text"},{"text":" ","type":"text"},{"text":"beats and beat-type arranged vertically. The adjacent value represents no separator with the beats and beat-","type":"text"},{"text":" ","type":"text"},{"text":"type arranged horizontally.","type":"text"}],"title":"MXLTimeSeparator","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"text":"MXLTimeSeparator","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"MXLTimeSeparator"}],"type":"topic","url":"\/documentation\/ivormxl\/mxltimeseparator","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTimeSeparator"},"doc://IvorMXL/documentation/IvorMXL/MXLTime":{"abstract":[{"type":"text","text":"Time signatures are represented by the beats element for the numerator and the beat-type element for the"},{"type":"text","text":" "},{"type":"text","text":"denominator. The symbol attribute is used to indicate common and cut time symbols as well as a single number"},{"text":" ","type":"text"},{"text":"display. Multiple pairs of beat and beat-type elements are used for composite time signatures with multiple","type":"text"},{"text":" ","type":"text"},{"text":"denominators, such as 2\/4 + 3\/8. A composite such as 3+2\/8 requires only one beat\/beat-type pair.","type":"text"}],"title":"MXLTime","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTime","kind":"identifier"}],"navigatorTitle":[{"text":"MXLTime","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxltime","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTime"},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"}}}