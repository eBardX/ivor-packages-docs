wift.enum"},"doc://IvorMXL/documentation/IvorMXL/MXLTimeSeparator":{"role":"symbol","abstract":[{"type":"text","text":"The time-separator type indicates how to display the arrangement between the beats and beat-type values in a"},{"type":"text","text":" "},{"type":"text","text":"time signature. The default value is none. The horizontal, diagonal, and vertical values represent horizontal,"},{"type":"text","text":" "},{"type":"text","text":"diagonal lower-left to upper-right, and vertical lines respectively. For these values, the beats and beat-type"},{"type":"text","text":" "},{"type":"text","text":"values are arranged on either side of the separator line. The none value represents no separator with the"},{"type":"text","text":" "},{"type":"text","text":"beats and beat-type arranged vertically. The adjacent value represents no separator with the beats and beat-"},{"type":"text","text":" "},{"type":"text","text":"type arranged horizontally."}],"title":"MXLTimeSeparator","url":"\/documentation\/ivormxl\/mxltimeseparator","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTimeSeparator","navigatorTitle":[{"text":"MXLTimeSeparator","kind":"identifier"}],"kind":"symbol","type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTimeSeparator","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLFont":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLFont"}],"abstract":[{"text":"The font attribute group gathers together attributes for determining the font within a credit or direction.","type":"text"},{"text":" ","type":"text"},{"text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of","type":"text"},{"text":" ","type":"text"},{"text":"font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric","type":"text"},{"text":" ","type":"text"},{"text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font","type":"text"},{"text":" ","type":"text"},{"text":"vs. a music font.","type":"text"}],"kind":"symbol","title":"MXLFont","url":"\/documentation\/ivormxl\/mxlfont","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFont"}]},"doc://IvorMXL/documentation/IvorMXL/MXLStaffNumber":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffNumber","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLStaffNumber"}],"abstract":[{"text":"The staff-number type indicates staff numbers within a multi-staff part. Staves are numbered from top to","type":"text"},{"text":" ","type":"text"},{"text":"bottom, with 1 being the top staff on a part.","type":"text"}],"title":"MXLStaffNumber","kind":"symbol","url":"\/documentation\/ivormxl\/mxlstaffnumber","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLStaffNumber"}]}}}