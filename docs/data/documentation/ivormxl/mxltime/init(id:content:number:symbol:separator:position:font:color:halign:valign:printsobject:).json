,"kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLTimeSeparator","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL16MXLTimeSeparatorO"},{"text":"?, ","kind":"text"},{"text":"position","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLPosition","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLPositionV"},{"text":", ","kind":"text"},{"text":"font","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLFont","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL7MXLFontV"},{"text":", ","kind":"text"},{"text":"color","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLColor","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLColorV"},{"text":"?, ","kind":"text"},{"text":"halign","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLLeftCenterRight","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL18MXLLeftCenterRightO"},{"text":"?, ","kind":"text"},{"text":"valign","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLValign","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLValignO"},{"text":"?, ","kind":"text"},{"text":"printsObject","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":"?)","kind":"text"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTime\/init(id:content:number:symbol:separator:position:font:color:halign:valign:printsObject:)","role":"symbol","title":"init(id:content:number:symbol:separator:position:font:color:halign:valign:printsObject:)","type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLStaffNumber":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLStaffNumber","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"MXLStaffNumber","kind":"identifier"}],"abstract":[{"text":"The staff-number type indicates staff numbers within a multi-staff part. Staves are numbered from top to","type":"text"},{"type":"text","text":" "},{"type":"text","text":"bottom, with 1 being the top staff on a part."}],"url":"\/documentation\/ivormxl\/mxlstaffnumber","title":"MXLStaffNumber","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffNumber","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLTimeSeparator":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTimeSeparator"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLTimeSeparator"}],"url":"\/documentation\/ivormxl\/mxltimeseparator","abstract":[{"text":"The time-separator type indicates how to display the arrangement between the beats and beat-type values in a","type":"text"},{"text":" ","type":"text"},{"text":"time signature. The default value is none. The horizontal, diagonal, and vertical values represent horizontal,","type":"text"},{"text":" ","type":"text"},{"text":"diagonal lower-left to upper-right, and vertical lines respectively. For these values, the beats and beat-type","type":"text"},{"text":" ","type":"text"},{"text":"values are arranged on either side of the separator line. The none value represents no separator with the","type":"text"},{"text":" ","type":"text"},{"text":"beats and beat-type arranged vertically. The adjacent value represents no separator with the beats and beat-","type":"text"},{"text":" ","type":"text"},{"text":"type arranged horizontally.","type":"text"}],"title":"MXLTimeSeparator","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTimeSeparator","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLTime":{"role":"symbol","navigatorTitle":[{"text":"MXLTime","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTime","kind":"identifier"}],"kind":"symbol","title":"MXLTime","url":"\/documentation\/ivormxl\/mxltime","type":"topic","abstract":[{"type":"text","text":"Time signatures are represented by the beats element for the numerator and the beat-type element for the"},{"type":"text","text":" "},{"type":"text","text":"denominator. The symbol attribute is used to indicate common and cut time symbols as well as a single number"},{"type":"text","text":" "},{"type":"text","text":"display. Multiple pairs of beat and beat-type elements are used for composite time signatures with multiple"},{"type":"text","text":" "},{"type":"text","text":"denominators, such as 2\/4 + 3\/8. A composite such as 3+2\/8 requires only one beat\/beat-type pair."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTime"},"doc://IvorMXL/documentation/IvorMXL/MXLPosition":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlposition","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPosition"}],"kind":"symbol","abstract":[{"text":"For most elements, any program will compute a default x and y position. The position attributes let this be","type":"text"},{"text":" ","type":"text"},{"text":"changed two ways.","type":"text"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLPosition"}],"title":"MXLPosition"},"doc://IvorMXL/documentation/IvorMXL/MXLTimeSymbol":{"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTimeSymbol","url":"\/documentation\/ivormxl\/mxltimesymbol","abstract":[{"text":"The time-symbol type indicates how to display a time signature. The normal value is the usual fractional","type":"text"},{"text":" ","type":"text"},{"text":"display, and is the implied symbol type if none is specified. Other options are the common and cut time","type":"text"},{"text":" ","type":"text"},{"text":"symbols, as well as a single number with an implied denominator. The note symbol indicates that the beat-type","type":"text"},{"text":" ","type":"text"},{"text":"should be represented with the corresponding downstem note rather than a number. The dotted-note symbol","type":"text"},{"text":" ","type":"text"},{"text":"indicates that the beat-type should be represented with a dotted downstem note that corresponds to three times","type":"text"},{"text":" ","type":"text"},{"text":"the beat-type value, and a numerator that is one third the beats value.","type":"text"}],"type":"topic","role":"symbol","navigatorTitle":[{"text":"MXLTimeSymbol","kind":"identifier"}],"title":"MXLTimeSymbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTimeSymbol","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLLeftCenterRight":{"url":"\/documentation\/ivormxl\/mxlleftcenterright","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLeftCenterRight","abstract":[{"type":"text","text":"The left-center-right type is used to define horizontal alignment and text justification."}],"title":"MXLLeftCenterRight","kind":"symbol","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLLeftCenterRight"}],"navigatorTitle":[{"kind":"identifier","text":"MXLLeftCenterRight"}]},"doc://IvorMXL/documentation/IvorMXL/MXLValign":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlvalign","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValign","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLValign"}],"abstract":[{"text":"The valign type is used to indicate vertical alignment to the top, middle, bottom, or baseline of the text. If","type":"text"},{"text":" ","type":"text"},{"text":"the text is on multiple lines, baseline alignment refers to the baseline of the lowest line of text. Defaults","type":"text"},{"text":" ","type":"text"},{"text":"are implementation-dependent.","type":"text"}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLValign"}],"title":"MXLValign"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"title":"MXLColor","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"abstract":[{"text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in","type":"text"},{"text":" ","type":"text"},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"url":"\/documentation\/ivormxl\/mxlcolor"}}}