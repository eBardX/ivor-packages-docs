":"text","text":"? = nil, "},{"kind":"externalParam","text":"symbol"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL13MXLTimeSymbolO","kind":"typeIdentifier","text":"MXLTimeSymbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTimeSymbol"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"separator"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL16MXLTimeSeparatorO","kind":"typeIdentifier","text":"MXLTimeSeparator","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTimeSeparator"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"position"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL11MXLPositionV","kind":"typeIdentifier","text":"MXLPosition","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition"},{"kind":"text","text":" = MXLPosition(), "},{"kind":"externalParam","text":"font"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL7MXLFontV","kind":"typeIdentifier","text":"MXLFont","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont"},{"kind":"text","text":" = MXLFont(), "},{"kind":"externalParam","text":"color"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL8MXLColorV","kind":"typeIdentifier","text":"MXLColor","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"halign"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL18MXLLeftCenterRightO","kind":"typeIdentifier","text":"MXLLeftCenterRight","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLeftCenterRight"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"valign"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL9MXLValignO","kind":"typeIdentifier","text":"MXLValign","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValign"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"printsObject"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"},{"kind":"text","text":"? = nil)"}]}]},{"kind":"parameters","parameters":[{"name":"id","content":[{"inlineContent":[{"type":"text","text":"The optional-unique-id attribute group allows an element to optionally specify an ID that is unique to the entire document. This attribute group is not used for a required id attribute, or for an id attribute that specifies an id reference."}],"type":"paragraph"}]},{"name":"content","content":[{"inlineContent":[{"type":"text","text":"One of the alternatives for Time."}],"type":"paragraph"}]},{"name":"number","content":[{"inlineContent":[{"type":"text","text":"The staff number within the part that this element applies to. If absent, the time signature applies to all staves in the part."}],"type":"paragraph"}]},{"name":"symbol","content":[{"inlineContent":[{"type":"text","text":"The symbol used to indicate common and cut time as well as a single number display."}],"type":"paragraph"}]},{"name":"separator","content":[{"inlineContent":[{"type":"text","text":"How the beats and beat-type values are displayed relative to one another. "},{"code":".stacked","type":"codeVoice"},{"type":"text","text":" if not specified."}],"type":"paragraph"}]},{"name":"position","content":[{"inlineContent":[{"type":"text","text":"For most elements, any program will compute a default x and y position. The position attributes let this be changed two ways."}],"type":"paragraph"}]},{"name":"font","content":[{"inlineContent":[{"type":"text","text":"The font attribute group gathers together attributes for determining the font within a credit or direction. They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font vs. a music font."}],"type":"paragraph"}]},{"name":"color","content":[{"inlineContent":[{"type":"text","text":"The color attribute group indicates the color of an element."}],"type":"paragraph"}]},{"name":"halign","content":[{"inlineContent":[{"type":"text","text":"In cases where text extends over more than one line, horizontal alignment and justify values can be different. The most typical case is for credits, such as:"}],"type":"paragraph"}]},{"name":"valign","content":[{"inlineContent":[{"type":"text","text":"The valign attribute is used to indicate vertical alignment to the top, middle, bottom, or baseline of the text. Defaults are implementation-dependent."}],"type":"paragraph"}]},{"name":"printsObject","content":[{"inlineContent":[{"type":"text","text":"A Boolean value indicating whether to print an object (e.g. a note or a rest). Defaults to "},{"code":"true","type":"codeVoice"},{"type":"text","text":" if not specified."}],"type":"paragraph"}]}]}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTime\/init(id:content:number:symbol:separator:position:font:color:halign:valign:printsObject:)","interfaceLanguage":"swift"},"sections":[],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLTime":{"title":"MXLTime","navigatorTitle":[{"kind":"identifier","text":"MXLTime"}],"type":"topic","abstract":[{"type":"text","text":"Time signatures are represented by the beats element for the numerator and the beat-type element for the"},{"type":"text","text":" "},{"type":"text","text":"denominator. The symbol attribute is used to indicate common and cut time symbols as well as a single number"},{"type":"text","text":" "},{"type":"text","text":"display. Multiple pairs of beat and beat-type elements are used for composite time signatures with multiple"},{"type":"text","text":" "},{"type":"text","text":"denominators, such as 2\/4 + 3\/8. A composite such as 3+2\/8 requires only one beat\/beat-type pair."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTime"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTime","url":"\/documentation\/ivormxl\/mxltime"},"doc://IvorMXL/documentation/IvorMXL/MXLPosition":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLPosition"}],"abstract":[{"text":"For most elements, any program will compute a default x and y position. The position attributes let this be","type":"text"},{"text":" ","type":"text"},{"text":"changed two ways.","type":"text"}],"kind":"symbol","title":"MXLPosition","url":"\/documentation\/ivormxl\/mxlposition","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPosition"}]},"doc://IvorMXL/documentation/IvorMXL/MXLLeftCenterRight":{"type":"topic","kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLLeftCenterRight","kind":"identifier"}],"navigatorTitle":[{"text":"MXLLeftCenterRight","kind":"identifier"}],"abstract":[{"text":"The left-center-right type is used to define horizontal alignment and text justification.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLeftCenterRight","title":"MXLLeftCenterRight","role":"symbol","url":"\/documentation\/ivormxl\/mxlleftcenterright"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLColor","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","title":"MXLColor","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlcolor"},"doc://IvorMXL/documentation/IvorMXL/MXLTimeSymbol":{"type":"topic","kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTimeSymbol","kind":"identifier"}],"navigatorTitle":[{"text":"MXLTimeSymbol","kind":"identifier"}],"abstract":[{"type":"text","text":"The time-symbol type indicates how to display a time signature. The normal value is the usual fractional"},{"type":"text","text":" "},{"type":"text","text":"display, and is the implied symbol type if none is specified. Other options are the common and cut time"},{"type":"text","text":" "},{"type":"text","text":"symbols, as well as a single number with an implied denominator. The note symbol indicates that the beat-type"},{"text":" ","type":"text"},{"type":"text","text":"should be represented with the corresponding downstem note rather than a number. The dotted-note symbol"},{"text":" ","type":"text"},{"type":"text","text":"indicates that the beat-type should be represented with a dotted downstem note that corresponds to three times"},{"type":"text","text":" "},{"text":"the beat-type value, and a numerator that is one third the beats value.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTimeSymbol","title":"MXLTimeSymbol","role":"symbol","url":"\/documentation\/ivormxl\/mxltimesymbol"},"doc://IvorMXL/documentation/IvorMXL/MXLValign":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLValign"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValign","title":"MXLValign","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLValign"}],"abstract":[{"type":"text","text":"The valign type is used to indicate vertical alignment to the top, middle, bottom, or baseline of the text. If"},{"type":"text","text":" "},{"type":"text","text":"the text is on multiple lines, baseline alignment refers to the baseline of the lowest line of text. Defaults"},{"type":"text","text":" "},{"type":"text","text":"are implementation-dependent."}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlvalign"},"doc://IvorMXL/documentation/IvorMXL/MXLTime/init(id:content:number:symbol:separator:position:font:color:halign:valign:printsObject:)":{"kind":"symbol","title":"init(id:content:number:symbol:separator:position:font:color:halign:valign:printsObject:)","role":"symbol","url":"\/documentation\/ivormxl\/mxltime\/init(id:content:number:symbol:separator:position:font:color:halign:valign:printsobject:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"id"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"content"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL7MXLTimeV7ContentO","text":"Content"},{"kind":"text","text":", "},{"kind":"externalParam","text":"number"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL14MXLStaffNumberV","text":"MXLStaffNumber"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"symbol"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL13MXLTimeSymbolO","text":"MXLTimeSymbol"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"separator"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL16MXLTimeSeparatorO","text":"MXLTimeSeparator"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"position"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLPositionV","text":"MXLPosition"},{"kind":"text","text":", "},{"kind":"externalParam","