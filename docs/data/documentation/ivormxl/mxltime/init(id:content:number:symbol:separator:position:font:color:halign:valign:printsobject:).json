ier":"s:7IvorMXL14MXLStaffNumberV"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"symbol"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTimeSymbol","text":"MXLTimeSymbol","preciseIdentifier":"s:7IvorMXL13MXLTimeSymbolO"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"separator"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTimeSeparator","text":"MXLTimeSeparator","preciseIdentifier":"s:7IvorMXL16MXLTimeSeparatorO"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"position"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","text":"MXLPosition","preciseIdentifier":"s:7IvorMXL11MXLPositionV"},{"kind":"text","text":" = MXLPosition(), "},{"kind":"externalParam","text":"font"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","text":"MXLFont","preciseIdentifier":"s:7IvorMXL7MXLFontV"},{"kind":"text","text":" = MXLFont(), "},{"kind":"externalParam","text":"color"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","text":"MXLColor","preciseIdentifier":"s:7IvorMXL8MXLColorV"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"halign"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLeftCenterRight","text":"MXLLeftCenterRight","preciseIdentifier":"s:7IvorMXL18MXLLeftCenterRightO"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"valign"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValign","text":"MXLValign","preciseIdentifier":"s:7IvorMXL9MXLValignO"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"printsObject"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":"? = nil)"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"name":"id","content":[{"inlineContent":[{"type":"text","text":"The optional-unique-id attribute group allows an element to optionally specify an ID"},{"type":"text","text":" "},{"type":"text","text":"that is unique to the entire document. This attribute group is not used for a"},{"type":"text","text":" "},{"type":"text","text":"required id attribute, or for an id attribute that specifies an id reference."}],"type":"paragraph"}]},{"name":"content","content":[{"inlineContent":[{"type":"text","text":"One of the alternatives for Time."}],"type":"paragraph"}]},{"name":"number","content":[{"inlineContent":[{"type":"text","text":"The staff number within the part that this element applies to. If absent, the time"},{"type":"text","text":" "},{"type":"text","text":"signature applies to all staves in the part."}],"type":"paragraph"}]},{"name":"symbol","content":[{"inlineContent":[{"type":"text","text":"The symbol used to indicate common and cut time as well as a single number display."}],"type":"paragraph"}]},{"name":"separator","content":[{"inlineContent":[{"type":"text","text":"How the beats and beat-type values are displayed relative to one another. "},{"type":"codeVoice","code":".stacked"},{"type":"text","text":" "},{"type":"text","text":"if not specified."}],"type":"paragraph"}]},{"name":"position","content":[{"inlineContent":[{"type":"text","text":"For most elements, any program will compute a default x and y position. The position"},{"type":"text","text":" "},{"type":"text","text":"attributes let this be changed two ways."}],"type":"paragraph"}]},{"name":"font","content":[{"inlineContent":[{"type":"text","text":"The font attribute group gathers together attributes for determining the font within"},{"type":"text","text":" "},{"type":"text","text":"a credit or direction. They are based on the text styles for Cascading Style Sheets."},{"type":"text","text":" "},{"type":"text","text":"The font-family is a comma-separated list of font names. The font-style can be normal"},{"type":"text","text":" "},{"type":"text","text":"or italic. The font-size can be one of the CSS sizes or a numeric point size. The"},{"type":"text","text":" "},{"type":"text","text":"font-weight can be normal or bold. The default is application-dependent, but is a"},{"type":"text","text":" "},{"type":"text","text":"text font vs. a music font."}],"type":"paragraph"}]},{"name":"color","content":[{"inlineContent":[{"type":"text","text":"The color attribute group indicates the color of an element."}],"type":"paragraph"}]},{"name":"halign","content":[{"inlineContent":[{"type":"text","text":"In cases where text extends over more than one line, horizontal alignment and justify"},{"type":"text","text":" "},{"type":"text","text":"values can be different."}],"type":"paragraph"}]},{"name":"valign","content":[{"inlineContent":[{"type":"text","text":"The valign attribute is used to indicate vertical alignment to the top, middle,"},{"type":"text","text":" "},{"type":"text","text":"bottom, or baseline of the text. Defaults are implementation-dependent."}],"type":"paragraph"}]},{"name":"printsObject","content":[{"inlineContent":[{"type":"text","text":"A Boolean value indicating whether to print an object (e.g. a note or a rest)."},{"type":"text","text":" "},{"type":"text","text":"Defaults to "},{"type":"codeVoice","code":"true"},{"type":"text","text":" if not specified."}],"type":"paragraph"}]}]}],"abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLTime"},{"type":"text","text":"."}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLFont":{"type":"topic","title":"MXLFont","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","abstract":[{"type":"text","text":"The font attribute group gathers together attributes for determining the font within a credit or direction."},{"type":"text","text":" "},{"type":"text","text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of"},{"type":"text","text":" "},{"type":"text","text":"font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric"},{"type":"text","text":" "},{"type":"text","text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font"},{"type":"text","text":" "},{"type":"text","text":"vs. a music font."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFont"}],"navigatorTitle":[{"kind":"identifier","text":"MXLFont"}],"url":"\/documentation\/ivormxl\/mxlfont"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLTimeSymbol":{"title":"MXLTimeSymbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTimeSymbol","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxltimesymbol","role":"symbol","navigatorTitle":[{"text":"MXLTimeSymbol","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTimeSymbol","abstract":[{"text":"The time-symbol type indicates how to display a time signature. The normal value is the usual fractional","type":"text"},{"text":" ","type":"text"},{"text":"display, and is the implied symbol type if none is specified. Other options are the common and cut time","type":"text"},{"text":" ","type":"text"},{"text":"symbols, as well as a single number with an implied denominator. The note symbol indicates that the beat-type","type":"text"},{"text":" ","type":"text"},{"text":"should be represented with the corresponding downstem note rather than a number. The dotted-note symbol","type":"text"},{"text":" ","type":"text"},{"text":"indicates that the beat-type should be represented with a dotted downstem note that corresponds to three times","type":"text"},{"text":" ","type":"text"},{"text":"the beat-type value, and a numerator that is one third the beats value.","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLTimeSeparator":{"type":"topic","title":"MXLTimeSeparator","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTimeSeparator","abstract":[{"type":"text","text":"The time-separator type indicates how to display the arrangement between the beats and beat-type values in a"},{"type":"text","text":" "},{"type":"text","text":"time signature. The default value is none. The horizontal, diagonal, and vertical values represent horizontal,"},{"type":"text","text":" "},{"type":"text","text":"diagonal lower-left to upper-right, and vertical lines respectively. For these values, the beats and beat-type"},{"type":"text","text":" "},{"type":"text","text":"values are arranged on either side of the separator line. The none value represents no separator with the"},{"type":"text","text":" "},{"type":"text","text":"beats and beat-type arranged vertically. The adjacent value represents no separator with the beats and beat-"},{"type":"text","text":" "},{"type":"text","text":"type arranged horizontally."}],"role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTimeSeparator"}],"navigatorTitle":[{"kind":"identifier","text":"MXLTimeSeparator"}],"url":"\/documentation\/ivormxl\/mxltimeseparator"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"type":"topic","abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"type":"text","text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is"},{"type":"text","text":" "},{"type":"text","text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF."}],"url":"\/documentation\/ivormxl\/mxlcolor","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"kind":"symbol","title":"MXLColor","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLTime/Content-swift.enum":{"kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"One of the alternatives for Time."}],"url":"\/documentation\/ivormxl\/mxltime\/content-swift.enum","type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Content","kind":"identifier"}],"title":"MXLTime.Content","navigatorTitle":[{"text":"Content","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTime\/Content-swift.enum"},"doc://IvorMXL/documentation/IvorMXL/MXLTime/init(id:content:number:symbol:separator:position:font:color:halign:valign:printsObject:)":{"kind":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTime\/init(id:content:number:symbol:separator:position:font:color:halign:valign:printsObject:)","role":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"id"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"content"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL7MXLTimeV7ContentO","kind":"typeIdentifier","text":"Content"},{"kind":"text","text":", "},{"kind":"externalParam","text":"number"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL14MXLStaffNumberV","kind":"typeIdentifier","text":"MXLStaffNumber"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"symbol"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL13MXLTimeSymbolO","kind":"typeIdentifier","text":"MXLTimeSymbol"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"separator"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL16MXLTimeSeparatorO","kind":"typeIdentifier","text":"MXLTimeSeparator"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"position"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL11MXLPositionV","kind":"typeIdentifier","text":"MXLPosition"},{"kind":"text","text":", "},{"kind":"externalParam","text":"font"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL7MXLFontV","kind":"typeIdentifier","text":"MXLFont"},{"kind":"text","text":", "},{"kind":"externalParam","text":"color"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL8MXLColorV","kind":"typeIdentifier","text":"MXLColor"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"halign"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL18MXLLeftCenterRightO","kind":"typeIdentifier","text":"MXLLeftCenterRight"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"valign"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL9MXLValignO","kind":"typeIdentifier","text":"MXLValign"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"printsObject"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"},{"kind":"text","text":"?)"}],"url":"\/documentation\/ivormxl\/mxltime\/init(id:content:number:symbol:separator:position:font:color:halign:valign:printsobject:)","title":"init(id:content:number:symbol:separator:position:font:color:halign:valign:printsObject:)","abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLTime"},{"type":"text","text":"."}]},"doc://IvorMXL/documentation/IvorMXL/MXLValign":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLValign","kind":"identifier"}],"title":"MXLValign","abstract":[{"type":"text","text":"The valign type is used to indicate vertical alignment to the top, middle, bottom, or baseline of the text. If"},{"type":"text","text":" "},{"type":"text","text":"the text is on multiple lines, baseline alignment refers to the baseline of the lowest line of text. Defaults"},{"type":"text","text":" "},{"type":"text","text":"are implementation-dependent."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValign","role":"symbol","url":"\/documentation\/ivormxl\/mxlvalign","kind":"symbol","navigatorTitle":[{"text":"MXLValign","kind":"identifier"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLLeftCenterRight":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLLeftCenterRight"}],"title":"MXLLeftCenterRight","abstract":[{"text":"The left-center-right type is used to define horizontal alignment and text justification.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLeftCenterRight","role":"symbol","url":"\/documentation\/ivormxl\/mxlleftcenterright","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLLeftCenterRight"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLStaffNumber":{"type":"topic","title":"MXLStaffNumber","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffNumber","abstract":[{"type":"text","text":"The staff-number type indicates staff numbers within a multi-staff part. Staves are numbered from top to"},{"type":"text","text":" "},{"type":"text","text":"bottom, with 1 being the top staff on a part."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLStaffNumber"}],"navigatorTitle":[{"kind":"identifier","text":"MXLStaffNumber"}],"url":"\/documentation\/ivormxl\/mxlstaffnumber"},"doc://IvorMXL/documentation/IvorMXL/MXLTime":{"title":"MXLTime","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTime"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxltime","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLTime"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTime","abstract":[{"type":"text","text":"Time signatures are represented by the beats element for the numerator and the beat-type element for the"},{"type":"text","text":" "},{"type":"text","text":"denominator. The symbol attribute is used to indicate common and cut time symbols as well as a single number"},{"type":"text","text":" "},{"type":"text","text":"display. Multiple pairs of beat and beat-type elements are used for composite time signatures with multiple"},{"type":"text","text":" "},{"type":"text","text":"denominators, such as 2\/4 + 3\/8. A composite such as 3+2\/8 requires only one beat\/beat-type pair."}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLPosition":{"type":"topic","abstract":[{"type":"text","text":"For most elements, any program will compute a default x and y position. The position attributes let this be"},{"type":"text","text":" "},{"type":"text","text":"changed two ways."}],"url":"\/documentation\/ivormxl\/mxlposition","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPosition"}],"kind":"symbol","title":"MXLPosition","navigatorTitle":[{"kind":"identifier","text":"MXLPosition"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","role":"symbol"}}}