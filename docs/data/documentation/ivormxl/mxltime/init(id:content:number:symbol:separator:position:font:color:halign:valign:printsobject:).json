entifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","preciseIdentifier":"s:7IvorMXL11MXLPositionV","text":"MXLPosition"},{"kind":"text","text":" = MXLPosition(), "},{"kind":"externalParam","text":"font"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","preciseIdentifier":"s:7IvorMXL7MXLFontV","text":"MXLFont"},{"kind":"text","text":" = MXLFont(), "},{"kind":"externalParam","text":"color"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","preciseIdentifier":"s:7IvorMXL8MXLColorV","text":"MXLColor"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"halign"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLeftCenterRight","preciseIdentifier":"s:7IvorMXL18MXLLeftCenterRightO","text":"MXLLeftCenterRight"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"valign"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValign","preciseIdentifier":"s:7IvorMXL9MXLValignO","text":"MXLValign"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"printsObject"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":"? = nil)"}]}]},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"text":"The optional-unique-id attribute group allows an element to optionally specify an ID that is unique to the entire document. This attribute group is not used for a required id attribute, or for an id attribute that specifies an id reference.","type":"text"}],"type":"paragraph"}],"name":"id"},{"content":[{"inlineContent":[{"text":"One of the alternatives for Time.","type":"text"}],"type":"paragraph"}],"name":"content"},{"content":[{"inlineContent":[{"text":"The staff number within the part that this element applies to. If absent, the time signature applies to all staves in the part.","type":"text"}],"type":"paragraph"}],"name":"number"},{"content":[{"inlineContent":[{"text":"The symbol used to indicate common and cut time as well as a single number display.","type":"text"}],"type":"paragraph"}],"name":"symbol"},{"content":[{"inlineContent":[{"text":"How the beats and beat-type values are displayed relative to one another. ","type":"text"},{"code":".stacked","type":"codeVoice"},{"text":" if not specified.","type":"text"}],"type":"paragraph"}],"name":"separator"},{"content":[{"inlineContent":[{"text":"For most elements, any program will compute a default x and y position. The position attributes let this be changed two ways.","type":"text"}],"type":"paragraph"}],"name":"position"},{"content":[{"inlineContent":[{"text":"The font attribute group gathers together attributes for determining the font within a credit or direction. They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font vs. a music font.","type":"text"}],"type":"paragraph"}],"name":"font"},{"content":[{"inlineContent":[{"text":"The color attribute group indicates the color of an element.","type":"text"}],"type":"paragraph"}],"name":"color"},{"content":[{"inlineContent":[{"text":"In cases where text extends over more than one line, horizontal alignment and justify values can be different. The most typical case is for credits, such as:","type":"text"}],"type":"paragraph"}],"name":"halign"},{"content":[{"inlineContent":[{"text":"The valign attribute is used to indicate vertical alignment to the top, middle, bottom, or baseline of the text. Defaults are implementation-dependent.","type":"text"}],"type":"paragraph"}],"name":"valign"},{"content":[{"inlineC