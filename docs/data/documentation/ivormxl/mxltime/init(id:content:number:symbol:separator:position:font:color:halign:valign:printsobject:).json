 pairs of beat and beat-type elements are used for composite time signatures with multiple","type":"text"},{"text":" ","type":"text"},{"text":"denominators, such as 2\/4 + 3\/8. A composite such as 3+2\/8 requires only one beat\/beat-type pair.","type":"text"}],"title":"MXLTime","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTime","kind":"identifier"}],"navigatorTitle":[{"text":"MXLTime","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxltime","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTime"},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLStaffNumber":{"navigatorTitle":[{"text":"MXLStaffNumber","kind":"identifier"}],"abstract":[{"text":"The staff-number type indicates staff numbers within a multi-staff part. Staves are numbered from top to","type":"text"},{"text":" ","type":"text"},{"text":"bottom, with 1 being the top staff on a part.","type":"text"}],"title":"MXLStaffNumber","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffNumber","kind":"symbol","url":"\/documentation\/ivormxl\/mxlstaffnumber","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLStaffNumber","kind":"identifier"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLTime/Content-swift.enum":{"navigatorTitle":[{"kind":"identifier","text":"Content"}],"abstract":[{"text":"One of the alternatives for Time.","type":"text"}],"title":"MXLTime.Content","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTime\/Content-swift.enum","kind":"symbol","url":"\/documentation\/ivormxl\/mxltime\/content-swift.enum","type":"topic","fragments":[{"kind":"keywo