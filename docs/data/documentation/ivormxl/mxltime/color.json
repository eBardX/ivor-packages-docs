/documentation/IvorMXL/MXLColor":{"title":"MXLColor","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"abstract":[{"text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in","type":"text"},{"text":" ","type":"text"},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"url":"\/documentation\/ivormxl\/mxlcolor"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLTime":{"role":"symbol","navigatorTitle":[{"text":"MXLTime","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTime","kind":"identifier"}],"kind":"symbol","title":"MXLTime","url":"\/documentation\/ivormxl\/mxltime","type":"topic","abstract":[{"type":"text","text":"Time signatures are represented by the beats element for the numerator and the beat-type element for the"},{"type":"text","text":" "},{"type":"text","text":"denominator. The symbol attribute is used to indicate common and cut time symbols as well as a single number"},{"type":"text","text":" "},{"type":"text","text":"display. Multiple pairs of beat and beat-type elements are used for composite time signatures with multiple"},{"type":"text","text":" "},{"type":"text","text":"denominators, such as 2\/4 + 3\/8. A composite such as 3+2\/8 requires only one beat\/beat-type pair."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTime"}}}