n","abstract":[{"type":"text","text":"In cases where text extends over more than one line, horizontal alignment and justify values can be different."},{"type":"text","text":" "},{"type":"text","text":"The most typical case is for credits, such as:"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTime\/halign"},"doc://IvorMXL/documentation/IvorMXL/MXLTime":{"abstract":[{"type":"text","text":"Time signatures are represented by the beats element for the numerator and the beat-type element for the"},{"type":"text","text":" "},{"type":"text","text":"denominator. The symbol attribute is used to indicate common and cut time symbols as well as a single number"},{"text":" ","type":"text"},{"text":"display. Multiple pairs of beat and beat-type elements are used for composite time signatures with multiple","type":"text"},{"text":" ","type":"text"},{"text":"denominators, such as 2\/4 + 3\/8. A composite such as 3+2\/8 requires only one beat\/beat-type pair.","type":"text"}],"title":"MXLTime","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTime","kind":"identifier"}],"navigatorTitle":[{"text":"MXLTime","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxltime","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTime"}}}