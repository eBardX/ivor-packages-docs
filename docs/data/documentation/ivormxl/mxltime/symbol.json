pe":"text","text":" "},{"type":"text","text":"denominator. The symbol attribute is used to indicate common and cut time symbols as well as a single number"},{"type":"text","text":" "},{"type":"text","text":"display. Multiple pairs of beat and beat-type elements are used for composite time signatures with multiple"},{"type":"text","text":" "},{"type":"text","text":"denominators, such as 2\/4 + 3\/8. A composite such as 3+2\/8 requires only one beat\/beat-type pair."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTime"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTime","url":"\/documentation\/ivormxl\/mxltime"},"doc://IvorMXL/documentation/IvorMXL/MXLTime/symbol":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"symbol","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLTimeSymbol","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL13MXLTimeSymbolO"},{"text":"?","kind":"text"}],"title":"symbol","kind":"symbol","url":"\/documentation\/ivormxl\/mxltime\/symbol","abstract":[{"type":"text","text":"The symbol used to indicate common and cut time as well as a single number display."}],"type":"topic","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTime\/symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLTimeSymbol":{"type":"topic","kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTimeSymbol","kind":"identifier"}],"navigatorTitle":[{"text":"MXLTimeSymbol","kind":"identifier"}],"abstract":[{"type":"text","text":"The time-symbol type indicates how to display a time signature. The normal value is the usual fractional"},{"type":"text","text":" "},{"type":"text","text":"display, and is the implied symbol type if none is specified. Other options are the common and cut time"},{"type":"text","text":" "},{"type":"text","text":"symbols, as well as a single number with an implied denominator. The note symbol indicates that the beat-type"},{"text":" ","type":"text"},{"type":"text","text":"should be represented with the corresponding downstem note rather than a number. The dotted-note symbol"},{"text":" ","type":"text"},{"type":"text","text":"indicates that the beat-type should be represented with a dotted downstem note that corresponds to three times"},{"type":"text","text":" "},{"text":"the beat-type value, and a numerator that is one third the beats value.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTimeSymbol","title":"MXLTimeSymbol","role":"symbol","url":"\/documentation\/ivormxl\/mxltimesymbol"}}}