ymbol"},"doc://IvorMXL/documentation/IvorMXL/MXLTime":{"role":"symbol","navigatorTitle":[{"text":"MXLTime","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTime","kind":"identifier"}],"kind":"symbol","title":"MXLTime","url":"\/documentation\/ivormxl\/mxltime","type":"topic","abstract":[{"type":"text","text":"Time signatures are represented by the beats element for the numerator and the beat-type element for the"},{"type":"text","text":" "},{"type":"text","text":"denominator. The symbol attribute is used to indicate common and cut time symbols as well as a single number"},{"type":"text","text":" "},{"type":"text","text":"display. Multiple pairs of beat and beat-type elements are used for composite time signatures with multiple"},{"type":"text","text":" "},{"type":"text","text":"denominators, such as 2\/4 + 3\/8. A composite such as 3+2\/8 requires only one beat\/beat-type pair."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTime"},"doc://IvorMXL/documentation/IvorMXL/MXLTime/symbol":{"abstract":[{"type":"text","text":"The symbol used to indicate common and cut time as well as a single number display."}],"url":"\/documentation\/ivormxl\/mxltime\/symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"symbol","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLTimeSymbol","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL13MXLTimeSymbolO"},{"text":"?","kind":"text"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTime\/symbol","role":"symbol","title":"symbol","type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLTimeSymbol":{"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTimeSymbol","url":"\/documentation\/ivormxl\/mxltimesymbol","abstract":[{"text":"The time-symbol type indicates how to display a time signature. The normal value is the usual fractional","type":"text"},{"text":" ","type":"text"},{"text":"display, and is the implied symbol type if none is specified. Other options are the common and cut time","type":"text"},{"text":" ","type":"text"},{"text":"symbols, as well as a single number with an implied denominator. The note symbol indicates that the beat-type","type":"text"},{"text":" ","type":"text"},{"text":"should be represented with the corresponding downstem note rather than a number. The dotted-note symbol","type":"text"},{"text":" ","type":"text"},{"text":"indicates that the beat-type should be represented with a dotted downstem note that corresponds to three times","type":"text"},{"text":" ","type":"text"},{"text":"the beat-type value, and a numerator that is one third the beats value.","type":"text"}],"type":"topic","role":"symbol","navigatorTitle":[{"text":"MXLTimeSymbol","kind":"identifier"}],"title":"MXLTimeSymbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTimeSymbol","kind":"identifier"}]}}}