he"},{"type":"text","text":" "},{"type":"text","text":"entire document. This attribute group is not used for a required id attribute, or for an id attribute that"},{"type":"text","text":" "},{"type":"text","text":"specifies an id reference."}],"type":"topic","title":"id","kind":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"id"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTime\/id","url":"\/documentation\/ivormxl\/mxltime\/id","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLTime":{"title":"MXLTime","navigatorTitle":[{"kind":"identifier","text":"MXLTime"}],"type":"topic","abstract":[{"type":"text","text":"Time signatures are represented by the beats element for the numerator and the beat-type element for the"},{"type":"text","text":" "},{"type":"text","text":"denominator. The symbol attribute is used to indicate common and cut time symbols as well as a single number"},{"type":"text","text":" "},{"type":"text","text":"display. Multiple pairs of beat and beat-type elements are used for composite time signatures with multiple"},{"type":"text","text":" "},{"type":"text","text":"denominators, such as 2\/4 + 3\/8. A composite such as 3+2\/8 requires only one beat\/beat-type pair."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTime"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTime","url":"\/documentation\/ivormxl\/mxltime"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"}}}