tual notes, the number of both actual and"},{"type":"text","text":" "},{"type":"text","text":"normal notes, or neither. It is actual by default. The show-type attribute is used to display either the"},{"type":"text","text":" "},{"type":"text","text":"actual type, both the actual and normal types, or neither. It is none by default."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Maps the MusicXML "},{"type":"codeVoice","code":"<tuplet>"},{"type":"text","text":" element."}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxltuplet"]}],"references":{"doc://IvorMXL/s16SendableMetatypeP":{"identifier":"doc:\/\/IvorMXL\/s16SendableMetatypeP","title":"Swift.SendableMetatype","type":"unresolvable"},"doc://IvorMXL/SQ":{"identifier":"doc:\/\/IvorMXL\/SQ","title":"Swift.Equatable","type":"unresolvable"},"doc://IvorMXL/documentation/IvorMXL/MXLTuplet/actual":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet\/actual","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"actual"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLTupletV7PortionV","text":"Portion"},{"kind":"text","text":"?"}],"role":"symbol","kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxltuplet\/actual","title":"actual","abstract":[{"type":"text","text":"The tuplet-actual element provide optional full control over how the actual part of the tuplet is displayed,"},{"type":"text","text":" "},{"type":"text","text":"including number and note type (with dots). If any of these elements are absent, their values are based on the"},{"type":"text","text":" "},{"type":"text","text":"time-modification element."}]},"doc://IvorMXL/documentation/IvorMXL/MXLTuplet/number":{"url":"\/documentation\/ivormxl\/mxltuplet\/number","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet\/number","fragments":[{"text":