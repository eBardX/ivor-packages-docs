{"sections":[],"kind":"symbol","variants":[{"paths":["\/documentation\/ivormxl\/mxlimage\/init(id:attributes:)"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLImage"},{"type":"text","text":"."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"init","kind":"keyword"},{"text":"(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"attributes","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLImage\/Attributes-swift.struct","preciseIdentifier":"s:7IvorMXL8MXLImageV10AttributesV","text":"Attributes","kind":"typeIdentifier"},{"text":")","kind":"text"}]}]},{"parameters":[{"name":"id","content":[{"type":"paragraph","inlineContent":[{"text":"The optional-unique-id attribute group allows an element to optionally specify an ID","type":"text"},{"text":" ","type":"text"},{"text":"that is unique to the entire document. This attribute group is not used for a required","type":"text"},{"text":" ","type":"text"},{"text":"id attribute, or for an id attribute that specifies an id reference.","type":"text"}]}]},{"name":"attributes","content":[{"inlineContent":[{"text":"The image-attributes group is used to include graphical images in a score. The required","type":"text"},{"text":" ","type":"text"},{"text":"source attribute is the URL for the image file. The required type attribute is the MIME","type":"text"},{"text":" ","type":"text"},{"text":"type for the image file format. Typical choices include application\/postscript,","type":"text"},{"text":" ","type":"text"},{"text":"image\/gif, image\/jpeg, image\/png, and image\/tiff. The optional height and width","type":"text"},{"text":" ","type":"text"},{"text":"attributes are used to size and scale an image. The image should be scaled","type":"text"},{"text":" ","type":"text"},{"text":"independently in X and Y if both height and width are specified. If only one attribute","type":"text"},{"text":" ","type":"text"},{"text":"is specified, the image should be scaled proportionally to fit in the specified","type":"text"},{"text":" ","type":"text"},{"text":"dimension.","type":"text"}],"type":"paragraph"}]}],"kind":"parameters"}],"metadata":{"title":"init(id:attributes:)","role":"symbol","externalID":"s:7IvorMXL8MXLImageV2id10attributesACSSSg_AC10AttributesVtcfc","roleHeading":"Initializer","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"attributes","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL8MXLImageV10AttributesV","text":"Attributes","kind":"typeIdentifier"},{"text":")","kind":"text"}],"modules":[{"name":"IvorMXL"}],"symbolKind":"init"},"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLImage\/init(id:attributes:)"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLImage"]]},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLImage":{"type":"topic","abstract":[{"text":"The image type is used to include graphical images in a score.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlimage","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLImage"}],"kind":"symbol","title":"MXLImage","navigatorTitle":[{"kind":"identifier","text":"MXLImage"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLImage","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLImage/Attributes-swift.struct":{"kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Attributes","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLImage\/Attributes-swift.struct","type":"topic","abstract":[{"text":"The image-attributes group is used to include graphical images in a score. The required source attribute is","type":"text"},{"text":" ","type":"text"},{"text":"the URL for the image file. The required type attribute is the MIME type for the image file format. Typical","type":"text"},{"text":" ","type":"text"},{"text":"choices include application\/postscript, image\/gif, image\/jpeg, image\/png, and image\/tiff. The optional height","type":"text"},{"text":" ","type":"text"},{"text":"and width attributes are used to size and scale an image. The image should be scaled independently in X and Y","type":"text"},{"text":" ","type":"text"},{"text":"if both height and width are specified. If only one attribute is specified, the image should be scaled","type":"text"},{"text":" ","type":"text"},{"text":"proportionally to fit in the specified dimension.","type":"text"}],"title":"MXLImage.Attributes","url":"\/documentation\/ivormxl\/mxlimage\/attributes-swift.struct","navigatorTitle":[{"text":"Attributes","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLImage/init(id:attributes:)":{"title":"init(id:attributes:)","role":"symbol","url":"\/documentation\/ivormxl\/mxlimage\/init(id:attributes:)","abstract":[{"text":"Creates a new ","type":"text"},{"type":"codeVoice","code":"MXLImage"},{"text":".","type":"text"}],"type":"topic","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"id","kind":"extern