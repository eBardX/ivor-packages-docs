 group allows an element to optionally specify an ID that is unique to the entire document. This attribute group is not used for a required id attribute, or for an id attribute that specifies an id reference."}]}]},{"name":"attributes","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The image-attributes group is used to include graphical images in a score. The required source attribute is the URL for the image file. The required type attribute is the MIME type for the image file format. Typical choices include application\/postscript, image\/gif, image\/jpeg, image\/png, and image\/tiff. The optional height and width attributes are used to size and scale an image. The image should be scaled independently in X and Y if both height and width are specified. If only one attribute is specified, the image should be scaled proportionally to fit in the specified dimension."}]}]}],"kind":"parameters"}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLImage":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlimage","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLImage","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLImage","kind":"identifier"}],"abstract":[{"type":"text","text":"The image type is used to include graphical images in a score."}],"kind":"symbol","type":"topic","navigatorTitle":[{"text":"MXLImage","kind":"identifier"}],"title":"MXLImage"},"doc://IvorMXL/documentation/IvorMXL/MXLImage/init(id:attributes:)":{"type":"topic","abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLImage"},{"type":"text","text":"."}],"url":"\/documentation\/ivormxl\/mxlimage\/init(id:attributes:)","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLImage\/init(id:attributes:)","title":"init(id:attributes:)","kind":"symbol","role":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"