s":{"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLImage/Attributes-swift.struct":{"kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Attributes","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLImage\/Attributes-swift.struct","type":"topic","abstract":[{"text":"The image-attributes group is used to include graphical images in a score. The required source attribute is","type":"text"},{"text":" ","type":"text"},{"text":"the URL for the image file. The required type attribute is the MIME type for the image file format. Typical","type":"text"},{"text":" ","type":"text"},{"text":"choices include application\/postscript, image\/gif, image\/jpeg, image\/png, and image\/tiff. The optional height","type":"text"},{"text":" ","type":"text"},{"text":"and width attributes are used to size and scale an image. The image should be scaled independently in X and Y","type":"text"},{"text":" ","type":"text"},{"text":"if both height and width are specified. If only one attribute is specified, the image should be scaled","type":"text"},{"text":" ","type":"text"},{"text":"proportionally to fit in the specified dimension.","type":"text"}],"title":"MXLImage.Attributes","url":"\/documentation\/ivormxl\/mxlimage\/attributes-swift.struct","navigatorTitle":[{"text":"Attributes","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLValignImage":{"kind":"symbol","abstract":[{"text":"The valign-image type is used to indicate vertical alignment for images and graphics, so it does not include a","type":"text"},{"text":" ","type":"text"},{"text":"baseline value. Defaults are implementation-dependent.","type":"text"}]