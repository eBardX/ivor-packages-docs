"codeVoice"},{"type":"text","text":"."}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLImage/Attributes-swift.struct":{"role":"symbol","abstract":[{"type":"text","text":"The image-attributes group is used to include graphical images in a score. The required source attribute is"},{"type":"text","text":" "},{"type":"text","text":"the URL for the image file. The required type attribute is the MIME type for the image file format. Typical"},{"type":"text","text":" "},{"type":"text","text":"choices include application\/postscript, image\/gif, image\/jpeg, image\/png, and image\/tiff. The optional height"},{"type":"text","text":" "},{"type":"text","text":"and width attributes are used to size and scale an image. The image should be scaled independently in X and Y"},{"type":"text","text":" "},{"type":"text","text":"if both height and width are specified. If only one attribute is specified, the image should be scaled"},{"type":"text","text":" "},{"type":"text","text":"proportionally to fit in the specified dimension."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLImage\/Attributes-swift.struct","url":"\/documentation\/ivormxl\/mxlimage\/attributes-swift.struct","title":"MXLImage.Attributes","navigatorTitle":[{"kind":"identifier","text":"Attributes"}],"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Attributes"}]},"doc://IvorMXL/documentation/IvorMXL/MXLImage":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLImage"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLImage"}],"url":"\/documentation\/ivormxl\/mxlimage","role":"symbol","title":"MXLImage","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLImage","type":"topic","abstract":[{"type":"text","text":"The image type is used to include graphical images in a score."}]},"doc://IvorMXL/documentation/IvorMXL/MXLImage/Attributes-swift.stru