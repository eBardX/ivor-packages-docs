mension; if only one is specified, the image is scaled proportionally to","type":"text"},{"type":"text","text":" "},{"type":"text","text":"fit that dimension."}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLImage":{"url":"\/documentation\/ivormxl\/mxlimage","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLImage"}],"title":"MXLImage","abstract":[{"type":"text","text":"The image type is used to include graphical images in a score."}],"navigatorTitle":[{"kind":"identifier","text":"MXLImage"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLImage"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLImage/Attributes-swift.struct/width":{"url":"\/documentation\/ivormxl\/mxlimage\/attributes-swift.struct\/width","title":"width","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"width","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLTenths","preciseIdentifier":"s:7IvorMXL9MXLTenthsa","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLImage\/Attributes-swift.struct\/width","abstract":[{"text":"The width used to size and scale the image. If both ","type":"text"},{"code":"width","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"height","type":"codeVoice"},{"text":" are specified, the image is","type":"text"},{"text":" ","type":"text"},{"text":"scaled independently in each dimension; if only one is specified, the image is scaled proportionally to","type":"text"},{"text":" ","type":"text"},{"text":"fit that dimension.","type":"text"}],"kind":"symbol","role":"symbol","type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLImage/Attributes-swift.struct":{"url":"\/documentation\/ivormxl\/mxlimage\/attributes-swift.struct","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Attributes"}],"title":"MXLImage.Attributes","abstract":[{"type":"text","text":"The image-attributes group is used to include graphical images in a score. The required source attribute is"},{"type":"text","text":" "},{"type":"text","text":"the URL for the image file. The required type attribute is the MIME type for the image file format. Typical"},{"type":"text","text":" "},{"type":"text","text":"choices include application\/postscript, image\/gif, image\/jpeg, image\/png, and image\/tiff. The optional height"},{"type":"text","text":" "},{"type":"text","text":"and width attributes are used to size and scale an image. The image should be scaled independently in X and Y"},{"type":"text","text":" "},{"type":"text","text":"if both height and width are specified. If only one attribute is specified, the image should be scaled"},{"type":"text","text":" "},{"type":"text","text":"proportionally to fit in the specified dimension."}],"navigatorTitle":[{"kind":"identifier","text":"Attributes"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLImage\/Attributes-swift.struct"},"doc://IvorMXL/documentation/IvorMXL/MXLTenths":{"title":"MXLTenths","type":"topic","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTenths","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxltenths","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"MXLTenths","kind":"identifier"}],"abstract":[{"type":"text","text":"The tenths type is a number representing tenths of interline staff space (positive or negative). Both integer"},{"type":"text","text":" "},{"type":"text","text":"and decimal values are allowed, such as 5 for a half space and 2.5 for a quarter space. Interline space is"},{"type":"text","text":" "},{"type":"text","text":"measured from the middle of a staff line."}]}}}