ibutes-swift.struct\/width"},"doc://IvorMXL/documentation/IvorMXL/MXLImage/Attributes-swift.struct":{"abstract":[{"type":"text","text":"The image-attributes group is used to include graphical images in a score. The required source attribute is"},{"text":" ","type":"text"},{"type":"text","text":"the URL for the image file. The required type attribute is the MIME type for the image file format. Typical"},{"type":"text","text":" "},{"text":"choices include application\/postscript, image\/gif, image\/jpeg, image\/png, and image\/tiff. The optional height","type":"text"},{"text":" ","type":"text"},{"text":"and width attributes are used to size and scale an image. The image should be scaled independently in X and Y","type":"text"},{"text":" ","type":"text"},{"text":"if both height and width are specified. If only one attribute is specified, the image should be scaled","type":"text"},{"type":"text","text":" "},{"type":"text","text":"proportionally to fit in the specified dimension."}],"title":"MXLImage.Attributes","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Attributes","kind":"identifier"}],"navigatorTitle":[{"text":"Attributes","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlimage\/attributes-swift.struct","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLImage\/Attributes-swift.struct"},"doc://IvorMXL/documentation/IvorMXL/MXLImage":{"abstract":[{"text":"The image type is used to include graphical images in a score.","type":"text"}],"title":"MXLImage","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLImage","kind":"identifier"}],"navigatorTitle":[{"text":"MXLImage","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlimage","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLImage"},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, 