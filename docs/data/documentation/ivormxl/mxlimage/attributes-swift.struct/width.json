atch":0,"minor":3,"major":0},"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLImage\/Attributes-swift.struct\/width","interfaceLanguage":"swift"},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLImage/Attributes-swift.struct":{"role":"symbol","abstract":[{"type":"text","text":"The image-attributes group is used to include graphical images in a score. The required source attribute is"},{"type":"text","text":" "},{"type":"text","text":"the URL for the image file. The required type attribute is the MIME type for the image file format. Typical"},{"type":"text","text":" "},{"type":"text","text":"choices include application\/postscript, image\/gif, image\/jpeg, image\/png, and image\/tiff. The optional height"},{"type":"text","text":" "},{"type":"text","text":"and width attributes are used to size and scale an image. The image should be scaled independently in X and Y"},{"type":"text","text":" "},{"type":"text","text":"if both height and width are specified. If only one attribute is specified, the image should be scaled"},{"type":"text","text":" "},{"type":"text","text":"proportionally to fit in the specified dimension."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLImage\/Attributes-swift.struct","url":"\/documentation\/ivormxl\/mxlimage\/attributes-swift.struct","title":"MXLImage.Attributes","navigatorTitle":[{"kind":"identifier","text":"Attributes"}],"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Attributes"}]},"doc://IvorMXL/documentation/IvorMXL/MXLTenths":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLTenths"}],"abstract":[{"type":"text","text":"The tenths type is a number representing tenths of interline staff space (positive or negative). Both integer"},{"type":"text","text":" "},{"type":"text","text":"and decimal values are allowed, such as 5 for a half space and 2.5 for a quarter space. Interline space is"},{"type":"text","text":" "},{"type":"text","text":"measured from the middle of a staff line."}],"kind":"symbol","title":"MXLTenths","url":"\/documentation\/ivormxl\/mxltenths","role":"symbol","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTenths"}]},"doc://IvorMXL/documentation/IvorMXL/MXLImage":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLImage"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLImage"}],"url":"\/documentation\/ivormxl\/mxlimage","role":"symbol","title":"MXLImage","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLImage","type":"topic","abstract":[{"type":"text","text":"The image type is used to include graphical images in a score."}]},"doc://IvorMXL/documentation/IvorMXL/MXLImage/Attributes-swift.struct/width":{"abstract":[{"type":"text","text":"The width used to size and scale the image. If both "},{"code":"width","type":"codeVoice"},{"type":"text","text":" and "},{"code":"height","type":"codeVoice"},{"type":"text","text":" are specified, the image is"},{"type":"text","text":" "},{"type":"text","text":"scaled independently in each dimension; if only one is specified, the image is scaled proportionally to"},{"type":"text","text":" "},{"type":"text","text":"fit that dimension."}],"role":"symbol","title":"width","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"text":"width","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL9MXLTenthsa","text":"MXLTenths","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlimage\/attributes-swift.struct\/width","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLImage\/Attributes-swift.struct\/width"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A Mu