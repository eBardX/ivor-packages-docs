":"halign"},{"content":[{"inlineContent":[{"type":"text","text":"The valign-image attribute is used to indicate vertical alignment for images and graphics, so it removes the baseline value. Defaults are implementation-dependent."}],"type":"paragraph"}],"name":"valign"}]}],"kind":"symbol","abstract":[{"text":"Creates a new ","type":"text"},{"type":"codeVoice","code":"MXLImage.Attributes"},{"text":".","type":"text"}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlimage\/attributes-swift.struct\/init(source:kind:height:width:position:halign:valign:)"]}],"references":{"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLTenths":{"title":"MXLTenths","kind":"symbol","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTenths"}],"abstract":[{"type":"text","text":"The tenths type is a number representing tenths of interline staff space (positive or negative). Both integer"},{"type":"text","text":" "},{"type":"text","text":"and decimal values are allowed, such as 5 for a half space and 2.5 for a quarter space. Interline space is"},{"type":"text","text":" "},{"type":"text","text":"measured from the middle of a staff line."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLTenths"}],"url":"\/documentation\/ivormxl\/mxltenths"},"doc://IvorMXL/documentation/IvorMXL/MXLPosition":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlposition","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPosition"}],"kind":"symbol","abstract":[{"text":"For most elements, any program will compute a default x and y position. The position attributes let this be","type":"text"},{"text":" ","type":"text"},{"text":"changed two ways.","type":"text"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLPosition"}],"title":"MXLPosition"},"doc://IvorMXL/documentation/IvorMXL/MXLImage":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlimage","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLImage","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLImage","kind":"identifier"}],"abstract":[{"type":"text","text":"The image type is used to include graphical images in a score."}],"kind":"symbol","type":"topic","navigatorTitle":[{"text":"MXLImage","kind":"identifier"}],"title":"MXLImage"},"doc://IvorMXL/documentation/IvorMXL/MXLValignImage":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValignImage","url":"\/documentation\/ivormxl\/mxlvalignimage","title":"MXLValignImage","type":"topic","kind":"symbol","abstract":[{"text":"The valign-image type is used to indicate vertical alignment for images and graphics, so it does not include a","type":"text"},{"text":" ","type":"text"},{"text":"baseline value. Defaults are implementation-dependent.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLValignImage"}],"navigatorTitle":[{"kind":"identifier","text":"MXLValignImage"}]},"doc://IvorMXL/documentation/IvorMXL/MXLImage/Attributes-swift.struct":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlimage\/attributes-swift.struct","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLImage\/Attributes-swift.struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Attributes","kind":"identifier"}],"abstract":[{"type":"text","text":"The image-attributes group is used to include graphical images in a score. The required source attribute is"},{"type":"text","text":" "},{"type":"text","text":"the URL for the image file. The required type attribute is the MIME type for the image file format. Typical"},{"type":"text","text":" "},{"type":"text","text":"choices include application\/postscript, image\/gif, image\/jpeg, image\/png, and image\/tiff. The optional height"},{"type":"text","text":" "},{"type":"text","text":"and width attributes are used to size and scale an image. The image should be scaled independently in X and Y"},{"type":"text","text":" "},{"type":"text","text":"if both height and width are specified. If only one attribute is specified, the image should be scaled"},{"type":"text","text":" "},{"type":"text","text":"proportionally to fit in the specified dimension."}],"kind":"symbol","type":"topic","navigatorTitle":[{"text":"Attributes","kind":"identifier"}],"title":"MXLImage.Attributes"},"doc://IvorMXL/documentation/IvorMXL/MXLImage/Attributes-swift.struct/init(source:kind:height:width:position:halign:valign:)":{"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLImage\/Attributes-swift.struct\/init(source:kind:height:width:position:halign:valign:)","title":"init(source:kind:height:width:position:halign:valign:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"source"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam","text":"kind"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam","text":"height"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLTenths","preciseIdentifier":"s:7IvorMXL9MXLTenthsa"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"width"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLTenths","preciseIdent