one line, horizontal alignment and justify values can be different. The most typical case is for credits, such as:"}],"type":"paragraph"}],"name":"halign"},{"content":[{"inlineContent":[{"type":"text","text":"The valign-image attribute is used to indicate vertical alignment for images and graphics, so it removes the baseline value. Defaults are implementation-dependent."}],"type":"paragraph"}],"name":"valign"}]}],"variants":[{"paths":["\/documentation\/ivormxl\/mxlimage\/attributes-swift.struct\/init(source:kind:height:width:position:halign:valign:)"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","references":{"doc://IvorMXL/documentation/IvorMXL/MXLValignImage":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValignImage","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLValignImage","kind":"identifier"}],"title":"MXLValignImage","abstract":[{"type":"text","text":"The valign-image type is used to indicate vertical alignment for images and graphics, so it does not include a"},{"type":"text","text":" "},{"type":"text","text":"baseline value. Defaults are implementation-dependent."}],"navigatorTitle":[{"text":"MXLValignImage","kind":"identifier"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlvalignimage"},"doc://IvorMXL/documentation/IvorMXL/MXLImage/Attributes-swift.struct/init(source:kind:height:width:position:halign:valign:)":{"url":"\/documentation\/ivormxl\/mxlimage\/attributes-swift.struct\/init(source:kind:height:width:position:halign:valign:)","title":"init(source:kind:height:width:position:halign:valign:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"source","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"kind","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"type