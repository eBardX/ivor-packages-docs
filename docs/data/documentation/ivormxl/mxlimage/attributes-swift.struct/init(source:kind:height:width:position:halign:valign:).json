,{"type":"text","text":" "},{"type":"text","text":"if both height and width are specified. If only one attribute is specified, the image should be scaled"},{"type":"text","text":" "},{"type":"text","text":"proportionally to fit in the specified dimension."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLImage\/Attributes-swift.struct","url":"\/documentation\/ivormxl\/mxlimage\/attributes-swift.struct","title":"MXLImage.Attributes","navigatorTitle":[{"kind":"identifier","text":"Attributes"}],"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Attributes"}]},"doc://IvorMXL/documentation/IvorMXL/MXLValignImage":{"abstract":[{"text":"The valign-image type is used to indicate vertical alignment for images and graphics, so it does not include a","type":"text"},{"text":" ","type":"text"},{"text":"baseline value. Defaults are implementation-dependent.","type":"text"}],"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLValignImage"}],"navigatorTitle":[{"kind":"identifier","text":"MXLValignImage"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlvalignimage","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValignImage","title":"MXLValignImage"},"doc://IvorMXL/documentation/IvorMXL/MXLTenths":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLTenths"}],"abstract":[{"type":"text","text":"The tenths type is a number representing tenths of interline staff space (positive or negative). Both integer"},{"type":"text","text":" "},{"type":"text","text":"and decimal values are allowed, such as 5 for a half space and 2.5 for a quarter space. Interline space is"},{"type":"text","text":" "},{"type":"text","text":"measured from the middle of a staff line."}],"kind":"symbol","title":"MXLTenths","url":"\/documentation\/ivo