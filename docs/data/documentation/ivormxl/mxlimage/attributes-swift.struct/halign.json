tract":[{"text":"The image-attributes group is used to include graphical images in a score. The required source attribute is","type":"text"},{"text":" ","type":"text"},{"text":"the URL for the image file. The required type attribute is the MIME type for the image file format. Typical","type":"text"},{"text":" ","type":"text"},{"text":"choices include application\/postscript, image\/gif, image\/jpeg, image\/png, and image\/tiff. The optional height","type":"text"},{"text":" ","type":"text"},{"text":"and width attributes are used to size and scale an image. The image should be scaled independently in X and Y","type":"text"},{"text":" ","type":"text"},{"text":"if both height and width are specified. If only one attribute is specified, the image should be scaled","type":"text"},{"text":" ","type":"text"},{"text":"proportionally to fit in the specified dimension.","type":"text"}],"title":"MXLImage.Attributes","url":"\/documentation\/ivormxl\/mxlimage\/attributes-swift.struct","navigatorTitle":[{"text":"Attributes","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLLeftCenterRight":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLLeftCenterRight"}],"title":"MXLLeftCenterRight","abstract":[{"text":"The left-center-right type is used to define horizontal alignment and text justification.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLeftCenterRight","role":"symbol","url":"\/documentation\/ivormxl\/mxlleftcenterright","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLLeftCenterRight"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLImage":{"type":"topic","abstract":[{"text":"The image type is used to include graphical images in a score.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlimage","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLImage"}],"kind":"symbol","title":"MXLImage","navigator