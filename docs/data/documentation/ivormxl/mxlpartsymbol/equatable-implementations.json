{"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartSymbol"]]},"kind":"article","schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlpartsymbol\/equatable-implementations"]}],"metadata":{"roleHeading":"API Collection","modules":[{"name":"IvorMXL"}],"role":"collectionGroup","title":"Equatable Implementations"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartSymbol\/Equatable-Implementations"},"topicSections":[{"title":"Operators","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartSymbol\/!=(_:_:)"],"generated":true,"anchor":"Operators"}],"sections":[],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLPartSymbol":{"type":"topic","abstract":[{"type":"text","text":"The part-symbol type indicates how a symbol for a multi-staff part is indicated in the score; brace is the"},{"type":"text","text":" "},{"type":"text","text":"default value. The top-staff and bottom-staff attributes are used when the brace does not extend across the"},{"type":"text","text":" "},{"type":"text","text":"entire part. For example, in a 3-staff organ part, the top-staff will typically be 1 for the right hand, while"},{"type":"text","text":" "},{"type":"text","text":"the bottom-staff will typically be 2 for the left hand. Staff 3 for the pedals is usually outside the brace."},{"type":"text","text":" "},{"type":"text","text":"By default, the presence of a part-symbol element that does not extend across the entire part also indicates a"},{"type":"text","text":" "},{"type":"text","text":"corresponding change in the common barlines within a part."}],"kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLPartSymbol"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartSymbol","title":"MXLPartSymbol","url":"\/documentation\/ivormxl\/mxlpartsymbol","fragme