:[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLPartSymbol/!=(_:_:)":{"title":"!=(_:_:)","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"!=","kind":"identifier"},{"text":" ","kind":"text"},{"text":"(","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartSymbol\/!=(_:_:)","url":"\/documentation\/ivormxl\/mxlpartsymbol\/!=(_:_:)","kind":"symbol","role":"symbol","abstract":[],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLPartSymbol":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlpartsymbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartSymbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPartSymbol","kind":"identifier"}],"abstract":[{"type":"text","text":"The part-symbol type indicates how a symbol for a multi-staff part is indicated in the score; brace is the"},{"type":"text","text":" "},{"type":"text","text":"default value. The top-staff and bottom-staff attributes are used when the brace does not extend across the"},{"type":"text","text":" "},{"type":"text","text":"entire part. For example, in a 3-staff organ part, the top-staff will typically be 1 for the right hand, while"},{"type":"text","text":" "},{"type":"text","text":"the bottom-staff will typically be 2 for the left hand. Staff 3 for the pedals is usually outside the brace."},{"type":"text","text":" "},{"type":"text","text":"By default, the presence of a part-symbol element that does not extend across the entire part also indicates a"},{"type":"text","text":" "},{"type":"text","text":"corresponding change in the common barlines within a part."}],"kind":"symbol","type":"topic","navigatorTitle":[{"text":"MXLPartSymbol","kind":"identifier"}],"title":"MXLPartSymbol"}}}