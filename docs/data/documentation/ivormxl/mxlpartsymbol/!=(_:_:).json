ic","abstract":[{"type":"text","text":"The part-symbol type indicates how a symbol for a multi-staff part is indicated in the score; brace is the"},{"type":"text","text":" "},{"type":"text","text":"default value. The top-staff and bottom-staff attributes are used when the brace does not extend across the"},{"type":"text","text":" "},{"type":"text","text":"entire part. For example, in a 3-staff organ part, the top-staff will typically be 1 for the right hand, while"},{"type":"text","text":" "},{"type":"text","text":"the bottom-staff will typically be 2 for the left hand. Staff 3 for the pedals is usually outside the brace."},{"type":"text","text":" "},{"type":"text","text":"By default, the presence of a part-symbol element that does not extend across the entire part also indicates a"},{"type":"text","text":" "},{"type":"text","text":"corresponding change in the common barlines within a part."}],"kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLPartSymbol"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartSymbol","title":"MXLPartSymbol","url":"\/documentation\/ivormxl\/mxlpartsymbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPartSymbol"}]},"doc://IvorMXL/documentation/IvorMXL/MXLPartSymbol/!=(_:_:)":{"kind":"symbol","title":"!=(_:_:)","role":"symbol","url":"\/documentation\/ivormxl\/mxlpartsymbol\/!=(_:_:)","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"!=","kind":"identifier"},{"text":" ","kind":"text"},{"text":"(","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"abstract":[],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartSymbol\/!=(_:_:)","type":"topic"},"doc://IvorMXL/documen