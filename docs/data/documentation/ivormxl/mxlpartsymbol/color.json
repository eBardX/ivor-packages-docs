{"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartSymbol"]]},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"color"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLColorV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","text":"MXLColor"},{"kind":"text","text":"?"}]}],"kind":"declarations"}],"abstract":[{"type":"text","text":"The color attribute group indicates the color of an element."}],"sections":[],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartSymbol\/color","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/ivormxl\/mxlpartsymbol\/color"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","metadata":{"role":"symbol","modules":[{"name":"IvorMXL"}],"symbolKind":"property","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"color"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLColorV","text":"MXLColor"},{"kind":"text","text":"?"}],"externalID":"s:7IvorMXL13MXLPartSymbolV5colorAA8MXLColorVSgvp","title":"color","roleHeading":"Instance Property"},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLPartSymbol/color":{"url":"\/documentation\/ivormxl\/mxlpartsymbol\/color","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartSymbol\/color","title":"color","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"color","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLColor","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLColorV"},{"text":"?","kind":"text"}],"abstract":[{"text":"The color attribute group indicates the color of an element.","type":"text"}],"role":"symbol","type":"topic","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLPartSymbol":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartSymbol","navigatorTitle":[{"text":"MXLPartSymbol","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlpartsymbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPartSymbol","kind":"identifier"}],"title":"MXLPartSymbol","abstract":[{"text":"The part-symbol type indicates how a symbol for a multi-staff part is indicated in the score; brace is the","type":"text"},{"text":" ","type":"text"},{"text":"default value. The top-staff and bottom-staff attributes are used when the brace does not extend across the","type":"text"},{"text":" ","type":"text"},{"text":"entire part. For example, in a 3-staff organ part, the top-staff will typically be 1 for the right hand, while","type":"text"},{"text":" ","type":"text"},{"text":"the bottom-staff will typically be 2 for the left hand. Staff 3 for the pedals is usually outside the brace.","type":"text"},{"text":" ","type":"text"},{"text":"By default, the presence of a part-symbol element that does not extend across the entire part also indicates a","type":"text"},{"text":" ","type":"text"},{"text":"corresponding change in the common barlines within a part.","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"type":"topic","abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"type":"text","text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is"},{"type":"text","text":" "},{"type":"text","text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF."}],"url":"\/documentation\/ivormxl\/mxlcolor","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"kind":"symbol","title":"MXLColor","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","role":"symbol"}}}