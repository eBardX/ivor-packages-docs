{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlpartsymbol\/color"]}],"metadata":{"roleHeading":"Instance Property","externalID":"s:7IvorMXL13MXLPartSymbolV5colorAA8MXLColorVSgvp","title":"color","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"color","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLColor","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLColorV"},{"kind":"text","text":"?"}],"role":"symbol","modules":[{"name":"IvorMXL"}],"symbolKind":"property"},"abstract":[{"type":"text","text":"The color attribute group indicates the color of an element."}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartSymbol"]]},"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"color","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLColor","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLColorV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor"},{"text":"?","kind":"text"}],"languages":["swift"],"platforms":["macOS"]}]}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartSymbol\/color","interfaceLanguage":"swift"},"references":{"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLPartSymbol/color":{"abstract":[{"text":"The color attribute group indicates the color of an element.","type":"text"}],"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlpartsymbol\/color","title":"color","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartSymbol\/color","type":"topic","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"color"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLColor","preciseIdentifier":"s:7IvorMXL8MXLColorV"},{"kind":"text","text":"?"}]},"doc://IvorMXL/documentation/IvorMXL/MXLPartSymbol":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlpartsymbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartSymbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPartSymbol","kind":"identifier"}],"abstract":[{"type":"text","text":"The part-symbol type indicates how a symbol for a multi-staff part is indicated in the score; brace is the"},{"type":"text","text":" "},{"type":"text","text":"default value. The top-staff and bottom-staff attributes are used when the brace does not extend across the"},{"type":"text","text":" "},{"type":"text","text":"entire part. For example, in a 3-staff organ part, the top-staff will typically be 1 for the right hand, while"},{"type":"text","text":" "},{"type":"text","text":"the bottom-staff will typically be 2 for the left hand. Staff 3 for the pedals is usually outside the brace."},{"type":"text","text":" "},{"type":"text","text":"By default, the presence of a part-symbol element that does not extend across the entire part also indicates a"},{"type":"text","text":" "},{"type":"text","text":"corresponding change in the common barlines within a part."}],"kind":"symbol","type":"topic","navigatorTitle":[{"text":"MXLPartSymbol","kind":"identifier"}],"title":"MXLPartSymbol"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"title":"MXLColor","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"abstract":[{"text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in","type":"text"},{"text":" ","type":"text"},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"url":"\/documentation\/ivormxl\/mxlcolor"}}}