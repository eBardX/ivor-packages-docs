text":"MXLGroupSymbolValue","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL19MXLGroupSymbolValueO"}],"title":"value","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartSymbol\/value","url":"\/documentation\/ivormxl\/mxlpartsymbol\/value"},"doc://IvorMXL/documentation/IvorMXL/MXLGroupSymbolValue":{"title":"MXLGroupSymbolValue","abstract":[{"type":"text","text":"The group-symbol-value type indicates how the symbol for a group or multi-staff part is indicated in the"},{"type":"text","text":" "},{"type":"text","text":"score."}],"url":"\/documentation\/ivormxl\/mxlgroupsymbolvalue","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLGroupSymbolValue"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLGroupSymbolValue"}],"type":"topic","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLGroupSymbolValue"},"doc://IvorMXL/documentation/IvorMXL/MXLPartSymbol":{"title":"MXLPartSymbol","abstract":[{"type":"text","text":"The part-symbol type indicates how a symbol for a multi-staff part is indicated in the score; brace is the"},{"type":"text","text":" "},{"type":"text","text":"default value. The top-staff and bottom-staff attributes are used when the brace does not extend across the"},{"type":"text","text":" "},{"type":"text","text":"entire part. For example, in a 3-staff organ part, the top-staff will typically be 1 for the right hand, while"},{"type":"text","text":" "},{"type":"text","text":"the bottom-staff will typically be 2 for the left hand. Staff 3 for the pedals is usually outside the brace."},{"type":"text","text":" "},{"type":"text","text":"By default, the presence of a part-symbol element that does not extend across the entire part also indicates a"},{"type":"text","text":" "},{"type":"text","text":"corresponding change in the common barlines within a part."}],"url":"\/documentation\/ivormxl\/mxlpartsymbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPartSymbol"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLPartSymbol"}],"type":"topic","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartSymbol"}}}