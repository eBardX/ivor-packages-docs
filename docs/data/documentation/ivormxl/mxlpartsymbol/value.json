{"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartSymbol\/value","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"The value of this element."}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"value","kind":"identifier"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLGroupSymbolValue","preciseIdentifier":"s:7IvorMXL19MXLGroupSymbolValueO","text":"MXLGroupSymbolValue","kind":"typeIdentifier"}],"platforms":["macOS"]}],"kind":"declarations"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlpartsymbol\/value"]}],"metadata":{"symbolKind":"property","roleHeading":"Instance Property","fragments":[{"text":"let","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"value"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLGroupSymbolValue","preciseIdentifier":"s:7IvorMXL19MXLGroupSymbolValueO"}],"externalID":"s:7IvorMXL13MXLPartSymbolV5valueAA08MXLGroupD5ValueOvp","role":"symbol","modules":[{"name":"IvorMXL"}],"title":"value"},"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","sections":[],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartSymbol"]]},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLPartSymbol/value":{"url":"\/documentation\/ivormxl\/mxlpartsymbol\/value","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartSymbol\/value","title":"value","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"value","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLGroupSymbolValue","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL19MXLGroupSymbolValueO"}],"abstract":[{"text":"The value of this element.","type":"text"}],"role":"symbol","type":"topic","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLPartSymbol":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartSymbol","navigatorTitle":[{"text":"MXLPartSymbol","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlpartsymbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPartSymbol","kind":"identifier"}],"title":"MXLPartSymbol","abstract":[{"text":"The part-symbol type indicates how a symbol for a multi-staff part is indicated in the score; brace is the","type":"text"},{"text":" ","type":"text"},{"text":"default value. The top-staff and bottom-staff attributes are used when the brace does not extend across the","type":"text"},{"text":" ","type":"text"},{"text":"entire part. For example, in a 3-staff organ part, the top-staff will typically be 1 for the right hand, while","type":"text"},{"text":" ","type":"text"},{"text":"the bottom-staff will typically be 2 for the left hand. Staff 3 for the pedals is usually outside the brace.","type":"text"},{"text":" ","type":"text"},{"text":"By default, the presence of a part-symbol element that does not extend across the entire part also indicates a","type":"text"},{"text":" ","type":"text"},{"text":"corresponding change in the common barlines within a part.","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLGroupSymbolValue":{"title":"MXLGroupSymbolValue","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLGroupSymbolValue"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlgroupsymbolvalue","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLGroupSymbolValue"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLGroupSymbolValue","abstract":[{"text":"The group-symbol-value type indicates how the symbol for a group or multi-staff part is indicated in the","type":"text"},{"text":" ","type":"text"},{"text":"score.","type":"text"}],"type":"topic"}}}