identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLStaffNumber":{"type":"topic","title":"MXLStaffNumber","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLStaffNumber"}],"url":"\/documentation\/ivormxl\/mxlstaffnumber","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffNumber","role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLStaffNumber"}],"abstract":[{"text":"The staff-number type indicates staff numbers within a multi-staff part. Staves are numbered from top to","type":"text"},{"text":" ","type":"text"},{"text":"bottom, with 1 being the top staff on a part.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLPartSymbol/topStaff":{"kind":"symbol","abstract":[{"type":"text","text":"The staff number of the topmost staff spanned by the symbol, used when the symbol does not extend across the"},{"type":"text","text":" "},{"type":"text","text":"entire part."}],"type":"topic","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"topStaff","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLStaffNumber","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL14MXLStaffNumberV"},{"text":"?","kind":"text"}],"title":"topStaff","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartSymbol\/topStaff","url":"\/documentation\/ivormxl\/mxlpartsymbol\/topstaff"},"doc://IvorMXL/documentation/IvorMXL/MXLPartSymbol":{"title":"MXLPartSymbol","abstract":[{"type":"text","text":"The part-symbol type indicates how a symbol for a multi-staff part is indicated in the score; brace is the"},{"type":"text","text":" "},{"type":"text","text":"default value. The top-staff and bottom-staff attributes are used when the brace does not extend across the"},{"type":"text","text":" "},{"type":"text","text