{"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartSymbol\/topStaff","interfaceLanguage":"swift"},"abstract":[{"text":"The staff number of the topmost staff spanned by the symbol, used when the symbol does not extend across the","type":"text"},{"text":" ","type":"text"},{"text":"entire part.","type":"text"}],"metadata":{"title":"topStaff","externalID":"s:7IvorMXL13MXLPartSymbolV8topStaffAA14MXLStaffNumberVSgvp","role":"symbol","symbolKind":"property","modules":[{"name":"IvorMXL"}],"roleHeading":"Instance Property","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"topStaff","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL14MXLStaffNumberV","text":"MXLStaffNumber","kind":"typeIdentifier"},{"text":"?","kind":"text"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlpartsymbol\/topstaff"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"topStaff","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL14MXLStaffNumberV","text":"MXLStaffNumber","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffNumber","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"inlineContent":[{"text":"Maps to the MusicXML ","type":"text"},{"code":"top-staff","type":"codeVoice"},{"text":" attribute.","type":"text"}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartSymbol"]]},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLPartSymbol":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartSymbol","navigatorTitle":[{"text":"MXLPartSymbol","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlpartsymbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPartSymbol","kind":"identifier"}],"title":"MXLPartSymbol","abstract":[{"text":"The part-symbol type indicates how a symbol for a multi-staff part is indicated in the score; brace is the","type":"text"},{"text":" ","type":"text"},{"text":"default value. The top-staff and bottom-staff attributes are used when the brace does not extend across the","type":"text"},{"text":" ","type":"text"},{"text":"entire part. For example, in a 3-staff organ part, the top-staff will typically be 1 for the right hand, while","type":"text"},{"text":" ","type":"text"},{"text":"the bottom-staff will typically be 2 for the left hand. Staff 3 for the pedals is usually outside the brace.","type":"text"},{"text":" ","type":"text"},{"text":"By default, the presence of a part-symbol element that does not extend across the entire part also indicates a","type":"text"},{"text":" ","type":"text"},{"text":"corresponding change in the common barlines within a part.","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLStaffNumber":{"type":"topic","title":"MXLStaffNumber","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffNumber","abstract":[{"type":"text","text":"The staff-number type indicates staff numbers within a multi-staff part. Staves are numbered from top to"},{"type":"text","text":" "},{"type":"text","text":"bottom, with 1 being the top staff on a part."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLStaffNumber"}],"navigatorTitle":[{"kind":"identifier","text":"MXLStaffNumber"}],"url":"\/documentation\/ivormxl\/mxlstaffnumber"},"doc://IvorMXL/documentation/IvorMXL/MXLPartSymbol/topStaff":{"title":"topStaff","type":"topic","identifier":"doc:\/\/IvorMXL\/documenta