tion","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLPartSymbol/bottomStaff":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartSymbol\/bottomStaff","abstract":[{"type":"text","text":"The staff number of the bottommost staff spanned by the symbol, used when the symbol does not extend across"},{"type":"text","text":" "},{"type":"text","text":"the entire part."}],"title":"bottomStaff","type":"topic","kind":"symbol","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"bottomStaff","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLStaffNumber","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL14MXLStaffNumberV"},{"text":"?","kind":"text"}],"url":"\/documentation\/ivormxl\/mxlpartsymbol\/bottomstaff"},"doc://IvorMXL/documentation/IvorMXL/MXLStaffNumber":{"type":"topic","title":"MXLStaffNumber","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLStaffNumber"}],"url":"\/documentation\/ivormxl\/mxlstaffnumber","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffNumber","role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLStaffNumber"}],"abstract":[{"text":"The staff-number type indicates staff numbers within a multi-staff part. Staves are numbered from top to","type":"text"},{"text":" ","type":"text"},{"text":"bottom, with 1 being the top staff on a part.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLPartSymbol":{"title":"MXLPartSymbol","abstract":[{"type":"text","text":"The part-symbol type indicates how a symbol for a multi-staff part is indicated in the score; brace is the"},{"type":"text","text":" "},{"type":"text","text":"default value. The top-staff and bottom-staff attributes are used when the brace does not extend across the"},{"type":"text","text":" "},{"type":"text","text":"entire part. For example, in a 3-staff organ part, the top-staff will typically be 1 for the right hand, while"},{"type":"text","text":" "},{"type":"text","text":"the bottom-staff will typically be 2 for the left hand. Staff 3 for the pedals is usually outside the brace."},{"type":"text","text":" "},{"type":"text","text":"By default, the presence of a part-symbol element that does not extend across the entire part also indicates a"},{"type":"text","text":" "},{"type":"text","text":"corresponding change in the common barlines within a part."}],"url":"\/documentation\/ivormxl\/mxlpartsymbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPartSymbol"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLPartSymbol"}],"type":"topic","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartSymbol"}}}