entifier","text":"MXLFeature"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFeature","abstract":[{"text":"The feature type is a part of the grouping element used for musical analysis. The type attribute represents","type":"text"},{"text":" ","type":"text"},{"text":"the type of the feature and the element content represents its value. This type is flexible to allow for","type":"text"},{"text":" ","type":"text"},{"text":"different analyses.","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLGrouping":{"type":"topic","title":"MXLGrouping","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLGrouping","abstract":[{"type":"text","text":"The grouping type is used for musical analysis. When the type attribute is “start” or “single”, it usually"},{"type":"text","text":" "},{"type":"text","text":"contains one or more feature elements. The number attribute is used for distinguishing between overlapping and"},{"type":"text","text":" "},{"type":"text","text":"hierarchical groupings. The member-of attribute allows for easy distinguishing of what grouping elements are"},{"type":"text","text":" "},{"type":"text","text":"in what hierarchy. Feature elements contained within a “stop” type of grouping may be ignored."}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLGrouping","kind":"identifier"}],"navigatorTitle":[{"text":"MXLGrouping","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlgrouping"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLGrouping/feature":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLGrouping\/feature","url":"\/documenta