{"kind":"symbol","sections":[],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValidator"]]},"metadata":{"extendedModule":"IvorMXL","navigatorTitle":[{"kind":"identifier","text":"Issue"}],"modules":[{"name":"IvorMXL"}],"externalID":"s:7IvorMXL12MXLValidatorV5IssueO","role":"symbol","title":"MXLValidator.Issue","roleHeading":"Enumeration","symbolKind":"enum","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Issue"}]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValidator\/Issue"},"relationshipsSections":[{"kind":"relationships","type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/IvorMXL\/s8CopyableP","doc:\/\/IvorMXL\/SQ","doc:\/\/IvorMXL\/s9EscapableP","doc:\/\/IvorMXL\/s8SendableP","doc:\/\/IvorMXL\/s16SendableMetatypeP"]}],"topicSections":[{"anchor":"Enumeration-Cases","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValidator\/Issue\/danglingPartID(_:)","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValidator\/Issue\/durationBeforeDivisions(part:measure:)","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValidator\/Issue\/unbalancedPartGroup(number:)","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValidator\/Issue\/unknownInstrumentSound(_:)","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValidator\/Issue\/unmatchedEndingStart(number:part:measure:)","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValidator\/Issue\/unmatchedEndingStop(number:part:measure:)","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValidator\/Issue\/unusedScorePart(_:)"],"generated":true,"title":"Enumeration Cases"},{"anchor":"Instance-Properties","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValidator\/Issue\/message"],"generated":true,"title":"Instance Properties"},{"generated":true,"title":"Default Implementations","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValidator\/Issue\/Equatable-Implementations"],"anchor":"Default-Implementations"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Issue"}],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"mentions","mentions":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/UsingIvorMXL"]},{"kind":"content","content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An issue describes conformance the schema cannot express and the parser"},{"type":"text","text":" "},{"type":"text","text":"does not enforce. The catalogue is deliberately confined to checks that"},{"type":"text","text":" "},{"type":"text","text":"are "},{"type":"emphasis","inlineContent":[{"type":"text","text":"sound on conforming input"}]},{"type":"text","text":" — a well-formed score never trips one —"},{"type":"text","text":" "},{"type":"text","text":"so that a reported issue is always a genuine defect and never a false"},{"type":"text","text":" "},{"type":"text","text":"alarm. Every check runs against the normalized part-wise score, so "},{"type":"codeVoice","code":"part"},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"measure"},{"type":"text","text":" labels are the part "},{"type":"codeVoice","code":"id"},{"type":"text","text":" and measure "},{"type":"codeVoice","code":"number"},{"type":"text","text":" from that"},{"type":"text","text":" "},{"type":"text","text":"score."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An opus is not checked at all: its schema is four elements and the parser"},{"type":"text","text":" "},{"type":"text","text":"already enforces nearly everything they constrain, so it passes straight"},{"type":"text","text":" "},{"type":"text","text":"through the validator."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Two checks the schema-diff proposal listed as candidates are deliberately"},{"type":"text","text":" "},{"type":"text","text":"absent, because they cannot be decided soundly from the AST alone:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Measure duration versus the prevailing "},{"code":"<time>","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"text","text":" MusicXML permits"},{"type":"text","text":" "},{"type":"text","text":"partial measures that are not flagged "},{"type":"codeVoice","code":"implicit"},{"type":"text","text":" (pickups, measures split"},{"type":"text","text":" "},{"type":"text","text":"across a repeat or a mid-measure meter change), so a short measure is not"},{"type":"text","text":" "},{"type":"text","text":"evidence of a defect."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Number-keyed spanner pairing ("},{"code":"<slur>","type":"codeVoice"},{"type":"text","text":", "},{"code":"<tuplet>","type":"codeVoice"},{"type":"text","text":", "},{"code":"<wedge>","type":"codeVoice"},{"type":"text","text":", and the"},{"type":"text","text":" "},{"type":"text","text":"like)."}]},{"type":"text","text":" The "},{"type":"codeVoice","code":"number"},{"type":"text","text":" level is reused across simultaneous voices, and the"},{"type":"text","text":" "},{"type":"text","text":"spec expressly allows a spanner’s start and stop to appear in arbitrary"},{"type":"text","text":" "},{"type":"text","text":"document order, so pairing them requires the per-voice onset timeline the"},{"type":"text","text":" "},{"type":"text","text":"resolver builds — not something the validator can settle. Unclosed"},{"type":"text","text":" "},{"type":"text","text":"spanners are also a common, non-fatal real-world imperfection."}]}]}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormx