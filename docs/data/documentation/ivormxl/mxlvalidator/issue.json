{"relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/IvorMXL\/s8CopyableP","doc:\/\/IvorMXL\/SQ","doc:\/\/IvorMXL\/s9EscapableP","doc:\/\/IvorMXL\/s8SendableP","doc:\/\/IvorMXL\/s16SendableMetatypeP"],"type":"conformsTo"}],"metadata":{"extendedModule":"IvorMXL","symbolKind":"enum","navigatorTitle":[{"kind":"identifier","text":"Issue"}],"externalID":"s:7IvorMXL12MXLValidatorV5IssueO","roleHeading":"Enumeration","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Issue"}],"role":"symbol","modules":[{"name":"IvorMXL"}],"title":"MXLValidator.Issue"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Issue"}]}]},{"kind":"mentions","mentions":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/UsingIvorMXL"]},{"kind":"content","content":[{"text":"Overview","anchor":"overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"An issue describes conformance the schema cannot express and the parser"},{"type":"text","text":" "},{"type":"text","text":"does not enforce. The catalogue is deliberately confined to checks that"},{"type":"text","text":" "},{"type":"text","text":"are "},{"inlineContent":[{"type":"text","text":"sound on conforming input"}],"type":"emphasis"},{"type":"text","text":" — a well-formed score never trips one —"},{"type":"text","text":" "},{"type":"text","text":"so that a reported issue is always a genuine defect and never a false"},{"type":"text","text":" "},{"type":"text","text":"alarm. Every check runs against the normalized part-wise score, so "},{"code":"part","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"measure"},{"type":"text","text":" labels are the part "},{"type":"codeVoice","code":"id"},{"type":"text","text":" and measure "},{"type":"codeVoice","code":"number"},{"type":"text","text":" from that"},{"type":"text","text":" "},{"type":"text","text":"score."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"An opus is not checked at all: its schema is four elements and the parser"},{"type":"text","text":" "},{"type":"text","text":"already enforces nearly everything they constrain, so it passes straight"},{"type":"text","text":" "},{"type":"text","text":"through the validator."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Two checks the schema-diff proposal listed as candidates are deliberately"},{"type":"text","text":" "},{"type":"text","text":"absent, because they cannot be decided soundly from the AST alone:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Measure duration versus the prevailing "},{"type":"codeVoice","code":"<time>"},{"type":"text","text":"."}],"type":"strong"},{"text":" MusicXML permits","type":"text"},{"text":" ","type":"text"},{"text":"partial measures that are not flagged ","type":"text"},{"code":"implicit","type":"codeVoice"},{"text":" (pickups, measures split","type":"text"},{"text":" ","type":"text"},{"text":"across a repeat or a mid-measure meter change), so a short measure is not","type":"text"},{"text":" ","type":"text"},{"text":"evidence of a defect.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Number-keyed spanner pairing ("},{"type":"codeVoice","code":"<slur>"},{"type":"text","text":", "},{"type":"codeVoice","code":"<tuplet>"},{"type":"text","text":", "},{"type":"codeVoice","code":"<wedge>"},{"type":"text","text":", and the"},{"type":"text","text":" "},{"type":"text","text":"like)."}],"type":"strong"},{"text":" The ","type":"text"},{"code":"number","type":"codeVoice"},{"text":" level is reused across simultaneous voices, and the","type":"text"},{"text":" ","type":"text"},{"text":"spec expressly allows a spanner’s start and stop to appear in arbitrary","type":"text"},{"text":" ","type":"text"},{"text":"document order, so pairing them requires the per-voice onset timeline the","type":"text"},{"text":" ","type":"text"},{"text":"resolver builds — not something the validator can settle. Unclosed","type":"text"},{"text":" ","type":"text"},{"text":"spanners are also a common, non-fatal real-world imperfection.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlvalidator\/issue"]}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValidator\/Issue","interfaceLanguage":"swift"},"topicSections":[{"title":"Enumeration Cases","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValidator\/Issue\/danglingPartID(_:)","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValidator\/Issue\/durationBeforeDivisions(part:measure:)","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValidator\/Issue\/unbalancedPartGroup(number:)","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValidator\/Issue\/unknownInstrumentSound(_:)","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValidator\/Issue\/unpairedEnding(number:part:measure:)","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValidator\/Issue\/unusedScorePart(_:)"],"anchor":"Enumeration-Cases","generated":true},{"title":"Instance Properties","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValidator\/Issue\/message"],"anchor":"Instance-Properties","generated":true},{"title":"Default Implementations","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValidator\/Issue\/Equatable-Implementations"],"anchor":"Default-Implementations","generated":true}],"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"symbol","sections":[],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValidator"]]},"abstract":[{"text":"An issue found when validating an ","type":"text"},{"isActive":t