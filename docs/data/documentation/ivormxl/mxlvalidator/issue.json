{"relationshipsSections":[{"kind":"relationships","type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/IvorMXL\/s8CopyableP","doc:\/\/IvorMXL\/SQ","doc:\/\/IvorMXL\/s9EscapableP","doc:\/\/IvorMXL\/s8SendableP","doc:\/\/IvorMXL\/s16SendableMetatypeP"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlvalidator\/issue"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValidator\/Issue"},"sections":[],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Issue"}]}]},{"kind":"mentions","mentions":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/UsingIvorMXL"]},{"kind":"content","content":[{"type":"heading","anchor":"overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"An issue describes conformance the schema cannot express and the parser","type":"text"},{"text":" ","type":"text"},{"text":"does not enforce. The catalogue is deliberately confined to checks that","type":"text"},{"text":" ","type":"text"},{"text":"are ","type":"text"},{"inlineContent":[{"type":"text","text":"sound on conforming input"}],"type":"emphasis"},{"text":" — a well-formed score never trips one —","type":"text"},{"type":"text","text":" "},{"type":"text","text":"so that a reported issue is always a genuine defect and never a false"},{"type":"text","text":" "},{"type":"text","text":"alarm. Every check runs against the normalized part-wise score, so "},{"type":"codeVoice","code":"part"},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"measure"},{"type":"text","text":" labels are the part "},{"type":"codeVoice","code":"id"},{"text":" and measure ","type":"text"},{"code":"number","type":"codeVoice"},{"type":"text","text":" from that"},{"text":" ","type":"text"},{"type":"text","text":"score."}]},{"type":"paragraph","inlineContent":[{"text":"An opus is not checked at all: its schema is four elements and the parser","type":"text"},{"text":" ","type":"text"},{"text":"already enforces nearly everything they constrain, so it passes straight","type":"text"},{"text":" ","type":"text"},{"text":"through the validator.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Two checks the schema-diff proposal listed as candidates are deliberately","type":"text"},{"text":" ","type":"text"},{"text":"absent, because they cannot be decided soundly from the AST alone:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Measure duration versus the prevailing "},{"type":"codeVoice","code":"<time>"},{"type":"text","text":"."}]},{"type":"text","text":" MusicXML permits"},{"type":"text","text":" "},{"type":"text","text":"partial measures that are not flagged "},{"code":"implicit","type":"codeVoice"},{"type":"text","text":" (pickups, measures split"},{"type":"text","text":" "},{"type":"text","text":"across a repeat or a mid-measure meter change), so a short measure is not"},{"type":"text","text":" "},{"type":"text","text":"evidence of a defect."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Number-keyed spanner pairing ("},{"type":"codeVoice","code":"<slur>"},{"type":"text","text":", "},{"type":"codeVoice","code":"<tuplet>"},{"type":"text","text":", "},{"type":"codeVoice","code":"<wedge>"},{"type":"text","text":", and the"},{"type":"text","text":" "},{"type":"text","text":"like)."}]},{"type":"text","text":" The "},{"type":"codeVoice","code":"number"},{"type":"text","text":" level is reused across simultaneous voices, and the"},{"type":"text","text":" "},{"type":"text","text":"spec expressly allows a spanner’s start and stop to appear in arbitrary"},{"type":"text","text":" "},{"type":"text","text":"document order, so pairing them requires the per-voice onset timeline the"},{"type":"text","text":" "},{"type":"text","text":"resolver builds — not something the validator can settle. Unclosed"},{"type":"text","text":" "},{"type":"text","text":"spanners are also a common, non-fatal real-world imperfection."}]}]}]}]}],"metadata":{"roleHeading":"Enumeration","modules":[{"name":"IvorMXL"}],"externalID":"s:7IvorMXL12MXLValidatorV5IssueO","extendedModule":"IvorMXL","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Issue"}],"navigatorTitle":[{"kind":"identifier","text":"Issue"}],"symbolKind":"enum","title":"MXLValidator.Issue"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValidator"]]},"abstract":[{"text":"An issue found when validating an ","type":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDocument","isActive":true,"type":"reference"},{"text":" against the MusicXML","type":"text"},{"text":" ","type":"text"},{"text":"specification.","type":"text"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"topicSections":[{"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValidator\/Issue\/danglingPartID(_:)","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValidator\/Issue\/durationBeforeDivisions(part:measure:)","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValidator\/Issue\/unbalancedPartGroup(number:)","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValidator\/Issue\/unknownInstrumentSound(_:)","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValidator\/Issue\/unpairedEnding(number:part:measure:)","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValidator\/Issue\/unusedScorePart(_:)"],"anchor":"Enumeration-Cases","generated":true,"title":"Enumeration Cases"},{"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValidator\/Issue\/message"],"anchor":"Instance-Properties","generated":true,"title":"Instance P