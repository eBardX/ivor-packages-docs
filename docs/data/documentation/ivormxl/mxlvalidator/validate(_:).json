{"abstract":[{"text":"Validates the provided document against the MusicXML specification and","type":"text"},{"text":" ","type":"text"},{"text":"returns any issues found.","type":"text"}],"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"validate","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"document","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"MXLDocument","preciseIdentifier":"s:7IvorMXL11MXLDocumentV","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDocument"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"Error","preciseIdentifier":"s:7IvorMXL12MXLValidatorV5ErrorO","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValidator\/Error"},{"text":") -> (","kind":"text"},{"text":"MXLDocument","preciseIdentifier":"s:7IvorMXL11MXLDocumentV","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDocument"},{"text":", [","kind":"text"},{"text":"Issue","preciseIdentifier":"s:7IvorMXL12MXLValidatorV5IssueO","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValidator\/Issue"},{"text":"])","kind":"text"}]}]},{"parameters":[{"name":"document","content":[{"inlineContent":[{"text":"The document to validate.","type":"text"}],"type":"paragraph"}]}],"kind":"parameters"},{"content":[{"anchor":"return-value","text":"Return Value","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"A tuple of the validated document and an array of ","type":"text"},{"isActive":true,"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValidator\/Issue","type":"reference"},{"text":" ","type":"text"},{"text":"values. The document in the tuple is a copy of ","type":"t