{"sections":[],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValidator"]]},"abstract":[{"type":"text","text":"Validates the provided document against the MusicXML specification and"},{"type":"text","text":" "},{"type":"text","text":"returns any issues found."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"validate"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"text":" ","kind":"text"},{"text":"document","kind":"internalParam"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLDocument","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDocument","preciseIdentifier":"s:7IvorMXL11MXLDocumentV"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Error","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValidator\/Error","preciseIdentifier":"s:7IvorMXL12MXLValidatorV5ErrorO"},{"kind":"text","text":") -> ("},{"kind":"typeIdentifier","text":"MXLDocument","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDocument","preciseIdentifier":"s:7IvorMXL11MXLDocumentV"},{"kind":"text","text":", ["},{"kind":"typeIdentifier","text":"Issue","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValidator\/Issue","preciseIdentifier":"s:7IvorMXL12MXLValidatorV5IssueO"},{"kind":"text","text":"])"}],"platforms":["macOS"],"languages":["swift"]}]},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The document to validate."}]}],"name":"document"}],"kind":"parameters"},{"content":[{"text":"Return Value","type":"heading","anchor":"return-value","level":2},{"type":"paragraph","inlineContent":[{"text":"A tuple of the validated document and an array of ","type":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValidator\/Issue","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"values. The document in the tuple is a copy of ","type":"text"},{"code":"document","type":"codeVoice"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDocument\/isValidated","isActive":true,"type":"reference"},{"text":" set to ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" when no issues","type":"text"},{"text":" ","type":"text"},{"text":"are found; otherwise ","type":"text"},{"code":"document","type":"codeVoice"},{"text":" is returned unchanged","type":"text"},{"text":" ","type":"text"},{"text":"(re-validating after fixing issues is required). An empty","type":"text"},{"text":" ","type":"text"},{"text":"issues array means the document is fully conformant.","type":"text"}]}],"kind":"content"},{"content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"The document is checked for conformance the schema cannot express and the","type":"text"},{"text":" ","type":"text"},{"text":"parser does not enforce — referential integrity, durations declared before","type":"text"},{"text":" ","type":"text"},{"text":"any divisions, ending pairing, part-group balance, and standard instrument","type":"text"},{"text":" ","type":"text"},{"text":"sounds. Only checks that","type":"text"},{"text":" ","type":"text"},{"text":"are sound on conforming input are performed; see ","type":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValidator\/Issue","isActive":true,"type":"reference"},{"text":" for the ones","type":"text"},{"text":" ","type":"text"},{"text":"deliberately omitted. The checks run against the part-wise score; a","type":"text"},{"text":" ","type":"text"},{"text":"time-wise score (which the normalizer converts to part-wise, so the","type":"text"},{"text":" ","type":"text"},{"text":"canonical pipeline never presents one here) is projected to part-wis