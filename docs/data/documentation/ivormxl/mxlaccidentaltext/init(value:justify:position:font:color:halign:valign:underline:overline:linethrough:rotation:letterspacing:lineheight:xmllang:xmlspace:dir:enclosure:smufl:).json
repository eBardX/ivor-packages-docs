eIdentifier":"s:7IvorMXL18MXLRotationDegreesa","text":"MXLRotationDegrees","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRotationDegrees"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"letterSpacing"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL17MXLNumberOrNormalO","text":"MXLNumberOrNormal","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumberOrNormal"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"lineHeight"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL17MXLNumberOrNormalO","text":"MXLNumberOrNormal","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumberOrNormal"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"xmlLang"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"xmlSpace"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLXmlSpaceO","text":"MXLXmlSpace","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLXmlSpace"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"dir"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL16MXLTextDirectionO","text":"MXLTextDirection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTextDirection"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"enclosure"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL17MXLEnclosureShapeO","text":"MXLEnclosureShape","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnclosureShape"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"smufl"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL27MXLSmuflAccidentalGlyphNameV","text":"MXLSmuflAccidentalGlyphName","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSmuflAccidentalGlyphName"},{"kind":"text","text":"? = nil)"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The value of this element."}]}],"name":"value"},{"name":"justify","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The justify attribute is used to indicate left, center, or right justification. The default value varies for different elements. For elements where the justify attribute is present but the halign attribute is not, the justify attribute indicates horizontal alignment as well as justification."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For most elements, any program will compute a default x and y position. The position attributes let this be changed two ways."}]}],"name":"position"},{"name":"font","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The font attribute group gathers together attributes for determining the font within a credit or direction. They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of font names.The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font vs. a music font."}]}]},{"name":"color","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The color attribute group indicates the color of an element."}]}]},{"name":"halign","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In cases where text extends over more than one line, horizontal alignment and justify values can be different. The most typical case is for credits, such as:"}]}]},{"name":"valign","content":[{"type":"paragraph","inlineContent":[{"text":"The valign attribute is used to indicate vertical alignment to the top, middle, bottom, or baseline of the text. Defaults are implementation-dependent.","type":"text"}]}]},{"name":"underline","content":[{"type":"paragraph","inlineContent":[{"text":"The number of lines used to underline the text: ","type":"text"},{"code":"0","type":"codeVoice"},{"text":" (none), ","type":"text"},{"type":"codeVoice","code":"1"},{"type":"text","text":", "},{"type":"codeVoice","code":"2"},{"type":"text","text":", or "},{"type":"codeVoice","code":"3"},{"type":"text","text":"."}]}]},{"name":"overline","content":[{"type":"paragraph","inlineContent":[{"text":"The number of lines used to overline the text: ","type":"text"},{"code":"0","type":"codeVoice"},{"text":" (none), ","type":"text"},{"type":"codeVoice","code":"1"},{"type":"text","text":", "},{"type":"codeVoice","code":"2"},{"type":"text","text":", or "},{"type":"codeVoice","code":"3"},{"type":"text","text":"."}]}]},{"name":"lineThrough","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The number of lines used to strike through the text: "},{"type":"codeVoice","code":"0"},{"type":"text","text":" (none), "},{"type":"codeVoice","code":"1"},{"type":"text","text":", "},{"type":"codeVoice","code":"2"},{"type":"text","text":", or "},{"type":"codeVoice","code":"3"},{"type":"text","text":"."}]}]},{"name":"rotation","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The rotation attribute is used to rotate text around the alignment point specified by the halign and valign attributes. Positive values are clockwise rotations, while negative values are counter-clockwise rotations."}]}]},{"name":"letterSpacing","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The letter-spacing attribute specifies text tracking. Values are either “normal” or a number representing the number of ems to add between each letter. The number may be negative in order to subtract space. The default is normal, which allows flexibility of letter-spacing for purposes of text justification."}]}]},{"name":"lineHeight","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The line-height attribute specifies text leading. Values are either “normal” or a number representing the percentage of the current font height to use for leading. The default is “normal”. The exact normal value is implementation-dependent, but values between 100 and 120 are recommended."}]}]},{"name":"xmlLang","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The xml:lang attribute value."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The xml:space attribute value."}]}],"name":"xmlSpace"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The text-direction attribute is used to adjust and override the Unicode bidirectional text algorithm, similar to the Directionality data category in the W3C Internationalization Tag Set recommendation."}]}],"name":"dir"},{"name":"enclosure","content":[{"type":"paragraph","inlineContent":[{"text":"The enclosure attribute group is used to specify the formatting of an enclosure around text or symbols.","type":"text"}]}]},{"name":"smufl","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The SMuFL canonical glyph name used to specify a particular accidental character."}]}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlaccidentaltext\/init(value:justify:position:font:color:halign:valign:underline:overline:linethrough:rotation:letterspacing:lineheight:xmllang:xmlspace:dir:enclosure:smufl:)"]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"abstract":[{"text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in","type":"text"},{"type":"text","text":" "},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"title":"MXLColor","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlcolor","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor"},"doc://IvorMXL/documentation/IvorMXL/MXLXmlSpace":{"title":"MXLXmlSpace","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLXmlSpace","kind":"identifier"}],"kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxlxmlspace","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLXmlSpace","abstract":[{"type":"text","text":"The xml:space attribute value, as defined by the XML 1.0 specification."}],"navigatorTitle":[{"text":"MXLXmlSpace","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLLeftCenterRight":{"title":"MXLLeftCenterRight","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"kind":"text","text":" "},{"text":"MXLLeftCenterRight","kind":"identifier"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlleftcenterright","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLeftCenterRight","abstract":[{"text":"The left-center-right type is used to define horizontal alignment and text justification.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"MXLLeftCenterRight"}]},"doc://IvorMXL/documentation/IvorMXL/MXLTextDirection":{"kind":"symbol","navigatorTitle":[{"text":"MXLTextDirection","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxltextdirection","title":"MXLTextDirection","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTextDirection","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTextDirection","abstract":[{"text":"The text-direction type is used to adjust and override the Unicode bidirectional text algorithm, similar to","type":"text"},{"text":" ","type":"text"},{"text":"the Directionality data category in the W3C Internationalization Tag Set recommendation. Values are ltr (left-","type":"text"},{"text":" ","type":"text"},{"text":"to-right embed), rtl (right-to-left embed), lro (left-to-right bidi-override), and rlo (right-to-left bidi-","type":"text"},{"text":" ","type":"text"},{"text":"override). The default value is ltr. This type is typically used by applications that store text in left-to-","type":"text"},{"text":" ","type":"text"},{"text":"right visual order rather than logical order. Such applications can use the lro value to better communicate","type":"text"},{"text":" ","type":"text"},{"text":"with other applications that more fully support bidirectional text.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLRotationDegrees":{"abstract":[{"type":"text","text":"The rotation-degrees type specifies rotation, pan, and elevation values in degrees. Values range from -180 to"},{"text":" ","type":"text"},{"type":"text","text":"180."}],"title":"MXLRotationDegrees","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"text":"MXLRotationDegrees","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"MXLRotationDegrees"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlrotationdegrees","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRotationDegrees"},"doc://IvorMXL/documentation/IvorMXL/MXLEnclosureShape":{"navigatorTitle":[{"kind":"identifier","text":"MXLEnclosureShape"}],"abstract":[{"text":"The enclosure-shape type describes the shape and presence \/ absence of an enclosure around text or symbols. A","type":"text"},{"text":" ","type":"text"},{"text":"bracket enclosure is similar to a rectangle with the bottom line missing, as is common in jazz notation. An","type":"text"},{"text":" ","type":"text"},{"text":"inverted-bracket enclosure is similar to a rectangle with the top line missing.","type":"text"}],"title":"MXLEnclosureShape","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnclosureShape","kind":"symbol","url":"\/documentation\/ivormxl\/mxlenclosureshape","type":"topic","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLEnclosureShape"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLAccidentalValue":{"title":"MXLAccidentalValue","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLAccidentalValue","kind":"identifier"}],"kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxlaccidentalvalue","abstract":[{"text":"The accidental-value type represents notated accidentals supported by MusicXML. In the MusicXML 2.0 DTD this","type":"text"},{"text":" ","type":"text"},{"text":"was a string with values that could be included. The XSD strengthens the data typing to an enumerated list.","type":"text"},{"text":" ","type":"text"},{"text":"The quarter- and three-quarters- accidentals are Tartini-style quarter-tone accidentals. The -down and -up","type":"text"},{"type":"text","text":" "},{"type":"text","text":"accidentals are quarter-tone accidentals that include arrows pointing down or up. The slash- accidentals are"},{"type":"text","text":" "},{"type":"text","text":"used in Turkish classical music. The numbered sharp and flat accidentals are superscripted versions of the"},{"type":"text","text":" "},{"type":"text","text":"accidental signs, used in Turkish folk music. The sori and koron accidentals are microtonal sharp and flat"},{"type":"text","text":" "},{"type":"text","text":"accidentals used in Iranian and Persian music. The other accidental covers accidentals other than those listed"},{"type":"text","text":" "},{"type":"text","text":"here. It is usually used in combination with the smufl attribute to specify a particular SMuFL accidental. The"},{"type":"text","text":" "},{"type":"text","text":"smufl attribute may be used with any accidental value to help specify the appearance of symbols that share the"},{"type":"text","text":" "},{"type":"text","text":"same MusicXML semantics."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidentalValue","navigatorTitle":[{"text":"MXLAccidentalValue","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLFont":{"navigatorTitle":[{"text":"MXLFont","kind":"identifier"}],"abstract":[{"text":"The font attribute group gathers together attributes for determining the font within a credit or direction.","type":"text"},{"text":" ","type":"text"},{"text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of","type":"text"},{"text":" ","type":"text"},{"text":"font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric","type":"text"},{"text":" ","type":"text"},{"text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font","type":"text"},{"text":" ","type":"text"},{"text":"vs. a music font.","type":"text"}],"title":"MXLFont","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","kind":"symbol","url":"\/documentation\/ivormxl\/mxlfont","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLFont","kind":"identifier"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNumberOfLines":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumberOfLines","title":"MXLNumberOfLines","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNumberOfLines","kind":"identifier"}],"navigatorTitle":[{"text":"MXLNumberOfLines","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlnumberoflines","abstract":[{"type":"text","text":"The number-of-lines type is used to specify the number of lines in text decoration attributes."}]},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLValign":{"abstract":[{"type":"text","text":"The valign type is used to indicate vertical alignment to the top, middle, bottom, or baseline of the text. If"},{"text":" ","type":"text"},{"text":"the text is on multiple lines, baseline alignment refers to the baseline of the lowest line of text. Defaults","type":"text"},{"text":" ","type":"text"},{"text":"are implementation-dependent.","type":"text"}],"title":"MXLValign","kind":"symbol","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLValign","kind":"identifier"}],"navigatorTitle":[{"text":"MXLValign","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlvalign","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValign"},"doc://IvorMXL/documentation/IvorMXL/MXLAccidentalText":{"abstract":[{"type":"text","text":"The accidental-text type represents an element with an accidental value and text-formatting attributes."}],"title":"MXLAccidentalText","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLAccidentalText","kind":"identifier"}],"navigatorTitle":[{"text":"MXLAccidentalText","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlaccidentaltext","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidentalText"},"doc://IvorMXL/documentation/IvorMXL/MXLPosition":{"title":"MXLPosition","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPosition"}],"type":"topic","ki