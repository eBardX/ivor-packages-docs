used, the A value is assumed to be FF."}],"url":"\/documentation\/ivormxl\/mxlcolor","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"kind":"symbol","title":"MXLColor","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLTextDirection":{"title":"MXLTextDirection","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTextDirection","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxltextdirection","role":"symbol","navigatorTitle":[{"text":"MXLTextDirection","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTextDirection","abstract":[{"text":"The text-direction type is used to adjust and override the Unicode bidirectional text algorithm, similar to","type":"text"},{"text":" ","type":"text"},{"text":"the Directionality data category in the W3C Internationalization Tag Set recommendation. Values are ltr (left-","type":"text"},{"text":" ","type":"text"},{"text":"to-right embed), rtl (right-to-left embed), lro (left-to-right bidi-override), and rlo (right-to-left bidi-","type":"text"},{"text":" ","type":"text"},{"text":"override). The default value is ltr. This type is typically used by applications that store text in left-to-","type":"text"},{"text":" ","type":"text"},{"text":"right visual order rather than logical order. Such applications can use the lro value to better communicate","type":"text"},{"text":" ","type":"text"},{"text":"with other applications that more fully support bidirectional text.","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLFont":{"type":"topic","title":"MXLFont","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","abstract":[{"type":"text","text":"The font attribute group gathers together attributes for determining the font within a credit or direction."},{"type":"text","text":" "},{"type":"text","text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of"},{"type":"text","text":" "},{"type":"text","text":"font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric"},{"type":"text","text":" "},{"type":"text","text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font"},{"type":"text","text":" "},{"type":"text","text":"vs. a music font."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFont"}],"navigatorTitle":[{"kind":"identifier","text":"MXLFont"}],"url":"\/documentation\/ivormxl\/mxlfont"},"doc://IvorMXL/documentation/IvorMXL/MXLRotationDegrees":{"type":"topic","abstract":[{"type":"text","text":"The rotation-degrees type specifies rotation, pan, and elevation values in degrees. Values range from -180 to"},{"type":"text","text":" "},{"type":"text","text":"180."}],"url":"\/documentation\/ivormxl\/mxlrotationdegrees","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLRotationDegrees"}],"kind":"symbol","title":"MXLRotationDegrees","navigatorTitle":[{"kind":"identifier","text":"MXLRotationDegrees"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRotationDegrees","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"}}}