/documentation\/IvorMXL\/MXLAccidentalText\/init(value:justify:position:font:color:halign:valign:underline:overline:lineThrough:rotation:letterSpacing:lineHeight:xmlLang:xmlSpace:dir:enclosure:smufl:)"},"abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLAccidentalText"},{"type":"text","text":"."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlaccidentaltext\/init(value:justify:position:font:color:halign:valign:underline:overline:linethrough:rotation:letterspacing:lineheight:xmllang:xmlspace:dir:enclosure:smufl:)"]}],"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLXmlSpace":{"title":"MXLXmlSpace","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLXmlSpace","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"MXLXmlSpace","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlxmlspace","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLXmlSpace","abstract":[{"type":"text","text":"The xml:space attribute value, as defined by the XML 1.0 specification."}],"type":"topic","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNumberOfLines":{"url":"\/documentation\/ivormxl\/mxlnumberoflines","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNumberOfLines","kind":"identifier"}],"title":"MXLNumberOfLines","abstract":[{"text":"The number-of-lines type is used to specify the number of lines in text decoration attributes.","type":"text"}],"navigatorTitle":[{"text":"MXLNumberOfLines","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumberOfLines","type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLSmuflAccidentalGlyphName":{"type":"topic","title":"MXLSmuflAccidentalGlyphName","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSmuflAccidentalGlyphName","abstract":[{"type":"text","text":"The smufl-accidental-glyph-name type is used to reference a specific Standard Music Font Layout (SMuFL)"},{"type":"text","text":" "},{"type":"text","text":"accidental character. The value is a SMuFL canonical glyph name that starts with one of the strings used at"},{"type":"text","text":" "},{"type":"text","text":"the start of glyph names for SMuFL accidentals."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLSmuflAccidentalGlyphName"}],"navigatorTitle":[{"kind":"identifier","text":"MXLSmuflAccidentalGlyphName"}],"url":"\/documentation\/ivormxl\/mxlsmuflaccidentalglyphname"},"doc://IvorMXL/documentation/IvorMXL/MXLAccidentalValue":{"type":"topic","abstract":[{"type":"text","text":"The accidental-value type represents notated accidentals supported by MusicXML. In the MusicXML 2.0 DTD this"},{"type":"text","text":" "},{"type":"text","text":"was a string with values that could be included. The XSD strengthens the data typing to an enumerated list."},{"type":"text","text":" "},{"type":"text","text":"The quarter- and three-quarters- accidentals are Tartini-style quarter-tone accidentals. The -down and -up"},{"type":"text","text":" "},{"type":"text","text":"accidentals are quarter-tone accidentals that include arrows pointing down or up. The slash- accidentals are"},{"type":"text","text":" "},{"type":"text","text":"used in Turkish classical music. The numbered sharp and flat accidentals are superscripted versions of the"},{"type":"text","text":" "},{"type":"text","text":"accidental signs, used in Turkish folk music. The sori and koron accidentals are microtonal sharp and flat"},{"type":"text","text":" "},{"type":"text","text":"accidentals used in Iranian and Persian music. The other accidental covers accidentals other than those listed"},{"type":"text","text":" "},{"type":"text","text":"here. It is usually used in combination with the smufl attribute to specify a particular SMuFL accidental. The"},{"type":"text","text":" "},{"type":"text","text":"smufl attribute may be used with any accidental value to help specify the appearance of symbols that share the"},{"type":"text","text":" "},{"type":"text","text":"same MusicXML semantics."}],"url":"\/documentation\/ivormxl\/mxlaccidentalvalue","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLAccidentalValue"}],"kind":"symbol","title":"MXLAccidentalValue","navigatorTitle":[{"kind":"identifier","text":"MXLAccidentalValue"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidentalValue","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLPosition":{"type":"topic","abstract":[{"type":"text","text":"For most elements, any program will compute a default x and y position. The position attributes let this be"},{"type":"text","text":" "},{"type":"text","text":"changed two ways."}],"url":"\/documentation\/ivormxl\/mxlposition","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPosition"}],"kind":"symbol","title":"MXLPosition","navigatorTitle":[{"kind":"identifier","text":"MXLPosition"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLValign":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLValign","kind":"identifier"}],"title":"MXLValign","abstract":[{"type":"text","text":"The valign type is used to indicate vertical alignment to the top, middle, bottom, or baseline of the text. If"},{"type":"text","text":" "},{"type":"text","text":"the text is on multiple lines, baseline alignment refers to the baseline of the lowest line of text. Defaults"},{"type":"text","text":" "},{"type":"text","text":"are implementation-dependent."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValign","role":"symbol","url":"\/documentation\/ivormxl\/mxlvalign","kind":"symbol","navigatorTitle":[{"text":"MXLValign","kind":"identifier"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLEnclosureShape":{"title":"MXLEnclosureShape","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLEnclosureShape","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlenclosureshape","role":"symbol","navigatorTitle":[{"text":"MXLEnclosureShape","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnclosureShape","abstract":[{"type":"text","text":"The enclosure-shape type describes the shape and presence \/ absence of an enclosure around text or symbols. A"},{"type":"text","text":" "},{"type":"text","text":"bracket enclosure is similar to a rectangle with the bottom line missing, as is common in jazz notation. An"},{"type":"text","text":" "},{"type":"text","text":"inverted-bracket enclosure is similar to a rectangle with the top line missing."}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLLeftCenterRight":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLLeftCenterRight"}],"title":"MXLLeftCenterRight","abstract":[{"text":"The left-center-right type is used to define horizontal alignment and text justification.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLeftCenterRight","role":"symbol","url":"\/documentation\/ivormxl\/mxlleftcenterright","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLLeftCenterRight"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLNumberOrNormal":{"type":"topic","title":"MXLNumberOrNormal","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumberOrNormal","abstract":[{"type":"text","text":"The number-or-normal values can be either a decimal number or the string “normal”. This is used by the line-"},{"type":"text","text":" "},{"type":"text","text":"height and letter-spacing attributes."}],"role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNumberOrNormal","kind":"identifier"}],"navigatorTitle":[{"text":"MXLNumberOrNormal","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlnumberornormal"},"doc://IvorMXL/documentation/IvorMXL/MXLAccidentalText":{"type":"topic","title":"MXLAccidentalText","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidentalText","abstract":[{"text":"The accidental-text type represents an element with an accidental value and text-formatting attributes.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLAccidentalText"}],"navigatorTitle":[{"kind":"identifier","text":"MXLAccidentalText"}],"url":"\/documentation\/ivormxl\/mxlaccidentaltext"},"doc://IvorMXL/documentation/IvorMXL/MXLAccidentalText/init(value:justify:position:font:color:halign:valign:underline:overline:lineThrough:rotation:letterSpacing:lineHeight:xmlLang:xmlSpace:dir:enclosure:smufl:)":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidentalText\/init(value:justify:position:font:color:halign:valign:underline:overline:lineThrough:rotation:letterSpacing:lineHeight:xmlLang:xmlSpace:dir:enclosure:smufl:)","abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLAccidentalText"},{"type":"text","text":"."}],"fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"value","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL18MXLAccidentalValueO","text":"MXLAccidentalValue","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"justify","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL18MXLLeftCenterRightO","text":"MXLLeftCenterRight","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"position","kind":"externalParam"},{"text":": ","kind":"text"},{"precis