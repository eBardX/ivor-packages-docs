t":"? = nil, "},{"kind":"externalParam","text":"underline"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLNumberOfLines","preciseIdentifier":"s:7IvorMXL16MXLNumberOfLinesV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumberOfLines"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"overline"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLNumberOfLines","preciseIdentifier":"s:7IvorMXL16MXLNumberOfLinesV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumberOfLines"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"lineThrough"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLNumberOfLines","preciseIdentifier":"s:7IvorMXL16MXLNumberOfLinesV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumberOfLines"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"rotation"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLRotationDegrees","preciseIdentifier":"s:7IvorMXL18MXLRotationDegreesa","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRotationDegrees"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"letterSpacing"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLNumberOrNormal","preciseIdentifier":"s:7IvorMXL17MXLNumberOrNormalO","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumberOrNormal"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"lineHeight"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLNumberOrNormal","preciseIdentifier":"s:7IvorMXL17MXLNumberOrNormalO","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumberOrNormal"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"xmlLang"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"xmlSpace"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLXmlSpace","preciseIdentifier":"s:7IvorMXL11MXLXmlSpaceO","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLXmlSpace"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"dir"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLTextDirection","preciseIdentifier":"s:7IvorMXL16MXLTextDirectionO","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTextDirection"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"enclosure"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLEnclosureShape","preciseIdentifier":"s:7IvorMXL17MXLEnclosureShapeO","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnclosureShape"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"smufl"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLSmuflAccidentalGlyphName","preciseIdentifier":"s:7IvorMXL27MXLSmuflAccidentalGlyphNameV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSmuflAccidentalGlyphName"},{"kind":"text","text":"? = nil)"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"name":"value","content":[{"inlineContent":[{"type":"text","text":"The value of this element."}],"type":"paragraph"}]},{"name":"justify","content":[{"inlineContent":[{"type":"text","text":"The justify attribute is used to indicate left, center, or right justification. The"},{"type":"text","text":" "},{"type":"text","text":"default value varies for different elements. For elements where the justify"},{"type":"text","text":" "},{"type":"text","text":"attribute is present but the halign attribute is not, the justify attribute"},{"type":"text","text":" "},{"type":"text","text":"indicates horizontal alignment as well as justification."}],"type":"paragraph"}]},{"name":"position","content":[{"inlineContent":[{"type":"text","text":"For most elements, any program will compute a default x and y position. The position"},{"type":"text","text":" "},{"type":"text","text":"attributes let this be changed two ways."}],"type":"paragraph"}]},{"name":"font","content":[{"inlineContent":[{"type":"text","text":"The font attribute group gathers together attributes for determining the font within"},{"type":"text","text":" "},{"type":"text","text":"a credit or direction. They are based on the text styles for Cascading Style Sheets."},{"type":"text","text":" "},{"type":"text","text":"The font-family is a comma-separated list of font names. The font-style can be"},{"type":"text","text":" "},{"type":"text","text":"normal or italic. The font-size can be one of the CSS sizes or a numeric point size."},{"type":"text","text":" "},{"type":"text","text":"The font-weight can be normal or bold. The default is application-dependent, but is"},{"type":"text","text":" "},{"type":"text","text":"a text font vs. a music font."}],"type":"paragraph"}]},{"name":"color","content":[{"inlineContent":[{"type":"text","text":"The color attribute group indicates the color of an element."}],"type":"paragraph"}]},{"name":"halign","content":[{"inlineContent":[{"type":"text","text":"In cases where text extends over more than one line, horizontal alignment and"},{"type":"text","text":" "},{"type":"text","text":"justify values can be different."}],"type":"paragraph"}]},{"name":"valign","content":[{"inlineContent":[{"type":"text","text":"The valign attribute is used to indicate vertical alignment to the top, middle,"},{"type":"text","text":" "},{"type":"text","text":"bottom, or baseline of the text. Defaults are implementation-dependent."}],"type":"paragraph"}]},{"name":"underline","content":[{"inlineContent":[{"type":"text","text":"The number of lines used to underline the text: "},{"type":"codeVoice","code":"0"},{"type":"text","text":" (none), "},{"type":"codeVoice","code":"1"},{"type":"text","text":", "},{"type":"codeVoice","code":"2"},{"type":"text","text":", or "},{"type":"codeVoice","code":"3"},{"type":"text","text":"."}],"type":"paragraph"}]},{"name":"overline","content":[{"inlineContent":[{"type":"text","text":"The number of lines used to overline the text: "},{"type":"codeVoice","code":"0"},{"type":"text","text":" (none), "},{"type":"codeVoice","code":"1"},{"type":"text","text":", "},{"type":"codeVoice","code":"2"},{"type":"text","text":", or "},{"type":"codeVoice","code":"3"},{"type":"text","text":"."}],"type":"paragraph"}]},{"name":"lineThrough","content":[{"inlineContent":[{"type":"text","text":"The number of lines used to strike through the text: "},{"type":"codeVoice","code":"0"},{"type":"text","text":" (none), "},{"type":"codeVoice","code":"1"},{"type":"text","text":", "},{"type":"codeVoice","code":"2"},{"type":"text","text":", or "},{"type":"codeVoice","code":"3"},{"type":"text","text":"."}],"type":"paragraph"}]},{"name":"rotation","content":[{"inlineContent":[{"type":"text","text":"The rotation attribute is used to rotate text around the alignment point specified"},{"type":"text","text":" "},{"type":"text","text":"by the halign and valign attributes. Positive values are clockwise rotations, while"},{"type":"text","text":" "},{"type":"text","text":"negative values are counter-clockwise rotations."}],"type":"paragraph"}]},{"name":"letterSpacing","content":[{"inlineContent":[{"type":"text","text":"The letter-spacing attribute specifies text tracking. Values are either “normal” or"},{"type":"text","text":" "},{"type":"text","text":"a number representing the number of ems to add between each letter. The number may"},{"type":"text","text":" "},{"type":"text","text":"be negative in order to subtract space. The default is normal, which allows"},{"type":"text","text":" "},{"type":"text","text":"flexibility of letter-spacing for purposes of text justification."}],"type":"paragraph"}]},{"name":"lineHeight","content":[{"inlineContent":[{"type":"text","text":"The line-height attribute specifies text leading. Values are either “normal” or a"},{"type":"text","text":" "},{"type":"text","text":"number representing the percentage of the current font height to use for leading."},{"type":"text","text":" "},{"type":"text","text":"The default is “normal”. The exact normal value is implementation-dependent, but"},{"type":"text","text":" "},{"type":"text","text":"values between 100 and 120 are recommended."}],"type":"paragraph"}]},{"name":"xmlLang","content":[{"inlineContent":[{"type":"text","text":"The xml:lang attribute value."}],"type":"paragraph"}]},{"name":"xmlSpace","content":[{"inlineContent":[{"type":"text","text":"The xml:space attribute value."}],"type":"paragraph"}]},{"name":"dir","content":[{"inlineContent":[{"type":"text","text":"The text-direction attribute is used to adjust and override the Unicode"},{"type":"text","text":" "},{"type":"text","text":"bidirectional text algorithm, similar to the Directionality data category in the W3C"},{"type":"text","text":" "},{"type":"text","text":"Internationalization Tag Set recommendation."}],"type":"paragraph"}]},{"name":"enclosure","content":[{"inlineContent":[{"type":"text","text":"The enclosure attribute group is used to specify the formatting of an enclosure"},{"type":"text","text":" "},{"type":"text","text":"around text or symbols."}],"type":"paragraph"}]},{"name":"smufl","content":[{"inlineContent":[{"type":"text","text":"The SMuFL canonical glyph name used to specify a particular accidental character."}],"type":"paragraph"}]}],"kind":"parameters"}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidentalText"]]},"metadata":{"modules":[{"name":"IvorMXL"}],"symbolKind":"init","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"value"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLAccidentalValue","preciseIdentifier":"s:7IvorMXL18MXLAccidentalValueO"},{"kind":"text","text":", "},{"kind":"externalParam","text":"justify"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLLeftCenterRight","p