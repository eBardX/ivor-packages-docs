ext","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"The accidental-text type represents an element with an accidental value and text-formatting attributes.","type":"text"}],"role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidentalText","url":"\/documentation\/ivormxl\/mxlaccidentaltext","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLAccidentalText","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLAccidentalText/dir":{"kind":"symbol","title":"dir","abstract":[{"type":"text","text":"The text-direction attribute is used to adjust and override the Unicode bidirectional text algorithm, similar"},{"type":"text","text":" "},{"type":"text","text":"to the Directionality data category in the W3C Internationalization Tag Set recommendation."}],"url":"\/documentation\/ivormxl\/mxlaccidentaltext\/dir","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"dir"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL16MXLTextDirectionO","kind":"typeIdentifier","text":"MXLTextDirection"}],"type":"topic","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidentalText\/dir"},"doc://IvorMXL/documentation/IvorMXL/MXLTextDirection":{"url":"\/documentation\/ivormxl\/mxltextdirection","title":"MXLTextDirection","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTextDirection"}],"navigatorTitle":[{"kind":"identifier","text":"MXLTextDirection"}],"abstract":[{"type":"text","text":"The text-direction type is used to adjust and override the Unicode bidirectional text algorithm, similar to"},{"type":"text","text":" "},{"type":"text","text":"the Directionality data category in the W3C Internationalization Tag Set recommendation. Values are ltr (left-"},{"type":"text","text":" "},{"type":"text","text":"to-right embed), rtl (right-to-left embed), lro (left-to-right bidi-override), and rlo (right-to-left bidi-"},{"type":"text","text":" "},{"type":"text","text":"override). The default value is ltr. This type is typically used by applications that store text in left-to-"},{"type":"text","text":" "},{"type":"text","text":"right visual order rather than logical order. Such applications can use the lro value to better communicate"},{"type":"text","text":" "},{"type":"text","text":"with other applications that more fully support bidirectional text."}],"kind":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTextDirection"}}}