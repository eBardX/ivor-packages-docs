tation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLAccidentalText/dir":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidentalText\/dir","url":"\/documentation\/ivormxl\/mxlaccidentaltext\/dir","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dir","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLTextDirection","preciseIdentifier":"s:7IvorMXL16MXLTextDirectionO","kind":"typeIdentifier"}],"title":"dir","abstract":[{"text":"The text-direction attribute is used to adjust and override the Unicode bidirectional text algorithm, similar","type":"text"},{"type":"text","text":" "},{"text":"to the Directionality data category in the W3C Internationalization Tag Set recommendation.","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLAccidentalText":{"type":"topic","title":"MXLAccidentalText","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidentalText","abstract":[{"text":"The accidental-text type represents an element with an accidental value and text-formatting attributes.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLAccidentalText"}],"navigatorTitle":[{"kind":"identifier","text":"MXLAccidentalText"}],"url":"\/documentation\/ivormxl\/mxlaccidentaltext"},"doc://IvorMXL/documentation/IvorMXL/MXLTextDirection":{"title":"MXLTextDirection","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTextDirection","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxltextdirection","role":"symbol","navigatorTitle":[{"text":"MXLTextDirection","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTextDirection","abstract":[{"text":"The text-direction type is used to adjust and override the Unicode bidirectional text algorithm, similar to","type":"text"},{"text":" ","type":"text"},{"text":"the Directionality data category in the W3C Internationalization Tag Set recommendation. Values are ltr (left-","type":"text"},{"text":" ","type":"text"},{"text":"to-right embed), rtl (right-to-left embed), lro (left-to-right bidi-override), and rlo (right-to-left bidi-","type":"text"},{"text":" ","type":"text"},{"text":"override). The default value is ltr. This type is typically used by applications that store text in left-to-","type":"text"},{"text":" ","type":"text"},{"text":"right visual order rather than logical order. Such applications can use the lro value to better communicate","type":"text"},{"text":" ","type":"text"},{"text":"with other applications that more fully support bidirectional text.","type":"text"}],"type":"topic"}}}