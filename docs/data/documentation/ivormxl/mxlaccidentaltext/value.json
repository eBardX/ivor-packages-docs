{"metadata":{"title":"value","modules":[{"name":"IvorMXL"}],"symbolKind":"property","fragments":[{"text":"let","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"value"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL18MXLAccidentalValueO","text":"MXLAccidentalValue"}],"role":"symbol","externalID":"s:7IvorMXL17MXLAccidentalTextV5valueAA0C5ValueOvp","roleHeading":"Instance Property"},"sections":[],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"value","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL18MXLAccidentalValueO","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidentalValue","text":"MXLAccidentalValue","kind":"typeIdentifier"}],"languages":["swift"]}],"kind":"declarations"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"paths":["\/documentation\/ivormxl\/mxlaccidentaltext\/value"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"The value of this element.","type":"text"}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidentalText\/value","interfaceLanguage":"swift"},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidentalText"]]},"references":{"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLAccidentalText":{"title":"MXLAccidentalText","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLAccidentalText","kind":"identifier"}],"abstract":[{"text":"The accidental-text type represents an element with an accidental value and text-formatting attributes.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidentalText","role":"symbol","navigatorTitle":[{"text":"MXLAccidentalText","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlaccidentaltext"},"doc://IvorMXL/documentation/IvorMXL/MXLAccidentalText/value":{"title":"value","kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"value","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL18MXLAccidentalValueO","text":"MXLAccidentalValue","kind":"typeIdentifier"}],"abstract":[{"text":"The value of this element.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidentalText\/value","role":"symbol","url":"\/documentation\/ivormxl\/mxlaccidentaltext\/value"},"doc://IvorMXL/documentation/IvorMXL/MXLAccidentalValue":{"title":"MXLAccidentalValue","kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLAccidentalValue","kind":"identifier"}],"abstract":[{"text":"The accidental-value type represents notated accidentals supported by MusicXML. In the MusicXML 2.0 DTD this","type":"text"},{"text":" ","type":"text"},{"text":"was a string with values that could be included. The XSD strengthens the data typing to an enumerated list.","type":"text"},{"text":" ","type":"text"},{"text":"The quarter- and three-quarters- accidentals are Tartini-style quarter-tone accidentals. The -down and -up","type":"text"},{"text":" ","type":"text"},{"text":"accidentals are quarter-tone accidentals that include arrows pointing down or up. The slash- accidentals are","type":"text"},{"text":" ","type":"text"},{"text":"used in Turkish classical music. The numbered sharp and flat accidentals are superscripted versions of the","type":"text"},{"text":" ","type":"text"},{"text":"accidental signs, used in Turkish folk music. The sori and koron accidentals are microtonal sharp and flat","type":"text"},{"text":" ","type":"text"},{"text":"accidentals used in Iranian and Persian music. The other accidental covers accidentals other than those listed","type":"text"},{"text":" ","type":"text"},{"text":"here. It is usually used in combination with the smufl attribute to specify a particular SMuFL accidental. The","type":"text"},{"text":" ","type":"text"},{"text":"smufl attribute may be used with any accidental value to help specify the appearance of symbols that share the","type":"text"},{"text":" ","type":"text"},{"text":"same MusicXML semantics.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidentalValue","role":"symbol","navigatorTitle":[{"text":"MXLAccidentalValue","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlaccidentalvalue"}}}