"identifier","text":"MXLLineDetail"}],"url":"\/documentation\/ivormxl\/mxllinedetail","abstract":[{"text":"If the staff-lines element is present, the appearance of each line may be individually specified with a line-","type":"text"},{"text":" ","type":"text"},{"text":"detail type. Staff lines are numbered from bottom to top. The print-object attribute allows lines to be hidden","type":"text"},{"text":" ","type":"text"},{"text":"within a staff. This is used in special situations such as a widely-spaced percussion staff where a note","type":"text"},{"text":" ","type":"text"},{"text":"placed below the higher line is distinct from a note placed above the lower line. Hidden staff lines are","type":"text"},{"text":" ","type":"text"},{"text":"included when specifying clef lines and determining display-step \/ display-octave values, but are not counted","type":"text"},{"text":" ","type":"text"},{"text":"as lines for the purposes of the system-layout and staff-layout elements.","type":"text"}],"title":"MXLLineDetail"},"doc://IvorMXL/documentation/IvorMXL/MXLLineDetail/width":{"kind":"symbol","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLineDetail\/width","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"width"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLTenthsa","text":"MXLTenths"},{"kind":"text","text":"?"}],"type":"topic","url":"\/documentation\/ivormxl\/mxllinedetail\/width","abstract":[{"text":"The width of the line, in tenths, if different from the default.","type":"text"}],"title":"width"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLTenths":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLTenths"}],"abstract":[{"type":"text","text":"The tenths type is a number representing tenths of interline staff space (positive or negative). Both integer"},{"type":"text","text":" "},{"type":"text","text":"and decimal values are allowed, such as 5 for a half space and 2.5 for a quarter space. Interline space is"},{"type":"text","text":" "},{"type":"text","text":"measured from the middle of a staff line."}],"kind":"symbol","title":"MXLTenths","url":"\/documentation\/ivormxl\/mxltenths","role":"symbol","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTenths"}]}}}