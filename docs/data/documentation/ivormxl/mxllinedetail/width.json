e. Interline space is","type":"text"},{"text":" ","type":"text"},{"text":"measured from the middle of a staff line.","type":"text"}],"title":"MXLTenths","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTenths"}],"navigatorTitle":[{"kind":"identifier","text":"MXLTenths"}],"type":"topic","url":"\/documentation\/ivormxl\/mxltenths","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths"},"doc://IvorMXL/documentation/IvorMXL/MXLLineDetail/width":{"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxllinedetail\/width","fragments":[{"kind":"keyword","text":"let"},{"text":" ","kind":"text"},{"kind":"identifier","text":"width"},{"text":": ","kind":"text"},{"text":"MXLTenths","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLTenthsa"},{"text":"?","kind":"text"}],"title":"width","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLineDetail\/width","abstract":[{"text":"The width of the line, in tenths, if different from the default.","type":"text"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLLineDetail":{"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLLineDetail"}],"title":"MXLLineDetail","url":"\/documentation\/ivormxl\/mxllinedetail","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLLineDetail","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLineDetail","abstract":[{"type":"text","text":"If the staff-lines element is present, the appearance of each line may be individually specified with a line-"},{"type":"text","text":" "},{"type":"text","text":"detail type. Staff lines are numbered from bottom to top. The print-object attribute allows lines to be hidden"},{"type":"text","text":" "},{"type":"text","text":"within a staff. This is used in special situations such as a widely-spaced percussion staff where a note"},{"type":"text","text":" "},{"type":"text","text":"placed below the higher line is distinct from a note placed above the lower line. Hidden staff lines are"},{"type":"text","text":" "},{"type":"text","text":"included when specifying clef lines and determining display-step \/ display-octave values, but are not counted"},{"type":"text","text":" "},{"type":"text","text":"as lines for the purposes of the system-layout and staff-layout elements."}]}}}