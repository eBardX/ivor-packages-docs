s."}],"type":"paragraph"}]},{"name":"printsObject","content":[{"inlineContent":[{"type":"text","text":"A Boolean value indicating whether to print an object (e.g. a note or a rest). Defaults to "},{"code":"true","type":"codeVoice"},{"type":"text","text":" if not specified."}],"type":"paragraph"}]}]}],"references":{"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLTenths":{"title":"MXLTenths","kind":"symbol","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTenths"}],"abstract":[{"type":"text","text":"The tenths type is a number representing tenths of interline staff space (positive or negative). Both integer"},{"type":"text","text":" "},{"type":"text","text":"and decimal values are allowed, such as 5 for a half space and 2.5 for a quarter space. Interline space is"},{"type":"text","text":" "},{"type":"text","text":"measured from the middle of a staff line."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLTenths"}],"url":"\/documentation\/ivormxl\/mxltenths"},"doc://IvorMXL/documentation/IvorMXL/MXLLineKind":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLLineKind"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLLineKind"}],"url":"\/documentation\/ivormxl\/mxllinekind","abstract":[{"type":"text","text":"The line-type type distinguishes between solid, dashed, dotted, and wavy lines."}],"title":"MXLLineKind","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLineKind","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLLineDetail/init(line:width:color:lineKind:printsObject:)":{"role":"symbol","url":"\/documentation\/ivormxl\/mxllinedetail\/init(line:width:color:linekind:printsobject:)","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLineDetail\/init(line:width:color:lineKind:printsObject:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"line"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL12MXLStaffLineV","text":"MXLStaffLine"},{"kind":"text","text":", "},{"kind":"externalParam","text":"width"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLTenthsa","text":"MXLTenths"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"color"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLColorV","text":"MXLColor"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"lineKind"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLLineKindO","text":"MXLLineKind"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"printsObject"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":"?)"}],"abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLLineDetail"},{"type":"text","text":"."}],"kind":"symbol","type":"topic","title":"init(line:width:color:lineKind:printsObject:)"},"doc://IvorMXL/documentation/IvorMXL/MXLStaffLine":{"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffLine","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLStaffLine","kind":"identifier"}],"title":"MXLStaffLine","kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlstaffline","navigatorTitle":[{"text":"MXLStaffLine","kind":"identifier"}],"abstract":[{"type":"text","text":"The staff-line type indicates the line on a given staff. Staff lines are numbered from bottom to top, with 1"},{"type":"text","text":" "},{"type":"text","text":"being the bottom line on a staff."}]},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"title":"MXLColor","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"abstract":[{"text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in","type":"text"},{"text":" ","type":"text"},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"url":"\/documentation\/ivormxl\/mxlcolor"},"doc://IvorMXL/documentation/IvorMXL/MXLLineDetail":{"role":"symbol","url":"\/documentation\/ivormxl\/mxllinedetail","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLineDetail","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLLineDetail"}],"abstract":[{"type":"text","text":"If the staff-lines element is present, the appearance of each line may be individually specified with a line-"},{"type":"text","text":" "},{"type":"text","text":"detail type. Staff lines are numbered from bottom to top. The print-object attribute allows lines to be hidden"},{"type":"text","text":" "},{"type":"text","text":"within a staff. This is used in special situations such as a widely-spaced percussion staff where a note"},{"type":"text","text":" "},{"type":"text","text":"placed below the higher line is distinct from a note placed above the lower line. Hidden staff lines are"},{"type":"text","text":" "},{"type":"text","text":"included when specifying clef lines and determining display-step \/ display-octave values, but are not counted"},{"type":"text","text":" "},{"type":"text","text":"as lines for the purposes of the system-layout and staff-layout elements."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLLineDetail"}],"title":"MXLLineDetail"}}}