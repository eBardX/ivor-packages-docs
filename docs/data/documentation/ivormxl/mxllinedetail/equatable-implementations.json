igher line is distinct from a note placed above the lower line. Hidden staff lines are","type":"text"},{"text":" ","type":"text"},{"text":"included when specifying clef lines and determining display-step \/ display-octave values, but are not counted","type":"text"},{"text":" ","type":"text"},{"text":"as lines for the purposes of the system-layout and staff-layout elements.","type":"text"}],"title":"MXLLineDetail"},"doc://IvorMXL/documentation/IvorMXL/MXLLineDetail/!=(_:_:)":{"role":"symbol","title":"!=(_:_:)","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLineDetail\/!=(_:_:)","abstract":[],"kind":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"!="},{"kind":"text","text":" "},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"url":"\/documentation\/ivormxl\/mxllinedetail\/!=(_:_:)"}}}