n staff lines are"},{"type":"text","text":" "},{"type":"text","text":"included when specifying clef lines and determining display-step \/ display-octave values, but are not counted"},{"type":"text","text":" "},{"type":"text","text":"as lines for the purposes of the system-layout and staff-layout elements."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLineDetail","role":"symbol","url":"\/documentation\/ivormxl\/mxllinedetail","kind":"symbol","navigatorTitle":[{"text":"MXLLineDetail","kind":"identifier"}],"type":"topic"}}}