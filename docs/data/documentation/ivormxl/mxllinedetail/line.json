{"metadata":{"roleHeading":"Instance Property","modules":[{"name":"IvorMXL"}],"symbolKind":"property","title":"line","role":"symbol","externalID":"s:7IvorMXL13MXLLineDetailV4lineAA12MXLStaffLineVvp","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"line"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLStaffLine","preciseIdentifier":"s:7IvorMXL12MXLStaffLineV"}]},"variants":[{"paths":["\/documentation\/ivormxl\/mxllinedetail\/line"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLineDetail"]]},"sections":[],"abstract":[{"text":"The staff line being configured, counted from the bottom of the staff.","type":"text"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"line"},{"text":": ","kind":"text"},{"text":"MXLStaffLine","preciseIdentifier":"s:7IvorMXL12MXLStaffLineV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffLine","kind":"typeIdentifier"}],"platforms":["macOS"],"languages":["swift"]}]},{"content":[{"anchor":"discussion","text":"Discussion","level":2,"type":"heading"},{"inlineContent":[{"text":"Maps to the MusicXML ","type":"text"},{"code":"line","type":"codeVoice"},{"text":" attribute.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLineDetail\/line","interfaceLanguage":"swift"},"kind":"symbol","references":{"doc://IvorMXL/documentation/IvorMXL/MXLStaffLine":{"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffLine","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLStaffLine","kind":"identifier"}],"title":"MXLStaffLine","kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlstaffline","navigatorTitle":[{"text":"MXLStaffLine","kind":"identifier"}],"abstract":[{"type":"text","text":"The staff-line type indicates the line on a given staff. Staff lines are numbered from bottom to top, with 1"},{"type":"text","text":" "},{"type":"text","text":"being the bottom line on a staff."}]},"doc://IvorMXL/documentation/IvorMXL/MXLLineDetail":{"role":"symbol","url":"\/documentation\/ivormxl\/mxllinedetail","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLineDetail","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLLineDetail"}],"abstract":[{"type":"text","text":"If the staff-lines element is present, the appearance of each line may be individually specified with a line-"},{"type":"text","text":" "},{"type":"text","text":"detail type. Staff lines are numbered from bottom to top. The print-object attribute allows lines to be hidden"},{"type":"text","text":" "},{"type":"text","text":"within a staff. This is used in special situations such as a widely-spaced percussion staff where a note"},{"type":"text","text":" "},{"type":"text","text":"placed below the higher line is distinct from a note placed above the lower line. Hidden staff lines are"},{"type":"text","text":" "},{"type":"text","text":"included when specifying clef lines and determining display-step \/ display-octave values, but are not counted"},{"type":"text","text":" "},{"type":"text","text":"as lines for the purposes of the system-layout and staff-layout elements."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLLineDetail"}],"title":"MXLLineDetail"},"doc://IvorMXL/documentation/IvorMXL/MXLLineDetail/line":{"role":"symbol","url":"\/documentation\/ivormxl\/mxllinedetail\/line","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLineDetail\/line","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"line"},{"kind":"text","text":": "},{"kin