{"metadata":{"title":"color","modules":[{"name":"IvorMXL"}],"role":"symbol","symbolKind":"property","roleHeading":"Instance Property","externalID":"s:7IvorMXL13MXLLineDetailV5colorAA8MXLColorVSgvp","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"color"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLColorV","text":"MXLColor"},{"kind":"text","text":"?"}]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLineDetail\/color"},"kind":"symbol","primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"text":"color","kind":"identifier"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","preciseIdentifier":"s:7IvorMXL8MXLColorV","text":"MXLColor"},{"kind":"text","text":"?"}]}],"kind":"declarations"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxllinedetail\/color"]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLineDetail"]]},"abstract":[{"type":"text","text":"The color attribute group indicates the color of an element."}],"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLLineDetail":{"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLLineDetail","kind":"identifier"}],"title":"MXLLineDetail","navigatorTitle":[{"text":"MXLLineDetail","kind":"identifier"}],"abstract":[{"type":"text","text":"If the staff-lines element is present, the appearance of each line may be individually specified with a line-"},{"type":"text","text":" "},{"type":"text","text":"detail type. Staff lines are numbered from bottom to top. The print-object attribute allows lines to be hidden"},{"type":"text","text":" "},{"type":"text","text":"within a staff. This is used in special situations such as a widely-spaced percussion staff where a note"},{"type":"text","text":" "},{"type":"text","text":"placed below the higher line is distinct from a note placed above the lower line. Hidden staff lines are"},{"type":"text","text":" "},{"type":"text","text":"included when specifying clef lines and determining display-step \/ display-octave values, but are not counted"},{"type":"text","text":" "},{"type":"text","text":"as lines for the purposes of the system-layout and staff-layout elements."}],"url":"\/documentation\/ivormxl\/mxllinedetail","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLineDetail","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLLineDetail/color":{"kind":"symbol","url":"\/documentation\/ivormxl\/mxllinedetail\/color","abstract":[{"text":"The color attribute group indicates the color of an element.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLineDetail\/color","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"color","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL8MXLColorV","text":"MXLColor","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"type":"topic","role":"symbol","title":"color"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlcolor","title":"MXLColor","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"type":"text","text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is"},{"type":"text","text":" "},{"type":"text","text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor"}}}