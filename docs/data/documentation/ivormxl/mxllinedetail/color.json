{"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"color"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","preciseIdentifier":"s:7IvorMXL8MXLColorV","text":"MXLColor"},{"kind":"text","text":"?"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"}],"kind":"symbol","metadata":{"symbolKind":"property","externalID":"s:7IvorMXL13MXLLineDetailV5colorAA8MXLColorVSgvp","roleHeading":"Instance Property","modules":[{"name":"IvorMXL"}],"title":"color","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"color"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLColorV","text":"MXLColor"},{"kind":"text","text":"?"}],"role":"symbol"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxllinedetail\/color"]}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLineDetail\/color"},"abstract":[{"type":"text","text":"The color attribute group indicates the color of an element."}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLineDetail"]]},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"title":"MXLColor","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"abstract":[{"text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in","type":"text"},{"text":" ","type":"text"},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"url":"\/documentation\/ivormxl\/mxlcolor"},"doc://IvorMXL/documentation/IvorMXL/MXLLineDetail/color":{"role":"symbol","url":"\/documentation\/ivormxl\/mxllinedetail\/color","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLineDetail\/color","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"color"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL8MXLColorV","kind":"typeIdentifier","text":"MXLColor"},{"kind":"text","text":"?"}],"kind":"symbol","abstract":[{"type":"text","text":"The color attribute group indicates the color of an element."}],"type":"topic","title":"color"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLLineDetail":{"role":"symbol","url":"\/documentation\/ivormxl\/mxllinedetail","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLineDetail","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLLineDetail"}],"abstract":[{"type":"text","text":"If the staff-lines element is present, the appearance of each line may be individually specified with a line-"},{"type":"text","text":" "},{"type":"text","text":"detail type. Staff lines are numbered from bottom to top. The print-object attribute allows lines to be hidden"},{"type":"text","text":" "},{"type":"text","text":"within a staff. This is used in special situations such as a widely-spaced percussion staff where a note"},{"type":"text","text":" "},{"type":"text","text":"placed below the higher line is distinct from a note placed above the lower line. Hidden staff lines are"},{"type":"text","text":" "},{"type":"text","text":"included when specifying clef lines and determining display-step \/ display-octave values, but are not counted"},{"type":"text","text":" "},{"type":"text","text":"as lines for the purposes of the system-layout and staff-layout elements."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLLineDetail"}],"title":"MXLLineDetail"}}}