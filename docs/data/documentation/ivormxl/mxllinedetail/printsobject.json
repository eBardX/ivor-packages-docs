{"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"printsObject","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":"?","kind":"text"}],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Maps to the MusicXML ","type":"text"},{"type":"codeVoice","code":"print-object"},{"text":" attribute.","type":"text"}]}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLineDetail\/printsObject"},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxllinedetail\/printsobject"]}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLineDetail"]]},"sections":[],"abstract":[{"type":"text","text":"A Boolean value indicating whether to print an object (e.g. a note or a rest). Defaults to "},{"code":"true","type":"codeVoice"},{"type":"text","text":" if not"},{"type":"text","text":" "},{"type":"text","text":"specified."}],"metadata":{"symbolKind":"property","externalID":"s:7IvorMXL13MXLLineDetailV12printsObjectSbSgvp","modules":[{"name":"IvorMXL"}],"roleHeading":"Instance Property","role":"symbol","title":"printsObject","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"printsObject","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":"?","kind":"text"}]},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLLineDetail/printsObject":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLineDetail\/printsObject","abstract":[{"type":"text","text":"A Boolean value indicating whether to print an object (e.g. a note or a rest). Defaults to "},{"type":"codeVoice","code":"true"},{"type":"text","text":" if not"},{"type":"text","text":" "},{"type":"text","text":"specified."}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"printsObject","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":"?","kind":"text"}],"type":"topic","kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxllinedetail\/printsobject","title":"printsObject"},"doc://IvorMXL/documentation/IvorMXL/MXLLineDetail":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLLineDetail","kind":"identifier"}],"title":"MXLLineDetail","abstract":[{"type":"text","text":"If the staff-lines element is present, the appearance of each line may be individually specified with a line-"},{"type":"text","text":" "},{"type":"text","text":"detail type. Staff lines are numbered from bottom to top. The print-object attribute allows lines to be hidden"},{"type":"text","text":" "},{"type":"text","text":"within a staff. This is used in special situations such as a widely-spaced percussion staff where a note"},{"type":"text","text":" "},{"type":"text","text":"placed below the higher line is distinct from a note placed above the lower line. Hidden staff lines are"},{"type":"text","text":" "},{"type":"text","text":"included when specifying clef lines and determining display-step \/ display-octave values, but are not counted"},{"type":"text","text":" "},{"type":"text","text":"as lines for the purposes of the system-layout and staff-layout elements."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLineDetail","role":"symbol","url":"\/documentation\/ivormxl\/mxllinedetail","kind":"symbol","navigatorTitle":[{"text":"MXLLineDetail","kind":"identifier"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"}}}