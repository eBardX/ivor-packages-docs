ol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLLineDetail":{"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLLineDetail"}],"title":"MXLLineDetail","url":"\/documentation\/ivormxl\/mxllinedetail","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLLineDetail","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLineDetail","abstract":[{"type":"text","text":"If the staff-lines element is present, the appearance of each line may be individually specified with a line-"},{"type":"text","text":" "},{"type":"text","text":"detail type. Staff lines are numbered from bottom to top. The print-object attribute allows lines to be hidden"},{"type":"text","text":" "},{"type":"text","text":"within a staff. This is used in special situations such as a widely-spaced percussion staff where a note"},{"type":"text","text":" "},{"type":"text","text":"placed below the higher line is distinct from a note placed above the lower line. Hidden staff lines are"},{"type":"text","text":" "},{"type":"text","text":"included when specifying clef lines and determining display-step \/ display-octave values, but are not counted"},{"type":"text","text":" "},{"type":"text","text":"as lines for the purposes of the system-layout and staff-layout elements."}]},"doc://IvorMXL/documentation/IvorMXL/MXLLineDetail/printsObject":{"title":"printsObject","url":"\/documentation\/ivormxl\/mxllinedetail\/printsobject","type":"topic","abstract":[{"type":"text","text":"A Boolean value indicating whether to print an object (e.g. a note or a rest). Defaults to "},{"type":"codeVoice","code":"true"},{"type":"text","text":" if not"},{"type":"text","text":" "},{"type":"text","text":"specified."}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"printsObject","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdent