XL"},"doc://IvorMXL/documentation/IvorMXL/MXLDegree/Kind-swift.struct":{"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxldegree\/kind-swift.struct","abstract":[{"type":"text","text":"The degree-type type indicates if this degree is an addition, alteration, or subtraction relative to the kind"},{"type":"text","text":" "},{"type":"text","text":"of the current chord. The value of the degree-type element affects the interpretation of the value of the"},{"type":"text","text":" "},{"type":"text","text":"degree-alter element. The text attribute specifies how the type of the degree should be displayed."}],"navigatorTitle":[{"text":"Kind","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Kind","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree\/Kind-swift.struct","title":"MXLDegree.Kind"},"doc://IvorMXL/documentation/IvorMXL/MXLDegree":{"role":"symbol","abstract":[{"text":"The degree type is used to add, alter, or subtract individual notes in the chord. The print-object attribute","type":"text"},{"text":" ","type":"text"},{"text":"can be used to keep the degree from printing separately when it has already taken into account in the text","type":"text"},{"text":" ","type":"text"},{"text":"attribute of the kind element. The degree-value and degree-type text attributes specify how the value and type","type":"text"},{"text":" ","type":"text"},{"text":"of the degree should be displayed.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree","url":"\/documentation\/ivormxl\/mxldegree","title":"MXLDegree","navigatorTitle":[{"kind":"identifier","text":"MXLDegree"}],"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLDegree"}]},"doc://IvorMXL/documentation/IvorMXL/MXLDegree/kind-swift.property":{"role":"symbol","kind":"symbol","title":"kind","abstra