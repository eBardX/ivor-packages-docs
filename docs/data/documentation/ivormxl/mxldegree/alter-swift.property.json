":{"navigatorTitle":[{"kind":"identifier","text":"MXLDegree"}],"abstract":[{"text":"The degree type is used to add, alter, or subtract individual notes in the chord. The print-object attribute","type":"text"},{"text":" ","type":"text"},{"text":"can be used to keep the degree from printing separately when it has already taken into account in the text","type":"text"},{"text":" ","type":"text"},{"text":"attribute of the kind element. The degree-value and degree-type text attributes specify how the value and type","type":"text"},{"text":" ","type":"text"},{"text":"of the degree should be displayed.","type":"text"}],"title":"MXLDegree","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree","kind":"symbol","url":"\/documentation\/ivormxl\/mxldegree","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLDegree"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLDegree/alter-swift.property":{"abstract":[{"text":"The chromatic alteration for this degree.","type":"text"}],"title":"alter","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree\/alter-swift.property","kind":"symbol","url":"\/documentation\/ivormxl\/mxldegree\/alter-swift.property","type":"topic","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"alter"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLDegreeV5AlterV","text":"Alter"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLDegree/Alter-swift.struct":{"title":"MXLDegree.Alter","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Alter"}],"kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxldegree\/alter-swift.struct","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree\/Alter-swift.struct","abstract":[{"text":"The degree-alter type represents the chromatic alteration for the current degree. If the degree-type value is","type":"text"},{"text":" ","type":"text"},{"text":"alter or subtract, the degree-alter value is relative to the degree already in the chord based on its kind","type":"text"},{"text":" ","type":"text"},{"text":"element. If the degree-type value is add, the degree-alter is relative to a dominant chord (major and perfect","type":"text"},{"text":" ","type":"text"},{"text":"intervals except for a minor seventh). The plus-minus attribute is used to indicate if plus and minus symbols","type":"text"},{"text":" ","type":"text"},{"text":"should be used instead of sharp and flat symbols to display the degree alteration. It is no if not specified.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"Alter"}]}}}