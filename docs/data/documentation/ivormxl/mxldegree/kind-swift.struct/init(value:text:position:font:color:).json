ree should be displayed.","type":"text"}],"title":"MXLDegree.Kind","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree\/Kind-swift.struct","kind":"symbol","url":"\/documentation\/ivormxl\/mxldegree\/kind-swift.struct","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Kind"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLDegree/Kind-swift.struct/init(value:text:position:font:color:)":{"abstract":[{"text":"Creates a new ","type":"text"},{"code":"MXLDegree.Kind","type":"codeVoice"},{"type":"text","text":"."}],"title":"init(value:text:position:font:color:)","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree\/Kind-swift.struct\/init(value:text:position:font:color:)","kind":"symbol","url":"\/documentation\/ivormxl\/mxldegree\/kind-swift.struct\/init(value:text:position:font:color:)","type":"topic","fragments":[{"text":"init","kind":"identifier"},{"kind":"text","text":"("},{"text":"value","kind":"externalParam"},{"kind":"text","text":": "},{"text":"Value","preciseIdentifier":"s:7IvorMXL9MXLDegreeV4KindV5ValueO","kind":"typeIdentifier"},{"kind":"text","text":", "},{"text":"text","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"position","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLPosition","preciseIdentifier":"s:7IvorMXL11MXLPositionV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"font","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLFont","preciseIdentifier":"s:7IvorMXL7MXLFontV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"color","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLColor","preciseIdentifier":"s:7IvorMXL8MXLColorV","kind":"typeIdentifier"},{"text":"?)","kind":"text"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"abstract":[{"text":"The color ty