mal"},{"type":"text","text":" "},{"type":"text","text":"or italic. The font-size can be one of the CSS sizes or a numeric point size. The"},{"type":"text","text":" "},{"type":"text","text":"font-weight can be normal or bold. The default is application-dependent, but is a"},{"type":"text","text":" "},{"type":"text","text":"text font vs. a music font."}]}],"name":"font"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The color attribute group indicates the color of an element."}]}],"name":"color"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxldegree\/kind-swift.struct\/init(value:text:position:font:color:)"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree\/Kind-swift.struct\/init(value:text:position:font:color:)"},"abstract":[{"type":"text","text":"Creates a new "},{"code":"MXLDegree.Kind","type":"codeVoice"},{"type":"text","text":"."}],"references":{"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLPosition":{"type":"topic","abstract":[{"type":"text","text":"For most elements, any program will compute a default x and y position. The position attributes let this be"},{"type":"text","text":" "},{"type":"text","text":"changed two ways."}],"url":"\/documentation\/ivormxl\/mxlposition","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPosition"}],"kind":"symbol","title":"MXLPosition","navigatorTitle":[{"kind":"identifier","text":"MXLPosition"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLDegree/Kind-swift.struct":{"type":"topic","title":"MXLDegree.Kind","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree\/Kind-swift.struct","abstract":[{"type":"text","text":"The degree-type type indicates if this degree is an addition, alteration, or subtraction relative to the kind"},{"type":"text","text":" "},{"type":"text","text":"of the current chord. The value of the degree-type element affects the interpretation of the value of the"},{"type":"text","text":" "},{"type":"text","text":"degree-alter element. The text attribute specifies how the type of the degree should be displayed."}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Kind","kind":"identifier"}],"navigatorTitle":[{"text":"Kind","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxldegree\/kind-swift.struct"},"doc://IvorMXL/documentation/IvorMXL/MXLDegree/Kind-swift.struct/init(value:text:position:font:color:)":{"title":"init(value:text:position:font:color:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"value","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Value","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLDegreeV4KindV5ValueO"},{"text":", ","kind":"text"},{"text":"text","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?, ","kind":"text"},{"text":"position","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLPosition","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLPositionV"},{"text":", ","kind":"text"},{"text":"font","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLFont","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL7MXLFontV"},{"text":", ","kind":"text"},{"text":"color","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLColor","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLColorV"},{"text":"?)","kind":"text"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxldegree\/kind-swift.struct\/init(value:text:position:font:color:)","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree\/Kind-swift.struct\/init(value:text:position:font:color:)","abstract":[{"type":"text","text":"Creates a new "},{"code":"MXLDegree.Kind","type":"codeVoice"},{"type":"text","text":"."}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"type":"topic","abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"type":"text","text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is"},{"type":"text","text":" "},{"type":"text","text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF."}],"url":"\/documentation\/ivormxl\/mxlcolor","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"kind":"symbol","title":"MXLColor","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLFont":{"type":"topic","title":"MXLFont","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","abstract":[{"type":"text","text":"The font attribute group gathers together attributes for determining the font within a credit or direction."},{"type":"text","text":" "},{"type":"text","text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of"},{"type":"text","text":" "},{"type":"text","text":"font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric"},{"type":"text","text":" "},{"type":"text","text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font"},{"type":"text","text":" "},{"type":"text","text":"vs. a music font."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFont"}],"navigatorTitle":[{"kind":"identifier","text":"MXLFont"}],"url":"\/documentation\/ivormxl\/mxlfont"},"doc://IvorMXL/documentation/IvorMXL/MXLDegree/Kind-swift.struct/Value-swift.enum":{"title":"MXLDegree.Kind.Value","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Value","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxldegree\/kind-swift.struct\/value-swift.enum","role":"symbol","navigatorTitle":[{"text":"Value","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree\/Kind-swift.struct\/Value-swift.enum","abstract":[{"type":"text","text":"The degree-type-value type indicates whether the current degree element is an addition, alteration, or"},{"type":"text","text":" "},{"type":"text","text":"subtraction to the kind of the current chord in the harmony element."}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLDegree":{"type":"topic","title":"MXLDegree","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree","abstract":[{"type":"text","text":"The degree type is used to add, alter, or subtract individual notes in the chord. The print-object attribute"},{"type":"text","text":" "},{"type":"text","text":"can be used to keep the degree from printing separately when it has already taken into account in the text"},{"type":"text","text":" "},{"type":"text","text":"attribute of the kind element. The degree-value and degree-type text attributes specify how the value and type"},{"type":"text","text":" "},{"type":"text","text":"of the degree should be displayed."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLDegree"}],"navigatorTitle":[{"kind":"identifier","text":"MXLDegree"}],"url":"\/documentation\/ivormxl\/mxldegree"}}}