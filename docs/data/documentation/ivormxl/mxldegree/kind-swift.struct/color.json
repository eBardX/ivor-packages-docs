on\/IvorMXL\/MXLDegree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLDegree","kind":"identifier"}],"abstract":[{"text":"The degree type is used to add, alter, or subtract individual notes in the chord. The print-object attribute","type":"text"},{"text":" ","type":"text"},{"text":"can be used to keep the degree from printing separately when it has already taken into account in the text","type":"text"},{"text":" ","type":"text"},{"text":"attribute of the kind element. The degree-value and degree-type text attributes specify how the value and type","type":"text"},{"text":" ","type":"text"},{"text":"of the degree should be displayed.","type":"text"}],"navigatorTitle":[{"text":"MXLDegree","kind":"identifier"}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLDegree/Kind-swift.struct":{"navigatorTitle":[{"text":"Kind","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxldegree\/kind-swift.struct","kind":"symbol","type":"topic","role":"symbol","title":"MXLDegree.Kind","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree\/Kind-swift.struct","abstract":[{"text":"The degree-type type indicates if this degree is an addition, alteration, or subtraction relative to the kind","type":"text"},{"text":" ","type":"text"},{"text":"of the current chord. The value of the degree-type element affects the interpretation of the value of the","type":"text"},{"text":" ","type":"text"},{"text":"degree-alter element. The text attribute specifies how the type of the degree should be displayed.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Kind","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLDegree/Kind-swift.struct/color":{"title":"color","role":"symbol","abstract":[{"type":"text","text":"The color attribute group indicates the color of an element."}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"color"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLColorV","text":"MXLColor"},{"kind":"text","text":"?"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree\/Kind-swift.struct\/color","url":"\/documentation\/ivormxl\/mxldegree\/kind-swift.struct\/color","type":"topic","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlcolor","title":"MXLColor","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"type":"text","text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is"},{"type":"text","text":" "},{"type":"text","text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor"}}}