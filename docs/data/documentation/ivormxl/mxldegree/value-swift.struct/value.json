"},{"type":"text","text":" "},{"type":"text","text":"the value of the text attribute follows the symbol."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree\/Value-swift.struct","role":"symbol","navigatorTitle":[{"text":"Value","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxldegree\/value-swift.struct"},"doc://IvorMXL/documentation/IvorMXL/MXLDegree/Value-swift.struct/value":{"type":"topic","abstract":[{"text":"The value of this element.","type":"text"}],"kind":"symbol","title":"value","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree\/Value-swift.struct\/value","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"value","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"url":"\/documentation\/ivormxl\/mxldegree\/value-swift.struct\/value"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLDegree":{"title":"MXLDegree","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLDegree"}],"abstract":[{"type":"text","text":"The degree type is used to add, alter, or subtract individual notes in the chord. The print-object attribute"},{"type":"text","text":" "},{"type":"text","text":"can be used to keep the degree from printing separately when it has already taken into account in the text"},{"type":"text","text":" "},{"type":"text","text":"attribute of the kind element. The degree-value and degree-type text attributes specify how the value and type"},{"type":"text","text":" "},{"type":"text","text":"of the degree should be displayed."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree","role":"symbol","navigatorTitle":[{"text":"MXLDegree","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxldegree"}}}