{"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"value"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"}],"languages":["swift"]}]}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree\/Value-swift.struct"]]},"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree\/Value-swift.struct\/value","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"The value of this element."}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxldegree\/value-swift.struct\/value"]}],"metadata":{"symbolKind":"property","externalID":"s:7IvorMXL9MXLDegreeV5ValueV5valueSivp","roleHeading":"Instance Property","modules":[{"name":"IvorMXL"}],"role":"symbol","title":"value","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"value"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"}]},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLDegree/Value-swift.struct":{"navigatorTitle":[{"text":"Value","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxldegree\/value-swift.struct","kind":"symbol","type":"topic","role":"symbol","title":"MXLDegree.Value","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree\/Value-swift.struct","abstract":[{"text":"The content of the degree-value type is a number indicating the degree of the chord (1 for the root, 3 for","type":"text"},{"type":"text","text":" "},{"text":"third, etc). The text attribute specifies how the value of the degree should be displayed. The symbol","type":"text"},{"type":"text","text":" "},{"text":"attribute indicates that a symbol should be used in specifying the degree. If the symbol attribute is present,","type":"text"},{"text":" ","type":"text"},{"text":"the value of the text attribute follows the symbol.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Value","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLDegree":{"type":"topic","url":"\/documentation\/ivormxl\/mxldegree","role":"symbol","title":"MXLDegree","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLDegree","kind":"identifier"}],"abstract":[{"text":"The degree type is used to add, alter, or subtract individual notes in the chord. The print-object attribute","type":"text"},{"text":" ","type":"text"},{"text":"can be used to keep the degree from printing separately when it has already taken into account in the text","type":"text"},{"text":" ","type":"text"},{"text":"attribute of the kind element. The degree-value and degree-type text attributes specify how the value and type","type":"text"},{"text":" ","type":"text"},{"text":"of the degree should be displayed.","type":"text"}],"navigatorTitle":[{"text":"MXLDegree","kind":"identifier"}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLDegree/Value-swift.struct/value":{"abstract":[{"text":"The value of this element.","type":"text"}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"value","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxldegree\/value-swift.struct\/value","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree\/Value-swift.struct\/value","type":"topic","role":"symbol","title":"value"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection",