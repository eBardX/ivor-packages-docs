text":" follows the symbol.","type":"text"}],"type":"paragraph"}]},{"name":"text","content":[{"inlineContent":[{"type":"text","text":"Specifies how the value of the degree should be displayed."}],"type":"paragraph"}]},{"name":"position","content":[{"inlineContent":[{"type":"text","text":"For most elements, any program will compute a default x and y position. The position attributes let this be changed two ways."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The font attribute group gathers together attributes for determining the font within a credit or direction. They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of font names.The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font vs. a music font.","type":"text"}]}],"name":"font"},{"content":[{"inlineContent":[{"type":"text","text":"The color attribute group indicates the color of an element."}],"type":"paragraph"}],"name":"color"}],"kind":"parameters"}],"abstract":[{"text":"Creates a new ","type":"text"},{"code":"MXLDegree.Value","type":"codeVoice"},{"text":".","type":"text"}],"sections":[],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLFont":{"title":"MXLFont","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFont"}],"abstract":[{"text":"The font attribute group gathers together attributes for determining the font within a credit or direction.","type":"text"},{"text":" ","type":"text"},{"text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of","type":"text"},{"text":" ","type":"text"},{"text":"font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric","type":"text"},{"text":" ","type":"text"},{"text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font","type":"text"},{"text":" ","type":"text"},{"text":"vs. a music font.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLFont"}],"url":"\/documentation\/ivormxl\/mxlfont"},"doc://IvorMXL/documentation/IvorMXL/MXLDegree/Value-swift.struct":{"title":"MXLDegree.Value","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Value"}],"abstract":[{"type":"text","text":"The content of the degree-value type is a number indicating the degree of the chord (1 for the root, 3 for"},{"type":"text","text":" "},{"type":"text","text":"third, etc). The text attribute specifies how the value of the degree should be displayed. The symbol"},{"type":"text","text":" "},{"type":"text","text":"attribute indicates that a symbol should be used in specifying the degree. If the symbol attribute is present,"},{"type":"text","text":" "},{"type":"text","text":"the value of the text attribute follows the symbol."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree\/Value-swift.struct","role":"symbol","navigatorTitle":[{"text":"Value","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxldegree\/value-swift.struct"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLPosition":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlposition","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPosition"}],"kind":"symbol","abstract":[{"text":"For most elements, any program will compute a default x and y position. The position attributes let this be","type":"text"},{"text":" ","type":"text"},{"text":"changed two ways.","type":"text"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLPosition"}],"title":"MXLPosition"},"doc://IvorMXL/documentation/IvorMXL/MXLDegree":{"title":"MXLDegree","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLDegree"}],"abstract":[{"type":"text","text":"The degree type is used to add, alter, or subtract individual notes in the chord. The print-object attribute"},{"type":"text","text":" "},{"type":"text","text":"can be used to keep the degree from printing separately when it has already taken into account in the text"},{"type":"text","text":" "},{"type":"text","text":"attribute of the kind element. The degree-value and degree-type text attributes specify how the value and type"},{"type":"text","text":" "},{"type":"text","text":"of the degree should be displayed."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree","role":"symbol","navigatorTitle":[{"text":"MXLDegree","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxldegree"},"doc://IvorMXL/documentation/IvorMXL/MXLDegree/SymbolValue":{"abstract":[{"type":"text","text":"The degree-symbol-value type indicates which symbol should be used in specifying a degree."}],"title":"MXLDegree.SymbolValue","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SymbolValue","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxldegree\/symbolvalue","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree\/SymbolValue","kind":"symbol","type":"topic","navigatorTitle":[{"text":"SymbolValue","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"title":"MXLColor","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"abstract":[{"text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in","type":"text"},{"text":" ","type":"text"},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"url":"\/documentation\/ivormxl\/mxlcolor"},"doc://IvorMXL/documentation/IvorMXL/MXLDegree/Value-swift.struct/init(value:symbol:text:position:font:color:)":{"kind":"symbol","abstract":[{"type":"text","text":"Creates a new "},{"code":"MXLDegree.Value","type":"codeVoice"},{"type":"text","text":"."}],"title":"init(value:symbol:text:position:font:color:)","type":"topic","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree\/Value-swift.struct\/init(value:symbol:text:position:font:color:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"value"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":", "},{"kind":"externalParam","text":"symbol"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"SymbolValue","preciseIdentifier":"s:7IvorMXL9MXLDegreeV11SymbolValueO"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"text"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"position"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLPosition","preciseIdentifier":"s:7IvorMXL11MXLPositionV"},{"kind":"text","t