e":"text","text":" "},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlcolor"},"doc://IvorMXL/documentation/IvorMXL/MXLDegree/Value-swift.struct/color":{"type":"topic","abstract":[{"text":"The color attribute group indicates the color of an element.","type":"text"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree\/Value-swift.struct\/color","title":"color","url":"\/documentation\/ivormxl\/mxldegree\/value-swift.struct\/color","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"color"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL8MXLColorV","kind":"typeIdentifier","text":"MXLColor"},{"kind":"text","text":"?"}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLDegree/Value-swift.struct":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree\/Value-swift.struct","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Value"}],"abstract":[{"text":"The content of the degree-value type is a number indicating the degree of the chord (1 for the root, 3 for","type":"text"},{"text":" ","type":"text"},{"text":"third, etc). The text attribute specifies how the value of the degree should be displayed. The symbol","type":"text"},{"text":" ","type":"text"},{"text":"attribute indicates that a symbol should be used in specifying the degree. If the symbol attribute is present,","type":"text"},{"text":" ","type":"text"},{"text":"the value of the text attribute follows the symbol.","type":"text"}],"kind":"symbol","title":"MXLDegree.Value","url":"\/documentation\/ivormxl\/mxldegree\/value-swift.struct","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Value"}]},"doc://IvorMXL/documentation/IvorMXL/MXLDegree":{"role":"symbol","abstract":[{"text":"The degree type is used to add, alter, or subtract individual notes in the chord. The print-object attribute","type":"text"},{"text":" ","type":"text"},{"text":"can be used to keep the degree from printing separately when it has already taken into account in the text","type":"text"},{"text":" ","type":"text"},{"text":"attribute of the kind element. The degree-value and degree-type text attributes specify how the value and type","type":"text"},{"text":" ","type":"text"},{"text":"of the degree should be displayed.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree","url":"\/documentation\/ivormxl\/mxldegree","title":"MXLDegree","navigatorTitle":[{"kind":"identifier","text":"MXLDegree"}],"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLDegree"}]}}}