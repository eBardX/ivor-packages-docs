lue-swift.struct":{"type":"topic","title":"MXLDegree.Value","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree\/Value-swift.struct","abstract":[{"type":"text","text":"The content of the degree-value type is a number indicating the degree of the chord (1 for the root, 3 for"},{"type":"text","text":" "},{"type":"text","text":"third, etc). The text attribute specifies how the value of the degree should be displayed. The symbol"},{"type":"text","text":" "},{"type":"text","text":"attribute indicates that a symbol should be used in specifying the degree. If the symbol attribute is present,"},{"type":"text","text":" "},{"type":"text","text":"the value of the text attribute follows the symbol."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Value"}],"navigatorTitle":[{"kind":"identifier","text":"Value"}],"url":"\/documentation\/ivormxl\/mxldegree\/value-swift.struct"},"doc://IvorMXL/documentation/IvorMXL/MXLDegree":{"type":"topic","title":"MXLDegree","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree","abstract":[{"type":"text","text":"The degree type is used to add, alter, or subtract individual notes in the chord. The print-object attribute"},{"type":"text","text":" "},{"type":"text","text":"can be used to keep the degree from printing separately when it has already taken into account in the text"},{"type":"text","text":" "},{"type":"text","text":"attribute of the kind element. The degree-value and degree-type text attributes specify how the value and type"},{"type":"text","text":" "},{"type":"text","text":"of the degree should be displayed."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLDegree"}],"navigatorTitle":[{"kind":"identifier","text":"MXLDegree"}],"url":"\/documentation\/ivormxl\/mxldegree"}}}