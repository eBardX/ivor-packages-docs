{"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree\/Alter-swift.struct\/value"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"value","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"}],"platforms":["macOS"],"languages":["swift"]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxldegree\/alter-swift.struct\/value"]}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree\/Alter-swift.struct"]]},"abstract":[{"text":"The value of this element.","type":"text"}],"sections":[],"metadata":{"modules":[{"name":"IvorMXL"}],"title":"value","symbolKind":"property","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"value","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"}],"externalID":"s:7IvorMXL9MXLDegreeV5AlterV5valueSdvp","role":"symbol","roleHeading":"Instance Property"},"kind":"symbol","references":{"doc://IvorMXL/documentation/IvorMXL/MXLDegree/Alter-swift.struct/value":{"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree\/Alter-swift.struct\/value","url":"\/documentation\/ivormxl\/mxldegree\/alter-swift.struct\/value","title":"value","abstract":[{"text":"The value of this element.","type":"text"}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"value"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"}],"kind":"symbol","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLDegree/Alter-swift.struct":{"role":"symbol","kind":"symbol","title":"MXLDegree.Alter","abstract":[{"type":"text","text":"The degree-alter type represents the chromatic alteration for the current degree. If the degree-type value is"},{"type":"text","text":" "},{"type":"text","text":"alter or subtract, the degree-alter value is relative to the degree already in the chord based on its kind"},{"type":"text","text":" "},{"type":"text","text":"element. If the degree-type value is add, the degree-alter is relative to a dominant chord (major and perfect"},{"type":"text","text":" "},{"type":"text","text":"intervals except for a minor seventh). The plus-minus attribute is used to indicate if plus and minus symbols"},{"type":"text","text":" "},{"type":"text","text":"should be used instead of sharp and flat symbols to display the degree alteration. It is no if not specified."}],"url":"\/documentation\/ivormxl\/mxldegree\/alter-swift.struct","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Alter"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree\/Alter-swift.struct","navigatorTitle":[{"kind":"identifier","text":"Alter"}]},"doc://IvorMXL/documentation/IvorMXL/MXLDegree":{"role":"symbol","abstract":[{"text":"The degree type is used to add, alter, or subtract individual notes in the chord. The print-object attribute","type":"text"},{"text":" ","type":"text"},{"text":"can be used to keep the degree from printing separately when it has already taken into account in the text","type":"text"},{"text":" ","type":"text"},{"text":"attribute of the kind element. The degree-value and degree-type text attributes specify how the value and type","type":"text"},{"text":" ","type":"text"},{"text":"of the degree should be displayed.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree","url":"\/documentation\/ivormxl\/mxldegree","title":"MXLDegree","navigatorTitle":[{"kind":"identifier","text":"MXLDegree"}],"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLDegree"}]}}}