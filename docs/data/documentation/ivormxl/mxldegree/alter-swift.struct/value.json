{"metadata":{"title":"value","symbolKind":"property","roleHeading":"Instance Property","externalID":"s:7IvorMXL9MXLDegreeV5AlterV5valueSdvp","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"value","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sd","text":"Double","kind":"typeIdentifier"}],"modules":[{"name":"IvorMXL"}]},"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree\/Alter-swift.struct\/value","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/ivormxl\/mxldegree\/alter-swift.struct\/value"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"value","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sd","text":"Double","kind":"typeIdentifier"}]}]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree\/Alter-swift.struct"]]},"abstract":[{"text":"The value of this element.","type":"text"}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLDegree/Alter-swift.struct/value":{"url":"\/documentation\/ivormxl\/mxldegree\/alter-swift.struct\/value","abstract":[{"text":"The value of this element.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree\/Alter-swift.struct\/value","title":"value","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"value"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sd","kind":"typeIdentifier","text":"Double"}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLDegree/Alter-swift.struct":{"type":"topic","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Alter","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree\/Alter-swift.struct","title":"MXLDegree.Alter","abstract":[{"type":"text","text":"The degree-alter type represents the chromatic alteration for the current degree. If the degree-type value is"},{"type":"text","text":" "},{"type":"text","text":"alter or subtract, the degree-alter value is relative to the degree already in the chord based on its kind"},{"type":"text","text":" "},{"type":"text","text":"element. If the degree-type value is add, the degree-alter is relative to a dominant chord (major and perfect"},{"type":"text","text":" "},{"type":"text","text":"intervals except for a minor seventh). The plus-minus attribute is used to indicate if plus and minus symbols"},{"type":"text","text":" "},{"type":"text","text":"should be used instead of sharp and flat symbols to display the degree alteration. It is no if not specified."}],"navigatorTitle":[{"text":"Alter","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxldegree\/alter-swift.struct"},"doc://IvorMXL/documentation/IvorMXL/MXLDegree":{"title":"MXLDegree","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLDegree"}],"abstract":[{"type":"text","text":"The degree type is used to add, alter, or subtract individual notes in the chord. The print-object attribute"},{"type":"text","text":" "},{"type":"text","text":"can be used to keep the degree from printing separately when it has already taken into account in the text"},{"type":"text","text":" "},{"type":"text","text":"attribute of the kind element. The degree-value and degree-type text attributes specify how the value and type"},{"type":"text","text":" "},{"type":"text","text":"of the degree should be displayed."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree","role":"symbol","navigatorTitle":[{"text":"MXLDegree","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxldegree"}}}