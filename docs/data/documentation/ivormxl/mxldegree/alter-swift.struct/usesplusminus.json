ruct":{"type":"topic","url":"\/documentation\/ivormxl\/mxldegree\/alter-swift.struct","role":"symbol","title":"MXLDegree.Alter","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree\/Alter-swift.struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Alter","kind":"identifier"}],"abstract":[{"text":"The degree-alter type represents the chromatic alteration for the current degree. If the degree-type value is","type":"text"},{"text":" ","type":"text"},{"text":"alter or subtract, the degree-alter value is relative to the degree already in the chord based on its kind","type":"text"},{"text":" ","type":"text"},{"text":"element. If the degree-type value is add, the degree-alter is relative to a dominant chord (major and perfect","type":"text"},{"text":" ","type":"text"},{"text":"intervals except for a minor seventh). The plus-minus attribute is used to indicate if plus and minus symbols","type":"text"},{"text":" ","type":"text"},{"text":"should be used instead of sharp and flat symbols to display the degree alteration. It is no if not specified.","type":"text"}],"navigatorTitle":[{"text":"Alter","kind":"identifier"}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLDegree":{"type":"topic","url":"\/documentation\/ivormxl\/mxldegree","role":"symbol","title":"MXLDegree","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLDegree","kind":"identifier"}],"abstract":[{"text":"The degree type is used to add, alter, or subtract individual notes in the chord. The print-object attribute","type":"text"},{"text":" ","type":"text"},{"text":"can be used to keep the degree from printing separately when it has already taken into account in the text","type":"text"},{"text":" ","type":"text"},{"text":"attribute of the kind element. The degree-value and degree-type text attributes specify how the value and type","type":"text"},{"text":" ","type":"text"},{"text":"of the degree should be displayed.","type":"text"}],"navigatorTitle":[{"text":"MXLDegree","kind":"identifier"}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLDegree/Alter-swift.struct/usesPlusMinus":{"abstract":[{"text":"A Boolean value indicating whether plus and minus symbols should be used instead of sharp and flat symbols","type":"text"},{"text":" ","type":"text"},{"text":"to display the degree alteration. ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" if not specified.","type":"text"}],"url":"\/documentation\/ivormxl\/mxldegree\/alter-swift.struct\/usesplusminus","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree\/Alter-swift.struct\/usesPlusMinus","type":"topic","role":"symbol","kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"usesPlusMinus","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"title":"usesPlusMinus"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]}}}