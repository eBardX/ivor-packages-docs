ruct/usesPlusMinus":{"type":"topic","role":"symbol","abstract":[{"text":"A Boolean value indicating whether plus and minus symbols should be used instead of sharp and flat symbols","type":"text"},{"text":" ","type":"text"},{"text":"to display the degree alteration. ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" if not specified.","type":"text"}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"usesPlusMinus"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":"?"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree\/Alter-swift.struct\/usesPlusMinus","kind":"symbol","title":"usesPlusMinus","url":"\/documentation\/ivormxl\/mxldegree\/alter-swift.struct\/usesplusminus"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLDegree/Alter-swift.struct":{"type":"topic","title":"MXLDegree.Alter","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree\/Alter-swift.struct","abstract":[{"type":"text","text":"The degree-alter type represents the chromatic alteration for the current degree. If the degree-type value is"},{"type":"text","text":" "},{"type":"text","text":"alter or subtract, the degree-alter value is relative to the degree already in the chord based on its kind"},{"type":"text","text":" "},{"type":"text","text":"element. If the degree-type value is add, the degree-alter is relative to a dominant chord (major and perfect"},{"type":"text","text":" "},{"type":"text","text":"intervals except for a minor seventh). The plus-minus attribute is used to indicate if plus and minus symbols"},{"type":"text","text":" "},{"type":"text","text":"should be used instead of sharp and flat symbols to display the degree alteration. It is no if not specified."}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Alter","kind":"identifier"}],"navigatorTitle":[{"text":"Alter","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxldegree\/alter-swift.struct"},"doc://IvorMXL/documentation/IvorMXL/MXLDegree":{"type":"topic","title":"MXLDegree","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree","abstract":[{"type":"text","text":"The degree type is used to add, alter, or subtract individual notes in the chord. The print-object attribute"},{"type":"text","text":" "},{"type":"text","text":"can be used to keep the degree from printing separately when it has already taken into account in the text"},{"type":"text","text":" "},{"type":"text","text":"attribute of the kind element. The degree-value and degree-type text attributes specify how the value and type"},{"type":"text","text":" "},{"type":"text","text":"of the degree should be displayed."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLDegree"}],"navigatorTitle":[{"kind":"identifier","text":"MXLDegree"}],"url":"\/documentation\/ivormxl\/mxldegree"}}}