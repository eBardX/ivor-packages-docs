{"kind":"symbol","abstract":[{"type":"text","text":"The color attribute group indicates the color of an element."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"color","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLColor","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLColorV"},{"text":"?","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}]}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree\/Alter-swift.struct"]]},"metadata":{"modules":[{"name":"IvorMXL"}],"roleHeading":"Instance Property","externalID":"s:7IvorMXL9MXLDegreeV5AlterV5colorAA8MXLColorVSgvp","title":"color","symbolKind":"property","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"color","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLColor","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLColorV"},{"text":"?","kind":"text"}]},"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree\/Alter-swift.struct\/color","interfaceLanguage":"swift"},"sections":[],"variants":[{"paths":["\/documentation\/ivormxl\/mxldegree\/alter-swift.struct\/color"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLDegree/Alter-swift.struct/color":{"url":"\/documentation\/ivormxl\/mxldegree\/alter-swift.struct\/color","kind":"symbol","abstract":[{"type":"text","text":"The color attribute group indicates the color of an element."}],"title":"color","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree\/Alter-swift.struct\/color","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"color"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLColor","preciseIdentifier":"s:7IvorMXL8MXLColorV"},{"kind":"text","text":"?"}],"role":"symbol","type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLDegree/Alter-swift.struct":{"type":"topic","url":"\/documentation\/ivormxl\/mxldegree\/alter-swift.struct","role":"symbol","title":"MXLDegree.Alter","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree\/Alter-swift.struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Alter","kind":"identifier"}],"abstract":[{"text":"The degree-alter type represents the chromatic alteration for the current degree. If the degree-type value is","type":"text"},{"text":" ","type":"text"},{"text":"alter or subtract, the degree-alter value is relative to the degree already in the chord based on its kind","type":"text"},{"text":" ","type":"text"},{"text":"element. If the degree-type value is add, the degree-alter is relative to a dominant chord (major and perfect","type":"text"},{"text":" ","type":"text"},{"text":"intervals except for a minor seventh). The plus-minus attribute is used to indicate if plus and minus symbols","type":"text"},{"text":" ","type":"text"},{"text":"should be used instead of sharp and flat symbols to display the degree alteration. It is no if not specified.","type":"text"}],"navigatorTitle":[{"text":"Alter","kind":"identifier"}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLDegree":{"type":"topic","url":"\/documentation\/ivormxl\/mxldegree","role":"symbol","title":"MXLDegree","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLDegree","kind":"identifier"}],"abstract":[{"text":"The degree type is used to add, alter, or subtract individual notes in the chord. The print-object attribute","type":"text"},{"text":" ","type":"text"},{"text":"can be used to keep the degree from printing separately when it has already taken into account in the text","type":"text"},{"text":" ","type":"text"},{"text":"attribute of the kind element. The degree-value and degree-type text attributes specify how the value and type","type":"text"},{"text":" ","type":"text"},{"text":"of the degree should be displayed.","type":"text"}],"navigatorTitle":[{"text":"MXLDegree","kind":"identifier"}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlcolor","title":"MXLColor","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"type":"text","text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is"},{"type":"text","text":" "},{"type":"text","text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor"}}}