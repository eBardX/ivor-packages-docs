{"kind":"symbol","abstract":[{"type":"text","text":"The color attribute group indicates the color of an element."}],"variants":[{"paths":["\/documentation\/ivormxl\/mxldegree\/alter-swift.struct\/color"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree\/Alter-swift.struct"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree\/Alter-swift.struct\/color"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"color","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLColor","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLColorV"},{"text":"?","kind":"text"}],"platforms":["macOS"]}]}],"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"role":"symbol","symbolKind":"property","modules":[{"name":"IvorMXL"}],"roleHeading":"Instance Property","title":"color","externalID":"s:7IvorMXL9MXLDegreeV5AlterV5colorAA8MXLColorVSgvp","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"color","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLColor","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLColorV"},{"text":"?","kind":"text"}]},"references":{"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLDegree":{"role":"symbol","abstract":[{"text":"The degree type is used to add, alter, or subtract individual notes in the chord. The print-object attribute","type":"text"},{"text":" ","type":"text"},{"text":"can be used to keep the degree from printing separately when it has already taken into account in the text","type":"text"},{"text":" ","type":"text"},{"text":"attribute of the kind element. The degree-value and degree-type text attributes specify how the value and type","type":"text"},{"text":" ","type":"text"},{"text":"of the degree should be displayed.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree","url":"\/documentation\/ivormxl\/mxldegree","title":"MXLDegree","navigatorTitle":[{"kind":"identifier","text":"MXLDegree"}],"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLDegree"}]},"doc://IvorMXL/documentation/IvorMXL/MXLDegree/Alter-swift.struct":{"role":"symbol","kind":"symbol","title":"MXLDegree.Alter","abstract":[{"type":"text","text":"The degree-alter type represents the chromatic alteration for the current degree. If the degree-type value is"},{"type":"text","text":" "},{"type":"text","text":"alter or subtract, the degree-alter value is relative to the degree already in the chord based on its kind"},{"type":"text","text":" "},{"type":"text","text":"element. If the degree-type value is add, the degree-alter is relative to a dominant chord (major and perfect"},{"type":"text","text":" "},{"type":"text","text":"intervals except for a minor seventh). The plus-minus attribute is used to indicate if plus and minus symbols"},{"type":"text","text":" "},{"type":"text","text":"should be used instead of sharp and flat symbols to display the degree alteration. It is no if not specified."}],"url":"\/documentation\/ivormxl\/mxldegree\/alter-swift.struct","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Alter"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree\/Alter-swift.struct","navigatorTitle":[{"kind":"identifier","text":"Alter"}]},"doc://IvorMXL/documentation/IvorMXL/MXLDegree/Alter-swift.struct/color":{"type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The color attribute group indicates the color of an element."}],"role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree\/Alter-swift.struct\/color","title":"color","url":"\/documentation\/ivormxl\/mxldegree\/alter-swift.struct\/color","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"color","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLColor","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLColorV"},{"text":"?","kind":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLColor","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","title":"MXLColor","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlcolor"}}}