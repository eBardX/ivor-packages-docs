ue-swift.struct","text":"Value","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"alter","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL9MXLDegreeV5AlterV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree\/Alter-swift.struct","text":"Alter","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"kind","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL9MXLDegreeV4KindV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree\/Kind-swift.struct","text":"Kind","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"printsObject","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":"? = nil)","kind":"text"}]}],"kind":"declarations"},{"parameters":[{"name":"value","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The degree of the chord being added, altered, or subtracted (1 for the root, 3 for third, etc.)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The chromatic alteration for this degree."}]}],"name":"alter"},{"name":"kind","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Whether this degree is an addition, alteration, or subtraction relative to the kind of the current chord."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A Boolean value indicating whether to print an object (e.g. a note or a rest). Defaults to "},{"type":"codeVoice","code":"true"},{"type":"text","text":" if not specified."}]}],"name":"printsObject"}],"kind":"parameters"}],"kind":"symbol","references":{"doc://IvorMXL/documentation/IvorMXL/MXLDegree/Value-swift.struct":{"navigatorTitle":[{"text":"Value","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxldegree\/value-swift.struct","kind":"symbol","type":"topic","role":"symbol","title":"MXLDegree.Value","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree\/Value-swift.struct","abstract":[{"text":"The content of the degree-value type is a number indicating the degree of the chord (1 for the root, 3 for","type":"text"},{"type":"text","text":" "},{"text":"third, etc). The text attribute specifies how the value of the degree should be displayed. The symbol","type":"text"},{"type":"text","text":" "},{"text":"attribute indicates that a symbol should be used in specifying the degree. If the symbol attribute is present,","type":"text"},{"text":" ","type":"text"},{"text":"the value of the text attribute follows the symbol.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Value","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLDegree/Alter-swift.struct":{"type":"topic","url":"\/documentation\/ivormxl\/mxldegree\/alter-swift.struct","role":"symbol","title":"MXLDegree.Alter","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree\/Alter-swift.struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Alter","kind":"identifier"}],"abstract":[{"text":"The degree-alter type represents the chromatic alteration for the current degree. If the degree-type value is","type":"text"},{"text":" ","type":"text"},{"text":"alter or subtract, the degree-alter value is relative to the degree already in the chord based on its kind","type":"text"},{"text":" ","type":"text"},{"text":"element. If the degree-type value is add, the degree-alter is relative to a dominant chord (major and perfect","type":"text"},{"text":" ","type":"text"},{"text":"intervals except for a minor seventh). The plus-minus attribute is used to indicate if plus and minus symbols","type":"text"},{"text":" ","type":"text"},{"text":"should be used instead of sharp and flat symbols to display the degree alteration. It is no if not specified.","type":"text"}],"navigatorTitle":[{"text":"Alter","kind":"identifier"}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLDegree/Kind-swift.struct":{"navigatorTitle":[{"text":"Kind","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxldegree\/kind-swift.struct","kind":"symbol","type":"topic","role":"symbol","title":"MXLDegree.Kind","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree\/Kind-swift.struct","abstract":[{"text":"The degree-type type indicates if this degree is an addition, alteration, or subtraction relative to the kind","type":"text"},{"text":" ","type":"text"},{"text":"of the current chord. The value of the degree-type element affects the interpretation of the value of the","type":"text"},{"text":" ","type":"text"},{"text":"degree-alter element. The text attribute specifies how the type of the degree should be displayed.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Kind","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLDegree/init(value:alter:kind:printsObject:)":{"type":"topic","url":"\/documentation\/ivormxl\/mxldegree\/init(value:alter:kind:printsobject:)","role":"symbol","title":"init(value:alter:kind:printsObject:)","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree\/init(value:alter:kind:printsObject:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"value","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Value","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLDegreeV5ValueV"},{"text":", ","kind":"text"},{"text":"alter","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Alter","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLDegreeV5AlterV"},{"text":", ","kind":"text"},{"text":"kind","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Kind","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLDegreeV4KindV"},{"text":", ","kind":"text"},{"text":"printsObject","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":"?)","kind":"text"}],"abstract":[{"text":"Creates a new ","type":"text"},{"type":"codeVoice","code":"MXLDegree"},{"text":".","type":"text"}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLDegree":{"type":"topic","url":"\/documentation\/ivormxl\/mxldegree","role":"symbol","title":"MXLDegree","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLDegree","kind":"identifier"}],"abstract":[{"text":"The degree type is used to add, alter, or subtract individual notes in the chord. The print-object attribute","type":"text"},{"text":" ","type":"text"},{"text":"can be used to keep the degree from printing separately when it has already taken into account in the text","type":"text"},{"text":" ","type":"text"},{"text":"attribute of the kind element. The degree-value and degree-type text attributes specify how the value and type","type":"text"},{"text":" ","type":"text"},{"text":"of the degree should be displayed.","type":"text"}],"navigatorTitle":[{"text":"MXLDegree","kind":"identifier"}],"kind":"symbol"}}}