name":"kind"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A Boolean value indicating whether to print an object (e.g. a note or a rest). Defaults to "},{"code":"true","type":"codeVoice"},{"type":"text","text":" if not specified."}]}],"name":"printsObject"}]}],"metadata":{"roleHeading":"Initializer","role":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"value"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Value","preciseIdentifier":"s:7IvorMXL9MXLDegreeV5ValueV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"alter"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Alter","preciseIdentifier":"s:7IvorMXL9MXLDegreeV5AlterV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"kind"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Kind","preciseIdentifier":"s:7IvorMXL9MXLDegreeV4KindV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"printsObject"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":"?)"}],"title":"init(value:alter:kind:printsObject:)","modules":[{"name":"IvorMXL"}],"externalID":"s:7IvorMXL9MXLDegreeV5value5alter4kind12printsObjectA2C5ValueV_AC5AlterVAC4KindVSbSgtcfc","symbolKind":"init"},"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree\/init(value:alter:kind:printsObject:)"},"abstract":[{"type":"text","text":"Creates a new "},{"code":"MXLDegree","type":"codeVoice"},{"type":"text","text":"."}],"kind":"symbol","references":{"doc://IvorMXL/documentation/IvorMXL/MXLDegree/Value-swift.struct":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree\/Value-swift.struct","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Value"}],"abstract":[{"text":"The content of the degree-value type is a number indicating the degree of the chord (1 for the root, 3 for","type":"text"},{"text":" ","type":"text"},{"text":"third, etc). The text attribute specifies how the value of the degree should be displayed. The symbol","type":"text"},{"text":" ","type":"text"},{"text":"attribute indicates that a symbol should be used in specifying the degree. If the symbol attribute is present,","type":"text"},{"text":" ","type":"text"},{"text":"the value of the text attribute follows the symbol.","type":"text"}],"kind":"symbol","title":"MXLDegree.Value","url":"\/documentation\/ivormxl\/mxldegree\/value-swift.struct","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Value"}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLDegree/Kind-swift.struct":{"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxldegree\/kind-swift.struct","abstract":[{"type":"text","text":"The degree-type type indicates if this degree is an addition, alteration, or subtraction relative to the kind"},{"type":"text","text":" "},{"type":"text","text":"of the current chord. The value of the degree-type element affects the interpretation of the value of the"},{"type":"text","text":" "},{"type":"text","text":"degree-alter element. The text attribute specifies how the type of the degree should be displayed."}],"navigatorTitle":[{"text":"Kind","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Kind","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree\/Kind-swift.struct","title":"MXLDegree.Kind"},"doc://IvorMXL/documentation/IvorMXL/MXLDegree/init(value:alter:kind:printsObject:)":{"role":"symbol","kind":"symbol","url":"\/documentation\/ivormxl\/mxldegree\/init(value:alter:kind:printsobject:)","title":"init(value:alter:kind:printsObject:)","abstract":[{"type":"text","text":"Creates a new "},{"code":"MXLDegree","type":"codeVoice"},{"type":"text","text":"."}],"type":"topic","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"value","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Value","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLDegreeV5ValueV"},{"text":", ","kind":"text"},{"text":"alter","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Alter","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLDegreeV5AlterV"},{"text":", ","kind":"text"},{"text":"kind","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Kind","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLDegreeV4KindV"},{"text":", ","kind":"text"},{"text":"printsObject","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":"?)","kind":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree\/init(value:alter:kind:printsObject:)"},"doc://IvorMXL/documentation/IvorMXL/MXLDegree":{"role":"symbol","abstract":[{"text":"The degree type is used to add, alter, or subtract individual notes in the chord. The print-object attribute","type":"text"},{"text":" ","type":"text"},{"text":"can be used to keep the degree from printing separately when it has already taken into account in the text","type":"text"},{"text":" ","type":"text"},{"text":"attribute of the kind element. The degree-value and degree-type text attributes specify how the value and type","type":"text"},{"text":" ","type":"text"},{"text":"of the degree should be displayed.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree","url":"\/documentation\/ivormxl\/mxldegree","title":"MXLDegree","navigatorTitle":[{"kind":"identifier","text":"MXLDegree"}],"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLDegree"}]},"doc://IvorMXL/documentation/IvorMXL/MXLDegree/Alter-swift.struct":{"role":"symbol","kind":"symbol","title":"MXLDegree.Alter","abstract":[{"type":"text","text":"The degree-alter type represents the chromatic alteration for the current degree. If the degree-type value is"},{"type":"text","text":" "},{"type":"text","text":"alter or subtract, the degree-alter value is relative to the degree already in the chord based on its kind"},{"type":"text","text":" "},{"type":"text","text":"element. If the degree-type value is add, the degree-alter is relative to a dominant chord (major and perfect"},{"type":"text","text":" "},{"type":"text","text":"intervals except for a minor seventh). The plus-minus attribute is used to indicate if plus and minus symbols"},{"type":"text","text":" "},{"type":"text","text":"should be used instead of sharp and flat symbols to display the degree alteration. It is no if not specified."}],"url":"\/documentation\/ivormxl\/mxldegree\/alter-swift.struct","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Alter"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree\/Alter-swift.struct","navigatorTitle":[{"kind":"identifier","text":"Alter"}]}}}