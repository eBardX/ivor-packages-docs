preciseIdentifier":"s:7IvorMXL9MXLDegreeV4KindV","text":"Kind"},{"kind":"text","text":", "},{"kind":"externalParam","text":"printsObject"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":"? = nil)"}]}],"kind":"declarations"},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The degree of the chord being added, altered, or subtracted (1 for the root, 3 for third, etc.)."}]}],"name":"value"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The chromatic alteration for this degree."}]}],"name":"alter"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Whether this degree is an addition, alteration, or subtraction relative to the kind of the current chord."}]}],"name":"kind"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A Boolean value indicating whether to print an object (e.g. a note or a rest). Defaults to "},{"code":"true","type":"codeVoice"},{"type":"text","text":" if not specified."}]}],"name":"printsObject"}],"kind":"parameters"}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree\/init(value:alter:kind:printsObject:)","interfaceLanguage":"swift"},"kind":"symbol","sections":[],"abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLDegree"},{"type":"text","text":"."}],"variants":[{"paths":["\/documentation\/ivormxl\/mxldegree\/init(value:alter:kind:printsobject:)"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree"]]},"references":{"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLDegree/Alter-swift.struct":{"type":"topic","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Alter","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree\/Alter-swift.struct","title":"MXLDegree.Alter","abstract":[{"type":"text","text":"The degree-alter type represents the chromatic alteration for the current degree. If the degree-type value is"},{"type":"text","text":" "},{"type":"text","text":"alter or subtract, the degree-alter value is relative to the degree already in the chord based on its kind"},{"type":"text","text":" "},{"type":"text","text":"element. If the degree-type value is add, the degree-alter is relative to a dominant chord (major and perfect"},{"type":"text","text":" "},{"type":"text","text":"intervals except for a minor seventh). The plus-minus attribute is used to indicate if plus and minus symbols"},{"type":"text","text":" "},{"type":"text","text":"should be used instead of sharp and flat symbols to display the degree alteration. It is no if not specified."}],"navigatorTitle":[{"text":"Alter","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxldegree\/alter-swift.struct"},"doc://IvorMXL/documentation/IvorMXL/MXLDegree/init(value:alter:kind:printsObject:)":{"fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"value","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Value","preciseIdentifier":"s:7IvorMXL9MXLDegreeV5ValueV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"alter","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Alter","preciseIdentifier":"s:7IvorMXL9MXLDegreeV5AlterV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"kind","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Kind","preciseIdentifier":"s:7IvorMXL9MXLDegreeV4KindV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"printsObject","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":"?)","kind":"text"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree\/init(value:alter:kind:printsObject:)","type":"topic","url":"\/documentation\/ivormxl\/mxldegree\/init(value:alter:kind:printsobject:)","abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLDegree"},{"type":"text","text":"."}],"title":"init(value:alter:kind:printsObject:)","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLDegree":{"title":"MXLDegree","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLDegree"}],"abstract":[{"type":"text","text":"The degree type is used to add, alter, or subtract individual notes in the chord. The print-object attribute"},{"type":"text","text":" "},{"type":"text","text":"can be used to keep the degree from printing separately when it has already taken into account in the text"},{"type":"text","text":" "},{"type":"text","text":"attribute of the kind element. The degree-value and degree-type text attributes specify how the value and type"},{"type":"text","text":" "},{"type":"text","text":"of the degree should be displayed."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree","role":"symbol","navigatorTitle":[{"text":"MXLDegree","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxldegree"},"doc://IvorMXL/documentation/IvorMXL/MXLDegree/Value-swift.struct":{"title":"MXLDegree.Value","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Value"}],"abstract":[{"type":"text","text":"The content of the degree-value type is a number indicating the degree of the chord (1 for the root, 3 for"},{"type":"text","text":" "},{"type":"text","text":"third, etc). The text attribute specifies how the value of the degree should be displayed. The symbol"},{"type":"text","text":" "},{"type":"text","text":"attribute indicates that a symbol should be used in specifying the degree. If the symbol attribute is present,"},{"type":"text","text":" "},{"type":"text","text":"the value of the text attribute follows the symbol."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree\/Value-swift.struct","role":"symbol","navigatorTitle":[{"text":"Value","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxldegree\/value-swift.struct"},"doc://IvorMXL/documentation/IvorMXL/MXLDegree/Kind-swift.struct":{"role":"symbol","url":"\/documentation\/ivormxl\/mxldegree\/kind-swift.struct","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree\/Kind-swift.struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Kind","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"The degree-type type indicates if this degree is an addition, alteration, or subtraction relative to the kind","type":"text"},{"text":" ","type":"text"},{"text":"of the current chord. The value of the degree-type element affects the interpretation of the value of the","type":"text"},{"text":" ","type":"text"},{"text":"degree-alter element. The text attribute specifies how the type of the degree should be displayed.","type":"text"}],"type":"topic","navigatorTitle":[{"text":"Kind","kind":"identifier"}],"title":"MXLDegree.Kind"}}}