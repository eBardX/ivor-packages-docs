nd":"text"},{"text":"MXLNumeral","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLNumeral/Mode":{"title":"MXLNumeral.Mode","url":"\/documentation\/ivormxl\/mxlnumeral\/mode","abstract":[{"type":"text","text":"The numeral-mode type specifies the mode similar to the mode type, but with a restricted set of values. The"},{"type":"text","text":" "},{"type":"text","text":"different minor values are used to interpret numeral-root values of 6 and 7 when present in a minor key. The"},{"type":"text","text":" "},{"type":"text","text":"harmonic minor value sharpens the 7 and the melodic minor value sharpens both 6 and 7. If a minor mode is used"},{"type":"text","text":" "},{"type":"text","text":"without qualification, either in the mode or numeral-mode elements, natural minor is used."}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Mode"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Mode"}],"type":"topic","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/Mode"},"doc://IvorMXL/documentation/IvorMXL/MXLNumeral/Mode/major":{"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"major","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/Mode\/major","type":"topic","abstract":[{"text":"Major mode.","type":"text"}],"role":"symbol","title":"MXLNumeral.Mode.major","url":"\/documentation\/ivormxl\/mxlnumeral\/mode\/major"}}}