{"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/Mode\/naturalMinor"},"abstract":[{"type":"text","text":"Natural minor mode."}],"metadata":{"title":"MXLNumeral.Mode.naturalMinor","externalID":"s:7IvorMXL10MXLNumeralV4ModeO12naturalMinoryA2EmF","role":"symbol","symbolKind":"case","modules":[{"name":"IvorMXL"}],"roleHeading":"Case","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"naturalMinor","kind":"identifier"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlnumeral\/mode\/naturalminor"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"naturalMinor","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}]}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/Mode"]]},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLNumeral":{"type":"topic","abstract":[{"type":"text","text":"The numeral type represents the Roman numeral or Nashville number part of a harmony. It requires that the key"},{"text":" ","type":"text"},{"type":"text","text":"be specified in the encoding, either with a key or numeral-key element."}],"url":"\/documentation\/ivormxl\/mxlnumeral","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNumeral"}],"kind":"symbol","title":"MXLNumeral","navigatorTitle":[{"kind":"identifier","text":"MXLNumeral"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNumeral/Mode/naturalMinor":{"type":"topic","url":"\/documentation\/ivormxl\/mxlnumeral\/mode\/naturalminor","title":"MXLNumeral.Mode.naturalMinor