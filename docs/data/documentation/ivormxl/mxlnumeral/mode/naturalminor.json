{"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"roleHeading":"Case","symbolKind":"case","modules":[{"name":"IvorMXL"}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"naturalMinor"}],"title":"MXLNumeral.Mode.naturalMinor","externalID":"s:7IvorMXL10MXLNumeralV4ModeO12naturalMinoryA2EmF","role":"symbol"},"kind":"symbol","variants":[{"paths":["\/documentation\/ivormxl\/mxlnumeral\/mode\/naturalminor"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"naturalMinor"}],"languages":["swift"],"platforms":["macOS"]}]}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/Mode\/naturalMinor","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/Mode"]]},"sections":[],"abstract":[{"text":"Natural minor mode.","type":"text"}],"references":{"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLNumeral":{"abstract":[{"type":"text","text":"The numeral type represents the Roman numeral or Nashville number part of a harmony. It requires that the key"},{"type":"text","text":" "},{"type":"text","text":"be specified in the encoding, either with a key or numeral-key element."}],"title":"MXLNumeral","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNumeral","kind":"identifier"}],"navigatorTitle":[{"text":"MXLNumeral","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlnumeral","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral"},"doc://IvorMXL/documentation/IvorMXL/MXLNumeral/Mode":{"abstract":[{"type":"text","text":"The numeral-mode type specifies the mode similar to the mode type, but with a restricted set of values. The"},{"type":"text","text":" "},{"type":"text","text":"different minor values are used to interpret numeral-root values of 6 and 7 when present in a minor key. The"},{"type":"text","text":" "},{"type":"text","text":"harmonic minor value sharpens the 7 and the melodic minor value sharpens both 6 and 7. If a minor mode is used"},{"type":"text","text":" "},{"type":"text","text":"without qualification, either in the mode or numeral-mode elements, natural minor is used."}],"title":"MXLNumeral.Mode","kind":"symbol","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Mode","kind":"identifier"}],"navigatorTitle":[{"text":"Mode","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlnumeral\/mode","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/Mode"},"doc://IvorMXL/documentation/IvorMXL/MXLNumeral/Mode/naturalMinor":{"url":"\/documentation\/ivormxl\/mxlnumeral\/mode\/naturalminor","abstract":[{"type":"text","text":"Natural minor mode."}],"title":"MXLNumeral.Mode.naturalMinor","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/Mode\/naturalMinor","type":"topic","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"naturalMinor","kind":"identifier"}],"role":"symbol"}}}