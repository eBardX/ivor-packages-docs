oc://IvorMXL/documentation/IvorMXL/MXLNumeral":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlnumeral","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNumeral"}],"abstract":[{"type":"text","text":"The numeral type represents the Roman numeral or Nashville number part of a harmony. It requires that the key"},{"type":"text","text":" "},{"type":"text","text":"be specified in the encoding, either with a key or numeral-key element."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLNumeral"}],"title":"MXLNumeral"},"doc://IvorMXL/documentation/IvorMXL/MXLNumeral/Mode":{"abstract":[{"text":"The numeral-mode type specifies the mode similar to the mode type, but with a restricted set of values. The","type":"text"},{"text":" ","type":"text"},{"text":"different minor values are used to interpret numeral-root values of 6 and 7 when present in a minor key. The","type":"text"},{"text":" ","type":"text"},{"text":"harmonic minor value sharpens the 7 and the melodic minor value sharpens both 6 and 7. If a minor mode is used","type":"text"},{"text":" ","type":"text"},{"text":"without qualification, either in the mode or numeral-mode elements, natural minor is used.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/Mode","kind":"symbol","url":"\/documentation\/ivormxl\/mxlnumeral\/mode","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Mode","kind":"identifier"}],"navigatorTitle":[{"text":"Mode","kind":"identifier"}],"title":"MXLNumeral.Mode","role":"symbol","type":"topic"}}}