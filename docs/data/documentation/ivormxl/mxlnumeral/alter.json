{"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral"]]},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"alter","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLHarmonyAlter","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmonyAlter","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL15MXLHarmonyAlterV"},{"text":"?","kind":"text"}]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Maps to a nested MusicXML ","type":"text"},{"code":"<numeral-alter>","type":"codeVoice"},{"text":" element.","type":"text"}]}]}],"metadata":{"symbolKind":"property","title":"alter","modules":[{"name":"IvorMXL"}],"role":"symbol","roleHeading":"Instance Property","externalID":"s:7IvorMXL10MXLNumeralV5alterAA15MXLHarmonyAlterVSgvp","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"alter","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLHarmonyAlter","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL15MXLHarmonyAlterV"},{"text":"?","kind":"text"}]},"variants":[{"paths":["\/documentation\/ivormxl\/mxlnumeral\/alter"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/alter"},"kind":"symbol","schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"text":"The numeral-alter element represents an alteration to the numeral-root, similar to the alter element for a","type":"text"},{"text":" ","type":"text"},{"text":"pitch. The print-object attribute can be used to hide an alteration in cases such as when the MusicXML","type":"text"},{"text":" ","type":"text"},{"text":"encoding of a 6 or 7 numeral-root in a minor key requires an alteration that is not displayed. The location","type":"text"},{"text":" ","type":"text"},{"text":"attribute indicates whether the alteration should appear to the left or the right of the numeral-root. It is","type":"text"},{"text":" ","type":"text"},{"text":"left by default.","type":"text"}],"references":{"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLHarmonyAlter":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLHarmonyAlter","kind":"identifier"}],"navigatorTitle":[{"text":"MXLHarmonyAlter","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmonyAlter","type":"topic","url":"\/documentation\/ivormxl\/mxlharmonyalter","abstract":[{"type":"text","text":"The harmony-alter type represents the chromatic alteration of the root, numeral, or bass of the current"},{"type":"text","text":" "},{"type":"text","text":"harmony-chord group within the harmony element. In some chord styles, the text of the preceding element may"},{"type":"text","text":" "},{"type":"text","text":"include alteration information. In that case, the print-object attribute of this type can be set to no. The"},{"type":"text","text":" "},{"type":"text","text":"location attribute indicates whether the alteration should appear to the left or the right of the preceding"},{"type":"text","text":" "},{"type":"text","text":"element. Its default value varies by element."}],"title":"MXLHarmonyAlter","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNumeral/alter":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"alter","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLHarmonyAlter","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL15MXLHarmonyAlterV"},{"text":"?","kind":"text"}],"title":"alter","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/alter","kind":"symbol","url":"\/documentation\/ivormxl\/mxlnumeral\/alter","type":"topic","abstract":[{"type":"text","text":"The numeral-alter element represents an alteration to the numeral-root, similar to the alter element for a"},{"type":"text","text":" "},{"text":"pitch. The print-object attribute can be used to hide an alteration in cases such as when the MusicXML","type":"text"},{"text":" ","type":"text"},{"text":"encoding of a 6 or 7 numeral-root in a minor key requires an alteration that is not displayed. The location","type":"text"},{"text":" ","type":"text"},{"text":"attribute indicates whether the alteration should appear to the left or the right of the numeral-root. It is","type":"text"},{"text":" ","type":"text"},{"text":"left by default.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLNumeral":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlnumeral","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNumeral"}],"abstract":[{"type":"text","text":"The numeral type represents the Roman numeral or Nashville number part of a harmony. It requires that the key"},{"type":"text","text":" "},{"type":"text","text":"be specified in the encoding, either with a key or numeral-key element."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLNumeral"}],"title":"MXLNumeral"}}}