{"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/alter","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral"]]},"abstract":[{"text":"The numeral-alter element represents an alteration to the numeral-root, similar to the alter element for a","type":"text"},{"text":" ","type":"text"},{"text":"pitch. The print-object attribute can be used to hide an alteration in cases such as when the MusicXML","type":"text"},{"text":" ","type":"text"},{"text":"encoding of a 6 or 7 numeral-root in a minor key requires an alteration that is not displayed. The location","type":"text"},{"text":" ","type":"text"},{"text":"attribute indicates whether the alteration should appear to the left or the right of the numeral-root. It is","type":"text"},{"text":" ","type":"text"},{"text":"left by default.","type":"text"}],"metadata":{"role":"symbol","symbolKind":"property","roleHeading":"Instance Property","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"alter","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL15MXLHarmonyAlterV","text":"MXLHarmonyAlter","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"title":"alter","modules":[{"name":"IvorMXL"}],"externalID":"s:7IvorMXL10MXLNumeralV5alterAA15MXLHarmonyAlterVSgvp"},"sections":[],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"alter","kind":"identifier"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmonyAlter","preciseIdentifier":"s:7IvorMXL15MXLHarmonyAlterV","text":"MXLHarmonyAlter","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"inlineContent":[{"text":"Maps to a nested MusicXML ","type":"text"},{"code":"<numeral-alter>","type":"codeVoice"},{"text":" element.","type":"text"}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/ivormxl\/mxlnumeral\/alter"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","references":{"doc://IvorMXL/documentation/IvorMXL/MXLNumeral":{"type":"topic","abstract":[{"type":"text","text":"The numeral type represents the Roman numeral or Nashville number part of a harmony. It requires that the key"},{"text":" ","type":"text"},{"type":"text","text":"be specified in the encoding, either with a key or numeral-key element."}],"url":"\/documentation\/ivormxl\/mxlnumeral","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNumeral"}],"kind":"symbol","title":"MXLNumeral","navigatorTitle":[{"kind":"identifier","text":"MXLNumeral"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLHarmonyAlter":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLHarmonyAlter","kind":"identifier"}],"title":"MXLHarmonyAlter","abstract":[{"text":"The harmony-alter type represents the chromatic alteration of the root, numeral, or bass of the current","type":"text"},{"text":" ","type":"text"},{"text":"harmony-chord group within the harmony element. In some chord styles, the text of the preceding element may","type":"text"},{"text":" ","type":"text"},{"text":"include alteration information. In that case, the print-object attribute of this type can be set to no. The","type":"text"},{"text":" ","type":"text"},{"text":"location attribute indicates whether the alteration should appear to the left or the right of the preceding","type":"text"},{"text":" ","type":"text"},{"text":"element. Its default value varies by element.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmonyAlter","role":"symbol","url":"\/documentation\/ivormxl\/mxlharmonyalter","kind":"symbol","navigatorTitle":[{"text":"MXLHarmonyAlter","kind":"identifier"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLNumeral/alter":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/alter","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"alter","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLHarmonyAlter","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL15MXLHarmonyAlterV"},{"text":"?","kind":"text"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlnumeral\/alter","abstract":[{"text":"The numeral-alter element represents an alteration to the numeral-root, similar to the alter element for a","type":"text"},{"text":" ","type":"text"},{"text":"pitch. The print-object attribute can be used to hide an alteration in cases such as when the MusicXML","type":"text"},{"text":" ","type":"text"},{"text":"encoding of a 6 or 7 numeral-root in a minor key requires an alteration that is not displayed. The location","type":"text"},{"text":" ","type":"text"},{"text":"attribute indicates whether the alteration should appear to the left or the right of the numeral-root. It is","type":"text"},{"text":" ","type":"text"},{"text":"left by default.","type":"text"}],"title":"alter","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"}}}