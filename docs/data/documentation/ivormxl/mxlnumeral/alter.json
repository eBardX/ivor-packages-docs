{"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/alter","interfaceLanguage":"swift"},"metadata":{"symbolKind":"property","externalID":"s:7IvorMXL10MXLNumeralV5alterAA15MXLHarmonyAlterVSgvp","role":"symbol","title":"alter","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"alter"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL15MXLHarmonyAlterV","text":"MXLHarmonyAlter"},{"kind":"text","text":"?"}],"modules":[{"name":"IvorMXL"}],"roleHeading":"Instance Property"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral"]]},"sections":[],"abstract":[{"type":"text","text":"The numeral-alter element represents an alteration to the numeral-root, similar to the alter element for a"},{"type":"text","text":" "},{"type":"text","text":"pitch. The print-object attribute can be used to hide an alteration in cases such as when the MusicXML"},{"type":"text","text":" "},{"type":"text","text":"encoding of a 6 or 7 numeral-root in a minor key requires an alteration that is not displayed. The location"},{"type":"text","text":" "},{"type":"text","text":"attribute indicates whether the alteration should appear to the left or the right of the numeral-root. It is"},{"type":"text","text":" "},{"type":"text","text":"left by default."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"alter"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL15MXLHarmonyAlterV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmonyAlter","text":"MXLHarmonyAlter"},{"kind":"text","text":"?"}],"languages":["swift"]}]},{"content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Maps to a nested MusicXML "},{"type":"codeVoice","code":"<numeral-alter>"},{"type":"text","text":" element."}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/ivormxl\/mxlnumeral\/alter"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLNumeral":{"abstract":[{"type":"text","text":"The numeral type represents the Roman numeral or Nashville number part of a harmony. It requires that the key"},{"text":" ","type":"text"},{"type":"text","text":"be specified in the encoding, either with a key or numeral-key element."}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLNumeral"}],"url":"\/documentation\/ivormxl\/mxlnumeral","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNumeral"}],"title":"MXLNumeral","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral","type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLNumeral/alter":{"kind":"symbol","url":"\/documentation\/ivormxl\/mxlnumeral\/alter","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/alter","role":"symbol","title":"alter","type":"topic","abstract":[{"type":"text","text":"The numeral-alter element represents an alteration to the numeral-root, similar to the alter element for a"},{"type":"text","text":" "},{"type":"text","text":"pitch. The print-object attribute can be used to hide an alteration in cases such as when the MusicXML"},{"type":"text","text":" "},{"type":"text","text":"encoding of a 6 or 7 numeral-root in a minor key requires an alteration that is not displayed. The location"},{"type":"text","text":" "},{"type":"text","text":"attribute indicates whether the alteration should appear to the left or the right of the numeral-root. It is"},{"type":"text","text":" "},{"type":"text","text":"left by default."}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"alter"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL15MXLHarmonyAlterV","text":"MXLHarmonyAlter"},{"kind":"text","text":"?"}]},"doc://IvorMXL/documentation/IvorMXL/MXLHarmonyAlter":{"url":"\/documentation\/ivormxl\/mxlharmonyalter","title":"MXLHarmonyAlter","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLHarmonyAlter","kind":"identifier"}],"navigatorTitle":[{"text":"MXLHarmonyAlter","kind":"identifier"}],"abstract":[{"type":"text","text":"The harmony-alter type represents the chromatic alteration of the root, numeral, or bass of the current"},{"type":"text","text":" "},{"type":"text","text":"harmony-chord group within the harmony element. In some chord styles, the text of the preceding element may"},{"type":"text","text":" "},{"type":"text","text":"include alteration information. In that case, the print-object attribute of this type can be set to no. The"},{"type":"text","text":" "},{"type":"text","text":"location attribute indicates whether the alteration should appear to the left or the right of the preceding"},{"type":"text","text":" "},{"type":"text","text":"element. Its default value varies by element."}],"kind":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmonyAlter"}}}