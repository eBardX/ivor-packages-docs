{"sections":[],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral"]]},"abstract":[{"type":"text","text":"The numeral-alter element represents an alteration to the numeral-root, similar to the alter element for a"},{"type":"text","text":" "},{"type":"text","text":"pitch. The print-object attribute can be used to hide an alteration in cases such as when the MusicXML"},{"type":"text","text":" "},{"type":"text","text":"encoding of a 6 or 7 numeral-root in a minor key requires an alteration that is not displayed. The location"},{"type":"text","text":" "},{"type":"text","text":"attribute indicates whether the alteration should appear to the left or the right of the numeral-root. It is"},{"type":"text","text":" "},{"type":"text","text":"left by default."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"alter","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLHarmonyAlter","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmonyAlter","preciseIdentifier":"s:7IvorMXL15MXLHarmonyAlterV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}]},{"content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"Maps to a nested MusicXML ","type":"text"},{"code":"<numeral-alter>","type":"codeVoice"},{"text":" element.","type":"text"}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/ivormxl\/mxlnumeral\/alter"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"alter","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLHarmonyAlter","preciseIdentifier":"s:7IvorMXL15MXLHarmonyAlterV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"title":"alter","externalID":"s:7IvorMXL10MXLNumeralV5alterAA15MXLHarmonyAlterVSgvp","modules":[{"name":"IvorMXL"}],"roleHeading":"Instance Property","role":"symbol","symbolKind":"property"},"kind":"symbol","identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/alter","interfaceLanguage":"swift"},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLHarmonyAlter":{"navigatorTitle":[{"kind":"identifier","text":"MXLHarmonyAlter"}],"abstract":[{"type":"text","text":"The harmony-alter type represents the chromatic alteration of the root, numeral, or bass of the current"},{"type":"text","text":" "},{"type":"text","text":"harmony-chord group within the harmony element. In some chord styles, the text of the preceding element may"},{"type":"text","text":" "},{"type":"text","text":"include alteration information. In that case, the print-object attribute of this type can be set to no. The"},{"type":"text","text":" "},{"type":"text","text":"location attribute indicates whether the alteration should appear to the left or the right of the preceding"},{"type":"text","text":" "},{"type":"text","text":"element. Its default value varies by element."}],"title":"MXLHarmonyAlter","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmonyAlter","kind":"symbol","url":"\/documentation\/ivormxl\/mxlharmonyalter","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLHarmonyAlter"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNumeral/alter":{"abstract":[{"type":"text","text":"The numeral-alter element represents an alteration to the numeral-root, similar to the alter element for a"},{"type":"text","text":" "},{"type":"text","text":"pitch. The print-object attribute can be used to hide an alteration in cases such as when the MusicXML"},{"type":"text","text":" "},{"type":"text","text":"encoding of a 6 or 7 numeral-root in a minor key requires an alteration that is not displayed. The location"},{"type":"text","text":" "},{"type":"text","text":"attribute indicates whether the alteration should appear to the left or the right of the numeral-root. It is"},{"type":"text","text":" "},{"type":"text","text":"left by default."}],"title":"alter","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/alter","kind":"symbol","url":"\/documentation\/ivormxl\/mxlnumeral\/alter","type":"topic","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"alter"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL15MXLHarmonyAlterV","kind":"typeIdentifier","text":"MXLHarmonyAlter"},{"kind":"text","text":"?"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLNumeral":{"abstract":[{"type":"text","text":"The numeral type represents the Roman numeral or Nashville number part of a harmony. It requires that the key"},{"type":"text","text":" "},{"type":"text","text":"be specified in the encoding, either with a key or numeral-key element."}],"title":"MXLNumeral","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNumeral","kind":"identifier"}],"navigatorTitle":[{"text":"MXLNumeral","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlnumeral","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral"}}}