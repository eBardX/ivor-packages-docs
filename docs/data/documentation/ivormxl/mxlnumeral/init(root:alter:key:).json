{"metadata":{"externalID":"s:7IvorMXL10MXLNumeralV4root5alter3keyA2C4RootV_AA15MXLHarmonyAlterVSgAC3KeyVSgtcfc","roleHeading":"Initializer","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"root","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Root","preciseIdentifier":"s:7IvorMXL10MXLNumeralV4RootV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"alter","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLHarmonyAlter","preciseIdentifier":"s:7IvorMXL15MXLHarmonyAlterV","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"key","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Key","preciseIdentifier":"s:7IvorMXL10MXLNumeralV3KeyV","kind":"typeIdentifier"},{"text":"?)","kind":"text"}],"modules":[{"name":"IvorMXL"}],"title":"init(root:alter:key:)","role":"symbol","symbolKind":"init"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"init","kind":"keyword"},{"text":"(","kind":"text"},{"text":"root","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Root","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/Root-swift.struct","preciseIdentifier":"s:7IvorMXL10MXLNumeralV4RootV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"alter","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLHarmonyAlter","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmonyAlter","preciseIdentifier":"s:7IvorMXL15MXLHarmonyAlterV","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"key","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Key","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/Key-swift.struct","preciseIdentifier":"s:7IvorMXL10MXLNumeralV3KeyV","kind":"typeIdentifier"},{"text":"? = nil)","kind":"text"}],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"name":"root","content":[{"type":"paragraph","inlineContent":[{"text":"The Roman numeral or Nashville number part of the harmony.","type":"text"}]}]},{"name":"alter","content":[{"type":"paragraph","inlineContent":[{"text":"The numeral-alter element represents an alteration to the numeral-root, similar to the alter element for a pitch. The print-object attribute can be used to hide an alteration in cases such as when the MusicXML encoding of a 6 or 7 numeral-root in a minor key requires an alteration that is not displayed. The location attribute indicates whether the alteration should appear to the left or the right of the numeral-root. It is left by default.","type":"text"}]}]},{"name":"key","content":[{"type":"paragraph","inlineContent":[{"text":"The key for the numeral, when it differs from the key specified by the key signature.","type":"text"}]}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlnumeral\/init(root:alter:key:)"]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral"]]},"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/init(root:alter:key:)","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLNumeral"},{"type":"text","text":"."}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLNumeral/init(root:alter:key:)":{"fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"root","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Root","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL10MXLNumeralV4RootV"},{"text":", ","kind":"text"},{"text":"alter","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLHarmonyAlter","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL15MXLHarmonyAlterV"},{"text":"?, ","kind":"text"},{"text":"key","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Key","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL10MXLNumeralV3KeyV"},{"text":"?)","kind":"text"}],"title":"init(root:alter:key:)","url":"\/documentation\/ivormxl\/mxlnumeral\/init(root:alter:key:)","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/init(root:alter:key:)","type":"topic","abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLNumeral"},{"type":"text","text":"."}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLHarmonyAlter":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLHarmonyAlter","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmonyAlter","type":"topic","role":"symbol","navigatorTitle":[{"text":"MXLHarmonyAlter","kind":"identifier"}],"title":"MXLHarmonyAlter","abstract":[{"type":"text","text":"The harmony-alter type represents the chromatic alteration of the root, numeral, or bass of the current"},{"type":"text","text":" "},{"type":"text","text":"harmony-chord group within the harmony element. In some chord styles, the text of the preceding element may"},{"type":"text","text":" "},{"type":"text","text":"include alteration information. In that case, the print-object attribute of this type can be set to no. The"},{"type":"text","text":" "},{"type":"text","text":"location attribute indicates whether the alteration should appear to the left or the right of the preceding"},{"type":"text","text":" "},{"type":"text","text":"element. Its default value varies by element."}],"url":"\/documentation\/ivormxl\/mxlharmonyalter"},"doc://IvorMXL/documentation/IvorMXL/MXLNumeral":{"navigatorTitle":[{"text":"MXLNumeral","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlnumeral","kind":"symbol","type":"topic","role":"symbol","title":"MXLNumeral","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral","abstract":[{"type":"text","text":"The numeral type represents the Roman numeral or Nashville number part of a harmony. It requires that the key"},{"type":"text","text":" "},{"type":"text","text":"be specified in the encoding, either with a key or numeral-key element."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNumeral","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLNumeral/Key-swift.struct":{"navigatorTitle":[{"kind":"identifier","text":"Key"}],"title":"MXLNumeral.Key","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/Key-swift.struct","type":"topic","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Key"}],"url":"\/documentation\/ivormxl\/mxlnumeral\/key-swift.struct","abstract":[{"type":"text","text":"The numeral-key type is used when the key for the numeral is different than the key specified by the key"},{"type":"text","text":" "},{"type":"text","text":"signature. The numeral-fifths element specifies the key in the same way as the fifths element. The numeral-"},{"type":"text","text":" "},{"type":"text","text":"mode element specifies the mode similar to the mode element, but with a restricted set of values"}]},"doc://IvorMXL/documentation/IvorMXL/MXLNumeral/Root-swift.struct":{"type":"topic","url":"\/documentation\/ivormxl\/mxlnumeral\/root-swift.struct","role":"symbol","title":"MXLNumeral.Root","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/Root-swift.struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Root","kind":"identifier"}],"abstract":[{"text":"The numeral-root type represents the Roman numeral or Nashville number as a positive integer from 1 to 7. The","type":"text"},{"text":" ","type":"text"},{"text":"text attribute indicates how the numeral should appear in the score. A numeral-root value of 5 with a kind of","type":"text"},{"text":" ","type":"text"},{"text":"major would have a text attribute of “V” if displayed as a Roman numeral, and “5” if displayed as a Nashville","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"number. If the text attribute is not specified, the display is application-dependent."}],"navigatorTitle":[{"text":"Root","kind":"identifier"}],"kind":"symbol"}}}