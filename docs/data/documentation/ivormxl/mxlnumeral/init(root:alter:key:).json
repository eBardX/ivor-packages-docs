{"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"root"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL10MXLNumeralV4RootV","kind":"typeIdentifier","text":"Root","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/Root-swift.struct"},{"kind":"text","text":", "},{"kind":"externalParam","text":"alter"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL15MXLHarmonyAlterV","kind":"typeIdentifier","text":"MXLHarmonyAlter","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmonyAlter"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"key"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL10MXLNumeralV3KeyV","kind":"typeIdentifier","text":"Key","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/Key-swift.struct"},{"kind":"text","text":"? = nil)"}],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"name":"root","content":[{"inlineContent":[{"type":"text","text":"The Roman numeral or Nashville number part of the harmony."}],"type":"paragraph"}]},{"name":"alter","content":[{"inlineContent":[{"type":"text","text":"The numeral-alter element represents an alteration to the numeral-root, similar to the alter"},{"type":"text","text":" "},{"type":"text","text":"element for a pitch. The print-object attribute can be used to hide an alteration in cases"},{"type":"text","text":" "},{"type":"text","text":"such as when the MusicXML encoding of a 6 or 7 numeral-root in a minor key requires an"},{"type":"text","text":" "},{"type":"text","text":"alteration that is not displayed. The location attribute indicates whether the alteration"},{"type":"text","text":" "},{"type":"text","text":"should appear to the left or the right of the numeral-root. It is left by default."}],"type":"paragraph"}]},{"name":"key","content":[{"inlineContent":[{"type":"text","text":"The key for the numeral, when it differs from the key specified by the key signature."}],"type":"paragraph"}]}],"kind":"parameters"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/init(root:alter:key:)"},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlnumeral\/init(root:alter:key:)"]}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral"]]},"sections":[],"abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLNumeral"},{"type":"text","text":"."}],"metadata":{"symbolKind":"init","externalID":"s:7IvorMXL10MXLNumeralV4root5alter3keyA2C4RootV_AA15MXLHarmonyAlterVSgAC3KeyVSgtcfc","modules":[{"name":"IvorMXL"}],"roleHeading":"Initializer","role":"symbol","title":"init(root:alter:key:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"root"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL10MXLNumeralV4RootV","kind":"typeIdentifier","text":"Root"},{"kind":"text","text":", "},{"kind":"externalParam","text":"alter"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL15MXLHarmonyAlterV","kind":"typeIdentifier","text":"MXLHarmonyAlter"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"key"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL10MXLNumeralV3KeyV","kind":"typeIdentifier","text":"Key"},{"kind":"text","text":"?)"}]},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLNumeral/Key-swift.struct":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/Key-swift.struct","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Key","kind":"identifier"}],"role":"symbol","abstract":[{"text":"The numeral-key type is used when the key for the numeral is different than the key specified by the key","type":"text"},{"text":" ","type":"text"},{"text":"signature. The numeral-fifths element specifies the key in the same way as the fifths element. The numeral-","type":"text"},{"text":" ","type":"text"},{"text":"mode element specifies the mode similar to the mode element, but with a restricted set of values","type":"text"}],"navigatorTitle":[{"text":"Key","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlnumeral\/key-swift.struct","kind":"symbol","title":"MXLNumeral.Key"},"doc://IvorMXL/documentation/IvorMXL/MXLNumeral":{"type":"topic","abstract":[{"type":"text","text":"The numeral type represents the Roman numeral or Nashville number part of a harmony. It requires that the key"},{"text":" ","type":"text"},{"type":"text","text":"be specified in the encoding, either with a key or numeral-key element."}],"url":"\/documentation\/ivormxl\/mxlnumeral","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNumeral"}],"kind":"symbol","title":"MXLNumeral","navigatorTitle":[{"kind":"identifier","text":"MXLNumeral"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNumeral/init(root:alter:key:)":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/init(root:alter:key:)","type":"topic","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"root","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL10MXLNumeralV4RootV","text":"Root","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"alter","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL15MXLHarmonyAlterV","text":"MXLHarmonyAlter","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"key","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL10MXLNumeralV3KeyV","text":"Key","kind":"typeIdentifier"},{"text":"?)","kind":"text"}],"role":"symbol","abstract":[{"text":"Creates a new ","type":"text"},{"type":"codeVoice","code":"MXLNumeral"},{"text":".","type":"text"}],"url":"\/documentation\/ivormxl\/mxlnumeral\/init(root:alter:key:)","kind":"symbol","title":"init(root:alter:key:)"},"doc://IvorMXL/documentation/IvorMXL/MXLHarmonyAlter":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLHarmonyAlter","kind":"identifier"}],"title":"MXLHarmonyAlter","abstract":[{"text":"The harmony-alter type represents the chromatic alteration of the root, numeral, or bass of the current","type":"text"},{"text":" ","type":"text"},{"text":"harmony-chord group within the harmony element. In some chord styles, the text of the preceding element may","type":"text"},{"text":" ","type":"text"},{"text":"include alteration information. In that case, the print-object attribute of this type can be set to no. The","type":"text"},{"text":" ","type":"text"},{"text":"location attribute indicates whether the alteration should appear to the left or the right of the preceding","type":"text"},{"text":" ","type":"text"},{"text":"element. Its default value varies by element.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmonyAlter","role":"symbol","url":"\/documentation\/ivormxl\/mxlharmonyalter","kind":"symbol","navigatorTitle":[{"text":"MXLHarmonyAlter","kind":"identifier"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLNumeral/Root-swift.struct":{"type":"topic","title":"MXLNumeral.Root","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/Root-swift.struct","abstract":[{"type":"text","text":"The numeral-root type represents the Roman numeral or Nashville number as a positive integer from 1 to 7. The"},{"type":"text","text":" "},{"type":"text","text":"text attribute indicates how the numeral should appear in the score. A numeral-root value of 5 with a kind of"},{"text":" ","type":"text"},{"text":"major would have a text attribute of “V” if displayed as a Roman numeral, and “5” if displayed as a Nashville","type":"text"},{"text":" ","type":"text"},{"text":"number. If the text attribute is not specified, the display is application-dependent.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Root"}],"navigatorTitle":[{"kind":"identifier","text":"Root"}],"url":"\/documentation\/ivormxl\/mxlnumeral\/root-swift.struct"}}}