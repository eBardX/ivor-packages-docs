"text":"? = nil, "},{"kind":"externalParam","text":"key"},{"kind":"text","text":": "},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/Key-swift.struct","kind":"typeIdentifier","text":"Key","preciseIdentifier":"s:7IvorMXL10MXLNumeralV3KeyV"},{"kind":"text","text":"? = nil)"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The Roman numeral or Nashville number part of the harmony."}]}],"name":"root"},{"name":"alter","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The numeral-alter element represents an alteration to the numeral-root, similar to the alter element for a pitch. The print-object attribute can be used to hide an alteration in cases such as when the MusicXML encoding of a 6 or 7 numeral-root in a minor key requires an alteration that is not displayed. The location attribute indicates whether the alteration should appear to the left or the right of the numeral-root. It is left by default."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The key for the numeral, when it differs from the key specified by the key signature."}]}],"name":"key"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlnumeral\/init(root:alter:key:)"]}],"references":{"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLNumeral/Root-swift.struct":{"abstract":[{"text":"The numeral-root type represents the Roman numeral or Nashville number as a positive integer from 1 to 7. The","type":"text"},{"text":" ","type":"text"},{"text":"text attribute indicates how the numeral should appear in the score. A numeral-root value of 5 with a kind of","type":"text"},{"text":" ","type":"text"},{"text":"major would have a text attribute of “V” if displayed as a Roman numeral, and “5” if displayed as a Nashville","type":"text"},{"text":" ","type":"text"},{"text":"number. If the text attribute is not specified, the display is application-dependent.","type":"text"}],"title":"MXLNumeral.Root","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Root"}],"navigatorTitle":[{"text":"Root","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlnumeral\/root-swift.struct","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/Root-swift.struct"},"doc://IvorMXL/documentation/IvorMXL/MXLNumeral/Key-swift.struct":{"abstract":[{"text":"The numeral-key type is used when the key for the numeral is different than the key specified by the key","type":"text"},{"text":" ","type":"text"},{"text":"signature. The numeral-fifths element specifies the key in the same way as the fifths element. The numeral-","type":"text"},{"text":" ","type":"text"},{"text":"mode element specifies the mode similar to the mode element, but with a restricted set of values","type":"text"}],"title":"MXLNumeral.Key","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Key"}],"navigatorTitle":[{"kind":"identifier","text":"Key"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlnumeral\/key-swift.struct","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/Key-swift.struct"},"doc://IvorMXL/documentation/IvorMXL/MXLNumeral":{"abstract":[{"type":"text","text":"The numeral type represents the Roman numeral or Nashville number part of a harmony. It requires that the key"},{"type":"text","text":" "},{"type":"text","text":"be specified in the encoding, either with a key or numeral-key element."}],"title":"MXLNumeral","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNumeral","kind":"identifier"}],"navigatorTitle":[{"text":"MXLNumeral","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlnumeral","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral"},"doc://IvorMXL/documentation/IvorMXL/MXLHarmonyAlter":{"navigatorTitle":[{"kind":"identifier","text":"MXLHarmonyAlter"}],"abstract":[{"type":"text","text":"The harmony-alter type represents the chromatic alteration of the root, numeral, or bass of the current"},{"type":"text","text":" "},{"type":"text","text":"harmony-chord group within the harmony element. In some chord styles, the text of the preceding element may"},{"type":"text","text":" "},{"type":"text","text":"include alteration information. In that case, the print-object attribute of this type can be set to no. The"},{"type":"text","text":" "},{"type":"text","text":"location attribute indicates whether the alteration should appear to the left or the right of the preceding"},{"type":"text","text":" "},{"type":"text","text":"element. Its default value varies by element."}],"title":"MXLHarmonyAlter","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmonyAlter","kind":"symbol","url":"\/documentation\/ivormxl\/mxlharmonyalter","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLHarmonyAlter"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNumeral/init(root:alter:key:)":{"abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLNumeral"},{"type":"text","text":"."}],"title":"init(root:alter:key:)","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/init(root:alter:key:)","kind":"symbol","url":"\/documentation\/ivormxl\/mxlnumeral\/init(root:alter:key:)","type":"topic","fragments":[{"kind":"identifier","text":"init"},{"text":"(","kind":"text"},{"text":"root"