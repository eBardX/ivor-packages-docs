{"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","abstract":[{"text":"Creates a new ","type":"text"},{"type":"codeVoice","code":"MXLNumeral"},{"text":".","type":"text"}],"sections":[],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"init","kind":"keyword"},{"text":"(","kind":"text"},{"text":"root","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Root","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/Root-swift.struct","preciseIdentifier":"s:7IvorMXL10MXLNumeralV4RootV"},{"text":", ","kind":"text"},{"text":"alter","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLHarmonyAlter","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmonyAlter","preciseIdentifier":"s:7IvorMXL15MXLHarmonyAlterV"},{"text":"? = nil, ","kind":"text"},{"text":"key","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Key","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/Key-swift.struct","preciseIdentifier":"s:7IvorMXL10MXLNumeralV3KeyV"},{"text":"? = nil)","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The Roman numeral or Nashville number part of the harmony."}],"type":"paragraph"}],"name":"root"},{"content":[{"inlineContent":[{"type":"text","text":"The numeral-alter element represents an alteration to the numeral-root, similar to the alter element for a pitch. The print-object attribute can be used to hide an alteration in cases such as when the MusicXML encoding of a 6 or 7 numeral-root in a minor key requires an alteration that is not displayed. The location attribute indicates whether the alteration should appear to the left or the right of the numeral-root. It is left by default."}],"type":"paragraph"}],"name":"alter"},{"content":[{"inlineContent":[{"type":"text","text":"The key for the numeral, when it differs from the key specified by the key signature."}],"type":"paragraph"}],"name":"key"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/init(root:alter:key:)"},"metadata":{"role":"symbol","externalID":"s:7IvorMXL10MXLNumeralV4root5alter3keyA2C4RootV_AA15MXLHarmonyAlterVSgAC3KeyVSgtcfc","symbolKind":"init","title":"init(root:alter:key:)","roleHeading":"Initializer","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"root","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Root","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL10MXLNumeralV4RootV"},{"text":", ","kind":"text"},{"text":"alter","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLHarmonyAlter","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL15MXLHarmonyAlterV"},{"text":"?, ","kind":"text"},{"text":"key","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Key","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL10MXLNumeralV3KeyV"},{"text":"?)","kind":"text"}],"modules":[{"name":"IvorMXL"}]},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral"]]},"variants":[{"paths":["\/documentation\/ivormxl\/mxlnumeral\/init(root:alter:key:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLHarmonyAlter":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLHarmonyAlter","kind":"identifier"}],"navigatorTitle":[{"text":"MXLHarmonyAlter","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmonyAlter","type":"topic","url":"\/documentation\/ivormxl\/mxlharmonyalter","abstract":[{"type":"text","text":"The harmony-alter type represents the chromatic alteration of the root, numeral, or bass of the current"},{"type":"text","text":" "},{"type":"text","text":"harmony-chord group within the harmony element. In some chord styles, the text of the preceding element may"},{"type":"text","text":" "},{"type":"text","text":"include alteration information. In that case, the print-object attribute of this type can be set to no. The"},{"type":"text","text":" "},{"type":"text","text":"location attribute indicates whether the alteration should appear to the left or the right of the preceding"},{"type":"text","text":" "},{"type":"text","text":"element. Its default value varies by element."}],"title":"MXLHarmonyAlter","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNumeral/init(root:alter:key:)":{"abstract":[{"text":"Creates a new ","type":"text"},{"type":"codeVoice","code":"MXLNumeral"},{"text":".","type":"text"}],"kind":"symbol","role":"symbol","type":"topic","title":"init(root:alter:key:)","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/init(root:alter:key:)","url":"\/documentation\/ivormxl\/mxlnumeral\/init(root:alter:key:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"root"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL10MXLNumeralV4RootV","text":"Root"},{"kind":"text","text":", "},{"kind":"externalParam","text":"alter"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL15MXLHarmonyAlterV","text":"MXLHarmonyAlter"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"key"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL10MXLNumeralV3KeyV","text":"Key"},{"kind":"text","text":"?)"}]},"doc://IvorMXL/documentation/IvorMXL/MXLNumeral":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlnumeral","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNumeral"}],"abstract":[{"type":"text","text":"The numeral type represents the Roman numeral or Nashville number part of a harmony. It requires that the key"},{"type":"text","text":" "},{"type":"text","text":"be specified in the encoding, either with a key or numeral-key element."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLNumeral"}],"title":"MXLNumeral"},"doc://IvorMXL/documentation/IvorMXL/MXLNumeral/Root-swift.struct":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlnumeral\/root-swift.struct","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/Root-swift.struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Root","kind":"identifier"}],"kind":"symbol","abstract":[{"type":"text","text":"The numeral-root type represents the Roman numeral or Nashville number as a positive integer from 1 to 7. The"},{"type":"text","text":" "},{"type":"text","text":"text attribute indicates how the numeral should appear in the score. A numeral-root value of 5 with a kind of"},{"type":"text","text":" "},{"type":"text","text":"major would have a text attribute of “V” if displayed as a Roman numeral, and “5” if displayed as a Nashville"},{"type":"text","text":" "},{"type":"text","text":"number. If the text attribute is not specified, the display is application-dependent."}],"type":"topic","navigatorTitle":[{"text":"Root","kind":"identifier"}],"title":"MXLNumeral.Root"},"doc://IvorMXL/documentation/IvorMXL/MXLNumeral/Key-swift.struct":{"kind":"symbol","abstract":[{"type":"text","text":"The numeral-key type is used when the key for the numeral is different than the key specified by the key"},{"type":"text","text":" "},{"type":"text","text":"signature. The numeral-fifths element specifies the key in the same way as the fifths element. The numeral-"},{"type":"text","text":" "},{"type":"text","text":"mode element specifies the mode similar to the mode element, but with a restricted set of values"}],"url":"\/documentation\/ivormxl\/mxlnumeral\/key-swift.struct","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/Key-swift.struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Key","kind":"identifier"}],"title":"MXLNumeral.Key","navigatorTitle":[{"text":"Key","kind":"identifier"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"}}}