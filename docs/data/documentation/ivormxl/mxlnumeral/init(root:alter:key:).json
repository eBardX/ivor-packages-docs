{"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"root","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Root","preciseIdentifier":"s:7IvorMXL10MXLNumeralV4RootV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"alter","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLHarmonyAlter","preciseIdentifier":"s:7IvorMXL15MXLHarmonyAlterV","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"key","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Key","preciseIdentifier":"s:7IvorMXL10MXLNumeralV3KeyV","kind":"typeIdentifier"},{"text":"?)","kind":"text"}],"externalID":"s:7IvorMXL10MXLNumeralV4root5alter3keyA2C4RootV_AA15MXLHarmonyAlterVSgAC3KeyVSgtcfc","symbolKind":"init","modules":[{"name":"IvorMXL"}],"roleHeading":"Initializer","role":"symbol","title":"init(root:alter:key:)"},"variants":[{"paths":["\/documentation\/ivormxl\/mxlnumeral\/init(root:alter:key:)"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/init(root:alter:key:)","interfaceLanguage":"swift"},"sections":[],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"init","kind":"keyword"},{"text":"(","kind":"text"},{"text":"root","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/Root-swift.struct","text":"Root","preciseIdentifier":"s:7IvorMXL10MXLNumeralV4RootV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"alter","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmonyAlter","text":"MXLHarmonyAlter","preciseIdentifier":"s:7IvorMXL15MXLHarmonyAlterV","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"key","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/Key-swift.struct","text":"Key","preciseIdentifier":"s:7IvorMXL10MXLNumeralV3KeyV","kind":"typeIdentifier"},{"text":"? = nil)","kind":"text"}]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"root","content":[{"inlineContent":[{"text":"The Roman numeral or Nashville number part of the harmony.","type":"text"}],"type":"paragraph"}]},{"name":"alter","content":[{"inlineContent":[{"text":"The numeral-alter element represents an alteration to the numeral-root, similar to the alter element for a pitch. The print-object attribute can be used to hide an alteration in cases such as when the MusicXML encoding of a 6 or 7 numeral-root in a minor key requires an alteration that is not displayed. The location attribute indicates whether the alteration should appear to the left or the right of the numeral-root. It is left by default.","type":"text"}],"type":"paragraph"}]},{"name":"key","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The key for the numeral, when it differs from the key specified by the key signature."}]}]}]}],"abstract":[{"text":"Creates a new ","type":"text"},{"code":"MXLNumeral","type":"codeVoice"},{"text":".","type":"text"}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLNumeral/Key-swift.struct":{"role":"symbol","kind":"symbol","url":"\/documentation\/ivormxl\/mxlnumeral\/key-swift.struct","abstract":[{"text":"The numeral-key type is used when the key for the numeral is different than the key specified by the key","type":"text"},{"text":" ","type":"text"},{"text":"signature. The numeral-fifths element specifies the key in the same way as the fifths element. The numeral-","type":"text"},{"text":" ","type":"text"},{"text":"mode element specifies the mode similar to the mode element, but with a restricted set of values","type":"text"}],"title":"MXLNumeral.Key","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Key"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/Key-swift.struct","navigatorTitle":[{"kind":"identifier","text":"Key"}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLNumeral":{"abstract":[{"type":"text","text":"The numeral type represents the Roman numeral or Nashville number part of a harmony. It requires that the key"},{"text":" ","type":"text"},{"type":"text","text":"be specified in the encoding, either with a key or numeral-key element."}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLNumeral"}],"url":"\/documentation\/ivormxl\/mxlnumeral","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNumeral"}],"title":"MXLNumeral","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral","type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLNumeral/init(root:alter:key:)":{"title":"init(root:alter:key:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"root","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL10MXLNumeralV4RootV","text":"Root","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"alter","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL15MXLHarmonyAlterV","text":"MXLHarmonyAlter","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"key","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL10MXLNumeralV3KeyV","text":"Key","kind":"typeIdentifier"},{"text":"?)","kind":"text"}],"url":"\/documentation\/ivormxl\/mxlnumeral\/init(root:alter:key:)","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/init(root:alter:key:)","type":"topic","role":"symbol","abstract":[{"text":"Creates a new ","type":"text"},{"type":"codeVoice","code":"MXLNumeral"},{"type":"text","text":"."}]},"doc://IvorMXL/documentation/IvorMXL/MXLNumeral/Root-swift.struct":{"abstract":[{"type":"text","text":"The numeral-root type represents the Roman numeral or Nashville number as a positive integer from 1 to 7. The"},{"type":"text","text":" "},{"type":"text","text":"text attribute indicates how the numeral should appear in the score. A numeral-root value of 5 with a kind of"},{"type":"text","text":" "},{"type":"text","text":"major would have a text attribute of “V” if displayed as a Roman numeral, and “5” if displayed as a Nashville"},{"type":"text","text":" "},{"type":"text","text":"number. If the text attribute is not specified, the display is application-dependent."}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Root"}],"url":"\/documentation\/ivormxl\/mxlnumeral\/root-swift.struct","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Root"}],"title":"MXLNumeral.Root","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/Root-swift.struct","type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLHarmonyAlter":{"url":"\/documentation\/ivormxl\/mxlharmonyalter","title":"MXLHarmonyAlter","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLHarmonyAlter","kind":"identifier"}],"navigatorTitle":[{"text":"MXLHarmonyAlter","kind":"identifier"}],"abstract":[{"type":"text","text":"The harmony-alter type represents the chromatic alteration of the root, numeral, or bass of the current"},{"type":"text","text":" "},{"type":"text","text":"harmony-chord group within the harmony element. In some chord styles, the text of the preceding element may"},{"type":"text","text":" "},{"type":"text","text":"include alteration information. In that case, the print-object attribute of this type can be set to no. The"},{"type":"text","text":" "},{"type":"text","text":"location attribute indicates whether the alteration should appear to the left or the right of the preceding"},{"type":"text","text":" "},{"type":"text","text":"element. Its default value varies by element."}],"kind":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmonyAlter"}}}