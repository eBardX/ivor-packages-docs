 "},{"kind":"identifier","text":"MXLNumeral"}],"abstract":[{"type":"text","text":"The numeral type represents the Roman numeral or Nashville number part of a harmony. It requires that the key"},{"type":"text","text":" "},{"type":"text","text":"be specified in the encoding, either with a key or numeral-key element."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLNumeral"}],"title":"MXLNumeral"},"doc://IvorMXL/documentation/IvorMXL/MXLNumeral/Key-swift.struct/fifths":{"url":"\/documentation\/ivormxl\/mxlnumeral\/key-swift.struct\/fifths","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"fifths","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL9MXLFifthsV","text":"MXLFifths","kind":"typeIdentifier"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/Key-swift.struct\/fifths","kind":"symbol","title":"fifths","abstract":[{"type":"text","text":"Specifies the key in the same way as the fifths element."}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLFifths":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlfifths","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFifths","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFifths"}],"abstract":[{"type":"text","text":"The fifths type represents the number of flats or sharps in a traditional key signature. Negative numbers are"},{"type":"text","text":" "},{"type":"text","text":"used for flats and positive numbers for sharps, reflecting the key’s placement within the circle of fifths"},{"type":"text","text":" "},{"type":"text","text":"(hence the type name)."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLFifths"}],"title":"MXLFifths"},"doc://IvorMXL/documentation/IvorMXL/MXLNumeral/Key-swift.struct":{"kind":"symbol","abstract":[{"type":"text","text":"The numeral-key type is used when the key for the numeral is different than the key specified by the key"},{"type":"text","text":" "},{"type":"text","text":"signature. The numeral-fifths element specifies the key in the same way as the fifths element. The numeral-"},{"type":"text","text":" "},{"type":"text","text":"mode element specifies the mode similar to the mode element, but with a restricted set of values"}],"url":"\/documentation\/ivormxl\/mxlnumeral\/key-swift.struct","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/Key-swift.struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Key","kind":"identifier"}],"title":"MXLNumeral.Key","navigatorTitle":[{"text":"Key","kind":"identifier"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"}}}