ext"},{"text":"Key","kind":"identifier"}],"role":"symbol","abstract":[{"text":"The numeral-key type is used when the key for the numeral is different than the key specified by the key","type":"text"},{"text":" ","type":"text"},{"text":"signature. The numeral-fifths element specifies the key in the same way as the fifths element. The numeral-","type":"text"},{"text":" ","type":"text"},{"text":"mode element specifies the mode similar to the mode element, but with a restricted set of values","type":"text"}],"navigatorTitle":[{"text":"Key","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlnumeral\/key-swift.struct","kind":"symbol","title":"MXLNumeral.Key"},"doc://IvorMXL/documentation/IvorMXL/MXLNumeral":{"type":"topic","abstract":[{"type":"text","text":"The numeral type represents the Roman numeral or Nashville number part of a harmony. It requires that the key"},{"text":" ","type":"text"},{"type":"text","text":"be specified in the encoding, either with a key or numeral-key element."}],"url":"\/documentation\/ivormxl\/mxlnumeral","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNumeral"}],"kind":"symbol","title":"MXLNumeral","navigatorTitle":[{"kind":"identifier","text":"MXLNumeral"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNumeral/Mode":{"role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Mode"}],"type":"topic","title":"MXLNumeral.Mode","navigatorTitle":[{"kind":"identifier","text":"Mode"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/Mode","url":"\/documentation\/ivormxl\/mxlnumeral\/mode","abstract":[{"type":"text","text":"The numeral-mode type specifies the mode similar to the mode type, but with a restricted set of values. The"},{"type":"text","text":" "},{"type":"text","text":"different minor values are used to interpret numeral-root values of 6 and 7 when present in a minor key. The"},{"type":"text","text":" "},{"type":"text","text":"harmonic minor value sharpens the 7 and the melodic minor value sharpens both 6 and 7. If a minor mode is used"},{"type":"text","text":" "},{"type":"text","text":"without qualification, either in the mode or numeral-mode elements, natural minor is used."}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLNumeral/Key-swift.struct/mode":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/Key-swift.struct\/mode","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"mode","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL10MXLNumeralV4ModeO","text":"Mode","kind":"typeIdentifier"}],"role":"symbol","abstract":[{"text":"The mode, similar to the mode element, but with a restricted set of values.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlnumeral\/key-swift.struct\/mode","kind":"symbol","title":"mode"}}}