ifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNumeral":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlnumeral","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNumeral"}],"abstract":[{"type":"text","text":"The numeral type represents the Roman numeral or Nashville number part of a harmony. It requires that the key"},{"type":"text","text":" "},{"type":"text","text":"be specified in the encoding, either with a key or numeral-key element."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLNumeral"}],"title":"MXLNumeral"},"doc://IvorMXL/documentation/IvorMXL/MXLNumeral/Key-swift.struct/mode":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlnumeral\/key-swift.struct\/mode","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/Key-swift.struct\/mode","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"mode"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL10MXLNumeralV4ModeO","kind":"typeIdentifier","text":"Mode"}],"abstract":[{"type":"text","text":"Specifies the mode, similar to the mode element, but with a restricted set of values."}],"kind":"symbol","type":"topic","title":"mode"},"doc://IvorMXL/documentation/IvorMXL/MXLNumeral/Key-swift.struct":{"kind":"symbol","abstract":[{"type":"text","text":"The numeral-key type is used when the key for the numeral is different than the key specified by the key"},{"type":"text","text":" "},{"type":"text","text":"signature. The numeral-fifths element specifies the key in the same way as the fifths element. The numeral-"},{"type":"text","text":" "},{"type":"text","text":"mode element specifies the mode similar to the mode element, but with a restricted set of values"}],"url":"\/documentation\/ivormxl\/mxlnumeral\/key-swift.struct","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/Key-swift.struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Key","kind":"identifier"}],"title":"MXLNumeral.Key","navigatorTitle":[{"text":"Key","kind":"identifier"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLNumeral/Mode":{"abstract":[{"text":"The numeral-mode type specifies the mode similar to the mode type, but with a restricted set of values. The","type":"text"},{"text":" ","type":"text"},{"text":"different minor values are used to interpret numeral-root values of 6 and 7 when present in a minor key. The","type":"text"},{"text":" ","type":"text"},{"text":"harmonic minor value sharpens the 7 and the melodic minor value sharpens both 6 and 7. If a minor mode is used","type":"text"},{"text":" ","type":"text"},{"text":"without qualification, either in the mode or numeral-mode elements, natural minor is used.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/Mode","kind":"symbol","url":"\/documentation\/ivormxl\/mxlnumeral\/mode","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Mode","kind":"identifier"}],"navigatorTitle":[{"text":"Mode","kind":"identifier"}],"title":"MXLNumeral.Mode","role":"symbol","type":"topic"}}}