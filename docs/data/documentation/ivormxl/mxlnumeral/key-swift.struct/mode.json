/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLNumeral/Key-swift.struct/mode":{"kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"mode","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Mode","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL10MXLNumeralV4ModeO"}],"type":"topic","title":"mode","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/Key-swift.struct\/mode","role":"symbol","abstract":[{"type":"text","text":"Specifies the mode, similar to the mode element, but with a restricted set of values."}],"url":"\/documentation\/ivormxl\/mxlnumeral\/key-swift.struct\/mode"},"doc://IvorMXL/documentation/IvorMXL/MXLNumeral/Mode":{"role":"symbol","navigatorTitle":[{"text":"Mode","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/Mode","url":"\/documentation\/ivormxl\/mxlnumeral\/mode","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Mode","kind":"identifier"}],"title":"MXLNumeral.Mode","type":"topic","abstract":[{"type":"text","text":"The numeral-mode type specifies the mode similar to the mode type, but with a restricted set of values. The"},{"type":"text","text":" "},{"type":"text","text":"different minor values are used to interpret numeral-root values of 6 and 7 when present in a minor key. The"},{"type":"text","text":" "},{"type":"text","text":"harmonic minor value sharpens the 7 and the melodic minor value sharpens both 6 and 7. If a minor mode is used"},{"type":"text","text":" "},{"type":"text","text":"without qualification, either in the mode or numeral-mode elements, natural minor is used."}]},"doc://IvorMXL/documentation/IvorMXL/MXLNumeral/Key-swift.struct":{"role":"symbol","kind":"symbol","url":"\/documentation\/ivormxl\/mxlnumeral\/key-swift.struct","abstract":[{"text":"The numeral-key type is used when the key for the numeral is different than the key specified by the key","type":"text"},{"text":" ","type":"text"},{"text":"signature. The numeral-fifths element specifies the key in the same way as the fifths element. The numeral-","type":"text"},{"text":" ","type":"text"},{"text":"mode element specifies the mode similar to the mode element, but with a restricted set of values","type":"text"}],"title":"MXLNumeral.Key","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Key"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/Key-swift.struct","navigatorTitle":[{"kind":"identifier","text":"Key"}]},"doc://IvorMXL/documentation/IvorMXL/MXLNumeral":{"abstract":[{"type":"text","text":"The numeral type represents the Roman numeral or Nashville number part of a harmony. It requires that the key"},{"text":" ","type":"text"},{"type":"text","text":"be specified in the encoding, either with a key or numeral-key element."}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLNumeral"}],"url":"\/documentation\/ivormxl\/mxlnumeral","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNumeral"}],"title":"MXLNumeral","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral","type":"topic"}}}