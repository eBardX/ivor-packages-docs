ues"}]},"doc://IvorMXL/documentation/IvorMXL/MXLNumeral/Mode":{"title":"MXLNumeral.Mode","url":"\/documentation\/ivormxl\/mxlnumeral\/mode","abstract":[{"type":"text","text":"The numeral-mode type specifies the mode similar to the mode type, but with a restricted set of values. The"},{"type":"text","text":" "},{"type":"text","text":"different minor values are used to interpret numeral-root values of 6 and 7 when present in a minor key. The"},{"type":"text","text":" "},{"type":"text","text":"harmonic minor value sharpens the 7 and the melodic minor value sharpens both 6 and 7. If a minor mode is used"},{"type":"text","text":" "},{"type":"text","text":"without qualification, either in the mode or numeral-mode elements, natural minor is used."}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Mode"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Mode"}],"type":"topic","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/Mode"},"doc://IvorMXL/documentation/IvorMXL/MXLNumeral/Key-swift.struct/init(fifths:mode:printsObject:)":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/Key-swift.struct\/init(fifths:mode:printsObject:)","abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLNumeral.Key"},{"type":"text","text":"."}],"title":"init(fifths:mode:printsObject:)","type":"topic","kind":"symbol","role":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"fifths","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLFifths","preciseIdentifier":"s:7IvorMXL9MXLFifthsV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"mode","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Mode","preciseIdentifier":"s:7IvorMXL10MXLNumeralV4ModeO","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"printsObject","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":"?)","kind":"text"}],"url":"\/documentation\/ivormxl\/mxlnumeral\/key-swift.struct\/init(fifths:mode:printsobject:)"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLFifths":{"title":"MXLFifths","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"MXLFifths","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlfifths","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFifths","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"MXLFifths","kind":"identifier"}],"abstract":[{"type":"text","text":"The fifths type represents the number of flats or sharps in a traditional key signature. Negative numbers are"},{"text":" ","type":"text"},{"type":"text","text":"used for flats and positive numbers for sharps, reflecting the key’s placement within the circle of fifths"},{"type":"text","text":" "},{"text":"(hence the type name).","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLNumeral":{"navigatorTitle":[{"text":"MXLNumeral","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlnumeral","kind":"symbol","type":"topic","role":"symbol","title":"MXLNumeral","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral","abstract":[{"type":"text","text":"The numeral type represents the Roman numeral or Nashville number part of a harmony. It requires that the key"},{"type":"text","text":" "},{"type":"text","text":"be specified in the encoding, either with a key or numeral-key element."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNumeral","kind":"identifier"}]}}}