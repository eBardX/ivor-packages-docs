"text","text":"?)"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlnumeral\/key-swift.struct\/init(fifths:mode:printsobject:)","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/Key-swift.struct\/init(fifths:mode:printsObject:)"},"doc://IvorMXL/documentation/IvorMXL/MXLNumeral":{"abstract":[{"type":"text","text":"The numeral type represents the Roman numeral or Nashville number part of a harmony. It requires that the key"},{"type":"text","text":" "},{"type":"text","text":"be specified in the encoding, either with a key or numeral-key element."}],"title":"MXLNumeral","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNumeral","kind":"identifier"}],"navigatorTitle":[{"text":"MXLNumeral","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlnumeral","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral"},"doc://IvorMXL/documentation/IvorMXL/MXLFifths":{"title":"MXLFifths","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"text":"MXLFifths","kind":"identifier"}],"kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxlfifths","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFifths","abstract":[{"type":"text","text":"The fifths type represents the number of flats or sharps in a traditional key signature. Negative numbers are"},{"type":"text","text":" "},{"type":"text","text":"used for flats and positive numbers for sharps, reflecting the key’s placement within the circle of fifths"},{"type":"text","text":" "},{"type":"text","text":"(hence the type name)."}],"navigatorTitle":[{"kind":"identifier","text":"MXLFifths"}]},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLNumeral/Key-swift.struct":{"abstract":[{"text":"The numeral-key type is used when the key for the numeral is different than the key specified by the key","type":"text"},{"text":" ","type":"text"},{"text":"signature. The numeral-fifths element specifies the key in the same way as the fifths element. The numeral-","type":"text"},{"text":" ","type":"text"},{"text":"mode element specifies the mode similar to the mode element, but with a restricted set of values","type":"text"}],"title":"MXLNumeral.Key","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Key"}],"navigatorTitle":[{"kind":"identifier","text":"Key"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlnumeral\/key-swift.struct","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/Key-swift.struct"},"doc://IvorMXL/documentation/IvorMXL/MXLNumeral/Mode":{"abstract":[{"type":"text","text":"The numeral-mode type specifies the mode similar to the mode type, but with a restricted set of values. The"},{"type":"text","text":" "},{"type":"text","text":"different minor values are used to interpret numeral-root values of 6 and 7 when present in a minor key. The"},{"type":"text","text":" "},{"type":"text","text":"harmonic minor value sharpens the 7 and the melodic minor value sharpens both 6 and 7. If a minor mode is used"},{"type":"text","text":" "},{"type":"text","text":"without qualification, either in the mode or numeral-mode elements, natural minor is used."}],"title":"MXLNumeral.Mode","kind":"symbol","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Mode","kind":"identifier"}],"navigatorTitle":[{"text":"Mode","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlnumeral\/mode","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/Mode"}}}