\/IvorMXL\/MXLNumeral\/Key-swift.struct","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Key","kind":"identifier"}],"role":"symbol","abstract":[{"text":"The numeral-key type is used when the key for the numeral is different than the key specified by the key","type":"text"},{"text":" ","type":"text"},{"text":"signature. The numeral-fifths element specifies the key in the same way as the fifths element. The numeral-","type":"text"},{"text":" ","type":"text"},{"text":"mode element specifies the mode similar to the mode element, but with a restricted set of values","type":"text"}],"navigatorTitle":[{"text":"Key","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlnumeral\/key-swift.struct","kind":"symbol","title":"MXLNumeral.Key"},"doc://IvorMXL/documentation/IvorMXL/MXLFifths":{"title":"MXLFifths","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFifths"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlfifths","role":"symbol","navigatorTitle":[{"text":"MXLFifths","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFifths","abstract":[{"text":"The fifths type represents the number of flats or sharps in a traditional key signature. Negative numbers are","type":"text"},{"text":" ","type":"text"},{"text":"used for flats and positive numbers for sharps, reflecting the key’s placement within the circle of fifths","type":"text"},{"text":" ","type":"text"},{"text":"(hence the type name).","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLNumeral/Mode":{"role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Mode"}],"type":"topic","title":"MXLNumeral.Mode","navigatorTitle":[{"kind":"identifier","text":"Mode"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/Mode","url":"\/documentation\/ivormxl\/mxlnumeral\/mode","abstract":[{"type":"text","text":"The numeral-mode type specifies the mode similar to the mode type, but with a restricted set of values. The"},{"type":"text","text":" "},{"type":"text","text":"different minor values are used to interpret numeral-root values of 6 and 7 when present in a minor key. The"},{"type":"text","text":" "},{"type":"text","text":"harmonic minor value sharpens the 7 and the melodic minor value sharpens both 6 and 7. If a minor mode is used"},{"type":"text","text":" "},{"type":"text","text":"without qualification, either in the mode or numeral-mode elements, natural minor is used."}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNumeral/Key-swift.struct/init(fifths:mode:printsObject:)":{"type":"topic","url":"\/documentation\/ivormxl\/mxlnumeral\/key-swift.struct\/init(fifths:mode:printsobject:)","title":"init(fifths:mode:printsObject:)","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/Key-swift.struct\/init(fifths:mode:printsObject:)","role":"symbol","abstract":[{"text":"Creates a new ","type":"text"},{"code":"MXLNumeral.Key","type":"codeVoice"},{"text":".","type":"text"}],"fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"fifths","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLFifths","preciseIdentifier":"s:7IvorMXL9MXLFifthsV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"mode","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Mode","preciseIdentifier":"s:7IvorMXL10MXLNumeralV4ModeO","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"printsObject","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kin