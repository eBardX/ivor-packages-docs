","url":"\/documentation\/ivormxl\/mxlnumeral\/key-swift.struct\/init(fifths:mode:printsobject:)","title":"init(fifths:mode:printsObject:)","type":"topic","abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLNumeral.Key"},{"type":"text","text":"."}],"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"fifths"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL9MXLFifthsV","kind":"typeIdentifier","text":"MXLFifths"},{"kind":"text","text":", "},{"kind":"externalParam","text":"mode"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL10MXLNumeralV4ModeO","kind":"typeIdentifier","text":"Mode"},{"kind":"text","text":", "},{"kind":"externalParam","text":"printsObject"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"},{"kind":"text","text":"?)"}],"kind":"symbol","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLNumeral/Key-swift.struct":{"role":"symbol","kind":"symbol","url":"\/documentation\/ivormxl\/mxlnumeral\/key-swift.struct","abstract":[{"text":"The numeral-key type is used when the key for the numeral is different than the key specified by the key","type":"text"},{"text":" ","type":"text"},{"text":"signature. The numeral-fifths element specifies the key in the same way as the fifths element. The numeral-","type":"text"},{"text":" ","type":"text"},{"text":"mode element specifies the mode similar to the mode element, but with a restricted set of values","type":"text"}],"title":"MXLNumeral.Key","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Key"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/Key-swift.struct","navigatorTitle":[{"kind":"identifier","text":"Key"}]},"doc://IvorMXL/documentation/IvorMXL/MXLFifths":{"kind":"symbol","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFifths","abstract":[{"type":"text","text":"The fifths type represents the number of flats or sharps in a traditional key signature. Negative numbers are"},{"type":"text","text":" "},{"type":"text","text":"used for flats and positive numbers for sharps, reflecting the key’s placement within the circle of fifths"},{"type":"text","text":" "},{"type":"text","text":"(hence the type name)."}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLFifths","kind":"identifier"}],"title":"MXLFifths","url":"\/documentation\/ivormxl\/mxlfifths","navigatorTitle":[{"text":"MXLFifths","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLNumeral/Mode":{"role":"symbol","navigatorTitle":[{"text":"Mode","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/Mode","url":"\/documentation\/ivormxl\/mxlnumeral\/mode","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Mode","kind":"identifier"}],"title":"MXLNumeral.Mode","type":"topic","abstract":[{"type":"text","text":"The numeral-mode type specifies the mode similar to the mode type, but with a restricted set of values. The"},{"type":"text","text":" "},{"type":"text","text":"different minor values are used to interpret numeral-root values of 6 and 7 when present in a minor key. The"},{"type":"text","text":" "},{"type":"text","text":"harmonic minor value sharpens the 7 and the melodic minor value sharpens both 6 and 7. If a minor mode is used"},{"type":"text","text":" "},{"type":"text","text":"without qualification, either in the mode or numeral-mode elements, natural minor is used."}]}}}