number as a positive integer from 1 to 7. The","type":"text"},{"text":" ","type":"text"},{"text":"text attribute indicates how the numeral should appear in the score. A numeral-root value of 5 with a kind of","type":"text"},{"text":" ","type":"text"},{"text":"major would have a text attribute of “V” if displayed as a Roman numeral, and “5” if displayed as a Nashville","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"number. If the text attribute is not specified, the display is application-dependent."}],"navigatorTitle":[{"text":"Root","kind":"identifier"}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNumeral/Root-swift.struct/color":{"abstract":[{"text":"The color attribute group indicates the color of an element.","type":"text"}],"kind":"symbol","type":"topic","title":"color","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"color"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLColor","preciseIdentifier":"s:7IvorMXL8MXLColorV"},{"kind":"text","text":"?"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/Root-swift.struct\/color","role":"symbol","url":"\/documentation\/ivormxl\/mxlnumeral\/root-swift.struct\/color"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlcolor","title":"MXLColor","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"type":"text","text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is"},{"type":"text","text":" "},{"type":"text","text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assum