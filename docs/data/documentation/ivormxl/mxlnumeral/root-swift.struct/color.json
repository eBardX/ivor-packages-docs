documentation\/IvorMXL\/MXLNumeral\/Root-swift.struct\/color","role":"symbol","url":"\/documentation\/ivormxl\/mxlnumeral\/root-swift.struct\/color","kind":"symbol","type":"topic"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"type":"topic","abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"type":"text","text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is"},{"type":"text","text":" "},{"type":"text","text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF."}],"url":"\/documentation\/ivormxl\/mxlcolor","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"kind":"symbol","title":"MXLColor","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNumeral/Root-swift.struct":{"type":"topic","title":"MXLNumeral.Root","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/Root-swift.struct","abstract":[{"type":"text","text":"The numeral-root type represents the Roman numeral or Nashville number as a positive integer from 1 to 7. The"},{"type":"text","text":" "},{"type":"text","text":"text attribute indicates how the numeral should appear in the score. A numeral-root value of 5 with a kind of"},{"text":" ","type":"text"},{"text":"major would have a text attribute of “V” if displayed as a Roman numeral, and “5” if displayed as a Nashville","type":"text"},{"text":" ","type":"text"},{"text":"number. If the text attribute is not specified, the display is application-dependent.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Root"}],"navigatorTitle":[{"kind":"identifier","text":"Root"}],"url":"\/documentation\/ivormxl\/mxlnumeral\/root-swift.struct"},"doc://IvorMXL/documentation/IvorMXL/MXLNumeral":{"type":"topic","abstract":[{"type":"text","text":"The numeral type represents the Roman numeral or Nashville number part of a harmony. It requires that the key"},{"text":" ","type":"text"},{"type":"text","text":"be specified in the encoding, either with a key or numeral-key element."}],"url":"\/documentation\/ivormxl\/mxlnumeral","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNumeral"}],"kind":"symbol","title":"MXLNumeral","navigatorTitle":[{"kind":"identifier","text":"MXLNumeral"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral","role":"symbol"}}}