Root-swift.struct":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlnumeral\/root-swift.struct","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral\/Root-swift.struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Root","kind":"identifier"}],"kind":"symbol","abstract":[{"type":"text","text":"The numeral-root type represents the Roman numeral or Nashville number as a positive integer from 1 to 7. The"},{"type":"text","text":" "},{"type":"text","text":"text attribute indicates how the numeral should appear in the score. A numeral-root value of 5 with a kind of"},{"type":"text","text":" "},{"type":"text","text":"major would have a text attribute of “V” if displayed as a Roman numeral, and “5” if displayed as a Nashville"},{"type":"text","text":" "},{"type":"text","text":"number. If the text attribute is not specified, the display is application-dependent."}],"type":"topic","navigatorTitle":[{"text":"Root","kind":"identifier"}],"title":"MXLNumeral.Root"},"doc://IvorMXL/documentation/IvorMXL/MXLNumeral":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlnumeral","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumeral","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNumeral"}],"abstract":[{"type":"text","text":"The numeral type represents the Roman numeral or Nashville number part of a harmony. It requires that the key"},{"type":"text","text":" "},{"type":"text","text":"be specified in the encoding, either with a key or numeral-key element."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLNumeral"}],"title":"MXLNumeral"}}}