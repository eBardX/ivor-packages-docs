":" ","type":"text"},{"text":"vs. a music font.","type":"text"}],"kind":"symbol","title":"MXLFont","url":"\/documentation\/ivormxl\/mxlfont","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFont"}]},"doc://IvorMXL/documentation/IvorMXL/MXLValign":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLValign"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValign","title":"MXLValign","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLValign"}],"abstract":[{"type":"text","text":"The valign type is used to indicate vertical alignment to the top, middle, bottom, or baseline of the text. If"},{"type":"text","text":" "},{"type":"text","text":"the text is on multiple lines, baseline alignment refers to the baseline of the lowest line of text. Defaults"},{"type":"text","text":" "},{"type":"text","text":"are implementation-dependent."}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlvalign"},"doc://IvorMXL/documentation/IvorMXL/MXLPosition":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLPosition"}],"abstract":[{"text":"For most elements, any program will compute a default x and y position. The position attributes let this be","type":"text"},{"text":" ","type":"text"},{"text":"changed two ways.","type":"text"}],"kind":"symbol","title":"MXLPosition","url":"\/documentation\/ivormxl\/mxlposition","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPosition"}]},"doc://IvorMXL/documentation/IvorMXL/MXLHarpPedals/init(id:pedalTuning:position:font:color:halign:valign:)":{"kind":"symbol","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarpPedals\/init(id:pedalTuning:position:font:color:halign:valign:)","fragments":[{"text":"init","kin