ples, with the A indicating alpha of transparency. An alpha value of 00 is"},{"type":"text","text":" "},{"type":"text","text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF."}],"url":"\/documentation\/ivormxl\/mxlcolor","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"kind":"symbol","title":"MXLColor","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLValign":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLValign","kind":"identifier"}],"title":"MXLValign","abstract":[{"type":"text","text":"The valign type is used to indicate vertical alignment to the top, middle, bottom, or baseline of the text. If"},{"type":"text","text":" "},{"type":"text","text":"the text is on multiple lines, baseline alignment refers to the baseline of the lowest line of text. Defaults"},{"type":"text","text":" "},{"type":"text","text":"are implementation-dependent."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValign","role":"symbol","url":"\/documentation\/ivormxl\/mxlvalign","kind":"symbol","navigatorTitle":[{"text":"MXLValign","kind":"identifier"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLPedalTuning":{"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPedalTuning","url":"\/documentation\/ivormxl\/mxlpedaltuning","abstract":[{"text":"The pedal-tuning type specifies the tuning of a single harp pedal.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPedalTuning","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"MXLPedalTuning","kind":"identifier"}],"role":"symbol","title":"MXLPedalTuning"},"doc://IvorMXL/documentation/IvorMXL/MXLHarpPedals":{"type":"topic","abstract":[{"type":"text","text":"The harp-pedals type is used to create harp pedal diagrams. The pedal-step and pedal-alter elements use the"},{"type":"text","text":" "},{"type":"text","text":"same values as the step and alter elements. For easiest reading, the pedal-tuning elements should follow"},{"type":"text","text":" "},{"type":"text","text":"standard harp pedal order, with pedal-step values of D, C, B, E, F, G, and A."}],"url":"\/documentation\/ivormxl\/mxlharppedals","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLHarpPedals","kind":"identifier"}],"kind":"symbol","title":"MXLHarpPedals","navigatorTitle":[{"text":"MXLHarpPedals","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarpPedals","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLFont":{"type":"topic","title":"MXLFont","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","abstract":[{"type":"text","text":"The font attribute group gathers together attributes for determining the font within a credit or direction."},{"type":"text","text":" "},{"type":"text","text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of"},{"type":"text","text":" "},{"type":"text","text":"font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric"},{"type":"text","text":" "},{"type":"text","text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font"},{"type":"text","text":" "},{"type":"text","text":"vs. a music font."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFont"}],"navigatorTitle":[{"kind":"identifier","text":"MXLFont"}],"url":"\/documentation\/ivormxl\/mxlfont"},"doc://IvorMXL/documentation/IvorMXL/MXLLeftCenterRight":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MX