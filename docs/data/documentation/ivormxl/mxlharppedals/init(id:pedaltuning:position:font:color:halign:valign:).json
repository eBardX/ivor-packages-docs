iples, as in","type":"text"},{"text":" ","type":"text"},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"url":"\/documentation\/ivormxl\/mxlcolor"},"doc://IvorMXL/documentation/IvorMXL/MXLLeftCenterRight":{"url":"\/documentation\/ivormxl\/mxlleftcenterright","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLeftCenterRight","abstract":[{"type":"text","text":"The left-center-right type is used to define horizontal alignment and text justification."}],"title":"MXLLeftCenterRight","kind":"symbol","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLLeftCenterRight"}],"navigatorTitle":[{"kind":"identifier","text":"MXLLeftCenterRight"}]},"doc://IvorMXL/documentation/IvorMXL/MXLHarpPedals":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLHarpPedals"}],"navigatorTitle":[{"text":"MXLHarpPedals","kind":"identifier"}],"title":"MXLHarpPedals","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarpPedals","kind":"symbol","url":"\/documentation\/ivormxl\/mxlharppedals","type":"topic","abstract":[{"type":"text","text":"The harp-pedals type is used to create harp pedal diagrams. The pedal-step and pedal-alter elements use the"},{"text":" ","type":"text"},{"type":"text","text":"same values as the step and alter elements. For easiest reading, the pedal-tuning elements should follow"},{"text":" ","type":"text"},{"text":"standard harp pedal order, with pedal-step values of D, C, B, E, F, G, and A.","type":"text"}]},"doc://IvorMXL/documenta