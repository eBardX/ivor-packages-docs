,{"type":"text","text":"The most typical case is for credits, such as:"}]},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLHarpPedals":{"type":"topic","title":"MXLHarpPedals","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLHarpPedals","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlharppedals","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarpPedals","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"MXLHarpPedals","kind":"identifier"}],"abstract":[{"type":"text","text":"The harp-pedals type is used to create harp pedal diagrams. The pedal-step and pedal-alter elements use the"},{"type":"text","text":" "},{"type":"text","text":"same values as the step and alter elements. For easiest reading, the pedal-tuning elements should follow"},{"type":"text","text":" "},{"type":"text","text":"standard harp pedal order, with pedal-step values of D, C, B, E, F, G, and A."}]}}}