xt","text":"same values as the step and alter elements. For easiest reading, the pedal-tuning elements should follow"},{"type":"text","text":" "},{"type":"text","text":"standard harp pedal order, with pedal-step values of D, C, B, E, F, G, and A."}],"kind":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarpPedals"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLLeftCenterRight":{"type":"topic","kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLLeftCenterRight","kind":"identifier"}],"navigatorTitle":[{"text":"MXLLeftCenterRight","kind":"identifier"}],"abstract":[{"text":"The left-center-right type is used to define horizontal alignment and text justification.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLeftCenterRight","title":"MXLLeftCenterRight","role":"symbol","url":"\/documentation\/ivormxl\/mxlleftcenterright"}}}