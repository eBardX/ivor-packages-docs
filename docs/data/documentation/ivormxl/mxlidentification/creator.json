r. Other type values may be used for","type":"text"},{"text":" ","type":"text"},{"text":"different types of creative roles. The type attribute should usually be used even if there is just a single","type":"text"},{"text":" ","type":"text"},{"text":"creator element. The MusicXML format does not use the creator \/ contributor distinction from Dublin Core.","type":"text"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLTypedText":{"type":"topic","abstract":[{"type":"text","text":"The typed-text type represents a text element with a type attribute."}],"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTypedText"}],"url":"\/documentation\/ivormxl\/mxltypedtext","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTypedText","title":"MXLTypedText","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLTypedText"}]},"doc://IvorMXL/documentation/IvorMXL/MXLIdentification":{"title":"MXLIdentification","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLIdentification","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlidentification","role":"symbol","navigatorTitle":[{"text":"MXLIdentification","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLIdentification","abstract":[{"text":"Identification contains basic metadata about the score. It includes information that may apply at a score-","type":"text"},{"text":" ","type":"text"},{"text":"wide, movement-wide, or part-wide level. The creator, rights, source, and relation elements are based on","type":"text"},{"text":" ","type":"text"},{"text":"Dublin Core.","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLIdentification/creator":{"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"creator"},{"kind":"