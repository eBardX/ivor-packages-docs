{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLIdentification\/init(creator:rights:encoding:source:relation:miscellaneous:)"},"sections":[],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"init","kind":"keyword"},{"text":"(","kind":"text"},{"text":"creator","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"MXLTypedText","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL12MXLTypedTextV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTypedText"},{"text":"] = [], ","kind":"text"},{"text":"rights","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"MXLTypedText","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL12MXLTypedTextV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTypedText"},{"text":"] = [], ","kind":"text"},{"text":"encoding","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLEncoding","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLEncodingV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEncoding"},{"text":"? = nil, ","kind":"text"},{"text":"source","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"? = nil, ","kind":"text"},{"text":"relation","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"MXLTypedText","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL12MXLTypedTextV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTypedText"},{"text":"] = [], ","kind":"text"},{"text":"miscellaneous","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLMiscellaneous","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL16MXLMiscellaneousV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMiscellaneous"},{"text":"? = nil)","kind":"text"}],"platforms":["macOS"]}]},{"kind":"parameters","parameters":[{"name":"creator","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The creator element is borrowed from Dublin Core. It is used for the creators of the score. The type attribute is used to distinguish different creative contributions. Thus, there can be multiple creators within an identification. Standard type values are composer, lyricist, and arranger. Other type values may be used for different types of creative roles. The type attribute should usually be used even if there is just a single creator element. The MusicXML format does not use the creator \/ contributor distinction from Dublin Core."}]}]},{"name":"rights","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The rights element is borrowed from Dublin Core. It contains copyright and other intellectual property notices. Words, music, and derivatives can have different types, so multiple rights elements with different type attributes are supported. Standard type values are music, words, and arrangement, but other types may be used. The type attribute is only needed when there are multiple rights elements."}]}]},{"name":"encoding","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Information about who did the digital encoding, when, with what software, and in what aspects."}]}]},{"name":"source","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The source for the music that is encoded. This is similar to the Dublin Core source element."}]}]},{"name":"relation","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A related resource for the music that is encoded. This is similar to the Dublin Core relation element. Standard type values are music, words, and arrangement, but other types may be used."}]}]},{"name":"miscellaneous","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Other metadata not yet supported elsewhere in the MusicXML format."}]}]}]}],"metadata":{"roleHeading":"Initializer","modules":[{"name":"IvorMXL"}],"exter