{"abstract":[{"text":"Creates a new ","type":"text"},{"code":"MXLIdentification","type":"codeVoice"},{"text":".","type":"text"}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"text":"init","kind":"keyword"},{"text":"(","kind":"text"},{"text":"creator","kind":"externalParam"},{"text":": [","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTypedText","preciseIdentifier":"s:7IvorMXL12MXLTypedTextV","text":"MXLTypedText","kind":"typeIdentifier"},{"text":"] = [], ","kind":"text"},{"text":"rights","kind":"externalParam"},{"text":": [","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTypedText","preciseIdentifier":"s:7IvorMXL12MXLTypedTextV","text":"MXLTypedText","kind":"typeIdentifier"},{"text":"] = [], ","kind":"text"},{"text":"encoding","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEncoding","preciseIdentifier":"s:7IvorMXL11MXLEncodingV","text":"MXLEncoding","kind":"typeIdentifier"},{"kind":"text","text":"? = nil, "},{"text":"source","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"relation","kind":"externalParam"},{"text":": [","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTypedText","preciseIdentifier":"s:7IvorMXL12MXLTypedTextV","text":"MXLTypedText","kind":"typeIdentifier"},{"text":"] = [], ","kind":"text"},{"text":"miscellaneous","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMiscellaneous","preciseIdentifier":"s:7IvorMXL16MXLMiscellaneousV","text":"MXLMiscellaneous","kind":"typeIdentifier"},{"text":"? = nil)","kind":"text"}],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"content":[{"inlineContent":[{"text":"The creator element is borrowed from Dublin Core. It is used for the creators of the","type":"text"},{"text":" ","type":"text"},{"text":"score. The type attribute is used to distinguish different creative contributions.","type":"text"},{"text":" ","type":"text"},{"text":"Thus, there can be multiple creators within an identification. Standard type values","type":"text"},{"text":" ","type":"text"},{"text":"are composer, lyricist, and arranger. Other type values may be used for different","type":"text"},{"text":" ","type":"text"},{"text":"types of creative roles. The type attribute should usually be used even if there is","type":"text"},{"text":" ","type":"text"},{"text":"just a single creator element. The MusicXML format does not use the creator \/","type":"text"},{"text":" ","type":"text"},{"text":"contributor distinction from Dublin Core.","type":"text"}],"type":"paragraph"}],"name":"creator"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The rights element is borrowed from Dublin Core. It contains copyright and other","type":"text"},{"text":" ","type":"text"},{"text":"intellectual property notices. Words, music, and derivatives can have different","type":"text"},{"text":" ","type":"text"},{"text":"types, so multiple rights elements with different type attributes are supported.","type":"text"},{"text":" ","type":"text"},{"text":"Standard type values are music, words, and arrangement, but other types may be used.","type":"text"},{"text":" ","type":"text"},{"text":"The type attribute is only needed when there are multiple rights elements.","type":"text"}]}],"name":"rights"},{"content":[{"inlineContent":[{"text":"Information about who did the digital encoding, when, with what software, and in","type":"text"},{"text":" ","type":"text"},{"text":"what aspects.","type":"text"}],"type":"paragraph"}],"name":"encoding"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The source for the music that is encoded. This is similar to the Dublin Core source","type":"text"},{"text":" ","type":"text"},{"text":"element.","type":"text"}]}],"name":"source"},{"content":[{"inlineContent":[{"text":"A related resource for the music that is encoded. This is similar to the Dublin Core","type":"text"},{"text":" ","type":"text"},{"text":"relation element. Standard type values are music, words, and arrangement, but other","type":"text"},{"text":" ","type":"text"},{"text":"types may be used.","type":"text"}],"type":"paragraph"}],"name":"relation"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Other metadata not yet supported elsewhere in the MusicXML format.","type":"text"}]}],"name":"miscellaneous"}],"kind":"parameters"}],"variants":[{"paths":["\/documentation\/ivormxl\/mxlidentification\/init(creator:rights:encoding:source:relation:miscellaneous:)"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLIdentification"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"roleHeading":"Initializer","modules":[{"name":"IvorMXL"}],"symbolKind":"init","role":"symbol","title":"init(creator:rights:encoding:source:relation:miscellaneous:)","externalID":"s:7IvorMXL17MXLIdentificationV7creator6rights8encoding6source8relation13miscellaneousACSayAA12MXLTypedTextVG_AlA11MXLEncodingVSgSSSgAlA16MXLMiscellaneousVSgtcfc","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"creator","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"MXLTypedText","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL12MXLTypedTextV"},{"text":"], ","kind":"text"},{"text":"rights","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"MXLTypedText","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL12MXLTypedTextV"},{"text":"], ","kind":"text"},{"text":"encoding","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLEncoding","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLEncodingV"},{"text":"?, ","kind":"text"},{"text":"source","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?, ","kind":"text"},{"text":"relation","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"MXLTypedText","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL12MXLTypedTextV"},{"text":"], ","kind":"text"},{"text":"miscellaneous","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLMiscellaneous","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL16MXLMiscellaneousV"},{"text":"?)","kind":"text"}]},"kind":"symbol","identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLIdentification\/init(creator:rights:encoding:source:relation:miscellaneous:)","interfaceLanguage":"swift"},"sections":[],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLTypedText":{"type":"topic","abstract":[{"type":"text","text":"The typed-text type represents a text element with a type attribute."}],"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTypedText"}],"url":"\/documentation\/ivormxl\/mxltypedtext","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTypedText","title":"MXLTypedText","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLTypedText"}]},"doc://IvorMXL/documentation/IvorMXL/MXLEncoding":{"type":"topic","abstract":[{"type":"text","text":"The encoding element contains information about who did the digital encoding, when, with what software, and in"},{"type":"text","text":" "},{"type":"text","text":"what aspects. Standard type values for the encoder element are music, words, and arrangement, but other types"},{"type":"text","text":" "},{"type":"text","text":"may be used. The type attribute is only needed when there are multiple encoder elements."}],"url":"\/documentation\/ivormxl\/mxlencoding","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLEncoding"}],"kind":"symbol","title":"MXLEncoding","navigatorTitle":[{"kind":"identifier","text":"MXLEncoding"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEncoding","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLMiscellaneous":{"type":"topic","abstract":[{"type":"text","text":"If a program has other metadata not yet supported in the MusicXML format, it can go in the miscellaneous"},{"type":"text","text":" "},{"type":"text","text":"element. The miscellaneous type puts each separate part of metadata into its own miscellaneous-field type."}],"url":"\/documentation\/ivormxl\/mxlmiscellaneous","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLMiscellaneous"}],"kind":"symbol","title":"MXLMiscellaneous","navigatorTitle":[{"kind":"identifier","text":"MXLMiscellaneous"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMiscellaneous","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLIdentification":{"title":"MXLIdentification","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLIdentification","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlidentification","role":"symbol","navigatorTitle":[{"text":"MXLIdentification","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLIdentification","abstract":[{"text":"Identification contains basic metadata about the score. It includes information that may apply at a score-","type":"text"},{"text":" ","type":"text"},{"text":"wide, movement-wide, or part-wide level. The creator, rights, source, and relation elements are based on","type":"text"},{"text":" ","type":"text"},{"text":"Dublin Core.","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLIdentification/init(creator:rights:encoding:source:relation:miscellaneous:)":{"type":"topic","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"creator","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"MXLTypedText",