":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"damperPedal","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLYesNoNumber","preciseIdentifier":"s:7IvorMXL14MXLYesNoNumberO","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"url":"\/documentation\/ivormxl\/mxlsound\/damperpedal"},"doc://IvorMXL/SQ":{"type":"unresolvable","title":"Swift.Equatable","identifier":"doc:\/\/IvorMXL\/SQ"},"doc://IvorMXL/documentation/IvorMXL/MXLSound/timeOnly":{"url":"\/documentation\/ivormxl\/mxlsound\/timeonly","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/timeOnly","title":"timeOnly","type":"topic","role":"symbol","abstract":[{"text":"Indicates which times through a repeat this sound element applies to, if only particular times.","type":"text"}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"timeOnly","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL11MXLTimeOnlya","text":"MXLTimeOnly","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNote"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLNote"}],"url":"\/documentation\/ivormxl\/mxlnote","role":"symbol","title":"MXLNote","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","type":"topic","abstract":[{"type":"text","text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for"},{"type":"text","text":" "},{"type":"text","text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation)."},{"type":"text","text":" "},{"type":"text","text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,"},{"type":"text","text":" "},{"type":"text","text":"but no tie elements. Having these two types of information available can make interchange easier, as some"},{"type":"text","text":" "},{"type":"text","text":"programs handle one type of information more readily than the other."}]},"doc://IvorMXL/documentation/IvorMXL/MXLSound/swing":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/swing","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"swing","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLSwing","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLSwingV"},{"text":"?","kind":"text"}],"kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxlsound\/swing","role":"symbol","abstract":[{"text":"Specifies playback as swung rather than even notes.","type":"text"}],"title":"swing"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline":{"role":"symbol","abstract":[{"type":"text","text":"If a barline is other than a normal single barline, it should be represented by a barline type that describes"},{"text":" ","type":"text"},{"type":"text","text":"it. This includes information about repeats and multiple endings, as well as line style. Barline data is on"},{"type":"text","text":" "},{"type":"text","text":"the same level as the other musical data in a score — a child of a measure in a partwise score, or a part in a"},{"text":" ","type":"text"},{"type":"text","text":"timewise score. This allows for barlines within measures, as in dotted barlines that subdivide measures in"},{"text":" ","type":"text"},{"type":"text","text":"complex meters. The two fermata elements allow for fermatas on both sides of the barline (the lower one"},{"type":"text","text":" "},{"type":"text","text":"inverted)."}],"title":"MXLBarline","url":"\/documentation\/ivormxl\/mxlbarline","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline","navigatorTitle":[{"text":"MXLBarline","kind":"identifier"}],"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLBarline"}]},"doc://IvorMXL/SH":{"type":"unresolvable","title":"Swift.Hashable","identifier":"doc:\/\/IvorMXL\/SH"},"doc://IvorMXL/s8CopyableP":{"type":"unresolvable","title":"Swift.Copyable","identifier":"doc:\/\/IvorMXL\/s8CopyableP"},"doc://IvorMXL/documentation/IvorMXL/MXLPitch":{"role":"symbol","abstract":[{"type":"text","text":"Pitch is represented as a combination of the step of the diatonic scale, the chromatic alteration, and the"},{"type":"text","text":" "},{"type":"text","text":"octave."}],"title":"MXLPitch","url":"\/documentation\/ivormxl\/mxlpitch","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPitch","navigatorTitle":[{"text":"MXLPitch","kind":"identifier"}],"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPitch"}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLDirection"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection","title":"MXLDirection","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLDirection"}],"abstract":[{"text":"A direction is a musical indication that is not necessarily attached to a specific note. Two or more may be","type":"text"},{"type":"text","text":" "},{"text":"combined to indicate words followed by the start of a dashed line, the end of a wedge followed by dynamics,","type":"text"},{"type":"text","text":" "},{"text":"etc. For applications where a specific direction is indeed attached to a specific note, the direction element","type":"text"},{"type":"text","text":" "},{"text":"can be associated with the first note element that follows it in score order that is not in a different voice.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxldirection"},"doc://IvorMXL/documentation/IvorMXL/MXLSound/dynamics":{"kind":"symbol","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/dynamics","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"dynamics"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL21MXLNonNegativeDecimala","kind":"typeIdentifier","text":"MXLNonNegativeDecimal"},{"kind":"text","text":"?"}],"type":"topic","abstract":[{"type":"text","text":"The dynamics (or MIDI velocity), expressed as a percentage of the default forte value (90 for MIDI 1.0)."}],"url":"\/documentation\/ivormxl\/mxlsound\/dynamics","title":"dynamics"}}}