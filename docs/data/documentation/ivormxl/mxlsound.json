{"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMusicItem","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFullNote","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRest","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPitch","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline"],"title":"Music","anchor":"Music"}],"topicSections":[{"generated":true,"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/Group-swift.struct"],"title":"Structures","anchor":"Structures"},{"generated":true,"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/init(id:group:swing:offset:tempo:dynamics:isDaCapo:segno:dalsegno:coda:tocoda:divisions:impliesForwardRepeat:fine:timeOnly:isPizzicato:pan:elevation:damperPedal:softPedal:sostenutoPedal:)"],"title":"Initializers","anchor":"Initializers"},{"generated":true,"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/coda","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/dalsegno","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/damperPedal","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/divisions","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/dynamics","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/elevation","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/fine","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/group-swift.property","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/id","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/impliesForwardRepeat","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/isDaCapo","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/isPizzicato","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/offset","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/pan","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/segno","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/softPedal","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/sostenutoPedal","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/swing","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/tempo","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/timeOnly","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/tocoda"],"title":"Instance Properties","anchor":"Instance-Properties"},{"generated":true,"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/Equatable-Implementations"],"title":"Default Implementations","anchor":"Default-Implementations"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSound","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"Tempo is expressed in quarter notes per minute. If 0, the sound-generating program should prompt the user at"},{"type":"text","text":" "},{"type":"text","text":"the time of compiling a sound (MIDI) file."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Dynamics (or MIDI velocity) are expressed as a percentage of the default forte value (90 for MIDI 1.0)."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Dacapo indicates to go back to the beginning of the movement. When used it always has the value “yes”."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Segno and dalsegno are used for backwards jumps to a segno sign; coda and tocoda are used for forward jumps to"},{"type":"text","text":" "},{"type":"text","text":"a coda sign. If there are multiple jumps, the value of these parameters can be used to name and distinguish"},{"type":"text","text":" "},{"type":"text","text":"them. If segno or coda is used, the divisions attribute can also be used to indicate the number of divisions"},{"type":"text","text":" "},{"type":"text","text":"per quarter note. Otherwise sound and MIDI generating programs may have to recompute this."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"By default, a dalsegno or dacapo attribute indicates that the jump should occur the first time through, while"},{"type":"text","text":" "},{"type":"text","text":"a tocoda attribute indicates the jump should occur the second time through. The time that jumps occur can be"},{"type":"text","text":" "},{"type":"text","text":"changed by using the time-only attribute."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The forward-repeat attribute indicates that a forward repeat sign is implied but not displayed. It is used for"},{"type":"text","text":" "},{"type":"text","text":"example in two-part forms with repeats, such as a minuet and trio where no repeat is displayed at the start of"},{"type":"text","text":" "},{"type":"text","text":"the trio. This usually occurs after a barline. When used it always has the value of “yes”."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The fine attribute follows the final note or rest in a movement with a da capo or dal segno direction. If"},{"type":"text","text":" "},{"type":"text","text":"numeric, the value represents the actual duration of the final note or rest, which can be ambiguous in written"},{"type":"text","text":" "},{"type":"text","text":"notation and different among parts and voices. The value may also be “yes” to indicate no change to the final"},{"type":"text","text":" "},{"type":"text","text":"duration."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If the sound element applies only particular times through a repeat, the time-only attribute indicates which"},{"type":"text","text":" "},{"type":"text","text":"times to apply the sound element."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Pizzicato in a sound element effects all following notes. Yes indicates pizzicato, no indicates arco."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The pan and elevation attributes are deprecated in Version 2.0. The pan and elevation elements in the midi-"},{"type":"text","text":" "},{"type":"text","text":"instrument element should be used instead. The meaning of the pan and elevation attributes is the same as for"},{"type":"text","text":" "},{"type":"text","text":"the pan and elevation elements. If both are present, the mid-instrument elements take priority."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The damper-pedal, soft-pedal, and sostenuto-pedal attributes effect playback of the three common piano pedals"},{"type":"text","text":" "},{"type":"text","text":"and their MIDI controller equivalents. The yes value indicates the pedal is depressed; no indicates the pedal"},{"type":"text","text":" "},{"type":"text","text":"is released. A numeric value from 0 to 100 may also be used for half pedaling. This value is the percentage"},{"type":"text","text":" "},{"type":"text","text":"that the pedal is depressed. A value of 0 is equivalent to no, and a value of 100 is equivalent to yes."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Instrument changes, MIDI devices, MIDI instruments, and playback techniques are changed using the instrument-"},{"type":"text","text":" "},{"type":"text","text":"change, midi-device, midi-instrument, and play elements. When there are multiple instances of these elements,"},{"type":"text","text":" "},{"type":"text","text":"they should be grouped together by instrument using the id attribute values."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The offset element is used to indicate that the sound takes place offset from the current score position. If"},{"type":"text","text":" "},{"type":"text","text":"the sound element is a child of a direction element, the sound offset element overrides the direction offset"},{"type":"text","text":" "},{"type":"text","text":"element if both elements are present. Note that the offset reflects the intended musical position for the"},{"type":"text","text":" "},{"type":"text","text":"change in sound. It should not be used to compensate for latency issues in particular hardware configurations."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Maps the MusicXML "},{"type":"codeVoice","code":"<sound>"},{"type":"text","text":" element."}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlsound"]}],"sections":[],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound","interfaceLanguage":"swift"},"metadata":{"roleHeading":"Structure","navigatorTitle":[{"text":"MXLSound","kind":"identifier"}],"externalID":"s:7IvorMXL8MXLSoundV","role":"symbol","title":"MXLSound","modules":[{"name":"IvorMXL"}],"symbolKind":"struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLSound"}]},"abstract":[{"type":"text","text":"The sound element contains general playback parameters. They can stand alone within a part\/measure, or be a"},{"type":"text","text":" "},{"type":"text","text":"component element within a direction."}],"relationshipsSections":[{"title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/IvorMXL\/s8CopyableP","doc:\/\/IvorMXL\/SQ","doc:\/\/IvorMXL\/s9EscapableP","doc:\/\/IvorMXL\/SH","doc:\/\/IvorMXL\/s8SendableP","doc:\/\/IvorMXL\/s16SendableMetatypeP"],"type":"conformsTo"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL"]]},"kind":"symbol","references":{"doc://IvorMXL/documentation/IvorMXL/MXLSound/isDaCapo":{"abstract":[{"type":"text","text":"A Boolean value indicating whether to go back to the beginning of the movement."}],"title":"isDaCapo","url":"\/documentation\/ivormxl\/mxlsound\/isdacapo","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isDaCapo","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":"?","kind":"text"}],"kind":"symbol","type":"topic","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/isDaCapo"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes":{"title":"MXLAttributes","url":"\/documentation\/ivormxl\/mxlattributes","abstract":[{"type":"text","text":"The attributes element contains musical information that typically changes on measure boundaries. This"},{"type":"text","text":" "},{"type":"text","text":"includes key and time signatures, clefs, transpositions, and staving. When attributes are changed mid-measure,"},{"type":"text","text":" "},{"type":"text","text":"it affects the music in score order, not in MusicXML document order."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLAttributes","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"MXLAttributes","kind":"identifier"}],"type":"topic","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes"},"doc://IvorMXL/documentation/IvorMXL/MXLMusicItem":{"navigatorTitle":[{"text":"MXLMusicItem","kind":"identifier"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLMusicItem","kind":"identifier"}],"abstract":[{"type":"text","text":"One of the alternatives for a music item."}],"role":"symbol","url":"\/documentation\/ivormxl\/mxlmusicitem","type":"topic","title":"MXLMusicItem","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMusicItem","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLSound/pan":{"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"pan"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL18MXLRotationDegreesa","text":"MXLRotationDegrees"},{"kind":"text","text":"?"}],"role":"symbol","title":"pan","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/pan","url":"\/documentation\/ivormxl\/mxlsound\/pan","abstract":[{"text":"Deprecated in favor of the pan element in midi-instrument. Specifies placement of sound in a 3-D space","type":"text"},{"text":" ","type":"text"},{"text":"relative to the listener, in degrees.","type":"text"}],"type":"topic","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLSound/softPedal":{"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"softPedal"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL14MXLYesNoNumberO","text":"MXLYesNoNumber"},{"kind":"text","text":"?"}],"role":"symbol","title":"softPedal","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/softPedal","url":"\/documentation\/ivormxl\/mxlsound\/softpedal","abstract":[{"text":"Controls playback of the soft pedal. A numeric value from 0 to 100 may be used for half pedaling.","type":"text"}],"type":"topic","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLSound/timeOnly":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/timeOnly","abstract":[{"type":"text","text":"Indicates which times through a repeat this sound element applies to, if only particular times."}],"title":"timeOnly","kind":"symbol","type":"topic","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"timeOnly","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL11MXLTimeOnlya","text":"MXLTimeOnly","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"url":"\/documentation\/ivormxl\/mxlsound\/timeonly"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLBarline"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLBarline"}],"title":"MXLBarline","abstract":[{"type":"text","text":"If a barline is other than a normal single barline, it should be represented by a barline type that describes"},{"type":"text","text":" "},{"type":"text","text":"it. This includes information about repeats and multiple endings, as well as line style. Barline data is on"},{"type":"text","text":" "},{"type":"text","text":"the same level as the other musical data in a score — a child of a measure in a partwise score, or a part in a"},{"type":"text","text":" "},{"type":"text","text":"timewise score. This allows for barlines within measures, as in dotted barlines that subdivide measures in"},{"type":"text","text":" "},{"type":"text","text":"complex meters. The two fermata elements allow for fermatas on both sides of the barline (the lower one"},{"type":"text","text":" "},{"type":"text","text":"inverted)."}],"url":"\/documentation\/ivormxl\/mxlbarline"},"doc://IvorMXL/s9EscapableP":{"identifier":"doc:\/\/IvorMXL\/s9EscapableP","type":"unresolvable","title":"Swift.Escapable"},"doc://IvorMXL/documentation/IvorMXL/MXLSound/damperPedal":{"kind":"symbol","url":"\/documentation\/ivormxl\/mxlsound\/damperpedal","title":"damperPedal","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/damperPedal","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"damperPedal","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL14MXLYesNoNumberO","text":"MXLYesNoNumber","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"abstract":[{"type":"text","text":"Controls playback of the damper pedal. A numeric value from 0 to 100 may be used for half pedaling."}]},"doc://IvorMXL/documentation/IvorMXL/MXLSound/dalsegno":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/dalsegno","type":"topic","abstract":[{"type":"text","text":"Names the segno sign to jump back to, used to distinguish between multiple jumps."}],"url":"\/documentation\/ivormxl\/mxlsound\/dalsegno","role":"symbol","title":"dalsegno","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"dalsegno"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?"}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLSound/dynamics":{"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"dynamics"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL21MXLNonNegativeDecimala","text":"MXLNonNegativeDecimal"},{"kind":"text","text":"?"}],"role":"symbol","title":"dynamics","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/dynamics","url":"\/documentation\/ivormxl\/mxlsound\/dynamics","abstract":[{"text":"The dynamics (or MIDI velocity), expressed as a percentage of the default forte value (90 for MIDI 1.0).","type":"text"}],"type":"topic","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLSound/swing":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlsound\/swing","title":"swing","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/swing","abstract":[{"text":"Specifies playback as swung rather than even notes.","type":"text"}],"type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"swing","kind":"identifier"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"MXLSwing","preciseIdentifier":"s:7IvorMXL8MXLSwingV"},{"kind":"text","text":"?"}]},"doc://IvorMXL/documentation/IvorMXL/MXLSound/sostenutoPedal":{"abstract":[{"text":"Controls playback of the sostenuto pedal. A numeric value from 0 to 100 may be used for half pedaling.","type":"text"}],"kind":"symbol","type":"topic","role":"symbol","title":"sostenutoPedal","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/sostenutoPedal","url":"\/documentation\/ivormxl\/mxlsound\/sostenutopedal","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"sostenutoPedal"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLYesNoNumber","preciseIdentifier":"s:7IvorMXL14MXLYesNoNumberO"},{"kind":"text","text":"?"}]},"doc://IvorMXL/documentation/IvorMXL/MXLSound/fine":{"url":"\/documentation\/ivormxl\/mxlsound\/fine","title":"fine","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/fine","abstract":[{"type":"text","text":"Follows the final note or rest in a movement with a da capo or dal segno direction. If numeric, represents"},{"type":"text","text":" "},{"type":"text","text":"the actual duration of the final note or rest."}],"type":"topic","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"fine","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?","kind":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLSound/id":{"url":"\/documentation\/ivormxl\/mxlsound\/id","abstract":[{"text":"The optional-unique-id attribute group allows an element to optionally specify an ID that is unique to the","type":"text"},{"text":" ","type":"text"},{"text":"entire document. This attribute group is not used for a required id attribute, or for an id attribute that","type":"text"},{"text":" ","type":"text"},{"text":"specifies an id reference.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/id","title":"id","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"id"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLFullNote":{"url":"\/documentation\/ivormxl\/mxlfullnote","role":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFullNote","abstract":[{"type":"text","text":"The full-note group is a sequence of the common note elements between cue\/grace notes and regular (full)"},{"type":"text","text":" "},{"type":"text","text":"notes: pitch, chord, and rest information, but not duration (cue and grace notes do not have duration"},{"type":"text","text":" "},{"type":"text","text":"encoded). Unpitched elements are used for unpitched percussion, speaking voice, and other musical elements"},{"type":"text","text":" "},{"type":"text","text":"lacking determinate pitch."}],"title":"MXLFullNote","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLFullNote","kind":"identifier"}],"navigatorTitle":[{"text":"MXLFullNote","kind":"identifier"}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLSound/isPizzicato":{"role":"symbol","abstract":[{"type":"text","text":"A Boolean value indicating whether following notes are played pizzicato ("},{"type":"codeVoice","code":"true"},{"type":"text","text":") or arco ("},{"type":"codeVoice","code":"false"},{"type":"text","text":")."}],"kind":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/isPizzicato","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isPizzicato","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"url":"\/documentation\/ivormxl\/mxlsound\/ispizzicato","title":"isPizzicato"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection":{"role":"symbol","url":"\/documentation\/ivormxl\/mxldirection","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLDirection","kind":"identifier"}],"navigatorTitle":[{"text":"MXLDirection","kind":"identifier"}],"abstract":[{"text":"A direction is a musical indication that is not necessarily attached to a specific note. Two or more may be","type":"text"},{"text":" ","type":"text"},{"text":"combined to indicate words followed by the start of a dashed line, the end of a wedge followed by dynamics,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"etc. For applications where a specific direction is indeed attached to a specific note, the direction element"},{"text":" ","type":"text"},{"type":"text","text":"can be associated with the first note element that follows it in score order that is not in a different voice."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection","title":"MXLDirection","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLRest":{"url":"\/documentation\/ivormxl\/mxlrest","role":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRest","abstract":[{"type":"text","text":"The rest element indicates notated rests or silences. Rest elements are usually empty, but placement on the"},{"type":"text","text":" "},{"type":"text","text":"staff can be specified using display-step and display-octave elements. If the measure attribute is set to yes,"},{"type":"text","text":" "},{"type":"text","text":"this indicates this is a complete measure rest."}],"title":"MXLRest","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLRest","kind":"identifier"}],"navigatorTitle":[{"text":"MXLRest","kind":"identifier"}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlnote","title":"MXLNote","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNote","kind":"identifier"}],"navigatorTitle":[{"text":"MXLNote","kind":"identifier"}],"abstract":[{"type":"text","text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for"},{"type":"text","text":" "},{"type":"text","text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation)."},{"type":"text","text":" "},{"type":"text","text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,"},{"type":"text","text":" "},{"text":"but no tie elements. Having these two types of information available can make interchange easier, as some","type":"text"},{"type":"text","text":" "},{"type":"text","text":"programs handle one type of information more readily than the other."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote"},"doc://IvorMXL/documentation/IvorMXL/MXLSound/impliesForwardRepeat":{"url":"\/documentation\/ivormxl\/mxlsound\/impliesforwardrepeat","abstract":[{"text":"A Boolean value indicating whether a forward repeat sign is implied but not displayed.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/impliesForwardRepeat","title":"impliesForwardRepeat","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"impliesForwardRepeat"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":"?"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLSound/coda":{"abstract":[{"text":"Names a coda sign for a forward jump, used to distinguish between multiple jumps.","type":"text"}],"title":"coda","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/coda","url":"\/documentation\/ivormxl\/mxlsound\/coda","kind":"symbol","role":"symbol","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"coda","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"?","kind":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLSound/divisions":{"url":"\/documentation\/ivormxl\/mxlsound\/divisions","abstract":[{"text":"The number of divisions per quarter note, u