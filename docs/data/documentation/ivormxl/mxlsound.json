,"navigatorTitle":[{"kind":"identifier","text":"MXLFullNote"}],"role":"symbol","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The full-note group is a sequence of the common note elements between cue\/grace notes and regular (full)"},{"type":"text","text":" "},{"type":"text","text":"notes: pitch, chord, and rest information, but not duration (cue and grace notes do not have duration"},{"type":"text","text":" "},{"type":"text","text":"encoded). Unpitched elements are used for unpitched percussion, speaking voice, and other musical elements"},{"type":"text","text":" "},{"type":"text","text":"lacking determinate pitch."}]},"doc://IvorMXL/documentation/IvorMXL/MXLSound/elevation":{"kind":"symbol","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/elevation","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"elevation"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLRotationDegrees","preciseIdentifier":"s:7IvorMXL18MXLRotationDegreesa"},{"kind":"text","text":"?"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlsound\/elevation","abstract":[{"type":"text","text":"Deprecated in favor of the elevation element in midi-instrument. Specifies placement of sound in a 3-D space"},{"type":"text","text":" "},{"type":"text","text":"relative to the listener, in degrees."}],"title":"elevation"},"doc://IvorMXL/documentation/IvorMXL/MXLSound/id":{"kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"id","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?","kind":"text"}],"url":"\/documentation\/ivormxl\/mxlsound\/id","abstract":[{"text":"The optional-unique-id attribute group allows an element to optionally specify an ID that is unique to the","type":"text"},{"text":" ","type":"text"},{"text":"entire document. This attribute group is not used for a required id attribute, or for an id attribute that","type":"text"},{"text":" ","type":"text"},{"text":"specifies an id reference.","type":"text"}],"role":"symbol","title":"id","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/id","type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLRest":{"url":"\/documentation\/ivormxl\/mxlrest","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLRest"}],"title":"MXLRest","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRest","navigatorTitle":[{"kind":"identifier","text":"MXLRest"}],"role":"symbol","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The rest element indicates notated rests or silences. Rest elements are usually empty, but placement on the"},{"type":"text","text":" "},{"type":"text","text":"staff can be specified using display-step and display-octave elements. If the measure attribute is set to yes,"},{"type":"text","text":" "},{"type":"text","text":"this indicates this is a complete measure rest."}]},"doc://IvorMXL/documentation/IvorMXL/MXLSound/Group-swift.struct":{"title":"MXLSound.Group","navigatorTitle":[{"text":"Group","kind":"identifier"}],"kind":"symbol","abstract":[{"type":"text","text":"A grouping of instrument changes, MIDI device and instrument assignments, and playback techniques"},{"type":"text","text":" "},{"type":"text","text":"associated with a single instrument within a sound element."}],"role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/Group-swift.struct","type":"topic","url":"\/documentation\/ivormxl\/mxlsound\/group-swift.struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Group","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLSound/softPedal":{"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"softPedal"},{"kind":"text","text":": "},{"kin