{"metadata":{"symbolKind":"struct","title":"MXLSound","role":"symbol","roleHeading":"Structure","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSound","kind":"identifier"}],"navigatorTitle":[{"text":"MXLSound","kind":"identifier"}],"externalID":"s:7IvorMXL8MXLSoundV","modules":[{"name":"IvorMXL"}]},"topicSections":[{"anchor":"Structures","title":"Structures","generated":true,"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/Group-swift.struct"]},{"anchor":"Initializers","title":"Initializers","generated":true,"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/init(id:group:swing:offset:tempo:dynamics:isDaCapo:segno:dalsegno:coda:tocoda:divisions:impliesForwardRepeat:fine:timeOnly:isPizzicato:pan:elevation:damperPedal:softPedal:sostenutoPedal:)"]},{"generated":true,"anchor":"Instance-Properties","title":"Instance Properties","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/coda","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/dalsegno","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/damperPedal","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/divisions","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/dynamics","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/elevation","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/fine","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/group-swift.property","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/id","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/impliesForwardRepeat","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/isDaCapo","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/isPizzicato","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/offset","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/pan","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/segno","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/softPedal","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/sostenutoPedal","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/swing","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/tempo","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/timeOnly","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/tocoda"]},{"generated":true,"anchor":"Default-Implementations","title":"Default Implementations","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/Equatable-Implementations"]}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlsound"]}],"seeAlsoSections":[{"anchor":"Music","title":"Music","generated":true,"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMusicItem","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFullNote","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRest","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPitch","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline"]}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL"]]},"relationshipsSections":[{"title":"Conforms To","type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/IvorMXL\/s8CopyableP","doc:\/\/IvorMXL\/SQ","doc:\/\/IvorMXL\/s9EscapableP","doc:\/\/IvorMXL\/SH","doc:\/\/IvorMXL\/s8SendableP","doc:\/\/IvorMXL\/s16SendableMetatypeP"]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSound","kind":"identifier"}],"platforms":["macOS"]}]},{"kind":"content","content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Tempo is expressed in quarter notes per minute. If 0, the sound-generating program should prompt the user at","type":"text"},{"text":" ","type":"text"},{"text":"the time of compiling a sound (MIDI) file.","type":"text"}]},{"inlineContent":[{"text":"Dynamics (or MIDI velocity) are expressed as a percentage of the default forte value (90 for MIDI 1.0).","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Dacapo indicates to go back to the beginning of the movement. When used it always has the value “yes”.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Segno and dalsegno are used for backwards jumps to a segno sign; coda and tocoda are used for forward jumps to","type":"text"},{"text":" ","type":"text"},{"text":"a coda sign. If there are multiple jumps, the value of these parameters can be used to name and distinguish","type":"text"},{"text":" ","type":"text"},{"text":"them. If segno or coda is used, the divisions attribute can also be used to indicate the number of divisions","type":"text"},{"text":" ","type":"text"},{"text":"per quarter note. Otherwise sound and MIDI generating programs may have to recompute this.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"By default, a dalsegno or dacapo attribute indicates that the jump should occur the first time through, while"},{"type":"text","text":" "},{"type":"text","text":"a tocoda attribute indicates the jump should occur the second time through. The time that jumps occur can be"},{"type":"text","text":" "},{"type":"text","text":"changed by using the time-only attribute."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The forward-repeat attribute indicates that a forward repeat sign is implied but not displayed. It is used for"},{"type":"text","text":" "},{"text":"example in two-part forms with repeats, such as a minuet and trio where no repeat is displayed at the start of","type":"text"},{"text":" ","type":"text"},{"text":"the trio. This usually occurs after a barline. When used it always has the value of “yes”.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The fine attribute follows the final note or rest in a movement with a da capo or dal segno direction. If"},{"text":" ","type":"text"},{"text":"numeric, the value represents the actual duration of the final note or rest, which can be ambiguous in written","type":"text"},{"text":" ","type":"text"},{"text":"notation and different among parts and voices. The value may also be “yes” to indicate no change to the final","type":"text"},{"text":" ","type":"text"},{"text":"duration.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"If the sound element applies only particular times through a repeat, the time-only attribute indicates which","type":"text"},{"text":" ","type":"text"},{"text":"times to apply the sound element.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Pizzicato in a sound element effects all following notes. Yes indicates pizzicato, no indicates arco.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The pan and elevation attributes are deprecated in Version 2.0. The pan and elevation elements in the midi-","type":"text"},{"text":" ","type":"text"},{"text":"instrument element should be used instead. The meaning of the pan and elevation attributes is the same as for","type":"text"},{"text":" ","type":"text"},{"text":"the pan and elevation elements. If both are present, the mid-instrument elements take priority.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The damper-pedal, soft-pedal, and sostenuto-pedal attributes effect playback of the three common piano pedals","type":"text"},{"text":" ","type":"text"},{"text":"and their MIDI controller equivalents. The yes value indicates the pedal is depressed; no indicates the pedal","type":"text"},{"text":" ","type":"text"},{"text":"is released. A numeric value from 0 to 100 may also be used for half pedaling. This value is the percentage","type":"text"},{"text":" ","type":"text"},{"text":"that the pedal is depressed. A value of 0 is equivalent to no, and a value of 100 is equivalent to yes.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Instrument changes, MIDI devices, MIDI instruments, and playback techniques are changed using the instrument-","type":"text"},{"text":" ","type":"text"},{"text":"change, midi-device, midi-instrument, and play elements. When there are multiple instances of these elements,","type":"text"},{"text":" ","type":"text"},{"text":"they should be grouped together by instrument using the id attribute values.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The offset element is used to indicate that the sound takes place offset from the current score position. If","type":"text"},{"text":" ","type":"text"},{"text":"the sound element is a child of a direction element, the sound offset element overrides the direction offset","type":"text"},{"text":" ","type":"text"},{"text":"element if both elements are present. Note that the offset reflects the intended musical position for the","type":"text"},{"text":" ","type":"text"},{"text":"change in sound. It should not be used to compensate for latency issues in particular hardware configurations.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Maps the MusicXML ","type":"text"},{"code":"<sound>","type":"codeVoice"},{"text":" element.","type":"text"}]}]}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound","interfaceLanguage":"swift"},"abstract":[{"text":"The sound element contains general playback parameters. They can stand alone within a part\/measure, or be a","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"component element within a direction."}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLAttributes":{"abstract":[{"text":"The attributes element contains musical information that typically changes on measure boundaries. This","type":"text"},{"text":" ","type":"text"},{"text":"includes key and time signatures, clefs, transpositions, and staving. When attributes are changed mid-measure,","type":"text"},{"text":" ","type":"text"},{"text":"it affects the music in score order, not in MusicXML document order.","type":"text"}],"title":"MXLAttributes","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLAttributes"}],"navigatorTitle":[{"kind":"identifier","text":"MXLAttributes"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlattributes","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes"},"doc://IvorMXL/SQ":{"title":"Swift.Equatable","identifier":"doc:\/\/IvorMXL\/SQ","type":"unresolvable"},"doc://IvorMXL/documentation/IvorMXL/MXLSound/damperPedal":{"kind":"symbol","title":"damperPedal","url":"\/documentation\/ivormxl\/mxlsound\/damperpedal","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"damperPedal","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLYesNoNumber","preciseIdentifier":"s:7IvorMXL14MXLYesNoNumberO","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/damperPedal","abstract":[{"text":"Controls playback of the damper pedal. A numeric value from 0 to 100 may be used for half pedaling.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLSound/timeOnly":{"kind":"symbol","title":"timeOnly","url":"\/documentation\/ivormxl\/mxlsound\/timeonly","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"timeOnly","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLTimeOnly","preciseIdentifier":"s:7IvorMXL11MXLTimeOnlya","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/timeOnly","abstract":[{"text":"Indicates which times through a repeat this sound element applies to, if only particular times.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLSound/tempo":{"kind":"symbol","title":"tempo","url":"\/documentation\/ivormxl\/mxlsound\/tempo","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"tempo","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLNonNegativeDecimal","preciseIdentifier":"s:7IvorMXL21MXLNonNegativeDecimala","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/tempo","abstract":[{"text":"The tempo, expressed in quarter notes per minute. A value of ","type":"text"},{"code":"0","type":"codeVoice"},{"text":" indicates the sound-generating program","type":"text"},{"text":" ","type":"text"},{"text":"should prompt the user when compiling a sound file.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLSound/segno":{"kind":"symbol","title":"segno","url":"\/documentation\/ivormxl\/mxlsound\/segno","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"segno","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/segno","abstract":[{"text":"Names a segno sign for a backward jump, used to distinguish between multiple jumps.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLFullNote":{"abstract":[{"text":"The full-note group is a sequence of the common note elements between cue\/grace notes and regular (full)","type":"text"},{"text":" ","type":"text"},{"text":"notes: pitch, chord, and rest information, but not duration (cue and grace notes do not have duration","type":"text"},{"text":" ","type":"text"},{"text":"encoded). Unpitched elements are used for unpitched percussion, speaking voice, and other musical elements","type":"text"},{"text":" ","type":"text"},{"text":"lacking determinate pitch.","type":"text"}],"title":"MXLFullNote","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFullNote"}],"navigatorTitle":[{"kind":"identifier","text":"MXLFullNote"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlfullnote","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFullNote"},"doc://IvorMXL/documentation/IvorMXL/MXLSound/tocoda":{"kind":"symbol","title":"tocoda","url":"\/documentation\/ivormxl\/mxlsound\/tocoda","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"tocoda","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/tocoda","abstract":[{"text":"Names the coda sign to jump forward to, used to distinguish between multiple jumps.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLSound/isDaCapo":{"kind":"symbol","title":"isDaCapo","url":"\/documentation\/ivormxl\/mxlsound\/isdacapo","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isDaCapo","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSound\/isDaCapo","abstract":[{"text":"A Boolean value indicating whether to go back to the beginning of the movement.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLDirection":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection","title":"MXLDirection","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLDirection","kind":"identifier"}],"navigatorTitle":[{"text":"MXLDirection","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxldirection","abstract":[{"text":"A direction is a musical indication that is not necessarily attached to a specific note. Two or more may be","type":"text"},{"type":"text","text":" "},{"type":"text","text":"combined to indicate words followed by the start of a dashed line, the end of a wedge followed by dynamics,"},{"type":"text","text":" "},{"type":"text","text":"etc. For applications where a specific direction is indeed attached to a specific note, the direction element"},{"type":"text","text":" "},{"type":"text","text":"can be associated with the first note element that follows it in score order that is not in a different voice."}]},"doc://IvorMXL/SH":{"title":"Swift.Hashable","identifier":"doc:\/\/IvorMXL\/SH","type":"unresolvable"},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"navigatorTitle":[{"kind":"identifier","text":"MXLNote"}],"abstract":[{"text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for","type":"text"},{"text":" ","type":"text"},{"text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation).","type":"text"},{"text":" ","type":"text"},{"text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,","type":"text"},{"text":" ","type":"text"},{"text":"but no tie elements. Having these two types of information available can make interchange easier, as some","type":"text"},{"text":" ","type":"text"},{"text":"programs handle one type of information more readily than the other.","type":"text"}],"title":"MXLNote","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","kind":"symbol","url":"\/documentation\/ivormxl\/mxlnote","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNote"}],"role":"symbol"},"doc://IvorMXL/s9EscapableP":{"title":"Swift.Escapable","identifier":"doc:\/\/IvorMXL\/s9EscapableP","type":"unresolvable"},"doc://IvorMXL/s8SendableP":{"ti