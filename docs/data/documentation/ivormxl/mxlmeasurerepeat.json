{"abstract":[{"type":"text","text":"The measure-repeat type is used for both single and multiple measure repeats. The text of the element"},{"type":"text","text":" "},{"type":"text","text":"indicates the number of measures to be repeated in a single pattern. The slashes attribute specifies the"},{"type":"text","text":" "},{"type":"text","text":"number of slashes to use in the repeat sign. It is 1 if not specified. The text of the element is ignored when"},{"type":"text","text":" "},{"type":"text","text":"the type is stop."}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMeasureRepeat","interfaceLanguage":"swift"},"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"topicSections":[{"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMeasureRepeat\/init(value:kind:slashes:)"],"generated":true},{"anchor":"Instance-Properties","title":"Instance Properties","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMeasureRepeat\/kind","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMeasureRepeat\/slashes","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMeasureRepeat\/value"],"generated":true},{"anchor":"Default-Implementations","title":"Default Implementations","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMeasureRepeat\/Equatable-Implementations"],"generated":true}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLMeasureRepeat"}],"platforms":["macOS"],"languages":["swift"]}]},{"content":[{"anchor":"overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"The stop type indicates the first measure where the repeats are no longer displayed. Both the start and the"},{"type":"text","text":" "},{"type":"text","text":"stop of the measure-repeat should be specified unless the repeats are displayed through the end of the part."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The measure-repeat element specifies a notation style for repetitions. The actual music being repeated needs"},{"type":"text","text":" "},{"type":"text","text":"to be repeated within each measure of the MusicXML file. This element specifies the notation that indicates"},{"type":"text","text":" "},{"type":"text","text":"the repeat."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Maps the MusicXML "},{"type":"codeVoice","code":"<measure-repeat>"},{"type":"text","text":" element."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlmeasurerepeat"]}],"kind":"symbol","relationshipsSections":[{"type":"conformsTo","title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/IvorMXL\/s8CopyableP","doc:\/\/IvorMXL\/SQ","doc:\/\/IvorMXL\/s9EscapableP","doc:\/\/IvorMXL\/SH","doc:\/\/IvorMXL\/s8SendableP","doc:\/\/IvorMXL\/s16SendableMetatypeP"]}],"metadata":{"navigatorTitle":[{"text":"MXLMeasureRepeat","kind":"identifier"}],"roleHeading":"Structure","modules":[{"name":"IvorMXL"}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLMeasureRepeat"}],"title":"MXLMeasureRepeat","symbolKind":"struct","externalID":"s:7IvorMXL16MXLMeasureRepeatV"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL"]]},"references":{"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLMeasureRepeat/kind":{"abstract":[{"type":"text","text":"Whether this element marks the start or the stop of the measure repeat."}],"url":"\/documentation\/ivormxl\/mxlmeasurerepeat\/kind","identi