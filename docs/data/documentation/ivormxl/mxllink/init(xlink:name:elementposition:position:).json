{"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLink\/init(xlink:name:elementPosition:position:)","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLink"]]},"kind":"symbol","metadata":{"modules":[{"name":"IvorMXL"}],"externalID":"s:7IvorMXL7MXLLinkV5xlink4name15elementPosition8positionAcA8MXLXLinkV_SSSgAA010MXLElementG0VAA11MXLPositionVtcfc","symbolKind":"init","roleHeading":"Initializer","role":"symbol","title":"init(xlink:name:elementPosition:position:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"xlink","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL8MXLXLinkV","text":"MXLXLink","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"name","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"elementPosition","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL18MXLElementPositionV","text":"MXLElementPosition","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"position","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL11MXLPositionV","text":"MXLPosition","kind":"typeIdentifier"},{"text":")","kind":"text"}]},"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLLink"},{"type":"text","text":"."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxllink\/init(xlink:name:elementposition:position:)"]}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"init","kind":"keyword"},{"text":"(","kind":"text"},{"text":"xlink","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL8MXLXLinkV","text":"MXLXLink","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLXLink","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"name","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"elementPosition","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL18MXLElementPositionV","text":"MXLElementPosition","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLElementPosition","kind":"typeIdentifier"},{"text":" = MXLElementPosition(), ","kind":"text"},{"text":"position","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL11MXLPositionV","text":"MXLPosition","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","kind":"typeIdentifier"},{"text":" = MXLPosition())","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"name":"xlink","content":[{"type":"paragraph","inlineContent":[{"text":"The link-attributes group includes all the simple XLink attributes supported in the MusicXML format. It is also used to connect a MusicXML score with MusicXML parts or a MusicXML opus.","type":"text"}]}]},{"name":"name","content":[{"type":"paragraph","inlineContent":[{"text":"A name for this link, usable by applications for any purpose.","type":"text"}]}]},{"name":"elementPosition","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The element and position attributes are new as of Version 2.0. They allow for bookmarks and links to be positioned at higher resolution than the level of music-data elements. When no element and position attributes are present, the bookmark or link element refers to the next sibling element in the MusicXML file. The element attribute specifies an element type for a descendant of the next sibling element that is not a link or bookmark. The position attribute specifies the position of this descendant element, where the first position is 1. The position attribute is ignored if the element attribute is not present. For instance, an element value of “beam” and a position value of “2” defines the link or bookmark to refer to the second beam descendant of the next sibling element that is not a link or bookmark. This is equivalent to an XPath test of [.\/\/beam[2]] done in the context of the sibling element."}]}]},{"name":"position","content":[{"inlineContent":[{"type":"text","text":"For most elements, any program will compute a default x and y position. The position attributes let this be changed two ways."}],"type":"paragraph"}]}],"kind":"parameters"}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLXLink":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLXLink"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLXLink","title":"MXLXLink","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLXLink"}],"abstract":[{"type":"text","text":"The simple XLink attributes supported in the MusicXML format. It is also used to connect a MusicXML score with"},{"type":"text","text":" "},{"type":"text","text":"MusicXML parts or a MusicXML opus."}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlxlink"},"doc://IvorMXL/documentation/IvorMXL/MXLElementPosition":{"type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLElementPosition","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"MXLElementPosition"}],"abstract":[{"type":"text","text":"The element and position attributes are new as of Version 2.0. They allow for bookmarks and links to be"},{"type":"text","text":" "},{"type":"text","text":"positioned at higher resolution than the level of music-data elements. When no element and position attributes"},{"type":"text","text":" "},{"type":"text","text":"are present, the bookmark or link element refers to the next sibling element in the MusicXML file. The element"},{"type":"text","text":" "},{"type":"text","text":"attribute specifies an element type for a descendant of the next sibling element that is not a link or"},{"type":"text","text":" "},{"type":"text","text":"bookmark. The position attribute specifies the position of this descendant element, where the first position"},{"type":"text","text":" "},{"type":"text","text":"is 1. The position attribute is ignored if the element attribute is not present. For instance, an element"},{"type":"text","text":" "},{"type":"text","text":"value of “beam” and a position value of “2” defines the link or bookmark to refer to the second beam"},{"type":"text","text":" "},{"type":"text","text":"descendant of the next sibling element that is not a link or bookmark. This is equivalent to an XPath test of"},{"type":"text","text":" "},{"type":"text","text":"[.\/\/beam[2]] done in the context of the sibling element."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLElementPosition","title":"MXLElementPosition","role":"symbol","url":"\/documentation\/ivormxl\/mxlelementposition"},"doc://IvorMXL/documentation/IvorMXL/MXLPosition":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLPosition"}],"abstract":[{"text":"For most elements, any program will compute a default x and y position. The position attributes let this be","type":"text"},{"text":" ","type":"text"},{"text":"changed two ways.","type":"text"}],"kind":"symbol","title":"MXLPosition","url":"\/documentation\/ivormxl\/mxlposition","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPosition"}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/d