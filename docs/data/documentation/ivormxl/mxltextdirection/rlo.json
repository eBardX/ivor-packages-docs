{"abstract":[{"text":"A right-to-left bidi-override.","type":"text"}],"sections":[],"kind":"symbol","identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTextDirection\/rlo","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTextDirection"]]},"metadata":{"symbolKind":"case","role":"symbol","roleHeading":"Case","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"rlo","kind":"identifier"}],"modules":[{"name":"IvorMXL"}],"externalID":"s:7IvorMXL16MXLTextDirectionO3rloyA2CmF","title":"MXLTextDirection.rlo"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"rlo","kind":"identifier"}],"platforms":["macOS"]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxltextdirection\/rlo"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLTextDirection/rlo":{"url":"\/documentation\/ivormxl\/mxltextdirection\/rlo","kind":"symbol","type":"topic","role":"symbol","title":"MXLTextDirection.rlo","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTextDirection\/rlo","abstract":[{"text":"A right-to-left bidi-override.","type":"text"}],"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"rlo","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLTextDirection":{"kind":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTextDirection"}],"url":"\/documentation\/ivormxl\/mxltextdirection","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTextDirection","navigatorTitle":[{"text":"MXLTextDirection","kind":"identifier"}],"abstract":[{"type":"text","text":"The text-direction type is used to adjust and override the Unicode bidirectional text algorithm, similar to"},{"text":" ","type":"text"},{"type":"text","text":"the Directionality data category in the W3C Internationalization Tag Set recommendation. Values are ltr (left-"},{"type":"text","text":" "},{"type":"text","text":"to-right embed), rtl (right-to-left embed), lro (left-to-right bidi-override), and rlo (right-to-left bidi-"},{"type":"text","text":" "},{"type":"text","text":"override). The default value is ltr. This type is typically used by applications that store text in left-to-"},{"type":"text","text":" "},{"type":"text","text":"right visual order rather than logical order. Such applications can use the lro value to better communicate"},{"type":"text","text":" "},{"type":"text","text":"with other applications that more fully support bidirectional text."}],"title":"MXLTextDirection","role":"symbol"}}}