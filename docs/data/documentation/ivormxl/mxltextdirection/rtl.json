":"text","text":"to-right embed), rtl (right-to-left embed), lro (left-to-right bidi-override), and rlo (right-to-left bidi-"},{"type":"text","text":" "},{"type":"text","text":"override). The default value is ltr. This type is typically used by applications that store text in left-to-"},{"type":"text","text":" "},{"type":"text","text":"right visual order rather than logical order. Such applications can use the lro value to better communicate"},{"type":"text","text":" "},{"type":"text","text":"with other applications that more fully support bidirectional text."}],"kind":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTextDirection"},"doc://IvorMXL/documentation/IvorMXL/MXLTextDirection/rtl":{"kind":"symbol","title":"MXLTextDirection.rtl","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"rtl","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxltextdirection\/rtl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTextDirection\/rtl","type":"topic","role":"symbol","abstract":[{"type":"text","text":"A right-to-left embed."}]}}}