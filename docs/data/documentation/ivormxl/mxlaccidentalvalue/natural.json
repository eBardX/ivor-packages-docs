{"sections":[],"abstract":[{"text":"A natural accidental.","type":"text"}],"variants":[{"paths":["\/documentation\/ivormxl\/mxlaccidentalvalue\/natural"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"title":"MXLAccidentalValue.natural","externalID":"s:7IvorMXL18MXLAccidentalValueO7naturalyA2CmF","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"natural"}],"role":"symbol","roleHeading":"Case","modules":[{"name":"IvorMXL"}],"symbolKind":"case"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"natural"}]}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidentalValue\/natural","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidentalValue"]]},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLAccidentalValue/natural":{"kind":"symbol","title":"MXLAccidentalValue.natural","url":"\/documentation\/ivormxl\/mxlaccidentalvalue\/natural","role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"natural","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidentalValue\/natural","abstract":[{"type":"text","text":"A natural accidental."}]},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLAccidentalValue":{"title":"MXLAccidentalValue","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLAccidentalValue","kind":"identifier"}],"kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxlaccidentalvalue","abstract":[{"text":"The accidental-value type represents notated accidentals supported by MusicXML. In the MusicXML 2.0 DTD this","type":"text"},{"text":" ","type":"text"},{"text":"was a string with values that could be included. The XSD strengthens the data typing to an enumerated list.","type":"text"},{"text":" ","type":"text"},{"text":"The quarter- and three-quarters- accidentals are Tartini-style quarter-tone accidentals. The -down and -up","type":"text"},{"type":"text","text":" "},{"type":"text","text":"accidentals are quarter-tone accidentals that include arrows pointing down or up. The slash- accidentals are"},{"type":"text","text":" "},{"type":"text","text":"used in Turkish classical music. The numbered sharp and flat accidentals are superscripted versions of the"},{"type":"text","text":" "},{"type":"text","text":"accidental signs, used in Turkish folk music. The sori and koron accidentals are microtonal sharp and flat"},{"type":"text","text":" "},{"type":"text","text":"accidentals used in Iranian and Persian music. The other accidental covers accidentals other than those listed"},{"type":"text","text":" "},{"type":"text","text":"here. It is usually used in combination with the smufl attribute to specify a particular SMuFL accidental. The"},{"type":"text","text":" "},{"type":"text","text":"smufl attribute may be used with any accidental value to help specify the appearance of symbols that share the"},{"type":"text","text":" "},{"type":"text","text":"same MusicXML semantics."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidentalValue","navigatorTitle":[{"text":"MXLAccidentalValue","kind":"identifier"}]}}}