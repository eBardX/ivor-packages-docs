{"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidentalValue\/threeQuartersSharp","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidentalValue"]]},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"threeQuartersSharp"}],"platforms":["macOS"],"languages":["swift"]}]}],"abstract":[{"text":"A Tartini-style three-quarter-tone sharp accidental.","type":"text"}],"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"paths":["\/documentation\/ivormxl\/mxlaccidentalvalue\/threequarterssharp"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"externalID":"s:7IvorMXL18MXLAccidentalValueO18threeQuartersSharpyA2CmF","symbolKind":"case","role":"symbol","roleHeading":"Case","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"threeQuartersSharp"}],"title":"MXLAccidentalValue.threeQuartersSharp","modules":[{"name":"IvorMXL"}]},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLAccidentalValue":{"abstract":[{"text":"The accidental-value type represents notated accidentals supported by MusicXML. In the MusicXML 2.0 DTD this","type":"text"},{"text":" ","type":"text"},{"text":"was a string with values that could be included. The XSD strengthens the data typing to an enumerated list.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"The quarter- and three-quarters- accidentals are Tartini-style quarter-tone accidentals. The -down and -up"},{"type":"text","text":" "},{"text":"accidentals are quarter-tone accidentals that include arrows pointing down or up. The slash- accidentals are","type":"text"},{"text":" ","type":"text"},{"text":"used in Turkish classical music. The numbered sharp and flat accidentals are superscripted versions of the","type":"text"},{"text":" ","type":"text"},{"text":"accidental signs, used in Turkish folk music. The sori and koron accidentals are microtonal sharp and flat","type":"text"},{"text":" ","type":"text"},{"text":"accidentals used in Iranian and Persian music. The other accidental covers accidentals other than those listed","type":"text"},{"text":" ","type":"text"},{"text":"here. It is usually used in combination with the smufl attribute to specify a particular SMuFL accidental. The","type":"text"},{"text":" ","type":"text"},{"text":"smufl attribute may be used with any accidental value to help specify the appearance of symbols that share the","type":"text"},{"text":" ","type":"text"},{"text":"same MusicXML semantics.","type":"text"}],"role":"symbol","navigatorTitle":[{"text":"MXLAccidentalValue","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlaccidentalvalue","kind":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"text":" ","kind":"text"},{"kind":"identifier","text":"MXLAccidentalValue"}],"title":"MXLAccidentalValue","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidentalValue","type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLAccidentalValue/threeQuartersSharp":{"title":"MXLAccidentalValue.threeQuartersSharp","url":"\/documentation\/ivormxl\/mxlaccidentalvalue\/threequarterssharp","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidentalValue\/threeQuartersSharp","abstract":[{"type":"text","text":"A Tartini-style three-quarter-tone sharp accidental."}],"kind":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"threeQuartersSharp","kind":"identifier"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"}}}