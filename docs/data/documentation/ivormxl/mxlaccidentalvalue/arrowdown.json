{"abstract":[{"type":"text","text":"A quarter-tone accidental with an arrow pointing down."}],"kind":"symbol","sections":[],"metadata":{"modules":[{"name":"IvorMXL"}],"externalID":"s:7IvorMXL18MXLAccidentalValueO9arrowDownyA2CmF","roleHeading":"Case","symbolKind":"case","role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"arrowDown","kind":"identifier"}],"title":"MXLAccidentalValue.arrowDown"},"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidentalValue"]]},"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidentalValue\/arrowDown","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"arrowDown","kind":"identifier"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"}],"variants":[{"paths":["\/documentation\/ivormxl\/mxlaccidentalvalue\/arrowdown"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLAccidentalValue":{"title":"MXLAccidentalValue","url":"\/documentation\/ivormxl\/mxlaccidentalvalue","role":"symbol","navigatorTitle":[{"text":"MXLAccidentalValue","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidentalValue","kind":"symbol","abstract":[{"type":"text","text":"The accidental-value type represents notated accidentals supported by MusicXML. In the MusicXML 2.0 DTD this"},{"type":"text","text":" "},{"type":"text","text":"was a string with values that could be included. The XSD strengthens the data typing to an enumerated list."},{"type":"text","text":" "},{"type":"text","text":"The quarter- and three-quarters- accidentals are Tartini-style quarter-tone accidentals. The -down and -up"},{"type":"text","text":" "},{"type":"text","text":"accidentals are quarter-tone accidentals that include arrows pointing down or up. The slash- accidentals are"},{"type":"text","text":" "},{"type":"text","text":"used in Turkish classical music. The numbered sharp and flat accidentals are superscripted versions of the"},{"type":"text","text":" "},{"type":"text","text":"accidental signs, used in Turkish folk music. The sori and koron accidentals are microtonal sharp and flat"},{"type":"text","text":" "},{"type":"text","text":"accidentals used in Iranian and Persian music. The other accidental covers accidentals other than those listed"},{"type":"text","text":" "},{"type":"text","text":"here. It is usually used in combination with the smufl attribute to specify a particular SMuFL accidental. The"},{"type":"text","text":" "},{"type":"text","text":"smufl attribute may be used with any accidental value to help specify the appearance of symbols that share the"},{"type":"text","text":" "},{"type":"text","text":"same MusicXML semantics."}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLAccidentalValue","kind":"identifier"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLAccidentalValue/arrowDown":{"abstract":[{"type":"text","text":"A quarter-tone accidental with an arrow pointing down."}],"kind":"symbol","role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"arrowDown","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidentalValue\/arrowDown","url":"\/documentation\/ivormxl\/mxlaccidentalvalue\/arrowdown","type":"topic","title":"MXLAccidentalValue.arrowDown"}}}