{"kind":"symbol","hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidentalValue"]]},"metadata":{"modules":[{"name":"IvorMXL"}],"roleHeading":"Case","title":"MXLAccidentalValue.flatFlatDown","externalID":"s:7IvorMXL18MXLAccidentalValueO12flatFlatDownyA2CmF","role":"symbol","symbolKind":"case","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"flatFlatDown"}]},"sections":[],"abstract":[{"type":"text","text":"A double flat accidental with an arrow pointing down."}],"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidentalValue\/flatFlatDown","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlaccidentalvalue\/flatflatdown"]}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"flatFlatDown"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLAccidentalValue/flatFlatDown":{"role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"flatFlatDown","kind":"identifier"}],"type":"topic","abstract":[{"text":"A double flat accidental with an arrow pointing down.","type":"text"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlaccidentalvalue\/flatflatdown","title":"MXLAccidentalValue.flatFlatDown","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidentalValue\/flatFlatDown"},"doc://IvorMXL/documentation/IvorMXL/MXLAccidentalValue":{"type":"topic","abstract":[{"type":"text","text":"The accidental-value type represents notated accidentals supported by MusicXML. In the MusicXML 2.0 DTD this"},{"type":"text","text":" "},{"type":"text","text":"was a string with values that could be included. The XSD strengthens the data typing to an enumerated list."},{"type":"text","text":" "},{"type":"text","text":"The quarter- and three-quarters- accidentals are Tartini-style quarter-tone accidentals. The -down and -up"},{"type":"text","text":" "},{"type":"text","text":"accidentals are quarter-tone accidentals that include arrows pointing down or up. The slash- accidentals are"},{"type":"text","text":" "},{"type":"text","text":"used in Turkish classical music. The numbered sharp and flat accidentals are superscripted versions of the"},{"type":"text","text":" "},{"type":"text","text":"accidental signs, used in Turkish folk music. The sori and koron accidentals are microtonal sharp and flat"},{"type":"text","text":" "},{"type":"text","text":"accidentals used in Iranian and Persian music. The other accidental covers accidentals other than those listed"},{"type":"text","text":" "},{"type":"text","text":"here. It is usually used in combination with the smufl attribute to specify a particular SMuFL accidental. The"},{"type":"text","text":" "},{"type":"text","text":"smufl attribute may be used with any accidental value to help specify the appearance of symbols that share the"},{"type":"text","text":" "},{"type":"text","text":"same MusicXML semantics."}],"url":"\/documentation\/ivormxl\/mxlaccidentalvalue","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLAccidentalValue"}],"kind":"symbol","title":"MXLAccidentalValue","navigatorTitle":[{"kind":"identifier","text":"MXLAccidentalValue"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidentalValue","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"}}}