],"title":"MXLCancel","abstract":[{"text":"A cancel element indicates that the old key signature should be canceled before the new one appears. This","type":"text"},{"text":" ","type":"text"},{"text":"will always happen when changing to C major or A minor and need not be specified then. The cancel value","type":"text"},{"text":" ","type":"text"},{"text":"matches the fifths value of the canceled key signature (e.g., a cancel of -2 will provide an explicit","type":"text"},{"text":" ","type":"text"},{"text":"cancellation for changing from B flat major to F major). The optional location attribute indicates where the","type":"text"},{"text":" ","type":"text"},{"text":"cancellation appears relative to the new key signature.","type":"text"}],"navigatorTitle":[{"text":"MXLCancel","kind":"identifier"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCancel"},"doc://IvorMXL/documentation/IvorMXL/MXLFifths":{"title":"MXLFifths","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"MXLFifths","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlfifths","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFifths","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"MXLFifths","kind":"identifier"}],"abstract":[{"type":"text","text":"The fifths type represents the number of flats or sharps in a traditional key signature. Negative numbers are"},{"text":" ","type":"text"},{"type":"text","text":"used for flats and positive numbers for sharps, reflecting the key’s placement within the circle of fifths"},{"type":"text","text":" "},{"text":"(hence the type name).","type":"text"}]}}}