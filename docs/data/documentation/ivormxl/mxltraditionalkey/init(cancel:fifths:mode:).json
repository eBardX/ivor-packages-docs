e the"},{"type":"text","text":" "},{"type":"text","text":"cancellation appears relative to the new key signature."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLCancel"}],"title":"MXLCancel"},"doc://IvorMXL/documentation/IvorMXL/MXLFifths":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlfifths","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFifths","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFifths"}],"abstract":[{"type":"text","text":"The fifths type represents the number of flats or sharps in a traditional key signature. Negative numbers are"},{"type":"text","text":" "},{"type":"text","text":"used for flats and positive numbers for sharps, reflecting the key’s placement within the circle of fifths"},{"type":"text","text":" "},{"type":"text","text":"(hence the type name)."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLFifths"}],"title":"MXLFifths"},"doc://IvorMXL/documentation/IvorMXL/MXLMode":{"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLMode"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMode","kind":"symbol","type":"topic","abstract":[{"text":"The mode type is used to specify major\/minor and other mode distinctions. Valid mode values include major,","type":"text"},{"text":" ","type":"text"},{"text":"minor, dorian, phrygian, lydian, mixolydian, aeolian, ionian, locrian, and none.","type":"text"}],"title":"MXLMode","url":"\/documentation\/ivormxl\/mxlmode","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLMode","kind":"identifier"}]}}}