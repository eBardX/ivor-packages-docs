rMXL\/documentation\/IvorMXL\/MXLFan","title":"MXLFan"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLColor","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","title":"MXLColor","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlcolor"},"doc://IvorMXL/documentation/IvorMXL/MXLBeam":{"title":"MXLBeam","navigatorTitle":[{"text":"MXLBeam","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"Beam values include begin, continue, end, forward hook, and backward hook. Up to eight concurrent beams are","type":"text"},{"text":" ","type":"text"},{"text":"available to cover up to 1024th notes. Each beam in a note is represented with a separate beam element,","type":"text"},{"text":" ","type":"text"},{"text":"starting with the eighth note beam using a number attribute of 1.","type":"text"}],"role":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBeam","url":"\/documentation\/ivormxl\/mxlbeam","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLBeam","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLBeamLevel":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLBeamLevel"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBeamLevel","title":"MXLBeamLevel","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLBeamLevel"}],"abstract":[{"type":"text","text":"The MusicXML format supports six levels of beaming, up to 1024th notes. Unlike the number-level type, the"},{"type":"text","text":" "},{"type":"text","text":"beam-level type identifies concurrent beams in a beam group. It does not distinguish overlapping beams such as"},{"type":"text","text":" "},{"type":"text","text":"grace notes within regular notes, or beams used in different voices."}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlbeamlevel"}}}