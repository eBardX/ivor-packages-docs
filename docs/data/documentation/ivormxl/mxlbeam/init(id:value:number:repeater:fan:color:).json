t":[{"text":"The beam-value type represents the type of beam associated with each of 8 beam levels (up to 1024th notes)","type":"text"},{"text":" ","type":"text"},{"text":"available for each note.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlbeamvalue","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlcolor","title":"MXLColor","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"type":"text","text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is"},{"type":"text","text":" "},{"type":"text","text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor"},"doc://IvorMXL/documentation/IvorMXL/MXLBeamLevel":{"navigatorTitle":[{"text":"MXLBeamLevel","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLBeamLevel","kind":"identifier"}],"abstract":[{"type":"text","text":"The MusicXML format supports six levels of beaming, up to 1024th notes. Unlike the number-level type, the"},{"type":"text","text":" "},{"type":"text","text":"beam-level type identifies concurrent beams in a beam group. It does not distinguish overlapping beams such as"},{"type":"text","text":" "},{"type":"text","text":"grace notes within regular notes, or beams used in different voices."}],"role":"symbol","url":"\/documentation\/ivormxl\/mxlbeamlevel","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBeamLevel","title":"MXLBeamLevel","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLFan":{"abstract":[{"type":"text","text":"The fan type represents the type of beam fanning present on a note, used to represent accelerandos and"},{"type":"text","text":" "},{"type":"text","text":"ritardandos."}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFan"}],"title":"MXLFan","role":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLFan"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlfan","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFan"}}}