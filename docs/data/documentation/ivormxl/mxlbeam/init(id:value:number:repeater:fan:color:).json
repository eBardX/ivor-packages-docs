uch as"},{"type":"text","text":" "},{"type":"text","text":"grace notes within regular notes, or beams used in different voices."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBeamLevel","navigatorTitle":[{"text":"MXLBeamLevel","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLBeam":{"abstract":[{"type":"text","text":"Beam values include begin, continue, end, forward hook, and backward hook. Up to eight concurrent beams are"},{"type":"text","text":" "},{"type":"text","text":"available to cover up to 1024th notes. Each beam in a note is represented with a separate beam element,"},{"type":"text","text":" "},{"type":"text","text":"starting with the eighth note beam using a number attribute of 1."}],"title":"MXLBeam","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLBeam","kind":"identifier"}],"navigatorTitle":[{"text":"MXLBeam","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlbeam","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBeam"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"abstract":[{"text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in","type":"text"},{"type":"text","text":" "},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"title":"MXLColor","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlcolor","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor"},"doc://IvorMXL/documentation/IvorMXL/MXLBeamValue":{"title":"MXLBeamValue","r