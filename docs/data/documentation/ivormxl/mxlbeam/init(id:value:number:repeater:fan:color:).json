t":"available for each note."}],"navigatorTitle":[{"kind":"identifier","text":"MXLBeamValue"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLBeam/init(id:value:number:repeater:fan:color:)":{"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"id"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"value"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL12MXLBeamValueO","kind":"typeIdentifier","text":"MXLBeamValue"},{"kind":"text","text":", "},{"kind":"externalParam","text":"number"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL12MXLBeamLevelV","kind":"typeIdentifier","text":"MXLBeamLevel"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"repeater"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"fan"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL6MXLFanO","kind":"typeIdentifier","text":"MXLFan"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"color"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL8MXLColorV","kind":"typeIdentifier","text":"MXLColor"},{"kind":"text","text":"?)"}],"type":"topic","role":"symbol","title":"init(id:value:number:repeater:fan:color:)","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBeam\/init(id:value:number:repeater:fan:color:)","abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLBeam"},{"type":"text","text":"."}],"url":"\/documentation\/ivormxl\/mxlbeam\/init(id:value:number:repeater:fan:color:)"},"doc://IvorMXL/documentation/IvorMXL/MXLBeam":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlbeam","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBeam","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLBeam","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"Beam values include begin, continue, end, forward hook, and backward hook. Up to eight concurrent beams are","type":"text"},{"text":" ","type":"text"},{"text":"available to cover up to 1024th notes. Each beam in a note is represented with a separate beam element,","type":"text"},{"text":" ","type":"text"},{"text":"starting with the eighth note beam using a number attribute of 1.","type":"text"}],"type":"topic","navigatorTitle":[{"text":"MXLBeam","kind":"identifier"}],"title":"MXLBeam"},"doc://IvorMXL/documentation/IvorMXL/MXLBeamLevel":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLBeamLevel","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"MXLBeamLevel","kind":"identifier"}],"abstract":[{"text":"The MusicXML format supports six levels of beaming, up to 1024th notes. Unlike the number-level type, the","type":"text"},{"text":" ","type":"text"},{"text":"beam-level type identifies concurrent beams in a beam group. It does not distinguish overlapping beams such as","type":"text"},{"text":" ","type":"text"},{"text":"grace notes within regular notes, or beams used in different voices.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlbeamlevel","title":"MXLBeamLevel","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBeamLevel","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"title":"MXLColor","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"abstract":[{"text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in","type":"text"},{"text":" ","type":"text"},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"url":"\/documentation\/ivormxl\/mxlcolor"}}}