{"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"number"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBeamLevel","text":"MXLBeamLevel","preciseIdentifier":"s:7IvorMXL12MXLBeamLevelV"}],"platforms":["macOS"]}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"inlineContent":[{"text":"Maps to the MusicXML ","type":"text"},{"type":"codeVoice","code":"number"},{"text":" attribute.","type":"text"}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBeam"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBeam\/number"},"abstract":[{"type":"text","text":"Defaults to "},{"type":"codeVoice","code":"1"},{"type":"text","text":"."}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlbeam\/number"]}],"metadata":{"roleHeading":"Instance Property","externalID":"s:7IvorMXL7MXLBeamV6numberAA0C5LevelVvp","role":"symbol","title":"number","modules":[{"name":"IvorMXL"}],"symbolKind":"property","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"number"},{"text":": ","kind":"text"},{"text":"MXLBeamLevel","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL12MXLBeamLevelV"}]},"references":{"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLBeam/number":{"url":"\/documentation\/ivormxl\/mxlbeam\/number","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBeam\/number","abstract":[{"text":"Defaults to ","type":"text"},{"code":"1","type":"codeVoice"},{"text":".","type":"text"}],"kind":"symbol","title":"number","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"number"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL12MXLBeamLevelV","kind":"typeIdentifier","text":"MXLBeamLevel"}]},"doc://IvorMXL/documentation/IvorMXL/MXLBeam":{"kind":"symbol","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBeam","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLBeam","kind":"identifier"}],"type":"topic","abstract":[{"text":"Beam values include begin, continue, end, forward hook, and backward hook. Up to eight concurrent beams are","type":"text"},{"text":" ","type":"text"},{"text":"available to cover up to 1024th notes. Each beam in a note is represented with a separate beam element,","type":"text"},{"text":" ","type":"text"},{"text":"starting with the eighth note beam using a number attribute of 1.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlbeam","navigatorTitle":[{"kind":"identifier","text":"MXLBeam"}],"title":"MXLBeam"},"doc://IvorMXL/documentation/IvorMXL/MXLBeamLevel":{"navigatorTitle":[{"text":"MXLBeamLevel","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLBeamLevel","kind":"identifier"}],"abstract":[{"type":"text","text":"The MusicXML format supports six levels of beaming, up to 1024th notes. Unlike the number-level type, the"},{"type":"text","text":" "},{"type":"text","text":"beam-level type identifies concurrent beams in a beam group. It does not distinguish overlapping beams such as"},{"type":"text","text":" "},{"type":"text","text":"grace notes within regular notes, or beams used in different voices."}],"role":"symbol","url":"\/documentation\/ivormxl\/mxlbeamlevel","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBeamLevel","title":"MXLBeamLevel","kind":"symbol"}}}