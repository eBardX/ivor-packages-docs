{"kind":"text","text":"?"}]},"doc://IvorMXL/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","type":"unresolvable","identifier":"doc:\/\/IvorMXL\/s16SendableMetatypeP"},"doc://IvorMXL/s9EscapableP":{"title":"Swift.Escapable","type":"unresolvable","identifier":"doc:\/\/IvorMXL\/s9EscapableP"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/SH":{"title":"Swift.Hashable","type":"unresolvable","identifier":"doc:\/\/IvorMXL\/SH"},"doc://IvorMXL/s8CopyableP":{"title":"Swift.Copyable","type":"unresolvable","identifier":"doc:\/\/IvorMXL\/s8CopyableP"},"doc://IvorMXL/documentation/IvorMXL/MXLPrint/Attributes-swift.struct":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Attributes","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint\/Attributes-swift.struct","title":"MXLPrint.Attributes","kind":"symbol","navigatorTitle":[{"text":"Attributes","kind":"identifier"}],"abstract":[{"type":"text","text":"The print-attributes group is used by the print element. The new-system and new-page attributes indicate"},{"type":"text","text":" "},{"type":"text","text":"whether to force a system or page break, or to force the current music onto the same system or page as the"},{"type":"text","text":" "},{"type":"text","text":"preceding music. Normally this is the first music data within a measure. If used in multi-part music, they"},{"type":"text","text":" "},{"type":"text","text":"should be placed in the same positions within each part, or the results are undefined. The page-number"},{"type":"text","text":" "},{"type":"text","text":"attribute sets the number of a new page; it is ignored if new-page is not “yes”. Version 2.0 adds a blank-page"},{"type":"text","text":" "},{"type":"text","text":"attribute. This is a positive integer value that specifies the number of blank pages to insert before the"},{"type":"text","text":" "},{"type":"text","text":"current measure. It is ignored if new-page is not “yes”. These blank pages have no music, but may have text or"},{"type":"text","text":" "},{"type":"text","text":"images specified by the credit element. This is used to allow a combination of pages that are all text, or all"},{"type":"text","text":" "},{"type":"text","text":"text and images, together with pages of music."}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlprint\/attributes-swift.struct"},"doc://IvorMXL/documentation/IvorMXL/MXLPrint":{"role":"symbol","abstract":[{"type":"text","text":"The print type contains general printing parameters, including layout elements. The part-name-display and"},{"type":"text","text":" "},{"type":"text","text":"part-abbreviation-display elements may also be used here to change how a part name or abbreviation is"},{"type":"text","text":" "},{"type":"text","text":"displayed over the course of a piece. They take effect when the current measure or a succeeding measure starts"},{"type":"text","text":" "},{"type":"text","text":"a new system."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint","url":"\/documentation\/ivormxl\/mxlprint","title":"MXLPrint","navigatorTitle":[{"kind":"identifier","text":"MXLPrint"}],"kind":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPrint","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLPrint/attributes-swift.property":{"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"attributes"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Attributes","preciseIdentifier":"s:7IvorMXL8MXLPrintV10AttributesV"}],"title":"attributes","kind":"symbol","url":"\/documentation\/ivormxl\/mxlprint\/attributes-swift.property","abstract":[{"type":"text","text":"The print-attributes group is used by the print element. The new-system and new-page attributes indicate"},{"type":"text","text":" "},{"type":"text","text":"whether to force a system or page break, or to force the current music onto the same system or page as the"},{"type":"text","text":" "},{"type":"text","text":"preceding music. Normally this is the first music data within a measure. If used in multi-part music, they"},{"type":"text","text":" "},{"type":"text","text":"should be placed in the same positions within each part, or the results are undefined. The page-number"},{"type":"text","text":" "},{"type":"text","text":"attribute sets the number of a new page; it is ignored if new-page is not “yes”. Version 2.0 adds a blank-page"},{"type":"text","text":" "},{"type":"text","text":"attribute. This is a positive integer value that specifies the number of blank pages to insert before the"},{"type":"text","text":" "},{"type":"text","text":"current measure. It is ignored if new-page is not “yes”. These blank pages have no music, but may have text or"},{"type":"text","text":" "},{"type":"text","text":"images specified by the credit element. This is used to allow a combination of pages that are all text, or all"},{"type":"text","text":" "},{"type":"text","text":"text and images, together with pages of music."}],"type":"topic","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint\/attributes-swift.property"},"doc://IvorMXL/documentation/IvorMXL/MXLPrint/layout":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"layout","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLLayout","preciseIdentifier":"s:7IvorMXL9MXLLayoutV","kind":"typeIdentifier"}],"title":"layout","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint\/layout","type":"topic","abstract":[{"type":"text","text":"The layout group specifies the sequence of page, system, and staff layout elements that is common to both the"},{"type":"text","text":" "},{"type":"text","text":"defaults and print elements."}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlprint\/layout"}}}