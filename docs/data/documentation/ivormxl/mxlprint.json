t":"MXLNameDisplay","preciseIdentifier":"s:7IvorMXL14MXLNameDisplayV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"kind":"symbol","title":"partNameDisplay","url":"\/documentation\/ivormxl\/mxlprint\/partnamedisplay","type":"topic","role":"symbol","abstract":[{"text":"Changes how the part name is displayed, taking effect when the current measure or a succeeding measure","type":"text"},{"text":" ","type":"text"},{"text":"starts a new system.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLPrint/partAbbreviationDisplay":{"abstract":[{"type":"text","text":"Changes how the part abbreviation is displayed, taking effect when the current measure or a succeeding"},{"type":"text","text":" "},{"type":"text","text":"measure starts a new system."}],"role":"symbol","title":"partAbbreviationDisplay","kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxlprint\/partabbreviationdisplay","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint\/partAbbreviationDisplay","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"partAbbreviationDisplay","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL14MXLNameDisplayV","text":"MXLNameDisplay","kind":"typeIdentifier"},{"text":"?","kind":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLPrint/attributes-swift.property":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint\/attributes-swift.property","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"attributes","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Attributes","preciseIdentifier":"s:7IvorMXL8MXLPrintV10AttributesV","kind":"typeIdentifier"}],"kind":"symbol","title":"attributes","url":"\/documentation\/ivormxl\/mxlprint\/attributes-swift.property","type":"topic","role":"symbol","abstract":[{"text":"The print-attributes group is used by the print element. The new-system and new-page attributes indicate","type":"text"},{"text":" ","type":"text"},{"text":"whether to force a system or page break, or to force the current music onto the same system or page as the","type":"text"},{"text":" ","type":"text"},{"text":"preceding music. Normally this is the first music data within a measure. If used in multi-part music, they","type":"text"},{"text":" ","type":"text"},{"text":"should be placed in the same positions within each part, or the results are undefined. The page-number","type":"text"},{"text":" ","type":"text"},{"text":"attribute sets the number of a new page; it is ignored if new-page is not “yes”. Version 2.0 adds a blank-page","type":"text"},{"text":" ","type":"text"},{"text":"attribute. This is a positive integer value that specifies the number of blank pages to insert before the","type":"text"},{"text":" ","type":"text"},{"text":"current measure. It is ignored if new-page is not “yes”. These blank pages have no music, but may have text or","type":"text"},{"text":" ","type":"text"},{"text":"images specified by the credit element. This is used to allow a combination of pages that are all text, or all","type":"text"},{"text":" ","type":"text"},{"text":"text and images, together with pages of music.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLPrint/id":{"abstract":[{"type":"text","text":"The optional-unique-id attribute group allows an element to optionally specify an ID that is unique to the"},{"type":"text","text":" "},{"type":"text","text":"entire document. This attribute group is not used for a required id attribute, or for an id attribute that"},{"type":"text","text":" "},{"type":"text","text":"specifies an id reference."}],"kind":"symbol","title":"id","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint\/id","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"id","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?","kind":"text"}],"role":"symbol","url":"\/documentation\/ivormxl\/mxlprint\/id"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLPrint/Attributes-swift.struct":{"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Attributes"}],"type":"topic","title":"MXLPrint.Attributes","navigatorTitle":[{"kind":"identifier","text":"Attributes"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint\/Attributes-swift.struct","url":"\/documentation\/ivormxl\/mxlprint\/attributes-swift.struct","abstract":[{"type":"text","text":"The print-attributes group is used by the print element. The new-system and new-page attributes indicate"},{"type":"text","text":" "},{"type":"text","text":"whether to force a system or page break, or to force the current music onto the same system or page as the"},{"type":"text","text":" "},{"type":"text","text":"preceding music. Normally this is the first music data within a measure. If used in multi-part music, they"},{"type":"text","text":" "},{"type":"text","text":"should be placed in the same positions within each part, or the results are undefined. The page-number"},{"type":"text","text":" "},{"type":"text","text":"attribute sets the number of a new page; it is ignored if new-page is not “yes”. Version 2.0 adds a blank-page"},{"type":"text","text":" "},{"type":"text","text":"attribute. This is a positive integer value that specifies the number of blank pages to insert before the"},{"type":"text","text":" "},{"type":"text","text":"current measure. It is ignored if new-page is not “yes”. These blank pages have no music, but may have text or"},{"type":"text","text":" "},{"type":"text","text":"images specified by the credit element. This is used to allow a combination of pages that are all text, or all"},{"type":"text","text":" "},{"type":"text","text":"text and images, together with pages of music."}],"kind":"symbol"}}}