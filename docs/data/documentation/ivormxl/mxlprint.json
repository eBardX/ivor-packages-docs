":0,"major":0,"minor":3},"sections":[],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPrint","kind":"identifier"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"anchor":"overview","text":"Overview","type":"heading"},{"inlineContent":[{"text":"Layout group elements in a print element only apply to the current page, system, or staff. Music that follows","type":"text"},{"type":"text","text":" "},{"type":"text","text":"continues to take the default values from the layout determined by the defaults element."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Maps the MusicXML "},{"type":"codeVoice","code":"<print>"},{"type":"text","text":" element."}],"type":"paragraph"}]}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint","interfaceLanguage":"swift"},"abstract":[{"text":"The print type contains general printing parameters, including layout elements. The part-name-display and","type":"text"},{"text":" ","type":"text"},{"text":"part-abbreviation-display elements may also be used here to change how a part name or abbreviation is","type":"text"},{"text":" ","type":"text"},{"text":"displayed over the course of a piece. They take effect when the current measure or a succeeding measure starts","type":"text"},{"text":" ","type":"text"},{"text":"a new system.","type":"text"}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLPrint":{"abstract":[{"type":"text","text":"The print type contains general printing parameters, including layout elements. The part-name-display and"},{"type":"text","text":" "},{"type":"text","text":"part-abbreviation-display elements may also be used here to change how a part name or abbreviation is"},{"type":"text","text":" "},{"type":"text","text":"displayed over the course of a piece. They take effect when the current measure or a succeeding measure starts"},{"type":"text",