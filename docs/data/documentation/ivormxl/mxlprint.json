ew-page attributes indicate","type":"text"},{"text":" ","type":"text"},{"text":"whether to force a system or page break, or to force the current music onto the same system or page as the","type":"text"},{"text":" ","type":"text"},{"text":"preceding music. Normally this is the first music data within a measure. If used in multi-part music, they","type":"text"},{"text":" ","type":"text"},{"text":"should be placed in the same positions within each part, or the results are undefined. The page-number","type":"text"},{"text":" ","type":"text"},{"text":"attribute sets the number of a new page; it is ignored if new-page is not “yes”. Version 2.0 adds a blank-page","type":"text"},{"text":" ","type":"text"},{"text":"attribute. This is a positive integer value that specifies the number of blank pages to insert before the","type":"text"},{"text":" ","type":"text"},{"text":"current measure. It is ignored if new-page is not “yes”. These blank pages have no music, but may have text or","type":"text"},{"text":" ","type":"text"},{"text":"images specified by the credit element. This is used to allow a combination of pages that are all text, or all","type":"text"},{"text":" ","type":"text"},{"text":"text and images, together with pages of music.","type":"text"}]},"doc://IvorMXL/SQ":{"title":"Swift.Equatable","type":"unresolvable","identifier":"doc:\/\/IvorMXL\/SQ"},"doc://IvorMXL/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","type":"unresolvable","identifier":"doc:\/\/IvorMXL\/s16SendableMetatypeP"},"doc://IvorMXL/SH":{"title":"Swift.Hashable","type":"unresolvable","identifier":"doc:\/\/IvorMXL\/SH"},"doc://IvorMXL/s8SendableP":{"title":"Swift.Sendable","type":"unresolvable","identifier":"doc:\/\/IvorMXL\/s8SendableP"},"doc://IvorMXL/documentation/IvorMXL/MXLPrint/measureNumbering":{"kind":"symbol","url":"\/documentation\/ivormxl\/mxlprint\/measurenumbering","title":"measureNumbering","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"k