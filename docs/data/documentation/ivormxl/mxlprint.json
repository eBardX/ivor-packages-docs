r an id attribute that","type":"text"},{"text":" ","type":"text"},{"text":"specifies an id reference.","type":"text"}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"id"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint\/id","title":"id","url":"\/documentation\/ivormxl\/mxlprint\/id","type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLPrint/partNameDisplay":{"url":"\/documentation\/ivormxl\/mxlprint\/partnamedisplay","abstract":[{"type":"text","text":"Changes how the part name is displayed, taking effect when the current measure or a succeeding measure"},{"type":"text","text":" "},{"type":"text","text":"starts a new system."}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"partNameDisplay","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLNameDisplay","preciseIdentifier":"s:7IvorMXL14MXLNameDisplayV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"kind":"symbol","role":"symbol","title":"partNameDisplay","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint\/partNameDisplay"},"doc://IvorMXL/s8CopyableP":{"type":"unresolvable","title":"Swift.Copyable","identifier":"doc:\/\/IvorMXL\/s8CopyableP"},"doc://IvorMXL/s16SendableMetatypeP":{"type":"unresolvable","title":"Swift.SendableMetatype","identifier":"doc:\/\/IvorMXL\/s16SendableMetatypeP"},"doc://IvorMXL/documentation/IvorMXL/MXLPrint/layout":{"type":"topic","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"layout"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLLayout","preciseIdentifier":"s:7IvorMXL9MXLLayoutV"}],"url":"\/documentation\/ivormxl\/mxlprint\/layout","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint\/layout","abstract":[{"type":"text","text":"The layout group specifies the sequence of page, system, and staff layout elements that is common to both the"},{"type":"text","text":" "},{"type":"text","text":"defaults and print elements."}],"title":"layout","role":"symbol","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLPrint":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPrint","kind":"identifier"}],"navigatorTitle":[{"text":"MXLPrint","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint","kind":"symbol","role":"symbol","title":"MXLPrint","abstract":[{"text":"The print type contains general printing parameters, including layout elements. The part-name-display and","type":"text"},{"text":" ","type":"text"},{"text":"part-abbreviation-display elements may also be used here to change how a part name or abbreviation is","type":"text"},{"text":" ","type":"text"},{"text":"displayed over the course of a piece. They take effect when the current measure or a succeeding measure starts","type":"text"},{"text":" ","type":"text"},{"text":"a new system.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlprint"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/s9EscapableP":{"type":"unresolvable","title":"Swift.Escapable","identifier":"doc:\/\/IvorMXL\/s9EscapableP"},"doc://IvorMXL/documentation/IvorMXL/MXLPrint/Equatable-Implementations":{"type":"topic","url":"\/documentation\/ivormxl\/mxlprint\/equatable-implementations","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint\/Equatable-Implementations","abstract":[],"title":"Equatable Implementations","role":"collectionGroup","kind":"article"},"doc://IvorMXL/documentation/IvorMXL/MXLPrint/Attributes-swift.struct":{"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint\/Attributes-swift.struct","url":"\/documentation\/ivormxl\/mxlprint\/attributes-swift.struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Attributes"}],"abstract":[{"type":"text","text":"The print-attributes group is used by the print element. The new-system and new-page attributes indicate"},{"type":"text","text":" "},{"type":"text","text":"whether to force a system or page break, or to force the current music onto the same system or page as the"},{"type":"text","text":" "},{"type":"text","text":"preceding music. Normally this is the first music data within a measure. If used in multi-part music, they"},{"type":"text","text":" "},{"type":"text","text":"should be placed in the same positions within each part, or the results are undefined. The page-number"},{"type":"text","text":" "},{"type":"text","text":"attribute sets the number of a new page; it is ignored if new-page is not “yes”. Version 2.0 adds a blank-page"},{"type":"text","text":" "},{"type":"text","text":"attribute. This is a positive integer value that specifies the number of blank pages to insert before the"},{"type":"text","text":" "},{"type":"text","text":"current measure. It is ignored if new-page is not “yes”. These blank pages have no music, but may have text or"},{"type":"text","text":" "},{"type":"text","text":"images specified by the credit element. This is used to allow a combination of pages that are all text, or all"},{"type":"text","text":" "},{"type":"text","text":"text and images, together with pages of music."}],"kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Attributes"}],"title":"MXLPrint.Attributes"},"doc://IvorMXL/documentation/IvorMXL/MXLPrint/measureLayout":{"url":"\/documentation\/ivormxl\/mxlprint\/measurelayout","type":"topic","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint\/measureLayout","title":"measureLayout","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"measureLayout","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL16MXLMeasureLayoutV","text":"MXLMeasureLayout","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"abstract":[{"text":"Specifies the horizontal distance from the previous measure, in tenths.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLPrint/partAbbreviationDisplay":{"type":"topic","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"partAbbreviationDisplay"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLNameDisplay","preciseIdentifier":"s:7IvorMXL14MXLNameDisplayV"},{"kind":"text","text":"?"}],"url":"\/documentation\/ivormxl\/mxlprint\/partabbreviationdisplay","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint\/partAbbreviationDisplay","abstract":[{"type":"text","text":"Changes how the part abbreviation is displayed, taking effect when the current measure or a succeeding"},{"type":"text","text":" "},{"type":"text","text":"measure starts a new system."}],"title":"partAbbreviationDisplay","role":"symbol","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLPrint/measureNumbering":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"measureNumbering","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLMeasureNumbering","preciseIdentifier":"s:7IvorMXL19MXLMeasureNumberingV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrint\/measureNumbering","kind":"symbol","role":"symbol","title":"measureNumbering","abstract":[{"text":"Specifies details about measure numbering displayed at this point in the score.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlprint\/measurenumbering"},"doc://IvorMXL/SQ":{"type":"unresolva