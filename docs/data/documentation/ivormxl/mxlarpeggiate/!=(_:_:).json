ic","title":"MXLArpeggiate","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLArpeggiate","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlarpeggiate","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArpeggiate","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"MXLArpeggiate","kind":"identifier"}],"abstract":[{"type":"text","text":"The arpeggiate type indicates that this note is part of an arpeggiated chord. The number attribute can be used"},{"type":"text","text":" "},{"type":"text","text":"to distinguish between two simultaneous chords arpeggiated separately (different numbers) or together (same"},{"type":"text","text":" "},{"type":"text","text":"number). The direction attribute is used if there is an arrow on the arpeggio sign. By default, arpeggios go"},{"type":"text","text":" "},{"type":"text","text":"from the lowest to highest note. The length of the sign can be determined from the position attributes for the"},{"type":"text","text":" "},{"type":"text","text":"arpeggiate elements used with the top and bottom notes of the arpeggiated chord. If the unbroken attribute is"},{"type":"text","text":" "},{"type":"text","text":"set to yes, it indicates that the arpeggio continues onto another staff within the part. This serves as a hint"},{"type":"text","text":" "},{"type":"text","text":"to applications and is not required for cross-staff arpeggios."}]},"doc://IvorMXL/documentation/IvorMXL/MXLArpeggiate/!=(_:_:)":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArpeggiate\/!=(_:_:)","type":"topic","abstract":[],"url":"\/documentation\/ivormxl\/mxlarpeggiate\/!=(_:_:)","role":"symbol","title":"!=(_:_:)","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"!=","kind":"identifier"},{"text":" ","kind":"text"},{"text":"(","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":