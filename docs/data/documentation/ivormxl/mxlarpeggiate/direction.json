fier"}],"abstract":[{"text":"The up-down type is used for the direction of arrows and other pointed symbols like vertical accents,","type":"text"},{"text":" ","type":"text"},{"text":"indicating which way the tip is pointing.","type":"text"}],"kind":"symbol","type":"topic","navigatorTitle":[{"text":"MXLUpDown","kind":"identifier"}],"title":"MXLUpDown"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLArpeggiate":{"url":"\/documentation\/ivormxl\/mxlarpeggiate","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArpeggiate","abstract":[{"type":"text","text":"The arpeggiate type indicates that this note is part of an arpeggiated chord. The number attribute can be used"},{"type":"text","text":" "},{"type":"text","text":"to distinguish between two simultaneous chords arpeggiated separately (different numbers) or together (same"},{"type":"text","text":" "},{"type":"text","text":"number). The direction attribute is used if there is an arrow on the arpeggio sign. By default, arpeggios go"},{"type":"text","text":" "},{"type":"text","text":"from the lowest to highest note. The length of the sign can be determined from the position attributes for the"},{"type":"text","text":" "},{"type":"text","text":"arpeggiate elements used with the top and bottom notes of the arpeggiated chord. If the unbroken attribute is"},{"type":"text","text":" "},{"type":"text","text":"set to yes, it indicates that the arpeggio continues onto another staff within the part. This serves as a hint"},{"type":"text","text":" "},{"type":"text","text":"to applications and is not required for cross-staff arpeggios."}],"title":"MXLArpeggiate","kind":"symbol","role":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLArpeggiate","kind":"identifier"}],"navigatorTitle":[{"text":"MXLArpeggiate","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLArpeggiate/direction":{"type":"topic","title":"direction","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"direction","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLUpDown","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLUpDownO"},{"text":"?","kind":"text"}],"abstract":[{"type":"text","text":"The direction of the arrow on the arpeggio sign, if present."}],"url":"\/documentation\/ivormxl\/mxlarpeggiate\/direction","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArpeggiate\/direction","kind":"symbol","role":"symbol"}}}