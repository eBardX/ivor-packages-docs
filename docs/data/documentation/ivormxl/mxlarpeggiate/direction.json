/IvorMXL\/documentation\/IvorMXL\/MXLArpeggiate","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"MXLArpeggiate","kind":"identifier"}],"abstract":[{"type":"text","text":"The arpeggiate type indicates that this note is part of an arpeggiated chord. The number attribute can be used"},{"type":"text","text":" "},{"type":"text","text":"to distinguish between two simultaneous chords arpeggiated separately (different numbers) or together (same"},{"type":"text","text":" "},{"type":"text","text":"number). The direction attribute is used if there is an arrow on the arpeggio sign. By default, arpeggios go"},{"type":"text","text":" "},{"type":"text","text":"from the lowest to highest note. The length of the sign can be determined from the position attributes for the"},{"type":"text","text":" "},{"type":"text","text":"arpeggiate elements used with the top and bottom notes of the arpeggiated chord. If the unbroken attribute is"},{"type":"text","text":" "},{"type":"text","text":"set to yes, it indicates that the arpeggio continues onto another staff within the part. This serves as a hint"},{"type":"text","text":" "},{"type":"text","text":"to applications and is not required for cross-staff arpeggios."}]},"doc://IvorMXL/documentation/IvorMXL/MXLArpeggiate/direction":{"abstract":[{"type":"text","text":"The direction of the arrow on the arpeggio sign, if present."}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"direction"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLUpDown","preciseIdentifier":"s:7IvorMXL9MXLUpDownO"},{"kind":"text","text":"?"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlarpeggiate\/direction","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArpeggiate\/direction","type":"topic","role":"symbol","title":"direction"},"doc://IvorMXL/documentation/IvorMXL/MXLUpDown":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlupdown","title":"MXLUpDown","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLUpDown"}],"navigatorTitle":[{"kind":"identifier","text":"MXLUpDown"}],"abstract":[{"type":"text","text":"The up-down type is used for the direction of arrows and other pointed symbols like vertical accents,"},{"type":"text","text":" "},{"type":"text","text":"indicating which way the tip is pointing."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLUpDown"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]}}}