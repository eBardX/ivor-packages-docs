kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLArpeggiate"}],"title":"MXLArpeggiate","abstract":[{"text":"The arpeggiate type indicates that this note is part of an arpeggiated chord. The number attribute can be used","type":"text"},{"text":" ","type":"text"},{"text":"to distinguish between two simultaneous chords arpeggiated separately (different numbers) or together (same","type":"text"},{"text":" ","type":"text"},{"text":"number). The direction attribute is used if there is an arrow on the arpeggio sign. By default, arpeggios go","type":"text"},{"text":" ","type":"text"},{"text":"from the lowest to highest note. The length of the sign can be determined from the position attributes for the","type":"text"},{"text":" ","type":"text"},{"text":"arpeggiate elements used with the top and bottom notes of the arpeggiated chord. If the unbroken attribute is","type":"text"},{"text":" ","type":"text"},{"text":"set to yes, it indicates that the arpeggio continues onto another staff within the part. This serves as a hint","type":"text"},{"text":" ","type":"text"},{"text":"to applications and is not required for cross-staff arpeggios.","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLArpeggiate/direction":{"role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"direction"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL9MXLUpDownO","kind":"typeIdentifier","text":"MXLUpDown"},{"kind":"text","text":"?"}],"type":"topic","title":"direction","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArpeggiate\/direction","url":"\/documentation\/ivormxl\/mxlarpeggiate\/direction","abstract":[{"type":"text","text":"The direction of the arrow on the arpeggio sign, if present."}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLUpDown":{"type":"topic","abstract":[{"type":"text","text":"The up-down type is used for the direction of arrows and other pointed symbols like vertical accents,"},{"type":"text","text":" "},{"type":"text","text":"indicating which way the tip is pointing."}],"url":"\/documentation\/ivormxl\/mxlupdown","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLUpDown"}],"kind":"symbol","title":"MXLUpDown","navigatorTitle":[{"kind":"identifier","text":"MXLUpDown"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLUpDown","role":"symbol"}}}