nd":"parameters","parameters":[{"content":[{"inlineContent":[{"text":"The optional-unique-id attribute group allows an element to optionally specify an ID","type":"text"},{"text":" ","type":"text"},{"text":"that is unique to the entire document. This attribute group is not used for a required","type":"text"},{"text":" ","type":"text"},{"text":"id attribute, or for an id attribute that specifies an id reference.","type":"text"}],"type":"paragraph"}],"name":"id"},{"content":[{"inlineContent":[{"text":"Distinguishes between two simultaneous chords arpeggiated separately (different","type":"text"},{"text":" ","type":"text"},{"text":"numbers) or together (same number).","type":"text"}],"type":"paragraph"}],"name":"number"},{"content":[{"inlineContent":[{"text":"The direction of the arrow on the arpeggio sign, if present.","type":"text"}],"type":"paragraph"}],"name":"direction"},{"content":[{"inlineContent":[{"text":"A Boolean value indicating whether the arpeggio continues onto another staff within the","type":"text"},{"text":" ","type":"text"},{"text":"part.","type":"text"}],"type":"paragraph"}],"name":"isUnbroken"},{"content":[{"inlineContent":[{"text":"For most elements, any program will compute a default x and y position. The position","type":"text"},{"text":" ","type":"text"},{"text":"attributes let this be changed two ways.","type":"text"}],"type":"paragraph"}],"name":"position"},{"content":[{"inlineContent":[{"text":"The placement attribute indicates whether something is above or below another element,","type":"text"},{"text":" ","type":"text"},{"text":"such as a note or a notation.","type":"text"}],"type":"paragraph"}],"name":"placement"},{"content":[{"inlineContent":[{"text":"The color attribute group indicates the color of an element.","type":"text"}],"type":"paragraph"}],"name":"color"}]}],"kind":"symbol","sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArpeggiate\/init(id:number:direction:isUnbroken:po