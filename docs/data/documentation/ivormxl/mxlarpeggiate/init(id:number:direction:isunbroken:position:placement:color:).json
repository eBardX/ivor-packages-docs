lineContent":[{"type":"text","text":"The optional-unique-id attribute group allows an element to optionally specify an ID that is unique to the entire document. This attribute group is not used for a required id attribute, or for an id attribute that specifies an id reference."}],"type":"paragraph"}]},{"name":"number","content":[{"inlineContent":[{"type":"text","text":"Distinguishes between two simultaneous chords arpeggiated separately (different numbers) or together (same number)."}],"type":"paragraph"}]},{"name":"direction","content":[{"inlineContent":[{"type":"text","text":"The direction of the arrow on the arpeggio sign, if present."}],"type":"paragraph"}]},{"name":"isUnbroken","content":[{"inlineContent":[{"type":"text","text":"A Boolean value indicating whether the arpeggio continues onto another staff within the part."}],"type":"paragraph"}]},{"name":"position","content":[{"inlineContent":[{"type":"text","text":"For most elements, any program will compute a default x and y position. The position attributes let this be changed two ways."}],"type":"paragraph"}]},{"name":"placement","content":[{"inlineContent":[{"type":"text","text":"The placement attribute indicates whether something is above or below another element, such as a note or a notation."}],"type":"paragraph"}]},{"name":"color","content":[{"inlineContent":[{"type":"text","text":"The color attribute group indicates the color of an element."}],"type":"paragraph"}]}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArpeggiate"]]},"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArpeggiate\/init(id:number:direction:isUnbroken:position:placement:color:)","interfaceLanguage":"swift"},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"abstract":[{"text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in","type":"text"},{"type":"text","text":" "},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"title":"MXLColor","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlcolor","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor"},"doc://IvorMXL/documentation/IvorMXL/MXLArpeggiate/init(id:number:direction:isUnbroken:position:placement:color:)":{"abstract":[{"text":"Creates a new ","type":"text"},{"code":"MXLArpeggiate","type":"codeVoice"},{"text":".","type":"text"}],"title":"init(id:number:direction:isUnbroken:position:placement:color:)","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArpeggiate\/init(id:number:direction:isUnbroken:position:placement:color:)","kind":"symbol","url":"\/documentation\/ivormxl\/mxlarpeggiate\/init(id:number:direction:isunbroken:position:placement:color:)","type":"topic","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"id"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"number"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL14MXLNumberLevelV","kind":"typeIdentifier","text":"MXLNumberLevel"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"direction"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL9MXLUpDownO","kind":"typeIdentifier","text":"MXLUpDown"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"isUnbroken"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"position"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL11MXLPositionV","kind":"typeIdentifier","text":"MXLPosition"},{"kind":"text","text":", "},{"kind":"externalParam","text":"placement"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL13MXLAboveBelowO","kind":"typeIdentifier","text":"MXLAboveBelow"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"color"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL8MXLColorV","kind":"typeIdentifier","text":"MXLColor"},{"kind":"text","text":"?)"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNumberLevel":{"title":"MXLNumberLevel","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNumberLevel"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlnumberlevel","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumberLevel","abstract":[{"text":"Slurs, tuplets, and many other features can be concurrent and overlap within a single musical part. The","type":"text"},{"text":" ","type":"text"},{"text":"number-level entity distinguishes up to 16 concurrent objects of the same type when the objects overlap in","type":"text"},{"text":" ","type":"text"},{"text":"MusicXML document order. Values greater than 6 are usually only needed for music with a large number of divisi","type":"text"},{"text":" ","type":"text"},{"text":"staves in a single part, or if there are more than 6 cross-staff arpeggios in a single measure. When a number-","type":"text"},{"text":" ","type":"text"},{"text":"level value is implied, the value is 1 by default.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"MXLNumberLevel"}]},"doc://IvorMXL/documentation/IvorMXL/MXLArpeggiate":{"title":"MXLArpeggiate","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLArpeggiate"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlarpeggiate","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArpeggiate","abstract":[{"text":"The arpeggiate type indicates that this note is part of an arpeggiated chord. The number attribute can be used","type":"text"},{"text":" ","type":"text"},{"text":"to distinguish between two simultaneous chords arpeggiated separately (different numbers) or together (same","type":"text"},{"text":" ","type":"text"},{"text":"number). The direction attribute is used if there is an arrow on the arpeggio sign. By default, arpeggios go","type":"text"},{"text":" ","type":"text"},{"text":"from the lowest to highest note. The length of the sign can be determined from the position attributes for the","type":"text"},{"text":" ","type":"text"},{"text":"arpeggiate elements used with the top and bottom notes of the arpeggiated chord. If the unbroken attribute is","type":"text"},{"text":" ","type":"text"},{"text":"set to yes, it indicates that the arpeggio continues onto another staff within the part. This serves as a hint","type":"text"},{"text":" ","type":"text"},{"text":"to applications and is not required for cross-staff arpeggios.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"MXLArpeggiate"}]},"doc://IvorMXL/documentation/IvorMXL/MXLAboveBelow":{"title":"MXLAboveBelow","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLAboveBelow"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlabovebelow","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAboveBelow","abstract":[{"text":"The above-below type is used to indicate whether one element appears above or below another element.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"MXLAboveBelow"}]},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLPosition":{"title":"MXLPosition","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPosition"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlposition","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","abstract":[{"text":"For most elements, any program will compute a default x and y position. The position attributes let this be","type":"text"},{"text":" ","type":"text"},{"text":"changed two ways.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"MXLPosition"}]},"doc://IvorMXL/documentation/IvorMXL/MXLUpDown":{"title":"MXLUpDown","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLUpDown"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlupdown","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLUpDown","abstract":[{"text":"The up-down type is used for the direction of arrows and other pointed symbols like vertical accents,","type":"text"},{"text":" ","type":"text"},{"text":"indicating which way the tip is pointing.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"MXLUpDown"}]}}}