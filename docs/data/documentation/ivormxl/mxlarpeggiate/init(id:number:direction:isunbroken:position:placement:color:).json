XLAboveBelow","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLAboveBelow"}],"kind":"symbol","abstract":[{"text":"The above-below type is used to indicate whether one element appears above or below another element.","type":"text"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLAboveBelow"}],"title":"MXLAboveBelow"},"doc://IvorMXL/documentation/IvorMXL/MXLUpDown":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlupdown","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLUpDown","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLUpDown","kind":"identifier"}],"abstract":[{"text":"The up-down type is used for the direction of arrows and other pointed symbols like vertical accents,","type":"text"},{"text":" ","type":"text"},{"text":"indicating which way the tip is pointing.","type":"text"}],"kind":"symbol","type":"topic","navigatorTitle":[{"text":"MXLUpDown","kind":"identifier"}],"title":"MXLUpDown"},"doc://IvorMXL/documentation/IvorMXL/MXLPosition":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlposition","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPosition"}],"kind":"symbol","abstract":[{"text":"For most elements, any program will compute a default x and y position. The position attributes let this be","type":"text"},{"text":" ","type":"text"},{"text":"changed two ways.","type":"text"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLPosition"}],"title":"MXLPosition"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLArpeggiate/init(id:number:direction:isUnbroken:position:placement:color:)":{"abstract":[{"text":"Creates a new ","type":"text"},{"code":"MXLArpeggiate","type":"codeVoice"},{"text":".","type":"text"}],"url":"\/documentation\/ivormxl\/mxlarpeggiate\/init(id:number:direction:isunbroken:position:placement:color:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"id"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"text":"?, ","kind":"text"},{"text":"number","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLNumberLevel","preciseIdentifier":"s:7IvorMXL14MXLNumberLevelV","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"direction","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLUpDown","preciseIdentifier":"s:7IvorMXL9MXLUpDownO","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"isUnbroken","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"position","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLPosition","preciseIdentifier":"s:7IvorMXL11MXLPositionV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"placement","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLAboveBelow","preciseIdentifier":"s:7IvorMXL13MXLAboveBelowO","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"color","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLColor","preciseIdentifier":"s:7IvorMXL8MXLColorV","kind":"typeIdentifier"},{"text":"?)","kind":"text"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArpeggiate\/init(id:number:direction:isUnbroken:position:placement:color:)","role":"symbol","title":"init(id:number:direction:isUnbroken:position:placement:color:)","type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLNumberLevel":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlnumberlevel","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumberLevel","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNumberLevel","kind":"identifier"}],"kind":"symbol","abstract":[{"type":"text","text":"Slurs, tuplets, and many other features can be concurrent and overlap within a single musical part. The"},{"type":"text","text":" "},{"type":"text","text":"number-level entity distinguishes up to 16 concurrent objects of the same type when the objects overlap in"},{"type":"text","text":" "},{"type":"text","text":"MusicXML document order. Values greater than 6 are usually only needed for music with a large number of divisi"},{"type":"text","text":" "},{"type":"text","text":"staves in a single part, or if there are more than 6 cross-staff arpeggios in a single measure. When a number-"},{"type":"text","text":" "},{"type":"text","text":"level value is implied, the value is 1 by default."}],"type":"topic","navigatorTitle":[{"text":"MXLNumberLevel","kind":"identifier"}],"title":"MXLNumberLevel"},"doc://IvorMXL/documentation/IvorMXL/MXLArpeggiate":{"url":"\/documentation\/ivormxl\/mxlarpeggiate","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArpeggiate","abstract":[{"type":"text","text":"The arpeggiate type indicates that this note is part of an arpeggiated chord. The number attribute can be used"},{"type":"text","text":" "},{"type":"text","text":"to distinguish between two simultaneous chords arpeggiated separately (different numbers) or together (same"},{"type":"text","text":" "},{"type":"text","text":"number). The direction attribute is used if there is an arrow on the arpeggio sign. By default, arpeggios go"},{"type":"text","text":" "},{"type":"text","text":"from the lowest to highest note. The length of the sign can be determined from the position attributes for the"},{"type":"text","text":" "},{"type":"text","text":"arpeggiate elements used with the top and bottom notes of the arpeggiated chord. If the unbroken attribute is"},{"type":"text","text":" "},{"type":"text","text":"set to yes, it indicates that the arpeggio continues onto another staff within the part. This serves as a hint"},{"type":"text","text":" "},{"type":"text","text":"to applications and is not required for cross-staff arpeggios."}],"title":"MXLArpeggiate","kind":"symbol","role":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLArpeggiate","kind":"identifier"}],"navigatorTitle":[{"text":"MXLArpeggiate","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"title":"MXLColor","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"abstract":[{"text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in","type":"text"},{"text":" ","type":"text"},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"url":"\/documentation\/ivormxl\/mxlcolor"}}}