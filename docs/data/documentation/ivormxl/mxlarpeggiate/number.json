{"metadata":{"roleHeading":"Instance Property","modules":[{"name":"IvorMXL"}],"symbolKind":"property","title":"number","role":"symbol","externalID":"s:7IvorMXL13MXLArpeggiateV6numberAA14MXLNumberLevelVSgvp","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"number","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL14MXLNumberLevelV","text":"MXLNumberLevel","kind":"typeIdentifier"},{"text":"?","kind":"text"}]},"variants":[{"paths":["\/documentation\/ivormxl\/mxlarpeggiate\/number"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArpeggiate"]]},"sections":[],"abstract":[{"text":"Distinguishes between two simultaneous chords arpeggiated separately (different numbers) or together (same","type":"text"},{"text":" ","type":"text"},{"text":"number).","type":"text"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"number","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL14MXLNumberLevelV","text":"MXLNumberLevel","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumberLevel"},{"text":"?","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Maps to the MusicXML ","type":"text"},{"code":"number","type":"codeVoice"},{"text":" attribute.","type":"text"}]}]}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArpeggiate\/number","interfaceLanguage":"swift"},"kind":"symbol","references":{"doc://IvorMXL/documentation/IvorMXL/MXLArpeggiate":{"url":"\/documentation\/ivormxl\/mxlarpeggiate","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArpeggiate","abstract":[{"type":"text","text":"The arpeggiate type indicates that this note is part of an arpeggiated chord. The number attribute can be used"},{"type":"text","text":" "},{"type":"text","text":"to distinguish between two simultaneous chords arpeggiated separately (different numbers) or together (same"},{"type":"text","text":" "},{"type":"text","text":"number). The direction attribute is used if there is an arrow on the arpeggio sign. By default, arpeggios go"},{"type":"text","text":" "},{"type":"text","text":"from the lowest to highest note. The length of the sign can be determined from the position attributes for the"},{"type":"text","text":" "},{"type":"text","text":"arpeggiate elements used with the top and bottom notes of the arpeggiated chord. If the unbroken attribute is"},{"type":"text","text":" "},{"type":"text","text":"set to yes, it indicates that the arpeggio continues onto another staff within the part. This serves as a hint"},{"type":"text","text":" "},{"type":"text","text":"to applications and is not required for cross-staff arpeggios."}],"title":"MXLArpeggiate","kind":"symbol","role":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLArpeggiate","kind":"identifier"}],"navigatorTitle":[{"text":"MXLArpeggiate","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLNumberLevel":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlnumberlevel","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumberLevel","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNumberLevel","kind":"identifier"}],"kind":"symbol","abstract":[{"type":"text","text":"Slurs, tuplets, and many other features can be concurrent and overlap within a single musical part. The"},{"type":"text","text":" "},{"type":"text","text":"number-level entity distinguishes up to 16 concurrent objects of the same type when the objects overlap in"},{"type":"text","text":" "},{"type":"text","text":"MusicXML document order. Values greater than 6 are usually only needed for music with a large number of divisi"},{"type":"text","text":" "},{"type":"text","text":"staves in a single part, or if there are more than 6 cross-staff arpeggios in a single measure. When a number-"},{"type":"text","text":" "},{"type":"text","text":"level value is implied, the value is 1 by default."}],"type":"topic","navigatorTitle":[{"text":"MXLNumberLevel","kind":"identifier"}],"title":"MXLNumberLevel"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLArpeggiate/number":{"abstract":[{"text":"Distinguishes between two simultaneous chords arpeggiated separately (different numbers) or together (same","type":"text"},{"text":" ","type":"text"},{"text":"number).","type":"text"}],"url":"\/documentation\/ivormxl\/mxlarpeggiate\/number","fragments":[{"text":"let","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"number"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLNumberLevel","preciseIdentifier":"s:7IvorMXL14MXLNumberLevelV"},{"kind":"text","text":"?"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArpeggiate\/number","role":"symbol","title":"number","type":"topic"}}}