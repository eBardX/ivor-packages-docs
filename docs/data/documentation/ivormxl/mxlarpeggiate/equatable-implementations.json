","type":"text"},{"text":"set to yes, it indicates that the arpeggio continues onto another staff within the part. This serves as a hint","type":"text"},{"text":" ","type":"text"},{"text":"to applications and is not required for cross-staff arpeggios.","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLArpeggiate/!=(_:_:)":{"kind":"symbol","role":"symbol","abstract":[],"url":"\/documentation\/ivormxl\/mxlarpeggiate\/!=(_:_:)","type":"topic","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"!="},{"kind":"text","text":" "},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}],"title":"!=(_:_:)","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArpeggiate\/!=(_:_:)"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"}}}