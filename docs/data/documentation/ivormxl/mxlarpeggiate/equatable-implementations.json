s that the arpeggio continues onto another staff within the part. This serves as a hint","type":"text"},{"text":" ","type":"text"},{"text":"to applications and is not required for cross-staff arpeggios.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"MXLArpeggiate"}]},"doc://IvorMXL/documentation/IvorMXL/MXLArpeggiate/!=(_:_:)":{"url":"\/documentation\/ivormxl\/mxlarpeggiate\/!=(_:_:)","abstract":[],"kind":"symbol","title":"!=(_:_:)","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArpeggiate\/!=(_:_:)","type":"topic","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"!="},{"kind":"text","text":" "},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"}}}