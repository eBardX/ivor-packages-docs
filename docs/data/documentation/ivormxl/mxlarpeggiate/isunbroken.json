{"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArpeggiate\/isUnbroken","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"A Boolean value indicating whether the arpeggio continues onto another staff within the part."}],"kind":"symbol","sections":[],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArpeggiate"]]},"metadata":{"symbolKind":"property","title":"isUnbroken","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"isUnbroken"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":"?"}],"externalID":"s:7IvorMXL13MXLArpeggiateV10isUnbrokenSbSgvp","roleHeading":"Instance Property","modules":[{"name":"IvorMXL"}]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"isUnbroken"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":"?"}],"platforms":["macOS"],"languages":["swift"]}]},{"content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Maps to the MusicXML "},{"code":"unbroken","type":"codeVoice"},{"type":"text","text":" attribute."}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlarpeggiate\/isunbroken"]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLArpeggiate":{"url":"\/documentation\/ivormxl\/mxlarpeggiate","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArpeggiate","abstract":[{"type":"text","text":"The arpeggiate type indicates that this note is part of an arpeggiated chord. The number attribute can be used"},{"type":"text","text":" "},{"type":"text","text":"to distinguish between two simultaneous chords arpeggiated separately (different numbers) or together (same"},{"type":"text","text":" "},{"type":"text","text":"number). The direction attribute is used if there is an arrow on the arpeggio sign. By default, arpeggios go"},{"type":"text","text":" "},{"type":"text","text":"from the lowest to highest note. The length of the sign can be determined from the position attributes for the"},{"type":"text","text":" "},{"type":"text","text":"arpeggiate elements used with the top and bottom notes of the arpeggiated chord. If the unbroken attribute is"},{"type":"text","text":" "},{"type":"text","text":"set to yes, it indicates that the arpeggio continues onto another staff within the part. This serves as a hint"},{"type":"text","text":" "},{"type":"text","text":"to applications and is not required for cross-staff arpeggios."}],"title":"MXLArpeggiate","kind":"symbol","role":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLArpeggiate","kind":"identifier"}],"navigatorTitle":[{"text":"MXLArpeggiate","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLArpeggiate/isUnbroken":{"url":"\/documentation\/ivormxl\/mxlarpeggiate\/isunbroken","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArpeggiate\/isUnbroken","abstract":[{"type":"text","text":"A Boolean value indicating whether the arpeggio continues onto another staff within the part."}],"title":"isUnbroken","kind":"symbol","role":"symbol","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isUnbroken","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":"?","kind":"text"}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"}}}