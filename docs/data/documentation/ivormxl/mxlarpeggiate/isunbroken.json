{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"title":"isUnbroken","abstract":[{"text":"A Boolean value indicating whether the arpeggio continues onto another staff within the part.","type":"text"}],"type":"topic","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLArpeggiate":{"title":"MXLArpeggiate","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLArpeggiate"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlarpeggiate","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLArpeggiate","abstract":[{"text":"The arpeggiate type indicates that this note is part of an arpeggiated chord. The number attribute can be used","type":"text"},{"text":" ","type":"text"},{"text":"to distinguish between two simultaneous chords arpeggiated separately (different numbers) or together (same","type":"text"},{"text":" ","type":"text"},{"text":"number). The direction attribute is used if there is an arrow on the arpeggio sign. By default, arpeggios go","type":"text"},{"text":" ","type":"text"},{"text":"from the lowest to highest note. The length of the sign can be determined from the position attributes for the","type":"text"},{"text":" ","type":"text"},{"text":"arpeggiate elements used with the top and bottom notes of the arpeggiated chord. If the unbroken attribute is","type":"text"},{"text":" ","type":"text"},{"text":"set to yes, it indicates that the arpeggio continues onto another staff within the part. This serves as a hint","type":"text"},{"text":" ","type":"text"},{"text":"to applications and is not required for cross-staff arpeggios.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"MXLArpeggiate"}]},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"}}}