pitch."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPitch\/step","type":"topic"},"doc://IvorMXL/s16SendableMetatypeP":{"type":"unresolvable","identifier":"doc:\/\/IvorMXL\/s16SendableMetatypeP","title":"Swift.SendableMetatype"},"doc://IvorMXL/documentation/IvorMXL/MXLAttributes":{"type":"topic","abstract":[{"type":"text","text":"The attributes element contains musical information that typically changes on measure boundaries. This"},{"text":" ","type":"text"},{"type":"text","text":"includes key and time signatures, clefs, transpositions, and staving. When attributes are changed mid-measure,"},{"type":"text","text":" "},{"type":"text","text":"it affects the music in score order, not in MusicXML document order."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLAttributes","kind":"identifier"}],"navigatorTitle":[{"text":"MXLAttributes","kind":"identifier"}],"title":"MXLAttributes","kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlattributes","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAttributes"},"doc://IvorMXL/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/IvorMXL\/s8SendableP","title":"Swift.Sendable"},"doc://IvorMXL/s9EscapableP":{"type":"unresolvable","identifier":"doc:\/\/IvorMXL\/s9EscapableP","title":"Swift.Escapable"},"doc://IvorMXL/documentation/IvorMXL/MXLPitch/Equatable-Implementations":{"kind":"article","title":"Equatable Implementations","role":"collectionGroup","url":"\/documentation\/ivormxl\/mxlpitch\/equatable-implementations","abstract":[],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPitch\/Equatable-Implementations","type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLRest":{"url":"\/documentation\/ivormxl\/mxlrest","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLRest"}],"title":"MXLRest","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRest","navigatorTitle":[{"kind":"identifier","text":"MXLRest"}],"role":"symbol","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The rest element indicates notated rests or silences. Rest elements are usually empty, but placement on the"},{"type":"text","text":" "},{"type":"text","text":"staff can be specified using display-step and display-octave elements. If the measure attribute is set to yes,"},{"type":"text","text":" "},{"type":"text","text":"this indicates this is a complete measure rest."}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLDirection":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLDirection"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDirection","title":"MXLDirection","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLDirection"}],"abstract":[{"text":"A direction is a musical indication that is not necessarily attached to a specific note. Two or more may be","type":"text"},{"type":"text","text":" "},{"text":"combined to indicate words followed by the start of a dashed line, the end of a wedge followed by dynamics,","type":"text"},{"type":"text","text":" "},{"text":"etc. For applications where a specific direction is indeed attached to a specific note, the direction element","type":"text"},{"type":"text","text":" "},{"text":"can be associated with the first note element that follows it in score order that is not in a different voice.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxldirection"},"doc://IvorMXL/SH":{"type":"unresolvable","identifier":"doc:\/\/IvorMXL\/SH","title":"Swift.Hashable"},"doc://IvorMXL/documentation/IvorMXL/MXLPitch/init(step:alter:octave:)":{"title":"init(step:alter:octave:)","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPitch\/init(step:alter:octave:)","url":"\/documentation\/ivormxl\/mxlpitch\/init(step:alter:octave:)","abstract":[{"type":"text","text":"Creates a new "},{"code":"MXLPitch","type":"codeVoice"},{"type":"text","text":"."}],"kind":"symbol","role":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"step"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL7MXLStepO","kind":"typeIdentifier","text":"MXLStep"},{"kind":"text","text":", "},{"kind":"externalParam","text":"alter"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL12MXLSemitonesa","kind":"typeIdentifier","text":"MXLSemitones"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"octave"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL9MXLOctaveV","kind":"typeIdentifier","text":"MXLOctave"},{"kind":"text","text":")"}],"type":"topic"},"doc://IvorMXL/s8CopyableP":{"type":"unresolvable","identifier":"doc:\/\/IvorMXL\/s8CopyableP","title":"Swift.Copyable"},"doc://IvorMXL/documentation/IvorMXL/MXLMusicItem":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLMusicItem"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLMusicItem"}],"url":"\/documentation\/ivormxl\/mxlmusicitem","role":"symbol","title":"MXLMusicItem","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMusicItem","type":"topic","abstract":[{"type":"text","text":"One of the alternatives for a music item."}]},"doc://IvorMXL/documentation/IvorMXL/MXLNote":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNote"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLNote"}],"url":"\/documentation\/ivormxl\/mxlnote","role":"symbol","title":"MXLNote","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNote","type":"topic","abstract":[{"type":"text","text":"Notes are the most common type of MusicXML data. The MusicXML format distinguishes between elements used for"},{"type":"text","text":" "},{"type":"text","text":"sound information and elements used for notation information (e.g., tie is used for sound, tied for notation)."},{"type":"text","text":" "},{"type":"text","text":"Thus grace notes do not have a duration element. Cue notes have a duration element, as do forward elements,"},{"type":"text","text":" "},{"type":"text","text":"but no tie elements. Having these two types of information available can make interchange easier, as some"},{"type":"text","text":" "},{"type":"text","text":"programs handle one type of information more readily than the other."}]},"doc://IvorMXL/documentation/IvorMXL/MXLFullNote":{"url":"\/documentation\/ivormxl\/mxlfullnote","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFullNote"}],"title":"MXLFullNote","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFullNote","navigatorTitle":[{"kind":"identifier","text":"MXLFullNote"}],"role":"symbol","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The full-note group is a sequence of the common note elements between cue\/grace notes and regular (full)"},{"type":"text","text":" "},{"type":"text","text":"notes: pitch, chord, and rest information, but not duration (cue and grace notes do not have duration"},{"type":"text","text":" "},{"type":"text","text":"encoded). Unpitched elements are used for unpitched percussion, speaking voice, and other musical elements"},{"type":"text","text":" "},{"type":"text","text":"lacking determinate pitch."}]},"doc://IvorMXL/documentation/IvorMXL/MXLPitch/octave":{"title":"octave","abstract":[{"text":"The octave of the pitch.","type":"text"}],"role":"symbol","type":"topic","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPitch\/octave","url":"\/documentation\/ivormxl\/mxlpitch\/octave","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"octave","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLOctave","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLOctaveV"}]},"doc://IvorMXL/documentation/IvorMXL/MXLPitch":{"role":"symbol","abstract":[{"type":"text","text":"Pitch is represented as a combination of the step of the diatonic scale, the chromatic alteration, and the"},{"type":"text","text":" "},{"type":"text","text":"octave."}],"title":"MXLPitch","url":"\/documentation\/ivormxl\/mxlpitch","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPitch","navigatorTitle":[{"text":"MXLPitch","kind":"identifier"}],"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPitch"}]},"doc://IvorMXL/documentation/IvorMXL/MXLPitch/alter":{"kind":"symbol","title":"alter","role":"symbol","url":"\/documentation\/ivormxl\/mxlpitch\/alter","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"alter","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL12MXLSemitonesa","text":"MXLSemitones","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"abstract":[{"type":"text","text":"The chromatic alteration of the pitch, in semitones (e.g. "},{"type":"codeVoice","code":"-1"},{"type":"text","text":" for flat, "},{"type":"codeVoice","code":"1"},{"type":"text","text":" for sharp)."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPitch\/alter","type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline":{"role":"symbol","abstract":[{"type":"text","text":"If a barline is other than a normal single barline, it should be represented by a barline type that describes"},{"text":" ","type":"text"},{"type":"text","text":"it. This includes information about repeats and multiple endings, as well as line style. Barline data is on"},{"type":"text","text":" "},{"type":"text","text":"the same level as the other musical data in a score — a child of a measure in a partwise score, or a part in a"},{"text":" ","type":"text"},{"type":"text","text":"timewise score. This allows for barlines within measures, as in dotted barlines that subdivide measures in"},{"text":" ","type":"text"},{"type":"text","text":"complex meters. The two fermata elements allow for fermatas on both sides of the barline (the lower one"},{"type":"text","text":" "},{"type":"text","text":"inverted)."}],"title":"MXLBarline","url":"\/documentation\/ivormxl\/mxlbarline","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline","navigatorTitle":[{"text":"MXLBarline","kind":"identifier"}],"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLBarline"}]}}}