"keyword"},{"text":" ","kind":"text"},{"text":"open","kind":"identifier"},{"text":"(","kind":"text"},{"text":"position","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLPosition","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLPositionV"},{"text":", ","kind":"text"},{"text":"font","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLFont","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL7MXLFontV"},{"text":", ","kind":"text"},{"text":"color","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLColor","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLColorV"},{"text":"?, ","kind":"text"},{"text":"placement","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLAboveBelow","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL13MXLAboveBelowO"},{"text":"?, ","kind":"text"},{"text":"smufl","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLSmuflGlyphName","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL17MXLSmuflGlyphNameV"},{"text":"?)","kind":"text"}],"symbolKind":"case","title":"MXLTechnical.Item.open(position:font:color:placement:smufl:)","externalID":"s:7IvorMXL12MXLTechnicalV4ItemO4openyAeA11MXLPositionV_AA7MXLFontVAA8MXLColorVSgAA13MXLAboveBelowOSgAA17MXLSmuflGlyphNameVSgtcAEmF","roleHeading":"Case","role":"symbol"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTechnical","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTechnical\/Item"]]},"abstract":[{"type":"text","text":"The open element represents the open symbol, which looks like a circle. The smufl attribute can be used to"},{"type":"text","text":" "},{"type":"text","text":"distinguish different SMuFL glyphs that have a similar appearance such as brassMuteOpen and guitarOpenPedal."},{"type":"text","text":" "},{"type":"text","text":"If not present, the default glyph is brassMuteOpen."}],"kind":"symbol","references":{"doc://IvorMXL/documentation/IvorMXL/MXLTechnical/Item":{"type":"topic","title":"MXLTechnical.Item","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTechnical\/Item","abstract":[{"type":"text","text":"One of the alternatives for Technical."}],"role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Item"}],"navigatorTitle":[{"kind":"identifier","text":"Item"}],"url":"\/documentation\/ivormxl\/mxltechnical\/item"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLPosition":{"type":"topic","abstract":[{"type":"text","text":"For most elements, any program will compute a default x and y position. The position attributes let this be"},{"type":"text","text":" "},{"type":"text","text":"changed two ways."}],"url":"\/documentation\/ivormxl\/mxlposition","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPosition"}],"kind":"symbol","title":"MXLPosition","navigatorTitle":[{"kind":"identifier","text":"MXLPosition"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"type":"topic","abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"type":"text","text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is"},{"type":"text","text":" "},{"type":"text","text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF."}],"url":"\/documentation\/ivormxl\/mxlcolor","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"kind":"symbol","title":"MXLColor","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLAboveBelow":{"type":"topic","title":"MXLAboveBelow","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAboveBelow","abstract":[{"type":"text","text":"The above-below type is used to indicate whether one element appears above or below another element."}],"role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLAboveBelow"}],"navigatorTitle":[{"kind":"identifier","text":"MXLAboveBelow"}],"url":"\/documentation\/ivormxl\/mxlabovebelow"},"doc://IvorMXL/documentation/IvorMXL/MXLFont":{"type":"topic","title":"MXLFont","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","abstract":[{"type":"text","text":"The font attribute group gathers together attributes for determining the font within a credit or direction."},{"type":"text","text":" "},{"type":"text","text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of"},{"type":"text","text":" "},{"type":"text","text":"font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric"},{"type":"text","text":" "},{"type":"text","text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font"},{"type":"text","text":" "},{"type":"text","text":"vs. a music font."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFont"}],"navigatorTitle":[{"kind":"identifier","text":"MXLFont"}],"url":"\/documentation\/ivormxl\/mxlfont"},"doc://IvorMXL/documentation/IvorMXL/MXLTechnical/Item/open(position:font:color:placement:smufl:)":{"url":"\/documentation\/ivormxl\/mxltechnical\/item\/open(position:font:color:placement:smufl:)","abstract":[{"text":"The open element represents the open symbol, which looks like a circle. The smufl attribute can be used to","type":"text"},{"text":" ","type":"text"},{"text":"distinguish different SMuFL glyphs that have a similar appearance such as brassMuteOpen and guitarOpenPedal.","type":"text"},{"text":" ","type":"text"},{"text":"If not present, the default glyph is brassMuteOpen.","type":"text"}],"title":"MXLTechnical.Item.open(position:font:color:placement:smufl:)","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTechnical\/Item\/open(position:font:color:placement:smufl:)","type":"topic","role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"open","kind":"identifier"},{"text":"(","kind":"text"},{"text":"position","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLPosition","preciseIdentifier":"s:7IvorMXL11MXLPositionV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"font","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLFont","preciseIdentifier":"s:7IvorMXL7MXLFontV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"color","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLColor","preciseIdentifier":"s:7IvorMXL8MXLColorV","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"placement","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLAboveBelow","preciseIdentifier":"s:7IvorMXL13MXLAboveBelowO","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"smufl","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLSmuflGlyphName","preciseIdentifier":"s:7IvorMXL17MXLSmuflGlyphNameV","kind":"typeIdentifier"},{"text":"?)","kind":"text"}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLSmuflGlyphName":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSmuflGlyphName","kind":"identifier"}],"title":"MXLSmuflGlyphName","abstract":[{"type":"text","text":"The smufl-glyph-name type is used for attributes that reference a specific Standard Music Font Layout (SMuFL)"},{"text":" ","type":"text"},{"type":"text","text":"character. The value is a SMuFL canonical glyph name, not a code point. For instance, the value for a standard"},{"type":"text","text":" "},{"text":"piano pedal mark would be keyboardPedalPed, not U+E650.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSmuflGlyphName","role":"symbol","url":"\/documentation\/ivormxl\/mxlsmuflglyphname","kind":"symbol","navigatorTitle":[{"text":"MXLSmuflGlyphName","kind":"identifier"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLTechnical":{"type":"topic","title":"MXLTechnical","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTechnical","abstract":[{"type":"text","text":"Technical indications give performance information for individual instruments."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTechnical"}],"navigatorTitle":[{"kind":"identifier","text":"MXLTechnical"}],"url":"\/documentation\/ivormxl\/mxltechnical"}}}