"},{"type":"text","text":" "},{"type":"text","text":"character. The value is a SMuFL canonical glyph name, not a code point. For instance, the value for a standard"},{"type":"text","text":" "},{"type":"text","text":"piano pedal mark would be keyboardPedalPed, not U+E650."}]},"doc://IvorMXL/documentation/IvorMXL/MXLTechnical/Item/stopped(position:font:color:placement:smufl:)":{"fragments":[{"kind":"keyword","text":"case"},{"text":" ","kind":"text"},{"kind":"identifier","text":"stopped"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"position"},{"text":": ","kind":"text"},{"text":"MXLPosition","preciseIdentifier":"s:7IvorMXL11MXLPositionV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"font","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL7MXLFontV","text":"MXLFont","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"color","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLColor","preciseIdentifier":"s:7IvorMXL8MXLColorV","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"placement","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLAboveBelow","preciseIdentifier":"s:7IvorMXL13MXLAboveBelowO","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"smufl","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLSmuflGlyphName","preciseIdentifier":"s:7IvorMXL17MXLSmuflGlyphNameV","kind":"typeIdentifier"},{"text":"?)","kind":"text"}],"abstract":[{"type":"text","text":"The stopped element represents the stopped symbol, which looks like a plus sign. The smufl attribute"},{"type":"text","text":" "},{"type":"text","text":"distinguishes different SMuFL glyphs that have a similar appearance such as handbellsMalletBellSuspended and"},{"type":"text","text":" "},{"type":"text","text":"guitarClosePedal. If not present, the default glyph is brassMuteClosed."}],"role":"symbol","url":"\/documentation\/ivormxl\/mxltechnical\/item\/stopped(position:font:color:placement:smufl:)","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTechnical\/Item\/stopped(position:font:color:placement:smufl:)","title":"MXLTechnical.Item.stopped(position:font:color:placement:smufl:)","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLPosition":{"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPosition","kind":"identifier"}],"title":"MXLPosition","navigatorTitle":[{"text":"MXLPosition","kind":"identifier"}],"abstract":[{"type":"text","text":"For most elements, any program will compute a default x and y position. The position attributes let this be"},{"type":"text","text":" "},{"type":"text","text":"changed two ways."}],"url":"\/documentation\/ivormxl\/mxlposition","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLTechnical/Item":{"title":"MXLTechnical.Item","url":"\/documentation\/ivormxl\/mxltechnical\/item","abstract":[{"type":"text","text":"One of the alternatives for Technical."}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Item","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"Item","kind":"identifier"}],"type":"topic","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTechnical\/Item"},"doc://IvorMXL/documentation/IvorMXL/MXLTechnical":{"title":"MXLTechnical","url":"\/documentation\/ivormxl\/mxltechnical","abstract":[{"type":"text","text":"Technical indications give performance information for individual instruments."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTe