word","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"kind":"symbol","title":"MXLColor","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLAboveBelow":{"type":"topic","title":"MXLAboveBelow","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAboveBelow","abstract":[{"type":"text","text":"The above-below type is used to indicate whether one element appears above or below another element."}],"role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLAboveBelow"}],"navigatorTitle":[{"kind":"identifier","text":"MXLAboveBelow"}],"url":"\/documentation\/ivormxl\/mxlabovebelow"},"doc://IvorMXL/documentation/IvorMXL/MXLFont":{"type":"topic","title":"MXLFont","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","abstract":[{"type":"text","text":"The font attribute group gathers together attributes for determining the font within a credit or direction."},{"type":"text","text":" "},{"type":"text","text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of"},{"type":"text","text":" "},{"type":"text","text":"font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric"},{"type":"text","text":" "},{"type":"text","text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font"},{"type":"text","text":" "},{"type":"text","text":"vs. a music font."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFont"}],"navigatorTitle":[{"kind":"identifier","text":"MXLFont"}],"url":"\/documentation\/ivormxl\/mxlfont"},"doc://IvorMXL/documentation/IvorMXL/MXLTechnical/Item/stopped(position:font:color