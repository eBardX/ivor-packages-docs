{"metadata":{"externalID":"s:7IvorMXL16MXLKeyAccidentalV5valueAA18MXLAccidentalValueOvp","roleHeading":"Instance Property","modules":[{"name":"IvorMXL"}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"value","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLAccidentalValue","preciseIdentifier":"s:7IvorMXL18MXLAccidentalValueO","kind":"typeIdentifier"}],"symbolKind":"property","role":"symbol","title":"value"},"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLKeyAccidental\/value"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLKeyAccidental"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"type":"text","text":"The value of this element."}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"value","kind":"identifier"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidentalValue","text":"MXLAccidentalValue","preciseIdentifier":"s:7IvorMXL18MXLAccidentalValueO","kind":"typeIdentifier"}],"languages":["swift"]}],"kind":"declarations"}],"variants":[{"paths":["\/documentation\/ivormxl\/mxlkeyaccidental\/value"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"references":{"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLKeyAccidental":{"abstract":[{"type":"text","text":"The key-accidental type indicates the accidental to be displayed in a non-traditional key signature,"},{"type":"text","text":" "},{"type":"text","text":"represented in the same manner as the accidental type without the formatting attributes."}],"navigatorTitle":[{"kind":"identifier","text":"MXLKeyAccidental"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLKeyAccidental"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLKeyAccidental","title":"MXLKeyAccidental","url":"\/documentation\/ivormxl\/mxlkeyaccidental","type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLAccidentalValue":{"title":"MXLAccidentalValue","kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLAccidentalValue","kind":"identifier"}],"abstract":[{"text":"The accidental-value type represents notated accidentals supported by MusicXML. In the MusicXML 2.0 DTD this","type":"text"},{"text":" ","type":"text"},{"text":"was a string with values that could be included. The XSD strengthens the data typing to an enumerated list.","type":"text"},{"text":" ","type":"text"},{"text":"The quarter- and three-quarters- accidentals are Tartini-style quarter-tone accidentals. The -down and -up","type":"text"},{"text":" ","type":"text"},{"text":"accidentals are quarter-tone accidentals that include arrows pointing down or up. The slash- accidentals are","type":"text"},{"text":" ","type":"text"},{"text":"used in Turkish classical music. The numbered sharp and flat accidentals are superscripted versions of the","type":"text"},{"text":" ","type":"text"},{"text":"accidental signs, used in Turkish folk music. The sori and koron accidentals are microtonal sharp and flat","type":"text"},{"text":" ","type":"text"},{"text":"accidentals used in Iranian and Persian music. The other accidental covers accidentals other than those listed","type":"text"},{"text":" ","type":"text"},{"text":"here. It is usually used in combination with the smufl attribute to specify a particular SMuFL accidental. The","type":"text"},{"text":" ","type":"text"},{"text":"smufl attribute may be used with any accidental value to help specify the appearance of symbols that share the","type":"text"},{"text":" ","type":"text"},{"text":"same MusicXML semantics.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidentalValue","role":"symbol","navigatorTitle":[{"text":"MXLAccidentalValue","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlaccidentalvalue"},"doc://IvorMXL/documentation/IvorMXL/MXLKeyAccidental/value":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLKeyAccidental\/value","kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxlkeyaccidental\/value","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"value","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLAccidentalValue","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL18MXLAccidentalValueO"}],"abstract":[{"type":"text","text":"The value of this element."}],"role":"symbol","title":"value"}}}