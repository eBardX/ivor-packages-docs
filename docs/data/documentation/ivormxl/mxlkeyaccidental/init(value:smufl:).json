tal character.","type":"text"}]}],"name":"smufl"}]}],"abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLKeyAccidental"},{"type":"text","text":"."}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLKeyAccidental\/init(value:smufl:)","interfaceLanguage":"swift"},"sections":[],"variants":[{"paths":["\/documentation\/ivormxl\/mxlkeyaccidental\/init(value:smufl:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLKeyAccidental/init(value:smufl:)":{"title":"init(value:smufl:)","role":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"value"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL18MXLAccidentalValueO","kind":"typeIdentifier","text":"MXLAccidentalValue"},{"kind":"text","text":", "},{"kind":"externalParam","text":"smufl"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL27MXLSmuflAccidentalGlyphNameV","kind":"typeIdentifier","text":"MXLSmuflAccidentalGlyphName"},{"kind":"text","text":"?)"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlkeyaccidental\/init(value:smufl:)","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLKeyAccidental\/init(value:smufl:)","abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLKeyAccidental"},{"type":"text","text":"."}]},"doc://IvorMXL/documentation/IvorMXL/MXLKeyAccidental":{"title":"MXLKeyAccidental","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLKeyAccidental","kind":"identifier"}],"kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxlkeyaccidental","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLKeyAccidental","abstract":[{"text":"The key-accidental type indicates the accidental to be displayed in a non-traditional key signature,","type":"text"},{"text":" ","type":"text"},{"text":"represented in the same manner as the accidental type without the formatting attributes.","type":"text"}],"navigatorTitle":[{"text":"MXLKeyAccidental","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLAccidentalValue":{"title":"MXLAccidentalValue","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLAccidentalValue","kind":"identifier"}],"kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxlaccidentalvalue","abstract":[{"text":"The accidental-value type represents notated accidentals supported by MusicXML. In the MusicXML 2.0 DTD this","type":"text"},{"text":" ","type":"text"},{"text":"was a string with values that could be included. The XSD strengthens the data typing to an enumerated list.","type":"text"},{"text":" ","type":"text"},{"text":"The quarter- and three-quarters- accidentals are Tartini-style quarter-tone accidentals. The -down and -up","type":"text"},{"type":"text","text":" "},{"type":"text","text":"accidentals are quarter-tone accidentals that include arrows pointing down or up. The slash- accidentals are"},{"type":"text","text":" "},{"type":"text","text":"used in Turkish classical music. The numbered sharp and flat accidentals are superscripted versions of the"},{"type":"text","text":" "},{"type":"text","text":"accidental signs, used in Turkish folk music. The sori and koron accidentals are microtonal sharp and flat"},{"type":"text","text":" "},{"type":"text","text":"accidentals used in Iranian and Persian music. The other accidental covers accidentals other than those listed"},{"type":"text","text":" "},{"type":"text","text":"here. It is usually used in combination with the smufl attribute to specify a particular SMuFL accidental. The"},{"type":"text","text":" "},{"type":"text","text":"smufl attribute may be used with any accidental value to help specify the appearance of symbols that share the"},{"type":"text","text":" "},{"type":"text","text":"same MusicXML semantics."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidentalValue","navigatorTitle":[{"text":"MXLAccidentalValue","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLSmuflAccidentalGlyphName":{"title":"MXLSmuflAccidentalGlyphName","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSmuflAccidentalGlyphName","kind":"identifier"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlsmuflaccidentalglyphname","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSmuflAccidentalGlyphName","abstract":[{"text":"The smufl-accidental-glyph-name type is used to reference a specific Standard Music Font Layout (SMuFL)","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"accidental character. The value is a SMuFL canonical glyph name that starts with one of the strings used at"},{"type":"text","text":" "},{"text":"the start of glyph names for SMuFL accidentals.","type":"text"}],"navigatorTitle":[{"text":"MXLSmuflAccidentalGlyphName","kind":"identifier"}]}}}