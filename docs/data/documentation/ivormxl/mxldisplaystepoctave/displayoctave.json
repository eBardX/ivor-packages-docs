{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxldisplaystepoctave\/displayoctave"]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"modules":[{"name":"IvorMXL"}],"role":"symbol","externalID":"s:7IvorMXL20MXLDisplayStepOctaveV07displayE0AA9MXLOctaveVvp","symbolKind":"property","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"displayOctave","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLOctave","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLOctaveV"}],"title":"displayOctave","roleHeading":"Instance Property"},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDisplayStepOctave"]]},"abstract":[{"type":"text","text":"The octave used to visually position a rest or unpitched element on the staff, following the current clef."},{"type":"text","text":" "},{"type":"text","text":"If a percussion clef is in use, this is interpreted as if in treble clef, with a G in octave 4 on line 2."}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"displayOctave","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLOctave","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOctave","preciseIdentifier":"s:7IvorMXL9MXLOctaveV"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"Maps to a nested MusicXML ","type":"text"},{"code":"<display-octave>","type":"codeVoice"},{"text":" element.","type":"text"}]}],"kind":"content"}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDisplayStepOctave\/displayOctave","interfaceLanguage":"swift"},"sections":[],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLOctave":{"kind":"symbol","role":"sy