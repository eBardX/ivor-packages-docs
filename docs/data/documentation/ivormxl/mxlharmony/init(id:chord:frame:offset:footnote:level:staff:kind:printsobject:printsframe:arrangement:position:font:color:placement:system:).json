tion\/IvorMXL\/MXLStaff","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLStaffV","text":"MXLStaff"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"kind"},{"kind":"text","text":": "},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmony\/Kind-swift.enum","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL10MXLHarmonyV4KindO","text":"Kind"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"printsObject"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"printsFrame"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"arrangement"},{"kind":"text","text":": "},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmonyArrangement","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL21MXLHarmonyArrangementO","text":"MXLHarmonyArrangement"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"position"},{"kind":"text","text":": "},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLPositionV","text":"MXLPosition"},{"kind":"text","text":" = MXLPosition(), "},{"kind":"externalParam","text":"font"},{"kind":"text","text":": "},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL7MXLFontV","text":"MXLFont"},{"kind":"text","text":" = MXLFont(), "},{"kind":"externalParam","text":"color"},{"kind":"text","text":": "},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLColorV","text":"MXLColor"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"placement"},{"kind":"text","text":": "},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAboveBelow","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL13MXLAboveBelowO","text":"MXLAboveBelow"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"system"},{"kind":"text","text":": "},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemRelation","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL17MXLSystemRelationO","text":"MXLSystemRelation"},{"kind":"text","text":"? = nil)"}]}]},{"kind":"parameters","parameters":[{"name":"id","content":[{"inlineContent":[{"type":"text","text":"The optional-unique-id attribute group allows an element to optionally specify an ID that is unique to the entire document. This attribute group is not used for a required id attribute, or for an id attribute that specifies an id reference."}],"type":"paragraph"}]},{"name":"chord","content":[{"inlineContent":[{"type":"text","text":"A harmony element can contain many stacked chords (e.g. V of II). A sequence of harmony-chord groups is used for this type of secondary function, where V of II would be represented by a harmony-chord with a 5 numeral followed by a harmony-chord with a 2 numeral."}],"type":"paragraph"}]},{"name":"frame","content":[{"inlineContent":[{"type":"text","text":"A fretboard diagram to be printed with this harmony."}],"type":"paragraph"}]},{"name":"offset","content":[{"inlineContent":[{"type":"text","text":"Indicates where this harmony will appear relative to the current musical location, in divisions."}],"type":"paragraph"}]},{"name":"footnote","content":[{"inlineContent":[{"type":"text","text":"The footnote element specifies editorial information that appears in footnotes in the printed score. It is defined within a group due to its multiple uses within the MusicXML schema."}],"type":"paragraph"}]},{"name":"level","content":[{"inlineContent":[{"type":"text","text":"The level element specifies editorial information for different MusicXML elements. It is defined within a group due to its multiple uses within the MusicXML schema."}],"type":"paragraph"}]},{"name":"staff","content":[{"inlineContent":[{"type":"text","text":"The staff element is defined within a group due to its use by both notes and direction elements."}],"type":"paragraph"}]},{"name":"kind","content":[{"inlineContent":[{"type":"text","text":"Differentiates whether this harmony is explicit, implied, or an alternate analysis, when alternate harmonies are possible."}],"type":"paragraph"}]},{"name":"printsObject","content":[{"inlineContent":[{"type":"text","text":"A Boolean value indicating whether to print an object (e.g. a note or a rest). Defaults to "},{"type":"codeVoice","code":"true"},{"type":"text","text":" if not specified."}],"type":"paragraph"}]},{"name":"printsFrame","content":[{"inlineContent":[{"type":"text","text":"A Boolean value indicating whether to print a frame or fretboard diagram for this harmony."}],"type":"paragraph"}]},{"name":"arrangement","content":[{"inlineContent":[{"type":"text","text":"Specifies how multiple harmony-chord groups are arranged relative to each other."}],"type":"paragraph"}]},{"name":"position","content":[{"inlineContent":[{"type":"text","text":"For most elements, any program will compute a default x and y position. The position attributes let this be changed two ways."}],"type":"paragraph"}]},{"name":"font","content":[{"inlineContent":[{"type":"text","text":"The font attribute group gathers together attributes for determining the font within a credit or direction. They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of font names.The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font vs. a music font."}],"type":"paragraph"}]},{"name":"color","content":[{"inlineContent":[{"type":"text","text":"The color attribute group indicates the color of an element."}],"type":"paragraph"}]},{"name":"placement","content":[{"inlineContent":[{"type":"text","text":"The placement attribute indicates whether something is above or below another element, such as a note or a notation."}],"type":"paragraph"}]},{"name":"system","content":[{"inlineContent":[{"type":"text","text":"The system-relation attribute group distinguishes elements that are associated with a system rather than the particular part where the element appears."}],"type":"paragraph"}]}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"variants":[{"paths":["\/documentation\/ivormxl\/mxlharmony\/init(id:chord:frame:offset:footnote:level:staff:kind:printsobject:printsframe:arrangement:position:font:color:placement:system:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"abstract":[{"text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in","type":"text"},{"type":"text","text":" "},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"title":"MXLColor","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlcolor","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor"},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLFormattedText":{"navigatorTitle":[{"text":"MXLFormattedText","kind":"identifier"}],"abstract":[{"type":"text","text":"The formatted-text type represents a text element with text-formatting attributes."}],"title":"MXLFormattedText","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFormattedText","kind":"symbol","url":"\/documentation\/ivormxl\/mxlformattedtext","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLFormattedText","kind":"identifier"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLFrame":{"abstract":[{"type":"text","text":"The frame type represents a frame or fretboard diagram used together with a chord symbol. The representation"},{"type":"text","text":" "},{"type":"text","text":"is based on the NIFF guitar grid with additional information. The frame type’s unplayed attribute indicates"},{"type":"text","text":" "},{"type":"text","text":"what to display above a string that has no associated frame-note element. Typical values are x and the empty"},{"type":"text","text":" "},{"type":"text","text":"string. If the attribute is not present, the display of the unplayed string is application-defined."}],"title":"MXLFrame","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFrame"}],"navigatorTitle":[{"kind":"identifier","text":"MXLFrame"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlframe","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFrame"},"doc://IvorMXL/documentation/IvorMXL/MXLStaff":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaff","title":"MXLStaff","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLStaff","kind":"identifier"}],"navigatorTitle":[{"text":"MXLStaff","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlstaff","abstract":[{"text":"The staff element is defined within a group due to its use by both notes and direction elements.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLHarmony/Chord-swift.struct":{"title":"MXLHarmony.Chord","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"Chord"}],"kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxlharmony\/chord-swift.struct","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmony\/Chord-swift.struct","abstract":[{"type":"text","text":"A harmony element can contain many stacked chords (e.g. V of II). A sequence of harmony-chord groups is used"},{"type":"text","text":" "},{"type":"text","text":"for this type of secondary function, where V of II would be represented by a harmony-chord with a 5 numeral"},{"type":"text","text":" "},{"type":"text","text":"followed by a harmony-chord with a 2 numeral."}],"navigatorTitle":[{"text":"Chord","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLHarmonyArrangement":{"navigatorTitle":[{"kind":"identifier","text":"MXLHarmonyArrangement"}],"abstract":[{"type":"text","text":"The harmony-arrangement type indicates how stacked chords and bass notes are displayed within a harmony"},{"type":"text","text":" "},{"type":"text","text":"element. The vertical value specifies that the second element appears below the first. The horizontal value"},{"type":"text","text":" "},{"type":"text","text":"specifies that the second element appears to the right of the first. The diagonal value specifies that the"},{"type":"text","text":" "},{"type":"text","text":"second element appears both below and to the right of the first."}],"title":"MXLHarmonyArrangement","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmonyArrangement","kind":"symbol","url":"\/documentation\/ivormxl\/mxlharmonyarrangement","type":"topic","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLHarmonyArrangement"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLPosition":{"title":"MX