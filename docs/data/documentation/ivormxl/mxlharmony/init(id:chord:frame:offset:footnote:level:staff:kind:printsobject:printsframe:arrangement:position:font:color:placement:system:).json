ue"},{"type":"text","text":" "},{"type":"text","text":"specifies that the second element appears to the right of the first. The diagonal value specifies that the"},{"type":"text","text":" "},{"text":"second element appears both below and to the right of the first.","type":"text"}],"navigatorTitle":[{"text":"MXLHarmonyArrangement","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLHarmonyArrangement","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmonyArrangement","title":"MXLHarmonyArrangement"},"doc://IvorMXL/documentation/IvorMXL/MXLFont":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLFont"}],"abstract":[{"text":"The font attribute group gathers together attributes for determining the font within a credit or direction.","type":"text"},{"text":" ","type":"text"},{"text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of","type":"text"},{"text":" ","type":"text"},{"text":"font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric","type":"text"},{"text":" ","type":"text"},{"text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font","type":"text"},{"text":" ","type":"text"},{"text":"vs. a music font.","type":"text"}],"kind":"symbol","title":"MXLFont","url":"\/documentation\/ivormxl\/mxlfont","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFont"}]},"doc://IvorMXL/documentation/IvorMXL/MXLHarmony/init(id:chord:frame:offset:footnote:level:staff:kind:printsObject:printsFrame:arrangement:position:font:color:placement:system:)":{"url":"\/documentation\/ivormxl\/mxlharmony\/init(id:chord:frame:offset:footnote:level:staff:kind:printsobject:printsframe:arra