/IvorMXL/documentation/IvorMXL/MXLFont":{"navigatorTitle":[{"text":"MXLFont","kind":"identifier"}],"abstract":[{"text":"The font attribute group gathers together attributes for determining the font within a credit or direction.","type":"text"},{"text":" ","type":"text"},{"text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of","type":"text"},{"text":" ","type":"text"},{"text":"font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric","type":"text"},{"text":" ","type":"text"},{"text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font","type":"text"},{"text":" ","type":"text"},{"text":"vs. a music font.","type":"text"}],"title":"MXLFont","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","kind":"symbol","url":"\/documentation\/ivormxl\/mxlfont","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLFont","kind":"identifier"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLAboveBelow":{"title":"MXLAboveBelow","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLAboveBelow"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlabovebelow","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAboveBelow","abstract":[{"text":"The above-below type is used to indicate whether one element appears above or below another element.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"MXLAboveBelow"}]},"doc://IvorMXL/documentation/IvorMXL/MXLLevel":{"navigatorTitle":[{"text":"MXLLevel","kind":"identifier"}],"abstract":[{"type":"text","text":"The level type is used to specify editorial information for different MusicXML elements. The content contains"},{"type":"text","text":" "},{"type":"text","text":"identifying and\/or descriptive text about the editorial status of the parent element."}],"title":"MXLLevel","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLevel","kind":"symbol","url":"\/documentation\/ivormxl\/mxllevel","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLLevel","kind":"identifier"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLOffset":{"title":"MXLOffset","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLOffset","kind":"identifier"}],"kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxloffset","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOffset","abstract":[{"type":"text","text":"An offset is represented in terms of divisions, and indicates where the direction will appear relative to the"},{"type":"text","text":" "},{"type":"text","text":"current musical location. The current musical location is always within the current measure, even at the end"},{"type":"text","text":" "},{"type":"text","text":"of a measure."}],"navigatorTitle":[{"text":"MXLOffset","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLSystemRelation":{"abstract":[{"text":"The system-relation type distinguishes elements that are associated with a system rather than the particular","type":"text"},{"text":" ","type":"text"},{"text":"part where the element appears. A value of only-top indicates that the element should appear only on the top","type":"text"},{"text":" ","type":"text"},{"text":"part of the current system. A value of also-top indicates that the element should appear on both the current","type":"text"},{"text":" ","type":"text"},{"text":"part and the top part of the current system. If this value appears in a score, when parts are created the","type":"text"},{"text":" ","type":"text"},{"text":"element should only appear once in this part, not twice. A value of none indicates that the element is","type":"text"},{"text":" ","type":"text"},{"text":"associated only with the current part, not with the system.","type":"text"}],"title":"MXLSystemRelation","kind":"symbol","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSystemRelation","kind":"identifier"}],"navigatorTitle":[{"text":"MXLSystemRelation","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlsystemrelation","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemRelation"}}}