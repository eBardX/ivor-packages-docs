{"text":": ","kind":"text"},{"text":"MXLColor","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLColorV"},{"text":"?, ","kind":"text"},{"text":"placement","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLAboveBelow","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL13MXLAboveBelowO"},{"text":"?, ","kind":"text"},{"text":"system","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLSystemRelation","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL17MXLSystemRelationO"},{"text":"?)","kind":"text"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlharmony\/init(id:chord:frame:offset:footnote:level:staff:kind:printsobject:printsframe:arrangement:position:font:color:placement:system:)","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmony\/init(id:chord:frame:offset:footnote:level:staff:kind:printsObject:printsFrame:arrangement:position:font:color:placement:system:)","abstract":[{"text":"Creates a new ","type":"text"},{"type":"codeVoice","code":"MXLHarmony"},{"text":".","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLHarmony/Kind-swift.enum":{"type":"topic","abstract":[{"type":"text","text":"The harmony-type type differentiates different types of harmonies when alternate harmonies are possible."},{"type":"text","text":" "},{"type":"text","text":"Explicit harmonies have all note present in the music; implied have some notes missing but implied;"},{"type":"text","text":" "},{"type":"text","text":"alternate represents alternate analyses."}],"url":"\/documentation\/ivormxl\/mxlharmony\/kind-swift.enum","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Kind"}],"kind":"symbol","title":"MXLHarmony.Kind","navigatorTitle":[{"kind":"identifier","text":"Kind"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmony\/Kind-swift.enum","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLStaff":{"type":"topic","abstract":[{"type":"text","text":"The staff element is defined within a group due to its use by both notes and direction elements."}],"url":"\/documentation\/ivormxl\/mxlstaff","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLStaff"}],"kind":"symbol","title":"MXLStaff","navigatorTitle":[{"kind":"identifier","text":"MXLStaff"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaff","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLFont":{"type":"topic","title":"MXLFont","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","abstract":[{"type":"text","text":"The font attribute group gathers together attributes for determining the font within a credit or direction."},{"type":"text","text":" "},{"type":"text","text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of"},{"type":"text","text":" "},{"type":"text","text":"font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric"},{"type":"text","text":" "},{"type":"text","text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font"},{"type":"text","text":" "},{"type":"text","text":"vs. a music font."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFont"}],"navigatorTitle":[{"kind":"identifier","text":"MXLFont"}],"url":"\/documentation\/ivormxl\/mxlfont"}}}