[{"text":"MXLOffset","kind":"identifier"}],"type":"topic","title":"MXLOffset","kind":"symbol","url":"\/documentation\/ivormxl\/mxloffset","abstract":[{"type":"text","text":"An offset is represented in terms of divisions, and indicates where the direction will appear relative to the"},{"type":"text","text":" "},{"type":"text","text":"current musical location. The current musical location is always within the current measure, even at the end"},{"type":"text","text":" "},{"type":"text","text":"of a measure."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLOffset","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLFormattedText":{"type":"topic","title":"MXLFormattedText","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFormattedText","abstract":[{"type":"text","text":"The formatted-text type represents a text element with text-formatting attributes."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFormattedText"}],"navigatorTitle":[{"kind":"identifier","text":"MXLFormattedText"}],"url":"\/documentation\/ivormxl\/mxlformattedtext"},"doc://IvorMXL/documentation/IvorMXL/MXLLevel":{"type":"topic","abstract":[{"type":"text","text":"The level type is used to specify editorial information for different MusicXML elements. The content contains"},{"type":"text","text":" "},{"type":"text","text":"identifying and\/or descriptive text about the editorial status of the parent element."}],"url":"\/documentation\/ivormxl\/mxllevel","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLLevel","kind":"identifier"}],"kind":"symbol","title":"MXLLevel","navigatorTitle":[{"text":"MXLLevel","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLevel","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLHarmonyArrangement":{"type":"topic","abstract":[{"type":"text","text":"The harmony-arrangement type indicates how stacked chords and bass notes are displayed within a harmony"},{"type":"text","text":" "},{"type":"text","text":"element. The vertical value specifies that the second element appears below the first. The horizontal value"},{"type":"text","text":" "},{"type":"text","text":"specifies that the second element appears to the right of the first. The diagonal value specifies that the"},{"type":"text","text":" "},{"type":"text","text":"second element appears both below and to the right of the first."}],"url":"\/documentation\/ivormxl\/mxlharmonyarrangement","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLHarmonyArrangement"}],"kind":"symbol","title":"MXLHarmonyArrangement","navigatorTitle":[{"kind":"identifier","text":"MXLHarmonyArrangement"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmonyArrangement","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLFrame":{"type":"topic","abstract":[{"text":"The frame type represents a frame or fretboard diagram used together with a chord symbol. The representation","type":"text"},{"text":" ","type":"text"},{"text":"is based on the NIFF guitar grid with additional information. The frame type’s unplayed attribute indicates","type":"text"},{"text":" ","type":"text"},{"text":"what to display above a string that has no associated frame-note element. Typical values are x and the empty","type":"text"},{"text":" ","type":"text"},{"text":"string. If the attribute is not present, the display of the unplayed string is application-defined.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlframe","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLFrame","kind":"identifier"}],"kind":"symbol","title":"MXLFrame","navigatorTitle":[{"text":"MXLFrame","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFrame","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLHarmony":{"type":"topic","title":"MXLHarmony","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmony","abstract":[{"text":"The harmony type represents harmony analysis, including chord symbols in popular music as well as functional","type":"text"},{"text":" ","type":"text"},{"text":"harmony analysis in classical music.","type":"text"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLHarmony","kind":"identifier"}],"navigatorTitle":[{"text":"MXLHarmony","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlharmony"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"type":"topic","abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"type":"text","text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is"},{"type":"text","text":" "},{"type":"text","text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF."}],"url":"\/documentation\/ivormxl\/mxlcolor","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"kind":"symbol","title":"MXLColor","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLAboveBelow":{"type":"topic","title":"MXLAboveBelow","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAboveBelow","abstract":[{"type":"text","text":"The above-below type is used to indicate whether one element appears above or below another element."}],"role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLAboveBelow"}],"navigatorTitle":[{"kind":"identifier","text":"MXLAboveBelow"}],"url":"\/documentation\/ivormxl\/mxlabovebelow"},"doc://IvorMXL/documentation/IvorMXL/MXLPosition":{"type":"topic","abstract":[{"type":"text","text":"For most elements, any program will compute a default x and y position. The position attributes let this be"},{"type":"text","text":" "},{"type":"text","text":"changed two ways."}],"url":"\/documentation\/ivormxl\/mxlposition","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPosition"}],"kind":"symbol","title":"MXLPosition","navigatorTitle":[{"kind":"identifier","text":"MXLPosition"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLSystemRelation":{"role":"symbol","kind":"symbol","type":"topic","abstract":[{"text":"The system-relation type distinguishes elements that are associated with a system rather than the particular","type":"text"},{"text":" ","type":"text"},{"text":"part where the element appears. A value of only-top indicates that the element should appear only on the top","type":"text"},{"text":" ","type":"text"},{"text":"part of the current system. A value of also-top indicates that the element should appear on both the current","type":"text"},{"text":" ","type":"text"},{"text":"part and the top part of the current system. If this value appears in a score, when parts are created the","type":"text"},{"text":" ","type":"text"},{"text":"element should only appear once in this part, not twice. A value of none indicates that the element is","type":"text"},{"text":" ","type":"text"},{"text":"associated only with the current part, not with the system.","type":"text"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLSystemRelation"}],"navigatorTitle":[{"kind":"identifier","text":"MXLSystemRelation"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemRelation","title":"MXLSystemRelation","url":"\/documentation\/ivormxl\/mxlsystemrelation"},"doc://IvorMXL/documentation/IvorMXL/MXLHarmony/Chord-swift.struct":{"type":"topic","title":"MXLHarmony.Chord","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmony\/Chord-swift.struct","abstract":[{"text":"A harmony element can contain many stacked chords (e.g. V of II). A sequence of harmony-chord groups is used","type":"text"},{"text":" ","type":"text"},{"text":"for this type of secondary function, where V of II would be represented by a harmony-chord with a 5 numeral","type":"text"},{"text":" ","type":"text"},{"text":"followed by a harmony-chord with a 2 numeral.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Chord"}],"navigatorTitle":[{"kind":"identifier","text":"Chord"}],"url":"\/documentation\/ivormxl\/mxlharmony\/chord-swift.struct"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLHarmony/init(id:chord:frame:offset:footnote:level:staff:kind:printsObject:printsFrame:arrangement:position:font:color:placement:system:)":{"title":"init(id:chord:frame:offset:footnote:level:staff:kind:printsObject:printsFrame:arrangement:position:font:color:placement:system:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?, ","kind":"text"},{"text":"chord","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"Chord","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL10MXLHarmonyV5ChordV"},{"text":"], ","kind":"text"},{"text":"frame","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLFrame","kind":"typeIde