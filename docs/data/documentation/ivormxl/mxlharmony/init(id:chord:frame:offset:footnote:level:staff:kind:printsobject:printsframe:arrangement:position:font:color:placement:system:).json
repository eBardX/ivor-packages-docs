{"abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLHarmony"},{"type":"text","text":"."}],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"id"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"chord"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:7IvorMXL10MXLHarmonyV5ChordV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmony\/Chord-swift.struct","text":"Chord","kind":"typeIdentifier"},{"text":"] = [], ","kind":"text"},{"text":"frame","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL8MXLFrameV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFrame","text":"MXLFrame","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"offset","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL9MXLOffsetV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOffset","text":"MXLOffset","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"footnote","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL16MXLFormattedTextV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFormattedText","text":"MXLFormattedText","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"level","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL8MXLLevelV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLevel","text":"MXLLevel","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"staff","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL8MXLStaffV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaff","text":"MXLStaff","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"kind","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL10MXLHarmonyV4KindO","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmony\/Kind-swift.enum","text":"Kind","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"kind":"externalParam","text":"printsObject"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"},{"text":"? = nil, ","kind":"text"},{"text":"printsFrame","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"arrangement","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL21MXLHarmonyArrangementO","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmonyArrangement","text":"MXLHarmonyArrangement","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"position","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL11MXLPositionV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","text":"MXLPosition","kind":"typeIdentifier"},{"text":" = MXLPosition(), ","kind":"text"},{"text":"font","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL7MXLFontV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","text":"MXLFont","kind":"typeIdentifier"},{"text":" = MXLFont(), ","kind":"text"},{"text":"color","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL8MXLColorV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","text":"MXLColor","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"placement","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL13MXLAboveBelowO","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAboveBelow","text":"MXLAboveBelow","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"system","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL17MXLSystemRelationO","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemRelation","text":"MXLSystemRelation","kind":"typeIdentifier"},{"text":"? = nil)","kind":"text"}],"platforms":["macOS"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The optional-unique-id attribute group allows an element to optionally specify an ID"},{"type":"text","text":" "},{"type":"text","text":"that is unique to the entire document. This attribute group is not used for a"},{"type":"text","text":" "},{"type":"text","text":"required id attribute, or for an id attribute that specifies an id reference."}]}],"name":"id"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A harmony element can contain many stacked chords (e.g. V of II). A sequence of"},{"type":"text","text":" "},{"type":"text","text":"harmony-chord groups is used for this type of secondary function, where V of II would"},{"type":"text","text":" "},{"type":"text","text":"be represented by a harmony-chord with a 5 numeral followed by a harmony-chord with a"},{"type":"text","text":" "},{"type":"text","text":"2 numeral."}]}],"name":"chord"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A fretboard diagram to be printed with this harmony."}]}],"name":"frame"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Indicates where this harmony will appear relative to the current musical location, in"},{"type":"text","text":" "},{"type":"text","text":"divisions."}]}],"name":"offset"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The footnote element specifies editorial information that appears in footnotes in the"},{"type":"text","text":" "},{"type":"text","text":"printed score. It is defined within a group due to its multiple uses within the"},{"type":"text","text":" "},{"type":"text","text":"MusicXML schema."}]}],"name":"footnote"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The level element specifies editorial information for different MusicXML elements. It"},{"type":"text","text":" "},{"type":"text","text":"is defined within a group due to its multiple uses within the MusicXML schema."}]}],"name":"level"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The staff element is defined within a group due to its use by both notes and"},{"type":"text","text":" "},{"type":"text","text":"direction elements."}]}],"name":"staff"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Differentiates whether this harmony is explicit, implied, or an alternate analysis,"},{"type":"text","text":" "},{"type":"text","text":"when alternate harmonies are possible."}]}],"name":"kind"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A Boolean value indicating whether to print an object (e.g. a note or a rest)."},{"type":"text","text":" "},{"type":"text","text":"Defaults to "},{"type":"codeVoice","code":"true"},{"type":"text","text":" if not specified."}]}],"name":"printsObject"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A Boolean value indicating whether to print a frame or fretboard diagram for this"},{"type":"text","text":" "},{"type":"text","text":"harmony."}]}],"name":"printsFrame"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Specifies how multiple harmony-chord groups are arranged relative to each other."}]}],"name":"arrangement"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For most elements, any program will compute a default x and y position. The position"},{"type":"text","text":" "},{"type":"text","text":"attributes let this be changed two ways."}]}],"name":"position"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The font attribute group gathers together attributes for determining the font within"},{"type":"text","text":" "},{"type":"text","text":"a credit or direction. They are based on the text styles for Cascading Style Sheets."},{"type":"text","text":" "},{"type":"text","text":"The font-family is a comma-separated list of font names. The font-style can be normal"},{"type":"text","text":" "},{"type":"text","text":"or italic. The font-size can be one of the CSS sizes or a numeric point size. The"},{"type":"text","text":" "},{"type":"text","text":"font-weight can be normal or bold. The default is application-dependent, but is a"},{"type":"text","text":" "},{"type":"text","text":"text font vs. a music font."}]}],"name":"font"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The color attribute group indicates the color of an element."}]}],"name":"color"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The placement attribute indicates whether something is above or below another"},{"type":"text","text":" "},{"type":"text","text":"element, such as a note or a notation."}]}],"name":"placement"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The system-relation attribute group distinguishes elements that are associated with a"},{"type":"text","text":" "},{"type":"text","text":"system rather than the particular part where the element appears."}]}],"name":"system"}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmony"]]},"metadata":{"role":"symbol","roleHeading":"Initializer","title":"init(id:chord:frame:offset:footnote:level:staff:kind:printsObject:printsFrame:arrangement:position:font:color:placement:system:)","modules":[{"name":"IvorMXL"}],"externalID":"s:7IvorMXL10MXLHarmonyV2id5chord5frame6offset8footnote5level5staff4kind12printsObject0L5Frame11arrangement8position4font5color9placement6systemACSSSg_S