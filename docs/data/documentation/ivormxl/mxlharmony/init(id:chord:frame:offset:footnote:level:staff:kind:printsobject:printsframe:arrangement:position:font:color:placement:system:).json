ext":"? = nil, "},{"text":"staff","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaff","kind":"typeIdentifier","text":"MXLStaff","preciseIdentifier":"s:7IvorMXL8MXLStaffV"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"kind"},{"text":": ","kind":"text"},{"text":"Kind","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmony\/Kind-swift.enum","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL10MXLHarmonyV4KindO"},{"text":"? = nil, ","kind":"text"},{"text":"printsObject","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":"? = nil, ","kind":"text"},{"text":"printsFrame","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":"? = nil, ","kind":"text"},{"text":"arrangement","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLHarmonyArrangement","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmonyArrangement","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL21MXLHarmonyArrangementO"},{"text":"? = nil, ","kind":"text"},{"text":"position","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLPosition","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLPositionV"},{"text":" = MXLPosition(), ","kind":"text"},{"text":"font","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLFont","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL7MXLFontV"},{"text":" = MXLFont(), ","kind":"text"},{"text":"color","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLColor","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLColorV"},{"text":"? = nil, ","kind":"text"},{"text":"placement","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLAboveBelow","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAboveBelow","preciseIdentifier":"s:7IvorMXL13MXLAboveBelowO","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"system","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLSystemRelation","preciseIdentifier":"s:7IvorMXL17MXLSystemRelationO","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemRelation"},{"text":"? = nil)","kind":"text"}],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The optional-unique-id attribute group allows an element to optionally specify an ID that is unique to the entire document. This attribute group is not used for a required id attribute, or for an id attribute that specifies an id reference.","type":"text"}]}],"name":"id"},{"content":[{"type":"paragraph","inlineContent":[{"text":"A harmony element can contain many stacked chords (e.g. V of II). A sequence of harmony-chord groups is used for this type of secondary function, where V of II would be represented by a harmony-chord with a 5 numeral followed by a harmony-chord with a 2 numeral.","type":"text"}]}],"name":"chord"},{"content":[{"type":"paragraph","inlineContent":[{"text":"A fretboard diagram to be printed with this harmony.","type":"text"}]}],"name":"frame"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Indicates where this harmony will appear relative to the current musical location, in divisions.","type":"text"}]}],"name":"offset"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The footnote element specifies editorial information that appears in footnotes in the printed score. It is defined within a group due to its multiple uses within the MusicXML schema.","type":"text"}]}],"name":"footnote"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The level element specifies editorial information for different MusicXML elements. It is defined within a group due to its multiple uses within the MusicXML schema.","type":"text"}]}],"name":"level"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The staff element is defined within a group due to its use by both notes and direction elements.","type":"text"}]}],"name":"staff"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Differentiates whether this harmony is explicit, implied, or an alternate analysis, when alternate harmonies are possible.","type":"text"}]}],"name":"kind"},{"content":[{"type":"paragraph","inlineContent":[{"text":"A Boolean value indicating whether to print an object (e.g. a note or a rest). Defaults to ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" if not specified.","type":"text"}]}],"name":"printsObject"},{"content":[{"type":"paragraph","inlineContent":[{"text":"A Boolean value indicating whether to print a frame or fretboard diagram for this harmony.","type":"text"}]}],"name":"printsFrame"},{"content":[{"inlineContent":[{"type":"text","text":"Specifies how multiple harmony-chord groups are arranged relative to each other."}],"type":"paragraph"}],"name":"arrangement"},{"content":[{"inlineContent":[{"type":"text","text":"For most elements, any program will compute a default x and y position. The position attributes let this be changed two ways."}],"type":"paragraph"}],"name":"position"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The font attribute group gathers together attributes for determining the font within a credit or direction. They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of font names.The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font vs. a music font."}]}],"name":"font"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The color attribute group indicates the color of an element."}]}],"name":"color"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The placement attribute indicates whether something is above or below another element, such as a note or a notation."}]}],"name":"placement"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The system-relation attribute group distinguishes elements that are associated with a system rather than the particular part where the element appears."}]}],"name":"system"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlharmony\/init(id:chord:frame:offset:footnote:level:staff:kind:printsobject:printsframe:arrangement:position:font:color:placement:system:)"]}],"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"modules":[{"name":"IvorMXL"}],"symbolKind":"init","roleHeading":"Initializer","externalID":"s:7IvorMXL10MXLHarmonyV2id5chord5frame6offset8footnote5level5staff4kind12printsObject0L5Frame11arrangement8position4font5color9placement6systemACSSSg_SayAC5ChordVGAA8MXLFrameVSgAA9MXLOffsetVSgAA16MXLFormattedTextVSgAA8MXLLevelVSgAA8MXLStaffVSgAC4KindOSgSbSgA14_AA0C11ArrangementOSgAA11MXLPositionVAA7MXLFontVAA8MXLColorVSgAA13MXLAboveBelowOSgAA17MXLSystemRelationOSgtcfc","role":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"chord","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"Chord","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL10MXLHarmonyV5ChordV"},{"text":"], ","kind":"text"},{"text":"frame","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLFrame","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLFrameV"},{"text":"?, ","kind":"tex