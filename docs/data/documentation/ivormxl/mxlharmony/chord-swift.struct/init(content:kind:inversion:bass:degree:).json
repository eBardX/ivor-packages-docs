:"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBass","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"MXLBass","kind":"identifier"}],"abstract":[{"type":"text","text":"The bass type is used to indicate a bass note in popular music chord symbols, e.g. G\/C. It is generally not"},{"type":"text","text":" "},{"type":"text","text":"used in functional harmony, as inversion is generally not used in pop chord symbols. As with root, it is"},{"type":"text","text":" "},{"type":"text","text":"divided into step and alter elements, similar to pitches. The arrangement attribute specifies where the bass"},{"type":"text","text":" "},{"type":"text","text":"is displayed relative to what precedes it."}]},"doc://IvorMXL/documentation/IvorMXL/MXLDegree":{"type":"topic","url":"\/documentation\/ivormxl\/mxldegree","role":"symbol","title":"MXLDegree","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLDegree","kind":"identifier"}],"abstract":[{"text":"The degree type is used to add, alter, or subtract individual notes in the chord. The print-object attribute","type":"text"},{"text":" ","type":"text"},{"text":"can be used to keep the degree from printing separately when it has already taken into account in the text","type":"text"},{"text":" ","type":"text"},{"text":"attribute of the kind element. The degree-value and degree-type text attributes specify how the value and type","type":"text"},{"text":" ","type":"text"},{"text":"of the degree should be displayed.","type":"text"}],"navigatorTitle":[{"text":"MXLDegree","kind":"identifier"}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLHarmony/Chord-swift.struct/Kind-swift.struct":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlharmony\/chord-swift.struct\/kind-swift.struct","title":"MXLHarmony.Chord.Kind","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"text":"Kind","kind":"identifier"}],"navigatorTitle":[{"text":"Kind","kind":"identifier"}],"abstract":[{"type":"text","text":"Kind indicates the type of chord. Degree elements can then add, subtract, or alter from these starting points."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmony\/Chord-swift.struct\/Kind-swift.struct"},"doc://IvorMXL/documentation/IvorMXL/MXLHarmony":{"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLHarmony","kind":"identifier"}],"title":"MXLHarmony","navigatorTitle":[{"text":"MXLHarmony","kind":"identifier"}],"abstract":[{"text":"The harmony type represents harmony analysis, including chord symbols in popular music as well as functional","type":"text"},{"text":" ","type":"text"},{"text":"harmony analysis in classical music.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlharmony","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmony","role":"symbol"}}}