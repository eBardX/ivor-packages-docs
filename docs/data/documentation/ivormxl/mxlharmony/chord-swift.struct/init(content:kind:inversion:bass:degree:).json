","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLInversion","kind":"identifier"}],"title":"MXLInversion","navigatorTitle":[{"text":"MXLInversion","kind":"identifier"}],"abstract":[{"type":"text","text":"The inversion type represents harmony inversions. The value is a number indicating which inversion is used: 0"},{"type":"text","text":" "},{"type":"text","text":"for root position, 1 for first inversion, etc. The text attribute indicates how the inversion should be"},{"type":"text","text":" "},{"type":"text","text":"displayed in a score."}],"url":"\/documentation\/ivormxl\/mxlinversion","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLInversion","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLHarmony/Chord-swift.struct":{"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Chord","kind":"identifier"}],"title":"MXLHarmony.Chord","navigatorTitle":[{"text":"Chord","kind":"identifier"}],"abstract":[{"text":"A harmony element can contain many stacked chords (e.g. V of II). A sequence of harmony-chord groups is used","type":"text"},{"type":"text","text":" "},{"type":"text","text":"for this type of secondary function, where V of II would be represented by a harmony-chord with a 5 numeral"},{"type":"text","text":" "},{"type":"text","text":"followed by a harmony-chord with a 2 numeral."}],"url":"\/documentation\/ivormxl\/mxlharmony\/chord-swift.struct","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmony\/Chord-swift.struct","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLHarmony/Chord-swift.struct/init(content:kind:inversion:bass:degr