ibutes specify how the value and type","type":"text"},{"text":" ","type":"text"},{"text":"of the degree should be displayed.","type":"text"}],"title":"MXLDegree","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree","kind":"symbol","url":"\/documentation\/ivormxl\/mxldegree","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLDegree"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLBass":{"navigatorTitle":[{"kind":"identifier","text":"MXLBass"}],"abstract":[{"type":"text","text":"The bass type is used to indicate a bass note in popular music chord symbols, e.g. G\/C. It is generally not"},{"type":"text","text":" "},{"type":"text","text":"used in functional harmony, as inversion is generally not used in pop chord symbols. As with root, it is"},{"type":"text","text":" "},{"type":"text","text":"divided into step and alter elements, similar to pitches. The arrangement attribute specifies where the bass"},{"type":"text","text":" "},{"type":"text","text":"is displayed relative to what precedes it."}],"title":"MXLBass","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBass","kind":"symbol","url":"\/documentation\/ivormxl\/mxlbass","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLBass"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLHarmony/Chord-swift.struct/init(content:kind:inversion:bass:degree:)":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmony\/Chord-swift.struct\/init(content:kind:inversion:bass:degree:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"