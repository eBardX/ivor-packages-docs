t":": "},{"kind":"typeIdentifier","text":"MXLHarmony","preciseIdentifier":"s:7IvorMXL10MXLHarmonyV"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Chord","preciseIdentifier":"s:7IvorMXL10MXLHarmonyV5ChordV"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Content","preciseIdentifier":"s:7IvorMXL10MXLHarmonyV5ChordV7ContentO"},{"kind":"text","text":", "},{"kind":"externalParam","text":"kind"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Kind","preciseIdentifier":"s:7IvorMXL10MXLHarmonyV5ChordV4KindV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"inversion"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLInversion","preciseIdentifier":"s:7IvorMXL12MXLInversionV"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"bass"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLBass","preciseIdentifier":"s:7IvorMXL7MXLBassV"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"degree"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"MXLDegree","preciseIdentifier":"s:7IvorMXL9MXLDegreeV"},{"kind":"text","text":"])"}],"kind":"symbol","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLHarmony/Chord-swift.struct/Kind-swift.struct":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Kind","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmony\/Chord-swift.struct\/Kind-swift.struct","title":"MXLHarmony.Chord.Kind","kind":"symbol","navigatorTitle":[{"text":"Kind","kind":"identifier"}],"abstract":[{"type":"text","text":"Kind indicates the type of chord. Degree elements can then add, subtract, or alter from these starting points."}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlharmony\/chord-swift.struct\/kind-swift.struct"},"doc://IvorMXL/documentation/IvorMXL/MXLHarmony/Chord-swift.struct":{"role":"symbol","abstract":[{"text":"A harmony element can contain many stacked chords (e.g. V of II). A sequence of harmony-chord groups is used","type":"text"},{"text":" ","type":"text"},{"text":"for this type of secondary function, where V of II would be represented by a harmony-chord with a 5 numeral","type":"text"},{"text":" ","type":"text"},{"text":"followed by a harmony-chord with a 2 numeral.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmony\/Chord-swift.struct","url":"\/documentation\/ivormxl\/mxlharmony\/chord-swift.struct","title":"MXLHarmony.Chord","navigatorTitle":[{"kind":"identifier","text":"Chord"}],"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Chord"}]},"doc://IvorMXL/documentation/IvorMXL/MXLHarmony":{"role":"symbol","abstract":[{"text":"The harmony type represents harmony analysis, including chord symbols in popular music as well as functional","type":"text"},{"type":"text","text":" "},{"text":"harmony analysis in classical music.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmony","url":"\/documentation\/ivormxl\/mxlharmony","title":"MXLHarmony","navigatorTitle":[{"kind":"identifier","text":"MXLHarmony"}],"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLHarmony"}]},"doc://IvorMXL/documentation/IvorMXL/MXLBass":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLBass"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBass","title":"MXLBass","kind":"symbol","navigatorTitle":[{"text":"MXLBass","kind":"identifier"}],"abstract":[{"text":"The bass type is used to indicate a bass note in popular music chord symbols, e.g. G\/C. It is generally not","type":"text"},{"text":" ","type":"text"},{"text":"used in functional harmony, as inversion is generally not used in pop chord symbols. As with root, it is","type":"text"},{"text":" ","type":"text"},{"text":"divided into step and alter elements, similar to pitches. The arrangement attribute specifies where the bass","type":"text"},{"text":" ","type":"text"},{"text":"is displayed relative to what precedes it.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlbass"},"doc://IvorMXL/documentation/IvorMXL/MXLHarmony/Chord-swift.struct/Content-swift.enum":{"url":"\/documentation\/ivormxl\/mxlharmony\/chord-swift.struct\/content-swift.enum","title":"MXLHarmony.Chord.Content","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"Content"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmony\/Chord-swift.struct\/Content-swift.enum","navigatorTitle":[{"text":"Content","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"One of the alternatives for HarmonyChord.","type":"text"}],"type":"topic","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLDegree":{"role":"symbol","abstract":[{"text":"The degree type is used to add, alter, or subtract individual notes in the chord. The print-object attribute","type":"text"},{"text":" ","type":"text"},{"text":"can be used to keep the degree from printing separately when it has already taken into account in the text","type":"text"},{"text":" ","type":"text"},{"text":"attribute of the kind element. The degree-value and degree-type text attributes specify how the value and type","type":"text"},{"text":" ","type":"text"},{"text":"of the degree should be displayed.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree","url":"\/documentation\/ivormxl\/mxldegree","title":"MXLDegree","navigatorTitle":[{"kind":"identifier","text":"MXLDegree"}],"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLDegree"}]},"doc://IvorMXL/documentation/IvorMXL/MXLInversion":{"role":"symbol","kind":"symbol","url":"\/documentation\/ivormxl\/mxlinversion","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLInversion","abstract":[{"type":"text","text":"The inversion type represents harmony inversions. The value is a number indicating which inversion is used: 0"},{"type":"text","text":" "},{"type":"text","text":"for root position, 1 for first inversion, etc. The text attribute indicates how the inversion should be"},{"type":"text","text":" "},{"type":"text","text":"displayed in a score."}],"type":"topic","title":"MXLInversion","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLInversion"}],"navigatorTitle":[{"kind":"identifier","text":"MXLInversion"}]}}}