ony","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLHarmony"}],"abstract":[{"text":"The harmony type represents harmony analysis, including chord symbols in popular music as well as functional","type":"text"},{"text":" ","type":"text"},{"text":"harmony analysis in classical music.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmony","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLHarmony"}],"url":"\/documentation\/ivormxl\/mxlharmony"},"doc://IvorMXL/documentation/IvorMXL/MXLInversion":{"url":"\/documentation\/ivormxl\/mxlinversion","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLInversion","abstract":[{"type":"text","text":"The inversion type represents harmony inversions. The value is a number indicating which inversion is used: 0"},{"type":"text","text":" "},{"type":"text","text":"for root position, 1 for first inversion, etc. The text attribute indicates how the inversion should be"},{"type":"text","text":" "},{"type":"text","text":"displayed in a score."}],"title":"MXLInversion","kind":"symbol","role":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLInversion","kind":"identifier"}],"navigatorTitle":[{"text":"MXLInversion","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLDegree":{"title":"MXLDegree","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLDegree"}],"abstract":[{"type":"text","text":"The degree type is used to add, alter, or subtract individual notes in the chord. The print-object attribute"},{"type":"text","text":" "},{"type":"text","text":"can be used to keep the degree from printing separately when it has already taken into account in the text"},{"type":"text","text":" "},{"type":"text","text":"attribute of the kind element. The degree-value and degree-type text attributes specify how the value and type"},{"type":"text","text":" "},{"type":"text","text":"of the degree should be displayed."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDegree","role":"symbol","navigatorTitle":[{"text":"MXLDegree","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxldegree"},"doc://IvorMXL/documentation/IvorMXL/MXLHarmony/Chord-swift.struct/init(content:kind:inversion:bass:degree:)":{"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmony\/Chord-swift.struct\/init(content:kind:inversion:bass:degree:)","url":"\/documentation\/ivormxl\/mxlharmony\/chord-swift.struct\/init(content:kind:inversion:bass:degree:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"content"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL10MXLHarmonyV","text":"MXLHarmony"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL10MXLHarmonyV5ChordV","text":"Chord"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL10MXLHarmonyV5ChordV7ContentO","text":"Content"},{"kind":"text","text":", "},{"kind":"externalParam","text":"kind"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL10MXLHarmonyV5ChordV4KindV","text":"Kind"},{"kind":"text","text":", "},{"kind":"externalParam","text":"inversion"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL12MXLInversionV","text":"MXLInversion"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"bass"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL7MXLBassV","text":"MXLBass"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"degree"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLDegreeV","text":"MXLDegree"},{"kind":"text","text":"])"}],"abstract":[{"type":"text","text":"Creates a new "},{"code":"MXLHarmony.Chord","type":"codeVoice"},{"type":"text","text":"."}],"kind":"symbol","role":"symbol","title":"init(content:kind:inversion:bass:degree:)"},"doc://IvorMXL/documentation/IvorMXL/MXLBass":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLBass","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"MXLBass","kind":"identifier"}],"abstract":[{"type":"text","text":"The bass type is used to indicate a bass note in popular music chord symbols, e.g. G\/C. It is generally not"},{"type":"text","text":" "},{"type":"text","text":"used in functional harmony, as inversion is generally not used in pop chord symbols. As with root, it is"},{"type":"text","text":" "},{"type":"text","text":"divided into step and alter elements, similar to pitches. The arrangement attribute specifies where the bass"},{"type":"text","text":" "},{"type":"text","text":"is displayed relative to what precedes it."}],"url":"\/documentation\/ivormxl\/mxlbass","title":"MXLBass","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBass","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLHarmony/Chord-swift.struct/Kind-swift.struct":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlharmony\/chord-swift.struct\/kind-swift.struct","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmony\/Chord-swift.struct\/Kind-swift.struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Kind"}],"abstract":[{"type":"text","text":"Kind indicates the type of chord. Degree elements can then add, subtract, or alter from these starting points."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Kind"}],"title":"MXLHarmony.Chord.Kind"},"doc://IvorMXL/documentation/IvorMXL/MXLHarmony/Chord-swift.struct":{"title":"MXLHarmony.Chord","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Chord"}],"abstract":[{"text":"A harmony element can contain many stacked chords (e.g. V of II). A sequence of harmony-chord groups is used","type":"text"},{"text":" ","type":"text"},{"text":"for this type of secondary function, where V of II would be represented by a harmony-chord with a 5 numeral","type":"text"},{"text":" ","type":"text"},{"text":"followed by a harmony-chord with a 2 numeral.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmony\/Chord-swift.struct","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Chord"}],"url":"\/documentation\/ivormxl\/mxlharmony\/chord-swift.struct"}}}