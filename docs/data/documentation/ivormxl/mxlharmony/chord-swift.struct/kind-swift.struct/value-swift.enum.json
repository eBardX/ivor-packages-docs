ontent":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Triads: major (major third, perfect fifth) minor (minor third, perfect fifth) augmented (major third,"},{"type":"text","text":" "},{"type":"text","text":"augmented fifth) diminished (minor third, diminished fifth) Sevenths: dominant (major triad, minor seventh)"},{"type":"text","text":" "},{"type":"text","text":"major-seventh (major triad, major seventh) minor-seventh (minor triad, minor seventh) diminished-seventh"},{"type":"text","text":" "},{"type":"text","text":"(diminished triad, diminished seventh) augmented-seventh (augmented triad, minor seventh) half-diminished"},{"type":"text","text":" "},{"type":"text","text":"(diminished triad, minor seventh) major-minor (minor triad, major seventh) Sixths: major-sixth (major triad,"},{"type":"text","text":" "},{"type":"text","text":"added sixth) minor-sixth (minor triad, added sixth) Ninths: dominant-ninth (dominant-seventh, major ninth)"},{"type":"text","text":" "},{"type":"text","text":"major-ninth (major-seventh, major ninth) minor-ninth (minor-seventh, major ninth) 11ths (usually as the basis"},{"type":"text","text":" "},{"type":"text","text":"for alteration): dominant-11th (dominant-ninth, perfect 11th) major-11th (major-ninth, perfect 11th)"},{"type":"text","text":" "},{"type":"text","text":"minor-11th (minor-ninth, perfect 11th) 13ths (usually as the basis for alteration): dominant-13th"},{"type":"text","text":" "},{"type":"text","text":"(dominant-11th, major 13th) major-13th (major-11th, major 13th) minor-13th (minor-11th, major 13th) Suspended:"},{"type":"text","text":" "},{"type":"text","text":"suspended-second (major second, perfect fifth) suspended-fourth (perfect fourth, perfect fifth) Functional"},{"type":"text","text":" "},{"type":"text","text":"sixths: Neapolitan Italian French German Other: pedal (pedal-point bass) power (perfect fifth) Tristan"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The “other” kind is used when the harmony is entirely composed of add elements."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The “none” kind is used to explicitly encode absence of chords or functional harmony. In this case, the root,"},{"type":"text","text":" "},{"type":"text","text":"numeral, or function element has no meaning. When using the root or numeral element, the root-step or numeral-"},{"type":"text","text":" "},{"type":"text","text":"step text attribute should be set to the empty string to keep the root or numeral from being displayed."}]}],"kind":"content"}],"abstract":[{"text":"A kind-value indicates the type of chord. Degree elements can then add, subtract, or alter from these starting","type":"text"},{"type":"text","text":" "},{"text":"points. Values include:","type":"text"}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLHarmony/Chord-swift.struct/Kind-swift.struct/Value-swift.enum/suspendedFourth":{"abstract":[{"type":"text","text":"A suspended fourth chord (perfect fourth, perfect fifth)."}],"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"suspendedFourth","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlharmony\/chord-swift.struct\/kind-swift.struct\/value-swift.enum\/suspendedfourth","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmony\/Chord-swift.struct\/Kind-swift.struct\/Value-swift.enum\/suspendedFourth","type":"topic","role":"symbol","title":"MXLHarmony.Chord.Kind.Value.suspendedFourth"},"doc://IvorMXL/documentation/IvorMXL/MXLHarmony/Chord-swift.struct/Kind-swift.struct/Value-swift.enum/majorSixth":{"abstract":[{"type":"text","text":"A major sixth chord (major triad, added sixth)."}],"type":"topic","title":"MXLHarmony.Chord.Kind.Value.majorSixth","kind":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"majorSixth","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL