 used"},{"type":"text","text":" "},{"type":"text","text":"for this type of secondary function, where V of II would be represented by a harmony-chord with a 5 numeral"},{"type":"text","text":" "},{"type":"text","text":"followed by a harmony-chord with a 2 numeral."}],"navigatorTitle":[{"text":"Chord","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLHarmony/Chord-swift.struct/Kind-swift.struct":{"title":"MXLHarmony.Chord.Kind","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Kind","kind":"identifier"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlharmony\/chord-swift.struct\/kind-swift.struct","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmony\/Chord-swift.struct\/Kind-swift.struct","abstract":[{"type":"text","text":"Kind indicates the type of chord. Degree elements can then add, subtract, or alter from these starting points."}],"navigatorTitle":[{"text":"Kind","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLHarmony/Chord-swift.struct/Kind-swift.struct/color":{"title":"color","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"color","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLColor","preciseIdentifier":"s:7IvorMXL8MXLColorV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxlharmony\/chord-swift.struct\/kind-swift.struct\/color","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmony\/Chord-swift.struct\/Kind-swift.struct\/color","abstract":[{"type":"text","text":"The color attribute group indicates the color of an element."}]}}}