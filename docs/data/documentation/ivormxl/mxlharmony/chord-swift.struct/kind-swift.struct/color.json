 this type of secondary function, where V of II would be represented by a harmony-chord with a 5 numeral"},{"type":"text","text":" "},{"type":"text","text":"followed by a harmony-chord with a 2 numeral."}],"url":"\/documentation\/ivormxl\/mxlharmony\/chord-swift.struct","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmony\/Chord-swift.struct","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLHarmony/Chord-swift.struct/Kind-swift.struct":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlharmony\/chord-swift.struct\/kind-swift.struct","title":"MXLHarmony.Chord.Kind","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"text":"Kind","kind":"identifier"}],"navigatorTitle":[{"text":"Kind","kind":"identifier"}],"abstract":[{"type":"text","text":"Kind indicates the type of chord. Degree elements can then add, subtract, or alter from these starting points."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmony\/Chord-swift.struct\/Kind-swift.struct"},"doc://IvorMXL/documentation/IvorMXL/MXLHarmony":{"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLHarmony","kind":"identifier"}],"title":"MXLHarmony","navigatorTitle":[{"text":"MXLHarmony","kind":"identifier"}],"abstract":[{"text":"The harmony type represents harmony analysis, including chord symbols in popular music as well as functional","type":"text"},{"text":" ","type":"text"},{"text":"harmony analysis in classical music.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlharmony","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmony","role":"symbol"}}}