d.Kind","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmony\/Chord-swift.struct\/Kind-swift.struct","abstract":[{"text":"Kind indicates the type of chord. Degree elements can then add, subtract, or alter from these starting points.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Kind"}],"navigatorTitle":[{"kind":"identifier","text":"Kind"}],"url":"\/documentation\/ivormxl\/mxlharmony\/chord-swift.struct\/kind-swift.struct"},"doc://IvorMXL/documentation/IvorMXL/MXLHarmony/Chord-swift.struct":{"type":"topic","title":"MXLHarmony.Chord","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmony\/Chord-swift.struct","abstract":[{"text":"A harmony element can contain many stacked chords (e.g. V of II). A sequence of harmony-chord groups is used","type":"text"},{"text":" ","type":"text"},{"text":"for this type of secondary function, where V of II would be represented by a harmony-chord with a 5 numeral","type":"text"},{"text":" ","type":"text"},{"text":"followed by a harmony-chord with a 2 numeral.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Chord"}],"navigatorTitle":[{"kind":"identifier","text":"Chord"}],"url":"\/documentation\/ivormxl\/mxlharmony\/chord-swift.struct"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"}}}