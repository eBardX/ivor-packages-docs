eciseIdentifier":"s:7IvorMXL9MXLValignO"},{"text":"? = nil)","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The value of this element.","type":"text"}]}],"name":"value"},{"name":"usesSymbols","content":[{"type":"paragraph","inlineContent":[{"text":"A Boolean value indicating whether the kind should be represented when possible with harmony symbols rather than letters and numbers.","type":"text"}]}]},{"name":"text","content":[{"inlineContent":[{"type":"text","text":"Describes how the kind should be spelled in a score. If "},{"type":"codeVoice","code":"usesSymbols"},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":", the value of "},{"code":"text","type":"codeVoice"},{"type":"text","text":" follows the symbol."}],"type":"paragraph"}]},{"name":"areDegreesStacked","content":[{"type":"paragraph","inlineContent":[{"text":"A Boolean value indicating whether the degree elements should be stacked above each other.","type":"text"}]}]},{"name":"areDegreesInParentheses","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A Boolean value indicating whether all the degrees should be in parentheses."}]}]},{"name":"areDegreesBracketed","content":[{"type":"paragraph","inlineContent":[{"text":"A Boolean value indicating whether all the degrees should be in a bracket.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For most elements, any program will compute a default x and y position. The position attributes let this be changed two ways."}]}],"name":"position"},{"name":"font","content":[{"type":"paragraph","inlineContent":[{"text":"The font attribute group gathers together attributes for determining the font within a credit or direction. They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of font names.The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font vs. a music font.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The color attribute group indicates the color of an element."}]}],"name":"color"},{"name":"halign","content":[{"type":"paragraph","inlineContent":[{"text":"In cases where text extends over more than one line, horizontal alignment and justify values can be different. The most typical case is for credits, such as:","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The valign attribute is used to indicate vertical alignment to the top, middle, bottom, or baseline of the text. Defaults are implementation-dependent."}]}],"name":"valign"}]}],"variants":[{"paths":["\/documentation\/ivormxl\/mxlharmony\/chord-swift.struct\/kind-swift.struct\/init(value:usessymbols:text:aredegreesstacked:aredegreesinparentheses:aredegreesbracketed:position:font:color:halign:valign:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLHarmony/Chord-swift.struct/Kind-swift.struct":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Kind","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmony\/Chord-swift.struct\/Kind-swift.struct","title":"MXLHarmony.Chord.Kind","kind":"symbol","navigatorTitle":[{"text":"Kind","kind":"identifier"}],"abstract":[{"type":"text","text":"Kind indicates the type of chord. Degree elements can then add, subtract, or alter from these starting points."}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlharmony\/chord-swift.struct\/kind-swift.struct"},"doc://IvorMXL/documentation/IvorMXL/MXLPosition":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","type":"topic","navigatorTitle":[{"kind":"identifie