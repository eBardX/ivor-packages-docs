{"variants":[{"paths":["\/documentation\/ivormxl\/mxlharmony\/chord-swift.struct\/kind-swift.struct"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmony\/Chord-swift.struct\/Kind-swift.struct"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmony","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmony\/Chord-swift.struct"]]},"topicSections":[{"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmony\/Chord-swift.struct\/Kind-swift.struct\/init(value:usesSymbols:text:areDegreesStacked:areDegreesInParentheses:areDegreesBracketed:position:font:color:halign:valign:)"],"title":"Initializers","generated":true,"anchor":"Initializers"},{"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmony\/Chord-swift.struct\/Kind-swift.struct\/areDegreesBracketed","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmony\/Chord-swift.struct\/Kind-swift.struct\/areDegreesInParentheses","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmony\/Chord-swift.struct\/Kind-swift.struct\/areDegreesStacked","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmony\/Chord-swift.struct\/Kind-swift.struct\/color","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmony\/Chord-swift.struct\/Kind-swift.struct\/font","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmony\/Chord-swift.struct\/Kind-swift.struct\/halign","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmony\/Chord-swift.struct\/Kind-swift.struct\/position","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmony\/Chord-swift.struct\/Kind-swift.struct\/text","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmony\/Chord-swift.struct\/Kind-swift.struct\/usesSymbols","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmony\/Chord-swift.struct\/Kind-swift.struct\/valign","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmony\/Chord-swift.struct\/Kind-swift.struct\/value-swift.property"],"title":"Instance Properties","generated":true,"anchor":"Instance-Properties"},{"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmony\/Chord-swift.struct\/Kind-swift.struct\/Value-swift.enum"],"title":"Enumerations","generated":true,"anchor":"Enumerations"},{"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmony\/Chord-swift.struct\/Kind-swift.struct\/Equatable-Implementations"],"title":"Default Implementations","generated":true,"anchor":"Default-Implementations"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Kind","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"inlineContent":[{"type":"text","text":"The attributes are used to indicate the formatting of the symbol. Since the kind element is the constant in"},{"type":"text","text":" "},{"type":"text","text":"all the harmony-chord groups that can make up a polychord, many formatting attributes are here."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"The use-symbols attribute is yes if the kind should be represented when possible with harmony symbols rather","type":"text"},{"text":" ","type":"text"},{"text":"than letters and numbers. These symbols include:","type":"text"}]},{"inlineContent":[{"type":"text","text":"major: a triangle, like Unicode 25B3 minor: -, like Unicode 002D augmented: +, like Unicode 002B diminished:"},{"type":"text","text":" "},{"text":"°, like Unicode 00B0 half-diminished: ø, like Unicode 00F8","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For the major-minor kind, only the minor symbol is used when use-symbols is yes. The major symbol is set using"},{"type":"text","text":" "},{"type":"text","text":"the symbol attribute in the degree-value element. The corresponding degree-alter value will usually be 0 in"},{"type":"text","text":" "},{"type":"text","text":"this case."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The text attribute describes how the kind should be spelled in a score. If use-symbols is yes, the value of"},{"text":" ","type":"text"},{"text":"the text attribute follows the symbol. The stack-degrees attribute is yes if the degree elements should be","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"stacked above each other. The parentheses-degrees attribute is yes if all the degrees should be in"},{"text":" ","type":"text"},{"type":"text","text":"parentheses. The bracket-degrees attribute is yes if all the degrees should be in a bracket. If not specified,"},{"type":"text","text":" "},{"type":"text","text":"these values are implementation-specific. The alignment attributes are for the entire harmony-chord group of"},{"type":"text","text":" "},{"type":"text","text":"which this kind element is a part."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The text attribute may use strings such as “13sus” that refer to both the kind and one or more degree"},{"type":"text","text":" "},{"type":"text","text":"elements. In this case, the corresponding degree elements should have the print-object attribute set to “no”"},{"type":"text","text":" "},{"type":"text","text":"to keep redundant alterations from being displayed."}],"type":"paragraph"}]}],"abstract":[{"text":"Kind indicates the type of chord. Degree elements can then add, subtract, or alter from these starting points.","type":"text"}],"sections":[],"metadata":{"externalID":"s:7IvorMXL10MXLHarmonyV5ChordV4KindV","extendedModule":"IvorMXL","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Kind","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"text":"Kind","kind":"identifier"}],"modules":[{"name":"IvorMXL"}],"title":"MXLHarmony.Chord.Kind","roleHeading":"Structure","symbolKind":"struct"