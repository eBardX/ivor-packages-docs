MXLHarmony.Chord","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Chord"}],"abstract":[{"text":"A harmony element can contain many stacked chords (e.g. V of II). A sequence of harmony-chord groups is used","type":"text"},{"text":" ","type":"text"},{"text":"for this type of secondary function, where V of II would be represented by a harmony-chord with a 5 numeral","type":"text"},{"text":" ","type":"text"},{"text":"followed by a harmony-chord with a 2 numeral.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmony\/Chord-swift.struct","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Chord"}],"url":"\/documentation\/ivormxl\/mxlharmony\/chord-swift.struct"},"doc://IvorMXL/documentation/IvorMXL/MXLBass":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLBass","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"MXLBass","kind":"identifier"}],"abstract":[{"type":"text","text":"The bass type is used to indicate a bass note in popular music chord symbols, e.g. G\/C. It is generally not"},{"type":"text","text":" "},{"type":"text","text":"used in functional harmony, as inversion is generally not used in pop chord symbols. As with root, it is"},{"type":"text","text":" "},{"type":"text","text":"divided into step and alter elements, similar to pitches. The arrangement attribute specifies where the bass"},{"type":"text","text":" "},{"type":"text","text":"is displayed relative to what precedes it."}],"url":"\/documentation\/ivormxl\/mxlbass","title":"MXLBass","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBass","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLHarmony":{"title":"MXLHarmony","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLHarmony"}],"abstract":[{"text":"The harmony type represents harmony analysis, including chord symbols in popular music as well as functional","type":"text"},{"text":" ","type":"text"},{"text":"harmony analysis in classical music.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmony","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLHarmony"}],"url":"\/documentation\/ivormxl\/mxlharmony"},"doc://IvorMXL/documentation/IvorMXL/MXLHarmony/Chord-swift.struct/bass":{"type":"topic","url":"\/documentation\/ivormxl\/mxlharmony\/chord-swift.struct\/bass","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmony\/Chord-swift.struct\/bass","title":"bass","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"bass"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLBass","preciseIdentifier":"s:7IvorMXL7MXLBassV"},{"kind":"text","text":"?"}],"abstract":[{"type":"text","text":"The bass note used in popular music chord symbols (e.g. the C in G\/C), generally not used together with"},{"type":"text","text":" "},{"type":"text","text":"an inversion."}]}}}