pe":"text"},{"text":"an inversion.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlharmony\/chord-swift.struct\/bass","kind":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"bass"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLBass","preciseIdentifier":"s:7IvorMXL7MXLBassV"},{"kind":"text","text":"?"}]},"doc://IvorMXL/documentation/IvorMXL/MXLHarmony":{"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLHarmony","kind":"identifier"}],"title":"MXLHarmony","navigatorTitle":[{"text":"MXLHarmony","kind":"identifier"}],"abstract":[{"text":"The harmony type represents harmony analysis, including chord symbols in popular music as well as functional","type":"text"},{"text":" ","type":"text"},{"text":"harmony analysis in classical music.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlharmony","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmony","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLBass":{"title":"MXLBass","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLBass","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlbass","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBass","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"MXLBass","kind":"identifier"}],"abstract":[{"type":"text","text":"The bass type is used to indicate a bass note in popular music chord symbols, e.g. G\/C. It is generally not"},{"type":"text","text":" "},{"type":"text","text":"used in functional harmony, as inversion is generally not used in pop chord symbols. As with root, it is"},{"type":"text","text":" "},{"type":"text","text":"divided into step and alter elements, similar to pitches. The arrangement attribute specifies where the bass"},{"type":"text","text":" "},{"type":"text","text":"is displayed relative to what precedes it."}]},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLHarmony/Chord-swift.struct":{"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Chord","kind":"identifier"}],"title":"MXLHarmony.Chord","navigatorTitle":[{"text":"Chord","kind":"identifier"}],"abstract":[{"text":"A harmony element can contain many stacked chords (e.g. V of II). A sequence of harmony-chord groups is used","type":"text"},{"type":"text","text":" "},{"type":"text","text":"for this type of secondary function, where V of II would be represented by a harmony-chord with a 5 numeral"},{"type":"text","text":" "},{"type":"text","text":"followed by a harmony-chord with a 2 numeral."}],"url":"\/documentation\/ivormxl\/mxlharmony\/chord-swift.struct","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmony\/Chord-swift.struct","role":"symbol"}}}