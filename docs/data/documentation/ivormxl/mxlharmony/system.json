:"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSystemRelation","kind":"identifier"}],"abstract":[{"text":"The system-relation type distinguishes elements that are associated with a system rather than the particular","type":"text"},{"text":" ","type":"text"},{"text":"part where the element appears. A value of only-top indicates that the element should appear only on the top","type":"text"},{"text":" ","type":"text"},{"text":"part of the current system. A value of also-top indicates that the element should appear on both the current","type":"text"},{"text":" ","type":"text"},{"text":"part and the top part of the current system. If this value appears in a score, when parts are created the","type":"text"},{"text":" ","type":"text"},{"text":"element should only appear once in this part, not twice. A value of none indicates that the element is","type":"text"},{"text":" ","type":"text"},{"text":"associated only with the current part, not with the system.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemRelation","role":"symbol","navigatorTitle":[{"text":"MXLSystemRelation","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlsystemrelation"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLHarmony/system":{"title":"system","kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"system","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLSystemRelation","preciseIdentifier":"s:7IvorMXL17MXLSystemRelationO","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"abstract":[{"text":"The system-relation attribute group distinguishes elements that are associated with a system rather th