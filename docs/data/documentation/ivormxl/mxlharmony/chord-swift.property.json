{"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmony\/chord-swift.property"},"abstract":[{"type":"text","text":"A harmony element can contain many stacked chords (e.g. V of II). A sequence of harmony-chord groups is used"},{"type":"text","text":" "},{"type":"text","text":"for this type of secondary function, where V of II would be represented by a harmony-chord with a 5 numeral"},{"type":"text","text":" "},{"type":"text","text":"followed by a harmony-chord with a 2 numeral."}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmony"]]},"sections":[],"variants":[{"paths":["\/documentation\/ivormxl\/mxlharmony\/chord-swift.property"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"symbolKind":"property","role":"symbol","roleHeading":"Instance Property","externalID":"s:7IvorMXL10MXLHarmonyV5chordSayAC5ChordVGvp","modules":[{"name":"IvorMXL"}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"chord","kind":"identifier"},{"text":": [","kind":"text"},{"text":"Chord","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL10MXLHarmonyV5ChordV"},{"text":"]","kind":"text"}],"title":"chord"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"chord"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"Chord","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmony\/Chord-swift.struct","preciseIdentifier":"s:7IvorMXL10MXLHarmonyV5ChordV"},{"kind":"text","text":"]"}],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"type":"heading","anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A root is a pitch name like C, D, E, while a numeral is a scale degree 