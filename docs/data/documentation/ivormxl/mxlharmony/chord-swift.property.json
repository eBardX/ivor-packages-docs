{"metadata":{"role":"symbol","title":"chord","roleHeading":"Instance Property","externalID":"s:7IvorMXL10MXLHarmonyV5chordSayAC5ChordVGvp","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"chord","kind":"identifier"},{"text":": [","kind":"text"},{"text":"Chord","preciseIdentifier":"s:7IvorMXL10MXLHarmonyV5ChordV","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"modules":[{"name":"IvorMXL"}],"symbolKind":"property"},"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmony"]]},"kind":"symbol","primaryContentSections":[{"declarations":[{"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"chord","kind":"identifier"},{"text":": [","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmony\/Chord-swift.struct","text":"Chord","preciseIdentifier":"s:7IvorMXL10MXLHarmonyV5ChordV","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"A root is a pitch name like C, D, E, while a numeral is a scale degree like 1, 2, 3. The root element is"},{"type":"text","text":" "},{"type":"text","text":"generally used with pop chord symbols, while the numeral element is generally used with classical functional"},{"type":"text","text":" "},{"type":"text","text":"harmony and Nashville numbers. It is an either\/or choice to avoid data inconsistency. The function element,"},{"type":"text","text":" "},{"type":"text","text":"which represents Roman numerals with roman numeral text, has been deprecated as of MusicXML 4.0."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Maps to a nested MusicXML "},{"type":"codeVoice","code":"<harmony-chord>"},{"type":"text","text":" element."}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"text":"A harmony element can contain many stacked chords (e.g. V of II). A sequence of harmony-chord groups is used","type":"text"},{"text":" ","type":"text"},{"text":"for this type of secondary function, where V of II would be represented by a harmony-chord with a 5 numeral","type":"text"},{"text":" ","type":"text"},{"text":"followed by a harmony-chord with a 2 numeral.","type":"text"}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmony\/chord-swift.property","interfaceLanguage":"swift"},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlharmony\/chord-swift.property"]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLHarmony/chord-swift.property":{"title":"chord","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"chord","kind":"identifier"},{"text":": [","kind":"text"},{"text":"Chord","preciseIdentifier":"s:7IvorMXL10MXLHarmonyV5ChordV","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxlharmony\/chord-swift.property","abstract":[{"text":"A harmony element can contain many stacked chords (e.g. V of II). A sequence of harmony-chord groups is used","type":"text"},{"text":" ","type":"text"},{"text":"for this type of secondary function, where V of II would be represented by a harmony-chord with a 5 numeral","type":"text"},{"text":" ","type":"text"},{"text":"followed by a harmony-chord with a 2 numeral.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmony\/chord-swift.property"},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLHarmony/Chord-