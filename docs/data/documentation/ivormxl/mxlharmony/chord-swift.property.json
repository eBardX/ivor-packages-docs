{"abstract":[{"type":"text","text":"A harmony element can contain many stacked chords (e.g. V of II). A sequence of harmony-chord groups is used"},{"type":"text","text":" "},{"type":"text","text":"for this type of secondary function, where V of II would be represented by a harmony-chord with a 5 numeral"},{"type":"text","text":" "},{"type":"text","text":"followed by a harmony-chord with a 2 numeral."}],"metadata":{"modules":[{"name":"IvorMXL"}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"chord","kind":"identifier"},{"text":": [","kind":"text"},{"text":"Chord","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL10MXLHarmonyV5ChordV"},{"text":"]","kind":"text"}],"roleHeading":"Instance Property","symbolKind":"property","role":"symbol","title":"chord","externalID":"s:7IvorMXL10MXLHarmonyV5chordSayAC5ChordVGvp"},"variants":[{"paths":["\/documentation\/ivormxl\/mxlharmony\/chord-swift.property"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"chord","kind":"identifier"},{"text":": [","kind":"text"},{"text":"Chord","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmony\/Chord-swift.struct","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL10MXLHarmonyV5ChordV"},{"text":"]","kind":"text"}]}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A root is a pitch name like C, D, E, while a numeral is a scale degree like 1, 2, 3. The root element is"},{"type":"text","text":" "},{"type":"text","text":"generally used with pop chord symbols, while the numeral element is generally used with classical functional"},{"type":"text","text":" "},{"type":"text","text":"harmony and Nashville numbers. It is an either\/or choice to avoid data inconsistency. The function element,"},{"type":"text","text":" "},{"type":"text","text":"which represents Roman numerals with roman numeral text, has been deprecated as of MusicXML 4.0."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Maps to a nested MusicXML "},{"type":"codeVoice","code":"<harmony-chord>"},{"type":"text","text":" element."}]}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmony"]]},"kind":"symbol","sections":[],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmony\/chord-swift.property","interfaceLanguage":"swift"},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLHarmony/chord-swift.property":{"abstract":[{"type":"text","text":"A harmony element can contain many stacked chords (e.g. V of II). A sequence of harmony-chord groups is used"},{"type":"text","text":" "},{"type":"text","text":"for this type of secondary function, where V of II would be represented by a harmony-chord with a 5 numeral"},{"type":"text","text":" "},{"type":"text","text":"followed by a harmony-chord with a 2 numeral."}],"url":"\/documentation\/ivormxl\/mxlharmony\/chord-swift.property","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"chord"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL10MXLHarmonyV5ChordV","text":"Chord"},{"kind":"text","text":"]"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmony\/chord-swift.property","role":"symbol","title":"chord","type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLHarmony":{"title":"MXLHarmony","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLHarmony"}],"abstract":[{"text":"The harmony type represents harmony analysis, including chord symbols in popular music as well as functional","type":"text"},{"text":" ","type":"text"},{"text":"harmony analysis in classical music.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmony","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLHarmony"}],"url":"\/documentation\/ivormxl\/mxlharmony"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLHarmony/Chord-swift.struct":{"title":"MXLHarmony.Chord","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Chord"}],"abstract":[{"text":"A harmony element can contain many stacked chords (e.g. V of II). A sequence of harmony-chord groups is used","type":"text"},{"text":" ","type":"text"},{"text":"for this type of secondary function, where V of II would be represented by a harmony-chord with a 5 numeral","type":"text"},{"text":" ","type":"text"},{"text":"followed by a harmony-chord with a 2 numeral.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHarmony\/Chord-swift.struct","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Chord"}],"url":"\/documentation\/ivormxl\/mxlharmony\/chord-swift.struct"}}}