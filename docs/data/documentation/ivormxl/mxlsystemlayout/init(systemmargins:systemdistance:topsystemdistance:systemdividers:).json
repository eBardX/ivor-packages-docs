mDividersV","kind":"typeIdentifier","text":"MXLSystemDividers"},{"kind":"text","text":"?)"}],"role":"symbol"},"references":{"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLSystemLayout/init(systemMargins:systemDistance:topSystemDistance:systemDividers:)":{"abstract":[{"type":"text","text":"Creates a new "},{"code":"MXLSystemLayout","type":"codeVoice"},{"type":"text","text":"."}],"title":"init(systemMargins:systemDistance:topSystemDistance:systemDividers:)","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemLayout\/init(systemMargins:systemDistance:topSystemDistance:systemDividers:)","kind":"symbol","url":"\/documentation\/ivormxl\/mxlsystemlayout\/init(systemmargins:systemdistance:topsystemdistance:systemdividers:)","type":"topic","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"systemMargins"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL16MXLSystemMarginsV","kind":"typeIdentifier","text":"MXLSystemMargins"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"systemDistance"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL9MXLTenthsa","kind":"typeIdentifier","text":"MXLTenths"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"topSystemDistance"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL9MXLTenthsa","kind":"typeIdentifier","text":"MXLTenths"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"systemDividers"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL17MXLSystemDividersV","kind":"typeIdentifier","text":"MXLSystemDividers"},{"kind":"text","text":"?)"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLTenths":{"abstract":[{"text":"The tenths type is a number representing tenths of interline staff space (positive or negative). Both integer","type":"text"},{"text":" ","type":"text"},{"text":"and decimal values are allowed, such as 5 for a half space and 2.5 for a quarter space. Interline space is","type":"text"},{"text":" ","type":"text"},{"text":"measured from the middle of a staff line.","type":"text"}],"title":"MXLTenths","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTenths"}],"navigatorTitle":[{"kind":"identifier","text":"MXLTenths"}],"type":"topic","url":"\/documentation\/ivormxl\/mxltenths","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths"},"doc://IvorMXL/documentation/IvorMXL/MXLSystemDividers":{"title":"MXLSystemDividers","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLSystemDividers"}],"kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxlsystemdividers","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemDividers","abstract":[{"text":"The system-dividers element indicates the presence or absence of system dividers (also known as system","type":"text"},{"type":"text","text":" "},{"text":"separation marks) between systems displayed on the same page. Dividers on the left and right side of the page","type":"text"},{"text":" ","type":"text"},{"text":"are controlled by the left-divider and right-divider elements respectively. The default vertical position is","type":"text"},{"text":" ","type":"text"},{"text":"half the system-distance value from the top of the system that is below the divider. The default horizontal","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"position is the left and right system margin, respectively."}],"navigatorTitle":[{"kind":"identifier","text":"MXLSystemDividers"}]},"doc://IvorMXL/documentation/IvorMXL/MXLSystemLayout":{"navigatorTitle":[{"text":"MXLSystemLayout","kind":"identifier"}],"abstract":[{"text":"A system is a group of staves that are read and played simultaneously. System layout includes left and right","type":"text"},{"text":" ","type":"text"},{"text":"margins and the vertical distance from the previous system. The system distance is measured from the bottom","type":"text"},{"text":" ","type":"text"},{"text":"line of the previous system to the top line of the current system. It is ignored for the first system on a","type":"text"},{"text":" ","type":"text"},{"text":"page. The top system distance is measured from the page’s top margin to the top line of the first system. It","type":"text"},{"text":" ","type":"text"},{"text":"is ignored for all but the first system on a page.","type":"text"}],"title":"MXLSystemLayout","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemLayout","kind":"symbol","url":"\/documentation\/ivormxl\/mxlsystemlayout","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSystemLayout","kind":"identifier"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLSystemMargins":{"abstract":[{"text":"System margins are relative to the page margins. Positive values indent and negative values reduce the margin","type":"text"},{"text":" ","type":"text"},{"text":"size.","type":"text"}],"title":"MXLSystemMargins","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSystemMargins","kind":"identifier"}],"navigatorTitle":[{"text":"MXLSystemMargins","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlsystemmargins","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemMargins"}}}