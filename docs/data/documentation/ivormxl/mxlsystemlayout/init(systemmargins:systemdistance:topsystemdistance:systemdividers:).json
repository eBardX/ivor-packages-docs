","kind":"text"},{"text":"systemDistance","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL9MXLTenthsa","text":"MXLTenths","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths"},{"text":"? = nil, ","kind":"text"},{"text":"topSystemDistance","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL9MXLTenthsa","text":"MXLTenths","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths"},{"text":"? = nil, ","kind":"text"},{"text":"systemDividers","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL17MXLSystemDividersV","text":"MXLSystemDividers","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemDividers"},{"text":"? = nil)","kind":"text"}],"languages":["swift"]}]},{"parameters":[{"name":"systemMargins","content":[{"inlineContent":[{"text":"The left and right margins for the system, relative to the page margins.","type":"text"}],"type":"paragraph"}]},{"name":"systemDistance","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The vertical distance from the bottom line of the previous system to the top line of the current system, in tenths. Ignored for the first system on a page."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"The vertical distance from the page’s top margin to the top line of the first system, in tenths. Ignored for all but the first system on a page."}],"type":"paragraph"}],"name":"topSystemDistance"},{"content":[{"inlineContent":[{"type":"text","text":"Indicates the presence or absence of system dividers between this system and the previous system."}],"type":"paragraph"}],"name":"systemDividers"}],"kind":"parameters"}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemLayout"]]},"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemLayout\/init(systemMargins:systemDistance:topSystemDistance:systemDividers:)","interfaceLanguage":"swift"},"sections":[],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLTenths":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLTenths"}],"abstract":[{"type":"text","text":"The tenths type is a number representing tenths of interline staff space (positive or negative). Both integer"},{"type":"text","text":" "},{"type":"text","text":"and decimal values are allowed, such as 5 for a half space and 2.5 for a quarter space. Interline space is"},{"type":"text","text":" "},{"type":"text","text":"measured from the middle of a staff line."}],"kind":"symbol","title":"MXLTenths","url":"\/documentation\/ivormxl\/mxltenths","role":"symbol","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTenths"}]},"doc://IvorMXL/documentation/IvorMXL/MXLSystemLayout":{"role":"symbol","kind":"symbol","title":"MXLSystemLayout","abstract":[{"type":"text","text":"A system is a group of staves that are read and played simultaneously. System layout includes left and right"},{"type":"text","text":" "},{"type":"text","text":"margins and the vertical distance from the previous system. The system distance is measured from the bottom"},{"type":"text","text":" "},{"type":"text","text":"line of the previous system to the top line of the current system. It is ignored for the first system on a"},{"type":"text","text":" "},{"type":"text","text":"page. The top system distance is measured from the page’s top margin to the top line of the first system. It"},{"type":"text","text":" "},{"type":"text","text":"is ignored for all but the first system on a page."}],"url":"\/documentation\/ivormxl\/mxlsystemlayout","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSystemLayout","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemLayout","navigatorTitle":[{"text":"MXLSystemLayout","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLSystemDividers":{"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLSystemDividers"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemDividers","url":"\/documentation\/ivormxl\/mxlsystemdividers","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLSystemDividers"}],"title":"MXLSystemDividers","type":"topic","abstract":[{"text":"The system-dividers element indicates the presence or absence of system dividers (also known as system","type":"text"},{"text":" ","type":"text"},{"text":"separation marks) between systems displayed on the same page. Dividers on the left and right side of the page","type":"text"},{"text":" ","type":"text"},{"text":"are controlled by the left-divider and right-divider elements respectively. The default vertical position is","type":"text"},{"text":" ","type":"text"},{"text":"half the system-distance value from the top of the system that is below the divider. The default horizontal","type":"text"},{"text":" ","type":"text"},{"text":"position is the left and right system margin, respectively.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLSystemLayout/init(systemMargins:systemDistance:topSystemDistance:systemDividers:)":{"url":"\/documentation\/ivormxl\/mxlsystemlayout\/init(systemmargins:systemdistance:topsystemdistance:systemdividers:)","abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLSystemLayout"},{"text":".","type":"text"}],"kind":"symbol","type":"topic","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemLayout\/init(systemMargins:systemDistance:topSystemDistance:systemDividers:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"systemMargins","kind":"externalParam"},{"text":": ","kind":"text"}