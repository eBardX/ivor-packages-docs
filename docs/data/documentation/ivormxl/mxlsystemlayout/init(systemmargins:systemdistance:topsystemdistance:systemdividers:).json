(systemmargins:systemdistance:topsystemdistance:systemdividers:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLSystemDividers":{"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemDividers","title":"MXLSystemDividers","url":"\/documentation\/ivormxl\/mxlsystemdividers","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLSystemDividers"}],"navigatorTitle":[{"kind":"identifier","text":"MXLSystemDividers"}],"kind":"symbol","abstract":[{"type":"text","text":"The system-dividers element indicates the presence or absence of system dividers (also known as system"},{"type":"text","text":" "},{"type":"text","text":"separation marks) between systems displayed on the same page. Dividers on the left and right side of the page"},{"type":"text","text":" "},{"type":"text","text":"are controlled by the left-divider and right-divider elements respectively. The default vertical position is"},{"type":"text","text":" "},{"type":"text","text":"half the system-distance value from the top of the system that is below the divider. The default horizontal"},{"type":"text","text":" "},{"type":"text","text":"position is the left and right system margin, respectively."}]},"doc://IvorMXL/documentation/IvorMXL/MXLSystemLayout/init(systemMargins:systemDistance:topSystemDistance:systemDividers:)":{"abstract":[{"text":"Creates a new ","type":"text"},{"type":"codeVoice","code":"MXLSystemLayout"},{"text":".","type":"text"}],"title":"init(systemMargins:systemDistance:topSystemDistance:systemDividers:)","url":"\/documentation\/ivormxl\/mxlsystemlayout\/init(systemmargins:systemdistance:topsystemdistance:systemdividers:)","kind":"symbol","role":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"systemMargins"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLSystemMargins","preciseIdentifier":"s:7IvorMXL16MXLSystemMarginsV"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"systemDistance"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLTenths","preciseIdentifier":"s:7IvorMXL9MXLTenthsa"},{"text":"?, ","kind":"text"},{"kind":"externalParam","text":"topSystemDistance"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"MXLTenths","preciseIdentifier":"s:7IvorMXL9MXLTenthsa"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"systemDividers"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLSystemDividers","preciseIdentifier":"s:7IvorMXL17MXLSystemDividersV"},{"kind":"text","text":"?)"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemLayout\/init(systemMargins:systemDistance:topSystemDistance:systemDividers:)"},"doc://IvorMXL/documentation/IvorMXL/MXLSystemMargins":{"title":"MXLSystemMargins","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSystemMargins","kind":"identifier"}],"abstract":[{"text":"System margins are relative to the page margins. Positive values indent and negative values reduce the margin","type":"text"},{"text":" ","type":"text"},{"text":"size.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemMargins","role":"symbol","navigatorTitle":[{"text":"MXLSystemMargins","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlsystemmargins"},"doc://IvorMXL/documentation/IvorMXL/MXLSystemLayout":{"title":"MXLSystemLayout","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLSystemLayout"}],"navigatorTitle":[{"text":"MXLSystemLayout","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemLayout","url":"\/documentation\/ivormxl\/mxlsystemlayout","type":"topic","abstract":[{"type":"text","text":"A system is a group of staves that are read and played simultaneously. System layout includes left and right"},{"type":"text","text":" "},{"type":"text","text":"margins and the vertical distance from the previous system. The system distance is measured from the bottom"},{"type":"text","text":" "},{"type":"text","text":"line of the previous system to the top line of the current system. It is ignored for the first system on a"},{"type":"text","text":" "},{"type":"text","text":"page. The top system distance is measured from the page’s top margin to the top line of the first system. It"},{"type":"text","text":" "},{"type":"text","text":"is ignored for all but the first system on a page."}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLTenths":{"title":"MXLTenths","kind":"symbol","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTenths"}],"abstract":[{"type":"text","text":"The tenths type is a number representing tenths of interline staff space (positive or negative). Both integer"},{"type":"text","text":" "},{"type":"text","text":"and decimal values are allowed, such as 5 for a half space and 2.5 for a quarter space. Interline space is"},{"type":"text","text":" "},{"type":"text","text":"measured from the middle of a staff line."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLTenths"}],"url":"\/documentation\/ivormxl\/mxltenths"}}}