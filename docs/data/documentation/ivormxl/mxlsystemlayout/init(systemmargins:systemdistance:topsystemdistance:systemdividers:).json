{"kind":"symbol","abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLSystemLayout"},{"type":"text","text":"."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlsystemlayout\/init(systemmargins:systemdistance:topsystemdistance:systemdividers:)"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"systemMargins"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL16MXLSystemMarginsV","kind":"typeIdentifier","text":"MXLSystemMargins","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemMargins"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"systemDistance"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL9MXLTenthsa","kind":"typeIdentifier","text":"MXLTenths","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"topSystemDistance"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL9MXLTenthsa","kind":"typeIdentifier","text":"MXLTenths","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"systemDividers"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL17MXLSystemDividersV","kind":"typeIdentifier","text":"MXLSystemDividers","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemDividers"},{"kind":"text","text":"? = nil)"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"name":"systemMargins","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The left and right margins for the system, relative to the page margins."}]}]},{"name":"systemDistance","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The vertical distance from the bottom line of the previous system to the top"},{"type":"text","text":" "},{"type":"text","text":"line of the current system, in tenths. Ignored for the first system on a page."}]}]},{"name":"topSystemDistance","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The vertical distance from the page’s top margin to the top line of the first"},{"type":"text","text":" "},{"type":"text","text":"system, in tenths. Ignored for all but the first system on a page."}]}]},{"name":"systemDividers","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Indicates the presence or absence of system dividers between this system and the"},{"type":"text","text":" "},{"type":"text","text":"previous system."}]}]}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemLayout\/init(systemMargins:systemDistance:topSystemDistance:systemDividers:)","interfaceLanguage":"swift"},"metadata":{"roleHeading":"Initializer","externalID":"s:7IvorMXL15MXLSystemLayoutV13systemMargins0E8Distance09topSystemG00E8DividersAcA0cF0VSg_SdSgAkA0cJ0VSgtcfc","title":"init(systemMargins:systemDistance:topSystemDistance:systemDividers:)","modules":[{"name":"IvorMXL"}],"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"systemMargins"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL16MXLSystemMarginsV","kind":"typeIdentifier","text":"MXLSystemMargins"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"systemDistance"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL9MXLTenthsa","kind":"typeIdentifier","text":"MXLTenths"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"topSystemDistance"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL9MXLTenthsa","kind":"typeIdentifier","text":"MXLTenths"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"systemDividers"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL17MXLSystemDividersV","kind":"typeIdentifier","text":"MXLSystemDividers"},{"kind":"text","text":"?)"}],"symbolKind":"init","role":"symbol"},"sections":[],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemLayout"]]},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLSystemLayout/init(systemMargins:systemDistance:topSystemDistance:systemDividers:)":{"role":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"systemMargins"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL16MXLSystemMarginsV","kind":"typeIdentifier","text":"MXLSystemMargins"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"systemDistance"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL9MXLTenthsa","kind":"typeIdentifier","text":"MXLTenths"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"topSystemDistance"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLTenthsa","text":"MXLTenths"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"systemDividers"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL17MXLSystemDividersV","text":"MXLSystemDividers"},{"kind":"text","text":"?)"}],"title":"init(systemMargins:systemDistance:topSystemDistance:systemDividers:)","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemLayout\/init(systemMargins:systemDistance:topSystemDistance:systemDividers:)","url":"\/documentation\/ivormxl\/mxlsystemlayout\/init(systemmargins:systemdistance:topsystemdistance:systemdividers:)","abstract":[{"type":"text","text":"Creates a new "},{"code":"MXLSystemLayout","type":"codeVoice"},{"type":"text","text":"."}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLSystemMargins":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemMargins","navigatorTitle":[{"text":"MXLSystemMargins","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlsystemmargins","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSystemMargins","kind":"identifier"}],"title":"MXLSystemMargins","abstract":[{"text":"System margins are relative to the page margins. Positive values indent and negative values reduce the margin","type":"text"},{"text":" ","type":"text"},{"text":"size.","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLTenths":{"type":"topic","abstract":[{"type":"text","text":"The tenths type is a number representing tenths of interline staff space (positive or negative). Both integer"},{"type":"text","text":" "},{"type":"text","text":"and decimal values are allowed, such as 5 for a half space and 2.5 for a quarter space. Interline space is"},{"type":"text","text":" "},{"type":"text","text":"measured from the middle of a staff line."}],"url":"\/documentation\/ivormxl\/mxltenths","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTenths"}],"kind":"symbol","title":"MXLTenths","navigatorTitle":[{"kind":"identifier","text":"MXLTenths"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLSystemDividers":{"type":"topic","title":"MXLSystemDividers","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemDividers","abstract":[{"text":"The system-dividers element indicates the presence or absence of system dividers (also known as system","type":"text"},{"text":" ","type":"text"},{"text":"separation marks) between systems displayed on the same page. Dividers on the left and right side of the page","type":"text"},{"text":" ","type":"text"},{"text":"are controlled by the left-divider and right-divider elements respectively. The default vertical position is","type":"text"},{"text":" ","type":"text"},{"text":"half the system-distance value from the top of the system that is below the divider. The default horizontal","type":"text"},{"text":" ","type":"text"},{"text":"position is the left and right system margin, respectively.","type":"text"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSystemDividers","kind":"identifier"}],"navigatorTitle":[{"text":"MXLSystemDividers","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlsystemdividers"},"doc://IvorMXL/documentation/IvorMXL/MXLSystemLayout":{"type":"topic","title":"MXLSystemLayout","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemLayout","abstract":[{"text":"A system is a group of staves that are read and played simultaneously. System layout includes left and right","type":"text"},{"text":" ","type":"text"},{"text":"margins and the vertical distance from the previous system. The system distance is measured from the bottom","type":"text"},{"text":" ","type":"text"},{"text":"line of the previous system to the top line of the current system. It is ignored for the first system on a","type":"text"},{"text":" ","type":"text"},{"text":"page. The top system distance is measured from the page’s top margin to the top line of the first system. It","type":"text"},{"text":" ","type":"text"},{"text":"is ignored for all but the first system on a page.","type":"text"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSystemLayout","kind":"identifier"}],"navigatorTitle":[{"text":"MXLSystemLayout","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlsystemlayout"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"}}}