"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemLayout","abstract":[{"text":"A system is a group of staves that are read and played simultaneously. System layout includes left and right","type":"text"},{"text":" ","type":"text"},{"text":"margins and the vertical distance from the previous system. The system distance is measured from the bottom","type":"text"},{"text":" ","type":"text"},{"text":"line of the previous system to the top line of the current system. It is ignored for the first system on a","type":"text"},{"text":" ","type":"text"},{"text":"page. The top system distance is measured from the page’s top margin to the top line of the first system. It","type":"text"},{"text":" ","type":"text"},{"text":"is ignored for all but the first system on a page.","type":"text"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSystemLayout","kind":"identifier"}],"navigatorTitle":[{"text":"MXLSystemLayout","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlsystemlayout"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLSystemLayout/systemDistance":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlsystemlayout\/systemdistance","abstract":[{"type":"text","text":"The vertical distance from the bottom line of the previous system to the top line of the current system, in"},{"type":"text","text":" "},{"type":"text","text":"tenths. Ignored for the first system on a page."}],"title":"systemDistance","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemLayout\/systemDistance","type":"topic","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"systemDistance"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLTenths","preciseIdentifier":"s:7IvorMXL9MXLTenthsa"},{"kind":"text","text":"?"}]},"doc://IvorMXL/documentation/IvorMXL/MXLTenths":{"type":"topic","abstract":[{"type":"text","text":"The tenths type is a number representing tenths of interline staff space (positive or negative). Both integer"},{"type":"text","text":" "},{"type":"text","text":"and decimal values are allowed, such as 5 for a half space and 2.5 for a quarter space. Interline space is"},{"type":"text","text":" "},{"type":"text","text":"measured from the middle of a staff line."}],"url":"\/documentation\/ivormxl\/mxltenths","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTenths"}],"kind":"symbol","title":"MXLTenths","navigatorTitle":[{"kind":"identifier","text":"MXLTenths"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths","role":"symbol"}}}