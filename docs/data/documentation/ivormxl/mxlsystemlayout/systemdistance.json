{"sections":[],"metadata":{"role":"symbol","externalID":"s:7IvorMXL15MXLSystemLayoutV14systemDistanceSdSgvp","roleHeading":"Instance Property","title":"systemDistance","symbolKind":"property","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"systemDistance","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLTenths","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLTenthsa"},{"text":"?","kind":"text"}],"modules":[{"name":"IvorMXL"}]},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemLayout"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemLayout\/systemDistance","interfaceLanguage":"swift"},"kind":"symbol","abstract":[{"type":"text","text":"The vertical distance from the bottom line of the previous system to the top line of the current system, in"},{"type":"text","text":" "},{"type":"text","text":"tenths. Ignored for the first system on a page."}],"variants":[{"paths":["\/documentation\/ivormxl\/mxlsystemlayout\/systemdistance"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"systemDistance","kind":"identifier"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths","text":"MXLTenths","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLTenthsa"},{"text":"?","kind":"text"}]}]},{"kind":"content","content":[{"type":"heading","anchor":"discussion","text":"Discussion","level":2},{"inlineContent":[{"type":"text","text":"Maps to a nested MusicXML "},{"type":"codeVoice","code":"<system-distance>"},{"type":"text","text":" element."}],"type":"paragraph"}]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLSystemLayout/systemDistance":{"title":"systemDistance","kind":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"systemDistance"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLTenthsa","text":"MXLTenths"},{"kind":"text","text":"?"}],"url":"\/documentation\/ivormxl\/mxlsystemlayout\/systemdistance","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemLayout\/systemDistance","type":"topic","abstract":[{"type":"text","text":"The vertical distance from the bottom line of the previous system to the top line of the current system, in"},{"type":"text","text":" "},{"type":"text","text":"tenths. Ignored for the first system on a page."}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLSystemLayout":{"title":"MXLSystemLayout","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLSystemLayout"}],"navigatorTitle":[{"text":"MXLSystemLayout","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemLayout","url":"\/documentation\/ivormxl\/mxlsystemlayout","type":"topic","abstract":[{"type":"text","text":"A system is a group of staves that are read and played simultaneously. System layout includes left and right"},{"type":"text","text":" "},{"type":"text","text":"margins and the vertical distance from the previous system. The system distance is measured from the bottom"},{"type":"text","text":" "},{"type":"text","text":"line of the previous system to the top line of the current system. It is ignored for the first system on a"},{"type":"text","text":" "},{"type":"text","text":"page. The top system distance is measured from the page’s top margin to the top line of the first system. It"},{"type":"text","text":" "},{"type":"text","text":"is ignored for all but the first system on a page."}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLTenths":{"title":"MXLTenths","kind":"symbol","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTenths"}],"abstract":[{"type":"text","text":"The tenths type is a number representing tenths of interline staff space (positive or negative). Both integer"},{"type":"text","text":" "},{"type":"text","text":"and decimal values are allowed, such as 5 for a half space and 2.5 for a quarter space. Interline space is"},{"type":"text","text":" "},{"type":"text","text":"measured from the middle of a staff line."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLTenths"}],"url":"\/documentation\/ivormxl\/mxltenths"}}}