fier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLSystemLayout":{"navigatorTitle":[{"text":"MXLSystemLayout","kind":"identifier"}],"abstract":[{"text":"A system is a group of staves that are read and played simultaneously. System layout includes left and right","type":"text"},{"text":" ","type":"text"},{"text":"margins and the vertical distance from the previous system. The system distance is measured from the bottom","type":"text"},{"text":" ","type":"text"},{"text":"line of the previous system to the top line of the current system. It is ignored for the first system on a","type":"text"},{"text":" ","type":"text"},{"text":"page. The top system distance is measured from the page’s top margin to the top line of the first system. It","type":"text"},{"text":" ","type":"text"},{"text":"is ignored for all but the first system on a page.","type":"text"}],"title":"MXLSystemLayout","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemLayout","kind":"symbol","url":"\/documentation\/ivormxl\/mxlsystemlayout","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSystemLayout","kind":"identifier"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLSystemDividers":{"title":"MXLSystemDividers","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLSystemDividers"}],"kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxlsystemdividers","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemDividers","abstract":[{"text":"The system-dividers element indicates the presence or absence of system dividers (also known as system","type":"text"},{"type":"text","text":" "},{"text":"separation marks) between systems displayed on the same page. Dividers on the left and right side of the page","type":"text"},{"text":" ","type":"text"},{"text":"are controlled by the left-divider and right-divider elements respectively. The default vertical position is","type":"text"},{"text":" ","type":"text"},{"text":"half the system-distance value from the top of the system that is below the divider. The default horizontal","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"position is the left and right system margin, respectively."}],"navigatorTitle":[{"kind":"identifier","text":"MXLSystemDividers"}]},"doc://IvorMXL/documentation/IvorMXL/MXLSystemLayout/systemDividers":{"url":"\/documentation\/ivormxl\/mxlsystemlayout\/systemdividers","abstract":[{"text":"Indicates the presence or absence of system dividers between this system and the previous system.","type":"text"}],"title":"systemDividers","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemLayout\/systemDividers","type":"topic","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"systemDividers"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL17MXLSystemDividersV","kind":"typeIdentifier","text":"MXLSystemDividers"},{"kind":"text","text":"?"}],"role":"symbol"}}}