{"abstract":[{"type":"text","text":"Indicates the presence or absence of system dividers between this system and the previous system."}],"sections":[],"metadata":{"modules":[{"name":"IvorMXL"}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"systemDividers","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL17MXLSystemDividersV","text":"MXLSystemDividers","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"title":"systemDividers","roleHeading":"Instance Property","externalID":"s:7IvorMXL15MXLSystemLayoutV14systemDividersAA0cF0VSgvp","role":"symbol","symbolKind":"property"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"systemDividers","kind":"identifier"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemDividers","preciseIdentifier":"s:7IvorMXL17MXLSystemDividersV","text":"MXLSystemDividers","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"type":"heading","anchor":"discussion","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Maps to a nested MusicXML "},{"type":"codeVoice","code":"<system-dividers>"},{"type":"text","text":" element."}]}],"kind":"content"}],"kind":"symbol","schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlsystemlayout\/systemdividers"]}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemLayout"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemLayout\/systemDividers"},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLSystemLayout":{"abstract":[{"type":"text","text":"A system is a group of staves that are read and played simultaneously. System layout includes left and right"},{"type":"text","text":" "},{"type":"text","text":"margins and the vertical distance from the previous system. The system distance is measured from the bottom"},{"type":"text","text":" "},{"type":"text","text":"line of the previous system to the top line of the current system. It is ignored for the first system on a"},{"type":"text","text":" "},{"type":"text","text":"page. The top system distance is measured from the page’s top margin to the top line of the first system. It"},{"type":"text","text":" "},{"type":"text","text":"is ignored for all but the first system on a page."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSystemLayout","kind":"identifier"}],"title":"MXLSystemLayout","navigatorTitle":[{"text":"MXLSystemLayout","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlsystemlayout","type":"topic","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemLayout"},"doc://IvorMXL/documentation/IvorMXL/MXLSystemDividers":{"abstract":[{"type":"text","text":"The system-dividers element indicates the presence or absence of system dividers (also known as system"},{"type":"text","text":" "},{"type":"text","text":"separation marks) between systems displayed on the same page. Dividers on the left and right side of the page"},{"type":"text","text":" "},{"type":"text","text":"are controlled by the left-divider and right-divider elements respectively. The default vertical position is"},{"type":"text","text":" "},{"type":"text","text":"half the system-distance value from the top of the system that is below the divider. The default horizontal"},{"type":"text","text":" "},{"type":"text","text":"position is the left and right system margin, respectively."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSystemDividers","kind":"identifier"}],"title":"MXLSystemDividers","navigatorTitle":[{"text":"MXLSystemDividers","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlsystemdividers","type":"topic","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemDividers"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLSystemLayout/systemDividers":{"abstract":[{"type":"text","text":"Indicates the presence or absence of system dividers between this system and the previous system."}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"systemDividers","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL17MXLSystemDividersV","text":"MXLSystemDividers","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"title":"systemDividers","kind":"symbol","url":"\/documentation\/ivormxl\/mxlsystemlayout\/systemdividers","type":"topic","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemLayout\/systemDividers"}}}