{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"topSystemDistance"},{"kind":"text","text":": "},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLTenthsa","text":"MXLTenths"},{"kind":"text","text":"?"}],"languages":["swift"],"platforms":["macOS"]}]},{"content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Maps to a nested MusicXML ","type":"text"},{"code":"<top-system-distance>","type":"codeVoice"},{"text":" element.","type":"text"}]}],"kind":"content"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"symbol","metadata":{"roleHeading":"Instance Property","symbolKind":"property","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"topSystemDistance"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLTenthsa","text":"MXLTenths"},{"kind":"text","text":"?"}],"title":"topSystemDistance","externalID":"s:7IvorMXL15MXLSystemLayoutV17topSystemDistanceSdSgvp","modules":[{"name":"IvorMXL"}],"role":"symbol"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemLayout"]]},"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemLayout\/topSystemDistance","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlsystemlayout\/topsystemdistance"]}],"abstract":[{"type":"text","text":"The vertical distance from the page’s top margin to the top line of the first system, in tenths. Ignored for"},{"type":"text","text":" "},{"type":"text","text":"all but the first system on a page."}],"sections":[],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLTenths":{"abstract":[{"text":"The tenths type is a number representing tenths of interline staff space (positive or negative). Both integer","type":"text"},{"text":" ","type":"text"},{"text":"and decimal values are allowed, such as 5 for a half space and 2.5 for a quarter space. Interline space is","type":"text"},{"text":" ","type":"text"},{"text":"measured from the middle of a staff line.","type":"text"}],"title":"MXLTenths","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTenths"}],"navigatorTitle":[{"kind":"identifier","text":"MXLTenths"}],"type":"topic","url":"\/documentation\/ivormxl\/mxltenths","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths"},"doc://IvorMXL/documentation/IvorMXL/MXLSystemLayout/topSystemDistance":{"url":"\/documentation\/ivormxl\/mxlsystemlayout\/topsystemdistance","abstract":[{"text":"The vertical distance from the page’s top margin to the top line of the first system, in tenths. Ignored for","type":"text"},{"text":" ","type":"text"},{"text":"all but the first system on a page.","type":"text"}],"title":"topSystemDistance","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemLayout\/topSystemDistance","type":"topic","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"topSystemDistance"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL9MXLTenthsa","kind":"typeIdentifier","text":"MXLTenths"},{"kind":"text","text":"?"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLSystemLayout":{"navigatorTitle":[{"text":"MXLSystemLayout","kind":"identifier"}],"abstract":[{"text":"A system is a group of staves that are read and played simultaneously. System layout includes left and right","type":"text"},{"text":" ","type":"text"},{"text":"margins and the vertical distance from the previous system. The system distance is measured from the bottom","type":"text"},{"text":" ","type":"text"},{"text":"line of the previous system to the top line of the current system. It is ignored for the first system on a","type":"text"},{"text":" ","type":"text"},{"text":"page. The top system distance is measured from the page’s top margin to the top line of the first system. It","type":"text"},{"text":" ","type":"text"},{"text":"is ignored for all but the first system on a page.","type":"text"}],"title":"MXLSystemLayout","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemLayout","kind":"symbol","url":"\/documentation\/ivormxl\/mxlsystemlayout","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSystemLayout","kind":"identifier"}],"role":"symbol"}}}