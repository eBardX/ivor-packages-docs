{"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemLayout"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"fragments":[{"kind":"keyword","text":"let"},{"text":" ","kind":"text"},{"text":"topSystemDistance","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL9MXLTenthsa","text":"MXLTenths","kind":"typeIdentifier"},{"kind":"text","text":"?"}],"symbolKind":"property","roleHeading":"Instance Property","title":"topSystemDistance","externalID":"s:7IvorMXL15MXLSystemLayoutV17topSystemDistanceSdSgvp","role":"symbol","modules":[{"name":"IvorMXL"}]},"variants":[{"paths":["\/documentation\/ivormxl\/mxlsystemlayout\/topsystemdistance"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemLayout\/topSystemDistance"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"topSystemDistance"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLTenthsa","text":"MXLTenths","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths"},{"kind":"text","text":"?"}],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Maps to a nested MusicXML "},{"code":"<top-system-distance>","type":"codeVoice"},{"type":"text","text":" element."}]}]}],"abstract":[{"type":"text","text":"The vertical distance from the page’s top margin to the top line of the first system, in tenths. Ignored for"},{"type":"text","text":" "},{"type":"text","text":"all but the first system on a page."}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLSystemLayout":{"role":"symbol","kind":"symbol","title":"MXLSystemLayout","abstract":[{"type":"text","text":"A system is a group of staves that are read and played simultaneously. System layout includes left and right"},{"type":"text","text":" "},{"type":"text","text":"margins and the vertical distance from the previous system. The system distance is measured from the bottom"},{"type":"text","text":" "},{"type":"text","text":"line of the previous system to the top line of the current system. It is ignored for the first system on a"},{"type":"text","text":" "},{"type":"text","text":"page. The top system distance is measured from the page’s top margin to the top line of the first system. It"},{"type":"text","text":" "},{"type":"text","text":"is ignored for all but the first system on a page."}],"url":"\/documentation\/ivormxl\/mxlsystemlayout","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSystemLayout","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemLayout","navigatorTitle":[{"text":"MXLSystemLayout","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLSystemLayout/topSystemDistance":{"abstract":[{"type":"text","text":"The vertical distance from the page’s top margin to the top line of the first system, in tenths. Ignored for"},{"type":"text","text":" "},{"type":"text","text":"all but the first system on a page."}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"topSystemDistance"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLTenths","preciseIdentifier":"s:7IvorMXL9MXLTenthsa"},{"kind":"text","text":"?"}],"url":"\/documentation\/ivormxl\/mxlsystemlayout\/topsystemdistance","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemLayout\/topSystemDistance","type":"topic","role":"symbol","title":"topSystemDistance"},"doc://IvorMXL/documentation/IvorMXL/MXLTenths":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLTenths"}],"abstract":[{"type":"text","text":"The tenths type is a number representing tenths of interline staff space (positive or negative). Both integer"},{"type":"text","text":" "},{"type":"text","text":"and decimal values are allowed, such as 5 for a half space and 2.5 for a quarter space. Interline space is"},{"type":"text","text":" "},{"type":"text","text":"measured from the middle of a staff line."}],"kind":"symbol","title":"MXLTenths","url":"\/documentation\/ivormxl\/mxltenths","role":"symbol","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTenths"}]}}}