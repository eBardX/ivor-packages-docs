abstract":[{"type":"text","text":"A system is a group of staves that are read and played simultaneously. System layout includes left and right"},{"type":"text","text":" "},{"type":"text","text":"margins and the vertical distance from the previous system. The system distance is measured from the bottom"},{"type":"text","text":" "},{"type":"text","text":"line of the previous system to the top line of the current system. It is ignored for the first system on a"},{"type":"text","text":" "},{"type":"text","text":"page. The top system distance is measured from the page’s top margin to the top line of the first system. It"},{"type":"text","text":" "},{"type":"text","text":"is ignored for all but the first system on a page."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSystemLayout","kind":"identifier"}],"title":"MXLSystemLayout","navigatorTitle":[{"text":"MXLSystemLayout","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlsystemlayout","type":"topic","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemLayout"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLSystemLayout/!=(_:_:)":{"abstract":[],"url":"\/documentation\/ivormxl\/mxlsystemlayout\/!=(_:_:)","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemLayout\/!=(_:_:)","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"!="},{"kind":"text","text":" "},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":") ->