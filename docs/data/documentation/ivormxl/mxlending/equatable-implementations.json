{"variants":[{"paths":["\/documentation\/ivormxl\/mxlending\/equatable-implementations"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/Equatable-Implementations","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding"]]},"metadata":{"modules":[{"name":"IvorMXL"}],"title":"Equatable Implementations","roleHeading":"API Collection","role":"collectionGroup"},"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"topicSections":[{"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/!=(_:_:)"],"title":"Operators","generated":true,"anchor":"Operators"}],"references":{"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLEnding":{"type":"topic","role":"symbol","abstract":[{"type":"text","text":"The ending type represents multiple (e.g. first and second) endings. Typically, the start type is associated"},{"type":"text","text":" "},{"type":"text","text":"with the left barline of the first measure in an ending. The stop and discontinue types are associated with"},{"type":"text","text":" "},{"type":"text","text":"the right barline of the last measure in an ending. Stop is used when the ending mark concludes with a"},{"type":"text","text":" "},{"type":"text","text":"downward jog, as is typical for first endings. Discontinue is used when there is no downward jog, as is"},{"type":"text","text":" "},{"type":"text","text":"typical for second endings that do not conclude a piece. The length of the jog can be specified using the end-"},{"type":"text","text":" "},{"type":"text","text":"length attribute. The text-x and text-y attributes are offsets that specify where the baseline of the start of"},{"type":"text","text":" "},{"type":"text","text":"the ending text appears, relative to the start of the ending line."}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding","title":"MXLEnding","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLEnding"}],"navigatorTitle":[{"kind":"identifier","text":"MXLEnding"}],"url":"\/documentation\/ivormxl\/mxlending"},"doc://IvorMXL/documentation/IvorMXL/MXLEnding/!=(_:_:)":{"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"!="},{"kind":"text","text":" "},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/!=(_:_:)","url":"\/documentation\/ivormxl\/mxlending\/!=(_:_:)","title":"!=(_:_:)","abstract":[],"type":"topic","role":"symbol"}}}