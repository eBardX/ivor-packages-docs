{"sections":[],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding"]]},"abstract":[{"type":"text","text":"The system-relation attribute group distinguishes elements that are associated with a system rather than the"},{"type":"text","text":" "},{"type":"text","text":"particular part where the element appears."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"system"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemRelation","text":"MXLSystemRelation","preciseIdentifier":"s:7IvorMXL17MXLSystemRelationO"},{"kind":"text","text":"?"}],"languages":["swift"]}]},{"content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"Maps to the MusicXML ","type":"text"},{"code":"system","type":"codeVoice"},{"text":" attribute.","type":"text"}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/ivormxl\/mxlending\/system"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"system"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLSystemRelation","preciseIdentifier":"s:7IvorMXL17MXLSystemRelationO"},{"kind":"text","text":"?"}],"title":"system","externalID":"s:7IvorMXL9MXLEndingV6systemAA17MXLSystemRelationOSgvp","roleHeading":"Instance Property","modules":[{"name":"IvorMXL"}],"role":"symbol","symbolKind":"property"},"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/system"},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLEnding/system":{"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlending\/system","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"system","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLSystemRelation","preciseIdentifier":"s:7IvorMXL17MXLSystemRelationO","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"title":"system","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/system","abstract":[{"text":"The system-relation attribute group distinguishes elements that are associated with a system rather than the","type":"text"},{"text":" ","type":"text"},{"text":"particular part where the element appears.","type":"text"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLEnding":{"title":"MXLEnding","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLEnding"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlending","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding","abstract":[{"text":"The ending type represents multiple (e.g. first and second) endings. Typically, the start type is associated","type":"text"},{"text":" ","type":"text"},{"text":"with the left barline of the first measure in an ending. The stop and discontinue types are associated with","type":"text"},{"text":" ","type":"text"},{"text":"the right barline of the last measure in an ending. Stop is used when the ending mark concludes with a","type":"text"},{"text":" ","type":"text"},{"text":"downward jog, as is typical for first endings. Discontinue is used when there is no downward jog, as is","type":"text"},{"text":" ","type":"text"},{"text":"typical for second endings that do not conclude a piece. The length of the jog can be specified using the end-","type":"text"},{"text":" ","type":"text"},{"text":"length attribute. The text-x and text-y attributes are offsets that specify where the baseline of the start of","type":"text"},{"text":" ","type":"text"},{"text":"the ending text appears, relative to the start of the ending line.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"MXLEnding"}]},"doc://IvorMXL/documentation/IvorMXL/MXLSystemRelation":{"abstract":[{"text":"The system-relation type distinguishes elements that are associated with a system rather than the particular","type":"text"},{"text":" ","type":"text"},{"text":"part where the element appears. A value of only-top indicates that the element should appear only on the top","type":"text"},{"text":" ","type":"text"},{"text":"part of the current system. A value of also-top indicates that the element should appear on both the current","type":"text"},{"text":" ","type":"text"},{"text":"part and the top part of the current system. If this value appears in a score, when parts are created the","type":"text"},{"text":" ","type":"text"},{"text":"element should only appear once in this part, not twice. A value of none indicates that the element is","type":"text"},{"text":" ","type":"text"},{"text":"associated only with the current part, not with the system.","type":"text"}],"title":"MXLSystemRelation","kind":"symbol","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSystemRelation","kind":"identifier"}],"navigatorTitle":[{"text":"MXLSystemRelation","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlsystemrelation","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemRelation"},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"}}}