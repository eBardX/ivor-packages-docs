{"metadata":{"modules":[{"name":"IvorMXL"}],"role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"system"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLSystemRelation","preciseIdentifier":"s:7IvorMXL17MXLSystemRelationO"},{"kind":"text","text":"?"}],"externalID":"s:7IvorMXL9MXLEndingV6systemAA17MXLSystemRelationOSgvp","roleHeading":"Instance Property","symbolKind":"property","title":"system"},"variants":[{"paths":["\/documentation\/ivormxl\/mxlending\/system"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/system","interfaceLanguage":"swift"},"abstract":[{"text":"The system-relation attribute group distinguishes elements that are associated with a system rather than the","type":"text"},{"text":" ","type":"text"},{"text":"particular part where the element appears.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"system"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemRelation","text":"MXLSystemRelation","preciseIdentifier":"s:7IvorMXL17MXLSystemRelationO"},{"kind":"text","text":"?"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Maps to the MusicXML "},{"type":"codeVoice","code":"system"},{"type":"text","text":" attribute."}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding"]]},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLEnding":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding","role":"symbol","navigatorTitle":[{"text":"MXLEnding","kind":"identifier"}],"type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLEnding","kind":"identifier"}],"abstract":[{"type":"text","text":"The ending type represents multiple (e.g. first and second) endings. Typically, the start type is associated"},{"type":"text","text":" "},{"type":"text","text":"with the left barline of the first measure in an ending. The stop and discontinue types are associated with"},{"type":"text","text":" "},{"type":"text","text":"the right barline of the last measure in an ending. Stop is used when the ending mark concludes with a"},{"type":"text","text":" "},{"type":"text","text":"downward jog, as is typical for first endings. Discontinue is used when there is no downward jog, as is"},{"type":"text","text":" "},{"type":"text","text":"typical for second endings that do not conclude a piece. The length of the jog can be specified using the end-"},{"type":"text","text":" "},{"type":"text","text":"length attribute. The text-x and text-y attributes are offsets that specify where the baseline of the start of"},{"type":"text","text":" "},{"type":"text","text":"the ending text appears, relative to the start of the ending line."}],"url":"\/documentation\/ivormxl\/mxlending","title":"MXLEnding"},"doc://IvorMXL/documentation/IvorMXL/MXLSystemRelation":{"url":"\/documentation\/ivormxl\/mxlsystemrelation","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemRelation","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLSystemRelation"}],"title":"MXLSystemRelation","abstract":[{"text":"The system-relation type distinguishes elements that are associated with a system rather than the particular","type":"text"},{"text":" ","type":"text"},{"text":"part where the element appears. A value of only-top indicates that the element should appear only on the top","type":"text"},{"text":" ","type":"text"},{"text":"part of the current system. A value of also-top indicates that the element should appear on both the current","type":"text"},{"text":" ","type":"text"},{"text":"part and the top part of the current system. If this value appears in a score, when parts are created the","type":"text"},{"text":" ","type":"text"},{"text":"element should only appear once in this part, not twice. A value of none indicates that the element is","type":"text"},{"text":" ","type":"text"},{"text":"associated only with the current part, not with the system.","type":"text"}],"type":"topic","fragments":[{"kind":"keyword","text":"enum"},{"text":" ","kind":"text"},{"kind":"identifier","text":"MXLSystemRelation"}]},"doc://IvorMXL/documentation/IvorMXL/MXLEnding/system":{"abstract":[{"type":"text","text":"The system-relation attribute group distinguishes elements that are associated with a system rather than the"},{"type":"text","text":" "},{"type":"text","text":"particular part where the element appears."}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"system","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLSystemRelation","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL17MXLSystemRelationO"},{"text":"?","kind":"text"}],"url":"\/documentation\/ivormxl\/mxlending\/system","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/system","title":"system","kind":"symbol","type":"topic","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]}}}