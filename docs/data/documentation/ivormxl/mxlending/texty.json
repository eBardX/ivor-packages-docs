{"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding"]]},"metadata":{"modules":[{"name":"IvorMXL"}],"externalID":"s:7IvorMXL9MXLEndingV5textYSdSgvp","title":"textY","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"textY","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLTenths","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLTenthsa"},{"text":"?","kind":"text"}],"symbolKind":"property","role":"symbol","roleHeading":"Instance Property"},"abstract":[{"text":"The vertical offset specifying where the baseline of the start of the ending text appears, relative to the","type":"text"},{"text":" ","type":"text"},{"text":"start of the ending line.","type":"text"}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/textY","interfaceLanguage":"swift"},"kind":"symbol","primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"textY","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL9MXLTenthsa","kind":"typeIdentifier","text":"MXLTenths","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths"},{"kind":"text","text":"?"}]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Maps to the MusicXML "},{"type":"codeVoice","code":"text-y"},{"type":"text","text":" attribute."}]}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"variants":[{"paths":["\/documentation\/ivormxl\/mxlending\/texty"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLEnding":{"title":"MXLEnding","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLEnding"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlending","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding","abstract":[{"text":"The ending type represents multiple (e.g. first and second) endings. Typically, the start type is associated","type":"text"},{"text":" ","type":"text"},{"text":"with the left barline of the first measure in an ending. The stop and discontinue types are associated with","type":"text"},{"text":" ","type":"text"},{"text":"the right barline of the last measure in an ending. Stop is used when the ending mark concludes with a","type":"text"},{"text":" ","type":"text"},{"text":"downward jog, as is typical for first endings. Discontinue is used when there is no downward jog, as is","type":"text"},{"text":" ","type":"text"},{"text":"typical for second endings that do not conclude a piece. The length of the jog can be specified using the end-","type":"text"},{"text":" ","type":"text"},{"text":"length attribute. The text-x and text-y attributes are offsets that specify where the baseline of the start of","type":"text"},{"text":" ","type":"text"},{"text":"the ending text appears, relative to the start of the ending line.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"MXLEnding"}]},"doc://IvorMXL/documentation/IvorMXL/MXLEnding/textY":{"kind":"symbol","title":"textY","url":"\/documentation\/ivormxl\/mxlending\/texty","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"textY"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL9MXLTenthsa","kind":"typeIdentifier","text":"MXLTenths"},{"kind":"text","text":"?"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/textY","abstract":[{"type":"text","text":"The vertical offset specifying where the baseline of the start of the ending text appears, relative to the"},{"text":" ","type":"text"},{"text":"start of the ending line.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLTenths":{"abstract":[{"text":"The tenths type is a number representing tenths of interline staff space (positive or negative). Both integer","type":"text"},{"text":" ","type":"text"},{"text":"and decimal values are allowed, such as 5 for a half space and 2.5 for a quarter space. Interline space is","type":"text"},{"text":" ","type":"text"},{"text":"measured from the middle of a staff line.","type":"text"}],"title":"MXLTenths","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTenths"}],"navigatorTitle":[{"kind":"identifier","text":"MXLTenths"}],"type":"topic","url":"\/documentation\/ivormxl\/mxltenths","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths"}}}