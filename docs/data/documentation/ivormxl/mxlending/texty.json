{"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding"]]},"sections":[],"metadata":{"fragments":[{"text":"let","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"textY"},{"kind":"text","text":": "},{"text":"MXLTenths","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLTenthsa"},{"kind":"text","text":"?"}],"role":"symbol","modules":[{"name":"IvorMXL"}],"externalID":"s:7IvorMXL9MXLEndingV5textYSdSgvp","symbolKind":"property","roleHeading":"Instance Property","title":"textY"},"abstract":[{"type":"text","text":"The vertical offset specifying where the baseline of the start of the ending text appears, relative to the"},{"type":"text","text":" "},{"type":"text","text":"start of the ending line."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlending\/texty"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"textY","kind":"identifier"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths","preciseIdentifier":"s:7IvorMXL9MXLTenthsa","text":"MXLTenths","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Maps to the MusicXML "},{"type":"codeVoice","code":"text-y"},{"type":"text","text":" attribute."}]}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/textY","interfaceLanguage":"swift"},"kind":"symbol","references":{"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLEnding/textY":{"abstract":[{"type":"text","text":"The vertical offset specifying where the baseline of the start of the ending text appears, relative to the"},{"type":"text","text":" "},{"type":"text","text":"start of the ending line."}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"textY","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLTenths","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLTenthsa"},{"text":"?","kind":"text"}],"url":"\/documentation\/ivormxl\/mxlending\/texty","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/textY","title":"textY","kind":"symbol","type":"topic","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLEnding":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding","role":"symbol","navigatorTitle":[{"text":"MXLEnding","kind":"identifier"}],"type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLEnding","kind":"identifier"}],"abstract":[{"type":"text","text":"The ending type represents multiple (e.g. first and second) endings. Typically, the start type is associated"},{"type":"text","text":" "},{"type":"text","text":"with the left barline of the first measure in an ending. The stop and discontinue types are associated with"},{"type":"text","text":" "},{"type":"text","text":"the right barline of the last measure in an ending. Stop is used when the ending mark concludes with a"},{"type":"text","text":" "},{"type":"text","text":"downward jog, as is typical for first endings. Discontinue is used when there is no downward jog, as is"},{"type":"text","text":" "},{"type":"text","text":"typical for second endings that do not conclude a piece. The length of the jog can be specified using the end-"},{"type":"text","text":" "},{"type":"text","text":"length attribute. The text-x and text-y attributes are offsets that specify where the baseline of the start of"},{"type":"text","text":" "},{"type":"text","text":"the ending text appears, relative to the start of the ending line."}],"url":"\/documentation\/ivormxl\/mxlending","title":"MXLEnding"},"doc://IvorMXL/documentation/IvorMXL/MXLTenths":{"title":"MXLTenths","type":"topic","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTenths","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxltenths","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"MXLTenths","kind":"identifier"}],"abstract":[{"type":"text","text":"The tenths type is a number representing tenths of interline staff space (positive or negative). Both integer"},{"type":"text","text":" "},{"type":"text","text":"and decimal values are allowed, such as 5 for a half space and 2.5 for a quarter space. Interline space is"},{"type":"text","text":" "},{"type":"text","text":"measured from the middle of a staff line."}]}}}