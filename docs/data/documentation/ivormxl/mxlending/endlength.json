{"kind":"symbol","abstract":[{"type":"text","text":"The length of the downward jog at the end of the ending line."}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding"]]},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"endLength"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLTenthsa","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths","text":"MXLTenths"},{"kind":"text","text":"?"}],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Maps to the MusicXML "},{"code":"end-length","type":"codeVoice"},{"type":"text","text":" attribute."}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/ivormxl\/mxlending\/endlength"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"modules":[{"name":"IvorMXL"}],"symbolKind":"property","role":"symbol","title":"endLength","roleHeading":"Instance Property","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"endLength"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLTenthsa","text":"MXLTenths"},{"kind":"text","text":"?"}],"externalID":"s:7IvorMXL9MXLEndingV9endLengthSdSgvp"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/endLength"},"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLTenths":{"type":"topic","abstract":[{"type":"text","text":"The tenths type is a number representing tenths of interline staff space (positive or negative). Both integer"},{"type":"text","text":" "},{"type":"text","text":"and decimal values are allowed, such as 5 for a half space and 2.5 for a quarter space. Interline space is"},{"type":"text","text":" "},{"type":"text","text":"measured from the middle of a staff line."}],"url":"\/documentation\/ivormxl\/mxltenths","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTenths"}],"kind":"symbol","title":"MXLTenths","navigatorTitle":[{"kind":"identifier","text":"MXLTenths"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTenths","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLEnding/endLength":{"kind":"symbol","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"endLength","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL9MXLTenthsa","text":"MXLTenths","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/endLength","type":"topic","abstract":[{"text":"The length of the downward jog at the end of the ending line.","type":"text"}],"title":"endLength","url":"\/documentation\/ivormxl\/mxlending\/endlength"},"doc://IvorMXL/documentation/IvorMXL/MXLEnding":{"type":"topic","title":"MXLEnding","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding","abstract":[{"type":"text","text":"The ending type represents multiple (e.g. first and second) endings. Typically, the start type is associated"},{"type":"text","text":" "},{"type":"text","text":"with the left barline of the first measure in an ending. The stop and discontinue types are associated with"},{"type":"text","text":" "},{"type":"text","text":"the right barline of the last measure in an ending. Stop is used when the ending mark concludes with a"},{"type":"text","text":" "},{"type":"text","text":"downward jog, as is typical for first endings. Discontinue is used when there is no downward jog, as is"},{"type":"text","text":" "},{"type":"text","text":"typical for second endings that do not conclude a piece. The length of the jog can be specified using the end-"},{"type":"text","text":" "},{"type":"text","text":"length attribute. The text-x and text-y attributes are offsets that specify where the baseline of the start of"},{"type":"text","text":" "},{"type":"text","text":"the ending text appears, relative to the start of the ending line."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLEnding"}],"navigatorTitle":[{"kind":"identifier","text":"MXLEnding"}],"url":"\/documentation\/ivormxl\/mxlending"}}}