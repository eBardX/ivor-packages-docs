ind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLEnding/Number-swift.typealias":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlending\/number-swift.typealias","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/Number-swift.typealias","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"Number"}],"kind":"symbol","abstract":[{"text":"The ending-number type is used to specify the positive integers (without leading zeros) of the ending element.","type":"text"},{"text":" ","type":"text"},{"text":"An empty array is used when software knows that an ending is present, but cannot determine the type of the","type":"text"},{"text":" ","type":"text"},{"text":"ending.","type":"text"}],"type":"topic","navigatorTitle":[{"text":"Number","kind":"identifier"}],"title":"MXLEnding.Number"},"doc://IvorMXL/documentation/IvorMXL/MXLEnding/number-swift.property":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlending\/number-swift.property","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/number-swift.property","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"number","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Number","preciseIdentifier":"s:7IvorMXL9MXLEndingV6Numbera","kind":"typeIdentifier"}],"abstract":[{"type":"text","text":"Indicates which times the ending is played, similar to the time-only attribute used by other elements."}],"kind":"symbol","type":"topic","title":"number"},"doc://IvorMXL/documentation/IvorMXL/MXLEnding":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLEnding"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLEnding"}],"url":"\/documentation\/ivormxl\/mxlending","abstract":[{"text":"The ending type represents multiple (e.g. first and second) endings. Typically, the start type is associated","type":"text"},{"text":" ","type":"text"},{"text":"with the left barline of the first measure in an ending. The stop and discontinue types are associated with","type":"text"},{"text":" ","type":"text"},{"text":"the right barline of the last measure in an ending. Stop is used when the ending mark concludes with a","type":"text"},{"text":" ","type":"text"},{"text":"downward jog, as is typical for first endings. Discontinue is used when there is no downward jog, as is","type":"text"},{"text":" ","type":"text"},{"text":"typical for second endings that do not conclude a piece. The length of the jog can be specified using the end-","type":"text"},{"text":" ","type":"text"},{"text":"length attribute. The text-x and text-y attributes are offsets that specify where the baseline of the start of","type":"text"},{"text":" ","type":"text"},{"text":"the ending text appears, relative to the start of the ending line.","type":"text"}],"title":"MXLEnding","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding","kind":"symbol"}}}