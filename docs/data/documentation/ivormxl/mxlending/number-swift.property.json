formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLEnding":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding","role":"symbol","navigatorTitle":[{"text":"MXLEnding","kind":"identifier"}],"type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLEnding","kind":"identifier"}],"abstract":[{"type":"text","text":"The ending type represents multiple (e.g. first and second) endings. Typically, the start type is associated"},{"type":"text","text":" "},{"type":"text","text":"with the left barline of the first measure in an ending. The stop and discontinue types are associated with"},{"type":"text","text":" "},{"type":"text","text":"the right barline of the last measure in an ending. Stop is used when the ending mark concludes with a"},{"type":"text","text":" "},{"type":"text","text":"downward jog, as is typical for first endings. Discontinue is used when there is no downward jog, as is"},{"type":"text","text":" "},{"type":"text","text":"typical for second endings that do not conclude a piece. The length of the jog can be specified using the end-"},{"type":"text","text":" "},{"type":"text","text":"length attribute. The text-x and text-y attributes are offsets that specify where the baseline of the start of"},{"type":"text","text":" "},{"type":"text","text":"the ending text appears, relative to the start of the ending line."}],"url":"\/documentation\/ivormxl\/mxlending","title":"MXLEnding"},"doc://IvorMXL/documentation/IvorMXL/MXLEnding/Number-swift.typealias":{"kind":"symbol","title":"MXLEnding.Number","url":"\/documentation\/ivormxl\/mxlending\/number-swift.typealias","role":"symbol","abstract":[{"type":"text","text":"The ending-number type is used to specify the positive integers (without leading zeros) of the ending element."},{"type":"text","text":" "},{"type":"text","text":"An empty array is used when software knows that an ending is present, but cannot determine the type of the"},{"type":"text","text":" "},{"type":"text","text":"ending."}],"navigatorTitle":[{"text":"Number","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/Number-swift.typealias","type":"topic","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Number","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLEnding/number-swift.property":{"kind":"symbol","title":"number","url":"\/documentation\/ivormxl\/mxlending\/number-swift.property","role":"symbol","abstract":[{"type":"text","text":"Indicates which times the ending is played, similar to the time-only attribute used by other elements."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/number-swift.property","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"number","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Number","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLEndingV6Numbera"}]}}}