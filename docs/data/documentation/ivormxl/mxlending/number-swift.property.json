{"variants":[{"paths":["\/documentation\/ivormxl\/mxlending\/number-swift.property"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/number-swift.property","interfaceLanguage":"swift"},"metadata":{"title":"number","externalID":"s:7IvorMXL9MXLEndingV6numberSaySiGvp","symbolKind":"property","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"number","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Number","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLEndingV6Numbera"}],"roleHeading":"Instance Property","role":"symbol","modules":[{"name":"IvorMXL"}]},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding"]]},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"number","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Number","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/Number-swift.typealias","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLEndingV6Numbera"}],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"Maps to the MusicXML ","type":"text"},{"type":"codeVoice","code":"number"},{"text":" attribute.","type":"text"}]}],"kind":"content"}],"abstract":[{"text":"Indicates which times the ending is played, similar to the time-only attribute used by other elements.","type":"text"}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLEnding":{"type":"topic","role":"symbol","abstract":[{"type":"text","text":"The ending type represents multiple (e.g. first and second) endings. Typically, the start type is associated"},{"type":"text","text":" "},{"type":"text","text":"with the left barline of the first measure in an ending. The stop and discontinue types are associated with"},{"type":"text","text":" "},{"type":"text","text":"the right barline of the last measure in an ending. Stop is used when the ending mark concludes with a"},{"type":"text","text":" "},{"type":"text","text":"downward jog, as is typical for first endings. Discontinue is used when there is no downward jog, as is"},{"type":"text","text":" "},{"type":"text","text":"typical for second endings that do not conclude a piece. The length of the jog can be specified using the end-"},{"type":"text","text":" "},{"type":"text","text":"length attribute. The text-x and text-y attributes are offsets that specify where the baseline of the start of"},{"type":"text","text":" "},{"type":"text","text":"the ending text appears, relative to the start of the ending line."}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding","title":"MXLEnding","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLEnding"}],"navigatorTitle":[{"kind":"identifier","text":"MXLEnding"}],"url":"\/documentation\/ivormxl\/mxlending"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLEnding/Number-swift.typealias":{"title":"MXLEnding.Number","url":"\/documentation\/ivormxl\/mxlending\/number-swift.typealias","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/Number-swift.typealias","type":"topic","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Number","kind":"identifier"}],"navigatorTitle":[{"text":"Number","kind":"identifier"}],"role":"symbol","abstract":[{"type":"text","text":"The ending-number type is used to specify the positive integers (without leading zeros) of the ending element."},{"type":"text","text":" "},{"type":"text","text":"An empty array is used when software knows that an ending is present, but cannot determine the type of the"},{"type":"text","text":" "},{"type":"text","text":"ending."}]},"doc://IvorMXL/documentation/IvorMXL/MXLEnding/number-swift.property":{"url":"\/documentation\/ivormxl\/mxlending\/number-swift.property","title":"number","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/number-swift.property","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"number","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Number","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLEndingV6Numbera"}],"role":"symbol","abstract":[{"text":"Indicates which times the ending is played, similar to the time-only attribute used by other elements.","type":"text"}]}}}