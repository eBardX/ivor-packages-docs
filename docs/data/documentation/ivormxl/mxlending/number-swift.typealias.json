{"sections":[],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding"]]},"abstract":[{"type":"text","text":"The ending-number type is used to specify the positive integers (without leading zeros) of the ending element."},{"type":"text","text":" "},{"type":"text","text":"An empty array is used when software knows that an ending is present, but cannot determine the type of the"},{"type":"text","text":" "},{"type":"text","text":"ending."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Number","kind":"identifier"},{"text":" = [","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}]}],"variants":[{"paths":["\/documentation\/ivormxl\/mxlending\/number-swift.typealias"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"Number"}],"title":"MXLEnding.Number","externalID":"s:7IvorMXL9MXLEndingV6Numbera","extendedModule":"IvorMXL","roleHeading":"Type Alias","modules":[{"name":"IvorMXL"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Number"}],"symbolKind":"typealias"},"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/Number-swift.typealias"},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLEnding/Number-swift.typealias":{"url":"\/documentation\/ivormxl\/mxlending\/number-swift.typealias","abstract":[{"text":"The ending-number type is used to specify the positive integers (without leading zeros) of the ending element.","type":"text"},{"text":" ","type":"text"},{"text":"An empty array is used when software knows that an ending is present, but cannot determine the type of the","type":"text"},{"text":" ","type":"text"},{"text":"ending.","type":"text"}],"kind":"symbol","title":"MXLEnding.Number","navigatorTitle":[{"kind":"identifier","text":"Number"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/Number-swift.typealias","type":"topic","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"Number"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLEnding":{"title":"MXLEnding","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLEnding"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlending","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding","abstract":[{"text":"The ending type represents multiple (e.g. first and second) endings. Typically, the start type is associated","type":"text"},{"text":" ","type":"text"},{"text":"with the left barline of the first measure in an ending. The stop and discontinue types are associated with","type":"text"},{"text":" ","type":"text"},{"text":"the right barline of the last measure in an ending. Stop is used when the ending mark concludes with a","type":"text"},{"text":" ","type":"text"},{"text":"downward jog, as is typical for first endings. Discontinue is used when there is no downward jog, as is","type":"text"},{"text":" ","type":"text"},{"text":"typical for second endings that do not conclude a piece. The length of the jog can be specified using the end-","type":"text"},{"text":" ","type":"text"},{"text":"length attribute. The text-x and text-y attributes are offsets that specify where the baseline of the start of","type":"text"},{"text":" ","type":"text"},{"text":"the ending text appears, relative to the start of the ending line.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"MXLEnding"}]},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"}}}