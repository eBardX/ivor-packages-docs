{"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"kind"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL23MXLStartStopDiscontinueO","kind":"typeIdentifier","text":"MXLStartStopDiscontinue","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStartStopDiscontinue"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Maps to the MusicXML "},{"type":"codeVoice","code":"type"},{"type":"text","text":" attribute."}]}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/kind"},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlending\/kind"]}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding"]]},"sections":[],"abstract":[{"type":"text","text":"Whether this ending starts, stops, or discontinues, determining which barline it is associated with and"},{"type":"text","text":" "},{"type":"text","text":"whether a downward jog is drawn."}],"metadata":{"symbolKind":"property","externalID":"s:7IvorMXL9MXLEndingV4kindAA23MXLStartStopDiscontinueOvp","modules":[{"name":"IvorMXL"}],"roleHeading":"Instance Property","role":"symbol","title":"kind","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"kind"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL23MXLStartStopDiscontinueO","kind":"typeIdentifier","text":"MXLStartStopDiscontinue"}]},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLStartStopDiscontinue":{"type":"topic","title":"MXLStartStopDiscontinue","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStartStopDiscontinue","abstract":[{"text":"The start-stop-discontinue type is used to specify ending types. Typically, the start type is associated with","type":"text"},{"text":" ","type":"text"},{"text":"the left barline of the first measure in an ending. The stop and discontinue types are associated with the","type":"text"},{"text":" ","type":"text"},{"text":"right barline of the last measure in an ending. Stop is used when the ending mark concludes with a downward","type":"text"},{"text":" ","type":"text"},{"text":"jog, as is typical for first endings. Discontinue is used when there is no downward jog, as is typical for","type":"text"},{"text":" ","type":"text"},{"text":"second endings that do not conclude a piece.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLStartStopDiscontinue"}],"navigatorTitle":[{"kind":"identifier","text":"MXLStartStopDiscontinue"}],"url":"\/documentation\/ivormxl\/mxlstartstopdiscontinue"},"doc://IvorMXL/documentation/IvorMXL/MXLEnding/kind":{"kind":"symbol","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"kind","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL23MXLStartStopDiscontinueO","text":"MXLStartStopDiscontinue","kind":"typeIdentifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding\/kind","type":"topic","abstract":[{"text":"Whether this ending starts, stops, or discontinues, determining which barline it is associated with and","type":"text"},{"text":" ","type":"text"},{"text":"whether a downward jog is drawn.","type":"text"}],"title":"kind","url":"\/documentation\/ivormxl\/mxlending\/kind"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLEnding":{"type":"topic","title":"MXLEnding","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding","abstract":[{"type":"text","text":"The ending type represents multiple (e.g. first and second) endings. Typically, the start type is associated"},{"type":"text","text":" "},{"type":"text","text":"with the left barline of the first measure in an ending. The stop and discontinue types are associated with"},{"type":"text","text":" "},{"type":"text","text":"the right barline of the last measure in an ending. Stop is used when the ending mark concludes with a"},{"type":"text","text":" "},{"type":"text","text":"downward jog, as is typical for first endings. Discontinue is used when there is no downward jog, as is"},{"type":"text","text":" "},{"type":"text","text":"typical for second endings that do not conclude a piece. The length of the jog can be specified using the end-"},{"type":"text","text":" "},{"type":"text","text":"length attribute. The text-x and text-y attributes are offsets that specify where the baseline of the start of"},{"type":"text","text":" "},{"type":"text","text":"the ending text appears, relative to the start of the ending line."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLEnding"}],"navigatorTitle":[{"kind":"identifier","text":"MXLEnding"}],"url":"\/documentation\/ivormxl\/mxlending"}}}