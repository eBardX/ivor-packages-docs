vel\/hashable-implementations","title":"Hashable Implementations","type":"topic","abstract":[]},"doc://IvorMXL/SQ":{"type":"unresolvable","identifier":"doc:\/\/IvorMXL\/SQ","title":"Swift.Equatable"},"doc://IvorMXL/documentation/IvorMXL/MXLNumberLevel/UIntRepresentable-Implementations":{"role":"collectionGroup","kind":"article","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumberLevel\/UIntRepresentable-Implementations","url":"\/documentation\/ivormxl\/mxlnumberlevel\/uintrepresentable-implementations","title":"UIntRepresentable Implementations","type":"topic","abstract":[]},"doc://IvorMXL/documentation/IvorMXL/MXLNumberLevel/uintValue":{"url":"\/documentation\/ivormxl\/mxlnumberlevel\/uintvalue","title":"uintValue","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"uintValue"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Su","text":"UInt"}],"abstract":[{"text":"Distinguishes up to 16 concurrent objects of the same type when the objects overlap in MusicXML document","type":"text"},{"text":" ","type":"text"},{"text":"order.","type":"text"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumberLevel\/uintValue"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/s16SendableMetatypeP":{"type":"unresolvable","identifier":"doc:\/\/IvorMXL\/s16SendableMetatypeP","title":"Swift.SendableMetatype"},"doc://IvorMXL/10XestiTools17UIntRepresentableP":{"type":"unresolvable","identifier":"doc:\/\/IvorMXL\/10XestiTools17UIntRepresentableP","title":"XestiTools.UIntRepresentable"}}}