ol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumberLevel\/uintValue","title":"uintValue","url":"\/documentation\/ivormxl\/mxlnumberlevel\/uintvalue","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNumberLevel/UIntRepresentable-Implementations":{"abstract":[],"kind":"article","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumberLevel\/UIntRepresentable-Implementations","title":"UIntRepresentable Implementations","url":"\/documentation\/ivormxl\/mxlnumberlevel\/uintrepresentable-implementations","role":"collectionGroup"},"doc://IvorMXL/s27ExpressibleByIntegerLiteralP":{"type":"unresolvable","identifier":"doc:\/\/IvorMXL\/s27ExpressibleByIntegerLiteralP","title":"Swift.ExpressibleByIntegerLiteral"},"doc://IvorMXL/SL":{"type":"unresolvable","identifier":"doc:\/\/IvorMXL\/SL","title":"Swift.Comparable"},"doc://IvorMXL/SH":{"type":"unresolvable","identifier":"doc:\/\/IvorMXL\/SH","title":"Swift.Hashable"},"doc://IvorMXL/documentation/IvorMXL/MXLNumberLevel/init(uintValue:)":{"url":"\/documentation\/ivormxl\/mxlnumberlevel\/init(uintvalue:)","title":"init(uintValue:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"?("},{"kind":"externalParam","text":"uintValue"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Su","text":"UInt"},{"kind":"text","text":")"}],"abstract":[{"type":"text","text":"Creates a new "},{"code":"MXLNumberLevel","type":"codeVoice"},{"type":"text","text":" with the provided unsigned integer value."}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumberLevel\/init(uintValue:)","type":"topic","role":"symbol"},"doc://IvorMXL/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/IvorMXL\/s8SendableP","title":"Swift.Sendable"},"doc://IvorMXL/documentation/IvorMXL/MXLNumberLevel":{"type":"topic","url":"\/documentation\/ivormxl\/mxlnumberlevel","role":"symbol","title":"MXLNumberLevel","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumberLevel","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNumberLevel","kind":"identifier"}],"abstract":[{"text":"Slurs, tuplets, and many other features can be concurrent and overlap within a single musical part. The","type":"text"},{"text":" ","type":"text"},{"text":"number-level entity distinguishes up to 16 concurrent objects of the same type when the objects overlap in","type":"text"},{"text":" ","type":"text"},{"text":"MusicXML document order. Values greater than 6 are usually only needed for music with a large number of divisi","type":"text"},{"text":" ","type":"text"},{"text":"staves in a single part, or if there are more than 6 cross-staff arpeggios in a single measure. When a number-","type":"text"},{"text":" ","type":"text"},{"text":"level value is implied, the value is 1 by default.","type":"text"}],"navigatorTitle":[{"text":"MXLNumberLevel","kind":"identifier"}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNumberLevel/CustomStringConvertible-Implementations":{"abstract":[],"kind":"article","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumberLevel\/CustomStringConvertible-Implementations","title":"CustomStringConvertible Implementations","url":"\/documentation\/ivormxl\/mxlnumberlevel\/customstringconvertible-implementations","role":"collectionGroup"},"doc://IvorMXL/Se":{"type":"unresolvable","identifier":"doc:\/\/IvorMXL\/Se","title":"Swift.Decodable"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/SQ":{"type":"unresolvable","identifier":"doc:\/\/IvorMXL\/SQ","title":"Swift.Equatable"}}}