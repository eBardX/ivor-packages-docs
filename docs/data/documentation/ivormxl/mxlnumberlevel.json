gios in a single measure. When a number-","type":"text"},{"text":" ","type":"text"},{"text":"level value is implied, the value is 1 by default.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"MXLNumberLevel"}]},"doc://IvorMXL/documentation/IvorMXL/MXLNumberLevel/init(uintValue:)":{"url":"\/documentation\/ivormxl\/mxlnumberlevel\/init(uintvalue:)","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumberLevel\/init(uintValue:)","kind":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"?("},{"kind":"externalParam","text":"uintValue"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"UInt","preciseIdentifier":"s:Su"},{"kind":"text","text":")"}],"abstract":[{"text":"Creates a new ","type":"text"},{"code":"MXLNumberLevel","type":"codeVoice"},{"text":" with the provided unsigned integer value.","type":"text"}],"title":"init(uintValue:)","type":"topic","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLNumberLevel/Comparable-Implementations":{"url":"\/documentation\/ivormxl\/mxlnumberlevel\/comparable-implementations","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumberLevel\/Comparable-Implementations","kind":"article","abstract":[],"title":"Comparable Implementations","type":"topic","role":"collectionGroup"},"doc://IvorMXL/10XestiTools17UIntRepresentableP":{"identifier":"doc:\/\/IvorMXL\/10XestiTools17UIntRepresentableP","type":"unresolvable","title":"XestiTools.UIntRepresentable"},"doc://IvorMXL/s8SendableP":{"identifier":"doc:\/\/IvorMXL\/s8SendableP","type":"unresolvable","title":"Swift.Sendable"}}}