ith cue size, whether defined explicitly or implicitly via"},{"type":"text","text":" "},{"type":"text","text":"a cue element. The large type is used for notes of large size. The text content represent the numeric"},{"type":"text","text":" "},{"type":"text","text":"percentage. A value of 100 would be identical to the size of a regular note as defined by the music font."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNoteSize"}],"title":"MXLNoteSize","navigatorTitle":[{"kind":"identifier","text":"MXLNoteSize"}],"url":"\/documentation\/ivormxl\/mxlnotesize","kind":"symbol","type":"topic","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNoteSize"}}}