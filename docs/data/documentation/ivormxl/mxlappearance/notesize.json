type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLAppearance/noteSize":{"abstract":[{"type":"text","text":"The percentages of the regular note size used for cue and large notes."}],"title":"noteSize","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"noteSize"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:7IvorMXL11MXLNoteSizeV","kind":"typeIdentifier","text":"MXLNoteSize"},{"kind":"text","text":"]"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlappearance\/notesize","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAppearance\/noteSize"},"doc://IvorMXL/documentation/IvorMXL/MXLNoteSize":{"abstract":[{"type":"text","text":"The note-size type indicates the percentage of the regular note size to use for notes with a cue and large"},{"type":"text","text":" "},{"type":"text","text":"size as defined in the type element. The grace type is used for notes of cue size that that include a grace"},{"type":"text","text":" "},{"type":"text","text":"element. The cue type is used for all other notes with cue size, whether defined explicitly or implicitly via"},{"type":"text","text":" "},{"type":"text","text":"a cue element. The large type is used for notes of large size. The text content represent the numeric"},{"type":"text","text":" "},{"type":"text","text":"percentage. A value of 100 would be identical to the size of a regular note as defined by the music font."}],"title":"MXLNoteSize","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNoteSize","kind":"identifier"}],"navigatorTitle":[{"text":"MXLNoteSize","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlnotesize","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNoteSize"},"doc://IvorMXL/documentation/IvorMXL/MXLAppearance":{"abstract":[{"type":"text","text":"The appearance type controls general graphical settings for the music’s final form appearance on a printed"},{"type":"text","text":" "},{"type":"text","text":"page of display. This includes support for line widths, definitions for note sizes, and standard distances"},{"type":"text","text":" "},{"type":"text","text":"between notation elements, plus an extension element for other aspects of appearance."}],"title":"MXLAppearance","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLAppearance"}],"navigatorTitle":[{"kind":"identifier","text":"MXLAppearance"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlappearance","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAppearance"}}}