{"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAppearance"]]},"sections":[],"variants":[{"paths":["\/documentation\/ivormxl\/mxlappearance\/glyph"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"The SMuFL glyphs used for different variations of semantically identical symbols.","type":"text"}],"kind":"symbol","identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAppearance\/glyph","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"glyph","kind":"identifier"},{"text":": [","kind":"text"},{"text":"MXLGlyph","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLGlyph","preciseIdentifier":"s:7IvorMXL8MXLGlyphV","kind":"typeIdentifier"},{"text":"]","kind":"text"}]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"Maps to nested MusicXML ","type":"text"},{"code":"<glyph>","type":"codeVoice"},{"text":" elements.","type":"text"}],"type":"paragraph"}]}],"metadata":{"role":"symbol","externalID":"s:7IvorMXL13MXLAppearanceV5glyphSayAA8MXLGlyphVGvp","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"text":"glyph","kind":"identifier"},{"kind":"text","text":": ["},{"text":"MXLGlyph","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLGlyphV"},{"kind":"text","text":"]"}],"modules":[{"name":"IvorMXL"}],"roleHeading":"Instance Property","title":"glyph","symbolKind":"property"},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLGlyph":{"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlglyph","abstract":[{"type":"text","text":"The glyph element represents what SMuFL glyph should be used for different variations of symbols that are"},{"type":"text","text":" "},{"type":"text","text":"semantically identical. The type attribute specifies what type of glyph is being defined. The element value"},{"type":"text","text":" "},{"type":"text","text":"specifies what SMuFL glyph to use, including recommended stylistic alternates. The SMuFL glyph name should"},{"type":"text","text":" "},{"type":"text","text":"match the type. For instance, a type of quarter-rest would use values restQuarter, restQuarterOld, or"},{"type":"text","text":" "},{"type":"text","text":"restQuarterZ. A type of g-clef-ottava-bassa would use values gClef8vb, gClef8vbOld, or gClef8vbCClef. A type"},{"type":"text","text":" "},{"type":"text","text":"of octave-shift-up-8 would use values ottava, ottavaBassa, ottavaBassaBa, ottavaBassaVb, or octaveBassa."}],"navigatorTitle":[{"text":"MXLGlyph","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLGlyph","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLGlyph","title":"MXLGlyph"},"doc://IvorMXL/documentation/IvorMXL/MXLAppearance/glyph":{"abstract":[{"type":"text","text":"The SMuFL glyphs used for different variations of semantically identical symbols."}],"url":"\/documentation\/ivormxl\/mxlappearance\/glyph","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"glyph","kind":"identifier"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:7IvorMXL8MXLGlyphV","kind":"typeIdentifier","text":"MXLGlyph"},{"kind":"text","text":"]"}],"type":"topic","title":"glyph","role":"symbol","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAppearance\/glyph"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLAppearance":{"abstract":[{"text":"The appearance type controls general graphical settings for the music’s final form appearance on a printed","type":"text"},{"text":" ","type":"text"},{"text":"page of display. This includes support for line widths, definitions for note sizes, and standard distances","type":"text"},{"type":"text","text":" "},{"text":"between notation elements, plus an extension element for other aspects of appearance.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlappearance","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLAppearance","kind":"identifier"}],"navigatorTitle":[{"text":"MXLAppearance","kind":"identifier"}],"type":"topic","title":"MXLAppearance","role":"symbol","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAppearance"}}}