Identifier","preciseIdentifier":"s:7IvorMXL8MXLGlyphV","text":"MXLGlyph"},{"kind":"text","text":"]"}],"url":"\/documentation\/ivormxl\/mxlappearance\/glyph","role":"symbol","type":"topic","abstract":[{"text":"The SMuFL glyphs used for different variations of semantically identical symbols.","type":"text"}],"kind":"symbol","title":"glyph"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLGlyph":{"url":"\/documentation\/ivormxl\/mxlglyph","title":"MXLGlyph","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLGlyph","kind":"identifier"}],"abstract":[{"type":"text","text":"The glyph element represents what SMuFL glyph should be used for different variations of symbols that are"},{"type":"text","text":" "},{"type":"text","text":"semantically identical. The type attribute specifies what type of glyph is being defined. The element value"},{"type":"text","text":" "},{"type":"text","text":"specifies what SMuFL glyph to use, including recommended stylistic alternates. The SMuFL glyph name should"},{"type":"text","text":" "},{"type":"text","text":"match the type. For instance, a type of quarter-rest would use values restQuarter, restQuarterOld, or"},{"type":"text","text":" "},{"type":"text","text":"restQuarterZ. A type of g-clef-ottava-bassa would use values gClef8vb, gClef8vbOld, or gClef8vbCClef. A type"},{"type":"text","text":" "},{"type":"text","text":"of octave-shift-up-8 would use values ottava, ottavaBassa, ottavaBassaBa, ottavaBassaVb, or octaveBassa."}],"navigatorTitle":[{"text":"MXLGlyph","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLGlyph","kind":"symbol","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLAppearance":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAppearance","abstract":[{"type":"text","text":"The appearance type controls general graphical settings for the music’s final form appearance on a printed"},{"type":"text","text":" "},{"type":"text","text":"page of display. This includes support for line widths, definitions for note sizes, and standard distances"},{"type":"text","text":" "},{"type":"text","text":"between notation elements, plus an extension element for other aspects of appearance."}],"title":"MXLAppearance","navigatorTitle":[{"text":"MXLAppearance","kind":"identifier"}],"kind":"symbol","type":"topic","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLAppearance","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlappearance"}}}