{"metadata":{"role":"symbol","title":"glyph","externalID":"s:7IvorMXL13MXLAppearanceV5glyphSayAA8MXLGlyphVGvp","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"glyph","kind":"identifier"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:7IvorMXL8MXLGlyphV","text":"MXLGlyph","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"modules":[{"name":"IvorMXL"}],"roleHeading":"Instance Property","symbolKind":"property"},"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"glyph"},{"kind":"text","text":": ["},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLGlyph","kind":"typeIdentifier","text":"MXLGlyph","preciseIdentifier":"s:7IvorMXL8MXLGlyphV"},{"kind":"text","text":"]"}]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Maps to nested MusicXML "},{"code":"<glyph>","type":"codeVoice"},{"type":"text","text":" elements."}]}]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAppearance"]]},"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAppearance\/glyph","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"The SMuFL glyphs used for different variations of semantically identical symbols."}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlappearance\/glyph"]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLGlyph":{"abstract":[{"type":"text","text":"The glyph element represents what SMuFL glyph should be used for different variations of symbols that are"},{"type":"text","text":" "},{"type":"text","text":"semantically identical. The type attribute specifies what type of glyph is being defined. The element value"},{"type":"text","text":" "},{"type":"text","text":"specifies what SMuFL glyph to use, including recommended stylistic alternates. The SMuFL glyph name should"},{"type":"text","text":" "},{"type":"text","text":"match the type. For instance, a type of quarter-rest would use values restQuarter, restQuarterOld, or"},{"type":"text","text":" "},{"type":"text","text":"restQuarterZ. A type of g-clef-ottava-bassa would use values gClef8vb, gClef8vbOld, or gClef8vbCClef. A type"},{"type":"text","text":" "},{"type":"text","text":"of octave-shift-up-8 would use values ottava, ottavaBassa, ottavaBassaBa, ottavaBassaVb, or octaveBassa."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLGlyph","url":"\/documentation\/ivormxl\/mxlglyph","navigatorTitle":[{"text":"MXLGlyph","kind":"identifier"}],"title":"MXLGlyph","role":"symbol","type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLGlyph","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLAppearance":{"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAppearance","title":"MXLAppearance","navigatorTitle":[{"text":"MXLAppearance","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLAppearance","kind":"identifier"}],"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlappearance","abstract":[{"text":"The appearance type controls general graphical settings for the music’s final form appearance on a printed","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"page of display. This includes support for line widths, definitions for note sizes, and standard distances"},{"type":"text","text":" "},{"type":"text","text":"between notation elements, plus an extension element for other aspects of appearance."}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXM