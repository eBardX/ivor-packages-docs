ons of semantically identical symbols.","type":"text"}],"role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"glyph"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:7IvorMXL8MXLGlyphV","kind":"typeIdentifier","text":"MXLGlyph"},{"kind":"text","text":"]"}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLAppearance":{"url":"\/documentation\/ivormxl\/mxlappearance","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAppearance","title":"MXLAppearance","abstract":[{"text":"The appearance type controls general graphical settings for the music’s final form appearance on a printed","type":"text"},{"text":" ","type":"text"},{"text":"page of display. This includes support for line widths, definitions for note sizes, and standard distances","type":"text"},{"text":" ","type":"text"},{"text":"between notation elements, plus an extension element for other aspects of appearance.","type":"text"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLAppearance"}],"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLAppearance"}]},"doc://IvorMXL/documentation/IvorMXL/MXLGlyph":{"navigatorTitle":[{"text":"MXLGlyph","kind":"identifier"}],"abstract":[{"text":"The glyph element represents what SMuFL glyph should be used for different variations of symbols that are","type":"text"},{"text":" ","type":"text"},{"text":"semantically identical. The type attribute specifies what type of glyph is being defined. The element value","type":"text"},{"text":" ","type":"text"},{"text":"specifies what SMuFL glyph to use, including recommended stylistic alternates. The SMuFL glyph name should","type":"text"},{"text":" ","type":"text"},{"text":"match the type. For instance, a type of quarter-rest would use values restQuarter, restQuarterOld, or","type":"text"},{"text":" ","type":"text"},{"text":"restQuarterZ. A type of g-clef-ottava-bassa would use values gClef8vb, gClef8vbOld, or gClef8vbCClef. A type","type":"text"},{"text":" ","type":"text"},{"text":"of octave-shift-up-8 would use values ottava, ottavaBassa, ottavaBassaBa, ottavaBassaVb, or octaveBassa.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLGlyph","url":"\/documentation\/ivormxl\/mxlglyph","role":"symbol","title":"MXLGlyph","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLGlyph","kind":"identifier"}]}}}