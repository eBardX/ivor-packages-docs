"text":"init","kind":"keyword"},{"text":"(","kind":"text"},{"text":"lineWidth","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"MXLLineWidth","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL12MXLLineWidthV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLineWidth"},{"text":"] = [], ","kind":"text"},{"text":"noteSize","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"MXLNoteSize","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLNoteSizeV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNoteSize"},{"text":"] = [], ","kind":"text"},{"text":"distance","kind":"externalParam"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:7IvorMXL11MXLDistanceV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDistance","text":"MXLDistance","kind":"typeIdentifier"},{"text":"] = [], ","kind":"text"},{"text":"glyph","kind":"externalParam"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:7IvorMXL8MXLGlyphV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLGlyph","text":"MXLGlyph","kind":"typeIdentifier"},{"text":"] = [], ","kind":"text"},{"text":"otherAppearance","kind":"externalParam"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:7IvorMXL18MXLOtherAppearanceV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOtherAppearance","text":"MXLOtherAppearance","kind":"typeIdentifier"},{"text":"] = [])","kind":"text"}],"languages":["swift"],"platforms":["macOS"]}]},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The widths of the various line types used in the score."}]}],"name":"lineWidth"},{"content":[{"inlineContent":[{"text":"The percentages of the regular note size used for cue and large notes.","type":"text"}],"type":"paragraph"}],"name":"noteSize"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The standard distances between notation elements."}]}],"name":"distance"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The SMuFL glyphs used for different variations of semantically identical symbols."}]}],"name":"glyph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Any graphical settings not yet defined elsewhere in the MusicXML format."}]}],"name":"otherAppearance"}],"kind":"parameters"}],"variants":[{"paths":["\/documentation\/ivormxl\/mxlappearance\/init(linewidth:notesize:distance:glyph:otherappearance:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLAppearance":{"abstract":[{"text":"The appearance type controls general graphical settings for the music’s final form appearance on a printed","type":"text"},{"text":" ","type":"text"},{"text":"page of display. This includes support for line widths, definitions for note sizes, and standard distances","type":"text"},{"type":"text","text":" "},{"text":"between notation elements, plus an extension element for other aspects of appearance.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlappearance","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLAppearance","kind":"identifier"}],"navigatorTitle":[{"text":"MXLAppearance","kind":"identifier"}],"type":"topic","title":"MXLAppearance","role":"symbol","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAppearance"},"doc://IvorMXL/documentation/IvorMXL/MXLOtherAppearance":{"kind":"symbol","url":"\/documentation\/ivormxl\/mxlotherappearance","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOtherAppearance","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLOtherAppearance","kind":"identifier"}],"navigatorTitle":[{"text":"MXLOtherAppearance","kind":"identifier"}],"role":"symbol","abstract":[{"type":"text","text":"The other-appearance type is used to define any graphical settings not yet in the current version of the"},{"type":"text","text":" "},{"type":"text","text":"MusicXML format. This allows extended representation, though without application interoperability."}],"type":"topic","title":"MXLOtherAppearance"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLGlyph":{"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlglyph","abstract":[{"type":"text","text":"The glyph element represents what SMuFL glyph should be used for different variations of symbols that are"},{"type":"text","text":" "},{"type":"text","text":"semantically identical. The type attribute specifies what type of glyph is being defined. The element value"},{"type":"text","text":" "},{"type":"text","text":"specifies what SMuFL glyph to use, including recommended stylistic alternates. The SMuFL glyph name should"},{"type":"text","text":" "},{"type":"text","text":"match the type. For instance, a type of quarter-rest would use values restQuarter, restQuarterOld, or"},{"type":"text","text":" "},{"type":"text","text":"restQuarterZ. A type of g-clef-ottava-bassa would use values gClef8vb, gClef8vbOld, or gClef8vbCClef. A type"},{"type":"text","text":" "},{"type":"text","text":"of octave-shift-up-8 would use values ottava, ottavaBassa, ottavaBassaBa, ottavaBassaVb, or octaveBassa."}],"navigatorTitle":[{"text":"MXLGlyph","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLGlyph","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLGlyph","title":"MXLGlyph"},"doc://IvorMXL/documentation/IvorMXL/MXLDistance":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDistance","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLDistance","kind":"identifier"}],"title":"MXLDistance","navigatorTitle":[{"text":"MXLDistance","kind":"identifier"}],"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxldistance","abstract":[{"text":"The distance element represents standard distances between notation elements in tenths. The type attribute","type":"text"},{"text":" ","type":"text"},{"text":"defines what type of distance is being defined. Valid values include hyphen (for hyphens in lyrics) and beam.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLNoteSize":{"title":"MXLNoteSize","navigatorTitle":[{"kind":"identifier","text":"MXLNoteSize"}],"type":"topic","abstract":[{"type":"text","text":"The note-size type indicates the percentage of the regular note size to use for notes with a cue and large"},{"type":"text","text":" "},{"type":"text","text":"size as defined in the type element. The grace type is used for notes of cue size that that include a grace"},{"type":"text","text":" "},{"type":"text","text":"element. The cue type is used for all other notes with cue size, whether defined explicitly or implicitly via"},{"type":"text","text":" "},{"type":"text","text":"a cue element. The large type is used for notes of large size. The text content represent the numeric"},{"type":"text","text":" "},{"type":"text","text":"percentage. A value of 100 would be identical to the size of a regular note as defined by the music font."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNoteSize"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNoteSize","url":"\/documentation\/ivormxl\/mxlnotesize"},"doc://IvorMXL/documentation/IvorMXL/MXLLineWidth":{"navigatorTitle":[{"kind":"identifier","text":"MXLLineWidth"}],"type":"topic","url":"\/documentation\/ivormxl\/mxllinewidth","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLineWidth","title":"MXLLineWidth","kind":"symbol","abstract":[{"text":"The line-width type indicates the width of a line type in tenths. The type attribute defines what type of line","type":"text"},{"text":" ","type":"text"},{"text":"is being defined. Values include beam, bracket, dashes, enclosure, ending, extend, heavy barline, leger, light","type":"text"},{"text":" ","type":"text"},{"text":"barline, octave shift, pedal, slur middle, slur tip, staff, stem, tie middle, tie tip, tuplet bracket, and","type":"text"},{"text":" ","type":"text"},{"text":"wedge. The text content is expressed in tenths.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLLineWidth"}]},"doc://IvorMXL/documentation/IvorMXL/MXLAppearance/init(lineWidth:noteSize:distance:glyph:otherAppearance:)":{"type":"topic","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAppearance\/init(lineWidth:noteSize:distance:glyph:otherAppearance:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"lineWidth","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"MXLLineWidth","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL12MXLLineWidthV"},{"text":"], ","kind":"text"},{"text":"noteSize","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"MXLNoteSize","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLNoteSizeV"},{"text":"], ","kind":"text"},{"text":"distance","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"MXLDistance","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLDistanceV"},{"text":"], ","kind":"text"},{"text":"glyph","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"MXLGlyph","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLGlyphV"},{"text":"], ","kind":"text"},{"text":"otherAppearance","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"MXLOtherAppearance","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL18MXLOtherAppearanceV"},{"text":"])","kind":"text"}],"title":"init(lineWidth:noteSize:distance:glyph:otherAppearance:)","role":"symbol","url":"\/documentation\/ivormxl\/mxlappearance\/init(linewidth:notesize:distance:glyph:otherappearance:)","abstract":[{"text":"Creates a new ","type":"text"},{"type":"codeVoice","code":"MXLAppearance"},{"text":".","type":"text"}]}}}