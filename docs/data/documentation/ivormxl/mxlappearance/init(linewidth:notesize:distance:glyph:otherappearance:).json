],"type":"paragraph"}]},{"name":"noteSize","content":[{"inlineContent":[{"type":"text","text":"The percentages of the regular note size used for cue and large notes."}],"type":"paragraph"}]},{"name":"distance","content":[{"inlineContent":[{"type":"text","text":"The standard distances between notation elements."}],"type":"paragraph"}]},{"name":"glyph","content":[{"inlineContent":[{"type":"text","text":"The SMuFL glyphs used for different variations of semantically identical symbols."}],"type":"paragraph"}]},{"name":"otherAppearance","content":[{"inlineContent":[{"type":"text","text":"Any graphical settings not yet defined elsewhere in the MusicXML format."}],"type":"paragraph"}]}],"kind":"parameters"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlappearance\/init(linewidth:notesize:distance:glyph:otherappearance:)"]}],"sections":[],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAppearance\/init(lineWidth:noteSize:distance:glyph:otherAppearance:)","interfaceLanguage":"swift"},"metadata":{"roleHeading":"Initializer","title":"init(lineWidth:noteSize:distance:glyph:otherAppearance:)","symbolKind":"init","modules":[{"name":"IvorMXL"}],"externalID":"s:7IvorMXL13MXLAppearanceV9lineWidth8noteSize8distance5glyph15otherAppearanceACSayAA07MXLLineE0VG_SayAA07MXLNoteG0VGSayAA11MXLDistanceVGSayAA8MXLGlyphVGSayAA08MXLOtherK0VGtcfc","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"lineWidth"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"MXLLineWidth","preciseIdentifier":"s:7IvorMXL12MXLLineWidthV"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"noteSize"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"MXLNoteSize","preciseIdentifier":"s:7IvorMXL11MXLNoteSizeV"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"distance"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"MXLDistance","preciseIdentifier":"s:7IvorMXL11MXLDistanceV"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"glyph"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"MXLGlyph","preciseIdentifier":"s:7IvorMXL8MXLGlyphV"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"otherAppearance"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"MXLOtherAppearance","preciseIdentifier":"s:7IvorMXL18MXLOtherAppearanceV"},{"kind":"text","text":"])"}],"role":"symbol"},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLGlyph":{"abstract":[{"text":"The glyph element represents what SMuFL glyph should be used for different variations of symbols that are","type":"text"},{"text":" ","type":"text"},{"text":"semantically identical. The type attribute specifies what type of glyph is being defined. The element value","type":"text"},{"text":" ","type":"text"},{"text":"specifies what SMuFL glyph to use, including recommended stylistic alternates. The SMuFL glyph name should","type":"text"},{"text":" ","type":"text"},{"text":"match the type. For instance, a type of quarter-rest would use values restQuarter, restQuarterOld, or","type":"text"},{"text":" ","type":"text"},{"text":"restQuarterZ. A type of g-clef-ottava-bassa would use values gClef8vb, gClef8vbOld, or gClef8vbCClef. A type","type":"text"},{"text":" ","type":"text"},{"text":"of octave-shift-up-8 would use values ottava, ottavaBassa, ottavaBassaBa, ottavaBassaVb, or octaveBassa.","type":"text"}],"title":"MXLGlyph","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLGlyph","kind":"identifier"}],"navigatorTitle":[{"text":"MXLGlyph","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlglyph","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLGlyph"},"doc://IvorMXL/documentation/IvorMXL/MXLOtherAppearance":{"abstract":[{"type":"text","text":"The other-appearance type is used to define any graphical settings not yet in the current version of the"},{"type":"text","text":" "},{"type":"text","text":"MusicXML format. This allows extended representation, though without application interoperability."}],"title":"MXLOtherAppearance","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLOtherAppearance","kind":"identifier"}],"navigatorTitle":[{"text":"MXLOtherAppearance","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlotherappearance","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOtherAppearance"},"doc://IvorMXL/documentation/IvorMXL/MXLAppearance":{"abstract":[{"type":"text","text":"The appearance type controls general graphical settings for the music’s final form appearance on a printed"},{"type":"text","text":" "},{"type":"text","text":"page of display. This includes support for line widths, definitions for note sizes, and standard distances"},{"type":"text","text":" "},{"type":"text","text":"between notation elements, plus an extension element for other aspects of appearance."}],"title":"MXLAppearance","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLAppearance"}],"navigatorTitle":[{"kind":"identifier","text":"MXLAppearance"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlappearance","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAppearance"},"doc://IvorMXL/documentation/IvorMXL/MXLNoteSize":{"abstract":[{"type":"text","text":"The note-size type indicates the percentage of the regular note size to use for notes with a cue and large"},{"type":"text","text":" "},{"type":"text","text":"size as defined in the type element. The grace type is used for notes of cue size that that include a grace"},{"type":"text","text":" "},{"type":"text","text":"element. The cue type is used for all other notes with cue size, whether defined explicitly or implicitly via"},{"type":"text","text":" "},{"type":"text","text":"a cue element. The large type is used for notes of large size. The text content represent the numeric"},{"type":"text","text":" "},{"type":"text","text":"percentage. A value of 100 would be identical to the size of a regular note as defined by the music font."}],"title":"MXLNoteSize","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNoteSize","kind":"identifier"}],"navigatorTitle":[{"text":"MXLNoteSize","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlnotesize","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNoteSize"},"doc://IvorMXL/documentation/IvorMXL/MXLLineWidth":{"title":"MXLLineWidth","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLLineWidth","kind":"identifier"}],"kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxllinewidth","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLineWidth","abstract":[{"text":"The line-width type indicates the width of a line type in tenths. The type attribute defines what type of line","type":"text"},{"text":" ","type":"text"},{"text":"is being defined. Values include beam, bracket, dashes, enclosure, ending, extend, heavy barline, leger, light","type":"text"},{"text":" ","type":"text"},{"text":"barline, octave shift, pedal, slur middle, slur tip, staff, stem, tie middle, tie tip, tuplet bracket, and","type":"text"},{"text":" ","type":"text"},{"text":"wedge. The text content is expressed in tenths.","type":"text"}],"navigatorTitle":[{"text":"MXLLineWidth","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLDistance":{"navigatorTitle":[{"text":"MXLDistance","kind":"identifier"}],"abstract":[{"text":"The distance element represents standard distances between notation elements in tenths. The type attribute","type":"text"},{"text":" ","type":"text"},{"text":"defines what type of distance is being defined. Valid values include hyphen (for hyphens in lyrics) and beam.","type":"text"}],"title":"MXLDistance","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDistance","kind":"symbol","url":"\/documentation\/ivormxl\/mxldistance","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLDistance","kind":"identifier"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLAppearance/init(lineWidth:noteSize:distance:glyph:otherAppearance:)":{"url":"\/documentation\/ivormxl\/mxlappearance\/init(linewidth:notesize:distance:glyph:otherappearance:)","kind":"symbol","title":"init(lineWidth:noteSize:distance:glyph:otherAppearance:)","abstract":[{"text":"Creates a new ","type":"text"},{"code":"MXLAppearance","type":"codeVoice"},{"text":".","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAppearance\/init(lineWidth:noteSize:distance:glyph:otherAppearance:)","type":"topic","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"lineWidth"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL12MXLLineWidthV","text":"MXLLineWidth"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"noteSize"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLNoteSizeV","text":"MXLNoteSize"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"distance"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLDistanceV","text":"MXLDistance"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"glyph"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLGlyphV","text":"MXLGlyph"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"otherAppearance"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL18MXLOtherAppearanceV","text":"MXLOtherAppearance"},{"kind":"text","text":"])"}],"role":"symbol"}}}