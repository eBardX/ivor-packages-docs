t"},{"kind":"text","text":"("},{"kind":"externalParam","text":"lineWidth"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLineWidth","text":"MXLLineWidth","preciseIdentifier":"s:7IvorMXL12MXLLineWidthV"},{"kind":"text","text":"] = [], "},{"kind":"externalParam","text":"noteSize"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNoteSize","text":"MXLNoteSize","preciseIdentifier":"s:7IvorMXL11MXLNoteSizeV"},{"kind":"text","text":"] = [], "},{"kind":"externalParam","text":"distance"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDistance","text":"MXLDistance","preciseIdentifier":"s:7IvorMXL11MXLDistanceV"},{"kind":"text","text":"] = [], "},{"kind":"externalParam","text":"glyph"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLGlyph","text":"MXLGlyph","preciseIdentifier":"s:7IvorMXL8MXLGlyphV"},{"kind":"text","text":"] = [], "},{"kind":"externalParam","text":"otherAppearance"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOtherAppearance","text":"MXLOtherAppearance","preciseIdentifier":"s:7IvorMXL18MXLOtherAppearanceV"},{"kind":"text","text":"] = [])"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The widths of the various line types used in the score."}]}],"name":"lineWidth"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The percentages of the regular note size used for cue and large notes."}]}],"name":"noteSize"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The standard distances between notation elements."}]}],"name":"distance"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The SMuFL glyphs used for different variations of semantically identical symbols."}]}],"name":"glyph"},{"content":[{"inlineContent":[{"type":"text","text":"Any graphical settings not yet defined elsewhere in the MusicXML format."}],"type":"paragraph"}],"name":"otherAppearance"}]}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAppearance\/init(lineWidth:noteSize:distance:glyph:otherAppearance:)","interfaceLanguage":"swift"},"sections":[],"kind":"symbol","references":{"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLOtherAppearance":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOtherAppearance","type":"topic","abstract":[{"type":"text","text":"The other-appearance type is used to define any graphical settings not yet in the current version of the"},{"type":"text","text":" "},{"type":"text","text":"MusicXML format. This allows extended representation, though without application interoperability."}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlotherappearance","title":"MXLOtherAppearance","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLOtherAppearance","kind":"identifier"}],"navigatorTitle":[{"text":"MXLOtherAppearance","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLLineWidth":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLineWidth","url":"\/documentation\/ivormxl\/mxllinewidth","title":"MXLLineWidth","type":"topic","kind":"symbol","abstract":[{"text":"The line-width type indicates the width of a line type in tenths. The type attribute defines what type of line","type":"text"},{"text":" ","type":"text"},{"text":"is being defined. Values include beam, bracket, dashes, enclosure, ending, extend, heavy barline, leger, light","type":"text"},{"text":" ","type":"text"},{"text":"barline, octave shift, pedal, slur middle, slur tip, staff, stem, tie middle, tie tip, tuplet bracket, and","type":"text"},{"text":" ","type":"text"},{"text":"wedge. The text content is expressed in tenths.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLLineWidth"}],"navigatorTitle":[{"kind":"identifier","text":"MXLLineWidth"}]},"doc://IvorMXL/documentation/IvorMXL/MXLGlyph":{"abstract":[{"type":"text","text":"The glyph element represents what SMuFL glyph should be used for different variations of symbols that are"},{"type":"text","text":" "},{"type":"text","text":"semantically identical. The type attribute specifies what type of glyph is being defined. The element value"},{"type":"text","text":" "},{"type":"text","text":"specifies what SMuFL glyph to use, including recommended stylistic alternates. The SMuFL glyph name should"},{"type":"text","text":" "},{"type":"text","text":"match the type. For instance, a type of quarter-rest would use values restQuarter, restQuarterOld, or"},{"type":"text","text":" "},{"type":"text","text":"restQuarterZ. A type of g-clef-ottava-bassa would use values gClef8vb, gClef8vbOld, or gClef8vbCClef. A type"},{"type":"text","text":" "},{"type":"text","text":"of octave-shift-up-8 would use values ottava, ottavaBassa, ottavaBassaBa, ottavaBassaVb, or octaveBassa."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLGlyph","url":"\/documentation\/ivormxl\/mxlglyph","navigatorTitle":[{"text":"MXLGlyph","kind":"identifier"}],"title":"MXLGlyph","role":"symbol","type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLGlyph","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLDistance":{"title":"MXLDistance","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLDistance","kind":"identifier"}],"navigatorTitle":[{"text":"MXLDistance","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDistance","url":"\/documentation\/ivormxl\/mxldistance","type":"topic","abstract":[{"type":"text","text":"The distance element represents standard distances between notation elements in tenths. The type attribute"},{"type":"text","text":" "},{"type":"text","text":"defines what type of distance is being defined. Valid values include hyphen (for hyphens in lyrics) and beam."}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLAppearance":{"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAppearance","title":"MXLAppearance","navigatorTitle":[{"text":"MXLAppearance","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLAppearance","kind":"identifier"}],"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlappearance","abstract":[{"text":"The appearance type controls general graphical settings for the music’s final form appearance on a printed","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"page of display. This includes support for line widths, definitions for note sizes, and standard distances"},{"type":"text","text":" "},{"type":"text","text":"between notation elements, plus an extension element for other aspects of appearance."}]},"doc://IvorMXL/documentation/IvorMXL/MXLNoteSize":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlnotesize","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNoteSize","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNoteSize"}],"abstract":[{"text":"The note-size type indicates the percentage of the regular note size to use for notes with a cue and large","type":"text"},{"text":" ","type":"text"},{"text":"size as defined in the type element. The grace type is used for notes of cue size that that include a grace","type":"text"},{"text":" ","type":"text"},{"text":"element. The cue type is used for all other notes with cue size, whether defined explicitly or implicitly via","type":"text"},{"text":" ","type":"text"},{"text":"a cue element. The large type is used for notes of large size. The text content represent the numeric","type":"text"},{"text":" ","type":"text"},{"text":"percentage. A value of 100 would be identical to the size of a regular note as defined by the music font.","type":"text"}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLNoteSize"}],"title":"MXLNoteSize"},"doc://IvorMXL/documentation/IvorMXL/MXLAppearance/init(lineWidth:noteSize:distance:glyph:otherAppearance:)":{"abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLAppearance"},{"type":"text","text":"."}],"kind":"symbol","role":"symbol","type":"topic","title":"init(lineWidth:noteSize:distance:glyph:otherAppearance:)","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAppearance\/init(lineWidth:noteSize:distance:glyph:otherAppearance:)","url":"\/documentation\/ivormxl\/mxlappearance\/init(linewidth:notesize:distance:glyph:otherappearance:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"lineWidth"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:7IvorMXL12MXLLineWidthV","kind":"typeIdentifier","text":"MXLLineWidth"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"noteSize"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:7IvorMXL11MXLNoteSizeV","kind":"typeIdentifier","text":"MXLNoteSize"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"distance"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:7IvorMXL11MXLDistanceV","kind":"typeIdentifier","text":"MXLDistance"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"glyph"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:7IvorMXL8MXLGlyphV","kind":"typeIdentifier","text":"MXLGlyph"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"otherAppearance"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:7IvorMXL18MXLOtherAppearanceV","kind":"typeIdentifier","text":"MXLOtherAppearance"},{"kind":"text","text":"])"}]}}}