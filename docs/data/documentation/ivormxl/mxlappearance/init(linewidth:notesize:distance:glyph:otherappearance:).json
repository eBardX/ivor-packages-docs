],"languages":["swift"]}]},{"parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The widths of the various line types used in the score."}],"type":"paragraph"}],"name":"lineWidth"},{"content":[{"inlineContent":[{"type":"text","text":"The percentages of the regular note size used for cue and large notes."}],"type":"paragraph"}],"name":"noteSize"},{"content":[{"inlineContent":[{"type":"text","text":"The standard distances between notation elements."}],"type":"paragraph"}],"name":"distance"},{"content":[{"inlineContent":[{"type":"text","text":"The SMuFL glyphs used for different variations of semantically identical symbols."}],"type":"paragraph"}],"name":"glyph"},{"content":[{"inlineContent":[{"type":"text","text":"Any graphical settings not yet defined elsewhere in the MusicXML format."}],"type":"paragraph"}],"name":"otherAppearance"}],"kind":"parameters"}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAppearance"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"externalID":"s:7IvorMXL13MXLAppearanceV9lineWidth8noteSize8distance5glyph15otherAppearanceACSayAA07MXLLineE0VG_SayAA07MXLNoteG0VGSayAA11MXLDistanceVGSayAA8MXLGlyphVGSayAA08MXLOtherK0VGtcfc","modules":[{"name":"IvorMXL"}],"roleHeading":"Initializer","title":"init(lineWidth:noteSize:distance:glyph:otherAppearance:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"lineWidth","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"MXLLineWidth","preciseIdentifier":"s:7IvorMXL12MXLLineWidthV","kind":"typeIdentifier"},{"text":"], ","kind":"text"},{"text":"noteSize","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"MXLNoteSize","preciseIdentifier":"s:7IvorMXL11MXLNoteSizeV","kind":"typeIdentifier"},{"text":"], ","kind":"text"},{"text":"distance","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"MXLDistance","preciseIdentifier":"s:7IvorMXL11MXLDistanceV","kind":"typeIdentifier"},{"text":"], ","kind":"text"},{"text":"glyph","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"MXLGlyph","preciseIdentifier":"s:7IvorMXL8MXLGlyphV","kind":"typeIdentifier"},{"text":"], ","kind":"text"},{"text":"otherAppearance","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"MXLOtherAppearance","preciseIdentifier":"s:7IvorMXL18MXLOtherAppearanceV","kind":"typeIdentifier"},{"text":"])","kind":"text"}],"role":"symbol","symbolKind":"init"},"references":{"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLGlyph":{"navigatorTitle":[{"text":"MXLGlyph","kind":"identifier"}],"abstract":[{"text":"The glyph element represents what SMuFL glyph should be used for different variations of symbols that are","type":"text"},{"text":" ","type":"text"},{"text":"semantically identical. The type attribute specifies what type of glyph is being defined. The element value","type":"text"},{"text":" ","type":"text"},{"text":"specifies what SMuFL glyph to use, including recommended stylistic alternates. The SMuFL glyph name should","type":"text"},{"text":" ","type":"text"},{"text":"match the type. For instance, a type of quarter-rest would use values restQuarter, restQuarterOld, or","type":"text"},{"text":" ","type":"text"},{"text":"restQuarterZ. A type of g-clef-ottava-bassa would use values gClef8vb, gClef8vbOld, or gClef8vbCClef. A type","type":"text"},{"text":" ","type":"text"},{"text":"of octave-shift-up-8 would use values ottava, ottavaBassa, ottavaBassaBa, ottavaBassaVb, or octaveBassa.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLGlyph","url":"\/documentation\/ivormxl\/mxlglyph","role":"symbol","title":"MXLGlyph","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLGlyph","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLDistance":{"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLDistance"}],"type":"topic","title":"MXLDistance","navigatorTitle":[{"kind":"identifier","text":"MXLDistance"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDistance","url":"\/documentation\/ivormxl\/mxldistance","abstract":[{"type":"text","text":"The distance element represents standard distances between notation elements in tenths. The type attribute"},{"type":"text","text":" "},{"type":"text","text":"defines what type of distance is being defined. Valid values include hyphen (for hyphens in lyrics) and beam."}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNoteSize":{"title":"MXLNoteSize","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNoteSize"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlnotesize","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLNoteSize"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNoteSize","abstract":[{"text":"The note-size type indicates the percentage of the regular note size to use for notes with a cue and large","type":"text"},{"text":" ","type":"text"},{"text":"size as defined in the type element. The grace type is used for notes of cue size that that include a grace","type":"text"},{"text":" ","type":"text"},{"text":"element. The cue type is used for all other notes with cue size, whether defined explicitly or implicitly via","type":"text"},{"text":" ","type":"text"},{"text":"a cue element. The large type is used for notes of large size. The text content represent the numeric","type":"text"},{"text":" ","type":"text"},{"text":"percentage. A value of 100 would be identical to the size of a regular note as defined by the music font.","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLLineWidth":{"url":"\/documentation\/ivormxl\/mxllinewidth","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLineWidth","title":"MXLLineWidth","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLLineWidth","kind":"identifier"}],"abstract":[{"text":"The line-width type indicates the width of a line type in tenths. The type attribute defines what type of line","type":"text"},{"text":" ","type":"text"},{"text":"is being defined. Values include beam, bracket, dashes, enclosure, ending, extend, heavy barline, leger, light","type":"text"},{"text":" ","type":"text"},{"text":"barline, octave shift, pedal, slur middle, slur tip, staff, stem, tie middle, tie tip, tuplet bracket, and","type":"text"},{"text":" ","type":"text"},{"text":"wedge. The text content is expressed in tenths.","type":"text"}],"role":"symbol","navigatorTitle":[{"text":"MXLLineWidth","kind":"identifier"}],"type":"topic","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLAppearance":{"url":"\/documentation\/ivormxl\/mxlappearance","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAppearance","title":"MXLAppearance","abstract":[{"text":"The appearance type controls general graphical settings for the music’s final form appearance on a printed","type":"text"},{"text":" ","type":"text"},{"text":"page of display. This includes support for line widths, definitions for note sizes, and standard distances","type":"text"},{"text":" ","type":"text"},{"text":"between notation elements, plus an extension element for other aspects of appearance.","type":"text"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLAppearance"}],"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLAppearance"}]},"doc://IvorMXL/documentation/IvorMXL/MXLAppearance/init(lineWidth:noteSize:distance:glyph:otherAppearance:)":{"url":"\/documentation\/ivormxl\/mxlappearance\/init(linewidth:notesize:distance:glyph:otherappearance:)","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAppearance\/init(lineWidth:noteSize:distance:glyph:otherAppearance:)","title":"init(lineWidth:noteSize:distance:glyph:otherAppearance:)","abstract":[{"text":"Creates a new ","type":"text"},{"code":"MXLAppearance","type":"codeVoice"},{"text":".","type":"text"}],"role":"symbol","type":"topic","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"lineWidth"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:7IvorMXL12MXLLineWidthV","kind":"typeIdentifier","text":"MXLLineWidth"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"noteSize"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:7IvorMXL11MXLNoteSizeV","kind":"typeIdentifier","text":"MXLNoteSize"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"distance"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:7IvorMXL11MXLDistanceV","kind":"typeIdentifier","text":"MXLDistance"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"glyph"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:7IvorMXL8MXLGlyphV","kind":"typeIdentifier","text":"MXLGlyph"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"otherAppearance"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:7IvorMXL18MXLOtherAppearanceV","kind":"typeIdentifier","text":"MXLOtherAppearance"},{"kind":"text","text":"])"}]},"doc://IvorMXL/documentation/IvorMXL/MXLOtherAppearance":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLOtherAppearance","kind":"identifier"}],"navigatorTitle":[{"text":"MXLOtherAppearance","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOtherAppearance","abstract":[{"text":"The other-appearance type is used to define any graphical settings not yet in the current version of the","type":"text"},{"text":" ","type":"text"},{"text":"MusicXML format. This allows extended representation, though without application interoperability.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlotherappearance","type":"topic","title":"MXLOtherAppearance","role":"symbol"}}}