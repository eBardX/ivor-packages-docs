LLink","preciseIdentifier":"s:7IvorMXL7MXLLinkV","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"abstract":[{"type":"text","text":"The link elements interspersed with this credit’s content."}],"kind":"symbol","type":"topic","title":"link"},"doc://IvorMXL/documentation/IvorMXL/MXLCredit":{"title":"MXLCredit","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLCredit"}],"abstract":[{"text":"The credit type represents the appearance of the title, composer, arranger, lyricist, copyright, dedication,","type":"text"},{"text":" ","type":"text"},{"text":"and other text, symbols, and graphics that commonly appear on the first page of a score. The credit-words,","type":"text"},{"text":" ","type":"text"},{"text":"credit-symbol, and credit-image elements are similar to the words, symbol, and image elements for directions.","type":"text"},{"text":" ","type":"text"},{"text":"However, since the credit is not part of a measure, the default-x and default-y attributes adjust the origin","type":"text"},{"text":" ","type":"text"},{"text":"relative to the bottom left-hand corner of the page. The enclosure for credit-words and credit-symbol is none","type":"text"},{"text":" ","type":"text"},{"text":"by default.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCredit","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLCredit"}],"url":"\/documentation\/ivormxl\/mxlcredit"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLLink":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLLink","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"MXLLink","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxllink","abstract":[{"type":"text","text":"The link type serves as an outgoing simple XLink. If a relative link is used within a document that is part of"},{"type":"text","text":" "},{"type":"text","text":"a compressed MusicXML file, the link is relative to the root folder of the zip file."}],"title":"MXLLink","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLink","kind":"symbol"}}}