r, lyricist, copyright, dedication,","type":"text"},{"text":" ","type":"text"},{"text":"and other text, symbols, and graphics that commonly appear on the first page of a score. The credit-words,","type":"text"},{"text":" ","type":"text"},{"text":"credit-symbol, and credit-image elements are similar to the words, symbol, and image elements for directions.","type":"text"},{"text":" ","type":"text"},{"text":"However, since the credit is not part of a measure, the default-x and default-y attributes adjust the origin","type":"text"},{"text":" ","type":"text"},{"text":"relative to the bottom left-hand corner of the page. The enclosure for credit-words and credit-symbol is none","type":"text"},{"text":" ","type":"text"},{"text":"by default.","type":"text"}],"title":"MXLCredit","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCredit","kind":"symbol","url":"\/documentation\/ivormxl\/mxlcredit","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLCredit"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLCredit/Content-swift.enum/AlternativeContent":{"abstract":[{"text":"One of the alternatives for Content.","type":"text"}],"title":"MXLCredit.Content.AlternativeContent","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"text":"AlternativeContent","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"AlternativeContent"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlcredit\/content-swift.enum\/alternativecontent","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCredit\/Content-swift.enum\/AlternativeContent"},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"}}}