keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLCredit"}],"abstract":[{"text":"The credit type represents the appearance of the title, composer, arranger, lyricist, copyright, dedication,","type":"text"},{"text":" ","type":"text"},{"text":"and other text, symbols, and graphics that commonly appear on the first page of a score. The credit-words,","type":"text"},{"text":" ","type":"text"},{"text":"credit-symbol, and credit-image elements are similar to the words, symbol, and image elements for directions.","type":"text"},{"text":" ","type":"text"},{"text":"However, since the credit is not part of a measure, the default-x and default-y attributes adjust the origin","type":"text"},{"text":" ","type":"text"},{"text":"relative to the bottom left-hand corner of the page. The enclosure for credit-words and credit-symbol is none","type":"text"},{"text":" ","type":"text"},{"text":"by default.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCredit","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLCredit"}],"url":"\/documentation\/ivormxl\/mxlcredit"},"doc://IvorMXL/documentation/IvorMXL/MXLCredit/Content-swift.enum/AlternativeContent/creditWords(_:)":{"url":"\/documentation\/ivormxl\/mxlcredit\/content-swift.enum\/alternativecontent\/creditwords(_:)","type":"topic","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCredit\/Content-swift.enum\/AlternativeContent\/creditWords(_:)","title":"MXLCredit.Content.AlternativeContent.creditWords(_:)","role":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"creditWords"},{"kind":"text","text":"("},{"preciseIdentifier":"s:7IvorMXL18MXLFormattedTextIDV","kind":"typeIdentifier","text":"MXLFormattedTextID"},{"kind":"text","text":")"}],"abstract":[{"text":"The credit-words element, a text element with text-formatting and id attributes.","type":"text"}]}}}