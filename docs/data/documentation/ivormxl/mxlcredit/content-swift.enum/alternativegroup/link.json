text":" "},{"type":"text","text":"by default."}],"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLCredit"}]},"doc://IvorMXL/documentation/IvorMXL/MXLCredit/Content-swift.enum/AlternativeGroup":{"title":"MXLCredit.Content.AlternativeGroup","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"text":"AlternativeGroup","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlcredit\/content-swift.enum\/alternativegroup","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCredit\/Content-swift.enum\/AlternativeGroup","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"AlternativeGroup","kind":"identifier"}],"abstract":[{"type":"text","text":"A group of credit-symbol and credit-words elements interspersed with link and bookmark elements, used to"},{"type":"text","text":" "},{"type":"text","text":"represent an alternating sequence of credit content within a single credit element."}]},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLLink":{"url":"\/documentation\/ivormxl\/mxllink","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLink","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLLink"}],"title":"MXLLink","abstract":[{"type":"text","text":"The link type serves as an outgoing simple XLink. If a relative link is used within a document that is part of"},{"type":"text","text":" "},{"type":"text","text":"a compressed MusicXML file, the link is relative to the root folder of the zip file."}],"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLLink"}]}}}