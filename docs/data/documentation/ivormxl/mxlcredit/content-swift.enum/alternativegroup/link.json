"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"link","kind":"identifier"},{"text":": [","kind":"text"},{"text":"MXLLink","preciseIdentifier":"s:7IvorMXL7MXLLinkV","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"title":"link","abstract":[{"type":"text","text":"The link elements interspersed within the alternating credit content."}],"type":"topic","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLCredit":{"navigatorTitle":[{"kind":"identifier","text":"MXLCredit"}],"abstract":[{"text":"The credit type represents the appearance of the title, composer, arranger, lyricist, copyright, dedication,","type":"text"},{"text":" ","type":"text"},{"text":"and other text, symbols, and graphics that commonly appear on the first page of a score. The credit-words,","type":"text"},{"text":" ","type":"text"},{"text":"credit-symbol, and credit-image elements are similar to the words, symbol, and image elements for directions.","type":"text"},{"text":" ","type":"text"},{"text":"However, since the credit is not part of a measure, the default-x and default-y attributes adjust the origin","type":"text"},{"text":" ","type":"text"},{"text":"relative to the bottom left-hand corner of the page. The enclosure for credit-words and credit-symbol is none","type":"text"},{"text":" ","type":"text"},{"text":"by default.","type":"text"}],"title":"MXLCredit","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCredit","kind":"symbol","url":"\/documentation\/ivormxl\/mxlcredit","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLCredit"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLLink":{"abstract":[{"type":"text","text":"The link type serves as an outgoing simple XLink. If a relative link is used within a document that is part of"},{"type":"text","text":" "},{"type":"text","text":"a compressed MusicXML file, the link is relative to the root folder of the zip file."}],"title":"MXLLink","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLLink"}],"navigatorTitle":[{"kind":"identifier","text":"MXLLink"}],"type":"topic","url":"\/documentation\/ivormxl\/mxllink","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLink"},"doc://IvorMXL/documentation/IvorMXL/MXLCredit/Content-swift.enum/AlternativeGroup":{"title":"MXLCredit.Content.AlternativeGroup","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AlternativeGroup"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlcredit\/content-swift.enum\/alternativegroup","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCredit\/Content-swift.enum\/AlternativeGroup","abstract":[{"text":"A group of credit-symbol and credit-words elements interspersed with link and bookmark elements, used to","type":"text"},{"text":" ","type":"text"},{"text":"represent an alternating sequence of credit content within a single credit element.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"AlternativeGroup"}]},"doc://IvorMXL/documentation/IvorMXL/MXLCredit/Content-swift.enum":{"abstract":[{"type":"text","text":"One of the alternatives for Credit."}],"title":"MXLCredit.Content","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Content"}],"navigatorTitle":[{"text":"Content","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlcredit\/content-swift.enum","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCredit\/Content-swift.enum"}}}