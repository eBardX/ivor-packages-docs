,"abstract":[{"type":"text","text":"The credit type represents the appearance of the title, composer, arranger, lyricist, copyright, dedication,"},{"type":"text","text":" "},{"type":"text","text":"and other text, symbols, and graphics that commonly appear on the first page of a score. The credit-words,"},{"type":"text","text":" "},{"type":"text","text":"credit-symbol, and credit-image elements are similar to the words, symbol, and image elements for directions."},{"type":"text","text":" "},{"type":"text","text":"However, since the credit is not part of a measure, the default-x and default-y attributes adjust the origin"},{"type":"text","text":" "},{"type":"text","text":"relative to the bottom left-hand corner of the page. The enclosure for credit-words and credit-symbol is none"},{"type":"text","text":" "},{"type":"text","text":"by default."}],"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLCredit"}]},"doc://IvorMXL/documentation/IvorMXL/MXLBookmark":{"type":"topic","title":"MXLBookmark","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"kind":"identifier","text":"MXLBookmark"}],"url":"\/documentation\/ivormxl\/mxlbookmark","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBookmark","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"MXLBookmark","kind":"identifier"}],"abstract":[{"text":"The bookmark type serves as a well-defined target for an incoming simple XLink.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLCredit/Content-swift.enum":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlcredit\/content-swift.enum","title":"MXLCredit.Co