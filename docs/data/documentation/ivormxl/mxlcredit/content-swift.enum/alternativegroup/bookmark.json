,{"text":" ","kind":"text"},{"text":"AlternativeGroup","kind":"identifier"}],"navigatorTitle":[{"text":"AlternativeGroup","kind":"identifier"}],"abstract":[{"text":"A group of credit-symbol and credit-words elements interspersed with link and bookmark elements, used to","type":"text"},{"text":" ","type":"text"},{"text":"represent an alternating sequence of credit content within a single credit element.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCredit\/Content-swift.enum\/AlternativeGroup","title":"MXLCredit.Content.AlternativeGroup","role":"symbol","url":"\/documentation\/ivormxl\/mxlcredit\/content-swift.enum\/alternativegroup"},"doc://IvorMXL/documentation/IvorMXL/MXLCredit":{"type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLCredit","kind":"identifier"}],"navigatorTitle":[{"text":"MXLCredit","kind":"identifier"}],"abstract":[{"text":"The credit type represents the appearance of the title, composer, arranger, lyricist, copyright, dedication,","type":"text"},{"text":" ","type":"text"},{"text":"and other text, symbols, and graphics that commonly appear on the first page of a score. The credit-words,","type":"text"},{"text":" ","type":"text"},{"text":"credit-symbol, and credit-image elements are similar to the words, symbol, and image elements for directions.","type":"text"},{"text":" ","type":"text"},{"text":"However, since the credit is not part of a measure, the default-x and default-y attributes adjust the origin","type":"text"},{"text":" ","type":"text"},{"text":"relative to the bottom left-hand corner of the page. The enclosure for credit-words and credit-symbol is none","type":"text"},{"text":" ","type":"text"},{"text":"by default.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCredit","title":"MXLCredit","role":"symbol","url":"\/documentation\/ivormxl\/mxlcredit"}}}