ymbol, and image elements for directions."},{"type":"text","text":" "},{"type":"text","text":"However, since the credit is not part of a measure, the default-x and default-y attributes adjust the origin"},{"type":"text","text":" "},{"type":"text","text":"relative to the bottom left-hand corner of the page. The enclosure for credit-words and credit-symbol is none"},{"type":"text","text":" "},{"type":"text","text":"by default."}],"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLCredit"}]},"doc://IvorMXL/documentation/IvorMXL/MXLCredit/Content-swift.enum/AlternativeGroup/Content-swift.enum":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCredit\/Content-swift.enum\/AlternativeGroup\/Content-swift.enum","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Content","kind":"identifier"}],"title":"MXLCredit.Content.AlternativeGroup.Content","abstract":[{"type":"text","text":"One of the alternatives for AlternativeGroup."}],"navigatorTitle":[{"text":"Content","kind":"identifier"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlcredit\/content-swift.enum\/alternativegroup\/content-swift.enum"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLCredit/Content-swift.enum":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlcredit\/content-swift.enum","title":"MXLCredit.Content","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Content"}],"navigatorTitle":[{"kind":"identifier","text":"Content"}],"abstract":[{"type":"text","text":"One of the alternatives for Credit."}],"type":"topic","iden