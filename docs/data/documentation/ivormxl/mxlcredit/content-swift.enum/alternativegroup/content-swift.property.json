":"text"}],"title":"MXLCredit","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCredit","kind":"symbol","url":"\/documentation\/ivormxl\/mxlcredit","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLCredit"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLCredit/Content-swift.enum/AlternativeGroup":{"title":"MXLCredit.Content.AlternativeGroup","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AlternativeGroup"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlcredit\/content-swift.enum\/alternativegroup","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCredit\/Content-swift.enum\/AlternativeGroup","abstract":[{"text":"A group of credit-symbol and credit-words elements interspersed with link and bookmark elements, used to","type":"text"},{"text":" ","type":"text"},{"text":"represent an alternating sequence of credit content within a single credit element.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"AlternativeGroup"}]},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLCredit/Content-swift.enum/AlternativeGroup/Content-swift.enum":{"abstract":[{"text":"One of the alternatives for AlternativeGroup.","type":"text"}],"title":"MXLCredit.Content.AlternativeGroup.Content","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Content"}],"navigatorTitle":[{"kind":"identifier","text":"Content"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlcredit\/content-swift.enum\/alternativegroup\/content-swift.enum","identi