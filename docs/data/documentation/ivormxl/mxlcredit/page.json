ct":[{"text":"The credit type represents the appearance of the title, composer, arranger, lyricist, copyright, dedication,","type":"text"},{"text":" ","type":"text"},{"text":"and other text, symbols, and graphics that commonly appear on the first page of a score. The credit-words,","type":"text"},{"text":" ","type":"text"},{"text":"credit-symbol, and credit-image elements are similar to the words, symbol, and image elements for directions.","type":"text"},{"text":" ","type":"text"},{"text":"However, since the credit is not part of a measure, the default-x and default-y attributes adjust the origin","type":"text"},{"text":" ","type":"text"},{"text":"relative to the bottom left-hand corner of the page. The enclosure for credit-words and credit-symbol is none","type":"text"},{"text":" ","type":"text"},{"text":"by default.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlcredit","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLCredit"}],"kind":"symbol","title":"MXLCredit","navigatorTitle":[{"kind":"identifier","text":"MXLCredit"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCredit","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLCredit/page":{"kind":"symbol","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"page","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":"?","kind":"text"}],"url":"\/documentation\/ivormxl\/mxlcredit\/page","title":"page","abstract":[{"text":"The page number where the credit should appear, starting with 1 for the first page. ","type":"text"},{"code":"1","type":"codeVoice"},{"text":" by default.","type":"text"}],"role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCredit\/page"}}}