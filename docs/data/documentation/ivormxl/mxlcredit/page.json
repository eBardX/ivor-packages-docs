abstract":[{"text":"The page number where the credit should appear, starting with 1 for the first page. ","type":"text"},{"code":"1","type":"codeVoice"},{"text":" by default.","type":"text"}],"type":"topic","role":"symbol","title":"page","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCredit\/page","url":"\/documentation\/ivormxl\/mxlcredit\/page","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"page","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":"?","kind":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLCredit":{"url":"\/documentation\/ivormxl\/mxlcredit","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCredit","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLCredit"}],"title":"MXLCredit","abstract":[{"type":"text","text":"The credit type represents the appearance of the title, composer, arranger, lyricist, copyright, dedication,"},{"type":"text","text":" "},{"type":"text","text":"and other text, symbols, and graphics that commonly appear on the first page of a score. The credit-words,"},{"type":"text","text":" "},{"type":"text","text":"credit-symbol, and credit-image elements are similar to the words, symbol, and image elements for directions."},{"type":"text","text":" "},{"type":"text","text":"However, since the credit is not part of a measure, the default-x and default-y attributes adjust the origin"},{"type":"text","text":" "},{"type":"text","text":"relative to the bottom left-hand corner of the page. The enclosure for credit-words and credit-symbol is none"},{"type":"text","text":" "},{"type":"text","text":"by default."}],"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLCredit"}]}}}