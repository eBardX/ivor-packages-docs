e":"text","text":"credit-symbol, and credit-image elements are similar to the words, symbol, and image elements for directions."},{"type":"text","text":" "},{"type":"text","text":"However, since the credit is not part of a measure, the default-x and default-y attributes adjust the origin"},{"type":"text","text":" "},{"type":"text","text":"relative to the bottom left-hand corner of the page. The enclosure for credit-words and credit-symbol is none"},{"type":"text","text":" "},{"type":"text","text":"by default."}],"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLCredit"}]},"doc://IvorMXL/documentation/IvorMXL/MXLLink":{"url":"\/documentation\/ivormxl\/mxllink","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLink","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLLink"}],"title":"MXLLink","abstract":[{"type":"text","text":"The link type serves as an outgoing simple XLink. If a relative link is used within a document that is part of"},{"type":"text","text":" "},{"type":"text","text":"a compressed MusicXML file, the link is relative to the root folder of the zip file."}],"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLLink"}]},"doc://IvorMXL/documentation/IvorMXL/MXLBookmark":{"type":"topic","title":"MXLBookmark","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"kind":"identifier","text":"MXLBookmark"}],"url":"\/documentation\/ivormxl\/mxlbookmark","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBookmark","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"MXLBookmark","kind":"identifier"}],"abstract":[{"text":"The bookmark type serves as a well-defined target for an incoming simple XLink.","type":"text"}]}}}