usicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLCredit":{"type":"topic","abstract":[{"text":"The credit type represents the appearance of the title, composer, arranger, lyricist, copyright, dedication,","type":"text"},{"text":" ","type":"text"},{"text":"and other text, symbols, and graphics that commonly appear on the first page of a score. The credit-words,","type":"text"},{"text":" ","type":"text"},{"text":"credit-symbol, and credit-image elements are similar to the words, symbol, and image elements for directions.","type":"text"},{"text":" ","type":"text"},{"text":"However, since the credit is not part of a measure, the default-x and default-y attributes adjust the origin","type":"text"},{"text":" ","type":"text"},{"text":"relative to the bottom left-hand corner of the page. The enclosure for credit-words and credit-symbol is none","type":"text"},{"text":" ","type":"text"},{"text":"by default.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlcredit","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLCredit"}],"kind":"symbol","title":"MXLCredit","navigatorTitle":[{"kind":"identifier","text":"MXLCredit"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCredit","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLCredit/id":{"abstract":[{"text":"The optional-unique-id attribute group allows an element to optionally specify an ID that is unique to the","type":"text"},{"text":" ","type":"text"},{"text":"entire document. This attribute group is not used for a required id attribute, or for an id attribute that","type":"text"},{"text":" ","type":"text"},{"text":"specifies an id reference.","type":"text"}],"role":"symbol","title":"id","kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxlcredit\/id","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCredit\/id","fragments":[{"te