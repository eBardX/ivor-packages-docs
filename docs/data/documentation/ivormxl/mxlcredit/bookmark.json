:"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLCredit":{"title":"MXLCredit","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLCredit"}],"abstract":[{"text":"The credit type represents the appearance of the title, composer, arranger, lyricist, copyright, dedication,","type":"text"},{"text":" ","type":"text"},{"text":"and other text, symbols, and graphics that commonly appear on the first page of a score. The credit-words,","type":"text"},{"text":" ","type":"text"},{"text":"credit-symbol, and credit-image elements are similar to the words, symbol, and image elements for directions.","type":"text"},{"text":" ","type":"text"},{"text":"However, since the credit is not part of a measure, the default-x and default-y attributes adjust the origin","type":"text"},{"text":" ","type":"text"},{"text":"relative to the bottom left-hand corner of the page. The enclosure for credit-words and credit-symbol is none","type":"text"},{"text":" ","type":"text"},{"text":"by default.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCredit","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLCredit"}],"url":"\/documentation\/ivormxl\/mxlcredit"},"doc://IvorMXL/documentation/IvorMXL/MXLBookmark":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBookmark","type":"topic","title":"MXLBookmark","kind":"symbol","url":"\/documentation\/ivormxl\/mxlbookmark","abstract":[{"text":"The bookmark type serves as a well-defined target for an incoming simple XLink.","type":"text"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLBookmark","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"MXLBookmark"}]},"doc://IvorMXL/documentation/IvorMXL/MXLCredit/bookmark":{"title":"bookmark","kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"bookmark","kind":"iden