{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Note","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlmetronome\/note"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNoteKindValue":{"url":"\/documentation\/ivormxl\/mxlnotekindvalue","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNoteKindValue","abstract":[{"type":"text","text":"The note-type-value type is used for the MusicXML type element and represents the graphic note type, from"},{"type":"text","text":" "},{"type":"text","text":"1024th (shortest) to maxima (longest)."}],"title":"MXLNoteKindValue","kind":"symbol","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNoteKindValue"}],"navigatorTitle":[{"kind":"identifier","text":"MXLNoteKindValue"}]},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLMetronome"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLMetronome"}],"url":"\/documentation\/ivormxl\/mxlmetronome","abstract":[{"text":"The metronome type represents metronome marks and other metric relationships. The beat-unit group and per-","type":"text"},{"text":" ","type":"text"},{"text":"minute element specify regular metronome marks. The metronome-note and metronome-relation elements allow for","type":"text"},{"text":" ","type":"text"},{"text":"the specification of metric modulations and other metric relationships, such as swing tempo marks where two","type":"text"},{"text":" ","type":"text"},{"text":"eighths are equated to a quarter note \/ eighth note triplet. Tied notes can be represented in both types of","type":"text"},{"text":" ","type":"text"},{"text":"metronome marks by using the beat-unit-tied and metronome-tied elements. The parentheses attribute indicates","type":"text"},{"text":" ","type":"text"},{"text":"whether or not to put the metronome mark in parentheses; its value is no if not specified. The print-object","type":"text"},{"text":" ","type":"text"},{"text":"attribute is set to no in cases where the metronome element represents a relationship or range that is not","type":"text"},{"text":" ","type":"text"},{"text":"displayed in the music notation.","type":"text"}],"title":"MXLMetronome","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome/Note/Tied-swift.struct":{"abstract":[{"type":"text","text":"The metronome-tied indicates the presence of a tie within a metric relationship mark. As with the tied"},{"type":"text","text":" "},{"type":"text","text":"element, both the start and stop of the tie should be specified, in this case within separate metronome-note"},{"type":"text","text":" "},{"type":"text","text":"elements."}],"title":"MXLMetronome.Note.Tied","url":"\/documentation\/ivormxl\/mxlmetronome\/note\/tied-swift.struct","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Tied","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/Note\/Tied-swift.struct","navigatorTitle":[{"text":"Tied","kind":"identifier"}]}}}