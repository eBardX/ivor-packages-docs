olKind":"init","externalID":"s:7IvorMXL12MXLMetronomeV4NoteV4BeamV5value6numberAgA12MXLBeamValueO_AA0H5LevelVSgtcfc","roleHeading":"Initializer","modules":[{"name":"IvorMXL"}],"title":"init(value:number:)"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/Note","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/Note\/Beam-swift.struct"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLBeamLevel":{"navigatorTitle":[{"text":"MXLBeamLevel","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLBeamLevel","kind":"identifier"}],"abstract":[{"type":"text","text":"The MusicXML format supports six levels of beaming, up to 1024th notes. Unlike the number-level type, the"},{"type":"text","text":" "},{"type":"text","text":"beam-level type identifies concurrent beams in a beam group. It does not distinguish overlapping beams such as"},{"type":"text","text":" "},{"type":"text","text":"grace notes within regular notes, or beams used in different voices."}],"role":"symbol","url":"\/documentation\/ivormxl\/mxlbeamlevel","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBeamLevel","title":"MXLBeamLevel","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome":{"type":"topic","title":"MXLMetronome","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLMetronome"}],"url":"\/documentation\/ivormxl\/mxlmetronome","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"MXLMetronome","kind":"identifier"}],"abstract":[{"text":"The metronome type represents metronome marks and other metric relationships. The beat-unit group and per-","type":"text"},{"text":" ","type":"text"},{"text":"minute element specify regular metronome marks. The metronome-note and metronome-relation elements allow for","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"the specification of metric modulations and other metric relationships, such as swing tempo marks where two"},{"type":"text","text":" "},{"text":"eighths are equated to a quarter note \/ eighth note triplet. Tied notes can be represented in both types of","type":"text"},{"type":"text","text":" "},{"type":"text","text":"metronome marks by using the beat-unit-tied and metronome-tied elements. The parentheses attribute indicates"},{"type":"text","text":" "},{"type":"text","text":"whether or not to put the metronome mark in parentheses; its value is no if not specified. The print-object"},{"type":"text","text":" "},{"type":"text","text":"attribute is set to no in cases where the metronome element represents a relationship or range that is not"},{"type":"text","text":" "},{"type":"text","text":"displayed in the music notation."}]},"doc://IvorMXL/documentation/IvorMXL/MXLBeamValue":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLBeamValue","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBeamValue","role":"symbol","navigatorTitle":[{"text":"MXLBeamValue","kind":"identifier"}],"title":"MXLBeamValue","abstract":[{"text":"The beam-value type represents the type of beam associated with each of 8 beam levels (up to 1024th notes)","type":"text"},{"text":" ","type":"text"},{"text":"available for each note.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlbeamvalue","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome/Note/Beam-swift.struct":{"abstract":[{"type":"text","text":"The metronome-beam type works like the beam type in defining metric relationships, but does not include all"},{"type":"text","text":" "},{"type":"text","text":"the attributes available in the beam type."}],"url":"\/documentation\/ivormxl\/mxlmetronome\/note\/beam-swift.struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Beam","kind":"identifier"}],"type":"topic","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"Beam","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/Note\/Beam-swift.struct","title":"MXLMetronome.Note.Beam"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome/Note/Beam-swift.struct/init(value:number:)":{"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"value"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL12MXLBeamValueO","text":"MXLBeamValue"},{"kind":"text","text":", "},{"kind":"externalParam","text":"number"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL12MXLBeamLevelV","text":"MXLBeamLevel"},{"kind":"text","text":"?)"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/Note\/Beam-swift.struct\/init(value:number:)","role":"symbol","url":"\/documentation\/ivormxl\/mxlmetronome\/note\/beam-swift.struct\/init(value:number:)","abstract":[{"type":"text","text":"Creates a new "},{"code":"MXLMetronome.Note.Beam","type":"codeVoice"},{"type":"text","text":"."}],"kind":"symbol","title":"init(value:number:)","type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome/Note":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/Note","role":"symbol","navigatorTitle":[{"text":"Note","kind":"identifier"}],"type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Note","kind":"identifier"}],"abstract":[{"