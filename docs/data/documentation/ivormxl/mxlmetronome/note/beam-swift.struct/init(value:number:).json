nd":"keyword"},{"text":" ","kind":"text"},{"text":"MXLBeamValue","kind":"identifier"}],"navigatorTitle":[{"text":"MXLBeamValue","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlbeamvalue"}}}