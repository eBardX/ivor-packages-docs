","type":"text"},{"text":" ","type":"text"},{"text":"whether or not to put the metronome mark in parentheses; its value is no if not specified. The print-object","type":"text"},{"text":" ","type":"text"},{"text":"attribute is set to no in cases where the metronome element represents a relationship or range that is not","type":"text"},{"text":" ","type":"text"},{"text":"displayed in the music notation.","type":"text"}],"title":"MXLMetronome","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLMetronome"}],"navigatorTitle":[{"kind":"identifier","text":"MXLMetronome"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlmetronome","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome"},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome/Note":{"abstract":[{"type":"text","text":"The metronome-note type defines the appearance of a note within a metric relationship mark."}],"title":"MXLMetronome.Note","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Note"}],"navigatorTitle":[{"kind":"identifier","text":"Note"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlmetronome\/note","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/Note"},"doc://IvorMXL/documentation/IvorMXL/MXLBeamLevel":{"title":"MXLBeamLevel","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"text":"MXLBeamLevel","kind":"identifier"}],"kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxlbeamlevel","abstract":[{"text":"The MusicXML format supports six levels of beaming, up to 1024th notes. Unlike the number-level type, the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"beam-level type identifies concurrent beams in a beam group. It does not distinguish overlapping beams such as"},{"type":"text","text":" "},{"type":"text","text":"grace notes within regular notes, or beams used in different voices."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBeamLevel","navigatorTitle":[{"text":"MXLBeamLevel","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome/Note/Beam-swift.struct":{"title":"MXLMetronome.Note.Beam","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"Beam"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlmetronome\/note\/beam-swift.struct","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/Note\/Beam-swift.struct","abstract":[{"text":"The metronome-beam type works like the beam type in defining metric relationships, but does not include all","type":"text"},{"text":" ","type":"text"},{"text":"the attributes available in the beam type.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"Beam"}]},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome/Note/Beam-swift.struct/init(value:number:)":{"abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLMetronome.Note.Beam"},{"type":"text","text":"."}],"title":"init(value:number:)","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/Note\/Beam-swift.struct\/init(value:number:)","kind":"symbol","url":"\/documentation\/ivormxl\/mxlmetronome\/note\/beam-swift.struct\/init(value:number:)","type":"topic","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"value"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLBeamValue","preciseIdentifier":"s:7IvorMXL12MXLBeamValueO"},{"kind":"text","text":", "},{"kind":"exte