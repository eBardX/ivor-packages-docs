text":"The MusicXML format supports six levels of beaming, up to 1024th notes. Unlike the number-level type, the","type":"text"},{"text":" ","type":"text"},{"text":"beam-level type identifies concurrent beams in a beam group. It does not distinguish overlapping beams such as","type":"text"},{"text":" ","type":"text"},{"text":"grace notes within regular notes, or beams used in different voices.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlbeamlevel","title":"MXLBeamLevel","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBeamLevel","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome/Note/Beam-swift.struct":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlmetronome\/note\/beam-swift.struct","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/Note\/Beam-swift.struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Beam"}],"abstract":[{"type":"text","text":"The metronome-beam type works like the beam type in defining metric relationships, but does not include all"},{"type":"text","text":" "},{"type":"text","text":"the attributes available in the beam type."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Beam"}],"title":"MXLMetronome.Note.Beam"},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLMetronome"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLMetronome"}],"url":"\/documentation\/ivormxl\/mxlmetronome","abstract":[{"text":"The metronome type represents metronome marks and other metric relationshi