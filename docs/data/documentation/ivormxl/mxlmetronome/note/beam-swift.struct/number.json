tter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome/Note":{"role":"symbol","navigatorTitle":[{"text":"Note","kind":"identifier"}],"abstract":[{"text":"The metronome-note type defines the appearance of a note within a metric relationship mark.","type":"text"}],"title":"MXLMetronome.Note","type":"topic","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/Note","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Note","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlmetronome\/note"},"doc://IvorMXL/documentation/IvorMXL/MXLBeamLevel":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLBeamLevel","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"MXLBeamLevel","kind":"identifier"}],"abstract":[{"text":"The MusicXML format supports six levels of beaming, up to 1024th notes. Unlike the number-level type, the","type":"text"},{"text":" ","type":"text"},{"text":"beam-level type identifies concurrent beams in a beam group. It does not distinguish overlapping beams such as","type":"text"},{"text":" ","type":"text"},{"text":"grace notes within regular notes, or beams used in different voices.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlbeamlevel","title":"MXLBeamLevel","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBeamLevel","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLMetronome"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLMetronome"}],"url":"\/documentation\/ivormxl\/mxlmetronome","abstract":[{"text":"The metronome type represents metronome marks and other metric relationships. The beat-unit group and per-","type":"text"},{"text":" ","type":"text"},{"text":"minute element specify regular metronome marks. The metronome-note and metronome-relation elements allow for","type":"text"},{"text":" ","type":"text"},{"text":"the specification of metric modulations and other metric relationships, such as swing tempo marks where two","type":"text"},{"text":" ","type":"text"},{"text":"eighths are equated to a quarter note \/ eighth note triplet. Tied notes can be represented in both types of","type":"text"},{"text":" ","type":"text"},{"text":"metronome marks by using the beat-unit-tied and metronome-tied elements. The parentheses attribute indicates","type":"text"},{"text":" ","type":"text"},{"text":"whether or not to put the metronome mark in parentheses; its value is no if not specified. The print-object","type":"text"},{"text":" ","type":"text"},{"text":"attribute is set to no in cases where the metronome element represents a relationship or range that is not","type":"text"},{"text":" ","type":"text"},{"text":"displayed in the music notation.","type":"text"}],"title":"MXLMetronome","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome/Note/Beam-swift.struct":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlmetronome\/note\/beam-swift.struct","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/Note\/Beam-swift.struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Beam"}],"abstract":[{"type":"text","text":"The metronome-beam type works like the beam type in defining metric relationships, but does not include all"},{"type":"text","text":" "},{"type":"text","text":"the attributes available in the beam type."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Beam"}],"title":"MXLMetronome.Note.Beam"},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome/Note/Beam-swift.struct/number":{