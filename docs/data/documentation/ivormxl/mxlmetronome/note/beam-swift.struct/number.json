t","abstract":[{"text":"The metronome-beam type works like the beam type in defining metric relationships, but does not include all","type":"text"},{"text":" ","type":"text"},{"text":"the attributes available in the beam type.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"Beam"}]},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"}}}