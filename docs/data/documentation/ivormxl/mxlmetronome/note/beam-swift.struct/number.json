tor, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome/Note/Beam-swift.struct":{"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/Note\/Beam-swift.struct","url":"\/documentation\/ivormxl\/mxlmetronome\/note\/beam-swift.struct","navigatorTitle":[{"text":"Beam","kind":"identifier"}],"title":"MXLMetronome.Note.Beam","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Beam","kind":"identifier"}],"type":"topic","abstract":[{"text":"The metronome-beam type works like the beam type in defining metric relationships, but does not include all","type":"text"},{"text":" ","type":"text"},{"text":"the attributes available in the beam type.","type":"text"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome/Note":{"type":"topic","abstract":[{"text":"The metronome-note type defines the appearance of a note within a metric relationship mark.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Note"}],"navigatorTitle":[{"kind":"identifier","text":"Note"}],"title":"MXLMetronome.Note","kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlmetronome\/note","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/Note"},"doc://IvorMXL/documentation/IvorMXL/MXLBeamLevel":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLBeamLevel"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBeamLevel","title":"MXLBeamLevel","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLBeamLevel"}],"abstract":[{"type":"text","text":"The MusicXML format supports six levels of beaming, up to 1024th notes. Unlike the number-level type, the"},{"type":"text","text":" "},{"type":"text","text":"beam-level type identifies concurrent beams in a beam group. It does not distinguish overlapping beams such as"},{"type":"text","text":" "},{"type":"text","text":"grace notes within regular notes, or beams used in different voices."}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlbeamlevel"},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLMetronome","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome","title":"MXLMetronome","kind":"symbol","navigatorTitle":[{"text":"MXLMetronome","kind":"identifier"}],"abstract":[{"type":"text","text":"The metronome type represents metronome marks and other metric relationships. The beat-unit group and per-"},{"text":" ","type":"text"},{"text":"minute element specify regular metronome marks. The metronome-note and metronome-relation elements allow for","type":"text"},{"text":" ","type":"text"},{"text":"the specification of metric modulations and other metric relationships, such as swing tempo marks where two","type":"text"},{"type":"text","text":" "},{"type":"text","text":"eighths are equated to a quarter note \/ eighth note triplet. Tied notes can be represented in both types of"},{"text":" ","type":"text"},{"text":"metronome marks by using the beat-unit-tied and metronome-tied elements. The parentheses attribute indicates","type":"text"},{"text":" ","type":"text"},{"text":"whether or not to put the metronome mark in parentheses; its value is no if not specified. The print-object","type":"text"},{"text":" ","type":"text"},{"text":"attribute is set to no in cases where the metronome element represents a relationship or range that is not","type":"text"},{"text":" ","type":"text"},{"text":"displayed in the music notation.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlmetronome"},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome/Note/Beam-swift.struct/number":{"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/Note\/Beam-swift.struct\/number","url":"\/documentation\/ivormxl\/mxlmetronome\/note\/beam-swift.struct\/number","title":"number","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"number","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLBeamLevel","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL12MXLBeamLevelV"}],"type":"topic","abstract":[{"text":"Defaults to ","type":"text"},{"type":"codeVoice","code":"1"},{"text":".","type":"text"}],"role":"symbol"}}}