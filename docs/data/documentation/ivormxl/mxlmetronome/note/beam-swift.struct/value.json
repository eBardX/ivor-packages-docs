,{"text":" ","kind":"text"},{"text":"Note","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlmetronome\/note"},"doc://IvorMXL/documentation/IvorMXL/MXLBeamValue":{"url":"\/documentation\/ivormxl\/mxlbeamvalue","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLBeamValue"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBeamValue","title":"MXLBeamValue","abstract":[{"type":"text","text":"The beam-value type represents the type of beam associated with each of 8 beam levels (up to 1024th notes)"},{"text":" ","type":"text"},{"type":"text","text":"available for each note."}],"navigatorTitle":[{"kind":"identifier","text":"MXLBeamValue"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome/Note/Beam-swift.struct/value":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlmetronome\/note\/beam-swift.struct\/value","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/Note\/Beam-swift.struct\/value","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"value"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL12MXLBeamValueO","text":"MXLBeamValue"}],"abstract":[{"type":"text","text":"The value of this element."}],"kind":"symbol","type":"topic","title":"value"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome/Note/Beam-swift.struct":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlmetronome\/note\/beam-swift.struct","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/Note\/Beam-swift.struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Beam"}],"abstract":[{"type":"text","text":"The metronome-beam type works like the beam type in defining metric relationships, but does not include all"},{"type":"text","text":" "},{"type":"text","text":"the attributes available in the beam type."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Beam"}],"title":"MXLMetronome.Note.Beam"},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLMetronome"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLMetronome"}],"url":"\/documentation\/ivormxl\/mxlmetronome","abstract":[{"text":"The metronome type represents metronome marks and other metric relationships. The beat-unit group and per-","type":"text"},{"text":" ","type":"text"},{"text":"minute element specify regular metronome marks. The metronome-note and metronome-relation elements allow for","type":"text"},{"text":" ","type":"text"},{"text":"the specification of metric modulations and other metric relationships, such as swing tempo marks where two","type":"text"},{"text":" ","type":"text"},{"text":"eighths are equated to a quarter note \/ eighth note triplet. Tied notes can be represented in both types of","type":"text"},{"text":" ","type":"text"},{"text":"metronome marks by using the beat-unit-tied and metronome-tied elements. The parentheses attribute indicates","type":"text"},{"text":" ","type":"text"},{"text":"whether or not to put the metronome mark in parentheses; its value is no if not specified. The print-object","type":"text"},{"text":" ","type":"text"},{"text":"attribute is set to no in cases where the metronome element represents a relationship or range that is not","type":"text"},{"text":" ","type":"text"},{"text":"displayed in the music notation.","type":"text"}],"title":"MXLMetronome","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome","kind":"symbol"}}}