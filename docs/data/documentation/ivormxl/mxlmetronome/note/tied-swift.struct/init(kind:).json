vorMXL\/documentation\/IvorMXL\/MXLStartStop","navigatorTitle":[{"text":"MXLStartStop","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlstartstop","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLStartStop","kind":"identifier"}],"title":"MXLStartStop","abstract":[{"text":"The start-stop type is used for an attribute of musical elements that can either start or stop, such as","type":"text"},{"text":" ","type":"text"},{"text":"tuplets.","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome":{"type":"topic","abstract":[{"type":"text","text":"The metronome type represents metronome marks and other metric relationships. The beat-unit group and per-"},{"type":"text","text":" "},{"type":"text","text":"minute element specify regular metronome marks. The metronome-note and metronome-relation elements allow for"},{"type":"text","text":" "},{"type":"text","text":"the specification of metric modulations and other metric relationships, such as swing tempo marks where two"},{"type":"text","text":" "},{"type":"text","text":"eighths are equated to a quarter note \/ eighth note triplet. Tied notes can be represented in both types of"},{"type":"text","text":" "},{"type":"text","text":"metronome marks by using the beat-unit-tied and metronome-tied elements. The parentheses attribute indicates"},{"type":"text","text":" "},{"type":"text","text":"whether or not to put the metronome mark in parentheses; its value is no if not specified. The print-object"},{"type":"text","text":" "},{"type":"text","text":"attribute is set to no in cases where the metronome element represents a relationship or range that is not"},{"type":"text","text":" "},{"type":"text","text":"displayed in the music notation."}],"url":"\/documentation\/ivormxl\/mxlmetronome","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLMetronome"}],"kind":"symbol","title":"MXLMetronome","navigatorTitle":[{