l\/mxlstartstop","abstract":[{"text":"The start-stop type is used for an attribute of musical elements that can either start or stop, such as","type":"text"},{"text":" ","type":"text"},{"text":"tuplets.","type":"text"}],"type":"topic","role":"symbol","kind":"symbol","title":"MXLStartStop","navigatorTitle":[{"kind":"identifier","text":"MXLStartStop"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLStartStop"}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome/Note/Tied-swift.struct/kind":{"type":"topic","abstract":[{"type":"text","text":"Whether this element marks the start or the stop of the tie."}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"kind"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL12MXLStartStopO","text":"MXLStartStop","kind":"typeIdentifier"}],"title":"kind","kind":"symbol","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/Note\/Tied-swift.struct\/kind","url":"\/documentation\/ivormxl\/mxlmetronome\/note\/tied-swift.struct\/kind"},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLMetronome","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome","title":"MXLMetronome","kind":"symbol","navigatorTitle":[{"text":"MXLMetronome","kind":"identifier"}],"abstract":[{"type":"text","text":"The metronome type represents metronome marks and other metric relationships. The beat-unit group and per-"},{"text":" ","type":"text"},{"text":"minute element specify regular metronome marks. The metronome-note and metronome-relation elements allow for","type":"text"},{"text":" ","type":"text"},{"text":"the specification of metric modulations and other metric relationships, such as swing tempo marks where two","type":"text"},{"type":"text","text":" "},{"type":"text","text":"eighths are equated to a quarter note \/ eighth note triplet. Tied notes can be represented in both types of"},{"text":" ","type":"text"},{"text":"metronome marks by using the beat-unit-tied and metronome-tied elements. The parentheses attribute indicates","type":"text"},{"text":" ","type":"text"},{"text":"whether or not to put the metronome mark in parentheses; its value is no if not specified. The print-object","type":"text"},{"text":" ","type":"text"},{"text":"attribute is set to no in cases where the metronome element represents a relationship or range that is not","type":"text"},{"text":" ","type":"text"},{"text":"displayed in the music notation.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlmetronome"},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome/Note/Tied-swift.struct":{"type":"topic","abstract":[{"text":"The metronome-tied indicates the presence of a tie within a metric relationship mark. As with the tied","type":"text"},{"text":" ","type":"text"},{"text":"element, both the start and stop of the tie should be specified, in this case within separate metronome-note","type":"text"},{"text":" ","type":"text"},{"text":"elements.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"text":"Tied","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"Tied"}],"title":"MXLMetronome.Note.Tied","kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlmetronome\/note\/tied-swift.struct","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/Note\/Tied-swift.struct"},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome/Note":{"type":"topic","abstract":[{"text":"The metronome-note type defines the appearance of a note within a metric relationship mark.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Note"}],"navigatorTitle":[{"kind":"identifier","text":"Note"}],"title":"MXLMetronome.Note","kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlmetronome\/note","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/Note"}}}