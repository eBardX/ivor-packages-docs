rl":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome/Note/Tied-swift.struct":{"abstract":[{"type":"text","text":"The metronome-tied indicates the presence of a tie within a metric relationship mark. As with the tied"},{"type":"text","text":" "},{"type":"text","text":"element, both the start and stop of the tie should be specified, in this case within separate metronome-note"},{"type":"text","text":" "},{"type":"text","text":"elements."}],"title":"MXLMetronome.Note.Tied","url":"\/documentation\/ivormxl\/mxlmetronome\/note\/tied-swift.struct","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Tied","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/Note\/Tied-swift.struct","navigatorTitle":[{"text":"Tied","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome/Note":{"role":"symbol","navigatorTitle":[{"text":"Note","kind":"identifier"}],"abstract":[{"text":"The metronome-note type defines the appearance of a note within a metric relationship mark.","type":"text"}],"title":"MXLMetronome.Note","type":"topic","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/Note","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Note","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlmetronome\/note"},"doc://IvorMXL/documentation/IvorMXL/MXLStartStop":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlstartstop","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStartStop","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLStartStop"}],"abstract":[{"type":"text","text":"The start-stop type is used for an attribute of musical elements that can either start or stop, such as"},{"type":"text","text":" "},{"type":"text","text":"tuplets."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLStartStop"}],"title":"MXLStartStop"},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLMetronome"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLMetronome"}],"url":"\/documentation\/ivormxl\/mxlmetronome","abstract":[{"text":"The metronome type represents metronome marks and other metric relationships. The beat-unit group and per-","type":"text"},{"text":" ","type":"text"},{"text":"minute element specify regular metronome marks. The metronome-note and metronome-relation elements allow for","type":"text"},{"text":" ","type":"text"},{"text":"the specification of metric modulations and other metric relationships, such as swing tempo marks where two","type":"text"},{"text":" ","type":"text"},{"text":"eighths are equated to a quarter note \/ eighth note triplet. Tied notes can be represented in both types of","type":"text"},{"text":" ","type":"text"},{"text":"metronome marks by using the beat-unit-tied and metronome-tied elements. The parentheses attribute indicates","type":"text"},{"text":" ","type":"text"},{"text":"whether or not to put the metronome mark in parentheses; its value is no if not specified. The print-object","type":"text"},{"text":" ","type":"text"},{"text":"attribute is set to no in cases where the metronome element represents a relationship or range that is not","type":"text"},{"text":" ","type":"text"},{"text":"displayed in the music notation.","type":"text"}],"title":"MXLMetronome","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome/Note/Tied-swift.struct/kind":{"type":"topic","abstract":[{"type":"text","text":"Whether this element marks the start or the stop of the tie."}],"url":"\/documentation\/ivormxl\/mxlmetronome\/note\/tied-swift.struct\/kind","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/Note\/Tied-swift.struct\/kind","title":"kind","kind":"symbol","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"kind","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL12MXLStartStopO","text":"MXLStartStop","kind":"typeIdentifier"}]}}}