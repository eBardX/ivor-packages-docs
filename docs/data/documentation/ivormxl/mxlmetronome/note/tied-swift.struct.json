es; its value is no if not specified. The print-object"},{"type":"text","text":" "},{"type":"text","text":"attribute is set to no in cases where the metronome element represents a relationship or range that is not"},{"type":"text","text":" "},{"type":"text","text":"displayed in the music notation."}],"url":"\/documentation\/ivormxl\/mxlmetronome","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLMetronome"}],"kind":"symbol","title":"MXLMetronome","navigatorTitle":[{"kind":"identifier","text":"MXLMetronome"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome/Note/Tied-swift.struct/Equatable-Implementations":{"kind":"article","type":"topic","url":"\/documentation\/ivormxl\/mxlmetronome\/note\/tied-swift.struct\/equatable-implementations","title":"Equatable Implementations","abstract":[],"role":"collectionGroup","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/Note\/Tied-swift.struct\/Equatable-Implementations"},"doc://IvorMXL/s16SendableMetatypeP":{"identifier":"doc:\/\/IvorMXL\/s16SendableMetatypeP","type":"unresolvable","title":"Swift.SendableMetatype"},"doc://IvorMXL/s8CopyableP":{"identifier":"doc:\/\/IvorMXL\/s8CopyableP","type":"unresolvable","title":"Swift.Copyable"},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome/Note/Tied-swift.struct/kind":{"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"kind"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL12MXLStartStopO","kind":"typeIdentifier","text":"MXLStartStop"}],"url":"\/documentation\/ivormxl\/mxlmetronome\/note\/tied-swift.struct\/kind","title":"kind","abstract":[{"text":"Whether this element marks the start or the stop of the tie.","type":"text"}],"role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/Note\/Tied-swift.struct\/