 mark in parentheses; its value is no if not specified. The print-object"},{"type":"text","text":" "},{"type":"text","text":"attribute is set to no in cases where the metronome element represents a relationship or range that is not"},{"type":"text","text":" "},{"type":"text","text":"displayed in the music notation."}]},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome/Note":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/Note","role":"symbol","navigatorTitle":[{"text":"Note","kind":"identifier"}],"type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Note","kind":"identifier"}],"abstract":[{"type":"text","text":"The metronome-note type defines the appearance of a note within a metric relationship mark."}],"url":"\/documentation\/ivormxl\/mxlmetronome\/note","title":"MXLMetronome.Note"},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome/Note/beam-swift.property":{"kind":"symbol","type":"topic","abstract":[{"type":"text","text":"The metronome-beam elements defining beaming for this metronome note, working like the beam element in"},{"type":"text","text":" "},{"type":"text","text":"defining metric relationships."}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"beam","kind":"identifier"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:7IvorMXL12MXLMetronomeV4NoteV4BeamV","text":"Beam","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"role":"symbol","url":"\/documentation\/ivormxl\/mxlmetronome\/note\/beam-swift.property","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/Note\/beam-swift.property","title":"beam"}}}