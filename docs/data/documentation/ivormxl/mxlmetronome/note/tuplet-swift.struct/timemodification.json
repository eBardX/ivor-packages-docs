ntation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome/Note/Tuplet-swift.struct":{"abstract":[{"type":"text","text":"The metronome-tuplet type uses the same element structure as the time-modification element along with some"},{"type":"text","text":" "},{"type":"text","text":"attributes from the tuplet element."}],"title":"MXLMetronome.Note.Tuplet","url":"\/documentation\/ivormxl\/mxlmetronome\/note\/tuplet-swift.struct","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Tuplet","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/Note\/Tuplet-swift.struct","navigatorTitle":[{"text":"Tuplet","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome/Note":{"role":"symbol","navigatorTitle":[{"text":"Note","kind":"identifier"}],"abstract":[{"text":"The metronome-note type defines the appearance of a note within a metric relationship mark.","type":"text"}],"title":"MXLMetronome.Note","type":"topic","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/Note","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Note","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlmetronome\/note"},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLMetronome"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLMetronome"}],"url":"\/documentation\/ivormxl\/mxlmetronome","abstract":[{"text":"The metronome type represents metronome marks and other metric relationships. The beat-unit group and per-","type":"text"},{"text":" ","type":"text"},{"text":"minute element specify regular metronome marks. The metronome-note and metronome-relation elements allow for","type":"text"},{"text":" ","type":"text"},{"text":"the specification of metric modulations and other metric relationships, such as swing tempo marks where two","type":"text"},{"text":" ","type":"text"},{"text":"eighths are equated to a quarter note \/ eighth note triplet. Tied notes can be represented in both types of","type":"text"},{"text":" ","type":"text"},{"text":"metronome marks by using the beat-unit-tied and metronome-tied elements. The parentheses attribute indicates","type":"text"},{"text":" ","type":"text"},{"text":"whether or not to put the metronome mark in parentheses; its value is no if not specified. The print-object","type":"text"},{"text":" ","type":"text"},{"text":"attribute is set to no in cases where the metronome element represents a relationship or range that is not","type":"text"},{"text":" ","type":"text"},{"text":"displayed in the music notation.","type":"text"}],"title":"MXLMetronome","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLTimeModification":{"role":"symbol","url":"\/documentation\/ivormxl\/mxltimemodification","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTimeModification","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTimeModification"}],"abstract":[{"type":"text","text":"Time modification indicates tuplets, double-note tremolos, and other durational changes. A time-modification"},{"type":"text","text":" "},{"type":"text","text":"element shows how the cumulative, sounding effect of tuplets and double-note tremolos compare to the written"},{"type":"text","text":" "},{"type":"text","text":"note type represented by the type and dot elements. Nested tuplets and other notations that use more detailed"},{"type":"text","text":" "},{"type":"text","text":"information need both the time-modification and tuplet elements to be represented accurately."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLTimeModification"}],"title":"MXLTimeModification"},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome/Note/Tuplet-swift.struct/timeModification":{"kind":"symbol","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"timeModification","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLTimeModification","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL19MXLTimeModificationV"}],"type":"topic","abstract":[{"type":"text","text":"The metronome-tuplet type uses the same element structure as the time-modification element along with some"},{"type":"text","text":" "},{"type":"text","text":"attributes from the tuplet element."}],"url":"\/documentation\/ivormxl\/mxlmetronome\/note\/tuplet-swift.struct\/timemodification","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/Note\/Tuplet-swift.struct\/timeModification","title":"timeModification"}}}