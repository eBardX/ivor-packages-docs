within a metric relationship mark."}],"url":"\/documentation\/ivormxl\/mxlmetronome\/note","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Note"}],"kind":"symbol","title":"MXLMetronome.Note","navigatorTitle":[{"kind":"identifier","text":"Note"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/Note","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLTimeModification":{"type":"topic","abstract":[{"text":"Time modification indicates tuplets, double-note tremolos, and other durational changes. A time-modification","type":"text"},{"text":" ","type":"text"},{"text":"element shows how the cumulative, sounding effect of tuplets and double-note tremolos compare to the written","type":"text"},{"text":" ","type":"text"},{"text":"note type represented by the type and dot elements. Nested tuplets and other notations that use more detailed","type":"text"},{"text":" ","type":"text"},{"text":"information need both the time-modification and tuplet elements to be represented accurately.","type":"text"}],"url":"\/documentation\/ivormxl\/mxltimemodification","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTimeModification"}],"kind":"symbol","title":"MXLTimeModification","navigatorTitle":[{"kind":"identifier","text":"MXLTimeModification"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTimeModification","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome":{"type":"topic","abstract":[{"type":"text","text":"The metronome type represents metronome marks and other metric relationships. The beat-unit group and per-"},{"type":"text","text":" "},{"type":"text","text":"minute element specify regular metronome marks. The metronome-note and metronome-relation elements allow for"},{"type":"text","text":" "},{"type":"text","text":"the specification of metric modulations and other metric relationships, such as swing tempo marks where two"},{"type":"text","text":" "},{"type":"text","text":"eighths are equated to a quarter note \/ eighth note triplet. Tied notes can be represented in both types of"},{"type":"text","text":" "},{"type":"text","text":"metronome marks by using the beat-unit-tied and metronome-tied elements. The parentheses attribute indicates"},{"type":"text","text":" "},{"type":"text","text":"whether or not to put the metronome mark in parentheses; its value is no if not specified. The print-object"},{"type":"text","text":" "},{"type":"text","text":"attribute is set to no in cases where the metronome element represents a relationship or range that is not"},{"type":"text","text":" "},{"type":"text","text":"displayed in the music notation."}],"url":"\/documentation\/ivormxl\/mxlmetronome","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLMetronome"}],"kind":"symbol","title":"MXLMetronome","navigatorTitle":[{"kind":"identifier","text":"MXLMetronome"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome/Note/Tuplet-swift.struct":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/Note\/Tuplet-swift.struct","navigatorTitle":[{"text":"Tuplet","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlmetronome\/note\/tuplet-swift.struct","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"text":"Tuplet","kind":"identifier"}],"title":"MXLMetronome.Note.Tuplet","abstract":[{"type":"text","text":"The metronome-tuplet type uses the same element structure as the time-modification element along with some"},{"type":"text","text":" "},{"type":"text","text":"attributes from the tuplet element."}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome/Note/Tuplet-swift.struct/timeModification":{"kind":"symbol","abstract":[{"text":"The metronome-tuplet type uses the same element structure as the time-modification element along with some","type":"text"},{"text":" ","type":"text"},{"text":"attributes from the tuplet element.","type":"text"}],"title":"timeModification","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/Note\/Tuplet-swift.struct\/timeModification","type":"topic","url":"\/documentation\/ivormxl\/mxlmetronome\/note\/tuplet-swift.struct\/timemodification","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"timeModification"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL19MXLTimeModificationV","text":"MXLTimeModification"}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"}}}