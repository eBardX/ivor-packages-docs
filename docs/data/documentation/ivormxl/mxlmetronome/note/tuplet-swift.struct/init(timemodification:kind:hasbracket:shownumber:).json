let numbers.","type":"text"}]}],"name":"showNumber"}]}],"references":{"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome":{"type":"topic","abstract":[{"type":"text","text":"The metronome type represents metronome marks and other metric relationships. The beat-unit group and per-"},{"type":"text","text":" "},{"type":"text","text":"minute element specify regular metronome marks. The metronome-note and metronome-relation elements allow for"},{"type":"text","text":" "},{"type":"text","text":"the specification of metric modulations and other metric relationships, such as swing tempo marks where two"},{"type":"text","text":" "},{"type":"text","text":"eighths are equated to a quarter note \/ eighth note triplet. Tied notes can be represented in both types of"},{"type":"text","text":" "},{"type":"text","text":"metronome marks by using the beat-unit-tied and metronome-tied elements. The parentheses attribute indicates"},{"type":"text","text":" "},{"type":"text","text":"whether or not to put the metronome mark in parentheses; its value is no if not specified. The print-object"},{"type":"text","text":" "},{"type":"text","text":"attribute is set to no in cases where the metronome element represents a relationship or range that is not"},{"type":"text","text":" "},{"type":"text","text":"displayed in the music notation."}],"url":"\/documentation\/ivormxl\/mxlmetronome","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLMetronome"}],"kind":"symbol","title":"MXLMetronome","navigatorTitle":[{"kind":"identifier","text":"MXLMetronome"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome/Note":{"type":"topic","abstract":[{"type":"text","text":"The metronome-note type defines the appearance of a note within a metric relationship mark."}],"url":"\/documentation\/ivormxl\/mxlmetronome\/note","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Note"}],"kind":"symbol","title":"MXLMetronome.Note","navigatorTitle":[{"kind":"identifier","text":"Note"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/Note","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLShowTuplet":{"type":"topic","abstract":[{"type":"text","text":"The show-tuplet type indicates whether to show a part of a tuplet relating to the tuplet-actual element, both"},{"type":"text","text":" "},{"type":"text","text":"the tuplet-actual and tuplet-normal elements, or neither."}],"url":"\/documentation\/ivormxl\/mxlshowtuplet","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLShowTuplet"}],"kind":"symbol","title":"MXLShowTuplet","navigatorTitle":[{"kind":"identifier","text":"MXLShowTuplet"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLShowTuplet","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLStartStop":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStartStop","navigatorTitle":[{"text":"MXLStartStop","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlstartstop","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLStartStop","kind":"identifier"}],"title":"MXLStartStop","abstract":[{"text":"The start-stop type is used for an attribute of musical elements that can either start or stop, such as","type":"text"},{"text":" ","type":"text"},{"text":"tuplets.","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLTimeModification":{"type":"topic","abstract":[{"text":"Time modification indicates tuplets, double-note tremolos, and o