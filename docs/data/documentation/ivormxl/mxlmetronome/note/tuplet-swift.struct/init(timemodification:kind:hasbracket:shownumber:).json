":": ","kind":"text"},{"text":"MXLTimeModification","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL19MXLTimeModificationV"},{"text":", ","kind":"text"},{"text":"kind","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLStartStop","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL12MXLStartStopO"},{"text":", ","kind":"text"},{"text":"hasBracket","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":"?, ","kind":"text"},{"text":"showNumber","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLShowTuplet","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL13MXLShowTupletO"},{"text":"?)","kind":"text"}],"abstract":[{"type":"text","text":"Creates a new "},{"code":"MXLMetronome.Note.Tuplet","type":"codeVoice"},{"type":"text","text":"."}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/Note\/Tuplet-swift.struct\/init(timeModification:kind:hasBracket:showNumber:)","type":"topic","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome/Note/Tuplet-swift.struct":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/Note\/Tuplet-swift.struct","abstract":[{"type":"text","text":"The metronome-tuplet type uses the same element structure as the time-modification element along with some"},{"type":"text","text":" "},{"type":"text","text":"attributes from the tuplet element."}],"title":"MXLMetronome.Note.Tuplet","navigatorTitle":[{"text":"Tuplet","kind":"identifier"}],"type":"topic","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Tuplet","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlmetronome\/note\/tuplet-swift.struct"},"doc://IvorMXL/documentation/IvorMXL/MXLTimeModification":{"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTimeModification","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTimeModification","title":"MXLTimeModification","url":"\/documentation\/ivormxl\/mxltimemodification","kind":"symbol","navigatorTitle":[{"text":"MXLTimeModification","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"Time modification indicates tuplets, double-note tremolos, and other durational changes. A time-modification"},{"type":"text","text":" "},{"type":"text","text":"element shows how the cumulative, sounding effect of tuplets and double-note tremolos compare to the written"},{"type":"text","text":" "},{"type":"text","text":"note type represented by the type and dot elements. Nested tuplets and other notations that use more detailed"},{"type":"text","text":" "},{"type":"text","text":"information need both the time-modification and tuplet elements to be represented accurately."}]},"doc://IvorMXL/documentation/IvorMXL/MXLStartStop":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlstartstop","title":"MXLStartStop","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLStartStop","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"MXLStartStop"}],"abstract":[{"type":"text","text":"The start-stop type is used for an attribute of musical elements that can either start or stop, such as"},{"type":"text","text":" "},{"type":"text","text":"tuplets."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStartStop"},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome":{"type":"topic","title":"MXLMetronome","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLMetronome"}],"url":"\/documentation\/ivormxl\/mxlmetronome","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"MXLMetronome","kind":"identifier"}],"abstract":[{"text":"The metronome type represents metronome marks and other metric relationships. The beat-unit group and per-","type":"text"},{"text":" ","type":"text"},{"text":"minute element specify regular metronome marks. The metronome-note and metronome-relation elements allow for","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"the specification of metric modulations and other metric relationships, such as swing tempo marks where two"},{"type":"text","text":" "},{"text":"eighths are equated to a quarter note \/ eighth note triplet. Tied notes can be represented in both types of","type":"text"},{"type":"text","text":" "},{"type":"text","text":"metronome marks by using the beat-unit-tied and metronome-tied elements. The parentheses attribute indicates"},{"type":"text","text":" "},{"type":"text","text":"whether or not to put the metronome mark in parentheses; its value is no if not specified. The print-object"},{"type":"text","text":" "},{"type":"text","text":"attribute is set to no in cases where the metronome element represents a relationship or range that is not"},{"type":"text","text":" "},{"type":"text","text":"displayed in the music notation."}]}}}