}]},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLMetronome/Note":{"type":"topic","abstract":[{"text":"The metronome-note type defines the appearance of a note within a metric relationship mark.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Note"}],"navigatorTitle":[{"kind":"identifier","text":"Note"}],"title":"MXLMetronome.Note","kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlmetronome\/note","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/Note"},"doc://IvorMXL/documentation/IvorMXL/MXLTimeModification":{"role":"symbol","kind":"symbol","url":"\/documentation\/ivormxl\/mxltimemodification","title":"MXLTimeModification","abstract":[{"type":"text","text":"Time modification indicates tuplets, double-note tremolos, and other durational changes. A time-modification"},{"type":"text","text":" "},{"type":"text","text":"element shows how the cumulative, sounding effect of tuplets and double-note tremolos compare to the written"},{"type":"text","text":" "},{"type":"text","text":"note type represented by the type and dot elements. Nested tuplets and other notations that use more detailed"},{"type":"text","text":" "},{"type":"text","text":"information need both the time-modification and tuplet elements to be represented accurately."}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTimeModification","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTimeModification","navigatorTitle":[{"text":"MXLTimeModification","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome/Note/Tuplet-swift.struct":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Tuplet"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Tuplet"}],"url":"\/documentation\/ivormxl\/mxlmetronome\/note\/tuplet-swift.struct","role":"symbol","title":"MXLMetronome.Note.Tuplet","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/Note\/Tuplet-swift.struct","type":"topic","abstract":[{"text":"The metronome-tuplet type uses the same element structure as the time-modification element along with some","type":"text"},{"text":" ","type":"text"},{"text":"attributes from the tuplet element.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLStartStop":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStartStop","url":"\/documentation\/ivormxl\/mxlstartstop","abstract":[{"text":"The start-stop type is used for an attribute of musical elements that can either start or stop, such as","type":"text"},{"text":" ","type":"text"},{"text":"tuplets.","type":"text"}],"type":"topic","role":"symbol","kind":"symbol","title":"MXLStartStop","navigatorTitle":[{"kind":"identifier","text":"MXLStartStop"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLStartStop"}]},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome/Note/Tuplet-swift.struct/init(timeModification:kind:hasBracket:showNumber:)":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/Note\/Tuplet-swift.struct\/init(timeModification:kind:hasBracket:showNumber:)","url":"\/documentation\/ivormxl\/mxlmetronome\/note\/tuplet-swift.struct\/init(timemodification:kind:hasbracket:shownumber:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"timeModification"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL19MXLTimeModificationV","text":"MXLTimeModification"},{"kind":"text","text":", "},{"kind":"externalParam","text":"kind"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL12MXLStartStopO","text":"MXLStartStop"},{"kind":"text","text":", "},{"kind":"externalParam","text":"hasBracket"},{"kind":"text","text":":