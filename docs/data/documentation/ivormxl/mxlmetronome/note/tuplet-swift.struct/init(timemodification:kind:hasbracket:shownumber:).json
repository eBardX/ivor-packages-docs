lets, double-note tremolos, and other durational changes. A time-modification"},{"type":"text","text":" "},{"type":"text","text":"element shows how the cumulative, sounding effect of tuplets and double-note tremolos compare to the written"},{"type":"text","text":" "},{"type":"text","text":"note type represented by the type and dot elements. Nested tuplets and other notations that use more detailed"},{"type":"text","text":" "},{"type":"text","text":"information need both the time-modification and tuplet elements to be represented accurately."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLTimeModification"}],"title":"MXLTimeModification"},"doc://IvorMXL/documentation/IvorMXL/MXLStartStop":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlstartstop","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStartStop","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLStartStop"}],"abstract":[{"type":"text","text":"The start-stop type is used for an attribute of musical elements that can either start or stop, such as"},{"type":"text","text":" "},{"type":"text","text":"tuplets."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLStartStop"}],"title":"MXLStartStop"},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLMetronome"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLMetronome"}],"url":"\/documentation\/ivormxl\/mxlmetronome","abstract":[{"text":"The metronome type represents metronome marks and other metric relationships. The beat-unit group and per-","type":"text"},{"text":" ","type":"text"},{"text":"minute element specify regular metronome marks. The metronome-note and metronome-relation elements allow for","type":"text"},{"text":" ","type":"text"},{"text":"the specification of metric modulations and other metric relationships, such as swing tempo marks where two","type":"text"},{"text":" ","type":"text"},{"text":"eighths are equated to a quarter note \/ eighth note triplet. Tied notes can be represented in both types of","type":"text"},{"text":" ","type":"text"},{"text":"metronome marks by using the beat-unit-tied and metronome-tied elements. The parentheses attribute indicates","type":"text"},{"text":" ","type":"text"},{"text":"whether or not to put the metronome mark in parentheses; its value is no if not specified. The print-object","type":"text"},{"text":" ","type":"text"},{"text":"attribute is set to no in cases where the metronome element represents a relationship or range that is not","type":"text"},{"text":" ","type":"text"},{"text":"displayed in the music notation.","type":"text"}],"title":"MXLMetronome","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome/Note/Tuplet-swift.struct/init(timeModification:kind:hasBracket:showNumber:)":{"kind":"symbol","role":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"timeModification","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL19MXLTimeModificationV","text":"MXLTimeModification","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"kind","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL12MXLStartStopO","text":"MXLStartStop","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"hasBracket","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"showNumber","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL13MXLShowTupletO","text":"MXLShowTuplet","kind":"typeIdentifier"},{"text":"?)","kind":"text"}],"type":"topic","abstract":[{"type":"text","text":"Creates a new "},{