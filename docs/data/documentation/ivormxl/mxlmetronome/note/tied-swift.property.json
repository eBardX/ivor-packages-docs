ext":" ","type":"text"},{"text":"metronome marks by using the beat-unit-tied and metronome-tied elements. The parentheses attribute indicates","type":"text"},{"text":" ","type":"text"},{"text":"whether or not to put the metronome mark in parentheses; its value is no if not specified. The print-object","type":"text"},{"text":" ","type":"text"},{"text":"attribute is set to no in cases where the metronome element represents a relationship or range that is not","type":"text"},{"text":" ","type":"text"},{"text":"displayed in the music notation.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlmetronome"},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome/Note/tied-swift.property":{"kind":"symbol","url":"\/documentation\/ivormxl\/mxlmetronome\/note\/tied-swift.property","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/Note\/tied-swift.property","title":"tied","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"tied"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL12MXLMetronomeV4NoteV4TiedV","text":"Tied"},{"kind":"text","text":"?"}],"type":"topic","abstract":[{"type":"text","text":"The metronome-tied element indicating the presence of a tie to another metronome note, if any."}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome/Note":{"type":"topic","abstract":[{"text":"The metronome-note type defines the appearance of a note within a metric relationship mark.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Note"}],"navigatorTitle":[{"kind":"identifier","text":"Note"}],"title":"MXLMetronome.Note","kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlmetronome\/note","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/Note"}}}