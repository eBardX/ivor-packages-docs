d. The print-object","type":"text"},{"text":" ","type":"text"},{"text":"attribute is set to no in cases where the metronome element represents a relationship or range that is not","type":"text"},{"text":" ","type":"text"},{"text":"displayed in the music notation.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlmetronome"},"doc://IvorMXL/s8CopyableP":{"type":"unresolvable","title":"Swift.Copyable","identifier":"doc:\/\/IvorMXL\/s8CopyableP"},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome/Note/Tuplet-swift.struct/kind":{"title":"kind","url":"\/documentation\/ivormxl\/mxlmetronome\/note\/tuplet-swift.struct\/kind","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"kind","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLStartStop","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL12MXLStartStopO"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/Note\/Tuplet-swift.struct\/kind","role":"symbol","kind":"symbol","abstract":[{"text":"Whether this element marks the start or the stop of the tuplet.","type":"text"}]},"doc://IvorMXL/SQ":{"type":"unresolvable","title":"Swift.Equatable","identifier":"doc:\/\/IvorMXL\/SQ"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/s16SendableMetatypeP":{"type":"unresolvable","title":"Swift.SendableMetatype","identifier":"doc:\/\/IvorMXL\/s16SendableMetatypeP"}}}