"justify attribute indicates horizontal alignment as well as justification."}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLMetronome/justify":{"title":"justify","type":"topic","url":"\/documentation\/ivormxl\/mxlmetronome\/justify","kind":"symbol","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"justify","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLLeftCenterRight","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL18MXLLeftCenterRightO"},{"text":"?","kind":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/justify","abstract":[{"type":"text","text":"The justify attribute is used to indicate left, center, or right justification. The default value varies for"},{"type":"text","text":" "},{"type":"text","text":"different elements. For elements where the justify attribute is present but the halign attribute is not, the"},{"type":"text","text":" "},{"type":"text","text":"justify attribute indicates horizontal alignment as well as justification."}]},"doc://IvorMXL/documentation/IvorMXL/MXLLeftCenterRight":{"url":"\/documentation\/ivormxl\/mxlleftcenterright","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLeftCenterRight","abstract":[{"type":"text","text":"The left-center-right type is used to define horizontal alignment and text justification."}],"title":"MXLLeftCenterRight","kind":"symbol","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLLeftCenterRight"}],"navigatorTitle":[{"kind":"identifier","text":"MXLLeftCenterRight"}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLMetronome"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLMetronome"}],"url":"\/documentation\/ivormxl\/mxlmetronome","abstract":[{"text":"The metronome type represents metronome marks and other metric relationships. The beat-unit group and per-","type":"text"},{"text":" ","type":"text"},{"text":"minute element specify regular metronome marks. The metronome-note and metronome-relation elements allow for","type":"text"},{"text":" ","type":"text"},{"text":"the specification of metric modulations and other metric relationships, such as swing tempo marks where two","type":"text"},{"text":" ","type":"text"},{"text":"eighths are equated to a quarter note \/ eighth note triplet. Tied notes can be represented in both types of","type":"text"},{"text":" ","type":"text"},{"text":"metronome marks by using the beat-unit-tied and metronome-tied elements. The parentheses attribute indicates","type":"text"},{"text":" ","type":"text"},{"text":"whether or not to put the metronome mark in parentheses; its value is no if not specified. The print-object","type":"text"},{"text":" ","type":"text"},{"text":"attribute is set to no in cases where the metronome element represents a relationship or range that is not","type":"text"},{"text":" ","type":"text"},{"text":"displayed in the music notation.","type":"text"}],"title":"MXLMetronome","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome","kind":"symbol"}}}