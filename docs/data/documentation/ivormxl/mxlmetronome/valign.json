{"variants":[{"paths":["\/documentation\/ivormxl\/mxlmetronome\/valign"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"type":"text","text":"The valign attribute is used to indicate vertical alignment to the top, middle, bottom, or baseline of the"},{"type":"text","text":" "},{"type":"text","text":"text. Defaults are implementation-dependent."}],"metadata":{"title":"valign","role":"symbol","roleHeading":"Instance Property","externalID":"s:7IvorMXL12MXLMetronomeV6valignAA9MXLValignOSgvp","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"valign"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLValign","preciseIdentifier":"s:7IvorMXL9MXLValignO"},{"kind":"text","text":"?"}],"modules":[{"name":"IvorMXL"}],"symbolKind":"property"},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"valign","kind":"identifier"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValign","preciseIdentifier":"s:7IvorMXL9MXLValignO","text":"MXLValign","kind":"typeIdentifier"},{"text":"?","kind":"text"}]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"inlineContent":[{"text":"Maps to the MusicXML ","type":"text"},{"code":"valign","type":"codeVoice"},{"text":" attribute.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/valign"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome"]]},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLValign":{"title":"MXLValign","url":"\/documentation\/ivormxl\/mxlvalign","abstract":[{"text":"The valign type is used to indicate vertical alignment to the top, middle, bottom, or baseline of the text. If","type":"text"},{"text":" ","type":"text"},{"text":"the text is on multiple lines, baseline alignment refers to the baseline of the lowest line of text. Defaults","type":"text"},{"text":" ","type":"text"},{"text":"are implementation-dependent.","type":"text"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLValign"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLValign"}],"type":"topic","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValign"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome/valign":{"title":"valign","role":"symbol","kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"valign","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLValign","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLValignO"},{"text":"?","kind":"text"}],"type":"topic","abstract":[{"type":"text","text":"The valign attribute is used to indicate vertical alignment to the top, middle, bottom, or baseline of the"},{"type":"text","text":" "},{"type":"text","text":"text. Defaults are implementation-dependent."}],"url":"\/documentation\/ivormxl\/mxlmetronome\/valign","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/valign"},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome":{"type":"topic","title":"MXLMetronome","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLMetronome"}],"url":"\/documentation\/ivormxl\/mxlmetronome","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"MXLMetronome","kind":"identifier"}],"abstract":[{"text":"The metronome type represents metronome marks and other metric relationships. The beat-unit group and per-","type":"text"},{"text":" ","type":"text"},{"text":"minute element specify regular metronome marks. The metronome-note and metronome-relation elements allow for","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"the specification of metric modulations and other metric relationships, such as swing tempo marks where two"},{"type":"text","text":" "},{"text":"eighths are equated to a quarter note \/ eighth note triplet. Tied notes can be represented in both types of","type":"text"},{"type":"text","text":" "},{"type":"text","text":"metronome marks by using the beat-unit-tied and metronome-tied elements. The parentheses attribute indicates"},{"type":"text","text":" "},{"type":"text","text":"whether or not to put the metronome mark in parentheses; its value is no if not specified. The print-object"},{"type":"text","text":" "},{"type":"text","text":"attribute is set to no in cases where the metronome element represents a relationship or range that is not"},{"type":"text","text":" "},{"type":"text","text":"displayed in the music notation."}]}}}