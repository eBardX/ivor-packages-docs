xt":"The left-center-right type is used to define horizontal alignment and text justification.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLeftCenterRight","role":"symbol","url":"\/documentation\/ivormxl\/mxlleftcenterright","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLLeftCenterRight"}],"type":"topic"}}}