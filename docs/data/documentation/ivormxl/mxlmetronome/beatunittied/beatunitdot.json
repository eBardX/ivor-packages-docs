{"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/BeatUnitTied"]]},"abstract":[{"text":"The number of augmentation dots to apply to the beat-unit note in a metronome mark.","type":"text"}],"sections":[],"kind":"symbol","variants":[{"paths":["\/documentation\/ivormxl\/mxlmetronome\/beatunittied\/beatunitdot"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"role":"symbol","roleHeading":"Instance Property","modules":[{"name":"IvorMXL"}],"externalID":"s:7IvorMXL12MXLMetronomeV12BeatUnitTiedV04beatE3DotSivp","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"beatUnitDot","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"}],"title":"beatUnitDot","symbolKind":"property"},"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/BeatUnitTied\/beatUnitDot","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"beatUnitDot","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"}]}],"kind":"declarations"},{"content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"Maps to a nested MusicXML ","type":"text"},{"type":"codeVoice","code":"<beat-unit-dot>"},{"text":" element.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLMetronome/BeatUnitTied":{"abstract":[{"type":"text","text":"The beat-unit-tied type indicates a beat-unit within a metronome mark that is tied to the preceding beat-unit."},{"type":"text","text":" "},{"type":"text","text":"This allows two or more tied notes to be associated with a per-minute value in a metronome mark, whereas the"},{"type":"text","text":" "},{"type":"text","text":"metronome-tied element is restricted to metric relationship marks."}],"navigatorTitle":[{"text":"BeatUnitTied","kind":"identifier"}],"type":"topic","title":"MXLMetronome.BeatUnitTied","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BeatUnitTied","kind":"identifier"}],"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlmetronome\/beatunittied","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/BeatUnitTied"},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome":{"type":"topic","title":"MXLMetronome","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLMetronome"}],"url":"\/documentation\/ivormxl\/mxlmetronome","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"MXLMetronome","kind":"identifier"}],"abstract":[{"text":"The metronome type represents metronome marks and other metric relationships. The beat-unit group and per-","type":"text"},{"text":" ","type":"text"},{"text":"minute element specify regular metronome marks. The metronome-note and metronome-relation elements allow for","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"the specification of metric modulations and other metric relationships, such as swing tempo marks where two"},{"type":"text","text":" "},{"text":"eighths are equated to a quarter note \/ eighth note triplet. Tied notes can be represented in both types of","type":"text"},{"type":"text","text":" "},{"type":"text","text":"metronome marks by using the beat-unit-tied and metronome-tied elements. The parentheses attribute indicates"},{"type":"text","text":" "},{"type":"text","text":"whether or not to put the metronome mark in parentheses; its value is no if not specified. The print-object"},{"type":"text","text":" "},{"type":"text","text":"attribute is set to no in cases where the metronome element represents a relationship or range that is not"},{"type":"text","text":" "},{"type":"text","text":"displayed in the music notation."}]},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome/BeatUnitTied/beatUnitDot":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/BeatUnitTied\/beatUnitDot","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"beatUnitDot"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"url":"\/documentation\/ivormxl\/mxlmetronome\/beatunittied\/beatunitdot","role":"symbol","type":"topic","abstract":[{"text":"The number of augmentation dots to apply to the beat-unit note in a metronome mark.","type":"text"}],"kind":"symbol","title":"beatUnitDot"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]}}}