{"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"role":"symbol","title":"beatUnitDot","roleHeading":"Instance Property","externalID":"s:7IvorMXL12MXLMetronomeV12BeatUnitTiedV04beatE3DotSivp","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"beatUnitDot","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"}],"modules":[{"name":"IvorMXL"}],"symbolKind":"property"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/BeatUnitTied"]]},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"beatUnitDot","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"}],"platforms":["macOS"]}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"Maps to a nested MusicXML ","type":"text"},{"code":"<beat-unit-dot>","type":"codeVoice"},{"text":" element.","type":"text"}]}]}],"abstract":[{"type":"text","text":"The number of augmentation dots to apply to the beat-unit note in a metronome mark."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/BeatUnitTied\/beatUnitDot"},"sections":[],"variants":[{"paths":["\/documentation\/ivormxl\/mxlmetronome\/beatunittied\/beatunitdot"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLMetronome/BeatUnitTied":{"abstract":[{"text":"The beat-unit-tied type indicates a beat-unit within a metronome mark that is tied to the preceding beat-unit.","type":"text"},{"text":" ","type":"text"},{"text":"This allows two or more tied notes to be associated with a per-minute value in a metronome mark, whereas the","type":"text"},{"text":" ","type":"text"},{"text":"metronome-tied element is restricted to metric relationship marks.","type":"text"}],"title":"MXLMetronome.BeatUnitTied","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"text":"BeatUnitTied","kind":"identifier"}],"navigatorTitle":[{"text":"BeatUnitTied","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlmetronome\/beatunittied","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/BeatUnitTied"},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome":{"abstract":[{"text":"The metronome type represents metronome marks and other metric relationships. The beat-unit group and per-","type":"text"},{"text":" ","type":"text"},{"text":"minute element specify regular metronome marks. The metronome-note and metronome-relation elements allow for","type":"text"},{"text":" ","type":"text"},{"text":"the specification of metric modulations and other metric relationships, such as swing tempo marks where two","type":"text"},{"text":" ","type":"text"},{"text":"eighths are equated to a quarter note \/ eighth note triplet. Tied notes can be represented in both types of","type":"text"},{"text":" ","type":"text"},{"text":"metronome marks by using the beat-unit-tied and metronome-tied elements. The parentheses attribute indicates","type":"text"},{"text":" ","type":"text"},{"text":"whether or not to put the metronome mark in parentheses; its value is no if not specified. The print-object","type":"text"},{"text":" ","type":"text"},{"text":"attribute is set to no in cases where the metronome element represents a relationship or range that is not","type":"text"},{"text":" ","type":"text"},{"text":"displayed in the music notation.","type":"text"}],"title":"MXLMetronome","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLMetronome"}],"navigatorTitle":[{"kind":"identifier","text":"MXLMetronome"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlmetronome","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome"},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome/BeatUnitTied/beatUnitDot":{"title":"beatUnitDot","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"kind":"text","text":" "},{"text":"beatUnitDot","kind":"identifier"},{"kind":"text","text":": "},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"}],"kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxlmetronome\/beatunittied\/beatunitdot","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/BeatUnitTied\/beatUnitDot","abstract":[{"text":"The number of augmentation dots to apply to the beat-unit note in a metronome mark.","type":"text"}]}}}