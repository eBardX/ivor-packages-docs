{"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"type":"text","text":"Creates a new "},{"code":"MXLMetronome.BeatUnitTied","type":"codeVoice"},{"type":"text","text":"."}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/BeatUnitTied"]]},"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/BeatUnitTied\/init(beatUnit:beatUnitDot:)","interfaceLanguage":"swift"},"kind":"symbol","metadata":{"roleHeading":"Initializer","title":"init(beatUnit:beatUnitDot:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"beatUnit","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL16MXLNoteKindValueO","text":"MXLNoteKindValue","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"beatUnitDot","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":")","kind":"text"}],"modules":[{"name":"IvorMXL"}],"symbolKind":"init","role":"symbol","externalID":"s:7IvorMXL12MXLMetronomeV12BeatUnitTiedV04beatE00gE3DotAeA16MXLNoteKindValueO_Sitcfc"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"init","kind":"keyword"},{"text":"(","kind":"text"},{"text":"beatUnit","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL16MXLNoteKindValueO","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNoteKindValue","text":"MXLNoteKindValue","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"beatUnitDot","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":")","kind":"text"}],"platforms":["macOS"]}],"kind":"declarations"},{"parameters":[{"name":"beatUnit","content":[{"inlineContent":[{"type":"text","text":"The beat-unit element indicates the graphical note type to use in a metronome mark."}],"type":"paragraph"}]},{"name":"beatUnitDot","content":[{"inlineContent":[{"type":"text","text":"The number of augmentation dots to apply to the beat-unit note in a metronome mark."}],"type":"paragraph"}]}],"kind":"parameters"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlmetronome\/beatunittied\/init(beatunit:beatunitdot:)"]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLMetronome":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLMetronome"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLMetronome"}],"url":"\/documentation\/ivormxl\/mxlmetronome","abstract":[{"text":"The metronome type represents metronome marks and other metric relationships. The beat-unit group and per-","type":"text"},{"text":" ","type":"text"},{"text":"minute element specify regular metronome marks. The metronome-note and metronome-relation elements allow for","type":"text"},{"text":" ","type":"text"},{"text":"the specification of metric modulations and other metric relationships, such as swing tempo marks where two","type":"text"},{"text":" ","type":"text"},{"text":"eighths are equated to a quarter note \/ eighth note triplet. Tied notes can be represented in both types of","type":"text"},{"text":" ","type":"text"},{"text":"metronome marks by using the beat-unit-tied and metronome-tied elements. The parentheses attribute indicates","type":"text"},{"text":" ","type":"text"},{"text":"whether or not to put the metronome mark in parentheses; its value is no if not specified. The print-object","type":"text"},{"text":" ","type":"text"},{"text":"attribute is set to no in cases where the metronome element represents a relationship or range that is not","type":"text"},{"text":" ","type":"text"},{"text":"displayed in the music notation.","type":"text"}],"title":"MXLMetronome","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome/BeatUnitTied":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlmetronome\/beatunittied","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/BeatUnitTied","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BeatUnitTied","kind":"identifier"}],"kind":"symbol","abstract":[{"type":"text","text":"The beat-unit-tied type indicates a beat-unit within a metronome mark that is tied to the preceding beat-unit."},{"type":"text","text":" "},{"type":"text","text":"This allows two or more tied notes to be associated with a per-minute value in a metronome mark, whereas the"},{"type":"text","text":" "},{"type":"text","text":"metronome-tied element is restricted to metric relationship marks."}],"type":"topic","navigatorTitle":[{"text":"BeatUnitTied","kind":"identifier"}],"title":"MXLMetronome.BeatUnitTied"},"doc://IvorMXL/documentation/IvorMXL/MXLNoteKindValue":{"url":"\/documentation\/ivormxl\/mxlnotekindvalue","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNoteKindValue","abstract":[{"type":"text","text":"The note-type-value type is used for the MusicXML type element and represents the graphic note type, from"},{"type":"text","text":" "},{"type":"text","text":"1024th (shortest) to maxima (longest)."}],"title":"MXLNoteKindValue","kind":"symbol","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNoteKindValue"}],"navigatorTitle":[{"kind":"identifier","text":"MXLNoteKindValue"}]},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome/BeatUnitTied/init(beatUnit:beatUnitDot:)":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlmetronome\/beatunittied\/init(beatunit:beatunitdot:)","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/BeatUnitTied\/init(beatUnit:beatUnitDot:)","fragments":[{"text":"init","kind":"identifier"},