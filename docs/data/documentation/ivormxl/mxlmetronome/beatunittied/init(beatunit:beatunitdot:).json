her or not to put the metronome mark in parentheses; its value is no if not specified. The print-object","type":"text"},{"text":" ","type":"text"},{"text":"attribute is set to no in cases where the metronome element represents a relationship or range that is not","type":"text"},{"text":" ","type":"text"},{"text":"displayed in the music notation.","type":"text"}],"title":"MXLMetronome","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLMetronome"}],"navigatorTitle":[{"kind":"identifier","text":"MXLMetronome"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlmetronome","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome"},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome/BeatUnitTied/init(beatUnit:beatUnitDot:)":{"url":"\/documentation\/ivormxl\/mxlmetronome\/beatunittied\/init(beatunit:beatunitdot:)","abstract":[{"text":"Creates a new ","type":"text"},{"code":"MXLMetronome.BeatUnitTied","type":"codeVoice"},{"text":".","type":"text"}],"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"beatUnit"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLNoteKindValue","preciseIdentifier":"s:7IvorMXL16MXLNoteKindValueO"},{"kind":"text","text":", "},{"kind":"externalParam","text":"beatUnitDot"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":")"}],"title":"init(beatUnit:beatUnitDot:)","type":"topic","role":"symbol","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/BeatUnitTied\/init(beatUnit:beatUnitDot:)"},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome/BeatUnitTied":{"abstract":[{"text":"The beat-unit-tied type indicates a beat-unit within a metronome mark that is tied to the preceding beat-unit.","type":"text"},{"text":" ","type":"text"},{"text":"This allows two or more tied notes to be associated with a per-minute value in a metronome mark, whereas the","type":"text"},{"text":" ","type":"text"},{"text":"metronome-tied element is restricted to metric relationship marks.","type":"text"}],"title":"MXLMetronome.BeatUnitTied","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"text":"BeatUnitTied","kind":"identifier"}],"navigatorTitle":[{"text":"BeatUnitTied","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlmetronome\/beatunittied","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/BeatUnitTied"},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"}}}