{"abstract":[{"text":"The beat-unit element indicates the graphical note type to use in a metronome mark.","type":"text"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/BeatUnitTied\/beatUnit"},"variants":[{"paths":["\/documentation\/ivormxl\/mxlmetronome\/beatunittied\/beatunit"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/BeatUnitTied"]]},"metadata":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"beatUnit","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLNoteKindValue","preciseIdentifier":"s:7IvorMXL16MXLNoteKindValueO","kind":"typeIdentifier"}],"modules":[{"name":"IvorMXL"}],"title":"beatUnit","roleHeading":"Instance Property","symbolKind":"property","externalID":"s:7IvorMXL12MXLMetronomeV12BeatUnitTiedV04beatE0AA16MXLNoteKindValueOvp","role":"symbol"},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"beatUnit","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLNoteKindValue","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNoteKindValue","preciseIdentifier":"s:7IvorMXL16MXLNoteKindValueO","kind":"typeIdentifier"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"inlineContent":[{"text":"Maps to a nested MusicXML ","type":"text"},{"type":"codeVoice","code":"<beat-unit>"},{"text":" element.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","references":{"doc://IvorMXL/documentation/IvorMXL/MXLNoteKindValue":{"kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNoteKindValue","kind":"identifier"}],"title":"MXLNoteKindValue","navigatorTitle":[{"text":"MXLNoteKindValue","kind":"identifier"}],"abstract":[{"type":"text","text":"The note-type-value type is used for the MusicXML type element and represents the graphic note type, from"},{"type":"text","text":" "},{"type":"text","text":"1024th (shortest) to maxima (longest)."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNoteKindValue","url":"\/documentation\/ivormxl\/mxlnotekindvalue","type":"topic","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome/BeatUnitTied":{"abstract":[{"type":"text","text":"The beat-unit-tied type indicates a beat-unit within a metronome mark that is tied to the preceding beat-unit."},{"type":"text","text":" "},{"type":"text","text":"This allows two or more tied notes to be associated with a per-minute value in a metronome mark, whereas the"},{"type":"text","text":" "},{"type":"text","text":"metronome-tied element is restricted to metric relationship marks."}],"navigatorTitle":[{"text":"BeatUnitTied","kind":"identifier"}],"type":"topic","title":"MXLMetronome.BeatUnitTied","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BeatUnitTied","kind":"identifier"}],"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlmetronome\/beatunittied","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/BeatUnitTied"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome":{"type":"topic","title":"MXLMetronome","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLMetronome"}],"url":"\/documentation\/ivormxl\/mxlmetronome","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"MXLMetronome","kind":"identifier"}],"abstract":[{"text":"The metronome type represents metronome marks and other metric relationships. The beat-unit group and per-","type":"text"},{"text":" ","type":"text"},{"text":"minute element specify regular metronome marks. The metronome-note and metronome-relation elements allow for","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"the specification of metric modulations and other metric relationships, such as swing tempo marks where two"},{"type":"text","text":" "},{"text":"eighths are equated to a quarter note \/ eighth note triplet. Tied notes can be represented in both types of","type":"text"},{"type":"text","text":" "},{"type":"text","text":"metronome marks by using the beat-unit-tied and metronome-tied elements. The parentheses attribute indicates"},{"type":"text","text":" "},{"type":"text","text":"whether or not to put the metronome mark in parentheses; its value is no if not specified. The print-object"},{"type":"text","text":" "},{"type":"text","text":"attribute is set to no in cases where the metronome element represents a relationship or range that is not"},{"type":"text","text":" "},{"type":"text","text":"displayed in the music notation."}]},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome/BeatUnitTied/beatUnit":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/BeatUnitTied\/beatUnit","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"beatUnit"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL16MXLNoteKindValueO","text":"MXLNoteKindValue"}],"url":"\/documentation\/ivormxl\/mxlmetronome\/beatunittied\/beatunit","role":"symbol","type":"topic","abstract":[{"text":"The beat-unit element indicates the graphical note type to use in a metronome mark.","type":"text"}],"kind":"symbol","title":"beatUnit"}}}