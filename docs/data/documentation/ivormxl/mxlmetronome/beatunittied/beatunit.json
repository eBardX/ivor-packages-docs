er","text":"beatUnit"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL16MXLNoteKindValueO","kind":"typeIdentifier","text":"MXLNoteKindValue"}],"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlmetronome\/beatunittied\/beatunit","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/BeatUnitTied\/beatUnit","title":"beatUnit","abstract":[{"type":"text","text":"The beat-unit element indicates the graphical note type to use in a metronome mark."}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome/BeatUnitTied":{"type":"topic","title":"MXLMetronome.BeatUnitTied","url":"\/documentation\/ivormxl\/mxlmetronome\/beatunittied","abstract":[{"text":"The beat-unit-tied type indicates a beat-unit within a metronome mark that is tied to the preceding beat-unit.","type":"text"},{"text":" ","type":"text"},{"text":"This allows two or more tied notes to be associated with a per-minute value in a metronome mark, whereas the","type":"text"},{"text":" ","type":"text"},{"text":"metronome-tied element is restricted to metric relationship marks.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"BeatUnitTied"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/BeatUnitTied","navigatorTitle":[{"kind":"identifier","text":"BeatUnitTied"}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNoteKindValue":{"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlnotekindvalue","abstract":[{"text":"The note-type-value type is used for the MusicXML type element and represents the graphic note type, from","type":"text"},{"text":" ","type":"text"},{"text":"1024th (shortest) to maxima (longest).","type":"text"}],"navigatorTitle":[{"text":"MXLNoteKindValue","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNoteKindValue","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNoteKindValue","title":"MXLNoteKindValue"},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLMetronome","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome","title":"MXLMetronome","kind":"symbol","navigatorTitle":[{"text":"MXLMetronome","kind":"identifier"}],"abstract":[{"type":"text","text":"The metronome type represents metronome marks and other metric relationships. The beat-unit group and per-"},{"text":" ","type":"text"},{"text":"minute element specify regular metronome marks. The metronome-note and metronome-relation elements allow for","type":"text"},{"text":" ","type":"text"},{"text":"the specification of metric modulations and other metric relationships, such as swing tempo marks where two","type":"text"},{"type":"text","text":" "},{"type":"text","text":"eighths are equated to a quarter note \/ eighth note triplet. Tied notes can be represented in both types of"},{"text":" ","type":"text"},{"text":"metronome marks by using the beat-unit-tied and metronome-tied elements. The parentheses attribute indicates","type":"text"},{"text":" ","type":"text"},{"text":"whether or not to put the metronome mark in parentheses; its value is no if not specified. The print-object","type":"text"},{"text":" ","type":"text"},{"text":"attribute is set to no in cases where the metronome element represents a relationship or range that is not","type":"text"},{"text":" ","type":"text"},{"text":"displayed in the music notation.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlmetronome"}}}