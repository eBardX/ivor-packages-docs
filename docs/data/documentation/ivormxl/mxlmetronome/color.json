{"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"The color attribute group indicates the color of an element.","type":"text"}],"metadata":{"symbolKind":"property","externalID":"s:7IvorMXL12MXLMetronomeV5colorAA8MXLColorVSgvp","title":"color","modules":[{"name":"IvorMXL"}],"role":"symbol","roleHeading":"Instance Property","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"color","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLColor","preciseIdentifier":"s:7IvorMXL8MXLColorV","kind":"typeIdentifier"},{"text":"?","kind":"text"}]},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome"]]},"variants":[{"paths":["\/documentation\/ivormxl\/mxlmetronome\/color"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/color","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"color","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLColor","preciseIdentifier":"s:7IvorMXL8MXLColorV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"}],"sections":[],"references":{"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome/color":{"kind":"symbol","url":"\/documentation\/ivormxl\/mxlmetronome\/color","title":"color","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/color","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"color","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL8MXLColorV","text":"MXLColor","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"abstract":[{"text":"The color attribute group indicates the color of an element.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome":{"type":"topic","title":"MXLMetronome","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLMetronome"}],"url":"\/documentation\/ivormxl\/mxlmetronome","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"MXLMetronome","kind":"identifier"}],"abstract":[{"text":"The metronome type represents metronome marks and other metric relationships. The beat-unit group and per-","type":"text"},{"text":" ","type":"text"},{"text":"minute element specify regular metronome marks. The metronome-note and metronome-relation elements allow for","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"the specification of metric modulations and other metric relationships, such as swing tempo marks where two"},{"type":"text","text":" "},{"text":"eighths are equated to a quarter note \/ eighth note triplet. Tied notes can be represented in both types of","type":"text"},{"type":"text","text":" "},{"type":"text","text":"metronome marks by using the beat-unit-tied and metronome-tied elements. The parentheses attribute indicates"},{"type":"text","text":" "},{"type":"text","text":"whether or not to put the metronome mark in parentheses; its value is no if not specified. The print-object"},{"type":"text","text":" "},{"type":"text","text":"attribute is set to no in cases where the metronome element represents a relationship or range that is not"},{"type":"text","text":" "},{"type":"text","text":"displayed in the music notation."}]},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlcolor","title":"MXLColor","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"type":"text","text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is"},{"type":"text","text":" "},{"type":"text","text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor"}}}