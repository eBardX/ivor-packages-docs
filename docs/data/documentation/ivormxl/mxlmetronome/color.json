{"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"color"},{"kind":"text","text":": "},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","kind":"typeIdentifier","text":"MXLColor","preciseIdentifier":"s:7IvorMXL8MXLColorV"},{"kind":"text","text":"?"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"}],"metadata":{"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"color"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLColor","preciseIdentifier":"s:7IvorMXL8MXLColorV"},{"kind":"text","text":"?"}],"roleHeading":"Instance Property","externalID":"s:7IvorMXL12MXLMetronomeV5colorAA8MXLColorVSgvp","role":"symbol","title":"color","symbolKind":"property","modules":[{"name":"IvorMXL"}]},"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/color","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome"]]},"kind":"symbol","abstract":[{"type":"text","text":"The color attribute group indicates the color of an element."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlmetronome\/color"]}],"references":{"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLMetronome"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLMetronome"}],"url":"\/documentation\/ivormxl\/mxlmetronome","abstract":[{"text":"The metronome type represents metronome marks and other metric relationships. The beat-unit group and per-","type":"text"},{"text":" ","type":"text"},{"text":"minute element specify regular metronome marks. The metronome-note and metronome-relation elements allow for","type":"text"},{"text":" ","type":"text"},{"text":"the specification of metric modulations and other metric relationships, such as swing tempo marks where two","type":"text"},{"text":" ","type":"text"},{"text":"eighths are equated to a quarter note \/ eighth note triplet. Tied notes can be represented in both types of","type":"text"},{"text":" ","type":"text"},{"text":"metronome marks by using the beat-unit-tied and metronome-tied elements. The parentheses attribute indicates","type":"text"},{"text":" ","type":"text"},{"text":"whether or not to put the metronome mark in parentheses; its value is no if not specified. The print-object","type":"text"},{"text":" ","type":"text"},{"text":"attribute is set to no in cases where the metronome element represents a relationship or range that is not","type":"text"},{"text":" ","type":"text"},{"text":"displayed in the music notation.","type":"text"}],"title":"MXLMetronome","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"title":"MXLColor","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"abstract":[{"text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in","type":"text"},{"text":" ","type":"text"},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"url":"\/documentation\/ivormxl\/mxlcolor"},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome/color":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"color","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLColor","preciseIdentifier":"s:7IvorMXL8MXLColorV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/color","kind":"symbol","role":"symbol","title":"color","abstract":[{"type":"text","text":"The color attribute group indicates the color of an element."}],"url":"\/documentation\/ivormxl\/mxlmetronome\/color"}}}