xt"},{"text":"attribute is set to no in cases where the metronome element represents a relationship or range that is not","type":"text"},{"text":" ","type":"text"},{"text":"displayed in the music notation.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlmetronome"},"doc://IvorMXL/documentation/IvorMXL/MXLBeatUnit":{"type":"topic","navigatorTitle":[{"text":"MXLBeatUnit","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlbeatunit","role":"symbol","abstract":[{"text":"The beat-unit group combines elements used repeatedly in the metronome element to specify a note within a","type":"text"},{"text":" ","type":"text"},{"text":"metronome mark.","type":"text"}],"kind":"symbol","title":"MXLBeatUnit","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBeatUnit","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLBeatUnit","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome/BeatUnitTied":{"type":"topic","title":"MXLMetronome.BeatUnitTied","url":"\/documentation\/ivormxl\/mxlmetronome\/beatunittied","abstract":[{"text":"The beat-unit-tied type indicates a beat-unit within a metronome mark that is tied to the preceding beat-unit.","type":"text"},{"text":" ","type":"text"},{"text":"This allows two or more tied notes to be associated with a per-minute value in a metronome mark, whereas the","type":"text"},{"text":" ","type":"text"},{"text":"metronome-tied element is restricted to metric relationship marks.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"BeatUnitTied"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/BeatUnitTied","navigatorTitle":[{"kind":"identifier","text":"BeatUnitTied"}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome/Content-swift.enum":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier",