ionships, such as swing tempo marks where two"},{"type":"text","text":" "},{"text":"eighths are equated to a quarter note \/ eighth note triplet. Tied notes can be represented in both types of","type":"text"},{"type":"text","text":" "},{"type":"text","text":"metronome marks by using the beat-unit-tied and metronome-tied elements. The parentheses attribute indicates"},{"type":"text","text":" "},{"type":"text","text":"whether or not to put the metronome mark in parentheses; its value is no if not specified. The print-object"},{"type":"text","text":" "},{"type":"text","text":"attribute is set to no in cases where the metronome element represents a relationship or range that is not"},{"type":"text","text":" "},{"type":"text","text":"displayed in the music notation."}]},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome/Content-swift.enum/BeatUnitContent":{"url":"\/documentation\/ivormxl\/mxlmetronome\/content-swift.enum\/beatunitcontent","navigatorTitle":[{"text":"BeatUnitContent","kind":"identifier"}],"type":"topic","title":"MXLMetronome.Content.BeatUnitContent","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/Content-swift.enum\/BeatUnitContent","role":"symbol","abstract":[{"text":"One of the alternatives for Content.","type":"text"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BeatUnitContent","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLPerMinute":{"type":"topic","title":"MXLPerMinute","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPerMinute","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlperminute","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPerMinute","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"MXLPerMinute","kind":"identifier"}],"abstract":[{"type":"text","text":"The per-minute type can be a number, or a text description including numbers. If a font is specified, it"},{"text":" ","type":"text"},{"text":"overrides the font specified for the overall metronome element. This allows separate specification of a music","type":"text"},{"text":" ","type":"text"},{"text":"font for the beat-unit and a text font for the numeric value, in cases where a single metronome font is not","type":"text"},{"text":" ","type":"text"},{"text":"used.","type":"text"}]}}}