{"kind":"symbol","abstract":[{"type":"text","text":"One of the alternatives for Metronome."}],"variants":[{"paths":["\/documentation\/ivormxl\/mxlmetronome\/content-swift.property"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"content"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/Content-swift.enum","preciseIdentifier":"s:7IvorMXL12MXLMetronomeV7ContentO","text":"Content"}],"platforms":["macOS"]}],"kind":"declarations"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/content-swift.property","interfaceLanguage":"swift"},"sections":[],"metadata":{"roleHeading":"Instance Property","externalID":"s:7IvorMXL12MXLMetronomeV7contentAC7ContentOvp","title":"content","modules":[{"name":"IvorMXL"}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"content"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL12MXLMetronomeV7ContentO","text":"Content"}],"symbolKind":"property","role":"symbol"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome"]]},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLMetronome/content-swift.property":{"role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"content","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Content","preciseIdentifier":"s:7IvorMXL12MXLMetronomeV7ContentO","kind":"typeIdentifier"}],"type":"topic","title":"content","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome\/content-swift.property","url":"\/documentation\/ivormxl\/mxlmetronome\/content-swift.property","abstract":[{"type":"text","text":"One of the alternatives for Metronome."}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome":{"type":"topic","abstract":[{"type":"text","text":"The metronome type represents metronome marks and other metric relationships. The beat-unit group and per-"},{"type":"text","text":" "},{"type":"text","text":"minute element specify regular metronome marks. The metronome-note and metronome-relation elements allow for"},{"type":"text","text":" "},{"type":"text","text":"the specification of metric modulations and other metric relationships, such as swing tempo marks where two"},{"type":"text","text":" "},{"type":"text","text":"eighths are equated to a quarter note \/ eighth note triplet. Tied notes can be represented in both types of"},{"type":"text","text":" "},{"type":"text","text":"metronome marks by using the beat-unit-tied and metronome-tied elements. The parentheses attribute indicates"},{"type":"text","text":" "},{"type":"text","text":"whether or not to put the metronome mark in parentheses; its value is no if not specified. The print-object"},{"type":"text","text":" "},{"type":"text","text":"attribute is set to no in cases where the metronome element represents a relationship or range that is not"},{"type":"text","text":" "},{"type":"text","text":"displayed in the music notation."}],"url":"\/documentation\/ivormxl\/mxlmetronome","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLMetronome"}],"kind":"symbol","title":"MXLMetronome","navigatorTitle":[{"kind":"identifier","text":"MXLMetronome"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome/Content-swift.enum":{"type":"topic","abstract":[{"type":"text","text":"One of the alternatives for Metronome."}],"url":"\/documentation\/ivormxl\/mxlmetronome\/content-swift.enum","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"