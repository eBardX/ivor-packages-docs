7ContentO","kind":"typeIdentifier"}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLMetronome":{"type":"topic","title":"MXLMetronome","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLMetronome"}],"url":"\/documentation\/ivormxl\/mxlmetronome","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMetronome","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"MXLMetronome","kind":"identifier"}],"abstract":[{"text":"The metronome type represents metronome marks and other metric relationships. The beat-unit group and per-","type":"text"},{"text":" ","type":"text"},{"text":"minute element specify regular metronome marks. The metronome-note and metronome-relation elements allow for","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"the specification of metric modulations and other metric relationships, such as swing tempo marks where two"},{"type":"text","text":" "},{"text":"eighths are equated to a quarter note \/ eighth note triplet. Tied notes can be represented in both types of","type":"text"},{"type":"text","text":" "},{"type":"text","text":"metronome marks by using the beat-unit-tied and metronome-tied elements. The parentheses attribute indicates"},{"type":"text","text":" "},{"type":"text","text":"whether or not to put the metronome mark in parentheses; its value is no if not specified. The print-object"},{"type":"text","text":" "},{"type":"text","text":"attribute is set to no in cases where the metronome element represents a relationship or range that is not"},{"type":"text","text":" "},{"type":"text","text":"displayed in the music notation."}]},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXL