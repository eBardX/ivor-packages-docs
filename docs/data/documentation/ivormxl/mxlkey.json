c"},"doc://IvorMXL/documentation/IvorMXL/MXLKey/font":{"abstract":[{"text":"The font attribute group gathers together attributes for determining the font within a credit or direction.","type":"text"},{"text":" ","type":"text"},{"text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of","type":"text"},{"text":" ","type":"text"},{"text":"font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric","type":"text"},{"text":" ","type":"text"},{"text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font","type":"text"},{"text":" ","type":"text"},{"text":"vs. a music font.","type":"text"}],"role":"symbol","url":"\/documentation\/ivormxl\/mxlkey\/font","kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"font","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL7MXLFontV","text":"MXLFont","kind":"typeIdentifier"}],"title":"font","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLKey\/font","type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLKey/position":{"type":"topic","url":"\/documentation\/ivormxl\/mxlkey\/position","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLKey\/position","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"For most elements, any program will compute a default x and y position. The position attributes let this be"},{"type":"text","text":" "},{"type":"text","text":"changed two ways."}],"title":"position","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"position","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL11MXLPositionV","text":"MXLPosition","kind":"typeIdentifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLKey/octave-swift.property":{"type":"topic","url":"\/documentation\/ivormxl\/mxlkey\/octave-swift.property","ident