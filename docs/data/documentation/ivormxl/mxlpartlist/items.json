"text"},{"text":"MXLPartList","kind":"identifier"}],"abstract":[{"text":"The part-list identifies the different musical parts in this document. Each part has an ID that is used later","type":"text"},{"text":" ","type":"text"},{"text":"within the musical data. Since parts may be encoded separately and combined later, identification elements are","type":"text"},{"text":" ","type":"text"},{"text":"present at both the score and score-part levels. There must be at least one score-part, combined as desired","type":"text"},{"text":" ","type":"text"},{"text":"with part-group elements that indicate braces and brackets. Parts are ordered from top to bottom in a score","type":"text"},{"text":" ","type":"text"},{"text":"based on the order in which they appear in the part-list.","type":"text"}],"kind":"symbol","type":"topic","navigatorTitle":[{"text":"MXLPartList","kind":"identifier"}],"title":"MXLPartList"},"doc://IvorMXL/documentation/IvorMXL/MXLPartList/items":{"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartList\/items","title":"items","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"items"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:7IvorMXL11MXLPartListV4ItemO","kind":"typeIdentifier","text":"Item"},{"kind":"text","text":"]"}],"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlpartlist\/items","abstract":[{"text":"The ordered sequence of part-group and score-part elements making up this part-list.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLPartList/Item":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlpartlist\/item","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartList\/Item","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Item","kind":"identifier"}],"abstract":[{"text":"One of the alternatives for PartList.","type":"text"}],"kind":"symbol","type":"topic","navigatorTitle":[{"text":"Item","kind":"iden