on\/ivormxl\/mxlpartlist","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartList","role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLPartList"}],"abstract":[{"type":"text","text":"The part-list identifies the different musical parts in this document. Each part has an ID that is used later"},{"type":"text","text":" "},{"type":"text","text":"within the musical data. Since parts may be encoded separately and combined later, identification elements are"},{"type":"text","text":" "},{"type":"text","text":"present at both the score and score-part levels. There must be at least one score-part, combined as desired"},{"type":"text","text":" "},{"type":"text","text":"with part-group elements that indicate braces and brackets. Parts are ordered from top to bottom in a score"},{"type":"text","text":" "},{"type":"text","text":"based on the order in which they appear in the part-list."}]}}}