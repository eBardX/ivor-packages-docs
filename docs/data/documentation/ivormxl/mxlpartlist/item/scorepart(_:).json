{"abstract":[{"type":"text","text":"The score-part element is defined within a group due to its multiple uses within the part-list element."}],"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartList","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartList\/Item"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartList\/Item\/scorePart(_:)"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"scorePart"},{"kind":"text","text":"("},{"preciseIdentifier":"s:7IvorMXL12MXLScorePartV","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePart","text":"MXLScorePart"},{"kind":"text","text":")"}]}]}],"metadata":{"modules":[{"name":"IvorMXL"}],"symbolKind":"case","roleHeading":"Case","role":"symbol","title":"MXLPartList.Item.scorePart(_:)","externalID":"s:7IvorMXL11MXLPartListV4ItemO9scorePartyAeA08MXLScoreG0VcAEmF","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"scorePart"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"MXLScorePart","preciseIdentifier":"s:7IvorMXL12MXLScorePartV"},{"kind":"text","text":")"}]},"sections":[],"variants":[{"paths":["\/documentation\/ivormxl\/mxlpartlist\/item\/scorepart(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLPartList":{"type":"topic","title":"MXLPartList","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartList","abstract":[{"text":"The part-list identifies the different musical parts in this document. Each part has an ID that is used later","type":"text"},{"text":" ","type":"text"},{"text":"within the musical data. Since parts may be encoded separately and combined later, identification elements are","type":"text"},{"text":" ","type":"text"},{"text":"present at both the score and score-part levels. There must be at least one score-part, combined as desired","type":"text"},{"text":" ","type":"text"},{"text":"with part-group elements that indicate braces and brackets. Parts are ordered from top to bottom in a score","type":"text"},{"text":" ","type":"text"},{"text":"based on the order in which they appear in the part-list.","type":"text"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPartList"}],"navigatorTitle":[{"kind":"identifier","text":"MXLPartList"}],"url":"\/documentation\/ivormxl\/mxlpartlist"},"doc://IvorMXL/documentation/IvorMXL/MXLPartList/Item":{"type":"topic","title":"MXLPartList.Item","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartList\/Item","abstract":[{"text":"One of the alternatives for PartList.","type":"text"}],"role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"Item"}],"navigatorTitle":[{"kind":"identifier","text":"Item"}],"url":"\/documentation\/ivormxl\/mxlpartlist\/item"},"doc://IvorMXL/documentation/IvorMXL/MXLScorePart":{"type":"topic","title":"MXLScorePart","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLScorePart","abstract":[{"text":"The score-part type collects part-wide information for each part in a score. Often, each MusicXML part","type":"text"},{"text":" ","type":"text"},{"text":"corresponds to a track in a Standard MIDI Format 1 file. In this case, the midi-device element is used to make","type":"text"},{"text":" ","type":"text"},{"text":"a MIDI device or port assignment for the given track or specific MIDI instruments. Initial midi-instrument","type":"text"},{"text":" ","type":"text"},{"text":"assignments may be made here as well. The score-instrument elements are used when there are multiple","type":"text"},{"text":" ","type":"text"},{"text":"instruments per track.","type":"text"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLScorePart"}],"navigatorTitle":[{"kind":"identifier","text":"MXLScorePart"}],"url":"\/documentation\/ivormxl\/mxlscorepart"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLPartList/Item/scorePart(_:)":{"abstract":[{"type":"text","text":"The score-part element is defined within a group due to its multiple uses within the part-list element."}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartList\/Item\/scorePart(_:)","url":"\/documentation\/ivormxl\/mxlpartlist\/item\/scorepart(_:)","role":"symbol","title":"MXLPartList.Item.scorePart(_:)","type":"topic","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"scorePart"},{"kind":"text","text":"("},{"preciseIdentifier":"s:7IvorMXL12MXLScorePartV","kind":"typeIdentifier","text":"MXLScorePart"},{"kind":"text","text":")"}]}}}