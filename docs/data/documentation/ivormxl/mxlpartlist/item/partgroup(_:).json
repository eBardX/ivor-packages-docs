{"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartList","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartList\/Item"]]},"abstract":[{"type":"text","text":"The part-group element is defined within a group due to its multiple uses within the part-list element."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlpartlist\/item\/partgroup(_:)"]}],"sections":[],"kind":"symbol","metadata":{"roleHeading":"Case","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"partGroup","kind":"identifier"},{"text":"(","kind":"text"},{"text":"MXLPartGroup","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL12MXLPartGroupV"},{"text":")","kind":"text"}],"modules":[{"name":"IvorMXL"}],"symbolKind":"case","title":"MXLPartList.Item.partGroup(_:)","role":"symbol","externalID":"s:7IvorMXL11MXLPartListV4ItemO9partGroupyAeA0cG0VcAEmF"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"partGroup","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:7IvorMXL12MXLPartGroupV","text":"MXLPartGroup","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartGroup","kind":"typeIdentifier"},{"kind":"text","text":")"}]}],"kind":"declarations"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartList\/Item\/partGroup(_:)"},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLPartList/Item/partGroup(_:)":{"abstract":[{"type":"text","text":"The part-group element is defined within a group due to its multiple uses within the part-list element."}],"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"partGroup","kind":"identifier"},{"text":"(","kind":"text"},{"text":"MXLPartGroup","preciseIdentifier":"s:7IvorMXL12MXLPartGroupV","kind":"typeIdentifier"},{"text":")","kind":"text"}],"title":"MXLPartList.Item.partGroup(_:)","role":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxlpartlist\/item\/partgroup(_:)","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartList\/Item\/partGroup(_:)"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLPartList/Item":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartList\/Item","abstract":[{"type":"text","text":"One of the alternatives for PartList."}],"title":"MXLPartList.Item","navigatorTitle":[{"text":"Item","kind":"identifier"}],"kind":"symbol","type":"topic","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Item","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlpartlist\/item"},"doc://IvorMXL/documentation/IvorMXL/MXLPartGroup":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartGroup","url":"\/documentation\/ivormxl\/mxlpartgroup","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPartGroup","kind":"identifier"}],"abstract":[{"type":"text","text":"The part-group element indicates groupings of parts in the score, usually indicated by braces and brackets."},{"type":"text","text":" "},{"type":"text","text":"Braces that are used for multi-staff parts should be defined in the attributes element for that part. The"},{"type":"text","text":" "},{"type":"text","text":"part-group start element appears before the first score-part in the group. The part-group stop element appears"},{"type":"text","text":" "},{"type":"text","text":"after the last score-part in the group."}],"navigatorTitle":[{"text":"MXLPartGroup","kind":"identifier"}],"title":"MXLPartGroup","type":"topic","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLPartList":{"type":"topic","title":"MXLPartList","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPartList"}],"url":"\/documentation\/ivormxl\/mxlpartlist","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartList","role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLPartList"}],"abstract":[{"type":"text","text":"The part-list identifies the different musical parts in this document. Each part has an ID that is used later"},{"type":"text","text":" "},{"type":"text","text":"within the musical data. Since parts may be encoded separately and combined later, identification elements are"},{"type":"text","text":" "},{"type":"text","text":"present at both the score and score-part levels. There must be at least one score-part, combined as desired"},{"type":"text","text":" "},{"type":"text","text":"with part-group elements that indicate braces and brackets. Parts are ordered from top to bottom in a score"},{"type":"text","text":" "},{"type":"text","text":"based on the order in which they appear in the part-list."}]}}}