ind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"The part-list identifies the different musical parts in this document. Each part has an ID that is used later"},{"type":"text","text":" "},{"type":"text","text":"within the musical data. Since parts may be encoded separately and combined later, identification elements are"},{"type":"text","text":" "},{"type":"text","text":"present at both the score and score-part levels. There must be at least one score-part, combined as desired"},{"type":"text","text":" "},{"type":"text","text":"with part-group elements that indicate braces and brackets. Parts are ordered from top to bottom in a score"},{"type":"text","text":" "},{"type":"text","text":"based on the order in which they appear in the part-list."}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPartList","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartList","url":"\/documentation\/ivormxl\/mxlpartlist"},"doc://IvorMXL/documentation/IvorMXL/MXLPartList/Item/partGroup(_:)":{"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"partGroup","kind":"identifier"},{"text":"(","kind":"text"},{"text":"MXLPartGroup","preciseIdentifier":"s:7IvorMXL12MXLPartGroupV","kind":"typeIdentifier"},{"text":")","kind":"text"}],"title":"MXLPartList.Item.partGroup(_:)","kind":"symbol","url":"\/documentation\/ivormxl\/mxlpartlist\/item\/partgroup(_:)","abstract":[{"type":"text","text":"The part-group element is defined within a group due to its multiple uses within the part-list element."}],"type":"topic","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartList\/Item\/partGroup(_:)"},"doc://IvorMXL/documentation/IvorMXL/MXLPartList/Item":{"title":"MXLPartList.Item","url":"\/documentation\/ivormxl\/mxlpartlist\/item","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartList\/Item","type":"topic","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Item"}],"navigatorTitle":[{"kind":"identifier","text":"Item"}],"role":"symbol","abstract":[{"text":"One of the alternatives for PartList.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLPartGroup":{"type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The part-group element indicates groupings of parts in the score, usually indicated by braces and brackets."},{"type":"text","text":" "},{"type":"text","text":"Braces that are used for multi-staff parts should be defined in the attributes element for that part. The"},{"type":"text","text":" "},{"type":"text","text":"part-group start element appears before the first score-part in the group. The part-group stop element appears"},{"type":"text","text":" "},{"type":"text","text":"after the last score-part in the group."}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLPartGroup"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartGroup","url":"\/documentation\/ivormxl\/mxlpartgroup","title":"MXLPartGroup","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPartGroup"}]}}}