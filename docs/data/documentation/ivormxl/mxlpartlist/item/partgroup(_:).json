[{"kind":"identifier","text":"Item"}],"url":"\/documentation\/ivormxl\/mxlpartlist\/item"},"doc://IvorMXL/documentation/IvorMXL/MXLPartList/Item/partGroup(_:)":{"title":"MXLPartList.Item.partGroup(_:)","role":"symbol","url":"\/documentation\/ivormxl\/mxlpartlist\/item\/partgroup(_:)","abstract":[{"text":"The part-group element is defined within a group due to its multiple uses within the part-list element.","type":"text"}],"type":"topic","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"partGroup","kind":"identifier"},{"text":"(","kind":"text"},{"text":"MXLPartGroup","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL12MXLPartGroupV"},{"text":")","kind":"text"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartList\/Item\/partGroup(_:)"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLPartList":{"type":"topic","title":"MXLPartList","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartList","abstract":[{"text":"The part-list identifies the different musical parts in this document. Each part has an ID that is used later","type":"text"},{"text":" ","type":"text"},{"text":"within the musical data. Since parts may be encoded separately and combined later, identification elements are","type":"text"},{"text":" ","type":"text"},{"text":"present at both the score and score-part levels. There must be at least one score-part, combined as desired","type":"text"},{"text":" ","type":"text"},{"text":"with part-group elements that indicate braces and brackets. Parts are ordered from top to bottom in a score","type":"text"},{"text":" ","type":"text"},{"text":"based on the order in which they appear in the part-list.","type":"text"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPartList"}],"navigatorTitle":[{"kind":"identifier","text":"MXLPartList"}],"url":"\/documentation\/ivormxl\/mxlpartlist"},"doc://IvorMXL/documentation/IvorMXL/MXLPartGroup":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPartGroup","navigatorTitle":[{"kind":"identifier","text":"MXLPartGroup"}],"url":"\/documentation\/ivormxl\/mxlpartgroup","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPartGroup"}],"title":"MXLPartGroup","abstract":[{"type":"text","text":"The part-group element indicates groupings of parts in the score, usually indicated by braces and brackets."},{"type":"text","text":" "},{"type":"text","text":"Braces that are used for multi-staff parts should be defined in the attributes element for that part. The"},{"type":"text","text":" "},{"type":"text","text":"part-group start element appears before the first score-part in the group. The part-group stop element appears"},{"type":"text","text":" "},{"type":"text","text":"after the last score-part in the group."}],"type":"topic"}}}