{"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"modules":[{"name":"IvorMXL"}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"staffSize","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLStaffSize","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL12MXLStaffSizeV"},{"text":"?","kind":"text"}],"roleHeading":"Instance Property","symbolKind":"property","role":"symbol","title":"staffSize","externalID":"s:7IvorMXL15MXLStaffDetailsV9staffSizeAA0cF0VSgvp"},"variants":[{"paths":["\/documentation\/ivormxl\/mxlstaffdetails\/staffsize"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails\/staffSize"},"abstract":[{"text":"How large a staff space is on this staff.","type":"text"}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"staffSize","kind":"identifier"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffSize","text":"MXLStaffSize","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL12MXLStaffSizeV"},{"text":"?","kind":"text"}]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Maps to a nested MusicXML "},{"code":"<staff-size>","type":"codeVoice"},{"text":" element.","type":"text"}]}]}],"sections":[],"kind":"symbol","references":{"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLStaffDetails":{"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLStaffDetails","kind":"identifier"}],"title":"MXLStaffDetails","navigatorTitle":[{"text":"MXLStaffDetails","kind":"identifier"}],"abstract":[{"type":"text","text":"The staff-details element is used to indicate different types of staves. The optional number attribute"},{"type":"text","text":" "},{"type":"text","text":"specifies the staff number from top to bottom on the system, as with clef. The print-object attribute is used"},{"type":"text","text":" "},{"type":"text","text":"to indicate when a staff is not printed in a part, usually in large scores where empty parts are omitted. It"},{"type":"text","text":" "},{"type":"text","text":"is yes by default. If print-spacing is yes while print-object is no, the score is printed in cutaway format"},{"type":"text","text":" "},{"type":"text","text":"where vertical space is left for the empty part."}],"url":"\/documentation\/ivormxl\/mxlstaffdetails","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLStaffSize":{"url":"\/documentation\/ivormxl\/mxlstaffsize","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLStaffSize"}],"title":"MXLStaffSize","abstract":[{"type":"text","text":"The staff-size element indicates how large a staff space is on this staff, expressed as a percentage of the"},{"type":"text","text":" "},{"type":"text","text":"work’s default scaling. Values less than 100 make the staff space smaller while values over 100 make the staff"},{"type":"text","text":" "},{"type":"text","text":"space larger. A staff-type of cue, ossia, or editorial implies a staff-size of less than 100, but the exact"},{"type":"text","text":" "},{"type":"text","text":"value is implementation-dependent unless specified here. Staff size affects staff height only, not the"},{"type":"text","text":" "},{"type":"text","text":"relationship of the staff to the left and right margins."}],"navigatorTitle":[{"kind":"identifier","text":"MXLStaffSize"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffSize"},"doc://IvorMXL/documentation/IvorMXL/MXLStaffDetails/staffSize":{"url":"\/documentation\/ivormxl\/mxlstaffdetails\/staffsize","abstract":[{"text":"How large a staff space is on this staff.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails\/staffSize","title":"staffSize","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"staffSize"},{"kind":"text","text":": "},{"text":"MXLStaffSize","preciseIdentifier":"s:7IvorMXL12MXLStaffSizeV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"role":"symbol"}}}