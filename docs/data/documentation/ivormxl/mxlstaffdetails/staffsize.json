"kind":"symbol","navigatorTitle":[{"text":"MXLStaffDetails","kind":"identifier"}],"abstract":[{"text":"The staff-details element is used to indicate different types of staves. The optional number attribute","type":"text"},{"text":" ","type":"text"},{"text":"specifies the staff number from top to bottom on the system, as with clef. The print-object attribute is used","type":"text"},{"text":" ","type":"text"},{"text":"to indicate when a staff is not printed in a part, usually in large scores where empty parts are omitted. It","type":"text"},{"text":" ","type":"text"},{"text":"is yes by default. If print-spacing is yes while print-object is no, the score is printed in cutaway format","type":"text"},{"text":" ","type":"text"},{"text":"where vertical space is left for the empty part.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlstaffdetails"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLStaffSize":{"role":"symbol","kind":"symbol","url":"\/documentation\/ivormxl\/mxlstaffsize","abstract":[{"text":"The staff-size element indicates how large a staff space is on this staff, expressed as a percentage of the","type":"text"},{"text":" ","type":"text"},{"text":"work’s default scaling. Values less than 100 make the staff space smaller while values over 100 make the staff","type":"text"},{"text":" ","type":"text"},{"text":"space larger. A staff-type of cue, ossia, or editorial implies a staff-size of less than 100, but the exact","type":"text"},{"text":" ","type":"text"},{"text":"value is implementation-dependent unless specified here. Staff size affects staff height only, not the","type":"text"},{"text":" ","type":"text"},{"text":"relationship of the staff to the left and right margins.","type":"text"}],"title":"MXLStaffSize","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLStaffSize"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffSize","navigatorTitle":[{"kind":"identifier","text":"MXLStaffSize"}]},"doc://IvorMXL/documentation/IvorMXL/MXLStaffDetails/staffSize":{"abstract":[{"type":"text","text":"How large a staff space is on this staff."}],"type":"topic","title":"staffSize","kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"staffSize","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLStaffSize","preciseIdentifier":"s:7IvorMXL12MXLStaffSizeV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails\/staffSize","url":"\/documentation\/ivormxl\/mxlstaffdetails\/staffsize","role":"symbol"}}}