{"abstract":[{"text":"The capo element indicates at which fret a capo should be placed on a fretted instrument. This changes the","type":"text"},{"text":" ","type":"text"},{"text":"open tuning of the strings specified by staff-tuning by the specified number of half-steps.","type":"text"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails"]]},"metadata":{"modules":[{"name":"IvorMXL"}],"symbolKind":"property","externalID":"s:7IvorMXL15MXLStaffDetailsV4capoSiSgvp","role":"symbol","title":"capo","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"capo","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"roleHeading":"Instance Property"},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails\/capo"},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"capo","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Maps to a nested MusicXML "},{"type":"codeVoice","code":"<capo>"},{"type":"text","text":" element."}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","variants":[{"paths":["\/documentation\/ivormxl\/mxlstaffdetails\/capo"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLStaffDetails":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLStaffDetails","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails","title":"MXLStaffDetails","kind":"symbol","navigatorTitle":[{"text":"MXLStaffDetails","kind":"identifier"}],"abstract":[{"text":"The staff-details element is used to indicate different types of staves. The optional number attribute","type":"text"},{"text":" ","type":"text"},{"text":"specifies the staff number from top to bottom on the system, as with clef. The print-object attribute is used","type":"text"},{"text":" ","type":"text"},{"text":"to indicate when a staff is not printed in a part, usually in large scores where empty parts are omitted. It","type":"text"},{"text":" ","type":"text"},{"text":"is yes by default. If print-spacing is yes while print-object is no, the score is printed in cutaway format","type":"text"},{"text":" ","type":"text"},{"text":"where vertical space is left for the empty part.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlstaffdetails"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLStaffDetails/capo":{"kind":"symbol","title":"capo","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"capo","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"url":"\/documentation\/ivormxl\/mxlstaffdetails\/capo","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails\/capo","role":"symbol","abstract":[{"text":"The capo element indicates at which fret a capo should be placed on a fretted instrument. This changes the","type":"text"},{"text":" ","type":"text"},{"text":"open tuning of the strings specified by staff-tuning by the specified number of half-steps.","type":"text"}]}}}