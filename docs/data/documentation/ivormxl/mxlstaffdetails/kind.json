tion Cases"},{"anchor":"Default-Implementations","generated":true,"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails\/Kind\/Equatable-Implementations"],"title":"Default Implementations"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"text":"The staff-type value can be ossia, editorial, cue, alternate, or regular. An ossia staff represents music","type":"text"},{"text":" ","type":"text"},{"text":"that can be played instead of what appears on the regular staff. An editorial staff also represents musical","type":"text"},{"text":" ","type":"text"},{"text":"alternatives, but is created by an editor rather than the composer. It can be used for suggested","type":"text"},{"text":" ","type":"text"},{"text":"interpretations or alternatives from other sources. A cue staff represents music from another part. An","type":"text"},{"text":" ","type":"text"},{"text":"alternate staff shares the same music as the prior staff, but displayed differently (e.g., treble and bass","type":"text"},{"text":" ","type":"text"},{"text":"clef, standard notation and tablature). It is not included in playback. An alternate staff provides more","type":"text"},{"text":" ","type":"text"},{"text":"information to an application reading a file than encoding the same music in separate parts, so its use is","type":"text"},{"text":" ","type":"text"},{"text":"preferred in this situation if feasible. A regular staff is the standard default staff-type.","type":"text"}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLStaffDetails/Kind/ossia":{"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ossia","kind":"identifier"}],"title":"MXLStaffDetails.Kind.ossia","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails\/Kind\/ossia","kind":"symbol","url":"\/documentation\/ivormxl\/mxlstaffdetails\/kind\/ossia","type":"topic","abstract":[{"type":"text","text":"A staff representing music that can be played instead of what appears on the regular staff."}]},"doc://IvorMXL/documentation/IvorMXL/MXLStaffDetails/Kind/Equatable-Implementations":{"role":"collectionGroup","url":"\/documentation\/ivormxl\/mxlstaffdetails\/kind\/equatable-implementations","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails\/Kind\/Equatable-Implementations","abstract":[],"kind":"article","type":"topic","title":"Equatable Implementations"},"doc://IvorMXL/s16SendableMetatypeP":{"type":"unresolvable","identifier":"doc:\/\/IvorMXL\/s16SendableMetatypeP","title":"Swift.SendableMetatype"},"doc://IvorMXL/s8CopyableP":{"title":"Swift.Copyable","identifier":"doc:\/\/IvorMXL\/s8CopyableP","type":"unresolvable"},"doc://IvorMXL/documentation/IvorMXL/MXLStaffDetails":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLStaffDetails"}],"navigatorTitle":[{"text":"MXLStaffDetails","kind":"identifier"}],"title":"MXLStaffDetails","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails","kind":"symbol","url":"\/documentation\/ivormxl\/mxlstaffdetails","type":"topic","abstract":[{"type":"text","text":"The staff-details element is used to indicate different types of staves. The optional number attribute"},{"type":"text","text":" "},{"type":"text","text":"specifies the staff number from top to bottom on the system, as with clef. The print-object attribute is used"},{"type":"text","text":" "},{"text":"to indicate when a staff is not printed in a part, usually in large scores where empty parts are omitted. It","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"is yes by default. If print-spacing is yes while print-object is no, the score is printed in cutaway format"},{"type":"text","text":" "},{"type":"text","text":"where vertical space is left for the empty part."}]},"doc://IvorMXL/documentation/IvorMXL/MXLStaffDetails/Kind/editorial":{"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"