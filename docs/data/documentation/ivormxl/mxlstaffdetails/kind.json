{"schemaVersion":{"minor":3,"major":0,"patch":0},"topicSections":[{"title":"Enumeration Cases","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails\/Kind\/alternate","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails\/Kind\/cue","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails\/Kind\/editorial","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails\/Kind\/ossia","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails\/Kind\/regular"],"generated":true,"anchor":"Enumeration-Cases"},{"title":"Default Implementations","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails\/Kind\/Equatable-Implementations"],"generated":true,"anchor":"Default-Implementations"}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails\/Kind","interfaceLanguage":"swift"},"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/IvorMXL\/s8CopyableP","doc:\/\/IvorMXL\/SQ","doc:\/\/IvorMXL\/s9EscapableP","doc:\/\/IvorMXL\/SH","doc:\/\/IvorMXL\/s8SendableP","doc:\/\/IvorMXL\/s16SendableMetatypeP"],"kind":"relationships","type":"conformsTo"}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Kind","kind":"identifier"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Maps the MusicXML ","type":"text"},{"type":"codeVoice","code":"<staff-type>"},{"text":" element.","type":"text"}]}],"kind":"content"}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlstaffdetails\/kind"]}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails"]]},"sections":[],"abstract":[{"type":"text","text":"The staff-type value can be ossia, editorial, cue, alternate, or regular. An ossia staff represents music"},{"type":"text","text":" "},{"type":"text","text":"that can be played instead of what appears on the regular staff. An editorial staff also represents musical"},{"type":"text","text":" "},{"type":"text","text":"alternatives, but is created by an editor rather than the composer. It can be used for suggested"},{"type":"text","text":" "},{"type":"text","text":"interpretations or alternatives from other sources. A cue staff represents music from another part. An"},{"type":"text","text":" "},{"type":"text","text":"alternate staff shares the same music as the prior staff, but displayed differently (e.g., treble and bass"},{"type":"text","text":" "},{"type":"text","text":"clef, standard notation and tablature). It is not included in playback. An alternate staff provides more"},{"type":"text","text":" "},{"type":"text","text":"information to an application reading a file than encoding the same music in separate parts, so its use is"},{"type":"text","text":" "},{"type":"text","text":"preferred in this situation if feasible. A regular staff is the standard default staff-type."}],"metadata":{"symbolKind":"enum","navigatorTitle":[{"kind":"identifier","text":"Kind"}],"externalID":"s:7IvorMXL15MXLStaffDetailsV4KindO","modules":[{"name":"IvorMXL"}],"roleHeading":"Enumeration","extendedModule":"IvorMXL","role":"symbol","title":"MXLStaffDetails.Kind","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Kind"}]},"references":{"doc://IvorMXL/SH":{"title":"Swift.Hashable","identifier":"doc:\/\/IvorMXL\/SH","type":"unresolvable"},"doc://IvorMXL/documentation/IvorMXL/MXLStaffDetails/Kind/editorial":{"type":"topic","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"editorial"}],"url":"\/documentation\/ivormxl\/mxlstaffdetails\/kind\/editorial","title":"MXLStaffDetails.Kind.editorial","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails\/Kind\/editorial","abstract":[{"text":"A staff representing musical alternatives created by an editor rather than the composer.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLStaffDetails/Kind":{"type":"topic","abstract":[{"type":"text","text":"The staff-type value can be ossia, editorial, cue, alternate, or regular. An ossia staff represents music"},{"type":"text","text":" "},{"type":"text","text":"that can be played instead of what appears on the regular staff. An editorial staff also represents musical"},{"type":"text","text":" "},{"type":"text","text":"alternatives, but is created by an editor rather than the composer. It can be used for suggested"},{"type":"text","text":" "},{"type":"text","text":"interpretations or alternatives from other sources. A cue staff represents music from another part. An"},{"type":"text","text":" "},{"type":"text","text":"alternate staff shares the same music as the prior staff, but displayed differently (e.g., treble and bass"},{"type":"text","text":" "},{"type":"text","text":"clef, standard notation and tablature). It is not included in playback. An alternate staff provides more"},{"type":"text","text":" "},{"type":"text","text":"information to an application reading a file than encoding the same music in separate parts, so its use is"},{"type":"text","text":" "},{"type":"text","text":"preferred in this situation if feasible. A regular staff is the standard default staff-type."}],"url":"\/documentation\/ivormxl\/mxlstaffdetails\/kind","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Kind"}],"kind":"symbol","title":"MXLStaffDetails.Kind","navigatorTitle":[{"kind":"identifier","text":"Kind"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails\/Kind","role":"symbol"},"doc://IvorMXL/s9EscapableP":{"title":"Swift.Escapable","identifier":"doc:\/\/IvorMXL\/s9EscapableP","type":"unresolvable"},"doc://IvorMXL/documentation/IvorMXL/MXLStaffDetails":{"type":"topic","abstract":[{"type":"text","text":"The staff-details element is used to indicate different types of staves. The optional number attribute"},{"type":"text","text":" "},{"type":"text","text":"specifies the staff number from top to bottom on the system, as with clef. The print-object attribute is used"},{"type":"text","text":" "},{"type":"text","text":"to indicate when a staff is not printed in a part, usually in large scores where empty parts are omitted. It"},{"type":"text","text":" "},{"type":"text","text":"is yes by default. If print-spacing is yes while print-object is no, the score is printed in cutaway format"},{"type":"text","text":" "},{"type":"text","text":"where vertical space is left for the empty part."}],"url":"\/documentation\/ivormxl\/mxlstaffdetails","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLStaffDetails"}],"kind":"symbol","title":"MXLStaffDetails","navigatorTitle":[{"kind":"identifier","text":"MXLStaffDetails"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails","role":"symbol"},"doc://IvorMXL/SQ":{"title":"Swift.Equatable","identifier":"doc:\/\/IvorMXL\/SQ","type":"unresolvable"},"doc://IvorMXL/documentation/IvorMXL/MXLStaffDetails/Kind/alternate":{"role":"symbol","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"A staff that shares the same music as the prior staff, but displayed differently. It is not included"},{"type":"text","text":" "},{"type":"text","text":"in playback."}],"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"alternate","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails\/Kind\/alternate","title":"MXLStaffDetails.Kind.alternate","url":"\/documentation\/ivormxl\/mxlstaffdetails\/kind\/alternate"},"doc://IvorMXL/documentation/IvorMXL/MXLStaffDetails/Kind/Equatable-Implementations":{"url":"\/documentation\/ivormxl\/mxlstaffdetails\/kind\/equat