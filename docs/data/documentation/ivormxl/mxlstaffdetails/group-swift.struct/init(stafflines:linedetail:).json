{"metadata":{"symbolKind":"init","title":"init(staffLines:lineDetail:)","role":"symbol","roleHeading":"Initializer","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"staffLines","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"lineDetail","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"MXLLineDetail","preciseIdentifier":"s:7IvorMXL13MXLLineDetailV","kind":"typeIdentifier"},{"text":"])","kind":"text"}],"externalID":"s:7IvorMXL15MXLStaffDetailsV5GroupV10staffLines10lineDetailAESi_SayAA07MXLLineI0VGtcfc","modules":[{"name":"IvorMXL"}]},"abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLStaffDetails.Group"},{"type":"text","text":"."}],"kind":"symbol","variants":[{"paths":["\/documentation\/ivormxl\/mxlstaffdetails\/group-swift.struct\/init(stafflines:linedetail:)"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"init","kind":"keyword"},{"text":"(","kind":"text"},{"text":"staffLines","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"lineDetail","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"MXLLineDetail","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLineDetail","preciseIdentifier":"s:7IvorMXL13MXLLineDetailV","kind":"typeIdentifier"},{"text":"] = [])","kind":"text"}],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"staffLines","content":[{"type":"paragraph","inlineContent":[{"text":"The staff-lines element specifies the number of lines and is usually used for a non 5-line staff. If the staff-lines element is present, the appearance of each line may be individually specified with a line-detail element.","type":"text"}]}]},{"name":"lineDetail","content":[{"type":"paragraph","inlineContent":[{"text":"Specifies the appearance of each line individually, when present.","type":"text"}]}]}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails\/Group-swift.struct"]]},"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails\/Group-swift.struct\/init(staffLines:lineDetail:)","interfaceLanguage":"swift"},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLStaffDetails/Group-swift.struct":{"abstract":[{"type":"text","text":"The number of lines on the staff, and per-line appearance details, for non-5-line staves."}],"title":"MXLStaffDetails.Group","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Group"}],"navigatorTitle":[{"kind":"identifier","text":"Group"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlstaffdetails\/group-swift.struct","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails\/Group-swift.struct"},"doc://IvorMXL/documentation/IvorMXL/MXLStaffDetails":{"abstract":[{"text":"The staff-details element is used to indicate different types of staves. The optional number attribute","type":"text"},{"text":" ","type":"text"},{"text":"specifies the staff number from top to bottom on the system, as with clef. The print-object attribute is used","type":"text"},{"text":" ","type":"text"},{"text":"to indicate when a staff is not printed in a part, usually in large scores where empty parts are omitted. It","type":"text"},{"text":" ","type":"text"},{"text":"is yes by default. If print-spacing is yes while print-object is no, the score is printed in cutaway format","type":"text"},{"text":" ","type":"text"},{"text":"where vertical space is left for the empty part.","type":"text"}],"title":"MXLStaffDetails","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLStaffDetails","kind":"identifier"}],"navigatorTitle":[{"text":"MXLStaffDetails","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlstaffdetails","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails"},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLStaffDetails/Group-swift.struct/init(staffLines:lineDetail:)":{"abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLStaffDetails.Group"},{"type":"text","text":"."}],"title":"init(staffLines:lineDetail:)","kind":"symbol","role":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"staffLines"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"lineDetail"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:7IvorMXL13MXLLineDetailV","kind":"typeIdentifier","text":"MXLLineDetail"},{"kind":"text","text":"])"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlstaffdetails\/group-swift.struct\/init(stafflines:linedetail:)","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails\/Group-swift.struct\/init(staffLines:lineDetail:)"},"doc://IvorMXL/documentation/IvorMXL/MXLLineDetail":{"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLLineDetail"}],"title":"MXLLineDetail","url":"\/documentation\/ivormxl\/mxllinedetail","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLLineDetail","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLineDetail","abstract":[{"type":"text","text":"If the staff-lines element is present, the appearance of each line may be individually specified with a line-"},{"type":"text","text":" "},{"type":"text","text":"detail type. Staff lines are numbered from bottom to top. The print-object attribute allows lines to be hidden"},{"type":"text","text":" "},{"type":"text","text":"within a staff. This is used in special situations such as a widely-spaced percussion staff where a note"},{"type":"text","text":" "},{"type":"text","text":"placed below the higher line is distinct from a note placed above the lower line. Hidden staff lines are"},{"type":"text","text":" "},{"type":"text","text":"included when specifying clef lines and determining display-step \/ display-octave values, but are not counted"},{"type":"text","text":" "},{"type":"text","text":"as lines for the purposes of the system-layout and staff-layout elements."}]}}}