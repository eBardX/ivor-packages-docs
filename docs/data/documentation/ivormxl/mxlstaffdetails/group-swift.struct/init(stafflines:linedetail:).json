{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails\/Group-swift.struct\/init(staffLines:lineDetail:)"},"abstract":[{"text":"Creates a new ","type":"text"},{"code":"MXLStaffDetails.Group","type":"codeVoice"},{"text":".","type":"text"}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"staffLines"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"lineDetail"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLineDetail","preciseIdentifier":"s:7IvorMXL13MXLLineDetailV","text":"MXLLineDetail"},{"kind":"text","text":"] = [])"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The staff-lines element specifies the number of lines and is usually used for a non"},{"type":"text","text":" "},{"type":"text","text":"5-line staff. If the staff-lines element is present, the appearance of each line"},{"type":"text","text":" "},{"type":"text","text":"may be individually specified with a line-detail element."}],"type":"paragraph"}],"name":"staffLines"},{"content":[{"inlineContent":[{"type":"text","text":"Specifies the appearance of each line individually, when present."}],"type":"paragraph"}],"name":"lineDetail"}],"kind":"parameters"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlstaffdetails\/group-swift.struct\/init(stafflines:linedetail:)"]}],"metadata":{"symbolKind":"init","roleHeading":"Initializer","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"staffLines","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"kind":"text","text"