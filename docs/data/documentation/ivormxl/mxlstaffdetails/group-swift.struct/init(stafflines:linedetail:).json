ternalParam","text":"lineDetail"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL13MXLLineDetailV","text":"MXLLineDetail"},{"kind":"text","text":"])"}],"abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLStaffDetails.Group"},{"type":"text","text":"."}],"role":"symbol","title":"init(staffLines:lineDetail:)"},"doc://IvorMXL/documentation/IvorMXL/MXLStaffDetails/Group-swift.struct":{"title":"MXLStaffDetails.Group","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Group"}],"navigatorTitle":[{"text":"Group","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails\/Group-swift.struct","url":"\/documentation\/ivormxl\/mxlstaffdetails\/group-swift.struct","type":"topic","abstract":[{"type":"text","text":"The number of lines on the staff, and per-line appearance details, for non-5-line staves."}],"role":"symbol"}}}