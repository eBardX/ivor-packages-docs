staff-details element is used to indicate different types of staves. The optional number attribute"},{"type":"text","text":" "},{"type":"text","text":"specifies the staff number from top to bottom on the system, as with clef. The print-object attribute is used"},{"type":"text","text":" "},{"type":"text","text":"to indicate when a staff is not printed in a part, usually in large scores where empty parts are omitted. It"},{"type":"text","text":" "},{"type":"text","text":"is yes by default. If print-spacing is yes while print-object is no, the score is printed in cutaway format"},{"type":"text","text":" "},{"type":"text","text":"where vertical space is left for the empty part."}],"url":"\/documentation\/ivormxl\/mxlstaffdetails","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLStaffDetails"}],"kind":"symbol","title":"MXLStaffDetails","navigatorTitle":[{"kind":"identifier","text":"MXLStaffDetails"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLStaffDetails/Group-swift.struct":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails\/Group-swift.struct","navigatorTitle":[{"text":"Group","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlstaffdetails\/group-swift.struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Group","kind":"identifier"}],"title":"MXLStaffDetails.Group","abstract":[{"type":"text","text":"The number of lines on the staff, and per-line appearance details, for non-5-line staves."}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLStaffDetails/Group-swift.struct/lineDetail":{"url":"\/documentation\/ivormxl\/mxlstaffdetails\/group-swift.struct\/linedetail","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails\/Group-swift.struct\/lineDetail","kind":"symbol","type":"topic","role":"symbol","abstract":[{"type":"text","text":"The appearance of each individual staff line, when present."}],"title":"lineDetail","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lineDetail","kind":"identifier"},{"text":": [","kind":"text"},{"text":"MXLLineDetail","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL13MXLLineDetailV"},{"text":"]","kind":"text"}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLLineDetail":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLLineDetail","kind":"identifier"}],"title":"MXLLineDetail","abstract":[{"type":"text","text":"If the staff-lines element is present, the appearance of each line may be individually specified with a line-"},{"type":"text","text":" "},{"type":"text","text":"detail type. Staff lines are numbered from bottom to top. The print-object attribute allows lines to be hidden"},{"type":"text","text":" "},{"type":"text","text":"within a staff. This is used in special situations such as a widely-spaced percussion staff where a note"},{"type":"text","text":" "},{"type":"text","text":"placed below the higher line is distinct from a note placed above the lower line. Hidden staff lines are"},{"type":"text","text":" "},{"type":"text","text":"included when specifying clef lines and determining display-step \/ display-octave values, but are not counted"},{"type":"text","text":" "},{"type":"text","text":"as lines for the purposes of the system-layout and staff-layout elements."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLineDetail","role":"symbol","url":"\/documentation\/ivormxl\/mxllinedetail","kind":"symbol","navigatorTitle":[{"text":"MXLLineDetail","kind":"identifier"}],"type":"topic"}}}