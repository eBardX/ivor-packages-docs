p","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Group"}],"navigatorTitle":[{"text":"Group","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails\/Group-swift.struct","url":"\/documentation\/ivormxl\/mxlstaffdetails\/group-swift.struct","type":"topic","abstract":[{"type":"text","text":"The number of lines on the staff, and per-line appearance details, for non-5-line staves."}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLStaffDetails/Group-swift.struct/lineDetail":{"role":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxlstaffdetails\/group-swift.struct\/linedetail","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails\/Group-swift.struct\/lineDetail","kind":"symbol","abstract":[{"text":"Specifies the appearance of each line individually, when present.","type":"text"}],"title":"lineDetail","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"lineDetail"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"MXLLineDetail","preciseIdentifier":"s:7IvorMXL13MXLLineDetailV"},{"kind":"text","text":"]"}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLStaffDetails":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLStaffDetails"}],"navigatorTitle":[{"text":"MXLStaffDetails","kind":"identifier"}],"title":"MXLStaffDetails","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails","kind":"symbol","url":"\/documentation\/ivormxl\/mxlstaffdetails","type":"topic","abstract":[{"type":"text","text":"The staff-details element is used to indicate different types of staves. The optional number attribute"},{"type":"text","text":" "},{"type":"text","text":"specifies the staff number from top to bottom on the system, as with clef. The print-object attribute is used"},{"type":"text","text":" "},{"text":"to indicate when a staff is not printed in a part, usually in large scores where empty parts are omitted. It","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"is yes by default. If print-spacing is yes while print-object is no, the score is printed in cutaway format"},{"type":"text","text":" "},{"type":"text","text":"where vertical space is left for the empty part."}]},"doc://IvorMXL/documentation/IvorMXL/MXLLineDetail":{"role":"symbol","url":"\/documentation\/ivormxl\/mxllinedetail","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLineDetail","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLLineDetail"}],"abstract":[{"type":"text","text":"If the staff-lines element is present, the appearance of each line may be individually specified with a line-"},{"type":"text","text":" "},{"type":"text","text":"detail type. Staff lines are numbered from bottom to top. The print-object attribute allows lines to be hidden"},{"type":"text","text":" "},{"type":"text","text":"within a staff. This is used in special situations such as a widely-spaced percussion staff where a note"},{"type":"text","text":" "},{"type":"text","text":"placed below the higher line is distinct from a note placed above the lower line. Hidden staff lines are"},{"type":"text","text":" "},{"type":"text","text":"included when specifying clef lines and determining display-step \/ display-octave values, but are not counted"},{"type":"text","text":" "},{"type":"text","text":"as lines for the purposes of the system-layout and staff-layout elements."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLLineDetail"}],"title":"MXLLineDetail"}}}