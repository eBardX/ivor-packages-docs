{"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails\/Group-swift.struct\/lineDetail","interfaceLanguage":"swift"},"metadata":{"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"lineDetail"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:7IvorMXL13MXLLineDetailV","kind":"typeIdentifier","text":"MXLLineDetail"},{"kind":"text","text":"]"}],"role":"symbol","externalID":"s:7IvorMXL15MXLStaffDetailsV5GroupV10lineDetailSayAA07MXLLineG0VGvp","symbolKind":"property","modules":[{"name":"IvorMXL"}],"title":"lineDetail","roleHeading":"Instance Property"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails\/Group-swift.struct"]]},"sections":[],"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"Specifies the appearance of each line individually, when present.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"lineDetail"},{"kind":"text","text":": ["},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLineDetail","preciseIdentifier":"s:7IvorMXL13MXLLineDetailV","kind":"typeIdentifier","text":"MXLLineDetail"},{"kind":"text","text":"]"}]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Maps to nested MusicXML "},{"type":"codeVoice","code":"<line-detail>"},{"type":"text","text":" elements."}]}]}],"variants":[{"paths":["\/documentation\/ivormxl\/mxlstaffdetails\/group-swift.struct\/linedetail"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLLineDetail":{"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLLineDetail"}],"title":"MXLLineDetail","url":"\/documentation\/ivormxl\/mxllinedetail","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLLineDetail","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLineDetail","abstract":[{"type":"text","text":"If the staff-lines element is present, the appearance of each line may be individually specified with a line-"},{"type":"text","text":" "},{"type":"text","text":"detail type. Staff lines are numbered from bottom to top. The print-object attribute allows lines to be hidden"},{"type":"text","text":" "},{"type":"text","text":"within a staff. This is used in special situations such as a widely-spaced percussion staff where a note"},{"type":"text","text":" "},{"type":"text","text":"placed below the higher line is distinct from a note placed above the lower line. Hidden staff lines are"},{"type":"text","text":" "},{"type":"text","text":"included when specifying clef lines and determining display-step \/ display-octave values, but are not counted"},{"type":"text","text":" "},{"type":"text","text":"as lines for the purposes of the system-layout and staff-layout elements."}]},"doc://IvorMXL/documentation/IvorMXL/MXLStaffDetails/Group-swift.struct/lineDetail":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails\/Group-swift.struct\/lineDetail","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lineDetail","kind":"identifier"},{"text":": [","kind":"text"},{"text":"MXLLineDetail","preciseIdentifier":"s:7IvorMXL13MXLLineDetailV","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"role":"symbol","kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxlstaffdetails\/group-swift.struct\/linedetail","title":"lineDetail","abstract":[{"text":"Specifies the appearance of each line individually, when present.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLStaffDetails/Group-swift.struct":{"abstract":[{"type":"text","text":"The number of lines on the staff, and per-line appearance details, for non-5-line staves."}],"title":"MXLStaffDetails.Group","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Group"}],"navigatorTitle":[{"kind":"identifier","text":"Group"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlstaffdetails\/group-swift.struct","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails\/Group-swift.struct"},"doc://IvorMXL/documentation/IvorMXL/MXLStaffDetails":{"abstract":[{"text":"The staff-details element is used to indicate different types of staves. The optional number attribute","type":"text"},{"text":" ","type":"text"},{"text":"specifies the staff number from top to bottom on the system, as with clef. The print-object attribute is used","type":"text"},{"text":" ","type":"text"},{"text":"to indicate when a staff is not printed in a part, usually in large scores where empty parts are omitted. It","type":"text"},{"text":" ","type":"text"},{"text":"is yes by default. If print-spacing is yes while print-object is no, the score is printed in cutaway format","type":"text"},{"text":" ","type":"text"},{"text":"where vertical space is left for the empty part.","type":"text"}],"title":"MXLStaffDetails","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLStaffDetails","kind":"identifier"}],"navigatorTitle":[{"text":"MXLStaffDetails","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlstaffdetails","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails"}}}