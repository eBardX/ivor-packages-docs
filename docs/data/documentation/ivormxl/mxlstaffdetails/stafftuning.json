ion\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLStaffTuning":{"title":"MXLStaffTuning","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLStaffTuning","kind":"identifier"}],"kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxlstafftuning","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffTuning","abstract":[{"text":"The staff-tuning type specifies the open, non-capo tuning of the lines on a tablature staff.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"MXLStaffTuning"}]},"doc://IvorMXL/documentation/IvorMXL/MXLStaffDetails/staffTuning":{"url":"\/documentation\/ivormxl\/mxlstaffdetails\/stafftuning","abstract":[{"type":"text","text":"The tunings for each line of a tablature staff."}],"title":"staffTuning","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails\/staffTuning","type":"topic","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"staffTuning"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL14MXLStaffTuningV","text":"MXLStaffTuning"},{"kind":"text","text":"]"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLStaffDetails":{"abstract":[{"text":"The staff-details element is used to indicate different types of staves. The optional number attribute","type":"text"},{"text":" ","type":"text"},{"text":"specifies the staff number from top to bottom on the system, as with clef. The print-object attribute is used","type":"text"},{"text":" ","type":"text"},{"text":"to indicate when a staff is not printed in a part, usually in large scores where empty parts are omitted. It","type":"text"},{"text":" ","type":"text"},{"text":"is yes by default. If print-spacing is yes while print-object is no, the score is printed in cutaway format","type":"text"},{"text":" ","type":"text"},{"text":"where vertical space is left