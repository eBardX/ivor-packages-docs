etails","title":"MXLStaffDetails","kind":"symbol","navigatorTitle":[{"text":"MXLStaffDetails","kind":"identifier"}],"abstract":[{"text":"The staff-details element is used to indicate different types of staves. The optional number attribute","type":"text"},{"text":" ","type":"text"},{"text":"specifies the staff number from top to bottom on the system, as with clef. The print-object attribute is used","type":"text"},{"text":" ","type":"text"},{"text":"to indicate when a staff is not printed in a part, usually in large scores where empty parts are omitted. It","type":"text"},{"text":" ","type":"text"},{"text":"is yes by default. If print-spacing is yes while print-object is no, the score is printed in cutaway format","type":"text"},{"text":" ","type":"text"},{"text":"where vertical space is left for the empty part.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlstaffdetails"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLStaffDetails/staffTuning":{"kind":"symbol","title":"staffTuning","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"staffTuning","kind":"identifier"},{"text":": [","kind":"text"},{"text":"MXLStaffTuning","preciseIdentifier":"s:7IvorMXL14MXLStaffTuningV","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"url":"\/documentation\/ivormxl\/mxlstaffdetails\/stafftuning","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails\/staffTuning","role":"symbol","abstract":[{"text":"The tunings for each line of a tablature staff.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLStaffTuning":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"iden