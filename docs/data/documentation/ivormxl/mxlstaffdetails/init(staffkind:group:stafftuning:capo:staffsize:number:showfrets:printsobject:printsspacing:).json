"text":"the specified number of half-steps.","type":"text"}],"type":"paragraph"}]},{"name":"staffSize","content":[{"inlineContent":[{"text":"How large a staff space is on this staff.","type":"text"}],"type":"paragraph"}]},{"name":"number","content":[{"inlineContent":[{"text":"The staff number, from top to bottom on the system, that this element applies to.","type":"text"}],"type":"paragraph"}]},{"name":"showFrets","content":[{"inlineContent":[{"text":"Whether to show tablature frets as numbers or letters. Defaults to numbers.","type":"text"}],"type":"paragraph"}]},{"name":"printsObject","content":[{"inlineContent":[{"text":"A Boolean value indicating whether to print an object (e.g. a note or a rest).","type":"text"},{"text":" ","type":"text"},{"text":"Defaults to ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" if not specified.","type":"text"}],"type":"paragraph"}]},{"name":"printsSpacing","content":[{"inlineContent":[{"text":"A Boolean value indicating whether to leave spacing for an invisible note or object.","type":"text"},{"text":" ","type":"text"},{"text":"Used only if no note, dot, or lyric is being printed. Defaults to ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" if not","type":"text"},{"text":" ","type":"text"},{"text":"specified.","type":"text"}],"type":"paragraph"}]}],"kind":"parameters"}],"metadata":{"role":"symbol","roleHeading":"Initializer","fragments":[{"text":"init","kind":"identifier"},{"kind":"text","text":"("},{"kind":"externalParam","text":"staffKind"},{"text":": ","kind":"text"},{"text":"Kind","preciseIdentifier":"s:7IvorMXL15MXLStaffDetailsV4KindO","kind":"typeIdentifier"},{"kind":"text","text":"?, "},{"text":"group","kind":"externalParam"},{"kind":"text","text":": "},{"text":"Group","preciseIdentifier":"s:7IvorMXL15MXLStaffDetailsV5GroupV","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"staffTuning","kind":"externalParam"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"