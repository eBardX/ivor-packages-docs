:"The staff number, from top to bottom on the system, that this element applies to.","type":"text"}]}]},{"name":"showFrets","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Whether to show tablature frets as numbers or letters. Defaults to numbers."}]}]},{"name":"printsObject","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A Boolean value indicating whether to print an object (e.g. a note or a rest). Defaults to "},{"type":"codeVoice","code":"true"},{"type":"text","text":" if not specified."}]}]},{"name":"printsSpacing","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A Boolean value indicating whether to leave spacing for an invisible note or object. Used only if no note, dot, or lyric is being printed. Defaults to "},{"type":"codeVoice","code":"true"},{"type":"text","text":" if not specified."}]}]}],"kind":"parameters"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails\/init(staffKind:group:staffTuning:capo:staffSize:number:showFrets:printsObject:printsSpacing:)"},"abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLStaffDetails"},{"type":"text","text":"."}],"references":{"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLStaffDetails":{"abstract":[{"text":"The staff-details element is used to indicate different types of staves. The optional number attribute","type":"text"},{"text":" ","type":"text"},{"text":"specifies the staff number from top to bottom on the system, as with clef. The print-object attribute is used","type":"text"},{"text":" ","type":"text"},{"text":"to indicate when a staff is not printed in a part, usually in large scores where empty parts are omitted. It","type":"text"},{"text":" ","type":"text"},{"text":"is yes by default. If print-spacing is yes while print-object is no, the score is printed in cutaway format","type":"text"},{"text":" ","type":"text"},{"text":"where vertical space is left for the empty part.","type":"text"}],"title":"MXLStaffDetails","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLStaffDetails","kind":"identifier"}],"navigatorTitle":[{"text":"MXLStaffDetails","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlstaffdetails","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails"},"doc://IvorMXL/documentation/IvorMXL/MXLStaffTuning":{"title":"MXLStaffTuning","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLStaffTuning","kind":"identifier"}],"kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxlstafftuning","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffTuning","abstract":[{"text":"The staff-tuning type specifies the open, non-capo tuning of the lines on a tablature staff.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"MXLStaffTuning"}]},"doc://IvorMXL/documentation/IvorMXL/MXLStaffDetails/init(staffKind:group:staffTuning:capo:staffSize:number:showFrets:printsObject:printsSpacing:)":{"kind":"symbol","title":"init(staffKind:group:staffTuning:capo:staffSize:number:showFrets:printsObject:printsSpacing:)","url":"\/documentation\/ivormxl\/mxlstaffdetails\/init(staffkind:group:stafftuning:capo:staffsize:number:showfrets:printsobject:printsspacing:)","role":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"staffKind","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL15MXLStaffDetailsV4KindO","text":"Kind","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"group","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL15MXLStaffDetailsV5GroupV","text":"Group","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"staffTuning","kind":"externalParam"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:7IvorMXL14MXLStaffTuningV","text":"MXLStaffTuning","kind":"typeIdentifier"},{"text":"], ","kind":"text"},{"text":"capo","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"staffSize","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL12MXLStaffSizeV","text":"MXLStaffSize","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"number","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL14MXLStaffNumberV","text":"MXLStaffNumber","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"showFrets","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL12MXLShowFretsO","text":"MXLShowFrets","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"printsObject","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"printsSpacing","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":"?)","kind":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails\/init(staffKind:group:staffTuning:capo:staffSize:number:showFrets:printsObject:printsSpacing:)","abstract":[{"text":"Creates a new ","type":"text"},{"code":"MXLStaffDetails","type":"codeVoice"},{"text":".","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLStaffDetails/Kind":{"navigatorTitle":[{"kind":"identifier","text":"Kind"}],"abstract":[{"text":"The staff-type value can be ossia, editorial, cue, alternate, or regular. An ossia staff represents music","type":"text"},{"text":" ","type":"text"},{"text":"that can be played instead of what appears on the regular staff. An editorial staff also represents musical","type":"text"},{"text":" ","type":"text"},{"text":"alternatives, but is created by an editor rather than the composer. It can be used for suggested","type":"text"},{"text":" ","type":"text"},{"text":"interpretations or alternatives from other sources. A cue staff represents music from another part. An","type":"text"},{"text":" ","type":"text"},{"text":"alternate staff shares the same music as the prior staff, but displayed differently (e.g., treble and bass","type":"text"},{"text":" ","type":"text"},{"text":"clef, standard notation and tablature). It is not included in playback. An alternate staff provides more","type":"text"},{"text":" ","type":"text"},{"text":"information to an application reading a file than encoding the same music in separate parts, so its use is","type":"text"},{"text":" ","type":"text"},{"text":"preferred in this situation if feasible. A regular staff is the standard default staff-type.","type":"text"}],"title":"MXLStaffDetails.Kind","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails\/Kind","kind":"symbol","url":"\/documentation\/ivormxl\/mxlstaffdetails\/kind","type":"topic","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Kind"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLStaffNumber":{"navigatorTitle":[{"text":"MXLStaffNumber","kind":"identifier"}],"abstract":[{"text":"The staff-number type indicates staff numbers within a multi-staff part. Staves are numbered from top to","type":"text"},{"text":" ","type":"text"},{"text":"bottom, with 1 being the top staff on a part.","type":"text"}],"title":"MXLStaffNumber","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffNumber","kind":"symbol","url":"\/documentation\/ivormxl\/mxlstaffnumber","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLStaffNumber","kind":"identifier"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLShowFrets":{"abstract":[{"type":"text","text":"The show-frets type indicates whether to show tablature frets as numbers (0, 1, 2) or letters (a, b, c). The"},{"type":"text","text":" "},{"type":"text","text":"default choice is numbers."}],"title":"MXLShowFrets","kind":"symbol","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLShowFrets","kind":"identifier"}],"navigatorTitle":[{"text":"MXLShowFrets","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlshowfrets","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLShowFrets"},"doc://IvorMXL/documentation/IvorMXL/MXLStaffSize":{"title":"MXLStaffSize","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLStaffSize","kind":"identifier"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlstaffsize","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffSize","abstract":[{"type":"text","text":"The staff-size element indicates how large a staff space is on this staff, expressed as a percentage of the"},{"type":"text","text":" "},{"type":"text","text":"work’s default scaling. Values less than 100 make the staff space smaller while values over 100 make the staff"},{"type":"text","text":" "},{"type":"text","text":"space larger. A staff-type of cue, ossia, or editorial implies a staff-size of less than 100, but the exact"},{"type":"text","text":" "},{"type":"text","text":"value is implementation-dependent unless specified here. Staff size affects staff height only, not the"},{"type":"text","text":" "},{"type":"text","text":"relationship of the staff to the left and right margins."}],"navigatorTitle":[{"text":"MXLStaffSize","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLStaffDetails/Group-swift.struct":{"abstract":[{"type":"text","text":"The number of lines on the staff, and per-line appearance details, for non-5-line staves."}],"title":"MXLStaffDetails.Group","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Group"}],"navigatorTitle":[{"kind":"identifier","text":"Group"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlstaffdetails\/group-swift.struct","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails\/Group-swift.struct"}}}