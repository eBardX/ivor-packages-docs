taff is not printed in a part, usually in large scores where empty parts are omitted. It"},{"type":"text","text":" "},{"type":"text","text":"is yes by default. If print-spacing is yes while print-object is no, the score is printed in cutaway format"},{"type":"text","text":" "},{"type":"text","text":"where vertical space is left for the empty part."}],"url":"\/documentation\/ivormxl\/mxlstaffdetails","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLStaffDetails"}],"kind":"symbol","title":"MXLStaffDetails","navigatorTitle":[{"kind":"identifier","text":"MXLStaffDetails"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLStaffNumber":{"type":"topic","title":"MXLStaffNumber","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffNumber","abstract":[{"type":"text","text":"The staff-number type indicates staff numbers within a multi-staff part. Staves are numbered from top to"},{"type":"text","text":" "},{"type":"text","text":"bottom, with 1 being the top staff on a part."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLStaffNumber"}],"navigatorTitle":[{"kind":"identifier","text":"MXLStaffNumber"}],"url":"\/documentation\/ivormxl\/mxlstaffnumber"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLStaffDetails/Group-swift.struct":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails\/Group-swift.struct","navigatorTitle":[{"text":"Group","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlstaffdetails\/group-swift.struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Group","kind":"identifier"}],"title":"MXLStaffDetails.Group","abstract":[{"type":"text","text":"The number of lines on the staff, and per-line appearance details, for non-5-line staves."}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLShowFrets":{"title":"MXLShowFrets","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLShowFrets","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlshowfrets","role":"symbol","navigatorTitle":[{"text":"MXLShowFrets","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLShowFrets","abstract":[{"text":"The show-frets type indicates whether to show tablature frets as numbers (0, 1, 2) or letters (a, b, c). The","type":"text"},{"text":" ","type":"text"},{"text":"default choice is numbers.","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLStaffDetails/Kind":{"type":"topic","abstract":[{"type":"text","text":"The staff-type value can be ossia, editorial, cue, alternate, or regular. An ossia staff represents music"},{"type":"text","text":" "},{"type":"text","text":"that can be played instead of what appears on the regular staff. An editorial staff also represents musical"},{"type":"text","text":" "},{"type":"text","text":"alternatives, but is created by an editor rather than the composer. It can be used for suggested"},{"type":"text","text":" "},{"type":"text","text":"interpretations or alternatives from other sources. A cue staff represents music from another part. An"},{"type":"text","text":" "},{"type":"text","text":"alternate staff shares the same music as the prior staff, but displayed differently (e.g., treble and bass"},{"type":"text","text":" "},{"type":"text","text":"clef, standard notation and tablature). It is not included in playback. An alternate staff provides more"},{"type":"text","text":" "},{"type":"text","text":"information to an application reading a file than encoding the same music in separate parts, so its use is"},{"type":"text","text":" "},{"type":"text","text":"preferred in this situation if feasible. A regular staff is the standard default staff-type."}],"url":"\/documentation\/ivormxl\/mxlstaffdetails\/kind","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Kind"}],"kind":"symbol","title":"MXLStaffDetails.Kind","navigatorTitle":[{"kind":"identifier","text":"Kind"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails\/Kind","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLStaffDetails/init(staffKind:group:staffTuning:capo:staffSize:number:showFrets:printsObject:printsSpacing:)":{"title":"init(staffKind:group:staffTuning:capo:staffSize:number:showFrets:printsObject:printsSpacing:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"staffKind"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL15MXLStaffDetailsV4KindO","text":"Kind"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"group"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL15MXLStaffDetailsV5GroupV","text":"Group"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"staffTuning"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL14MXLStaffTuningV","text":"MXLStaffTuning"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"capo"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"staffSize"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL12MXLStaffSizeV","text":"MXLStaffSize"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"number"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL14MXLStaffNumberV","text":"MXLStaffNumber"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"showFrets"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL12MXLShowFretsO","text":"MXLShowFrets"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"printsObject"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"printsSpacing"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":"?)"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlstaffdetails\/init(staffkind:group:stafftuning:capo:staffsize:number:showfrets:printsobject:printsspacing:)","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails\/init(staffKind:group:staffTuning:capo:staffSize:number:showFrets:printsObject:printsSpacing:)","abstract":[{"text":"Creates a new ","type":"text"},{"code":"MXLStaffDetails","type":"codeVoice"},{"text":".","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLStaffSize":{"type":"topic","abstract":[{"text":"The staff-size element indicates how large a staff space is on this staff, expressed as a percentage of the","type":"text"},{"text":" ","type":"text"},{"text":"work’s default scaling. Values less than 100 make the staff space smaller while values over 100 make the staff","type":"text"},{"text":" ","type":"text"},{"text":"space larger. A staff-type of cue, ossia, or editorial implies a staff-size of less than 100, but the exact","type":"text"},{"text":" ","type":"text"},{"text":"value is implementation-dependent unless specified here. Staff size affects staff height only, not the","type":"text"},{"text":" ","type":"text"},{"text":"relationship of the staff to the left and right margins.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlstaffsize","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLStaffSize"}],"kind":"symbol","title":"MXLStaffSize","navigatorTitle":[{"kind":"identifier","text":"MXLStaffSize"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffSize","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLStaffTuning":{"navigatorTitle":[{"kind":"identifier","text":"MXLStaffTuning"}],"abstract":[{"text":"The staff-tuning type specifies the open, non-capo tuning of the lines on a tablature staff.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffTuning","url":"\/documentation\/ivormxl\/mxlstafftuning","role":"symbol","title":"MXLStaffTuning","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLStaffTuning"}]}}}