me":"capo"},{"content":[{"inlineContent":[{"text":"How large a staff space is on this staff.","type":"text"}],"type":"paragraph"}],"name":"staffSize"},{"content":[{"inlineContent":[{"text":"The staff number, from top to bottom on the system, that this element applies to.","type":"text"}],"type":"paragraph"}],"name":"number"},{"content":[{"inlineContent":[{"text":"Whether to show tablature frets as numbers or letters. Defaults to numbers.","type":"text"}],"type":"paragraph"}],"name":"showFrets"},{"content":[{"inlineContent":[{"text":"A Boolean value indicating whether to print an object (e.g. a note or a rest). Defaults to ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" if not specified.","type":"text"}],"type":"paragraph"}],"name":"printsObject"},{"content":[{"inlineContent":[{"text":"A Boolean value indicating whether to leave spacing for an invisible note or object. Used only if no note, dot, or lyric is being printed. Defaults to ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" if not specified.","type":"text"}],"type":"paragraph"}],"name":"printsSpacing"}]}],"abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLStaffDetails"},{"type":"text","text":"."}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLStaffDetails/init(staffKind:group:staffTuning:capo:staffSize:number:showFrets:printsObject:printsSpacing:)":{"abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLStaffDetails"},{"type":"text","text":"."}],"url":"\/documentation\/ivormxl\/mxlstaffdetails\/init(staffkind:group:stafftuning:capo:staffsize:number:showfrets:printsobject:printsspacing:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"staffKind","kind":"externalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"Kind","preciseIdentifier":"s:7IvorMXL15MXLStaffDetailsV4KindO"},{"kind":"text","text":"?, "},{"text":"group","kind":"externalParam"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Group","preciseIdentifier":"s:7IvorMXL15MXLStaffDetailsV5GroupV"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"staffTuning"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"MXLStaffTuning","preciseIdentifier":"s:7IvorMXL14MXLStaffTuningV"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"capo"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"staffSize"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLStaffSize","preciseIdentifier":"s:7IvorMXL12MXLStaffSizeV"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"number"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLStaffNumber","preciseIdentifier":"s:7IvorMXL14MXLStaffNumberV"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"showFrets"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLShowFrets","preciseIdentifier":"s:7IvorMXL12MXLShowFretsO"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"printsObject"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"printsSpacing"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":"?)"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails\/init(staffKind:group:staffTuning:capo:staffSize:number:showFrets:printsObject:printsSpacing:)","role":"symbol","title":"init(staffKind:group:staffTuning:capo:staffSize:number:showFrets:printsObject:printsSpacing:)","type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLStaffTuning":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffTuning","url":"\/documentation\/ivormxl\/mxlstafftuning","title":"MXLStaffTuning","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The staff-tuning type specifies the open, non-capo tuning of the lines on a tablature staff."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLStaffTuning"}],"navigatorTitle":[{"kind":"identifier","text":"MXLStaffTuning"}]},"doc://IvorMXL/documentation/IvorMXL/MXLStaffDetails/Group-swift.struct":{"title":"MXLStaffDetails.Group","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Group"}],"navigatorTitle":[{"text":"Group","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails\/Group-swift.struct","url":"\/documentation\/ivormxl\/mxlstaffdetails\/group-swift.struct","type":"topic","abstract":[{"type":"text","text":"The number of lines on the staff, and per-line appearance details, for non-5-line staves."}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLStaffNumber":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLStaffNumber","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"MXLStaffNumber","kind":"identifier"}],"abstract":[{"text":"The staff-number type indicates staff numbers within a multi-staff part. Staves are numbered from top to","type":"text"},{"type":"text","text":" "},{"type":"text","text":"bottom, with 1 being the top staff on a part."}],"url":"\/documentation\/ivormxl\/mxlstaffnumber","title":"MXLStaffNumber","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffNumber","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLShowFrets":{"url":"\/documentation\/ivormxl\/mxlshowfrets","abstract":[{"type":"text","text":"The show-frets type indicates whether to show tablature frets as numbers (0, 1, 2) or letters (a, b, c). The"},{"type":"text","text":" "},{"text":"default choice is numbers.","type":"text"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLShowFrets","kind":"identifier"}],"kind":"symbol","role":"symbol","type":"topic","title":"MXLShowFrets","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLShowFrets","navigatorTitle":[{"text":"MXLShowFrets","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLStaffDetails":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLStaffDetails"}],"navigatorTitle":[{"text":"MXLStaffDetails","kind":"identifier"}],"title":"MXLStaffDetails","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails","kind":"symbol","url":"\/documentation\/ivormxl\/mxlstaffdetails","type":"topic","abstract":[{"type":"text","text":"The staff-details element is used to indicate different types of staves. The optional number attribute"},{"type":"text","text":" "},{"type":"text","text":"specifies the staff number from top to bottom on the system, as with clef. The print-object attribute is used"},{"type":"text","text":" "},{"text":"to indicate when a staff is not printed in a part, usually in large scores where empty parts are omitted. It","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"is yes by default. If print-spacing is yes while print-object is no, the score is printed in cutaway format"},{"type":"text","text":" "},{"type":"text","text":"where vertical space is left for the empty part."}]},"doc://IvorMXL/documentation/IvorMXL/MXLStaffDetails/Kind":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Kind","kind":"identifier"}],"navigatorTitle":[{"text":"Kind","kind":"identifier"}],"title":"MXLStaffDetails.Kind","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails\/Kind","kind":"symbol","url":"\/documentation\/ivormxl\/mxlstaffdetails\/kind","type":"topic","abstract":[{"type":"text","text":"The staff-type value can be ossia, editorial, cue, alternate, or regular. An ossia staff represents music"},{"type":"text","text":" "},{"type":"text","text":"that can be played instead of what appears on the regular staff. An editorial staff also represents musical"},{"type":"text","text":" "},{"type":"text","text":"alternatives, but is created by an editor rather than the composer. It can be used for suggested"},{"type":"text","text":" "},{"type":"text","text":"interpretations or alternatives from other sources. A cue staff represents music from another part. An"},{"type":"text","text":" "},{"type":"text","text":"alternate staff shares the same music as the prior staff, but displayed differently (e.g., treble and bass"},{"type":"text","text":" "},{"type":"text","text":"clef, standard notation and tablature). It is not included in playback. An alternate staff provides more"},{"type":"text","text":" "},{"type":"text","text":"information to an application reading a file than encoding the same music in separate parts, so its use is"},{"type":"text","text":" "},{"type":"text","text":"preferred in this situation if feasible. A regular staff is the standard default staff-type."}]},"doc://IvorMXL/documentation/IvorMXL/MXLStaffSize":{"title":"MXLStaffSize","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLStaffSize","kind":"identifier"}],"abstract":[{"type":"text","text":"The staff-size element indicates how large a staff space is on this staff, expressed as a percentage of the"},{"text":" ","type":"text"},{"text":"work’s default scaling. Values less than 100 make the staff space smaller while values over 100 make the staff","type":"text"},{"type":"text","text":" "},{"type":"text","text":"space larger. A staff-type of cue, ossia, or editorial implies a staff-size of less than 100, but the exact"},{"type":"text","text":" "},{"type":"text","text":"value is implementation-dependent unless specified here. Staff size affects staff height only, not the"},{"type":"text","text":" "},{"type":"text","text":"relationship of the staff to the left and right margins."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffSize","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLStaffSize"}],"url":"\/documentation\/ivormxl\/mxlstaffsize"}}}