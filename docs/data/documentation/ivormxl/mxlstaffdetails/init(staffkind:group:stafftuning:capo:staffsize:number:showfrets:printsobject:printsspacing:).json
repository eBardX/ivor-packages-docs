ing of the strings specified by staff-tuning by the specified number of half-steps.","type":"text"}]}],"name":"capo"},{"content":[{"type":"paragraph","inlineContent":[{"text":"How large a staff space is on this staff.","type":"text"}]}],"name":"staffSize"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The staff number, from top to bottom on the system, that this element applies to.","type":"text"}]}],"name":"number"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Whether to show tablature frets as numbers or letters. Defaults to numbers.","type":"text"}]}],"name":"showFrets"},{"content":[{"type":"paragraph","inlineContent":[{"text":"A Boolean value indicating whether to print an object (e.g. a note or a rest). Defaults to ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" if not specified.","type":"text"}]}],"name":"printsObject"},{"content":[{"type":"paragraph","inlineContent":[{"text":"A Boolean value indicating whether to leave spacing for an invisible note or object. Used only if no note, dot, or lyric is being printed. Defaults to ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" if not specified.","type":"text"}]}],"name":"printsSpacing"}],"kind":"parameters"}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLStaffDetails/Group-swift.struct":{"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Group","kind":"identifier"}],"title":"MXLStaffDetails.Group","navigatorTitle":[{"text":"Group","kind":"identifier"}],"abstract":[{"type":"text","text":"The number of lines on the staff, and per-line appearance details, for non-5-line staves."}],"url":"\/documentation\/ivormxl\/mxlstaffdetails\/group-swift.struct","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails\/Group-swift.struct","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLStaffSize":{"url":"\/documentation\/ivormxl\/mxlstaffsize","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLStaffSize"}],"title":"MXLStaffSize","abstract":[{"type":"text","text":"The staff-size element indicates how large a staff space is on this staff, expressed as a percentage of the"},{"type":"text","text":" "},{"type":"text","text":"work’s default scaling. Values less than 100 make the staff space smaller while values over 100 make the staff"},{"type":"text","text":" "},{"type":"text","text":"space larger. A staff-type of cue, ossia, or editorial implies a staff-size of less than 100, but the exact"},{"type":"text","text":" "},{"type":"text","text":"value is implementation-dependent unless specified here. Staff size affects staff height only, not the"},{"type":"text","text":" "},{"type":"text","text":"relationship of the staff to the left and right margins."}],"navigatorTitle":[{"kind":"identifier","text":"MXLStaffSize"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffSize"},"doc://IvorMXL/documentation/IvorMXL/MXLStaffNumber":{"type":"topic","title":"MXLStaffNumber","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLStaffNumber"}],"url":"\/documentation\/ivormxl\/mxlstaffnumber","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffNumber","role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLStaffNumber"}],"abstract":[{"text":"The staff-number type indicates staff numbers within a multi-staff part. Staves are numbered from top to","type":"text"},{"text":" ","type":"text"},{"text":"bottom, with 1 being the top staff on a part.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLStaffDetails/init(staffKind:group:staffTuning:capo:staffSize:number:showFrets:printsObject:printsSpacing:)":{"type":"topic","title":"init(staffKind:group:staffTuning:capo:staffSize:number:showFrets:printsObject:printsSpacing:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"staffKind"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL15MXLStaffDetailsV4KindO","text":"Kind"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"group"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL15MXLStaffDetailsV5GroupV","text":"Group"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"staffTuning"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL14MXLStaffTuningV","text":"MXLStaffTuning"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"capo"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"staffSize"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL12MXLStaffSizeV","text":"MXLStaffSize"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"number"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL14MXLStaffNumberV","text":"MXLStaffNumber"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"showFrets"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL12MXLShowFretsO","text":"MXLShowFrets"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"printsObject"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"printsSpacing"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":"?)"}],"abstract":[{"text":"Creates a new ","type":"text"},{"code":"MXLStaffDetails","type":"codeVoice"},{"text":".","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails\/init(staffKind:group:staffTuning:capo:staffSize:number:showFrets:printsObject:printsSpacing:)","kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlstaffdetails\/init(staffkind:group:stafftuning:capo:staffsize:number:showfrets:printsobject:printsspacing:)"},"doc://IvorMXL/documentation/IvorMXL/MXLShowFrets":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLShowFrets","url":"\/documentation\/ivormxl\/mxlshowfrets","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLShowFrets","kind":"identifier"}],"abstract":[{"type":"text","text":"The show-frets type indicates whether to show tablature frets as numbers (0, 1, 2) or letters (a, b, c). The"},{"text":" ","type":"text"},{"text":"default choice is numbers.","type":"text"}],"navigatorTitle":[{"text":"MXLShowFrets","kind":"identifier"}],"title":"MXLShowFrets","type":"topic","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLStaffDetails/Kind":{"abstract":[{"text":"The staff-type value can be ossia, editorial, cue, alternate, or regular. An ossia staff represents music","type":"text"},{"text":" ","type":"text"},{"text":"that can be played instead of what appears on the regular staff. An editorial staff also represents musical","type":"text"},{"text":" ","type":"text"},{"text":"alternatives, but is created by an editor rather than the composer. It can be used for suggested","type":"text"},{"text":" ","type":"text"},{"text":"interpretations or alternatives from other sources. A cue staff represents music from another part. An","type":"text"},{"text":" ","type":"text"},{"text":"alternate staff shares the same music as the prior staff, but displayed differently (e.g., treble and bass","type":"text"},{"text":" ","type":"text"},{"text":"clef, standard notation and tablature). It is not included in playback. An alternate staff provides more","type":"text"},{"text":" ","type":"text"},{"text":"information to an application reading a file than encoding the same music in separate parts, so its use is","type":"text"},{"text":" ","type":"text"},{"text":"preferred in this situation if feasible. A regular staff is the standard default staff-type.","type":"text"}],"navigatorTitle":[{"text":"Kind","kind":"identifier"}],"kind":"symbol","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Kind","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails\/Kind","url":"\/documentation\/ivormxl\/mxlstaffdetails\/kind","type":"topic","title":"MXLStaffDetails.Kind"},"doc://IvorMXL/documentation/IvorMXL/MXLStaffTuning":{"navigatorTitle":[{"kind":"identifier","text":"MXLStaffTuning"}],"url":"\/documentation\/ivormxl\/mxlstafftuning","kind":"symbol","type":"topic","role":"symbol","title":"MXLStaffTuning","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffTuning","abstract":[{"type":"text","text":"The staff-tuning type specifies the open, non-capo tuning of the lines on a tablature staff."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLStaffTuning"}]},"doc://IvorMXL/documentation/IvorMXL/MXLStaffDetails":{"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLStaffDetails","kind":"identifier"}],"title":"MXLStaffDetails","navigatorTitle":[{"text":"MXLStaffDetails","kind":"identifier"}],"abstract":[{"type":"text","text":"The staff-details element is used to indicate different types of staves. The optional number attribute"},{"type":"text","text":" "},{"type":"text","text":"specifies the staff number from top to bottom on the system, as with clef. The print-object attribute is used"},{"type":"text","text":" "},{"type":"text","text":"to indicate when a staff is not printed in a part, usually in large scores where empty parts are omitted. It"},{"type":"text","text":" "},{"type":"text","text":"is yes by default. If print-spacing is yes while print-object is no, the score is printed in cutaway format"},{"type":"text","text":" "},{"type":"text","text":"where vertical space is left for the empty part."}],"url":"\/documentation\/ivormxl\/mxlstaffdetails","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]}}}