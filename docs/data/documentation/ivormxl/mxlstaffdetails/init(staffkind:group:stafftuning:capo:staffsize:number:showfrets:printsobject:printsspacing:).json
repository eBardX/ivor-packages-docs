"staffSize","content":[{"type":"paragraph","inlineContent":[{"text":"How large a staff space is on this staff.","type":"text"}]}]},{"name":"number","content":[{"type":"paragraph","inlineContent":[{"text":"The staff number, from top to bottom on the system, that this element applies to.","type":"text"}]}]},{"name":"showFrets","content":[{"type":"paragraph","inlineContent":[{"text":"Whether to show tablature frets as numbers or letters. Defaults to numbers.","type":"text"}]}]},{"name":"printsObject","content":[{"type":"paragraph","inlineContent":[{"text":"A Boolean value indicating whether to print an object (e.g. a note or a rest). Defaults to ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" if not specified.","type":"text"}]}]},{"name":"printsSpacing","content":[{"type":"paragraph","inlineContent":[{"text":"A Boolean value indicating whether to leave spacing for an invisible note or object. Used only if no note, dot, or lyric is being printed. Defaults to ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" if not specified.","type":"text"}]}]}],"kind":"parameters"}],"abstract":[{"text":"Creates a new ","type":"text"},{"type":"codeVoice","code":"MXLStaffDetails"},{"text":".","type":"text"}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLStaffDetails/Kind":{"abstract":[{"text":"The staff-type value can be ossia, editorial, cue, alternate, or regular. An ossia staff represents music","type":"text"},{"text":" ","type":"text"},{"text":"that can be played instead of what appears on the regular staff. An editorial staff also represents musical","type":"text"},{"text":" ","type":"text"},{"text":"alternatives, but is created by an editor rather than the composer. It can be used for suggested","type":"text"},{"text":" ","type":"text"},{"text":"interpretations or alternatives from other sources. A cue staff represents music from another part. An","type":"text"},{"text":" ","type":"text"},{"text":"alternate staff shares the same music as the prior staff, but displayed differently (e.g., treble and bass","type":"text"},{"text":" ","type":"text"},{"text":"clef, standard notation and tablature). It is not included in playback. An alternate staff provides more","type":"text"},{"text":" ","type":"text"},{"text":"information to an application reading a file than encoding the same music in separate parts, so its use is","type":"text"},{"text":" ","type":"text"},{"text":"preferred in this situation if feasible. A regular staff is the standard default staff-type.","type":"text"}],"role":"symbol","navigatorTitle":[{"text":"Kind","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlstaffdetails\/kind","kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Kind","kind":"identifier"}],"title":"MXLStaffDetails.Kind","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails\/Kind","type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLShowFrets":{"url":"\/documentation\/ivormxl\/mxlshowfrets","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLShowFrets","kind":"identifier"}],"title":"MXLShowFrets","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLShowFrets","navigatorTitle":[{"text":"MXLShowFrets","kind":"identifier"}],"role":"symbol","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The show-frets type indicates whether to show tablature frets as numbers (0, 1, 2) or letters (a, b, c). The"},{"type":"text","text":" "},{"type":"text","text":"default choice is numbers."}]},"doc://IvorMXL/documentation/IvorMXL/MXLStaffDetails/init(staffKind:group:staffTuning:capo:staffSize:number:showFrets:printsObject:printsSpacing:)":{"kind":"symbol","title":"init(staffKind:group:staffTuning:capo:staffSize:number:showFrets:printsObject:printsSpacing:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"staffKind","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Kind","preciseId