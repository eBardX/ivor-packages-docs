:"MXLStaffDetails","type":"codeVoice"},{"text":".","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLStaffDetails/Group-swift.struct":{"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Group"}],"navigatorTitle":[{"kind":"identifier","text":"Group"}],"abstract":[{"type":"text","text":"The number of lines on the staff, and per-line appearance details, for non-5-line staves."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails\/Group-swift.struct","title":"MXLStaffDetails.Group","role":"symbol","url":"\/documentation\/ivormxl\/mxlstaffdetails\/group-swift.struct"},"doc://IvorMXL/documentation/IvorMXL/MXLStaffTuning":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLStaffTuning"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlstafftuning","title":"MXLStaffTuning","navigatorTitle":[{"kind":"identifier","text":"MXLStaffTuning"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffTuning","abstract":[{"type":"text","text":"The staff-tuning type specifies the open, non-capo tuning of the lines on a tablature staff."}],"type":"topic","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLStaffNumber":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffNumber","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLStaffNumber"}],"abstract":[{"text":"The staff-number type indicates staff numbers within a multi-staff part. Staves are numbered from top to","type":"text"},{"text":" ","type":"text"},{"text":"bottom, with 1 being the top staff on a part.","type":"text"}],"title":"MXLStaffNumber","kind":"symbol","url":"\/documentation\/ivormxl\/mxlstaffnumber","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLStaffNumber"}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLStaffDetails":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLStaffDetails","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails","title":"MXLStaffDetails","kind":"symbol","navigatorTitle":[{"text":"MXLStaffDetails","kind":"identifier"}],"abstract":[{"text":"The staff-details element is used to indicate different types of staves. The optional number attribute","type":"text"},{"text":" ","type":"text"},{"text":"specifies the staff number from top to bottom on the system, as with clef. The print-object attribute is used","type":"text"},{"text":" ","type":"text"},{"text":"to indicate when a staff is not printed in a part, usually in large scores where empty parts are omitted. It","type":"text"},{"text":" ","type":"text"},{"text":"is yes by default. If print-spacing is yes while print-object is no, the score is printed in cutaway format","type":"text"},{"text":" ","type":"text"},{"text":"where vertical space is left for the empty part.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlstaffdetails"},"doc://IvorMXL/documentation/IvorMXL/MXLStaffSize":{"role":"symbol","kind":"symbol","url":"\/documentation\/ivormxl\/mxlstaffsize","abstract":[{"text":"The staff-size element indicates how large a staff space is on this staff, expressed as a percentage of the","type":"text"},{"text":" ","type":"text"},{"text":"work’s default scaling. Values less than 100 make the staff space smaller while values over 100 make the staff","type":"text"},{"text":" ","type":"text"},{"text":"space larger. A staff-type of cue, ossia, or editorial implies a staff-size of less than 100, but the exact","type":"text"},{"text":" ","type":"text"},{"text":"value is implementation-dependent unless specified here. Staff size affects staff height only, not the","type":"text"},{"text":" ","type":"text"},{"text":"relationship of the staff to the left and right margins.","type":"text"}],"title":"MXLStaffSize","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLStaffSize"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffSize","navigatorTitle":[{"kind":"identifier","text":"MXLStaffSize"}]}}}