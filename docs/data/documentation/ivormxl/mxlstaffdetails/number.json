LStaffNumber","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"MXLStaffNumber","kind":"identifier"}],"abstract":[{"text":"The staff-number type indicates staff numbers within a multi-staff part. Staves are numbered from top to","type":"text"},{"type":"text","text":" "},{"type":"text","text":"bottom, with 1 being the top staff on a part."}],"url":"\/documentation\/ivormxl\/mxlstaffnumber","title":"MXLStaffNumber","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffNumber","kind":"symbol"}}}