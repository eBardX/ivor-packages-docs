{"sections":[],"abstract":[{"type":"text","text":"A Boolean value indicating whether to leave spacing for an invisible note or object. Used only if no note,"},{"type":"text","text":" "},{"type":"text","text":"dot, or lyric is being printed. Defaults to "},{"type":"codeVoice","code":"true"},{"type":"text","text":" if not specified."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlstaffdetails\/printsspacing"]}],"metadata":{"roleHeading":"Instance Property","symbolKind":"property","fragments":[{"text":"let","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"printsSpacing"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":"?"}],"title":"printsSpacing","externalID":"s:7IvorMXL15MXLStaffDetailsV13printsSpacingSbSgvp","modules":[{"name":"IvorMXL"}],"role":"symbol"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"text":"printsSpacing","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":"?","kind":"text"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Maps to the MusicXML "},{"type":"codeVoice","code":"print-spacing"},{"type":"text","text":" attribute."}]}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails\/printsSpacing","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails"]]},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLStaffDetails":{"abstract":[{"text":"The staff-details element is used to indicate different types of staves. The optional number attribute","type":"text"},{"text":" ","type":"text"},{"text":"specifies the staff number from top to bottom on the system, as with clef. The print-object attribute is used","type":"text"},{"text":" ","type":"text"},{"text":"to indicate when a staff is not printed in a part, usually in large scores where empty parts are omitted. It","type":"text"},{"text":" ","type":"text"},{"text":"is yes by default. If print-spacing is yes while print-object is no, the score is printed in cutaway format","type":"text"},{"text":" ","type":"text"},{"text":"where vertical space is left for the empty part.","type":"text"}],"title":"MXLStaffDetails","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLStaffDetails","kind":"identifier"}],"navigatorTitle":[{"text":"MXLStaffDetails","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlstaffdetails","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails"},"doc://IvorMXL/documentation/IvorMXL/MXLStaffDetails/printsSpacing":{"url":"\/documentation\/ivormxl\/mxlstaffdetails\/printsspacing","abstract":[{"type":"text","text":"A Boolean value indicating whether to leave spacing for an invisible note or object. Used only if no note,"},{"type":"text","text":" "},{"type":"text","text":"dot, or lyric is being printed. Defaults to "},{"type":"codeVoice","code":"true"},{"type":"text","text":" if not specified."}],"title":"printsSpacing","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails\/printsSpacing","type":"topic","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"printsSpacing"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":"?"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and forma