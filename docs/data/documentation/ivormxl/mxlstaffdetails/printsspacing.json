{"sections":[],"abstract":[{"type":"text","text":"A Boolean value indicating whether to leave spacing for an invisible note or object. Used only if no note,"},{"type":"text","text":" "},{"type":"text","text":"dot, or lyric is being printed. Defaults to "},{"type":"codeVoice","code":"true"},{"type":"text","text":" if not specified."}],"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"symbolKind":"property","title":"printsSpacing","roleHeading":"Instance Property","modules":[{"name":"IvorMXL"}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"printsSpacing"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"},{"kind":"text","text":"?"}],"role":"symbol","externalID":"s:7IvorMXL15MXLStaffDetailsV13printsSpacingSbSgvp"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails"]]},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"printsSpacing"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"},{"kind":"text","text":"?"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"level":2,"type":"heading","anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Maps to the MusicXML "},{"type":"codeVoice","code":"print-spacing"},{"type":"text","text":" attribute."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlstaffdetails\/printsspacing"]}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails\/printsSpacing","interfaceLanguage":"swift"},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLStaffDetails/printsSpacing":{"abstract":[{"type":"text","text":"A Boolean value indicating whether to le