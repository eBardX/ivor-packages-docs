{"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails\/Kind"]]},"topicSections":[{"title":"Operators","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails\/Kind\/!=(_:_:)"],"generated":true,"anchor":"Operators"}],"variants":[{"paths":["\/documentation\/ivormxl\/mxlstaffdetails\/kind\/equatable-implementations"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails\/Kind\/Equatable-Implementations"},"metadata":{"roleHeading":"API Collection","title":"Equatable Implementations","modules":[{"name":"IvorMXL"}],"role":"collectionGroup"},"references":{"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLStaffDetails":{"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLStaffDetails","kind":"identifier"}],"title":"MXLStaffDetails","navigatorTitle":[{"text":"MXLStaffDetails","kind":"identifier"}],"abstract":[{"type":"text","text":"The staff-details element is used to indicate different types of staves. The optional number attribute"},{"type":"text","text":" "},{"type":"text","text":"specifies the staff number from top to bottom on the system, as with clef. The print-object attribute is used"},{"type":"text","text":" "},{"type":"text","text":"to indicate when a staff is not printed in a part, usually in large scores where empty parts are omitted. It"},{"type":"text","text":" "},{"type":"text","text":"is yes by default. If print-spacing is yes while print-object is no, the score is printed in cutaway format"},{"type":"text","text":" "},{"type":"text","text":"where vertical space is left for the empty part."}],"url":"\/documentation\/ivormxl\/mxlstaffdetails","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLStaffDetails/Kind":{"abstract":[{"text":"The staff-type value can be ossia, editorial, cue, alternate, or regular. An ossia staff represents music","type":"text"},{"text":" ","type":"text"},{"text":"that can be played instead of what appears on the regular staff. An editorial staff also represents musical","type":"text"},{"text":" ","type":"text"},{"text":"alternatives, but is created by an editor rather than the composer. It can be used for suggested","type":"text"},{"text":" ","type":"text"},{"text":"interpretations or alternatives from other sources. A cue staff represents music from another part. An","type":"text"},{"text":" ","type":"text"},{"text":"alternate staff shares the same music as the prior staff, but displayed differently (e.g., treble and bass","type":"text"},{"text":" ","type":"text"},{"text":"clef, standard notation and tablature). It is not included in playback. An alternate staff provides more","type":"text"},{"text":" ","type":"text"},{"text":"information to an application reading a file than encoding the same music in separate parts, so its use is","type":"text"},{"text":" ","type":"text"},{"text":"preferred in this situation if feasible. A regular staff is the standard default staff-type.","type":"text"}],"navigatorTitle":[{"text":"Kind","kind":"identifier"}],"kind":"symbol","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Kind","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails\/Kind","url":"\/documentation\/ivormxl\/mxlstaffdetails\/kind","type":"topic","title":"MXLStaffDetails.Kind"},"doc://IvorMXL/documentation/IvorMXL/MXLStaffDetails/Kind/!=(_:_:)":{"url":"\/documentation\/ivormxl\/mxlstaffdetails\/kind\/!=(_:_:)","title":"!=(_:_:)","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"!=","kind":"identifier"},{"text":" ","kind":"text"},{"text":"(","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"abstract":[],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails\/Kind\/!=(_:_:)","type":"topic","role":"symbol"}}}