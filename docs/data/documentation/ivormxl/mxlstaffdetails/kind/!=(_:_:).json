ge":"swift"},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLStaffDetails/Kind/!=(_:_:)":{"type":"topic","abstract":[],"url":"\/documentation\/ivormxl\/mxlstaffdetails\/kind\/!=(_:_:)","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"!="},{"kind":"text","text":" "},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"kind":"symbol","title":"!=(_:_:)","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails\/Kind\/!=(_:_:)","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLStaffDetails":{"type":"topic","abstract":[{"type":"text","text":"The staff-details element is used to indicate different types of staves. The optional number attribute"},{"type":"text","text":" "},{"type":"text","text":"specifies the staff number from top to bottom on the system, as with clef. The print-object attribute is used"},{"type":"text","text":" "},{"type":"text","text":"to indicate when a staff is not printed in a part, usually in large scores where empty parts are omitted. It"},{"type":"text","text":" "},{"type":"text","text":"is yes by default. If print-spacing is yes while print-object is no, the score is printed in cutaway format"},{"type":"text","text":" "},{"type":"text","text":"where vertical space is left for the empty part."}],"url":"\/documentation\/ivormxl\/mxlstaffdetails","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLStaffDetails"}],"kind":"symbol","title":"MXLStaffDetails","navigatorTitle":[{"kind":"identifier","text":"MXLStaffDetails"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLStaffDetails/Kind":{"type":"topic","abstract":[{"type":"text","text":"The staff-type value can be ossia, editorial, cue, alternate, or regular. An ossia staff represents music"},{"type":"text","text":" "},{"type":"text","text":"that can be played instead of what appears on the regular staff. An editorial staff also represents musical"},{"type":"text","text":" "},{"type":"text","text":"alternatives, but is created by an editor rather than the composer. It can be used for suggested"},{"type":"text","text":" "},{"type":"text","text":"interpretations or alternatives from other sources. A cue staff represents music from another part. An"},{"type":"text","text":" "},{"type":"text","text":"alternate staff shares the same music as the prior staff, but displayed differently (e.g., treble and bass"},{"type":"text","text":" "},{"type":"text","text":"clef, standard notation and tablature). It is not included in playback. An alternate staff provides more"},{"type":"text","text":" "},{"type":"text","text":"information to an application reading a file than encoding the same music in separate parts, so its use is"},{"type":"text","text":" "},{"type":"text","text":"preferred in this situation if feasible. A regular staff is the standard default staff-type."}],"url":"\/documentation\/ivormxl\/mxlstaffdetails\/kind","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Kind"}],"kind":"symbol","title":"MXLStaffDetails.Kind","navigatorTitle":[{"kind":"identifier","text":"Kind"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails\/Kind","role":"symbol"}}}