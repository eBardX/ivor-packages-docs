{"kind":"symbol","metadata":{"modules":[{"name":"IvorMXL"}],"role":"symbol","title":"staffKind","externalID":"s:7IvorMXL15MXLStaffDetailsV9staffKindAC0F0OSgvp","symbolKind":"property","roleHeading":"Instance Property","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"staffKind","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Kind","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL15MXLStaffDetailsV4KindO"},{"text":"?","kind":"text"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlstaffdetails\/staffkind"]}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails"]]},"sections":[],"abstract":[{"type":"text","text":"The kind of staff, such as ossia, cue, editorial, regular, or alternate."}],"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"staffKind","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Kind","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails\/Kind","preciseIdentifier":"s:7IvorMXL15MXLStaffDetailsV4KindO"},{"text":"?","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Maps to a nested MusicXML ","type":"text"},{"type":"codeVoice","code":"<staff-type>"},{"text":" element.","type":"text"}]}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails\/staffKind"},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLStaffDetails/staffKind":{"kind":"symbol","url":"\/documentation\/ivormxl\/mxlstaffdetails\/staffkind","abstract":[{"text":"The kind of staff, such as ossia, cue, editorial, regular, or alternate.","type":"text"}],"role":"symbol","title":"staffKind","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails\/staffKind","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"staffKind"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Kind","preciseIdentifier":"s:7IvorMXL15MXLStaffDetailsV4KindO"},{"kind":"text","text":"?"}]},"doc://IvorMXL/documentation/IvorMXL/MXLStaffDetails/Kind":{"abstract":[{"text":"The staff-type value can be ossia, editorial, cue, alternate, or regular. An ossia staff represents music","type":"text"},{"text":" ","type":"text"},{"text":"that can be played instead of what appears on the regular staff. An editorial staff also represents musical","type":"text"},{"text":" ","type":"text"},{"text":"alternatives, but is created by an editor rather than the composer. It can be used for suggested","type":"text"},{"text":" ","type":"text"},{"text":"interpretations or alternatives from other sources. A cue staff represents music from another part. An","type":"text"},{"text":" ","type":"text"},{"text":"alternate staff shares the same music as the prior staff, but displayed differently (e.g., treble and bass","type":"text"},{"text":" ","type":"text"},{"text":"clef, standard notation and tablature). It is not included in playback. An alternate staff provides more","type":"text"},{"text":" ","type":"text"},{"text":"information to an application reading a file than encoding the same music in separate parts, so its use is","type":"text"},{"text":" ","type":"text"},{"text":"preferred in this situation if feasible. A regular staff is the standard default staff-type.","type":"text"}],"navigatorTitle":[{"text":"Kind","kind":"identifier"}],"kind":"symbol","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Kind","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails\/Kind","url":"\/documentation\/ivormxl\/mxlstaffdetails\/kind","type":"topic","title":"MXLStaffDetails.Kind"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLStaffDetails":{"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLStaffDetails","kind":"identifier"}],"title":"MXLStaffDetails","navigatorTitle":[{"text":"MXLStaffDetails","kind":"identifier"}],"abstract":[{"type":"text","text":"The staff-details element is used to indicate different types of staves. The optional number attribute"},{"type":"text","text":" "},{"type":"text","text":"specifies the staff number from top to bottom on the system, as with clef. The print-object attribute is used"},{"type":"text","text":" "},{"type":"text","text":"to indicate when a staff is not printed in a part, usually in large scores where empty parts are omitted. It"},{"type":"text","text":" "},{"type":"text","text":"is yes by default. If print-spacing is yes while print-object is no, the score is printed in cutaway format"},{"type":"text","text":" "},{"type":"text","text":"where vertical space is left for the empty part."}],"url":"\/documentation\/ivormxl\/mxlstaffdetails","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStaffDetails","role":"symbol"}}}