rt type is associated with","type":"text"},{"text":" ","type":"text"},{"text":"the left barline of the first measure in an ending. The stop and discontinue types are associated with the","type":"text"},{"text":" ","type":"text"},{"text":"right barline of the last measure in an ending. Stop is used when the ending mark concludes with a downward","type":"text"},{"text":" ","type":"text"},{"text":"jog, as is typical for first endings. Discontinue is used when there is no downward jog, as is typical for","type":"text"},{"text":" ","type":"text"},{"text":"second endings that do not conclude a piece.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLStartStopDiscontinue"}],"navigatorTitle":[{"kind":"identifier","text":"MXLStartStopDiscontinue"}],"url":"\/documentation\/ivormxl\/mxlstartstopdiscontinue"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"}}}