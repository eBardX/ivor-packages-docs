{"sections":[],"abstract":[{"text":"The start of an ending, typically associated with the left barline of the first measure.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlstartstopdiscontinue\/start"]}],"metadata":{"title":"MXLStartStopDiscontinue.start","externalID":"s:7IvorMXL23MXLStartStopDiscontinueO5startyA2CmF","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"start"}],"role":"symbol","roleHeading":"Case","modules":[{"name":"IvorMXL"}],"symbolKind":"case"},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"case"},{"text":" ","kind":"text"},{"text":"start","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"symbol","identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStartStopDiscontinue\/start","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStartStopDiscontinue"]]},"references":{"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLStartStopDiscontinue":{"title":"MXLStartStopDiscontinue","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLStartStopDiscontinue"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlstartstopdiscontinue","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStartStopDiscontinue","abstract":[{"text":"The start-stop-discontinue type is used to specify ending types. Typically, the start type is associated with","type":"text"},{"text":" ","type":"text"},{"text":"the left barline of the first measure in an ending. The stop and discontinue types are associated with the","type":"text"},{"text":" ","type":"text"},{"text":"right barline of the last measure in an ending. Stop is used when the ending mark concludes with a downward","type":"text"},{"text":" ","type":"text"},{"text":"jog, as is typical for first endings. Discontinue is used when there is no downward jog, as is typical for","type":"text"},{"text":" ","type":"text"},{"text":"second endings that do not conclude a piece.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"MXLStartStopDiscontinue"}]},"doc://IvorMXL/documentation/IvorMXL/MXLStartStopDiscontinue/start":{"url":"\/documentation\/ivormxl\/mxlstartstopdiscontinue\/start","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStartStopDiscontinue\/start","role":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"start"}],"kind":"symbol","abstract":[{"text":"The start of an ending, typically associated with the left barline of the first measure.","type":"text"}],"type":"topic","title":"MXLStartStopDiscontinue.start"}}}