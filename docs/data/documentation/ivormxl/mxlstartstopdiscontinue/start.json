{"abstract":[{"type":"text","text":"The start of an ending, typically associated with the left barline of the first measure."}],"sections":[],"metadata":{"role":"symbol","externalID":"s:7IvorMXL23MXLStartStopDiscontinueO5startyA2CmF","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"start","kind":"identifier"}],"modules":[{"name":"IvorMXL"}],"symbolKind":"case","roleHeading":"Case","title":"MXLStartStopDiscontinue.start"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"start","kind":"identifier"}],"languages":["swift"],"platforms":["macOS"]}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlstartstopdiscontinue\/start"]}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStartStopDiscontinue"]]},"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStartStopDiscontinue\/start","interfaceLanguage":"swift"},"references":{"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLStartStopDiscontinue/start":{"abstract":[{"text":"The start of an ending, typically associated with the left barline of the first measure.","type":"text"}],"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"start","kind":"identifier"}],"title":"MXLStartStopDiscontinue.start","url":"\/documentation\/ivormxl\/mxlstartstopdiscontinue\/start","kind":"symbol","type":"topic","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStartStopDiscontinue\/start"},"doc://IvorMXL/documentation/IvorMXL/MXLStartStopDiscontinue":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStartStopDiscontinue","role":"symbol","navigatorTitle":[{"text":"MXLStartStopDiscontinue","kind":"identifier"}],"kind":"symbol","type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLStartStopDiscontinue","kind":"identifier"}],"abstract":[{"type":"text","text":"The start-stop-discontinue type is used to specify ending types. Typically, the start type is associated with"},{"type":"text","text":" "},{"type":"text","text":"the left barline of the first measure in an ending. The stop and discontinue types are associated with the"},{"text":" ","type":"text"},{"type":"text","text":"right barline of the last measure in an ending. Stop is used when the ending mark concludes with a downward"},{"text":" ","type":"text"},{"type":"text","text":"jog, as is typical for first endings. Discontinue is used when there is no downward jog, as is typical for"},{"type":"text","text":" "},{"type":"text","text":"second endings that do not conclude a piece."}],"url":"\/documentation\/ivormxl\/mxlstartstopdiscontinue","title":"MXLStartStopDiscontinue"}}}