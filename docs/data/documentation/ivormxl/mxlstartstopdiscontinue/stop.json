{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"stop","kind":"identifier"}],"languages":["swift"],"platforms":["macOS"]}]}],"kind":"symbol","schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"symbolKind":"case","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"stop","kind":"identifier"}],"modules":[{"name":"IvorMXL"}],"title":"MXLStartStopDiscontinue.stop","externalID":"s:7IvorMXL23MXLStartStopDiscontinueO4stopyA2CmF","roleHeading":"Case","role":"symbol"},"abstract":[{"text":"The end of an ending that concludes with a downward jog, as is typical for first endings.","type":"text"}],"variants":[{"paths":["\/documentation\/ivormxl\/mxlstartstopdiscontinue\/stop"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStartStopDiscontinue\/stop","interfaceLanguage":"swift"},"sections":[],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStartStopDiscontinue"]]},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLStartStopDiscontinue/stop":{"url":"\/documentation\/ivormxl\/mxlstartstopdiscontinue\/stop","kind":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"stop","kind":"identifier"}],"abstract":[{"type":"text","text":"The end of an ending that concludes with a downward jog, as is typical for first endings."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStartStopDiscontinue\/stop","title":"MXLStartStopDiscontinue.stop","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLStartStopDiscontinue":{"fragments":[{"kind":"keyword","text":"enum"},{"text":" ","kind":"text"},{"kind":"identifier","text":"MXLStartStopDiscontinue"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStartStopDiscontinue","title":"MXLStartStopDiscontinue","kind":"symbol","navigatorTitle":[{"text":"MXLStartStopDiscontinue","kind":"identifier"}],"abstract":[{"type":"text","text":"The start-stop-discontinue type is used to specify ending types. Typically, the start type is associated with"},{"type":"text","text":" "},{"text":"the left barline of the first measure in an ending. The stop and discontinue types are associated with the","type":"text"},{"type":"text","text":" "},{"text":"right barline of the last measure in an ending. Stop is used when the ending mark concludes with a downward","type":"text"},{"type":"text","text":" "},{"text":"jog, as is typical for first endings. Discontinue is used when there is no downward jog, as is typical for","type":"text"},{"type":"text","text":" "},{"type":"text","text":"second endings that do not conclude a piece."}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlstartstopdiscontinue"}}}