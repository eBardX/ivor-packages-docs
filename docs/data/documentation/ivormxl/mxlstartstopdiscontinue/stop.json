{"kind":"symbol","metadata":{"modules":[{"name":"IvorMXL"}],"role":"symbol","externalID":"s:7IvorMXL23MXLStartStopDiscontinueO4stopyA2CmF","symbolKind":"case","roleHeading":"Case","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"stop","kind":"identifier"}],"title":"MXLStartStopDiscontinue.stop"},"abstract":[{"type":"text","text":"The end of an ending that concludes with a downward jog, as is typical for first endings."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlstartstopdiscontinue\/stop"]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"stop","kind":"identifier"}],"languages":["swift"]}],"kind":"declarations"}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStartStopDiscontinue\/stop"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStartStopDiscontinue"]]},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLStartStopDiscontinue/stop":{"kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"The end of an ending that concludes with a downward jog, as is typical for first endings."}],"url":"\/documentation\/ivormxl\/mxlstartstopdiscontinue\/stop","type":"topic","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"stop","kind":"identifier"}],"title":"MXLStartStopDiscontinue.stop","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStartStopDiscontinue\/stop"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLStartStopDiscontinue":{"type":"topic","title":"MXLStartStopDiscontinue","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStartStopDiscontinue","abstract":[{"text":"The start-stop-discontinue type is used to specify ending types. Typically, the start type is associated with","type":"text"},{"text":" ","type":"text"},{"text":"the left barline of the first measure in an ending. The stop and discontinue types are associated with the","type":"text"},{"text":" ","type":"text"},{"text":"right barline of the last measure in an ending. Stop is used when the ending mark concludes with a downward","type":"text"},{"text":" ","type":"text"},{"text":"jog, as is typical for first endings. Discontinue is used when there is no downward jog, as is typical for","type":"text"},{"text":" ","type":"text"},{"text":"second endings that do not conclude a piece.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLStartStopDiscontinue"}],"navigatorTitle":[{"kind":"identifier","text":"MXLStartStopDiscontinue"}],"url":"\/documentation\/ivormxl\/mxlstartstopdiscontinue"}}}