{"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"externalID":"s:7IvorMXL23MXLStartStopDiscontinueO4stopyA2CmF","title":"MXLStartStopDiscontinue.stop","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"stop"}],"symbolKind":"case","roleHeading":"Case","role":"symbol","modules":[{"name":"IvorMXL"}]},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlstartstopdiscontinue\/stop"]}],"abstract":[{"type":"text","text":"The end of an ending that concludes with a downward jog, as is typical for first endings."}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStartStopDiscontinue"]]},"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStartStopDiscontinue\/stop"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"stop"}],"platforms":["macOS"]}],"kind":"declarations"}],"references":{"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLStartStopDiscontinue/stop":{"type":"topic","title":"MXLStartStopDiscontinue.stop","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"stop","kind":"identifier"}],"abstract":[{"type":"text","text":"The end of an ending that concludes with a downward jog, as is typical for first endings."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStartStopDiscontinue\/stop","kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlstartstopdiscontinue\/stop"},"doc://IvorMXL/documentation/IvorMXL/MXLStartStopDiscontinue":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLStartStopDiscontinue","role":"symbol","navigatorTitle":[{"text":"MXLStartStopDiscontinue","kind":"identifier"}],"kind":"symbol","type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLStartStopDiscontinue","kind":"identifier"}],"abstract":[{"type":"text","text":"The start-stop-discontinue type is used to specify ending types. Typically, the start type is associated with"},{"type":"text","text":" "},{"type":"text","text":"the left barline of the first measure in an ending. The stop and discontinue types are associated with the"},{"text":" ","type":"text"},{"type":"text","text":"right barline of the last measure in an ending. Stop is used when the ending mark concludes with a downward"},{"text":" ","type":"text"},{"type":"text","text":"jog, as is typical for first endings. Discontinue is used when there is no downward jog, as is typical for"},{"type":"text","text":" "},{"type":"text","text":"second endings that do not conclude a piece."}],"url":"\/documentation\/ivormxl\/mxlstartstopdiscontinue","title":"MXLStartStopDiscontinue"}}}