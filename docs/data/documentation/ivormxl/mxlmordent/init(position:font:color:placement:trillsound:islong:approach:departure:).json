 and wavy lines. The default choices are:"}],"type":"paragraph"}]},{"name":"isLong","content":[{"inlineContent":[{"type":"text","text":"A Boolean value indicating whether this is a long mordent or inverted-mordent sign. Defaults to "},{"code":"false","type":"codeVoice"},{"type":"text","text":" if not specified."}],"type":"paragraph"}]},{"name":"approach","content":[{"inlineContent":[{"type":"text","text":"The approach and departure attributes are used for compound ornaments, indicating how the beginning and ending of the ornament look relative to the main part of the mordent."}],"type":"paragraph"}]},{"name":"departure","content":[{"inlineContent":[{"type":"text","text":"The approach and departure attributes are used for compound ornaments, indicating how the beginning and ending of the ornament look relative to the main part of the mordent."}],"type":"paragraph"}]}],"kind":"parameters"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlmordent\/init(position:font:color:placement:trillsound:islong:approach:departure:)"]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLAboveBelow":{"title":"MXLAboveBelow","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLAboveBelow"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlabovebelow","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAboveBelow","abstract":[{"text":"The above-below type is used to indicate whether one element appears above or below another element.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"MXLAboveBelow"}]},"doc://IvorMXL/documentation/IvorMXL/MXLPosition":{"title":"MXLPosition","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPosition"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivormxl\/mxlpo