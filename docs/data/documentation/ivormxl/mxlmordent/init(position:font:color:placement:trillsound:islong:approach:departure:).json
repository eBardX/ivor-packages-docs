aph"}],"name":"trillSound"},{"content":[{"inlineContent":[{"text":"A Boolean value indicating whether this is a long mordent or inverted-mordent sign. Defaults to ","type":"text"},{"type":"codeVoice","code":"false"},{"text":" if not specified.","type":"text"}],"type":"paragraph"}],"name":"isLong"},{"content":[{"inlineContent":[{"text":"The approach and departure attributes are used for compound ornaments, indicating how the beginning and ending of the ornament look relative to the main part of the mordent.","type":"text"}],"type":"paragraph"}],"name":"approach"},{"content":[{"inlineContent":[{"text":"The approach and departure attributes are used for compound ornaments, indicating how the beginning and ending of the ornament look relative to the main part of the mordent.","type":"text"}],"type":"paragraph"}],"name":"departure"}]}],"variants":[{"paths":["\/documentation\/ivormxl\/mxlmordent\/init(position:font:color:placement:trillsound:islong:approach:departure:)"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"Creates a new ","type":"text"},{"code":"MXLMordent","type":"codeVoice"},{"text":".","type":"text"}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLColor","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","title":"MXLColor","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlcol