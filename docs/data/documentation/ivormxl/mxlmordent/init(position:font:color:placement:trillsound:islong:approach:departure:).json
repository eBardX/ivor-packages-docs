element, such as a note or a notation.","type":"text"}]}],"name":"placement"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The trill-sound attribute group includes attributes used to guide the sound of trills, mordents, turns, shakes, and wavy lines. The default choices are:","type":"text"}]}],"name":"trillSound"},{"content":[{"type":"paragraph","inlineContent":[{"text":"A Boolean value indicating whether this is a long mordent or inverted-mordent sign. Defaults to ","type":"text"},{"type":"codeVoice","code":"false"},{"text":" if not specified.","type":"text"}]}],"name":"isLong"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The approach and departure attributes are used for compound ornaments, indicating how the beginning and ending of the ornament look relative to the main part of the mordent.","type":"text"}]}],"name":"approach"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The approach and departure attributes are used for compound ornaments, indicating how the beginning and ending of the ornament look relative to the main part of the mordent.","type":"text"}]}],"name":"departure"}]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLTrillSound":{"kind":"symbol","title":"MXLTrillSound","url":"\/documentation\/ivormxl\/mxltrillsound","role":"symbol","abstract":[{"text":"The trill-sound attribute group includes attributes used to guide the sound of trills, mordents, turns,","type":"text"},{"text":" ","type":"text"},{"text":"shakes, and wavy lines. The default choices are:","type":"text"}],"navigatorTitle":[{"text":"MXLTrillSound","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTrillSound","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTrillSound","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLMordent":{"abstract":[{"text":"The mordent type represents both the mordent sign with the vertical line and the inverted-mordent sign without","type":"text"},{"text":" ","type":"text"},{"text":"the line. The long attribute is “no” by default. The approach and departure attributes are used for compound","type":"text"},{"text":" ","type":"text"},{"text":"ornaments, indicating how the beginning and ending of the ornament look relative to the main part of the","type":"text"},{"text":" ","type":"text"},{"text":"mordent.","type":"text"}],"navigatorTitle":[{"text":"MXLMordent","kind":"identifier"}],"kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLMordent","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMordent","url":"\/documentation\/ivormxl\/mxlmordent","type":"topic","title":"MXLMordent"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLAboveBelow":{"title":"MXLAboveBelow","type":"topic","fragments":[{"kind":"keyword","text":"enum"},{"text":" ","kind":"text"},{"kind":"identifier","text":"MXLAboveBelow"}],"url":"\/documentation\/ivormxl\/mxlabovebelow","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAboveBelow","role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLAboveBelow"}],"abstract":[{"type":"text","text":"The above-below type is used to indicate whether one element appears above or below another element."}]},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlcolor","title":"MXLColor","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"type":"text","text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is"},{"type":"text","text":" "},{"type":"text","text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor"},"doc://IvorMXL/documentation/IvorMXL/MXLFont":{"title":"MXLFont","url":"\/documentation\/ivormxl\/mxlfont","role":"symbol","navigatorTitle":[{"text":"MXLFont","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","abstract":[{"text":"The font attribute group gathers together attributes for determining the font within a credit or direction.","type":"text"},{"text":" ","type":"text"},{"text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric"},{"type":"text","text":" "},{"type":"text","text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font"},{"type":"text","text":" "},{"type":"text","text":"vs. a music font."}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLFont","kind":"identifier"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLMordent/init(position:font:color:placement:trillSound:isLong:approach:departure:)":{"title":"init(position:font:color:placement:trillSound:isLong:approach:departure:)","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMordent\/init(position:font:color:placement:trillSound:isLong:approach:departure:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"