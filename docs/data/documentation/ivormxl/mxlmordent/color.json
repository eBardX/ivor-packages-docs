color"},"doc://IvorMXL/documentation/IvorMXL/MXLMordent":{"type":"topic","abstract":[{"type":"text","text":"The mordent type represents both the mordent sign with the vertical line and the inverted-mordent sign without"},{"type":"text","text":" "},{"type":"text","text":"the line. The long attribute is “no” by default. The approach and departure attributes are used for compound"},{"type":"text","text":" "},{"type":"text","text":"ornaments, indicating how the beginning and ending of the ornament look relative to the main part of the"},{"type":"text","text":" "},{"type":"text","text":"mordent."}],"url":"\/documentation\/ivormxl\/mxlmordent","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLMordent"}],"kind":"symbol","title":"MXLMordent","navigatorTitle":[{"kind":"identifier","text":"MXLMordent"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMordent","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"type":"topic","abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"type":"text","text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is"},{"type":"text","text":" "},{"type":"text","text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF."}],"url":"\/documentation\/ivormxl\/mxlcolor","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"kind":"symbol","title":"MXLColor","navigatorTitle":[{"kind":"identifier","text":"MXLColor"