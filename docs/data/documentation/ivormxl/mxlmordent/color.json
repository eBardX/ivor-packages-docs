{"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"role":"symbol","modules":[{"name":"IvorMXL"}],"roleHeading":"Instance Property","title":"color","symbolKind":"property","externalID":"s:7IvorMXL10MXLMordentV5colorAA8MXLColorVSgvp","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"color","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLColor","preciseIdentifier":"s:7IvorMXL8MXLColorV","kind":"typeIdentifier"},{"text":"?","kind":"text"}]},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"color","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLColor","preciseIdentifier":"s:7IvorMXL8MXLColorV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"platforms":["macOS"]}]}],"sections":[],"abstract":[{"type":"text","text":"The color attribute group indicates the color of an element."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlmordent\/color"]}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMordent\/color","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMordent"]]},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLColor","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","title":"MXLColor","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlcolor"},"doc://IvorMXL/documentation/IvorMXL/MXLMordent":{"kind":"symbol","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMordent","abstract":[{"type":"text","text":"The mordent type represents both the mordent sign with the vertical line and the inverted-mordent sign without"},{"type":"text","text":" "},{"type":"text","text":"the line. The long attribute is “no” by default. The approach and departure attributes are used for compound"},{"type":"text","text":" "},{"type":"text","text":"ornaments, indicating how the beginning and ending of the ornament look relative to the main part of the"},{"type":"text","text":" "},{"type":"text","text":"mordent."}],"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLMordent"}],"title":"MXLMordent","url":"\/documentation\/ivormxl\/mxlmordent","navigatorTitle":[{"kind":"identifier","text":"MXLMordent"}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLMordent/color":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"color","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLColor","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLColorV"},{"text":"?","kind":"text"}],"url":"\/documentation\/ivormxl\/mxlmordent\/color","abstract":[{"text":"The color attribute group indicates the color of an element.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/docume