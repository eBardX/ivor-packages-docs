ext"}]},"doc://IvorMXL/documentation/IvorMXL/MXLMordent":{"abstract":[{"text":"The mordent type represents both the mordent sign with the vertical line and the inverted-mordent sign without","type":"text"},{"text":" ","type":"text"},{"text":"the line. The long attribute is “no” by default. The approach and departure attributes are used for compound","type":"text"},{"text":" ","type":"text"},{"text":"ornaments, indicating how the beginning and ending of the ornament look relative to the main part of the","type":"text"},{"text":" ","type":"text"},{"text":"mordent.","type":"text"}],"navigatorTitle":[{"text":"MXLMordent","kind":"identifier"}],"kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLMordent","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMordent","url":"\/documentation\/ivormxl\/mxlmordent","type":"topic","title":"MXLMordent"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlcolor","title":"MXLColor","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"type":"text","text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is"},{"type":"text","text":" "},{"type":"text","text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":