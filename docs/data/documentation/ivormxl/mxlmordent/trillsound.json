{"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMordent"]]},"metadata":{"role":"symbol","modules":[{"name":"IvorMXL"}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"trillSound","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLTrillSound","preciseIdentifier":"s:7IvorMXL13MXLTrillSoundV","kind":"typeIdentifier"}],"symbolKind":"property","externalID":"s:7IvorMXL10MXLMordentV10trillSoundAA08MXLTrillE0Vvp","title":"trillSound","roleHeading":"Instance Property"},"abstract":[{"type":"text","text":"The trill-sound attribute group includes attributes used to guide the sound of trills, mordents, turns,"},{"type":"text","text":" "},{"type":"text","text":"shakes, and wavy lines. The default choices are:"}],"sections":[],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"trillSound","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLTrillSound","preciseIdentifier":"s:7IvorMXL13MXLTrillSoundV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTrillSound","kind":"typeIdentifier"}],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Start-Note = “upper” trill-step = “whole” two-note-turn = “none” accelerate = “no” beats = “4”.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Second-beat and last-beat are percentages for landing on the indicated beat, with defaults of 25 and 75","type":"text"},{"text":" ","type":"text"},{"text":"respectively.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For mordent and inverted-mordent elements, the defaults are different:","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The default start-note is “main”, not “upper”. The default for beats is “3”, not “4”. The default for second-","type":"text"},{"text":" ","type":"text"},{"text":"beat is “12”, not “25”. The default for last-beat is “24”, not “75”.","type":"text"}]}]}],"kind":"symbol","variants":[{"paths":["\/documentation\/ivormxl\/mxlmordent\/trillsound"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMordent\/trillSound","interfaceLanguage":"swift"},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLMordent/trillSound":{"type":"topic","abstract":[{"type":"text","text":"The trill-sound attribute group includes attributes used to guide the sound of trills, mordents, turns,"},{"type":"text","text":" "},{"type":"text","text":"shakes, and wavy lines. The default choices are:"}],"url":"\/documentation\/ivormxl\/mxlmordent\/trillsound","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"trillSound"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL13MXLTrillSoundV","text":"MXLTrillSound"}],"kind":"symbol","title":"trillSound","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMordent\/trillSound","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLTrillSound":{"type":"topic","abstract":[{"type":"text","text":"The trill-sound attribute group includes attributes used to guide the sound of trills, mordents, turns,"},{"type":"text","text":" "},{"type":"text","text":"shakes, and wavy lines. The default choices are:"}],"url":"\/documentation\/ivormxl\/mxltrillsound","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTrillSound"}],"kind":"symbol","title":"MXLTrillSound","navigatorTitle":[{"kind":"identifier","text":"MXLTrillSound"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTrillSound","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLMordent":{"type":"topic","abstract":[{"type":"text","text":"The mordent type represents both the mordent sign with the vertical line and the inverted-mordent sign without"},{"type":"text","text":" "},{"type":"text","text":"the line. The long attribute is “no” by default. The approach and departure attributes are used for compound"},{"type":"text","text":" "},{"type":"text","text":"ornaments, indicating how the beginning and ending of the ornament look relative to the main part of the"},{"type":"text","text":" "},{"type":"text","text":"mordent."}],"url":"\/documentation\/ivormxl\/mxlmordent","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLMordent"}],"kind":"symbol","title":"MXLMordent","navigatorTitle":[{"kind":"identifier","text":"MXLMordent"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMordent","role":"symbol"}}}