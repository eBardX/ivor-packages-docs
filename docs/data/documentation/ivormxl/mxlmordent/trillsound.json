{"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"text":"The trill-sound attribute group includes attributes used to guide the sound of trills, mordents, turns,","type":"text"},{"text":" ","type":"text"},{"text":"shakes, and wavy lines. The default choices are:","type":"text"}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMordent"]]},"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMordent\/trillSound"},"metadata":{"roleHeading":"Instance Property","title":"trillSound","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"trillSound"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL13MXLTrillSoundV","text":"MXLTrillSound"}],"modules":[{"name":"IvorMXL"}],"symbolKind":"property","role":"symbol","externalID":"s:7IvorMXL10MXLMordentV10trillSoundAA08MXLTrillE0Vvp"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"trillSound"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLTrillSound","preciseIdentifier":"s:7IvorMXL13MXLTrillSoundV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTrillSound"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Start-Note = “upper” trill-step = “whole” two-note-turn = “none” accelerate = “no” beats = “4”."}]},{"inlineContent":[{"text":"Second-beat and last-beat are percentages for landing on the indicated beat, with defaults of 25 and 75","type":"text"},{"text":" ","type":"text"},{"text":"respectively.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For mordent and inverted-mordent elements, the defaults are different:"}]},{"inlineContent":[{"text":"The default start-note is “main”, not “upper”. The default for beats is “3”, not “4”. The default for second-","type":"text"},{"text":" ","type":"text"},{"text":"beat is “12”, not “25”. The default for last-beat is “24”, not “75”.","type":"text"}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/ivormxl\/mxlmordent\/trillsound"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLMordent":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlmordent","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMordent","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLMordent"}],"kind":"symbol","abstract":[{"text":"The mordent type represents both the mordent sign with the vertical line and the inverted-mordent sign without","type":"text"},{"text":" ","type":"text"},{"text":"the line. The long attribute is “no” by default. The approach and departure attributes are used for compound","type":"text"},{"text":" ","type":"text"},{"text":"ornaments, indicating how the beginning and ending of the ornament look relative to the main part of the","type":"text"},{"text":" ","type":"text"},{"text":"mordent.","type":"text"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLMordent"}],"title":"MXLMordent"},"doc://IvorMXL/documentation/IvorMXL/MXLTrillSound":{"title":"MXLTrillSound","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTrillSound"}],"navigatorTitle":[{"kind":"identifier","text":"MXLTrillSound"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTrillSound","url":"\/documentation\/ivormxl\/mxltrillsound","type":"topic","abstract":[{"text":"The trill-sound attribute group includes attributes used to guide the sound of trills, mordents, turns,","type":"text"},{"text":" ","type":"text"},{"text":"shakes, and wavy lines. The default choices are:","type":"text"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLMordent/trillSound":{"type":"topic","title":"trillSound","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"trillSound"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL13MXLTrillSoundV","text":"MXLTrillSound"}],"abstract":[{"text":"The trill-sound attribute group includes attributes used to guide the sound of trills, mordents, turns,","type":"text"},{"text":" ","type":"text"},{"text":"shakes, and wavy lines. The default choices are:","type":"text"}],"url":"\/documentation\/ivormxl\/mxlmordent\/trillsound","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLMordent\/trillSound","role":"symbol"}}}