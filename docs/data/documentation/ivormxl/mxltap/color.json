ntation/IvorMXL/MXLTap":{"abstract":[{"type":"text","text":"The tap type indicates a tap on the fretboard. The text content allows specification of the notation; + and T"},{"type":"text","text":" "},{"type":"text","text":"are common choices. If the element is empty, the hand attribute is used to specify the symbol to use. The hand"},{"type":"text","text":" "},{"type":"text","text":"attribute is ignored if the tap glyph is already specified by the text content. If neither text content nor"},{"type":"text","text":" "},{"type":"text","text":"the hand attribute are present, the display is application-specific."}],"title":"MXLTap","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTap"}],"navigatorTitle":[{"kind":"identifier","text":"MXLTap"}],"type":"topic","url":"\/documentation\/ivormxl\/mxltap","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTap"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"abstract":[{"text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in","type":"text"},{"type":"text","text":" "},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"title":"MXLColor","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlcolor","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor"},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation