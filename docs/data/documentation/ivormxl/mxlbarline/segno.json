"text":": ","kind":"text"},{"text":"MXLSegno","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLSegnoV"},{"text":"?","kind":"text"}],"kind":"symbol","role":"symbol","title":"segno","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/segno"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlbarline","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLBarline"}],"abstract":[{"type":"text","text":"If a barline is other than a normal single barline, it should be represented by a barline type that describes"},{"type":"text","text":" "},{"type":"text","text":"it. This includes information about repeats and multiple endings, as well as line style. Barline data is on"},{"type":"text","text":" "},{"type":"text","text":"the same level as the other musical data in a score — a child of a measure in a partwise score, or a part in a"},{"type":"text","text":" "},{"type":"text","text":"timewise score. This allows for barlines within measures, as in dotted barlines that subdivide measures in"},{"type":"text","text":" "},{"type":"text","text":"complex meters. The two fermata elements allow for fermatas on both sides of the barline (the lower one"},{"type":"text","text":" "},{"type":"text","text":"inverted)."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLBarline"}],"title":"MXLBarline"},"doc://IvorMXL/documentation/IvorMXL/MXLSegno":{"url":"\/documentation\/ivormxl\/mxlsegno","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSegno","title":"MXLSegno","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The segno type is the visual indicator of a segno sign. The exact glyph can be specified with the smufl"},{"type":"text","text":" "},{"type":"text","text":"attribute. A sound element is also needed to guide playback applications reliably."}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSegno","kind":"identifier"}],"navigatorTitle":[{"text":"MXLSegno","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"}}}