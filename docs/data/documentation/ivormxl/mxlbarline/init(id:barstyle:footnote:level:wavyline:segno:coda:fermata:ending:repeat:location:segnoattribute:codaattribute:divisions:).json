 associated with this barline."}]}]},{"name":"repeat","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The repeat mark associated with this barline."}]}]},{"name":"location","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Defaults to "},{"type":"codeVoice","code":"right"},{"type":"text","text":"."}]}]},{"name":"segnoAttribute","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Used the same way as the segno attribute of the sound element, to name and distinguish forward jumps to a segno sign for playback."}]}]},{"name":"codaAttribute","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Used the same way as the coda attribute of the sound element, to name and distinguish forward jumps to a coda sign for playback."}]}]},{"name":"divisions","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Used the same way as the divisions attribute of the sound element, to indicate the number of divisions per quarter note for playback when this barline contains a segno or coda child element."}]}]}],"kind":"parameters"}],"metadata":{"role":"symbol","externalID":"s:7IvorMXL10MXLBarlineV2id8barStyle8footnote5level8wavyLine5segno4coda7fermata6ending6repeat8location0K9Attribute0lQ09divisionsACSSSg_AC0F5ColorVSgAA16MXLFormattedTextVSgAA8MXLLevelVSgAA07MXLWavyJ0VSgAA8MXLSegnoVSgAA7MXLCodaVSgSayAA10MXLFermataVGAA9MXLEndingVSgAA9MXLRepeatVSgAA18MXLRightLeftMiddleOSgA2rA12MXLDivisionsVSgtcfc","symbolKind":"init","roleHeading":"Initializer","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"id"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"barStyle"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"StyleColor","preciseIdentifier":"s:7IvorMXL10MXLBarlineV10StyleColorV"},{"kind":"text","text":"?, "},{"kind":"extern