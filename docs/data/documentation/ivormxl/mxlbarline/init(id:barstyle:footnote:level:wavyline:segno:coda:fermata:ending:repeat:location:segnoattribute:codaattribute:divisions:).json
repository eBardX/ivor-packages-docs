doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDivisions","preciseIdentifier":"s:7IvorMXL12MXLDivisionsV"},{"text":"? = nil)","kind":"text"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"id","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The optional-unique-id attribute group allows an element to optionally specify an ID that is unique to the entire document. This attribute group is not used for a required id attribute, or for an id attribute that specifies an id reference."}]}]},{"name":"barStyle","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The style and color of the barline."}]}]},{"name":"footnote","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The footnote element specifies editorial information that appears in footnotes in the printed score. It is defined within a group due to its multiple uses within the MusicXML schema."}]}]},{"name":"level","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The level element specifies editorial information for different MusicXML elements. It is defined within a group due to its multiple uses within the MusicXML schema."}]}]},{"name":"wavyLine","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A wavy line associated with the barline, such as for a trill or vibrato that continues across it."}]}]},{"name":"segno","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The visual indicator of a segno sign appearing at this barline."}]}]},{"name":"coda","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The visual indicator of a coda sign appearing at this barline."}]}]},{"name":"fermata","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The fermata signs on either side of the barline, allowing fermatas on both sides (the lower one inverted)."}]}]},{"name":"ending","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The multiple-ending bracket associated with this barline."}]}]},{"name":"repeat","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The repeat mark associated with this barline."}]}]},{"name":"location","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Defaults to "},{"type":"codeVoice","code":"right"},{"type":"text","text":"."}]}]},{"name":"segnoAttribute","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Used the same way as the segno attribute of the sound element, to name and distinguish forward jumps to a segno sign for playback."}]}]},{"name":"codaAttribute","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Used the same way as the coda attribute of the sound element, to name and distinguish forward jumps to a coda sign for playback."}]}]},{"name":"divisions","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Used the same way as the divisions attribute of the sound element, to indicate the number of divisions per quarter note for playback when this barline contains a segno or coda child element."}]}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlbarline\/init(id:barstyle:footnote:level:wavyline:segno:coda:fermata:ending:repeat:location:segnoattribute:codaattribute:divisions:)"]}],"metadata":{"modules":[{"name":"IvorMXL"}],"fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?, ","kind":"text"},{"text":"barStyle","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"StyleColor","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL10MXLBarlineV10StyleColorV"},{"text":"?, ","kind":"text"},{"text":"footnote","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLFormattedText","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL16MXLFormattedTextV"},{"text":"?, ","kind":"text"},{"text":"level","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLLevel","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLLevelV"},{"text":"?, ","kind":"text"},{"text":"wavyLine","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLWavyLine","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLWavyLineV"},{"text":"?, ","kind":"text"},{"text":"segno","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLSegno","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLSegnoV"},{"text":"?, ","kind":"text"},{"text":"coda","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLCoda","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL7MXLCodaV"},{"text":"?, ","kind":"text"},{"text":"fermata","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"MXLFermata","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL10MXLFermataV"},{"text":"], ","kind":"text"},{"text":"ending","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLEnding","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLEndingV"},{"text":"?, ","kind":"text"},{"text":"repeat","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLRepeat","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLRepeatV"},{"text":"?, ","kind":"text"},{"text":"location","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLRightLeftMiddle","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL18MXLRightLeftMiddleO"},{"text":"?, ","kind":"text"},{"text":"segnoAttribute","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"codaAttribute","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"divisions","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL12MXLDivisionsV","text":"MXLDivisions","kind":"typeIdentifier"},{"text":"?)","kind":"text"}],"title":"init(id:barStyle:footnote:level:wavyLine:segno:coda:fermata:ending:repeat:location:segnoAttribute:codaAttribute:divisions:)","roleHeading":"Initializer","externalID":"s:7IvorMXL10MXLBarlineV2id8barStyle8footnote5level8wavyLine5segno4coda7fermata6ending6repeat8location0K9Attribute0lQ09divisionsACSSSg_AC0F5ColorVSgAA16MXLFormattedTextVSgAA8MXLLevelVSgAA07MXLWavyJ0VSgAA8MXLSegnoVSgAA7MXLCodaVSgSayAA10MXLFermataVGAA9MXLEndingVSgAA9MXLRepeatVSgAA18MXLRightLeftMiddleOSgA2rA12MXLDivisionsVSgtcfc","role":"symbol","symbolKind":"init"},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLFormattedText":{"navigatorTitle":[{"kind":"identifier","text":"MXLFormattedText"}],"url":"\/documentation\/ivormxl\/mxlformattedtext","kind":"symbol","type":"topic","role":"symbol","title":"MXLFormattedText","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFormattedText","abstract":[{"text":"The formatted-text type represents a text element with text-formatting attributes.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFormattedText"}]},"doc://IvorMXL/documentation/IvorMXL/MXLDivisions":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDivisions","role":"symbol","navigatorTitle":[{"text":"MXLDivisions","kind":"identifier"}],"type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLDivisions","kind":"identifier"}],"abstract":[{"type":"text","text":"The divisions type is used to express values in terms of the musical divisions defined by the divisions"},{"type":"text","text":" "},{"type":"text","text":"element. It is preferred that these be integer values both for MIDI interoperability and to avoid roundoff"},{"type":"text","text":" "},{"type":"text","text":"errors."}],"url":"\/documentation\/ivormxl\/mxldivisions","title":"MXLDivisions"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/StyleColor":{"navigatorTitle":[{"kind":"identifier","text":"StyleColor"}],"url":"\/documentation\/ivormxl\/mxlbarline\/stylecolor","kind":"symbol","type":"topic","role":"symbol","title":"MXLBarline.StyleColor","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/StyleColor","abstract":[{"text":"The bar-style-color type contains barline style and color information.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"StyleColor"}]},"doc://IvorMXL/documentation/IvorMXL/MXLWavyLine":{"type":"topic","url":"\/documentation\/ivormxl\/mxlwavyline","role":"symbol","title":"MXLWavyLine","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLWavyLine","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLWavyLine","kind":"identifier"}],"abstract":[{"text":"Wavy lines are one way to indicate trills and vibrato. When used with a barline element, they should always","type":"text"},{"text":" ","type":"text"},{"text":"have type=“continue” set. The smufl attribute specifies a particular wavy line glyph from the SMuFL Multi-","type":"text"},{"text":" ","type":"text"},{"text":"segment lines range.","type":"text"}],"navigatorTitle":[{"text":"MXLWavyLine","kind":"identifier"}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLEnding":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding","role":"symbol","navigatorTitle":[{"text":"MXLEnding","kind":"identifier"}],"type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLEnding","kind":"identifier"}],"abstract":[{"type":"text","text":"The ending type represents multiple (e.g. first and second) endings. Typically, the start type is associated"},{"type":"text","text":" "},{"type":"text","text":"with the left barline of the first measure in an ending. The stop and discontinue types are associated with"},{"type":"text","text":" "},{"type":"text","text":"the right barline of the last measure in an ending. Stop is used when the ending mark concludes with a"},{"type":"text","text":" "},{"type":"text","text":"downward jog, as is typical for first endings. Discontinue is used when there is no downward jog, as is"},{"type":"text","text":" "},{"type":"text","text":"typical for second endings that do not conclude a piece. The length of the jog can be specified using the end-"},{"type":"text","text":" "},{"type":"text","text":"length attribute. The text-x and text-y attributes are offsets that specify where the baseline of the start of"},{"type":"text","text":" "},{"type":"text","text":"the ending text appears, relative to the start of the ending line."}],"url":"\/documentation\/ivormxl\/mxlending","title":"MXLEnding"},"doc://IvorMXL/documentation/IvorMXL/MXLCoda":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlcoda","title":"MXLCoda","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLCoda"}],"navigatorTitle":[{"kind":"identifier","text":"MXLCoda"}],"abstract":[{"text":"The coda type is the visual indicator of a coda sign. The exact glyph can be specified with the smufl","type":"text"},{"text":" ","type":"text"},{"text":"attribute. A sound element is also needed to guide playback applications reliably.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCoda"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/init(id:barStyle:footnote:level:wavyLine:segno:coda:fermata:ending:repeat:location:segnoAttribute:codaAttribute:divisions:)":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/init(id:barStyle:footnote:level:wavyLine:segno:coda:fermata:ending:repeat:location:segnoAttribute:codaAttribute:divisions:)","role":"symbol","type":"topic","kind":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"barStyle","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"StyleColor","preciseIdentifier":"s:7IvorMXL10MXLBarlineV10StyleColorV","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"footnote","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLFormattedText","preciseIdentifier":"s:7IvorMXL16MXLFormattedTextV","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"level","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLLevel","preciseIdentifier":"s:7IvorMXL8MXLLevelV","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"wavyLine","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLWavyLine","preciseIdentifier":"s:7IvorMXL11MXLWavyLineV","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"segno","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLSegno","preciseIdentifier":"s:7IvorMXL8MXLSegnoV","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"coda","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLCoda","preciseIdentifier":"s:7IvorMXL7MXLCodaV","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"fermata","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"MXLFermata","preciseIdentifier":"s:7IvorMXL10MXLFermataV","kind":"typeIdentifier"},{"text":"], ","kind":"text"},{"text":"ending","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLEnding","preciseIdentifier":"s:7IvorMXL9MXLEndingV","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"repeat","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLRepeat","preciseIdentifier":"s:7IvorMXL9MXLRepeatV","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"location","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLRightLeftMiddle","preciseIdentifier":"s:7IvorMXL18MXLRightLeftMiddleO","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"segnoAttribute","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"codaAttribute","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"divisions","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLDivisions","preciseIdentifier":"s:7IvorMXL12MXLDivisionsV","kind":"typeIdentifier"},{"text":"?)","kind":"text"}],"abstract":[{"type":"text","text":"Creates a new "},{"code":"MXLBarline","type":"codeVoice"},{"type":"text","text":"."}],"url":"\/documentation\/ivormxl\/mxlbarline\/init(id:barstyle:footnote:level:wavyline:segno:coda:fermata:ending:repeat:location:segnoattribute:codaattribute:divisions:)","title":"init(id:barStyle:footnote:level:wavyLine:segno:coda:fermata:ending:repeat:location:segnoAttribute:codaAttribute:divisions:)"},"doc://IvorMXL/documentation/IvorMXL/MXLFermata":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlfermata","title":"MXLFermata","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLFermata","kind":"identifier"}],"navigatorTitle":[{"text":"MXLFermata","kind":"identifier"}],"abstract":[{"type":"text","text":"The fermata text content represents the shape of the fermata sign. An empty fermata element represents a"},{"type":"text","text":" "},{"type":"text","text":"normal fermata. The fermata type is upright if not specified."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFermata"},"doc://IvorMXL/documentation/IvorMXL/MXLRepeat":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRepeat","role":"symbol","navigatorTitle":[{"text":"MXLRepeat","kind":"identifier"}],"type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLRepeat","kind":"identifier"}],"abstract":[{"type":"text","text":"The repeat type represents repeat marks. The start of the repeat has a forward direction while the end of the"},{"type":"text","text":" "},{"type":"text","text":"repeat has a backward direction. The times and after-jump attributes are only used with backward repeats that"},{"type":"text","text":" "},{"type":"text","text":"are not part of an ending. The times attribute indicates the number of times the repeated section is played."},{"type":"text","text":" "},{"type":"text","text":"The after-jump attribute indicates if the repeats are played after a jump due to a da capo or dal segno."}],"url":"\/documentation\/ivormxl\/mxlrepeat","title":"MXLRepeat"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLBarline"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLBarline"}],"title":"MXLBarline","abstract":[{"type":"text","text":"If a barline is other than a normal single barline, it should be represented by a barline type that describes"},{"type":"text","text":" "},{"type":"text","text":"it. This includes information about repeats and multiple endings, as well as line style. Barline data is on"},{"type":"text","text":" "},{"type":"text","text":"the same level as the other musical data in a score — a child of a measure in a partwise score, or a part in a"},{"type":"text","text":" "},{"type":"text","text":"timewise score. This allows for barlines within measures, as in dotted barlines that subdivide measures in"},{"type":"text","text":" "},{"type":"text","text":"complex meters. The two fermata elements allow for fermatas on both sides of the barline (the lower one"},{"type":"text","text":" "},{"type":"text","text":"inverted)."}],"url":"\/documentation\/ivormxl\/mxlbarline"},"doc://IvorMXL/documentation/IvorMXL/MXLLevel":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxllevel","title":"MXLLevel","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLLevel"}],"navigatorTitle":[{"kind":"identifier","text":"MXLLevel"}],"abstract":[{"text":"The level type is used to specify editorial information for different MusicXML elements. The content contains","type":"text"},{"text":" ","type":"text"},{"text":"identifying and\/or descriptive text about the editorial status of the parent element.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLevel"},"doc://IvorMXL/documentation/IvorMXL/MXLSegno":{"title":"MXLSegno","url":"\/documentation\/ivormxl\/mxlsegno","abstract":[{"type":"text","text":"The segno type is the visual indicator of a segno sign. The exact glyph can be specified with the smufl"},{"type":"text","text":" "},{"type":"text","text":"attribute. A sound element is also needed to guide playback applications reliably."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSegno","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"MXLSegno","kind":"identifier"}],"type":"topic","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSegno"},"doc://IvorMXL/documentation/IvorMXL/MXLRightLeftMiddle":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlrightleftmiddle","title":"MXLRightLeftMiddle","fragments":[{"text":"enum","kind":"keyword"},{"kind":"text","text":" "},{"text":"MXLRightLeftMiddle","kind":"identifier"}],"navigatorTitle":[{"text":"MXLRightLeftMiddle","kind":"identifier"}],"abstract":[{"type":"text","text":"The right-left-middle type is used to specify barline location."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRightLeftMiddle"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]}}}