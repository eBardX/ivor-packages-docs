,{"type":"text","text":" "},{"type":"text","text":"required id attribute, or for an id attribute that specifies an id reference."}]}]},{"name":"barStyle","content":[{"type":"paragraph","inlineContent":[{"text":"The style and color of the barline.","type":"text"}]}]},{"name":"footnote","content":[{"type":"paragraph","inlineContent":[{"text":"The footnote element specifies editorial information that appears in footnotes in","type":"text"},{"text":" ","type":"text"},{"text":"the printed score. It is defined within a group due to its multiple uses within the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"MusicXML schema."}]}]},{"name":"level","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The level element specifies editorial information for different MusicXML elements."},{"type":"text","text":" "},{"type":"text","text":"It is defined within a group due to its multiple uses within the MusicXML schema."}]}]},{"name":"wavyLine","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A wavy line associated with the barline, such as for a trill or vibrato that"},{"type":"text","text":" "},{"type":"text","text":"continues across it."}]}]},{"name":"segno","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The visual indicator of a segno sign appearing at this barline."}]}]},{"name":"coda","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The visual indicator of a coda sign appearing at this barline."}]}]},{"name":"fermata","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The fermata signs on either side of the barline, allowing fermatas on both sides"},{"type":"text","text":" "},{"type":"text","text":"(the lower one inverted)."}]}]},{"name":"ending","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The multiple-ending bracket associated with this barline."}]}]},{"name":"repeat","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The repeat mark associated with this barline."}]}]},{"name":"location","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Defaults to "},{"type":"codeVoice","code":"right"},{"type":"text","text":"."}]}]},{"name":"segnoAttribute","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Used the same way as the segno attribute of the sound element, to name and"},{"type":"text","text":" "},{"type":"text","text":"distinguish forward jumps to a segno sign for playback."}]}]},{"name":"codaAttribute","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Used the same way as the coda attribute of the sound element, to name and"},{"type":"text","text":" "},{"type":"text","text":"distinguish forward jumps to a coda sign for playback."}]}]},{"name":"divisions","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Used the same way as the divisions attribute of the sound element, to indicate the"},{"type":"text","text":" "},{"type":"text","text":"number of divisions per quarter note for playback when this barline contains a"},{"type":"text","text":" "},{"type":"text","text":"segno or coda child element."}]}]}],"kind":"parameters"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLBarline/init(id:barStyle:footnote:level:wavyLine:segno:coda:fermata:ending:repeat:location:segnoAttribute:codaAttribute:divisions:)":{"type":"topic","title":"init(id:barStyle:footnote:level:wavyLine:segno:coda:fermata:ending:repeat:location:segnoAttribute:codaAttribute:divisions:)","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/init(id:barStyle:footnote:level:wavyLine:segno:coda:fermata:ending:repeat:location:segnoAttribute:codaAttribute:divisions:)","abstract":[{"type":"text","text":"Creates a new "},{"code":"MXLBarline","type":"codeVoice"},{"type":"text","text":"."}],"role":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"id"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"barStyle"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL10MXLBarlineV10StyleColorV","kind":"typeIdentifier","text":"StyleColor"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"footnote"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL16MXLFormattedTextV","kind":"typeIdentifier","text":"MXLFormattedText"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"level"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL8MXLLevelV","kind":"typeIdentifier","text":"MXLLevel"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"wavyLine"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL11MXLWavyLineV","kind":"typeIdentifier","text":"MXLWavyLine"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"segno"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL8MXLSegnoV","kind":"typeIdentifier","text":"MXLSegno"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"coda"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL7MXLCodaV","kind":"typeIdentifier","text":"MXLCoda"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"fermata"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:7IvorMXL10MXLFermataV","kind":"typeIdentifier","text":"MXLFermata"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"ending"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL9MXLEndingV","kind":"typeIdentifier","text":"MXLEnding"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"repeat"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL9MXLRepeatV","kind":"typeIdentifier","text":"MXLRepeat"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"location"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL18MXLRightLeftMiddleO","kind":"typeIdentifier","text":"MXLRightLeftMiddle"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"segnoAttribute"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"codaAttribute"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"divisions"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL12MXLDivisionsV","kind":"typeIdentifier","text":"MXLDivisions"},{"kind":"text","text":"?)"}],"url":"\/documentation\/ivormxl\/mxlbarline\/init(id:barstyle:footnote:level:wavyline:segno:coda:fermata:ending:repeat:location:segnoattribute:codaattribute:divisions:)"},"doc://IvorMXL/documentation/IvorMXL/MXLDivisions":{"type":"topic","title":"MXLDivisions","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDivisions","abstract":[{"type":"text","text":"The divisions type is used to express values in terms of the musical divisions defined by the divisions"},{"type":"text","text":" "},{"type":"text","text":"element. It is preferred that these be integer values both for MIDI interoperability and to avoid roundoff"},{"type":"text","text":" "},{"type":"text","text":"errors."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLDivisions"}],"navigatorTitle":[{"kind":"identifier","text":"MXLDivisions"}],"url":"\/documentation\/ivormxl\/mxldivisions"},"doc://IvorMXL/documentation/IvorMXL/MXLWavyLine":{"type":"topic","title":"MXLWavyLine","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLWavyLine","abstract":[{"type":"text","text":"Wavy lines are one way to indicate trills and vibrato. When used with a barline element, they should always"},{"type":"text","text":" "},{"type":"text","text":"have "},{"code":"type=\"continue\"","type":"codeVoice"},{"type":"text","text":" set. The smufl attribute specifies a particular wavy line glyph from the SMuFL Multi-"},{"type":"text","text":" "},{"type":"text","text":"segment lines range."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLWavyLine"}],"navigatorTitle":[{"kind":"identifier","text":"MXLWavyLine"}],"url":"\/documentation\/ivormxl\/mxlwavyline"},"doc://IvorMXL/documentation/IvorMXL/MXLCoda":{"type":"topic","title":"MXLCoda","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCoda","abstract":[{"type":"text","text":"The coda type is the visual indicator of a coda sign. The exact glyph can be specified with the smufl"},{"type":"text","text":" "},{"type":"text","text":"attribute. A sound element is also needed to guide playback applications reliably."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLCoda"}],"navigatorTitle":[{"kind":"identifier","text":"MXLCoda"}],"url":"\/documentation\/ivormxl\/mxlcoda"},"doc://IvorMXL/documentation/IvorMXL/MXLRepeat":{"type":"topic","title":"MXLRepeat","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRepeat","abstract":[{"type":"text","text":"The repeat type represents repeat marks. The start of the repeat has a forward direction while the end of the"},{"type":"text","text":" "},{"type":"text","text":"repeat has a backward direction. The times and after-jump attributes are only used with backward repeats that"},{"type":"text","text":" "},{"type":"text","text":"are not part of an ending. The times attribute indicates the number of times the repeated section is played."},{"type":"text","text":" "},{"type":"text","text":"The after-jump attribute indicates if the repeats are played after a jump due to a da capo or dal segno."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLRepeat"}],"navigatorTitle":[{"kind":"identifier","text":"MXLRepeat"}],"url":"\/documentation\/ivormxl\/mxlrepeat"},"doc://IvorMXL/documentation/IvorMXL/MXLEnding":{"type":"topic","title":"MXLEnding","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding","abstract":[{"type":"text","text":"The ending type represents multiple (e.g. first and second) endings. Typically, the start type is associated"},{"type":"text","text":" "},{"type":"text","text":"with the left barline of the first measure in an ending. The stop and discontinue types are associated with"},{"type":"text","text":" "},{"type":"text","text":"the right barline of the last measure in an ending. Stop is used when the ending mark concludes with a"},{"type":"text","text":" "},{"type":"text","text":"downward jog, as is typical for first endings. Discontinue is used when there is no downward jog, as is"},{"type":"text","text":" "},{"type":"text","text":"typical for second endings that do not conclude a piece. The length of the jog can be specified using the end-"},{"type":"text","text":" "},{"type":"text","text":"length attribute. The text-x and text-y attributes are offsets that specify where the baseline of the start of"},{"type":"text","text":" "},{"type":"text","text":"the ending text appears, relative to the start of the ending line."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLEnding"}],"navigatorTitle":[{"kind":"identifier","text":"MXLEnding"}],"url":"\/documentation\/ivormxl\/mxlending"},"doc://IvorMXL/documentation/IvorMXL/MXLLevel":{"type":"topic","abstract":[{"type":"text","text":"The level type is used to specify editorial information for different MusicXML elements. The content contains"},{"type":"text","text":" "},{"type":"text","text":"identifying and\/or descriptive text about the editorial status of the parent element."}],"url":"\/documentation\/ivormxl\/mxllevel","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLLevel","kind":"identifier"}],"kind":"symbol","title":"MXLLevel","navigatorTitle":[{"text":"MXLLevel","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLevel","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/StyleColor":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"StyleColor"}],"abstract":[{"text":"The bar-style-color type contains barline style and color information.","type":"text"}],"title":"MXLBarline.StyleColor","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/StyleColor","role":"symbol","url":"\/documentation\/ivormxl\/mxlbarline\/stylecolor","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"StyleColor"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLRightLeftMiddle":{"type":"topic","title":"MXLRightLeftMiddle","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRightLeftMiddle","abstract":[{"type":"text","text":"The right-left-middle type is used to specify barline location."}],"role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLRightLeftMiddle"}],"navigatorTitle":[{"kind":"identifier","text":"MXLRightLeftMiddle"}],"url":"\/documentation\/ivormxl\/mxlrightleftmiddle"},"doc://IvorMXL/documentation/IvorMXL/MXLFermata":{"type":"topic","title":"MXLFermata","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFermata","abstract":[{"type":"text","text":"The fermata text content represents the shape of the fermata sign. An empty fermata element represents a"},{"type":"text","text":" "},{"type":"text","text":"normal fermata. The fermata type is upright if not specified."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFermata"}],"navigatorTitle":[{"kind":"identifier","text":"MXLFermata"}],"url":"\/documentation\/ivormxl\/mxlfermata"},"doc://IvorMXL/documentation/IvorMXL/MXLSegno":{"type":"topic","title":"MXLSegno","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSegno","abstract":[{"type":"text","text":"The segno type is the visual indicator of a segno sign. The exact glyph can be specified with the smufl"},{"type":"text","text":" "},{"type":"text","text":"attribute. A sound element is also needed to guide playback applications reliably."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLSegno"}],"navigatorTitle":[{"kind":"identifier","text":"MXLSegno"}],"url":"\/documentation\/ivormxl\/mxlsegno"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLBarline"}],"abstract":[{"text":"If a barline is other than a normal single barline, it should be represented by a barline type that describes","type":"text"},{"text":" ","type":"text"},{"text":"it. This includes information about repeats and multiple endings, as well as line style. Barline data is on","type":"text"},{"text":" ","type":"text"},{"text":"the same level as the other musical data in a score — a child of a measure in a partwise score, or a part in a","type":"text"},{"text":" ","type":"text"},{"text":"timewise score. This allows for barlines within measures, as in dotted barlines that subdivide measures in","type":"text"},{"text":" ","type":"text"},{"text":"complex meters. The two fermata elements allow for fermatas on both sides of the barline (the lower one","type":"text"},{"text":" ","type":"text"},{"text":"inverted).","type":"text"}],"title":"MXLBarline","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline","role":"symbol","url":"\/documentation\/ivormxl\/mxlbarline","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLBarline"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLFormattedText":{"type":"topic","title":"MXLFormattedText","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFormattedText","abstract":[{"type":"text","text":"The formatted-text type represents a text element with text-formatting attributes."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFormattedText"}],"navigatorTitle":[{"kind":"identifier","text":"MXLFormattedText"}],"url":"\/documentation\/ivormxl\/mxlformattedtext"}}}