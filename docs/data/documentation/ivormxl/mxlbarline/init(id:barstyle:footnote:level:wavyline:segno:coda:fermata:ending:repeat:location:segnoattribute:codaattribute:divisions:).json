ind":"externalParam","text":"codaAttribute"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"divisions"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLDivisions","preciseIdentifier":"s:7IvorMXL12MXLDivisionsV"},{"kind":"text","text":"?)"}],"title":"init(id:barStyle:footnote:level:wavyLine:segno:coda:fermata:ending:repeat:location:segnoAttribute:codaAttribute:divisions:)","url":"\/documentation\/ivormxl\/mxlbarline\/init(id:barstyle:footnote:level:wavyline:segno:coda:fermata:ending:repeat:location:segnoattribute:codaattribute:divisions:)","abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLBarline"},{"type":"text","text":"."}],"kind":"symbol","type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLWavyLine":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLWavyLine"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLWavyLine"}],"url":"\/documentation\/ivormxl\/mxlwavyline","role":"symbol","title":"MXLWavyLine","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLWavyLine","type":"topic","abstract":[{"type":"text","text":"Wavy lines are one way to indicate trills and vibrato. When used with a barline element, they should always"},{"type":"text","text":" "},{"type":"text","text":"have type=“continue” set. The smufl attribute specifies a particular wavy line glyph from the SMuFL Multi-"},{"type":"text","text":" "},{"type":"text","text":"segment lines range."}]},"doc://IvorMXL/documentation/IvorMXL/MXLSegno":{"title":"MXLSegno","url":"\/documentation\/ivormxl\/mxlsegno","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSegno","kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLSegno"}],"navigatorTitle":[{"kind":"identifier","text":"MXLSegno"}],"role":"symbol","abstract":[{"type":"text","text":"The segno type is the visual indicator of a segno sign. The exact glyph can be specified with the smufl"},{"type":"text","text":" "},{"type":"text","text":"attribute. A sound element is also needed to guide playback applications reliably."}]},"doc://IvorMXL/documentation/IvorMXL/MXLRightLeftMiddle":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLRightLeftMiddle","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRightLeftMiddle","title":"MXLRightLeftMiddle","kind":"symbol","navigatorTitle":[{"text":"MXLRightLeftMiddle","kind":"identifier"}],"abstract":[{"type":"text","text":"The right-left-middle type is used to specify barline location."}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlrightleftmiddle"},"doc://IvorMXL/documentation/IvorMXL/MXLRepeat":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLRepeat"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLRepeat"}],"url":"\/documentation\/ivormxl\/mxlrepeat","role":"symbol","title":"MXLRepeat","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRepeat","type":"topic","abstract":[{"text":"The repeat type represents repeat marks. The start of the repeat has a forward direction while the end of the","type":"text"},{"text":" ","type":"text"},{"text":"repeat has a backward direction. The times and after-jump attributes are only used with backward repeats that","type":"text"},{"text":" ","type":"text"},{"text":"are not part of an ending. The times attribute indicates the number of times the repeated section is played.","type":"text"},{"text":" ","type":"text"},{"text":"The after-jump attribute indicates if the repeats are played after a jump due to a da capo or dal segno.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLFermata":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFermata"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLFermata"}],"url":"\/documentation\/ivormxl\/mxlfermata","role":"symbol","title":"MXLFermata","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFermata","type":"topic","abstract":[{"text":"The fermata text content represents the shape of the fermata sign. An empty fermata element represents a","type":"text"},{"text":" ","type":"text"},{"text":"normal fermata. The fermata type is upright if not specified.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLCoda":{"role":"symbol","kind":"symbol","url":"\/documentation\/ivormxl\/mxlcoda","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCoda","abstract":[{"type":"text","text":"The coda type is the visual indicator of a coda sign. The exact glyph can be specified with the smufl"},{"type":"text","text":" "},{"type":"text","text":"attribute. A sound element is also needed to guide playback applications reliably."}],"type":"topic","title":"MXLCoda","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLCoda"}],"navigatorTitle":[{"kind":"identifier","text":"MXLCoda"}]},"doc://IvorMXL/documentation/IvorMXL/MXLEnding":{"type":"topic","role":"symbol","abstract":[{"type":"text","text":"The ending type represents multiple (e.g. first and second) endings. Typically, the start type is associated"},{"type":"text","text":" "},{"type":"text","text":"with the left barline of the first measure in an ending. The stop and discontinue types are associated with"},{"type":"text","text":" "},{"type":"text","text":"the right barline of the last measure in an ending. Stop is used when the ending mark concludes with a"},{"type":"text","text":" "},{"type":"text","text":"downward jog, as is typical for first endings. Discontinue is used when there is no downward jog, as is"},{"type":"text","text":" "},{"type":"text","text":"typical for second endings that do not conclude a piece. The length of the jog can be specified using the end-"},{"type":"text","text":" "},{"type":"text","text":"length attribute. The text-x and text-y attributes are offsets that specify where the baseline of the start of"},{"type":"text","text":" "},{"type":"text","text":"the ending text appears, relative to the start of the ending line."}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding","title":"MXLEnding","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLEnding"}],"navigatorTitle":[{"kind":"identifier","text":"MXLEnding"}],"url":"\/documentation\/ivormxl\/mxlending"},"doc://IvorMXL/documentation/IvorMXL/MXLLevel":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLLevel"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLLevel"}],"url":"\/documentation\/ivormxl\/mxllevel","role":"symbol","title":"MXLLevel","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLevel","type":"topic","abstract":[{"text":"The level type is used to specify editorial information for different MusicXML elements. The content contains","type":"text"},{"text":" ","type":"text"},{"text":"identifying and\/or descriptive text about the editorial status of the parent element.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLDivisions":{"abstract":[{"text":"The divisions type is used to express values in terms of the musical divisions defined by the divisions","type":"text"},{"text":" ","type":"text"},{"text":"element. It is preferred that these be integer values both for MIDI interoperability and to avoid roundoff","type":"text"},{"text":" ","type":"text"},{"text":"errors.","type":"text"}],"kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLDivisions","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"MXLDivisions"}],"type":"topic","url":"\/documentation\/ivormxl\/mxldivisions","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDivisions","title":"MXLDivisions"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/StyleColor":{"url":"\/documentation\/ivormxl\/mxlbarline\/stylecolor","title":"MXLBarline.StyleColor","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"StyleColor"}],"navigatorTitle":[{"kind":"identifier","text":"StyleColor"}],"abstract":[{"type":"text","text":"The bar-style-color type contains barline style and color information."}],"kind":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/StyleColor"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline":{"role":"symbol","abstract":[{"type":"text","text":"If a barline is other than a normal single barline, it should be represented by a barline type that describes"},{"text":" ","type":"text"},{"type":"text","text":"it. This includes information about repeats and multiple endings, as well as line style. Barline data is on"},{"type":"text","text":" "},{"type":"text","text":"the same level as the other musical data in a score — a child of a measure in a partwise score, or a part in a"},{"text":" ","type":"text"},{"type":"text","text":"timewise score. This allows for barlines within measures, as in dotted barlines that subdivide measures in"},{"text":" ","type":"text"},{"type":"text","text":"complex meters. The two fermata elements allow for fermatas on both sides of the barline (the lower one"},{"type":"text","text":" "},{"type":"text","text":"inverted)."}],"title":"MXLBarline","url":"\/documentation\/ivormxl\/mxlbarline","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline","navigatorTitle":[{"text":"MXLBarline","kind":"identifier"}],"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLBarline"}]}}}