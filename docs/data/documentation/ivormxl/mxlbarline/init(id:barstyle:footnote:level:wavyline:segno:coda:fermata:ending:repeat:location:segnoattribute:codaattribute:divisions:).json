{"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"id"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"barStyle"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/StyleColor","preciseIdentifier":"s:7IvorMXL10MXLBarlineV10StyleColorV","text":"StyleColor"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"footnote"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFormattedText","preciseIdentifier":"s:7IvorMXL16MXLFormattedTextV","text":"MXLFormattedText"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"level"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLevel","preciseIdentifier":"s:7IvorMXL8MXLLevelV","text":"MXLLevel"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"wavyLine"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLWavyLine","preciseIdentifier":"s:7IvorMXL11MXLWavyLineV","text":"MXLWavyLine"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"segno"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSegno","preciseIdentifier":"s:7IvorMXL8MXLSegnoV","text":"MXLSegno"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"coda"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCoda","preciseIdentifier":"s:7IvorMXL7MXLCodaV","text":"MXLCoda"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","tex