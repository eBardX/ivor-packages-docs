Fermata","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFermata"}],"kind":"symbol","abstract":[{"type":"text","text":"The fermata text content represents the shape of the fermata sign. An empty fermata element represents a"},{"type":"text","text":" "},{"type":"text","text":"normal fermata. The fermata type is upright if not specified."}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLFermata"}],"title":"MXLFermata"},"doc://IvorMXL/documentation/IvorMXL/MXLLevel":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLLevel","kind":"identifier"}],"navigatorTitle":[{"text":"MXLLevel","kind":"identifier"}],"title":"MXLLevel","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLevel","kind":"symbol","url":"\/documentation\/ivormxl\/mxllevel","type":"topic","abstract":[{"type":"text","text":"The level type is used to specify editorial information for different MusicXML elements. The content contains"},{"type":"text","text":" "},{"type":"text","text":"identifying and\/or descriptive text about the editorial status of the parent element."}]},"doc://IvorMXL/documentation/IvorMXL/MXLEnding":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLEnding"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLEnding"}],"url":"\/documentation\/ivormxl\/mxlending","abstract":[{"text":"The ending type represents multiple (e.g. first and second) endings. Typically, the start type is associated","type":"text"},{"text":" ","type":"text"},{"text":"with the left barline of the first measure in an ending. The stop and discontinue types are associated with","type":"text"},{"text":" ","type":"text"},{"text":"the right barline of the last measure in an ending. Stop is used when the ending mark concludes with a","type":"text"},{"text":" ","type":"text"},{"text":"downward jog, as is typical for first endings. Discontinue is used when there is no downward jog, as is","type":"text"},{"text":" ","type":"text"},{"text":"typical for second endings that do not conclude a piece. The length of the jog can be specified using the end-","type":"text"},{"text":" ","type":"text"},{"text":"length attribute. The text-x and text-y attributes are offsets that specify where the baseline of the start of","type":"text"},{"text":" ","type":"text"},{"text":"the ending text appears, relative to the start of the ending line.","type":"text"}],"title":"MXLEnding","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLSegno":{"url":"\/documentation\/ivormxl\/mxlsegno","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSegno","title":"MXLSegno","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The segno type is the visual indicator of a segno sign. The exact glyph can be specified with the smufl"},{"type":"text","text":" "},{"type":"text","text":"attribute. A sound element is also needed to guide playback applications reliably."}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSegno","kind":"identifier"}],"navigatorTitle":[{"text":"MXLSegno","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLDivisions":{"role":"symbol","url":"\/documentation\/ivormxl\/mxldivisions","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDivisions","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLDivisions"}],"kind":"symbol","abstract":[{"text":"The divisions type is used to express values in terms of the musical divisions defined by the divisions","type":"text"},{"text":" ","type":"text"},{"text":"element. It is preferred that these be integer values both for MIDI interoperability and to avoid roundoff","type":"text"},{"text":" ","type":"text"},{"text":"errors.","type":"text"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLDivisions"}],"title":"MXLDivisions"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/init(id:barStyle:footnote:level:wavyLine:segno:coda:fermata:ending:repeat:location:segnoAttribute:codaAttribute:divisions:)":{"abstract":[{"text":"Creates a new ","type":"text"},{"type":"codeVoice","code":"MXLBarline"},{"text":".","type":"text"}],"title":"init(id:barStyle:footnote:level:wavyLine:segno:coda:fermata:ending:repeat:location:segnoAttribute:codaAttribute:divisions:)","url":"\/documentation\/ivormxl\/mxlbarline\/init(id:barstyle:footnote:level:wavyline:segno:coda:fermata:ending:repeat:location:segnoattribute:codaattribute:divisions:)","kind":"symbol","role":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"barStyle","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"StyleColor","preciseIdentifier":"s:7IvorMXL10MXLBarlineV10StyleColorV","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"footnote","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLFormattedText","preciseIdentifier":"s:7IvorMXL16MXLFormattedTextV","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"level","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLLevel","preciseIdentifier":"s:7IvorMXL8MXLLevelV","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"wavyLine","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLWavyLine","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLWavyLineV"},{"text":"?, ","kind":"text"},{"text":"segno","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLSegno","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLSegnoV"},{"text":"?, ","kind":"text"},{"text":"coda","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLCoda","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL7MXLCodaV"},{"text":"?, ","kind":"text"},{"text":"fermata","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"MXLFermata","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL10MXLFermataV"},{"text":"], ","kind":"text"},{"text":"ending","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLEnding","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLEndingV"},{"text":"?, ","kind":"text"},{"text":"repeat","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLRepeat","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLRepeatV"},{"text":"?, ","kind":"text"},{"text":"location","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLRightLeftMiddle","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL18MXLRightLeftMiddleO"},{"text":"?, ","kind":"text"},{"text":"segnoAttribute","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?, ","kind":"text"},{"text":"codaAttribute","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?, ","kind":"text"},{"text":"divisions","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLDivisions","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL12MXLDivisionsV"},{"text":"?)","kind":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/init(id:barStyle:footnote:level:wavyLine:segno:coda:fermata:ending:repeat:location:segnoAttribute:codaAttribute:divisions:)"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlbarline","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLBarline"}],"abstract":[{"type":"text","text":"If a barline is other than a normal single barline, it should be represented by a barline type that describes"},{"type":"text","text":" "},{"type":"text","text":"it. This includes information about repeats and multiple endings, as well as line style. Barline data is on"},{"type":"text","text":" "},{"type":"text","text":"the same level as the other musical data in a score — a child of a measure in a partwise score, or a part in a"},{"type":"text","text":" "},{"type":"text","text":"timewise score. This allows for barlines within measures, as in dotted barlines that subdivide measures in"},{"type":"text","text":" "},{"type":"text","text":"complex meters. The two fermata elements allow for fermatas on both sides of the barline (the lower one"},{"type":"text","text":" "},{"type":"text","text":"inverted)."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLBarline"}],"title":"MXLBarline"},"doc://IvorMXL/documentation/IvorMXL/MXLCoda":{"title":"MXLCoda","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLCoda"}],"abstract":[{"text":"The coda type is the visual indicator of a coda sign. The exact glyph can be specified with the smufl","type":"text"},{"text":" ","type":"text"},{"text":"attribute. A sound element is also needed to guide playback applications reliably.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCoda","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLCoda"}],"url":"\/documentation\/ivormxl\/mxlcoda"},"doc://IvorMXL/documentation/IvorMXL/MXLRepeat":{"kind":"symbol","url":"\/documentation\/ivormxl\/mxlrepeat","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLRepeat","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRepeat","title":"MXLRepeat","abstract":[{"type":"text","text":"The repeat type represents repeat marks. The start of the repeat has a forward direction while the end of the"},{"type":"text","text":" "},{"type":"text","text":"repeat has a backward direction. The times and after-jump attributes are only used with backward repeats that"},{"type":"text","text":" "},{"type":"text","text":"are not part of an ending. The times attribute indicates the number of times the repeated section is played."},{"text":" ","type":"text"},{"type":"text","text":"The after-jump attribute indicates if the repeats are played after a jump due to a da capo or dal segno."}],"navigatorTitle":[{"text":"MXLRepeat","kind":"identifier"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLFormattedText":{"type":"topic","abstract":[{"type":"text","text":"The formatted-text type represents a text element with text-formatting attributes."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"MXLFormattedText","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLFormattedText"}],"title":"MXLFormattedText","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFormattedText","url":"\/documentation\/ivormxl\/mxlformattedtext","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLWavyLine":{"abstract":[{"text":"Wavy lines are one way to indicate trills and vibrato. When used with a barline element, they should always","type":"text"},{"text":" ","type":"text"},{"text":"have type=“continue” set. The smufl attribute specifies a particular wavy line glyph from the SMuFL Multi-","type":"text"},{"text":" ","type":"text"},{"text":"segment lines range.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLWavyLine","url":"\/documentation\/ivormxl\/mxlwavyline","navigatorTitle":[{"kind":"identifier","text":"MXLWavyLine"}],"title":"MXLWavyLine","role":"symbol","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLWavyLine"}]}}}