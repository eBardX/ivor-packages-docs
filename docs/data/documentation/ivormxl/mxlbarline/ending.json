{"sections":[],"abstract":[{"text":"The multiple-ending bracket associated with this barline.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlbarline\/ending"]}],"kind":"symbol","schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"ending"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLEnding","preciseIdentifier":"s:7IvorMXL9MXLEndingV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding"},{"kind":"text","text":"?"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","level":2,"type":"heading"},{"inlineContent":[{"text":"Maps to a nested MusicXML ","type":"text"},{"type":"codeVoice","code":"<ending>"},{"text":" element.","type":"text"}],"type":"paragraph"}]}],"metadata":{"symbolKind":"property","title":"ending","modules":[{"name":"IvorMXL"}],"roleHeading":"Instance Property","externalID":"s:7IvorMXL10MXLBarlineV6endingAA9MXLEndingVSgvp","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"ending"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLEnding","preciseIdentifier":"s:7IvorMXL9MXLEndingV"},{"kind":"text","text":"?"}]},"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/ending","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline"]]},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLBarline":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLBarline"}],"abstract":[{"text":"If a barline is other than a normal single barline, it should be represented by a barline type that describes","type":"text"},{"text":" ","type":"text"},{"text":"it. This includes information about repeats and multiple endings, as well as line style. Barline data is on","type":"text"},{"text":" ","type":"text"},{"text":"the same level as the other musical data in a score — a child of a measure in a partwise score, or a part in a","type":"text"},{"text":" ","type":"text"},{"text":"timewise score. This allows for barlines within measures, as in dotted barlines that subdivide measures in","type":"text"},{"text":" ","type":"text"},{"text":"complex meters. The two fermata elements allow for fermatas on both sides of the barline (the lower one","type":"text"},{"text":" ","type":"text"},{"text":"inverted).","type":"text"}],"title":"MXLBarline","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline","role":"symbol","url":"\/documentation\/ivormxl\/mxlbarline","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLBarline"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/ending":{"abstract":[{"text":"The multiple-ending bracket associated with this barline.","type":"text"}],"kind":"symbol","title":"ending","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/ending","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"ending"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLEndingV","text":"MXLEnding"},{"kind":"text","text":"?"}],"role":"symbol","url":"\/documentation\/ivormxl\/mxlbarline\/ending"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLEnding":{"type":"topic","title":"MXLEnding","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEnding","abstract":[{"type":"text","text":"The ending type represents multiple (e.g. first and second) endings. Typically, the start type is associated"},{"type":"text","text":" "},{"type":"text","text":"with the left barline of the first measure in an ending. The stop and discontinue types are associated with"},{"type":"text","text":" "},{"type":"text","text":"the right barline of the last measure in an ending. Stop is used when the ending mark concludes with a"},{"type":"text","text":" "},{"type":"text","text":"downward jog, as is typical for first endings. Discontinue is used when there is no downward jog, as is"},{"type":"text","text":" "},{"type":"text","text":"typical for second endings that do not conclude a piece. The length of the jog can be specified using the end-"},{"type":"text","text":" "},{"type":"text","text":"length attribute. The text-x and text-y attributes are offsets that specify where the baseline of the start of"},{"type":"text","text":" "},{"type":"text","text":"the ending text appears, relative to the start of the ending line."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLEnding"}],"navigatorTitle":[{"kind":"identifier","text":"MXLEnding"}],"url":"\/documentation\/ivormxl\/mxlending"}}}