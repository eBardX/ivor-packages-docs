ntinue” set. The smufl attribute specifies a particular wavy line glyph from the SMuFL Multi-","type":"text"},{"text":" ","type":"text"},{"text":"segment lines range.","type":"text"}],"title":"MXLWavyLine","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLWavyLine"}],"navigatorTitle":[{"kind":"identifier","text":"MXLWavyLine"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlwavyline","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLWavyLine"},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/wavyLine":{"kind":"symbol","title":"wavyLine","url":"\/documentation\/ivormxl\/mxlbarline\/wavyline","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"wavyLine","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLWavyLine","preciseIdentifier":"s:7IvorMXL11MXLWavyLineV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/wavyLine","abstract":[{"text":"A wavy line associated with the barline, such as for a trill or vibrato that continues across it.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLBarline":{"navigatorTitle":[{"text":"MXLBarline","kind":"identifier"}],"abstract":[{"text":"If a barline is other than a normal single barline, it should be represented by a barline type that describes","type":"text"},{"text":" ","type":"text"},{"text":"it. This includes information about repeats and multiple endings, as well as line style. Barline data is on","type":"text"},{"text":" ","type":"text"},{"text":"the same level as the other musical data in a score — a child of a measure in a partwise score, or a part in a","type":"text"},{"text":" ","type":"text"},{"text":"timewise score. This allows for barlines within measures, as in dotted barlines that subdivide measures in","type":"text"},{"text":" ","type":"text"},{"text":"complex meters. The two fermata elements allow for fermatas on both sides of the barline (the lower one","type":"text"},{"text":" ","type":"text"},{"text":"inverted).","type":"text"}],"title":"MXLBarline","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline","kind":"symbol","url":"\/documentation\/ivormxl\/mxlbarline","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLBarline","kind":"identifier"}],"role":"symbol"}}}