{"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline"]]},"metadata":{"modules":[{"name":"IvorMXL"}],"externalID":"s:7IvorMXL10MXLBarlineV6repeatAA9MXLRepeatVSgvp","role":"symbol","title":"repeat","symbolKind":"property","roleHeading":"Instance Property","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"`repeat`"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLRepeat","preciseIdentifier":"s:7IvorMXL9MXLRepeatV"},{"kind":"text","text":"?"}]},"kind":"symbol","abstract":[{"type":"text","text":"The repeat mark associated with this barline."}],"variants":[{"paths":["\/documentation\/ivormxl\/mxlbarline\/repeat"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/repeat"},"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"`repeat`"},{"kind":"text","text":": "},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRepeat","kind":"typeIdentifier","text":"MXLRepeat","preciseIdentifier":"s:7IvorMXL9MXLRepeatV"},{"kind":"text","text":"?"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Maps to a nested MusicXML "},{"type":"codeVoice","code":"<repeat>"},{"type":"text","text":" element."}]}],"kind":"content"}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLRepeat":{"type":"topic","title":"MXLRepeat","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRepeat","abstract":[{"type":"text","text":"The repeat type represents repeat marks. The start of the repeat has a forward direction while the end of the"},{"type":"text","text":" "},{"type":"text","text":"repeat has a backward direction. The times and after-jump attributes are only used with backward repeats that"},{"type":"text","text":" "},{"type":"text","text":"are not part of an ending. The times attribute indicates the number of times the repeated section is played."},{"type":"text","text":" "},{"type":"text","text":"The after-jump attribute indicates if the repeats are played after a jump due to a da capo or dal segno."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLRepeat"}],"navigatorTitle":[{"kind":"identifier","text":"MXLRepeat"}],"url":"\/documentation\/ivormxl\/mxlrepeat"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLBarline"}],"abstract":[{"text":"If a barline is other than a normal single barline, it should be represented by a barline type that describes","type":"text"},{"text":" ","type":"text"},{"text":"it. This includes information about repeats and multiple endings, as well as line style. Barline data is on","type":"text"},{"text":" ","type":"text"},{"text":"the same level as the other musical data in a score — a child of a measure in a partwise score, or a part in a","type":"text"},{"text":" ","type":"text"},{"text":"timewise score. This allows for barlines within measures, as in dotted barlines that subdivide measures in","type":"text"},{"text":" ","type":"text"},{"text":"complex meters. The two fermata elements allow for fermatas on both sides of the barline (the lower one","type":"text"},{"text":" ","type":"text"},{"text":"inverted).","type":"text"}],"title":"MXLBarline","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline","role":"symbol","url":"\/documentation\/ivormxl\/mxlbarline","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLBarline"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/repeat":{"role":"symbol","title":"repeat","kind":"symbol","url":"\/documentation\/ivormxl\/mxlbarline\/repeat","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/repeat","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"`repeat`"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLRepeat","preciseIdentifier":"s:7IvorMXL9MXLRepeatV"},{"kind":"text","text":"?"}],"abstract":[{"text":"The repeat mark associated with this barline.","type":"text"}],"type":"topic"}}}