{"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"roleHeading":"Instance Property","symbolKind":"property","modules":[{"name":"IvorMXL"}],"fragments":[{"text":"let","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"`repeat`"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLRepeat","preciseIdentifier":"s:7IvorMXL9MXLRepeatV"},{"kind":"text","text":"?"}],"title":"repeat","externalID":"s:7IvorMXL10MXLBarlineV6repeatAA9MXLRepeatVSgvp","role":"symbol"},"kind":"symbol","variants":[{"paths":["\/documentation\/ivormxl\/mxlbarline\/repeat"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"`repeat`"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRepeat","preciseIdentifier":"s:7IvorMXL9MXLRepeatV","text":"MXLRepeat"},{"kind":"text","text":"?"}]}],"kind":"declarations"},{"content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Maps to a nested MusicXML "},{"type":"codeVoice","code":"<repeat>"},{"type":"text","text":" element."}]}],"kind":"content"}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/repeat","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline"]]},"sections":[],"abstract":[{"type":"text","text":"The repeat mark associated with this barline."}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLRepeat":{"navigatorTitle":[{"text":"MXLRepeat","kind":"identifier"}],"abstract":[{"text":"The repeat type represents repeat marks. The start of the repeat has a forward direction while the end of the","type":"text"},{"text":" ","type":"text"},{"text":"repeat has a backward direction. The times and after-jump attributes are only used with backward repeats that","type":"text"},{"text":" ","type":"text"},{"text":"are not part of an ending. The times attribute indicates the number of times the repeated section is played.","type":"text"},{"text":" ","type":"text"},{"text":"The after-jump attribute indicates if the repeats are played after a jump due to a da capo or dal segno.","type":"text"}],"title":"MXLRepeat","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRepeat","kind":"symbol","url":"\/documentation\/ivormxl\/mxlrepeat","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLRepeat","kind":"identifier"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/repeat":{"kind":"symbol","title":"repeat","url":"\/documentation\/ivormxl\/mxlbarline\/repeat","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"`repeat`"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL9MXLRepeatV","kind":"typeIdentifier","text":"MXLRepeat"},{"kind":"text","text":"?"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/repeat","abstract":[{"type":"text","text":"The repeat mark associated with this barline."}]},"doc://IvorMXL/documentation/IvorMXL/MXLBarline":{"navigatorTitle":[{"text":"MXLBarline","kind":"identifier"}],"abstract":[{"text":"If a barline is other than a normal single barline, it should be represented by a barline type that describes","type":"text"},{"text":" ","type":"text"},{"text":"it. This includes information about repeats and multiple endings, as well as line style. Barline data is on","type":"text"},{"text":" ","type":"text"},{"text":"the same level as the other musical data in a score — a child of a measure in a partwise score, or a part in a","type":"text"},{"text":" ","type":"text"},{"text":"timewise score. This allows for barlines within measures, as in dotted barlines that subdivide measures in","type":"text"},{"text":" ","type":"text"},{"text":"complex meters. The two fermata elements allow for fermatas on both sides of the barline (the lower one","type":"text"},{"text":" ","type":"text"},{"text":"inverted).","type":"text"}],"title":"MXLBarline","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline","kind":"symbol","url":"\/documentation\/ivormxl\/mxlbarline","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLBarline","kind":"identifier"}],"role":"symbol"}}}