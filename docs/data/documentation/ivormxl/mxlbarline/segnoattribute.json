:"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/segnoAttribute":{"kind":"symbol","title":"segnoAttribute","url":"\/documentation\/ivormxl\/mxlbarline\/segnoattribute","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"segnoAttribute","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/segnoAttribute","abstract":[{"text":"Used the same way as the segno attribute of the sound element, to name and distinguish forward jumps to a","type":"text"},{"text":" ","type":"text"},{"text":"segno sign for playback.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLBarline":{"navigatorTitle":[{"text":"MXLBarline","kind":"identifier"}],"abstract":[{"text":"If a barline is other than a normal single barline, it should be represented by a barline type that describes","type":"text"},{"text":" ","type":"text"},{"text":"it. This includes information about repeats and multiple endings, as well as line style. Barline data is on","type":"text"},{"text":" ","type":"text"},{"text":"the same level as the other musical data in a score — a child of a measure in a partwise score, or a part in a","type":"text"},{"text":" ","type":"text"},{"text":"timewise score. This allows for barlines within measures, as in dotted barlines that subdivide measures in","type":"text"},{"text":" ","type":"text"},{"text":"complex meters. The two fermata elements allow for fermatas on both sides of the barline (the lower one","type":"text"},{"text":" ","type":"text"},{"text":"inverted).","type":"text"}],"title":"MXLBarline","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline","kind":"symbol","url":"\/documentation\/ivormxl\/mxlbarline","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLBarline","kin