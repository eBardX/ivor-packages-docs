at describes"},{"type":"text","text":" "},{"type":"text","text":"it. This includes information about repeats and multiple endings, as well as line style. Barline data is on"},{"type":"text","text":" "},{"type":"text","text":"the same level as the other musical data in a score — a child of a measure in a partwise score, or a part in a"},{"type":"text","text":" "},{"type":"text","text":"timewise score. This allows for barlines within measures, as in dotted barlines that subdivide measures in"},{"type":"text","text":" "},{"type":"text","text":"complex meters. The two fermata elements allow for fermatas on both sides of the barline (the lower one"},{"type":"text","text":" "},{"type":"text","text":"inverted)."}],"url":"\/documentation\/ivormxl\/mxlbarline"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/StyleColor/Style/tick":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/StyleColor\/Style\/tick","abstract":[{"type":"text","text":"A short stroke through the top line."}],"title":"MXLBarline.StyleColor.Style.tick","type":"topic","kind":"symbol","role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"tick"}],"url":"\/documentation\/ivormxl\/mxlbarline\/stylecolor\/style\/tick"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/StyleColor/Style/Equatable-Implementations":{"abstract":[],"title":"Equatable Implementations","role":"collectionGroup","type":"topic","url":"\/documentation\/ivormxl\/mxlbarline\/stylecolor\/style\/equatable-implementations","kind":"article","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/StyleColor\/Style\/Equatable-Implementations"},"doc://IvorMXL/s16SendableMetatypeP":{"type":"unresolvable","identifier":"doc:\/\/IvorMXL\/s16SendableMetatypeP","title":"Swift.SendableMetatype"},"doc://IvorMXL/SH":{"type":"unresolvable","identifier":"doc:\/\/IvorMXL\/SH","title":"Swift.Hashable"},"doc://IvorMXL/s9EscapableP":{"type":"unresolvable","identifier":"doc:\/