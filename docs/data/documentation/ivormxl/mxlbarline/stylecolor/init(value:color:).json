ciseIdentifier":"s:7IvorMXL10MXLBarlineV10StyleColorV0D0O","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"color","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLColor","preciseIdentifier":"s:7IvorMXL8MXLColorV","kind":"typeIdentifier"},{"text":"?)","kind":"text"}],"symbolKind":"init","modules":[{"name":"IvorMXL"}],"role":"symbol"},"kind":"symbol","sections":[],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLBarline/StyleColor/Style":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/StyleColor\/Style","title":"MXLBarline.StyleColor.Style","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Style"}],"abstract":[{"text":"The bar-style type represents barline style information. Choices are regular, dotted, dashed, heavy, light-","type":"text"},{"text":" ","type":"text"},{"text":"light, light-heavy, heavy-light, heavy-heavy, tick (a short stroke through the top line), short (a partial","type":"text"},{"text":" ","type":"text"},{"text":"barline between the 2nd and 4th lines), and none.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlbarline\/stylecolor\/style","kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Style"}]},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/StyleColor":{"navigatorTitle":[{"kind":"identifier","text":"StyleColor"}],"url":"\/documentation\/ivormxl\/mxlbarline\/stylecolor","kind":"symbol","type":"topic","role":"symbol","title":"MXLBarline.StyleColor","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/StyleColor","abstract":[{"text":"The bar-style-color type contains barline style and color information.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"StyleColor"}]},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/StyleColor/init(value:color:)":{"url":"\/documentation\/ivormxl\/mxlbarline\/stylecolor\/init(value:color:)","abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLBarline.StyleColor"},{"type":"text","text":"."}],"title":"init(value:color:)","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/StyleColor\/init(value:color:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"value"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL10MXLBarlineV10StyleColorV0D0O","text":"Style"},{"kind":"text","text":", "},{"kind":"externalParam","text":"color"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLColorV","text":"MXLColor"},{"kind":"text","text":"?)"}],"role":"symbol","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLBarline"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLBarline"}],"title":"MXLBarline","abstract":[{"type":"text","text":"If a barline is other than a normal single barline, it should be represented by a barline type that describes"},{"type":"text","text":" "},{"type":"text","text":"it. This includes information about repeats and multiple endings, as well as line style. Barline data is on"},{"type":"text","text":" "},{"type":"text","text":"the same level as the other musical data in a score — a child of a measure in a partwise score, or a part in a"},{"type":"text","text":" "},{"type":"text","text":"timewise score. This allows for barlines within measures, as in dotted barlines that subdivide measures in"},{"type":"text","text":" "},{"type":"text","text":"complex meters. The two fermata elements allow for fermatas on both sides of the barline (the lower one"},{"type":"text","text":" "},{"type":"text","text":"inverted)."}],"url":"\/documentation\/ivormxl\/mxlbarline"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlcolor","title":"MXLColor","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"type":"text","text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is"},{"type":"text","text":" "},{"type":"text","text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]}}}