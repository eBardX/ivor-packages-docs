{"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","metadata":{"symbolKind":"case","role":"symbol","roleHeading":"Case","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"heavyHeavy"}],"modules":[{"name":"IvorMXL"}],"title":"MXLBarline.StyleColor.Style.heavyHeavy","externalID":"s:7IvorMXL10MXLBarlineV10StyleColorV0D0O10heavyHeavyyA2GmF"},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"heavyHeavy","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}]}],"abstract":[{"type":"text","text":"Two heavy barlines."}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/StyleColor","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/StyleColor\/Style"]]},"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/StyleColor\/Style\/heavyHeavy","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlbarline\/stylecolor\/style\/heavyheavy"]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLBarline":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlbarline","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLBarline"}],"abstract":[{"type":"text","text":"If a barline is other than a normal single barline, it should be represented by a barline type that describes"},{"type":"text","text":" "},{"type":"text","text":"it. This includes information about repeats and multiple endings, as well as line style. Barline data is on"},{"type":"text","text":" "},{"type":"text","text":"the same level as the other musical data in a score — a child of a measure in a partwise score, or a part in a"},{"type":"text","text":" "},{"type":"text","text":"timewise score. This allows for barlines within measures, as in dotted barlines that subdivide measures in"},{"type":"text","text":" "},{"type":"text","text":"complex meters. The two fermata elements allow for fermatas on both sides of the barline (the lower one"},{"type":"text","text":" "},{"type":"text","text":"inverted)."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLBarline"}],"title":"MXLBarline"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/StyleColor":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlbarline\/stylecolor","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/StyleColor","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"StyleColor"}],"abstract":[{"text":"The bar-style-color type contains barline style and color information.","type":"text"}],"kind":"symbol","type":"topic","navigatorTitle":[{"text":"StyleColor","kind":"identifier"}],"title":"MXLBarline.StyleColor"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/StyleColor/Style/heavyHeavy":{"url":"\/documentation\/ivormxl\/mxlbarline\/stylecolor\/style\/heavyheavy","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/StyleColor\/Style\/heavyHeavy","abstract":[{"text":"Two heavy barlines.","type":"text"}],"kind":"symbol","type":"topic","title":"MXLBarline.StyleColor.Style.heavyHeavy","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"heavyHeavy","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/StyleColor/Style":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlbarline\/stylecolor\/style","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/StyleColor\/Style","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Style"}],"abstract":[{"type":"text","text":"The bar-style type represents barline style information. Choices are regular, dotted, dashed, heavy, light-"},{"type":"text","text":" "},{"type":"text","text":"light, light-heavy, heavy-light, heavy-heavy, tick (a short stroke through the top line), short (a partial"},{"type":"text","text":" "},{"type":"text","text":"barline between the 2nd and 4th lines), and none."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Style"}],"title":"MXLBarline.StyleColor.Style"}}}