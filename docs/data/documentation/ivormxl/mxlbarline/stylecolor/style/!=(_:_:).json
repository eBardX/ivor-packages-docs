"},{"type":"text","text":"timewise score. This allows for barlines within measures, as in dotted barlines that subdivide measures in"},{"text":" ","type":"text"},{"type":"text","text":"complex meters. The two fermata elements allow for fermatas on both sides of the barline (the lower one"},{"type":"text","text":" "},{"type":"text","text":"inverted)."}],"title":"MXLBarline","url":"\/documentation\/ivormxl\/mxlbarline","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline","navigatorTitle":[{"text":"MXLBarline","kind":"identifier"}],"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLBarline"}]},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/StyleColor/Style":{"url":"\/documentation\/ivormxl\/mxlbarline\/stylecolor\/style","title":"MXLBarline.StyleColor.Style","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Style"}],"navigatorTitle":[{"kind":"identifier","text":"Style"}],"abstract":[{"type":"text","text":"The bar-style type represents barline style information. Choices are regular, dotted, dashed, heavy, light-"},{"type":"text","text":" "},{"type":"text","text":"light, light-heavy, heavy-light, heavy-heavy, tick (a short stroke through the top line), short (a partial"},{"type":"text","text":" "},{"type":"text","text":"barline between the 2nd and 4th lines), and none."}],"kind":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/StyleColor\/Style"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"}}}