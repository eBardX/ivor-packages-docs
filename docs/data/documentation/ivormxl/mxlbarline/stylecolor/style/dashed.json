{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"dashed"}],"platforms":["macOS"],"languages":["swift"]}]}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/StyleColor","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/StyleColor\/Style"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"A dashed barline.","type":"text"}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/StyleColor\/Style\/dashed","interfaceLanguage":"swift"},"metadata":{"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"dashed"}],"role":"symbol","externalID":"s:7IvorMXL10MXLBarlineV10StyleColorV0D0O6dashedyA2GmF","title":"MXLBarline.StyleColor.Style.dashed","modules":[{"name":"IvorMXL"}],"roleHeading":"Case","symbolKind":"case"},"sections":[],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlbarline\/stylecolor\/style\/dashed"]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLBarline/StyleColor":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"StyleColor"}],"abstract":[{"text":"The bar-style-color type contains barline style and color information.","type":"text"}],"title":"MXLBarline.StyleColor","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/StyleColor","role":"symbol","url":"\/documentation\/ivormxl\/mxlbarline\/stylecolor","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"StyleColor"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLBarline"}],"abstract":[{"text":"If a barline is other than a normal single barline, it should be represented by a barline type that describes","type":"text"},{"text":" ","type":"text"},{"text":"it. This includes information about repeats and multiple endings, as well as line style. Barline data is on","type":"text"},{"text":" ","type":"text"},{"text":"the same level as the other musical data in a score — a child of a measure in a partwise score, or a part in a","type":"text"},{"text":" ","type":"text"},{"text":"timewise score. This allows for barlines within measures, as in dotted barlines that subdivide measures in","type":"text"},{"text":" ","type":"text"},{"text":"complex meters. The two fermata elements allow for fermatas on both sides of the barline (the lower one","type":"text"},{"text":" ","type":"text"},{"text":"inverted).","type":"text"}],"title":"MXLBarline","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline","role":"symbol","url":"\/documentation\/ivormxl\/mxlbarline","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLBarline"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/StyleColor/Style/dashed":{"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"dashed"}],"abstract":[{"text":"A dashed barline.","type":"text"}],"title":"MXLBarline.StyleColor.Style.dashed","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/StyleColor\/Style\/dashed","role":"symbol","url":"\/documentation\/ivormxl\/mxlbarline\/stylecolor\/style\/dashed","kind":"symbol","type":"topic"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/StyleColor/Style":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Style"}],"abstract":[{"text":"The bar-style type represents barline style information. Choices are regular, dotted, dashed, heavy, light-","type":"text"},{"text":" ","type":"text"},{"text":"light, light-heavy, heavy-light, heavy-heavy, tick (a short stroke through the top line), short (a partial","type":"text"},{"text":" ","type":"text"},{"text":"barline between the 2nd and 4th lines), and none.","type":"text"}],"title":"MXLBarline.StyleColor.Style","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/StyleColor\/Style","role":"symbol","url":"\/documentation\/ivormxl\/mxlbarline\/stylecolor\/style","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Style"}],"type":"topic"}}}