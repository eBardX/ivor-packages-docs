{"type":"text","text":" "},{"type":"text","text":"timewise score. This allows for barlines within measures, as in dotted barlines that subdivide measures in"},{"type":"text","text":" "},{"type":"text","text":"complex meters. The two fermata elements allow for fermatas on both sides of the barline (the lower one"},{"type":"text","text":" "},{"type":"text","text":"inverted)."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLBarline"}],"title":"MXLBarline"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/StyleColor/Style/invisible":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlbarline\/stylecolor\/style\/invisible","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/StyleColor\/Style\/invisible","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"invisible"}],"abstract":[{"type":"text","text":"No barline."}],"kind":"symbol","type":"topic","title":"MXLBarline.StyleColor.Style.invisible"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/StyleColor/Style":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlbarline\/stylecolor\/style","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/StyleColor\/Style","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Style"}],"abstract":[{"type":"text","text":"The bar-style type represents barline style information. Choices are regular, dotted, dashed, heavy, light-"},{"type":"text","text":" "},{"type":"text","text":"light, light-heavy, heavy-light, heavy-heavy, tick (a short stroke through the top line), short (a partial"},{"type":"text","text":" "},{"type":"text","text":"barline between the 2nd and 4th lines), and none."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Style"}],"title":"MXLBarline.StyleColor.Style"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and