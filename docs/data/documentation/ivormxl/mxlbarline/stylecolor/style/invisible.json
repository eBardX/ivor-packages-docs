{"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/StyleColor\/Style\/invisible"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/StyleColor","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/StyleColor\/Style"]]},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"invisible","kind":"identifier"}]}],"kind":"declarations"}],"abstract":[{"type":"text","text":"No barline."}],"sections":[],"metadata":{"externalID":"s:7IvorMXL10MXLBarlineV10StyleColorV0D0O9invisibleyA2GmF","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"invisible","kind":"identifier"}],"role":"symbol","modules":[{"name":"IvorMXL"}],"title":"MXLBarline.StyleColor.Style.invisible","roleHeading":"Case","symbolKind":"case"},"kind":"symbol","variants":[{"paths":["\/documentation\/ivormxl\/mxlbarline\/stylecolor\/style\/invisible"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLBarline/StyleColor/Style/invisible":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/StyleColor\/Style\/invisible","url":"\/documentation\/ivormxl\/mxlbarline\/stylecolor\/style\/invisible","role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"invisible","kind":"identifier"}],"abstract":[{"type":"text","text":"No barline."}],"title":"MXLBarline.StyleColor.Style.invisible","type":"topic","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLBarline"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLBarline"}],"title":"MXLBarline","abstract":[{"type":"text","text":"If a barline is other than a normal single barline, it should be represented by a barline type that describes"},{"type":"text","text":" "},{"type":"text","text":"it. This includes information about repeats and multiple endings, as well as line style. Barline data is on"},{"type":"text","text":" "},{"type":"text","text":"the same level as the other musical data in a score — a child of a measure in a partwise score, or a part in a"},{"type":"text","text":" "},{"type":"text","text":"timewise score. This allows for barlines within measures, as in dotted barlines that subdivide measures in"},{"type":"text","text":" "},{"type":"text","text":"complex meters. The two fermata elements allow for fermatas on both sides of the barline (the lower one"},{"type":"text","text":" "},{"type":"text","text":"inverted)."}],"url":"\/documentation\/ivormxl\/mxlbarline"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/StyleColor":{"navigatorTitle":[{"kind":"identifier","text":"StyleColor"}],"url":"\/documentation\/ivormxl\/mxlbarline\/stylecolor","kind":"symbol","type":"topic","role":"symbol","title":"MXLBarline.StyleColor","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/StyleColor","abstract":[{"text":"The bar-style-color type contains barline style and color information.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"StyleColor"}]},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/StyleColor/Style":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/StyleColor\/Style","title":"MXLBarline.StyleColor.Style","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Style"}],"abstract":[{"text":"The bar-style type represents barline style information. Choices are regular, dotted, dashed, heavy, light-","type":"text"},{"text":" ","type":"text"},{"text":"light, light-heavy, heavy-light, heavy-heavy, tick (a short stroke through the top line), short (a partial","type":"text"},{"text":" ","type":"text"},{"text":"barline between the 2nd and 4th lines), and none.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlbarline\/stylecolor\/style","kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Style"}]}}}