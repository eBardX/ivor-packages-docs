{"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/StyleColor","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/StyleColor\/Style"]]},"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"No barline.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"invisible"}]}]}],"variants":[{"paths":["\/documentation\/ivormxl\/mxlbarline\/stylecolor\/style\/invisible"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/StyleColor\/Style\/invisible","interfaceLanguage":"swift"},"metadata":{"roleHeading":"Case","title":"MXLBarline.StyleColor.Style.invisible","symbolKind":"case","modules":[{"name":"IvorMXL"}],"externalID":"s:7IvorMXL10MXLBarlineV10StyleColorV0D0O9invisibleyA2GmF","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"invisible"}],"role":"symbol"},"references":{"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/StyleColor/Style":{"navigatorTitle":[{"text":"Style","kind":"identifier"}],"abstract":[{"text":"The bar-style type represents barline style information. Choices are regular, dotted, dashed, heavy, light-","type":"text"},{"text":" ","type":"text"},{"text":"light, light-heavy, heavy-light, heavy-heavy, tick (a short stroke through the top line), short (a partial","type":"text"},{"type":"text","text":" "},{"text":"barline between the 2nd and 4th lines), and none.","type":"text"}],"title":"MXLBarline.StyleColor.Style","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/StyleColor\/Style","kind":"symbol","url":"\/documentation\/ivormxl\/mxlbarline\/stylecolor\/style","type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Style","kind":"identifier"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/StyleColor/Style/invisible":{"url":"\/documentation\/ivormxl\/mxlbarline\/stylecolor\/style\/invisible","abstract":[{"text":"No barline.","type":"text"}],"title":"MXLBarline.StyleColor.Style.invisible","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/StyleColor\/Style\/invisible","type":"topic","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"invisible","kind":"identifier"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline":{"navigatorTitle":[{"text":"MXLBarline","kind":"identifier"}],"abstract":[{"text":"If a barline is other than a normal single barline, it should be represented by a barline type that describes","type":"text"},{"text":" ","type":"text"},{"text":"it. This includes information about repeats and multiple endings, as well as line style. Barline data is on","type":"text"},{"text":" ","type":"text"},{"text":"the same level as the other musical data in a score — a child of a measure in a partwise score, or a part in a","type":"text"},{"text":" ","type":"text"},{"text":"timewise score. This allows for barlines within measures, as in dotted barlines that subdivide measures in","type":"text"},{"text":" ","type":"text"},{"text":"complex meters. The two fermata elements allow for fermatas on both sides of the barline (the lower one","type":"text"},{"text":" ","type":"text"},{"text":"inverted).","type":"text"}],"title":"MXLBarline","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline","kind":"symbol","url":"\/documentation\