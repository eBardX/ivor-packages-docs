{"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/StyleColor","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/StyleColor\/Style"]]},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"lightHeavy"}]}],"kind":"declarations"}],"abstract":[{"type":"text","text":"A light barline followed by a heavy barline."}],"sections":[],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/StyleColor\/Style\/lightHeavy","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/ivormxl\/mxlbarline\/stylecolor\/style\/lightheavy"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","metadata":{"role":"symbol","modules":[{"name":"IvorMXL"}],"symbolKind":"case","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"lightHeavy"}],"externalID":"s:7IvorMXL10MXLBarlineV10StyleColorV0D0O10lightHeavyyA2GmF","title":"MXLBarline.StyleColor.Style.lightHeavy","roleHeading":"Case"},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLBarline":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLBarline"}],"abstract":[{"text":"If a barline is other than a normal single barline, it should be represented by a barline type that describes","type":"text"},{"text":" ","type":"text"},{"text":"it. This includes information about repeats and multiple endings, as well as line style. Barline data is on","type":"text"},{"text":" ","type":"text"},{"text":"the same level as the other musical data in a score — a child of a measure in a partwise score, or a part in a","type":"text"},{"text":" ","type":"text"},{"text":"timewise score. This allows for barlines within measures, as in dotted barlines that subdivide measures in","type":"text"},{"text":" ","type":"text"},{"text":"complex meters. The two fermata elements allow for fermatas on both sides of the barline (the lower one","type":"text"},{"text":" ","type":"text"},{"text":"inverted).","type":"text"}],"title":"MXLBarline","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline","role":"symbol","url":"\/documentation\/ivormxl\/mxlbarline","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLBarline"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/StyleColor/Style/lightHeavy":{"type":"topic","role":"symbol","abstract":[{"type":"text","text":"A light barline followed by a heavy barline."}],"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lightHeavy","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/StyleColor\/Style\/lightHeavy","kind":"symbol","title":"MXLBarline.StyleColor.Style.lightHeavy","url":"\/documentation\/ivormxl\/mxlbarline\/stylecolor\/style\/lightheavy"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/StyleColor/Style":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Style"}],"abstract":[{"text":"The bar-style type represents barline style information. Choices are regular, dotted, dashed, heavy, light-","type":"text"},{"text":" ","type":"text"},{"text":"light, light-heavy, heavy-light, heavy-heavy, tick (a short stroke through the top line), short (a partial","type":"text"},{"text":" ","type":"text"},{"text":"barline between the 2nd and 4th lines), and none.","type":"text"}],"title":"MXLBarline.StyleColor.Style","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/StyleColor\/Style","role":"symbol","url":"\/documentation\/ivormxl\/mxlbarline\/stylecolor\/style","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Style"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/StyleColor":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"StyleColor"}],"abstract":[{"text":"The bar-style-color type contains barline style and color information.","type":"text"}],"title":"MXLBarline.StyleColor","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/StyleColor","role":"symbol","url":"\/documentation\/ivormxl\/mxlbarline\/stylecolor","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"StyleColor"}],"type":"topic"}}}