on\/IvorMXL\/MXLBarline\/StyleColor"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline":{"role":"symbol","abstract":[{"type":"text","text":"If a barline is other than a normal single barline, it should be represented by a barline type that describes"},{"text":" ","type":"text"},{"type":"text","text":"it. This includes information about repeats and multiple endings, as well as line style. Barline data is on"},{"type":"text","text":" "},{"type":"text","text":"the same level as the other musical data in a score — a child of a measure in a partwise score, or a part in a"},{"text":" ","type":"text"},{"type":"text","text":"timewise score. This allows for barlines within measures, as in dotted barlines that subdivide measures in"},{"text":" ","type":"text"},{"type":"text","text":"complex meters. The two fermata elements allow for fermatas on both sides of the barline (the lower one"},{"type":"text","text":" "},{"type":"text","text":"inverted)."}],"title":"MXLBarline","url":"\/documentation\/ivormxl\/mxlbarline","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline","navigatorTitle":[{"text":"MXLBarline","kind":"identifier"}],"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLBarline"}]},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/StyleColor/value":{"kind":"symbol","title":"value","role":"symbol","url":"\/documentation\/ivormxl\/mxlbarline\/stylecolor\/value","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"value","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Style","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL10MXLBarlineV10StyleColorV0D0O"}],"abstract":[{"text":"The value of this element.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/StyleColor\/value","type":"topic"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/StyleColor/Style":{"url":"\/documentation\/ivormxl\/mxlbarline\/stylecolor\/style","title":"MXLBarline.StyleColor.Style","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Style"}],"navigatorTitle":[{"kind":"identifier","text":"Style"}],"abstract":[{"type":"text","text":"The bar-style type represents barline style information. Choices are regular, dotted, dashed, heavy, light-"},{"type":"text","text":" "},{"type":"text","text":"light, light-heavy, heavy-light, heavy-heavy, tick (a short stroke through the top line), short (a partial"},{"type":"text","text":" "},{"type":"text","text":"barline between the 2nd and 4th lines), and none."}],"kind":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/StyleColor\/Style"}}}