, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLDivisions":{"title":"MXLDivisions","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLDivisions","kind":"identifier"}],"kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxldivisions","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLDivisions","abstract":[{"type":"text","text":"The divisions type is used to express values in terms of the musical divisions defined by the divisions"},{"type":"text","text":" "},{"type":"text","text":"element. It is preferred that these be integer values both for MIDI interoperability and to avoid roundoff"},{"type":"text","text":" "},{"type":"text","text":"errors."}],"navigatorTitle":[{"text":"MXLDivisions","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/divisions":{"kind":"symbol","title":"divisions","url":"\/documentation\/ivormxl\/mxlbarline\/divisions","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"divisions","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLDivisions","preciseIdentifier":"s:7IvorMXL12MXLDivisionsV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/divisions","abstract":[{"text":"Used the same way as the divisions attribute of the sound element, to indicate the number of divisions per","type":"text"},{"text":" ","type":"text"},{"text":"quarter note for playback when this barline contains a segno or coda child element.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLBarline":{"navigatorTitle":[{"text":"MXLBarline","kind":"identifier"}],"abstract":[{"text":"If a barline is other than a normal single barline, it should be represented by a barline type that describes","type":"text"},{"text":" ","type":"text"},{"text":"it. This includes information about repeats and multiple endings, as well as line style. Barline data is on","type":"text"},{"text":" ","type":"text"},{"text":"the same level as the other musical data in a score — a child of a measure in a partwise score, or a part in a","type":"text"},{"text":" ","type":"text"},{"text":"timewise score. This allows for barlines within measures, as in dotted barlines that subdivide measures in","type":"text"},{"text":" ","type":"text"},{"text":"complex meters. The two fermata elements allow for fermatas on both sides of the barline (the lower one","type":"text"},{"text":" ","type":"text"},{"text":"inverted).","type":"text"}],"title":"MXLBarline","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline","kind":"symbol","url":"\/documentation\/ivormxl\/mxlbarline","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLBarline","kind":"identifier"}],"role":"symbol"}}}