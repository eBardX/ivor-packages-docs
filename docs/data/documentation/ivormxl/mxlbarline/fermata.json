{"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline"]]},"metadata":{"modules":[{"name":"IvorMXL"}],"externalID":"s:7IvorMXL10MXLBarlineV7fermataSayAA10MXLFermataVGvp","title":"fermata","fragments":[{"text":"let","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"fermata"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:7IvorMXL10MXLFermataV","kind":"typeIdentifier","text":"MXLFermata"},{"kind":"text","text":"]"}],"symbolKind":"property","role":"symbol","roleHeading":"Instance Property"},"abstract":[{"text":"The fermata signs on either side of the barline, allowing fermatas on both sides (the lower one inverted).","type":"text"}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/fermata","interfaceLanguage":"swift"},"kind":"symbol","primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"text":"let","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"fermata"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:7IvorMXL10MXLFermataV","kind":"typeIdentifier","text":"MXLFermata","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFermata"},{"kind":"text","text":"]"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"Maps to nested MusicXML ","type":"text"},{"code":"<fermata>","type":"codeVoice"},{"text":" elements.","type":"text"}]}],"kind":"content"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlbarline\/fermata"]}],"references":{"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline":{"navigatorTitle":[{"text":"MXLBarline","kind":"identifier"}],"abstract":[{"text":"If a barline is other than a normal single barline, it should be represented by a barline type that describes","type":"text"},{"text":" ","type":"text"},{"text":"it. This includes information about repeats and multiple endings, as well as line style. Barline data is on","type":"text"},{"text":" ","type":"text"},{"text":"the same level as the other musical data in a score — a child of a measure in a partwise score, or a part in a","type":"text"},{"text":" ","type":"text"},{"text":"timewise score. This allows for barlines within measures, as in dotted barlines that subdivide measures in","type":"text"},{"text":" ","type":"text"},{"text":"complex meters. The two fermata elements allow for fermatas on both sides of the barline (the lower one","type":"text"},{"text":" ","type":"text"},{"text":"inverted).","type":"text"}],"title":"MXLBarline","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline","kind":"symbol","url":"\/documentation\/ivormxl\/mxlbarline","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLBarline","kind":"identifier"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/fermata":{"kind":"symbol","title":"fermata","url":"\/documentation\/ivormxl\/mxlbarline\/fermata","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"fermata","kind":"identifier"},{"text":": [","kind":"text"},{"text":"MXLFermata","preciseIdentifier":"s:7IvorMXL10MXLFermataV","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/fermata","abstract":[{"text":"The fermata signs on either side of the barline, allowing fermatas on both sides (the lower one inverted).","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLFermata":{"abstract":[{"text":"The fermata text content represents the shape of the fermata sign. An empty fermata element represents a","type":"text"},{"text":" ","type":"text"},{"text":"normal fermata. The fermata type is upright if not specified.","type":"text"}],"title":"MXLFermata","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLFermata","kind":"identifier"}],"navigatorTitle":[{"text":"MXLFermata","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlfermata","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFermata"}}}