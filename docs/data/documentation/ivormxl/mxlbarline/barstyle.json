e type that describes","type":"text"},{"text":" ","type":"text"},{"text":"it. This includes information about repeats and multiple endings, as well as line style. Barline data is on","type":"text"},{"text":" ","type":"text"},{"text":"the same level as the other musical data in a score — a child of a measure in a partwise score, or a part in a","type":"text"},{"text":" ","type":"text"},{"text":"timewise score. This allows for barlines within measures, as in dotted barlines that subdivide measures in","type":"text"},{"text":" ","type":"text"},{"text":"complex meters. The two fermata elements allow for fermatas on both sides of the barline (the lower one","type":"text"},{"text":" ","type":"text"},{"text":"inverted).","type":"text"}],"title":"MXLBarline","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline","role":"symbol","url":"\/documentation\/ivormxl\/mxlbarline","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLBarline"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/StyleColor":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"StyleColor"}],"abstract":[{"text":"The bar-style-color type contains barline style and color information.","type":"text"}],"title":"MXLBarline.StyleColor","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/StyleColor","role":"symbol","url":"\/documentation\/ivormxl\/mxlbarline\/stylecolor","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"StyleColor"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/barStyle":{"role":"symbol","title":"barStyle","kind":"symbol","url":"\/documentation\/ivormxl\/mxlbarline\/barsty