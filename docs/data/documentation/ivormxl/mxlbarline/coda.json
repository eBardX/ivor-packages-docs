da":{"role":"symbol","kind":"symbol","url":"\/documentation\/ivormxl\/mxlcoda","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCoda","abstract":[{"type":"text","text":"The coda type is the visual indicator of a coda sign. The exact glyph can be specified with the smufl"},{"type":"text","text":" "},{"type":"text","text":"attribute. A sound element is also needed to guide playback applications reliably."}],"type":"topic","title":"MXLCoda","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLCoda"}],"navigatorTitle":[{"kind":"identifier","text":"MXLCoda"}]},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/coda":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/coda","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"coda"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLCoda","preciseIdentifier":"s:7IvorMXL7MXLCodaV"},{"kind":"text","text":"?"}],"title":"coda","url":"\/documentation\/ivormxl\/mxlbarline\/coda","abstract":[{"type":"text","text":"The visual indicator of a coda sign appearing at this barline."}],"kind":"symbol","type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline":{"role":"symbol","abstract":[{"type":"text","text":"If a barline is other than a normal single barline, it should be represented by a barline type that describes"},{"text":" ","type":"text"},{"type":"text","text":"it. This includes information about repeats and multiple endings, as well as line style. Barline data is on"},{"type":"text","text":" "},{"type":"text","text":"the same level as the other musical data in a score — a child of a measure in a partwise score, or a part in a"},{"text":" ","type":"text"},{"type":"text","text":"timewise score. This allows for barlines within measures, as in dotted barlines that subdivide measures in"},{"text":" ","type":"text"},{"type":"text","text":"complex meters. The two fermata elements allow for fermatas on both sides of the barline (the lower one"},{"type":"text","text":" "},{"type":"text","text":"inverted)."}],"title":"MXLBarline","url":"\/documentation\/ivormxl\/mxlbarline","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline","navigatorTitle":[{"text":"MXLBarline","kind":"identifier"}],"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLBarline"}]}}}