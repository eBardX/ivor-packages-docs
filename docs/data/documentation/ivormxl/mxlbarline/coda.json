{"sections":[],"abstract":[{"text":"The visual indicator of a coda sign appearing at this barline.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlbarline\/coda"]}],"metadata":{"title":"coda","symbolKind":"property","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"coda"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLCoda","preciseIdentifier":"s:7IvorMXL7MXLCodaV"},{"kind":"text","text":"?"}],"role":"symbol","roleHeading":"Instance Property","modules":[{"name":"IvorMXL"}],"externalID":"s:7IvorMXL10MXLBarlineV4codaAA7MXLCodaVSgvp"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"coda"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLCoda","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCoda","preciseIdentifier":"s:7IvorMXL7MXLCodaV"},{"kind":"text","text":"?"}]}]},{"content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Maps to a nested MusicXML "},{"type":"codeVoice","code":"<coda>"},{"type":"text","text":" element."}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/coda","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline"]]},"references":{"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLCoda":{"abstract":[{"type":"text","text":"The coda type is the visual indicator of a coda sign. The exact glyph can be specified with the smufl"},{"type":"text","text":" "},{"type":"text","text":"attribute. A sound element is also needed to guide playback applications reliably."}],"title":"MXLCoda","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLCoda"}],"navigatorTitle":[{"text":"MXLCoda","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlcoda","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCoda"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline":{"navigatorTitle":[{"text":"MXLBarline","kind":"identifier"}],"abstract":[{"text":"If a barline is other than a normal single barline, it should be represented by a barline type that describes","type":"text"},{"text":" ","type":"text"},{"text":"it. This includes information about repeats and multiple endings, as well as line style. Barline data is on","type":"text"},{"text":" ","type":"text"},{"text":"the same level as the other musical data in a score — a child of a measure in a partwise score, or a part in a","type":"text"},{"text":" ","type":"text"},{"text":"timewise score. This allows for barlines within measures, as in dotted barlines that subdivide measures in","type":"text"},{"text":" ","type":"text"},{"text":"complex meters. The two fermata elements allow for fermatas on both sides of the barline (the lower one","type":"text"},{"text":" ","type":"text"},{"text":"inverted).","type":"text"}],"title":"MXLBarline","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline","kind":"symbol","url":"\/documentation\/ivormxl\/mxlbarline","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLBarline","kind":"identifier"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/coda":{"kind":"symbol","title":"coda","url":"\/documentation\/ivormx