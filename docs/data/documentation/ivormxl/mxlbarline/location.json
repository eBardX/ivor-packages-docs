Barline"}],"abstract":[{"type":"text","text":"If a barline is other than a normal single barline, it should be represented by a barline type that describes"},{"type":"text","text":" "},{"type":"text","text":"it. This includes information about repeats and multiple endings, as well as line style. Barline data is on"},{"type":"text","text":" "},{"type":"text","text":"the same level as the other musical data in a score — a child of a measure in a partwise score, or a part in a"},{"type":"text","text":" "},{"type":"text","text":"timewise score. This allows for barlines within measures, as in dotted barlines that subdivide measures in"},{"type":"text","text":" "},{"type":"text","text":"complex meters. The two fermata elements allow for fermatas on both sides of the barline (the lower one"},{"type":"text","text":" "},{"type":"text","text":"inverted)."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLBarline"}],"title":"MXLBarline"},"doc://IvorMXL/documentation/IvorMXL/MXLBarline/location":{"abstract":[{"text":"Defaults to ","type":"text"},{"code":"right","type":"codeVoice"},{"text":".","type":"text"}],"title":"location","url":"\/documentation\/ivormxl\/mxlbarline\/location","kind":"symbol","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"location","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLRightLeftMiddle","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL18MXLRightLeftMiddleO"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLBarline\/location"},"doc://IvorMXL/documentation/IvorMXL/MXLRightLeftMiddle":{"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLRightLeftMiddle"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLRightLeftMiddle","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"The right-left-middle type is used to specify barline location."}],"title":"MXLRightLeftMiddle","url":"\/documentation\/i