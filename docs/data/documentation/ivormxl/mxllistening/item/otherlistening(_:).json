abstract":[{"type":"text","text":"The listen and listening types, new in Version 4.0, specify different ways that a score following or machine"},{"type":"text","text":" "},{"type":"text","text":"listening application can interact with a performer. The listening type handles interactions that change the"},{"type":"text","text":" "},{"type":"text","text":"state of the listening application from the specified point in the performance onward. If multiple child"},{"type":"text","text":" "},{"type":"text","text":"elements of the same type are present, they should have distinct player and\/or time-only attributes."}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLListening"}],"url":"\/documentation\/ivormxl\/mxllistening","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLListening"}],"title":"MXLListening","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLListening","type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLOtherListening":{"url":"\/documentation\/ivormxl\/mxlotherlistening","navigatorTitle":[{"text":"MXLOtherListening","kind":"identifier"}],"type":"topic","kind":"symbol","abstract":[{"text":"The other-listening type represents other types of listening control and interaction. The required type","type":"text"},{"text":" ","type":"text"},{"text":"attribute indicates the type of listening to which the element content applies. The optional player and time-","type":"text"},{"text":" ","type":"text"},{"text":"only attributes restrict the element to apply to a single player or set of times through a repeated section,","type":"text"},{"text":" ","type":"text"},{"text":"respectively.","type":"text"}],"role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOtherListening","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLOtherListening","kind":"identifier"}],"title":"MXLOtherListening"},"doc://IvorMXL/documentation/