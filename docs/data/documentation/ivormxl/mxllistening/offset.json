 validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLListening":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxllistening","title":"MXLListening","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLListening","kind":"identifier"}],"navigatorTitle":[{"text":"MXLListening","kind":"identifier"}],"abstract":[{"type":"text","text":"The listen and listening types, new in Version 4.0, specify different ways that a score following or machine"},{"type":"text","text":" "},{"type":"text","text":"listening application can interact with a performer. The listening type handles interactions that change the"},{"type":"text","text":" "},{"type":"text","text":"state of the listening application from the specified point in the performance onward. If multiple child"},{"type":"text","text":" "},{"type":"text","text":"elements of the same type are present, they should have distinct player and\/or time-only attributes."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLListening"},"doc://IvorMXL/documentation/IvorMXL/MXLListening/offset":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxllistening\/offset","title":"offset","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLListening\/offset","abstract":[{"type":"text","text":"Indicates that the listening change takes place offset from the current score position, in divisions."}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"offset","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLOffset","preciseIdentifier":"s:7IvorMXL9MXLOffsetV","kind":"typeIdentifier"},{"text":"?","kind":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLOffset":{"role":"symbol","url":"\/documentation\/ivormxl\/mxloffset","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLOffset","kind":"identifier"}],"navigatorTitle":[{"text":"MXLOffset","kind":"identifier"}],"abstract":[{"type":"text","text":"An offset is represented in terms of divisions, and indicates where the direction will appear relative to the"},{"type":"text","text":" "},{"type":"text","text":"current musical location. The current musical location is always within the current measure, even at the end"},{"type":"text","text":" "},{"type":"text","text":"of a measure."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLOffset","title":"MXLOffset","kind":"symbol"}}}