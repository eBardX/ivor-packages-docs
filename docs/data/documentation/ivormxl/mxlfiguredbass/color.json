}],"role":"symbol","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLFiguredBass":{"title":"MXLFiguredBass","url":"\/documentation\/ivormxl\/mxlfiguredbass","role":"symbol","navigatorTitle":[{"text":"MXLFiguredBass","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFiguredBass","kind":"symbol","abstract":[{"type":"text","text":"The figured-bass element represents figured bass notation. Figured bass elements take their position from the"},{"type":"text","text":" "},{"type":"text","text":"first regular note (not a grace note or chord note) that follows in score order. The optional duration element"},{"type":"text","text":" "},{"type":"text","text":"is used to indicate changes of figures under a note."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLFiguredBass","kind":"identifier"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlcolor","title":"MXLColor","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"type":"text","text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is"},{"type":"text","text":" "},{"type":"text","text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, valid