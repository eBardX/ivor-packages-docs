xt":"? = nil, ","kind":"text"},{"text":"halign","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLLeftCenterRight","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL18MXLLeftCenterRightO","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLeftCenterRight"},{"text":"? = nil, ","kind":"text"},{"text":"valign","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLValign","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLValignO","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValign"},{"text":"? = nil, ","kind":"text"},{"text":"placement","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLAboveBelow","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL13MXLAboveBelowO","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAboveBelow"},{"text":"? = nil, ","kind":"text"},{"text":"printout","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLPrintout","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLPrintoutV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrintout"},{"text":" = MXLPrintout(), ","kind":"text"},{"text":"hasParentheses","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":"? = nil)","kind":"text"}],"languages":["swift"],"platforms":["macOS"]}]},{"parameters":[{"name":"id","content":[{"inlineContent":[{"text":"The optional-unique-id attribute group allows an element to optionally specify an","type":"text"},{"type":"text","text":" "},{"type":"text","text":"ID that is unique to the entire document. This attribute group is not used for a"},{"type":"text","text":" "},{"type":"text","text":"required id attribute, or for an id attribute that specifies an id reference."}],"type":"paragraph"}]},{"name":"figure","content":[{"inlineContent":[{"type":"text","text":"The individual figures, ordered from top to bottom."}],"type":"paragraph"}]},{"name":"duration","content":[{"inlineContent":[{"text":"The duration element is defined within a group due to its uses within the note,","type":"text"},{"text":" ","type":"text"},{"text":"figured-bass, backup, and forward elements.","type":"text"}],"type":"paragraph"}]},{"name":"footnote","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The footnote element specifies editorial information that appears in footnotes in"},{"type":"text","text":" "},{"type":"text","text":"the printed score. It is defined within a group due to its multiple uses within the"},{"type":"text","text":" "},{"type":"text","text":"MusicXML schema."}]}]},{"name":"level","content":[{"inlineContent":[{"text":"The level element specifies editorial information for different MusicXML elements.","type":"text"},{"text":" ","type":"text"},{"text":"It is defined within a group due to its multiple uses within the MusicXML schema.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"For most elements, any program will compute a default x and y position. The","type":"text"},{"text":" ","type":"text"},{"text":"position attributes let this be changed two ways.","type":"text"}],"type":"paragraph"}],"name":"position"},{"content":[{"inlineContent":[{"text":"The font attribute group gathers together attributes for determining the font","type":"text"},{"text":" ","type":"text"},{"text":"within a credit or direction. They are based on the text styles for Cascading Style","type":"text"},{"text":" ","type":"text"},{"text":"Sheets. The font-family is a comma-separated list of font names. The font-style can","type":"text"},{"text":" ","type":"text"},{"text":"be normal or italic. The font-size can be one of the CSS sizes or a numeric point","type":"text"},{"text":" ","type":"text"},{"text":"size. The font-weight can be normal or bold. The default is application-dependent,","type":"text"},{"text":" ","type":"text"},{"text":"but is a text font vs. a music font.","type":"text"}],"type":"paragraph"}],"name":"font"},{"content":[{"inlineContent":[{"text":"The color attribute group indicates the color of an element.","type":"text"}],"type":"paragraph"}],"name":"color"},{"content":[{"inlineContent":[{"text":"In cases where text extends over more than one line, horizontal alignment and","type":"text"},{"text":" ","type":"text"},{"text":"justify values can be different.","type":"text"}],"type":"paragraph"}],"name":"halign"},{"content":[{"inlineContent":[{"text":"The valign attribute is used to indicate vertical alignment to the top, middle,","type":"text"},{"text":" ","type":"text"},{"text":"bottom, or baseline of the text. Defaults are implementation-dependent.","type":"text"}],"type":"paragraph"}],"name":"valign"},{"content":[{"inlineContent":[{"text":"The placement attribute indicates whether something is above or below another","type":"text"},{"text":" ","type":"text"},{"text":"element, such as a note or a notation.","type":"text"}],"type":"paragraph"}],"name":"placement"},{"content":[{"inlineContent":[{"text":"The printout attribute group collects the different controls over printing an","type":"text"},{"text":" ","type":"text"},{"text":"object (e.g. a note or rest) and its parts, including augmentation dots and lyrics.","type":"text"},{"text":" ","type":"text"},{"text":"This is especially useful for notes that overlap in different voices, or for chord","type":"text"},{"text":" ","type":"text"},{"text":"sheets that contain lyrics and chords but no melody.","type":"text"}],"type":"paragraph"}],"name":"printout"},{"content":[{"inlineContent":[{"text":"A Boolean value indicating whether the figures are enclosed in parentheses. ","type":"text"},{"type":"codeVoice","code":"false"},{"text":" ","type":"text"},{"text":"if not specified.","type":"text"}],"type":"paragraph"}],"name":"hasParentheses"}],"kind":"parameters"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLFigure":{"type":"topic","title":"MXLFigure","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFigure","abstract":[{"type":"text","text":"The figure type represents a single figure within a figured-bass element."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFigure"}],"navigatorTitle":[{"kind":"identifier","text":"MXLFigure"}],"url":"\/documentation\/ivormxl\/mxlfigure"},"doc://IvorMXL/documentation/IvorMXL/MXLFiguredBass":{"type":"topic","title":"MXLFiguredBass","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFiguredBass","abstract":[{"type":"text","text":"The figured-bass element represents figured bass notation. Figured bass elements take their position from the"},{"type":"text","text":" "},{"type":"text","text":"first regular note (not a grace note or chord note) that follows in score order. The optional duration element"},{"type":"text","text":" "},{"type":"text","text":"is used to indicate changes of figures under a note."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFiguredBass"}],"navigatorTitle":[{"kind":"identifier","text":"MXLFiguredBass"}],"url":"\/documentation\/ivormxl\/mxlfiguredbass"},"doc://IvorMXL/documentation/IvorMXL/MXLPrintout":{"type":"topic","title":"MXLPrintout","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPrintout","abstract":[{"text":"The printout attribute group collects the different controls over printing an object (e.g. a note or rest) and","type":"text"},{"text":" ","type":"text"},{"text":"its parts, including augmentation dots and lyrics. This is especially useful for notes that overlap in","type":"text"},{"text":" ","type":"text"},{"text":"different voices, or for chord sheets that contain lyrics and chords but no melody.","type":"text"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLPrintout","kind":"identifier"}],"navigatorTitle":[{"text":"MXLPrintout","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlprintout"},"doc://IvorMXL/documentation/IvorMXL/MXLPosition":{"type":"topic","abstract":[{"type":"text","text":"For most elements, any program will compute a default x and y position. The position attributes let this be"},{"type":"text","text":" "},{"type":"text","text":"changed two ways."}],"url":"\/documentation\/ivormxl\/mxlposition","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPosition"}],"kind":"symbol","title":"MXLPosition","navigatorTitle":[{"kind":"identifier","text":"MXLPosition"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLValign":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLValign","kind":"identifier"}],"title":"MXLValign","abstract":[{"type":"text","text":"The valign type is used to indicate vertical alignment to the top, middle, bottom, or baseline of the text. If"},{"type":"text","text":" "},{"type":"text","text":"the text is on multiple lines, baseline alignment refers to the baseline of the lowest line of text. Defaults"},{"type":"text","text":" "},{"type":"text","text":"are implementation-dependent."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValign","role":"symbol","url":"\/documentation\/ivormxl\/mxlvalign","kind":"symbol","navigatorTitle":[{"text":"MXLValign","kind":"identifier"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLLevel":{"type":"topic","abstract":[{"type":"text","text":"The level type is used to specify editorial information for different MusicXML elements. The content contains"},{"type":"text","text":" "},{"type":"text","text":"identifying and\/or descriptive text about the editorial status of the parent element."}],"url":"\/documentation\/ivormxl\/mxllevel","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLLevel","kind":"identifier"}],"kind":"symbol","title":"MXLLevel","navigatorTitle":[{"text":"MXLLevel","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLevel","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLLeftCenterRight":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLLeftCenterRight"}],"title":"MXLLeftCenterRight","abstract":[{"text":"The left-center-right type is used to define horizontal alignment and text justification.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLeftCenterRight","role":"symbol","url":"\/documentation\/ivormxl\/mxlleftcenterright","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLLeftCenterRight"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLPositiveDivisions":{"type":"topic","title":"MXLPositiveDivisions","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPositiveDivisions","abstract":[{"type":"text","text":"The positive-divisions type restricts divisions values to positive numbers."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPositiveDivisions"}],"navigatorTitle":[{"kind":"identifier","text":"MXLPositiveDivisions"}],"url":"\/documentation\/ivormxl\/mxlpositivedivisions"},"doc://IvorMXL/documentation/IvorMXL/MXLAboveBelow":{"type":"topic","title":"MXLAboveBelow","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAboveBelow","abstract":[{"type":"text","text":"The above-below type is used to indicate whether one element appears above or below another element."}],"role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLAboveBelow"}],"navigatorTitle":[{"kind":"identifier","text":"MXLAboveBelow"}],"url":"\/documentation\/ivormxl\/mxlabovebelow"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"type":"topic","abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"type":"text","text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is"},{"type":"text","text":" "},{"type":"text","text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF."}],"url":"\/documentation\/ivormxl\/mxlcolor","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"kind":"symbol","title":"MXLColor","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLFiguredBass/init(id:figure:duration:footnote:level:position:font:color:halign:valign:placement:printout:hasParentheses:)":{"type":"topic","title":"init(id:figure:duration:footnote:level:position:font:color:halign:valign:placement:printout:hasParentheses:)","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFiguredBass\/init(id:figure:duration:footnote:level:position:font:color:halign:valign:placement:printout:hasParentheses:)","abstract":[{"type":"text","text":"Creates a new "},{"code":"MXLFiguredBass","type":"codeVoice"},{"type":"text","text":"."}],"role":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"id"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"figure"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:7IvorMXL9MXLFigureV","kind":"typeIdentifier","text":"MXLFigure"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"duration"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL20MXLPositiveDivisionsV","kind":"typ