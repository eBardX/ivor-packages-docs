{"variants":[{"paths":["\/documentation\/ivormxl\/mxltuplet\/portion\/number-swift.struct\/equatable-implementations"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet\/Portion\/Number-swift.struct\/Equatable-Implementations","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet\/Portion","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet\/Portion\/Number-swift.struct"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"modules":[{"name":"IvorMXL"}],"role":"collectionGroup","roleHeading":"API Collection","title":"Equatable Implementations"},"sections":[],"topicSections":[{"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet\/Portion\/Number-swift.struct\/!=(_:_:)"],"anchor":"Operators","generated":true,"title":"Operators"}],"kind":"article","references":{"doc://IvorMXL/documentation/IvorMXL/MXLTuplet/Portion":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxltuplet\/portion","title":"MXLTuplet.Portion","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Portion","kind":"identifier"}],"navigatorTitle":[{"text":"Portion","kind":"identifier"}],"abstract":[{"type":"text","text":"The tuplet-portion type provides optional full control over tuplet specifications. It allows the number and"},{"type":"text","text":" "},{"type":"text","text":"note type (including dots) to be set for the actual and normal portions of a single tuplet. If any of these"},{"type":"text","text":" "},{"type":"text","text":"elements are absent, their values are based on the time-modification element."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet\/Portion"},"doc://IvorMXL/documentation/IvorMXL/MXLTuplet/Portion/Number-swift.struct":{"identifier":"doc:\/\/IvorMXL\/documentation\/Ivor