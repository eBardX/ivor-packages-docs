":[{"text":"MXLTuplet","kind":"identifier"}],"title":"MXLTuplet"},"doc://IvorMXL/documentation/IvorMXL/MXLTuplet/Portion":{"url":"\/documentation\/ivormxl\/mxltuplet\/portion","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Portion","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet\/Portion","title":"MXLTuplet.Portion","abstract":[{"type":"text","text":"The tuplet-portion type provides optional full control over tuplet specifications. It allows the number and"},{"type":"text","text":" "},{"type":"text","text":"note type (including dots) to be set for the actual and normal portions of a single tuplet. If any of these"},{"type":"text","text":" "},{"type":"text","text":"elements are absent, their values are based on the time-modification element."}],"navigatorTitle":[{"kind":"identifier","text":"Portion"}],"type":"topic"}}}