n\/IvorMXL\/MXLTuplet\/Portion","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet\/Portion\/Dot-swift.struct"]]},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLTuplet/Portion":{"type":"topic","title":"MXLTuplet.Portion","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet\/Portion","abstract":[{"type":"text","text":"The tuplet-portion type provides optional full control over tuplet specifications. It allows the number and"},{"type":"text","text":" "},{"type":"text","text":"note type (including dots) to be set for the actual and normal portions of a single tuplet. If any of these"},{"type":"text","text":" "},{"type":"text","text":"elements are absent, their values are based on the time-modification element."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Portion"}],"navigatorTitle":[{"kind":"identifier","text":"Portion"}],"url":"\/documentation\/ivormxl\/mxltuplet\/portion"},"doc://IvorMXL/documentation/IvorMXL/MXLTuplet/Portion/Dot-swift.struct/!=(_:_:)":{"abstract":[],"kind":"symbol","title":"!=(_:_:)","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet\/Portion\/Dot-swift.struct\/!=(_:_:)","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"!="},{"kind":"text","text":" "},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"role":"symbol","url":"\/documentation\/ivormxl\/mxltuplet\/portion\/dot-swift.struct\/!=(_:_:)"},"doc://IvorMXL/documentation/IvorMXL/MXLTuplet":{"type":"topic","abstract":[{"type":"text","text":"A tuplet element is present when a tuplet is to be displayed graphically, in addition to the sound data"},{"type":"text","text":" "},{"type":"text","text":"provided by the time-modification elements. The number attribute is used to distinguish nested tuplets. The"},{"type":"text","text":" "},{"type":"text","text":"bracket attribute is used to indicate the presence of a bracket. If unspecified, the results are"},{"type":"text","text":" "},{"type":"text","text":"implementation-dependent. The line-shape attribute is used to specify whether the bracket is straight or in"},{"type":"text","text":" "},{"type":"text","text":"the older curved or slurred style. It is straight by default."}],"url":"\/documentation\/ivormxl\/mxltuplet","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTuplet"}],"kind":"symbol","title":"MXLTuplet","navigatorTitle":[{"kind":"identifier","text":"MXLTuplet"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLTuplet/Portion/Dot-swift.struct":{"type":"topic","title":"MXLTuplet.Portion.Dot","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet\/Portion\/Dot-swift.struct","abstract":[{"text":"The tuplet-dot type is used to specify dotted tuplet types.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Dot"}],"navigatorTitle":[{"kind":"identifier","text":"Dot"}],"url":"\/documentation\/ivormxl\/mxltuplet\/portion\/dot-swift.struct"}}}