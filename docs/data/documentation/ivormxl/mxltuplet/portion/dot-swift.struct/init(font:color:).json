t"},{"text":"vs. a music font.","type":"text"}],"title":"MXLFont","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","kind":"symbol","url":"\/documentation\/ivormxl\/mxlfont","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLFont","kind":"identifier"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"}}}