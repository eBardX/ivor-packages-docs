esults are"},{"type":"text","text":" "},{"type":"text","text":"implementation-dependent. The line-shape attribute is used to specify whether the bracket is straight or in"},{"type":"text","text":" "},{"type":"text","text":"the older curved or slurred style. It is straight by default."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet","url":"\/documentation\/ivormxl\/mxltuplet","title":"MXLTuplet","navigatorTitle":[{"kind":"identifier","text":"MXLTuplet"}],"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTuplet"}]}}}