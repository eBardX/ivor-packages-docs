.Portion.Dot","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Dot","kind":"identifier"}],"navigatorTitle":[{"text":"Dot","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet\/Portion\/Dot-swift.struct","url":"\/documentation\/ivormxl\/mxltuplet\/portion\/dot-swift.struct","type":"topic","abstract":[{"type":"text","text":"The tuplet-dot type is used to specify dotted tuplet types."}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLTuplet/Portion/Dot-swift.struct/color":{"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet\/Portion\/Dot-swift.struct\/color","type":"topic","url":"\/documentation\/ivormxl\/mxltuplet\/portion\/dot-swift.struct\/color","role":"symbol","title":"color","abstract":[{"type":"text","text":"The color attribute group indicates the color of an element."}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"color"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL8MXLColorV","kind":"typeIdentifier","text":"MXLColor"},{"kind":"text","text":"?"}]},"doc://IvorMXL/documentation/IvorMXL/MXLTuplet/Portion":{"url":"\/documentation\/ivormxl\/mxltuplet\/portion","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Portion","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet\/Portion","title":"MXLTuplet.Portion","abstract":[{"type":"text","text":"The tuplet-portion type provides optional full control over tuplet specifications. It allows the number and"},{"type":"text","text":" "},{"type":"text","text":"note type (including dots) to be set for the actual and normal portions of a single tuplet. If any of these"},{"type":"text","text":" "},{"type":"text","text":"elements are absent, their values are based on the time-modification element."}],"navigatorTitle":[{"kind":"identifier","text":"Portion"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLTuplet":{"role":"symbol","url":"\/documentation\/ivormxl\/mxltuplet","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTuplet","kind":"identifier"}],"abstract":[{"type":"text","text":"A tuplet element is present when a tuplet is to be displayed graphically, in addition to the sound data"},{"type":"text","text":" "},{"type":"text","text":"provided by the time-modification elements. The number attribute is used to distinguish nested tuplets. The"},{"text":" ","type":"text"},{"text":"bracket attribute is used to indicate the presence of a bracket. If unspecified, the results are","type":"text"},{"text":" ","type":"text"},{"text":"implementation-dependent. The line-shape attribute is used to specify whether the bracket is straight or in","type":"text"},{"text":" ","type":"text"},{"text":"the older curved or slurred style. It is straight by default.","type":"text"}],"kind":"symbol","type":"topic","navigatorTitle":[{"text":"MXLTuplet","kind":"identifier"}],"title":"MXLTuplet"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"title":"MXLColor","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"abstract":[{"text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in","type":"text"},{"text":" ","type":"text"},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"url":"\/documentation\/ivormxl\/mxlcolor"}}}