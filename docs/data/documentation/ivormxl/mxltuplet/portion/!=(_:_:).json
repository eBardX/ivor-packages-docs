ifier","text":"MXLTuplet"}],"type":"topic","url":"\/documentation\/ivormxl\/mxltuplet","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet"},"doc://IvorMXL/documentation/IvorMXL/MXLTuplet/Portion":{"title":"MXLTuplet.Portion","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Portion","kind":"identifier"}],"kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxltuplet\/portion","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet\/Portion","abstract":[{"text":"The tuplet-portion type provides optional full control over tuplet specifications. It allows the number and","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"note type (including dots) to be set for the actual and normal portions of a single tuplet. If any of these"},{"type":"text","text":" "},{"type":"text","text":"elements are absent, their values are based on the time-modification element."}],"navigatorTitle":[{"text":"Portion","kind":"identifier"}]}}}