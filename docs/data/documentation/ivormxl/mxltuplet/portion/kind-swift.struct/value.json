hen a tuplet is to be displayed graphically, in addition to the sound data"},{"type":"text","text":" "},{"type":"text","text":"provided by the time-modification elements. The number attribute is used to distinguish nested tuplets. The"},{"type":"text","text":" "},{"type":"text","text":"bracket attribute is used to indicate the presence of a bracket. If unspecified, the results are"},{"type":"text","text":" "},{"type":"text","text":"implementation-dependent. The line-shape attribute is used to specify whether the bracket is straight or in"},{"type":"text","text":" "},{"type":"text","text":"the older curved or slurred style. It is straight by default."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet","url":"\/documentation\/ivormxl\/mxltuplet","title":"MXLTuplet","navigatorTitle":[{"kind":"identifier","text":"MXLTuplet"}],"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTuplet"}]},"doc://IvorMXL/documentation/IvorMXL/MXLTuplet/Portion/Kind-swift.struct":{"abstract":[{"text":"The tuplet-type type indicates the graphical note type of the notes for this portion of the tuplet.","type":"text"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Kind"}],"url":"\/documentation\/ivormxl\/mxltuplet\/portion\/kind-swift.struct","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Kind"}],"title":"MXLTuplet.Portion.Kind","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet\/Portion\/Kind-swift.struct","type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLNoteKindValue":{"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlnotekindvalue","abstract":[{"text":"The note-type-value type is used for the MusicXML type element and represents the graphic note type, from","type":"text"},{"text":" ","type":"text"},{"text":"1024th (shortest) to maxima (longest).","type":"text"}],