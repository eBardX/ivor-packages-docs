dValue","kind":"identifier"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLTuplet":{"abstract":[{"type":"text","text":"A tuplet element is present when a tuplet is to be displayed graphically, in addition to the sound data"},{"type":"text","text":" "},{"type":"text","text":"provided by the time-modification elements. The number attribute is used to distinguish nested tuplets. The"},{"type":"text","text":" "},{"type":"text","text":"bracket attribute is used to indicate the presence of a bracket. If unspecified, the results are"},{"type":"text","text":" "},{"text":"implementation-dependent. The line-shape attribute is used to specify whether the bracket is straight or in","type":"text"},{"text":" ","type":"text"},{"text":"the older curved or slurred style. It is straight by default.","type":"text"}],"title":"MXLTuplet","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTuplet"}],"navigatorTitle":[{"kind":"identifier","text":"MXLTuplet"}],"type":"topic","url":"\/documentation\/ivormxl\/mxltuplet","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet"},"doc://IvorMXL/documentation/IvorMXL/MXLTuplet/Portion/Kind-swift.struct/value":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet\/Portion\/Kind-swift.struct\/value","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"value","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLNoteKindValue","preciseIdentifier":"s:7IvorMXL16MXLNoteKindValueO","kind":"typeIdentifier"}],"role":"symbol","kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxltuplet\/portion\/kind-swift.struct\/value","abstract":[{"type":"text","text":"The value of this element."}],"title":"value"}}}