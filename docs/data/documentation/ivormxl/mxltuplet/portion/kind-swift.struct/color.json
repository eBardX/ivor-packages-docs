-swift.struct","kind":"symbol","url":"\/documentation\/ivormxl\/mxltuplet\/portion\/kind-swift.struct","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Kind"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"abstract":[{"text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in","type":"text"},{"type":"text","text":" "},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"title":"MXLColor","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlcolor","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor"},"doc://IvorMXL/documentation/IvorMXL/MXLTuplet/Portion":{"title":"MXLTuplet.Portion","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Portion","kind":"identifier"}],"kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxltuplet\/portion","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet\/Portion","abstract":[{"text":"The tuplet-portion type provides optional full control over tuplet specifications. It allows the number and","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"note type (including dots) to be set for the actual and normal portions of a single tuplet. If any of these"},{"type":"text","text":" "},{"type":"text","text":"elements are absent, their values are based on the time-modification element."}],"navigatorTitle":[{"text":"Portion","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLTuplet":{"abstract":[{"type":"text","text":"A tuplet element is present when a tuplet is to be displayed graphically, in addition to the sound data"},{"type":"text","text":" "},{"type":"text","text":"provided by the time-modification elements. The number attribute is used to distinguish nested tuplets. The"},{"type":"text","text":" "},{"type":"text","text":"bracket attribute is used to indicate the presence of a bracket. If unspecified, the results are"},{"type":"text","text":" "},{"text":"implementation-dependent. The line-shape attribute is used to specify whether the bracket is straight or in","type":"text"},{"text":" ","type":"text"},{"text":"the older curved or slurred style. It is straight by default.","type":"text"}],"title":"MXLTuplet","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTuplet"}],"navigatorTitle":[{"kind":"identifier","text":"MXLTuplet"}],"type":"topic","url":"\/documentation\/ivormxl\/mxltuplet","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet"},"doc://IvorMXL/documentation/IvorMXL/MXLTuplet/Portion/Kind-swift.struct/color":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet\/Portion\/Kind-swift.struct\/color","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"color","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLColor","preciseIdentifier":"s:7IvorMXL8MXLColorV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"role":"symbol","kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxltuplet\/portion\/kind-swift.struct\/color","abstract":[{"type":"text","text":"The color attribute 