er and"},{"type":"text","text":" "},{"type":"text","text":"note type (including dots) to be set for the actual and normal portions of a single tuplet. If any of these"},{"type":"text","text":" "},{"type":"text","text":"elements are absent, their values are based on the time-modification element."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet\/Portion"},"doc://IvorMXL/documentation/IvorMXL/MXLTuplet/Portion/Kind-swift.struct":{"role":"symbol","url":"\/documentation\/ivormxl\/mxltuplet\/portion\/kind-swift.struct","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Kind"}],"navigatorTitle":[{"kind":"identifier","text":"Kind"}],"abstract":[{"type":"text","text":"The tuplet-type type indicates the graphical note type of the notes for this portion of the tuplet."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet\/Portion\/Kind-swift.struct","title":"MXLTuplet.Portion.Kind","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLTuplet":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet","url":"\/documentation\/ivormxl\/mxltuplet","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTuplet"}],"title":"MXLTuplet","kind":"symbol","abstract":[{"type":"text","text":"A tuplet element is present when a tuplet is to be displayed graphically, in addition to the sound data"},{"type":"text","text":" "},{"type":"text","text":"provided by the time-modification elements. The number attribute is used to distinguish nested tuplets. The"},{"type":"text","text":" "},{"type":"text","text":"bracket attribute is used to indicate the presence of a bracket. If unspecified, the results are"},{"type":"text","text":" "},{"type":"text","text":"implementation-dependent. The line-shape attribute is used to specify whether the bracket is straight or in"},{"type":"text","text":" "},{"type":"text","text":"the older curved or slurred style. It is straight by default."}],"navigatorTitle":[{"text":"MXLTuplet","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLTuplet/Portion/Kind-swift.struct/init(value:font:color:)":{"title":"init(value:font:color:)","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet\/Portion\/Kind-swift.struct\/init(value:font:color:)","abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLTuplet.Portion.Kind"},{"type":"text","text":"."}],"type":"topic","url":"\/documentation\/ivormxl\/mxltuplet\/portion\/kind-swift.struct\/init(value:font:color:)","kind":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"value"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL16MXLNoteKindValueO","text":"MXLNoteKindValue"},{"kind":"text","text":", "},{"kind":"externalParam","text":"font"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL7MXLFontV","text":"MXLFont"},{"kind":"text","text":", "},{"kind":"externalParam","text":"color"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLColorV","text":"MXLColor"},{"kind":"text","text":"?)"}]},"doc://IvorMXL/documentation/IvorMXL/MXLNoteKindValue":{"kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNoteKindValue","kind":"identifier"}],"title":"MXLNoteKindValue","navigatorTitle":[{"text":"MXLNoteKindValue","kind":"identifier"}],"abstract":[{"type":"text","text":"The note-type-value type is used for the MusicXML type element and represents the graphic note type, from"},{"type":"text","text":" "},{"type":"text","text":"1024th (shortest) to maxima (longest)."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNoteKindValue","url":"\/documentation\/ivormxl\/mxlnotekindvalue","type":"topic","role":"symbol"},"doc