"identifier","text":"MXLTuplet"}],"title":"MXLTuplet","kind":"symbol","abstract":[{"type":"text","text":"A tuplet element is present when a tuplet is to be displayed graphically, in addition to the sound data"},{"type":"text","text":" "},{"type":"text","text":"provided by the time-modification elements. The number attribute is used to distinguish nested tuplets. The"},{"type":"text","text":" "},{"type":"text","text":"bracket attribute is used to indicate the presence of a bracket. If unspecified, the results are"},{"type":"text","text":" "},{"type":"text","text":"implementation-dependent. The line-shape attribute is used to specify whether the bracket is straight or in"},{"type":"text","text":" "},{"type":"text","text":"the older curved or slurred style. It is straight by default."}],"navigatorTitle":[{"text":"MXLTuplet","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLTuplet/Portion/!=(_:_:)":{"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"!=","kind":"identifier"},{"text":" ","kind":"text"},{"text":"(","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"abstract":[],"role":"symbol","kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxltuplet\/portion\/!=(_:_:)","title":"!=(_:_:)","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet\/Portion\/!=(_:_:)"}}}