/MXLTuplet/Portion":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxltuplet\/portion","title":"MXLTuplet.Portion","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Portion","kind":"identifier"}],"navigatorTitle":[{"text":"Portion","kind":"identifier"}],"abstract":[{"type":"text","text":"The tuplet-portion type provides optional full control over tuplet specifications. It allows the number and"},{"type":"text","text":" "},{"type":"text","text":"note type (including dots) to be set for the actual and normal portions of a single tuplet. If any of these"},{"type":"text","text":" "},{"type":"text","text":"elements are absent, their values are based on the time-modification element."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet\/Portion"},"doc://IvorMXL/documentation/IvorMXL/MXLTuplet/Portion/kind-swift.property":{"title":"kind","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet\/Portion\/kind-swift.property","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"kind"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL9MXLTupletV7PortionV4KindV","kind":"typeIdentifier","text":"Kind"},{"kind":"text","text":"?"}],"kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxltuplet\/portion\/kind-swift.property","abstract":[{"text":"The graphical note type of the notes for this portion of the tuplet, if specified. Based on the","type":"text"},{"text":" ","type":"text"},{"text":"time-modification element if absent.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLTuplet/Portion/Kind-swift.struct":{"role":"symbol","url":"\/documentation\/ivormxl\/mxltuplet\/portion\/kind-swift.struct","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Kind"}],"navigatorTitle":[{"kind":"identifier","text":"Kind"}],"abstract":[{"type":"text","text":"The tuplet-type type indicates the graphical note type of the notes for this portion of the tuplet."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet\/Portion\/Kind-swift.struct","title":"MXLTuplet.Portion.Kind","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLTuplet":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet","url":"\/documentation\/ivormxl\/mxltuplet","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTuplet"}],"title":"MXLTuplet","kind":"symbol","abstract":[{"type":"text","text":"A tuplet element is present when a tuplet is to be displayed graphically, in addition to the sound data"},{"type":"text","text":" "},{"type":"text","text":"provided by the time-modification elements. The number attribute is used to distinguish nested tuplets. The"},{"type":"text","text":" "},{"type":"text","text":"bracket attribute is used to indicate the presence of a bracket. If unspecified, the results are"},{"type":"text","text":" "},{"type":"text","text":"implementation-dependent. The line-shape attribute is used to specify whether the bracket is straight or in"},{"type":"text","text":" "},{"type":"text","text":"the older curved or slurred style. It is straight by default."}],"navigatorTitle":[{"text":"MXLTuplet","kind":"identifier"}]}}}