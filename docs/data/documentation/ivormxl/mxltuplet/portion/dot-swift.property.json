ortion":{"abstract":[{"type":"text","text":"The tuplet-portion type provides optional full control over tuplet specifications. It allows the number and"},{"type":"text","text":" "},{"type":"text","text":"note type (including dots) to be set for the actual and normal portions of a single tuplet. If any of these"},{"type":"text","text":" "},{"type":"text","text":"elements are absent, their values are based on the time-modification element."}],"role":"symbol","navigatorTitle":[{"text":"Portion","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxltuplet\/portion","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"kind":"identifier","text":"Portion"}],"title":"MXLTuplet.Portion","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet\/Portion","type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLTuplet/Portion/Dot-swift.struct":{"fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"Dot"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet\/Portion\/Dot-swift.struct","navigatorTitle":[{"text":"Dot","kind":"identifier"}],"type":"topic","title":"MXLTuplet.Portion.Dot","role":"symbol","abstract":[{"type":"text","text":"The tuplet-dot type is used to specify dotted tuplet types."}],"url":"\/documentation\/ivormxl\/mxltuplet\/portion\/dot-swift.struct","kind":"symbol"}}}