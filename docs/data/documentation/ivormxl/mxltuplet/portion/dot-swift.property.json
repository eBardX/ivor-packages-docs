n\/IvorMXL\/MXLTuplet","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTuplet","kind":"identifier"}],"abstract":[{"type":"text","text":"A tuplet element is present when a tuplet is to be displayed graphically, in addition to the sound data"},{"type":"text","text":" "},{"type":"text","text":"provided by the time-modification elements. The number attribute is used to distinguish nested tuplets. The"},{"text":" ","type":"text"},{"text":"bracket attribute is used to indicate the presence of a bracket. If unspecified, the results are","type":"text"},{"text":" ","type":"text"},{"text":"implementation-dependent. The line-shape attribute is used to specify whether the bracket is straight or in","type":"text"},{"text":" ","type":"text"},{"text":"the older curved or slurred style. It is straight by default.","type":"text"}],"kind":"symbol","type":"topic","navigatorTitle":[{"text":"MXLTuplet","kind":"identifier"}],"title":"MXLTuplet"},"doc://IvorMXL/documentation/IvorMXL/MXLTuplet/Portion/dot-swift.property":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet\/Portion\/dot-swift.property","abstract":[{"text":"The augmentation dots for the notes of this portion of the tuplet, if dotted.","type":"text"}],"url":"\/documentation\/ivormxl\/mxltuplet\/portion\/dot-swift.property","kind":"symbol","type":"topic","title":"dot","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dot","kind":"identifier"},{"text":": [","kind":"text"},{"text":"Dot","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLTupletV7PortionV3DotV"},{"text":"]","kind":"text"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLTuplet/Portion":{"url":"\/documentation\/ivormxl\/mxltuplet\/portion","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Portion","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet\/Portion","title":"MXLTuplet.Portion","abstract":[{"type":"text","text":"The tuplet-portion type provides optional full control over tuplet specifications. It allows the number and"},{"type":"text","text":" "},{"type":"text","text":"note type (including dots) to be set for the actual and normal portions of a single tuplet. If any of these"},{"type":"text","text":" "},{"type":"text","text":"elements are absent, their values are based on the time-modification element."}],"navigatorTitle":[{"kind":"identifier","text":"Portion"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLTuplet/Portion/Dot-swift.struct":{"title":"MXLTuplet.Portion.Dot","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Dot","kind":"identifier"}],"navigatorTitle":[{"text":"Dot","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet\/Portion\/Dot-swift.struct","url":"\/documentation\/ivormxl\/mxltuplet\/portion\/dot-swift.struct","type":"topic","abstract":[{"type":"text","text":"The tuplet-dot type is used to specify dotted tuplet types."}],"role":"symbol"}}}