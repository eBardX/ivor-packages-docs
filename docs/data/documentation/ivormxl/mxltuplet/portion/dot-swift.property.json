uplet","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTuplet"}],"title":"MXLTuplet","kind":"symbol","abstract":[{"type":"text","text":"A tuplet element is present when a tuplet is to be displayed graphically, in addition to the sound data"},{"type":"text","text":" "},{"type":"text","text":"provided by the time-modification elements. The number attribute is used to distinguish nested tuplets. The"},{"type":"text","text":" "},{"type":"text","text":"bracket attribute is used to indicate the presence of a bracket. If unspecified, the results are"},{"type":"text","text":" "},{"type":"text","text":"implementation-dependent. The line-shape attribute is used to specify whether the bracket is straight or in"},{"type":"text","text":" "},{"type":"text","text":"the older curved or slurred style. It is straight by default."}],"navigatorTitle":[{"text":"MXLTuplet","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLTuplet/Portion":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxltuplet\/portion","title":"MXLTuplet.Portion","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Portion","kind":"identifier"}],"navigatorTitle":[{"text":"Portion","kind":"identifier"}],"abstract":[{"type":"text","text":"The tuplet-portion type provides optional full control over tuplet specifications. It allows the number and"},{"type":"text","text":" "},{"type":"text","text":"note type (including dots) to be set for the actual and normal portions of a single tuplet. If any of these"},{"type":"text","text":" "},{"type":"text","text":"elements are absent, their values are based on the time-modification element."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet\/Portion"},"doc://IvorMXL/documentation/IvorMXL/MXLTuplet/Portion/dot-swift.property":{"type":"topic","url":"\/documentation\/ivormxl\/mxltuplet\/portion\/dot-swift