n/IvorMXL/MXLTuplet/Portion/Number-swift.struct":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet\/Portion\/Number-swift.struct","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Number","kind":"identifier"}],"title":"MXLTuplet.Portion.Number","navigatorTitle":[{"text":"Number","kind":"identifier"}],"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxltuplet\/portion\/number-swift.struct","abstract":[{"type":"text","text":"The tuplet-number type indicates the number of notes for this portion of the tuplet."}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLTuplet":{"role":"symbol","abstract":[{"type":"text","text":"A tuplet element is present when a tuplet is to be displayed graphically, in addition to the sound data"},{"type":"text","text":" "},{"type":"text","text":"provided by the time-modification elements. The number attribute is used to distinguish nested tuplets. The"},{"type":"text","text":" "},{"type":"text","text":"bracket attribute is used to indicate the presence of a bracket. If unspecified, the results are"},{"type":"text","text":" "},{"type":"text","text":"implementation-dependent. The line-shape attribute is used to specify whether the bracket is straight or in"},{"type":"text","text":" "},{"type":"text","text":"the older curved or slurred style. It is straight by default."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet","url":"\/documentation\/ivormxl\/mxltuplet","title":"MXLTuplet","navigatorTitle":[{"kind":"identifier","text":"MXLTuplet"}],"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","tex