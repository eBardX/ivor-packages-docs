n/IvorMXL/MXLTuplet/Portion/number-swift.property":{"type":"topic","abstract":[{"type":"text","text":"The number of notes for this portion of the tuplet, if specified. Based on the time-modification element"},{"type":"text","text":" "},{"type":"text","text":"if absent."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet\/Portion\/number-swift.property","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"number"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Number","preciseIdentifier":"s:7IvorMXL9MXLTupletV7PortionV6NumberV"},{"kind":"text","text":"?"}],"kind":"symbol","title":"number","url":"\/documentation\/ivormxl\/mxltuplet\/portion\/number-swift.property"},"doc://IvorMXL/documentation/IvorMXL/MXLTuplet/Portion":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxltuplet\/portion","title":"MXLTuplet.Portion","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Portion","kind":"identifier"}],"navigatorTitle":[{"text":"Portion","kind":"identifier"}],"abstract":[{"type":"text","text":"The tuplet-portion type provides optional full control over tuplet specifications. It allows the number and"},{"type":"text","text":" "},{"type":"text","text":"note type (including dots) to be set for the actual and normal portions of a single tuplet. If any of these"},{"type":"text","text":" "},{"type":"text","text":"elements are absent, their values are based on the time-modification element."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet\/Portion"},"doc://IvorMXL/documentation/IvorMXL/MXLTuplet":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet","url":"\/documentation\/ivormxl\/mxltuplet","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTuplet"}],"title":"MXLTuplet","kind":"symbol","abstract":[{"type":"text","text":"A tuplet element is present when a tuplet is to be displayed graphically, in addition to the sound data"},{"type":"text","text":" "},{"type":"text","text":"provided by the time-modification elements. The number attribute is used to distinguish nested tuplets. The"},{"type":"text","text":" "},{"type":"text","text":"bracket attribute is used to indicate the presence of a bracket. If unspecified, the results are"},{"type":"text","text":" "},{"type":"text","text":"implementation-dependent. The line-shape attribute is used to specify whether the bracket is straight or in"},{"type":"text","text":" "},{"type":"text","text":"the older curved or slurred style. It is straight by default."}],"navigatorTitle":[{"text":"MXLTuplet","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLTuplet/Portion/Number-swift.struct":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet\/Portion\/Number-swift.struct","abstract":[{"type":"text","text":"The tuplet-number type indicates the number of notes for this portion of the tuplet."}],"title":"MXLTuplet.Portion.Number","navigatorTitle":[{"kind":"identifier","text":"Number"}],"type":"topic","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Number"}],"url":"\/documentation\/ivormxl\/mxltuplet\/portion\/number-swift.struct"}}}