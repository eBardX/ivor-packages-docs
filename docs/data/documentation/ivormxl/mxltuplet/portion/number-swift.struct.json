nd":"identifier","text":"Number"}],"type":"topic","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Number"}],"url":"\/documentation\/ivormxl\/mxltuplet\/portion\/number-swift.struct"},"doc://IvorMXL/documentation/IvorMXL/MXLTuplet/Portion/Number-swift.struct/font":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet\/Portion\/Number-swift.struct\/font","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"font"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL7MXLFontV","text":"MXLFont"}],"role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"The font attribute group gathers together attributes for determining the font within a credit or direction."},{"type":"text","text":" "},{"type":"text","text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of"},{"type":"text","text":" "},{"type":"text","text":"font names.The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric"},{"type":"text","text":" "},{"type":"text","text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font"},{"type":"text","text":" "},{"type":"text","text":"vs. a music font."}],"type":"topic","title":"font","url":"\/documentation\/ivormxl\/mxltuplet\/portion\/number-swift.struct\/font"},"doc://IvorMXL/s8CopyableP":{"title":"Swift.Copyable","type":"unresolvable","identifier":"doc:\/\/IvorMXL\/s8CopyableP"},"doc://IvorMXL/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","type":"unresolvable","identifier":"doc:\/\/IvorMXL\/s16SendableMetatypeP"},"doc://IvorMXL/SQ":{"title":"Swift.Equatable","type":"unresolvable","identifier":"doc:\/\/IvorMXL\/SQ"},"doc://IvorMXL/documentation/IvorMXL/MXLTuplet":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet",