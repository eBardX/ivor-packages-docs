, or neither."},{"type":"text","text":" "},{"type":"text","text":"Defaults to "},{"type":"codeVoice","code":"actual"},{"type":"text","text":" if not specified."}]},"doc://IvorMXL/documentation/IvorMXL/MXLShowTuplet":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLShowTuplet","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"MXLShowTuplet","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlshowtuplet","role":"symbol","title":"MXLShowTuplet","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLShowTuplet","type":"topic","abstract":[{"type":"text","text":"The show-tuplet type indicates whether to show a part of a tuplet relating to the tuplet-actual element, both"},{"type":"text","text":" "},{"type":"text","text":"the tuplet-actual and tuplet-normal elements, or neither."}]}}}