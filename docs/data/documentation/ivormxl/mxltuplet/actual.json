{"sections":[],"abstract":[{"text":"The tuplet-actual element provide optional full control over how the actual part of the tuplet is displayed,","type":"text"},{"text":" ","type":"text"},{"text":"including number and note type (with dots). If any of these elements are absent, their values are based on the","type":"text"},{"text":" ","type":"text"},{"text":"time-modification element.","type":"text"}],"variants":[{"paths":["\/documentation\/ivormxl\/mxltuplet\/actual"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"title":"actual","externalID":"s:7IvorMXL9MXLTupletV6actualAC7PortionVSgvp","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"actual","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL9MXLTupletV7PortionV","text":"Portion","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"role":"symbol","modules":[{"name":"IvorMXL"}],"roleHeading":"Instance Property","symbolKind":"property"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"actual","kind":"identifier"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet\/Portion","preciseIdentifier":"s:7IvorMXL9MXLTupletV7PortionV","text":"Portion","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"languages":["swift"],"platforms":["macOS"]}]},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Maps to a nested MusicXML "},{"code":"<tuplet-actual>","type":"codeVoice"},{"type":"text","text":" element."}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet\/actual","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet"]]},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLTuplet":{"abstract":[{"type":"text","text":"A tuplet element is present when a tuplet is to be displayed graphically, in addition to the sound data"},{"type":"text","text":" "},{"type":"text","text":"provided by the time-modification elements. The number attribute is used to distinguish nested tuplets. The"},{"type":"text","text":" "},{"type":"text","text":"bracket attribute is used to indicate the presence of a bracket. If unspecified, the results are"},{"type":"text","text":" "},{"text":"implementation-dependent. The line-shape attribute is used to specify whether the bracket is straight or in","type":"text"},{"text":" ","type":"text"},{"text":"the older curved or slurred style. It is straight by default.","type":"text"}],"title":"MXLTuplet","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTuplet"}],"navigatorTitle":[{"kind":"identifier","text":"MXLTuplet"}],"type":"topic","url":"\/documentation\/ivormxl\/mxltuplet","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet"},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLTuplet/actual":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet\/actual","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"actual"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLTupletV7PortionV","text":"Portion"},{"kind":"text","text":"?"}],"role":"symbol","kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxltuplet\/actual","title":"actual","abstract":[{"type":"text","text":"The tuplet-actual element provide optional full control over how the actual part of the tuplet is displayed,"},{"type":"text","text":" "},{"type":"text","text":"including number and note type (with dots). If any of these elements are absent, their values are based on the"},{"type":"text","text":" "},{"type":"text","text":"time-modification element."}]},"doc://IvorMXL/documentation/IvorMXL/MXLTuplet/Portion":{"title":"MXLTuplet.Portion","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Portion","kind":"identifier"}],"kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxltuplet\/portion","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet\/Portion","abstract":[{"text":"The tuplet-portion type provides optional full control over tuplet specifications. It allows the number and","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"note type (including dots) to be set for the actual and normal portions of a single tuplet. If any of these"},{"type":"text","text":" "},{"type":"text","text":"elements are absent, their values are based on the time-modification element."}],"navigatorTitle":[{"text":"Portion","kind":"identifier"}]}}}