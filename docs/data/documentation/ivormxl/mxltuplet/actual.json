{"sections":[],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet\/actual"},"metadata":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"actual","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Portion","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLTupletV7PortionV"},{"text":"?","kind":"text"}],"symbolKind":"property","externalID":"s:7IvorMXL9MXLTupletV6actualAC7PortionVSgvp","role":"symbol","title":"actual","roleHeading":"Instance Property","modules":[{"name":"IvorMXL"}]},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"actual","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Portion","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLTupletV7PortionV","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet\/Portion"},{"text":"?","kind":"text"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"Maps to a nested MusicXML ","type":"text"},{"type":"codeVoice","code":"<tuplet-actual>"},{"text":" element.","type":"text"}],"type":"paragraph"}]}],"abstract":[{"text":"The tuplet-actual element provide optional full control over how the actual part of the tuplet is displayed,","type":"text"},{"text":" ","type":"text"},{"text":"including number and note type (with dots). If any of these elements are absent, their values are based on the","type":"text"},{"text":" ","type":"text"},{"text":"time-modification element.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxltuplet\/actual"]}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLTuplet/actual":{"url":"\/documentation\/ivormxl\/mxltuplet\/actual","type":"topic","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet\/actual","title":"actual","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"actual"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLTupletV7PortionV","text":"Portion"},{"kind":"text","text":"?"}],"abstract":[{"text":"The tuplet-actual element provide optional full control over how the actual part of the tuplet is displayed,","type":"text"},{"text":" ","type":"text"},{"text":"including number and note type (with dots). If any of these elements are absent, their values are based on the","type":"text"},{"text":" ","type":"text"},{"text":"time-modification element.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLTuplet":{"role":"symbol","url":"\/documentation\/ivormxl\/mxltuplet","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLTuplet","kind":"identifier"}],"abstract":[{"type":"text","text":"A tuplet element is present when a tuplet is to be displayed graphically, in addition to the sound data"},{"type":"text","text":" "},{"type":"text","text":"provided by the time-modification elements. The number attribute is used to distinguish nested tuplets. The"},{"text":" ","type":"text"},{"text":"bracket attribute is used to indicate the presence of a bracket. If unspecified, the results are","type":"text"},{"text":" ","type":"text"},{"text":"implementation-dependent. The line-shape attribute is used to specify whether the bracket is straight or in","type":"text"},{"text":" ","type":"text"},{"text":"the older curved or slurred style. It is straight by default.","type":"text"}],"kind":"symbol","type":"topic","navigatorTitle":[{"text":"MXLTuplet","kind":"identifier"}],"title":"MXLTuplet"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLTuplet/Portion":{"url":"\/documentation\/ivormxl\/mxltuplet\/portion","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Portion","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet\/Portion","title":"MXLTuplet.Portion","abstract":[{"type":"text","text":"The tuplet-portion type provides optional full control over tuplet specifications. It allows the number and"},{"type":"text","text":" "},{"type":"text","text":"note type (including dots) to be set for the actual and normal portions of a single tuplet. If any of these"},{"type":"text","text":" "},{"type":"text","text":"elements are absent, their values are based on the time-modification element."}],"navigatorTitle":[{"kind":"identifier","text":"Portion"}],"type":"topic"}}}