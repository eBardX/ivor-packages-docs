{"sections":[],"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet\/actual"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"actual","kind":"identifier"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet\/Portion","text":"Portion","preciseIdentifier":"s:7IvorMXL9MXLTupletV7PortionV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"languages":["swift"]}]},{"content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"Maps to a nested MusicXML ","type":"text"},{"code":"<tuplet-actual>","type":"codeVoice"},{"text":" element.","type":"text"}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxltuplet\/actual"]}],"abstract":[{"type":"text","text":"The tuplet-actual element provide optional full control over how the actual part of the tuplet is displayed,"},{"type":"text","text":" "},{"type":"text","text":"including number and note type (with dots). If any of these elements are absent, their values are based on the"},{"type":"text","text":" "},{"type":"text","text":"time-modification element."}],"metadata":{"symbolKind":"property","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"actual","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Portion","preciseIdentifier":"s:7IvorMXL9MXLTupletV7PortionV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"title":"actual","modules":[{"name":"IvorMXL"}],"roleHeading":"Instance Property","externalID":"s:7IvorMXL9MXLTupletV6actualAC7PortionVSgvp"},"references":{"doc://IvorMXL/documentation/IvorMXL/MXLTuplet/actual":{"url":"\/documentation\/ivormxl\/mxltuplet\/actual","abstract":[{"type":"text","text":"The tuplet-actual element provide optional full control over how the actual part of the tuplet is displayed,"},{"type":"text","text":" "},{"type":"text","text":"including number and note type (with dots). If any of these elements are absent, their values are based on the"},{"type":"text","text":" "},{"type":"text","text":"time-modification element."}],"title":"actual","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet\/actual","type":"topic","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"actual","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Portion","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLTupletV7PortionV"},{"text":"?","kind":"text"}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLTuplet":{"type":"topic","abstract":[{"type":"text","text":"A tuplet element is present when a tuplet is to be displayed graphically, in addition to the sound data"},{"type":"text","text":" "},{"type":"text","text":"provided by the time-modification elements. The number attribute is used to distinguish nested tuplets. The"},{"type":"text","text":" "},{"type":"text","text":"bracket attribute is used to indicate the presence of a bracket. If unspecified, the results are"},{"type":"text","text":" "},{"type":"text","text":"implementation-dependent. The line-shape attribute is used to specify whether the bracket is straight or in"},{"type":"text","text":" "},{"type":"text","text":"the older curved or slurred style. It is straight by default."}],"url":"\/documentation\/ivormxl\/mxltuplet","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTuplet"}],"kind":"symbol","title":"MXLTuplet","navigatorTitle":[{"kind":"identifier","text":"MXLTuplet"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLTuplet/Portion":{"type":"topic","title":"MXLTuplet.Portion","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet\/Portion","abstract":[{"type":"text","text":"The tuplet-portion type provides optional full control over tuplet specifications. It allows the number and"},{"type":"text","text":" "},{"type":"text","text":"note type (including dots) to be set for the actual and normal portions of a single tuplet. If any of these"},{"type":"text","text":" "},{"type":"text","text":"elements are absent, their values are based on the time-modification element."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Portion"}],"navigatorTitle":[{"kind":"identifier","text":"Portion"}],"url":"\/documentation\/ivormxl\/mxltuplet\/portion"}}}