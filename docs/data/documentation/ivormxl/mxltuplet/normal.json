{"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet"]]},"kind":"symbol","abstract":[{"type":"text","text":"The tuplet-normal element provide optional full control over how the normal part of the tuplet is displayed,"},{"text":" ","type":"text"},{"type":"text","text":"including number and note type (with dots). If any of these elements are absent, their values are based on the"},{"text":" ","type":"text"},{"type":"text","text":"time-modification element."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"let"},{"text":" ","kind":"text"},{"kind":"identifier","text":"normal"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet\/Portion","preciseIdentifier":"s:7IvorMXL9MXLTupletV7PortionV","text":"Portion"},{"text":"?","kind":"text"}],"platforms":["macOS"]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Maps to a nested MusicXML ","type":"text"},{"code":"<tuplet-normal>","type":"codeVoice"},{"text":" element.","type":"text"}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxltuplet\/normal"]}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet\/normal","interfaceLanguage":"swift"},"metadata":{"role":"symbol","externalID":"s:7IvorMXL9MXLTupletV6normalAC7PortionVSgvp","symbolKind":"property","roleHeading":"Instance Property","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"normal"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLTupletV7PortionV","text":"Portion"},{"kind":"text","text":"?"}],"title":"normal","modules":[{"name":"IvorMXL"}]},"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLTuplet/normal":{"abstract":[{"text":"The tuplet-normal element provide optional full control over how the normal part of the tuplet is displayed,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"including number and note type (with dots). If any of these elements are absent, their values are based on the"},{"type":"text","text":" "},{"type":"text","text":"time-modification element."}],"role":"symbol","url":"\/documentation\/ivormxl\/mxltuplet\/normal","kind":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"normal"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Portion","preciseIdentifier":"s:7IvorMXL9MXLTupletV7PortionV"},{"kind":"text","text":"?"}],"title":"normal","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet\/normal","type":"topic"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLTuplet":{"role":"symbol","abstract":[{"type":"text","text":"A tuplet element is present when a tuplet is to be displayed graphically, in addition to the sound data"},{"type":"text","text":" "},{"type":"text","text":"provided by the time-modification elements. The number attribute is used to distinguish nested tuplets. The"},{"type":"text","text":" "},{"type":"text","text":"bracket attribute is used to indicate the presence of a bracket. If unspecified, the results are"},{"type":"text","text":" "},{"type":"text","text":"implementation-dependent. The line-shape attribute is used to specify whether the bracket is straight or in"},{"type":"text","text":" "},{"type":"text","text":"the older curved or slurred style. It is straight by default."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet","url":"\/documentation\/ivormxl\/mxltuplet","title":"MXLTuplet","navigatorTitle":[{"kind":"identifier","text":"MXLTuplet"}],"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTuplet"}]},"doc://IvorMXL/documentation/IvorMXL/MXLTuplet/Portion":{"abstract":[{"type":"text","text":"The tuplet-portion type provides optional full control over tuplet specifications. It allows the number and"},{"type":"text","text":" "},{"type":"text","text":"note type (including dots) to be set for the actual and normal portions of a single tuplet. If any of these"},{"type":"text","text":" "},{"type":"text","text":"elements are absent, their values are based on the time-modification element."}],"role":"symbol","navigatorTitle":[{"text":"Portion","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxltuplet\/portion","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"kind":"identifier","text":"Portion"}],"title":"MXLTuplet.Portion","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet\/Portion","type":"topic"}}}