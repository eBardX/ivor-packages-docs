ype (including dots) to be set for the actual and normal portions of a single tuplet. If any of these"},{"type":"text","text":" "},{"type":"text","text":"elements are absent, their values are based on the time-modification element."}],"navigatorTitle":[{"text":"Portion","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLTuplet/normal":{"url":"\/documentation\/ivormxl\/mxltuplet\/normal","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet\/normal","kind":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"text":"normal","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Portion","preciseIdentifier":"s:7IvorMXL9MXLTupletV7PortionV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"title":"normal","abstract":[{"type":"text","text":"The tuplet-normal element provide optional full control over how the normal part of the tuplet is displayed,"},{"type":"text","text":" "},{"type":"text","text":"including number and note type (with dots). If any of these elements are absent, their values are based on the"},{"type":"text","text":" "},{"type":"text","text":"time-modification element."}],"type":"topic","role":"symbol"}}}