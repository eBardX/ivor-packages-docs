{"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"normal"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL9MXLTupletV7PortionV","kind":"typeIdentifier","text":"Portion","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet\/Portion"},{"kind":"text","text":"?"}]}],"kind":"declarations"},{"content":[{"anchor":"discussion","text":"Discussion","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Maps to a nested MusicXML "},{"code":"<tuplet-normal>","type":"codeVoice"},{"type":"text","text":" element."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/ivormxl\/mxltuplet\/normal"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"modules":[{"name":"IvorMXL"}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"normal","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL9MXLTupletV7PortionV","text":"Portion","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"symbolKind":"property","title":"normal","externalID":"s:7IvorMXL9MXLTupletV6normalAC7PortionVSgvp","roleHeading":"Instance Property","role":"symbol"},"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet\/normal","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet"]]},"abstract":[{"text":"The tuplet-normal element provide optional full control over how the normal part of the tuplet is displayed,","type":"text"},{"text":" ","type":"text"},{"text":"including number and note type (with dots). If any of these elements are absent, their values are based on the","type":"text"},{"text":" ","type":"text"},{"text":"time-modification element.","type":"text"}],"kind":"symbol","references":{"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLTuplet":{"type":"topic","abstract":[{"type":"text","text":"A tuplet element is present when a tuplet is to be displayed graphically, in addition to the sound data"},{"type":"text","text":" "},{"type":"text","text":"provided by the time-modification elements. The number attribute is used to distinguish nested tuplets. The"},{"type":"text","text":" "},{"type":"text","text":"bracket attribute is used to indicate the presence of a bracket. If unspecified, the results are"},{"type":"text","text":" "},{"type":"text","text":"implementation-dependent. The line-shape attribute is used to specify whether the bracket is straight or in"},{"type":"text","text":" "},{"type":"text","text":"the older curved or slurred style. It is straight by default."}],"url":"\/documentation\/ivormxl\/mxltuplet","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTuplet"}],"kind":"symbol","title":"MXLTuplet","navigatorTitle":[{"kind":"identifier","text":"MXLTuplet"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLTuplet/normal":{"url":"\/documentation\/ivormxl\/mxltuplet\/normal","abstract":[{"type":"text","text":"The tuplet-normal element provide optional full control over how the normal part of the tuplet is displayed,"},{"type":"text","text":" "},{"type":"text","text":"including number and note type (with dots). If any of these elements are absent, their values are based on the"},{"type":"text","text":" "},{"type":"text","text":"time-modification element."}],"title":"normal","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet\/normal","type":"topic","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"normal","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Portion","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLTupletV7PortionV"},{"text":"?","kind":"text"}],"kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLTuplet/Portion":{"type":"topic","title":"MXLTuplet.Portion","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTuplet\/Portion","abstract":[{"type":"text","text":"The tuplet-portion type provides optional full control over tuplet specifications. It allows the number and"},{"type":"text","text":" "},{"type":"text","text":"note type (including dots) to be set for the actual and normal portions of a single tuplet. If any of these"},{"type":"text","text":" "},{"type":"text","text":"elements are absent, their values are based on the time-modification element."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Portion"}],"navigatorTitle":[{"kind":"identifier","text":"Portion"}],"url":"\/documentation\/ivormxl\/mxltuplet\/portion"}}}