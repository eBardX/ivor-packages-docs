{"kind":"symbol","variants":[{"paths":["\/documentation\/ivormxl\/mxlaccidentalmark\/font"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"symbolKind":"property","roleHeading":"Instance Property","externalID":"s:7IvorMXL17MXLAccidentalMarkV4fontAA7MXLFontVvp","title":"font","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"kind":"text","text":" "},{"text":"font","kind":"identifier"},{"kind":"text","text":": "},{"text":"MXLFont","preciseIdentifier":"s:7IvorMXL7MXLFontV","kind":"typeIdentifier"}],"modules":[{"name":"IvorMXL"}]},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidentalMark"]]},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"font","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLFont","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL7MXLFontV"}],"platforms":["macOS"]}]}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidentalMark\/font","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"type":"text","text":"The font attribute group gathers together attributes for determining the font within a credit or direction. They"},{"type":"text","text":" "},{"type":"text","text":"are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of font"},{"type":"text","text":" "},{"type":"text","text":"names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric point"},{"type":"text","text":" "},{"type":"text","text":"size. The font-weight can be normal or bold. The default is application-dependent, but is a text font vs. a"},{"type":"text","text":" "},{"type":"text","text":"music font."}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLAccidentalMark":{"type":"topic","abstract":[{"type":"text","text":"An accidental-mark can be used as a separate notation or as part of an ornament. When used in an ornament,"},{"type":"text","text":" "},{"type":"text","text":"position and placement are relative to the ornament, not relative to the note."}],"url":"\/documentation\/ivormxl\/mxlaccidentalmark","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLAccidentalMark"}],"kind":"symbol","title":"MXLAccidentalMark","navigatorTitle":[{"kind":"identifier","text":"MXLAccidentalMark"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidentalMark","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLAccidentalMark/font":{"kind":"symbol","role":"symbol","title":"font","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"font"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL7MXLFontV","kind":"typeIdentifier","text":"MXLFont"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidentalMark\/font","url":"\/documentation\/ivormxl\/mxlaccidentalmark\/font","abstract":[{"type":"text","text":"The font attribute group gathers together attributes for determining the font within a credit or direction. They"},{"type":"text","text":" "},{"type":"text","text":"are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of font"},{"type":"text","text":" "},{"type":"text","text":"names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric point"},{"type":"text","text":" "},{"type":"text","text":"size. The font-weight can be normal or bold. The default is application-dependent, but is a text font vs. a"},{"type":"text","text":" "},{"type":"text","text":"music font."}]},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLFont":{"type":"topic","title":"MXLFont","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","abstract":[{"type":"text","text":"The font attribute group gathers together attributes for determining the font within a credit or direction."},{"type":"text","text":" "},{"type":"text","text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of"},{"type":"text","text":" "},{"type":"text","text":"font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric"},{"type":"text","text":" "},{"type":"text","text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font"},{"type":"text","text":" "},{"type":"text","text":"vs. a music font."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFont"}],"navigatorTitle":[{"kind":"identifier","text":"MXLFont"}],"url":"\/documentation\/ivormxl\/mxlfont"}}}