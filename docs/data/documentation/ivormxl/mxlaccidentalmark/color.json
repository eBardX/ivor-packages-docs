gatorTitle":[{"kind":"identifier","text":"MXLColor"}],"abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlcolor"},"doc://IvorMXL/documentation/IvorMXL/MXLAccidentalMark/color":{"role":"symbol","kind":"symbol","url":"\/documentation\/ivormxl\/mxlaccidentalmark\/color","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidentalMark\/color","abstract":[{"type":"text","text":"The color attribute group indicates the color of an element."}],"type":"topic","title":"color","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"color"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLColor","preciseIdentifier":"s:7IvorMXL8MXLColorV"},{"kind":"text","text":"?"}]},"doc://IvorMXL/documentation/IvorMXL/MXLAccidentalMark":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidentalMark","type":"topic","abstract":[{"text":"An accidental-mark can be used as a separate notation or as part of an ornament. When used in an ornament,","type":"text"},{"text":" ","type":"text"},{"text":"position and placement are relative to the ornament, not relative to the note.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlaccidentalmark","role":"symbol","kind":"symbol","title":"MXLAccidentalMark","navigatorTitle":[{"text":"MXLAccidentalMark","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLAccidentalMark","kind":"identifier"}]}}}