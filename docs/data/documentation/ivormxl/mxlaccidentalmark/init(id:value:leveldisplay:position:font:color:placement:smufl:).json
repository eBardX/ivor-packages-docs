{"abstract":[{"text":"Creates a new ","type":"text"},{"code":"MXLAccidentalMark","type":"codeVoice"},{"text":".","type":"text"}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"id"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"value"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidentalValue","text":"MXLAccidentalValue","preciseIdentifier":"s:7IvorMXL18MXLAccidentalValueO"},{"kind":"text","text":", "},{"kind":"externalParam","text":"levelDisplay"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLevel","text":"MXLLevel","preciseIdentifier":"s:7IvorMXL8MXLLevelV"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLevel\/Display-swift.struct","text":"Display","preciseIdentifier":"s:7IvorMXL8MXLLevelV7DisplayV"},{"kind":"text","text":" = MXLLevel.Display(), "},{"kind":"externalParam","text":"position"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","text":"MXLPosition","preciseIdentifier":"s:7IvorMXL11MXLPositionV"},{"kind":"text","text":" = MXLPosition(), "},{"kind":"externalParam","text":"font"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","text":"MXLFont","preciseIdentifier":"s:7IvorMXL7MXLFontV"},{"kind":"text","text":" = MXLFont(), "},{"kind":"externalParam","text":"color"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","text":"MXLColor","preciseIdentifier":"s:7IvorMXL8MXLColorV"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"placement"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAboveBelow","text":"MXLAboveBelow","preciseIdentifier":"s:7IvorMXL13MXLAboveBelowO"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"smufl"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSmuflAccidentalGlyphName","text":"MXLSmuflAccidentalGlyphName","preciseIdentifier":"s:7IvorMXL27MXLSmuflAccidentalGlyphNameV"},{"kind":"text","text":"? = nil)"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"id","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The optional-unique-id attribute group allows an element to optionally specify an ID"},{"type":"text","text":" "},{"type":"text","text":"that is unique to the entire document. This attribute group is not used for a"},{"type":"text","text":" "},{"type":"text","text":"required id attribute, or for an id attribute that specifies an id reference."}]}]},{"name":"value","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The value of this element."}]}]},{"name":"levelDisplay","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The level-display attribute group specifies three common ways to indicate editorial"},{"type":"text","text":" "},{"type":"text","text":"indications: putting parentheses or square brackets around a symbol, or making the"},{"type":"text","text":" "},{"type":"text","text":"symbol a different size. If not specified, they are left to application defaults. It"},{"type":"text","text":" "},{"type":"text","text":"is used by the level and accidental elements."}]}]},{"name":"position","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For most elements, any program will compute a default x and y position. The position"},{"type":"text","text":" "},{"type":"text","text":"attributes let this be changed two ways."}]}]},{"name":"font","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The font attribute group gathers together attributes for determining the font within"},{"type":"text","text":" "},{"type":"text","text":"a credit or direction. They are based on the text styles for Cascading Style Sheets."},{"type":"text","text":" "},{"type":"text","text":"The font-family is a comma-separated list of font names. The font-style can be normal"},{"type":"text","text":" "},{"type":"text","text":"or italic. The font-size can be one of the CSS sizes or a numeric point size. The"},{"type":"text","text":" "},{"type":"text","text":"font-weight can be normal or bold. The default is application-dependent, but is a"},{"type":"text","text":" "},{"type":"text","text":"text font vs. a music font."}]}]},{"name":"color","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The color attribute group indicates the color of an element."}]}]},{"name":"placement","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The placement attribute indicates whether something is above or below another"},{"type":"text","text":" "},{"type":"text","text":"element, such as a note or a notation."}]}]},{"name":"smufl","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The SMuFL canonical glyph name used to specify a particular accidental character."}]}]}]}],"variants":[{"paths":["\/documentation\/ivormxl\/mxlaccidentalmark\/init(id:value:leveldisplay:position:font:color:placement:smufl:)"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"roleHeading":"Initializer","modules":[{"name":"IvorMXL"}],"symbolKind":"init","externalID":"s:7IvorMXL17MXLAccidentalMarkV2id5value12levelDisplay8position4font5color9placement5smuflACSSSg_AA0C5ValueOAA8MXLLevelV0H0VAA11MXLPositionVAA7MXLFontVAA8MXLColorVSgAA13MXLAboveBelowOSgAA27MXLSmuflAccidentalGlyphNameVSgtcfc","role":"symbol","title":"init(id:value:levelDisplay:position:font:color:placement:smufl:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"id"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"value"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLAccidentalValue","preciseIdentifier":"s:7IvorMXL18MXLAccidentalValueO"},{"kind":"text","text":", "},{"kind":"externalParam","text":"levelDisplay"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLLevel","preciseIdentifier":"s:7IvorMXL8MXLLevelV"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Display","preciseIdentifier":"s:7IvorMXL8MXLLevelV7DisplayV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"position"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLPosition","preciseIdentifier":"s:7IvorMXL11MXLPositionV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"font"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLFont","preciseIdentifier":"s:7IvorMXL7MXLFontV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"color"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLColor","preciseIdentifier":"s:7IvorMXL8MXLColorV"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"placement"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLAboveBelow","preciseIdentifier":"s:7IvorMXL13MXLAboveBelowO"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"smufl"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLSmuflAccidentalGlyphName","preciseIdentifier":"s:7IvorMXL27MXLSmuflAccidentalGlyphNameV"},{"kind":"text","text":"?)"}]},"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidentalMark"]]},"kind":"symbol","identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidentalMark\/init(id:value:levelDisplay:position:font:color:placement:smufl:)","interfaceLanguage":"swift"},"sections":[],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLPosition":{"type":"topic","abstract":[{"type":"text","text":"For most elements, any program will compute a default x and y position. The position attributes let this be"},{"type":"text","text":" "},{"type":"text","text":"changed two ways."}],"url":"\/documentation\/ivormxl\/mxlposition","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPosition"}],"kind":"symbol","title":"MXLPosition","navigatorTitle":[{"kind":"identifier","text":"MXLPosition"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"type":"topic","abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"type":"text","text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is"},{"type":"text","text":" "},{"type":"text","text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF."}],"url":"\/documentation\/ivormxl\/mxlcolor","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"kind":"symbol","title":"MXLColor","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLAccidentalMark/init(id:value:levelDisplay:position:font:color:placement:smufl:)":{"type":"topic","abstract":[{"type":"text","text":"Creates a new "},{"code":"MXLAccidentalMark","type":"codeVoice"},{"type":"text","text":"."}],"role":"symbol","title":"init(id:value:levelDisplay:position:font:color:placement:smufl:)","kind":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?, ","kind":"text"},{"text":"value","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLAccidentalValue","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL18MXLAccidentalValueO"},{"text":", ","kind":"text"},{"text":"levelDisplay","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLLevel","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLLevelV"},{"text":".","kind":"text"},{"text":"Display","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLLevelV7DisplayV"},{"text":", ","kind":"text"},{"text":"position","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLPosition","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL11MXLPositionV"},{"text":", ","kind":"text"},{"text":"font","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLFont","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL7MXLFontV"},{"text":", ","kind":"text"},{"text":"color","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLColor","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLColorV"},{"text":"?, ","kind":"text"},{"text":"placement","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLAboveBelow","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL13MXLAboveBelowO"},{"text":"?, ","kind":"text"},{"text":"smufl","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLSmuflAccidentalGlyphName","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL27MXLSmuflAccidentalGlyphNameV"},{"text":"?)","kind":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidentalMark\/init(id:value:levelDisplay:position:font:color:placement:smufl:)","url":"\/documentation\/ivormxl\/mxlaccidentalmark\/init(id:value:leveldisplay:position:font:color:placement:smufl:)"},"doc://IvorMXL/documentation/IvorMXL/MXLAccidentalValue":{"type":"topic","abstract":[{"type":"text","text":"The accidental-value type represents notated accidentals supported by MusicXML. In the MusicXML 2.0 DTD this"},{"type":"text","text":" "},{"type":"text","text":"was a string with values that could be included. The XSD strengthens the data typing to an enumerated list."},{"type":"text","text":" "},{"type":"text","text":"The quarter- and three-quarters- accidentals are Tartini-style quarter-tone accidentals. The -down and -up"},{"type":"text","text":" "},{"type":"text","text":"accidentals are quarter-tone accidentals that include arrows pointing down or up. The slash- accidentals are"},{"type":"text","text":" "},{"type":"text","text":"used in Turkish classical music. The numbered sharp and flat accidentals are superscripted versions of the"},{"type":"text","text":" "},{"type":"text","text":"accidental signs, used in Turkish folk music. The sori and koron accidentals are microtonal sharp and flat"},{"type":"text","text":" "},{"type":"text","text":"accidentals used in Iranian and Persian music. The other accidental covers accidentals other than those listed"},{"type":"text","text":" "},{"type":"text","text":"here. It is usually used in combination with the smufl attribute to specify a particular SMuFL accidental. The"},{"type":"text","text":" "},{"type":"text","text":"smufl attribute may be used with any accidental value to help specify the appearance of symbols that share the"},{"type":"text","text":" "},{"type":"text","text":"same MusicXML semantics."}],"url":"\/documentation\/ivormxl\/mxlaccidentalvalue","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLAccidentalValue"}],"kind":"symbol","title":"MXLAccidentalValue","navigatorTitle":[{"kind":"identifier","text":"MXLAccidentalValue"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidentalValue","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLAccidentalMark":{"type":"topic","abstract":[{"type":"text","text":"An accidental-mark can be used as a separate notation or as part of an ornament. When used in an ornament,"},{"type":"text","text":" "},{"type":"text","text":"position and placement are relative to the ornament, not relative to the note."}],"url":"\/documentation\/ivormxl\/mxlaccidentalmark","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLAccidentalMark"}],"kind":"symbol","title":"MXLAccidentalMark","navigatorTitle":[{"kind":"identifier","text":"MXLAccidentalMark"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidentalMark","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLAboveBelow":{"type":"topic","title":"MXLAboveBelow","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAboveBelow","abstract":[{"type":"text","text":"The above-below type is used to indicate whether one element appears above or below another element."}],"role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLAboveBelow"}],"navigatorTitle":[{"kind":"identifier","text":"MXLAboveBelow"}],"url":"\/documentation\/ivormxl\/mxlabovebelow"},"doc://IvorMXL/documentation/IvorMXL/MXLFont":{"type":"topic","title":"MXLFont","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","abstract":[{"type":"text","text":"The font attribute group gathers together attributes for determining the font within a credit or direction."},{"type":"text","text":" "},{"type":"text","text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of"},{"type":"text","text":" "},{"type":"text","text":"font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric"},{"type":"text","text":" "},{"type":"text","text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font"},{"type":"text","text":" "},{"type":"text","text":"vs. a music font."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFont"}],"navigatorTitle":[{"kind":"identifier","text":"MXLFont"}],"url":"\/documentation\/ivormxl\/mxlfont"},"doc://IvorMXL/documentation/IvorMXL/MXLSmuflAccidentalGlyphName":{"type":"topic","title":"MXLSmuflAccidentalGlyphName","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSmuflAccidentalGlyphName","abstract":[{"type":"text","text":"The smufl-accidental-glyph-name type is used to reference a specific Standard Music Font Layout (SMuFL)"},{"type":"text","text":" "},{"type":"text","text":"accidental character. The value is a SMuFL canonical glyph name that starts with one of the strings used at"},{"type":"text","text":" "},{"type":"text","text":"the start of glyph names for SMuFL accidentals."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLSmuflAccidentalGlyphName"}],"navigatorTitle":[{"kind":"identifier","text":"MXLSmuflAccidentalGlyphName"}],"url":"\/documentation\/ivormxl\/mxlsmuflaccidentalglyphname"},"doc://IvorMXL/documentation/IvorMXL/MXLLevel/Display-swift.struct":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLevel\/Display-swift.struct","navigatorTitle":[{"text":"Display","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxllevel\/display-swift.struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Display","kind":"identifier"}],"title":"MXLLevel.Display","abstract":[{"text":"The level-display attribute group specifies three common ways to indicate editorial indications: putting","type":"text"},{"text":" ","type":"text"},{"text":"parentheses or square brackets around a symbol, or making the symbol a different size. If not specified, they","type":"text"},{"text":" ","type":"text"},{"text":"are left to application defaults. It is used by the level and accidental elements.","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLLevel":{"type":"topic","abstract":[{"type":"text","text":"The level type is used to specify editorial information for different MusicXML elements. The content contains"},{"type":"text","text":" "},{"type":"text","text":"identifying and\/or descriptive text about the editorial status of the parent element."}],"url":"\/documentation\/ivormxl\/mxllevel","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLLevel","kind":"identifier"}],"kind":"symbol","title":"MXLLevel","navigatorTitle":[{"text":"MXLLevel","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLevel","role":"symbol"}}}