text":"An accidental-mark can be used as a separate notation or as part of an ornament. When used in an ornament,","type":"text"},{"text":" ","type":"text"},{"text":"position and placement are relative to the ornament, not relative to the note.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlaccidentalmark","role":"symbol","kind":"symbol","title":"MXLAccidentalMark","navigatorTitle":[{"text":"MXLAccidentalMark","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLAccidentalMark","kind":"identifier"}]},"doc://IvorMXL/documentation/IvorMXL/MXLLevel":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLLevel"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLLevel"}],"url":"\/documentation\/ivormxl\/mxllevel","role":"symbol","title":"MXLLevel","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLevel","type":"topic","abstract":[{"text":"The level type is used to specify editorial information for different MusicXML elements. The content contains","type":"text"},{"text":" ","type":"text"},{"text":"identifying and\/or descriptive text about the editorial status of the parent element.","type":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLPosition":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLPosition"}],"abstract":[{"text":"For most elements, any program will compute a default x and y position. The position attributes let this be","type":"text"},{"text":" ","type":"text"},{"text":"changed two ways.","type":"text"}],"kind":"symbol","title":"MXLPosition","url":"\/documentation\/ivormxl\/mxlposition","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPosition"}]},"doc://IvorMXL/documentation/IvorMXL/MXLSmuflAccidentalGlyphName":{"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlsmuflaccidentalglyphname","abstract":[{"type":"text","text":"The smufl-accidental-glyph-name type is used to reference a specific Standard Music Font Layout (SMuFL)"},{"type":"text","text":" "},{"type":"text","text":"accidental character. The value is a SMuFL canonical glyph name that starts with one of the strings used at"},{"type":"text","text":" "},{"type":"text","text":"the start of glyph names for SMuFL accidentals."}],"navigatorTitle":[{"text":"MXLSmuflAccidentalGlyphName","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSmuflAccidentalGlyphName","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSmuflAccidentalGlyphName","title":"MXLSmuflAccidentalGlyphName"},"doc://IvorMXL/documentation/IvorMXL/MXLAboveBelow":{"type":"topic","abstract":[{"text":"The above-below type is used to indicate whether one element appears above or below another element.","type":"text"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLAboveBelow"}],"navigatorTitle":[{"kind":"identifier","text":"MXLAboveBelow"}],"title":"MXLAboveBelow","kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlabovebelow","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAboveBelow"},"doc://IvorMXL/documentation/IvorMXL/MXLAccidentalValue":{"abstract":[{"text":"The accidental-value type represents notated accidentals supported by MusicXML. In the MusicXML 2.0 DTD this","type":"text"},{"text":" ","type":"text"},{"text":"was a string with values that could be included. The XSD strengthens the data typing to an enumerated list.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"The quarter- and three-quarters- accidentals are Tartini-style quarter-tone accidentals. The -down and -up"},{"type":"text","text":" "},{"text":"accidentals are quarter-tone accidentals that include arrows pointing down or up. The slash- accidentals are","type":"text"},{"text":" ","type":"text"},{"text":"used in Turkish classical music. The numbered sharp and flat accidentals are superscripted versions of the","type":"text"},{"text":" ","type":"text"},{"text":"accidental signs, used in Turkish folk music. The sori and koron accidentals are microtonal sharp and flat","type":"text"},{"text":" ","type":"text"},{"text":"accidentals used in Iranian and Persian music. The other accidental covers accidentals other than those listed","type":"text"},{"text":" ","type":"text"},{"text":"here. It is usually used in combination with the smufl attribute to specify a particular SMuFL accidental. The","type":"text"},{"text":" ","type":"text"},{"text":"smufl attribute may be used with any accidental value to help specify the appearance of symbols that share the","type":"text"},{"text":" ","type":"text"},{"text":"same MusicXML semantics.","type":"text"}],"role":"symbol","navigatorTitle":[{"text":"MXLAccidentalValue","kind":"identifier"}],"url":"\/documentation\/ivormxl\/mxlaccidentalvalue","kind":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"text":" ","kind":"text"},{"kind":"identifier","text":"MXLAccidentalValue"}],"title":"MXLAccidentalValue","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLAccidentalValue","type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLLevel/Display-swift.struct":{"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLevel\/Display-swift.struct","url":"\/documentation\/ivormxl\/mxllevel\/display-swift.struct","navigatorTitle":[{"text":"Display","kind":"identifier"}],"title":"MXLLevel.Display","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Display","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"The level-display attribute group specifies three common ways to indicate editorial indications: putting"},{"type":"text","text":" "},{"type":"text","text":"parentheses or square brackets around a symbol, or making the symbol a different size. If not specified, they"},{"type":"text","text":" "},{"type":"text","text":"are left to application defaults. It is used by the level and accidental elements."}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","kind":"symbol","role":"collection","url":"\/documentation\/ivormxl","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL"}}}