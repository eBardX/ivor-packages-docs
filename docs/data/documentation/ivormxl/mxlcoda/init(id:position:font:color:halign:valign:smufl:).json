 = nil, ","kind":"text"},{"text":"smufl","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MXLSmuflCodaGlyphName","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSmuflCodaGlyphName","preciseIdentifier":"s:7IvorMXL21MXLSmuflCodaGlyphNameV"},{"text":"? = nil)","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}]},{"parameters":[{"name":"id","content":[{"inlineContent":[{"type":"text","text":"The optional-unique-id attribute group allows an element to optionally specify an ID that is unique to the entire document. This attribute group is not used for a required id attribute, or for an id attribute that specifies an id reference."}],"type":"paragraph"}]},{"name":"position","content":[{"inlineContent":[{"type":"text","text":"For most elements, any program will compute a default x and y position. The position attributes let this be changed two ways."}],"type":"paragraph"}]},{"name":"font","content":[{"type":"paragraph","inlineContent":[{"text":"The font attribute group gathers together attributes for determining the font within a credit or direction. They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of font names.The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font vs. a music font.","type":"text"}]}]},{"name":"color","content":[{"type":"paragraph","inlineContent":[{"text":"The color attribute group indicates the color of an element.","type":"text"}]}]},{"name":"halign","content":[{"type":"paragraph","inlineContent":[{"text":"In cases where text extends over more than one line, horizontal alignment and justify values can be different. The most typical case is for credits, such as:","type":"text"}]}]},{"name":"valign","content":[{"type":"paragraph","inlineContent":[{"text":"The valign attribute is used to indicate vertical alignment to the top, middle, bottom, or baseline of the text. Defaults are implementation-dependent.","type":"text"}]}]},{"name":"smufl","content":[{"type":"paragraph","inlineContent":[{"text":"The SMuFL canonical glyph name used to specify a particular coda character.","type":"text"}]}]}],"kind":"parameters"}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLFont":{"title":"MXLFont","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLFont"}],"abstract":[{"text":"The font attribute group gathers together attributes for determining the font within a credit or direction.","type":"text"},{"text":" ","type":"text"},{"text":"They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of","type":"text"},{"text":" ","type":"text"},{"text":"font names. The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric","type":"text"},{"text":" ","type":"text"},{"text":"point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font","type":"text"},{"text":" ","type":"text"},{"text":"vs. a music font.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLFont","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLFont"}],"url":"\/documentation\/ivormxl\/mxlfont"},"doc://IvorMXL/documentation/IvorMXL/MXLPosition":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlposition","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLPosition","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLPosition"}],"kind":"symbol","abstract":[{"text":"For most elements, any program will compute a default x and y position. The position attributes let this be","type":"text"},{"text":" ","type":"text"},{"text":"changed two ways.","type":"text"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLPosition"}],"title":"MXLPosition"},"doc://IvorMXL/documentation/IvorMXL/MXLCoda":{"title":"MXLCoda","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLCoda"}],"abstract":[{"text":"The coda type is the visual indicator of a coda sign. The exact glyph can be specified with the smufl","type":"text"},{"text":" ","type":"text"},{"text":"attribute. A sound element is also needed to guide playback applications reliably.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCoda","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLCoda"}],"url":"\/documentation\/ivormxl\/mxlcoda"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLLeftCenterRight":{"url":"\/documentation\/ivormxl\/mxlleftcenterright","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLLeftCenterRight","abstract":[{"type":"text","text":"The left-center-right type is used to define horizontal alignment and text justification."}],"title":"MXLLeftCenterRight","kind":"symbol","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLLeftCenterRight"}],"navigatorTitle":[{"kind":"identifier","text":"MXLLeftCenterRight"}]},"doc://IvorMXL/documentation/IvorMXL/MXLCoda/init(id:position:font:color:halign:valign:smufl:)":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlcoda\/init(id:position:font:color:halign:valign:smufl:)","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCoda\/init(id:position:font:color:halign:valign:smufl:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"position","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL11MXLPositionV","text":"MXLPosition","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"font","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL7MXLFontV","text":"MXLFont","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"color","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL8MXLColorV","text":"MXLColor","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"halign","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL18MXLLeftCenterRightO","text":"MXLLeftCenterRight","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"valign","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL9MXLValignO","text":"MXLValign","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"smufl","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL21MXLSmuflCodaGlyphNameV","text":"MXLSmuflCodaGlyphName","kind":"typeIdentifier"},{"text":"?)","kind":"text"}],"abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLCoda"},{"type":"text","text":"."}],"kind":"symbol","type":"topic","title":"init(id:position:font:color:halign:valign:smufl:)"},"doc://IvorMXL/documentation/IvorMXL/MXLValign":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlvalign","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValign","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLValign"}],"abstract":[{"text":"The valign type is used to indicate vertical alignment to the top, middle, bottom, or baseline of the text. If","type":"text"},{"text":" ","type":"text"},{"text":"the text is on multiple lines, baseline alignment refers to the baseline of the lowest line of text. Defaults","type":"text"},{"text":" ","type":"text"},{"text":"are implementation-dependent.","type":"text"}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLValign"}],"title":"MXLValign"},"doc://IvorMXL/documentation/IvorMXL/MXLSmuflCodaGlyphName":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlsmuflcodaglyphname","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSmuflCodaGlyphName","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSmuflCodaGlyphName","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"The smufl-coda-glyph-name type is used to reference a specific Standard Music Font Layout (SMuFL) coda","type":"text"},{"text":" ","type":"text"},{"text":"character. The value is a SMuFL canonical glyph name that starts with coda.","type":"text"}],"type":"topic","navigatorTitle":[{"text":"MXLSmuflCodaGlyphName","kind":"identifier"}],"title":"MXLSmuflCodaGlyphName"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"title":"MXLColor","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"abstract":[{"text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in","type":"text"},{"text":" ","type":"text"},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"url":"\/documentation\/ivormxl\/mxlcolor"}}}