:"text","text":" "},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlcolor"},"doc://IvorMXL/documentation/IvorMXL/MXLSmuflCodaGlyphName":{"url":"\/documentation\/ivormxl\/mxlsmuflcodaglyphname","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSmuflCodaGlyphName","kind":"identifier"}],"title":"MXLSmuflCodaGlyphName","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSmuflCodaGlyphName","navigatorTitle":[{"text":"MXLSmuflCodaGlyphName","kind":"identifier"}],"role":"symbol","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The smufl-coda-glyph-name type is used to reference a specific Standard Music Font Layout (SMuFL) coda"},{"type":"text","text":" "},{"type":"text","text":"character. The value is a SMuFL canonical glyph name that starts with coda."}]},"doc://IvorMXL/documentation/IvorMXL/MXLValign":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLValign"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLValign","title":"MXLValign","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLValign"}],"abstract":[{"type":"text","text":"The valign type is used to indicate vertical alignment to the top, middle, bottom, or baseline of the text. If"},{"type":"text","text":" "},{"type":"text","text":"the text is on multiple lines, baseline alignment refers to the baseline of the lowest line of text. Defaults"},{"type":"text","text":" "},{"type":"text","text":"are implementation-dependent."}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlvalign"}}}