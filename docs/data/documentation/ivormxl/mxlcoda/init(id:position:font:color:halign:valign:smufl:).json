},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlcolor","title":"MXLColor","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"type":"text","text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is"},{"type":"text","text":" "},{"type":"text","text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF."}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor"},"doc://IvorMXL/documentation/IvorMXL/MXLCoda":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlcoda","title":"MXLCoda","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLCoda"}],"navigatorTitle":[{"kind":"identifier","text":"MXLCoda"}],"abstract":[{"text":"The coda type is the visual indicator of a coda sign. The exact glyph can be specified with the smufl","type":"text"},{"text":" ","type":"text"},{"text":"attribute. A sound element is also needed to guide playback applications reliably.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCoda"},"doc://IvorMXL/documentation/IvorMXL/MXLCoda/init(id:position:font:color:halign:valign:smufl:)":{"kind":"symbol","url":"\/documentation\/ivormxl\/mxlcoda\/init(id:position:font:color:halign:valign:smufl:)","title":"init(id:position:font:color:halign:valign:smufl:)","role":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCoda\/init(id:position:font:color:halign:valign:smufl:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"tex