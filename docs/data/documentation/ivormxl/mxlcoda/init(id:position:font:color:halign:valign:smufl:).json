ages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The optional-unique-id attribute group allows an element to optionally specify an ID that is unique to the entire document. This attribute group is not used for a required id attribute, or for an id attribute that specifies an id reference."}],"type":"paragraph"}],"name":"id"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For most elements, any program will compute a default x and y position. The position attributes let this be changed two ways."}]}],"name":"position"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The font attribute group gathers together attributes for determining the font within a credit or direction. They are based on the text styles for Cascading Style Sheets. The font-family is a comma-separated list of font names.The font-style can be normal or italic. The font-size can be one of the CSS sizes or a numeric point size. The font-weight can be normal or bold. The default is application-dependent, but is a text font vs. a music font.","type":"text"}]}],"name":"font"},{"content":[{"inlineContent":[{"type":"text","text":"The color attribute group indicates the color of an element."}],"type":"paragraph"}],"name":"color"},{"content":[{"inlineContent":[{"type":"text","text":"In cases where text extends over more than one line, horizontal alignment and justify values can be different. The most typical case is for credits, such as:"}],"type":"paragraph"}],"name":"halign"},{"content":[{"inlineContent":[{"text":"The valign attribute is used to indicate vertical alignment to the top, middle, bottom, or baseline of the text. Defaults are implementation-dependent.","type":"text"}],"type":"paragraph"}],"name":"valign"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The SMuFL canonical glyph name used to specify a particular coda character."}]}],"name":"smufl"}],"kind":"