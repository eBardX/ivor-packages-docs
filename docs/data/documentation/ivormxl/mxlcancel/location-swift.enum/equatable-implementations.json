{"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCancel","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCancel\/Location-swift.enum"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCancel\/Location-swift.enum\/Equatable-Implementations"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlcancel\/location-swift.enum\/equatable-implementations"]}],"sections":[],"metadata":{"modules":[{"name":"IvorMXL"}],"role":"collectionGroup","roleHeading":"API Collection","title":"Equatable Implementations"},"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"article","topicSections":[{"generated":true,"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCancel\/Location-swift.enum\/!=(_:_:)"],"title":"Operators","anchor":"Operators"}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLCancel/Location-swift.enum/!=(_:_:)":{"abstract":[],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCancel\/Location-swift.enum\/!=(_:_:)","kind":"symbol","type":"topic","title":"!=(_:_:)","fragments":[{"kind":"keyword","text":"static"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"!=","kind":"identifier"},{"text":" ","kind":"text"},{"text":"(","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"role":"symbol","url":"\/documentation\/ivormxl\/mxlcancel\/location-swift.enum\/!=(_:_:)"},"doc://IvorMXL/documentation/IvorMXL/MXLCancel/Location-swift.enum":{"type":"topic","role":"symbol","title":"MXLCancel.Location","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCancel\/Location-swift.enum","kind":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Location"}],"url":"\/documentation\/ivormxl\/mxlcancel\/location-swift.enum","navigatorTitle":[{"kind":"identifier","text":"Location"}],"abstract":[{"type":"text","text":"The cancel-location type is used to indicate where a key signature cancellation appears relative to a new key"},{"type":"text","text":" "},{"type":"text","text":"signature: to the left, to the right, or before the barline and to the left. It is left by default. For mid-"},{"type":"text","text":" "},{"type":"text","text":"measure key elements, a cancel-location of before-barline should be treated like a cancel-location of left."}]},"doc://IvorMXL/documentation/IvorMXL/MXLCancel":{"url":"\/documentation\/ivormxl\/mxlcancel","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLCancel","kind":"identifier"}],"title":"MXLCancel","abstract":[{"text":"A cancel element indicates that the old key signature should be canceled before the new one appears. This","type":"text"},{"text":" ","type":"text"},{"text":"will always happen when changing to C major or A minor and need not be specified then. The cancel value","type":"text"},{"text":" ","type":"text"},{"text":"matches the fifths value of the canceled key signature (e.g., a cancel of -2 will provide an explicit","type":"text"},{"text":" ","type":"text"},{"text":"cancellation for changing from B flat major to F major). The optional location attribute indicates where the","type":"text"},{"text":" ","type":"text"},{"text":"cancellation appears relative to the new key signature.","type":"text"}],"navigatorTitle":[{"text":"MXLCancel","kind":"identifier"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCancel"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]}}}