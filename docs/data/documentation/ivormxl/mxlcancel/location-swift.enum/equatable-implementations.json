{"topicSections":[{"title":"Operators","anchor":"Operators","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCancel\/Location-swift.enum\/!=(_:_:)"],"generated":true}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCancel","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCancel\/Location-swift.enum"]]},"variants":[{"paths":["\/documentation\/ivormxl\/mxlcancel\/location-swift.enum\/equatable-implementations"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCancel\/Location-swift.enum\/Equatable-Implementations","interfaceLanguage":"swift"},"kind":"article","metadata":{"role":"collectionGroup","title":"Equatable Implementations","roleHeading":"API Collection","modules":[{"name":"IvorMXL"}]},"schemaVersion":{"minor":3,"major":0,"patch":0},"references":{"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLCancel/Location-swift.enum":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCancel\/Location-swift.enum","navigatorTitle":[{"kind":"identifier","text":"Location"}],"url":"\/documentation\/ivormxl\/mxlcancel\/location-swift.enum","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Location"}],"title":"MXLCancel.Location","abstract":[{"type":"text","text":"The cancel-location type is used to indicate where a key signature cancellation appears relative to a new key"},{"type":"text","text":" "},{"type":"text","text":"signature: to the left, to the right, or before the barline and to the left. It is left by default. For mid-"},{"type":"text","text":" "},{"type":"text","text":"measure key elements, a cancel-location of before-barline should be treated like a cancel-location of left."}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLCancel":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCancel","navigatorTitle":[{"kind":"identifier","text":"MXLCancel"}],"url":"\/documentation\/ivormxl\/mxlcancel","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLCancel"}],"title":"MXLCancel","abstract":[{"type":"text","text":"A cancel element indicates that the old key signature should be canceled before the new one appears. This"},{"type":"text","text":" "},{"type":"text","text":"will always happen when changing to C major or A minor and need not be specified then. The cancel value"},{"type":"text","text":" "},{"type":"text","text":"matches the fifths value of the canceled key signature (e.g., a cancel of -2 will provide an explicit"},{"type":"text","text":" "},{"type":"text","text":"cancellation for changing from B flat major to F major). The optional location attribute indicates where the"},{"type":"text","text":" "},{"type":"text","text":"cancellation appears relative to the new key signature."}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLCancel/Location-swift.enum/!=(_:_:)":{"abstract":[],"kind":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCancel\/Location-swift.enum\/!=(_:_:)","title":"!=(_:_:)","url":"\/documentation\/ivormxl\/mxlcancel\/location-swift.enum\/!=(_:_:)","role":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"!="},{"kind":"text","text":" "},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Bool","prec