{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCancel\/Location-swift.enum\/right"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCancel","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCancel\/Location-swift.enum"]]},"abstract":[{"type":"text","text":"To the right of the new key signature."}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"right"}]}],"kind":"declarations"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlcancel\/location-swift.enum\/right"]}],"metadata":{"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"right"}],"title":"MXLCancel.Location.right","externalID":"s:7IvorMXL9MXLCancelV8LocationO5rightyA2EmF","roleHeading":"Case","modules":[{"name":"IvorMXL"}],"role":"symbol","symbolKind":"case"},"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","sections":[],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLCancel/Location-swift.enum/right":{"title":"MXLCancel.Location.right","role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"right"}],"kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxlcancel\/location-swift.enum\/right","abstract":[{"type":"text","text":"To the right of the new key signature."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCancel\/Location-swift.enum\/right"},"doc://IvorMXL/documentation/IvorMXL/MXLCancel/Location-swift.enum":{"abstract":[{"text":"The cancel-location type is used to indicate where a key signature cancellation appears relative to a new key","type":"text"},{"text":" ","type":"text"},{"text":"signature: to the left, to the right, or before the barline and to the left. It is left by default. For mid-","type":"text"},{"text":" ","type":"text"},{"text":"measure key elements, a cancel-location of before-barline should be treated like a cancel-location of left.","type":"text"}],"title":"MXLCancel.Location","kind":"symbol","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Location","kind":"identifier"}],"navigatorTitle":[{"text":"Location","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlcancel\/location-swift.enum","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCancel\/Location-swift.enum"},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLCancel":{"title":"MXLCancel","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLCancel","kind":"identifier"}],"kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxlcancel","abstract":[{"text":"A cancel element indicates that the old key signature should be canceled before the new one appears. This","type":"text"},{"text":" ","type":"text"},{"text":"will always happen when changing to C major or A minor and need not be specified then. The cancel value","type":"text"},{"text":" ","type":"text"},{"text":"matches the fifths value of the canceled key signature (e.g., a cancel of -2 will provide an explicit","type":"text"},{"text":" ","type":"text"},{"text":"cancellation for changing from B flat major to F major). The optional location attribute indicates where the","type":"text"},{"text":" ","type":"text"},{"text":"cancellation appears relative to the new key signature.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCancel","navigatorTitle":[{"text":"MXLCancel","kind":"identifier"}]}}}