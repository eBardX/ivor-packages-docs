{"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"right","kind":"identifier"}],"platforms":["macOS"]}]}],"abstract":[{"text":"To the right of the new key signature.","type":"text"}],"variants":[{"paths":["\/documentation\/ivormxl\/mxlcancel\/location-swift.enum\/right"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCancel","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCancel\/Location-swift.enum"]]},"metadata":{"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"right","kind":"identifier"}],"role":"symbol","symbolKind":"case","modules":[{"name":"IvorMXL"}],"roleHeading":"Case","externalID":"s:7IvorMXL9MXLCancelV8LocationO5rightyA2EmF","title":"MXLCancel.Location.right"},"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCancel\/Location-swift.enum\/right","interfaceLanguage":"swift"},"kind":"symbol","references":{"doc://IvorMXL/documentation/IvorMXL/MXLCancel/Location-swift.enum":{"type":"topic","role":"symbol","title":"MXLCancel.Location","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCancel\/Location-swift.enum","kind":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Location"}],"url":"\/documentation\/ivormxl\/mxlcancel\/location-swift.enum","navigatorTitle":[{"kind":"identifier","text":"Location"}],"abstract":[{"type":"text","text":"The cancel-location type is used to indicate where a key signature cancellation appears relative to a new key"},{"type":"text","text":" "},{"type":"text","text":"signature: to the left, to the right, or before the barline and to the left. It is left by default. For mid-"},{"type":"text","text":" "},{"type":"text","text":"measure key elements, a cancel-location of before-barline should be treated like a cancel-location of left."}]},"doc://IvorMXL/documentation/IvorMXL/MXLCancel/Location-swift.enum/right":{"kind":"symbol","type":"topic","abstract":[{"text":"To the right of the new key signature.","type":"text"}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"right"}],"role":"symbol","url":"\/documentation\/ivormxl\/mxlcancel\/location-swift.enum\/right","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCancel\/Location-swift.enum\/right","title":"MXLCancel.Location.right"},"doc://IvorMXL/documentation/IvorMXL/MXLCancel":{"url":"\/documentation\/ivormxl\/mxlcancel","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLCancel","kind":"identifier"}],"title":"MXLCancel","abstract":[{"text":"A cancel element indicates that the old key signature should be canceled before the new one appears. This","type":"text"},{"text":" ","type":"text"},{"text":"will always happen when changing to C major or A minor and need not be specified then. The cancel value","type":"text"},{"text":" ","type":"text"},{"text":"matches the fifths value of the canceled key signature (e.g., a cancel of -2 will provide an explicit","type":"text"},{"text":" ","type":"text"},{"text":"cancellation for changing from B flat major to F major). The optional location attribute indicates where the","type":"text"},{"text":" ","type":"text"},{"text":"cancellation appears relative to the new key signature.","type":"text"}],"navigatorTitle":[{"text":"MXLCancel","kind":"identifier"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCancel"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]}}}