,{"type":"text","text":" "},{"type":"text","text":"cancellation appears relative to the new key signature."}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLCancel/location-swift.property":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCancel\/location-swift.property","abstract":[{"type":"text","text":"Where the cancellation appears relative to the new key signature."}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"location","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Location","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLCancelV8LocationO"},{"text":"?","kind":"text"}],"type":"topic","kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlcancel\/location-swift.property","title":"location"}}}