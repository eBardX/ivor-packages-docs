{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCancel\/location-swift.property"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlcancel\/location-swift.property"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"location"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCancel\/Location-swift.enum","preciseIdentifier":"s:7IvorMXL9MXLCancelV8LocationO","text":"Location"},{"kind":"text","text":"?"}]}],"kind":"declarations"},{"content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Maps to the MusicXML "},{"type":"codeVoice","code":"location"},{"type":"text","text":" attribute."}]}],"kind":"content"}],"kind":"symbol","abstract":[{"text":"Where the cancellation appears relative to the new key signature.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCancel"]]},"metadata":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"location","kind":"identifier"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLCancelV8LocationO","text":"Location"},{"kind":"text","text":"?"}],"externalID":"s:7IvorMXL9MXLCancelV8locationAC8LocationOSgvp","roleHeading":"Instance Property","modules":[{"name":"IvorMXL"}],"symbolKind":"property","title":"location","role":"symbol"},"references":{"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLCancel/location-swift.property":{"abstract":[{"text":"Where the cancellation appears relative to the new key signature.","type":"text"}],"type":"topic","kind":"symbol","title":"location","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCancel\/location-swift.property","url":"\/documentation\/ivormxl\/mxlcancel\/location-swift.property","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"location"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7IvorMXL9MXLCancelV8LocationO","kind":"typeIdentifier","text":"Location"},{"kind":"text","text":"?"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLCancel/Location-swift.enum":{"url":"\/documentation\/ivormxl\/mxlcancel\/location-swift.enum","abstract":[{"text":"The cancel-location type is used to indicate where a key signature cancellation appears relative to a new key","type":"text"},{"text":" ","type":"text"},{"text":"signature: to the left, to the right, or before the barline and to the left. It is left by default. For mid-","type":"text"},{"text":" ","type":"text"},{"text":"measure key elements, a cancel-location of before-barline should be treated like a cancel-location of left.","type":"text"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Location"}],"kind":"symbol","role":"symbol","type":"topic","title":"MXLCancel.Location","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCancel\/Location-swift.enum","navigatorTitle":[{"kind":"identifier","text":"Location"}]},"doc://IvorMXL/documentation/IvorMXL/MXLCancel":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlcancel","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCancel","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLCancel"}],"abstract":[{"type":"text","text":"A cancel element indicates that the old key signature should be canceled before the new one appears. This"},{"type":"text","text":" "},{"type":"text","text":"will always happen when changing to C major or A minor and need not be specified then. The cancel value"},{"type":"text","text":" "},{"type":"text","text":"matches the fifths value of the canceled key signature (e.g., a cancel of -2 will provide an explicit"},{"type":"text","text":" "},{"type":"text","text":"cancellation for changing from B flat major to F major). The optional location attribute indicates where the"},{"type":"text","text":" "},{"type":"text","text":"cancellation appears relative to the new key signature."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLCancel"}],"title":"MXLCancel"}}}