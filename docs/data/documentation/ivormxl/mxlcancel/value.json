"},"doc://IvorMXL/documentation/IvorMXL/MXLCancel":{"title":"MXLCancel","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLCancel","kind":"identifier"}],"kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxlcancel","abstract":[{"text":"A cancel element indicates that the old key signature should be canceled before the new one appears. This","type":"text"},{"text":" ","type":"text"},{"text":"will always happen when changing to C major or A minor and need not be specified then. The cancel value","type":"text"},{"text":" ","type":"text"},{"text":"matches the fifths value of the canceled key signature (e.g., a cancel of -2 will provide an explicit","type":"text"},{"text":" ","type":"text"},{"text":"cancellation for changing from B flat major to F major). The optional location attribute indicates where the","type":"text"},{"text":" ","type":"text"},{"text":"cancellation appears relative to the new key signature.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCancel","navigatorTitle":[{"text":"MXLCancel","kind":"identifier"}]}}}