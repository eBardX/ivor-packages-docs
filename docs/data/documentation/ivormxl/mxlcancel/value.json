{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCancel\/value"},"abstract":[{"type":"text","text":"The value of this element."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"value","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}],"platforms":["macOS"],"languages":["swift"]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlcancel\/value"]}],"metadata":{"symbolKind":"property","roleHeading":"Instance Property","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"value","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}],"role":"symbol","externalID":"s:7IvorMXL9MXLCancelV5valueSivp","modules":[{"name":"IvorMXL"}],"title":"value"},"kind":"symbol","schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCancel"]]},"sections":[],"references":{"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLCancel":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCancel","navigatorTitle":[{"kind":"identifier","text":"MXLCancel"}],"url":"\/documentation\/ivormxl\/mxlcancel","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLCancel"}],"title":"MXLCancel","abstract":[{"type":"text","text":"A cancel element indicates that the old key signature should be canceled before the new one appears. This"},{"type":"text","text":" "},{"type":"text","text":"will always happen when changing to C major or A minor and need not be specified then. The cancel value"},{"type":"text","text":" "},{"type":"text","text":"matches the fifths value of the canceled key signature (e.g., a cancel of -2 will provide an explicit"},{"type":"text","text":" "},{"type":"text","text":"cancellation for changing from B flat major to F major). The optional location attribute indicates where the"},{"type":"text","text":" "},{"type":"text","text":"cancellation appears relative to the new key signature."}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLCancel/value":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCancel\/value","abstract":[{"type":"text","text":"The value of this element."}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"value"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"type":"topic","kind":"symbol","role":"symbol","url":"\/documentation\/ivormxl\/mxlcancel\/value","title":"value"}}}