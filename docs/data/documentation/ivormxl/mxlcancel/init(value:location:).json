":"text"}]}]},{"name":"location","content":[{"type":"paragraph","inlineContent":[{"text":"Where the cancellation appears relative to the new key signature.","type":"text"}]}]}]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLCancel":{"url":"\/documentation\/ivormxl\/mxlcancel","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLCancel","kind":"identifier"}],"title":"MXLCancel","abstract":[{"text":"A cancel element indicates that the old key signature should be canceled before the new one appears. This","type":"text"},{"text":" ","type":"text"},{"text":"will always happen when changing to C major or A minor and need not be specified then. The cancel value","type":"text"},{"text":" ","type":"text"},{"text":"matches the fifths value of the canceled key signature (e.g., a cancel of -2 will provide an explicit","type":"text"},{"text":" ","type":"text"},{"text":"cancellation for changing from B flat major to F major). The optional location attribute indicates where the","type":"text"},{"text":" ","type":"text"},{"text":"cancellation appears relative to the new key signature.","type":"text"}],"navigatorTitle":[{"text":"MXLCancel","kind":"identifier"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCancel"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/documentation/IvorMXL/MXLCancel/init(value:location:)":{"type":"topic","role":"symbol","title":"init(value:location:)","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCancel\/init(value:location:)","kind":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"value"},{"kind":"text","text":": "},{"kin