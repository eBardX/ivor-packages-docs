paragraph"}]},{"name":"location","content":[{"inlineContent":[{"type":"text","text":"Where the cancellation appears relative to the new key signature."}],"type":"paragraph"}]}]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLCancel/Location-swift.enum":{"url":"\/documentation\/ivormxl\/mxlcancel\/location-swift.enum","abstract":[{"text":"The cancel-location type is used to indicate where a key signature cancellation appears relative to a new key","type":"text"},{"text":" ","type":"text"},{"text":"signature: to the left, to the right, or before the barline and to the left. It is left by default. For mid-","type":"text"},{"text":" ","type":"text"},{"text":"measure key elements, a cancel-location of before-barline should be treated like a cancel-location of left.","type":"text"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Location"}],"kind":"symbol","role":"symbol","type":"topic","title":"MXLCancel.Location","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCancel\/Location-swift.enum","navigatorTitle":[{"kind":"identifier","text":"Location"}]},"doc://IvorMXL/documentation/IvorMXL/MXLCancel/init(value:location:)":{"type":"topic","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCancel\/init(value:location:)","role":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"value","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":", ","kind":"text"},{"text":"location","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Location","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL9MXLCancelV8LocationO"},{"text":"?)","kind":"text"}],"title":"init(value:location:)","abstract":[{"text":"Creates a new ","type":"text"},{"type":"codeVoice","code":"MXLCancel"},{"text":".","type":"text"}],"url":"\/documentation\/ivormxl\/mxlcancel\/init(value:location:)"},"doc://IvorMXL/documentation/IvorMXL/MXLCancel":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlcancel","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCancel","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLCancel"}],"abstract":[{"type":"text","text":"A cancel element indicates that the old key signature should be canceled before the new one appears. This"},{"type":"text","text":" "},{"type":"text","text":"will always happen when changing to C major or A minor and need not be specified then. The cancel value"},{"type":"text","text":" "},{"type":"text","text":"matches the fifths value of the canceled key signature (e.g., a cancel of -2 will provide an explicit"},{"type":"text","text":" "},{"type":"text","text":"cancellation for changing from B flat major to F major). The optional location attribute indicates where the"},{"type":"text","text":" "},{"type":"text","text":"cancellation appears relative to the new key signature."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLCancel"}],"title":"MXLCancel"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"}}}