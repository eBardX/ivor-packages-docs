{"abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLCancel"},{"type":"text","text":"."}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"value"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":", "},{"kind":"externalParam","text":"location"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Location","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCancel\/Location-swift.enum","preciseIdentifier":"s:7IvorMXL9MXLCancelV8LocationO"},{"kind":"text","text":"? = nil)"}],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"name":"value","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The value of this element."}]}]},{"name":"location","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Where the cancellation appears relative to the new key signature."}]}]}],"kind":"parameters"}],"metadata":{"role":"symbol","modules":[{"name":"IvorMXL"}],"externalID":"s:7IvorMXL9MXLCancelV5value8locationACSi_AC8LocationOSgtcfc","symbolKind":"init","roleHeading":"Initializer","title":"init(value:location:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"value"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":", "},{"kind":"externalParam","text":"location"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Location","preciseIdentifier":"s:7IvorMXL9MXLCancelV8LocationO"},{"kind":"text","text":"?)"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlcancel\/init(value:location:)"]}],"sections":[],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCancel\/init(value:location:)","interfaceLanguage":"swift"},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCancel"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"references":{"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","title":"IvorMXL","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLCancel/Location-swift.enum":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCancel\/Location-swift.enum","navigatorTitle":[{"kind":"identifier","text":"Location"}],"url":"\/documentation\/ivormxl\/mxlcancel\/location-swift.enum","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Location"}],"title":"MXLCancel.Location","abstract":[{"type":"text","text":"The cancel-location type is used to indicate where a key signature cancellation appears relative to a new key"},{"type":"text","text":" "},{"type":"text","text":"signature: to the left, to the right, or before the barline and to the left. It is left by default. For mid-"},{"type":"text","text":" "},{"type":"text","text":"measure key elements, a cancel-location of before-barline should be treated like a cancel-location of left."}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLCancel/init(value:location:)":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlcancel\/init(value:location:)","abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"MXLCancel"},{"type":"text","text":"."}],"title":"init(value:location:)","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCancel\/init(value:location:)","kind":"symbol","type":"topic","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"value","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"location","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Location","preciseIdentifier":"s:7IvorMXL9MXLCancelV8LocationO","kind":"typeIdentifier"},{"text":"?)","kind":"text"}]},"doc://IvorMXL/documentation/IvorMXL/MXLCancel":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLCancel","navigatorTitle":[{"kind":"identifier","text":"MXLCancel"}],"url":"\/documentation\/ivormxl\/mxlcancel","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLCancel"}],"title":"MXLCancel","abstract":[{"type":"text","text":"A cancel element indicates that the old key signature should be canceled before the new one appears. This"},{"type":"text","text":" "},{"type":"text","text":"will always happen when changing to C major or A minor and need not be specified then. The cancel value"},{"type":"text","text":" "},{"type":"text","text":"matches the fifths value of the canceled key signature (e.g., a cancel of -2 will provide an explicit"},{"type":"text","text":" "},{"type":"text","text":"cancellation for changing from B flat major to F major). The optional location attribute indicates where the"},{"type":"text","text":" "},{"type":"text","text":"cancellation appears relative to the new key signature."}],"type":"topic"}}}