\/\/IvorMXL\/documentation\/IvorMXL"},"doc://IvorMXL/documentation/IvorMXL/MXLNonArpeggiate/number":{"abstract":[{"type":"text","text":"Distinguishes multiple non-arpeggiate elements on a single note."}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNonArpeggiate\/number","kind":"symbol","url":"\/documentation\/ivormxl\/mxlnonarpeggiate\/number","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"number","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLNumberLevel","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL14MXLNumberLevelV"},{"text":"?","kind":"text"}],"title":"number","role":"symbol","type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLNonArpeggiate":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNonArpeggiate","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLNonArpeggiate"}],"abstract":[{"text":"The non-arpeggiate type indicates that this note is at the top or bottom of a bracket indicating to not","type":"text"},{"type":"text","text":" "},{"type":"text","text":"arpeggiate these notes. Since this does not involve playback, it is only used on the top or bottom notes, not"},{"type":"text","text":" "},{"type":"text","text":"on each note as for the arpeggiate type."}],"kind":"symbol","title":"MXLNonArpeggiate","url":"\/documentation\/ivormxl\/mxlnonarpeggiate","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNonArpeggiate"}]},"doc://IvorMXL/documentation/IvorMXL/MXLNumberLevel":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumberLevel","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLNumberLevel"}],"abstract":[{"type":"text","text":"Slurs, tuplets, and many other features can be concurrent and overlap within a single musical part. The"},{"type":"text","text":" "},{"type":"text","text":"number-level entity distinguishes up to 16 concurrent objects of the same type when the objects overlap in"},{"type":"text","text":" "},{"type":"text","text":"MusicXML document order. Values greater than 6 are usually only needed for music with a large number of divisi"},{"type":"text","text":" "},{"type":"text","text":"staves in a single part, or if there are more than 6 cross-staff arpeggios in a single measure. When a number-"},{"type":"text","text":" "},{"type":"text","text":"level value is implied, the value is 1 by default."}],"kind":"symbol","title":"MXLNumberLevel","url":"\/documentation\/ivormxl\/mxlnumberlevel","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNumberLevel"}]}}}