umentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNonArpeggiate/number":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNonArpeggiate\/number","abstract":[{"text":"Distinguishes multiple non-arpeggiate elements on a single note.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlnonarpeggiate\/number","kind":"symbol","title":"number","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"number","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL14MXLNumberLevelV","text":"MXLNumberLevel","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLNonArpeggiate":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlnonarpeggiate","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNonArpeggiate","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"MXLNonArpeggiate","kind":"identifier"}],"abstract":[{"type":"text","text":"The non-arpeggiate type indicates that this note is at the top or bottom of a bracket indicating to not"},{"type":"text","text":" "},{"type":"text","text":"arpeggiate these notes. Since this does not involve playback, it is only used on the top or bottom notes, not"},{"type":"text","text":" "},{"type":"text","text":"on each note as for the arpeggiate type."}],"kind":"symbol","type":"topic","navigatorTitle":[{"text":"MXLNonArpeggiate","kind":"identifier"}],"title":"MXLNonArpeggiate"},"doc://IvorMXL/documentation/IvorMXL/MXLNumberLevel":{"role":"symbol","url":"\/documentation\/ivormxl\/mxlnumberlevel","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumberLevel","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLNumberLevel","kind":"identifier"}],"kind":"symbol","abstract":[{"type":"text","text":"Slurs, tuplets, and many other features can be concurrent and overlap within a single musical part. The"},{"type":"text","text":" "},{"type":"text","text":"number-level entity distinguishes up to 16 concurrent objects of the same type when the objects overlap in"},{"type":"text","text":" "},{"type":"text","text":"MusicXML document order. Values greater than 6 are usually only needed for music with a large number of divisi"},{"type":"text","text":" "},{"type":"text","text":"staves in a single part, or if there are more than 6 cross-staff arpeggios in a single measure. When a number-"},{"type":"text","text":" "},{"type":"text","text":"level value is implied, the value is 1 by default."}],"type":"topic","navigatorTitle":[{"text":"MXLNumberLevel","kind":"identifier"}],"title":"MXLNumberLevel"}}}