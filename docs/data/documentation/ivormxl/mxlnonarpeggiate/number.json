on","url":"\/documentation\/ivormxl"},"doc://IvorMXL/documentation/IvorMXL/MXLNonArpeggiate/number":{"kind":"symbol","abstract":[{"text":"Distinguishes multiple non-arpeggiate elements on a single note.","type":"text"}],"title":"number","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNonArpeggiate\/number","role":"symbol","url":"\/documentation\/ivormxl\/mxlnonarpeggiate\/number","type":"topic","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"number"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL14MXLNumberLevelV","text":"MXLNumberLevel"},{"kind":"text","text":"?"}]},"doc://IvorMXL/documentation/IvorMXL/MXLNumberLevel":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNumberLevel","navigatorTitle":[{"kind":"identifier","text":"MXLNumberLevel"}],"url":"\/documentation\/ivormxl\/mxlnumberlevel","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNumberLevel"}],"title":"MXLNumberLevel","abstract":[{"text":"Slurs, tuplets, and many other features can be concurrent and overlap within a single musical part. The","type":"text"},{"text":" ","type":"text"},{"text":"number-level entity distinguishes up to 16 concurrent objects of the same type when the objects overlap in","type":"text"},{"text":" ","type":"text"},{"text":"MusicXML document order. Values greater than 6 are usually only needed for music with a large number of divisi","type":"text"},{"text":" ","type":"text"},{"text":"staves in a single part, or if there are more than 6 cross-staff arpeggios in a single measure. When a number-","type":"text"},{"text":" ","type":"text"},{"text":"level value is implied, the value is 1 by default.","type":"text"}],"type":"topic"},"doc://IvorMXL/documentation/IvorMXL/MXLNonArpeggiate":{"type":"topic","abstract":[{"text":"The non-arpeggiate type indicates that this note is at the top or bottom of a bracket indicating to not","type":"text"},{"text":" ","type":"text"},{"text":"arpeggiate these notes. Since this does not involve playback, it is only used on the top or bottom notes, not","type":"text"},{"text":" ","type":"text"},{"text":"on each note as for the arpeggiate type.","type":"text"}],"url":"\/documentation\/ivormxl\/mxlnonarpeggiate","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLNonArpeggiate"}],"kind":"symbol","title":"MXLNonArpeggiate","navigatorTitle":[{"kind":"identifier","text":"MXLNonArpeggiate"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNonArpeggiate","role":"symbol"}}}