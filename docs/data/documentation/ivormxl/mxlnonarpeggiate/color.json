rTitle":[{"kind":"identifier","text":"MXLColor"}],"abstract":[{"type":"text","text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in"},{"type":"text","text":" "},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/ivormxl\/mxlcolor"},"doc://IvorMXL/documentation/IvorMXL/MXLNonArpeggiate/color":{"type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"color"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL8MXLColorV","text":"MXLColor"},{"kind":"text","text":"?"}],"title":"color","url":"\/documentation\/ivormxl\/mxlnonarpeggiate\/color","abstract":[{"type":"text","text":"The color attribute group indicates the color of an element."}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNonArpeggiate\/color"},"doc://IvorMXL/documentation/IvorMXL/MXLNonArpeggiate":{"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNonArpeggiate","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MXLNonArpeggiate"}],"abstract":[{"text":"The non-arpeggiate type indicates that this note is at the top or bottom of a bracket indicating to not","type":"text"},{"type":"text","text":" "},{"type":"text","text":"arpeggiate these notes. Since this does not involve playback, it is only used on the top or bottom notes, not"},{"type":"text","text":" "},{"type":"text","text":"on each note as for the arpeggiate type."}],"kind":"symbol","title":"MXLNonArpeggiate","url":"\/documentation\/ivormxl\/mxlnonarpeggiate","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifie