text":"MXLNonArpeggiate","kind":"identifier"}],"abstract":[{"type":"text","text":"The non-arpeggiate type indicates that this note is at the top or bottom of a bracket indicating to not"},{"type":"text","text":" "},{"type":"text","text":"arpeggiate these notes. Since this does not involve playback, it is only used on the top or bottom notes, not"},{"type":"text","text":" "},{"type":"text","text":"on each note as for the arpeggiate type."}],"kind":"symbol","type":"topic","navigatorTitle":[{"text":"MXLNonArpeggiate","kind":"identifier"}],"title":"MXLNonArpeggiate"},"doc://IvorMXL/documentation/IvorMXL/MXLNonArpeggiate/color":{"role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"color","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLColor","preciseIdentifier":"s:7IvorMXL8MXLColorV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"kind":"symbol","title":"color","url":"\/documentation\/ivormxl\/mxlnonarpeggiate\/color","type":"topic","abstract":[{"text":"The color attribute group indicates the color of an element.","type":"text"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLNonArpeggiate\/color"},"doc://IvorMXL/documentation/IvorMXL/MXLColor":{"title":"MXLColor","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLColor"}],"abstract":[{"text":"The color type indicates the color of an element. Color may be represented as hexadecimal RGB triples, as in","type":"text"},{"text":" ","type":"text"},{"text":"HTML, or as hexadecimal ARGB tuples, with the A indicating alpha of transparency. An alpha value of 00 is","type":"text"},{"text":" ","type":"text"},{"text":"totally transparent; FF is totally opaque. If RGB is used, the A value is assumed to be FF.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLColor","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MXLColor"}],"url":"\/doc