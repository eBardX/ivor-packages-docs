{"kind":"symbol","schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL"]]},"topicSections":[{"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemLayout\/init(systemMargins:systemDistance:topSystemDistance:systemDividers:)"],"anchor":"Initializers","generated":true,"title":"Initializers"},{"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemLayout\/systemDistance","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemLayout\/systemDividers","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemLayout\/systemMargins","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemLayout\/topSystemDistance"],"anchor":"Instance-Properties","generated":true,"title":"Instance Properties"},{"identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemLayout\/Equatable-Implementations"],"anchor":"Default-Implementations","generated":true,"title":"Default Implementations"}],"sections":[],"abstract":[{"type":"text","text":"A system is a group of staves that are read and played simultaneously. System layout includes left and right"},{"type":"text","text":" "},{"type":"text","text":"margins and the vertical distance from the previous system. The system distance is measured from the bottom"},{"type":"text","text":" "},{"type":"text","text":"line of the previous system to the top line of the current system. It is ignored for the first system on a"},{"type":"text","text":" "},{"type":"text","text":"page. The top system distance is measured from the page’s top margin to the top line of the first system. It"},{"type":"text","text":" "},{"type":"text","text":"is ignored for all but the first system on a page."}],"relationshipsSections":[{"identifiers":["doc:\/\/IvorMXL\/s8CopyableP","doc:\/\/IvorMXL\/SQ","doc:\/\/IvorMXL\/s9EscapableP","doc:\/\/IvorMXL\/SH","doc:\/\/IvorMXL\/s8SendableP","doc:\/\/IvorMXL\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships","title":"Conforms To"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSystemLayout","kind":"identifier"}]}],"kind":"declarations"},{"content":[{"anchor":"overview","type":"heading","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"Sometimes the sum of measure widths in a system may not equal the system width specified by the layout","type":"text"},{"text":" ","type":"text"},{"text":"elements due to roundoff or other errors. The behavior when reading MusicXML files in these cases is","type":"text"},{"text":" ","type":"text"},{"text":"application-dependent. For instance, applications may find that the system layout data is more reliable than","type":"text"},{"text":" ","type":"text"},{"text":"the sum of the measure widths, and adjust the measure widths accordingly.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"When used in the defaults element, the system-layout element defines a default appearance for all systems in","type":"text"},{"text":" ","type":"text"},{"text":"the score. If no system-layout element is present in the defaults element, default system layout values are","type":"text"},{"text":" ","type":"text"},{"text":"chosen by the application.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"When used in the print element, the system-layout element affects the appearance of the current system only.","type":"text"},{"text":" ","type":"text"},{"text":"All other systems use the default values as determined by the defaults element. If any child elements are","type":"text"},{"text":" ","type":"text"},{"text":"missing from the system-layout element in a print element, the values determined by the defaults element are","type":"text"},{"text":" ","type":"text"},{"text":"used there as well. This type of system-layout element need only be read from or written to the first visible","type":"text"},{"text":" ","type":"text"},{"text":"part in the score.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Maps the MusicXML ","type":"text"},{"code":"<system-layout>","type":"codeVoice"},{"text":" element.","type":"text"}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/ivormxl\/mxlsystemlayout"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemLayout"},"metadata":{"modules":[{"name":"IvorMXL"}],"roleHeading":"Structure","role":"symbol","title":"MXLSystemLayout","symbolKind":"struct","externalID":"s:7IvorMXL15MXLSystemLayoutV","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSystemLayout","kind":"identifier"}],"navigatorTitle":[{"text":"MXLSystemLayout","kind":"identifier"}]},"references":{"doc://IvorMXL/SH":{"identifier":"doc:\/\/IvorMXL\/SH","type":"unresolvable","title":"Swift.Hashable"},"doc://IvorMXL/documentation/IvorMXL/MXLSystemLayout/systemMargins":{"role":"symbol","title":"systemMargins","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemLayout\/systemMargins","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"systemMargins","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLSystemMargins","kind":"typeIdentifier","preciseIdentifier":"s:7IvorMXL16MXLSystemMarginsV"},{"text":"?","kind":"text"}],"type":"topic","url":"\/documentation\/ivormxl\/mxlsystemlayout\/systemmargins","abstract":[{"type":"text","text":"The left and right margins for the system, relative to the page margins."}],"kind":"symbol"},"doc://IvorMXL/s8SendableP":{"identifier":"doc:\/\/IvorMXL\/s8SendableP","type":"unresolvable","title":"Swift.Sendable"},"doc://IvorMXL/documentation/IvorMXL/MXLSystemLayout/systemDistance":{"kind":"symbol","abstract":[{"type":"text","text":"The vertical distance from the bottom line of the previous system to the top line of the current system, in"},{"type":"text","text":" "},{"type":"text","t