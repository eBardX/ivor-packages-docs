 bottom line of the previous system to the top line of the current system, in"},{"type":"text","text":" "},{"type":"text","text":"tenths. Ignored for the first system on a page."}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLSystemLayout":{"title":"MXLSystemLayout","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLSystemLayout"}],"navigatorTitle":[{"text":"MXLSystemLayout","kind":"identifier"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemLayout","url":"\/documentation\/ivormxl\/mxlsystemlayout","type":"topic","abstract":[{"type":"text","text":"A system is a group of staves that are read and played simultaneously. System layout includes left and right"},{"type":"text","text":" "},{"type":"text","text":"margins and the vertical distance from the previous system. The system distance is measured from the bottom"},{"type":"text","text":" "},{"type":"text","text":"line of the previous system to the top line of the current system. It is ignored for the first system on a"},{"type":"text","text":" "},{"type":"text","text":"page. The top system distance is measured from the page’s top margin to the top line of the first system. It"},{"type":"text","text":" "},{"type":"text","text":"is ignored for all but the first system on a page."}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLSystemLayout/init(systemMargins:systemDistance:topSystemDistance:systemDividers:)":{"abstract":[{"text":"Creates a new ","type":"text"},{"type":"codeVoice","code":"MXLSystemLayout"},{"text":".","type":"text"}],"title":"init(systemMargins:systemDistance:topSystemDistance:systemDividers:)","url":"\/documentation\/ivormxl\/mxlsystemlayout\/init(systemmargins:systemdistance:topsystemdistance:systemdividers:)","kind":"symbol","role":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"systemMargins"},{"kind":"text","text":": "}