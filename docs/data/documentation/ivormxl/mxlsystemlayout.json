{"sections":[],"abstract":[{"type":"text","text":"A system is a group of staves that are read and played simultaneously. System layout includes left and right"},{"type":"text","text":" "},{"type":"text","text":"margins and the vertical distance from the previous system. The system distance is measured from the bottom"},{"type":"text","text":" "},{"type":"text","text":"line of the previous system to the top line of the current system. It is ignored for the first system on a"},{"type":"text","text":" "},{"type":"text","text":"page. The top system distance is measured from the page’s top margin to the top line of the first system. It"},{"type":"text","text":" "},{"type":"text","text":"is ignored for all but the first system on a page."}],"metadata":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLSystemLayout"}],"symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"MXLSystemLayout"}],"title":"MXLSystemLayout","externalID":"s:7IvorMXL15MXLSystemLayoutV","modules":[{"name":"IvorMXL"}],"role":"symbol","roleHeading":"Structure"},"topicSections":[{"title":"Initializers","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemLayout\/init(systemMargins:systemDistance:topSystemDistance:systemDividers:)"],"anchor":"Initializers","generated":true},{"title":"Instance Properties","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemLayout\/systemDistance","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemLayout\/systemDividers","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemLayout\/systemMargins","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemLayout\/topSystemDistance"],"anchor":"Instance-Properties","generated":true},{"title":"Default Implementations","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemLayout\/Equatable-Implementations"],"anchor":"Default-Implementations","generated":true}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLSystemLayout"}]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"type":"text","text":"Sometimes the sum of measure widths in a system may not equal the system width specified by the layout"},{"type":"text","text":" "},{"type":"text","text":"elements due to roundoff or other errors. The behavior when reading MusicXML files in these cases is"},{"text":" ","type":"text"},{"type":"text","text":"application-dependent. For instance, applications may find that the system layout data is more reliable than"},{"type":"text","text":" "},{"text":"the sum of the measure widths, and adjust the measure widths accordingly.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"When used in the defaults element, the system-layout element defines a default appearance for all systems in","type":"text"},{"text":" ","type":"text"},{"text":"the score. If no system-layout element is present in the defaults element, default system layout values are","type":"text"},{"text":" ","type":"text"},{"text":"chosen by the application.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"When used in the print element, the system-layout element affects the appearance of the current system only."},{"type":"text","text":" "},{"type":"text","text":"All other systems use the default values as determined by the defaults element. If any child elements are"},{"type":"text","text":" "},{"text":"missing from the system-layout element in a print element, the values determined by the defaults element are","type":"text"},{"text":" ","type":"text"},{"text":"used there as well. This type of system-layout element need only be read from or written to the first visible","type":"text"},{"text":" ","type":"text"},{"text":"part in the score.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Maps the MusicXML ","type":"text"},{"code":"<system-layout>","type":"codeVoice"},{"text":" element.","type":"text"}],"type":"paragraph"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemLayout"},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL"]]},"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/IvorMXL\/s8CopyableP","doc:\/\/IvorMXL\/SQ","doc:\/\/IvorMXL\/s9EscapableP","doc:\/\/IvorMXL\/SH","doc:\/\/IvorMXL\/s8SendableP","doc:\/\/IvorMXL\/s16SendableMetatypeP"],"kind":"relationships","type":"conformsTo"}],"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"paths":["\/documentation\/ivormxl\/mxlsystemlayout"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://IvorMXL/documentation/IvorMXL/MXLSystemLayout/systemMargins":{"url":"\/documentation\/ivormxl\/mxlsystemlayout\/systemmargins","title":"systemMargins","abstract":[{"text":"The left and right margins for the system, relative to the page margins.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemLayout\/systemMargins","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"systemMargins"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLSystemMargins","preciseIdentifier":"s:7IvorMXL16MXLSystemMarginsV"},{"kind":"text","text":"?"}],"kind":"symbol","role":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLSystemLayout":{"abstract":[{"type":"text","text":"A system is a group of staves that are read and played simultaneously. System layout includes left and right"},{"type":"text","text":" "},{"type":"text","text":"margins and the vertical distance from the previous system. The system distance is measured from the bottom"},{"type":"text","text":" "},{"type":"text","text":"line of the previous system to the top line of the current system. It is ignored for the first system on a"},{"type":"text","text":" "},{"type":"text","text":"page. The top system distance is measured from the page’s top margin to the top line of the first system. It"},{"type":"text","text":" "},{"type":"text","text":"is ignored for all but the first system on a page."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSystemLayout","kind":"identifier"}],"title":"MXLSystemLayout","navigatorTitle":[{"text":"MXLSystemLayout","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/ivormxl\/mxlsystemlayout","type":"topic","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemLayout"},"doc://IvorMXL/documentation/IvorMXL":{"url":"\/documentation\/ivormxl","kind":"symbol","type":"topic","role":"collection","title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}]},"doc://IvorMXL/s9EscapableP":{"title":"Swift.Escapable","type":"unresolvable","identifier":"doc:\/\/IvorMXL\/s9EscapableP"},"doc://IvorMXL/documentation/IvorMXL/MXLSystemLayout/systemDividers":{"abstract":[{"type":"text","text":"Indicates the presence or absence of system dividers between this system and the previous system."}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"systemDividers","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorMXL17MXLSystemDividersV","text":"MXLSystemDividers","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"title":"systemDividers","kind":"symbol","url":"\/documentation\/ivormxl\/mxlsystemlayout\/systemdividers","type":"topic","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemLayout\/systemDividers"},"doc://IvorMXL/documentation/IvorMXL/MXLSystemLayout/Equatable-Implementations":{"url":"\/documentation\/ivormxl\/mxlsystemlayout\/equatable-implementations","title":"Equatable Implementations","abstr