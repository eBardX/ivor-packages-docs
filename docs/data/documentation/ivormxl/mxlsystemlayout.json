{"schemaVersion":{"patch":0,"major":0,"minor":3},"relationshipsSections":[{"type":"conformsTo","title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/IvorMXL\/s8CopyableP","doc:\/\/IvorMXL\/SQ","doc:\/\/IvorMXL\/s9EscapableP","doc:\/\/IvorMXL\/SH","doc:\/\/IvorMXL\/s8SendableP","doc:\/\/IvorMXL\/s16SendableMetatypeP"]}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLSystemLayout"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sometimes the sum of measure widths in a system may not equal the system width specified by the layout"},{"type":"text","text":" "},{"type":"text","text":"elements due to roundoff or other errors. The behavior when reading MusicXML files in these cases is"},{"type":"text","text":" "},{"type":"text","text":"application-dependent. For instance, applications may find that the system layout data is more reliable than"},{"type":"text","text":" "},{"type":"text","text":"the sum of the measure widths, and adjust the measure widths accordingly."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When used in the defaults element, the system-layout element defines a default appearance for all systems in"},{"type":"text","text":" "},{"type":"text","text":"the score. If no system-layout element is present in the defaults element, default system layout values are"},{"type":"text","text":" "},{"type":"text","text":"chosen by the application."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When used in the print element, the system-layout element affects the appearance of the current system only."},{"type":"text","text":" "},{"type":"text","text":"All other systems use the default values as determined by the defaults element. If any child elements are"},{"type":"text","text":" "},{"type":"text","text":"missing from the system-layout element in a print element, the values determined by the defaults element are"},{"type":"text","text":" "},{"type":"text","text":"used there as well. This type of system-layout element need only be read from or written to the first visible"},{"type":"text","text":" "},{"type":"text","text":"part in the score."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Maps the MusicXML "},{"type":"codeVoice","code":"<system-layout>"},{"type":"text","text":" element."}]}],"kind":"content"}],"kind":"symbol","metadata":{"symbolKind":"struct","externalID":"s:7IvorMXL15MXLSystemLayoutV","roleHeading":"Structure","title":"MXLSystemLayout","modules":[{"name":"IvorMXL"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MXLSystemLayout","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"MXLSystemLayout"}],"role":"symbol"},"topicSections":[{"anchor":"Initializers","generated":true,"title":"Initializers","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemLayout\/init(systemMargins:systemDistance:topSystemDistance:systemDividers:)"]},{"anchor":"Instance-Properties","generated":true,"title":"Instance Properties","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemLayout\/systemDistance","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemLayout\/systemDividers","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemLayout\/systemMargins","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemLayout\/topSystemDistance"]},{"anchor":"Default-Implementations","generated":true,"title":"Default Implementations","identifiers":["doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemLayout\/Equatable-Implementations"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormxl\/mxlsystemlayout"]}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemLayout"},"abstract":[{"type":"text","text":"A system is a group of staves that are read and played simultaneously. System layout includes left and right"},{"type":"text","text":" "},{"type":"text","text":"margins and the vertical distance from the previous system. The system distance is measured from the bottom"},{"type":"text","text":" "},{"type":"text","text":"line of the previous system to the top line of the current system. It is ignored for the first system on a"},{"type":"text","text":" "},{"type":"text","text":"page. The top system distance is measured from the page’s top margin to the top line of the first system. It"},{"type":"text","text":" "},{"type":"text","text":"is ignored for all but the first system on a page."}],"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL"]]},"references":{"doc://IvorMXL/s8CopyableP":{"type":"unresolvable","title":"Swift.Copyable","identifier":"doc:\/\/IvorMXL\/s8CopyableP"},"doc://IvorMXL/documentation/IvorMXL/MXLSystemLayout/Equatable-Implementations":{"abstract":[],"title":"Equatable Implementations","url":"\/documentation\/ivormxl\/mxlsystemlayout\/equatable-implementations","kind":"article","role":"collectionGroup","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemLayout\/Equatable-Implementations"},"doc://IvorMXL/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","type":"unresolvable","identifier":"doc:\/\/IvorMXL\/s16SendableMetatypeP"},"doc://IvorMXL/documentation/IvorMXL/MXLSystemLayout/topSystemDistance":{"abstract":[{"type":"text","text":"The vertical distance from the page’s top margin to the top line of the first system, in tenths. Ignored for"},{"type":"text","text":" "},{"type":"text","text":"all but the first system on a page."}],"title":"topSystemDistance","url":"\/documentation\/ivormxl\/mxlsystemlayout\/topsystemdistance","kind":"symbol","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"topSystemDistance","kind":"id