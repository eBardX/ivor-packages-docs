ntifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLEmptyPrintObjectStyleAlign","abstract":[{"text":"The empty-print-style-align-object type represents an empty element with print-object and print-style-align","type":"text"},{"text":" ","type":"text"},{"text":"attribute groups.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"MXLEmptyPrintObjectStyleAlign"}]},"doc://IvorMXL/documentation/IvorMXL":{"abstract":[{"type":"text","text":"A MusicXML parser, normalizer, validator, and formatter."}],"title":"IvorMXL","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol","url":"\/documentation\/ivormxl","type":"topic","role":"collection"},"doc://IvorMXL/documentation/IvorMXL/MXLSystemDividers":{"title":"MXLSystemDividers","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLSystemDividers"}],"kind":"symbol","type":"topic","url":"\/documentation\/ivormxl\/mxlsystemdividers","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLSystemDividers","abstract":[{"text":"The system-dividers element indicates the presence or absence of system dividers (also known as system","type":"text"},{"type":"text","text":" "},{"text":"separation marks) between systems displayed on the same page. Dividers on the left and right side of the page","type":"text"},{"text":" ","type":"text"},{"text":"are controlled by the left-divider and right-divider elements respectively. The default vertical position is","type":"text"},{"text":" ","type":"text"},{"text":"half the system-distance value from the top of the system that is below the divider. The default horizontal","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"position is the left and right system margin, respectively."}],"navigatorTitle":[{"kind":"identifier","text":"MXLSystemDividers"}]}}}