{"abstract":[{"type":"text","text":"The trill-sound attribute group includes attributes used to guide the sound of trills, mordents, turns,"},{"type":"text","text":" "},{"type":"text","text":"shakes, and wavy lines. The default choices are:"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"title":"trillSound","modules":[{"name":"IvorMXL"}],"externalID":"s:7IvorMXL17MXLHorizontalTurnV10trillSoundAA08MXLTrillF0Vvp","role":"symbol","symbolKind":"property","roleHeading":"Instance Property","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"trillSound","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLTrillSound","preciseIdentifier":"s:7IvorMXL13MXLTrillSoundV","kind":"typeIdentifier"}]},"hierarchy":{"paths":[["doc:\/\/IvorMXL\/documentation\/IvorMXL","doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHorizontalTurn"]]},"variants":[{"paths":["\/documentation\/ivormxl\/mxlhorizontalturn\/trillsound"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"trillSound","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MXLTrillSound","preciseIdentifier":"s:7IvorMXL13MXLTrillSoundV","kind":"typeIdentifier","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTrillSound"}],"platforms":["macOS"],"languages":["swift"]}]},{"content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"Start-Note = “upper” trill-step = “whole” two-note-turn = “none” accelerate = “no” beats = “4”."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Second-beat and last-beat are percentages for landing on the indicated beat, with defaults of 25 and 75"},{"type":"text","text":" "},{"type":"text","text":"respectively."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For mordent and inverted-mordent elements, the defaults are different:"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The default start-note is “main”, not “upper”. The default for beats is “3”, not “4”. The default for second-"},{"type":"text","text":" "},{"type":"text","text":"beat is “12”, not “25”. The default for last-beat is “24”, not “75”."}],"type":"paragraph"}],"kind":"content"}],"identifier":{"url":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHorizontalTurn\/trillSound","interfaceLanguage":"swift"},"sections":[],"kind":"symbol","references":{"doc://IvorMXL/documentation/IvorMXL/MXLHorizontalTurn/trillSound":{"abstract":[{"type":"text","text":"The trill-sound attribute group includes attributes used to guide the sound of trills, mordents, turns,"},{"type":"text","text":" "},{"type":"text","text":"shakes, and wavy lines. The default choices are:"}],"type":"topic","title":"trillSound","kind":"symbol","role":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHorizontalTurn\/trillSound","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"trillSound"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MXLTrillSound","preciseIdentifier":"s:7IvorMXL13MXLTrillSoundV"}],"url":"\/documentation\/ivormxl\/mxlhorizontalturn\/trillsound"},"doc://IvorMXL/documentation/IvorMXL/MXLTrillSound":{"title":"MXLTrillSound","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLTrillSound"}],"navigatorTitle":[{"kind":"identifier","text":"MXLTrillSound"}],"identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLTrillSound","url":"\/documentation\/ivormxl\/mxltrillsound","type":"topic","abstract":[{"text":"The trill-sound attribute group includes attributes used to guide the sound of trills, mordents, turns,","type":"text"},{"text":" ","type":"text"},{"text":"shakes, and wavy lines. The default choices are:","type":"text"}],"role":"symbol"},"doc://IvorMXL/documentation/IvorMXL":{"type":"topic","abstract":[{"text":"A MusicXML parser, normalizer, validator, and formatter.","type":"text"}],"url":"\/documentation\/ivormxl","title":"IvorMXL","role":"collection","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL","kind":"symbol"},"doc://IvorMXL/documentation/IvorMXL/MXLHorizontalTurn":{"url":"\/documentation\/ivormxl\/mxlhorizontalturn","abstract":[{"type":"text","text":"The horizontal-turn type represents turn elements that are horizontal rather than vertical. These are empty"},{"type":"text","text":" "},{"type":"text","text":"elements with print-style, placement, trill-sound, and slash attributes. If the slash attribute is yes, then a"},{"type":"text","text":" "},{"type":"text","text":"vertical line is used to slash the turn. It is no if not specified."}],"title":"MXLHorizontalTurn","kind":"symbol","type":"topic","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHorizontalTurn","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLHorizontalTurn"}],"navigatorTitle":[{"kind":"identifier","text":"MXLHorizontalTurn"}]}}}