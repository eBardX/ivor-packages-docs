ifier","text":"MXLTrillSound","preciseIdentifier":"s:7IvorMXL13MXLTrillSoundV"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHorizontalTurn\/trillSound","url":"\/documentation\/ivormxl\/mxlhorizontalturn\/trillsound"},"doc://IvorMXL/documentation/IvorMXL/MXLHorizontalTurn":{"title":"MXLHorizontalTurn","navigatorTitle":[{"kind":"identifier","text":"MXLHorizontalTurn"}],"type":"topic","abstract":[{"type":"text","text":"The horizontal-turn type represents turn elements that are horizontal rather than vertical. These are empty"},{"type":"text","text":" "},{"type":"text","text":"elements with print-style, placement, trill-sound, and slash attributes. If the slash attribute is yes, then a"},{"type":"text","text":" "},{"type":"text","text":"vertical line is used to slash the turn. It is no if not specified."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MXLHorizontalTurn"}],"kind":"symbol","identifier":"doc:\/\/IvorMXL\/documentation\/IvorMXL\/MXLHorizontalTurn","url":"\/documentation\/ivormxl\/mxlhorizontalturn"}}}