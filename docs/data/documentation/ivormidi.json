{"abstract":[{"type":"text","text":"MIDI channel message, system message, and data value types."}],"topicSections":[{"anchor":"Guides","title":"Guides","identifiers":["doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/UsingIvorMIDI"]},{"anchor":"Messages","title":"Messages","identifiers":["doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIChannelMessage","doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDISystemMessage","doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDITuningMessage"]},{"anchor":"Data-values","title":"Data values","identifiers":["doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIChannel","doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIController","doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIData1Value","doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIData2Value","doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDINonRegisteredParameter","doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIPitchBend","doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIProgram","doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIRegisteredParameter","doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDITuningChange","doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDITuningFrequency","doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDITuningLocation","doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDITuningOffsets"]},{"title":"Patches","anchor":"Patches","identifiers":["doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIBank","doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIPatch"]},{"title":"Encoding","anchor":"Encoding","identifiers":["doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIBytesConvertible"]}],"kind":"symbol","metadata":{"color":{"standardColorIdentifier":"blue"},"role":"collection","modules":[{"name":"IvorMIDI"}],"symbolKind":"module","roleHeading":"Framework","title":"IvorMIDI","externalID":"IvorMIDI"},"identifier":{"url":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"The IvorMIDI framework provides MIDI channel message, system message, and data","type":"text"},{"text":" ","type":"text"},{"text":"value types written in Swift. Channel messages cover note on and off,","type":"text"},{"text":" ","type":"text"},{"text":"polyphonic and channel pressure, control change, program change, and pitch","type":"text"},{"text":" ","type":"text"},{"text":"bend change; system messages cover system exclusive, system common, and system","type":"text"},{"text":" ","type":"text"},{"text":"real-time messages. Channel and system messages, and the data values they","type":"text"},{"text":" ","type":"text"},{"text":"carry, can be converted to and from their ","type":"text"},{"identifier":"https:\/\/midi.org\/midi-1-0","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"wire encoding.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Registered (RPN) and non-registered (NRPN) parameters, such as pitch bend","type":"text"},{"text":" ","type":"text"},{"text":"sensitivity and fine tuning, can be set with a single call that builds the","type":"text"},{"text":" ","type":"text"},{"text":"whole control change sequence. Universal system exclusive messages for master","type":"text"},{"text":" ","type":"text"},{"text":"volume, master tuning, and all of the MIDI Tuning Standard are built the same","type":"text"},{"text":" ","type":"text"},{"text":"way, as are the bank select and program change messages that set a channel to","type":"text"},{"text":" ","type":"text"},{"text":"a ","type":"text"},{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIPatch","type":"reference","isActive":true},{"text":". ","type":"text"},{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDITuningMessage","type":"reference","isActive":true},{"text":" decodes MIDI Tuning Standard messages.","type":"text"},{"text":" ","type":"text"},{"text":"A ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIPitchBend"},{"text":" can be made from a bend in cents and the synthesizer’s","type":"text"},{"text":" ","type":"text"},{"text":"pitch bend sensitivity.","type":"text"}]},{"type":"codeListing","code":["import IvorMIDI","","\/\/ Middle C, velocity 100, on channel 1.","let noteOn = MIDIChannelMessage.noteOn(1, 60, 100)","","noteOn.statusByte   \/\/ 0x90","noteOn.dataBytes    \/\/ [0x3C, 0x64]","","\/\/ Decode a message from its wire encoding.","let decoded = MIDIChannelMessage(statusByte: 0x90,","                                 dataBytes: [0x3c, 0x64])","","decoded == noteOn   \/\/ true"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"See "},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/UsingIvorMIDI"},{"type":"text","text":" for a full guide to the messages, the data values, and"},{"type":"text","text":" "},{"type":"text","text":"the wire encoding."}]}]}],"hierarchy":{"paths":[[]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormidi"]}],"references":{"doc://IvorMIDI/documentation/IvorMIDI/MIDIPatch":{"abstract":[{"text":"A MIDI patch: a program and, optionally, the bank it comes from.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MIDIPatch"}],"navigatorTitle":[{"kind":"identifier","text":"MIDIPatch"}],"title":"MIDIPatch","kind":"symbol","identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIPatch","url":"\/documentation\/ivormidi\/midipatch","type":"topic","role":"symbol"},"doc://IvorMIDI/documentation/IvorMIDI/MIDITuningChange":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MIDITuningChange"}],"navigatorTitle":[{"kind":"identifier","text":"MIDITuningChange"}],"abstract":[{"type":"text","t