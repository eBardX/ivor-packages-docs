{"metadata":{"externalID":"IvorMIDI","color":{"standardColorIdentifier":"blue"},"role":"collection","title":"IvorMIDI","symbolKind":"module","modules":[{"name":"IvorMIDI"}],"roleHeading":"Framework"},"hierarchy":{"paths":[[]]},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI"},"kind":"symbol","abstract":[{"type":"text","text":"MIDI channel message, system message, and data value types."}],"variants":[{"paths":["\/documentation\/ivormidi"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"The IvorMIDI framework provides MIDI channel message, system message, and data","type":"text"},{"text":" ","type":"text"},{"text":"value types written in Swift. Channel messages cover note on and off,","type":"text"},{"text":" ","type":"text"},{"text":"polyphonic and channel pressure, control change, program change, and pitch","type":"text"},{"text":" ","type":"text"},{"text":"bend change; system messages cover system exclusive, system common, and system","type":"text"},{"text":" ","type":"text"},{"text":"real-time messages. Every message and data value can be converted to and from","type":"text"},{"text":" ","type":"text"},{"text":"its ","type":"text"},{"identifier":"https:\/\/midi.org\/midi-1-0","isActive":true,"type":"reference"},{"text":" wire encoding.","type":"text"},{"text":" ","type":"text"},{"text":"Registered (RPN) and non-registered (NRPN) parameters, such as pitch bend","type":"text"},{"text":" ","type":"text"},{"text":"sensitivity and fine tuning, can be set with a single call that builds the","type":"text"},{"text":" ","type":"text"},{"text":"whole control change sequence. Universal system exclusive messages","type":"text"},{"text":" ","type":"text"},{"text":"for master volume, master tuning, and scale\/octave tuning are built the same","type":"text"},{"text":" ","type":"text"},{"text":"way, as are the bank select and program change messages that set a channel","type":"text"},{"text":" ","type":"text"},{"text":"to a ","type":"text"},{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIPatch","isActive":true,"type":"reference"},{"text":". A ","type":"text"},{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIPitchBend","isActive":true,"type":"reference"},{"text":" can be made from a bend in cents and","type":"text"},{"text":" ","type":"text"},{"text":"the synthesizer’s pitch bend sensitivity.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["import IvorMIDI","","\/\/ Middle C, velocity 100, on channel 1.","let noteOn = MIDIChannelMessage.noteOn(1, 60, 100)","","noteOn.statusByte   \/\/ 0x90","noteOn.dataBytes    \/\/ [0x3C, 0x64]","","\/\/ Decode a message from its wire encoding.","let decoded = MIDIChannelMessage(statusByte: 0x90,","                                 dataBytes: [0x3c, 0x64])","","decoded == noteOn   \/\/ true"]},{"type":"paragraph","inlineContent":[{"text":"Every public message and data value type is a ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":" value type, so","type":"text"},{"text":" ","type":"text"},{"text":"instances can be freely shared across tasks and actor boundaries.","type":"text"}]}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"topicSections":[{"identifiers":["doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIChannelMessage","doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDISystemMessage"],"anchor":"Messages","title":"Messages"},{"identifiers":["doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIChannel","doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIController","doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIData1Value","doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIData2Value","doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDINonRegisteredParameter","doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIPitchBend","doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIProgram","doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIRegisteredParameter"],"anchor":"Data-values","title":"Data values"},{"identifiers":["doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIBytesConvertible"],"anchor":"Encoding","title":"Encoding"},{"generated":true,"identifiers":["doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIBank","doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIPatch"],"anchor":"Structures","title":"Structures"}],"references":{"doc://IvorMIDI/documentation/IvorMIDI/MIDIController":{"fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"text":"MIDIController","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIController","abstract":[{"type":"text","text":"A MIDI controller number (0–127)."}],"type":"topic","role":"symbol","url":"\/documentation\/ivormidi\/midicontroller","title":"MIDIController","navigatorTitle":[{"text":"MIDIController","kind":"identifier"}]},"doc://IvorMIDI/documentation/IvorMIDI/MIDIChannelMessage":{"role":"symbol","url":"\/documentation\/ivormidi\/midichannelmessage","abstract":[{"text":"A MIDI channel voice or mode message.","type":"text"}],"navigatorTitle":[{"text":"MIDIChannelMessage","kind":"identifier"}],"title":"MIDIChannelMessage","kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MIDIChannelMessage","kind":"identifier"}],"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIChannelMessage","type":"topic"},"doc://IvorMIDI/documentation/IvorMIDI/MIDIPitchBend":{"navigatorTitle":[{"text":"MIDIPitchBend","kind":"identifier"}],"type":"topic","title":"MIDIPitchBend","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MIDIPitchBend","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIPitchBend","url":"\/documentation\/ivormidi\/midipitchbend","role":"symbol","abstract":[{"type":"text","text":"A MIDI pitch ben