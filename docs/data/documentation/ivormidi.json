{"kind":"symbol","primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"IvorMIDI parses and formats "},{"type":"reference","identifier":"https:\/\/midi.org\/standard-midi-files","isActive":true},{"type":"text","text":" "},{"type":"text","text":"(SMF, RP-001). It handles all three SMF formats, all standard meta-event types, MIDI channel"},{"type":"text","text":" "},{"type":"text","text":"messages, system-exclusive events, SMPTE time division, and the extended meta-event types"},{"type":"text","text":" "},{"type":"text","text":"defined in RP-001 Appendix C (device name, program name, MIDI port, reserved text events"},{"type":"text","text":" "},{"type":"text","text":"0x0A–0x0F)."}]},{"type":"heading","level":3,"text":"Parsing","anchor":"Parsing"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/SMFParser","isActive":true},{"type":"text","text":" decodes raw binary data into an "},{"type":"reference","identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/SMFSequence","isActive":true},{"text":". By default it enforces strict","type":"text"},{"type":"text","text":" "},{"type":"text","text":"conformance to RP-001; any deviation causes a "},{"type":"reference","identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/SMFParseError","isActive":true},{"type":"text","text":". Pass"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/SMFParser\/Strictness\/lenient","isActive":true},{"type":"text","text":" to recover from common real-world issues instead — the parser"},{"type":"text","text":" "},{"type":"text","text":"collects "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/SMFDiagnostic"},{"type":"text","text":" values describing each deviation it repaired:"}]},{"type":"codeListing","code":["\/\/ Strict (default) — throws on any spec deviation","let sequence = try SMFParser().parse(data)","","\/\/ Lenient — recovers from common issues and reports what was repaired","let (sequence, diagnostics) = try SMFParser(strictness: .lenient)","                                            .parseWithDiagnostics(data)","for diagnostic in diagnostics {","    print(diagnostic.message)","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Lenient mode handles: truncated chunk lengths, missing End-of-Track events, stray","type":"text"},{"text":" ","type":"text"},{"text":"system-real-time bytes (0xF8–0xFE) embedded in the event stream, track-count mismatches","type":"text"},{"text":" ","type":"text"},{"text":"between the header and the actual MTrk chunks, and format-0 files that incorrectly contain","type":"text"},{"type":"text","text":" "},{"text":"more than one track (coerced to format 1).","type":"text"}]},{"type":"heading","level":3,"text":"Formatting","anchor":"Formatting"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/SMFFormatter","isActive":true},{"type":"text","text":" encodes an "},{"type":"reference","identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/SMFSequence","isActive":true},{"type":"text","text":" to binary data. It automatically appends an"},{"type":"text","text":" "},{"type":"text","text":"End-of-Track meta-event to any track that lacks one, and throws "},{"type":"reference","identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/SMFFormatError","isActive":true},{"type":"text","text":" if a track"},{"type":"text","text":" "},{"type":"text","text":"contains events after its End-of-Track marker:"}]},{"type":"codeListing","syntax":"swift","code":["let data = try SMFFormatter().format(sequence)"]},{"type":"heading","level":3,"anchor":"Validation","text":"Validation"},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/SMFSequence\/validate()"},{"type":"text","text":" checks a sequence for spec violations without throwing, returning an"},{"type":"text","text":" "},{"type":"text","text":"array of "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/SMFValidationIssue"},{"type":"text","text":" values. Each issue has a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/SMFValidationIssue\/severity-swift.property"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/SMFValidationIssue\/Severity-swift.enum\/error"},{"type":"text","text":" or "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/SMFValidationIssue\/Severity-swift.enum\/warning"},{"type":"text","text":") and a"},{"type":"text","text":" "},{"type":"text","text":"human-readable "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/SMFValidationIssue\/message"},{"type":"text","text":". An empty array means the sequence is fully"},{"type":"text","text":" "},{"type":"text","text":"conformant:"}]},{"type":"codeListing","syntax":"swift","code":["let issues = sequence.validate()","if issues.isEmpty {","    print(\"Sequence is fully conformant\")","} else {","    for issue in issues {","        print(\"[\\(issue.severity)] \\(issue.message)\")","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Error-severity issues (missing or misplaced End-of-Track) will cause "},{"type":"reference","identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/SMFFormatter","isActive":true},{"type":"text","text":" to throw."},{"type":"text","text":" "},{"type":"text","text":"Warning-severity issues (tempo\/time-signature in the wrong track, sequence number not at time"},{"type":"text","text":" "},{"type":"text","text":"zero) may cause interoperability problems with some players."}]},{"type":"heading","level":3,"anchor":"Scope-and-non-goals","text":"Scope and non-goals"},{"type":"paragraph","inlineContent":[{"type":"text","text":"IvorMIDI covers the RP-001 SMF specification as described above. The following are"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"type":"text","text":"deliberately out of scope"}]},{"type":"text","text":":"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"RMID (","type":"text"},{"type":"codeVoice","code":".rmi"},{"text":") files","type":"text"}]},{"text":" — the RIFF wrapper around an SMF payload is not supported.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Tempo-map to wall-clock conversion"}]},{"type":"text","text":" — IvorMIDI works in ticks; converting to seconds"},{"type":"text","text":" "},{"type":"text","text":"requires integrating the tempo track, which is application-domain logic."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"MIDI 2.0 \/ UMP","type":"text"}]},{"text":" — IvorMIDI targets MIDI 1.0 SMF only.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Real-time MIDI I\/O"}]},{"type":"text","text":" — IvorMIDI is a file-format library; it does not transmit or receive"},{"text":" ","type":"text"},{"text":"live MIDI data.","type":"text"}]}]}]}]}],"hierarchy":{"paths":[[]]},"variants":[{"paths":["\/documentation\/ivormidi"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"A Standard MIDI Files parser and formatter."}],"metadata":{"externalID":"IvorMIDI","color":{"standardColorIdentifier":"blue"},"modules":[{"name":"IvorMIDI"}],"title":"IvorMIDI","role":"collection","roleHeading":"Framew