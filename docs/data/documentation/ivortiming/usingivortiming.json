{"sections":[],"abstract":[{"text":"Measure musical time in beats or in seconds, and convert between the two with a","type":"text"},{"text":" ","type":"text"},{"text":"tempo map.","type":"text"}],"metadata":{"role":"article","title":"Using IvorTiming","roleHeading":"Article","modules":[{"name":"IvorTiming"}]},"hierarchy":{"paths":[["doc:\/\/IvorTiming\/documentation\/IvorTiming"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorTiming\/documentation\/IvorTiming\/UsingIvorTiming"},"variants":[{"paths":["\/documentation\/ivortiming\/usingivortiming"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"IvorTiming measures time in two ways. "},{"inlineContent":[{"type":"text","text":"Beat time"}],"type":"strong"},{"text":" counts musical beats, so","type":"text"},{"text":" ","type":"text"},{"text":"it stays the same whatever the tempo; ","type":"text"},{"inlineContent":[{"text":"wall time","type":"text"}],"type":"strong"},{"text":" counts seconds on the","type":"text"},{"text":" ","type":"text"},{"text":"clock. Each has a type for a point in time and a type for a length of time:","type":"text"}]},{"header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Kind of time"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Point in time"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Length of time"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Unit"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Beat"}],"type":"paragraph"}],[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorTiming\/documentation\/IvorTiming\/BeatTime"}],"type":"paragraph"}],[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorTiming\/documentation\/IvorTiming\/BeatDuration"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Beats, as an exact rational number"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Wall"}],"type":"paragraph"}],[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorTiming\/documentation\/IvorTiming\/WallTime"}],"type":"paragraph"}],[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorTiming\/documentation\/IvorTiming\/WallDuration"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Whole microseconds"}],"type":"paragraph"}]]],"type":"table","alignments":["left","left","left","left"]},{"inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/IvorTiming\/documentation\/IvorTiming\/TempoMap","type":"reference","isActive":true},{"text":" says how fast the beats go, a ","type":"text"},{"identifier":"doc:\/\/IvorTiming\/documentation\/IvorTiming\/TimeConverter","type":"reference","isActive":true},{"text":" uses one to","type":"text"},{"text":" ","type":"text"},{"text":"convert between the two kinds of time, and a ","type":"text"},{"identifier":"doc:\/\/IvorTiming\/documentation\/IvorTiming\/BeatQuantizer","type":"reference","isActive":true},{"text":" snaps beat times","type":"text"},{"text":" ","type":"text"},{"text":"to a rhythmic grid.","type":"text"}],"type":"paragraph"},{"text":"Times and durations","anchor":"Times-and-durations","level":2,"type":"heading"},{"inlineContent":[{"text":"All four time and duration types are non-negative. Beat times and durations","type":"text"},{"text":" ","type":"text"},{"text":"hold an exact rational ","type":"text"},{"code":"Number","type":"codeVoice"},{"text":" from","type":"text"},{"text":" ","type":"text"},{"identifier":"https:\/\/github.com\/eBardX\/XestiNumbers","type":"reference","isActive":true},{"text":", so a triplet eighth is","type":"text"},{"text":" ","type":"text"},{"text":"exactly 1\/3 of a beat. Wall times and durations hold a whole number of","type":"text"},{"text":" ","type":"text"},{"text":"microseconds; made from seconds, they round to the nearest microsecond.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Every one of them can be written as a literal, but the units differ: a beat","type":"text"},{"text":" ","type":"text"},{"text":"literal is a number of beats, while a wall literal is a number of","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"microseconds"}],"type":"strong"},{"text":". To give a wall time in seconds, use","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/IvorTiming\/documentation\/IvorTiming\/WallTime\/init(doubleValue:)","type":"reference","isActive":true},{"text":" or ","type":"text"},{"identifier":"doc:\/\/IvorTiming\/documentation\/IvorTiming\/WallTime\/init(numberValue:)","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let downbeat: BeatTime = 4","let triplet  = BeatDuration(numberValue: Number(numerator: 1, denominator: 3))!","let onset    = WallTime(doubleValue: 1.25)!     \/\/ 1,250,000 microseconds"],"type":"codeListing"},{"inlineContent":[{"text":"The failable initializers — ","type":"text"},{"code":"init?(numberValue:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"init?(doubleValue:)","type":"codeVoice"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"code":"init?(plain:)","type":"codeVoice"},{"text":" — return ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" for a negative or non-finite value, or one too","type":"text"},{"text":" ","type":"text"},{"text":"large to represent.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Each type has a ","type":"text"},{"inlineContent":[{"type":"text","text":"plain"}],"type":"strong"},{"text":" string form, which ","type":"text"},{"identifier":"doc:\/\/IvorTiming\/documentation\/IvorTiming\/BeatTime\/init(plain:)","type":"reference","isActive":true},{"text":" and its","type":"text"},{"text":" ","type":"text"},{"text":"counterparts parse back. Beat values print as mixed fractions, such as","type":"text"},{"text":" ","type":"text"},{"code":"4 1\/2","type":"codeVoice"},{"text":", and also parse from decimals; wall values print as seconds, without","type":"text"},{"text":" ","type":"text"},{"text":"trailing zeros. Each type also has a ","type":"text"},{"code":"FormatStyle","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"formatted()","type":"codeVoice"},{"text":" produces","type":"text"},{"text":" ","type":"text"},{"text":"an ","type":"text"},{"code":"AttributedString","type":"codeVoice"},{"text":" for display.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"identifier":"doc:\/\/IvorTiming\/documentation\/IvorTiming\/TimeProtocol","type":"reference","isActive":true},{"text":" and ","type":"text"},{"identifier":"doc:\/\/IvorTiming\/documentation\/IvorTiming\/DurationProtocol","type":"reference","isActive":true},{"text":" are the shared interfaces of the time","type":"text"},{"text":" ","type":"text"},{"text":"and duration types, for code that works with either kind of time.","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorTiming\/documentation\/IvorTiming\/TimeBasis"},{"text":" names a kind of time — ","type":"text"},{"code":"beat","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"wall","type":"codeVoice"},{"type":"text","text":" — for a setting or a"},{"type":"text","text":" "},{"type":"text","text":"file that must record which one it uses."}],"type":"paragraph"},{"text":"Arithmetic","anchor":"Arithmetic","level":2,"type":"heading"},{"inlineContent":[{"text":"A time plus or minus a duration is a time, the difference between two times is","type":"text"},{"type":"text","text":" "},{"type":"text","text":"a duration, and a duration can be added to, subtracted from, or scaled by a"},{"text":" ","type":"text"},{"code":"Number","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["let later = downbeat + triplet          \/\/ 4 1\/3","let gap   = later - downbeat            \/\/ 1\/3"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The operators require their results to stay non-negative: subtracting more","type":"text"},{"text":" ","type":"text"},{"text":"than there is, or scaling by a negative factor, stops execution. When that","type":"text"},{"text":" ","type":"text"},{"text":"could happen, use the checked forms instead — ","type":"text"},{"code":"adding(_:)","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"subtracting(_:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"multiplied(by:)","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"divided(by:)","type":"codeVoice"},{"text":" on durations — which","type":"text"},{"text":" ","type":"text"},{"text":"return ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"To move in either direction, pair a duration with a ","type":"text"},{"identifier":"doc:\/\/IvorTiming\/documentation\/IvorTiming\/TimeDirection","type":"reference","isActive":true},{"text":" in a","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/IvorTiming\/documentation\/IvorTiming\/DirectedDuration","type":"reference","isActive":true},{"text":". ","type":"text"},{"identifier":"doc:\/\/IvorTiming\/documentation\/IvorTiming\/BeatTime\/duration(to:)","type":"reference","isActive":true},{"text":" returns the directed duration","type":"text"},{"text":" ","type":"text"},{"text":"from one time to another, and ","type":"text"},{"identifier":"doc:\/\/IvorTiming\/documentation\/IvorTiming\/BeatTime\/moved(by:)","type":"reference","isActive":true},{"type":"text","text":" applies one:"}],"type":"paragraph"},{"syntax":"swift","code":["let back = downbeat.duration(to: 2)!    \/\/ 2 beats, backward","","downbeat.moved(by: back)                \/\/ 2"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"A zero duration must have the direction "},{"identifier":"doc:\/\/IvorTiming\/documentation\/IvorTiming\/TimeDirection\/same","type":"reference","isActive":true},{"type":"text","text":", and a nonzero"},{"text":" ","type":"text"},{"text":"one ","type":"text"},{"isActive":true,"identifier":"doc:\/\/IvorTiming\/documentation\/IvorTiming\/TimeDirection\/forward","type":"reference"},{"text":" or ","type":"text"},{"isActive":true,"identifier":"doc:\/\/IvorTiming\/documentation\/IvorTiming\/TimeDirection\/backward","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Tempo maps","level":2,"type":"heading","anchor":"Tempo-maps"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/IvorTiming\/documentation\/IvorTiming\/Tempo","type":"reference","isActive":true},{"text":" is a whole number of beats per minute, greater than zero.","type":"text"},{"text":" ","type":"text"},{"text":"A ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorTiming\/documentation\/IvorTiming\/TempoMap"},{"text":" is a list of entries, each a tempo that takes effect at a beat","type":"text"},{"text":" ","type":"text"},{"text":"time, sorted by beat time:","type":"text"}]},{"code":["var tempoMap = TempoMap()                \/\/ 60 BPM until it has entries","","tempoMap.insert(beatTime: 0, tempo: 120)","tempoMap.insert(beatTime: 8, tempo: 60)","","tempoMap[4]                             \/\/ 105"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Subscripting a tempo map with a beat time gives the tempo in effect there.","type":"text"},{"text":" ","type":"text"},{"text":"Before the first entry, that is the first entry’s tempo, and after the last,","type":"text"},{"text":" ","type":"text"},{"text":"the last one’s. Between two entries the tempo moves gradually from one to the","type":"text"},{"text":" ","type":"text"},{"text":"next, slowly at first and faster toward the second. An empty map gives its","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/IvorTiming\/documentation\/IvorTiming\/TempoMap\/defaultTempo","type":"reference","isActive":true},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Two entries at the same beat time with different tempos make an instant step.","type":"text"},{"text":" ","type":"text"},{"text":"An entry that exactly duplicates another — same beat time, tempo, and extras —","type":"text"},{"text":" ","type":"text"},{"text":"adds nothing, so inserting one is ignored.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Every entry has an ","type":"text"},{"identifier":"doc:\/\/IvorTiming\/documentation\/IvorTiming\/TempoMap\/EntryID","type":"reference","isActive":true},{"text":" that keeps naming it while the map","type":"text"},{"text":" ","type":"text"},{"text":"changes: ","type":"text"},{"identifier":"doc:\/\/IvorTiming\/documentation\/IvorTiming\/TempoMap\/insert(beatTime:tempo:extras:)","type":"reference","isActive":true},{"text":" returns it, and","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/IvorTiming\/documentation\/IvorTiming\/TempoMap\/update(entryID:tempo:extras:)","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/IvorTiming\/documentation\/IvorTiming\/TempoMap\/move(entryID:to:)","type":"reference","isActive":true},{"text":", and","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/IvorTiming\/documentation\/IvorTiming\/TempoMap\/remove(entryID:)","type":"reference","isActive":true},{"text":" take it. An entry ID lasts only as long as the map","type":"text"},{"text":" ","type":"text"},{"text":"is in memory: it is not encoded, so a decoded map has fresh ones. A tempo map is","type":"text"},{"text":" ","type":"text"},{"text":"also a collection of its entries, but a position is valid only until the next","type":"text"},{"text":" ","type":"text"},{"text":"change; to keep addressing an entry, use its ID. An entry can carry ","type":"text"},{"code":"Extras","type":"codeVoice"},{"text":" ","type":"text"},{"text":"(from ","type":"text"},{"identifier":"https:\/\/github.com\/eBardX\/XestiTools","type":"reference","isActive":true},{"text":") for data of your own.","type":"text"}]},{"level":2,"type":"heading","text":"Transforming a tempo map","anchor":"Transforming-a-tempo-map"},{"type":"paragraph","inlineContent":[{"text":"A tempo map can be transformed as a whole, or just the entries whose IDs you","type":"text"},{"text":" ","type":"text"},{"text":"pass:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/IvorTiming\/documentation\/IvorTiming\/TempoMap\/augment(by:anchor:entryIDs:)","type":"reference"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/IvorTiming\/documentation\/IvorTiming\/TempoMap\/diminish(by:anchor:entryIDs:)","type":"reference","isActive":true},{"type":"text","text":" stretch or compress entry beat"},{"type":"text","text":" "},{"type":"text","text":"times by a factor of at least 1, relative to an anchor beat time that"},{"type":"text","text":" "},{"type":"text","text":"defaults to the start of the entries."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorTiming\/documentation\/IvorTiming\/TempoMap\/move(by:entryIDs:)","isActive":true},{"type":"text","text":" shifts entry beat times by a directed"},{"type":"text","text":" "},{"type":"text","text":"duration."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/IvorTiming\/documentation\/IvorTiming\/TempoMap\/reverse(within:entryIDs:)","type":"reference"},{"type":"text","text":" mirrors entry beat times within a"},{"type":"text","text":" "},{"type":"text","text":"range."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/IvorTiming\/documentation\/IvorTiming\/TempoMap\/quantize(using:entryIDs:)","type":"reference"},{"type":"text","text":" snaps entry beat times to a"},{"type":"text","text":" "},{"type":"text","text":"quantizer’s grid."}],"type":"paragraph"}]}]},{"type":"codeListing","syntax":"swift","code":["try tempoMap.augment(by: 2)             \/\/ entries now at beats 0 and 16"]},{"type":"paragraph","inlineContent":[{"text":"The first four throw a ","type":"text"},{"identifier":"doc:\/\/IvorTiming\/documentation\/IvorTiming\/TempoMap\/Error","type":"reference","isActive":true},{"text":" if their arguments are invalid or an","type":"text"},{"text":" ","type":"text"},{"text":"entry would land outside the valid range; quantizing never fails.","type":"text"}]},{"level":2,"type":"heading","text":"Converting between beat time and wall time","anchor":"Converting-between-beat-time-and-wall-time"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/IvorTiming\/documentation\/IvorTiming\/TimeConverter","type":"reference","isActive":true},{"text":" takes a snapshot of a tempo map, so later changes to the","type":"text"},{"text":" ","type":"text"},{"text":"map do not affect it, and converts in either direction:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let converter = TimeConverter(tempoMap: tempoMap)","","converter.wallTime(at: 4)               \/\/ when beat 4 sounds","converter.beatTime(at: WallTime(doubleValue: 2)!)  \/\/ which beat sounds 2 seconds in"]},{"level":2,"type":"heading","text":"Quantizing","anchor":"Quantizing"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/IvorTiming\/documentation\/IvorTiming\/BeatQuantizer","type":"reference","isActive":true},{"text":" snaps a beat time to the nearest point on a rhythmic grid.","type":"text"},{"text":" ","type":"text"},{"text":"Each of its factors ","type":"text"},{"code":"n","type":"codeVoice"},{"text":" contributes a grid of ","type":"text"},{"code":"1\/n","type":"codeVoice"},{"text":"-beat subdivisions, and the","type":"text"},{"text":" ","type":"text"},{"text":"quantizer snaps to whichever point of any grid is nearest. Factors of 4 and 3","type":"text"},{"text":" ","type":"text"},{"text":"snap to sixteenth notes and eighth-note triplets alike:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let quantizer = try BeatQuantizer(factors: [4, 3])","","quantizer.quantize(BeatTime(plain: \"1.3\")!)     \/\/ 1 1\/3","quantizer.quantize(BeatTime(plain: \"1.26\")!)    \/\/ 1 1\/4","quantizer.gridUnit                              \/\/ 1\/12"]},{"level":2,"type":"heading","text":"Error handling","anchor":"Error-handling"},{"type":"paragraph","inlineContent":[{"text":"Thrown errors conform to ","type":"text"},{"code":"EnhancedError","type":"codeVoice"},{"text":" (from","type":"text"},{"text":" ","type":"text"},{"overridingTitle":"XestiTools","overridingTitleInlineContent":[{"text":"XestiTools","type":"text"}],"identifier":"https:\/\/github.com\/eBardX\/XestiTools","type":"reference","isActive":true},{"text":"): each has a ","type":"text"},{"code":"category","type":"codeVoice"},{"text":" of","type":"text"},{"text":" ","type":"text"},{"code":"\"IvorTiming\"","type":"codeVoice"},{"text":" and a human-readable ","type":"text"},{"code":"message","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"text":"Type","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Thrown by","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorTiming\/documentation\/IvorTiming\/BeatQuantizer\/Error"}],"type":"paragraph"}],[{"inlineContent":[{"code":"BeatQuantizer.init(factors:)","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorTiming\/documentation\/IvorTiming\/TempoMap\/Error"}],"type":"paragraph"}],[{"inlineContent":[{"code":"augment(by:anchor:entryIDs:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"diminish(by:anchor:entryIDs:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"move(by:entryIDs:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"reverse(within:entryIDs:)","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorTiming\/documentation\/IvorTiming\/ParseError"}],"type":"paragraph"}],[{"inlineContent":[{"code":"TimeBasis.init(stringValue:)","type":"codeVoice"}],"type":"paragraph"}]]],"alignments":["left","left"]},{"type":"paragraph","inlineContent":[{"text":"The failable initializers return ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" rather than throwing, and the arithmetic","type":"text"},{"text":" ","type":"text"},{"text":"operators stop execution on a result that would be negative; see","type":"text"},{"text":" ","type":"text"},{"identifier":"#Arithmetic","isActive":true,"type":"reference"},{"text":".","type":"text"}]},{"level":2,"type":"heading","text":"Concurrency","anchor":"Concurrency"},{"type":"paragraph","inlineContent":[{"text":"IvorTiming is built for Swift 6 strict concurrency. Every public type is a","type":"text"},{"text":" ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":" value type, so instances can be freely shared across tasks and actor","type":"text"},{"text":" ","type":"text"},{"text":"boundaries.","type":"text"}]}],"kind":"content"}],"references":{"doc://IvorTiming/documentation/IvorTiming/DirectedDuration":{"navigatorTitle":[{"text":"DirectedDuration","kind":"identifier"}],"kind":"symbol","title":"DirectedDuration","url":"\/documentation\/ivortiming\/directedduration","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedDuration","kind":"identifier"}],"identifier":"doc:\/\/IvorTiming\/documentation\/IvorTiming\/DirectedDuration","type":"topic","abstract":[{"text":"A duration paired with a direction of movement.","type":"text"}],"role":"symbol"},"doc://IvorTiming/documentation/IvorTiming/BeatTime/init(plain:)":{"url":"\/documentation\/ivortiming\/beattime\/init(plain:)","type":"topic","title":"init(plain:)","kind":"symbol","abstract":[{"type":"text","text":"Creates a beat time by parsing its plain string representation, returning "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" if the"},{"type":"text","text":" "},{"type":"text","text":"string cannot be parsed or is out of range."}],"role":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"?(","kind":"text"},{"text":"plain","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":")","kind":"text"}],"identifier":"doc:\/\/IvorTiming\/documentation\/IvorTiming\/BeatTime\/init(plain:)"},"doc://IvorTiming/documentation/IvorTiming/TempoMap/quantize(using:entryIDs:)":{"kind":"symbol","role":"symbol","url":"\/documentation\/ivortiming\/tempomap\/quantize(using:entryids:)","type":"topic","title":"quantize(using:entryIDs:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"quantize","kind":"identifier"},{"text":"(","kind":"text"},{"text":"using","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:10IvorTiming13BeatQuantizerV","text":"BeatQuantizer","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"entryIDs","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sh","text":"Set","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:10IvorTiming8TempoMapV7EntryIDV","text":"EntryID","kind":"typeIdentifier"},{"text":">?)","kind":"text"}],"abstract":[{"type":"text","text":"Quantizes entry beat times to the nearest grid point defined by "},{"type":"codeVoice","code":"quantizer"},{"type":"text","text":"."}],"identifier":