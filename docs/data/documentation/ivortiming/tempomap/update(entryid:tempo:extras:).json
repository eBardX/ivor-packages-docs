ext"},{"text":" ","type":"text"},{"text":"keeps the entry’s identity and does not reorder entries. Reordering only matters when more","type":"text"},{"text":" ","type":"text"},{"text":"than one entry shares a beat time: insertion always lands after every entry already at that","type":"text"},{"text":" ","type":"text"},{"text":"beat time, so a remove-then-insert edit of one entry among ties silently changes the order of","type":"text"},{"text":" ","type":"text"},{"text":"entries that were never touched. And — unlike a position — the identity keeps addressing","type":"text"},{"text":" ","type":"text"},{"text":"this same entry across any other entry’s edit, so a caller never needs to re-resolve it","type":"text"},{"text":" ","type":"text"},{"text":"first.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The edit can turn this entry into an exact duplicate of another one","type":"text"},{"text":" ","type":"text"},{"text":"already at the same beat time — same beat time, tempo, and extras —","type":"text"},{"text":" ","type":"text"},{"text":"the same combination ","type":"text"},{"identifier":"doc:\/\/IvorTiming\/documentation\/IvorTiming\/TempoMap\/insert(beatTime:tempo:extras:)","type":"reference","isActive":true},{"text":" silently","type":"text"},{"text":" ","type":"text"},{"text":"collapses. When that happens, ","type":"text"},{"code":"entryID","type":"codeVoice"},{"text":" always keeps addressing the","type":"text"},{"text":" ","type":"text"},{"text":"entry that was just updated; the ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"other","type":"text"}]},{"text":", pre-existing entry is the","type":"text"},{"text":" ","type":"text"},{"text":"one silently removed instead. That is the only choice consistent","type":"text"},{"text":" ","type":"text"},{"text":"with the guarantee above: a caller invoking this method already","type":"text"},{"text":" ","type":"text"},{"text":"holds ","type":"text"},{"code":"entryID","type":"codeVoice"},{"text":" and goes on using it afterward, so honoring “this","type":"text"},{"text":" ","type":"text"},{"text":"identity keeps addressing this same entry” means the entry it","type":"text"},{"text":" ","type":"text"},{"text":"wasn’t referencing has to be the one that gives way, never the one","type":"text"},{"text":" ","type":"text"},{"text":"it was.","type":"text"}]}]}],"references":{"doc://IvorTiming/documentation/IvorTiming/Tempo":{"url":"\/documentation\/ivortiming\/tempo","title":"Tempo","navigatorTitle":[{"text":"Tempo","kind":"identifier"}],"abstract":[{"text":"A tempo in beats per minute, represented as a positive unsigned integer.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Tempo","kind":"identifier"}],"type":"topic","role":"symbol","kind":"symbol","identifier":"doc:\/\/IvorTiming\/documentation\/IvorTiming\/Tempo"},"doc://IvorTiming/documentation/IvorTiming/TempoMap/insert(beatTime:tempo:extras:)":{"url":"\/documentation\/ivortiming\/tempomap\/insert(beattime:tempo:extras:)","type":"topic","title":"insert(beatTime:tempo:extras:)","kind":"symbol","abstract":[{"type":"text","text":"Inserts a tempo entry into this tempo map at the given beat time."}],"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"insert","kind":"identifier"},{"text":"(","kind":"text"},{"text":"beatTime","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:10IvorTiming8BeatTimeV","text":"BeatTime","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"tempo","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:10IvorTiming5TempoV","text":"Tempo","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"extras","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:10XestiTools6ExtrasV","text":"Extras","kind":"typeIdentifier"},{"text":"?) -> (entryID","kind":"text"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:1