type":"text","text":" if "},{"type":"codeVoice","code":"entryID"},{"type":"text","text":" identified an"},{"type":"text","text":" "},{"type":"text","text":"entry and it was updated, "},{"type":"codeVoice","code":"false"},{"type":"text","text":" if "},{"type":"codeVoice","code":"entryID"},{"type":"text","text":" named no"},{"type":"text","text":" "},{"type":"text","text":"entry and nothing happened — and "},{"type":"codeVoice","code":"removedEntryID"},{"type":"text","text":", the"},{"type":"text","text":" "},{"type":"text","text":"identity of the pre-existing entry dropped because the"},{"type":"text","text":" "},{"text":"edit collapsed into it (see above). ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" if ","type":"text"},{"code":"updated","type":"codeVoice"},{"text":" ","type":"text"},{"text":"is ","type":"text"},{"code":"false","type":"codeVoice"},{"text":", or if it is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" but no such collision","type":"text"},{"text":" ","type":"text"},{"text":"occurred.","type":"text"}]}]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"Unlike a ","type":"text"},{"identifier":"doc:\/\/IvorTiming\/documentation\/IvorTiming\/TempoMap\/remove(entryID:)","isActive":true,"type":"reference"},{"text":" followed by an ","type":"text"},{"identifier":"doc:\/\/IvorTiming\/documentation\/IvorTiming\/TempoMap\/insert(beatTime:tempo:extras:)","isActive":true,"type":"reference"},{"text":", this","type":"text"},{"text":" ","type":"text"},{"text":"keeps the entry’s identity and does not reorder entries. Reordering only matters when more","type":"text"},{"text":" ","type":"text"},{"text":"than one entry shares a beat time: insertion always lands after every entry already at that","type":"text"},{"text":" ","type":"text"},{"text":"beat time, so a remove-then-insert edit of one entry among ties silently changes the order of","type":"text"},{"text":" ","type":"text"},{"text":"entries that were never touched. And — unlike a position — the identity keeps addressing","type":"text"},{"text":" ","type":"text"},{"text":"this same entry across any other entry’s edit, so a caller never needs to re-resolve it","type":"text"},{"text":" ","type":"text"},{"text":"first.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The edit can turn this entry into an exact duplicate of another one","type":"text"},{"text":" ","type":"text"},{"text":"already at the same beat time — same beat time, tempo, and extras —","type":"text"},{"text":" ","type":"text"},{"text":"the same combination ","type":"text"},{"identifier":"doc:\/\/IvorTiming\/documentation\/IvorTiming\/TempoMap\/insert(beatTime:tempo:extras:)","isActive":true,"type":"reference"},{"text":" silently","type":"text"},{"text":" ","type":"text"},{"text":"collapses. When that happens, ","type":"text"},{"code":"entryID","type":"codeVoice"},{"text":" always keeps addressing the","type":"text"},{"text":" ","type":"text"},{"text":"entry that was just updated; the ","type":"text"},{"inlineContent":[{"text":"other","type":"text"}],"type":"emphasis"},{"text":", pre-existing entry is the","type":"text"},{"text":" ","type":"text"},{"text":"one silently removed instead. That is the only choice consistent","type":"text"},{"text":" ","type":"text"},{"text":"with the guarantee above: a caller invoking this method already","type":"text"},{"text":" ","type":"text"},{"text":"holds ","type":"text"},{"code":"entryID","type":"codeVoice"},{"text":" and goes on using it afterward, so honoring “this","type":"text"},{"text":" ","type":"text"},{"text":"identity keeps addressing this same entry” means the entry it","type":"text"},{"text":" ","type":"text"},{"text":"wasn’t referencing has to be the one that gives way, never the one","type":"text"},{"text":" ","type":"text"},{"text":"it was.","type":"text"}]}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/IvorTiming\/docu