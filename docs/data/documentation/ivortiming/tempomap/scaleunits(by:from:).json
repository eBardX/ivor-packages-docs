{"kind":"symbol","schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"hierarchy":{"paths":[["doc:\/\/IvorTiming\/documentation\/IvorTiming","doc:\/\/IvorTiming\/documentation\/IvorTiming\/TempoMap"]]},"identifier":{"url":"doc:\/\/IvorTiming\/documentation\/IvorTiming\/TempoMap\/scaleUnits(by:from:)","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/ivortiming\/tempomap\/scaleunits(by:from:)"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"modules":[{"name":"IvorTiming"}],"externalID":"s:10IvorTiming8TempoMapV10scaleUnits2by4fromy12XestiNumbers6NumberV_AA8BeatTimeVtF","extendedModule":"IvorTiming","roleHeading":"Instance Method","title":"scaleUnits(by:from:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"scaleUnits"},{"kind":"text","text":"("},{"kind":"externalParam","text":"by"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:12XestiNumbers6NumberV","text":"Number"},{"kind":"text","text":", "},{"kind":"externalParam","text":"from"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:10IvorTiming8BeatTimeV","text":"BeatTime"},{"kind":"text","text":")"}],"symbolKind":"method","role":"symbol"},"abstract":[{"type":"text","text":"Multiplies the unit of every tempo from a beat time onward by a factor, keeping each rate."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"mutating"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"scaleUnits"},{"kind":"text","text":"("},{"kind":"externalParam","text":"by"},{"kind":"text","text":" "},{"kind":"internalParam","text":"factor"},{"kind":"text","text":": "},{"preciseIdentifier":"s:12XestiNumbers6NumberV","kind":"typeIdentifier","text":"Number"},{"kind":"text","text":", "},{"text":"from","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"anchor","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"BeatTime","kind":"typeIdentifier","identifier":"doc:\/\/IvorTiming\/documentation\/IvorTiming\/BeatTime","preciseIdentifier":"s:10IvorTiming8BeatTimeV"},{"text":")","kind":"text"}],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"name":"factor","content":[{"inlineContent":[{"text":"The factor to multiply each unit by.","type":"text"}],"type":"paragraph"}]},{"name":"anchor","content":[{"inlineContent":[{"type":"text","text":"The beat time from which units are scaled."}],"type":"paragraph"}]}]},{"mentions":["doc:\/\/IvorTiming\/documentation\/IvorTiming\/UsingIvorTiming"],"kind":"mentions"},{"kind":"content","content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"Use this after augmenting or diminishing the music from ","type":"text"},{"code":"anchor","type":"codeVoice"},{"text":" by ","type":"text"},{"code":"factor","type":"codeVoice"},{"text":", to keep its","type":"text"},{"text":" ","type":"text"},{"text":"sound: each tempo keeps its rate, and its speed in whole notes per minute scales with the","type":"text"},{"text":" ","type":"text"},{"text":"music. For example, ♪ = 240 becomes ♩ = 240 when the music is augmented by 2.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Nothing before ","type":"text"},{"code":"anchor","type":"codeVoice"},{"text":" changes speed. Unless ","type":"text"},{"code":"anchor","type":"codeVoice"},{"text":" is zero, an unscaled entry is first","type":"text"},{"text":" ","type":"text"},{"text":"inserted at ","type":"text"},{"code":"anchor","type":"codeVoice"},{"text":", holding the tempo the music reaches there (the end of any ramp that","type":"text"},{"text":" ","type":"text"},{"text":"runs into it). It comes before any entry already at ","type":"text"},{"type":"codeVoice","code":"anchor"},{"text":", so the speed steps there.","type":"text"},{"text":" ","type":"text"},{"text":"Then every other entry at or after ","type":"text"},{"type":"codeVoice","code":"anchor"},{"text":" has its unit scaled. If no entry was at","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"anchor"},{"text":", a scaled entry holding the tempo in effect there is inserted as well. That","type":"text"},{"text":" ","type":"text"},{"text":"includes ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorTiming\/documentation\/IvorTiming\/TempoMap\/defaultTempo"},{"text":", when this tempo map is empty.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Inserting an entry inside a ramp splits it. The first part keeps its exact shape; the","type":"text"},{"text":" ","type":"text"},{"text":"second becomes a fresh ease-in from the speed at ","type":"text"},{"code":"anchor","type":"codeVoice"},{"text":" to the ramp’s end, which is","type":"text"},{"text":" ","type":"text"},{"text":"close to the original but not identical.","type":"text"}],"type":"paragraph"},{"style":"note","name":"Precondition","content":[{"inlineContent":[{"text":"","type":"text"},{"code":"factor","type":"codeVoice"},{"text":" is a positive rational number.","type":"text"}],"type":"paragraph"}],"type":"aside"}]}],"references":{"doc://IvorTiming/documentation/IvorTiming/BeatTime":{"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"BeatTime"}],"role":"symbol","title":"BeatTime","type":"topic","url":"\/documentation\/ivortiming\/beattime","navigatorTitle":[{"kind":"identifier","text":"BeatTime"}],"identifier":"doc:\/\/IvorTiming\/documentation\/IvorTiming\/BeatTime","abstract":[{"type":"text","text":"A point in musical beat time, measured in whole notes from time zero."}]},"doc://IvorTiming/documentation/IvorTiming/TempoMap/scaleUnits(by:from:)":{"url":"\/documentation\/ivortiming\/tempomap\/scaleunits(by:from:)","kind":"symbol","title":"scaleUnits(by:from:)","fragments":[{"text":"func","kind":"keyword