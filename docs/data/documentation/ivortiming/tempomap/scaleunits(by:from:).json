xt":"Tempo"}],"abstract":[{"text":"The tempo used when this tempo map contains no entries.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/IvorTiming\/documentation\/IvorTiming\/TempoMap\/defaultTempo","url":"\/documentation\/ivortiming\/tempomap\/defaulttempo"},"doc://IvorTiming/documentation/IvorTiming":{"url":"\/documentation\/ivortiming","identifier":"doc:\/\/IvorTiming\/documentation\/IvorTiming","kind":"symbol","title":"IvorTiming","abstract":[{"text":"Musical time, duration, and tempo types.","type":"text"}],"role":"collection","type":"topic"}}}