{"variants":[{"paths":["\/documentation\/ivorsmpte\/usingivorsmpte"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"roleHeading":"Article","modules":[{"name":"IvorSMPTE"}],"role":"article","title":"Using IvorSMPTE"},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"type":"text","text":"IvorSMPTE has four types:"}],"type":"paragraph"},{"rows":[[[{"inlineContent":[{"text":"Type","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Represents","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTEFrameRate","type":"reference","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"text":"One of the 12 standard SMPTE frame rates","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTETime","type":"reference","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"text":"A timecode at a frame rate, to the hundredth of a frame","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTEExactSeconds","type":"reference","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"text":"An exact, non-negative number of seconds","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTETimeConverter","type":"reference","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"text":"A fixed mapping between seconds and timecode","type":"text"}],"type":"paragraph"}]]],"header":"row","alignments":["left","left"],"type":"table"},{"inlineContent":[{"type":"text","text":"Every time in IvorSMPTE is exact. The NTSC-derived frame rates are rational"},{"type":"text","text":" "},{"type":"text","text":"numbers (29.97 frames per second is exactly 30000\/1001), and seconds are kept"},{"type":"text","text":" "},{"type":"text","text":"as rational numbers too, so converting a timecode to seconds and back never"},{"type":"text","text":" "},{"type":"text","text":"drifts."}],"type":"paragraph"},{"text":"Frame rates","anchor":"Frame-rates","type":"heading","level":2},{"inlineContent":[{"identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTEFrameRate","type":"reference","isActive":true},{"type":"text","text":" has a case for each standard rate. The NTSC-derived rates —"},{"type":"text","text":" "},{"type":"text","text":"23.976, 29.97, and 59.94 — run at 1000\/1001 of their nominal rate, and 29.97,"},{"type":"text","text":" "},{"type":"text","text":"30, 59.94, and 60 each come in a non-drop-frame and a drop-frame form:"}],"type":"paragraph"},{"code":["let rate = SMPTEFrameRate.fps2997Drop","","rate.isDropFrame    \/\/ true","rate.uintValue      \/\/ 30, the nominal rate: frame numbers per second","rate.numberValue    \/\/ 30000\/1001, the exact rate","rate.description    \/\/ \"29.97DF\"","","SMPTEFrameRate(string: \"23.98\")     \/\/ .fps23976"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Drop-frame timecode skips frame numbers — 0 and 1 at 29.97 and 30 frames per"},{"type":"text","text":" "},{"type":"text","text":"second, 0 through 3 at 59.94 and 60 — at the start of every minute except"},{"type":"text","text":" "},{"type":"text","text":"minutes 0, 10, 20, 30, 40, and 50. At 29.97 and 59.94 frames per second this"},{"type":"text","text":" "},{"type":"text","text":"keeps timecode in step with real time. The 30 and 60 frames per second"},{"type":"text","text":" "},{"type":"text","text":"drop-frame rates run at a true 30 or 60, so their timecode does not; they are"},{"type":"text","text":" "},{"type":"text","text":"typically used for material that is pulled down to 29.97 or 59.94 drop-frame."}],"type":"paragraph"},{"inlineContent":[{"identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTEFrameRate\/framesPerDay","type":"reference","isActive":true},{"type":"text","text":" gives the number of frames in 24 hours of"},{"type":"text","text":" "},{"type":"text","text":"timecode, which accounts for the skipped frame numbers."}],"type":"paragraph"},{"text":"Timecodes","anchor":"Timecodes","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"An "},{"identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTETime","type":"reference","isActive":true},{"type":"text","text":" is a frame rate together with hour, minute, second, frame, and"},{"type":"text","text":" "},{"type":"text","text":"subframe (hundredths of a frame) components. It can be made in four ways:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"From its components, with"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTETime\/init(frameRate:hour:minute:second:frame:subframe:)","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"From its "},{"type":"codeVoice","code":"HH:MM:SS:FF"},{"type":"text","text":" string, with "},{"type":"reference","identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTETime\/init(string:frameRate:)","isActive":true},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"At drop-frame rates the separator before the frame number may be "},{"type":"codeVoice","code":";"},{"type":"text","text":" or "},{"type":"codeVoice","code":":"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"and the string may end with a period and a two-digit subframe, as in"},{"type":"text","text":" "},{"type":"codeVoice","code":"01:00:03;12.50"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"From a number of frames since midnight, with"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTETime\/init(frameRate:frameCount:subframe:)","isActive":true},{"type":"text","text":". At drop-frame rates the"},{"type":"text","text":" "},{"type":"text","text":"frames are numbered with drop-frame timecode."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"From an exact number of seconds since midnight, with"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTETime\/init(frameRate:elapsedSeconds:)","isActive":true},{"type":"text","text":", which rounds to the nearest"},{"type":"text","text":" "},{"type":"text","text":"hundredth of a frame and wraps around after 24 hours."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"The first three are failable, returning "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" for any component out of range,"},{"type":"text","text":" "},{"type":"text","text":"including a frame number that drop-frame timecode skips. The last never fails."}],"type":"paragraph"},{"code":["let time = SMPTETime(frameRate: .fps2997Drop,","                     frameCount: 1800,","                     subframe: 0)","","time?.description   \/\/ \"00:01:00;02\"","time?.frameCount    \/\/ 1800"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"A timecode’s "},{"identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTETime\/description","type":"reference","isActive":true},{"type":"text","text":" is its "},{"code":"HH:MM:SS:FF","type":"codeVoice"},{"type":"text","text":" string, with "},{"code":";","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"before the frame number at drop-frame rates and a subframe suffix if it is not"},{"type":"text","text":" "},{"type":"text","text":"zero."}],"type":"paragraph"},{"text":"Exact seconds","anchor":"Exact-seconds","type":"heading","level":2},{"inlineContent":[{"identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTETime\/elapsedSeconds","type":"reference","isActive":true},{"type":"text","text":" gives a timecode’s exact time since midnight as an"},{"type":"text","text":" "},{"identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTEExactSeconds","type":"reference","isActive":true},{"type":"text","text":", which holds a rational "},{"code":"Number","type":"codeVoice"},{"type":"text","text":" from"},{"type":"text","text":" "},{"identifier":"https:\/\/github.com\/eBardX\/XestiNumbers","type":"reference","isActive":true},{"type":"text","text":". An"},{"type":"text","text":" "},{"identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTEExactSeconds","type":"reference","isActive":true},{"type":"text","text":" can be written as an integer, floating-point, or string"},{"type":"text","text":" "},{"type":"text","text":"literal, or made from a "},{"code":"Number","type":"codeVoice"},{"type":"text","text":"; "},{"identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTEExactSeconds\/init(numberValue:)","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"returns "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" for a negative or non-finite number."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A floating-point value is converted to the exact rational value it represents,"},{"type":"text","text":" "},{"type":"text","text":"which is not always the decimal it looks like: "},{"code":"0.1","type":"codeVoice"},{"type":"text","text":" is not exactly one tenth."},{"type":"text","text":" "},{"type":"text","text":"To write a decimal fraction exactly, use "},{"code":"Number(numerator:denominator:)","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Changing frame rate","anchor":"Changing-frame-rate","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"There are two ways to move a timecode to another frame rate, and they answer"},{"type":"text","text":" "},{"type":"text","text":"different questions:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Converting through seconds keeps the "},{"inlineContent":[{"type":"text","text":"moment"}],"type":"strong"},{"type":"text","text":": make a new "},{"type":"reference","identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTETime","isActive":true},{"type":"text","text":" "},{"type":"text","text":"from the old one’s "},{"type":"reference","identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTETime\/elapsedSeconds","isActive":true},{"type":"text","text":" at the new rate."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTETime\/retimed(to:)","isActive":true},{"type":"text","text":" keeps the "},{"inlineContent":[{"type":"text","text":"label"}],"type":"strong"},{"type":"text","text":": 01:00:00:00 at 25 frames per"},{"type":"text","text":" "},{"type":"text","text":"second becomes 01:00:00:00 at any other rate. The frame number is clamped to"},{"type":"text","text":" "},{"type":"text","text":"the new rate’s last frame, and at a drop-frame rate a skipped frame number"},{"type":"text","text":" "},{"type":"text","text":"becomes the first one kept, so 00:01:00:00 at 30 frames per second becomes"},{"type":"text","text":" "},{"type":"text","text":"00:01:00;02 at 29.97 drop-frame."}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Timecode conversion","anchor":"Timecode-conversion","type":"heading","level":2},{"inlineContent":[{"text":"An ","type":"text"},{"type":"reference","identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTETimeConverter","isActive":true},{"text":" labels a timeline measured in seconds — the wall","type":"text"},{"text":" ","type":"text"},{"text":"time of a performance, say — with timecode that starts at a chosen timecode.","type":"text"},{"text":" ","type":"text"},{"text":"Its frame rate is the start timecode’s:","type":"text"}],"type":"paragraph"},{"code":["let start     = SMPTETime(string: \"01:00:00:00\", frameRate: .fps25)!","let converter = SMPTETimeConverter(startTime: start)","","converter.smpteTime(at: 90)     \/\/ 01:01:30:00","","let earlier = SMPTETime(string: \"00:59:00:00\", frameRate: .fps25)!","","converter.seconds(at: earlier)  \/\/ 86340: the next day"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Because timecode wraps around after 24 hours, a timecode earlier than the start"},{"type":"text","text":" "},{"type":"text","text":"timecode is taken to fall on the following day, so"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTETimeConverter\/seconds(at:)","isActive":true},{"text":" always returns at least zero and less than","type":"text"},{"type":"text","text":" "},{"text":"one day. The timecode it is given must be at the converter’s","type":"text"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTETimeConverter\/frameRate","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Error handling","anchor":"Error-handling","type":"heading","level":2},{"inlineContent":[{"text":"IvorSMPTE throws no errors. Every conversion that can fail returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" ","type":"text"},{"type":"text","text":"instead: the failable "},{"identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTETime","type":"reference","isActive":true},{"text":" and ","type":"text"},{"identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTEExactSeconds","type":"reference","isActive":true},{"type":"text","text":" initializers, and"},{"type":"text","text":" "},{"identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTEFrameRate\/init(string:)","type":"reference","isActive":true},{"type":"text","text":". Passing "},{"identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTETimeConverter\/seconds(at:)","isActive":true,"type":"reference"},{"type":"text","text":" a"},{"type":"text","text":" "},{"type":"text","text":"timecode at a different frame rate from the converter’s is a programming error,"},{"type":"text","text":" "},{"type":"text","text":"and stops execution."}],"type":"paragraph"},{"anchor":"Concurrency","type":"heading","level":2,"text":"Concurrency"},{"inlineContent":[{"text":"IvorSMPTE is built for Swift 6 strict concurrency. Every public type is a","type":"text"},{"text":" ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":" value type, so instances can be freely shared across tasks and actor","type":"text"},{"type":"text","text":" "},{"type":"text","text":"boundaries."}],"type":"paragraph"}]}],"abstract":[{"type":"text","text":"Represent SMPTE timecode at any standard frame rate, and convert it to and from"},{"type":"text","text":" "},{"type":"text","text":"an exact number of seconds."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/UsingIvorSMPTE"},"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"article","hierarchy":{"paths":[["doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE"]]},"references":{"https://github.com/eBardX/XestiNumbers":{"titleInlineContent":[{"text":"XestiNumbers","type":"text"}],"identifier":"https:\/\/github.com\/eBardX\/XestiNumbers","type":"link","title":"XestiNumbers","url":"https:\/\/github.com\/eBardX\/XestiNumbers"},"doc://IvorSMPTE/documentation/IvorSMPTE/SMPTETime/init(frameRate:frameCount:subframe:)":{"kind":"symbol","title":"init(frameRate:frameCount:subframe:)","role":"symbol","identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTETime\/init(frameRate:frameCount:subframe:)","abstract":[{"type":"text","text":"Creates a new "},{"type":"codeVoice","code":"SMPTETime"},{"type":"text","text":" instance from a number of frames since"},{"type":"text","text":" "},{"type":"text","text":"midnight (00:00:00:00), or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" if the frame count or subframe is out"},{"type":"text","text":" "},{"type":"text","text":"of range for the given frame rate."}],"url":"\/documentation\/ivorsmpte\/smptetime\/init(framerate:framecount:subframe:)","type":"topic","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"?("},{"kind":"externalParam","text":"frameRate"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"SMPTEFrameRate","preciseIdentifier":"s:9IvorSMPTE14SMPTEFrameRateO"},{"kind":"text","text":", "},{"kind":"externalParam","text":"frameCount"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"UInt","preciseIdentifier":"s:Su"},{"kind":"text","text":", "},{"kind":"externalParam","text":"subframe"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"UInt","preciseIdentifier":"s:Su"},{"kind":"text","text":")"}]},"doc://IvorSMPTE/documentation/IvorSMPTE/SMPTETimeConverter/seconds(at:)":{"title":"seconds(at:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"seconds","kind":"identifier"},{"text":"(","kind":"text"},{"text":"at","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:9IvorSMPTE9SMPTETimeV","text":"SMPTETime","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:9IvorSMPTE17SMPTEExactSecondsV","text":"SMPTEExactSeconds"}],"role":"symbol","type":"topic","kind":"symbol","url":"\/documentation\/ivorsmpte\/smptetimeconverter\/seconds(at:)","identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTETimeConverter\/seconds(at:)","abstract":[{"type":"text","text":"Returns the exact number of seconds from the start timecode to the"},{"type":"text","text":" "},{"type":"text","text":"given timecode."}]},"doc://IvorSMPTE/documentation/IvorSMPTE":{"url":"\/documentation\/ivorsmpte","abstract":[{"text":"SMPTE timecode, frame rate, and timecode conversion types.","type":"text"}],"kind":"symbol","title":"IvorSMPTE","role":"collection","identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE","type":"topic"},"doc://IvorSMPTE/documentation/IvorSMPTE/SMPTEFrameRate/init(string:)":{"kind":"symbol","title":"init(string:)","role":"symbol","identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTEFrameRate\/init(string:)","abstract":[{"type":"text","text":"Creates a new "},{"code":"SMPTEFrameRate","type":"codeVoice"},{"type":"text","text":" instance by parsing its string"},{"type":"text","text":" "},{"type":"text","text":"representation, or "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" if the string does not name a frame rate."}],"type":"topic","url":"\/documentation\/ivorsmpte\/smpteframerate\/init(string:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"?("},{"kind":"externalParam","text":"string"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":")"}]},"doc://IvorSMPTE/documentation/IvorSMPTE/SMPTEExactSeconds":{"kind":"symbol","title":"SMPTEExactSeconds","role":"symbol","abstract":[{"type":"text","text":"An exact, non-negative number of seconds."}],"identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTEExactSeconds","type":"topic","url":"\/documentation\/ivorsmpte\/smpteexactseconds","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SMPTEExactSeconds"}],"navigatorTitle":[{"kind":"identifier","text":"SMPTEExactSeconds"}]},"doc://IvorSMPTE/documentation/IvorSMPTE/SMPTEFrameRate/framesPerDay":{"kind":"symbol","title":"framesPerDay","role":"symbol","identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTEFrameRate\/framesPerDay","abstract":[{"type":"text","text":"The number of frames in one day (24 hours) of timecode at this frame"},{"type":"text","text":" "},{"type":"text","text":"rate."}],"url":"\/documentation\/ivorsmpte\/smpteframerate\/framesperday","type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"framesPerDay"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"UInt","preciseIdentifier":"s:Su"}]},"doc://IvorSMPTE/documentation/IvorSMPTE/SMPTETimeConverter":{"kind":"symbol","title":"SMPTETimeConverter","role":"symbol","identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTETimeConverter","abstract":[{"type":"text","text":"A type that converts between SMPTE timecode and an exact number of seconds"},{"text":" ","type":"text"},{"text":"from a starting timecode.","type":"text"}],"type":"topic","url":"\/documentation\/ivorsmpte\/smptetimeconverter","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SMPTETimeConverter","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"SMPTETimeConverter"}]},"doc://IvorSMPTE/documentation/IvorSMPTE/SMPTETime":{"title":"SMPTETime","navigatorTitle":[{"kind":"identifier","text":"SMPTETime"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SMPTETime"}],"role":"symbol","type":"topic","kind":"symbol","url":"\/documentation\/ivorsmpte\/smptetime","identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTETime","abstract":[{"type":"text","text":"A SMPTE timecode value specifying a point in time."}]},"doc://IvorSMPTE/documentation/IvorSMPTE/SMPTETimeConverter/frameRate":{"title":"frameRate","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"frameRate"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:9IvorSMPTE14SMPTEFrameRateO","text":"SMPTEFrameRate"}],"role":"symbol","type":"topic","kind":"symbol","url":"\/documentation\/ivorsmpte\/smptetimeconverter\/framerate","identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTETimeConverter\/frameRate","abstract":[{"type":"text","text":"The SMPTE frame rate of the timecodes this converter produces."