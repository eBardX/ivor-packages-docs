{"primaryContentSections":[{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"inlineContent":[{"text":"IvorSMPTE has four types:","type":"text"}],"type":"paragraph"},{"header":"row","alignments":["left","left"],"rows":[[[{"inlineContent":[{"type":"text","text":"Type"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Represents","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTEFrameRate","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"text":"One of the 12 standard SMPTE frame rates","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTETime","type":"reference"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"A timecode at a frame rate, to the hundredth of a frame","type":"text"}]}]],[[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTEExactSeconds","type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"An exact, non-negative number of seconds"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTETimeConverter","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"A fixed mapping between seconds and timecode"}],"type":"paragraph"}]]],"type":"table"},{"inlineContent":[{"text":"Every time in IvorSMPTE is exact. The NTSC-derived frame rates are rational","type":"text"},{"text":" ","type":"text"},{"text":"numbers (29.97 frames per second is exactly 30000\/1001), and seconds are kept","type":"text"},{"text":" ","type":"text"},{"text":"as rational numbers too, so converting a timecode to seconds and back never","type":"text"},{"text":" ","type":"text"},{"text":"drifts.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Frame rates","type":"heading","anchor":"Frame-rates"},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTEFrameRate","type":"reference"},{"text":" has a case for each standard rate. The NTSC-derived rates —","type":"text"},{"text":" ","type":"text"},{"text":"23.976, 29.97, and 59.94 — run at 1000\/1001 of their nominal rate, and 29.97,","type":"text"},{"text":" ","type":"text"},{"text":"30, 59.94, and 60 each come in a non-drop-frame and a drop-frame form:","type":"text"}],"type":"paragraph"},{"code":["let rate = SMPTEFrameRate.fps2997Drop","","rate.isDropFrame    \/\/ true","rate.uintValue      \/\/ 30, the nominal rate: frame numbers per second","rate.numberValue    \/\/ 30000\/1001, the exact rate","rate.description    \/\/ \"29.97DF\"","","SMPTEFrameRate(string: \"23.98\")     \/\/ .fps23976"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Drop-frame timecode skips frame numbers — 0 and 1 at 29.97 and 30 frames per","type":"text"},{"text":" ","type":"text"},{"text":"second, 0 through 3 at 59.94 and 60 — at the start of every minute except","type":"text"},{"text":" ","type":"text"},{"text":"minutes 0, 10, 20, 30, 40, and 50. At 29.97 and 59.94 frames per second this","type":"text"},{"text":" ","type":"text"},{"text":"keeps timecode in step with real time. The 30 and 60 frames per second","type":"text"},{"text":" ","type":"text"},{"text":"drop-frame rates run at a true 30 or 60, so their timecode does not; they are","type":"text"},{"text":" ","type":"text"},{"text":"typically used for material that is pulled down to 29.97 or 59.94 drop-frame.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTEFrameRate\/framesPerDay","type":"reference"},{"text":" gives the number of frames in 24 hours of","type":"text"},{"text":" ","type":"text"},{"text":"timecode, which accounts for the skipped frame numbers.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Timecodes","type":"heading","anchor":"Timecodes"},{"inlineContent":[{"text":"An ","type":"text"},{"isActive":true,"identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTETime","type":"reference"},{"text":" is a frame rate together with hour, minute, second, frame, and","type":"text"},{"text":" ","type":"text"},{"text":"subframe (hundredths of a frame) components. It can be made in four ways:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"From its components, with"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTETime\/init(frameRate:hour:minute:second:frame:subframe:)","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"From its "},{"type":"codeVoice","code":"HH:MM:SS:FF"},{"type":"text","text":" string, with "},{"type":"reference","identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTETime\/init(string:frameRate:)","isActive":true},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"At drop-frame rates the separator before the frame number may be "},{"type":"codeVoice","code":";"},{"type":"text","text":" or "},{"type":"codeVoice","code":":"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"and the string may end with a period and a two-digit subframe, as in"},{"type":"text","text":" "},{"type":"codeVoice","code":"01:00:03;12.50"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"From a number of frames since midnight, with"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTETime\/init(frameRate:frameCount:subframe:)","isActive":true},{"type":"text","text":". At drop-frame rates the"},{"type":"text","text":" "},{"type":"text","text":"frames are numbered with drop-frame timecode."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"From an exact number of seconds since midnight, with"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTETime\/init(frameRate:elapsedSeconds:)","isActive":true},{"type":"text","text":", which rounds to the nearest"},{"type":"text","text":" "},{"type":"text","text":"hundredth of a frame and wraps around after 24 hours."}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"The first three are failable, returning ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" for any component out of range,","type":"text"},{"text":" ","type":"text"},{"text":"including a frame number that drop-frame timecode skips. The last never fails.","type":"text"}],"type":"paragraph"},{"code":["let time = SMPTETime(frameRate: .fps2997Drop,","                     frameCount: 1800,","                     subframe: 0)","","time?.description   \/\/ \"00:01:00;02\"","time?.frameCount    \/\/ 1800"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"A timecode’s ","type":"text"},{"isActive":true,"identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTETime\/description","type":"reference"},{"text":" is its ","type":"text"},{"code":"HH:MM:SS:FF","type":"codeVoice"},{"text":" string, with ","type":"text"},{"code":";","type":"codeVoice"},{"text":" ","type":"text"},{"text":"before the frame number at drop-frame rates and a subframe suffix if it is not","type":"text"},{"text":" ","type":"text"},{"text":"zero.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Exact seconds","type":"heading","anchor":"Exact-seconds"},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTETime\/elapsedSeconds","type":"reference"},{"text":" gives a timecode’s exact time since midnight as an","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTEExactSeconds","type":"reference"},{"text":", which holds a rational ","type":"text"},{"code":"Number","type":"codeVoice"},{"text":" from","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"https:\/\/github.com\/eBardX\/XestiNumbers","type":"reference"},{"text":". An","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTEExactSeconds","type":"reference"},{"text":" can be written as an integer, floating-point, or string","type":"text"},{"text":" ","type":"text"},{"text":"literal, or made from a ","type":"text"},{"code":"Number","type":"codeVoice"},{"text":"; ","type":"text"},{"isActive":true,"identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTEExactSeconds\/init(numberValue:)","type":"reference"},{"text":" ","type":"text"},{"text":"returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" for a negative or non-finite number.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A floating-point value is converted to the exact rational value it represents,","type":"text"},{"text":" ","type":"text"},{"text":"which is not always the decimal it looks like: ","type":"text"},{"code":"0.1","type":"codeVoice"},{"text":" is not exactly one tenth.","type":"text"},{"text":" ","type":"text"},{"text":"To write a decimal fraction exactly, use ","type":"text"},{"code":"Number(numerator:denominator:)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"level":2,"text":"Changing frame rate","type":"heading","anchor":"Changing-frame-rate"},{"inlineContent":[{"text":"There are two ways to move a timecode to another frame rate, and they answer","type":"text"},{"text":" ","type":"text"},{"text":"different questions:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Converting through seconds keeps the "},{"type":"strong","inlineContent":[{"type":"text","text":"moment"}]},{"type":"text","text":": make a new "},{"type":"reference","identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTETime","isActive":true},{"type":"text","text":" "},{"type":"text","text":"from the old one’s "},{"type":"reference","identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTETime\/elapsedSeconds","isActive":true},{"type":"text","text":" at the new rate."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTETime\/retimed(to:)","isActive":true},{"type":"text","text":" keeps the "},{"type":"strong","inlineContent":[{"type":"text","text":"label"}]},{"type":"text","text":": 01:00:00:00 at 25 frames per"},{"type":"text","text":" "},{"type":"text","text":"second becomes 01:00:00:00 at any other rate. The frame number is clamped to"},{"type":"text","text":" "},{"type":"text","text":"the new rate’s last frame, and at a drop-frame rate a skipped frame number"},{"type":"text","text":" "},{"type":"text","text":"becomes the first one kept, so 00:01:00:00 at 30 frames per second becomes"},{"type":"text","text":" "},{"type":"text","text":"00:01:00;02 at 29.97 drop-frame."}],"type":"paragraph"}]}]},{"level":2,"text":"Timecode conversion","type":"heading","anchor":"Timecode-conversion"},{"inlineContent":[{"text":"An ","type":"text"},{"isActive":true,"identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTETimeConverter","type":"reference"},{"text":" labels a timeline measured in seconds — the wall","type":"text"},{"text":" ","type":"text"},{"text":"time of a performance, say — with timecode that starts at a chosen timecode.","type":"text"},{"text":" ","type":"text"},{"text":"Its frame rate is the start timecode’s:","type":"text"}],"type":"paragraph"},{"code":["let start     = SMPTETime(string: \"01:00:00:00\", frameRate: .fps25)!","let converter = SMPTETimeConverter(startTime: start)","","converter.smpteTime(at: 90)     \/\/ 01:01:30:00","","let earlier = SMPTETime(string: \"00:59:00:00\", frameRate: .fps25)!","","converter.seconds(at: earlier)  \/\/ 86340: the next day"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Because timecode wraps around after 24 hours, a timecode earlier than the start","type":"text"},{"text":" ","type":"text"},{"text":"timecode is taken to fall on the following day, so","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTETimeConverter\/seconds(at:)","type":"reference"},{"text":" always returns at least zero and less than","type":"text"},{"text":" ","type":"text"},{"text":"one day. The timecode it is given must be at the converter’s","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTETimeConverter\/frameRate","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"level":2,"text":"Error handling","type":"heading","anchor":"Error-handling"},{"inlineContent":[{"text":"IvorSMPTE throws no errors. Every conversion that can fail returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" ","type":"text"},{"text":"instead: the failable ","type":"text"},{"isActive":true,"identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTETime","type":"reference"},{"text":" and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTEExactSeconds","type":"reference"},{"text":" initializers, and","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTEFrameRate\/init(string:)","type":"reference"},{"text":". Passing ","type":"text"},{"isActive":true,"identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTETimeConverter\/seconds(at:)","type":"reference"},{"text":" a","type":"text"},{"text":" ","type":"text"},{"text":"timecode at a different frame rate from the converter’s is a programming error,","type":"text"},{"text":" ","type":"text"},{"text":"and stops execution.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Concurrency","type":"heading","anchor":"Concurrency"},{"inlineContent":[{"text":"IvorSMPTE is built for Swift 6 strict concurrency. Every public type is a","type":"text"},{"text":" ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":" value type, so instances can be freely shared across tasks and actor","type":"text"},{"text":" ","type":"text"},{"text":"boundaries.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/ivorsmpte\/usingivorsmpte"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"Represent SMPTE timecode at any standard frame rate, and convert it to and from","type":"text"},{"text":" ","type":"text"},{"text":"an exact number of seconds.","type":"text"}],"kind":"article","sections":[],"metadata":{"modules":[{"name":"IvorSMPTE"}],"role":"article","title":"Using IvorSMPTE","roleHeading":"Article"},"identifier":{"url":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/UsingIvorSMPTE","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://IvorSMPTE/documentation/IvorSMPTE/SMPTETimeConverter":{"kind":"symbol","type":"topic","title":"SMPTETimeConverter","identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTETimeConverter","url":"\/documentation\/ivorsmpte\/smptetimeconverter","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"text":"SMPTETimeConverter","kind":"identifier"}],"navigatorTitle":[{"text":"SMPTETimeConverter","kind":"identifier"}],"role":"symbol","abstract":[{"type":"text","text":"A type that converts between SMPTE timecode and an exact number of seconds"},{"type":"text","text":" "},{"text":"from a starting timecode.","type":"text"}]},"doc://IvorSMPTE/documentation/IvorSMPTE/SMPTETime/elapsedSeconds":{"role":"symbol","abstract":[{"text":"The exact number of seconds since midnight (00:00:00:00), including","type":"text"},{"text":" ","type":"text"},{"text":"the subframe component.","type":"text"}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"elapsedSeconds","kind":"identifier"},{"text":": ","kind":"text"},{"text":"SMPTEExactSeconds","kind":"typeIdentifier","preciseIdentifier":"s:9IvorSMPTE17SMPTEExactSecondsV"}],"kind":"symbol","url":"\/documentation\/ivorsmpte\/smptetime\/elapsedseconds","identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTETime\/elapsedSeconds","title":"elapsedSeconds","type":"topic"},"doc://IvorSMPTE/documentation/IvorSMPTE/SMPTETimeConverter/frameRate":{"kind":"symbol","url":"\/documentation\/ivorsmpte\/smptetimeconverter\/framerate","abstract":[{"text":"The SMPTE frame rate of the timecodes this converter produces.","type":"text"}],"identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTETimeConverter\/frameRate","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"frameRate"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"SMPTEFrameRate","preciseIdentifier":"s:9IvorSMPTE14SMPTEFrameRateO"}],"title":"frameRate","type":"topic"},"doc://IvorSMPTE/documentation/IvorSMPTE/SMPTEExactSeconds/init(numberValue:)":{"role":"symbol","abstract":[{"text":"Creates a new ","type":"text"},{"code":"SMPTEExactSeconds","type":"codeVoice"},{"text":" instance from a number value, or","type":"text"},{"text":" ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" if the number value is negative or is not a finite real number.","type":"text"}],"fragments":[{"text":"init","kind":"identifier"},{"text":"?(","kind":"text"},{"text":"numberValue","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Number","kind":"typeIdentifier","preciseIdentifier":"s:12XestiNumbers6NumberV"},{"text":")","kind":"text"}],"kind":"symbol","url":"\/documentation\/ivorsmpte\/smpteexactseconds\/init(numbervalue:)","identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTEExactSeconds\/init(numberValue:)","title":"init(numberValue:)","type":"topic"},"doc://IvorSMPTE/documentation/IvorSMPTE/SMPTETime/init(string:frameRate:)":{"role":"symbol","abstract":[{"text":"Creates a new ","type":"text"},{"code":"SMPTETime","type":"codeVoice"},{"text":" instance by parsing its string representation,","type":"text"},{"text":" ","type":"text"},{"text":"or ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" if the string cannot be parsed or any component is out of","type":"text"},{"text":" ","type":"text"},{"text":"range for the given frame rate.","type":"text"}],"fragments":[{"text":"init","kind":"identifier"},{"text":"?(","kind":"text"},{"text":"string","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"frameRate","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"SMPTEFrameRate","kind":"typeIdentifier","preciseIdentifier":"s:9IvorSMPTE14SMPTEFrameRateO"},{"text":")","kind":"text"}],"kind":"symbol","url":"\/documentation\/ivorsmpte\/smptetime\/init(string:framerate:)","identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTETime\/init(string:frameRate:)","title":"init(string:frameRate:)","type":"topic"},"doc://IvorSMPTE/documentation/IvorSMPTE/SMPTETime/description":{"kind":"symbol","type":"topic","title":"description","identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTETime\/description","url":"\/documentation\/ivorsmpte\/smptetime\/description","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"description"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"}],"role":"symbol","abstract":[{"text":"The string representation of this timecode, in the form ","type":"text"},{"code":"HH:MM:SS:FF","type":"codeVoice"},{"text":".","type":"text"}]},"doc://IvorSMPTE/documentation/IvorSMPTE/SMPTETime/retimed(to:)":{"role":"symbol","abstract":[{"text":"Returns this timecode at a different frame rate, keeping its hour,","type":"text"},{"text":" ","type":"text"},{"text":"minute, second, and subframe components.","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"retimed","kind":"identifier"},{"text":"(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"SMPTEFrameRate","kind":"typeIdentifier","preciseIdentifier":"s:9IvorSMPTE14SMPTEFrameRateO"},{"text":") -> ","kind":"text"},{"text":"SMPTETime","kind":"typeIdentifier","preciseIdentifier":"s:9IvorSMPTE9SMPTETimeV"}],"kind":"symbol","url":"\/documentation\/ivorsmpte\/smptetime\/retimed(to:)","identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTETime\/retimed(to:)","title":"retimed(to:)","type":"topic"},"doc://IvorSMPTE/documentation/IvorSMPTE/SMPTETime/init(frameRate:frameCount:subframe:)":{"role":"symbol","abstract":[{"text":"Creates a new ","type":"text"},{"code":"SMPTETime","type":"codeVoice"},{"text":" instance from a number of frames since","type":"text"},{"text":" ","type":"text"},{"text":"midnight (00:00:00:00), or ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" if the frame count or subframe is out","type":"text"},{"text":" ","type":"text"},{"text":"of range for the given frame rate.","type":"text"}],"fragments":[{"text":"init","kind":"identifier"},{"text":"?(","kind":"text"},{"text":"frameRate","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"SMPTEFrameRate","kind":"typeIdentifier","preciseIdentifier":"s:9IvorSMPTE14SMPTEFrameRateO"},{"text":", ","kind":"text"},{"text":"frameCount","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"UInt","kind":"typeIdentifier","preciseIdentifier":"s:Su"},{"text":", ","kind":"text"},{"text":"subframe","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"UInt","kind":"typeIdentif