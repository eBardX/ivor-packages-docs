{"abstract":[{"text":"Build MIDI 1.0 messages from typed values, and convert them to and from their","type":"text"},{"text":" ","type":"text"},{"text":"wire encoding.","type":"text"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"IvorMIDI models the MIDI 1.0 message set with two enumerations, built from a","type":"text"},{"text":" ","type":"text"},{"text":"family of small data value types that each validate their own range:","type":"text"}],"type":"paragraph"},{"alignments":["left","left"],"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Type","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Represents","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIChannelMessage","isActive":true,"type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"text":"A channel voice or mode message","type":"text"}]}]],[[{"inlineContent":[{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDISystemMessage","type":"reference","isActive":true}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"A system exclusive, common, or real-time message","type":"text"}]}]],[[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIChannel"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"A channel number (1–16)"}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIData1Value"}],"type":"paragraph"}],[{"inlineContent":[{"text":"A 7-bit data value (0–127)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIData2Value","isActive":true,"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"A 14-bit data value (0–16,383)"}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIController"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"A controller number (0–127)"}]}]],[[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIProgram","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"A program number (1–128)"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIPitchBend","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"text":"A pitch bend value (−8,192–8,191)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIRegisteredParameter","isActive":true,"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"text":"A registered parameter number (0–16,383)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDINonRegisteredParameter","type":"reference","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"text":"A non-registered parameter number (0–16,383)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIBank","type":"reference","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"text":"A bank number (0–16,383)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIPatch","type":"reference","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"text":"A program and, optionally, its bank","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDITuningMessage","type":"reference","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"text":"A decoded MIDI Tuning message","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDITuningFrequency","type":"reference","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"text":"A frequency in the MIDI Tuning format","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDITuningChange","type":"reference","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"text":"A retuning of one key","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDITuningLocation","type":"reference","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"text":"A tuning program and, optionally, its bank","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDITuningOffsets","type":"reference","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"text":"The tuning offsets of the 12 notes of the octave","type":"text"}],"type":"paragraph"}]]],"type":"table"},{"inlineContent":[{"type":"text","text":"Messages are values, so building one is just naming its case:"}],"type":"paragraph"},{"syntax":"swift","code":["let noteOn  = MIDIChannelMessage.noteOn(1, 60, 100)     \/\/ channel, note, velocity","let sustain = MIDIChannelMessage.controlChange(1, .sustain, 127)","let start   = MIDISystemMessage.start"],"type":"codeListing"},{"anchor":"Data-values","level":2,"text":"Data values","type":"heading"},{"inlineContent":[{"type":"text","text":"Each data value type wraps one number. An integer literal creates one directly,"},{"type":"text","text":" "},{"type":"text","text":"which suits constants; a literal out of range stops execution. For values that"},{"type":"text","text":" "},{"type":"text","text":"come from outside the program, use the failable "},{"code":"init?(uintValue:)","type":"codeVoice"},{"type":"text","text":" (or"},{"type":"text","text":" "},{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIPitchBend\/init(intValue:)","isActive":true,"type":"reference"},{"type":"text","text":"), which returns "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" for a value out of"},{"type":"text","text":" "},{"type":"text","text":"range, or check it first with "},{"code":"isValid(_:)","type":"codeVoice"},{"type":"text","text":". "},{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIChannel","isActive":true,"type":"reference"},{"type":"text","text":","},{"type":"text","text":" "},{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIData1Value","isActive":true,"type":"reference"},{"type":"text","text":", "},{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIData2Value","isActive":true,"type":"reference"},{"type":"text","text":", "},{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIProgram","isActive":true,"type":"reference"},{"type":"text","text":", and "},{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIPitchBend","isActive":true,"type":"reference"},{"type":"text","text":" "},{"type":"text","text":"also offer "},{"code":"init(clamping:)","type":"codeVoice"},{"type":"text","text":", which pulls any integer into range:"}],"type":"paragraph"},{"syntax":"swift","code":["let channel: MIDIChannel = 10                   \/\/ a literal: traps if out of range","let program = MIDIProgram(uintValue: 129)       \/\/ nil","let velocity = MIDIData1Value(clamping: 200)    \/\/ 127"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Channels and programs are numbered from 1, as the MIDI and General MIDI"},{"type":"text","text":" "},{"type":"text","text":"specifications number them; the wire encoding stores them zero-based. The"},{"type":"text","text":" "},{"type":"text","text":"14-bit types — "},{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIData2Value","isActive":true,"type":"reference"},{"type":"text","text":", "},{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIBank","isActive":true,"type":"reference"},{"type":"text","text":", "},{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIRegisteredParameter","isActive":true,"type":"reference"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"and "},{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDINonRegisteredParameter","isActive":true,"type":"reference"},{"type":"text","text":" — expose their 7-bit halves as "},{"code":"msb","type":"codeVoice"},{"type":"text","text":" and"},{"type":"text","text":" "},{"code":"lsb","type":"codeVoice"},{"type":"text","text":", and "},{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIData2Value","isActive":true,"type":"reference"},{"type":"text","text":" and "},{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIBank","isActive":true,"type":"reference"},{"type":"text","text":" can also be made from them:"}],"type":"paragraph"},{"syntax":"swift","code":["let bank = MIDIBank(msb: 121, lsb: 1)","bank.uintValue      \/\/ 15489"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"A "},{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIPitchBend","isActive":true,"type":"reference"},{"type":"text","text":" is centered at 0. Rather than work out the value by hand,"},{"type":"text","text":" "},{"type":"text","text":"make one from a bend in cents and the synthesizer’s pitch bend sensitivity"},{"type":"text","text":" "},{"type":"text","text":"(also in cents); the result uses the full 14-bit range and is clamped to it:"}],"type":"paragraph"},{"syntax":"swift","code":["let bend = MIDIPitchBend(cents: 100, sensitivity: 200)  \/\/ 4096"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The data value types are "},{"code":"Codable","type":"codeVoice"},{"type":"text","text":", "},{"code":"Comparable","type":"codeVoice"},{"type":"text","text":", and "},{"code":"Hashable","type":"codeVoice"},{"type":"text","text":", and describe"},{"type":"text","text":" "},{"type":"text","text":"themselves by their number."}],"type":"paragraph"},{"anchor":"Channel-messages","level":2,"text":"Channel messages","type":"heading"},{"inlineContent":[{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIChannelMessage","isActive":true,"type":"reference"},{"type":"text","text":" has one case per channel voice message: note on and"},{"type":"text","text":" "},{"type":"text","text":"off, polyphonic and channel pressure, control change, program change, and"},{"type":"text","text":" "},{"type":"text","text":"pitch bend change. Channel mode messages, such as all notes off, are control"},{"type":"text","text":" "},{"type":"text","text":"changes; "},{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIController","isActive":true,"type":"reference"},{"type":"text","text":" names every controller the MIDI 1.0 specification"},{"type":"text","text":" "},{"type":"text","text":"assigns, from "},{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIController\/bankSelectMSB","isActive":true,"type":"reference"},{"type":"text","text":" to"},{"type":"text","text":" "},{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIController\/polyModeOn","isActive":true,"type":"reference"},{"type":"text","text":". Every message knows its"},{"type":"text","text":" "},{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIChannelMessage\/channel","isActive":true,"type":"reference"},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Parameters-and-patches","level":2,"text":"Parameters and patches","type":"heading"},{"inlineContent":[{"type":"text","text":"A registered or non-registered parameter is set with a sequence of control"},{"type":"text","text":" "},{"type":"text","text":"changes: select the parameter, send its value with data entry, then deselect"},{"type":"text","text":" "},{"type":"text","text":"it so that later data entry does not change it by accident. One call builds"},{"type":"text","text":" "},{"type":"text","text":"the whole sequence, with a 7-bit ("},{"code":"msb:","type":"codeVoice"},{"type":"text","text":") or 14-bit ("},{"code":"value:","type":"codeVoice"},{"type":"text","text":") value:"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Set pitch bend sensitivity to 2 semitones on channel 1.","let bendRange = MIDIChannelMessage.registeredParameterChange(.pitchBendSensitivity,","                                                             msb: 2,","                                                             on: 1)","\/\/ RPN MSB, RPN LSB, data entry MSB, then the null RPN to deselect."],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The pieces are available separately too — "},{"code":"registeredParameterSelect(_:on:)","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"nonRegisteredParameterSelect(_:on:)","type":"codeVoice"},{"type":"text","text":", "},{"code":"dataEntry(_:on:)","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"dataEntryMSB(_:on:)","type":"codeVoice"},{"type":"text","text":", "},{"code":"dataIncrement(on:)","type":"codeVoice"},{"type":"text","text":", "},{"code":"dataDecrement(on:)","type":"codeVoice"},{"type":"text","text":", and"},{"type":"text","text":" "},{"code":"parameterDeselect(on:)","type":"codeVoice"},{"type":"text","text":" — for a controller that adjusts a parameter step by"},{"type":"text","text":" "},{"type":"text","text":"step."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A "},{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIPatch","isActive":true,"type":"reference"},{"type":"text","text":" is a program and, optionally, the bank it comes from."},{"type":"text","text":" "},{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIPatch\/selectionMessages(on:after:)","isActive":true,"type":"reference"},{"type":"text","text":" returns the bank select and program"},{"type":"text","text":" "},{"type":"text","text":"change messages that set a channel to it. Given the patch the channel had, it"},{"type":"text","text":" "},{"type":"text","text":"also selects bank 0 when moving from a banked patch to one without a bank, so"},{"type":"text","text":" "},{"type":"text","text":"the channel doesn’t stay in the old bank:"}],"type":"paragraph"},{"syntax":"swift","code":["let ukulele  = MIDIPatch(program: 25, bank: MIDIBank(msb: 121, lsb: 1))","let messages = ukulele.selectionMessages(on: 1, after: nil)","\/\/ Bank select MSB 121, bank select LSB 1, then program change 25."],"type":"codeListing"},{"anchor":"System-messages","level":2,"text":"System messages","type":"heading"},{"inlineContent":[{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDISystemMessage","isActive":true,"type":"reference"},{"type":"text","text":" covers system exclusive messages, system common messages"},{"type":"text","text":" "},{"type":"text","text":"(MIDI time code quarter frame, song position, song select, tune request, and"},{"type":"text","text":" "},{"type":"text","text":"EOX), and system real-time messages (timing clock, start, continue, stop,"},{"type":"text","text":" "},{"type":"text","text":"active sensing, and system reset)."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A "},{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDISystemMessage\/systemExclusive(_:)","isActive":true,"type":"reference"},{"type":"text","text":" message holds the bytes that follow"},{"type":"text","text":" "},{"type":"text","text":"the 0xF0 status byte, up to and including the terminating 0xF7. Universal"},{"type":"text","text":" "},{"type":"text","text":"system exclusive messages addressed to all devices are built for you:"}],"type":"paragraph"},{"syntax":"swift","code":["let volume = MIDISystemMessage.masterVolume(16_383)         \/\/ full volume","let tuning = MIDISystemMessage.masterCoarseTuning(64)       \/\/ A440"],"type":"codeListing"},{"anchor":"MIDI-tuning","level":2,"text":"MIDI tuning","type":"heading"},{"inlineContent":[{"type":"text","text":"The messages of the "},{"inlineContent":[{"text":"MIDI Tuning Messages","type":"text"}],"type":"emphasis"},{"type":"text","text":" specification (the MIDI Tuning"},{"type":"text","text":" "},{"type":"text","text":"Standard, with its CA-020, CA-021, and RP-020 extensions) are built by"},{"type":"text","text":" "},{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDISystemMessage","isActive":true,"type":"reference"},{"type":"text","text":" type methods. They address all devices unless you"},{"type":"text","text":" "},{"type":"text","text":"provide a "},{"code":"deviceID:","type":"codeVoice"},{"type":"text","text":". Unlike "},{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIProgram","isActive":true,"type":"reference"},{"type":"text","text":", tuning programs and banks are"},{"type":"text","text":" "},{"type":"text","text":"numbered from 0, as they appear on the wire (0–127)."}],"type":"paragraph"},{"alignments":["left","left"],"header":"row","rows":[[[{"inlineContent":[{"text":"Message","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Method","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Bulk tuning dump request, with or without a bank","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"bulkTuningDumpRequest"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Bulk tuning dump","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"bulkTuningDump"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Key-based tuning dump","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"keyBasedTuningDump"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Scale\/octave tuning dump, 1 or 2 byte format","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"scaleOctaveTuningDump"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Single note tuning change, with or without a bank","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"singleNoteTuningChange"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Scale\/octave tuning, 1 or 2 byte form","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"scaleOctaveTuning"}],"type":"paragraph"}]]],"type":"table"},{"inlineContent":[{"type":"text","text":"Key-based messages give keys absolute frequencies as"},{"type":"text","text":" "},{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDITuningFrequency","isActive":true,"type":"reference"},{"type":"text","text":" values, which you can make from a frequency in hertz"},{"type":"text","text":" "},{"type":"text","text":"or from a semitone and a fraction of a semitone."},{"type":"text","text":" "},{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDITuningFrequency\/noChange","isActive":true,"type":"reference"},{"type":"text","text":" leaves a key as it is:"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Retune key 69 to 442 Hz in tuning program 0, even while it sounds.","let change = MIDISystemMessage.singleNoteTuningChange(","    [MIDITuningChange(key: 69, frequency: MIDITuningFrequency(hertz: 442)!)],","    program: 0",")"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Scale\/octave messages give the 12 notes from C to B offsets from the selected"},{"type":"text","text":" "},{"type":"text","text":"preset, or from equal temperament if there is none, as a"},{"type":"text","text":" "},{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDITuningOffsets","isActive":true,"type":"reference"},{"type":"text","text":" value. "},{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDITuningOffsets\/coarse(_:)","isActive":true,"type":"reference"},{"type":"text","text":" is the 1-byte"},{"type":"text","text":" "},{"type":"text","text":"form, in whole cents from −64 to +63; "},{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDITuningOffsets\/fine(_:)","isActive":true,"type":"reference"},{"type":"text","text":" is the"},{"type":"text","text":" "},{"type":"text","text":"2-byte form, about ±100 cents in steps of about 0.012 cents:"}],"type":"paragraph"},{"syntax":"swift","code":["let offsets = [MIDIData1Value](repeating: 64, count: 12)","let scale   = MIDISystemMessage.scaleOctaveTuning(channels: [1, 2],","                                                  offsets: .coarse(offsets))"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Each scale\/octave message replaces the offsets of the last one rather than"},{"type":"text","text":" "},{"type":"text","text":"adding to them. To start from equal temperament on a device with tuning"},{"type":"text","text":" "},{"type":"text","text":"presets, RP-020 recommends selecting bank 0, program 0 first."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"These methods return "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" if they are given the wrong number of elements, or"},{"type":"text","text":" "},{"type":"text","text":"a tuning name that is not ASCII or is longer than 16 characters. A shorter"},{"type":"text","text":" "},{"type":"text","text":"name is padded with spaces."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To make a stored tuning the active one on a channel, set the"},{"type":"text","text":" "},{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIRegisteredParameter\/tuningBankSelect","isActive":true,"type":"reference"},{"type":"text","text":" and"},{"type":"text","text":" "},{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIRegisteredParameter\/tuningProgramChange","isActive":true,"type":"reference"},{"type":"text","text":" registered parameters:"}],"type":"paragraph"},{"syntax":"swift","code":["let select = MIDIChannelMessage.registeredParameterChange(.tuningProgramChange,","                                                          msb: 5,","                                                          on: 1)"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"To read a tuning message, such as a device’s reply to a dump request, decode"},{"type":"text","text":" "},{"type":"text","text":"it with "},{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDITuningMessage","isActive":true,"type":"reference"},{"type":"text","text":". Its "},{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDITuningMessage\/content-swift.property","isActive":true,"type":"reference"},{"type":"text","text":" holds what"},{"type":"text","text":" "},{"type":"text","text":"the message says, and its "},{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDITuningMessage\/systemMessage","isActive":true,"type":"reference"},{"type":"text","text":" encodes it"},{"type":"text","text":" "},{"type":"text","text":"again, so you can edit a tuning and send it back:"}],"type":"paragraph"},{"syntax":"swift","code":["if let tuning = MIDITuningMessage(reply),","   case let .keyBasedDump(location, name, frequencies) = tuning.content {","    \/\/ Use the tuning.","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The decoder returns "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" for anything that is not a valid tuning message,"},{"type":"text","text":" "},{"type":"text","text":"including a key-based or scale\/octave tuning dump with a wrong checksum. It"},{"type":"text","text":" "},{"type":"text","text":"does not check the checksum of a bulk tuning dump, because manufacturers have"},{"type":"text","text":" "},{"type":"text","text":"calculated it differently and the specification lets receivers ignore it."}],"type":"paragraph"},{"anchor":"Wire-encoding","level":2,"text":"Wire encoding","type":"heading"},{"inlineContent":[{"type":"text","text":"Both message types expose the two halves of their MIDI 1.0 wire encoding,"},{"type":"text","text":" "},{"code":"statusByte","type":"codeVoice"},{"type":"text","text":" and "},{"code":"dataBytes","type":"codeVoice"},{"type":"text","text":", and can be made from them with"},{"type":"text","text":" "},{"code":"init?(statusByte:dataBytes:)","type":"codeVoice"},{"type":"text","text":". That initializer returns "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" if the data"},{"type":"text","text":" "},{"type":"text","text":"bytes are the wrong number for the status byte, or are not valid data bytes;"},{"type":"text","text":" "},{"code":"expectedDataByteCount(for:)","type":"codeVoice"},{"type":"text","text":" tells you how many a status byte takes, which"},{"type":"text","text":" "},{"type":"text","text":"helps when reading a byte stream."}],"type":"paragraph"},{"inlineContent":[{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIChannelMessage","isActive":true,"type":"reference"},{"type":"text","text":", "},{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDISystemMessage","isActive":true,"type":"reference"},{"type":"text","text":", "},{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIChannel","isActive":true,"type":"reference"},{"type":"text","text":","},{"type":"text","text":" "},{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIController","isActive":true,"type":"reference"},{"type":"text","text":", "},{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIData1Value","isActive":true,"type":"reference"},{"type":"text","text":", "},{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIData2Value","isActive":true,"type":"reference"},{"type":"text","text":", "},{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIPitchBend","isActive":true,"type":"reference"},{"type":"text","text":","},{"type":"text","text":" "},{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIProgram","isActive":true,"type":"reference"},{"type":"text","text":", "},{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDITuningFrequency","isActive":true,"type":"reference"},{"type":"text","text":", and "},{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDITuningOffsets","isActive":true,"type":"reference"},{"type":"text","text":" also adopt"},{"type":"text","text":" "},{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIBytesConvertible","isActive":true,"type":"reference"},{"type":"text","text":", which converts a value to and from one array of"},{"type":"text","text":" "},{"type":"text","text":"bytes — for a message, the status byte followed by the data bytes:"}],"type":"paragraph"},{"syntax":"swift","code":["MIDIChannelMessage.noteOn(1, 60, 100).bytesValue    \/\/ [0x90, 0x3C, 0x64]","MIDISystemMessage(bytesValue: [0xfa])               \/\/ .start"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Other packages adopt "},{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIBytesConvertible","isActive":true,"type":"reference"},{"type":"text","text":" for their own binary encodings."}],"type":"paragraph"},{"anchor":"Error-handling","level":2,"text":"Error handling","type":"heading"},{"inlineContent":[{"type":"text","text":"IvorMIDI throws no errors. Every conversion that can fail returns "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"instead: the failable initializers of the data value types, the"},{"type":"text","text":" "},{"code":"init?(statusByte:dataBytes:)","type":"codeVoice"},{"type":"text","text":" and "},{"code":"init?(bytesValue:)","type":"codeVoice"},{"type":"text","text":" decoders, the MIDI"},{"type":"text","text":" "},{"type":"text","text":"tuning builders, and "},{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDITuningMessage","isActive":true,"type":"reference"},{"type":"text","text":". An integer literal out of range"},{"type":"text","text":" "},{"type":"text","text":"stops execution, so use a failable initializer for any value you have not"},{"type":"text","text":" "},{"type":"text","text":"checked."}],"type":"paragraph"},{"anchor":"Concurrency","level":2,"text":"Concurrency","type":"heading"},{"inlineContent":[{"type":"text","text":"IvorMIDI is built for Swift 6 strict concurrency. Every public message and"},{"type":"text","text":" "},{"type":"text","text":"data value type is a "},{"code":"Sendable","type":"codeVoice"},{"type":"text","text":" value type, so instances can be freely shared"},{"type":"text","text":" "},{"type":"text","text":"across tasks and actor boundaries."}],"type":"paragraph"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/UsingIvorMIDI"},"metadata":{"roleHeading":"Article","title":"Using IvorMIDI","modules":[{"name":"IvorMIDI"}],"role":"article"},"sections":[],"hierarchy":{"paths":[["doc:\/\/IvorMIDI\/documentation\/IvorMIDI"]]},"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormidi\/usingivormidi"]}],"references":{"doc://IvorMIDI/documentation/IvorMIDI/MIDITuningOffsets/coarse(_:)":{"abstract":[{"text":"Offsets in the 1-byte format, from −64 cents (0) through equal","type":"text"},{"text":" ","type":"text"},{"text":"temperament (64) to +63 cents (127).","type":"text"}],"title":"MIDITuningOffsets.coarse(_:)","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"coarse"},{"kind":"text","text":"(["},{"preciseIdentifier":"s:8IvorMIDI14MIDIData1ValueV","kind":"typeIdentifier","text":"MIDIData1Value"},{"kind":"text","text":"])"}],"url":"\/documentation\/ivormidi\/midituningoffsets\/coarse(_:)","kind":"symbol","role":"symbol","type":"topic","identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDITuningOffsets\/coarse(_:)"},"doc://IvorMIDI/documentation/IvorMIDI/MIDITuningFrequency/noChange":{"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind