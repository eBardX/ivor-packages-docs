{"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/UsingIvorMIDI"},"sections":[],"abstract":[{"text":"Build MIDI 1.0 messages from typed values, and convert them to and from their","type":"text"},{"text":" ","type":"text"},{"text":"wire encoding.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormidi\/usingivormidi"]}],"metadata":{"modules":[{"name":"IvorMIDI"}],"title":"Using IvorMIDI","roleHeading":"Article","role":"article"},"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","text":"Overview","level":2},{"inlineContent":[{"type":"text","text":"IvorMIDI models the MIDI 1.0 message set with two enumerations, built from a"},{"type":"text","text":" "},{"type":"text","text":"family of small data value types that each validate their own range:"}],"type":"paragraph"},{"alignments":["left","left"],"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Type"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Represents","type":"text"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIChannelMessage","isActive":true,"type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"A channel voice or mode message"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDISystemMessage","type":"reference","isActive":true}]}],[{"inlineContent":[{"text":"A system exclusive, common, or real-time message","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIChannel"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"A channel number (1–16)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIData1Value","isActive":true,"type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"A 7-bit data value (0–127)"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIData2Value","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"A 14-bit data value (0–16,383)"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIController","type":"reference","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"A controller number (0–127)"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIProgram"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"A program number (1–128)"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIPitchBend","isActive":true,"type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"A pitch bend value (−8,192–8,191)"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIRegisteredParameter"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"A registered parameter number (0–16,383)"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDINonRegisteredParameter"}]}],[{"type":"paragraph","inlineContent":[{"text":"A non-registered parameter number (0–16,383)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIBank","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"A bank number (0–16,383)"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIPatch"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"A program and, optionally, its bank"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDITuningMessage","type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"A decoded MIDI Tuning message"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDITuningFrequency","type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"A frequency in the MIDI Tuning format"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDITuningChange","isActive":true,"type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"A retuning of one key"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDITuningLocation","type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"text":"A tuning program and, optionally, its bank","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDITuningOffsets"}]}],[{"type":"paragraph","inlineContent":[{"text":"The tuning offsets of the 12 notes of the octave","type":"text"}]}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Messages are values, so building one is just naming its case:"}]},{"syntax":"swift","type":"codeListing","code":["let noteOn  = MIDIChannelMessage.noteOn(1, 60, 100)     \/\/ channel, note, velocity","let sustain = MIDIChannelMessage.controlChange(1, .sustain, 127)","let start   = MIDISystemMessage.start"]},{"anchor":"Data-values","level":2,"text":"Data values","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Each data value type wraps one number. An integer literal creates one directly,","type":"text"},{"text":" ","type":"text"},{"text":"which suits constants; a literal out of range stops execution. For values that","type":"text"},{"text":" ","type":"text"},{"text":"come from outside the program, use the failable ","type":"text"},{"type":"codeVoice","code":"init?(uintValue:)"},{"text":" (or","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIPitchBend\/init(intValue:)"},{"text":"), which returns ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" for a value out of","type":"text"},{"text":" ","type":"text"},{"text":"range, or check it first with ","type":"text"},{"type":"codeVoice","code":"isValid(_:)"},{"text":". ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIChannel"},{"text":",","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIData1Value"},{"text":", ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIData2Value"},{"text":", ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIProgram"},{"text":", and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIPitchBend"},{"text":" ","type":"text"},{"text":"also offer ","type":"text"},{"type":"codeVoice","code":"init(clamping:)"},{"text":", which pulls any integer into range:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let channel: MIDIChannel = 10                   \/\/ a literal: traps if out of range","let program = MIDIProgram(uintValue: 129)       \/\/ nil","let velocity = MIDIData1Value(clamping: 200)    \/\/ 127"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Channels and programs are numbered from 1, as the MIDI and General MIDI"},{"type":"text","text":" "},{"type":"text","text":"specifications number them; the wire encoding stores them zero-based. The"},{"type":"text","text":" "},{"type":"text","text":"14-bit types — "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIData2Value"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIBank"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIRegisteredParameter"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDINonRegisteredParameter"},{"type":"text","text":" — expose their 7-bit halves as "},{"type":"codeVoice","code":"msb"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"lsb"},{"type":"text","text":", and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIData2Value"},{"type":"text","text":" and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIBank"},{"type":"text","text":" can also be made from them:"}]},{"type":"codeListing","code":["let bank = MIDIBank(msb: 121, lsb: 1)","bank.uintValue      \/\/ 15489"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIPitchBend","type":"reference","isActive":true},{"type":"text","text":" is centered at 0. Rather than work out the value by hand,"},{"type":"text","text":" "},{"type":"text","text":"make one from a bend in cents and the synthesizer’s pitch bend sensitivity"},{"type":"text","text":" "},{"type":"text","text":"(also in cents); the result uses the full 14-bit range and is clamped to it:"}]},{"type":"codeListing","code":["let bend = MIDIPitchBend(cents: 100, sensitivity: 200)  \/\/ 4096"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The data value types are "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":", "},{"type":"codeVoice","code":"Comparable"},{"type":"text","text":", and "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":", and describe"},{"type":"text","text":" "},{"type":"text","text":"themselves by their number."}]},{"text":"Channel messages","type":"heading","level":2,"anchor":"Channel-messages"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIChannelMessage","type":"reference","isActive":true},{"text":" has one case per channel voice message: note on and","type":"text"},{"type":"text","text":" "},{"type":"text","text":"off, polyphonic and channel pressure, control change, program change, and"},{"type":"text","text":" "},{"type":"text","text":"pitch bend change. Channel mode messages, such as all notes off, are control"},{"type":"text","text":" "},{"type":"text","text":"changes; "},{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIController","type":"reference","isActive":true},{"type":"text","text":" names every controller the MIDI 1.0 specification"},{"type":"text","text":" "},{"type":"text","text":"assigns, from "},{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIController\/bankSelectMSB","type":"reference","isActive":true},{"type":"text","text":" to"},{"type":"text","text":" "},{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIController\/polyModeOn","type":"reference","isActive":true},{"type":"text","text":". Every message knows its"},{"type":"text","text":" "},{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIChannelMessage\/channel","type":"reference","isActive":true},{"type":"text","text":"."}]},{"level":2,"text":"Parameters and patches","type":"heading","anchor":"Parameters-and-patches"},{"type":"paragraph","inlineContent":[{"text":"A registered or non-registered parameter is set with a sequence of control","type":"text"},{"text":" ","type":"text"},{"text":"changes: select the parameter, send its value with data entry, then deselect","type":"text"},{"text":" ","type":"text"},{"text":"it so that later data entry does not change it by accident. One call builds","type":"text"},{"text":" ","type":"text"},{"text":"the whole sequence, with a 7-bit (","type":"text"},{"type":"codeVoice","code":"msb:"},{"text":") or 14-bit (","type":"text"},{"type":"codeVoice","code":"value:"},{"text":") value:","type":"text"}]},{"code":["\/\/ Set pitch bend sensitivity to 2 semitones on channel 1.","let bendRange = MIDIChannelMessage.registeredParameterChange(.pitchBendSensitivity,","                                                             msb: 2,","                                                             on: 1)","\/\/ RPN MSB, RPN LSB, data entry MSB, then the null RPN to deselect."],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The pieces are available separately too — "},{"type":"codeVoice","code":"registeredParameterSelect(_:on:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"nonRegisteredParameterSelect(_:on:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"dataEntry(_:on:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"dataEntryMSB(_:on:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"dataIncrement(on:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"dataDecrement(on:)"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"codeVoice","code":"parameterDeselect(on:)"},{"type":"text","text":" — for a controller that adjusts a parameter step by"},{"type":"text","text":" "},{"type":"text","text":"step."}]},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIPatch","isActive":true,"type":"reference"},{"text":" is a program and, optionally, the bank it comes from.","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIPatch\/selectionMessages(on:after:)","isActive":true,"type":"reference"},{"text":" returns the bank select and program","type":"text"},{"text":" ","type":"text"},{"text":"change messages that set a channel to it. Given the patch the channel had, it","type":"text"},{"text":" ","type":"text"},{"text":"also selects bank 0 when moving from a banked patch to one without a bank, so","type":"text"},{"text":" ","type":"text"},{"text":"the channel doesn’t stay in the old bank:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let ukulele  = MIDIPatch(program: 25, bank: MIDIBank(msb: 121, lsb: 1))","let messages = ukulele.selectionMessages(on: 1, after: nil)","\/\/ Bank select MSB 121, bank select LSB 1, then program change 25."]},{"level":2,"anchor":"System-messages","text":"System messages","type":"heading"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDISystemMessage","type":"reference","isActive":true},{"type":"text","text":" covers system exclusive messages, system common messages"},{"type":"text","text":" "},{"text":"(MIDI time code quarter frame, song position, song select, tune request, and","type":"text"},{"text":" ","type":"text"},{"text":"EOX), and system real-time messages (timing clock, start, continue, stop,","type":"text"},{"text":" ","type":"text"},{"text":"active sensing, and system reset).","type":"text"}]},{"inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDISystemMessage\/systemExclusive(_:)","type":"reference","isActive":true},{"text":" message holds the bytes that follow","type":"text"},{"text":" ","type":"text"},{"text":"the 0xF0 status byte, up to and including the terminating 0xF7. Universal","type":"text"},{"text":" ","type":"text"},{"text":"system exclusive messages addressed to all devices are built for you:","type":"text"}],"type":"paragraph"},{"code":["let volume = MIDISystemMessage.masterVolume(16_383)         \/\/ full volume","let tuning = MIDISystemMessage.masterCoarseTuning(64)       \/\/ A440"],"syntax":"swift","type":"codeListing"},{"level":2,"anchor":"MIDI-tuning","text":"MIDI tuning","type":"heading"},{"inlineContent":[{"type":"text","text":"The messages of the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"MIDI Tuning Messages"}]},{"type":"text","text":" specification (the MIDI Tuning"},{"type":"text","text":" "},{"type":"text","text":"Standard, with its CA-020, CA-021, and RP-020 extensions) are built by"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDISystemMessage"},{"type":"text","text":" type methods. They address all devices unless you"},{"type":"text","text":" "},{"type":"text","text":"provide a "},{"code":"deviceID:","type":"codeVoice"},{"type":"text","text":". Unlike "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIProgram"},{"type":"text","text":", tuning programs and banks are"},{"type":"text","text":" "},{"type":"text","text":"numbered from 0, as they appear on the wire (0–127)."}],"type":"paragraph"},{"header":"row","alignments":["left","left"],"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Message"}]}],[{"inlineContent":[{"text":"Method","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Bulk tuning dump request, with or without a bank","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"bulkTuningDumpRequest"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Bulk tuning dump","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"bulkTuningDump"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Key-based tuning dump"}],"type":"paragraph"}],[{"inlineContent":[{"code":"keyBasedTuningDump","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Scale\/octave tuning dump, 1 or 2 byte format","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"scaleOctaveTuningDump"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Single note tuning change, with or without a bank","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"singleNoteTuningChange","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Scale\/octave tuning, 1 or 2 byte form","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"scaleOctaveTuning"}],"type":"paragraph"}]]],"type":"table"},{"type":"paragraph","inlineContent":[{"text":"Key-based messages give keys absolute frequencies as","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDITuningFrequency","type":"reference","isActive":true},{"text":" values, which you can make from a frequency in hertz","type":"text"},{"text":" ","type":"text"},{"text":"or from a semitone and a fraction of a semitone.","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDITuningFrequency\/noChange","type":"reference","isActive":true},{"text":" leaves a key as it is:","type":"text"}]},{"code":["\/\/ Retune key 69 to 442 Hz in tuning program 0, even while it sounds.","let change = MIDISystemMessage.singleNoteTuningChange(","    [MIDITuningChange(key: 69, frequency: MIDITuningFrequency(hertz: 442)!)],","    program: 0",")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Scale\/octave messages give the 12 notes from C to B offsets from the selected"},{"type":"text","text":" "},{"type":"text","text":"preset, or from equal temperament if there is none, as a"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDITuningOffsets","isActive":true},{"type":"text","text":" value. "},{"type":"reference","identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDITuningOffsets\/coarse(_:)","isActive":true},{"type":"text","text":" is the 1-byte"},{"type":"text","text":" "},{"type":"text","text":"form, in whole cents from −64 to +63; "},{"type":"reference","identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDITuningOffsets\/fine(_:)","isActive":true},{"type":"text","text":" is the"},{"type":"text","text":" "},{"type":"text","text":"2-byte form, about ±100 cents in steps of about 0.012 cents:"}],"type":"paragraph"},{"code":["let offsets = [MIDIData1Value](repeating: 64, count: 12)","let scale   = MIDISystemMessage.scaleOctaveTuning(channels: [1, 2],","                                                  offsets: .coarse(offsets))"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Each scale\/octave message replaces the offsets of the last one rather than","type":"text"},{"text":" ","type":"text"},{"text":"adding to them. To start from equal temperament on a device with tuning","type":"text"},{"text":" ","type":"text"},{"text":"presets, RP-020 recommends selecting bank 0, program 0 first.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"These methods return "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" if they are given the wrong number of elements, or"},{"type":"text","text":" "},{"type":"text","text":"a tuning name that is not ASCII or is longer than 16 characters. A shorter"},{"type":"text","text":" "},{"type":"text","text":"name is padded with spaces."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To make a stored tuning the active one on a channel, set the"},{"type":"text","text":" "},{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIRegisteredParameter\/tuningBankSelect","type":"reference","isActive":true},{"text":" and","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIRegisteredParameter\/tuningProgramChange","isActive":true},{"text":" registered parameters:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["let select = MIDIChannelMessage.registeredParameterChange(.tuningProgramChange,","                                                          msb: 5,","                                                          on: 1)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To read a tuning message, such as a device’s reply to a dump request, decode"},{"type":"text","text":" "},{"type":"text","text":"it with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDITuningMessage"},{"type":"text","text":". Its "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDITuningMessage\/content-swift.property"},{"type":"text","text":" holds what"},{"type":"text","text":" "},{"type":"text","text":"the message says, and its "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDITuningMessage\/systemMessage"},{"type":"text","text":" encodes it"},{"type":"text","text":" "},{"type":"text","text":"again, so you can edit a tuning and send it back:"}]},{"type":"codeListing","code":["if let tuning = MIDITuningMessage(reply),","   case let .keyBasedDump(location, name, frequencies) = tuning.content {","    \/\/ Use the tuning.","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The decoder returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" for anything that is not a valid tuning message,","type":"text"},{"text":" ","type":"text"},{"text":"including a key-based or scale\/octave tuning dump with a wrong checksum. It","type":"text"},{"text":" ","type":"text"},{"text":"does not check the checksum of a bulk tuning dump, because manufacturers have","type":"text"},{"text":" ","type":"text"},{"text":"calculated it differently and the specification lets receivers ignore it.","type":"text"}]},{"type":"heading","level":2,"text":"Wire encoding","anchor":"Wire-encoding"},{"type":"paragraph","inlineContent":[{"text":"Both message types expose the two halves of their MIDI 1.0 wire encoding,","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"statusByte"},{"type":"text","text":" and "},{"type":"codeVoice","code":"dataBytes"},{"text":", and can be made from them with","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"init?(statusByte:dataBytes:)"},{"text":". That initializer returns ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" if the data","type":"text"},{"text":" ","type":"text"},{"text":"bytes are the wrong number for the status byte, or are not valid data bytes;","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"expectedDataByteCount(for:)"},{"type":"text","text":" tells you how many a status byte takes, which"},{"text":" ","type":"text"},{"text":"helps when reading a byte stream.","type":"text"}]},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIChannelMessage"},{"text":", ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDISystemMessage"},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIChannel","isActive":true},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIController","isActive":true},{"text":", ","type":"text"},{"type":"reference","identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIData1Value","isActive":true},{"text":", ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIData2Value"},{"text":", ","type":"text"},{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIPitchBend","type":"reference","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIProgram","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDITuningFrequency","type":"reference","isActive":true},{"type":"text","text":", and "},{"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDITuningOffsets","type":"reference","isActive":true},{"type":"text","text":" also adopt"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIBytesConvertible","isActive":true},{"text":", which converts a value to and from one array of","type":"text"},{"text":" ","type":"text"},{"text":"bytes — for a message, the status byte followed by the data bytes:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["MIDIChannelMessage.noteOn(1, 60, 100).bytesValue    \/\/ [0x90, 0x3C, 0x64]","MIDISystemMessage(bytesValue: [0xfa])               \/\/ .start"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Other packages adopt "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorMIDI\/documentation\/IvorMIDI\/MIDIBytesConvertible"},{"type":"text","text":" for their own binary encodings."}]},{"level":2,"anchor":"Error-handling","type":"heading","text":"Error handling"},{"type":"paragraph","inlineContent":[{"type":"text","text":"IvorMIDI throws no errors. Every conversion that can fail returns "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"instead: the failable initializers of the data value types, the"},{"type":"text","text":" "},{"code":"init?(statusByte:dataBytes:)","type":"codeVoice"},{"type":"text","text":" and "},{"code":"init?(bytesValue:)","typ