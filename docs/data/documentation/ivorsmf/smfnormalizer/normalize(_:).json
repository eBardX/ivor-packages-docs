{"hierarchy":{"paths":[["doc:\/\/IvorSMF\/documentation\/IvorSMF","doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFNormalizer"]]},"metadata":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"normalize","kind":"identifier"},{"text":"(","kind":"text"},{"text":"SMFSequence","kind":"typeIdentifier","preciseIdentifier":"s:7IvorSMF11SMFSequenceV"},{"kind":"text","text":") -> ("},{"text":"SMFSequence","kind":"typeIdentifier","preciseIdentifier":"s:7IvorSMF11SMFSequenceV"},{"kind":"text","text":", ["},{"preciseIdentifier":"s:7IvorSMF13SMFNormalizerV6ChangeO","kind":"typeIdentifier","text":"Change"},{"kind":"text","text":"])"}],"externalID":"s:7IvorSMF13SMFNormalizerV9normalizeyAA11SMFSequenceV_SayAC6ChangeOGtAFF","extendedModule":"IvorSMF","symbolKind":"method","title":"normalize(_:)","role":"symbol","roleHeading":"Instance Method","modules":[{"name":"IvorSMF"}]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFNormalizer\/normalize(_:)"},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"normalize"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"text":"sequence","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"SMFSequence","identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFSequence","preciseIdentifier":"s:7IvorSMF11SMFSequenceV","kind":"typeIdentifier"},{"text":") -> (","kind":"text"},{"text":"SMFSequence","identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFSequence","preciseIdentifier":"s:7IvorSMF11SMFSequenceV","kind":"typeIdentifier"},{"text":", [","kind":"text"},{"text":"Change","identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFNormalizer\/Change","preciseIdentifier":"s:7IvorSMF13SMFNormalizerV6ChangeO","kind":"typeIdentifier"},{"text":"])","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}]},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The sequence to normalize.","type":"text"}]}],"name":"sequence"}],"kind":"parameters"},{"content":[{"type":"heading","level":2,"anchor":"return-value","text":"Return Value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A tuple of a new "},{"type":"reference","identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFSequence","isActive":true},{"type":"text","text":" whose"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFSequence\/isNormalized","isActive":true},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":", and an array of"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFNormalizer\/Change","isActive":true},{"type":"text","text":" values describing each normalization applied."}]}],"kind":"content"},{"content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Normalization is idempotent: calling "},{"type":"codeVoice","code":"normalize(_:)"},{"type":"text","text":" on an"},{"type":"text","text":" "},{"type":"text","text":"already-normalized sequence returns it immediately with an empty"},{"type":"text","text":" "},{"type":"text","text":"changes array."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Canonical form requires each track to have exactly one End-of-Track"},{"type":"text","text":" "},{"type":"text","text":"meta-event, as the final event, at a tick greater than or equal to"},{"type":"text","text":" "},{"type":"text","text":"every other event in the track. Each track is mechanically and"},{"type":"text","text":" "},{"type":"text","text":"data-preservingly brought into this form: all End-of-Track events are"},{"type":"text","text":" "},{"type":"text","text":"removed, then a single End-of-Track is appended at the maximum"},{"type":"text","text":" "},{"type":"text","text":"remaining event tick (or tick zero if the track is otherwise empty)."},{"type":"text","text":" "},{"type":"text","text":"No musical events are ever dropped."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Canonical form also requires a format-0 sequence to have exactly one"},{"type":"text","text":" "},{"type":"text","text":"track. A format-0 sequence with more than one track is reinterpreted"},{"type":"text","text":" "},{"type":"text","text":"as format 1, which has no such restriction."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Canonical form also requires that, within a track, a sequence-number"},{"type":"text","text":" "},{"type":"text","text":"meta-event appear at time zero, and that, in a format-1 sequence with"},{"type":"text","text":" "},{"type":"text","text":"more than one track, tempo and time-signature meta-events appear only"},{"type":"text","text":" "},{"type":"text","text":"in the first track. A misplaced sequence-number event has its time"},{"type":"text","text":" "},{"type":"text","text":"reset to zero; a misplaced tempo or time-signature event is moved to"},{"type":"text","text":" "},{"type":"text","text":"track 0 at its original tick."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This clears every "},{"type":"reference","identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFValidator\/Issue","isActive":true},{"type":"text","text":" case that has a mechanical"},{"type":"text","text":" "},{"type":"text","text":"fix, so a normalized sequence has no validation issues arising from"},{"type":"text","text":" "},{"type":"text","text":"them. Issues that require a judgment call (such as"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFValidator\/Issue\/unencodableText(trackIndex:)","isActive":true},{"type":"text","text":") are left to"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFValidator","isActive":true},{"type":"text","text":"."}]}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"paths":["\/documentation\/ivorsmf\/smfnormalizer\/normalize(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"Returns a copy of the provided sequence normalized to canonical form,"},{"text":" ","type":"text"},{"type":"text","text":"along with an array describing each change applied."}],"sections":[],"references":{"doc://IvorSMF/documentation/IvorSMF/SMFValidator":{"kind":"symbol","identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFValidator","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SMFValidator"}],"title":"SMFValidator","type":"topic","url":"\/documentation\/ivorsmf\/smfvalidator","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"SMFValidator"}],"abstract":[{"type":"text","text":"A type that validates an SMF sequence against the Standard MIDI Files"},{"type":"text","text":" "},{"type":"text","text":"specification."}]},"doc://IvorSMF/documentation/IvorSMF/SMFNormalizer/Change":{"identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFNormalizer\/Change","kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Change","kind":"identifier"}],"title":"SMFNormalizer.Change","type":"topic","url":"\/documentation\/ivorsmf\/smfnormalizer\/change","role":"symbol","navigatorTitle":[{"text":"Change","kind":"identifier"}],"abstract":[{"type":"text","text":"A change applied when normalizing an "},{"identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFSequence","isActive":true,"type":"reference"},{"type":"text","text":" to canonical"},{"type":"text","text":" "},{"type":"text","text":"form."}]},"doc://IvorSMF/documentation/IvorSMF/SMFValidator/Issue/unencodableText(trackIndex:)":{"identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/