{"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","metadata":{"roleHeading":"Instance Method","extendedModule":"IvorSMF","externalID":"s:7IvorSMF13SMFNormalizerV9normalizeyAA11SMFSequenceV_SayAC6ChangeOGtAFF","role":"symbol","symbolKind":"method","modules":[{"name":"IvorSMF"}],"title":"normalize(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"normalize","kind":"identifier"},{"text":"(","kind":"text"},{"text":"SMFSequence","preciseIdentifier":"s:7IvorSMF11SMFSequenceV","kind":"typeIdentifier"},{"text":") -> (","kind":"text"},{"text":"SMFSequence","preciseIdentifier":"s:7IvorSMF11SMFSequenceV","kind":"typeIdentifier"},{"text":", [","kind":"text"},{"text":"Change","preciseIdentifier":"s:7IvorSMF13SMFNormalizerV6ChangeO","kind":"typeIdentifier"},{"text":"])","kind":"text"}]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"normalize"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"sequence"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFSequence","text":"SMFSequence","preciseIdentifier":"s:7IvorSMF11SMFSequenceV"},{"kind":"text","text":") -> ("},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFSequence","text":"SMFSequence","preciseIdentifier":"s:7IvorSMF11SMFSequenceV"},{"kind":"text","text":", ["},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFNormalizer\/Change","text":"Change","preciseIdentifier":"s:7IvorSMF13SMFNormalizerV6ChangeO"},{"kind":"text","text":"])"}],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"name":"sequence","content":[{"inlineContent":[{"type":"text","text":"The sequence to normalize."}],"type":"paragraph"}]}]},{"kind":"content","content":[{"text":"Return Value","level":2,"type":"heading","anchor":"return-value"},{"type":"paragraph","inlineContent":[{"text":"A tuple of a new ","type":"text"},{"identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFSequence","isActive":true,"type":"reference"},{"text":" whose","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFSequence\/isNormalized","isActive":true,"type":"reference"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"true"},{"text":", and an array of","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFNormalizer\/Change","isActive":true,"type":"reference"},{"text":" values describing each normalization applied.","type":"text"}]}]},{"kind":"content","content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Normalization is idempotent: calling ","type":"text"},{"type":"codeVoice","code":"normalize(_:)"},{"text":" on an","type":"text"},{"text":" ","type":"text"},{"text":"already-normalized sequence returns it immediately with an empty","type":"text"},{"text":" ","type":"text"},{"text":"changes array.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Canonical form requires each track to have exactly one End-of-Track","type":"text"},{"text":" ","type":"text"},{"text":"meta-event, as the final event, at a tick greater than or equal to","type":"text"},{"text":" ","type":"text"},{"text":"every other event in the track. Each track is mechanically and","type":"text"},{"text":" ","type":"text"},{"text":"data-preservingly brought into this form: all End-of-Track events are","type":"text"},{"text":" ","type":"text"},{"text":"removed, then a single End-of-Track is appended at the maximum","type":"text"},{"text":" ","type":"text"},{"text":"remaining event tick (or tick zero if the track is otherwise empty).","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"No musical events are ever dropped."}]},{"type":"paragraph","inlineContent":[{"text":"Canonical form also requires a format-0 sequence to have exactly one","type":"text"},{"text":" ","type":"text"},{"text":"track. A format-0 sequence with more than one track is reinterpreted","type":"text"},{"text":" ","type":"text"},{"text":"as format 1, which has no such restriction.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Canonical form also requires that, within a track, a sequence-number"},{"type":"text","text":" "},{"type":"text","text":"meta-event appear at time zero, and that, in a format-1 sequence with"},{"type":"text","text":" "},{"type":"text","text":"more than one track, tempo and time-signature meta-events appear only"},{"type":"text","text":" "},{"type":"text","text":"in the first track. A misplaced sequence-number event has its time"},{"type":"text","text":" "},{"type":"text","text":"reset to zero; a misplaced tempo or time-signature event is moved to"},{"type":"text","text":" "},{"type":"text","text":"track 0 at its original tick."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This clears every "},{"type":"reference","identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFValidator\/Issue","isActive":true},{"type":"text","text":" case that has a mechanical"},{"type":"text","text":" "},{"type":"text","text":"fix, so a normalized sequence has no validation issues arising from"},{"type":"text","text":" "},{"type":"text","text":"them. Issues that require a judgment call (such as"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFValidator\/Issue\/unencodableText(trackIndex:)","isActive":true},{"type":"text","text":") are left to"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFValidator","isActive":true},{"type":"text","text":"."}]}]}],"variants":[{"paths":["\/documentation\/ivorsmf\/smfnormalizer\/normalize(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/IvorSMF\/documentation\/IvorSMF","doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFNormalizer"]]},"abstract":[{"text":"Returns a copy of the provided sequence normalized to canonical form,","type":"text"},{"text":" ","type":"text"},{"text":"along with an array describing each change applied.","type":"text"}],"identifier":{"url":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFNormalizer\/normalize(_:)","interfaceLanguage":"swift"},"references":{"doc://IvorSMF/documentation/IvorSMF/SMFValidator/Issue":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Issue"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Issue"}],"abstract":[{"text":"An issue found when validating an ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFSequence"},{"text":" against the Standard","type":"text"},{"text":" ","type":"text"},{"text":"MIDI Files specification.","type":"text"}],"role":"symbol","url":"\/documentation\/ivorsmf\/smfvalidator\/issue","title":"SMFValidator.Issue","identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFValidator\/Issue","type":"topic"},"doc://IvorSMF/documentation/IvorSMF":{"kind":"symbol","type":"topic","abstract":[{"type":"text","text":"A Standard MIDI Files parser, normalizer, validator, and formatter."}],"role":"collection","url":"\/documentation\/ivorsmf","title":"IvorSMF","identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF"},"doc://IvorSMF/documentation/IvorSMF/SMFValidator":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SMFValidator"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"SMFValidator"}],"type":"topic","abstract":[{"text":"A type that validates an SMF sequence against the Standard MIDI Files","type":"text"},{"text":" ","type":"text"},{"type":"text","text"