{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"normalize"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"sequence"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"SMFSequence","identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFSequence","preciseIdentifier":"s:7IvorSMF11SMFSequenceV"},{"kind":"text","text":") -> ("},{"kind":"typeIdentifier","text":"SMFSequence","identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFSequence","preciseIdentifier":"s:7IvorSMF11SMFSequenceV"},{"kind":"text","text":", ["},{"identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFNormalizer\/Change","text":"Change","preciseIdentifier":"s:7IvorSMF13SMFNormalizerV6ChangeO","kind":"typeIdentifier"},{"text":"])","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The sequence to normalize."}],"type":"paragraph"}],"name":"sequence"}]},{"kind":"content","content":[{"text":"Return Value","anchor":"return-value","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"A tuple of a new ","type":"text"},{"identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFSequence","type":"reference","isActive":true},{"text":" whose","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFSequence\/isNormalized","type":"reference","isActive":true},{"text":" is ","type":"text"},{"type":"codeVoice","code":"true"},{"text":", and an array of","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFNormalizer\/Change"},{"text":" values describing each normalization applied.","type":"text"}]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Normalization is idempotent: calling ","type":"text"},{"code":"normalize(_:)","type":"codeVoice"},{"text":" on an","type":"text"},{"text":" ","type":"text"},{"text":"already-normalized sequence returns it immediately with an empty","type":"text"},{"text":" ","type":"text"},{"text":"changes array.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Canonical form requires each track to have exactly one End-of-Track","type":"text"},{"type":"text","text":" "},{"type":"text","text":"meta-event, as the final event, at a tick greater than or equal to"},{"type":"text","text":" "},{"type":"text","text":"every other event in the track. Each track is mechanically and"},{"type":"text","text":" "},{"type":"text","text":"data-preservingly brought into this form: all End-of-Track events are"},{"type":"text","text":" "},{"text":"removed, then a single End-of-Track is appended at the maximum","type":"text"},{"text":" ","type":"text"},{"text":"remaining event tick (or tick zero if the track is otherwise empty).","type":"text"},{"text":" ","type":"text"},{"text":"No musical events are ever dropped.","type":"text"}]},{"inlineContent":[{"type":"text","text":"Canonical form also requires a format-0 sequence to have exactly one"},{"type":"text","text":" "},{"type":"text","text":"track. A format-0 sequence with more than one track is reinterpreted"},{"type":"text","text":" "},{"type":"text","text":"as format 1, which has no such restriction."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Canonical form also requires that, within a track, a sequence-number"},{"type":"text","text":" "},{"type":"text","text":"meta-event appear at time zero, and that, in a format-1 sequence with"},{"type":"text","text":" "},{"type":"text","text":"more than one track, tempo and time-signature meta-events appear only"},{"type":"text","text":" "},{"type":"text","text":"in the first track. A misplaced sequence-number event has its time"},{"type":"text","text":" "},{"type":"text","text":"reset to zero; a misplaced tempo or time-signature event is moved to"},{"type":"text","text":" "},{"type":"text","text":"track 0 at its original tick."}],"type":"paragraph"},{"inlineContent":[{"text":"This clears every ","type":"text"},{"identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFValidator\/Issue","isActive":true,"type":"reference"},{"text":" case that has a mechanical","type":"text"},{"text":" ","type":"text"},{"text":"fix, so a normalized sequence has no validation issues arising from","type":"text"},{"text":" ","type":"text"},{"text":"them. Issues that require a judgment call (such as","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFValidator\/Issue\/unencodableText(trackIndex:)","isActive":true,"type":"reference"},{"text":") are left to","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFValidator"},{"type":"text","text":"."}],"type":"paragraph"}]}],"kind":"symbol","sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/IvorSMF\/documentation\/IvorSMF","doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFNormalizer"]]},"abstract":[{"type":"text","text":"Returns a copy of the provided sequence normalized to canonical form,"},{"type":"text","text":" "},{"type":"text","text":"along with an array describing each change applied."}],"variants":[{"paths":["\/documentation\/ivorsmf\/smfnormalizer\/normalize(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"modules":[{"name":"IvorSMF"}],"role":"symbol","title":"normalize(_:)","roleHeading":"Instance Method","symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"normalize"},{"text":"(","kind":"text"},{"text":"SMFSequence","preciseIdentifier":"s:7IvorSMF11SMFSequenceV","kind":"typeIdentifier"},{"text":") -> (","kind":"text"},{"kind":"typeIdentifier","text":"SMFSequence","preciseIdentifier":"s:7IvorSMF11SMFSequenceV"},{"kind":"text","text":", ["},{"kind":"typeIdentifier","text":"Change","preciseIdentifier":"s:7IvorSMF13SMFNormalizerV6ChangeO"},{"kind":"text","text":"])"}],"extendedModule":"IvorSMF","externalID":"s:7IvorSMF13SMFNormalizerV9normalizeyAA11SMFSequenceV_SayAC6ChangeOGtAFF"},"identifier":{"url":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFNormalizer\/normalize(_:)","interfaceLanguage":"swift"},"references":{"doc://IvorSMF/documentation/IvorSMF":{"identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF","type":"topic","kind":"symbol","role":"collection","abstract":[{"type":"text","text":"A Standard MIDI Files parser, normalizer, validator, and formatter."}],"title":"IvorSMF","url":"\/documentation\/ivorsmf"},"doc://IvorSMF/documentation/IvorSMF/SMFSequence/isNormalized":{"kind":"symbol","url":"\/documentation\/ivorsmf\/smfsequence\/isnormalized","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"isNormalized"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"abstract":[{"text":"A Boolean value indicating whether this sequence has been normalized","type":"text"},{"text":" ","type":"text"},{"text":"via ","type":"text"},{"identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFNormalizer\/normalize(_:)","isActive":true,"type":"reference"},{"text":".","type":"text"}],"identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFSequence\/isNormalized","title":"isNormalized"},"doc://IvorSMF/documentation/IvorSMF/SMFValidator":{"url":"\/documentation\/ivorsmf\/smfvalidator","type":"topic","role":"symbol","kind":"symbol","title":"SMFValidator","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SMFValidator"}],"navigatorTitle":[{"kind":"identifier","text":"SMFValidator"}],"a