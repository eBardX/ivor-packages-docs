nd":"text"},{"text":"isNormalized","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"title":"isNormalized","type":"topic","url":"\/documentation\/ivorsmf\/smfsequence\/isnormalized","role":"symbol","abstract":[{"type":"text","text":"A Boolean value indicating whether this sequence has been normalized"},{"type":"text","text":" "},{"type":"text","text":"via "},{"identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFNormalizer\/normalize(_:)","isActive":true,"type":"reference"},{"type":"text","text":"."}]},"doc://IvorSMF/documentation/IvorSMF/SMFValidator/Issue":{"kind":"symbol","identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFValidator\/Issue","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Issue"}],"title":"SMFValidator.Issue","type":"topic","url":"\/documentation\/ivorsmf\/smfvalidator\/issue","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Issue"}],"abstract":[{"type":"text","text":"An issue found when validating an "},{"identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFSequence","type":"reference","isActive":true},{"type":"text","text":" against the Standard"},{"type":"text","text":" "},{"type":"text","text":"MIDI Files specification."}]},"doc://IvorSMF/documentation/IvorSMF":{"kind":"symbol","identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF","url":"\/documentation\/ivorsmf","type":"topic","role":"collection","abstract":[{"type":"text","text":"A Standard MIDI Files parser, normalizer, validator, and formatter."}],"title":"IvorSMF"},"doc://IvorSMF/documentation/IvorSMF/SMFSequence":{"kind":"symbol","identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFSequence","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SMFSequence","kind":"identifier"}],"title":"SMFSequence","type":"topic","url":"\/documentation\/ivorsmf\/smfsequence","role":"symbol","navigatorTitle":[{"text":"SM