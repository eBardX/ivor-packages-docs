{"abstract":[{"type":"text","text":"Returns a copy of the provided sequence normalized to canonical form,"},{"type":"text","text":" "},{"type":"text","text":"along with an array describing each change applied."}],"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","identifier":{"url":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFNormalizer\/normalize(_:)","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/IvorSMF\/documentation\/IvorSMF","doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFNormalizer"]]},"metadata":{"externalID":"s:7IvorSMF13SMFNormalizerV9normalizeyAA11SMFSequenceV_SayAC6ChangeOGtAFF","title":"normalize(_:)","roleHeading":"Instance Method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"normalize","kind":"identifier"},{"text":"(","kind":"text"},{"text":"SMFSequence","kind":"typeIdentifier","preciseIdentifier":"s:7IvorSMF11SMFSequenceV"},{"text":") -> (","kind":"text"},{"text":"SMFSequence","kind":"typeIdentifier","preciseIdentifier":"s:7IvorSMF11SMFSequenceV"},{"text":", [","kind":"text"},{"text":"Change","kind":"typeIdentifier","preciseIdentifier":"s:7IvorSMF13SMFNormalizerV6ChangeO"},{"text":"])","kind":"text"}],"symbolKind":"method","extendedModule":"IvorSMF","modules":[{"name":"IvorSMF"}],"role":"symbol"},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"normalize","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"sequence","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"SMFSequence","kind":"typeIdentifier","identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFSequence","preciseIdentifier":"s:7IvorSMF11SMFSequenceV"},{"kind":"text","text":") -> ("},{"preciseIdentifier":"s:7IvorSMF11SMFSequenceV","identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFSequence","kind":"typeIdentifier","text":"SMFSequence"},{"kind":"text","text":", ["},{"preciseIdentifier":"s:7IvorSMF13SMFNormalizerV6ChangeO","identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFNormalizer\/Change","kind":"typeIdentifier","text":"Change"},{"kind":"text","text":"])"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The sequence to normalize.","type":"text"}]}],"name":"sequence"}]},{"content":[{"type":"heading","anchor":"return-value","text":"Return Value","level":2},{"inlineContent":[{"type":"text","text":"A tuple of a new "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFSequence"},{"type":"text","text":" whose"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFSequence\/isNormalized"},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":", and an array of"},{"type":"text","text":" "},{"identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFNormalizer\/Change","isActive":true,"type":"reference"},{"text":" values describing each normalization applied.","type":"text"}],"type":"paragraph"}],"kind":"content"},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"Normalization is idempotent: calling "},{"type":"codeVoice","code":"normalize(_:)"},{"type":"text","text":" on an"},{"text":" ","type":"text"},{"text":"already-normalized sequence returns it immediately with an empty","type":"text"},{"text":" ","type":"text"},{"text":"changes array.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Canonical form requires each track to have exactly one End-of-Track"},{"text":" ","type":"text"},{"text":"meta-event, as the final event, at a tick greater than or equal to","type":"text"},{"text":" ","type":"text"},{"text":"every other event in the track. Each track is mechanically and","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"data-preservingly brought into this form: all End-of-Track events are"},{"text":" ","type":"text"},{"text":"removed, then a single End-of-Track is appended at the maximum","type":"text"},{"text":" ","type":"text"},{"text":"remaining event tick (or tick zero if the track is otherwise empty).","type":"text"},{"text":" ","type":"text"},{"text":"No musical events are ever dropped.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Canonical form also requires a format-0 sequence to have exactly one","type":"text"},{"text":" ","type":"text"},{"text":"track. A format-0 sequence with more than one track is reinterpreted","type":"text"},{"text":" ","type":"text"},{"text":"as format 1, which has no such restriction.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Canonical form also requires that, within a track, a sequence-number"},{"type":"text","text":" "},{"text":"meta-event appear at time zero, and that, in a format-1 sequence with","type":"text"},{"text":" ","type":"text"},{"text":"more than one track, tempo and time-signature meta-events appear only","type":"text"},{"text":" ","type":"text"},{"text":"in the first track. A misplaced sequence-number event has its time","type":"text"},{"text":" ","type":"text"},{"text":"reset to zero; a misplaced tempo or time-signature event is moved to","type":"text"},{"text":" ","type":"text"},{"text":"track 0 at its original tick.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"This clears every ","type":"text"},{"type":"reference","identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFValidator\/Issue","isActive":true},{"type":"text","text":" case that has a mechanical"},{"type":"text","text":" "},{"type":"text","text":"fix, so a normalized sequence has no validation issues arising from"},{"type":"text","text":" "},{"type":"text","text":"them. Issues that require a judgment call (such as"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFValidator\/Issue\/unencodableText(trackIndex:)","isActive":true},{"type":"text","text":") are left to"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFValidator","isActive":true},{"type":"text","text":"."}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/ivorsmf\/smfnormalizer\/normalize(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://IvorSMF/documentation/IvorSMF/SMFValidator/Issue/unencodableText(trackIndex:)":{"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"unencodableText"},{"kind":"text","text":"("},{"kind":"externalParam","text":"trackIndex"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":")"}],"role":"symbol","title":"SMFValidator.Issue.unencodableText(trackIndex:)","identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFValidator\/Issue\/unencodableText(trackIndex:)","url":"\/documentation\/ivorsmf\/smfvalidator\/issue\/unencodabletext(trackindex:)","abstract":[{"type":"text","text":"A meta-event in this track carries text with one or more characters"},{"type":"text","text":" "},{"type":"text","text":"that cannot be encoded as single-byte SMF text."}],"type":"topic","kind":"symbol"},"doc://IvorSMF/documentation/IvorSMF/SMFSequence":{"role":"symbol","kind":"symbol","title":"SMFSequence","url":"\/documentation\/ivorsmf\/smfsequence","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SMFSequence","kind":"identifier"}],"navigatorTitle":[{"text":"SMFSequence","kind":"identifier"}],"abstract":[{"type":"text","text":"An SMF sequence consisting of a format identifier, a time division,"},{"type":"text","text":" "},{"type":"text","text":"and one or more tracks."}],"identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFSequence"},"doc://IvorSMF/documentation/IvorSMF":{"role":"collection","title":"IvorSMF","identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF","url":"\/documentation\/ivorsmf","abstract":[{"text":"A Standard MIDI Files parser, normalizer, validator, and formatter.","type":"text"}],"type":"topic","kind":"symbol"},"doc://IvorSMF/documentation/IvorSMF/SMFSequence/isNormalized":{"url":"\/documentation\/ivorsmf\/smfsequence\/isnormalized","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isNormalized","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"type":"topic","abstract":[{"type":"text","text":"A Boolean value indicating whether this sequence has been normalized"},{"type":"text","text":" "},{"type":"text","text":"via "},{"type":"reference","identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFNormalizer\/normalize(_:)","isActive":true},{"text":".","type":"text"}],"kind":"symbol","role":"symbol","title":"isNormalized","identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFSequence\/isNormalized"},"doc://IvorSMF/documentation/IvorSMF/SMFValidator/Issue":{"fragments":[{"text":"enum","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"Issue"}],"type":"topic","identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFValidator\/Issue","url":"\/documentation\/ivorsmf\/smfvalidator\/issue","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"Issue","kind":"identifier"}],"abstract":[{"type":"text","text":"An issue found when validating an "},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFSequence"},{"type":"text","text":" against the Standard"},{"type":"text","text":" "},{"type":"text","text":"MIDI Files specification."}],"title":"SMFValidator.Issue"},"doc://IvorSMF/documentation/IvorSMF/SMFNormalizer/normalize(_:)":{"kind":"symbol","identifier":"doc:\/\/IvorSMF\/docu