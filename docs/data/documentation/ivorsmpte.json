{"abstract":[{"text":"SMPTE timecode, frame rate, and timecode conversion types.","type":"text"}],"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The IvorSMPTE framework provides SMPTE timecode and frame rate types written in"},{"type":"text","text":" "},{"type":"text","text":"Swift. A timecode is expressed in hours, minutes, seconds, frames, and"},{"type":"text","text":" "},{"type":"text","text":"hundredths of a frame at one of the standard frame rates: 23.976, 24, 25, 29.97"},{"type":"text","text":" "},{"type":"text","text":"(drop-frame or non-drop-frame), 30 (drop-frame or non-drop-frame), 50, 59.94"},{"type":"text","text":" "},{"type":"text","text":"(drop-frame or non-drop-frame), and 60 (drop-frame or non-drop-frame) frames per"},{"type":"text","text":" "},{"type":"text","text":"second. Timecodes can be parsed from and formatted as "},{"code":"HH:MM:SS:FF","type":"codeVoice"},{"type":"text","text":" strings, and"},{"type":"text","text":" "},{"type":"text","text":"converted to and from an exact number of seconds since midnight, with"},{"type":"text","text":" "},{"type":"text","text":"drop-frame numbering handled throughout. A timecode converter labels any"},{"type":"text","text":" "},{"type":"text","text":"timeline measured in seconds, such as wall-clock time, with timecode relative to"},{"type":"text","text":" "},{"type":"text","text":"a chosen start timecode."}]},{"syntax":"swift","code":["import IvorSMPTE","","\/\/ One hour exactly, at 25 frames per second.","let start = SMPTETime(frameRate: .fps25,","                      hour: 1,","                      minute: 0,","                      second: 0,","                      frame: 0,","                      subframe: 0)","","\/\/ Drop-frame timecode uses `;` before the frame number.","if let time = SMPTETime(string: \"01:00:03;12\",","                        frameRate: .fps2997Drop) {","    print(time.elapsedSeconds)  \/\/ 18016999\/5000 (about 3,603.4 seconds)","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"See "},{"identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/UsingIvorSMPTE","isActive":true,"type":"reference"},{"type":"text","text":" for a full guide to frame rates, timecodes, and"},{"type":"text","text":" "},{"type":"text","text":"timecode conversion."}]}],"kind":"content"}],"hierarchy":{"paths":[[]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE"},"metadata":{"color":{"standardColorIdentifier":"blue"},"roleHeading":"Framework","externalID":"IvorSMPTE","title":"IvorSMPTE","role":"collection","modules":[{"name":"IvorSMPTE"}],"symbolKind":"module"},"kind":"symbol","topicSections":[{"identifiers":["doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/UsingIvorSMPTE"],"anchor":"Guides","title":"Guides"},{"identifiers":["doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTETime","doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTEFrameRate"],"anchor":"Timecode","title":"Timecode"},{"identifiers":["doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTETimeConverter","doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTEExactSeconds"],"anchor":"Conversion","title":"Conversion"}],"variants":[{"paths":["\/documentation\/ivorsmpte"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://IvorSMPTE/documentation/IvorSMPTE/SMPTETime":{"type":"topic","url":"\/documentation\/ivorsmpte\/smptetime","identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTETime","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SMPTETime","kind":"identifier"}],"title":"SMPTETime","role":"symbol","abstract":[{"text":"A SMPTE timecode value specifying a point in time.","type":"text"}],"navigatorTitle":[{"text":"SMPTETime","kind":"identifier"}]},"doc://IvorSMPTE/documentation/IvorSMPTE