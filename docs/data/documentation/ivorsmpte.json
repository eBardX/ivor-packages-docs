{"hierarchy":{"paths":[[]]},"abstract":[{"type":"text","text":"SMPTE timecode, frame rate, and timecode conversion types."}],"identifier":{"url":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The IvorSMPTE framework provides SMPTE timecode and frame rate types written in"},{"type":"text","text":" "},{"type":"text","text":"Swift. A timecode is expressed in hours, minutes, seconds, frames, and"},{"type":"text","text":" "},{"type":"text","text":"hundredths of a frame at one of the standard frame rates: 23.976, 24, 25, 29.97"},{"type":"text","text":" "},{"type":"text","text":"(drop-frame or non-drop-frame), 30 (drop-frame or non-drop-frame), 50, 59.94"},{"type":"text","text":" "},{"type":"text","text":"(drop-frame or non-drop-frame), and 60 (drop-frame or non-drop-frame) frames per"},{"type":"text","text":" "},{"type":"text","text":"second. Timecodes can be parsed from and formatted as "},{"type":"codeVoice","code":"HH:MM:SS:FF"},{"type":"text","text":" strings, and"},{"type":"text","text":" "},{"type":"text","text":"converted to and from an exact number of seconds since midnight, with"},{"type":"text","text":" "},{"type":"text","text":"drop-frame numbering handled throughout. A timecode converter labels any"},{"type":"text","text":" "},{"type":"text","text":"timeline measured in seconds, such as wall-clock time, with timecode relative to"},{"type":"text","text":" "},{"type":"text","text":"a chosen start timecode."}]},{"type":"codeListing","syntax":"swift","code":["import IvorSMPTE","","\/\/ One hour exactly, at 25 frames per second.","let start = SMPTETime(frameRate: .fps25,","                      hour: 1,","                      minute: 0,","                      second: 0,","                      frame: 0,","                      subframe: 0)","","\/\/ Drop-frame timecode uses `;` before the frame number.","if let time = SMPTETime(string: \"01:00:03;12\",","                        frameRate: .fps2997Drop) {","    print(time.elapsedSeconds)  \/\/ 18016999\/5000 (about 3,603.4 seconds)","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"See "},{"type":"reference","identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/UsingIvorSMPTE","isActive":true},{"type":"text","text":" for a full guide to frame rates, timecodes, and"},{"type":"text","text":" "},{"type":"text","text":"timecode conversion."}]}]}],"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"topicSections":[{"title":"Guides","identifiers":["doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/UsingIvorSMPTE"],"anchor":"Guides"},{"title":"Timecode","identifiers":["doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTETime","doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTEFrameRate"],"anchor":"Timecode"},{"title":"Conversion","identifiers":["doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTETimeConverter","doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTEExactSeconds"],"anchor":"Conversion"}],"metadata":{"symbolKind":"module","modules":[{"name":"IvorSMPTE"}],"role":"collection","color":{"standardColorIdentifier":"blue"},"title":"IvorSMPTE","roleHeading":"Framework","externalID":"IvorSMPTE"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivorsmpte"]}],"kind":"symbol","references":{"doc://IvorSMPTE/documentation/IvorSMPTE/SMPTETimeConverter":{"abstract":[{"type":"text","text":"A type that converts between SMPTE timecode and an exact number of seconds"},{"type":"text","text":" "},{"type":"text","text":"from a starting timecode."}],"url":"\/documentation\/ivorsmpte\/smptetimeconverter","identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTETimeConverter","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SMPTETimeConverter"}]