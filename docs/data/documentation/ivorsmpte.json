{"sections":[],"metadata":{"symbolKind":"module","externalID":"IvorSMPTE","roleHeading":"Framework","role":"collection","modules":[{"name":"IvorSMPTE"}],"color":{"standardColorIdentifier":"blue"},"title":"IvorSMPTE"},"kind":"symbol","schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"text":"SMPTE timecode, frame rate, and timecode conversion types.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivorsmpte"]}],"identifier":{"url":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE","interfaceLanguage":"swift"},"hierarchy":{"paths":[[]]},"topicSections":[{"identifiers":["doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/UsingIvorSMPTE"],"title":"Guides","anchor":"Guides"},{"identifiers":["doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTETime","doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTEFrameRate"],"title":"Timecode","anchor":"Timecode"},{"identifiers":["doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTETimeConverter","doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTEExactSeconds"],"title":"Conversion","anchor":"Conversion"}],"primaryContentSections":[{"content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"The IvorSMPTE framework provides SMPTE timecode and frame rate types written in"},{"type":"text","text":" "},{"type":"text","text":"Swift. A timecode is expressed in hours, minutes, seconds, frames, and"},{"type":"text","text":" "},{"type":"text","text":"hundredths of a frame at one of the standard frame rates: 23.976, 24, 25, 29.97"},{"type":"text","text":" "},{"type":"text","text":"(drop-frame or non-drop-frame), 30 (drop-frame or non-drop-frame), 50, 59.94"},{"type":"text","text":" "},{"type":"text","text":"(drop-frame or non-drop-frame), and 60 (drop-frame or non-drop-frame) frames per"},{"type":"text","text":" "},{"type":"text","text":"second. Timecodes can be parsed from and formatted as "},{"type":"codeVoice","code":"HH:MM:SS:FF"},{"type":"text","text":" strings, and"},{"type":"text","text":" "},{"type":"text","text":"converted to and from an exact number of seconds since midnight, with"},{"type":"text","text":" "},{"type":"text","text":"drop-frame numbering handled throughout. A timecode converter labels any"},{"type":"text","text":" "},{"type":"text","text":"timeline measured in seconds, such as wall-clock time, with timecode relative to"},{"type":"text","text":" "},{"type":"text","text":"a chosen start timecode."}],"type":"paragraph"},{"syntax":"swift","code":["import IvorSMPTE","","\/\/ One hour exactly, at 25 frames per second.","let start = SMPTETime(frameRate: .fps25,","                      hour: 1,","                      minute: 0,","                      second: 0,","                      frame: 0,","                      subframe: 0)","","\/\/ Drop-frame timecode uses `;` before the frame number.","if let time = SMPTETime(string: \"01:00:03;12\",","                        frameRate: .fps2997Drop) {","    print(time.elapsedSeconds)  \/\/ 18016999\/5000 (about 3,603.4 seconds)","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"See "},{"isActive":true,"identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/UsingIvorSMPTE","type":"reference"},{"type":"text","text":" for a full guide to frame rates, timecodes, and"},{"type":"text","text":" "},{"type":"text","text":"timecode conversion."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://IvorSMPTE/documentation/IvorSMPTE/SMPTETimeConverter":{"kind":"symbol","type":"topic","title":"SMPTETimeConverter","identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTETimeConverter","url":"\/documentation\/ivorsmpte\/smptetimeconverter","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"text":"SMPTETimeConverter","kind":"identifier"}],"navigatorTitle":[{"text":"SMPTETimeConverter","kind":"identifier"}],"role":"symbol","abstract":[{"type":"text","text":"A type that converts between SMPTE timecode and an exact number of seconds"},{"type":"text","text":" "},{"text":"from a starting timecode.","type":"text"}]},"doc://IvorSMPTE/documentation/IvorSMPTE/SMPTEExactSeconds":{"type":"topic","navigatorTitle":[{"text":"SMPTEExactSeconds","kind":"identifier"}],"kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SMPTEExactSeconds","kind":"identifier"}],"url":"\/documentation\/ivorsmpte\/smpteexactseconds","title":"SMPTEExactSeconds","abstract":[{"text":"An exact, non-negative number of seconds.","type":"text"}],"identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTEExactSeconds"},"doc://IvorSMPTE/documentation/IvorSMPTE":{"kind":"symbol","url":"\/documentation\/ivorsmpte","abstract":[{"text":"SMPTE timecode, frame rate, and timecode conversion types.","type":"text"}],"identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE","role":"collection","title":"IvorSMPTE","type":"topic"},"doc://IvorSMPTE/documentation/IvorSMPTE/SMPTEFrameRate":{"type":"topic","navigatorTitle":[{"text":"SMPTEFrameRate","kind":"identifier"}],"kind":"symbol","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SMPTEFrameRate","kind":"identifier"}],"url":"\/documentation\/ivorsmpte\/smpteframerate","title":"SMPTEFrameRate","abstract":[{"text":"A SMPTE frame rate.","type":"text"}],"identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTEFrameRate"},"doc://IvorSMPTE/documentation/IvorSMPTE/UsingIvorSMPTE":{"kind":"article","type":"topic","title":"Using IvorSMPTE","identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/UsingIvorSMPTE","url":"\/documentation\/ivorsmpte\/usingivorsmpte","role":"article","abstract":[{"text":"Represent SMPTE timecode at any standard frame rate, and convert it to and from","type":"text"},{"text":" ","type":"text"},{"text":"an exact number of seconds.","type":"text"}]},"doc://IvorSMPTE/documentation/IvorSMPTE/SMPTETime":{"kind":"symbol","type":"topic","title":"SMPTETime","identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTETime","url":"\/documentation\/ivorsmpte\/smptetime","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SMPTETime"}],"navigatorTitle":[{"kind":"identifier","text":"SMPTETime"}],"role":"symbol","abstract":[{"text":"A SMPTE timecode value specifying a point in time.","type":"text"}]}}}