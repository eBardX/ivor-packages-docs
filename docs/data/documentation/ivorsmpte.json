{"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The IvorSMPTE framework provides SMPTE timecode and frame rate types written in"},{"type":"text","text":" "},{"type":"text","text":"Swift. A timecode is expressed in hours, minutes, seconds, frames, and"},{"type":"text","text":" "},{"type":"text","text":"hundredths of a frame at one of the standard frame rates: 23.976, 24, 25, 29.97"},{"type":"text","text":" "},{"type":"text","text":"(drop-frame or non-drop-frame), 30 (drop-frame or non-drop-frame), 50, 59.94"},{"type":"text","text":" "},{"type":"text","text":"(drop-frame or non-drop-frame), and 60 (drop-frame or non-drop-frame) frames per"},{"type":"text","text":" "},{"type":"text","text":"second. Timecodes can be parsed from and formatted as "},{"type":"codeVoice","code":"HH:MM:SS:FF"},{"type":"text","text":" strings, and"},{"type":"text","text":" "},{"type":"text","text":"converted to and from an exact number of seconds since midnight, with"},{"type":"text","text":" "},{"type":"text","text":"drop-frame numbering handled throughout. A timecode converter labels any"},{"type":"text","text":" "},{"type":"text","text":"timeline measured in seconds, such as wall-clock time, with timecode relative to"},{"type":"text","text":" "},{"type":"text","text":"a chosen start timecode."}]},{"type":"codeListing","code":["import IvorSMPTE","","\/\/ One hour exactly, at 25 frames per second.","let start = SMPTETime(frameRate: .fps25,","                      hour: 1,","                      minute: 0,","                      second: 0,","                      frame: 0,","                      subframe: 0)","","\/\/ Drop-frame timecode uses `;` before the frame number.","if let time = SMPTETime(string: \"01:00:03;12\",","                        frameRate: .fps2997Drop) {","    print(time.elapsedSeconds)  \/\/ 18016999\/5000 (about 3,603.4 seconds)","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"See "},{"identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/UsingIvorSMPTE","isActive":true,"type":"reference"},{"type":"text","text":" for a full guide to frame rates, timecodes, and"},{"type":"text","text":" "},{"type":"text","text":"timecode conversion."}]}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE"},"metadata":{"title":"IvorSMPTE","modules":[{"name":"IvorSMPTE"}],"roleHeading":"Framework","role":"collection","externalID":"IvorSMPTE","symbolKind":"module","color":{"standardColorIdentifier":"blue"}},"kind":"symbol","schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivorsmpte"]}],"topicSections":[{"anchor":"Guides","identifiers":["doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/UsingIvorSMPTE"],"title":"Guides"},{"anchor":"Timecode","identifiers":["doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTETime","doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTEFrameRate"],"title":"Timecode"},{"anchor":"Conversion","identifiers":["doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTETimeConverter","doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTEExactSeconds"],"title":"Conversion"}],"sections":[],"hierarchy":{"paths":[[]]},"abstract":[{"type":"text","text":"SMPTE timecode, frame rate, and timecode conversion types."}],"references":{"doc://IvorSMPTE/documentation/IvorSMPTE/SMPTETimeConverter":{"kind":"symbol","title":"SMPTETimeConverter","role":"symbol","identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTETimeConverter","abstract":[{"type":"text","text":"A type that converts between SMPTE timecode and an exact number of seconds"},{"text":" ","type":"text"},{"text":"from a starting timecode.","type":"text"}],"type":"topic","url":"\/documentation\/ivorsmpte\/smptetimeconverter","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SMPTETimeConverter","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"SMPTETimeConverter"}]},"doc://IvorSMPTE/documentation/IvorSMPTE":{"url":"\/documentation\/ivorsmpte","abstract":[{"text":"SMPTE timecode, frame rate, and timecode conversion types.","type":"text"}],"kind":"symbol","title":"IvorSMPTE","role":"collection","identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE","type":"topic"},"doc://IvorSMPTE/documentation/IvorSMPTE/SMPTEFrameRate":{"url":"\/documentation\/ivorsmpte\/smpteframerate","abstract":[{"text":"A SMPTE frame rate.","type":"text"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"SMPTEFrameRate"}],"navigatorTitle":[{"text":"SMPTEFrameRate","kind":"identifier"}],"kind":"symbol","title":"SMPTEFrameRate","role":"symbol","identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTEFrameRate","type":"topic"},"doc://IvorSMPTE/documentation/IvorSMPTE/SMPTEExactSeconds":{"kind":"symbol","title":"SMPTEExactSeconds","role":"symbol","abstract":[{"type":"text","text":"An exact, non-negative number of seconds."}],"identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTEExactSeconds","type":"topic","url":"\/documentation\/ivorsmpte\/smpteexactseconds","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SMPTEExactSeconds"}],"navigatorTitle":[{"kind":"identifier","text":"SMPTEExactSeconds"}]},"doc://IvorSMPTE/documentation/IvorSMPTE/SMPTETime":{"title":"SMPTETime","navigatorTitle":[{"kind":"identifier","text":"SMPTETime"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SMPTETime"}],"role":"symbol","type":"topic","kind":"symbol","url":"\/documentation\/ivorsmpte\/smptetime","identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTETime","abstract":[{"type":"text","text":"A SMPTE timecode value specifying a point in time."}]},"doc://IvorSMPTE/documentation/Iv