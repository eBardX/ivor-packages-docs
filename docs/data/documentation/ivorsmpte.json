{"identifier":{"url":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"SMPTE timecode, frame rate, and timecode conversion types."}],"topicSections":[{"anchor":"Timecode","title":"Timecode","identifiers":["doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTETime","doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTEFrameRate"]},{"anchor":"Conversion","title":"Conversion","identifiers":["doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTETimeConverter","doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTEExactSeconds"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivorsmpte"]}],"sections":[],"hierarchy":{"paths":[[]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"text":"The IvorSMPTE framework provides SMPTE timecode and frame rate types written in","type":"text"},{"text":" ","type":"text"},{"text":"Swift. A timecode is expressed in hours, minutes, seconds, frames, and","type":"text"},{"text":" ","type":"text"},{"text":"hundredths of a frame at one of the standard frame rates: 23.976, 24, 25, 29.97","type":"text"},{"text":" ","type":"text"},{"text":"(drop-frame or non-drop-frame), 30 (drop-frame or non-drop-frame), 50, 59.94","type":"text"},{"text":" ","type":"text"},{"text":"(drop-frame or non-drop-frame), and 60 (drop-frame or non-drop-frame) frames per","type":"text"},{"text":" ","type":"text"},{"text":"second. Timecodes can be parsed from and formatted as","type":"text"},{"text":" ","type":"text"},{"code":"HH:MM:SS:FF","type":"codeVoice"},{"text":" strings, and converted to and from an exact number of seconds","type":"text"},{"text":" ","type":"text"},{"text":"since midnight, with drop-frame numbering handled throughout. A timecode","type":"text"},{"text":" ","type":"text"},{"text":"converter labels any timeline measured in seconds, such as wall-clock time, with","type":"text"},{"text":" ","type":"text"},{"text":"timecode relative to a chosen start timecode.","type":"text"}],"type":"paragraph"},{"code":["import IvorSMPTE","","\/\/ One hour exactly, at 25 frames per second.","let start = SMPTETime(frameRate: .fps25,","                      hour: 1,","                      minute: 0,","                      second: 0,","                      frame: 0,","                      subframe: 0)","","\/\/ Drop-frame timecode uses `;` before the frame number.","if let time = SMPTETime(string: \"01:00:03;12\",","                        frameRate: .fps2997Drop) {","    print(time.elapsedSeconds)  \/\/ 18016999\/5000 (about 3,603.4 seconds)","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Every public type is a "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":" value type, so instances can be freely shared"},{"type":"text","text":" "},{"type":"text","text":"across tasks and actor boundaries."}],"type":"paragraph"}],"kind":"content"}],"metadata":{"roleHeading":"Framework","modules":[{"name":"IvorSMPTE"}],"role":"collection","title":"IvorSMPTE","externalID":"IvorSMPTE","symbolKind":"module","color":{"standardColorIdentifier":"blue"}},"references":{"doc://IvorSMPTE/documentation/IvorSMPTE/SMPTEExactSeconds":{"identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTEExactSeconds","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SMPTEExactSeconds","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivorsmpte\/smpteexactseconds","title":"SMPTEExactSeconds","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"SMPTEExactSeconds","kind":"identifier"}],"abstract":[{"text":"An exact, non-negative number of seconds.","type":"text"}]},"doc://IvorSMPTE/documentation/IvorSMPTE/SMPTETime":{"identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTETime","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SMPTETime","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivorsmpte\/smptetime","title":"SMPTETime","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"SMPTETime","kind":"identifier"}],"abstract":[{"text":"A SMPTE timecode value specifying a point in time.","type":"text"}]},"doc://IvorSMPTE/documentation/IvorSMPTE/SMPTEFrameRate":{"role":"symbol","type":"topic","title":"SMPTEFrameRate","url":"\/documentation\/ivorsmpte\/smpteframerate","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SMPTEFrameRate","kind":"identifier"}],"abstract":[{"text":"A SMPTE frame rate.","type":"text"}],"identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTEFrameRate","kind":"symbol","navigatorTitle":[{"text":"SMPTEFrameRate","kind":"identifier"}]},"doc://IvorSMPTE/documentation/IvorSMPTE":{"identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE","type":"topic","url":"\/documentation\/ivorsmpte","title":"IvorSMPTE","role":"collection","kind":"symbol","abstract":[{"text":"SMPTE timecode, frame rate, and timecode conversion types.","type":"text"}]},"doc://IvorSMPTE/documentation/IvorSMPTE/SMPTETimeConverter":{"identifier":"doc:\/\/IvorSMPTE\/documentation\/IvorSMPTE\/SMPTETimeConverter","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SMPTETimeConverter","kind":"identifier"}],"type":"topic","url":"\/documentation\/ivorsmpte\/smptetimeconverter","title":"SMPTETimeConverter","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"SMPTETimeConverter","kind":"identifier"}],"abstract":[{"text":"A type that converts between SMPTE timecode and an exact number of seconds","type":"text"},{"text":" ","type":"text"},{"text":"from a starting timecode.","type":"text"}]}}}