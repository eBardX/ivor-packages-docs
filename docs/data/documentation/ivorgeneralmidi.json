{"hierarchy":{"paths":[[]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The IvorGeneralMIDI framework provides the "},{"type":"reference","isActive":true,"identifier":"https:\/\/midi.org\/general-midi"},{"type":"text","text":" and General MIDI 2 sound sets as Swift"},{"type":"text","text":" "},{"type":"text","text":"enumerations. For General MIDI 1: the 128 instruments that a program change"},{"type":"text","text":" "},{"type":"text","text":"selects, the 16 instrument families they fall into, and the 47 sounds of the"},{"type":"text","text":" "},{"type":"text","text":"percussion key map. For General MIDI 2: the 256 instruments that a bank select"},{"type":"text","text":" "},{"type":"text","text":"and program change select, the 9 drum sets, and the 61 sounds of the extended"},{"type":"text","text":" "},{"type":"text","text":"percussion key map. Each sound can be looked up by its program, bank, or note,"},{"type":"text","text":" "},{"type":"text","text":"or by its name as the specification gives it, and converted back again."},{"type":"text","text":" "},{"type":"text","text":"Programs, notes, and channels use the"},{"type":"text","text":" "},{"identifier":"https:\/\/github.com\/eBardX\/IvorMIDI","type":"reference","isActive":true},{"type":"text","text":" data value types, and"},{"type":"text","text":" "},{"identifier":"doc:\/\/IvorGeneralMIDI\/documentation\/IvorGeneralMIDI\/GMMessage","type":"reference","isActive":true},{"type":"text","text":" covers the system exclusive messages that turn General MIDI on and"},{"type":"text","text":" "},{"type":"text","text":"off, and the General MIDI 2 effects and controllers."}]},{"syntax":"swift","code":["import IvorGeneralMIDI","","let guitar = GM1Instrument(program: 25)","","guitar              \/\/ .acousticGuitarNylon","guitar.name         \/\/ \"Acoustic Guitar (nylon)\"","guitar.family       \/\/ .guitar","","\/\/ Name lookup ignores case and extra whitespace.","let snare = GM1PercussionSound(name: \"acoustic snare\")","","snare?.note         \/\/ 38","GM1PercussionSound.channel  \/\/ 10","","\/\/ A General MIDI 2 variation falls back to its General MIDI 1 instrument.","let ukulele = GM2Instrument(bankLSB: 1, program: 25)","","ukulele?.name           \/\/ \"Ukulele\"","ukulele?.gm1Instrument  \/\/ .acousticGuitarNylon","GM2Instrument.bankMSB   \/\/ 121","","\/\/ Bank select MSB 121, bank select LSB 1, then program change 25.","let messages = ukulele?.selectionMessages(channel: 1)","","GMMessage(content: .gm2SystemOn).systemMessage  \/\/ F0 7E 7F 09 03 F7"],"type":"codeListing"},{"inlineContent":[{"text":"See ","type":"text"},{"isActive":true,"identifier":"doc:\/\/IvorGeneralMIDI\/documentation\/IvorGeneralMIDI\/UsingIvorGeneralMIDI","type":"reference"},{"text":" for a full guide to the instruments, drum sets,","type":"text"},{"text":" ","type":"text"},{"text":"percussion sounds, and General MIDI 2 effects and controllers.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorGeneralMIDI\/documentation\/IvorGeneralMIDI"},"metadata":{"externalID":"IvorGeneralMIDI","roleHeading":"Framework","modules":[{"name":"IvorGeneralMIDI"}],"role":"collection","title":"IvorGeneralMIDI","symbolKind":"module","color":{"standardColorIdentifier":"blue"}},"topicSections":[{"identifiers":["doc:\/\/IvorGeneralMIDI\/documentation\/IvorGeneralMIDI\/UsingIvorGeneralMIDI"],"anchor":"Guides","title":"Guides"},{"identifiers":["doc:\/\/IvorGeneralMIDI\/documentation\/IvorGeneralMIDI\/GMMessage"],"anchor":"Messages","title":"Messages"},{"identifiers":["doc:\/\/IvorGeneralMIDI\/documentation\/IvorGeneralMIDI\/GM1Instrument","doc:\/\/IvorGeneralMIDI\/documentation\/IvorGeneralMIDI\/GM1InstrumentFamily","doc:\/\/IvorGeneralMIDI\/documentation\/IvorGeneralMIDI\/GM1PercussionS