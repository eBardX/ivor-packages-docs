neral MIDI 1 instrument.","let ukulele = GM2Instrument(bankLSB: 1, program: 25)","","ukulele?.name           \/\/ \"Ukulele\"","ukulele?.gm1Instrument  \/\/ .acousticGuitarNylon","GM2Instrument.bankMSB   \/\/ 121","","\/\/ Bank select MSB 121, bank select LSB 1, then program change 25 — the","\/\/ messages that select `ukulele?.patch`.","let messages = ukulele?.selectionMessages(channel: 1)","","MIDISystemMessage.gm2SystemOn  \/\/ F0 7E 7F 09 03 F7"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Every public type is a ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":" value type, so instances can be freely shared","type":"text"},{"text":" ","type":"text"},{"text":"across tasks and actor boundaries.","type":"text"}]}]}],"hierarchy":{"paths":[[]]},"references":{"doc://IvorGeneralMIDI/documentation/IvorGeneralMIDI/GM2ControllerDestination":{"type":"topic","abstract":[{"type":"text","text":"A General MIDI 2 (GM2) controller destination and its range: a sound"},{"type":"text","text":" "},{"type":"text","text":"parameter that a controller destination setting message assigns to"},{"type":"text","text":" "},{"type":"text","text":"channel pressure or a control change, and how strongly it responds."}],"url":"\/documentation\/ivorgeneralmidi\/gm2controllerdestination","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"GM2ControllerDestination"}],"kind":"symbol","title":"GM2ControllerDestination","role":"symbol","identifier":"doc:\/\/IvorGeneralMIDI\/documentation\/IvorGeneralMIDI\/GM2ControllerDestination","navigatorTitle":[{"kind":"identifier","text":"GM2ControllerDestination"}]},"doc://IvorGeneralMIDI/documentation/IvorGeneralMIDI/GM2DrumSet":{"abstract":[{"type":"text","text":"A General MIDI 2 (GM2) drum set: one of the 9 percussion kits that a"},{"type":"text","text":" "},{"type":"text","text":"bank select and program change select on a rhythm channel."}],"type":"topic","url":"\/documentati