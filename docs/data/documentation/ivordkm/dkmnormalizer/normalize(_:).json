{"abstract":[{"text":"Returns a copy of the provided score normalized to canonical form,","type":"text"},{"text":" ","type":"text"},{"text":"along with an array describing each change applied.","type":"text"}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"normalize","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"score","kind":"internalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7IvorDKM8DKMScoreV","text":"DKMScore","identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMScore","kind":"typeIdentifier"},{"text":") -> (","kind":"text"},{"preciseIdentifier":"s:7IvorDKM8DKMScoreV","text":"DKMScore","identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMScore","kind":"typeIdentifier"},{"text":", [","kind":"text"},{"preciseIdentifier":"s:7IvorDKM13DKMNormalizerV6ChangeO","text":"Change","identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMNormalizer\/Change","kind":"typeIdentifier"},{"text":"])","kind":"text"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The score to normalize."}],"type":"paragraph"}],"name":"score"}]},{"content":[{"text":"Return Value","level":2,"anchor":"return-value","type":"heading"},{"inlineContent":[{"text":"A tuple of a new ","type":"text"},{"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMScore","type":"reference","isActive":true},{"text":" whose ","type":"text"},{"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMScore\/isNormalized","type":"reference","isActive":true},{"text":" ","type":"text"},{"text":"is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":", and an array of ","type":"text"},{"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMNormalizer\/Change","type":"reference","isActive":true},{"text":" values describing","type":"text"},{"text":" ","type":"text"},{"text":"each normalization applied.","type":"text"}],"type":"paragraph"}],"kind":"content"},{"kind":"mentions","mentions":["doc:\/\/IvorDKM\/documentation\/IvorDKM\/UsingIvorDKM"]},{"content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"Normalization is idempotent: calling ","type":"text"},{"code":"normalize(_:)","type":"codeVoice"},{"text":" on an","type":"text"},{"text":" ","type":"text"},{"text":"already-normalized score returns it immediately with an empty changes","type":"text"},{"text":" ","type":"text"},{"text":"array.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Canonical form requires every command’s start beat to be stated","type":"text"},{"text":" ","type":"text"},{"text":"absolutely, and no command to restate a global setting already in","type":"text"},{"text":" ","type":"text"},{"text":"effect. A ","type":"text"},{"code":"\/Levels","type":"codeVoice"},{"text":" line whose start beat is negative is","type":"text"},{"text":" ","type":"text"},{"text":"rewritten to the beat the preceding ","type":"text"},{"code":"\/Levels","type":"codeVoice"},{"text":" line ended at","type":"text"},{"text":" ","type":"text"},{"text":"(matching ","type":"text"},{"code":"ProcessLevels","type":"codeVoice"},{"text":"’ ","type":"text"},{"code":"endBeat = 0","type":"codeVoice"},{"text":" initialization, for the","type":"text"},{"text":" ","type":"text"},{"text":"first such line in a score). A ","type":"text"},{"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMCommand\/haas(_:)","type":"reference","isActive":true},{"text":",","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMCommand\/tuning(_:)","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMCommand\/soundFileName(_:)","type":"reference","isActive":true},{"text":", or","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMCommand\/screenOut(_:)","type":"reference","isActive":true},{"text":" command that is byte-identical to the","type":"text"},{"text":" ","type":"text"},{"text":"value already in effect is dropped. Every other segment command’s","type":"text"},{"text":" ","type":"text"},{"text":"negative start beat, and every command’s negative duration, is","type":"text"},{"text":" ","type":"text"},{"text":"clamped to zero, mirroring the reference implementation’s","type":"text"},{"text":" ","type":"text"},{"code":"MyWarn","type":"codeVoice"},{"text":"-and-clamp recovery.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A negative start beat on a note (","type":"text"},{"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMCommand\/pitchesNote(_:)","type":"reference","isActive":true},{"text":",","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMCommand\/clipNote(_:)","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMCommand\/vocodeNote(_:)","type":"reference","isActive":true},{"text":") is left","type":"text"},{"text":" ","type":"text"},{"text":"alone: in the reference implementation it terminates the score rather","type":"text"},{"text":" ","type":"text"},{"text":"than requesting a repair, and clamping it would silently discard that","type":"text"},{"text":" ","type":"text"},{"text":"meaning.","type":"text"}],"type":"paragraph"},{"text":"Discussion","level":2,"anchor":"Discussion","type":"heading"},{"inlineContent":[{"text":"Several other repairs were considered and rejected:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Sorting commands by start beat.","type":"text"}],"type":"strong"},{"type":"text","text":" Command order is load-bearing —"},{"type":"text","text":" "},{"type":"text","text":"settings carry no beat of their own, mode commands are sticky, and"},{"type":"text","text":" "},{"type":"text","text":"reordering would churn the formatter’s section-header compression."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Dropping commands after ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMCommand\/end"},{"text":".","type":"text"}],"type":"strong"},{"type":"text","text":" Provably inert, but"},{"type":"text","text":" "},{"type":"text","text":"not worthless: parking material after "},{"type":"codeVoice","code":"\/End"},{"type":"text","text":" is a common"},{"type":"text","text":" "},{"type":"text","text":"convention. The "},{"inlineContent":[{"text":"resolver","type":"text"}],"type":"emphasis"},{"type":"text","text":", not the normalizer, treats "},{"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMCommand\/end","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"as a terminator."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Dropping comments.","type":"text"}],"type":"strong"},{"type":"text","text":" Lossy, for no gain."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Coalescing adjacent ramps.","type":"text"}],"type":"strong"},{"type":"text","text":" Buys nothing."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Padding ","type":"text"},{"type":"codeVoice","code":"\/GEQ"},{"text":" band gains out to 30.","type":"text"}],"type":"strong"},{"type":"text","text":" The missing values"},{"type":"text","text":" "},{"type":"text","text":"are unprovable; "},{"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMValidator","type":"reference","isActive":true},{"type":"text","text":" flags the short count instead of"},{"type":"text","text":" "},{"type":"text","text":"inventing data."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Clamping anything else.","type":"text"}],"type":"strong"},{"type":"text","text":" Every other repair the reference"},{"type":"text","text":" "},{"type":"text","text":"performs invents a value rather than restoring one, which is"},{"type":"text","text":" "},{"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMValidator","type":"reference","isActive":true},{"type":"text","text":"’s judgment call to make, not this method’s."}]}]}],"type":"unorderedList"}],"kind":"content"}],"kind":"symbol","metadata":{"modules":[{"name":"IvorDKM"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"normalize","kind":"identifier"},{"text":"(","kind":"text"},{"text":"DKMScore","preciseIdentifier":"s:7IvorDKM8DKMScoreV","kind":"typeIdentifier"},{"text":") -> (","kind":"text"},{"text":"DKMScore","preciseIdentifier":"s:7IvorDKM8DKMScoreV","kind":"typeIdentifier"},{"text":", [","kind":"text"},{"text":"Change","preciseIdentifier":"s:7IvorDKM13DKMNormalizerV6ChangeO","kind":"typeIdentifier"},{"text":"])","kind":"text"}],"symbolKind":"method","roleHeading":"Instance Method","role":"symbol","title":"normalize(_:)","externalID":"s:7IvorDKM13DKMNormalizerV9normalizeyAA8DKMScoreV_SayAC6ChangeOGtAFF","extendedModule":"IvorDKM"},"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMNormalizer\/normalize(_:)"},"sections":[],"variants":[{"paths":["\/documentation\/ivordkm\/dkmnormalizer\/normalize(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/IvorDKM\/documentation\/IvorDKM","doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMNormalizer"]]},"references":{"doc://IvorDKM/documentation/IvorDKM/DKMCommand/end":{"kind":"symbol","identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMCommand\/end","url":"\/documentation\/ivordkm\/dkmcommand\/end","type":"topic","abstract":[{"type":"text","text":"A command that 