{"hierarchy":{"paths":[["doc:\/\/IvorDKM\/documentation\/IvorDKM","doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMNormalizer"]]},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"normalize"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"score"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"DKMScore","identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMScore","preciseIdentifier":"s:7IvorDKM8DKMScoreV"},{"kind":"text","text":") -> ("},{"kind":"typeIdentifier","text":"DKMScore","identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMScore","preciseIdentifier":"s:7IvorDKM8DKMScoreV"},{"kind":"text","text":", ["},{"kind":"typeIdentifier","text":"Change","identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMNormalizer\/Change","preciseIdentifier":"s:7IvorDKM13DKMNormalizerV6ChangeO"},{"kind":"text","text":"])"}],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"name":"score","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The score to normalize."}]}]}],"kind":"parameters"},{"content":[{"level":2,"text":"Return Value","type":"heading","anchor":"return-value"},{"inlineContent":[{"type":"text","text":"A tuple of a new "},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMScore"},{"type":"text","text":" whose "},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMScore\/isNormalized"},{"type":"text","text":" "},{"type":"text","text":"is "},{"type":"codeVoice","code":"true"},{"type":"text","text":", and an array of "},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMNormalizer\/Change"},{"type":"text","text":" values describing"},{"type":"text","text":" "},{"type":"text","text":"each normalization applied."}],"type":"paragraph"}],"kind":"content"},{"mentions":["doc:\/\/IvorDKM\/documentation\/IvorDKM\/UsingIvorDKM"],"kind":"mentions"},{"content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"Normalization is idempotent: calling "},{"type":"codeVoice","code":"normalize(_:)"},{"type":"text","text":" on an"},{"type":"text","text":" "},{"type":"text","text":"already-normalized score returns it immediately with an empty changes"},{"type":"text","text":" "},{"type":"text","text":"array."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Canonical form requires every command’s start beat to be stated"},{"type":"text","text":" "},{"type":"text","text":"absolutely, and no command to restate a global setting already in"},{"type":"text","text":" "},{"type":"text","text":"effect. A "},{"type":"codeVoice","code":"`\/Levels`"},{"type":"text","text":" line whose start beat is negative is"},{"type":"text","text":" "},{"type":"text","text":"rewritten to the beat the preceding "},{"type":"codeVoice","code":"`\/Levels`"},{"type":"text","text":" line ended at"},{"type":"text","text":" "},{"type":"text","text":"(matching "},{"type":"codeVoice","code":"ProcessLevels"},{"type":"text","text":"’ "},{"type":"codeVoice","code":"endBeat = 0"},{"type":"text","text":" initialization, for the"},{"type":"text","text":" "},{"type":"text","text":"first such line in a score). A "},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMCommand\/haas(_:)"},{"type":"text","text":","},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMCommand\/tuning(_:)"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMCommand\/soundFileName(_:)"},{"type":"text","text":", or"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMCommand\/screenOut(_:)"},{"type":"text","text":" command that is byte-identical to the"},{"type":"text","text":" "},{"type":"text","text":"value already in effect is dropped. Every other segment command’s"},{"type":"text","text":" "},{"type":"text","text":"negative start beat, and every command’s negative duration, is"},{"type":"text","text":" "},{"type":"text","text":"clamped to zero, mirroring the reference implementation’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"MyWarn"},{"type":"text","text":"-and-clamp recovery."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A negative start beat on a note ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMCommand\/pitchesNote(_:)"},{"type":"text","text":","},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMCommand\/clipNote(_:)"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMCommand\/vocodeNote(_:)"},{"type":"text","text":") is left"},{"type":"text","text":" "},{"type":"text","text":"alone: in the reference implementation it terminates the score rather"},{"type":"text","text":" "},{"type":"text","text":"than requesting a repair, and clamping it would silently discard that"},{"type":"text","text":" "},{"type":"text","text":"meaning."}],"type":"paragraph"},{"level":2,"text":"Discussion","type":"heading","anchor":"Discussion"},{"inlineContent":[{"type":"text","text":"Several other repairs were considered and rejected:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Sorting commands by start beat.","type":"text"}],"type":"strong"},{"text":" Command order is load-bearing —","type":"text"},{"text":" ","type":"text"},{"text":"settings carry no beat of their own, mode commands are sticky, and","type":"text"},{"text":" ","type":"text"},{"text":"reordering would churn the formatter’s section-header compression.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Dropping commands after "},{"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMCommand\/end","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"strong"},{"text":" Provably inert, but","type":"text"},{"text":" ","type":"text"},{"text":"not worthless: parking material after ","type":"text"},{"code":"`\/End`","type":"codeVoice"},{"text":" is a common","type":"text"},{"text":" ","type":"text"},{"text":"convention. The ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"resolver","type":"text"}]},{"text":", not the normalizer, treats ","type":"text"},{"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMCommand\/end","type":"reference","isActive":true},{"text":" ","type":"text"},{"text":"as a terminator.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Dropping comments.","type":"text"}],"type":"strong"},{"text":" Lossy, for no gain.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Coalescing adjacent ramps."}],"type":"strong"},{"type":"text","text":" Buys nothing."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Padding ","type":"text"},{"code":"`\/GEQ`","type":"codeVoice"},{"text":" band gains out to 30.","type":"text"}]},{"type":"text","text":" The missing values"},{"type":"text","text":" "},{"type":"text","text":"are unprovable; "},{"type":"reference","identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMValidator","isActive":true},{"type":"text","text":" flags the short count instead of"},{"type":"text","text":" "},{"type":"text","text":"inventing data."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Clamping anything else.","type":"text"}]},{"type":"text","text":" Every other repair the reference"},{"type":"text","text":" "},{"type":"text","text":"performs invents a value rather than restoring one, which is"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMValidator","isActive":true},{"type":"text","text":"’s judgment call to make, not this method’s."}],"type":"paragraph"}]}]}],"kind":"content"}],"sections":[],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMNormalizer\/normalize(_:)"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivordkm\/dkmnormalizer\/normalize(_:)"]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"normalize","kind":"identifier"},{"text":"(","kind":"text"},{"text":"DKMScore","preciseIdentifier":"s:7IvorDKM8DKMScoreV","kind":"typeIdentifier"},{"text":") -> (","kind":"text"},{"text":"DKMScore","preciseIdentifier":"s:7IvorDKM8DKMScoreV","kind":"typeIdentifier"},{"text":", [","kind":"text"},{"text":"Change","preciseIdentifier":"s:7IvorDKM13DKMNormalizerV6ChangeO","kind":"typeIdentifier"},{"text":"])","kind":"text"}],"externalID":"s:7IvorDKM13DKMNormalizerV9normalizeyAA8DKMScoreV_SayAC6ChangeOGtAFF","title":"normalize(_:)","extendedModule":"IvorDKM","modules":[{"name":"IvorDKM"}],"roleHeading":"Instance Method","role":"symbol","symbolKind":"method"},"abstract":[{"text":"Returns a copy of the provided score normalized to canonical form,","type":"text"},{"text":" ","type":"text"},{"text":"along with an array describing each change applied.","type":"text"}],"references":{"doc://IvorDKM/documentation/IvorDKM/UsingIvorDKM":{"role":"article","kind":"article","type":"topic","abstract":[{"text":"Take JohnnySonic score bytes from ","type":"text"},{"code":"Data","type":"codeVoice"},{"text":" to a validated syntax tree.","t