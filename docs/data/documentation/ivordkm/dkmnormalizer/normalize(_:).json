:"effect. A ","type":"text"},{"code":"\/Levels","type":"codeVoice"},{"text":" line whose start beat is negative is","type":"text"},{"type":"text","text":" "},{"type":"text","text":"rewritten to the beat the preceding "},{"code":"\/Levels","type":"codeVoice"},{"type":"text","text":" line ended at"},{"type":"text","text":" "},{"type":"text","text":"(matching "},{"code":"ProcessLevels","type":"codeVoice"},{"type":"text","text":"’ "},{"code":"endBeat = 0","type":"codeVoice"},{"type":"text","text":" initialization, for the"},{"type":"text","text":" "},{"type":"text","text":"first such line in a score). A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMCommand\/haas(_:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMCommand\/tuning(_:)"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMCommand\/soundFileName(_:)"},{"type":"text","text":", or"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMCommand\/screenOut(_:)"},{"type":"text","text":" command that is byte-identical to the"},{"type":"text","text":" "},{"type":"text","text":"value already in effect is dropped. Every other segment command’s"},{"type":"text","text":" "},{"type":"text","text":"negative start beat, and every command’s negative duration, is"},{"type":"text","text":" "},{"type":"text","text":"clamped to zero, mirroring the reference implementation’s"},{"type":"text","text":" "},{"code":"MyWarn","type":"codeVoice"},{"type":"text","text":"-and-clamp recovery."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A negative start beat on a note ("},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMCommand\/pitchesNote(_:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMCommand\/clipNote(_:)"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMCommand\/vocodeNote(_:)"},{"type":"text","text":") is left"},{"type":"text","text":" "},{"type":"text","text":"alone: in the reference implementation it terminates the score rather"},{"type":"text","text":" "},{"type":"text","text":"than requesting a repair, and clamping it would silently discard that"},{"type":"text","text":" "},{"type":"text","text":"meaning."}]},{"anchor":"Discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Several other repairs were considered and rejected:"}]},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Sorting commands by start beat.","type":"text"}],"type":"strong"},{"text":" Command order is load-bearing —","type":"text"},{"text":" ","type":"text"},{"text":"settings carry no beat of their own, mode commands are sticky, and","type":"text"},{"text":" ","type":"text"},{"text":"reordering would churn the formatter’s section-header compression.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Dropping commands after ","type":"text"},{"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMCommand\/end","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"strong"},{"text":" Provably inert, but","type":"text"},{"text":" ","type":"text"},{"text":"not worthless: parking material after ","type":"text"},{"code":"\/End","type":"codeVoice"},{"text":" is a common","type":"text"},{"text":" ","type":"text"},{"text":"convention. The ","type":"text"},{"inlineContent":[{"text":"resolver","type":"text"}],"type":"emphasis"},{"text":", not the normalizer, treats ","type":"text"},{"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMCommand\/end","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"as a terminator.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Dropping comments.","type":"text"}],"type":"strong"},{"text":" Lossy, for no gain.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Coalescing adjacent ramps.","type":"text"}],"type":"strong"},{"text":" Buys nothing.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Padding ","type":"text"},{"code":"\/GEQ","type":"codeVoice"},{"text":" band gains out to 30.","type":"text"}],"type":"strong"},{"text":" The missing values","type":"text"},{"text":" ","type":"text"},{"text":"are unprovable; ","type":"text"},{"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMValidator","isActive":true,"type":"reference"},{"text":" flags the short count instead of","type":"text"},{"text":" ","type":"text"},{"text":"inventing data.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Clamping anything else.","type":"text"}],"type":"strong"},{"text":" Every other repair the reference","type":"text"},{"text":" ","type":"text"},{"text":"performs invents a value rather than restoring one, which is","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMValidator","isActive":true,"type":"reference"},{"text":"’s judgment call to make, not this method’s.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"kind":"symbol","variants":[{"paths":["\/documentation\/ivordkm\/dkmnormalizer\/normalize(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://IvorDKM/documentation/IvorDKM/DKMNormalizer/Change":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Change","kind":"identifier"}],"type":"topic","title":"DKMNormalizer.Change","role":"symbol","kind":"symbol","naviga