t":"absolutely, and no command to restate a global setting already in","type":"text"},{"text":" ","type":"text"},{"text":"effect. A ","type":"text"},{"code":"\/Levels","type":"codeVoice"},{"text":" line whose start beat is negative is","type":"text"},{"text":" ","type":"text"},{"text":"rewritten to the beat the preceding ","type":"text"},{"code":"\/Levels","type":"codeVoice"},{"text":" line ended at","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"(matching "},{"code":"ProcessLevels","type":"codeVoice"},{"type":"text","text":"’ "},{"code":"endBeat = 0","type":"codeVoice"},{"type":"text","text":" initialization, for the"},{"type":"text","text":" "},{"text":"first such line in a score). A ","type":"text"},{"type":"reference","identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMCommand\/haas(_:)","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMCommand\/tuning(_:)","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMCommand\/soundFileName(_:)","isActive":true},{"type":"text","text":", or"},{"type":"text","text":" "},{"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMCommand\/screenOut(_:)","isActive":true,"type":"reference"},{"type":"text","text":" command that is byte-identical to the"},{"type":"text","text":" "},{"type":"text","text":"value already in effect is dropped. Every other segment command’s"},{"type":"text","text":" "},{"type":"text","text":"negative start beat, and every command’s negative duration, is"},{"type":"text","text":" "},{"type":"text","text":"clamped to zero, mirroring the reference implementation’s"},{"type":"text","text":" "},{"code":"MyWarn","type":"codeVoice"},{"type":"text","text":"-and-clamp recovery."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A negative start beat on a note ("},{"identifier":"doc:\/\/IvorDKM\/documentatio