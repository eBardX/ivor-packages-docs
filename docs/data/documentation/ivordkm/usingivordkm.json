{"abstract":[{"type":"text","text":"Take JohnnySonic score text from "},{"type":"codeVoice","code":"Data"},{"type":"text","text":" to a validated syntax tree, and back to"},{"type":"text","text":" "},{"type":"codeVoice","code":"Data"},{"type":"text","text":"."}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"IvorDKM exposes four processing types. Each is a "},{"code":"Sendable","type":"codeVoice"},{"type":"text","text":" value type with a"},{"type":"text","text":" "},{"type":"text","text":"no-argument initializer and a single primary method:"}]},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Type"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Method"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Result"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMParser","type":"reference","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"parse(_:)"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"(DKMScore, [DKMParser.Diagnostic])"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMNormalizer","type":"reference","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"normalize(_:)"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"(DKMScore, [DKMNormalizer.Change])"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMValidator","type":"reference","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"validate(_:)"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"(DKMScore, [DKMValidator.Issue])"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMFormatter","type":"reference","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"format(_:)"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Data"}]}]]],"type":"table","alignments":["left","left","left"],"header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMScore","type":"reference","isActive":true},{"type":"text","text":" carries two Boolean state flags that enforce the order of the"},{"type":"text","text":" "},{"type":"text","text":"pipeline:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"isNormalized"}],"type":"strong"},{"type":"text","text":" — "},{"type":"codeVoice","code":"validate(_:)"},{"type":"text","text":" throws unless this is "},{"type":"codeVoice","code":"true"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"isValidated"}],"type":"strong"},{"type":"text","text":" — "},{"type":"codeVoice","code":"format(_:)"},{"type":"text","text":" throws unless this is "},{"type":"codeVoice","code":"true"},{"type":"text","text":"."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"So the canonical order is "},{"type":"strong","inlineContent":[{"type":"text","text":"parse → normalize → validate → format"}]},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["let (parsed, diagnostics) = try DKMParser().parse(data)","let (normalized, changes) = DKMNormalizer().normalize(parsed)","let (validated, issues)   = try DKMValidator().validate(normalized)","","guard issues.isEmpty","else { \/* handle issues *\/ return }","","let output = try DKMFormatter().format(validated)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Both "},{"code":"normalize(_:)","type":"codeVoice"},{"type":"text","text":" and "},{"code":"validate(_:)","type":"codeVoice"},{"type":"text","text":" are idempotent — calling them on a"},{"type":"text","text":" "},{"type":"text","text":"score that is already normalized or validated returns it unchanged — so it is"},{"type":"text","text":" "},{"type":"text","text":"always safe to run the full pipeline."}]},{"level":3,"type":"heading","anchor":"The-reference-implementation","text":"The reference implementation"},{"type":"paragraph","inlineContent":[{"type":"text","text":"JohnnySonic’s own "},{"identifier":"https:\/\/github.com\/JohnnySonic\/JohnnySonic","type":"reference","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"and in particular its "},{"code":"main.c","type":"codeVoice"},{"type":"text","text":", is the semantic authority this package is"},{"type":"text","text":" "},{"type":"text","text":"checked against: where the format’s own documentation is silent or ambiguous,"},{"type":"text","text":" "},{"code":"main.c","type":"codeVoice"},{"type":"text","text":"’s behavior — including its recoveries, its clamps, and its hard"},{"type":"text","text":" "},{"type":"text","text":"errors — is what IvorDKM reproduces."}]},{"level":2,"type":"heading","anchor":"Parsing","text":"Parsing"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMParser","type":"reference","isActive":true},{"type":"text","text":" decodes raw UTF-8 text data into a "},{"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMScore","type":"reference","isActive":true},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["let (score, diagnostics) = try DKMParser().parse(data)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The parser is tolerant of two specific, provably-safe deviations from the"},{"type":"text","text":" "},{"type":"text","text":"reference implementation’s own conventions, and reports each repair as a"},{"type":"text","text":" "},{"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMParser\/Diagnostic","type":"reference","isActive":true},{"type":"text","text":": a "},{"code":"\/GEQ","type":"codeVoice"},{"type":"text","text":" line whose band-gain count does not"},{"type":"text","text":" "},{"type":"text","text":"match the reference’s fixed 30, and an integer-typed parameter (such as"},{"type":"text","text":" "},{"code":"numberOfVoices","type":"codeVoice"},{"type":"text","text":") written with a fractional part, which the reference itself"},{"type":"text","text":" "},{"type":"text","text":"reads as a "},{"code":"double","type":"codeVoice"},{"type":"text","text":" and truncates. Diagnostics are always returned, never"},{"type":"text","text":" "},{"type":"text","text":"thrown; each has a human-readable "},{"code":"message","type":"codeVoice"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["for diagnostic in diagnostics {","    print(diagnostic.message)","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The parser throws "},{"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMParser\/Error","type":"reference","isActive":true},{"type":"text","text":" when the data cannot be decoded at"},{"type":"text","text":" "},{"type":"text","text":"all — invalid UTF-8, a data line with the wrong parameter count or an"},{"type":"text","text":" "},{"type":"text","text":"unparseable value, an unrecognized section name, or a data line before any"},{"type":"text","text":" "},{"type":"text","text":"section has been established:"}]},{"type":"codeListing","syntax":"swift","code":["do {","    let (score, _) = try DKMParser().parse(data)","} catch let error as DKMParser.Error {","    print(error.message)","}"]},{"level":2,"type":"heading","anchor":"Normalizing","text":"Normalizing"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMNormalizer","type":"reference","isActive":true},{"type":"text","text":" mechanically canonicalizes a score, returning a new score"},{"type":"text","text":" "},{"type":"text","text":"whose "},{"code":"isNormalized","type":"codeVoice"},{"type":"text","text":" flag is "},{"code":"true","type":"codeVoice"},{"type":"text","text":", together with a list of the changes it"},{"type":"text","text":" "},{"type":"text","text":"applied:"}]},{"type":"codeListing","syntax":"swift","code":["let (normalized, changes) = DKMNormalizer().normalize(score)","","for change in changes {","    print(change.message)        \/\/ what was changed","    print(change.commandIndex)   \/\/ which command in the input score, if any","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Canonical form clamps a negative start beat or duration to zero on every"},{"type":"text","text":" "},{"type":"text","text":"command except a note, rewrites a "},{"code":"\/Levels","type":"codeVoice"},{"type":"text","text":" line’s continuation start"},{"type":"text","text":" "},{"type":"text","text":"beat (a negative value, meaning “continue from where the previous "},{"code":"\/Levels","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"line ended”) to the absolute beat it resolves to, and drops a"},{"type":"text","text":" "},{"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMCommand\/haas(_:)","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMCommand\/tuning(_:)","type":"reference","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMCommand\/soundFileName(_:)","type":"reference","isActive":true},{"type":"text","text":", or "},{"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMCommand\/screenOut(_:)","type":"reference","isActive":true},{"type":"text","text":" command that"},{"type":"text","text":" "},{"type":"text","text":"merely restates the value already in effect. A negative start beat on a note"},{"type":"text","text":" "},{"type":"text","text":"is left alone — in the reference implementation it terminates the score"},{"type":"text","text":" "},{"type":"text","text":"rather than requesting a repair, and clamping it would silently discard that"},{"type":"text","text":" "},{"type":"text","text":"meaning. See "},{"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMNormalizer\/normalize(_:)","type":"reference","isActive":true},{"type":"text","text":" for the full list of changes"},{"type":"text","text":" "},{"type":"text","text":"considered and rejected."}]},{"level":2,"type":"heading","anchor":"Validating","text":"Validating"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMValidator","type":"reference","isActive":true},{"type":"text","text":" checks a "},{"type":"strong","inlineContent":[{"type":"text","text":"normalized"}]},{"type":"text","text":" score against the reference"},{"type":"text","text":" "},{"type":"text","text":"implementation’s parameter constraints:"}]},{"type":"codeListing","syntax":"swift","code":["let (validated, issues) = try DKMValidator().validate(normalized)","","if issues.isEmpty {","    \/\/ `validated.isValidated` is now true.","} else {","    issues.forEach { print($0.message) }","}"]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If the score has not been normalized, "},{"type":"codeVoice","code":"validate(_:)"},{"type":"text","text":" throws"},{"type":"text","text":" "},{"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMValidator\/Error\/notNormalized","type":"reference","isActive":true},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If any issues are found, the returned score is the "},{"inlineContent":[{"text":"input unchanged","type":"text"}],"type":"strong"},{"type":"text","text":" (its"},{"type":"text","text":" "},{"type":"codeVoice","code":"isValidated"},{"type":"text","text":" flag stays "},{"type":"codeVoice","code":"false"},{"type":"text","text":"). Fix the issues — or run it through the"},{"type":"text","text":" "},{"type":"text","text":"normalizer again after editing — and validate again."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Only when the issues array is empty does the returned score have"},{"type":"text","text":" "},{"type":"codeVoice","code":"isValidated == true"},{"type":"text","text":" — the prerequisite for formatting."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every "},{"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMValidator\/Issue","type":"reference","isActive":true},{"type":"text","text":" case names a value the reference implementation"},{"type":"text","text":" "},{"type":"text","text":"cannot recover from silently: it either invents a replacement with a warning,"},{"type":"text","text":" "},{"type":"text","text":"or halts outright. This includes a beat beyond the reference’s fixed"},{"type":"text","text":" "},{"code":"8192","type":"codeVoice"},{"type":"text","text":"-entry tempo table, a "},{"code":"\/GEQ","type":"codeVoice"},{"type":"text","text":" line with the wrong band-gain count, a"},{"type":"text","text":" "},{"type":"text","text":"non-finite or out-of-range parameter, a non-positive duration or tempo, an"},{"type":"text","text":" "},{"type":"text","text":"unwritable name, an incomplete graphic EQ segment, and a clip or vocode note"},{"type":"text","text":" "},{"type":"text","text":"with no preceding mode command. Instrument and clip "},{"type":"emphasis","inlineContent":[{"type":"text","text":"names"}]},{"type":"text","text":" are notably"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" checked for existence — the reference implementation resolves those"},{"type":"text","text":" "},{"type":"text","text":"against an external instrument file and clip list file, and this package does"},{"type":"text","text":" "},{"type":"text","text":"no file I\/O, so it cannot know whether a name is valid."}]},{"level":2,"type":"heading","anchor":"Formatting","text":"Formatting"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMFormatter","type":"reference","isActive":true},{"type":"text","text":" serializes a "},{"type":"strong","inlineContent":[{"type":"text","text":"validated"}]},{"type":"text","text":" score back to UTF-8 text "},{"code":"Data","type":"codeVoice"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["let data = try DKMFormatter().format(validated)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the score has not been validated, "},{"code":"format(_:)","type":"codeVoice"},{"type":"text","text":" throws"},{"type":"text","text":" "},{"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMFormatter\/Error\/notValidated","type":"reference","isActive":true},{"type":"text","text":". Because the model is validated first,"},{"type":"text","text":" "},{"type":"text","text":"formatting itself only fails on a string argument containing characters the"},{"type":"text","text":" "},{"type":"text","text":"JohnnySonic format cannot represent."}]},{"level":3,"type":"heading","anchor":"The-round-trip-contract","text":"The round-trip contract"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Round-tripping through "},{"code":"parse → format","type":"codeVoice"},{"type":"text","text":" is "},{"type":"strong","inlineContent":[{"type":"text","text":"AST-stable, not byte-stable"}]},{"type":"text","text":", in"},{"type":"text","text":" "},{"type":"text","text":"two independent ways:"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Section spelling."}],"type":"strong"},{"text":" The parser recognizes a section by the first three","type":"text"},{"type":"text","text":" "},{"type":"text","text":"characters of its name; the formatter always emits the canonical spelling"},{"type":"text","text":" "},{"type":"text","text":"("},{"code":"\/ScreenOut","type":"codeVoice"},{"type":"text","text":", never "},{"code":"\/ScreenOutput","type":"codeVoice"},{"type":"text","text":"). A score written with the"},{"text":" ","type":"text"},{"text":"reference implementation’s own real-world spellings re-parses to the same","type":"text"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMCommand"},{"type":"text","text":", but the formatted bytes differ from the input."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Number formatting."}],"type":"strong"},{"text":" A value written as ","type":"text"},{"code":"60","type":"codeVoice"},{"text":" parses to ","type":"text"},{"code":"60.0","type":"codeVoice"},{"text":" and prints","type":"text"},{"text":" ","type":"text"},{"text":"back as ","type":"text"},{"code":"\"60.0\"","type":"codeVoice"},{"text":". So ","type":"text"},{"code":"format(parse(x)) != x","type":"codeVoice"},{"type":"text","text":" at the byte level in general —"},{"type":"text","text":" "},{"type":"text","text":"but the pipeline is idempotent from the second generation onward:"},{"type":"text","text":" "},{"code":"format(parse(format(parse(x)))) == format(parse(x))","type":"codeVoice"},{"type":"text","text":"."}]}]}]},{"type":"paragraph","inlineContent":[{"text":"The contract to rely on, and the one this package’s own round-trip tests","type":"text"},{"text":" ","type":"text"},{"text":"assert, is: ","type":"text"},{"code":"parse → format → parse","type":"codeVoice"},{"text":" produces a ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMScore"},{"type":"text","text":" equal to the one"},{"type":"text","text":" "},{"type":"text","text":"you started with, and formatting that result a second time is byte-identical"},{"type":"text","text":" "},{"type":"text","text":"to the first. Never assert byte equality against the original input."}]},{"type":"heading","level":2,"text":"The AST model","anchor":"The-AST-model"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The syntactic model is a flat list of commands:"}]},{"type":"codeListing","syntax":null,"code":["DKMScore","└─ commands: [DKMCommand]   \/\/ .chorusLine | .clipMode | .clipNote | … | .vocodeNote"]},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMCommand"},{"type":"text","text":" is an enum with one case per JohnnySonic section or note type;"},{"type":"text","text":" "},{"type":"text","text":"a case whose section carries more than one line-worth of parameters wraps them"},{"type":"text","text":" "},{"type":"text","text":"in a dedicated payload type ("},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMChorusLine"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMPitchesNote"},{"type":"text","text":", and so on)."},{"type":"text","text":" "},{"type":"text","text":"Command order is meaningful: settings and mode commands are sticky, applying"},{"type":"text","text":" "},{"type":"text","text":"to every subsequent command until overridden, and section headers compress a"},{"type":"text","text":" "},{"type":"text","text":"maximal run of same-kind lines — this is why "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMNormalizer"},{"type":"text","text":" never reorders"},{"type":"text","text":" "},{"type":"text","text":"commands."}]},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMScore"},{"type":"text","text":" equality and hashing compare "},{"type":"codeVoice","code":"commands"},{"text":" only; the ","type":"text"},{"code":"isNormalized","type":"codeVoice"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"code":"isValidated","type":"codeVoice"},{"text":" flags are metadata and are excluded.","type":"text"}]},{"type":"heading","level":2,"text":"Building a score programmatically","anchor":"Building-a-score-programmatically"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can construct the AST directly rather than parsing bytes:"}]},{"type":"codeListing","syntax":"swift","code":["let note = DKMPitchesNote(startBeat: 0.0,","                          duration: 4.0,","                          volume: 1.0,","                          location: 0.0,","                          startPitch: 60.0,","                          endPitch: 60.0,","                          instrument: \"Piano\")","","let score = DKMScore(commands: [.soundFileName(\"Data\/Output.AIFF\"),","                                .pitchesNote(note),","                                .end])"]},{"type":"paragraph","inlineContent":[{"text":"A directly-constructed score has ","type":"text"},{"code":"isNormalized == false","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"isValidated == false","type":"codeVoice"},{"text":" — exactly like one fresh out of the parser — so you must run it through","type":"text"},{"text":" ","type":"text"},{"text":"the normalizer and validator before formatting.","type":"text"}]},{"type":"heading","level":2,"text":"Error handling","anchor":"Error-handling"},{"type":"paragraph","inlineContent":[{"text":"Thrown errors conform to ","type":"text"},{"code":"EnhancedError","type":"codeVoice"},{"text":" (from","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"https:\/\/github.com\/eBardX\/XestiTools","type":"reference"},{"text":"): each has a ","type":"text"},{"code":"category","type":"codeVoice"},{"text":" of","type":"text"},{"text":" ","type":"text"},{"code":"\"IvorDKM\"","type":"codeVoice"},{"text":" and a human-readable ","type":"text"},{"code":"message","type":"codeVoice"},{"text":".","type":"text"}]},{"alignments":["left","left"],"type":"table","rows":[[[{"inlineContent":[{"text":"Type","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Thrown by","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMParser\/Error","type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"code":"DKMParser.parse(_:)","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMValidator\/Error","type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"code":"DKMValidator.validate(_:)","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMFormatter\/Error","type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"code":"DKMFormatter.format(_:)","type":"codeVoice"}],"type":"paragraph"}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"code":"DKMNormalizer.normalize(_:)","type":"codeVoice"},{"text":" never throws — normalization has no failure mode.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Non-fatal results are returned rather than thrown, and each also provides a","type":"text"},{"text":" ","type":"text"},{"code":"message","type":"codeVoice"},{"text":":","type":"text"}]},{"rows":[[[{"inlineContent":[{"type":"text","text":"Type"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Returned by"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMParser\/Diagnostic"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"parse(_:)"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc: