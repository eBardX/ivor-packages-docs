{"metadata":{"role":"article","modules":[{"name":"IvorDKM"}],"title":"Using IvorDKM","roleHeading":"Article"},"sections":[],"hierarchy":{"paths":[["doc:\/\/IvorDKM\/documentation\/IvorDKM"]]},"kind":"article","schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"url":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/UsingIvorDKM","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivordkm\/usingivordkm"]}],"abstract":[{"type":"text","text":"Take JohnnySonic score text from "},{"type":"codeVoice","code":"Data"},{"type":"text","text":" to a validated syntax tree, and back to"},{"type":"text","text":" "},{"type":"codeVoice","code":"Data"},{"type":"text","text":"."}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"IvorDKM exposes four processing types. Each is a "},{"code":"Sendable","type":"codeVoice"},{"type":"text","text":" value type with a"},{"type":"text","text":" "},{"type":"text","text":"no-argument initializer and a single primary method:"}]},{"type":"table","alignments":["left","left","left"],"rows":[[[{"inlineContent":[{"text":"Type","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Method","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Result"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMParser","isActive":true}]}],[{"inlineContent":[{"code":"parse(_:)","type":"codeVoice"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"(DKMScore, [DKMParser.Diagnostic])"}]}]],[[{"inlineContent":[{"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMNormalizer","isActive":true,"type":"reference"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"code":"normalize(_:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"(DKMScore, [DKMNormalizer.Change])"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMValidator","type":"reference","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"validate(_:)"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"(DKMScore, [DKMValidator.Issue])"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMFormatter","type":"reference","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"code":"format(_:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Data"}]}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMScore","isActive":true,"type":"reference"},{"text":" carries two Boolean state flags that enforce the order of the","type":"text"},{"text":" ","type":"text"},{"text":"pipeline:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"isNormalized","type":"codeVoice"}]},{"type":"text","text":" — "},{"type":"codeVoice","code":"validate(_:)"},{"type":"text","text":" throws unless this is "},{"type":"codeVoice","code":"true"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"isValidated"}]},{"type":"text","text":" — "},{"type":"codeVoice","code":"format(_:)"},{"type":"text","text":" throws unless this is "},{"type":"codeVoice","code":"true"},{"type":"text","text":"."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"So the canonical order is ","type":"text"},{"type":"strong","inlineContent":[{"text":"parse → normalize → validate → format","type":"text"}]},{"text":":","type":"text"}],"type":"paragraph"},{"code":["let (parsed, diagnostics) = try DKMParser().parse(data)","let (normalized, changes) = DKMNormalizer().normalize(parsed)","let (validated, issues)   = try DKMValidator().validate(normalized)","","guard issues.isEmpty","else { \/* handle issues *\/ return }","","let output = try DKMFormatter().format(validated)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Both ","type":"text"},{"type":"codeVoice","code":"normalize(_:)"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"validate(_:)"},{"text":" are idempotent — calling them on a","type":"text"},{"text":" ","type":"text"},{"text":"score that is already normalized or validated returns it unchanged — so it is","type":"text"},{"text":" ","type":"text"},{"text":"always safe to run the full pipeline.","type":"text"}],"type":"paragraph"},{"anchor":"The-reference-implementation","text":"The reference implementation","type":"heading","level":3},{"inlineContent":[{"text":"JohnnySonic’s own ","type":"text"},{"identifier":"https:\/\/github.com\/JohnnySonic\/JohnnySonic","isActive":true,"type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"and in particular its ","type":"text"},{"code":"main.c","type":"codeVoice"},{"text":", is the semantic authority this package is","type":"text"},{"text":" ","type":"text"},{"text":"checked against: where the format’s own documentation is silent or ambiguous,","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"main.c"},{"type":"text","text":"’s behavior — including its recoveries, its clamps, and its hard"},{"type":"text","text":" "},{"type":"text","text":"errors — is what IvorDKM reproduces."}],"type":"paragraph"},{"level":2,"text":"Parsing","anchor":"Parsing","type":"heading"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMParser"},{"text":" decodes raw UTF-8 text data into a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMScore"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["let (score, diagnostics) = try DKMParser().parse(data)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"The parser is tolerant of two specific, provably-safe deviations from the","type":"text"},{"text":" ","type":"text"},{"text":"reference implementation’s own conventions, and reports each repair as a","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMParser\/Diagnostic","isActive":true},{"text":": a ","type":"text"},{"code":"\/GEQ","type":"codeVoice"},{"text":" line whose band-gain count does not","type":"text"},{"text":" ","type":"text"},{"text":"match the reference’s fixed 30, and an integer-typed parameter (such as","type":"text"},{"text":" ","type":"text"},{"code":"numberOfVoices","type":"codeVoice"},{"text":") written with a fractional part, which the reference itself","type":"text"},{"text":" ","type":"text"},{"text":"reads as a ","type":"text"},{"code":"double","type":"codeVoice"},{"text":" and truncates. Diagnostics are always returned, never","type":"text"},{"text":" ","type":"text"},{"text":"thrown; each has a human-readable ","type":"text"},{"code":"message","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["for diagnostic in diagnostics {","    print(diagnostic.message)","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The parser throws "},{"type":"reference","identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMParser\/Error","isActive":true},{"type":"text","text":" when the data cannot be decoded at"},{"type":"text","text":" "},{"text":"all — invalid UTF-8, a data line with the wrong parameter count or an","type":"text"},{"text":" ","type":"text"},{"text":"unparseable value, an unrecognized section name, or a data line before any","type":"text"},{"text":" ","type":"text"},{"text":"section has been established:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["do {","    let (score, _) = try DKMParser().parse(data)","} catch let error as DKMParser.Error {","    print(error.message)","}"]},{"type":"heading","level":2,"text":"Normalizing","anchor":"Normalizing"},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMNormalizer"},{"text":" mechanically canonicalizes a score, returning a new score","type":"text"},{"text":" ","type":"text"},{"text":"whose ","type":"text"},{"type":"codeVoice","code":"isNormalized"},{"text":" flag is ","type":"text"},{"type":"codeVoice","code":"true"},{"text":", together with a list of the changes it","type":"text"},{"text":" ","type":"text"},{"text":"applied:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let (normalized, changes) = DKMNormalizer().normalize(score)","","for change in changes {","    print(change.message)        \/\/ what was changed","    print(change.commandIndex)   \/\/ which command in the input score, if any","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Canonical form clamps a negative start beat or duration to zero on every"},{"type":"text","text":" "},{"type":"text","text":"command except a note, rewrites a "},{"type":"codeVoice","code":"\/Levels"},{"type":"text","text":" line’s continuation start"},{"type":"text","text":" "},{"type":"text","text":"beat (a negative value, meaning “continue from where the previous "},{"type":"codeVoice","code":"\/Levels"},{"type":"text","text":" "},{"type":"text","text":"line ended”) to the absolute beat it resolves to, and drops a"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMCommand\/haas(_:)","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMCommand\/tuning(_:)","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMCommand\/soundFileName(_:)","isActive":true},{"type":"text","text":", or "},{"type":"reference","identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMCommand\/screenOut(_:)","isActive":true},{"type":"text","text":" command that"},{"type":"text","text":" "},{"type":"text","text":"merely restates the value already in effect. A negative start beat on a note"},{"type":"text","text":" "},{"type":"text","text":"is left alone — in the reference implementation it terminates the score"},{"type":"text","text":" "},{"type":"text","text":"rather than requesting a repair, and clamping it would silently discard that"},{"type":"text","text":" "},{"type":"text","text":"meaning. See "},{"type":"reference","identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMNormalizer\/normalize(_:)","isActive":true},{"type":"text","text":" for the full list of changes"},{"type":"text","text":" "},{"type":"text","text":"considered and rejected."}]},{"text":"Validating","type":"heading","anchor":"Validating","level":2},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMValidator"},{"type":"text","text":" checks a "},{"type":"strong","inlineContent":[{"type":"text","text":"normalized"}]},{"type":"text","text":" score against the reference"},{"type":"text","text":" "},{"type":"text","text":"implementation’s parameter constraints:"}]},{"type":"codeListing","syntax":"swift","code":["let (validated, issues) = try DKMValidator().validate(normalized)","","if issues.isEmpty {","    \/\/ `validated.isValidated` is now true.","} else {","    issues.forEach { print($0.message) }","}"]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If the score has not been normalized, "},{"type":"codeVoice","code":"validate(_:)"},{"type":"text","text":" throws"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMValidator\/Error\/notNormalized"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"If any issues are found, the returned score is the ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"input unchanged"}]},{"text":" (its","type":"text"},{"text":" ","type":"text"},{"code":"isValidated","type":"codeVoice"},{"text":" flag stays ","type":"text"},{"code":"false","type":"codeVoice"},{"text":"). Fix the issues — or run it through the","type":"text"},{"text":" ","type":"text"},{"text":"normalizer again after editing — and validate again.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Only when the issues array is empty does the returned score have"},{"type":"text","text":" "},{"type":"codeVoice","code":"isValidated == true"},{"type":"text","text":" — the prerequisite for formatting."}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every "},{"type":"reference","identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMValidator\/Issue","isActive":true},{"type":"text","text":" case names a value the reference implementation"},{"type":"text","text":" "},{"type":"text","text":"cannot recover from silently: it either invents a replacement with a warning,"},{"type":"text","text":" "},{"type":"text","text":"or halts outright. This includes a beat beyond the reference’s fixed"},{"type":"text","text":" "},{"code":"8192","type":"codeVoice"},{"text":"-entry tempo table, a ","type":"text"},{"code":"\/GEQ","type":"codeVoice"},{"text":" line with the wrong band-gain count, a","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"non-finite or out-of-range parameter, a non-positive duration or tempo, an"},{"type":"text","text":" "},{"type":"text","text":"unwritable name, an incomplete graphic EQ segment, and a clip or vocode note"},{"type":"text","text":" "},{"type":"text","text":"with no preceding mode command. Instrument and clip "},{"type":"emphasis","inlineContent":[{"type":"text","text":"names"}]},{"type":"text","text":" are notably"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"text":"not","type":"text"}]},{"type":"text","text":" checked for existence — the reference implementation resolves those"},{"type":"text","text":" "},{"type":"text","text":"against an external instrument file and clip list file, and this package does"},{"type":"text","text":" "},{"type":"text","text":"no file I\/O, so it cannot know whether a name is valid."}]},{"anchor":"Formatting","type":"heading","text":"Formatting","level":2},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMFormatter","isActive":true,"type":"reference"},{"text":" serializes a ","type":"text"},{"type":"strong","inlineContent":[{"text":"validated","type":"text"}]},{"type":"text","text":" score back to UTF-8 text "},{"type":"codeVoice","code":"Data"},{"type":"text","text":":"}]},{"syntax":"swift","type":"codeListing","code":["let data = try DKMFormatter().format(validated)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the score has not been validated, "},{"type":"codeVoice","code":"format(_:)"},{"type":"text","text":" throws"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMFormatter\/Error\/notValidated"},{"type":"text","text":". Because the model is validated first,"},{"type":"text","text":" "},{"type":"text","text":"formatting itself only fails on a string argument containing characters the"},{"type":"text","text":" "},{"type":"text","text":"JohnnySonic format cannot represent."}]},{"text":"The round-trip contract","anchor":"The-round-trip-contract","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Round-tripping through "},{"code":"parse → format","type":"codeVoice"},{"text":" is ","type":"text"},{"inlineContent":[{"text":"AST-stable, not byte-stable","type":"text"}],"type":"strong"},{"type":"text","text":", in"},{"type":"text","text":" "},{"text":"two independent ways:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Section spelling."}]},{"type":"text","text":" The parser recognizes a section by the first three"},{"type":"text","text":" "},{"type":"text","text":"characters of its name; the formatter always emits the canonical spelling"},{"type":"text","text":" "},{"type":"text","text":"("},{"code":"\/ScreenOut","type":"codeVoice"},{"text":", never ","type":"text"},{"code":"\/ScreenOutput","type":"codeVoice"},{"text":"). A score written with the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"reference implementation’s own real-world spellings re-parses to the same"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMCommand","type":"reference"},{"type":"text","text":", but the formatted bytes differ from the input."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Number formatting."}]},{"type":"text","text":" A value written as "},{"type":"codeVoice","code":"60"},{"type":"text","text":" parses to "},{"type":"codeVoice","code":"60.0"},{"type":"text","text":" and prints"},{"type":"text","text":" "},{"type":"text","text":"back as "},{"type":"codeVoice","code":"\"60.0\""},{"type":"text","text":". So "},{"type":"codeVoice","code":"format(parse(x)) != x"},{"type":"text","text":" at the byte level in general —"},{"type":"text","text":" "},{"type":"text","text":"but the pipeline is idempotent from the second generation onward:"},{"type":"text","text":" "},{"type":"codeVoice","code":"format(parse(format(parse(x)))) == format(parse(x))"},{"type":"text","text":"."}]}]}],"type":"orderedList"},{"inlineContent":[{"type":"text","text":"The contract to rely on, and the one this package’s own round-trip tests"},{"type":"text","text":" "},{"type":"text","text":"assert, is: "},{"type":"codeVoice","code":"parse → format → parse"},{"type":"text","text":" produces a "},{"type":"reference","identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMScore","isActive":true},{"type":"text","text":" equal to the one"},{"type":"text","text":" "},{"type":"text","text":"you started with, and formatting that result a second time is byte-identical"},{"type":"text","text":" "},{"type":"text","text":"to the first. Never assert byte equality against the original input."}],"type":"paragraph"},{"text":"The AST model","level":2,"anchor":"The-AST-model","type":"heading"},{"inlineContent":[{"text":"The syntactic model is a flat list of commands:","type":"text"}],"type":"paragraph"},{"syntax":null,"code":["DKMScore","└─ commands: [DKMCommand]   \/\/ .chorusLine | .clipMode | .clipNote | … | .vocodeNote"],"type":"codeListing"},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMCommand"},{"type":"text","text":" is an enum with one case per JohnnySonic section or note type;"},{"type":"text","text":" "},{"type":"text","text":"a case whose section carries more than one line-worth of parameters wraps them"},{"type":"text","text":" "},{"type":"text","text":"in a dedicated payload type ("},{"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMChorusLine","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMPitchesNote","type":"reference","isActive":true},{"text":", and so on).","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Command order is meaningful: settings and mode commands are sticky, applying"},{"type":"text","text":" "},{"text":"to every subsequent command until overridden, and section headers compress a","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"maximal run of same-kind lines — this is why "},{"isActive":true,"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMNormalizer","type":"reference"},{"type":"text","text":" never reorders"},{"type":"text","text":" "},{"type":"text","text":"commands."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMScore"},{"type":"text","text":" equality and hashing compare "},{"type":"codeVoice","code":"commands"},{"type":"text","text":" only; the "},{"type":"codeVoice","code":"isNormalized"},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"isValidated"},{"type":"text","text":" flags are metadata and are excluded."}]},{"level":2,"type":"heading","text":"Building a score programmatically","anchor":"Building-a-score-programmatically"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can construct the AST directly rather than parsing bytes:"}]},{"syntax":"swift","type":"codeListing","code":["let note = DKMPitchesNote(startBeat: 0.0,","                          duration: 4.0,","                          volume: 1.0,","                          location: 0.0,","                          startPitch: 60.0,","                          endPitch: 60.0,","                          instrument: \"Piano\")","","let score = DKMScore(commands: [.soundFileName(\"Data\/Output.AIFF\"),","                                .pitchesNote(note),","                                .end])"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A directly-constructed score has "},{"code":"isNormalized == false","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"isValidated == false","type":"codeVoice"},{"text":" — exactly like one fresh out of the parser — so you must run it through","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"the normalizer and validator before formatting."}]},{"anchor":"Error-handling","type":"heading","text":"Error handling","level":2},{"type":"paragraph","inlineContent":[{"text":"Thrown errors conform to ","type":"text"},{"code":"EnhancedError","type":"codeVoice"},{"type":"text","text":" (from"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/eBardX\/XestiTools"},{"type":"text","text":"): each has a "},{"code":"category","type":"codeVoice"},{"type":"text","text":" of"},{"type":"text","text":" "},{"code":"\"IvorDKM\"","type":"codeVoice"},{"type":"text","text":" and a human-readable "},{"code":"message","type":"codeVoice"},{"type":"text","text":"."}]},{"alignments":["left","left"],"type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Type"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Thrown by"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMParser\/Error"}],"type":"paragraph"}],[{"inlineContent":[{"code":"DKMParser.parse(_:)","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMValidator\/Error","isActive":true,"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"DKMValidator.validate(_:)"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMFormatter\/Error","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"code":"DKMFormatter.format(_:)","type":"codeVoice"}],"type":"paragraph"}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"code":"DKMNormalizer.normalize(_:)","type":"codeVoice"},{"type":"text","text":" never throws — normalization has no failure mode."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Non-fatal results are returned rather than thrown, and each also provides a"},{"type":"text","text":" "},{"type":"codeVoice","code":"message"},{"type":"text","text":":"}]},{"rows":[[[{"type":"para