{"metadata":{"roleHeading":"Article","role":"article","title":"Using IvorDKM","modules":[{"name":"IvorDKM"}]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/UsingIvorDKM"},"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/IvorDKM\/documentation\/IvorDKM"]]},"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"IvorDKM exposes four processing types. Each is a ","type":"text"},{"type":"codeVoice","code":"Sendable"},{"text":" value type with a","type":"text"},{"text":" ","type":"text"},{"text":"no-argument initializer and a single primary method:","type":"text"}]},{"header":"row","alignments":["left","left","left"],"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Type"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Method"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Result"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMParser"}]}],[{"type":"paragraph","inlineContent":[{"code":"parse(_:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"(DKMScore, [DKMParser.Diagnostic])","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMNormalizer"}]}],[{"type":"paragraph","inlineContent":[{"code":"normalize(_:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"(DKMScore, [DKMNormalizer.Change])","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMValidator"}]}],[{"type":"paragraph","inlineContent":[{"code":"validate(_:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"(DKMScore, [D