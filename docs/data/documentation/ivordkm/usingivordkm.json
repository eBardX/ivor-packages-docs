/documentation\/IvorDKM\/DKMValidator","type":"reference"},{"text":", or ","type":"text"},{"isActive":true,"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMFormatter","type":"reference"},{"text":" instance can be reused for any number of","type":"text"},{"text":" ","type":"text"},{"text":"concurrent operations.","type":"text"}],"type":"paragraph"}]}],"metadata":{"title":"Using IvorDKM","modules":[{"name":"IvorDKM"}],"roleHeading":"Article","role":"article"},"hierarchy":{"paths":[["doc:\/\/IvorDKM\/documentation\/IvorDKM"]]},"kind":"article","sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/UsingIvorDKM"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivordkm\/usingivordkm"]}],"references":{"doc://IvorDKM/documentation/IvorDKM/DKMFormatter/format(_:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"format","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:7IvorDKM8DKMScoreV","text":"DKMScore","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:7IvorDKM12DKMFormatterV","text":"DKMFormatter","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:7IvorDKM12DKMFormatterV5ErrorO","text":"Error","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:10Foundation4DataV","text":"Data","kind":"typeIdentifier"}],"type":"topic","title":"format(_:)","role":"symbol","kind":"symbol","identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMFormatter\/format(_:)","abstract":[{"type":"text","text":"Formats the provided JohnnySonic score as binary data."}],"url":"\/documentation\/ivordkm\/dkmformatter\/format(_:)"},"doc://IvorDKM/documentation/IvorDKM/DKMPitchesNote":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DKMP