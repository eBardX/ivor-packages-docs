{"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"IvorDKM exposes four processing types. Each is a ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":" value type","type":"text"},{"text":" ","type":"text"},{"text":"with a no-argument initializer and a single primary method:","type":"text"}]},{"alignments":["left","left","left"],"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Type","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Method","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Result","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMParser","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"code":"parse(_:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"(DKMScore, [DKMParser.Diagnostic])","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMNormalizer","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"code":"normalize(_:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"(DKMScore, [DKMNormalizer.Change])","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMValidator","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"code":"validate(_:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"(DKMScore, [DKMValidator.Issue])","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMFormatter","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"code":"format(_:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"Data","type":"codeVoice"}]}]]],"type":"table","header":"row"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMScore"},{"text":" carries two Boolean state flags that enforce the order of the","type":"text"},{"text":" ","type":"text"},{"text":"pipeline:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"isNormalized","type":"codeVoice"}]},{"text":" — ","type":"text"},{"code":"validate(_:)","type":"codeVoice"},{"text":" throws unless this is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"isValidated","type":"codeVoice"}]},{"text":" — ","type":"text"},{"code":"format(_:)","type":"codeVoice"},{"text":" throws unless this is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":".","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"So the canonical order is ","type":"text"},{"type":"strong","inlineContent":[{"text":"parse → normalize → validate → format","type":"text"}]},{"text":":","type":"text"}]},{"type":"codeListing","code":["let (parsed, diagnostics) = try DKMParser().parse(data)","let (normalized, changes) = DKMNormalizer().normalize(parsed)","let (validated, issues)   = try DKMValidator().validate(normalized)","","guard issues.isEmpty","else { \/* handle issues *\/ return }","","let output = try DKMFormatter().format(validated)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Both ","type":"text"},{"code":"normalize(_:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"validate(_:)","type":"codeVoice"},{"text":" are idempotent — calling them on a","type":"text"},{"text":" ","type":"text"},{"text":"score that is already normalized or validated returns it unchanged — so it is","type":"text"},{"text":" ","type":"text"},{"text":"always safe to run the full pipeline.","type":"text"}]},{"anchor":"The-reference-implementation","type":"heading","level":3,"text":"The reference implementation"},{"type":"paragraph","inlineContent":[{"text":"JohnnySonic’s own C implementation lives at","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/JohnnySonic\/JohnnySonic"},{"text":" alongside","type":"text"},{"text":" ","type":"text"},{"text":"this package, and its ","type":"text"},{"code":"main.c","type":"codeVoice"},{"text":" is the semantic authority this package is","type":"text"},{"text":" ","type":"text"},{"text":"checked against: where the format’s own documentation is silent or ambiguous,","type":"text"},{"text":" ","type":"text"},{"code":"main.c","type":"codeVoice"},{"text":"’s behavior — including its recoveries, its clamps, and its hard","type":"text"},{"text":" ","type":"text"},{"text":"errors — is what IvorDKM reproduces. Several corrections to this","type":"text"},{"text":" ","type":"text"},{"text":"package’s own earlier doc comments trace back to reading that source directly","type":"text"},{"text":" ","type":"text"},{"text":"rather than the format’s PDF documentation alone.","type":"text"}]},{"anchor":"Parsing","type":"heading","level":2,"text":"Parsing"},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMParser"},{"text":" decodes raw UTF-8 text data into a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMScore"},{"text":":","type":"text"}]},{"type":"codeListing","code":["let (score, diagnostics) = try DKMParser().parse(data)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The parser is tolerant of two specific, provably-safe deviations from the","type":"text"},{"text":" ","type":"text"},{"text":"reference implementation’s own conventions, and reports each repair as a","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMParser\/Diagnostic"},{"text":": a ","type":"text"},{"code":"`\/GEQ`","type":"codeVoice"},{"text":" line whose band-gain count does not","type":"text"},{"text":" ","type":"text"},{"text":"match the reference’s fixed 30, and an integer-typed parameter (such as","type":"text"},{"text":" ","type":"text"},{"code":"numberOfVoices","type":"codeVoice"},{"text":") written with a fractional part, which the reference itself","type":"text"},{"text":" ","type":"text"},{"text":"reads as a ","type":"text"},{"code":"double","type":"codeVoice"},{"text":" and truncates. Diagnostics are always returned, never","type":"text"},{"text":" ","type":"text"},{"text":"thrown; each has a human-readable ","type":"text"},{"code":"message","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","code":["for diagnostic in diagnostics {","    print(diagnostic.message)","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The parser throws ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMParser\/Error"},{"text":" when the data cannot be decoded at","type":"text"},{"text":" ","type":"text"},{"text":"all — invalid UTF-8, a data line with the wrong parameter count or an","type":"text"},{"text":" ","type":"text"},{"text":"unparseable value, an unrecognized section name, or a data line before any","type":"text"},{"text":" ","type":"text"},{"text":"section has been established:","type":"text"}]},{"type":"codeListing","code":["do {","    let (score, _) = try DKMParser().parse(data)","} catch let error as DKMParser.Error {","    print(error.message)","}"],"syntax":"swift"},{"anchor":"Normalizing","type":"heading","level":2,"text":"Normalizing"},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMNormalizer"},{"text":" mechanically canonicalizes a score, returning a new score","type":"text"},{"text":" ","type":"text"},{"text":"whose ","type":"text"},{"code":"isNormalized","type":"codeVoice"},{"text":" flag is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":", together with a list of the changes it","type":"text"},{"text":" ","type":"text"},{"text":"applied:","type":"text"}]},{"type":"codeListing","code":["let (normalized, changes) = DKMNormalizer().normalize(score)","","for change in changes {","    print(change.message)        \/\/ what was changed","    print(change.commandIndex)   \/\/ which command in the input score, if any","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Canonical form clamps a negative start beat or duration to zero on every","type":"text"},{"text":" ","type":"text"},{"text":"command except a note, rewrites a ","type":"text"},{"code":"`\/Levels`","type":"codeVoice"},{"text":" line’s continuation start","type":"text"},{"text":" ","type":"text"},{"text":"beat (a negative value, meaning “continue from where the previous ","type":"text"},{"code":"\/Levels","type":"codeVoice"},{"text":" ","type":"text"},{"text":"line ended”) to the absolute beat it resolves to, and drops a","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMCommand\/haas(_:)"},{"text":", ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMCommand\/tuning(_:)"},{"text":",","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMCommand\/soundFileName(_:)"},{"text":", or ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMCommand\/screenOut(_:)"},{"text":" command that","type":"text"},{"text":" ","type":"text"},{"text":"merely restates the value already in effect. A negative start beat on a note","type":"text"},{"text":" ","type":"text"},{"text":"is left alone — in the reference implementation it terminates the score","type":"text"},{"text":" ","type":"text"},{"text":"rather than requesting a repair, and clamping it would silently discard that","type":"text"},{"text":" ","type":"text"},{"text":"meaning. See ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMNormalizer\/normalize(_:)"},{"text":" for the full list of changes","type":"text"},{"text":" ","type":"text"},{"text":"considered and rejected.","type":"text"}]},{"anchor":"Validating","type":"heading","level":2,"text":"Validating"},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMValidator"},{"text":" checks a ","type":"text"},{"type":"strong","inlineContent":[{"text":"normalized","type":"text"}]},{"text":" score against the reference","type":"text"},{"text":" ","type":"text"},{"text":"implementation’s parameter constraints:","type":"text"}]},{"type":"codeListing","code":["let (validated, issues) = try DKMValidator().validate(normalized)","","if issues.isEmpty {","    \/\/ `validated.isValidated` is now true.","} else {","    issues.forEach { print($0.message) }","}"],"syntax":"swift"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"If the score has not been normalized, ","type":"text"},{"code":"validate(_:)","type":"codeVoice"},{"text":" throws","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMValidator\/Error\/notNormalized","type":"reference","isActive":true},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"If any issues are found, the returned score is the ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"input unchanged"}]},{"text":" (its","type":"text"},{"text":" ","type":"text"},{"code":"isValidated","type":"codeVoice"},{"text":" flag stays ","type":"text"},{"code":"false","type":"codeVoice"},{"text":"). Fix the issues — or run it through the","type":"text"},{"text":" ","type":"text"},{"text":"normalizer again after editing — and validate again.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Only when the issues array is empty does the returned score have","type":"text"},{"text":" ","type":"text"},{"code":"isValidated == true","type":"codeVoice"},{"text":" — the prerequisite for formatting.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Every ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMValidator\/Issue"},{"text":" case names a value the reference implementation","type":"text"},{"text":" ","type":"text"},{"text":"cannot recover from silently: it either invents a replacement with a warning,","type":"text"},{"text":" ","type":"text"},{"text":"or halts outright. This includes a beat beyond the reference’s fixed","type":"text"},{"text":" ","type":"text"},{"code":"8192","type":"codeVoice"},{"text":"-entry tempo table, a ","type":"text"},{"code":"`\/GEQ`","type":"codeVoice"},{"text":" line with the wrong band-gain count, a","type":"text"},{"text":" ","type":"text"},{"text":"non-finite or out-of-range parameter, a non-positive duration or tempo, an","type":"text"},{"text":" ","type":"text"},{"text":"unwritable name, an incomplete graphic EQ segment, and a clip or vocode note","type":"text"},{"text":" ","type":"text"},{"text":"with no preceding mode command. Instrument and clip ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"names","type":"text"}]},{"text":" are notably","type":"text"},{"text":" ","type":"text"},{"type":"strong","inlineContent":[{"text":"not","type":"text"}]},{"text":" checked for existence — the reference implementation resolves those","type":"text"},{"text":" ","type":"text"},{"text":"against an external instrument file and clip list file, and this package does","type":"text"},{"text":" ","type":"text"},{"text":"no file I\/O, so it cannot know whether a name is valid.","type":"text"}]},{"anchor":"Formatting","type":"heading","level":2,"text":"Formatting"},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMFormatter"},{"text":" serializes a ","type":"text"},{"type":"strong","inlineContent":[{"text":"validated","type":"text"}]},{"text":" score back to binary data:","type":"text"}]},{"type":"codeListing","code":["let data = try DKMFormatter().format(validated)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"If the score has not been validated, ","type":"text"},{"code":"format(_:)","type":"codeVoice"},{"text":" throws","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMFormatter\/Error\/notValidated"},{"text":". Because the model is validated first,","type":"text"},{"text":" ","type":"text"},{"text":"formatting itself only fails on a string argument containing characters the","type":"text"},{"text":" ","type":"text"},{"text":"JohnnySonic format cannot represent.","type":"text"}]},{"anchor":"The-round-trip-contract","type":"heading","level":3,"text":"The round-trip contract"},{"type":"paragraph","inlineContent":[{"text":"Round-tripping through ","type":"text"},{"code":"parse → format","type":"codeVoice"},{"text":" is ","type":"text"},{"type":"strong","inlineContent":[{"text":"AST-stable, not byte-stable","type":"text"}]},{"text":", in","type":"text"},{"text":" ","type":"text"},{"text":"two independent ways:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Section spelling."}]},{"text":" The parser recognizes a section by the first three","type":"text"},{"text":" ","type":"text"},{"text":"characters of its name; the formatter always emits the canonical spelling","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"`\/ScreenOut`","type":"codeVoice"},{"text":", never ","type":"text"},{"code":"`\/ScreenOutput`","type":"codeVoice"},{"text":"). A score written with the","type":"text"},{"text":" ","type":"text"},{"text":"reference implementation’s own real-world spellings re-parses to the same","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMCommand","type":"reference","isActive":true},{"text":", but the formatted bytes differ from the input.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Number formatting."}]},{"text":" A value written as ","type":"text"},{"code":"60","type":"codeVoice"},{"text":" parses to ","type":"text"},{"code":"60.0","type":"codeVoice"},{"text":" and prints","type":"text"},{"text":" ","type":"text"},{"text":"back as ","type":"text"},{"code":"\"60.0\"","type":"codeVoice"},{"text":". So ","type":"text"},{"code":"format(parse(x)) != x","type":"codeVoice"},{"text":" at the byte level in general —","type":"text"},{"text":" ","type":"text"},{"text":"but the pipeline is idempotent from the second generation onward:","type":"text"},{"text":" ","type":"text"},{"code":"format(parse(format(parse(x)))) == format(parse(x))","type":"codeVoice"},{"text":".","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"The contract to rely on, and the one this package’s own round-trip tests","type":"text"},{"text":" ","type":"text"},{"text":"assert, is: ","type":"text"},{"code":"parse → format → parse","type":"codeVoice"},{"text":" produces a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMScore"},{"text":" equal to the one","type":"text"},{"text":" ","type":"text"},{"text":"you started with, and formatting that result a second time is byte-identical","type":"text"},{"text":" ","type":"text"},{"text":"to the first. Never assert byte equality against the original input.","type":"text"}]},{"anchor":"The-AST-model","type":"heading","level":2,"text":"The AST model"},{"type":"paragraph","inlineContent":[{"text":"The syntactic model is a flat list of commands:","type":"text"}]},{"type":"codeListing","code":["DKMScore","└─ commands: [DKMCommand]   \/\/ .chorusLine | .clipMode | .clipNote | … | .vocodeNote"],"syntax":null},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMCommand"},{"text":" is an enum with one case per JohnnySonic section or note type;","type":"text"},{"text":" ","type":"text"},{"text":"a case whose section carries more than one line-worth of parameters wraps them","type":"text"},{"text":" ","type":"text"},{"text":"in a dedicated payload type (","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMChorusLine"},{"text":", ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMPitchesNote"},{"text":", and so on).","type":"text"},{"text":" ","type":"text"},{"text":"Command order is meaningful: settings and mode commands are sticky, applying","type":"text"},{"text":" ","type":"text"},{"text":"to every subsequent command until overridden, and section headers compress a","type":"text"},{"text":" ","type":"text"},{"text":"maximal run of same-kind lines — this is why ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMNormalizer"},{"text":" never reorders","type":"text"},{"text":" ","type":"text"},{"text":"commands.","type":"text"}]},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMScore"},{"text":" equality and hashing compare ","type":"text"},{"code":"commands","type":"codeVoice"},{"text":" only; ","type":"text"},{"code":"isNormalized","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"isValidated","type":"codeVoice"},{"text":" are pipeline metadata and are excluded.","type":"text"}]},{"anchor":"Building-a-score-programmatically","type":"heading","level":2,"text":"Building a score programmatically"},{"type":"paragraph","inlineContent":[{"text":"You can construct the AST directly rather than parsing bytes:","type":"text"}]},{"type":"codeListing","code":["let note = DKMPitchesNote(startBeat: 0.0,","                          duration: 4.0,","                          volume: 1.0,","                          location: 0.0,","                          startPitch: 60.0,","                          endPitch: 60.0,","                          instrument: \"Piano\")","","let score = DKMScore(commands: [.soundFileName(\"Data\/Output.AIFF\"),","                                .pitchesNote(note),","                                .end])"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"A directly-constructed score has ","type":"text"},{"code":"isNormalized == false","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"isValidated == false","type":"codeVoice"},{"text":" — exactly like one fresh out of the parser — so it must be run through","type":"text"},{"text":" ","type":"text"},{"text":"the normalizer and validator before formatting.","type":"text"}]},{"anchor":"Error-handling","type":"heading","level":2,"text":"Error handling"},{"type":"paragraph","inlineContent":[{"text":"Thrown errors conform to ","type":"text"},{"type":"codeVoice","code":"EnhancedError"},{"text":" (from","type":"text"},{"type":"text","text":" "},{"type":"reference","identifier":"https:\/\/github.com\/eBardX\/XestiTools","isActive":true},{"type":"text","text":"): each has a "},{"type":"codeVoice","code":"category"},{"type":"text","text":" of"},{"type":"text","text":" "},{"type":"codeVoice","code":"\"IvorDKM\""},{"text":" and a human-readable ","type":"text"},{"code":"message","type":"codeVoice"},{"text":".","type":"text"}]},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Type","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Thrown by","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMParser\/Error","isActive":true,"type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"code":"DKMParser.parse(_:)","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMValidator\/Error","isActive":true,"type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"DKMValidator.validate(_:)"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMFormatter\/Error","isActive":true,"type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"code":"DKMFormatter.format(_:)","type":"codeVoice"}]}]]],"type":"table","alignments":["left","left"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Non-fatal results are returned rather than thrown, and each also provides a"},{"type":"text","text":" "},{"type":"codeVoice","code":"message"},{"type":"text","text":":"}]},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Type"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Returned by"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Also"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMParser\/Diagnostic","isActive":true,"type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"code":"parse(_:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"—"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/IvorDKM\/documentation\/IvorDKM\/DKMNormalizer\/Change","isAct