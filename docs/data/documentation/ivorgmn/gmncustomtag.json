{"seeAlsoSections":[{"anchor":"Tags","identifiers":["doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNTag","doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNReservedTag"],"title":"Tags","generated":true}],"hierarchy":{"paths":[["doc:\/\/IvorGMN\/documentation\/IvorGMN"]]},"topicSections":[{"anchor":"Initializers","identifiers":["doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNCustomTag\/init(ident:name:parameters:body:)"],"title":"Initializers","generated":true},{"anchor":"Instance-Properties","identifiers":["doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNCustomTag\/body","doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNCustomTag\/ident-swift.property","doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNCustomTag\/name-swift.property","doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNCustomTag\/parameters"],"title":"Instance Properties","generated":true},{"anchor":"Type-Aliases","identifiers":["doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNCustomTag\/Ident-swift.typealias","doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNCustomTag\/Name-swift.typealias","doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNCustomTag\/Parameter"],"title":"Type Aliases","generated":true},{"anchor":"Default-Implementations","identifiers":["doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNCustomTag\/Equatable-Implementations"],"title":"Default Implementations","generated":true}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNCustomTag"},"metadata":{"externalID":"s:7IvorGMN12GMNCustomTagV","modules":[{"name":"IvorGMN"}],"title":"GMNCustomTag","roleHeading":"Structure","symbolKind":"struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"GMNCustomTag"}],"role":"symbol","navigatorTitle":[{"text":"GMNCustomTag","kind":"identifier"}]},"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","relationshipsSections":[{"type":"conformsTo","identifiers":["doc:\/\/IvorGMN\/s8CopyableP","doc:\/\/IvorGMN\/SQ","doc:\/\/IvorGMN\/s9