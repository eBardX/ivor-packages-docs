text":"to give it meaning.","type":"text"}]},{"level":2,"anchor":"What-lands-here","text":"What lands here","type":"heading"},{"inlineContent":[{"type":"text","text":"A name outside GMN’s reserved vocabulary: "},{"type":"codeVoice","code":"\\bembel"},{"type":"text","text":", "},{"type":"codeVoice","code":"\\splitChord"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"\\shortFermata"},{"type":"text","text":", "},{"type":"codeVoice","code":"\\chord"},{"type":"text","text":", and anything a consumer invents. Nothing reads"},{"type":"text","text":" "},{"text":"what was written to such a tag, so there is no schema to bind against and","type":"text"},{"text":" ","type":"text"},{"text":"nothing to model. It round-trips byte for byte and realizes as a no-op.","type":"text"}],"type":"paragraph"},{"text":"What does not land here","level":2,"anchor":"What-does-not-land-here","type":"heading"},{"inlineContent":[{"type":"text","text":"A reserved name that failed to promote is "},{"type":"reference","identifier":"doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNTag\/reserved(_:)","isActive":true},{"type":"text","text":", not"},{"type":"text","text":" "},{"text":"this. The distinction is enforced by ","type":"text"},{"identifier":"doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNCustomTag\/init(ident:name:parameters:body:)","type":"reference","isActive":true},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"which fails for a reserved name — so a ","type":"text"},{"type":"codeVoice","code":"GMNCustomTag"},{"text":" never carries a","type":"text"},{"text":" ","type":"text"},{"text":"reserved name, at any stage, and the case cannot be used as a general","type":"text"},{"text":" ","type":"text"},{"text":"escape hatch.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://IvorGMN/documentation/IvorGMN/GMNCustomTag/ident-swift.property":{"role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"kind":"text","text":" "},{