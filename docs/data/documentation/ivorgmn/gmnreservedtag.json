"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reserved","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:7IvorGMN14GMNReservedTagV","text":"GMNReservedTag","kind":"typeIdentifier"},{"text":")","kind":"text"}],"type":"topic","identifier":"doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNTag\/reserved(_:)","url":"\/documentation\/ivorgmn\/gmntag\/reserved(_:)"},"doc://IvorGMN/documentation/IvorGMN/GMNReservedTag/Ident-swift.typealias":{"title":"GMNReservedTag.Ident","abstract":[{"text":"The optional numeric identifier of a reserved tag.","type":"text"}],"role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"Ident"}],"type":"topic","identifier":"doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNReservedTag\/Ident-swift.typealias","navigatorTitle":[{"kind":"identifier","text":"Ident"}],"url":"\/documentation\/ivorgmn\/gmnreservedtag\/ident-swift.typealias"},"doc://IvorGMN/documentation/IvorGMN/GMNTag/custom(_:)":{"identifier":"doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNTag\/custom(_:)","url":"\/documentation\/ivorgmn\/gmntag\/custom(_:)","kind":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"custom"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:7IvorGMN12GMNCustomTagV","text":"GMNCustomTag"},{"kind":"text","text":")"}],"abstract":[{"type":"text","text":"A tag GMN does not reserve, carried as written."}],"role":"symbol","title":"GMNTag.custom(_:)","type":"topic"},"doc://IvorGMN/documentation/IvorGMN/GMNScore":{"identifier":"doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNScore","url":"\/documentation\/ivorgmn\/gmnscore","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"GMNScore"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"GMNScore"}],"abstract":[{"text":"A parsed Guido Music Notation score.","type":"