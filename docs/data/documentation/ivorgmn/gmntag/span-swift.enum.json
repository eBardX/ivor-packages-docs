{"metadata":{"externalID":"s:7IvorGMN6GMNTagO4SpanO","modules":[{"name":"IvorGMN"}],"title":"GMNTag.Span","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Span","kind":"identifier"}],"extendedModule":"IvorGMN","navigatorTitle":[{"text":"Span","kind":"identifier"}],"symbolKind":"enum","roleHeading":"Enumeration"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"enum"},{"text":" ","kind":"text"},{"text":"Span","kind":"identifier"}]}]},{"mentions":["doc:\/\/IvorGMN\/documentation\/IvorGMN\/UsingIvorGMN"],"kind":"mentions"},{"content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Roughly forty tag names are the ","type":"text"},{"code":"…Begin","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"…End","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"halves of about fifteen base tags — "},{"code":"\\slurBegin","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"\\slurEnd","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"\\crescBegin","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"\\crescEnd","type":"codeVoice"},{"type":"text","text":", "},{"code":"\\tieBegin","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"\\tieEnd","type":"codeVoice"},{"type":"text","text":", and so on. Rather"},{"type":"text","text":" "},{"type":"text","text":"than give each half its own payload, one payload carries a "},{"code":"Span","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNTag\/Span-swift.enum\/whole","type":"reference","isActive":true},{"text":": the range form, ","type":"text"},{"code":"\\slur(c d e)","type":"codeVoice"},{"text":" — the tag owns a body.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNTag\/Span-swift.enum\/begin","type":"reference","isActive":true},{"text":" \/ ","type":"text"},{"identifier":"doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNTag\/Span-swift.enum\/end","type":"reference","isActive":true},{"text":": the open form, ","type":"text"},{"code":"\\slurBegin c d \\slurEnd","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"optionally paired by a ","type":"text"},{"identifier":"doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNTag\/Ident-swift.struct","type":"reference","isActive":true},{"text":" suffix.","type":"text"}]}]}]},{"type":"heading","level":2,"anchor":"The-two-forms-are-never-interchanged","text":"The two forms are never interchanged"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"code":"Begin","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"End","type":"codeVoice"},{"type":"text","text":" pair is not rewritten into a range, nor a range into a"},{"type":"text","text":" "},{"type":"text","text":"pair, on grounds of totality: open spans may overlap or go"},{"type":"text","text":" "},{"type":"text","text":"unterminated, and a range is a tree that can express neither."},{"type":"text","text":" "},{"type":"text","text":"A real score may contain"},{"type":"text","text":" "},{"code":"\\slurBegin:1 \\beam( b\/16 \\crescBegin c3 d e&) \\slurEnd:1 \\crescEnd","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which interleaves three spans across the beam’s range. Restricting the"},{"type":"text","text":" "},{"type":"text","text":"rewrite to the safe subset would be worse than not doing it: identical"},{"type":"text","text":" "},{"type":"text","text":"fragments would format differently depending on distant context."}]},{"type":"heading","level":2,"anchor":"An-end-carries-no-parameters","text":"An `end` carries no parameters"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every "},{"code":"…End","type":"codeVoice"},{"type":"text","text":" name takes no parameters at all. A payload whose span is"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNTag\/Span-swift.enum\/end"},{"type":"text","text":" therefore refuses typed parameters, and none is ever emitted."},{"type":"text","text":" "},{"type":"text","text":"Parameters written on an "},{"code":"…End","type":"codeVoice"},{"type":"text","text":" tag keep it reserved"},{"type":"text","text":" "},{"type":"text","text":"through the parser, and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNNormalizer"},{"type":"text","text":" drops them —"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNNormalizer\/Change\/droppedSpanEndParameters(_:)"},{"type":"text","text":" — so the tag"},{"type":"text","text":" "},{"type":"text","text":"promotes on the second pass."}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/IvorGMN\/documentation\/IvorGMN","doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNTag"]]},"abstract":[{"text":"Which part of a spanning construct a Guido Music Notation tag is.","type":"text"}],"kind":"symbol","sections":[],"relationshipsSections":[{"type":"conformsTo","kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/IvorGMN\/s8CopyableP","doc:\/\/IvorGMN\/SQ","doc:\/\/IvorGMN\/s9EscapableP","doc:\/\/IvorGMN\/SH","doc:\/\/IvorGMN\/s8SendableP","doc:\/\/IvorGMN\/s16SendableMetatypeP"]}],"identifier":{"url":"doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNTag\/Span-swift.enum","interfaceLanguage":"swift"},"topicSections":[{"identifiers":["doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNTag\/Span-swift.enum\/begin","doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNTag\/Span-swift.enum\/end","doc:\/\/IvorGMN\/documentation\/IvorGMN\/G