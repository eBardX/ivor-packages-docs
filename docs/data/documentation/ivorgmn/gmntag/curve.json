":[{"type":"text","text":"Always used as "},{"type":"codeVoice","code":"Curve?"},{"type":"text","text":", where "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" means either no "},{"type":"codeVoice","code":"curve"},{"type":"text","text":" was"},{"type":"text","text":" "},{"type":"text","text":"written at all (the renderer decides) or a value outside the closed"},{"type":"text","text":" "},{"type":"codeVoice","code":"up"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"down"},{"type":"text","text":" vocabulary was written. Both are reported the same way a"},{"type":"text","text":" "},{"type":"text","text":"closed-vocabulary "},{"type":"codeVoice","code":"position"},{"type":"text","text":" is — see"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNValidator\/Issue\/unreadableParameterValue(_:)"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"GMNTagBinder.Binding.hasUnreadableCurve(named:)"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"heading","text":"The parse is closed, and case-insensitive","level":2,"anchor":"The-parse-is-closed-and-case-insensitive"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Unlike guidolib’s own total parse (above), this type does not treat"},{"type":"text","text":" "},{"type":"text","text":"every unrecognized spelling as "},{"type":"codeVoice","code":"up"},{"type":"text","text":" — "},{"type":"codeVoice","code":"\\slur<curve=\"banana\">"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"\\slur<curve=\"up\">"},{"type":"text","text":" are not read as the same score, so "},{"type":"codeVoice","code":"\"banana\""},{"type":"text","text":" "},{"type":"text","text":"stays reserved rather than silently promoting to "},{"type":"codeVoice","code":"up"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Case is the one plac