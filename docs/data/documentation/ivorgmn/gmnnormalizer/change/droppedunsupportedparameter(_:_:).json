"},{"type":"text","text":" "},{"type":"text","text":"of the name it was written under. Such a tag stays"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNTag\/reserved(_:)","isActive":true},{"type":"text","text":", and on a parsed score the reference has"},{"type":"text","text":" "},{"type":"text","text":"already been refused by"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNParser\/Error\/unresolvableVariableReference(_:)","isActive":true},{"type":"text","text":" — the"},{"type":"text","text":" "},{"type":"text","text":"exemption is what a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"hand-built"}]},{"type":"text","text":" score relies on, since no"},{"type":"text","text":" "},{"type":"text","text":"rejection guards that path. A reference that "},{"type":"emphasis","inlineContent":[{"type":"text","text":"does"}]},{"type":"text","text":" resolve is"},{"type":"text","text":" "},{"type":"text","text":"substituted first — see "},{"type":"reference","identifier":"doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNNormalizer\/Change\/expandedVariableReference(_:_:)","isActive":true},{"type":"text","text":" — and"},{"type":"text","text":" "},{"type":"text","text":"whatever it expands to is then dropped like any other unsupported"},{"type":"text","text":" "},{"type":"text","text":"value, so "},{"type":"codeVoice","code":"\\beam<bogus=$x>"},{"type":"text","text":" records both changes."}],"type":"paragraph"}]}],"kind":"symbol","abstract":[{"text":"A parameter the tag does not support was dropped. The associated","type":"text"},{"text":" ","type":"text"},{"text":"values are the tag name it appeared on and the name it bound to.","type":"text"}],"metadata":{"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"droppedUnsupportedParameter"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"GMNTag"