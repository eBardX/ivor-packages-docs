rser would turn "},{"type":"codeVoice","code":"$x = 1; [\\beam<dy=$x>(c d)]"},{"type":"text","text":" into"},{"type":"text","text":" "},{"type":"codeVoice","code":"[\\beam<dy=1>(c d)]"},{"type":"text","text":" with the declaration left dangling."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A reference in "},{"type":"emphasis","inlineContent":[{"type":"text","text":"symbol"}]},{"type":"text","text":" position is untouched by this; splicing"},{"type":"text","text":" "},{"type":"text","text":"that one in is not implemented anywhere in IvorGMN."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A reference to a name no declaration carries is left exactly as"},{"type":"text","text":" "},{"type":"text","text":"written rather than guessed at. "},{"type":"reference","identifier":"doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNParser","isActive":true},{"type":"text","text":" has already refused"},{"type":"text","text":" "},{"type":"text","text":"one on a parsed score — see"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNParser\/Error\/unresolvableVariableReference(_:)","isActive":true},{"type":"text","text":" — so this is"},{"type":"text","text":" "},{"type":"text","text":"what a hand-built score relies on."}]}],"kind":"content"}],"references":{"doc://IvorGMN/documentation/IvorGMN/GMNTag/Name-swift.struct":{"type":"topic","abstract":[{"text":"The name of a Guido Music Notation tag.","type":"text"}],"role":"symbol","identifier":"doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNTag\/Name-swift.struct","url":"\/documentation\/ivorgmn\/gmntag\/name-swift.struct","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Name"}],"title":"GMNTag.Name","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Name"}]},"doc://IvorGMN/documentation/IvorGMN/GMNNormalizer":{"url":"\/documentation\/ivorgmn\/gmnnormalizer","role":"symbol","identifier":"doc: