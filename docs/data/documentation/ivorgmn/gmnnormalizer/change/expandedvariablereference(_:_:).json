{"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"type":"text","text":"A "},{"type":"codeVoice","code":"$variable"},{"type":"text","text":" reference in tag-parameter position was substituted"},{"type":"text","text":" "},{"type":"text","text":"by the value its declaration carries. The associated values are"},{"type":"text","text":" "},{"type":"text","text":"the tag name it appeared on and the variable name."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"expandedVariableReference"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"GMNTag","identifier":"doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNTag","preciseIdentifier":"s:7IvorGMN6GMNTagO"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Name","identifier":"doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNTag\/Name-swift.struct","preciseIdentifier":"s:7IvorGMN6GMNTagO4NameV"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"GMNVariable","identifier":"doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNVariable","preciseIdentifier":"s:7IvorGMN11GMNVariableV"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Name","identifier":"doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNVariable\/Name-swift.struct","preciseIdentifier":"s:7IvorGMN11GMNVariableV4NameV"},{"kind":"text","text":")"}]}]},{"content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The substituted value "},{"type":"strong","inlineContent":[{"type":"text","text":"never carries a unit"}]},{"type":"text","text":", whatever the"},{"type":"text","text":" "},{"type":"text","text":"declaration says. Where a name is declared more than once, the"},{"type":"text","text":" "},{"type":"text","text":"last declaration wins."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The substitution is unambiguous because a declaration is a"},{"type":"text","text":" "},{"type":"text","text":"prologue only, so the environment is complete before any"},{"type":"text","text":" "},{"type":"text","text":"reference. It is done here rather than in "},{"type":"reference","identifier":"doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNParser","isActive":true},{"type":"text","text":" so that a"},{"type":"text","text":" "},{"type":"text","text":"parsed score still round-trips byte for byte — expanding at the"},{"type":"text","text":" "},{"type":"text","text":"parser would turn "},{"type":"codeVoice","code":"$x = 1; [\\beam<dy=$x>(c d)]"},{"type":"text","text":" into"},{"type":"text","text":" "},{"type":"codeVoice","code":"[\\beam<dy=1>(c d)]"},{"type":"text","text":" with the declaration left dangling."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A reference in "},{"type":"emphasis","inlineContent":[{"type":"text","text":"symbol"}]},{"type":"text","text":" position is untouched by this; splicing"},{"type":"text","text":" "},{"type":"text","text":"that one in is not implemented anywhere in IvorGMN."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A reference to a name no declaration carries is left exactly as"},{"type":"text","text":" "},{"type":"text","text":"written rather than guessed at. "},{"type":"reference","identifier":"doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNParser","isActive":true},{"type":"text","text":" has already refused"},{"type":"text","text":" "},{"type":"text","text":"one on a parsed score — see"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNParser\/Error\/unresolvableVariableReference(_:)","isActive":true},{"type":"text","text":" — so this is"},{"type":"text","text":" "},{"type":"text","text":"what a hand-built score relies on."}]}],"kind":"content"}],"sections":[],"metadata":{"roleHeading":"Case","symbolKind":"case","externalID":"s:7IvorGMN13GMNNormalizerV6ChangeO25expandedVariableReferenceyAeA6GMNTagO4NameV_AA11GMNVariableVAIVtcAEmF","modules":[{"name":"IvorGMN"}],"title":"GMNNormalizer.Change.expandedVariableReference(_:_:)","role":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"expandedVariableReference"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"GMNTag","preciseIdentifier":"s:7IvorGMN6GMNTagO"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Name","preciseIdentifier":"s:7IvorGMN6GMNTagO4NameV"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"GMNVariable","preciseIdentifier":"s:7IvorGMN11GMNVariableV"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Name","preciseIdentifier":"s:7IvorGMN11GMNVariableV4NameV"},{"kind":"text","text":")"}]},"hierarchy":{"paths":[["doc:\/\/IvorGMN\/documentation\/IvorGMN","doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNNormalizer","doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNNormalizer\/Change"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNNormalizer\/Change\/expandedVariableReference(_:_:)"},"variants":[{"paths":["\/documentation\/ivorgmn\/gmnnormalizer\/change\/expandedvariablereference(_:_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","references":{"doc://IvorGMN/documentation/IvorGMN/GMNNormalizer":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GMNNormalizer","kind":"identifier"}],"identifier":"doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNNormalizer","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"A type that normalizes a Guido Music Notation score to canonical form."}],"title":"GMNNormalizer","role":"symbol","navigatorTitle":[{"text":"GMNNormalizer","kind":"identifier"}],"url":"\/documentation\/ivorgmn\/gmnnormalizer"},"doc://IvorGMN/documentation/IvorGMN/GMNVariable/Name-swift.struct":{"abstract":[{"text":"The name of a Guido Music Not