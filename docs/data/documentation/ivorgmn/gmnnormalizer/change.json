{"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"type":"text","text":"A change applied when normalizing a "},{"identifier":"doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNScore","type":"reference","isActive":true},{"type":"text","text":" to canonical form."}],"relationshipsSections":[{"kind":"relationships","type":"conformsTo","identifiers":["doc:\/\/IvorGMN\/s8CopyableP","doc:\/\/IvorGMN\/SQ","doc:\/\/IvorGMN\/s9EscapableP","doc:\/\/IvorGMN\/s8SendableP","doc:\/\/IvorGMN\/s16SendableMetatypeP"],"title":"Conforms To"}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Change","kind":"identifier"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"mentions","mentions":["doc:\/\/IvorGMN\/documentation\/IvorGMN\/UsingIvorGMN"]},{"kind":"content","content":[{"anchor":"Two-of-these-fire-far-less-often-than-they-used-to","level":2,"text":"Two of these fire far less often than they used to","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Before the typed tag model, normalization was where a tag’s name and"},{"type":"text","text":" "},{"type":"text","text":"its parameter names were put right, so"},{"type":"text","text":" "},{"identifier":"doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNNormalizer\/Change\/canonicalizedTagName(_:_:)","isActive":true,"type":"reference"},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNNormalizer\/Change\/renamedParameter(_:_:_:)","isActive":true},{"type":"text","text":" "},{"type":"text","text":"were reported for "},{"type":"emphasis","inlineContent":[{"type":"text","text":"every"}]},{"type":"text","text":" tag written with an alias or a deprecated"},{"type":"text","text":" "},{"type":"text","text":"parameter name. They are now reported only for a tag that failed to"},{"text":" ","type":"text"},{"text":"promote to a typed payload.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The canonicalization still happens either way — it just usually","type":"text"},{"text":" ","type":"text"},{"text":"happens in the parser, where promotion selects the payload and the","type":"text"},{"text":" ","type":"text"},{"text":"payload ","type":"text"},{"inlineContent":[{"text":"is","type":"text"}],"type":"emphasis"},{"text":" the canonical identity. A ","type":"text"},{"code":"\\bm","type":"codeVoice"},{"text":" becomes a ","type":"text"},{"identifier":"doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNBeam","isActive":true,"type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"identifier":"doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNBeam","isActive":true,"type":"reference"},{"text":" reports the name ","type":"text"},{"code":"beam","type":"codeVoice"},{"text":"; there was never an alias","type":"text"},{"text":" ","type":"text"},{"text":"stored to rewrite. Only a tag promotion rejected — an unknown","type":"text"},{"text":" ","type":"text"},{"text":"parameter, a value no field can carry — keeps its written name far","type":"text"},{"text":" ","type":"text"},{"text":"enough downstream for the normalizer’s fallback table to be the thing","type":"text"},{"text":" ","type":"text"},{"text":"that fixes it.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"So a caller that counted these changes to detect “this score used","type":"text"},{"text":" ","type":"text"},{"text":"short-form tag names” will now see nothing for a score it previously","type":"text"},{"text":" ","type":"text"},{"text":"reported on. ","type":"text"},{"inlineContent":[{"type":"text","text":"The formatted output is unchanged"}],"type":"strong"},{"text":": a ","type":"text"},{"code":"\\bm","type":"codeVoice"},{"text":" still","type":"text"},{"text":" ","type":"text"},{"text":"comes out ","type":"text"},{"code":"\\beam","type":"codeVoice"},{"text":". What changed is which stage says so, and th