accato<0.5>"},{"type":"text","text":" are therefore both reserved out of the parser and typed"},{"text":" ","type":"text"},{"text":"out of the normalizer. The pipeline already requires normalization before","type":"text"},{"text":" ","type":"text"},{"text":"formatting, and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNScore\/isNormalized","type":"reference"},{"text":" already marks the distinction,","type":"text"},{"text":" ","type":"text"},{"text":"so this fits the existing contract rather than adding to it — but a","type":"text"},{"text":" ","type":"text"},{"text":"consumer that switches over ","type":"text"},{"isActive":true,"identifier":"doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNTag","type":"reference"},{"text":" should read a ","type":"text"},{"inlineContent":[{"text":"normalized","type":"text"}],"type":"emphasis"},{"text":" score.","type":"text"}]}],"kind":"content"}],"references":{"doc://IvorGMN/documentation/IvorGMN/UsingIvorGMN":{"identifier":"doc:\/\/IvorGMN\/documentation\/IvorGMN\/UsingIvorGMN","kind":"article","role":"article","abstract":[{"text":"Take Guido Music Notation text from ","type":"text"},{"code":"Data","type":"codeVoice"},{"text":" to a validated syntax tree, and back","type":"text"},{"text":" ","type":"text"},{"text":"to ","type":"text"},{"code":"Data","type":"codeVoice"},{"text":".","type":"text"}],"url":"\/documentation\/ivorgmn\/usingivorgmn","type":"topic","title":"Using IvorGMN"},"doc://IvorGMN/documentation/IvorGMN/GMNParser/init()":{"identifier":"doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNParser\/init()","title":"init()","url":"\/documentation\/ivorgmn\/gmnparser\/init()","type":"topic","kind":"symbol","role":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"()","kind":"text"}],"abstract":[{"type":"text","text":"Creates a new Guido Music Notation parser."}]},"doc://IvorGMN/documentation/IvorGMN/GMNParser/parse(_:)":{"role":"symbol","fragments":[{"text":"func","kind":"k