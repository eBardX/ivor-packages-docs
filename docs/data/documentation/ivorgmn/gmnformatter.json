text","text":", not"},{"type":"text","text":" "},{"type":"text","text":"spelling."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Rules 1–4 rest on four facts about how Guido reads a tag: positional and"},{"type":"text","text":" "},{"type":"text","text":"named spellings are identical; parameter order carries no meaning; a"},{"type":"text","text":" "},{"text":"duplicate name overwrites, last one winning; and a wrongly-typed value is","type":"text"},{"text":" ","type":"text"},{"text":"inert.","type":"text"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Canonical tag name.","type":"text"}],"type":"strong"},{"text":" The long form, never an alias — ","type":"text"},{"code":"\\bm","type":"codeVoice"},{"type":"text","text":" is"},{"text":" ","type":"text"},{"type":"text","text":"emitted as "},{"type":"codeVoice","code":"\\beam"},{"type":"text","text":", "},{"type":"codeVoice","code":"\\rit"},{"type":"text","text":" as "},{"code":"\\ritardando","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Positional prefix, then named."}],"type":"strong"},{"type":"text","text":" A parameter is emitted unnamed for"},{"text":" ","type":"text"},{"text":"as long as it occupies the next consecutive slot of the tag’s own","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"template, starting at slot 0. At the first gap — a slot with no"},{"text":" ","type":"text"},{"text":"emitted value, whether the author omitted it or rule 5 dropped it —","type":"text"},{"text":" ","type":"text"},{"text":"every remaining parameter is named. So ","type":"text"},{"code":"\\tempo<\"Allegro\",120>","type":"codeVoice"},{"type":"text","text":" stays"},{"text":" ","type":"text"},{"text":"as written, while skipping ","type":"text"},{"code":"bpm","type":"codeVoice"},{"type":"text","text":" gives"},{"text":" ","type":"text"},{"code":"\\tempo<\"Allegro\",font=\"Times\">","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Declared order."}]},{"type":"text","text":" Parameters follow the tag’s own order, then any"},{"type":"text","text":" "},{"type":"text","text":"common appearance parameters ("},{"type":"codeVoice","code":"color"},{"type":"text","text":", "},{"type":"codeVoice","code":"dx"},{"type":"text","text":", "},{"type":"codeVoice","code":"dy"},{"type":"text","text":", "},{"code":"size","type":"codeVoice"},{"text":") in their","type":"text"},{"type":"text","text":" "},{"text":"declared order.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Duplicates collapsed","type":"text"}]},{"type":"text","text":", last-wins."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Defaults omitted only where provably unobservable."}],"type":"strong"},{"type":"text","text":" A parameter is"},{"type":"text","text":" "},{"type":"text","text":"dropped only when nothing can tell it apart from its default. All four"},{"type":"text","text":" "},{"type":"text","text":"common appearance parameters fail that test, so "},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNTag\/Appearance-swift.struct"},{"type":"text","text":" "},{"text":"is always emitted as written — ","type":"text"},{"code":"\\bar","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"\\bar<dx=0>","type":"codeVoice"},{"type":"text","text":" are observably"},{"type":"text","text":" "},{"type":"text","text":"different scores."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Barlines: "},{"code":"|","type":"codeVoice"},{"text":" when bare, ","type":"text"},{"code":"\\bar<…>","type":"codeVoice"},{"text":" when parameterized.","type":"text"}],"type":"strong"},{"type":"text","text":" The two are"},{"type":"text","text":" "},{"type":"text","text":"identical in that case alone; a barline carrying parameters or an"},{"type":"text","text":" "},{"type":"text","text":"identifier uses the long form."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Range form and ","type":"text"},{"code":"Begin","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"End","type":"codeVoice"},{"text":" form are both preserved","type":"text"}],"type":"strong"},{"type":"text","text":", never"},{"type":"text","text":" "},{"type":"text","text":"rewritten into each other."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Canonical form is "},{"type":"strong","inlineContent":[{"type":"text","text":"compact"}]},{"type":"text","text":", not maximally explicit."}]},{"type":"heading","level":2,"anchor":"Idempotence","text":"Idempotence"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Formatting canonical text again changes nothing: for any score "},{"type":"codeVoice","code":"s"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"format(parse(format(s))) == format(s)"},{"type":"text","text":". This is the property the"},{"type":"text","text":" "},{"type":"text","text":"canonicalization suite measures."}]}]}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivorgmn\/gmnformatter"]}],"metadata":{"symbolKind":"struct","modules":[{"name":"IvorGMN"}],"externalID":"s:7IvorGMN12GMNFormatterV","navigatorTitle":[{"kind":"identifier","text":"GMNFormatter"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GMNFormatter","kind":"identifier"}],"role":"symbol","roleHeading":"Structure","title":"GMNFormatter"},"abstract":[{"type":"text","text":"A type that formats a Guido Music Notation score as UTF-8 data."}],"schemaVersion":{"patch":0,"major":0,"minor":3},"topicSections":[{"title":"Initi