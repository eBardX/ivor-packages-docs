:"text","text":"spelling."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Rules 1–4 rest on four facts about how Guido reads a tag: positional and"},{"text":" ","type":"text"},{"text":"named spellings are identical; parameter order carries no meaning; a","type":"text"},{"text":" ","type":"text"},{"text":"duplicate name overwrites, last one winning; and a wrongly-typed value is","type":"text"},{"text":" ","type":"text"},{"text":"inert.","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Canonical tag name."}],"type":"strong"},{"text":" The long form, never an alias — ","type":"text"},{"code":"\\bm","type":"codeVoice"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"text":"emitted as ","type":"text"},{"code":"\\beam","type":"codeVoice"},{"text":", ","type":"text"},{"code":"\\rit","type":"codeVoice"},{"text":" as ","type":"text"},{"code":"\\ritardando","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Positional prefix, then named.","type":"text"}],"type":"strong"},{"text":" A parameter is emitted unnamed for","type":"text"},{"text":" ","type":"text"},{"text":"as long as it occupies the next consecutive slot of the tag’s own","type":"text"},{"text":" ","type":"text"},{"text":"template, starting at slot 0. At the first gap — a slot with no","type":"text"},{"text":" ","type":"text"},{"text":"emitted value, whether the author omitted it or rule 5 dropped it —","type":"text"},{"text":" ","type":"text"},{"text":"every remaining parameter is named. So ","type":"text"},{"code":"\\tempo<\"Allegro\",120>","type":"codeVoice"},{"text":" stays","type":"text"},{"text":" ","type":"text"},{"text":"as written, while skipping ","type":"text"},{"code":"bpm","type":"codeVoice"},{"text":" gives","type":"text"},{"text":" ","type":"text"},{"code":"\\tempo<\"Allegro\",font=\"Times\">","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Declared order."}],"type":"strong"},{"text":" Parameters follow the tag’s own order, then any","type":"text"},{"text":" ","type":"text"},{"text":"common appearance parameters (","type":"text"},{"code":"color","type":"codeVoice"},{"text":", ","type":"text"},{"code":"dx","type":"codeVoice"},{"text":", ","type":"text"},{"code":"dy","type":"codeVoice"},{"text":", ","type":"text"},{"code":"size","type":"codeVoice"},{"text":") in their","type":"text"},{"text":" ","type":"text"},{"text":"declared order.","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Duplicates collapsed"}],"type":"strong"},{"type":"text","text":", last-wins."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Defaults omitted only where provably unobservable.","type":"text"}],"type":"strong"},{"type":"text","text":" A parameter is"},{"type":"text","text":" "},{"type":"text","text":"dropped only when nothing can tell it apart from its default. All four"},{"type":"text","text":" "},{"type":"text","text":"common appearance parameters fail that test, so "},{"type":"reference","identifier":"doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNTag\/Appearance-swift.struct","isActive":true},{"type":"text","text":" "},{"type":"text","text":"is always emitted as written — "},{"type":"codeVoice","code":"\\bar"},{"type":"text","text":" and "},{"type":"codeVoice","code":"\\bar<dx=0>"},{"type":"text","text":" are observably"},{"type":"text","text":" "},{"type":"text","text":"different scores."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Barlines: ","type":"text"},{"code":"|","type":"codeVoice"},{"text":" when bare, ","type":"text"},{"code":"\\bar<…>","type":"codeVoice"},{"type":"text","text":" when parameterized."}],"type":"strong"},{"type":"text","text":" The two are"},{"type":"text","text":" "},{"typ