{"relationshipsSections":[{"type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/IvorGMN\/s8SendableP","doc:\/\/IvorGMN\/s16SendableMetatypeP"],"kind":"relationships"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNFormatter"},"topicSections":[{"anchor":"Initializers","title":"Initializers","generated":true,"identifiers":["doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNFormatter\/init()"]},{"anchor":"Instance-Methods","title":"Instance Methods","generated":true,"identifiers":["doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNFormatter\/format(_:)"]},{"anchor":"Enumerations","title":"Enumerations","generated":true,"identifiers":["doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNFormatter\/Error"]}],"seeAlsoSections":[{"anchor":"Processing","title":"Processing","generated":true,"identifiers":["doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNParser","doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNNormalizer","doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNValidator"]}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"GMNFormatter"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"mentions","mentions":["doc:\/\/IvorGMN\/documentation\/IvorGMN\/UsingIvorGMN"]},{"content":[{"anchor":"Canonical-form","text":"Canonical form","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The formatter does not reproduce the source text it was given. It emits"},{"type":"text","text":" "},{"type":"text","text":"the score’s "},{"inlineContent":[{"type":"text","text":"canonical spelling"}],"type":"strong"},{"type":"text","text":", and is free to re-spell anything Guido"},{"type":"text","text":" "},{"type":"text","text":"treats as equivalent: "},{"type":"codeVoice","code":"\\bm<dy=2hs>(c d)"},{"type":"text","text":" may come back as"},{"type":"text","text":" "},{"type":"codeVoice","code":"\\beam<dy=2hs>(c d)"},{"type":"text","text":", and "},{"type":"codeVoice","code":"\\meter<autoBarlines=\"off\",\"4\/4\">"},{"type":"text","text":" as"},{"type":"text","text":" "},{"type":"codeVoice","code":"\\meter<\"4\/4\",autoBarlines=\"off\">"},{"type":"text","text":". What is preserved is "},{"inlineContent":[{"type":"text","text":"meaning"}],"type":"strong"},{"type":"text","text":", not"},{"type":"text","text":" "},{"type":"text","text":"spelling."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Rules 1–4 rest on four facts about how Guido reads a tag: positional and"},{"type":"text","text":" "},{"type":"text","text":"named spellings are identical; parameter order carries no meaning; a"},{"type":"text","text":" "},{"type":"text","text":"duplicate name overwrites, last one winning; and a wrongly-typed value is"},{"type":"text","text":" "},{"type":"text","text":"inert."}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Canonical tag name."}]},{"type":"text","text":" The long form, never an alias — "},{"type":"codeVoice","code":"\\bm"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"emitted as "},{"type":"codeVoice","code":"\\beam"},{"type":"text","text":", "},{"type":"codeVoice","code":"\\rit"},{"type":"text","text":" as "},{"type":"codeVoice","code":"\\ritardando"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Positional prefix, then named."}]},{"type":"text","text":" A parameter is emitted unnamed for"},{"type":"text","text":" "},{"type":"text","text":"as long as it occupies the next consecutive slot of the tag’s own"},{"type":"text","text":" "},{"type":"text","text":"template, starting at slot 0. At the first gap — a slot with no"},{"type":"text","text":" "},{"type":"text","text":"emitted value, whether the author omitted it or rule 5 dropped it —"},{"type":"text","text":" "},{"type":"text","text":"every remaining parameter is named. So "},{"type":"codeVoice","code":"\\tempo<\"Allegro\",120>"},{"type":"text","text":" stays"},{"type":"text","text":" "},{"type":"text","text":"as written, while skipping "},{"type":"codeVoice","code":"bpm"},{"type":"text","text":" gives"},{"type":"text","text":" "},{"type":"codeVoice","code":"\\tempo<\"Allegro\",font=\"Times\">"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Declared order."}]},{"type":"text","text":" Parameters follow the tag’s own order, then any"},{"type":"text","text":" "},{"type":"text","text":"common appearance parameters ("},{"type":"codeVoice","code":"color"},{"type":"text","text":", "},{"type":"codeVoice","code":"dx"},{"type":"text","text":", "},{"type":"codeVoice","code":"dy"},{"type":"text","text":", "},{"type":"codeVoice","code":"size"},{"type":"text","text":") in their"},{"type":"text","text":" "},{"type":"text","text":"declared order."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Duplicates collapsed"}]},{"type":"text","text":", last-wins."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Defaults omitted only where provably unobservable."}]},{"type":"text","text":" A parameter is"},{"type":"text","text":" "},{"type":"text","text":"dropped only when nothing can tell it apart from its default. All four"},{"type":"text","text":" "},{"type":"text","text":"common appearance parameters fail that test, so "},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNTag\/Appearance-swift.struct"},{"type":"text","text":" "},{"type":"text","text":"is always emitted as written — "},{"type":"codeVoice","code":"\\bar"},{"type":"text","text":" and "},{"type":"codeVoice","code":"\\bar<dx=0>"},{"type":"text","text":" are observably"},{"type":"text","text":" "},{"type":"text","text":"different scores."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Barlines: "},{"type":"codeVoice","code":"|"},{"type":"text","text":" when bare, "},{"type":"codeVoice","code":"\\bar<…>"},{"type":"text","text":" when parameterized."}]},{"type":"text","text":" The two are"},{"type":"text","text":" "},{"type":"text","text":"identical in that case alone; a barline carrying parameters or an"},{"type":"text","text":" "},{"type":"text","text":"identifier uses the long form."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Range form and "},{"type":"codeVoice","code":"Begin"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"End"},{"type":"text","text":" form are both preserved"}]},{"type":"text","text":", never"},{"type":"text","text":" "},{"type":"text","text":"rewritten into each other."}]}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Canonical form is "},{"inlineContent":[{"type":"text","text":"compact"}],"type":"strong"},{"type":"text","text":", not maximally explicit."}]},{"anchor":"Idempotence","text":"Idempotence","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Formatting canonical text again changes nothing: for any score "},{"type":"codeVoice","code":"s"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"format(parse(format(s))) == format(s)"},{"type":"text","text":". This is the property the"},{"type":"text","text":" "},{"type":"text","text":"canonicalization suite measures."}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/ivorgmn\/gmnformatter"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"A type that formats a Guido Music Notation score as UTF-8 data.","type":"text"}],"metadata":{"roleHeading":"Structure","symbolKind":"struct","fragm