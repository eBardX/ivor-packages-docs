{"identifier":{"url":"doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNNormalizer","interfaceLanguage":"swift"},"seeAlsoSections":[{"generated":true,"title":"Processing","identifiers":["doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNParser","doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNValidator","doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNFormatter"],"anchor":"Processing"}],"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/IvorGMN\/s8SendableP","doc:\/\/IvorGMN\/s16SendableMetatypeP"],"kind":"relationships","type":"conformsTo"}],"hierarchy":{"paths":[["doc:\/\/IvorGMN\/documentation\/IvorGMN"]]},"sections":[],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"GMNNormalizer"}]}],"kind":"declarations"},{"mentions":["doc:\/\/IvorGMN\/documentation\/IvorGMN\/UsingIvorGMN"],"kind":"mentions"},{"content":[{"type":"heading","level":2,"anchor":"Normalization-is-what-makes-a-score-fully-typed","text":"Normalization is what makes a score fully typed"},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNParser"},{"type":"text","text":" promotes only the tags that bind cleanly as written. The"},{"type":"text","text":" "},{"type":"text","text":"normalizer performs the repairs that let the rest promote, then re-runs"},{"type":"text","text":" "},{"type":"text","text":"promotion on the result:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"a tag-name alias is collapsed to its canonical long form;","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"a deprecated parameter name is renamed to its current one;","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"a ","type":"text"},{"code":"$variable","type":"codeVoice"},{"text":" reference in tag-parameter position is substituted by its","type":"text"},{"text":" ","type":"text"},{"text":"declared value;","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"a parameter of the wrong type is dropped, since such a value is inert —","type":"text"},{"text":" ","type":"text"},{"code":"\\staccato<0.5>","type":"codeVoice"},{"text":" means the same as a bare ","type":"text"},{"code":"\\staccato","type":"codeVoice"},{"text":";","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"so is one written to a tag that keeps none, one written on an ","type":"text"},{"code":"…End","type":"codeVoice"},{"text":" ","type":"text"},{"text":"tag, and a raw (unquoted) identifier, none of which anything reads;","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"a unit written on a parameter that cannot carry one is dropped, keeping","type":"text"},{"text":" ","type":"text"},{"text":"the magnitude.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each of those is something Guido provably never reads, which is what"},{"type":"text","text":" "},{"type":"text","text":"licenses the repair: the score’s meaning is unchanged and the loss is"},{"type":"text","text":" "},{"type":"text","text":"announced rather than silent. The one thing no repair touches is a"},{"type":"text","text":" "},{"type":"codeVoice","code":"$variable"},{"type":"text","text":" reference no declaration answers, which has to survive to be"},{"type":"text","text":" "},{"type":"text","text":"reported."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each is reported as a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNNormalizer\/Change"},{"type":"text","text":". Re-running promotion is safe because"},{"type":"text","text":" "},{"type":"text","text":"promotion is a total, idempotent function of a tag’s name and parameters,"},{"type":"text","text":" "},{"type":"text","text":"with the two untyped lanes as its fallback: a tag that still does not"},{"type":"text","text":" "},{"type":"text","text":"bind is carried through exactly as written."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The visible consequence is that "},{"type":"strong","inlineContent":[{"type":"text","text":"a parsed score is less typed than a"},{"type":"text","text":" "},{"type":"text","text":"normalized one"}]},{"type":"text","text":". A consumer that switches over "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNTag"},{"type":"text","text":" should read a"},{"type":"text","text":" "},{"type":"text","text":"score whose "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNScore\/isNormalized"},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":"."}]},{"type":"heading","level":2,"anchor":"What-it-does-not-do","text":"What it does not do"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Normalization never fails. Three defects survive every repair above — a"},{"type":"text","text":" "},{"type":"text","text":"required parameter still missing, an unnamed parameter past the end of the"},{"type":"text","text":" "},{"type":"text","text":"tag’s template, and a value the tag’s own class cannot read — and each is"},{"type":"text","text":" "},{"type":"text","text":"carried through to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNValidator"},{"type":"text","text":", which reports it as an"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNValidator\/Issue"},{"type":"text","text":". Judging is the validator’s job; this stage only"},{"type":"text","text":" "},{"type":"text","text":"repairs, so a caller that wants a diagnosis calls"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNValidator\/validate(_:)"},{"type":"text","text":" on what it gets back."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A tag carrying one of those three stays on an untyped lane, which is what"},{"type":"text","text":" "},{"type":"text","text":"gives the validator something to read. Otherwise the only untyped tags left"},{"type":"text","text":" "},{"type":"text","text":"after normalization are the ones that belong there: "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNTag\/custom(_:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"whose name GMN does not reserve at all, and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNTag\/reserved(_:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which is down to the three reserved names no typed payload claims —"},{"type":"text","text":" "},{"type":"codeVoice","code":"\\port"},{"type":"text","text":", "},{"type":"codeVoice","code":"\\DrHoos"},{"type":"text","text":", and "},{"code":"\\DrRenz","type":"codeVoice"},{"text":".","type":"text"}]}],"kind":"content"}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivorgmn\/gmnnormalizer"]}],"metadata":{"symbolKind":"struct","modules":[{"name":"IvorGMN"}],"externalID":"s:7IvorGMN13GMNNormalizerV","navigatorTitle":[{"kind":"identifier","text":"GMNNormalizer"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"GMNNormalizer"}],"role":"symbol","roleHeading":"Structure","title":"GMNNormalizer"},"abstract":[{"type":"text","text":"A type that normalizes a Guido Music Notation score to canonical form."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"topicSections":[{"generated":true,"title":"Initializers","identifiers":["doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNNor