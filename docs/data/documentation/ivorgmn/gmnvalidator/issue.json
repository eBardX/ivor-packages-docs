{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivorgmn\/gmnvalidator\/issue"]}],"abstract":[{"text":"An issue found when validating a ","type":"text"},{"identifier":"doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNScore","isActive":true,"type":"reference"},{"text":".","type":"text"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"url":"doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNValidator\/Issue","interfaceLanguage":"swift"},"kind":"symbol","sections":[],"hierarchy":{"paths":[["doc:\/\/IvorGMN\/documentation\/IvorGMN","doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNValidator"]]},"metadata":{"roleHeading":"Enumeration","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Issue","kind":"identifier"}],"externalID":"s:7IvorGMN12GMNValidatorV5IssueO","role":"symbol","navigatorTitle":[{"text":"Issue","kind":"identifier"}],"modules":[{"name":"IvorGMN"}],"extendedModule":"IvorGMN","title":"GMNValidator.Issue","symbolKind":"enum"},"relationshipsSections":[{"type":"conformsTo","title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/IvorGMN\/s8CopyableP","doc:\/\/IvorGMN\/SQ","doc:\/\/IvorGMN\/s9EscapableP","doc:\/\/IvorGMN\/s8SendableP","doc:\/\/IvorGMN\/s16SendableMetatypeP"]}],"topicSections":[{"anchor":"Enumeration-Cases","title":"Enumeration Cases","generated":true,"identifiers":["doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNValidator\/Issue\/missingRequiredParameter(_:_:)","doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNValidator\/Issue\/missingTagBody(_:)","doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNValidator\/Issue\/unboundPositionalParameter(_:index:)","doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNValidator\/Issue\/unexpectedTagBody(_:)","doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNValidator\/Issue\/unreadableParameterValue(_:)"]},{"anchor":"Instance-Properties","title":"Instance Properties","generated":true,"identifiers":["doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNValidator\/Issue\/message"]},{"anchor":"Default-Implementations","title":"Default Implementations","generated":true,"identifiers":["doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNValidator\/Issue\/Equatable-Implementations"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Issue"}],"platforms":["macOS"]}]},{"mentions":["doc:\/\/IvorGMN\/documentation\/IvorGMN\/UsingIvorGMN"],"kind":"mentions"},{"content":[{"text":"What is judged here","level":2,"anchor":"What-is-judged-here","type":"heading"},{"inlineContent":[{"text":"Everything a repair cannot reach. ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNParser"},{"text":" rejects what could never","type":"text"},{"text":" ","type":"text"},{"text":"be repaired and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNNormalizer"},{"text":" repairs what it can, but neither","type":"text"},{"text":" ","type":"text"},{"text":"judges: normalization is total, so a defect it could not repair arrives","type":"text"},{"text":" ","type":"text"},{"text":"here intact.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Two of the five are about a tag’s ","type":"text"},{"inlineContent":[{"type":"text","text":"body"}],"type":"emphasis"},{"text":", and whether a tag scopes","type":"text"},{"text":" ","type":"text"},{"text":"something is a fact about the score around it, which no repair could","type":"text"},{"text":" ","type":"text"},{"text":"guess at. The other three are about its ","type":"text"},{"inlineContent":[{"type":"text","text":"parameters"}],"type":"emphasis"},{"text":", and each is a","type":"text"},{"text":" ","type":"text"},{"text":"value that was written and then thrown away unread.","type":"text"}],"type":"paragraph"},{"text":"Why the parameter issues are judged after normalization","level":2,"anchor":"Why-the-parameter-issues-are-judged-after-normalization","type":"heading"},{"inlineContent":[{"text":"A defect is only definite once every repair has been tried. ","type":"text"},{"type":"codeVoice","code":"\\volta"},{"text":" ","type":"text"},{"text":"requires ","type":"text"},{"type":"codeVoice","code":"mark"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"\\volta<m=\"1.\">"},{"text":" supplies it under a name since","type":"text"},{"text":" ","type":"text"},{"text":"renamed — so the tag is missing a required parameter as written and","type":"text"},{"text":" ","type":"text"},{"text":"complete after ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNNormalizer\/normalize(_:)"},{"text":" renames it.","type":"text"},{"text":" ","type":"text"},{"text":"The same holds for a ","type":"text"},{"type":"codeVoice","code":"$variable"},{"text":" that expands into a closed vocabulary,","type":"text"},{"text":" ","type":"text"},{"text":"and for a span end whose written parameters are dropped before they can","type":"text"},{"text":" ","type":"text"},{"text":"overrun its template. This is why ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNValidator\/validate(_:)"},{"text":" throws","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNValidator\/Error\/notNormalized"},{"text":" rather than judging an unnormalized score.","type":"text"}],"type":"paragraph"},{"text":"Every issue is fatal","level":2,"anchor":"Every-issue-is-fatal","type":"heading"},{"inlineContent":[{"text":"There is no grading, and no issue is advisory. Any of the five leaves","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNValidator\/validate(_:)"},{"text":" returning the score unvalidated, because","type":"text"},{"text":" ","type":"text"},{"text":"a set this small holds nothing worth tolerating: a ","type":"text"},{"type":"codeVoice","code":"\\slur"},{"text":" scoping","type":"text"},{"text":" ","type":"text"},{"text":"nothing, a ","type":"text"},{"type":"codeVoice","code":"\\title"},{"text":" scoping something, and a ","type":"text"},{"type":"codeVoice","code":"\\clef"},{"text":" with no type are","type":"text"},{"text":" ","type":"text"},{"text":"all defects the writer meant otherwise.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A Guido renderer warns on every one of the five and draws the score","type":"text"},{"text":" ","type":"text"},{"text":"anyway. That is a divergence, and a deliberate one — a renderer answers","type":"text"},{"text":" ","type":"text"},{"text":"“can something be drawn?”, and this is a library answering “is this","type":"text"},{"text":" ","type":"text"},{"text":"score well formed?”. In each case a value that was written is thrown","type":"text"},{"text":" ","type":"text"},{"text":"away without being read, and the rendered score says nothing about the","type":"text"},{"text":" ","type":"text"},{"text":"loss. What each field ","type":"text"},{"inlineContent":[{"type":"text","text":"means"}],"type":"emphasis"},{"text":" is Guido’s to say; what to do about a","type":"text"},{"text":" ","type":"text"},{"text":"violation is not.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://IvorGMN/s16SendableMetatypeP":{"identifier":"doc:\/\/IvorGMN\/s16SendableMetatypeP","title":"Swift.SendableMetatype","type":"unresolvable"},"doc://IvorGMN/documentation/IvorGMN/GMNTag/RangeSetting-swift.enum/no":{"type":"topic","abstract":[{"type":"text","text":"The tag must not have a body. This is the default for any tag"},{"type":"text","text":" "},{"type":"text","text":"that does not say otherwise."}],"role":"symbol","identifier":"doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNTag\/RangeSetting-swift.enum\/no","url":"\/documentation\/ivorgmn\/gmntag\/rangesetting-swift.enum\/no","kind":"symbol","title":"GMNTag.RangeSetting.no","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"no"}]},"doc://IvorGMN/documentation/IvorGMN/GMNTag/RangeSetting-swift.enum/only":{"type":"topic","abstract":[{"text":"The tag must have a body. ","type":"text"},{"type":"codeVoice","code":"\\accent"},{"text":" is one.","type":"text"}],"role":"symbol","identifier":"doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNTag\/RangeSetting-swift.enum\/only","url":"\/documentation\/ivorgmn\/gmntag\/rangesetting-swift.enum\/only","kind":"symbol","title":"GMNTag.RangeSetting.only","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"only","kind":"identifier"}]},"doc://IvorGMN/s8SendableP":{"identifier":"doc:\/\/IvorGMN\/s8SendableP","title":"Swift.Sendable","type":"unresolvable"},"doc://IvorGMN/documentation/IvorGMN/GMNValidator/validate(_:)":{"title":"validate(_:)","role":"symbol","identifier":"doc:\/\/IvorGMN\/documentation\/IvorGMN\/GMNValidator\/validate(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"validate"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"GMNScore","preciseIdentifier":"s:7IvorGMN8GMNScoreV"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Error","preciseIdentifier":"s:7IvorGMN12GMNValidatorV5ErrorO"},{"kind":"text","text":") -> ("},{"kind":"typeIdentifier","text":"GMNScore","preciseIdentifier":"s:7IvorGMN8GMNScoreV"},{"kind":"text","text":", ["},{"kind":"typeIdentifier","text":"Issue","preciseIdentifier":"s:7IvorGMN12GMNValidatorV5IssueO"},{"text":"])","kind":"text"}],"abstract":[{"text":"Validates the provided score and returns any issues found.","type":"text"}],"type":"topic","kind":"symbol","url":"\/documentation\/ivorgmn\/gmnvalidator\/validate(_:)"},"do