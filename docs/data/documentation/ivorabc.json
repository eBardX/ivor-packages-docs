{"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"abstract":[{"type":"text","text":"An ABC Notation parser, normalizer, validator, and formatter."}],"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The IvorABC framework provides an "},{"type":"reference","isActive":true,"identifier":"https:\/\/abcnotation.com"},{"type":"text","text":" "},{"type":"text","text":"parser, normalizer, validator, and formatter written in Swift. It targets "},{"type":"reference","isActive":true,"identifier":"https:\/\/abcnotation.com\/wiki\/abc:standard:v2.1"},{"type":"text","text":", with a"},{"type":"text","text":" "},{"type":"text","text":"strict-concurrency-ready, value-type API."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"IvorABC’s syntactic core turns ABC text into a typed, round-trippable abstract"},{"type":"text","text":" "},{"type":"text","text":"syntax tree ("},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCTunebook"},{"type":"text","text":" → "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCTune"},{"type":"text","text":" → "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCHeaderEntry"},{"type":"text","text":" \/"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCBodyEntry"},{"type":"text","text":" → "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCField"},{"type":"text","text":" \/ "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCSymbol"},{"type":"text","text":") and back to text, without"},{"type":"text","text":" "},{"type":"text","text":"interpreting the music."}],"type":"paragraph"},{"text":"The pipeline","anchor":"The-pipeline","type":"headin