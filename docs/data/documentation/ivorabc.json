{"abstract":[{"text":"An ABC Notation parser, normalizer, validator, and formatter.","type":"text"}],"kind":"symbol","primaryContentSections":[{"content":[{"level":2,"anchor":"Overview","text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"The IvorABC framework provides an "},{"type":"reference","identifier":"https:\/\/abcnotation.com","isActive":true},{"type":"text","text":" "},{"type":"text","text":"parser, normalizer, validator, and formatter written in Swift. It targets "},{"type":"reference","identifier":"https:\/\/abcnotation.com\/wiki\/abc:standard:v2.1","isActive":true},{"type":"text","text":", with a"},{"type":"text","text":" "},{"type":"text","text":"strict-concurrency-ready, value-type API."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"IvorABC’s syntactic core turns ABC text into a typed, round-trippable abstract"},{"type":"text","text":" "},{"type":"text","text":"syntax tree ("},{"type":"reference","identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCTunebook","isActive":true},{"type":"text","text":" → "},{"type":"reference","identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCTune","isActive":true},{"type":"text","text":" → "},{"type":"reference","identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCHeaderEntry","isActive":true},{"type":"text","text":" \/"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCBodyEntry","isActive":true},{"type":"text","text":" → "},{"type":"reference","identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCField","isActive":true},{"type":"text","text":" \/ "},{"type":"reference","identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCSymbol","isActive":true},{"type":"text","text":") and back to text, without"},{"type":"text","text":" "},{"type":"text","text":"interpreting the music."}],"type":"paragraph"},{"level":3,"anchor":"The-pipeline","text":"The pipeline","type":"heading"},{"inlineContent":[{"type":"text","text":"Everything flows through a small, explicit pipeline of four value types, each a"},{"type":"text","text":" "},{"code":"Sendable","type":"codeVoice"},{"type":"text","text":" value type with a no-argument initializer:"}],"type":"paragraph"},{"header":"row","alignments":["left","left","left"],"rows":[[[{"inlineContent":[{"type":"text","text":"Stage"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Type"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Input → Output"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Parse"}],"type":"paragraph"}],[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCParser"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Data","type":"codeVoice"},{"type":"text","text":" → "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCTunebook"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Normalize"}],"type":"paragraph"}],[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCNormalizer"}],"type":"paragraph"}],[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCTunebook"},{"type":"text","text":" → "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCTunebook"},{"type":"text","text":" (ABC 2.1)"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Validate"}],"type":"paragraph"}],[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCValidator"}],"type":"paragraph"}],[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCTunebook"},{"type":"text","text":" → validated "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCTunebook"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Format"}],"type":"paragraph"}],[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCFormatter"}],"type":"paragraph"}],[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCTunebook"},{"type":"text","text":" → "},{"code":"Data","type":"codeVoice"}],"type":"paragraph"}]]],"type":"table"},{"inlineContent":[{"type":"text","text":"An "},{"type":"reference","identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCTunebook","isActive":true},{"type":"text","text":" carries two Boolean state flags that enforce the order of the"},{"type":"text","text":" "},{"type":"text","text":"pipeline: a tunebook must be normalized before it can be validated, and"},{"type":"text","text":" "},{"type":"text","text":"validated before it can be formatted. Both normalization and validation are"},{"type":"text","text":" "},{"type":"text","text":"idempotent, so it is always safe to run the full pipeline:"}],"type":"paragraph"},{"syntax":"swift","code":["import Foundation","import IvorABC","","let data = try Data(contentsOf: url)","","let (parsed, diagnostics) = try ABCParser().parse(data)","let (normalized, changes) = ABCNormalizer().normalize(parsed)","let (validated, issues)   = try ABCValidator().validate(normalized)","","guard issues.isEmpty","else { issues.forEach { print($0.message) }; return }","","let output = try ABCFormatter().format(validated)  \/\/ back to ABC"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"See "},{"type":"reference","identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/UsingIvorABC","isActive":true},{"type":"text","text":" for a full guide to each stage, the models, and error"},{"type":"text","text":" "},{"type":"text","text":"handling."}],"type":"paragraph"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorABC\/documentation\/IvorABC"},"sec