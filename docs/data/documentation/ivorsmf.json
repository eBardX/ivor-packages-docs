rmalizer, validator, and","type":"text"},{"text":" ","type":"text"},{"text":"formatter written in Swift. It targets ","type":"text"},{"identifier":"https:\/\/midi.org\/standard-midi-files-specification","isActive":true,"type":"reference"},{"text":", as extended by ","type":"text"},{"identifier":"https:\/\/midi.org\/smf-lyric-meta-event-definition","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"https:\/\/midi.org\/smf-device-name-and-program-name-meta-events","isActive":true,"type":"reference"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"identifier":"https:\/\/midi.org\/smf-language-and-display-extensions","isActive":true,"type":"reference"},{"text":", with a","type":"text"},{"text":" ","type":"text"},{"text":"strict-concurrency-ready, value-type API.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"IvorSMF’s syntactic core turns Standard MIDI File bytes into a typed,","type":"text"},{"text":" ","type":"text"},{"text":"round-trippable abstract syntax tree (","type":"text"},{"identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFSequence","isActive":true,"type":"reference"},{"text":" → ","type":"text"},{"identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFTrack","isActive":true,"type":"reference"},{"text":" →","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFEvent","isActive":true,"type":"reference"},{"text":") and back to bytes, without interpreting the music.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"IvorSMF builds on two companion packages:","type":"text"},{"text":" ","type":"text"},{"identifier":"https:\/\/github.com\/eBardX\/IvorMIDI","isActive":true,"type":"reference"},{"text":" supplies the MIDI channel","type":"text"},{"text":" ","type":"text"},{"text":"messages carried by MIDI events, and","type":"text"},{"text":" ","type":"text"},{"identifier":"https:\/\/github.com\/eBardX\/IvorSMPTE","isActive":true,"type":"reference"},{"text":" supplies the SMPTE frame rates","type":"text"},{"text":" ","type":"text"},{"text":"and timecode values used by timecode-based time divisions and SMPTE offset","type":"text"},{"text":" ","type":"text"},{"text":"meta-events.","type":"text"}]},{"type":"heading","anchor":"The-pipeline","level":3,"text":"The pipeline"},{"type":"paragraph","inlineContent":[{"text":"Everything flows through a small, explicit pipeline of four value types, each a","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Sendable"},{"text":" value type with a no-argument initializer:","type":"text"}]},{"type":"table","rows":[[[{"inlineContent":[{"text":"Stage","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Type","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Input → Output","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Parse","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFParser"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Data","type":"codeVoice"},{"text":" → ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFSequence"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Normalize","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFNormalizer"}],"type":"paragraph"}],[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFSequence"},{"text":" → ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFSequence"},{"text":" (canonical)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Validate","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorSMF\/docume