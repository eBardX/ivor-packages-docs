{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorSMF\/documentation\/IvorSMF"},"primaryContentSections":[{"content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"inlineContent":[{"type":"text","text":"The IvorSMF framework provides a "},{"identifier":"https:\/\/midi.org\/standard-midi-files","isActive":true,"type":"reference"},{"type":"text","text":" parser, normalizer, validator, and"},{"type":"text","text":" "},{"type":"text","text":"formatter written in Swift. It targets "},{"type":"reference","identifier":"https:\/\/midi.org\/standard-midi-files-specification","isActive":true},{"type":"text","text":", as extended by "},{"type":"reference","identifier":"https:\/\/midi.org\/smf-lyric-meta-event-definition","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"https:\/\/midi.org\/smf-device-name-and-program-name-meta-events","isActive":true},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"reference","identifier":"https:\/\/midi.org\/smf-language-and-display-extensions","isActive":true},{"type":"text","text":", with a"},{"type":"text","text":" "},{"type":"text","text":"strict-concurrency-ready, value-type API."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"IvorSMF’s syntactic core turns Standard MIDI File bytes into a typed,"},{"type":"text","text":" "},{"type":"text","text":"round-trippable abstract syntax tree ("},{"type":"reference","identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFSequence","isActive":true},{"type":"text","text":" → "},{"type":"reference","identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFTrack","isActive":true},{"type":"text","text":" →"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFEvent","isActive":true},{"type":"text","text":") and back to bytes, without interpreting the music."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"IvorSMF builds on two companion packages:"},{"type":"text","text":" "},{"type":"reference","identifier":"https:\/\/github.com\/eBardX\/IvorMIDI","isActive":true},{"type":"text","text":" supplies the MIDI channel"},{"type":"text","text":" "},{"type":"text","text":"messages carried by MIDI events, and"},{"type":"text","text":" "},{"type":"reference","identifier":"https:\/\/github.com\/eBardX\/IvorSMPTE","isActive":true},{"type":"text","text":" supplies the SMPTE frame rates"},{"type":"text","text":" "},{"type":"text","text":"and timecode values used by timecode-based time divisions and SMPTE offset"},{"type":"text","text":" "},{"type":"text","text":"meta-events."}],"type":"paragraph"},{"level":3,"anchor":"The-pipeline","text":"The pipeline","type":"heading"},{"inlineContent":[{"type":"text","text":"Everything flows through a small, explicit pipeline of four value types, each a"},{"type":"text","text":" "},{"code":"Sendable","type":"codeVoice"},{"type":"text","text":" value type with a no-argument initializer:"}],"type":"paragraph"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Stage"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Type"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Input → Output"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Parse"}]}],[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFParser","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Data"},{"type":"text","text":" → "},{"type":"reference","identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFSequence","isActive":true}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Normalize"}]}],[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFNormalizer","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFSequence","isActive":true},{"type":"text","text":" → "},{"type":"reference","identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFSequence","isActive":true},{"type":"text","text":" (canonical)"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Validate"}]}],[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFValidator","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFSequence","isActive":true},{"type":"text","text":" → validated "},{"type":"reference","identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFSequence","isActive":true}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Format"}]}],[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFFormatter","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFSequence","isActive":true},{"type":"text","text":" → "},{"type":"codeVoice","code":"Data"}]}]]],"alignments":["left","left","left"],"type":"table"},{"inlineContent":[{"type":"text","text":"An "},{"type":"reference","identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFSequence","isActive":true},{"type":"text","text":" carries two Boolean state flags that enforce the order of the"},{"type":"text","text":" "},{"type":"text","text":"pipeline: a sequence must be normalized before it can be validated, and"},{"type":"text","text":" "},{"type":"text","text":"validated before it can be formatted. Both normalization and validation are"},{"type":"text","text":" "},{"type":"text","text":"idempotent, so it is always safe to run the full pipeline:"}],"type":"paragraph"},{"syntax":"swift","code":["import Foundation","import IvorSMF","","let data = try Data(contentsOf: url)","","let (parsed, diagnostics) = try