"The IvorSMF framework provides a ","type":"text"},{"identifier":"https:\/\/midi.org\/standard-midi-files","type":"reference","isActive":true},{"text":" parser, normalizer, validator, and","type":"text"},{"text":" ","type":"text"},{"text":"formatter written in Swift. It targets ","type":"text"},{"identifier":"https:\/\/midi.org\/standard-midi-files-specification","type":"reference","isActive":true},{"text":", as extended by ","type":"text"},{"identifier":"https:\/\/midi.org\/smf-lyric-meta-event-definition","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"https:\/\/midi.org\/smf-device-name-and-program-name-meta-events","type":"reference","isActive":true},{"text":", and","type":"text"},{"text":" ","type":"text"},{"identifier":"https:\/\/midi.org\/smf-language-and-display-extensions","type":"reference","isActive":true},{"text":", with a","type":"text"},{"text":" ","type":"text"},{"text":"strict-concurrency-ready, value-type API.","type":"text"}]},{"inlineContent":[{"text":"IvorSMF’s syntactic core turns Standard MIDI File bytes into a typed,","type":"text"},{"text":" ","type":"text"},{"text":"round-trippable abstract syntax tree (","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFSequence"},{"text":" → ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFTrack"},{"text":" →","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFEvent"},{"type":"text","text":") and back to bytes, without interpreting the music."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"IvorSMF builds on two companion packages:"},{"type":"text","text":" "},{"isActive":true,"identifier":"https:\/\/github.com\/eBardX\/IvorMIDI","type":"reference"},{"type":"text","text":" supplies the MIDI channel"},{"type":"text","text":" "},{"type":"text","text":"messages carried by MIDI events, and"},{"type":"text","text":" "},{"isActive":true,"identifier":"https:\/\/github.com\/eBardX\/IvorSMPTE","type":"reference"},{"type":"text","text":" supplies the SMPTE frame rates"},{"type":"text","text":" "},{"type":"text","text":"and timecode values used by timecode-based time divisions and SMPTE offset"},{"type":"text","text":" "},{"type":"text","text":"meta-events."}]},{"anchor":"The-pipeline","type":"heading","text":"The pipeline","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Everything flows through a small, explicit pipeline of four value types, each a"},{"type":"text","text":" "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":" value type with a no-argument initializer:"}]},{"rows":[[[{"inlineContent":[{"text":"Stage","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Type","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Input → Output","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Parse","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFParser","type":"reference","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"code":"Data","type":"codeVoice"},{"text":" → ","type":"text"},{"identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFSequence","type":"reference","isActive":true}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Normalize","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFNormalizer","type":"reference","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFSequence","type":"reference","isActive":true},{"text":" → ","type":"text"},{"identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFSequence","type":"reference","isActive":true},{"text":" (canonical)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Validate","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFValidator","type":"reference","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFSequence","type":"reference","isActive":true},{"text":" → validated ","type":"text"},{"identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFSequence","type":"reference","isActive":true}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Format","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFFormatter","type":"reference","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFSequence","type":"reference","isActive":true},{"text":" → ","type":"text"},{"code":"Data","type":"codeVoice"}],"type":"paragraph"}]]],"type":"table","alignments":["left","left","left"],"header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"isActive":true,"identifier":"doc:\/\/IvorSMF\/documentation\/IvorSMF\/SMFSequence","type":"reference"},{"type":"text","text":" carries two Boolean state flags that enforce the order of the"},{"type":"text","text":" "},{"type":"text","text":"pipeline: a sequence must be normalized before it can be validated, and"},{"type":"text","text":" "},{"type":"text","text":"validated before it can be formatted. Both normalization and validation are"},{"type":"text","text":" "},{"type":"text","text":"idempotent, so it is always safe to run the full pipeline:"}]},{"type":"codeListing","code":["import Foundation","import IvorSMF","","let data = try Data(contentsOf: url)","","let (parsed, diagnostics) = try SMFParser().parse(data)","let (normalized, changes) = SMFNormalizer().normalize(parsed)","let (validated, issues)   = try SMFValidator().validate(normalized)","","guard issues.isEmpty","else { issues.forEach { print($0.message) }; return