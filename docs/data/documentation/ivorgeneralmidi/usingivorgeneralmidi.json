{"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"IvorGeneralMIDI turns the sound sets of the General MIDI 1 and General MIDI 2"},{"type":"text","text":" "},{"type":"text","text":"specifications into Swift enumerations:"}]},{"alignments":["left","left"],"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Type"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Represents"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorGeneralMIDI\/documentation\/IvorGeneralMIDI\/GM1Instrument"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"One of the 128 General MIDI 1 instruments"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorGeneralMIDI\/documentation\/IvorGeneralMIDI\/GM1InstrumentFamily"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"One of the 16 families of 8 instruments"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorGeneralMIDI\/documentation\/IvorGeneralMIDI\/GM1PercussionSound"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"One of the 47 sounds of the percussion key map"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorGeneralMIDI\/documentation\/IvorGeneralMIDI\/GM2Instrument"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"One of the 256 General MIDI 2 instruments"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorGeneralMIDI\/documentation\/IvorGeneralMIDI\/GM2DrumSet"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"One of the 9 General MIDI 2 drum sets"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorGeneralMIDI\/documentation\/IvorGeneralMIDI\/GM2DrumSetSound"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The sound a note plays in a drum set"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorGeneralMIDI\/documentation\/IvorGeneralMIDI\/GM2PercussionSound"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"One of the 61 sounds of the extended key map"}]}]]],"type":"table","header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every sound can be looked up by the numbers that select it — a program, a bank"},{"type":"text","text":" "},{"type":"text","text":"LSB, or a note — or by its name, and gives those numbers back. Programs,"},{"type":"text","text":" "},{"type":"text","text":"notes, and channels are "},{"type":"reference","identifier":"https:\/\/github.com\/eBardX\/IvorMIDI","isActive":true},{"type":"text","text":" data"},{"type":"text","text":" "},{"type":"text","text":"values ("},{"type":"codeVoice","code":"MIDIProgram"},{"type":"text","text":", "},{"type":"codeVoice","code":"MIDIData1Value"},{"type":"text","text":", and "},{"type":"codeVoice","code":"MIDIChannel"},{"type":"text","text":"), so they can go"},{"type":"text","text":" "},{"type":"text","text":"straight into a "},{"type":"codeVoice","code":"MIDIChannelMessage"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Name lookup ignores case, leading and trailing whitespace, and the amount of"},{"type":"text","text":" "},{"type":"text","text":"whitespace between words. Names are spelled as the specification gives them,"},{"type":"text","text":" "},{"type":"text","text":"and the two specifications spell a few differently: General MIDI 2 has “String"},{"type":"text","text":" "},{"type":"text","text":"Ensembles 1” and “High Bongo” where General MIDI 1 has “String Ensemble 1” and"},{"type":"text","text":" "},{"type":"text","text":"“Hi Bongo”."}]},{"anchor":"General-MIDI-1-instruments","type":"heading","text":"General MIDI 1 instruments","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A program change selects one of the 128 "},{"type":"reference","identifier":"doc:\/\/IvorGeneralMIDI\/documentation\/IvorGeneralMIDI\/GM1Instrument","isActive":true},{"type":"text","text":" cases. Every program"},{"type":"text","text":" "},{"type":"text","text":"selects one, so "},{"type":"reference","identifier":"doc:\/\/IvorGeneralMIDI\/documentation\/IvorGeneralMIDI\/GM1Instrument\/init(program:)","isActive":true},{"type":"text","text":" never fails:"}]},{"type":"codeListing","syntax":"swift","code":["let piano = GM1Instrument(program: 1)   \/\/ .acousticGrandPiano","","piano.name      \/\/ \"Acoustic Grand Piano\"","piano.family    \/\/ .piano","piano.patch     \/\/ program 1, no bank"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The instruments fall into 16 "},{"type":"reference","identifier":"doc:\/\/IvorGeneralMIDI\/documentation\/IvorGeneralMIDI\/GM1InstrumentFamily","isActive":true},{"type":"text","text":" groups of 8 consecutive"},{"type":"text","text":" "},{"type":"text","text":"programs, from "},{"type":"reference","identifier":"doc:\/\/IvorGeneralMIDI\/documentation\/IvorGeneralMIDI\/GM1InstrumentFamily\/piano","isActive":true},{"type":"text","text":" (programs 1–8) to"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/IvorGeneralMIDI\/documentation\/IvorGeneralMIDI\/GM1InstrumentFamily\/soundEffects","isActive":true},{"type":"text","text":" (programs 121–128); a family lists its"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/IvorGeneralMIDI\/documentation\/IvorGeneralMIDI\/GM1InstrumentFamily\/instruments","isActive":true},{"type":"text","text":" in program order. Both enumerations list"},{"type":"text","text":" "},{"type":"text","text":"their "},{"type":"reference","identifier":"doc:\/\/IvorGeneralMIDI\/documentation\/IvorGeneralMIDI\/GM1Instrument\/allCases","isActive":true},{"type":"text","text":" in program order."}]},{"anchor":"General-MIDI-1-percussion","type":"heading","text":"General MIDI 1 percussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"On "},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorGeneralMIDI\/documentation\/IvorGeneralMIDI\/GM1PercussionSound\/channel"},{"type":"text","text":" (channel 10), each note from 35 to 81 plays"},{"type":"text","text":" "},{"type":"text","text":"one of the 47 "},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorGeneralMIDI\/documentation\/IvorGeneralMIDI\/GM1PercussionSound"},{"type":"text","text":" cases. "},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorGeneralMIDI\/documentation\/IvorGeneralMIDI\/GM1PercussionSound\/init(note:)"},{"type":"text","text":" "},{"type":"text","text":"returns "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" for a note outside that range:"}]},{"type":"codeListing","syntax":"swift","code":["let kick = GM1PercussionSound(note: 36)     \/\/ .bassDrum1","","kick?.name      \/\/ \"Bass Drum 1\""]},{"anchor":"General-MIDI-2-instruments","type":"heading","text":"General MIDI 2 instruments","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"General MIDI 2 keeps the 128 General MIDI 1 instruments and adds 128"},{"type":"text","text":" "},{"type":"text","text":"variations of them. A "},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorGeneralMIDI\/documentation\/IvorGeneralMIDI\/GM2Instrument"},{"type":"text","text":" is selected by a bank select MSB of"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorGeneralMIDI\/documentation\/IvorGeneralMIDI\/GM2Instrument\/bankMSB"},{"type":"text","text":" (121), a bank select LSB, and a program change: bank"},{"type":"text","text":" "},{"type":"text","text":"LSB 0 holds the General MIDI 1 instruments, and higher LSBs their variations."},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorGeneralMIDI\/documentation\/IvorGeneralMIDI\/GM2Instrument\/init(bankLSB:program:)"},{"type":"text","text":" returns "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" for a bank LSB that the"},{"type":"text","text":" "},{"type":"text","text":"program has no variation in."}]},{"type":"codeListing","syntax":"swift","code":["let ukulele = GM2Instrument(bankLSB: 1, program: 25)!","","ukulele.gm1Instrument       \/\/ .acousticGuitarNylon","ukulele.patch               \/\/ program 25 in bank 121:1","ukulele.selectionMessages(channel: 1)","\/\/ Bank select MSB 121, bank select LSB 1, then program change 25."]},{"type":"paragraph","inlineContent":[{"text":"A device that lacks a variation plays its ","type":"text"},{"identifier":"doc:\/\/IvorGeneralMIDI\/documentation\/IvorGeneralMIDI\/GM2Instrument\/gm1Instrument","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"instead. ","type":"text"},{"identifier":"doc:\/\/IvorGeneralMIDI\/documentation\/IvorGeneralMIDI\/GM2Instrument\/recommendedKeyRange","isActive":true,"type":"reference"},{"text":" gives the notes over which an","type":"text"},{"text":" ","type":"text"},{"text":"instrument keeps its proper character; it is ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" for the effect sounds of","type":"text"},{"text":" ","type":"text"},{"text":"programs 116–128, which have no defined pitch.","type":"text"}]},{"anchor":"Drum-sets","type":"heading","text":"Drum sets","level":2},{"type":"paragraph","inlineContent":[{"text":"A rhythm channel plays one of the 9 ","type":"text"},{"identifier":"doc:\/\/IvorGeneralMIDI\/documentation\/IvorGeneralMIDI\/GM2DrumSet","isActive":true,"type":"reference"},{"type":"text","text":" cases, selected by a bank"},{"type":"text","text":" "},{"type":"text","text":"select MSB of "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorGeneralMIDI\/documentation\/IvorGeneralMIDI\/GM2DrumSet\/bankMSB"},{"type":"text","text":" (120), a bank select LSB of"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorGeneralMIDI\/documentation\/IvorGeneralMIDI\/GM2DrumSet\/bankLSB"},{"type":"text","text":" (0), and a program change. Its"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/IvorGeneralMIDI\/documentation\/IvorGeneralMIDI\/GM2DrumSet\/selectionMessages(channel:)","type":"reference"},{"text":" default to channel 10.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"isActive":true,"identifier":"doc:\/\/IvorGeneralMIDI\/documentation\/IvorGeneralMIDI\/GM2DrumSet\/standard","type":"reference"},{"type":"text","text":" set plays the 61 "},{"isActive":true,"identifier":"doc:\/\/IvorGeneralMIDI\/documentation\/IvorGeneralMIDI\/GM2PercussionSound","type":"reference"},{"type":"text","text":" cases on"},{"type":"text","text":" "},{"type":"text","text":"notes 27–87: the 47 General MIDI 1 sounds on notes 35–81, plus 8 below and 6"},{"type":"text","text":" "},{"type":"text","text":"above. Every other set replaces some of them with sounds of its own, and the"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/IvorGeneralMIDI\/documentation\/IvorGeneralMIDI\/GM2DrumSet\/sfx","type":"reference"},{"type":"text","text":" set replaces nearly all. "},{"isActive":true,"identifier":"doc:\/\/IvorGeneralMIDI\/documentation\/IvorGeneralMIDI\/GM2DrumSet\/sound(for:)","type":"reference"},{"type":"text","text":" and"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/IvorGeneralMIDI\/documentation\/IvorGeneralMIDI\/GM2DrumSet\/sounds","type":"reference"},{"type":"text","text":" give the "},{"isActive":true,"identifier":"doc:\/\/IvorGeneralMIDI\/documentation\/IvorGeneralMIDI\/GM2DrumSetSound","type":"reference"},{"type":"text","text":" each note plays in a set:"}]},{"type":"codeListing","syntax":"swift","code":["let jazz = GM2DrumSet.jazz","","jazz.program                        \/\/ 33","jazz.sound(for: 36)?.name           \/\/ the set’s own kick","jazz.sound(for: 36)?.standardSound  \/\/ nil: the set replaces this note"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"isActive":true,"identifier":"doc:\/\/IvorGeneralMIDI\/documentation\/IvorGeneralMIDI\/GM2DrumSetSound","type":"reference"},{"type":"text","text":" carries the note’s preset "},{"isActive":true,"identifier":"doc:\/\/IvorGeneralMIDI\/documentation\/IvorGeneralMIDI\/GM2DrumSetSound\/pan","type":"reference"},{"type":"text","text":", its"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/IvorGeneralMIDI\/documentation\/IvorGeneralMIDI\/GM2DrumSetSound\/exclusiveGroup","type":"reference"},{"type":"text","text":" (sounds in the same group, such as the"},{"type":"text","text":" "},{"type":"text","text":"closed, pedal, and open hi-hats, cut each other off), and whether it"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/IvorGeneralMIDI\/documentation\/IvorGeneralMIDI\/GM2DrumSetSound\/respondsToNoteOff","type":"reference"},{"type":"text","text":"; "},{"isActive":true,"identifier":"doc:\/\/IvorGeneralMIDI\/documentation\/IvorGeneralMIDI\/GM2DrumSetSound\/standardSound","type":"reference"},{"type":"text","text":" is the"},{"type":"text","text":" "},{"type":"text","text":"Standard Set sound it is, or "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" if the set replaces it."}]},{"anchor":"Turning-General-MIDI-on-and-off","type":"heading","text":"Turning General MIDI on and off","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The universal system exclusive messages that switch a device into or out of"},{"type":"text","text":" "},{"type":"text","text":"General MIDI are "},{"code":"MIDISystemMessage.gm1SystemOn","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"MIDISystemMessage.gm2SystemOn","type":"codeVoice"},{"type":"text","text":", and"},{"type":"text","text":" "},{"code":"MIDISystemMessage.gmSystemOff","type":"codeVoice"},{"type":"text","text":". Send one before anything else, so"},{"type":"text","text":" "},{"type":"text","text":"that the device starts from the specification’s default state."}]},{"anchor":"General-MIDI-2-effects-and-controllers","type":"heading","text":"General MIDI 2 effects and controllers","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"General MIDI 2 devices have a reverb and a chorus, set with global parameter"},{"type":"text","text":" "},{"type":"text","text":"control messages. Pass the parameters in the order to set them, with the type"},{"type":"text","text":" "},{"type":"text","text":"first, since selecting a type resets the other parameters to that type’s"},{"type":"text","text":" "},{"type":"text","text":"defaults:"}]},{"type":"codeListing","syntax":"swift","code":["let reverb = MIDISystemMessage.gm2Reverb(.type(.largeHall), .time(64))","let chorus = MIDISystemMessage.gm2Chorus(.type(.chorus3), .feedback(16))"]},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/IvorGeneralMIDI\/documentation\/IvorGeneralMIDI\/GM2ReverbType","type":"reference"},{"type":"text","text":" and "},{"isActive":true,"identifier":"doc:\/\/IvorGeneralMIDI\/documentation\/IvorGeneralMIDI\/GM2ChorusType","type":"reference"},{"type":"text","text":" name the effect types and give their"},{"type":"text","text":" "},{"type":"text","text":"defaults, such as "},{"isActive":true,"identifier":"doc:\/\/IvorGeneralMIDI\/documentation\/IvorGeneralMIDI\/GM2ReverbType\/defaultTime","type":"reference"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A controller destination setting assigns channel pressure, or one control"},{"type":"text","text":" "},{"type":"text","text":"change, to sound parameters such as pitch, filter cutoff, or vibrato depth"},{"type":"text","text":" "},{"type":"text","text":"("},{"isActive":true,"identifier":"doc:\/\/IvorGeneralMIDI\/documentation\/IvorGeneralMIDI\/GM2ControllerDestination","type":"reference"},{"type":"text","text":"). A key-based instrument control message adjusts"},{"type":"text","text":" "},{"type":"text","text":"the pan, volume, or effect sends of one note of a drum set"},{"type":"text","text":" "},{"type":"text","text":"("},{"isActive":true,"identifier":"doc:\/\/IvorGeneralMIDI\/documentation\/IvorGeneralMIDI\/GM2KeyBasedController","type":"reference"},{"type":"text","text":"):"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Let the modulation wheel add vibrato on channel 1.","let vibrato = MIDISystemMessage.controlChangeDestinationSetting(controller: .modulationWheelMSB,","                                                                channel: 1,","                                                                .lfoPitchDepth(32))","","\/\/ Pan the kick of the drum set on channel 10 hard left, and keep it dry.","let kick = MIDISystemMessage.keyBasedInstrumentControl(channel: 10,","                                                       note: 36,","                                                       .pan(0),","                                                       .reverbSendLevel(0))"]},{"type":"paragraph","inlineContent":[{"code":"MIDISystemMessage.controlChangeDestinationSetting(controller:channel:_:)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"returns "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" for a controller outside the assignable ranges, 1–31 and 64–95."}]},{"anchor":"Error-handling","type":"heading","text":"Error handling","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"IvorGeneralMIDI throws no errors. Every lookup that can fail returns "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"instead: the name initializers, "},{"isActive":true,"identifier":"doc:\/\/IvorGeneralMIDI\/documentation\/IvorGeneralMIDI\/GM1PercussionSound\/init(note:)","type":"reference"},{"type":"text","text":","},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/IvorGeneralMIDI\/documentation\/IvorGeneralMIDI\/GM2Instrument\/init(bankLSB:program:)","type":"reference"},{"type":"text","text":", "},{"isActive":true,"identifier":"doc:\/\/IvorGeneralMIDI\/documentation\/IvorGeneralMIDI\/GM2DrumSet\/init(program:)","type":"reference"},{"type":"text","text":","},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/IvorGeneralMIDI\/documentation\/IvorGeneralMIDI\/GM2PercussionSound\/init(note:)","type":"reference"},{"type":"text","text":", "},{"isActive":true,"identifier":"doc:\/\/IvorGeneralMIDI\/documentation\/IvorGeneralMIDI\/GM2DrumSet\/sound(for:)","type":"reference"},{"type":"text","text":", and"},{"type":"text","text":" "},{"code":"MIDISystemMessage.controlChangeDestinationSetting(controller:channel:_:)","type":"codeVoice"},{"type":"text","text":"."}]},{"anchor":"Concurrency","type":"heading","text":"Concurrency","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"IvorGeneralMIDI is built for Swift 6 strict concurrency. Every public type is a"},{"type":"text","text":" "},{"code":"Sendable","type":"codeVoice"},{"type":"text","text":" value type, so instances can be freely shared across tasks and actor"},{"type":"text","text":" "},{"type":"text","text":"boundaries."}]}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorGeneralMIDI\/documentation\/IvorGeneralMIDI\/UsingIvorGeneralMIDI"},"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"Look up General MIDI 1 and 2 sounds, and build the messages that select and","type":"text"},{"type":"text","text":" "},{"type":"text","text":"control them."}],"metadata":{"role":"article","modules":[{"name":"IvorGeneralMIDI"}],"title":"Using IvorGeneralMIDI","roleHeading":"Article"},"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivorgeneralmidi\/usingivorgeneralmidi"]}],"hierarchy":{"paths":[["doc:\/\/IvorGeneralMIDI\/documentation\/IvorGeneralMIDI"]]},"sections":[],"references":{"doc://IvorGeneralMIDI/documentation/IvorGeneralMIDI/GM2DrumSet/bankMSB":{"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"bankMSB","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:8IvorMIDI14MIDIData1ValueV","text":"MIDIData1Value","kind":"typeIdentifier"}],"abstract":[{"type":"text","text":"The bank select MSB that selects the General MIDI 2 drum sets (120)."}],"title":"bankMSB","role":"symbol","url":"\/documentation\/ivorgeneralmidi\/gm2drumset\/bankmsb","identifier":"doc:\/\/IvorGeneralMIDI\/documentation\/IvorGeneralMIDI\/GM2DrumSet\/bankMSB","kind":"symbol","type":"topic"},"doc://IvorGeneralMIDI/documentation/IvorGeneralMIDI/GM2ReverbType":{"url":"\/documentation\/ivorgeneralmidi\/gm2reverbtype","abstract":[{"type":"text","text":"A General MIDI 2 (GM2) reverb type: one of the 6 reverb designs that the"},{"type":"text","text":" "},{"type":"text","text":"reverb type parameter selects."}],"type":"topic","identifier":"doc:\/\/IvorGeneralMIDI\/documentation\/IvorGeneralMIDI\/GM2ReverbType","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GM2ReverbType","kind":"identifier"}],"kind":"symbol","role":"symbol","navigatorTitle":[{"text":"GM2ReverbType","kind":"identifier"}],"title":"GM2ReverbType"},"doc://IvorGeneralMIDI/documentation/IvorGeneralMIDI/GM2Instrument/bankMSB":{"url":"\/documentation\/ivorgeneralmidi\/gm2instrument\/bankmsb","type":"topic","abstract":[{"type":"text","text":"The bank select MSB that selects the General MIDI 2 melodic bank"},{"type":"text","text":" "},{"type":"text","text":"(121)."}],"identifier":"doc:\/\/IvorGeneralMIDI\/documentation\/IvorGeneralMIDI\/GM2Instrument\/bankMSB","fragments":[{"text":"static","kind":"keyword"},{"text":" ",