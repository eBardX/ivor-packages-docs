ns","mentions":["doc:\/\/IvorModel\/documentation\/IvorModel\/UsingIvorModel"]},{"content":[{"level":2,"type":"heading","anchor":"overview","text":"Overview"},{"inlineContent":[{"type":"text","text":"The time and pitch types must match the template’s content; see"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/Template\/AnyGenerationOptions","isActive":true},{"type":"text","text":" for a recipe whose types are chosen at run time. The"},{"type":"text","text":" "},{"type":"text","text":"defaults reproduce the plain generation of earlier versions: order 1, at most 100 note"},{"type":"text","text":" "},{"type":"text","text":"events, starting at the source’s opening and stopping where it ends."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The options are applied in this order: "},{"type":"reference","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/Template\/GenerationOptions\/mixing-swift.property","isActive":true},{"type":"text","text":" (or "},{"type":"reference","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/Template\/GenerationOptions\/order","isActive":true},{"type":"text","text":" alone), then"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/Template\/GenerationOptions\/constraints-swift.property","isActive":true},{"type":"text","text":", then "},{"type":"reference","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/Template\/GenerationOptions\/contrast","isActive":true},{"type":"text","text":", then "},{"type":"reference","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/Template\/GenerationOptions\/backsOff","isActive":true},{"type":"text","text":", then "},{"type":"reference","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/Template\/GenerationOptions\/loops","isActive":true},{"type":"text","text":". A template that"},{"type":"text","text":" "},{"type":"text","text":"separates pitch and duration generates from its two chains in step: the duration chain"},{"type":"text","text":" "},{"type":"text","text":"chooses each event’s duration and whether it is a rest, and the pitch chain chooses the"},{"type":"text","text":" "},{"type":"text","text":"pitches of each sounding event. Each chain gets its own stack of generators, so back-off"},{"type":"text","text":" "},{"type":"text","text":"and looping apply to each chain on its own, and either chain stopping stops generation. Generation stops"},{"type":"text","text":" "},{"type":"text","text":"when "},{"type":"reference","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/Template\/GenerationOptions\/length-swift.property","isActive":true},{"type":"text","text":" is reached, or at the "},{"type":"reference","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/Template\/GenerationOptions\/cadence-swift.property","isActive":true},{"type":"text","text":" once its minimum length is reached,"},{"type":"text","text":" "},{"type":"text","text":"whichever comes first; it may also stop earlier, at the end of a source sequence or at a"},{"type":"text","text":" "},{"type":"text","text":"dead end, unless "},{"type":"reference","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/Template\/GenerationOptions\/stopsAtEnd","isActive":true},{"type":"text","text":" is "},{"type":"codeVoice","code":"false"},{"type":"text","text":" or "},{"type":"reference","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/Template\/GenerationOptions\/backsOff","isActive":true},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"topicSections":[{"anchor":"Structures","title":"Structures","identifiers":["doc:\/\/IvorModel\/documentation\/IvorModel\/Template\/GenerationOptions\/Cadence-swift.struct","doc:\/\/IvorModel\/documentation\/IvorModel\/Template\/GenerationOption