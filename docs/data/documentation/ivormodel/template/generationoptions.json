:"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/Template\/AnyGenerationOptions","isActive":true,"type":"reference"},{"text":" for a recipe whose types are chosen at run time. The","type":"text"},{"text":" ","type":"text"},{"text":"defaults reproduce the plain generation of earlier versions: order 1, at most 100 note","type":"text"},{"text":" ","type":"text"},{"text":"events, starting at the source’s opening and stopping where it ends.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The options are applied in this order: ","type":"text"},{"identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/Template\/GenerationOptions\/mixing-swift.property","isActive":true,"type":"reference"},{"text":" (or ","type":"text"},{"identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/Template\/GenerationOptions\/order","isActive":true,"type":"reference"},{"text":" alone), then","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/Template\/GenerationOptions\/constraints-swift.property","isActive":true,"type":"reference"},{"text":", then ","type":"text"},{"identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/Template\/GenerationOptions\/contrast","isActive":true,"type":"reference"},{"text":", then ","type":"text"},{"identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/Template\/GenerationOptions\/backsOff","isActive":true,"type":"reference"},{"text":", then ","type":"text"},{"identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/Template\/GenerationOptions\/loops","isActive":true,"type":"reference"},{"text":". A template that","type":"text"},{"text":" ","type":"text"},{"text":"separates pitch and duration generates from its two chains in step: the duration chain","type":"text"},{"text":" ","type":"text"},{"text":"chooses each event’s duration and whether it is a rest, and the pitch chain chooses the","type":"text"},{"text":" ","type":"text"},{"text":"pitches of each sounding event. Each chain gets its own stack of generators, so back-off","type":"text"},{"text":" ","type":"text"},{"text":"and looping apply to each chain on its own, and either chain stopping stops generation. Generation stops","type":"text"},{"text":" ","type":"text"},{"text":"when ","type":"text"},{"identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/Template\/GenerationOptions\/length-swift.property","isActive":true,"type":"reference"},{"text":" is reached, or at the ","type":"text"},{"identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/Template\/GenerationOptions\/cadence-swift.property","isActive":true,"type":"reference"},{"text":" once its minimum length is reached,","type":"text"},{"text":" ","type":"text"},{"text":"whichever comes first; it may also stop earlier, at the end of a source sequence or at a","type":"text"},{"text":" ","type":"text"},{"text":"dead end, unless ","type":"text"},{"identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/Template\/GenerationOptions\/stopsAtEnd","isActive":true,"type":"reference"},{"text":" is ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" or ","type":"text"},{"identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/Template\/GenerationOptions\/backsOff","isActive":true,"type":"reference"},{"text":" is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}],"references":{"doc://IvorModel/documentation/IvorModel/Template/GenerationOptions/constraints-swift.property":{"type":"topic","abstract":[{"type":"text","text":"Which note events may be generated."}],"identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/Template\/GenerationOptions\/constraints-swift.property","kind":"symbol","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"constraints","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Constraints","kind":"typeIdentifier","preciseIdentifier":"s:9IvorModel8TemplateV1