{"identifier":{"url":"doc:\/\/IvorModel\/documentation\/IvorModel\/Template\/AnalysisOptions-swift.struct\/Variants-swift.struct","interfaceLanguage":"swift"},"metadata":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Variants","kind":"identifier"}],"modules":[{"name":"IvorModel"}],"roleHeading":"Structure","title":"Template.AnalysisOptions.Variants","symbolKind":"struct","navigatorTitle":[{"text":"Variants","kind":"identifier"}],"extendedModule":"IvorModel","role":"symbol","externalID":"s:9IvorModel8TemplateV15AnalysisOptionsV8VariantsV"},"kind":"symbol","abstract":[{"type":"text","text":"Transformed copies of the part to analyze along with it, so that one template learns a"},{"type":"text","text":" "},{"type":"text","text":"family of related forms."}],"relationshipsSections":[{"kind":"relationships","type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/IvorModel\/s8CopyableP","doc:\/\/IvorModel\/Se","doc:\/\/IvorModel\/SE","doc:\/\/IvorModel\/SQ","doc:\/\/IvorModel\/s9EscapableP","doc:\/\/IvorModel\/SH","doc:\/\/IvorModel\/s8SendableP","doc:\/\/IvorModel\/s16SendableMetatypeP"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/IvorModel\/documentation\/IvorModel","doc:\/\/IvorModel\/documentation\/IvorModel\/Template","doc:\/\/IvorModel\/documentation\/IvorModel\/Template\/AnalysisOptions-swift.struct"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Variants"}]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The variants are every combination of the choices: each transposition (and none), inverted"},{"type":"text","text":" "},{"type":"text","text":"or not, in retrograde or not, and at each time factor (and ×1). The original is always one"},{"type":"text","text":" "},{"type":"text","text":"of them. For example, 11 transpositions with inversion and retrograde give the 48 forms of"},{"type":"text","text":" "},{"type":"text","text":"a tone row."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each variant is made from the part’s note table, after the timing tolerance: inverted"},{"type":"text","text":" "},{"type":"text","text":"around the part’s own pitch range, then transposed, then reversed within the part’s own time"},{"type":"text","text":" "},{"type":"text","text":"range, then scaled in time from the part’s start. It is then sliced into note events like the"},{"type":"text","text":" "},{"type":"text","text":"original, and becomes a sequence of its own. A variant whose states are the same as an"},{"type":"text","text":" "},{"type":"text","text":"earlier one’s isn’t trained again, and one that can’t be made — a transposition out of"},{"type":"text","text":" "},{"type":"text","text":"range, say — is left out; "},{"identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/Template\/analysisSummary-swift.property","isActive":true,"type":"reference"},{"type":"text","text":" records both."}]}]}],"topicSections":[{"anchor":"Initializers","title":"Initializers","generated":true,"identifiers":["doc:\/\/IvorModel\/documentation\/IvorModel\/Template\/AnalysisOptions-swift.struct\/Variants-swift.struct\/init(transpositions:inverts:retrogrades:timeFactors:)"]},{"anchor":"Instance-Properties","title":"Instance Properties","generated":true,"identifiers":["doc:\/\/IvorModel\/documentation\/IvorModel\/Template\/AnalysisOptions-swift.struct\/Variants-swift.struct\/inverts","doc:\/\/IvorModel\/documentation\/IvorModel\/Template\/AnalysisOptions-swift.struct\/Variants-swift.struct\/retrogrades","doc:\/\/IvorModel\/documentation\/IvorModel\/Template\/AnalysisOptions-swift.struct\/Variants-swift.struct\/sequenceCount","doc:\/\/IvorModel\/documentation\/IvorModel\/Template\/Analysi