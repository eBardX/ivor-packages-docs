xt":"a tone row.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Each variant is made from the part’s note table, after the timing tolerance: inverted","type":"text"},{"text":" ","type":"text"},{"text":"around the part’s own pitch range, then transposed, then reversed within the part’s own time","type":"text"},{"text":" ","type":"text"},{"text":"range, then scaled in time from the part’s start. It is then sliced into note events like the","type":"text"},{"text":" ","type":"text"},{"text":"original, and becomes a sequence of its own. A variant whose states are the same as an","type":"text"},{"text":" ","type":"text"},{"text":"earlier one’s isn’t trained again, and one that can’t be made — a transposition out of","type":"text"},{"text":" ","type":"text"},{"text":"range, say — is left out; ","type":"text"},{"identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/Template\/analysisSummary-swift.property","isActive":true,"type":"reference"},{"text":" records both.","type":"text"}],"type":"paragraph"}]}],"references":{"doc://IvorModel/documentation/IvorModel/Work":{"abstract":[{"text":"A musical work containing parts and associated data.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/Work","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Work","kind":"identifier"}],"title":"Work","url":"\/documentation\/ivormodel\/work","navigatorTitle":[{"text":"Work","kind":"identifier"}]},"doc://IvorModel/documentation/IvorModel/Template/AnalysisOptions-swift.struct/Variants-swift.struct/none":{"type":"topic","abstract":[{"text":"No variants: the part alone, as earlier versions analyzed it.","type":"text"}],"identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/Template\/AnalysisOptions-swift.struct\/Variants-swift.struct\/none","kind":"symbol","role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind"