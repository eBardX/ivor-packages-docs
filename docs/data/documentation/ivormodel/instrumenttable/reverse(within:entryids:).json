time range, or — when "},{"type":"codeVoice","code":"entryIDs"},{"type":"text","text":" is non-"},{"type":"codeVoice","code":"nil"},{"type":"text","text":" — the"},{"type":"text","text":" "},{"type":"text","text":"selected entries’ own time range."}],"type":"paragraph"}]},{"name":"entryIDs","content":[{"inlineContent":[{"type":"text","text":"The identities of the entries to reverse, or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" to reverse every"},{"type":"text","text":" "},{"type":"text","text":"entry in the table."}],"type":"paragraph"}]}],"kind":"parameters"},{"content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"Each entry is a step: its instrument holds until the next entry. So reversing mirrors the","type":"text"},{"text":" ","type":"text"},{"text":"stretch each selected entry governs — up to the next selected entry, or to the range’s","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"upper bound — and moves the entry to that stretch’s new start. Flute at 0 and piccolo at"},{"text":" ","type":"text"},{"type":"text","text":"4, reversed within 0…8, gives piccolo at 0 and flute at 4. The stretch before the first"},{"text":" ","type":"text"},{"type":"text","text":"selected entry, which holds the instrument in effect before it ("},{"type":"reference","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/InstrumentTable\/defaultInstrument","isActive":true},{"type":"text","text":" "},{"type":"text","text":"unless an unselected entry precedes it), moves to the end of the range, and a new entry"},{"type":"text","text":" "},{"type":"text","text":"begins it there. Entries that share a time swap order, so a step keeps its order. The"},{"type":"text","text":" "},{"type":"text","text":"instrument after the range isn’t restored, just as the interpolating maps don’t restore"},{"type":"text","text":" "},{"type":"text","text":"their values after it."}]},{"name":"Throws","type":"aside","style":"note","content":[{"inlineContent":[{"text":"","type":"text"},{"isActive":true,"identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/InstrumentTable\/Error\/invalidAnchor","type":"reference"},{"text":" if ","type":"text"},{"code":"timeRange","type":"codeVoice"},{"text":" does not contain the time","type":"text"},{"text":" ","type":"text"},{"text":"range of the entries being reversed; otherwise,","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/InstrumentTable\/Error\/reverseFailure(_:)","type":"reference"},{"text":" if an entry cannot be reversed.","type":"text"}],"type":"paragraph"}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/IvorModel\/documentation\/IvorModel","doc:\/\/IvorModel\/documentation\/IvorModel\/InstrumentTable"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"title":"reverse(within:entryIDs:)","role":"symbol","conformance":{"constraints":[{"type":"codeVoice","code":"TimeType"},{"text":" conforms to ","type":"text"},{"code":"TimeProtocol","type":"codeVoice"},{"text":".","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}]},"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reverse","kind":"identifier"},{"text":"(","kind":"text"},{"text":"within","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ClosedRange","kind":"typeIdentifier","preciseIdentifier":"s:SN"},{"text":"<","kind":"text"},{"text":"TimeType","kind":"typeIdentifier","preciseIdentifier":"s:9IvorModel15InstrumentTableV8TimeTypexmfp"},{"text":">?, ","kind":"text"},{"text":"entryIDs","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Set","kind":"typeIdentifier","preciseIdentifier":"s:Sh"},{"text":"<","kind":"text"},{"text":"EntryID","kind":"typeIdentifier","preciseIdentifier":"s:9IvorModel7EntryIDV"},{"text":">?) ","kind":"text"},{"text"