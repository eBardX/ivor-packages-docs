caller invoking this method already","type":"text"},{"text":" ","type":"text"},{"text":"holds ","type":"text"},{"type":"codeVoice","code":"entryID"},{"text":" and goes on using it afterward, so honoring “this","type":"text"},{"text":" ","type":"text"},{"text":"identity keeps addressing this same entry” means the entry it","type":"text"},{"text":" ","type":"text"},{"text":"wasn’t referencing has to be the one that gives way, never the one","type":"text"},{"text":" ","type":"text"},{"text":"it was.","type":"text"}]}],"kind":"content"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://IvorModel/documentation/IvorModel/InstrumentTable/update(entryID:instrument:extras:)":{"abstract":[{"text":"Replaces the instrument entry with the given identity, in place.","type":"text"}],"identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/InstrumentTable\/update(entryID:instrument:extras:)","kind":"symbol","conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"code":"TimeType","type":"codeVoice"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"TimeProtocol"},{"type":"text","text":"."}]},"type":"topic","role":"symbol","title":"update(entryID:instrument:extras:)","url":"\/documentation\/ivormodel\/instrumenttable\/update(entryid:instrument:extras:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"update","kind":"identifier"},{"text":"(","kind":"text"},{"text":"entryID","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"EntryID","preciseIdentifier":"s:9IvorModel7EntryIDV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"instrument","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Instrument","preciseIdentifier":"s:9IvorModel10InstrumentV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"extras","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Extras","