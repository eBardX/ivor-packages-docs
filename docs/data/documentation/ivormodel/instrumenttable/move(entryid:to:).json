{"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"type":"text","text":"Moves the instrument entry with the given identity to a new time,"},{"type":"text","text":" "},{"type":"text","text":"keeping its instrument and extras, and re-sorts it into place."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorModel\/documentation\/IvorModel\/InstrumentTable\/move(entryID:to:)"},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"attribute","text":"@discardableResult"},{"kind":"text","text":" "},{"kind":"keyword","text":"mutating"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"move"},{"kind":"text","text":"("},{"kind":"externalParam","text":"entryID"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/EntryID","preciseIdentifier":"s:9IvorModel7EntryIDV","text":"EntryID"},{"kind":"text","text":", "},{"kind":"externalParam","text":"to"},{"kind":"text","text":" "},{"kind":"internalParam","text":"time"},{"kind":"text","text":": "},{"preciseIdentifier":"s:9IvorModel15InstrumentTableV8TimeTypexmfp","kind":"typeIdentifier","text":"TimeType"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:9IvorModel7EntryIDV","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/EntryID","kind":"typeIdentifier","text":"EntryID"},{"kind":"text","text":"?"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The identity of the entry to move."}],"type":"paragraph"}],"name":"entryID"},{"content":[{"inlineContent":[{"text":"The new time for the entry.","type":"text"}],"type":"paragraph"}],"name":"time"}],"kind":"parameters"},{"kind":"content","content":[{"level":2,"anchor":"return-value","type":"heading","text":"Return Value"},{"inlineContent":[{"text":"The identity that now addresses this entry’s content — ","type":"text"},{"code":"entryID","type":"codeVoice"},{"text":" ","type":"text"},{"text":"itself, unless the move merged it into a pre-existing exact","type":"text"},{"text":" ","type":"text"},{"text":"duplicate, in which case the survivor’s identity. ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" if","type":"text"},{"text":" ","type":"text"},{"code":"entryID","type":"codeVoice"},{"text":" did not identify any entry and nothing moved.","type":"text"}],"type":"paragraph"}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"inlineContent":[{"text":"Unlike ","type":"text"},{"isActive":true,"identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/InstrumentTable\/update(entryID:instrument:extras:)","type":"reference"},{"type":"text","text":", this is expected to"},{"type":"text","text":" "},{"text":"reorder entries — that is the point of editing the time itself. Two","type":"text"},{"type":"text","text":" "},{"type":"text","text":"entries legitimately ending up at the same time (see"},{"type":"text","text":" "},{"identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/InstrumentTable\/insert(time:instrument:extras:)","isActive":true,"type":"reference"},{"type":"text","text":" for the discontinuity use case)"},{"text":" ","type":"text"},{"type":"text","text":"is not treated as a collision to reject; the moved entry simply"},{"type":"text","text":" "},{"type":"text","text":"takes its place among any others already there, exactly as a fresh"},{"type":"text","text":" "},{"type":"text","text":"insertion would."}],"type":"paragraph"},{"inlineContent":[{"text":"The one case where ","type":"text"},{"code":"entryID","type":"codeVoice"},{"text":" stops identifying the moved entry afterward is","type":"text"},{"text":" ","type":"text"},{"text":"when the move lands it exactly on top of another entry already","type":"text"},{"text":" ","type":"text"},{"text":"present — same time, instrument, and extras — the same","type":"text"},{"text":" ","type":"text"},{"text":"exact-duplicate case ","type":"text"},{"isActive":true,"identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/InstrumentTable\/insert(time:instrument:extras:)","type":"reference"},{"text":" silently","type":"text"},{"text":" ","type":"text"},{"text":"collapses. There, the moved entry merges into that pre-existing one","type":"text"},{"text":" ","type":"text"},{"text":"instead of being kept separately, so ","type":"text"},{"code":"entryID","type":"codeVoice"},{"text":" no longer names anything in","type":"text"},{"text":" ","type":"text"},{"text":"the table; the returned identity is the survivor’s instead, which a","type":"text"},{"text":" ","type":"text"},{"text":"caller must switch to addressing from then on.","type":"text"}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/ivormodel\/instrumenttable\/move(entryid:to:)"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/IvorModel\/documentation\/IvorModel","doc:\/\/IvorModel\/documentation\/IvorModel\/InstrumentTable"]]},"metadata":{"modules":[{"name":"IvorModel"}],"symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"move"},{"kind":"text","text":"("},{"kind":"externalParam","text":"entryID"},{"kind":"text","text":": "},{"preciseIdentifier":"s:9IvorModel7EntryIDV","kind":"typeIdentifier","text":"EntryID"},{"kind":"text","text":", "},{"kind":"externalParam","text":"to"},{"kind":"text","text":": "},{"preciseIdentifier":"s:9IvorModel15InstrumentTableV8TimeTypexmfp","kind":"typeIdentifier","text":"TimeType"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:9IvorModel7EntryIDV","kind":"typeIdentifier","text":"EntryID"},{"kind":"text","text":"?"}],"conformance":{"constraints":[{"code":"TimeType","type":"codeVoice"},{"type":"text","text":" conforms to "},{"code":"TimeProtocol","type":"codeVoice"},{"type":"text","text":"."}],"availabilityPrefix":[{"type":"text","text":"Avai