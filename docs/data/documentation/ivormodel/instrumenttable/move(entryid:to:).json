"},{"text":"instead of being kept separately, so ","type":"text"},{"code":"entryID","type":"codeVoice"},{"text":" no longer names anything in","type":"text"},{"text":" ","type":"text"},{"text":"the table; the returned identity is the survivor’s instead, which a","type":"text"},{"text":" ","type":"text"},{"text":"caller must switch to addressing from then on.","type":"text"}],"type":"paragraph"}]}],"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"url":"doc:\/\/IvorModel\/documentation\/IvorModel\/InstrumentTable\/move(entryID:to:)","interfaceLanguage":"swift"},"abstract":[{"text":"Moves the instrument entry with the given identity to a new time,","type":"text"},{"text":" ","type":"text"},{"text":"keeping its instrument and extras, and re-sorts it into place.","type":"text"}],"variants":[{"paths":["\/documentation\/ivormodel\/instrumenttable\/move(entryid:to:)"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/IvorModel\/documentation\/IvorModel","doc:\/\/IvorModel\/documentation\/IvorModel\/InstrumentTable"]]},"metadata":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"move","kind":"identifier"},{"text":"(","kind":"text"},{"text":"entryID","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"EntryID","preciseIdentifier":"s:9IvorModel7EntryIDV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TimeType","preciseIdentifier":"s:9IvorModel15InstrumentTableV8TimeTypexmfp","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"EntryID","preciseIdentifier":"s:9IvorModel7EntryIDV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"role":"symbol","roleHeading":"Instance Method","title":"move(entryID:to:)","externalID":"s:9IvorModel15InstrumentTableV4move7entryID2toAA05EntryG0VSgAH_xtF","symbolKind":"method","conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"conforma