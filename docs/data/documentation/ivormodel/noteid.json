t","text":" "},{"type":"reference","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/NoteTable\/movePitchStart(noteID:to:)","isActive":true},{"type":"text","text":", or "},{"type":"reference","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/NoteTable\/movePitchEnd(noteID:to:)","isActive":true},{"type":"text","text":" —"},{"type":"text","text":" "},{"type":"text","text":"without affecting its identity, so a caller can keep addressing the same note"},{"type":"text","text":" "},{"type":"text","text":"across an edit that reorders it, rather than recomputing which ordinal"},{"type":"text","text":" "},{"type":"text","text":"position it landed on."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Not persisted: "},{"type":"codeVoice","code":"NoteTable.StoredNote"},{"type":"text","text":"’s "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" conformance never encodes a"},{"type":"text","text":" "},{"type":"text","text":"note’s identity, and assigns every decoded note a fresh one, the same as a"},{"type":"text","text":" "},{"type":"text","text":"newly inserted note. A note’s identity is therefore stable only within one"},{"type":"text","text":" "},{"type":"text","text":"in-memory note table’s lifetime — never across an encode\/decode round trip,"},{"type":"text","text":" "},{"type":"text","text":"and so never across a save and reopen."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Unlike the "},{"type":"codeVoice","code":"EntryID"},{"type":"text","text":" of the time-keyed maps and tables, identity here does the same job in a"},{"type":"text","text":" "},{"type":"text","text":"context where content isn’t unique to begin with: a note table allows exact"},{"type":"text","text":" "},{"type":"text","text":"duplicates (a doubled unison), so — unlike "},{"type":"codeVoice","code":"TempoMap"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"PanMap"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"DynamicMap"},{"type":"text","text":"\/"},{"type":"text","text":" "},{"type":"codeVoice","code":"InstrumentTable"},{"type":"text","text":" — a move here can never “merge into” a pre-existing duplicate;"},{"type":"text","text":" "},{"type":"codeVoice","code":"noteID"},{"type":"text","text":" always keeps naming the same note, with no survivor-identity case to"},{"type":"text","text":" "},{"type":"text","text":"account for."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A top-level, non-generic type — not nested inside "},{"type":"codeVoice","code":"NoteTable<TimeType, PitchType>"},{"type":"text","text":" "},{"type":"text","text":"— so a single "},{"type":"codeVoice","code":"NoteID"},{"type":"text","text":" (and a single "},{"type":"codeVoice","code":"Set<NoteID>"},{"type":"text","text":") can be shared across"},{"type":"text","text":" "},{"type":"text","text":"differently-"},{"type":"codeVoice","code":"PitchType"},{"type":"text","text":"d parts, e.g. by "},{"type":"codeVoice","code":"Work"},{"type":"text","text":"’s whole-work transform methods,"},{"type":"text","text":" "},{"type":"text","text":"which operate across all three beat-time "},{"type":"codeVoice","code":"Content"},{"type":"text","text":" cases in one function body."}]}],"kind":"content"}],"identifier":{"url":"doc:\/\/IvorModel\/documentation\/IvorModel\/NoteID","interfaceLanguage":"swift"},"kind":"symbol","sections":[],"hierarchy":{"paths":[["doc:\/\/IvorModel\/documentation\/IvorModel"]]},"references":{"doc://IvorModel/documentation/IvorModel/NoteID/Comparable-Implementations":{"role":"collectionGroup","abstract":[],"title":"Comparable Implementations","kind":"article","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/NoteID\/Comparable-Implementations","url":"\/documentation\/ivormodel\/noteid\/comparable-implementations","type":"topic"},"doc://IvorModel/s26ExpressibleByStringLiteralP":{"type":"unresolvable","title":"Swift.ExpressibleByStringLiteral","identifier":"doc:\/\/IvorModel\/s2