{"kind":"symbol","identifier":{"url":"doc:\/\/IvorModel\/documentation\/IvorModel\/PanMap\/update(entryID:pan:extras:)","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"type":"text","text":"Replaces the pan entry with the given identity, in place."}],"metadata":{"extendedModule":"IvorModel","conformance":{"constraints":[{"type":"codeVoice","code":"TimeType"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"TimeProtocol"},{"type":"text","text":"."}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"availabilityPrefix":[{"type":"text","text":"Available when"}]},"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"update"},{"kind":"text","text":"("},{"kind":"externalParam","text":"entryID"},{"kind":"text","text":": "},{"preciseIdentifier":"s:9IvorModel7EntryIDV","kind":"typeIdentifier","text":"EntryID"},{"kind":"text","text":", "},{"kind":"externalParam","text":"pan"},{"kind":"text","text":": "},{"preciseIdentifier":"s:9IvorModel3PanV","kind":"typeIdentifier","text":"Pan"},{"kind":"text","text":", "},{"kind":"externalParam","text":"extras"},{"kind":"text","text":": "},{"preciseIdentifier":"s:10XestiTools6ExtrasV","kind":"typeIdentifier","text":"Extras"},{"kind":"text","text":"?) -> (updated"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"},{"kind":"text","text":", removedEntryID"},{"kind":"text","text":": "},{"preciseIdentifier":"s:9IvorModel7EntryIDV","kind":"typeIdentifier","text":"EntryID"},{"kind":"text","text":"?)"}],"roleHeading":"Instance Method","role":"symbol","title":"update(entryID:pan:extras:)","modules":[{"name":"IvorModel"}],"externalID":"s:9IvorModel6PanMapV6update7entryID3pan6extrasSb7updated_AA05EntryG0VSg07removedkG0tAJ_AA0C0V10XestiTools6ExtrasVSgtF","symbolKind":"method"},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"@discardableResult","kind":"attribute"},{"text":" ","kind":"text"},{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"update","kind":"identifier"},{"text":"(","kind":"text"},{"text":"entryID","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/EntryID","preciseIdentifier":"s:9IvorModel7EntryIDV","text":"EntryID","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"pan","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/Pan","preciseIdentifier":"s:9IvorModel3PanV","text":"Pan","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"extras","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:10XestiTools6ExtrasV","text":"Extras","kind":"typeIdentifier"},{"text":"? = nil) -> (updated","kind":"text"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":", removedEntryID","kind":"text"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/EntryID","preciseIdentifier":"s:9IvorModel7EntryIDV","text":"EntryID","kind":"typeIdentifier"},{"text":"?)","kind":"text"}]}]},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The identity of the entry to replace. An","type":"text"},{"text":" ","type":"text"},{"text":"identity naming no entry is ignored.","type":"text"}]}],"name":"entryID"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The new pan position for the entry."}]}],"name":"pan"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The new optional extra data for the entry.","type":"text"},{"text":" ","type":"text"},{"text":"Defaults to ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":".","type":"text"}]}],"name":"extras"}],"kind":"parameters"},{"kind":"content","content":[{"type":"heading","level":2,"text":"Return Value","anchor":"return-value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A pair of "},{"type":"codeVoice","code":"updated"},{"type":"text","text":", "},{"type":"codeVoice","code":"true"},{"type":"text","text":" if "},{"type":"codeVoice","code":"entryID"},{"type":"text","text":" identified an"},{"type":"text","text":" "},{"type":"text","text":"entry and it was updated, "},{"type":"codeVoice","code":"false"},{"type":"text","text":" if "},{"type":"codeVoice","code":"entryID"},{"type":"text","text":" named no"},{"type":"text","text":" "},{"type":"text","text":"entry and nothing happened — and "},{"type":"codeVoice","code":"removedEntryID"},{"type":"text","text":", the"},{"type":"text","text":" "},{"type":"text","text":"identity of the pre-existing entry dropped because the"},{"type":"text","text":" "},{"type":"text","text":"edit collapsed into it (see above). "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" if "},{"type":"codeVoice","code":"updated"},{"type":"text","text":" "},{"type":"text","text":"is "},{"type":"codeVoice","code":"false"},{"type":"text","text":", or if it is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" but no such collision"},{"type":"text","text":" "},{"type":"text","text":"occurred."}]}]},{"content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Unlike a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/PanMap\/remove(entryID:)"},{"type":"text","text":" followed by an "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/PanMap\/insert(time:pan:extras:)"},{"type":"text","text":", this"},{"type":"text","text":" "},{"type":"text","text":"keeps the entry’s identity and does not reorder entries. Reordering only matters when more"},{"type":"text","text":" "},{"type":"text","text":"than one entry shares a time: insertion always lands after every entry already at that"},{"type":"text","text":" "},{"type":"text","text":"time, so a remove-then-insert edit of one entry among ties silently changes the order of"},{"type":"text","text":" "},{"type":"text","text":"entries that were never touched. And — unlike a position — the identity keeps addressing"},{"type":"text","text":" "},{"type":"text","text":"this same entry across any other entry’s edit, so a caller never needs to re-resolve it"},{"type":"text","text":" "},{"type":"text","text":"first."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The edit can turn this entry into an exact duplicate of another one"},{"type":"text","text":" "},{"type":"text","text":"already at the same time — same time, pan position, and extras —"},{"type":"text","text":" "},{"type":"text","text":"the same combination "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/PanMap\/insert(time:pan:extras:)"},{"type":"text","text":" silently"},{"type":"text","text":" "},{"type":"text","text":"collapses. When that happens, "},{"code":"entryID","type":"codeVoice"},{"type":"text","text":" always keeps addressing the"},{"type":"text","text":" "},{"type":"text","text":"entry that was just updated; the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"other"}]},{"type":"text","text":", pre-existing entry is the"},{"type":"text","text":" "},{"type":"text","text":"one silently removed instead. That is the only choice consistent"},{"type":"text","text":" "},{"type":"text","text":"with the guarantee above: a caller invoking this method already"},{"type":"text","text":" "},{"type":"text","text":"holds "},{"code":"entryID","type":"codeVoice"},{"type":"text","text":" and goes on using it afterward, so honoring “this"},{"type":"text","text":" "},{"type":"text","text":"identity keeps addressing this same entry” means the entry it"},{"type":"text","text":" "},{"type":"text","text":"wasn’t referencing has to be the one that gives way, never the one"},{"type":"text","text":" "},{"type":"text","text":"it was."}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/IvorModel\/documentation\/IvorModel","doc:\/\/IvorModel\/documentation\/IvorModel\/PanMap"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormodel\/panmap\/update(entryid:pan:extras:)"]}],"references":{"doc://IvorModel/documentation/IvorModel/PanMap":{"kind":"symbol","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/PanMap","role":"symbol","title":"PanMap","url":"\/documentation\/ivormodel\/panmap","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PanMap","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"PanMap","kind":"identifier"}],"abstract":[{"type":"text","text":"A time-indexed map of spatial pan positions with a configurable default."}]},"doc://IvorModel/documentation/IvorModel":{"identifier":"doc:\/\/IvorModel\/documentation\/IvorModel","abstract":[{"type":"text","text":"A representation-agnostic musical composition model."}],"title":"IvorModel","type":"topic","kind":"symbol","url":"\/documentation\/ivormodel","role":"collection"},"doc://IvorModel/documentation/IvorModel/EntryID":{"role":"symbol","type":"topic","url":"\/documentation\/ivormodel\/entryid","title":"EntryID","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EntryID","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"EntryID"}],"abstract":[{"type":"text","text":"A unique identity for an entry in a time-keyed map or table, represented as a"},{"type":"text","text":" "},{"type":"text","text":"validated string."}],"identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/EntryID"},"doc://IvorModel/documentation/IvorModel/PanMap/remove(entryID:)":{"url":"\/documentation\/ivormodel\/panmap\/remove(entryid:)","title":"remove(entryID:)","identifier":"do