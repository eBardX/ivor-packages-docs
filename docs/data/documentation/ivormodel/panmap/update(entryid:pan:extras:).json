eyword","text":"mutating"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"update"},{"kind":"text","text":"("},{"kind":"externalParam","text":"entryID"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/EntryID","text":"EntryID","preciseIdentifier":"s:9IvorModel7EntryIDV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"pan"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/Pan","text":"Pan","preciseIdentifier":"s:9IvorModel3PanV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"extras"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Extras","preciseIdentifier":"s:10XestiTools6ExtrasV"},{"kind":"text","text":"? = nil) -> (updated"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":", removedEntryID"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/EntryID","text":"EntryID","preciseIdentifier":"s:9IvorModel7EntryIDV"},{"kind":"text","text":"?)"}],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"name":"entryID","content":[{"type":"paragraph","inlineContent":[{"text":"The identity of the entry to replace. An","type":"text"},{"text":" ","type":"text"},{"text":"identity naming no entry is ignored.","type":"text"}]}]},{"name":"pan","content":[{"type":"paragraph","inlineContent":[{"text":"The new pan position for the entry.","type":"text"}]}]},{"name":"extras","content":[{"type":"paragraph","inlineContent":[{"text":"The new optional extra data for the entry.","type":"text"},{"text":" ","type":"text"},{"text":"Defaults to ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":".","type":"text"}]}]}]},{"content":[{"text":"Return Value","anchor":"return-value","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"A pair of "},{"type":"codeVoice","code":"updated"},{"type":"text","text":", "},{"type":"codeVoice","code":"true"},{"type":"text","text":" if "},{"type":"codeVoice","code":"entryID"},{"type":"text","text":" identified an"},{"type":"text","text":" "},{"type":"text","text":"entry and it was updated, "},{"type":"codeVoice","code":"false"},{"type":"text","text":" if "},{"type":"codeVoice","code":"entryID"},{"type":"text","text":" named no"},{"type":"text","text":" "},{"type":"text","text":"entry and nothing happened — and "},{"type":"codeVoice","code":"removedEntryID"},{"type":"text","text":", the"},{"type":"text","text":" "},{"type":"text","text":"identity of the pre-existing entry dropped because the"},{"type":"text","text":" "},{"type":"text","text":"edit collapsed into it (see above). "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" if "},{"type":"codeVoice","code":"updated"},{"type":"text","text":" "},{"type":"text","text":"is "},{"type":"codeVoice","code":"false"},{"type":"text","text":", or if it is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" but no such collision"},{"type":"text","text":" "},{"type":"text","text":"occurred."}],"type":"paragraph"}],"kind":"content"},{"content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Unlike a "},{"identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/PanMap\/remove(entryID:)","type":"reference","isActive":true},{"type":"text","text":" followed by an "},{"identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/PanMap\/insert(time:pan:extras:)","type":"reference","isActive":true},{"type":"text","text":", this"},{"type":"text","text":" "},{"type":"text","text":"keeps the entry’s identity and does not reorder entries. Reordering only matters when more"},{"type":"text","text":" "},{"type":"text","text":"than one entry shares a time: insertion always lands after every entry already at that"},{"type":"text","text":" "},{"type":"text","text":"time, so a remove-then-insert edit of one entry among ties silently changes the order of"},{"type":"text","text":" "},{"type":"text","text":"entries that were never touched. And — unlike a position — the identity keeps addressing"},{"type":"text","text":" "},{"type":"text","text":"this same entry across any other entry’s edit, so a caller never needs to re-resolve it"},{"type":"text","text":" "},{"type":"text","text":"first."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The edit can turn this entry into an exact duplicate of another one"},{"type":"text","text":" "},{"type":"text","text":"already at the same time — same time, pan position, and extras —"},{"type":"text","text":" "},{"type":"text","text":"the same combination "},{"identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/PanMap\/insert(time:pan:extras:)","type":"reference","isActive":true},{"type":"text","text":" silently"},{"type":"text","text":" "},{"type":"text","text":"collapses. When that happens, "},{"type":"codeVoice","code":"entryID"},{"type":"text","text":" always keeps addressing the"},{"type":"text","text":" "},{"type":"text","text":"entry that was just updated; the "},{"type":"emphasis","inlineContent":[{"text":"other","type":"text"}]},{"type":"text","text":", pre-existing entry is the"},{"type":"text","text":" "},{"type":"text","text":"one silently removed instead. That is the only choice consistent"},{"type":"text","text":" "},{"type":"text","text":"with the guarantee above: a caller invoking this method already"},{"type":"text","text":" "},{"type":"text","text":"holds "},{"type":"codeVoice","code":"entryID"},{"type":"text","text":" and goes on using it afterward, so honoring “this"},{"type":"text","text":" "},{"type":"text","text":"identity keeps addressing this same entry” means the entry it"},{"type":"text","text":" "},{"type":"text","text":"wasn’t referencing has to be the one that gives way, never the one"},{"type":"text","text":" "},{"type":"text","text":"it was."}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"variants":[{"paths":["\/documentation\/ivormodel\/panmap\/update(entryid:pan:extras:)"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorModel\/documentation\/IvorModel\/PanMap\/update(entryID:pan:extras:)"},"references":{"doc://IvorModel/documentation/IvorModel/PanMap/update(entryID:pan:extras:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"update","kind":"identifier"},{"text":"(","kind":"text"},{"text":"entryID","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"EntryID","kind":"typeIdentifier","preciseIdentifier":"s:9IvorModel7EntryIDV"},{"text":", ","kind":"text"},{"text":"pan","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Pan","kind":"typeIdentifier","preciseIdentifier":"s:9IvorModel3PanV"},{"text":", ","kind":"text"},{"text":"extras","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Extras","kind":"typeIdentifier","preciseIdentifier":"s:10XestiTools6ExtrasV"},{"text":"?) -> (updated","kind":"text"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":", removedEntryID","kind":"text"},{"text":": ","kind":"text"},{"text":"EntryID","kind":"typeIdentifier","preciseIdentifier":"s:9IvorModel7EntryIDV"},{"text":"?)","kind":"text"}],"abstract":[{"text":"Replaces the pan entry with the given identity, in place.","type":"text"}],"kind":"symbol","type":"topic","url":"\/documentation\/ivormodel\/panmap\/update(entryid:pan:extras:)","role":"symbol","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/PanMap\/update(entryID:pan:extras:)","title":"update(entryID:pan:extras:)","conformance":{"constraints":[{"code":"TimeType","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"TimeProtocol","type":"codeVoice"},{"text":".","ty