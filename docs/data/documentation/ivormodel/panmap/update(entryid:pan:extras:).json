codeVoice","code":"nil"},{"type":"text","text":"."}],"type":"paragraph"}],"name":"extras"}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Return Value","anchor":"return-value"},{"inlineContent":[{"type":"text","text":"A pair of "},{"type":"codeVoice","code":"updated"},{"type":"text","text":", "},{"type":"codeVoice","code":"true"},{"type":"text","text":" if "},{"type":"codeVoice","code":"entryID"},{"type":"text","text":" identified an"},{"type":"text","text":" "},{"type":"text","text":"entry and it was updated, "},{"type":"codeVoice","code":"false"},{"type":"text","text":" if "},{"type":"codeVoice","code":"entryID"},{"type":"text","text":" named no"},{"type":"text","text":" "},{"type":"text","text":"entry and nothing happened — and "},{"type":"codeVoice","code":"removedEntryID"},{"type":"text","text":", the"},{"type":"text","text":" "},{"type":"text","text":"identity of the pre-existing entry dropped because the"},{"type":"text","text":" "},{"type":"text","text":"edit collapsed into it (see above). "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" if "},{"type":"codeVoice","code":"updated"},{"type":"text","text":" "},{"type":"text","text":"is "},{"type":"codeVoice","code":"false"},{"type":"text","text":", or if it is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" but no such collision"},{"type":"text","text":" "},{"type":"text","text":"occurred."}],"type":"paragraph"}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"Unlike a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/PanMap\/remove(entryID:)"},{"type":"text","text":" followed by an "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/PanMap\/insert(time:pan:extras:)"},{"type":"text","text":", this"},{"type":"text","text":" "},{"type":"text","text":"keeps the entry’s identity and does not reorder entries. Reordering only matters when more"},{"type":"text","text":" "},{"type":"text","text":"than one entry shares a time: insertion always lands after every entry already at that"},{"type":"text","text":" "},{"type":"text","text":"time, so a remove-then-insert edit of one entry among ties silently changes the order of"},{"type":"text","text":" "},{"type":"text","text":"entries that were never touched. And — unlike a position — the identity keeps addressing"},{"type":"text","text":" "},{"type":"text","text":"this same entry across any other entry’s edit, so a caller never needs to re-resolve it"},{"type":"text","text":" "},{"type":"text","text":"first."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The edit can turn this entry into an exact duplicate of another one"},{"type":"text","text":" "},{"type":"text","text":"already at the same time — same time, pan position, and extras —"},{"type":"text","text":" "},{"type":"text","text":"the same combination "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/PanMap\/insert(time:pan:extras:)"},{"type":"text","text":" silently"},{"type":"text","text":" "},{"type":"text","text":"collapses. When that happens, "},{"type":"codeVoice","code":"entryID"},{"type":"text","text":" always keeps addressing the"},{"type":"text","text":" "},{"type":"text","text":"entry that was just updated; the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"other"}]},{"type":"text","text":", pre-existing entry is the"},{"type":"text","text":" "},{"type":"text","text":"one silently removed instead. That is the only choice consistent"},{"type":"text","text":" "},{"type":"text","text":"with the guarantee above: a caller invoking this method already"},{"type":"text","text":" "},{"type":"text","text":"holds "},{"type":"codeVoice","code":"entryID"},{"type":"text","text":" and goes on using it afterward, so honoring “this"},{"type":"text","text":" "},{"type":"text","text":"identity keeps addressing this same entry” means the entry it"},{"type":"text","text":" "},{"type":"text","text":"wasn’t referencing has to be the one that gives way, never the one"},{"type":"text","text":" "},{"type":"text","text":"it was."}],"type":"paragraph"}]}],"sections":[],"variants":[{"paths":["\/documentation\/ivormodel\/panmap\/update(entryid:pan:extras:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://IvorModel/documentation/IvorModel/Pan/Angle":{"kind":"symbol","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/Pan\/Angle","abstract":[{"type":"text","text":"An angle, in degrees, that wraps into the half-open range "},{"type":"codeVoice","code":"(-180, 180]"},{"type":"text","text":"."}],"title":"Pan.Angle","navigatorTitle":[{"text":"Angle","kind":"identifier"}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Angle","kind":"identifier"}],"role":"symbol","url":"\/documentation\/ivormodel\/pan\/angle"},"doc://IvorModel/documentation/IvorModel/PanMap/update(entryID:pan:extras:)":{"kind":"symbol","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/PanMap\/update(entryID:pan:extras:)","abstract":[{"type":"text","text":"Replaces the pan entry with the given identity, in place."}],"conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"type":"codeVoice","code":"TimeType"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"TimeProtocol"},{"type":"text","text":"."}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]},"title":"update(entryID:pan:extras:)","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"update","kind":"identifier"},{"text":"(","kind":"text"},{"text":"entryID","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"EntryID","kind":"typeIdentifier","preciseIdentifier":"s:9IvorModel7EntryIDV"},{"text":", ","kind":"text"},{"text":"pan","kind":"exte