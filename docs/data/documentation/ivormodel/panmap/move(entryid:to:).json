{"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"attribute","text":"@discardableResult"},{"kind":"text","text":" "},{"kind":"keyword","text":"mutating"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"move"},{"kind":"text","text":"("},{"kind":"externalParam","text":"entryID"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"EntryID","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/EntryID","preciseIdentifier":"s:9IvorModel7EntryIDV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"to"},{"kind":"text","text":" "},{"text":"time","kind":"internalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:9IvorModel6PanMapV8TimeTypexmfp","text":"TimeType","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:9IvorModel7EntryIDV","text":"EntryID","kind":"typeIdentifier","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/EntryID"},{"text":"?","kind":"text"}]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The identity of the entry to move."}]}],"name":"entryID"},{"content":[{"inlineContent":[{"type":"text","text":"The new time for the entry."}],"type":"paragraph"}],"name":"time"}]},{"content":[{"anchor":"return-value","text":"Return Value","level":2,"type":"heading"},{"inlineContent":[{"text":"The identity that now addresses this entry’s content — ","type":"text"},{"code":"entryID","type":"codeVoice"},{"text":" ","type":"text"},{"text":"itself, unless the move merged it into a pre-existing exact","type":"text"},{"text":" ","type":"text"},{"text":"duplicate, in which case the survivor’s identity. ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" if","type":"text"},{"text":" ","type":"text"},{"code":"entryID","type":"codeVoice"},{"text":" did not identify any entry and nothing moved.","type":"text"}],"type":"paragraph"}],"kind":"content"},{"content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Unlike ","type":"text"},{"identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/PanMap\/update(entryID:pan:extras:)","type":"reference","isActive":true},{"type":"text","text":", this is expected to reorder"},{"type":"text","text":" "},{"type":"text","text":"entries — that is the point of editing the time itself. Two entries"},{"type":"text","text":" "},{"type":"text","text":"legitimately ending up at the same time (see"},{"type":"text","text":" "},{"identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/PanMap\/insert(time:pan:extras:)","type":"reference","isActive":true},{"type":"text","text":" for the discontinuity use case) is not"},{"type":"text","text":" "},{"type":"text","text":"treated as a collision to reject; the moved entry simply takes its"},{"type":"text","text":" "},{"type":"text","text":"place among any others already there, exactly as a fresh insertion"},{"type":"text","text":" "},{"type":"text","text":"would."}]},{"type":"paragraph","inlineContent":[{"text":"The one case where ","type":"text"},{"code":"entryID","type":"codeVoice"},{"text":" stops identifying the moved entry afterward is","type":"text"},{"text":" ","type":"text"},{"text":"when the move lands it exactly on top of another entry already","type":"text"},{"text":" ","type":"text"},{"text":"present — same time, pan position, and extras — the same","type":"text"},{"type":"text","text":" "},{"type":"text","text":"exact-duplicate case "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/PanMap\/insert(time:pan:extras:)"},{"type":"text","text":" silently collapses."},{"text":" ","type":"text"},{"text":"There, the moved entry merges into that pre-existing one instead of","type":"text"},{"text":" ","type":"text"},{"text":"being kept separately, so ","type":"text"},{"type":"codeVoice","code":"entryID"},{"type":"text","text":" no longer names anything in the map;"},{"type":"text","text":" "},{"type":"text","text":"the returned identity is the survivor’s instead, which a caller must"},{"type":"text","text":" "},{"type":"text","text":"switch to addressing from then on."}]}],"kind":"content"}],"sections":[],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/IvorModel\/documentation\/IvorModel","doc:\/\/IvorModel\/documentation\/IvorModel\/PanMap"]]},"metadata":{"modules":[{"name":"IvorModel"}],"extendedModule":"IvorModel","title":"move(entryID:to:)","conformance":{"conformancePrefix":[{"text":"Conforms when","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}],"constraints":[{"code":"TimeType","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"TimeProtocol","type":"codeVoice"},{"text":".","type":"text"}]},"symbolKind":"method","externalID":"s:9IvorModel6PanMapV4move7entryID2toAA05EntryG0VSgAH_xtF","role":"symbol","roleHeading":"Instance Method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"move","kind":"identifier"},{"text":"(","kind":"text"},{"text":"entryID","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:9IvorModel7EntryIDV","text":"EntryID","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:9IvorModel6PanMapV8TimeTypexmfp","text":"TimeType","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:9IvorModel7EntryIDV","text":"EntryID","kind":"typeIdentifier"},{"text":"?","kind":"text"}]},"abstract":[{"text":"Moves the pan entry with the given identity to a new time, keeping","type":"text"},{"text":" ","type":"text"},{"text":"its pan position and extras, and re-sorts it into place.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/document