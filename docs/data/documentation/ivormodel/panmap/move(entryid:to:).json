text":"move","kind":"identifier"},{"text":"(","kind":"text"},{"text":"entryID","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/EntryID","text":"EntryID","preciseIdentifier":"s:9IvorModel7EntryIDV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"to","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"time","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"TimeType","preciseIdentifier":"s:9IvorModel6PanMapV8TimeTypexmfp","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/EntryID","text":"EntryID","preciseIdentifier":"s:9IvorModel7EntryIDV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"name":"entryID","content":[{"inlineContent":[{"text":"The identity of the entry to move.","type":"text"}],"type":"paragraph"}]},{"name":"time","content":[{"inlineContent":[{"text":"The new time for the entry.","type":"text"}],"type":"paragraph"}]}],"kind":"parameters"},{"content":[{"type":"heading","text":"Return Value","level":2,"anchor":"return-value"},{"type":"paragraph","inlineContent":[{"text":"The identity that now addresses this entry’s content — ","type":"text"},{"type":"codeVoice","code":"entryID"},{"text":" ","type":"text"},{"text":"itself, unless the move merged it into a pre-existing exact","type":"text"},{"text":" ","type":"text"},{"text":"duplicate, in which case the survivor’s identity. ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" if","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"entryID"},{"text":" did not identify any entry and nothing moved.","type":"text"}]}],"kind":"content"},{"content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Unlike ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorModel\/docume