@discardableResult","kind":"attribute"},{"text":" ","kind":"text"},{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"move","kind":"identifier"},{"text":"(","kind":"text"},{"text":"entryID","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"EntryID","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/EntryID","preciseIdentifier":"s:9IvorModel7EntryIDV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"to","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"time","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"TimeType","preciseIdentifier":"s:9IvorModel10DynamicMapV8TimeTypexmfp","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"EntryID","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/EntryID","preciseIdentifier":"s:9IvorModel7EntryIDV","kind":"typeIdentifier"},{"text":"?","kind":"text"}]}]},{"kind":"parameters","parameters":[{"name":"entryID","content":[{"type":"paragraph","inlineContent":[{"text":"The identity of the entry to move.","type":"text"}]}]},{"name":"time","content":[{"type":"paragraph","inlineContent":[{"text":"The new time for the entry.","type":"text"}]}]}]},{"content":[{"text":"Return Value","type":"heading","level":2,"anchor":"return-value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The identity that now addresses this entry’s content — "},{"type":"codeVoice","code":"entryID"},{"type":"text","text":" "},{"type":"text","text":"itself, unless the move merged it into a pre-existing exact"},{"type":"text","text":" "},{"type":"text","text":"duplicate, in which case the survivor’s identity. "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" if"},{"type":"text","text":" "},{"type":"codeVoice","code":"entryID"},{"type":"text","text":" did not identify any entry and nothing moved."}]}],"kind":"content"},{"content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Unlike "},{"type":"reference","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/DynamicMap\/update(entryID:dynamic:extras:)","isActive":true},{"type":"text","text":", this is expected to reorder"},{"type":"text","text":" "},{"type":"text","text":"entries — that is the point of editing the time itself. Two entries"},{"type":"text","text":" "},{"type":"text","text":"legitimately ending up at the same time (see"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/DynamicMap\/insert(time:dynamic:extras:)","isActive":true},{"type":"text","text":" for the discontinuity use case) is"},{"type":"text","text":" "},{"type":"text","text":"not treated as a collision to reject; the moved entry simply takes"},{"type":"text","text":" "},{"type":"text","text":"its place among any others already there, exactly as a fresh"},{"type":"text","text":" "},{"type":"text","text":"insertion would."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The one case where "},{"type":"codeVoice","code":"entryID"},{"type":"text","text":" stops identifying the moved entry afterward is"},{"type":"text","text":" "},{"type":"text","text":"when the move lands it exactly on top of another entry already"},{"type":"text","text":" "},{"type":"text","text":"present — same time, dynamic level, and extras — the same"},{"type":"text","text":" "},{"type":"text","text":"exact-duplicate case "},{"type":"reference","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/DynamicMap\/insert(time:dynamic:extras:)","isActive":true},{"type":"text","text":" silently"},{"type":"text","text":" "},{"type":"text","text":"collapses. There, the moved entry merges into that pre-existing one"},{"type":"text","text":" "},{"type":"text","text":"instead of being kept separately, so "},{"type":"codeVoice","code":"entryID"},{"type":"text","text":" no longer names anything in"},{"type":"text","text":" "},{"type":"text","text":"the map; the returned identity is the survivor’s instead, which a"},{"type":"text","text":" "},{"type":"text","text":"caller must switch to addressing from then on."}]}],"kind":"content"}],"references":{"doc://IvorModel/documentation/IvorModel/DynamicMap/insert(time:dynamic:extras:)":{"type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"insert"},{"kind":"text","text":"("},{"kind":"externalParam","text":"time"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"TimeType","preciseIdentifier":"s:9IvorModel10DynamicMapV8TimeTypexmfp"},{"kind":"text","text":", "},{"kind":"externalParam","text":"dynamic"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Dynamic","preciseIdentifier":"s:9IvorModel7DynamicV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"extras"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Extras","preciseIdentifier":"s:10XestiTools6ExtrasV"},{"kind":"text","text":"?) -> (entryID"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"EntryID","preciseIdentifier":"s:9IvorModel7EntryIDV"},{"kind":"text","text":", inserted"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":")"}],"identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/DynamicMap\/insert(time:dynamic:extras:)","abstract":[{"text":"Inserts a dynamic entry into this dynamic map at the given time.","type":"text"}],"conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"constraints":[{"code":"TimeType","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"TimeProtocol","type":"codeVoice"},{"text":".","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}]},"url":"\/documentation\/ivormodel\/dynamicmap\/insert(time:dynamic:extras:)","title":"insert(time:dynamic:extras:)","role":"symbol"},"doc://Ivor