{"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"hierarchy":{"paths":[["doc:\/\/IvorModel\/documentation\/IvorModel","doc:\/\/IvorModel\/documentation\/IvorModel\/DynamicMap"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormodel\/dynamicmap\/move(entryid:to:)"]}],"abstract":[{"type":"text","text":"Moves the dynamic entry with the given identity to a new time,"},{"type":"text","text":" "},{"type":"text","text":"keeping its dynamic level and extras, and re-sorts it into place."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"@discardableResult","kind":"attribute"},{"text":" ","kind":"text"},{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"move","kind":"identifier"},{"text":"(","kind":"text"},{"text":"entryID","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"EntryID","preciseIdentifier":"s:9IvorModel7EntryIDV","kind":"typeIdentifier","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/EntryID"},{"text":", ","kind":"text"},{"text":"to","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"time","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"TimeType","preciseIdentifier":"s:9IvorModel10DynamicMapV8TimeTypexmfp","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"EntryID","preciseIdentifier":"s:9IvorModel7EntryIDV","kind":"typeIdentifier","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/EntryID"},{"text":"?","kind":"text"}]}]},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The identity of the entry to move."}],"type":"paragraph"}],"name":"entryID"},{"content":[{"inlineContent":[{"type":"text","text":"The new time for the entry."}],"type":"paragraph"}],"name":"time"}]},{"content":[{"type":"heading","level":2,"text":"Return Value","anchor":"return-value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The identity that now addresses this entry’s content — "},{"type":"codeVoice","code":"entryID"},{"type":"text","text":" "},{"type":"text","text":"itself, unless the move merged it into a pre-existing exact"},{"type":"text","text":" "},{"type":"text","text":"duplicate, in which case the survivor’s identity. "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" if"},{"type":"text","text":" "},{"type":"codeVoice","code":"entryID"},{"type":"text","text":" did not identify any entry and nothing moved."}]}],"kind":"content"},{"content":[{"type":"heading","anchor":"discussion","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Unlike "},{"type":"reference","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/DynamicMap\/update(entryID:dynamic:extras:)","isActive":true},{"type":"text","text":", this is expected to reorder"},{"type":"text","text":" "},{"type":"text","text":"entries — that is the point of editing the time itself. Two entries"},{"type":"text","text":" "},{"type":"text","text":"legitimately ending up at the same time (see"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/DynamicMap\/insert(time:dynamic:extras:)"},{"type":"text","text":" for the discontinuity use case) is"},{"type":"text","text":" "},{"type":"text","text":"not treated as a collision to reject; the moved entry simply takes"},{"type":"text","text":" "},{"type":"text","text":"its place among any others already there, exactly as a fresh"},{"type":"text","text":" "},{"type":"text","text":"insertion would."}]},{"inlineContent":[{"type":"text","text":"The one case where "},{"type":"codeVoice","code":"entryID"},{"type":"text","text":" stops identifying the moved entry afterward is"},{"type":"text","text":" "},{"type":"text","text":"when the move lands it exactly on top of another entry already"},{"type":"text","text":" "},{"type":"text","text":"present — same time, dynamic level, and extras — the same"},{"type":"text","text":" "},{"type":"text","text":"exact-duplicate case "},{"type":"reference","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/DynamicMap\/insert(time:dynamic:extras:)","isActive":true},{"type":"text","text":" silently"},{"type":"text","text":" "},{"type":"text","text":"collapses. There, the moved entry merges into that pre-existing one"},{"type":"text","text":" "},{"type":"text","text":"instead of being kept separately, so "},{"type":"codeVoice","code":"entryID"},{"text":" no longer names anything in","type":"text"},{"text":" ","type":"text"},{"text":"the map; the returned identity is the survivor’s instead, which a","type":"text"},{"text":" ","type":"text"},{"text":"caller must switch to addressing from then on.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"metadata":{"role":"symbol","roleHeading":"Instance Method","symbolKind":"method","modules":[{"name":"IvorModel"}],"externalID":"s:9IvorModel10DynamicMapV4move7entryID2toAA05EntryG0VSgAH_xtF","conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"constraints":[{"code":"TimeType","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"TimeProtocol","type":"codeVoice"},{"text":".","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}]},"title":"move(entryID:to:)","extendedModule":"IvorModel","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"move","kind":"identifier"},{"text":"(","kind":"text"},{"text":"entryID","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"EntryID","preciseIdentifier":"s:9IvorModel7EntryIDV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TimeType","preciseIdentifier":"s:9IvorModel10DynamicMapV8TimeTypexmfp","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"EntryI