reference","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/DynamicMap\/insert(time:dynamic:extras:)"},{"type":"text","text":", this"},{"type":"text","text":" "},{"type":"text","text":"keeps the entry’s identity and does not reorder entries. Reordering only matters when more"},{"type":"text","text":" "},{"type":"text","text":"than one entry shares a time: insertion always lands after every entry already at that"},{"type":"text","text":" "},{"type":"text","text":"time, so a remove-then-insert edit of one entry among ties silently changes the order of"},{"type":"text","text":" "},{"type":"text","text":"entries that were never touched. And — unlike a position — the identity keeps addressing"},{"type":"text","text":" "},{"type":"text","text":"this same entry across any other entry’s edit, so a caller never needs to re-resolve it"},{"type":"text","text":" "},{"type":"text","text":"first."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The edit can turn this entry into an exact duplicate of another one"},{"type":"text","text":" "},{"type":"text","text":"already at the same time — same time, dynamic level, and extras —"},{"type":"text","text":" "},{"type":"text","text":"the same combination "},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/DynamicMap\/insert(time:dynamic:extras:)"},{"type":"text","text":" silently"},{"type":"text","text":" "},{"type":"text","text":"collapses. When that happens, "},{"code":"entryID","type":"codeVoice"},{"type":"text","text":" always keeps addressing the"},{"type":"text","text":" "},{"type":"text","text":"entry that was just updated; the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"other"}]},{"type":"text","text":", pre-existing entry is the"},{"type":"text","text":" "},{"type":"text","text":"one silently removed instead. That is the only choice consistent"},{"type":"text","text":" "},{"type":"text","text":"with the guarantee above: a caller invoking this method already"},{"type":"text","text":" "},{"type":"text","text":"holds "},{"code":"entryID","type":"codeVoice"},{"type":"text","text":" and goes on using it afterward, so honoring “this"},{"type":"text","text":" "},{"type":"text","text":"identity keeps addressing this same entry” means the entry it"},{"type":"text","text":" "},{"type":"text","text":"wasn’t referencing has to be the one that gives way, never the one"},{"type":"text","text":" "},{"type":"text","text":"it was."}],"type":"paragraph"}]}],"references":{"doc://IvorModel/documentation/IvorModel":{"abstract":[{"text":"A representation-agnostic musical composition model.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel","kind":"symbol","role":"collection","url":"\/documentation\/ivormodel","title":"IvorModel"},"doc://IvorModel/documentation/IvorModel/EntryID":{"abstract":[{"type":"text","text":"A unique identity for an entry in a time-keyed map, represented as a"},{"type":"text","text":" "},{"text":"validated string.","type":"text"}],"type":"topic","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/EntryID","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EntryID","kind":"identifier"}],"title":"EntryID","url":"\/documentation\/ivormodel\/entryid","navigatorTitle":[{"text":"EntryID","kind":"identifier"}]},"doc://IvorModel/documentation/IvorModel/DynamicMap/remove(entryID:)":{"conformance":{"conformancePrefix":[{"text":"Conforms when","type":"text"}],"constraints":[{"code":"TimeType","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"TimeProtocol","type":"codeVoice"},{"text":".","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}]},"type":"topic","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/DynamicMap\/remove(entryID:)","url":"\/documentation\/ivormodel\/dynamicmap\/remove(entryid:)","abstract":[{"text":"Removes the dynamic entry with 