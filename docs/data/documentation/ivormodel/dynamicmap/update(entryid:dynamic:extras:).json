{"sections":[],"identifier":{"url":"doc:\/\/IvorModel\/documentation\/IvorModel\/DynamicMap\/update(entryID:dynamic:extras:)","interfaceLanguage":"swift"},"abstract":[{"text":"Replaces the dynamic entry with the given identity, in place.","type":"text"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"paths":["\/documentation\/ivormodel\/dynamicmap\/update(entryid:dynamic:extras:)"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","primaryContentSections":[{"declarations":[{"tokens":[{"kind":"attribute","text":"@discardableResult"},{"kind":"text","text":" "},{"kind":"keyword","text":"mutating"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"update"},{"kind":"text","text":"("},{"kind":"externalParam","text":"entryID"},{"kind":"text","text":": "},{"preciseIdentifier":"s:9IvorModel7EntryIDV","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/EntryID","kind":"typeIdentifier","text":"EntryID"},{"kind":"text","text":", "},{"kind":"externalParam","text":"dynamic"},{"text":": ","kind":"text"},{"text":"Dynamic","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/Dynamic","preciseIdentifier":"s:9IvorModel7DynamicV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"extras","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Extras","preciseIdentifier":"s:10XestiTools6ExtrasV","kind":"typeIdentifier"},{"text":"? = nil) -> (updated","kind":"text"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":", removedEntryID","kind":"text"},{"text":": ","kind":"text"},{"text":"EntryID","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/EntryID","preciseIdentifier":"s:9IvorModel7EntryIDV","kind":"typeIdentifier"},{"text":"?)","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"name":"entryID","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The identity of the entry to replace. An"},{"type":"text","text":" "},{"type":"text","text":"identity naming no entry is ignored."}]}]},{"name":"dynamic","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The new dynamic level for the entry."}]}]},{"name":"extras","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The new optional extra data for the entry."},{"type":"text","text":" "},{"type":"text","text":"Defaults to "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}]}]}],"kind":"parameters"},{"kind":"content","content":[{"anchor":"return-value","type":"heading","text":"Return Value","level":2},{"type":"paragraph","inlineContent":[{"text":"A pair of ","type":"text"},{"type":"codeVoice","code":"updated"},{"text":", ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" if ","type":"text"},{"type":"codeVoice","code":"entryID"},{"text":" identified an","type":"text"},{"text":" ","type":"text"},{"text":"entry and it was updated, ","type":"text"},{"type":"codeVoice","code":"false"},{"text":" if ","type":"text"},{"type":"codeVoice","code":"entryID"},{"text":" named no","type":"text"},{"text":" ","type":"text"},{"text":"entry and nothing happened — and ","type":"text"},{"type":"codeVoice","code":"removedEntryID"},{"text":", the","type":"text"},{"text":" ","type":"text"},{"text":"identity of the pre-existing entry dropped because the","type":"text"},{"text":" ","type":"text"},{"text":"edit collapsed into it (see above). ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" if ","type":"text"},{"type":"codeVoice","code":"updated"},{"text":" ","type":"text"},{"text":"is ","type":"text"},{"type":"codeVoice","code":"false"},{"text":", or if it is ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" but no such collision","type":"text"},{"text":" ","type":"text"},{"text":"occurred.","type":"text"}]}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"Unlike a ","type":"text"},{"type":"reference","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/DynamicMap\/remove(entryID:)","isActive":true},{"text":" followed by an ","type":"text"},{"type":"reference","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/DynamicMap\/insert(time:dynamic:extras:)","isActive":true},{"text":", this","type":"text"},{"text":" ","type":"text"},{"text":"keeps the entry’s identity and does not reorder entries. Reordering only matters when more","type":"text"},{"text":" ","type":"text"},{"text":"than one entry shares a time: insertion always lands after every entry already at that","type":"text"},{"text":" ","type":"text"},{"text":"time, so a remove-then-insert edit of one entry among ties silently changes the order of","type":"text"},{"text":" ","type":"text"},{"text":"entries that were never touched. And — unlike a position — the identity keeps addressing","type":"text"},{"text":" ","type":"text"},{"text":"this same entry across any other entry’s edit, so a caller never needs to re-resolve it","type":"text"},{"text":" ","type":"text"},{"text":"first.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The edit can turn this entry into an exact duplicate of another one"},{"type":"text","text":" "},{"type":"text","text":"already at the same time — same time, dynamic level, and extras —"},{"type":"text","text":" "},{"type":"text","text":"the same combination "},{"type":"reference","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/DynamicMap\/insert(time:dynamic:extras:)","isActive":true},{"type":"text","text":" silently"},{"type":"text","text":" "},{"type":"text","text":"collapses. When that happens, "},{"type":"codeVoice","code":"entryID"},{"type":"text","text":" always keeps addressing the"},{"type":"text","text":" "},{"type":"text","text":"entry that was just updated; the "},{"type":"emphasis","inlineContent":[{"text":"other","type":"text"}]},{"type":"text","text":", pre-existing entry is the"},{"type":"text","text":" "},{"type":"text","text":"one silently removed instead. That is the only choice consistent"},{"type":"text","text":" "},{"type":"text","text":"with the guarantee above: a caller invoking this method already"},{"type":"text","text":" "},{"type":"text","text":"holds "},{"type":"codeVoice","code":"entryID"},{"type":"text","text":" and goes on using it afterward, so honoring “this"},{"type":"text","text":" "},{"type":"text","text":"identity keeps addressing this same entry” means the entry it"},{"type":"text","text":" "},{"type":"text","text":"wasn’t referencing has to be the one that gives way, never the one"},{"type":"text","text":" "},{"type":"text","text":"it was."}]}]}],"hierarchy":{"paths":[["doc:\/\/IvorModel\/documentation\/IvorModel","doc:\/\/IvorModel\/documentation\/IvorModel\/DynamicMap"]]},"metadata":{"role":"symbol","externalID":"s:9IvorModel10DynamicMapV6update7entryID7dynamic6extrasSb7updated_AA05EntryG0VSg07removedkG0tAJ_AA0C0V10XestiTools6ExtrasVSgtF","fragments":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"kind":"identifier","text":"update"},{"kind":"text","text":"("},{"kind":"externalParam","text":"entryID"},{"kind":"text","text":": "},{"preciseIdentifier":"s:9IvorModel7EntryIDV","kind":"typeIdentifier","text":"EntryID"},{"kind":"text","text":", "},{"kind":"externalParam","text":"dynamic"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Dynamic","preciseIdentifier":"s:9IvorModel7DynamicV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"extras"},{"kind":"text","text":": "},{"preciseIdentifier":"s:10XestiTools6ExtrasV","kind":"typeIdentifier","text":"Extras"},{"kind":"text","text":"?) -> (updated"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"},{"text":", removedEntryID","kind":"text"},{"text":": ","kind":"text"},{"text":"EntryID","kind":"typeIdentifier","preciseIdentifier":"s:9Iv