/IvorModel\/documentation\/IvorModel\/DynamicMap"]]},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"@discardableResult","kind":"attribute"},{"text":" ","kind":"text"},{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"update","kind":"identifier"},{"text":"(","kind":"text"},{"text":"entryID","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"EntryID","kind":"typeIdentifier","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/EntryID","preciseIdentifier":"s:9IvorModel7EntryIDV"},{"text":", ","kind":"text"},{"text":"dynamic","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Dynamic","kind":"typeIdentifier","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/Dynamic","preciseIdentifier":"s:9IvorModel7DynamicV"},{"text":", ","kind":"text"},{"text":"extras","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Extras","kind":"typeIdentifier","preciseIdentifier":"s:10XestiTools6ExtrasV"},{"text":"? = nil) -> (updated","kind":"text"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":", removedEntryID","kind":"text"},{"text":": ","kind":"text"},{"text":"EntryID","kind":"typeIdentifier","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/EntryID","preciseIdentifier":"s:9IvorModel7EntryIDV"},{"text":"?)","kind":"text"}]}],"kind":"declarations"},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The identity of the entry to replace. An"},{"type":"text","text":" "},{"type":"text","text":"identity naming no entry is ignored."}]}],"name":"entryID"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The new dynamic level for the entry."}]}],"name":"dynamic"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The new optional extra data for the entry."},{"type":"text","text":" "},{"type":"text","text":"Defaults to "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}]}],"name":"extras"}],"kind":"parameters"},{"content":[{"type":"heading","anchor":"return-value","text":"Return Value","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A pair of "},{"type":"codeVoice","code":"updated"},{"type":"text","text":", "},{"type":"codeVoice","code":"true"},{"type":"text","text":" if "},{"type":"codeVoice","code":"entryID"},{"type":"text","text":" identified an"},{"type":"text","text":" "},{"type":"text","text":"entry and it was updated, "},{"type":"codeVoice","code":"false"},{"type":"text","text":" if "},{"type":"codeVoice","code":"entryID"},{"type":"text","text":" named no"},{"type":"text","text":" "},{"type":"text","text":"entry and nothing happened — and "},{"type":"codeVoice","code":"removedEntryID"},{"type":"text","text":", the"},{"type":"text","text":" "},{"type":"text","text":"identity of the pre-existing entry dropped because the"},{"type":"text","text":" "},{"type":"text","text":"edit collapsed into it (see above). "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" if "},{"type":"codeVoice","code":"updated"},{"type":"text","text":" "},{"type":"text","text":"is "},{"type":"codeVoice","code":"false"},{"type":"text","text":", or if it is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" but no such collision"},{"type":"text","text":" "},{"type":"text","text":"occurred."}]}],"kind":"content"},{"content":[{"type":"heading","anchor":"discussion","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Unlike a "},{"type":"reference","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/DynamicMap\/remove(entryID:)","isActive":true},{"type":"text","text":" followed by an "},{"type":"reference","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/DynamicMap\/insert(time:dynamic:extras:)","isActive":true},{"type":"text","text":", this"},{"type":"text","text":" "},{"type":"text","text":"keeps the entry’s identity and does not reorder entries. Reordering only matters when more"},{"type":"text","text":" "},{"type":"text","text":"than one entry shares a time: insertion always lands after every entry already at that"},{"type":"text","text":" "},{"type":"text","text":"time, so a remove-then-insert edit of one entry among ties silently changes the order of"},{"type":"text","text":" "},{"type":"text","text":"entries that were never touched. And — unlike a position — the identity keeps addressing"},{"type":"text","text":" "},{"type":"text","text":"this same entry across any other entry’s edit, so a caller never needs to re-resolve it"},{"type":"text","text":" "},{"type":"text","text":"first."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The edit can turn this entry into an exact duplicate of another one"},{"type":"text","text":" "},{"type":"text","text":"already at the same time — same time, dynamic level, and extras —"},{"type":"text","text":" "},{"type":"text","text":"the same combination "},{"type":"reference","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/DynamicMap\/insert(time:dynamic:extras:)","isActive":true},{"type":"text","text":" silently"},{"type":"text","text":" "},{"type":"text","text":"collapses. When that happens, "},{"type":"codeVoice","code":"entryID"},{"type":"text","text":" always keeps addressing the"},{"type":"text","text":" "},{"type":"text","text":"entry that was just updated; the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"other"}]},{"type":"text","text":", pre-existing entry is the"},{"type":"text","text":" "},{"type":"text","text":"one silently removed instead. That is the only choice consistent"},{"type":"text","text":" "},{"type":"text","text":"with the guarantee above: a caller invoking this method already"},{"type":"text","text":" "},{"type":"text","text":"holds "},{"type":"codeVoice","code":"entryID"},{"type":"text","text":" and goes on using it afterward, so honoring “this"},{"type":"text","text":" "},{"type":"text","text":"identity keeps addressing this same entry” means the entry it"},{"type":"text","text":" "},{"type":"text","text":"wasn’t referencing has to be the one that gives way, never the one"},{"type":"text","text":" "},{"type":"text","text":"it was."}]}],"kind":"content"}],"sections":[],"variants":[{"paths":["\/documentation\/ivormodel\/dynamicmap\/update(entryid:dynamic:extras:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://IvorModel/documentation/IvorModel/DynamicMap/insert(time:dynamic:extras:)":{"role":"symbol","kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"text":"insert","kind":"identifier"},{"kind":"text","text":"("},{"kind":"externalParam","text":"time"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"TimeType","preciseIdentifier":"s:9IvorModel10DynamicMapV8TimeTypexmfp"},{"text":", ","kind":"text"},{"text":"dynamic","kind":"externalParam"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Dynamic","preciseIdentifier":"s:9IvorModel7DynamicV"},{"text":", ","kind":"text"},{"text":"extras","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Extras","preciseIdentifier":"s:10XestiTools6ExtrasV","kind":"typeIdentifier"},{"text":"?) -> (entryID","kind":"text"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:9IvorModel7EntryIDV","text":"EntryID","kind":"typeIdentifier"},{"text":", inserted","kind":"text"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":")","kind":"text"}],"abstract":[{"type":"text","text":"Inserts a dynamic entry into this dynamic map at the given time."}],"url":"\/documentation\/ivormodel\/dynamicmap\/insert(time:dynamic:extras:)","title":"insert(time:dynamic:extras:)","conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms wh