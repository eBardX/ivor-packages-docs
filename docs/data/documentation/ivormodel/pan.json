{"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"type":"text","text":"A spatial pan position: the direction of a sound in 3-D space relative to"},{"type":"text","text":" "},{"type":"text","text":"the listener, expressed as a horizontal and a vertical "},{"type":"reference","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/Pan\/Angle","isActive":true},{"type":"text","text":" in degrees."}],"sections":[],"hierarchy":{"paths":[["doc:\/\/IvorModel\/documentation\/IvorModel"]]},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Pan"}],"platforms":["macOS"]}],"kind":"declarations"},{"mentions":["doc:\/\/IvorModel\/documentation\/IvorModel\/UsingIvorModel"],"kind":"mentions"},{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"The conventions follow MusicXML’s ","type":"text"},{"code":"pan","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"elevation","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"horizontal","type":"codeVoice"},{"type":"text","text":" — "},{"code":"0","type":"codeVoice"},{"type":"text","text":" is straight ahead, "},{"code":"-90","type":"codeVoice"},{"type":"text","text":" is hard left, "},{"code":"90","type":"codeVoice"},{"type":"text","text":" is hard"},{"type":"text","text":" "},{"type":"text","text":"right, and "},{"code":"180","type":"codeVoice"},{"type":"text","text":" is directly behind."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"vertical","type":"codeVoice"},{"text":" — ","type":"text"},{"code":"0","type":"codeVoice"},{"text":" is level with the listener, ","type":"text"},{"code":"90","type":"codeVoice"},{"text":" is directly above, and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"-90"},{"text":