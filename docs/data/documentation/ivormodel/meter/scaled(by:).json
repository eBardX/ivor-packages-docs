"paragraph","inlineContent":[{"type":"text","text":"For a factor "},{"inlineContent":[{"type":"text","text":"p"}],"type":"emphasis"},{"type":"text","text":"\/"},{"inlineContent":[{"type":"text","text":"q"}],"type":"emphasis"},{"type":"text","text":" in lowest terms, if "},{"inlineContent":[{"type":"text","text":"d"}],"type":"emphasis"},{"type":"text","text":"·"},{"inlineContent":[{"type":"text","text":"q"}],"type":"emphasis"},{"type":"text","text":"\/"},{"inlineContent":[{"type":"text","text":"p"}],"type":"emphasis"},{"type":"text","text":" is a whole number, the numerators are"},{"type":"text","text":" "},{"type":"text","text":"kept and that becomes the denominator: 3\/4 × 2 is 3\/2, and 6\/8 × 4\/3 is 6\/6. Otherwise,"},{"type":"text","text":" "},{"type":"text","text":"every numerator is multiplied by "},{"inlineContent":[{"type":"text","text":"p"}],"type":"emphasis"},{"type":"text","text":" and the denominator by "},{"inlineContent":[{"type":"text","text":"q"}],"type":"emphasis"},{"type":"text","text":": 3\/4 × 3\/2 is 9\/8, and"},{"type":"text","text":" "},{"type":"text","text":"2+2+3\/8 × 3\/2 is 6+6+9\/16. A simple-form meter stays simple, and a grouped one stays"},{"type":"text","text":" "},{"type":"text","text":"grouped. The pulse is re-derived by the usual rules, so it can change: 3\/4 ÷ 2 is 3\/8, felt"},{"type":"text","text":" "},{"type":"text","text":"in one. A free meter stays free."}]},{"content":[{"inlineContent":[{"type":"text","text":""},{"code":"factor","type":"codeVoice"},{"type":"text","text":" must be a positive rational number."}],"type":"paragraph"}],"type":"aside","name":"Precondition","style":"note"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"paths":["\/documentation\/ivormodel\/meter\/scaled(by:)"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/IvorModel\/documentation\/IvorModel\/Meter\/scaled(by:)","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/IvorModel\/documentation\/IvorMode