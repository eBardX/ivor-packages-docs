ontent":[{"text":"p","type":"text"}]},{"type":"text","text":" and the denominator by "},{"type":"emphasis","inlineContent":[{"type":"text","text":"q"}]},{"type":"text","text":": 3\/4 × 3\/2 is 9\/8, and"},{"type":"text","text":" "},{"type":"text","text":"2+2+3\/8 × 3\/2 is 6+6+9\/16. A simple-form meter stays simple, and a grouped one stays"},{"type":"text","text":" "},{"type":"text","text":"grouped. The pulse is re-derived by the usual rules, so it can change: 3\/4 ÷ 2 is 3\/8, felt"},{"type":"text","text":" "},{"type":"text","text":"in one. A free meter stays free."}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"factor"},{"type":"text","text":" must be a positive rational number."}]}],"style":"note","name":"Precondition","type":"aside"}],"kind":"content"}],"sections":[],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/IvorModel\/documentation\/IvorModel","doc:\/\/IvorModel\/documentation\/IvorModel\/Meter"]]},"metadata":{"modules":[{"name":"IvorModel"}],"title":"scaled(by:)","extendedModule":"IvorModel","symbolKind":"method","externalID":"s:9IvorModel5MeterV6scaled2byAC12XestiNumbers6NumberV_tF","role":"symbol","roleHeading":"Instance Method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"scaled"},{"kind":"text","text":"("},{"kind":"externalParam","text":"by"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Number","preciseIdentifier":"s:12XestiNumbers6NumberV"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Meter","preciseIdentifier":"s:9IvorModel5MeterV"}]},"abstract":[{"type":"text","text":"Returns this meter re-notated so that one bar is a given factor as long, as augmentation"},{"type":"text","text":" "},{"type":"text","text":"and diminution need."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormodel\/meter\/scaled(by:)"]}],"identifier":{"url":"doc:\/\/IvorModel\/documentation\/I