{"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"url":"doc:\/\/IvorModel\/documentation\/IvorModel\/MeterTable\/reverse(within:)","interfaceLanguage":"swift"},"sections":[],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/IvorModel\/documentation\/IvorModel","doc:\/\/IvorModel\/documentation\/IvorModel\/MeterTable"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reverse","kind":"identifier"},{"text":"(","kind":"text"},{"text":"within","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"beatTimeRange","kind":"internalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SN","text":"ClosedRange","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"identifier":"doc:\/\/IvorTiming\/documentation\/IvorTiming\/BeatTime","preciseIdentifier":"s:10IvorTiming8BeatTimeV","text":"BeatTime","kind":"typeIdentifier"},{"text":">)","kind":"text"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"parameters","parameters":[{"name":"beatTimeRange","content":[{"inlineContent":[{"type":"text","text":"The beat-time range to mirror the grid within."}],"type":"paragraph"}]}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"The grid within the range — clipped to start no earlier than the first entry — is cut into","type":"text"},{"text":" ","type":"text"},{"text":"pieces, one per bar (clipped to the range), each with its meter and the extras of the entry","type":"text"},{"text":" ","type":"text"},{"text":"that governs it. The pieces are mirrored within the range, and the entries in it are","type":"text"},{"text":" ","type":"text"},{"text":"replaced by one at the start of each mirrored piece, leaving out any that would be","type":"text"},{"text":" ","type":"text"},{"text":"redundant. Then:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Leftover → pickup:"}],"type":"strong"},{"text":" if the range starts at time 0 and the first mirrored piece is","type":"text"},{"text":" ","type":"text"},{"text":"shorter than its bar, it becomes the pickup.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"The grid after the range is kept:"}],"type":"strong"},{"text":" if the range’s upper bound wasn’t a barline, an","type":"text"},{"text":" ","type":"text"},{"text":"entry with the meter in effect there is inserted at it, and a restart at the first","type":"text"},{"text":" ","type":"text"},{"text":"barline after it, so that every later barline stays where it was. If it was a barline,","type":"text"},{"text":" ","type":"text"},{"text":"an entry with the meter in effect there is inserted at it, unless the reversed grid","type":"text"},{"text":" ","type":"text"},{"text":"already has a barline there with that meter.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"For example, bars of 3\/4 then 2\/4, reversed within 0…1 (the range ending 1\/4 into the 2\/4","type":"text"},{"text":" ","type":"text"},{"text":"bar), give 2\/4 at 0 with a pickup of 1\/4, then 3\/4 from 1\/4.","type":"text"}]}]}],"metadata":{"externalID":"s:9IvorModel10MeterTableV7reverse6withinySNy0A6Timing8BeatTimeVG_tF","title":"reverse(within:)","role":"symbol","modules":[{"name":"IvorModel"}],"extendedModule":"IvorModel","symbolKind":"method","roleHeading":"Instance Method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reverse","kind":"identifier"},{"text":"(","kind":"text"},{"text":"within","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ClosedRange","kind":"typeIdentifier","preciseIdentifier":"s:SN"},{"text":"<","kind":"text"},{"text":"BeatTime","kind":"typeIdentifier","preciseIdentifier":"s:10IvorTiming8BeatTimeV"},{"text":">)","kind":"text"}]},"abstract":[{"type":"text","text":"Reverses the grid of this meter table within a beat-time range, mirroring its bars as the"},{"type":"text","text":" "},{"type":"text","text":"music in that range is mirrored."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormodel\/metertable\/reverse(within:)"]}],"references":{"doc://IvorModel/documentation/IvorModel/MeterTable":{"navigatorTitle":[{"text":"MeterTable","kind":"identifier"}],"identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/MeterTable","abstract":[{"type":"text","text":"A beat-time table of meters: where each meter takes effect, and the pickup before the first"},{"type":"text","text":" "},{"type":"text","text":"full bar."}],"title":"MeterTable","type":"topic","kind":"symbol","url":"\/documentation\/ivormodel\/metertable","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"MeterTable","kind":"identifier"}]},"doc://IvorModel/documentation/IvorModel":{"identifier":"doc:\/\/IvorModel\/documentation\/IvorModel","abstract":[{"type":"text","text":"A representation-agnostic musical composition model."}],"title":"IvorModel","type":"topic","kind":"symbol","url":"\/documentation\/ivormodel","role":"collection"},"doc://IvorTiming/documentation/IvorTiming/BeatTime":{"url":"\/documentation\/ivortiming\/beattime","title":"BeatTime","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BeatTime","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"BeatTime","kind":"identifier"}],"abstract":[{"type":"text","text":"A point in musical beat time, measured in whole notes from time zero."}],"type":"topic","identifier":"doc:\/\/IvorTiming\/documentation\/IvorTiming\/BeatTime"},"doc://IvorModel/documentation/IvorModel/MeterTable/reverse(within:)":{"role":"symbol","type":"topic","url":"\/documentation\/ivormodel\/metertable\/reverse(within:)","title":"reverse(within:)","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"reverse"},{"kind":"text","text":"("},{"kind":"externalParam","text":"within"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SN","text":"ClosedRange"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:10IvorTiming8BeatTimeV","text":"BeatTime"},{"kind":"text","text":">)"}],"abstract":[{"type":"text","text":"Reverses the grid of this meter table within a beat-time range, mirroring its bars as the"},{"type":"text","text":" "},{"type":"text","text":"music in that range is mirrored."}],"identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/MeterTable\/reverse(within:)"}}}