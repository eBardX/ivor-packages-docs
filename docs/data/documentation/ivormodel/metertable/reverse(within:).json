{"metadata":{"roleHeading":"Instance Method","role":"symbol","title":"reverse(within:)","symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"reverse"},{"kind":"text","text":"("},{"kind":"externalParam","text":"within"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"ClosedRange","preciseIdentifier":"s:SN"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"BeatTime","preciseIdentifier":"s:10IvorTiming8BeatTimeV"},{"kind":"text","text":">)"}],"modules":[{"name":"IvorModel"}],"extendedModule":"IvorModel","externalID":"s:9IvorModel10MeterTableV7reverse6withinySNy0A6Timing8BeatTimeVG_tF"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"mutating"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"reverse"},{"kind":"text","text":"("},{"kind":"externalParam","text":"within"},{"kind":"text","text":" "},{"kind":"internalParam","text":"beatTimeRange"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SN","kind":"typeIdentifier","text":"ClosedRange"},{"kind":"text","text":"<"},{"identifier":"doc:\/\/IvorTiming\/documentation\/IvorTiming\/BeatTime","preciseIdentifier":"s:10IvorTiming8BeatTimeV","kind":"typeIdentifier","text":"BeatTime"},{"kind":"text","text":">)"}],"languages":["swift"],"platforms":["macOS"]}]},{"parameters":[{"name":"beatTimeRange","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The beat-time range to mirror the grid within."}]}]}],"kind":"parameters"},{"content":[{"anchor":"discussion","text":"Discussion","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The grid within the range — clipped to start no earlier than the first entry — is cut into"},{"type":"text","text":" "},{"type":"text","text":"pieces, one per bar (clipped to the range), each with its meter and the extras of the entry"},{"type":"text","text":" "},{"type":"text","text":"that governs it. The pieces are mirrored within the range, and the entries in it are"},{"type":"text","text":" "},{"type":"text","text":"replaced by one at the start of each mirrored piece, leaving out any that would be"},{"text":" ","type":"text"},{"text":"redundant. Then:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Leftover → pickup:","type":"text"}],"type":"strong"},{"text":" if the range starts at time 0 and the first mirrored piece is","type":"text"},{"text":" ","type":"text"},{"text":"shorter than its bar, it becomes the pickup.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"The grid after the range is kept:","type":"text"}],"type":"strong"},{"text":" if the range’s upper bound wasn’t a barline, an","type":"text"},{"text":" ","type":"text"},{"text":"entry with the meter in effect there is inserted at it, and a restart at the first","type":"text"},{"text":" ","type":"text"},{"text":"barline after it, so that every later barline stays where it was. If it was a barline,","type":"text"},{"text":" ","type":"text"},{"text":"an entry with the meter in effect there is inserted at it, unless the reversed grid","type":"text"},{"text":" ","type":"text"},{"text":"already has a barline there with that meter.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"For example, bars of 3\/4 then 2\/4, reversed within 0…1 (the range ending 1\/4 into the 2\/4","type":"text"},{"text":" ","type":"text"},{"text":"bar), give 2\/4 at 0 with a pickup of 1\/4, then 3\/4 from 1\/4.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/ivormodel\/metertable\/reverse(within:)"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/IvorModel\/documentation\/IvorModel","doc:\/\/IvorModel\/documentation\/IvorModel\/MeterTable"]]},"sections":[],"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorModel\/documentation\/IvorModel\/MeterTable\/reverse(within:)"},"abstract":[{"type":"text","text":"Reverses the grid of this meter table within a beat-time range, mirroring its bars as the"},{"type":"text","text":" "},{"type":"text","text":"music in that range is mirrored."}],"references":{"doc://IvorModel/documentation/IvorModel":{"title":"IvorModel","role":"collection","type":"topic","url":"\/documentation\/ivormodel","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel","kind":"symbol","abstract":[{"type":"text","text":"A representation-agnostic musical composition model."}]},"doc://IvorTiming/documentation/IvorTiming/BeatTime":{"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"BeatTime"}],"type":"topic","identifier":"doc:\/\/IvorTiming\/documentation\/IvorTiming\/BeatTime","title":"BeatTime","abstract":[{"text":"A point in musical beat time, measured in whole notes from time zero.","type":"text"}],"url":"\/documentation\/ivortiming\/beattime","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"BeatTime"}],"kind":"symbol"},"doc://IvorModel/documentation/IvorModel/MeterTable/reverse(within:)":{"url":"\/documentation\/ivormodel\/metertable\/reverse(within:)","abstract":[{"text":"Reverses the grid of this meter table within a beat-time range, mirroring its bars as the","type":"text"},{"text":" ","type":"text"},{"text":"music in that range is mirrored.","type":"text"}],"type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"reverse"},{"kind":"text","text":"("},{"kind":"externalParam","text":"within"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"ClosedRange","preciseIdentifier":"s:SN"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"BeatTime","preciseIdentifier":"s:10IvorTiming8BeatTimeV"},{"kind":"text","text":">)"}],"kind":"symbol","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/MeterTable\/reverse(within:)","title":"reverse(within:)","role":"symbol"},"doc://IvorModel/documentation/IvorModel/MeterTable":{"url":"\/documentation\/ivormodel\/metertable","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MeterTable","kind":"identifier"}],"type":"topic","title":"MeterTable","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"MeterTable","kind":"identifier"}],"identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/MeterTable","abstract":[{"text":"A beat-time table of meters: where each meter takes effect, and the pickup before the first","type":"text"},{"text":" ","type":"text"},{"text":"full bar.","type":"text"}]}}}