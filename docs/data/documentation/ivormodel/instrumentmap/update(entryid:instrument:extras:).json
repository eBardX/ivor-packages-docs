{"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"symbol","sections":[],"hierarchy":{"paths":[["doc:\/\/IvorModel\/documentation\/IvorModel","doc:\/\/IvorModel\/documentation\/IvorModel\/InstrumentMap"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormodel\/instrumentmap\/update(entryid:instrument:extras:)"]}],"abstract":[{"type":"text","text":"Replaces the instrument entry with the given identity, in place."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"attribute","text":"@discardableResult"},{"kind":"text","text":" "},{"kind":"keyword","text":"mutating"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"update"},{"kind":"text","text":"("},{"kind":"externalParam","text":"entryID"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"EntryID","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/EntryID","preciseIdentifier":"s:9IvorModel7EntryIDV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"instrument"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Instrument","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/Instrument","preciseIdentifier":"s:9IvorModel10InstrumentV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"extras"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Extras","preciseIdentifier":"s:10XestiTools6ExtrasV"},{"kind":"text","text":"? = nil) -> (updated"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":", removedEntryID"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"EntryID","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/EntryID","preciseIdentifier":"s:9IvorModel7EntryIDV"},{"kind":"text","text":"?)"}]}]},{"parameters":[{"name":"entryID","content":[{"type":"paragraph","inlineContent":[{"text":"The identity of the entry to replace. An","type":"text"},{"text":" ","type":"text"},{"text":"identity naming no entry is ignored.","type":"text"}]}]},{"name":"instrument","content":[{"type":"paragraph","inlineContent":[{"text":"The new instrument for the entry.","type":"text"}]}]},{"name":"extras","content":[{"type":"paragraph","inlineContent":[{"text":"The new optional extra data for the entry.","type":"text"},{"text":" ","type":"text"},{"text":"Defaults to ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":".","type":"text"}]}]}],"kind":"parameters"},{"content":[{"type":"heading","text":"Return Value","anchor":"return-value","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A pair of "},{"type":"codeVoice","code":"updated"},{"type":"text","text":", "},{"type":"codeVoice","code":"true"},{"type":"text","text":" if "},{"type":"codeVoice","code":"entryID"},{"type":"text","text":" identified an"},{"type":"text","text":" "},{"type":"text","text":"entry and it was updated, "},{"type":"codeVoice","code":"false"},{"type":"text","text":" if "},{"type":"codeVoice","code":"entryID"},{"type":"text","text":" named no"},{"type":"text","text":" "},{"type":"text","text":"entry and nothing happened — and "},{"type":"codeVoice","code":"removedEntryID"},{"type":"text","text":", the"},{"type":"text","text":" "},{"type":"text","text":"identity of the pre-existing entry dropped because the"},{"type":"text","text":" "},{"type":"text","text":"edit collapsed into it (see above). "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" if "},{"type":"codeVoice","code":"updated"},{"type":"text","text":" "},{"type":"text","text":"is "},{"type":"codeVoice","code":"false"},{"type":"text","text":", or if it is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" but no such collision"},{"type":"text","text":" "},{"type":"text","text":"occurred."}]}],"kind":"content"},{"content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Unlike a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/InstrumentMap\/remove(entryID:)"},{"type":"text","text":" followed by an "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/InstrumentMap\/insert(time:instrument:extras:)"},{"type":"text","text":", this"},{"type":"text","text":" "},{"type":"text","text":"keeps the entry’s identity and does not reorder entries. Reordering only matters when more"},{"type":"text","text":" "},{"type":"text","text":"than one entry shares a time: insertion always lands after every entry already at that"},{"type":"text","text":" "},{"type":"text","text":"time, so a remove-then-insert edit of one entry among ties silently changes the order of"},{"type":"text","text":" "},{"type":"text","text":"entries that were never touched. And — unlike a position — the identity keeps addressing"},{"type":"text","text":" "},{"type":"text","text":"this same entry across any other entry’s edit, so a caller never needs to re-resolve it"},{"type":"text","text":" "},{"type":"text","text":"first."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The edit can turn this entry into an exact duplicate of another one"},{"type":"text","text":" "},{"type":"text","text":"already at the same time — same time, instrument, and extras — the"},{"type":"text","text":" "},{"type":"text","text":"same combination "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/InstrumentMap\/insert(time:instrument:extras:)"},{"type":"text","text":" silently"},{"type":"text","text":" "},{"type":"text","text":"collapses. When that happens, "},{"type":"codeVoice","code":"entryID"},{"type":"text","text":" always keeps addressing the"},{"type":"text","text":" "},{"type":"text","text":"entry that was just updated; the "},{"type":"emphasis","inlineContent":[{"text":"other","type":"text"}]},{"type":"text","text":", pre-existing entry is the"},{"type":"text","text":" "},{"type":"text","text":"one silently removed instead. That is the only choice consistent"},{"type":"text","text":" "},{"type":"text","text":"with the guarantee above: a caller invoking this method already"},{"type":"text","text":" "},{"type":"text","text":"holds "},{"type":"codeVoice","code":"entryID"},{"type":"text","text":" and goes on using it afterward, so honoring “this"},{"type":"text","text":" "},{"type":"text","text":"identity keeps addressing this same entry” means the entry it"},{"type":"text","text":" "},{"type":"text","text":"wasn’t referencing has to be the one that gives way, never the one"},{"type":"text","text":" "},{"type":"text","text":"it was."}]}],"kind":"content"}],"identifier":{"url":"doc:\/\/IvorModel\/documentation\/IvorModel\/InstrumentMap\/update(entryID:instrument:extras:)","interfaceLanguage":"swift"},"metadata":{"role":"symbol","roleHeading":"Instance Method","symbolKind":"method","modules":[{"name":"IvorModel"}],"externalID":"s:9IvorModel13InstrumentMapV6update7entryID10instrument6extrasSb7updated_AA05EntryG0VSg07removedkG0tAJ_AA0C0V10XestiTools6ExtrasVSgtF","conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"type":"codeVoice","code":"TimeType"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"TimeProtocol"},{"type":"text","text":"."}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]},"extendedModule":"IvorModel","title":"update(entryID:instrument:extras:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"update","kind":"identifier"},{"text":"(","kind":"text"},{"text":"entryID","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"EntryID","kind":"typeIdentifier","preciseIdentifier":"s:9IvorModel7EntryIDV"},{"text":", ","kind":"text"},{"text":"instrument","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Instrument","kind