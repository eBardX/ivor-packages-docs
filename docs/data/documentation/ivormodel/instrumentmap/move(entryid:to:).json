{"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","sections":[],"hierarchy":{"paths":[["doc:\/\/IvorModel\/documentation\/IvorModel","doc:\/\/IvorModel\/documentation\/IvorModel\/InstrumentMap"]]},"variants":[{"paths":["\/documentation\/ivormodel\/instrumentmap\/move(entryid:to:)"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"Moves the instrument entry with the given identity to a new time,"},{"type":"text","text":" "},{"type":"text","text":"keeping its instrument and extras, and re-sorts it into place."}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"@discardableResult","kind":"attribute"},{"text":" ","kind":"text"},{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"move","kind":"identifier"},{"text":"(","kind":"text"},{"text":"entryID","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:9IvorModel7EntryIDV","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/EntryID","text":"EntryID","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"to","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"time","kind":"internalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:9IvorModel13InstrumentMapV8TimeTypexmfp","text":"TimeType","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:9IvorModel7EntryIDV","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/EntryID","text":"EntryID","kind":"typeIdentifier"},{"text":"?","kind":"text"}]}],"kind":"declarations"},{"parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The identity of the entry to move."}],"type":"paragraph"}],"name":"entryID"},{"content":[{"inlineContent":[{"type":"text","text":"The new time for the entry."}],"type":"paragraph"}],"name":"time"}],"kind":"parameters"},{"content":[{"type":"heading","anchor":"return-value","text":"Return Value","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The identity that now addresses this entry’s content — "},{"type":"codeVoice","code":"entryID"},{"type":"text","text":" "},{"type":"text","text":"itself, unless the move merged it into a pre-existing exact"},{"type":"text","text":" "},{"type":"text","text":"duplicate, in which case the survivor’s identity. "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" if"},{"type":"text","text":" "},{"type":"codeVoice","code":"entryID"},{"type":"text","text":" did not identify any entry and nothing moved."}]}],"kind":"content"},{"content":[{"type":"heading","anchor":"discussion","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Unlike "},{"type":"reference","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/InstrumentMap\/update(entryID:instrument:extras:)","isActive":true},{"type":"text","text":", this is expected to"},{"type":"text","text":" "},{"type":"text","text":"reorder entries — that is the point of editing the time itself. Two"},{"type":"text","text":" "},{"type":"text","text":"entries legitimately ending up at the same time (see"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/InstrumentMap\/insert(time:instrument:extras:)","isActive":true},{"type":"text","text":" for the discontinuity use case)"},{"type":"text","text":" "},{"type":"text","text":"is not treated as a collision to reject; the moved entry simply"},{"type":"text","text":" "},{"type":"text","text":"takes its place among any others already there, exactly as a fresh"},{"type":"text","text":" "},{"type":"text","text":"insertion would."}]},{"inlineContent":[{"type":"text","text":"The one case where "},{"type":"codeVoice","code":"entryID"},{"type":"text","text":" stops identifying the moved entry afterward is"},{"type":"text","text":" "},{"type":"text","text":"when the move lands it exactly on top of another entry already"},{"type":"text","text":" "},{"type":"text","text":"present — same time, instrument, and extras — the same"},{"type":"text","text":" "},{"type":"text","text":"exact-duplicate case "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/InstrumentMap\/insert(time:instrument:extras:)"},{"type":"text","text":" silently"},{"type":"text","text":" "},{"type":"text","text":"collapses. There, the moved entry merges into that pre-existing one"},{"type":"text","text":" "},{"type":"text","text":"instead of being kept separately, so "},{"type":"codeVoice","code":"entryID"},{"type":"text","text":" no longer names anything in"},{"type":"text","text":" "},{"type":"text","text":"the map; the returned identity is the survivor’s instead, which a"},{"type":"text","text":" "},{"type":"text","text":"caller must switch to addressing from then on."}],"type":"paragraph"}],"kind":"content"}],"identifier":{"url":"doc:\/\/IvorModel\/documentation\/IvorModel\/InstrumentMap\/move(entryID:to:)","interfaceLanguage":"swift"},"metadata":{"role":"symbol","roleHeading":"Instance Method","symbolKind":"method","modules":[{"name":"IvorModel"}],"externalID":"s:9IvorModel13InstrumentMapV4move7entryID2toAA05EntryG0VSgAH_xtF","conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"type":"codeVoice","code":"TimeType"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"TimeProtocol"},{"type":"text","text":"."}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]},"title":"move(entryID:to:)","extendedModule":"IvorModel","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"move","kind":"identifier"},{"text":"(","kind":"text"},{"text":"entryID","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"EntryID","preciseIdentifier":"s:9IvorModel7EntryIDV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": ","kind":"te