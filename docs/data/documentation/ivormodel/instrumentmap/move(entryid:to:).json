g in","type":"text"},{"text":" ","type":"text"},{"text":"the map; the returned identity is the survivor’s instead, which a","type":"text"},{"text":" ","type":"text"},{"text":"caller must switch to addressing from then on.","type":"text"}]}],"kind":"content"}],"references":{"doc://IvorModel/documentation/IvorModel/InstrumentMap/move(entryID:to:)":{"abstract":[{"type":"text","text":"Moves the instrument entry with the given identity to a new time,"},{"type":"text","text":" "},{"type":"text","text":"keeping its instrument and extras, and re-sorts it into place."}],"type":"topic","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/InstrumentMap\/move(entryID:to:)","kind":"symbol","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"move","kind":"identifier"},{"text":"(","kind":"text"},{"text":"entryID","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:9IvorModel7EntryIDV","text":"EntryID","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:9IvorModel13InstrumentMapV8TimeTypexmfp","text":"TimeType","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:9IvorModel7EntryIDV","text":"EntryID","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"conformance":{"constraints":[{"type":"codeVoice","code":"TimeType"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"TimeProtocol"},{"type":"text","text":"."}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"availabilityPrefix":[{"type":"text","text":"Available when"}]},"url":"\/documentation\/ivormodel\/instrumentmap\/move(entryid:to:)","title":"move(entryID:to:)"},"doc://IvorModel/documentation/IvorModel/InstrumentMap":{"type":"topic","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/InstrumentMap","abstract":[{"text":"A time-indexed map of instrument designations with a configurable default.","type":