 inserted in a wall work — and"},{"type":"text","text":" "},{"type":"text","text":"then removes them (see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/Work\/rendered(options:)"},{"type":"text","text":")."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Always permitted, even on a locked work: this returns an independent copy rather than"},{"type":"text","text":" "},{"type":"text","text":"mutating "},{"code":"self","type":"codeVoice"},{"type":"text","text":", so "},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/Work\/isLocked"},{"type":"text","text":" does not apply."}],"type":"paragraph"},{"type":"aside","style":"note","name":"Throws","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"isActive":true,"identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/Work\/Error\/unsupportedPitchConversion(from:to:)","type":"reference"},{"text":" if converting this work’s","type":"text"},{"text":" ","type":"text"},{"text":"pitch notation to ","type":"text"},{"code":"pitchNotation","type":"codeVoice"},{"text":" is not supported;","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/Work\/Error\/unsupportedStandardConversion","type":"reference"},{"text":" if the context’s tuning system","type":"text"},{"text":" ","type":"text"},{"text":"does not support standard pitch notation and the conversion requires it;","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/Work\/Error\/invalidKeyboardLayout(_:)","type":"reference"},{"text":" if the context’s keyboard layout can’t","type":"text"},{"text":" ","type":"text"},{"text":"be used for the conversion or is invalid in the context’s tuning system;","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/Work