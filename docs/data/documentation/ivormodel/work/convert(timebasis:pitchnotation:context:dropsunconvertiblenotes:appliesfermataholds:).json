:"text"},{"code":"false","type":"codeVoice"},{"text":".","type":"text"}]}]}],"kind":"parameters"},{"kind":"content","content":[{"anchor":"return-value","type":"heading","text":"Return Value","level":2},{"inlineContent":[{"type":"text","text":"The converted work, or "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" if this work already has "},{"code":"timeBasis","type":"codeVoice"},{"type":"text","text":" and"},{"type":"text","text":" "},{"code":"pitchNotation","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"kind":"mentions","mentions":["doc:\/\/IvorModel\/documentation\/IvorModel\/UsingIvorModel"]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"inlineContent":[{"type":"text","text":"Like "},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/Work\/warped(appliesFermataHolds:)"},{"type":"text","text":", the new work has a fresh "},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/Work\/workID"},{"type":"text","text":", is unlocked, and keeps this"},{"type":"text","text":" "},{"type":"text","text":"work’s "},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/Work\/name"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/Work\/smpteStartTime"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/Work\/info-swift.property"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/Work\/extras"},{"type":"text","text":","},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/Work\/interpretationRules"},{"type":"text","text":" and "},{"isActive":true,"type":"reference","identifier":