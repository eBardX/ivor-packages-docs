e-Methods"},{"title":"Enumerations","identifiers":["doc:\/\/IvorModel\/documentation\/IvorModel\/MeterTable\/Error"],"generated":true,"anchor":"Enumerations"},{"generated":true,"identifiers":["doc:\/\/IvorModel\/documentation\/IvorModel\/MeterTable\/BidirectionalCollection-Implementations","doc:\/\/IvorModel\/documentation\/IvorModel\/MeterTable\/Collection-Implementations","doc:\/\/IvorModel\/documentation\/IvorModel\/MeterTable\/Decodable-Implementations","doc:\/\/IvorModel\/documentation\/IvorModel\/MeterTable\/Encodable-Implementations","doc:\/\/IvorModel\/documentation\/IvorModel\/MeterTable\/Equatable-Implementations","doc:\/\/IvorModel\/documentation\/IvorModel\/MeterTable\/Hashable-Implementations","doc:\/\/IvorModel\/documentation\/IvorModel\/MeterTable\/RandomAccessCollection-Implementations","doc:\/\/IvorModel\/documentation\/IvorModel\/MeterTable\/Sequence-Implementations"],"anchor":"Default-Implementations","title":"Default Implementations"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormodel\/metertable"]}],"hierarchy":{"paths":[["doc:\/\/IvorModel\/documentation\/IvorModel"]]},"identifier":{"url":"doc:\/\/IvorModel\/documentation\/IvorModel\/MeterTable","interfaceLanguage":"swift"},"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","metadata":{"title":"MeterTable","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MeterTable"}],"symbolKind":"struct","externalID":"s:9IvorModel10MeterTableV","roleHeading":"Structure","modules":[{"name":"IvorModel"}],"role":"symbol","navigatorTitle":[{"text":"MeterTable","kind":"identifier"}]},"abstract":[{"type":"text","text":"A beat-time table of meters: where each meter takes effect, and the pickup before the first"},{"type":"text","text":" "},{"type":"text","text":"full bar."}],"seeAlsoSections":[{"title":"Meters","identifiers":["doc:\/\/IvorModel\/documentation\/IvorModel\/Meter"],"generated":true,"anchor":"Meters"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MeterTable","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"mentions","mentions":["doc:\/\/IvorModel\/documentation\/IvorModel\/UsingIvorModel"]},{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"Each entry starts a new bar with its ","type":"text"},{"identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/Meter","isActive":true,"type":"reference"},{"text":". Bars of that meter follow one another until the","type":"text"},{"text":" ","type":"text"},{"text":"next entry; if the bar that the next entry falls in is cut off before it reaches its full","type":"text"},{"text":" ","type":"text"},{"text":"length, it’s a ","type":"text"},{"inlineContent":[{"text":"short bar","type":"text"}],"type":"emphasis"},{"text":". An entry with the same meter as the one before it, which doesn’t","type":"text"},{"text":" ","type":"text"},{"text":"fall on a barline the earlier entry would have drawn anyway, is a ","type":"text"},{"inlineContent":[{"type":"text","text":"restart"}],"type":"emphasis"},{"text":": it exists to make","type":"text"},{"text":" ","type":"text"},{"text":"the bar before it short. A free meter’s whole span, up to the next entry, is one bar with no","type":"text"},{"text":" ","type":"text"},{"text":"pulse. Before the first entry there are no bars.","type":"text"}]},{"inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/MeterTable\/pickup","isActive":true},{"text":" is the length of an opening part-bar, ","type":"text"},{"inlineContent":[{"text":"bar 0","type":"text"}],"type":"emphasis"},{"text":", when the first entry is a metered","type":"text"},{"text":" ","type":"text"},{"text":"meter at time 0. Its beats are counted as the tail of a full bar: a one-beat pickup in 3\/4 is","type":"text"},{"text":" ","type":"text"},{"text":"beat 3. Bars are numbered from 1, starting after the pickup, and every later bar — short or","type":"text"},{"text":" ","type":"text"},{"text":"free — adds 1.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Unlike the parameter maps, a meter table never interpolates, and unlike the other tables, it"},{"type":"text","text":" "},{"type":"text","text":"lives on the work, not on a part, and only in beat time. Its invariants hold after every"},{"type":"text","text":" "},{"type":"text","text":"mutating method, and decoding rejects a table that breaks them:"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"There’s at most one entry per beat time."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The pickup is 0 unless there’s an entry at time 0 with a metered meter.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The pickup is shorter than that meter’s bar length, and ends no later than the second","type":"text"},{"text":" ","type":"text"},{"text":"entry, if there is one.","type":"text"}],"type":"paragraph"}]}]}]}],"relationshipsSections":[{"identifiers":["doc:\/\/IvorModel\/SK","doc:\/\/IvorModel\/Sl","doc:\/\/IvorModel\/s8CopyableP","doc:\/\/IvorModel\/Se","doc:\/\/IvorModel\/SE","doc:\/\/IvorModel\/SQ","doc:\/\/IvorModel\/s9EscapableP","doc:\/\/IvorModel\/SH","doc:\/\/IvorModel\/Sk","doc:\/\/IvorModel\/s8SendableP","doc:\/\/IvorModel\/s16SendableMetatypeP","doc:\/\/IvorModel\/ST"],"type":"conformsTo","kind":"relationships","title":"Conforms To"}],"references":{"doc://IvorModel/SQ":{"identifier":"doc:\/\/IvorModel\/SQ","title":"Swift.Equatable","type":"unresolvable"},"doc://IvorModel/SH":{"identifier":"doc:\/\/IvorModel\/SH","title":"Swift.Hashable","type":"unresolvable"},"doc://IvorModel/s16SendableMetatypeP":{"title":"Swift.S