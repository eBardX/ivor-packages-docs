nt":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each entry starts a new bar with its "},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/Meter"},{"text":". Bars of that meter follow one another until the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"next entry; if the bar that the next entry falls in is cut off before it reaches its full"},{"type":"text","text":" "},{"type":"text","text":"length, it’s a "},{"type":"emphasis","inlineContent":[{"text":"short bar","type":"text"}]},{"type":"text","text":". An entry with the same meter as the one before it, which doesn’t"},{"type":"text","text":" "},{"type":"text","text":"fall on a barline the earlier entry would have drawn anyway, is a "},{"type":"emphasis","inlineContent":[{"text":"restart","type":"text"}]},{"type":"text","text":": it exists to make"},{"type":"text","text":" "},{"type":"text","text":"the bar before it short. A free meter’s whole span, up to the next entry, is one bar with no"},{"type":"text","text":" "},{"type":"text","text":"pulse. Before the first entry there are no bars."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/MeterTable\/pickup"},{"text":" is the length of an opening part-bar, ","type":"text"},{"inlineContent":[{"text":"bar 0","type":"text"}],"type":"emphasis"},{"text":", when the first entry is a metered","type":"text"},{"text":" ","type":"text"},{"text":"meter at time 0. Its beats are counted as the tail of a full bar: a one-beat pickup in 3\/4 is","type":"text"},{"text":" ","type":"text"},{"text":"beat 3. Bars are numbered from 1, starting after the pickup, and every later bar — short or","type":"text"},{"text":" ","type":"text"},{"text":"free — adds 1.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Unlike the parameter maps, a meter table never interpolates, and unlike the other tables, it"},{"type":"text","text":" "},{"type":"text","text":"lives on the work, not on a part, and only in beat time. Its invariants hold after every"},{"type":"text","text":" "},{"type":"text","text":"mutating method, and decoding rejects a table that breaks them:"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"text":"There’s at most one entry per beat time.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The pickup is 0 unless there’s an entry at time 0 with a metered meter.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The pickup is shorter than that meter’s bar length, and ends no later than the second","type":"text"},{"text":" ","type":"text"},{"text":"entry, if there is one.","type":"text"}],"type":"paragraph"}]}]}],"kind":"content"}],"metadata":{"modules":[{"name":"IvorModel"}],"roleHeading":"Structure","role":"symbol","navigatorTitle":[{"text":"MeterTable","kind":"identifier"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MeterTable"}],"title":"MeterTable","externalID":"s:9IvorModel10MeterTableV","symbolKind":"struct"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormodel\/metertable"]}],"seeAlsoSections":[{"identifiers":["doc:\/\/IvorModel\/documentation\/IvorModel\/Meter"],"title":"Meters","generated":true,"anchor":"Meters"}],"abstract":[{"text":"A beat-time table of meters: where each meter takes effect, and the pickup before the first","type":"text"},{"text":" ","type":"text"},{"text":"full bar.","type":"text"}],"references":{"doc://IvorModel/Sl":{"identifier":"doc:\/\/IvorModel\/Sl","title":"Swift.Collection","type":"unresolvable"},"doc://IvorModel/documentation/IvorModel/Meter":{"navigatorTitle":[{"text":"Meter","kind":"identifier"}],"type":"topic","kind":"symbol","fragments":[{"text":"stru