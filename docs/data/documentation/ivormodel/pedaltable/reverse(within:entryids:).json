{"abstract":[{"type":"text","text":"Reverses the order of entries within a time range."}],"metadata":{"conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"constraints":[{"code":"TimeType","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"TimeProtocol","type":"codeVoice"},{"text":".","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}]},"extendedModule":"IvorModel","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"reverse"},{"kind":"text","text":"("},{"kind":"externalParam","text":"within"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SN","kind":"typeIdentifier","text":"ClosedRange"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:9IvorModel10PedalTableV8TimeTypexmfp","kind":"typeIdentifier","text":"TimeType"},{"kind":"text","text":">?, "},{"kind":"externalParam","text":"entryIDs"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sh","kind":"typeIdentifier","text":"Set"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:9IvorModel7EntryIDV","kind":"typeIdentifier","text":"EntryID"},{"kind":"text","text":">?) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"preciseIdentifier":"s:9IvorModel10PedalTableV5ErrorO","kind":"typeIdentifier","text":"Error"},{"kind":"text","text":")"}],"externalID":"s:9IvorModel10PedalTableV7reverse6within8entryIDsySNyxGSg_ShyAA7EntryIDVGSgtAC5ErrorOyx_GYKF","roleHeading":"Instance Method","modules":[{"name":"IvorModel"}],"role":"symbol","symbolKind":"method","title":"reverse(within:entryIDs:)"},"variants":[{"paths":["\/documentation\/ivormodel\/pedaltable\/reverse(within:entryids:)"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/IvorModel\/documentation\/IvorModel\/PedalTable\/reverse(within:entryIDs:)","interfaceLanguage":"swift"},"sections":[],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"mutating"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"reverse"},{"kind":"text","text":"("},{"kind":"externalParam","text":"within"},{"kind":"text","text":" "},{"kind":"internalParam","text":"timeRange"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"ClosedRange","preciseIdentifier":"s:SN"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"TimeType","preciseIdentifier":"s:9IvorModel10PedalTableV8TimeTypexmfp"},{"kind":"text","text":">? = nil, "},{"kind":"externalParam","text":"entryIDs"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Set","preciseIdentifier":"s:Sh"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"EntryID","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/EntryID","preciseIdentifier":"s:9IvorModel7EntryIDV"},{"kind":"text","text":">? = nil) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Error","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/PedalTable\/Error","preciseIdentifier":"s:9IvorModel10PedalTableV5ErrorO"},{"kind":"text","text":")"}]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"timeRange","content":[{"inlineContent":[{"type":"text","text":"The time range to mirror entry times around. "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" resolves to the"},{"type":"text","text":" "},{"type":"text","text":"table’s own time range, or — when "},{"code":"entryIDs","type":"codeVoice"},{"type":"text","text":" is non-"},{"code":"nil","type":"codeVoice"},{"type":"text","text":" — the"},{"type":"text","text":" "},{"type":"text","text":"selected entries’ own time range."}],"type":"paragraph"}]},{"name":"entryIDs","content":[{"inlineContent":[{"type":"text","text":"The identities of the entries to reverse, or "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" to reverse every"},{"type":"text","text":" "},{"type":"text","text":"entry in the table."}],"type":"paragraph"}]}]},{"content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"Each entry is a step: its level holds until the next entry. So reversing mirrors the","type":"text"},{"text":" ","type":"text"},{"text":"stretch each selected entry governs — up to the next selected entry, or to the range’s","type":"text"},{"text":" ","type":"text"},{"text":"upper bound — and moves the entry to that stretch’s new start. Down at 0 and Up at 4,","type":"text"},{"text":" ","type":"text"},{"text":"reversed within 0…8, gives Up at 0 and Down at 4. The stretch before the first selected","type":"text"},{"text":" ","type":"text"},{"text":"entry, which holds the level in effect before it (","type":"text"},{"isActive":true,"identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/Pedal\/Level\/up","type":"reference"},{"text":" unless an","type":"text"},{"text":" ","type":"text"},{"text":"unselected entry precedes it), moves to the end of the range, and a new entry begins it","type":"text"},{"text":" ","type":"text"},{"text":"there. Entries that share a time swap order, so a re-pedal (Up then Down at one time)","type":"text"},{"text":" ","type":"text"},{"text":"stays Up then Down at its mirrored time. The level after the range isn’t restored, just as","type":"text"},{"text":" ","type":"text"},{"text":"the interpolating maps don’t restore their values after it.","type":"text"}]},{"type":"aside","style":"note","name":"Throws","content":[{"inlineContent":[{"type":"text","text":""},{"identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/PedalTable\/Error\/invalidAnchor","isActive":true,"type":"reference"},{"type":"text","text":" if "},{"code":"timeRange","type":"codeVoice"},{"type":"text","text":" does not contain the time"},{"type":"text","text":" "},{"type":"text","text":"range of the entries being reversed; otherwise,"},{"type":"text","text":" "},{"identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/PedalTable\/Error\/reverseFailure(_:)","isActive":true,"type":"reference"},{"type":"text","text":" if an entry cannot be reversed."}],"type":"paragraph"}]}],"kind":"content"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/IvorModel\/documentation\/IvorModel","doc:\/\/IvorModel\/documentation\/IvorModel\/PedalTable"]]},"kind":"symbol","references":{"doc://IvorModel/documentation/IvorModel/PedalTable/Error/invalidAnchor":{"type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"invalidAnchor"}],"identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/PedalTable\/Error\/invalidAnchor","abstract":[{"text":"An anchor that does not fit what it is applied to: a time or time range that does not","type":"text"},{"text":" ","type":"text"},{"text":"bound the entries being transformed, or an entry to insert before that is missing or","type":"text"},{"text":" ","type":"text"},{"text":"at a different time.","type":"text"}],"url":"\/documentation\/ivormodel\/pedaltable\/error\/invalidanchor","title":"PedalTable.Error.invalidAnchor","role":"symbol"},"doc://IvorModel/documentation/IvorModel/Pedal/Level/up":{"kind":"symbol","type":"topic","abstract":[{"text":"The level of a pedal all the way up (","type":"text"},{"code":"0","type":"codeVoice"},{"text":").","type":"text"}],"role":"symbol","url":"\/documentation\/ivormodel\/pedal\/level\/up","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/Pedal\/Level\/up","title":"up","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"up","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Pedal","preciseIdentifier":"s:9IvorModel5PedalO","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Level","preciseIdentifier":"s:9IvorModel5PedalO5LevelV","kind":"typeIdentifier"}]},"doc://IvorModel/documentation/