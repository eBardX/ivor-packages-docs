{"abstract":[{"text":"Reverses the order of entries within a time range.","type":"text"}],"kind":"symbol","sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reverse","kind":"identifier"},{"text":"(","kind":"text"},{"text":"within","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"timeRange","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"ClosedRange","kind":"typeIdentifier","preciseIdentifier":"s:SN"},{"text":"<","kind":"text"},{"text":"TimeType","kind":"typeIdentifier","preciseIdentifier":"s:9IvorModel10PedalTableV8TimeTypexmfp"},{"text":">? = nil, ","kind":"text"},{"text":"entryIDs","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Set","kind":"typeIdentifier","preciseIdentifier":"s:Sh"},{"text":"<","kind":"text"},{"text":"EntryID","kind":"typeIdentifier","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/EntryID","preciseIdentifier":"s:9IvorModel7EntryIDV"},{"text":">? = nil) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"Error","kind":"typeIdentifier","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/PedalTable\/Error","preciseIdentifier":"s:9IvorModel10PedalTableV5ErrorO"},{"text":")","kind":"text"}],"languages":["swift"]}]},{"parameters":[{"name":"timeRange","content":[{"inlineContent":[{"type":"text","text":"The time range to mirror entry times around. "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" resolves to the"},{"type":"text","text":" "},{"text":"table’s own time range, or — when ","type":"text"},{"type":"codeVoice","code":"entryIDs"},{"text":" is non-","type":"text"},{"type":"codeVoice","code":"nil"},{"type":"text","text":" — the"},{"type":"text","text":" "},{"type":"text","text":"selected entries’ own time range."}],"type":"paragraph"}]},{"name":"entryIDs","content":[{"inlineContent":[{"text":"The identities of the entries to reverse, or ","type":"text"},{"type":"codeVoice","code":"nil"},{"type":"text","text":" to reverse every"},{"type":"text","text":" "},{"text":"entry in the table.","type":"text"}],"type":"paragraph"}]}],"kind":"parameters"},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"Each entry is a step: its level holds until the next entry. So reversing mirrors the","type":"text"},{"text":" ","type":"text"},{"text":"stretch each selected entry governs — up to the next selected entry, or to the range’s","type":"text"},{"text":" ","type":"text"},{"text":"upper bound — and moves the entry to that stretch’s new start. Down at 0 and Up at 4,","type":"text"},{"text":" ","type":"text"},{"text":"reversed within 0…8, gives Up at 0 and Down at 4. The stretch before the first selected","type":"text"},{"text":" ","type":"text"},{"text":"entry, which holds the level in effect before it (","type":"text"},{"identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/Pedal\/Level\/up","isActive":true,"type":"reference"},{"text":" unless an","type":"text"},{"text":" ","type":"text"},{"text":"unselected entry precedes it), moves to the end of the range, and a new entry begins it","type":"text"},{"text":" ","type":"text"},{"text":"there. Entries that share a time swap order, so a re-pedal (Up then Down at one time)","type":"text"},{"text":" ","type":"text"},{"text":"stays Up then Down at its mirrored time. The level after the range isn’t restored, just as","type":"text"},{"type":"text","text":" "},{"text":"the interpolating maps don’t restore their values after it.","type":"text"}],"type":"paragraph"},{"name":"Throws","style":"note","type":"aside","content":[{"inlineContent":[{"text":"","type":"text"},{"isActive":true,"identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/PedalTable\/Error\/invalidAnchor","type":"reference"},{"type":"text","text":" if "},{"type":"codeVoice","code":"timeRange"},{"type":"text","text":" does not contain the time"},{"type":"text","text":" "},{"type":"text","text":"range of the entries being reversed; otherwise,"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/PedalTable\/Error\/reverseFailure(_:)","isActive":true},{"type":"text","text":" if an entry cannot be reversed."}],"type":"paragraph"}]}],"kind":"content"}],"identifier":{"url":"doc:\/\/IvorModel\/documentation\/IvorModel\/PedalTable\/reverse(within:entryIDs:)","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"paths":["\/documentation\/ivormodel\/pedaltable\/reverse(within:entryids:)"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/IvorModel\/documentation\/IvorModel","doc:\/\/IvorModel\/documentation\/IvorModel\/PedalTable"]]},"metadata":{"roleHeading":"Instance Method","modules":[{"name":"IvorModel"}],"conformance":{"conformancePrefix":[{"text":"Conforms when","type":"text"}],"constraints":[{"code":"TimeType","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"TimeProtocol","type":"codeVoice"},{"text":".","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}]},"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reverse","kind":"identifier"},{"text":"(","kind":"text"},{"text":"within","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SN","kind":"typeIdentifier","text":"ClosedRange"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:9IvorModel10PedalTableV8TimeTypexmfp","kind":"typeIdentifier","text":"TimeType"},{"kind":"text","text":">?, "},{"kind":"externalParam","text":"entryIDs"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sh","text":"Set"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:9IvorModel7EntryIDV","text":"EntryID"},{"kind":"text","text":">?) "},{"k