{"metadata":{"role":"symbol","roleHeading":"Initializer","externalID":"s:9IvorModel3PanV5plainACSgSS_tcfc","symbolKind":"init","modules":[{"name":"IvorModel"}],"fragments":[{"text":"init","kind":"identifier"},{"text":"?(","kind":"text"},{"text":"plain","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":")","kind":"text"}],"title":"init(plain:)"},"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"Creates a pan position by parsing its plain string representation,","type":"text"},{"text":" ","type":"text"},{"text":"returning ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" if the string cannot be parsed.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormodel\/pan\/init(plain:)"]}],"hierarchy":{"paths":[["doc:\/\/IvorModel\/documentation\/IvorModel","doc:\/\/IvorModel\/documentation\/IvorModel\/Pan"]]},"identifier":{"url":"doc:\/\/IvorModel\/documentation\/IvorModel\/Pan\/init(plain:)","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"init","kind":"keyword"},{"text":"?(","kind":"text"},{"text":"plain","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":")","kind":"text"}],"platforms":["macOS"]}]},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The plain string representation of the pan position"},{"type":"text","text":" "},{"type":"text","text":"(as produced by "},{"type":"codeVoice","code":"plain"},{"type":"text","text":")."}]}],"name":"plain"}],"kind":"parameters"},{"content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Parsing is lenient. Each angle is a number optionally followed by a"},{"type":"text","text":" "},{"type":"text","text":"degree sign and then by a label — "},{"type":"codeVoice","code":"H"},{"type":"text","text":" for horizontal or "},{"type":"codeVoice","code":"V"},{"type":"text","text":" for"},{"type":"text","text":" "},{"type":"text","text":"vertical, in either case — with optional whitespace throughout, and"},{"type":"text","text":" "},{"type":"text","text":"the angles may appear in either order. An unlabeled number is the"},{"type":"text","text":" "},{"type":"text","text":"horizontal angle, and an omitted angle is "},{"type":"codeVoice","code":"0"},{"type":"text","text":". For example, "},{"type":"codeVoice","code":"-45H 30V"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"30v -45h"},{"type":"text","text":", "},{"type":"codeVoice","code":"-45°H 30°V"},{"type":"text","text":", "},{"type":"codeVoice","code":"-45"},{"type":"text","text":", and "},{"type":"codeVoice","code":"30V"},{"type":"text","text":" are all accepted. A string"},{"type":"text","text":" "},{"type":"text","text":"that gives either angle more than once, or that contains anything"},{"type":"text","text":" "},{"type":"text","text":"else, is rejected."}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","references":{"doc://IvorModel/documentation/IvorModel/Pan/Angle":{"kind":"symbol","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/Pan\/Angle","abstract":[{"type":"text","text":"An angle, in degrees, that wraps into the half-open range "},{"type":"codeVoice","code":"(-180, 180]"},{"type":"text","text":"."}],"title":"Pan.Angle","navigatorTitle":[{"text":"Angle","kind":"identifier"}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Angle","kind":"identifier"}],"role":"symbol","url":"\/documentation\/ivormodel\/pan\/angle"},"doc://IvorModel/documentation/IvorModel/Pan":{"kind":"symbol","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/Pan","abstract":[{"type":"text","text":"A spatial pan position: the direction of a sound in 3-D space relative to"},{"type":"text","text":" "},{"type":"text","text":"the listener, expressed as a horizontal and a vertical "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/Pan\/Angle"},{"type":"text","text":" in degrees."}],"title":"Pan","navigatorTitle":[{"text":"Pan","kind":"identifier"}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Pan","kind":"identifier"}],"role":"symbol","url":"\/documentation\/ivormodel\/pan"},"doc://IvorModel/documentation/IvorModel/Pan/init(plain:)":{"url":"\/documentation\/ivormodel\/pan\/init(plain:)","role":"symbol","abstract":[{"text":"Creates a pan position by parsing its plain string representation,","type":"text"},{"text":" ","type":"text"},{"text":"returning ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" if the string cannot be parsed.","type":"text"}],"fragments":[{"text":"init","kind":"identifier"},{"text":"?(","kind":"text"},{"text":"plain","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":")","kind":"text"}],"title":"init(plain:)","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/Pan\/init(plain:)","type":"topic","kind":"symbol"},"doc://IvorModel/documentation/IvorModel":{"url":"\/documentation\/ivormodel","role":"collection","abstract":[{"type":"text","text":"A representation-agnostic musical composition model."}],"identifier":"doc:\/\/IvorModel\/documentation\/IvorModel","title":"IvorModel","type":"topic","kind":"symbol"}}}