, and ","type":"text"},{"code":"30V","type":"codeVoice"},{"text":" are all accepted. A string","type":"text"},{"text":" ","type":"text"},{"text":"that gives either angle more than once, or that contains anything","type":"text"},{"text":" ","type":"text"},{"text":"else, is rejected.","type":"text"}]}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorModel\/documentation\/IvorModel\/Pan\/init(plain:)"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormodel\/pan\/init(plain:)"]}],"metadata":{"roleHeading":"Initializer","modules":[{"name":"IvorModel"}],"role":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"?("},{"kind":"externalParam","text":"plain"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":")"}],"title":"init(plain:)","externalID":"s:9IvorModel3PanV5plainACSgSS_tcfc","symbolKind":"init"},"abstract":[{"text":"Creates a pan position by parsing its plain string representation,","type":"text"},{"text":" ","type":"text"},{"text":"returning ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" if the string cannot be parsed.","type":"text"}],"references":{"doc://IvorModel/documentation/IvorModel/Pan/Angle":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Angle"}],"abstract":[{"text":"An angle, in degrees, that wraps into the half-open range ","type":"text"},{"code":"(-180, 180]","type":"codeVoice"},{"text":".","type":"text"}],"kind":"symbol","type":"topic","url":"\/documentation\/ivormodel\/pan\/angle","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Angle"}],"identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/Pan\/Angle","title":"Pan.Angle"},"doc://IvorModel/documentation/IvorModel/Pan/init(plain:)":{"url":"\/documentation\/ivormodel\/pan\/init(plain:)","kind":"symbol","role":"symbol","identifier":"doc:\/\/IvorModel\/documentation\/I