{"abstract":[{"type":"text","text":"Creates a pan position by parsing its plain string representation,"},{"text":" ","type":"text"},{"text":"returning ","type":"text"},{"code":"nil","type":"codeVoice"},{"type":"text","text":" if the string cannot be parsed."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormodel\/pan\/init(plain:)"]}],"kind":"symbol","metadata":{"externalID":"s:9IvorModel3PanV5plainACSgSS_tcfc","symbolKind":"init","modules":[{"name":"IvorModel"}],"fragments":[{"text":"init","kind":"identifier"},{"text":"?(","kind":"text"},{"text":"plain","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":")","kind":"text"}],"title":"init(plain:)","roleHeading":"Initializer","role":"symbol"},"identifier":{"url":"doc:\/\/IvorModel\/documentation\/IvorModel\/Pan\/init(plain:)","interfaceLanguage":"swift"},"sections":[],"hierarchy":{"paths":[["doc:\/\/IvorModel\/documentation\/IvorModel","doc:\/\/IvorModel\/documentation\/IvorModel\/Pan"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"init"},{"text":"?(","kind":"text"},{"text":"plain","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"kind":"text","text":")"}],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The plain string representation of the pan position"},{"text":" ","type":"text"},{"type":"text","text":"(as produced by "},{"type":"codeVoice","code":"plain"},{"type":"text","text":")."}]}],"name":"plain"}]},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Parsing is lenient. Each angle is a number optionally followed by a","type":"text"},{"text":" ","type":"text"},{"text":"degree sign and then by a label — ","type":"text"},{"code":"H","type":"codeVoice"},{"text":" for horizontal or ","type":"text"},{"code":"V","type":"codeVoice"},{"text":" for","type":"text"},{"text":" ","type":"text"},{"text":"vertical, in either case — with optional whitespace throughout, and","type":"text"},{"text":" ","type":"text"},{"text":"the angles may appear in either order. An unlabeled number is the","type":"text"},{"text":" ","type":"text"},{"text":"horizontal angle, and an omitted angle is ","type":"text"},{"code":"0","type":"codeVoice"},{"text":". For example, ","type":"text"},{"code":"-45H 30V","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"30v -45h","type":"codeVoice"},{"text":", ","type":"text"},{"code":"-45°H 30°V","type":"codeVoice"},{"text":", ","type":"text"},{"code":"-45","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"30V","type":"codeVoice"},{"text":" are all accepted. A string","type":"text"},{"text":" ","type":"text"},{"text":"that gives either angle more than once, or that contains anything","type":"text"},{"text":" ","type":"text"},{"text":"else, is rejected.","type":"text"}]}],"kind":"content"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://IvorModel/documentation/IvorModel/Pan/Angle":{"role":"symbol","navigatorTitle":[{"text":"Angle","kind":"identifier"}],"identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/Pan\/Angle","type":"topic","title":"Pan.Angle","abstract":[{"type":"text","text":"An angle, in degrees, that wraps into the half-open range "},{"code":"(-180, 180]","type":"codeVoice"},{"type":"text","text":"."}],"url":"\/documentation\/ivormodel\/pan\/angle","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Angle","kind":"identifier"}],"kind":"symbol"},"doc://IvorModel/documentation/IvorModel/Pan/init(plain:)":{"title":"init(plain:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"?("},{"kind":"externalParam","text":"pla