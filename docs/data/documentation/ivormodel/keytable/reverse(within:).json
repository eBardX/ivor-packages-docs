{"abstract":[{"type":"text","text":"Reverses the keys of this key table within a beat-time range,"},{"type":"text","text":" "},{"type":"text","text":"mirroring them as the music in that range is mirrored."}],"variants":[{"paths":["\/documentation\/ivormodel\/keytable\/reverse(within:)"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorModel\/documentation\/IvorModel\/KeyTable\/reverse(within:)"},"metadata":{"externalID":"s:9IvorModel8KeyTableV7reverse6withinySNy0A6Timing8BeatTimeVG_tF","symbolKind":"method","modules":[{"name":"IvorModel"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reverse","kind":"identifier"},{"text":"(","kind":"text"},{"text":"within","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ClosedRange","kind":"typeIdentifier","preciseIdentifier":"s:SN"},{"text":"<","kind":"text"},{"text":"BeatTime","kind":"typeIdentifier","preciseIdentifier":"s:10IvorTiming8BeatTimeV"},{"text":">)","kind":"text"}],"title":"reverse(within:)","extendedModule":"IvorModel","roleHeading":"Instance Method","role":"symbol"},"sections":[],"hierarchy":{"paths":[["doc:\/\/IvorModel\/documentation\/IvorModel","doc:\/\/IvorModel\/documentation\/IvorModel\/KeyTable"]]},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reverse","kind":"identifier"},{"text":"(","kind":"text"},{"text":"within","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"beatTimeRange","kind":"internalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"ClosedRange","preciseIdentifier":"s:SN"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"BeatTime","identifier":"doc:\/\/IvorTiming\/documentation\/IvorTiming\/BeatTime","preciseIdentifier":"s:10IvorTiming8BeatTimeV"},{"kind":"text","text":">)"}]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The beat-time range to mirror the keys within."}]}],"name":"beatTimeRange"}]},{"content":[{"anchor":"discussion","text":"Discussion","level":2,"type":"heading"},{"inlineContent":[{"text":"Each entry is a step: its key holds until the next entry. So reversing mirrors","type":"text"},{"text":" ","type":"text"},{"text":"the stretch each entry in the range governs — up to the next entry, or to the range’s","type":"text"},{"text":" ","type":"text"},{"text":"upper bound — and moves the entry to that stretch’s new start. The stretch before the first","type":"text"},{"text":" ","type":"text"},{"text":"entry in the range, which holds the key in effect before the range, moves to the","type":"text"},{"text":" ","type":"text"},{"text":"end of the range, and a new entry with that key and its extras begins it there.","type":"text"},{"text":" ","type":"text"},{"text":"(When no key is in effect before the range, there’s nothing to begin it with, so","type":"text"},{"text":" ","type":"text"},{"text":"the last mirrored key runs on over it.) Finally, the key in effect","type":"text"},{"text":" ","type":"text"},{"text":"after the range is restated at its upper bound, unless it’s already in effect there.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For example, D major at 0 and B♭ major at 4, reversed within 0…8, gives B♭ major at 0 and","type":"text"},{"text":" ","type":"text"},{"text":"D major at 4, then B♭ major again at 8, since it was in effect after the range.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://IvorModel/documentation/IvorModel/KeyTable":{"role":"symbol","navigatorTitle":[{"text":"KeyTable","kind":"identifier"}],"identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/KeyTable","type":"topic","title":"KeyTable","abstract":[{"text":"A beat-time table of keys: where each key takes effect.","type":"text"}],"url":"\/documentation\/ivormodel\/keytable","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"KeyTable"}],"kind":"symbol"},"doc://IvorModel/documentation/IvorModel":{"title":"IvorModel","role":"collection","type":"topic","url":"\/documentation\/ivormodel","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel","kind":"symbol","abstract":[{"type":"text","text":"A representation-agnostic musical composition model."}]},"doc://IvorTiming/documentation/IvorTiming/BeatTime":{"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"BeatTime"}],"type":"topic","identifier":"doc:\/\/IvorTiming\/documentation\/IvorTiming\/BeatTime","title":"BeatTime","abstract":[{"text":"A point in musical beat time, measured in whole notes from time zero.","type":"text"}],"url":"\/documentation\/ivortiming\/beattime","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"BeatTime"}],"kind":"symbol"},"doc://IvorModel/documentation/IvorModel/KeyTable/reverse(within:)":{"role":"symbol","type":"topic","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/KeyTable\/reverse(within:)","title":"reverse(within:)","abstract":[{"text":"Reverses the keys of this key table within a beat-time range,","type":"text"},{"text":" ","type":"text"},{"text":"mirroring them as the music in that range is mirrored.","type":"text"}],"url":"\/documentation\/ivormodel\/keytable\/reverse(within:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reverse","kind":"identifier"},{"text":"(","kind":"text"},{"text":"within","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ClosedRange","preciseIdentifier":"s:SN","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"BeatTime","preciseIdentifier":"s:10IvorTiming8BeatTimeV","kind":"typeIdentifier"},{"text":">)","kind":"text"}],"kind":"symbol"}}}