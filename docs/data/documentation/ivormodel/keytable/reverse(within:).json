{"abstract":[{"text":"Reverses the keys of this key table within a beat-time range,","type":"text"},{"text":" ","type":"text"},{"text":"mirroring them as the music in that range is mirrored.","type":"text"}],"metadata":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reverse","kind":"identifier"},{"text":"(","kind":"text"},{"text":"within","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ClosedRange","kind":"typeIdentifier","preciseIdentifier":"s:SN"},{"text":"<","kind":"text"},{"text":"BeatTime","kind":"typeIdentifier","preciseIdentifier":"s:10IvorTiming8BeatTimeV"},{"text":">)","kind":"text"}],"externalID":"s:9IvorModel8KeyTableV7reverse6withinySNy0A6Timing8BeatTimeVG_tF","role":"symbol","roleHeading":"Instance Method","symbolKind":"method","extendedModule":"IvorModel","modules":[{"name":"IvorModel"}],"title":"reverse(within:)"},"kind":"symbol","sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reverse","kind":"identifier"},{"text":"(","kind":"text"},{"text":"within","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"beatTimeRange","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"ClosedRange","kind":"typeIdentifier","preciseIdentifier":"s:SN"},{"text":"<","kind":"text"},{"text":"BeatTime","identifier":"doc:\/\/IvorTiming\/documentation\/IvorTiming\/BeatTime","kind":"typeIdentifier","preciseIdentifier":"s:10IvorTiming8BeatTimeV"},{"text":">)","kind":"text"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"beatTimeRange","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The beat-time range to mirror the keys within."}]}]}]},{"content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"inlineContent":[{"type":"text","text":"Each entry is a step: its key holds until the next entry. So reversing mirrors"},{"type":"text","text":" "},{"type":"text","text":"the stretch each entry in the range governs — up to the next entry, or to the range’s"},{"type":"text","text":" "},{"type":"text","text":"upper bound — and moves the entry to that stretch’s new start. The stretch before the first"},{"type":"text","text":" "},{"type":"text","text":"entry in the range, which holds the key in effect before the range, moves to the"},{"type":"text","text":" "},{"type":"text","text":"end of the range, and a new entry with that key and its extras begins it there."},{"type":"text","text":" "},{"type":"text","text":"(When no key is in effect before the range, there’s nothing to begin it with, so"},{"type":"text","text":" "},{"type":"text","text":"the last mirrored key runs on over it.) Finally, the key in effect"},{"type":"text","text":" "},{"type":"text","text":"after the range is restated at its upper bound, unless it’s already in effect there."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For example, D major at 0 and B♭ major at 4, reversed within 0…8, gives B♭ major at 0 and"},{"type":"text","text":" "},{"type":"text","text":"D major at 4, then B♭ major again at 8, since it was in effect after the range."}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/ivormodel\/keytable\/reverse(within:)"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/IvorModel\/documentation\/IvorModel\/KeyTable\/reverse(within:)","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/IvorModel\/documentation\/IvorModel","doc:\/\/IvorModel\/documentation\/IvorModel\/KeyTable"]]},"references":{"doc://IvorModel/documentation/IvorModel/KeyTable/reverse(within:)":{"type":"topic","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/KeyTable\/reverse(within:)","title":"reverse(within:)","role":"symbol","abstract":[{"type":"text","text":"Reverses the keys of this key table within a beat-time range,"},{"type":"text","text":" "},{"type":"text","text":"mirroring them as the music in that range is mirrored."}],"url":"\/documentation\/ivormodel\/keytable\/reverse(within:)","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reverse","kind":"identifier"},{"text":"(","kind":"text"},{"text":"within","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ClosedRange","kind":"typeIdentifier","preciseIdentifier":"s:SN"},{"text":"<","kind":"text"},{"text":"BeatTime","preciseIdentifier":"s:10IvorTiming8BeatTimeV","kind":"typeIdentifier"},{"text":">)","kind":"text"}]},"doc://IvorTiming/documentation/IvorTiming/BeatTime":{"abstract":[{"type":"text","text":"A point in musical beat time, measured in whole notes from time zero."}],"identifier":"doc:\/\/IvorTiming\/documentation\/IvorTiming\/BeatTime","title":"BeatTime","url":"\/documentation\/ivortiming\/beattime","navigatorTitle":[{"kind":"identifier","text":"BeatTime"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"BeatTime"}],"type":"topic","role":"symbol","kind":"symbol"},"doc://IvorModel/documentation/IvorModel":{"type":"topic","kind":"symbol","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel","abstract":[{"text":"A representation-agnostic musical composition model.","type":"text"}],"url":"\/documentation\/ivormodel","title":"IvorModel","role":"collection"},"doc://IvorModel/documentation/IvorModel/KeyTable":{"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"KeyTable"}],"role":"symbol","url":"\/documentation\/ivormodel\/keytable","navigatorTitle":[{"kind":"identifier","text":"KeyTable"}],"abstract":[{"type":"text","text":"A beat-time table of keys: where each key takes effect."}],"title":"KeyTable","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/KeyTable","type":"topic"}}}