"text":" and a human-readable ","type":"text"},{"type":"codeVoice","code":"message"},{"text":".","type":"text"}],"type":"paragraph"},{"alignments":["left","left"],"type":"table","header":"row","rows":[[[{"inlineContent":[{"text":"Type","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Thrown by","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCParser\/Error","type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"code":"ABCParser.parse(_:)","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCValidator\/Error","type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"ABCValidator.validate(_:)"}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCFormatter\/Error","type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"code":"ABCFormatter.format(_:)","type":"codeVoice"}],"type":"paragraph"}]]]},{"inlineContent":[{"type":"codeVoice","code":"ABCNormalizer.normalize(_:)"},{"text":" never throws — normalization has no failure mode.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Non-fatal results are returned rather than thrown, and each also provides a","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"message"},{"text":":","type":"text"}],"type":"paragraph"},{"alignments":["left","left"],"type":"table","header":"row","rows":[[[{"inlineContent":[{"text":"Type","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Returned by","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCParser\/Diagnostic","isActive":true,"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"code":"parse(_:)","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"do