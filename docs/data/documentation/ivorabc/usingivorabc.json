xt":" ","type":"text"},{"identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCReferenceNumber","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCVoice\/ID-swift.struct","type":"reference","isActive":true},{"text":", and ","type":"text"},{"identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCClef\/Name-swift.struct","type":"reference","isActive":true},{"text":" — each of which","type":"text"},{"text":" ","type":"text"},{"text":"exposes an ","type":"text"},{"type":"codeVoice","code":"isValid(_:)"},{"text":" check and a failable initializer that returns ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" ","type":"text"},{"text":"for out-of-range input. Others, like ","type":"text"},{"identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCLength","type":"reference","isActive":true},{"text":", validate internally in a","type":"text"},{"text":" ","type":"text"},{"text":"failable initializer without a public ","type":"text"},{"type":"codeVoice","code":"isValid(_:)"},{"text":" check. All AST types are","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Equatable"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"Sendable"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCTunebook","type":"reference","isActive":true},{"text":" equality compares ","type":"text"},{"type":"codeVoice","code":"version"},{"text":", ","type":"text"},{"type":"codeVoice","code":"fileHeader"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"tunes"},{"text":" only;","type":"text"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"type":"codeVoice","code":"isNormalized"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"isValidated"},{"text":" flags are metadata and are excluded.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","anchor":"Building-a-tunebook-program