ield — and exposes both a ","type":"text"},{"type":"codeVoice","code":"message"},{"text":" ","type":"text"},{"text":"and a ","type":"text"},{"type":"codeVoice","code":"tuneIndex"},{"text":".","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","anchor":"Formatting","text":"Formatting"},{"inlineContent":[{"identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCFormatter","type":"reference","isActive":true},{"text":" serializes a ","type":"text"},{"inlineContent":[{"text":"validated","type":"text"}],"type":"strong"},{"text":" tunebook back to ABC 2.1-compliant","type":"text"},{"text":" ","type":"text"},{"text":"UTF-8 ","type":"text"},{"type":"codeVoice","code":"Data"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let data = try ABCFormatter().format(validated)"],"type":"codeListing"},{"inlineContent":[{"text":"If the tunebook has not been validated, ","type":"text"},{"type":"codeVoice","code":"format(_:)"},{"text":" throws","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCFormatter\/Error\/notValidated","type":"reference","isActive":true},{"text":". Because the model is validated first,","type":"text"},{"text":" ","type":"text"},{"text":"formatting itself does not fail on content — round-tripping ","type":"text"},{"type":"codeVoice","code":"parse → normalize → validate → format"},{"text":" reproduces a specification-compliant document.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","anchor":"The-AST-model","text":"The AST model"},{"inlineContent":[{"text":"The syntactic model is a tree of value types:","type":"text"}],"type":"paragraph"},{"syntax":null,"code":["ABCTunebook","├─ version:    ABCVersion?","├─ fileHeader: [ABCHeaderEntry]","└─ tunes:      [ABCTune]","   ├─ header: [ABCHeaderEntry]   \/\/ .directive | .field","   └─ body:   [ABCBodyEntry]     \/\/ .directive | .field | .symbols([ABCSymbol])"],"type":"codeListing"},{"type":"unorderedList","items"