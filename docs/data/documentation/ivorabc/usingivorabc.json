adable "},{"code":"message","type":"codeVoice"},{"text":".","type":"text"}]},{"header":"row","alignments":["left","left"],"rows":[[[{"inlineContent":[{"text":"Type","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Thrown by","type":"text"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCParser\/Error"}]}],[{"inlineContent":[{"code":"ABCParser.parse(_:)","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCValidator\/Error","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"ABCValidator.validate(_:)"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCFormatter\/Error","isActive":true,"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"code":"ABCFormatter.format(_:)","type":"codeVoice"}],"type":"paragraph"}]]],"type":"table"},{"inlineContent":[{"type":"codeVoice","code":"ABCNormalizer.normalize(_:)"},{"text":" never throws — normalization has no failure mode.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Non-fatal results are returned rather than thrown, and each also provides a"},{"type":"text","text":" "},{"type":"codeVoice","code":"message"},{"type":"text","text":":"}],"type":"paragraph"},{"alignments":["left","left"],"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Type"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Returned by"}]}]],[[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCParser\/Diagnostic","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"code":"parse(_:)","type":"codeVoice"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/IvorABC\/documentation\/IvorABC