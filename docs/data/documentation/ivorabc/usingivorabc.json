ue,"type":"reference","identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCReferenceNumber"},{"text":", ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCVoice\/ID-swift.struct"},{"text":", and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCClef\/Name-swift.struct"},{"text":" — each of which","type":"text"},{"text":" ","type":"text"},{"text":"exposes an ","type":"text"},{"type":"codeVoice","code":"isValid(_:)"},{"text":" check and a failable initializer that returns ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" ","type":"text"},{"text":"for out-of-range input. Others, like ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCLength"},{"text":", validate internally in a","type":"text"},{"text":" ","type":"text"},{"text":"failable initializer without a public ","type":"text"},{"type":"codeVoice","code":"isValid(_:)"},{"type":"text","text":" check. All AST types are"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Equatable"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"Sendable"},{"text":".","type":"text"}]},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCTunebook"},{"type":"text","text":" equality compares "},{"type":"codeVoice","code":"version"},{"type":"text","text":", "},{"type":"codeVoice","code":"fileHeader"},{"type":"text","text":", and "},{"type":"codeVoice","code":"tunes"},{"type":"text","text":" only;"},{"type":"text","text":" "},{"type":"text","text":"the "},{"type":"codeVoice","code":"isNormalized"},{"type":"text","text":" and "},{"type":"codeVoice","code":"isValidated"},{"type":"text","text":" flags are metadata and are excluded."}],"type":"paragraph"},{"text":"Building a tunebook programmatically","level":2,"type":"heading","anchor":"Building-a-tunebook-programmatically"