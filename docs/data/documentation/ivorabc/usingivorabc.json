Voice","code":"message"},{"text":" ","type":"text"},{"text":"and a ","type":"text"},{"code":"tuneIndex","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Formatting","level":2,"anchor":"Formatting","type":"heading"},{"inlineContent":[{"identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCFormatter","type":"reference","isActive":true},{"type":"text","text":" serializes a "},{"type":"strong","inlineContent":[{"type":"text","text":"validated"}]},{"type":"text","text":" tunebook back to ABC 2.1-compliant"},{"type":"text","text":" "},{"type":"text","text":"UTF-8 "},{"type":"codeVoice","code":"Data"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["let data = try ABCFormatter().format(validated)"],"type":"codeListing"},{"inlineContent":[{"text":"If the tunebook has not been validated, ","type":"text"},{"type":"codeVoice","code":"format(_:)"},{"text":" throws","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCFormatter\/Error\/notValidated"},{"text":". Because the model is validated first,","type":"text"},{"text":" ","type":"text"},{"text":"formatting itself does not fail on content — round-tripping ","type":"text"},{"type":"codeVoice","code":"parse → normalize → validate → format"},{"text":" reproduces a specification-compliant document.","type":"text"}],"type":"paragraph"},{"text":"The AST model","level":2,"anchor":"The-AST-model","type":"heading"},{"inlineContent":[{"text":"The syntactic model is a tree of value types:","type":"text"}],"type":"paragraph"},{"syntax":null,"code":["ABCTunebook","├─ version:    ABCVersion?","├─ fileHeader: [ABCHeaderEntry]","└─ tunes:      [ABCTune]","   ├─ header: [ABCHeaderEntry]   \/\/ .directive | .field","   └─ body:   [ABCBodyEntry]     \/\/ .directive | .field | .symbols([ABCSymbol])"],"type":"codeListing"},{"items":[{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorA