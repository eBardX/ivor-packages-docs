,"identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCParser\/Diagnostic","isActive":true},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Diagnostics are always returned, never thrown; each has a human-readable","type":"text"},{"text":" ","type":"text"},{"code":"message","type":"codeVoice"},{"text":":","type":"text"}]},{"code":["for diagnostic in diagnostics {","    print(diagnostic.message)","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Diagnostics cover recoverable situations such as a deprecated tempo form"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"Q:120"},{"type":"text","text":"), a duplicate "},{"type":"codeVoice","code":"%%abc-charset"},{"type":"text","text":", an unrecognized character set, a"},{"text":" ","type":"text"},{"text":"malformed version string, or a skipped unrecognizable line.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Unrecoverable problems are thrown as an "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCParser\/Error"},{"type":"text","text":", for example"},{"type":"text","text":" "},{"type":"codeVoice","code":".invalidField(_:_:)"},{"text":", ","type":"text"},{"type":"codeVoice","code":".invalidKeySignature(_:)"},{"text":", ","type":"text"},{"type":"codeVoice","code":".orphanedContinuation"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":".unmatchedBeginDirective(_:)"},{"type":"text","text":", or "},{"type":"codeVoice","code":".missingTunes"},{"type":"text","text":". Like all IvorABC errors it"},{"type":"text","text":" "},{"type":"text","text":"conforms to "},{"type":"codeVoice","code":"EnhancedError"},{"type":"text","text":" and provides a "},{"type":"codeVoice","code":"message"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["do {","    let (tunebook, _) = try ABCParser().parse(data)","} catch let error as ABCParser.E