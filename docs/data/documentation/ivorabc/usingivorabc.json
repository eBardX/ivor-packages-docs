= try ABCFormatter().format(validated)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Both "},{"type":"codeVoice","code":"normalize(_:)"},{"type":"text","text":" and "},{"code":"validate(_:)","type":"codeVoice"},{"text":" are idempotent — calling them on a","type":"text"},{"text":" ","type":"text"},{"text":"tunebook that is already normalized or validated returns it unchanged — so it is","type":"text"},{"text":" ","type":"text"},{"text":"always safe to run the full pipeline.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Parsing","anchor":"Parsing","type":"heading"},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCParser","type":"reference"},{"text":" decodes UTF-8 ","type":"text"},{"type":"codeVoice","code":"Data"},{"text":" into an ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCTunebook"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let (tunebook, diagnostics) = try ABCParser().parse(data)"],"type":"codeListing"},{"inlineContent":[{"text":"The parser chooses its own parse policy from the version declared in the input:","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"text":"strict","type":"text"}],"type":"strong"},{"text":" for files that declare ABC 2.1 or later, and ","type":"text"},{"type":"strong","inlineContent":[{"text":"loose","type":"text"}]},{"type":"text","text":" for everything"},{"type":"text","text":" "},{"type":"text","text":"else (including unversioned files). In loose mode it recovers from common"},{"type":"text","text":" "},{"type":"text","text":"deviations rather than failing, and reports each recovery — along with any"},{"type":"text","text":" "},{"type":"text","text":"deprecated forms accepted in either mode — as an "},{"type":"reference","identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCParser\/Diagnostic","isActive":true},{"type":"text","text":"."},{"text":" ","type":"text"},{"text":"Diagnostics are always returned, never thrown; each has a human-readable","type":"text"},{"text":" ","type":"text"},{"code":"message","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["for diagnostic in diagnostics {","    print(diagnostic.message)","}"],"type":"codeListing"},{"inlineContent":[{"text":"Diagnostics cover recoverable situations such as a deprecated tempo form","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"Q:120","type":"codeVoice"},{"text":"), a duplicate ","type":"text"},{"code":"%%abc-charset","type":"codeVoice"},{"text":", an unrecognized character set, a","type":"text"},{"text":" ","type":"text"},{"text":"malformed version string, or a skipped unrecognizable line.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Unrecoverable problems are thrown as an ","type":"text"},{"isActive":true,"identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCParser\/Error","type":"reference"},{"text":", for example","type":"text"},{"text":" ","type":"text"},{"code":".invalidField(_:_:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":".invalidKeySignature(_:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":".orphanedContinuation","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":".unmatchedBeginDirective(_:)","type":"codeVoice"},{"text":", or ","type":"text"},{"code":".missingTunes","type":"codeVoice"},{"text":". Like all IvorABC errors it","type":"text"},{"text":" ","type":"text"},{"text":"conforms to ","type":"text"},{"code":"EnhancedError","type":"codeVoice"},{"text":" and provides a ","type":"text"},{"code":"message","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["do {","    let (tunebook, _) = try ABCParser().parse(data)","} catch let error as ABCParser.Error {","    print(error.message)","}"],"type":"codeListing"},{"level":2,"text":"Normalizing","anchor":"Normalizing","type":"heading"},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCNormalizer","type":"reference"},{"text":" upgrades legacy and deprecated constructs to their ABC 2.1","type":"text"},{"text":" ","type":"text"},{"text":"equivalents, returning a new tunebook whose ","type":"text"},{"code":"isNormalized","type":"codeVoice"},{"text":" flag is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"text":"whose ","type":"text"},{"code":"version","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"ABCVersion.current","type":"codeVoice"},{"text":", together with a list of the changes it","type":"text"},{"text":" ","type":"text"},{"text":"applied:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let (normalized, changes) = ABCNormalizer().normalize(tunebook)","","for change in changes {","    print(change.message)          \/\/ what was changed","    print(change.tuneIndex ?? -1)  \/\/ which tune, or nil for the file header","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Normalization performs conversions such as:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"E:"},{"text":" (elemskip) and legacy ","type":"text"},{"type":"codeVoice","code":"I:"},{"text":" (information) fields → ","type":"text"},{"type":"codeVoice","code":"r:"},{"text":" (remark).","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Deprecated C-form tempos ("},{"code":"Q:C=rate","type":"codeVoice"},{"type":"text","text":") resolved against the active "},{"code":"L:","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"M:","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"+name+"},{"text":" decorations → the standard ","type":"text"},{"type":"codeVoice","code":"!name!"},{"text":" form.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Dropping stale directives ("},{"code":"%%abc-charset","type":"codeVoice"},{"type":"text","text":", "},{"code":"%%abc-version","type":"codeVoice"},{"type":"text","text":", "},{"code":"%%decoration +","type":"codeVoice"},{"type":"text","text":")."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Each "},{"type":"reference","identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCNormalizer\/Change","isActive":true},{"type":"text","text":" case ("},{"code":"clearedBeatMultiplier","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"convertedDecoration","type":"codeVoice"},{"type":"text","text":", "},{"code":"removedDirective","type":"codeVoice"},{"type":"text","text":", "},{"code":"replacedField","type":"codeVoice"},{"type":"text","text":") carries the affected"},{"type":"text","text":" "},{"type":"text","text":"value, so you can present a precise change log rather than just a count."}],"type":"paragraph"},{"level":2,"text":"Validating","anchor":"Validating","type":"heading"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCValidator","isActive":true},{"type":"text","text":" checks a "},{"type":"strong","inlineContent":[{"type":"text","text":"normalized"}]},{"type":"text","text":" tunebook against the ABC 2.1"},{"type":"text","text":" "},{"type":"text","text":"specification:"}],"type":"paragraph"},{"syntax":"swift","code":["let (validated, issues) = try ABCValidator().validate(normalized)","","if issues.isEmpty {","    \/\/ `validated.isValidated` is now true.","} else {","    issues.forEach { print($0.message) }","}"],"type":"codeListing"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"If the tunebook has not been normalized, ","type":"text"},{"type":"codeVoice","code":"validate(_:)"},{"text":" throws","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCValidator\/Error\/notNormalized"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"If any issues are found, the returned tunebook is the "},{"inlineContent":[{"text":"input unchanged","type":"text"}],"type":"strong"},{"type":"text","text":" (its"},{"type":"text","text":" "},{"code":"isValidated","type":"codeVoice"},{"type":"text","text":" flag stays "},{"code":"false","type":"codeVoice"},{"type":"text","text":"). Fix the issues — or run it through the"},{"type":"text","text":" "},{"type":"text","text":"normalizer again after editing — and validate again."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Only when the issues array is empty does the returned tunebook have","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"isValidated == true"},{"text":" — the prerequisite for formatting.","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"Each ","type":"text"},{"type":"reference","identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCValidator\/Issue","isActive":true},{"text":" describes a specific conformance problem — a missing","type":"text"},{"text":" ","type":"text"},{"text":"or misplaced ","type":"text"},{"type":"codeVoice","code":"X:"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"T:"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"K:"},{"text":" field, an inline field used where it is not","type":"text"},{"text":" ","type":"text"},{"text":"allowed, more than one chord symbol or grace-note group on a single note, or a","type":"text"},{"text":" ","type":"text"},{"text":"shorthand decoration with no defining ","type":"text"},{"type":"codeVoice","code":"U:"},{"text":" field — and exposes both a ","type":"text"},{"type":"codeVoice","code":"message"},{"text":" ","type":"text"},{"text":"and a ","type":"text"},{"type":"codeVoice","code":"tuneIndex"},{"text":".","type":"text"}]},{"level":2,"text":"Formatting","anchor":"Formatting","type":"heading"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCFormatter","isActive":true},{"type":"text","text":" serializes a "},{"type":"strong","inlineContent":[{"type":"text","text":"validated"}]},{"type":"text","text":" tunebook back to ABC 2.1-compliant"},{"type":"text","text":" "},{"type":"text","text":"UTF-8 "},{"code":"Data","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["let data = try ABCFormatter().format(validated)"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"If the tunebook has not been validated, "},{"code":"format(_:)","type":"codeVoice"},{"type":"text","text":" throws"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCFormatter\/Error\/notValidated","isActive":true},{"type":"text","text":". Because the model is validated first,"},{"type":"text","text":" "},{"type":"text","text":"formatting itself does not fail on content — round-tripping "},{"code":"parse → normalize → validate → format","type":"codeVoice"},{"type":"text","text":" reproduces a specification-compliant document."}],"type":"paragraph"},{"level":2,"text":"The AST model","anchor":"The-AST-model","type":"heading"},{"inlineContent":[{"type":"text","text":"The syntactic model is a tree of value types:"}],"type":"paragraph"},{"syntax":null,"code":["ABCTunebook","├─ version:    ABCVersion?","├─ fileHeader: [ABCHeaderEntry]","└─ tunes:      [ABCTune]","   ├─ header: [ABCHeaderEntry]   \/\/ .directive | .field","   └─ body:   [ABCBodyEntry]     \/\/ .directive | .field | .symbols([ABCSymbol])"],"type":"codeListing"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCField"},{"text":" is an enum with one case per ABC information\/tune field","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":".tuneTitle"},{"text":", ","type":"text"},{"type":"codeVoice","code":".key"},{"text":", ","type":"text"},{"type":"codeVoice","code":".meter"},{"text":", ","type":"text"},{"type":"codeVoice","code":".tempo"},{"text":", ","type":"text"},{"type":"codeVoice","code":".voice"},{"text":", …). Each case’s payload","type":"text"},{"text":" ","type":"text"},{"text":"is a dedicated, fully-typed value (e.g. ","type":"text"},{"type":"codeVoice","code":".key(ABCKeySignature)"},{"text":").","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCSymbol","isActive":true},{"type":"text","text":" is an enum covering everything that can appear in a line of"},{"type":"text","text":" "},{"type":"text","text":"music: "},{"code":".note","type":"codeVoice"},{"type":"text","text":", "},{"code":".chord","type":"codeVoice"},{"type":"text","text":", "},{"code":".rest","type":"codeVoice"},{"type":"text","text":", "},{"code":".barLine","type":"codeVoice"},{"type":"text","text":", "},{"code":".decoration","type":"codeVoice"},{"type":"text","text":", "},{"code":".tuplet","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":".slur","type":"codeVoice"},{"type":"text","text":", "},{"code":".chordSymbol","type":"codeVoice"},{"type":"text","text":", "},{"code":".inlineField","type":"codeVoice"},{"type":"text","text":", and so on."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Leaf values are wrapped in small validating types — for instance "},{"type":"reference","identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCText","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCReferenceNumber","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCVoice\/ID-swift.struct","isActive":true},{"type":"text","text":", and "},{"type":"reference","identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCClef\/Name-swift.struct","isActive":true},{"type":"text","text":" — each of which"},{"type":"text","text":" "},{"type":"text","text":"exposes an "},{"code":"isValid(_:)","type":"codeVoice"},{"type":"text","text":" check and a failable initializer that returns "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"for out-of-range input. Others, like "},{"type":"reference","identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCLength","isActive":true},{"type":"text","text":", validate internally in a"},{"type":"text","text":" "},{"type":"text","text":"failable initializer without a public "},{"code":"isValid(_:)","type":"codeVoice"},{"type":"text","text":" check. All AST types are"},{"type":"text","text":" "},{"code":"Equatable","type":"codeVoice"},{"type":"text","text":" and "},{"code":"Sendable","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCTunebook","isActive":true},{"type":"text","text":" equality compares "},{"code":"version","type":"codeVoice"},{"type":"text","text":", "},{"code":"fileHeader","type":"codeVoice"},{"type":"text","text":", and "},{"code":"tunes","type":"codeVoice"},{"type":"text","text":" only;"},{"type":"text","text":" "},{"type":"text","text":"the "},{"code":"isNormalized","type":"codeVoice"},{"type":"text","text":" and "},{"code":"isValidated","type":"codeVoice"},{"type":"text","text":" flags are metadata and are excluded."}],"type":"paragraph"},{"level":2,"text":"Building a tunebook programmatically","anchor":"Building-a-tunebook-programmatically","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can construct the AST directly rather than parsing text. Leaf initializers"},{"text":" ","type":"text"},{"text":"are failable, returning ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" when their validity constraints are not met:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let refNumber = ABCReferenceNumber(uintValue: 1)!","let title     = ABCText(stringValue: \"Cooley's\")!","let key       = ABCKeySignature.standard(.init(tonic: .e,","                                               mode: .dorian)!)","","let header: [ABCHeaderEntry] = [","    .field(.referenceNumber(refNumber)),  \/\/ X:1","    .field(.tuneTitle(title)),            \/\/ T:Cooley's","    .field(.key(key)),                    \/\/ K:Edor","]","","let tune     = ABCTune(header: header,","                       body: [])!","let tunebook = ABCTunebook(fileHeader: [],","                           tunes: [tune])!"]},{"type":"paragraph","inlineContent":[{"text":"A directly-constructed tunebook has ","type":"text"},{"code":"isNormalized == false","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"isValidated == false","type":"codeVoice"},{"text":" — exactly like one fresh out of the parser — so you must run it through","type":"text"},{"text":" ","type":"text"},{"text":"the normalizer and validator before formatting.","type":"text"}]},{"anchor":"Error-handling","level":2,"text":"Error handling","type":"heading"},{"inlineContent":[{"text":"Thrown errors conform to ","type":"text"},{"type":"codeVoice","code":"EnhancedError"},{"text":" (from","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/eBardX\/XestiTools"},{"text":"): each has a ","type":"text"},{"type":"codeVoice","code":"category"},{"text":" of","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"\"IvorABC\""},{"text":" and a human-readable ","type":"text"},{"type":"codeVoice","code":"message"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"table","alignments":["left","left"],"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Type","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Thrown by","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCParser\/Error"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ABCParser.parse(_:)"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCValidator\/Error","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ABCValidator.validate(_:)"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCFormatter\/Error","type":"reference","isActive":true}]}],[{"inlineContent":[{"type":"codeVoice","code":"ABCFormatter.format(_:)"}],"type":"paragraph"}]]],"header":"row"},{"inlineContent":[{"type":"codeVoice","code":"ABCNormalizer.normalize(_:)"},{"text":" never throws — normalization has no failure mode.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Non-fatal results are returned rather than thrown, and each also provides a","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"message"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"table","alignments":["left","left"],"rows":[[[{"inlineContent":[{"text":"Type","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Returned by","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCParser\/Diagnostic","type":"reference","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"parse(_:)"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCNormalizer\/Change","type":"reference","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"no