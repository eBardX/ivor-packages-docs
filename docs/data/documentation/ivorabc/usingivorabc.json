ame+","type":"codeVoice"},{"text":" decorations → the standard ","type":"text"},{"code":"!name!","type":"codeVoice"},{"text":" form.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Dropping stale directives (","type":"text"},{"type":"codeVoice","code":"%%abc-charset"},{"text":", ","type":"text"},{"type":"codeVoice","code":"%%abc-version"},{"text":", ","type":"text"},{"type":"codeVoice","code":"%%decoration +"},{"text":").","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each "},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCNormalizer\/Change"},{"type":"text","text":" case ("},{"type":"codeVoice","code":"clearedBeatMultiplier"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"convertedDecoration"},{"type":"text","text":", "},{"type":"codeVoice","code":"removedDirective"},{"type":"text","text":", "},{"type":"codeVoice","code":"replacedField"},{"type":"text","text":") carries the affected"},{"type":"text","text":" "},{"type":"text","text":"value, so you can present a precise change log rather than just a count."}]},{"anchor":"Validating","level":2,"text":"Validating","type":"heading"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCValidator","type":"reference","isActive":true},{"type":"text","text":" checks a "},{"inlineContent":[{"type":"text","text":"normalized"}],"type":"strong"},{"type":"text","text":" tunebook against the ABC 2.1"},{"type":"text","text":" "},{"type":"text","text":"specification:"}]},{"code":["let (validated, issues) = try ABCValidator().validate(normalized)","","if issues.isEmpty {","    \/\/ `validated.isValidated` is now true.","} else {","    issues.forEach { print($0.message) }","}"],"type":"codeListing","syntax":"swift"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"If the tunebook has 