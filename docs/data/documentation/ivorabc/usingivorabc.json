 ","type":"text"},{"identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCParser\/Diagnostic","type":"reference","isActive":true},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Diagnostics are always returned, never thrown; each has a human-readable","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"message"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["for diagnostic in diagnostics {","    print(diagnostic.message)","}"],"type":"codeListing"},{"inlineContent":[{"text":"Diagnostics cover recoverable situations such as a deprecated tempo form","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"Q:120"},{"text":"), a duplicate ","type":"text"},{"type":"codeVoice","code":"%%abc-charset"},{"text":", an unrecognized character set, a","type":"text"},{"text":" ","type":"text"},{"text":"malformed version string, or a skipped unrecognizable line.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Unrecoverable problems are thrown as an ","type":"text"},{"identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCParser\/Error","type":"reference","isActive":true},{"text":", for example","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":".invalidField(_:_:)"},{"text":", ","type":"text"},{"type":"codeVoice","code":".invalidKeySignature(_:)"},{"text":", ","type":"text"},{"type":"codeVoice","code":".orphanedContinuation"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":".unmatchedBeginDirective(_:)"},{"text":", or ","type":"text"},{"type":"codeVoice","code":".missingTunes"},{"text":". Like all IvorABC errors it","type":"text"},{"text":" ","type":"text"},{"text":"conforms to ","type":"text"},{"type":"codeVoice","code":"EnhancedError"},{"text":" and provides a ","type":"text"},{"type":"codeVoice","code":"message"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["do {","    let (tunebook, _) = try ABCParser().parse(data)","} catch let error as ABCParser.Error {","    print(error.message)","}"],"type":"codeListing"},{"level":2,"type":"heading","anchor":"Normalizing","text":"Normalizing"},{"inlineContent":[{"identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCNormalizer","type":"reference","isActive":true},{"text":" upgrades legacy and deprecated constructs to their ABC 2.1","type":"text"},{"text":" ","type":"text"},{"text":"equivalents, returning a new tunebook whose ","type":"text"},{"type":"codeVoice","code":"isNormalized"},{"text":" flag is ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"text":"whose ","type":"text"},{"type":"codeVoice","code":"version"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"ABCVersion.current"},{"text":", together with a list of the changes it","type":"text"},{"text":" ","type":"text"},{"text":"applied:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let (normalized, changes) = ABCNormalizer().normalize(tunebook)","","for change in changes {","    print(change.message)          \/\/ what was changed","    print(change.tuneIndex ?? -1)  \/\/ which tune, or nil for the file header","}"],"type":"codeListing"},{"inlineContent":[{"text":"Normalization performs conversions such as:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"E:"},{"text":" (elemskip) and legacy ","type":"text"},{"type":"codeVoice","code":"I:"},{"text":" (information) fields → ","type":"text"},{"type":"codeVoice","code":"r:"},{"text":" (remark).","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Deprecated C-form tempos (","type":"text"},{"type":"codeVoice","code":"Q:C=rate"},{"text":") resolved against the active ","type":"text"},{"type":"codeVoice","code":"L:"},{"text":"\/","type":"text"},{"type":"codeVoice","code":"M:"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"+name+","type":"codeVoice"},{"text":" decorations → the standard ","type":"text"},{"type":"codeVoice","code":"!name!"},{"text":" form.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Dropping stale directives (","type":"text"},{"code":"%%abc-charset","type":"codeVoice"},{"text":", ","type":"text"},{"code":"%%abc-version","type":"codeVoice"},{"text":", ","type":"text"},{"type":"codeVoice","code":"%%decoration +"},{"text":").","type":"text"}]}]}]},{"inlineContent":[{"text":"Each ","type":"text"},{"identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCNormalizer\/Change","type":"reference","isActive":true},{"text":" case (","type":"text"},{"type":"codeVoice","code":"clearedBeatMultiplier"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"convertedDecoration"},{"text":", ","type":"text"},{"type":"codeVoice","code":"removedDirective"},{"text":", ","type":"text"},{"type":"codeVoice","code":"replacedField"},{"text":") carries the affected","type":"text"},{"text":" ","type":"text"},{"text":"value, so you can present a precise change log rather than just a count.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","anchor":"Validating","text":"Validating"},{"inlineContent":[{"identifier":"doc:\/\/IvorABC\/documentation\/IvorABC\/ABCValidator","type":"reference","isActive":true},{"text":" checks a ","type":"text"},{"inlineContent":[{"text":"normalized","type":"text"}],"type":"strong"},{"text":" tunebook against the ABC 2.1","type":"text"},{"text":" ","type":"text"},{"text":"specification:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let (validated, issues) = try ABCValidator().validate(normalized)","","if issues.isEmpty {","    \/\/ `validated.isValidated` is now true.","} else {","    issues.forEach { print($0.message) }","}"],"type":"codeListing"},{"type":"unorderedList","items":[{"content":[{"inlineCo