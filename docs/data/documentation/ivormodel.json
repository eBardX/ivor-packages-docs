argets","kind":"identifier"}],"url":"\/documentation\/ivormodel\/maptargets","title":"MapTargets","navigatorTitle":[{"text":"MapTargets","kind":"identifier"}]},"doc://IvorModel/documentation/IvorModel/NoteEvent":{"type":"topic","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/NoteEvent","url":"\/documentation\/ivormodel\/noteevent","abstract":[{"text":"A musical note event consisting of a set of tied pitches and a duration.","type":"text"}],"role":"symbol","kind":"symbol","navigatorTitle":[{"text":"NoteEvent","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NoteEvent","kind":"identifier"}],"title":"NoteEvent"},"doc://IvorModel/documentation/IvorModel/Instrument":{"type":"topic","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/Instrument","url":"\/documentation\/ivormodel\/instrument","abstract":[{"text":"An instrument designation represented as a validated string.","type":"text"}],"role":"symbol","kind":"symbol","navigatorTitle":[{"text":"Instrument","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Instrument","kind":"identifier"}],"title":"Instrument"},"doc://IvorModel/documentation/IvorModel/TemplateDuration":{"type":"topic","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/TemplateDuration","url":"\/documentation\/ivormodel\/templateduration","abstract":[{"text":"A duration type that a template can analyze in relative terms: as a ratio to the previous","type":"text"},{"text":" ","type":"text"},{"text":"duration.","type":"text"}],"role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"TemplateDuration"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"TemplateDuration"}],"title":"TemplateDuration"},"doc://IvorModel/documentation/IvorModel/UsingIvorModel":{"abstract":[{"text":"Build, transform, convert, and analyze musical works, and generate ne