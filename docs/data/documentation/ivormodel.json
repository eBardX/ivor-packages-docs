ext":" "},{"type":"text","text":"validated string."}],"url":"\/documentation\/ivormodel\/noteid","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NoteID","kind":"identifier"}],"navigatorTitle":[{"text":"NoteID","kind":"identifier"}],"identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/NoteID","type":"topic","title":"NoteID"},"doc://IvorModel/documentation/IvorModel/Part":{"type":"topic","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/Part","abstract":[{"text":"A named musical part containing a note table and its parameter maps.","type":"text"}],"url":"\/documentation\/ivormodel\/part","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"Part","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Part","kind":"identifier"}],"title":"Part"},"doc://IvorModel/documentation/IvorModel/PatchTable/Assignment":{"type":"topic","url":"\/documentation\/ivormodel\/patchtable\/assignment","abstract":[{"text":"How an ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/Instrument"},{"text":" is realized when a part plays: the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/Patch"},{"text":" it sounds as and,","type":"text"},{"text":" ","type":"text"},{"text":"optionally, the MIDI channel it plays on.","type":"text"}],"identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/PatchTable\/Assignment","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"Assignment","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Assignment","kind":"identifier"}],"title":"PatchTable.Assignment"},"doc://IvorModel/documentation/IvorModel/PanMap":{"abstract":[{"text":"A time-indexed map of spatial pan positions with a configurable default.","type":"text"}],"type":"topic","identifie