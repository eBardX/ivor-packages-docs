{"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","topicSections":[{"identifiers":["doc:\/\/IvorModel\/documentation\/IvorModel\/TemplateDuration","doc:\/\/IvorModel\/documentation\/IvorModel\/TemplatePitch","doc:\/\/IvorModel\/documentation\/IvorModel\/UniqueID"],"generated":true,"anchor":"Protocols","title":"Protocols"},{"identifiers":["doc:\/\/IvorModel\/documentation\/IvorModel\/Credit","doc:\/\/IvorModel\/documentation\/IvorModel\/Dynamic","doc:\/\/IvorModel\/documentation\/IvorModel\/DynamicMap","doc:\/\/IvorModel\/documentation\/IvorModel\/EntryID","doc:\/\/IvorModel\/documentation\/IvorModel\/Instrument","doc:\/\/IvorModel\/documentation\/IvorModel\/InstrumentMap","doc:\/\/IvorModel\/documentation\/IvorModel\/MapTargets","doc:\/\/IvorModel\/documentation\/IvorModel\/NoteEvent","doc:\/\/IvorModel\/documentation\/IvorModel\/NoteID","doc:\/\/IvorModel\/documentation\/IvorModel\/NoteTable","doc:\/\/IvorModel\/documentation\/IvorModel\/Pan","doc:\/\/IvorModel\/documentation\/IvorModel\/PanMap","doc:\/\/IvorModel\/documentation\/IvorModel\/Part","doc:\/\/IvorModel\/documentation\/IvorModel\/PartID","doc:\/\/IvorModel\/documentation\/IvorModel\/Patch","doc:\/\/IvorModel\/documentation\/IvorModel\/PatchTable","doc:\/\/IvorModel\/documentation\/IvorModel\/Project","doc:\/\/IvorModel\/documentation\/IvorModel\/Realization","doc:\/\/IvorModel\/documentation\/IvorModel\/RealizationID","doc:\/\/IvorModel\/documentation\/IvorModel\/Remark","doc:\/\/IvorModel\/documentation\/IvorModel\/RightsNotice","doc:\/\/IvorModel\/documentation\/IvorModel\/Template","doc:\/\/IvorModel\/documentation\/IvorModel\/TemplateID","doc:\/\/IvorModel\/documentation\/IvorModel\/Work","doc:\/\/IvorModel\/documentation\/IvorModel\/WorkID"],"generated":true,"anchor":"Structures","title":"Structures"}],"sections":[],"hierarchy":{"paths":[[]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormodel"]}],"abstract":[{"type":"text","text":"A representation-agnostic musical composition model."}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"IvorModel is the foundational data-modeling framework for the Ivor music","type":"text"},{"text":" ","type":"text"},{"text":"ecosystem, providing a representation-agnostic model for musical compositions,","type":"text"},{"text":" ","type":"text"},{"text":"written in Swift.","type":"text"}]},{"inlineContent":[{"type":"text","text":"Designed as a flexible composer’s assistant, IvorModel bridges the gap between"},{"type":"text","text":" "},{"type":"text","text":"abstract symbolic notation and physical audio performance through a unified,"},{"type":"text","text":" "},{"type":"text","text":"dual-paradigm architecture. Compositions are organized as projects containing"},{"type":"text","text":" "},{"type":"text","text":"works, each broken into parts with note events, dynamics, panning, and"},{"type":"text","text":" "},{"type":"text","text":"instrumentation — all captured at a level natural to a composer, without being"},{"type":"text","text":" "},{"type":"text","text":"tied to any particular notation system, audio format, or instrument family."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A template system rounds out the model, enabling analysis of existing works and"},{"type":"text","text":" "},{"type":"text","text":"algorithmic generation of new, derived ones. Together these capabilities make it"},{"type":"text","text":" "},{"type":"text","text":"straightforward to aggregate, analyze, and transform musical data from disparate"},{"type":"text","text":" "},{"type":"text","text":"sources before exporting to any destination."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The model is oriented toward Western musical traditions but is not confined to"},{"type":"text","text":" "},{"type":"text","text":"Western classical music, and aims 