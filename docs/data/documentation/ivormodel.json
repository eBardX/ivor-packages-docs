{"hierarchy":{"paths":[[]]},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"type":"text","text":"IvorModel is the foundational data-modeling framework for the Ivor music"},{"type":"text","text":" "},{"type":"text","text":"ecosystem, providing a representation-agnostic model for musical compositions,"},{"type":"text","text":" "},{"type":"text","text":"written in Swift."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Designed as a flexible composer’s assistant, IvorModel bridges the gap between"},{"type":"text","text":" "},{"text":"abstract symbolic notation and physical audio performance through a unified,","type":"text"},{"text":" ","type":"text"},{"text":"dual-paradigm architecture. Compositions are organized as projects containing","type":"text"},{"text":" ","type":"text"},{"text":"works, each broken into parts with note events, dynamics, panning, and","type":"text"},{"text":" ","type":"text"},{"text":"instrumentation — all captured at a level natural to a composer, without being","type":"text"},{"text":" ","type":"text"},{"text":"tied to any particular notation system, audio format, or instrument family.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A template system rounds out the model, enabling analysis of existing works and"},{"text":" ","type":"text"},{"type":"text","text":"algorithmic generation of new, derived ones. Together these capabilities make it"},{"text":" ","type":"text"},{"type":"text","text":"straightforward to aggregate, analyze, and transform musical data from disparate"},{"type":"text","text":" "},{"type":"text","text":"sources before exporting to any destination."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The model is oriented toward Western musical traditions but is not confined to"},{"type":"text","text":" "},{"type":"text","text":"Western classical music, and aims to accommodate a broader range of musical"},{"type":"text","text":" "},{"type":"text","text":"practice where possible."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import IvorModel","import IvorTiming","import IvorTuning","","\/\/ A work in beat time and standard pitch, with one part.","var work = Work(name: \"Etude\",","                content: .empty(timeBasis: .beat,","                                pitchNotation: .standard))","let melody = try work.addPart(name: \"Melody\")","","\/\/ Seven quarter notes. Beat time counts whole notes, so a quarter note is 1\/4.","let pitches = [\"C4\", \"E4\", \"G4\", \"E4\", \"C4\", \"G3\", \"C4\"]","","try work.modifyPart(melody, as: Part<BeatTime, Pitch>.self) { part in","    var attack = BeatTime.zero","","    for name in pitches {","        part.noteTable.insert(attack: attack,","                              duration: .quarter,","                              pitch: Pitch(plain: name)!)","        attack += .quarter","    }","}","","\/\/ In 3\/4, starting with a one-beat pickup.","try work.modifyMeterTable { table in","    _ = try? table.insert(beatTime: .zero, meter: Meter(plain: \"3\/4\")!)","    try? table.setPickup(.quarter)","}","","\/\/ Transpose it up a fifth, then convert it to wall time and MIDI note numbers.","try work.transpose(by: DirectedInterval(interval: .perfect5,","                                        direction: .ascending))","","let midi = try work.convert(timeBasis: .wall,","                            pitchNotation: .keyboard)!","","\/\/ Learn the melody, and generate a 12-note variation of it.","let template = try Template.analyzeNoteEvents(in: work,","                                              at: 0,","                                              maximumOrder: 2,","                                              name: \"Melody\")","let options  = Template.GenerationOptions<BeatTime, Pitch>(order: 1,","                                                           length: .noteCount(12),","                                                           stopsAtEnd: false)","let variation = try template.generateWork(name: \"Variation\",","                                          partName: \"Melody\",","                                          options: options,","                                          seed: 42)","","\/\/ Keep them in a project, and save it.","var project = Project()","","project.updateWork(work)","project.updateTemplate(template)","","let file = try project.save()               \/\/ a FileWrapper"]},{"inlineContent":[{"type":"text","text":"See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorModel\/documentation\/IvorModel\/UsingIvorModel"},{"type":"text","text":" for a full guide to works, parts, notes, parameter"},{"type":"text","text":" "},{"type":"text","text":"maps, pedals, meters, transforms, conversion, realizations, templates, and projects."}],"type":"paragraph"}]}],"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormodel"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorModel\/documentation\/IvorModel"},"metadata":{"color":{"standardColorIdentifier":"blue"},"role":"collection","title":"IvorModel","externalID":"IvorModel","modules":[{"name":"IvorModel"}],"symbolKind":"module","roleHeading":"Framework"},"sections":[],"abstract":[{"type":"text","text":"A representation-agnostic musical composition model."}],"topicSections":[{"title":"Guides","identifiers":["doc:\/\/IvorModel\/documentation\/IvorModel\/UsingIvorModel"],"anchor":"Guides"},{"title":"Projects and works","identifiers":["doc:\/\/IvorModel\/documentation\/IvorModel\/Project","doc:\/\/IvorModel\/documentation\/IvorModel\/Work"],"anchor":"Projects-and-works"},{"title":"Parts and notes","identifiers":["doc:\/\/IvorModel\/documentation\/IvorModel\/Part","doc:\/\/IvorModel\/documentation\/IvorModel\/NoteTable","doc:\/\/IvorModel\/documentation\/IvorMo