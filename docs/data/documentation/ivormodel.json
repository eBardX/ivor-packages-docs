{"hierarchy":{"paths":[[]]},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorModel\/documentation\/IvorModel"},"topicSections":[{"title":"Structures","anchor":"Structures","generated":true,"identifiers":["doc:\/\/IvorModel\/documentation\/IvorModel\/Dynamic","doc:\/\/IvorModel\/documentation\/IvorModel\/DynamicMap","doc:\/\/IvorModel\/documentation\/IvorModel\/Instrument","doc:\/\/IvorModel\/documentation\/IvorModel\/InstrumentMap","doc:\/\/IvorModel\/documentation\/IvorModel\/NoteEvent","doc:\/\/IvorModel\/documentation\/IvorModel\/NoteTable","doc:\/\/IvorModel\/documentation\/IvorModel\/Pan","doc:\/\/IvorModel\/documentation\/IvorModel\/PanMap","doc:\/\/IvorModel\/documentation\/IvorModel\/Part","doc:\/\/IvorModel\/documentation\/IvorModel\/PartID","doc:\/\/IvorModel\/documentation\/IvorModel\/Project","doc:\/\/IvorModel\/documentation\/IvorModel\/Template","doc:\/\/IvorModel\/documentation\/IvorModel\/TemplateID","doc:\/\/IvorModel\/documentation\/IvorModel\/Work","doc:\/\/IvorModel\/documentation\/IvorModel\/WorkID"]}],"abstract":[{"type":"text","text":"A representation-agnostic musical composition model."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivormodel"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"inlineContent":[{"type":"text","text":"IvorModel is the foundational data-modeling framework for the Ivor music"},{"type":"text","text":" "},{"type":"text","text":"ecosystem, providing a representation-agnostic model for musical compositions,"},{"type":"text","text":" "},{"type":"text","text":"written in Swift."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Designed as a flexible composer’s assistant, IvorModel bridges the gap between"},{"type":"text","text":" "},{"type":"text","text":"abstract symbolic notation and physical audio performance through a unified,"},{"type":"text","text":" "},{"type":"text","text":"dual-paradigm architecture. Compositions are organized as projects containing"},{"type":"text","text":" "},{"type":"text","text":"works, each broken into parts with note events, dynamics, panning, and"},{"type":"text","text":" "},{"type":"text","text":"instrumentation — all captured at a level natural to a composer, without being"},{"type":"text","text":" "},{"type":"text","text":"tied to any particular notation system, audio format, or instrument family."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A template system rounds out the model, enabling analysis of existing works and"},{"type":"text","text":" "},{"type":"text","text":"algorithmic generation of new, derived ones. Together these capabilities make it"},{"type":"text","text":" "},{"type":"text","text":"straightforward to aggregate, analyze, and transform musical data from disparate"},{"type":"text","text":" "},{"type":"text","text":"sources before exporting to any destination."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The model is oriented toward Western musical traditions but is not confined to"},{"type":"text","text":" "},{"type":"text","text":"Western classical music, and aims to accommodate a broader range of musical"},{"type":"text","text":" "},{"type":"text","text":"practice where possible."}],"type":"paragraph"}],"kind":"content"}],"metadata":{"role":"collection","color":{"standardColorIdentifier":"blue"},"title":"IvorModel","symbolKind":"module","modules":[{"name":"IvorModel"}],"roleHeading":"Framework","externalID":"IvorModel"},"kind":"symbol","references":{"doc://IvorModel/documentation/IvorModel/InstrumentMap":{"abstract":[{"text":"A time-indexed map of instrument designations with a configurable default.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"InstrumentMap"}],"url":"\/documentation\/ivormodel\/instrumentmap","navigatorTitle":[{"kind":