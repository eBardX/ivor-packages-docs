{"topicSections":[{"title":"Initializers","anchor":"Initializers","generated":true,"identifiers":["doc:\/\/IvorConnect\/documentation\/IvorConnect\/MIDIRouter\/init(channelOutputs:)","doc:\/\/IvorConnect\/documentation\/IvorConnect\/MIDIRouter\/init(outputs:)"]},{"title":"Instance Methods","generated":true,"identifiers":["doc:\/\/IvorConnect\/documentation\/IvorConnect\/MIDIRouter\/outputs(forChannel:)","doc:\/\/IvorConnect\/documentation\/IvorConnect\/MIDIRouter\/reset()","doc:\/\/IvorConnect\/documentation\/IvorConnect\/MIDIRouter\/send(message:at:)","doc:\/\/IvorConnect\/documentation\/IvorConnect\/MIDIRouter\/setOutput(_:forChannel:)","doc:\/\/IvorConnect\/documentation\/IvorConnect\/MIDIRouter\/waitUntilDelivered()"],"anchor":"Instance-Methods"}],"hierarchy":{"paths":[["doc:\/\/IvorConnect\/documentation\/IvorConnect"]]},"identifier":{"url":"doc:\/\/IvorConnect\/documentation\/IvorConnect\/MIDIRouter","interfaceLanguage":"swift"},"seeAlsoSections":[{"title":"Routing","identifiers":["doc:\/\/IvorConnect\/documentation\/IvorConnect\/MIDIOutputChoice"],"anchor":"Routing","generated":true}],"metadata":{"roleHeading":"Class","modules":[{"name":"IvorConnect"}],"externalID":"s:11IvorConnect10MIDIRouterC","title":"MIDIRouter","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"MIDIRouter"}],"role":"symbol","symbolKind":"class","navigatorTitle":[{"text":"MIDIRouter","kind":"identifier"}]},"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","abstract":[{"text":"Delivers each MIDI channel message to its channel’s outputs, keeping","type":"text"},{"type":"text","text":" "},{"type":"text","text":"timestamps in order across all of them."}],"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"final"},{"kind":"text","text":" "},{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"MIDIRouter"}],"