{"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"paths":["\/documentation\/ivorconnect\/midirouter"],"traits":[{"interfaceLanguage":"swift"}]}],"topicSections":[{"title":"Initializers","identifiers":["doc:\/\/IvorConnect\/documentation\/IvorConnect\/MIDIRouter\/init(channelOutputs:)","doc:\/\/IvorConnect\/documentation\/IvorConnect\/MIDIRouter\/init(outputs:)"],"generated":true,"anchor":"Initializers"},{"title":"Instance Methods","identifiers":["doc:\/\/IvorConnect\/documentation\/IvorConnect\/MIDIRouter\/broadcast(message:at:)","doc:\/\/IvorConnect\/documentation\/IvorConnect\/MIDIRouter\/outputs(forChannel:)","doc:\/\/IvorConnect\/documentation\/IvorConnect\/MIDIRouter\/reset()","doc:\/\/IvorConnect\/documentation\/IvorConnect\/MIDIRouter\/send(message:at:)","doc:\/\/IvorConnect\/documentation\/IvorConnect\/MIDIRouter\/send(message:forChannel:at:)","doc:\/\/IvorConnect\/documentation\/IvorConnect\/MIDIRouter\/setOutput(_:forChannel:)","doc:\/\/IvorConnect\/documentation\/IvorConnect\/MIDIRouter\/waitUntilDelivered()"],"generated":true,"anchor":"Instance-Methods"}],"seeAlsoSections":[{"generated":true,"anchor":"Routing","title":"Routing","identifiers":["doc:\/\/IvorConnect\/documentation\/IvorConnect\/MIDIOutputChoice"]}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"final"},{"kind":"text","text":" "},{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"MIDIRouter"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"mentions":["doc:\/\/IvorConnect\/documentation\/IvorConnect\/UsingIvorConnect"],"kind":"mentions"},{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Messages are usually scheduled slightly ahead of time, so a message sent"},{"type":"text","text":" "},{"type":"text","text":"“now” (say, a note-off from a key press) is held back to the latest time"},{"type":"text","text":" "},{"type":"text","text":"already scheduled. Otherwise it could arrive before an earlier-sent but"},{"type":"text","text":" "},{"type":"text","text":"later-sounding note-on, leaving that note hanging."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A router either sends every channel to the same outputs"},{"type":"text","text":" "},{"type":"text","text":"("},{"identifier":"doc:\/\/IvorConnect\/documentation\/IvorConnect\/MIDIRouter\/init(outputs:)","isActive":true,"type":"reference"},{"type":"text","text":"), or gives some channels outputs of their own"},{"type":"text","text":" "},{"type":"text","text":"("},{"identifier":"doc:\/\/IvorConnect\/documentation\/IvorConnect\/MIDIRouter\/init(channelOutputs:)","isActive":true,"type":"reference"},{"type":"text","text":"). In the second case, the remaining channels"},{"type":"text","text":" "},{"type":"text","text":"go to every output in use, so that messages such as all-notes-off reach"},{"type":"text","text":" "},{"type":"text","text":"all of them."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A system message has no channel, so a router can’t choose outputs for it. A"},{"type":"text","text":" "},{"type":"text","text":"message for one device goes directly to that device’s output, or through"},{"type":"text","text":" "},{"identifier":"doc:\/\/IvorConnect\/documentation\/IvorConnect\/MIDIRouter\/send(message:forChannel:at:)","isActive":true,"type":"reference"},{"type":"text","text":" to keep it on the router’s timeline, and"},{"type":"text","text":" "},{"identifier":"doc:\/\/IvorConnect\/documentation\/IvorConnect\/MIDIRouter\/broadcast(message:at:)","isActive":true,"type":"reference"},{"type":"text","text":" sends a message to every output in use."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A router is not thread-safe. Protect it with a lock if it is shared."}]}],"kind":"content"}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/IvorConnect\/documentation\/IvorConnect"]]},"identifier":{"url":"doc:\/\/IvorConnect\/documentation\/IvorConnect\/MIDIRouter","interfaceLanguage":"swift"},"metadata":{"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MIDIRouter"}],"roleHeading":"Class","symbolKind":"class","externalID":"s:11IvorConnect10MIDIRouterC","title":"MIDIRouter","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MIDIRouter","kind":"identifier"}],"modules":[{"name":"IvorConnect"}]},"sections":[],"abstract":[{"type":"text","text":"A router that delivers each MIDI channel message to its channel’s"},{"type":"text","text":" "},{"type":"text","text":"outputs, keeping timestamps in order across all of them."}],"references":{"doc://IvorConnect/documentation/IvorConnect/UsingIvorConnect":{"kind":"article","type":"topic","abstract":[{"text":"Play IvorMIDI channel messages on time, through CoreMIDI and Apple’s built-in","type":"text"},{"text":" ","type":"text"},{"text":"synth.","type":"text"}],"url":"\/documentation\/ivorconnect\/usingivorconnect","title":"Using IvorConnect","role":"article","identifier":"doc:\/\/IvorConnect\/documentation\/IvorConnect\/UsingIvorConnect"},"doc://IvorConnect/documentation/IvorConnect/MIDIRouter/send(message:forChannel:at:)":{"kind":"symbol","type":"topic","abstract":[{"text":"Sends a system message to the outputs of a channel.","type":"text"}],"url":"\/documentation\/ivorconnect\/midirouter\/send(message:forchannel:at:)","title":"send(message:forChannel:at:)","role":"symbol","identifier":"doc:\/\/IvorConnect\/documentation\/IvorConnect\/MIDIRouter\/send(message:forChannel:at:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"send"},{"kind":"text","text":"("},{"kind":"externalParam","text":"message"},{"kind":"text","text":": "},{"preciseIdentifier":"s:8IvorMIDI17MIDISystemMessageO","kind":"typeIdentifier","text":"MIDISystemMessage"},{"kind":"text","text":", "},{"kind":"externalParam","text":"forChannel"},