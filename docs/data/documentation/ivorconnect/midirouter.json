{"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"final"},{"text":" ","kind":"text"},{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"text":"MIDIRouter","kind":"identifier"}],"languages":["swift"]}]},{"kind":"mentions","mentions":["doc:\/\/IvorConnect\/documentation\/IvorConnect\/UsingIvorConnect"]},{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"text":"Messages are usually scheduled slightly ahead of time, so a message sent","type":"text"},{"text":" ","type":"text"},{"text":"“now” (say, a note-off from a key press) is held back to the latest time","type":"text"},{"text":" ","type":"text"},{"text":"already scheduled. Otherwise it could arrive before an earlier-sent but","type":"text"},{"text":" ","type":"text"},{"text":"later-sounding note-on, leaving that note hanging.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A router either sends every channel to the same outputs","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"isActive":true,"identifier":"doc:\/\/IvorConnect\/documentation\/IvorConnect\/MIDIRouter\/init(outputs:)","type":"reference"},{"text":"), or gives some channels outputs of their own","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"isActive":true,"identifier":"doc:\/\/IvorConnect\/documentation\/IvorConnect\/MIDIRouter\/init(channelOutputs:)","type":"reference"},{"text":"). In the second case, the remaining channels","type":"text"},{"text":" ","type":"text"},{"text":"go to every output in use, so that messages such as all-notes-off reach","type":"text"},{"text":" ","type":"text"},{"text":"all of them.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A system message has no channel, so a router can’t choose outputs for it. A","type":"text"},{"text":" ","type":"text"},{"text":"message for one device goes directly to that device’s output, or through","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/IvorConnect\/documentation\/IvorConnect\/MIDIRouter\/send(message:forChannel:at:)","type":"reference"},{"text":" to keep it on the router’s timeline, and","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/IvorConnect\/documentation\/IvorConnect\/MIDIRouter\/broadcast(message:at:)","type":"reference"},{"text":" sends a message to every output in use.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A router is not thread-safe. Protect it with a lock if it is shared.","type":"text"}],"type":"paragraph"}]}],"sections":[],"metadata":{"externalID":"s:11IvorConnect10MIDIRouterC","title":"MIDIRouter","symbolKind":"class","modules":[{"name":"IvorConnect"}],"roleHeading":"Class","fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"kind":"identifier","text":"MIDIRouter"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MIDIRouter"}]},"abstract":[{"text":"A router that delivers each MIDI channel message to its channel’s","type":"text"},{"text":" ","type":"text"},{"text":"outputs, keeping timestamps in order across all of them.","type":"text"}],"topicSections":[{"identifiers":["doc:\/\/IvorConnect\/documentation\/IvorConnect\/MIDIRouter\/init(channelOutputs:)","doc:\/\/IvorConnect\/documentation\/IvorConnect\/MIDIRouter\/init(outputs:)"],"generated":true,"anchor":"Initializers","title":"Initializers"},{"identifiers":["doc:\/\/IvorConnect\/documentation\/IvorConnect\/MIDIRouter\/broadcast(message:at:)","doc:\/\/IvorConnect\/documentation\/IvorConnect\/MIDIRouter\/outputs(forChannel:)","doc:\/\/IvorConnect\/documentation\/IvorConnect\/MIDIRouter\/reset()","doc:\/\/IvorConnect\/documentation\/IvorConnect\/MIDIRouter\/send(message:at:)","doc:\/\/IvorConnect\/documentation\/IvorConnect\/MIDIRouter\/send(message:forChannel:at:)","doc:\/\/IvorConnec