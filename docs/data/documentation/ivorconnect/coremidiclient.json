{"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"paths":["\/documentation\/ivorconnect\/coremidiclient"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"final"},{"kind":"text","text":" "},{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"CoreMIDIClient"}],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"type":"text","text":"A client lists the destinations available right now, and reports every"},{"type":"text","text":" "},{"type":"text","text":"change to the MIDI setup: a cable plugged in, an app launched, a"},{"type":"text","text":" "},{"type":"text","text":"destination renamed. Each destination output made with it is reconnected"},{"type":"text","text":" "},{"type":"text","text":"on every such change, so a destination that goes away is found again"},{"type":"text","text":" "},{"type":"text","text":"when it comes back."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Messages go out as MIDI 1.0 Universal MIDI Packets, timestamped with the"},{"type":"text","text":" "},{"type":"text","text":"host time at which they should sound."}],"type":"paragraph"},{"style":"important","name":"Important","content":[{"inlineContent":[{"type":"text","text":"CoreMIDI reports setup changes only on the run loop that"},{"type":"text","text":" "},{"type":"text","text":"was current when the process first used CoreMIDI. A"},{"type":"text","text":" "},{"type":"text","text":"client sets up a thread of its own for this, so create"},{"type":"text","text":" "},{"type":"text","text":"one before making any other CoreMIDI call (even listing"},{"type":"text","text":" "},{"type":"text","text":"the destinations) or setup changes may never be"},{"type":"text","text":" "},{"type":"text","text":"reported."}],"type":"paragraph"}]