{"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"paths":["\/documentation\/ivorconnect\/synthoutput"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"final"},{"kind":"text","text":" "},{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"SynthOutput"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each channel keeps its own program. Only the 128 programs of bank 0 are"},{"type":"text","text":" "},{"type":"text","text":"loaded at first; "},{"type":"reference","identifier":"doc:\/\/IvorConnect\/documentation\/IvorConnect\/SynthOutput\/preload(_:)","isActive":true},{"type":"text","text":" loads any other instrument a channel will"},{"type":"text","text":" "},{"type":"text","text":"select, such as a General MIDI Level 2 instrument or drum set. Every"},{"type":"text","text":" "},{"type":"text","text":"message is placed at its exact sample: messages wait in a time-ordered"},{"type":"text","text":" "},{"type":"text","text":"queue until shortly before they are due, then go to the render thread,"},{"type":"text","text":" "},{"type":"text","text":"which hands each one to the synth just before the buffer it falls in, with"},{"type":"text","text":" "},{"type":"text","text":"its offset into that buffer."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The synth’s audio engine restarts by itself after a configuration change"},{"type":"text","text":" "},{"type":"text","text":"(headphones plugged in, say) stops it. On iOS, restart it with"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/IvorConnect\/documentation\/IvorConnect\/SynthOutput\/restart()","isActive":true},{"type":"text","text":" after an audio session interruption ends."}]},{"content":[{"type":"paragr