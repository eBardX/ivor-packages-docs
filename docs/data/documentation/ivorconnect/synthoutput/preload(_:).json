re set back to"},{"type":"text","text":" "},{"type":"text","text":"bank 0. Call it only while nothing is playing through the synth."}],"type":"paragraph"},{"style":"note","name":"Throws","content":[{"inlineContent":[{"type":"text","text":""},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorConnect\/documentation\/IvorConnect\/SynthOutput\/Error\/instrumentPreloadFailed(_:)"},{"type":"text","text":" if the synth fails"},{"type":"text","text":" "},{"type":"text","text":"to load them."}],"type":"paragraph"}],"type":"aside"}]}],"references":{"doc://IvorConnect/documentation/IvorConnect/SynthOutput":{"role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SynthOutput","kind":"identifier"}],"navigatorTitle":[{"text":"SynthOutput","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/IvorConnect\/documentation\/IvorConnect\/SynthOutput","abstract":[{"text":"A MIDI output that plays on Apple’s multitimbral MIDI synth","type":"text"},{"text":" ","type":"text"},{"text":"(AUMIDISynth), loaded with a General MIDI sound bank, so that music can","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"be heard with no other software."}],"url":"\/documentation\/ivorconnect\/synthoutput","title":"SynthOutput","type":"topic"},"doc://IvorConnect/documentation/IvorConnect/SynthOutput/preload(_:)":{"identifier":"doc:\/\/IvorConnect\/documentation\/IvorConnect\/SynthOutput\/preload(_:)","title":"preload(_:)","abstract":[{"text":"Loads the instruments that the provided selections choose, so that","type":"text"},{"text":" ","type":"text"},{"text":"they sound.","type":"text"}],"kind":"symbol","type":"topic","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"preload","kind":"identifier"},{"text":"(","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:ST","text":"Sequence","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text