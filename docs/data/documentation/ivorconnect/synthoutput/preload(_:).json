{"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"text":"Loads the instruments that the provided selections choose, so that","type":"text"},{"text":" ","type":"text"},{"text":"they sound.","type":"text"}],"identifier":{"url":"doc:\/\/IvorConnect\/documentation\/IvorConnect\/SynthOutput\/preload(_:)","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/ivorconnect\/synthoutput\/preload(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","sections":[],"metadata":{"extendedModule":"IvorConnect","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"preload"},{"kind":"text","text":"("},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:ST","text":"Sequence"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Selection","preciseIdentifier":"s:11IvorConnect11SynthOutputC9SelectionV"},{"kind":"text","text":">) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Error","preciseIdentifier":"s:11IvorConnect11SynthOutputC5ErrorO"},{"kind":"text","text":")"}],"title":"preload(_:)","symbolKind":"method","modules":[{"name":"IvorConnect"}],"roleHeading":"Instance Method","role":"symbol","externalID":"s:11IvorConnect11SynthOutputC7preloadyyxAC5ErrorOYKSTRzAC9SelectionV7ElementRtzlF"},"hierarchy":{"paths":[["doc:\/\/IvorConnect\/documentation\/IvorConnect","doc:\/\/IvorConnect\/documentation\/IvorConnect\/SynthOutput"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"preload","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"selections","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sequence","kind":"typeIdentifier","preciseId