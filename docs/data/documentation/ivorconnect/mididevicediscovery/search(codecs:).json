{"sections":[],"hierarchy":{"paths":[["doc:\/\/IvorConnect\/documentation\/IvorConnect","doc:\/\/IvorConnect\/documentation\/IvorConnect\/MIDIDeviceDiscovery"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"Asks each address of each codec for a tuning, and returns the first"},{"type":"text","text":" "},{"type":"text","text":"device that replies with one the codec understands."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"search"},{"kind":"text","text":"("},{"kind":"externalParam","text":"codecs"},{"kind":"text","text":": ["},{"kind":"keyword","text":"any"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"MIDITuningCodec","preciseIdentifier":"s:8IvorMIDI15MIDITuningCodecP"},{"kind":"text","text":"]) "},{"kind":"keyword","text":"async"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"MIDIDevice","preciseIdentifier":"s:8IvorMIDI10MIDIDeviceV"},{"kind":"text","text":"?"}]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The codecs to try, in order. Nothing is sent to a","type":"text"},{"text":" ","type":"text"},{"text":"device unless the caller asks for it here.","type":"text"}]}],"name":"codecs"}]},{"kind":"content","content":[{"type":"heading","anchor":"return-value","level":2,"text":"Return Value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The first device found, or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" if there is none."}]}]},{"kind":"content","content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A device found this way has the codec and the address that worked, but"},{"type":"text","text":" "},{"type":"text","text":"no model. A reply can’t name a model, because models share formats. Its"},{"type":"text","text":" "},{"type":"text","text":"address is the one that was asked, not one from the reply, because a"},{"type":"text","text":" "},{"type":"text","text":"device can reply on a different channel."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each address waits for the full timeout, so a search of a codec with 16"},{"type":"text","text":" "},{"type":"text","text":"addresses takes 16 timeouts if nothing replies. Use a timeout longer than"},{"type":"text","text":" "},{"type":"text","text":"a dump takes to arrive, or a late reply could be credited to the next"},{"type":"text","text":" "},{"type":"text","text":"address."}]}]}],"kind":"symbol","metadata":{"modules":[{"name":"IvorConnect"}],"title":"search(codecs:)","role":"symbol","symbolKind":"method","roleHeading":"Instance Method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"search"},{"kind":"text","text":"("},{"kind":"externalParam","text":"codecs"},{"kind":"text","text":": ["},{"kind":"keyword","text":"any"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"MIDITuningCodec","preciseIdentifier":"s:8IvorMIDI15MIDITuningCodecP"},{"kind":"text","text":"]) "},{"kind":"keyword","text":"async"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"MIDIDevice","preciseIdentifier":"s:8IvorMIDI10MIDIDeviceV"},{"kind":"text","text":"?"}],"extendedModule":"IvorConnect","externalID":"s:11IvorConnect19MIDIDeviceDiscoveryV6search6codecs0A4MIDI0C0VSgSayAF15MIDITuningCodec_pG_tYaF"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivorconnect\/mididevicediscovery\/search(codecs:)"]}],"identifier":{"url":"doc:\/\/IvorConnect\/documentation\/IvorConnect\/MIDIDeviceDiscovery\/search(codecs:)","interfaceLanguage":"swift"},"references":{"doc://IvorConnect/documentation/IvorConnect/MIDIDeviceDiscovery":{"navigatorTitle":[{"text":"MIDIDeviceDiscovery","kind":"identifier"}],"iden