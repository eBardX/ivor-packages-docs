{"sections":[],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/IvorConnect\/documentation\/IvorConnect","doc:\/\/IvorConnect\/documentation\/IvorConnect\/MIDIDeviceDiscovery"]]},"abstract":[{"text":"Asks each address of each codec for a tuning, and returns the first","type":"text"},{"text":" ","type":"text"},{"text":"device that replies with one the codec understands.","type":"text"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"search"},{"kind":"text","text":"("},{"kind":"externalParam","text":"codecs"},{"kind":"text","text":": ["},{"kind":"keyword","text":"any"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"MIDITuningCodec","preciseIdentifier":"s:8IvorMIDI15MIDITuningCodecP"},{"kind":"text","text":"]) "},{"kind":"keyword","text":"async"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"MIDIDevice","preciseIdentifier":"s:8IvorMIDI10MIDIDeviceV"},{"kind":"text","text":"?"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"name":"codecs","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The codecs to try, in order. Nothing is sent to a"},{"type":"text","text":" "},{"type":"text","text":"device unless the caller asks for it here."}]}]}],"kind":"parameters"},{"content":[{"text":"Return Value","level":2,"type":"heading","anchor":"return-value"},{"inlineContent":[{"text":"The first device found, or ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" if there is none.","type":"text"}],"type":"paragraph"}],"kind":"content"},{"content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"inlineContent":[{"text":"A device found this way has the codec and the address that worked, but","type":"text"},{"text":" ","type":"text"},{"text":"no model. A reply can’t name a model, because models share formats. Its","type":"text