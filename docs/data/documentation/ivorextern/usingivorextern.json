{"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"IvorExtern connects "},{"type":"reference","identifier":"https:\/\/github.com\/eBardX\/IvorModel","isActive":true},{"type":"text","text":" works to"},{"type":"text","text":" "},{"type":"text","text":"files in other formats. Each format is handled by a lower-level Ivor package,"},{"type":"text","text":" "},{"type":"text","text":"which IvorExtern drives on your behalf:"}]},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Format","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Filename extensions","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Time basis","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Pitch notation","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Built on","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"ABC File","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"abc","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Beat","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Standard","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"IvorABC","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Guido Score File","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"gmn","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Beat","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Standard","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"IvorGMN","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"JohnnySonic Score File","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"dkm","type":"codeVoice"},{"text":", ","type":"text"},{"code":"johnnysonic","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Beat","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Absolute, keyboard","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"IvorDKM","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Standard MIDI File","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"mid","type":"codeVoice"},{"text":", ","type":"text"},{"code":"midi","type":"codeVoice"},{"text":", ","type":"text"},{"code":"smf","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Beat, wall","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Keyboard","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"IvorSMF","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"MusicXML Document","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"musicxml","type":"codeVoice"},{"text":", ","type":"text"},{"code":"xml","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Beat","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Standard","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"IvorMXL","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Compressed MusicXML Document","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"mxl","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Beat","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Standard","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"IvorMXL","type":"text"}]}]]],"header":"row","type":"table","alignments":["left","left","left","left","left"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The core types are "},{"type":"reference","identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/ImportFileFormat","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/ExportFileFormat","isActive":true},{"type":"text","text":", which read"},{"type":"text","text":" "},{"type":"text","text":"and write files, and "},{"type":"reference","identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance","isActive":true},{"type":"text","text":", which turns a work into timed MIDI"},{"type":"text","text":" "},{"type":"text","text":"channel messages."}]},{"anchor":"Finding-a-format","level":2,"type":"heading","text":"Finding a format"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A format is looked up by a filename extension or a MIME type, such as a"},{"type":"text","text":" "},{"type":"text","text":"document picker or a URL gives you:"}]},{"code":["let abc  = ImportFileFormat.importFileFormat(for: \"abc\")","let midi = ExportFileFormat.exportFileFormat(for: \"audio\/midi\")"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" for a tag no format supports. The type properties"},{"type":"text","text":" "},{"type":"codeVoice","code":"supportedFilenameExtensions"},{"type":"text","text":", "},{"type":"codeVoice","code":"supportedMIMETypes"},{"type":"text","text":", "},{"type":"codeVoice","code":"supportedTimeBases"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"codeVoice","code":"supportedPitchNotations"},{"type":"text","text":" list what is supported across every format, and their"},{"type":"text","text":" "},{"type":"codeVoice","code":"preferred…"},{"type":"text","text":" counterparts give one extension or MIME type per format, for"},{"type":"text","text":" "},{"type":"text","text":"building a file type list. A format value also has a"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/ImportFileFormat\/displayName","isActive":true},{"type":"text","text":" and its own extensions, MIME types, time bases,"},{"type":"text","text":" "},{"type":"text","text":"and pitch notations."}]},{"anchor":"Importing","level":2,"type":"heading","text":"Importing"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/ImportFileFormat\/read(from:options:)","isActive":true},{"type":"text","text":" reads every work a "},{"type":"codeVoice","code":"FileWrapper"},{"type":"text","text":" holds — an ABC"},{"type":"text","text":" "},{"type":"text","text":"file can hold a whole tunebook:"}]},{"code":["let works = try ImportFileFormat.importFileFormat(for: \"abc\")!","    .read(from: FileWrapper(url: url))"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each work comes back in the time basis and pitch notation of its format, as"},{"type":"text","text":" "},{"type":"text","text":"the table above shows. It holds whatever the file records of its parts, notes,"},{"type":"text","text":" "},{"type":"text","text":"dynamics, instruments, and pan positions, and of its descriptive information —"},{"type":"text","text":" "},{"type":"text","text":"titles, credits, rights, and remarks — in the work’s "},{"type":"codeVoice","code":"info"},{"type":"text","text":". A work read from a"},{"type":"text","text":" "},{"type":"text","text":"Standard MIDI File whose times were measured in SMPTE frames reports"},{"type":"text","text":" "},{"type":"codeVoice","code":"Work.hasMIDITimeCode"},{"type":"text","text":", so that writing it back keeps the same division."}]},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/ImportOptions","isActive":true},{"type":"text","text":" adjusts how a format reads: its"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/ImportOptions\/pedalSimplification","isActive":true},{"type":"text","text":" simplifies each imported pedal table. A"},{"type":"text","text":" "},{"type":"text","text":"format ignores any option it doesn’t use, and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/ImportFileFormat\/supportedOptions","isActive":true},{"type":"text","text":" lists the ones it does."}]},{"anchor":"Exporting","level":2,"type":"heading","text":"Exporting"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A format can write a work only in a time basis and pitch notation it supports."},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/ExportFileFormat\/canWrite(_:)","isActive":true},{"type":"text","text":" checks a work, and IvorModel’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"convert(timeBasis:pitchNotation:context:dropsUnconvertibleNotes:)"},{"type":"text","text":" converts"},{"type":"text","text":" "},{"type":"text","text":"one that doesn’t fit:"}]},{"code":["let midi = ExportFileFormat.exportFileFormat(for: \"mid\")!","var work = works[0]                        \/\/ beat time, standard pitch","","if !midi.canWrite(work) {","    work = try work.convert(timeBasis: .beat, pitchNotation: .keyboard)!","}","","let file = try midi.write(works: [work])   \/\/ a FileWrapper"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/ExportFileFormat\/write(works:options:)","isActive":true},{"type":"text","text":" writes one or more works to a "},{"type":"codeVoice","code":"FileWrapper"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"ready to save or share."}]},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/ExportOptions","isActive":true},{"type":"text","text":" adjusts how a format writes. For now its only options are"},{"type":"text","text":" "},{"type":"text","text":"the "},{"type":"reference","identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/MIDIExportOptions","isActive":true},{"type":"text","text":" of a Standard MIDI File: the ticks per quarter note"},{"type":"text","text":" "},{"type":"text","text":"for a beat-time work, and the frame rate and ticks per frame for a wall-time"},{"type":"text","text":" "},{"type":"text","text":"one. A format ignores any option it doesn’t use, and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/ExportFileFormat\/supportedOptions","isActive":true},{"type":"text","text":" lists the ones it does."}]},{"anchor":"Playing-a-work","level":2,"type":"heading","text":"Playing a work"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance","isActive":true},{"type":"text","text":" is a work as a MIDI player plays it: every part’s channel"},{"type":"text","text":" "},{"type":"text","text":"messages, each at its time in the work, in the order they are sent. It is made"},{"type":"text","text":" "},{"type":"text","text":"from a work in keyboard pitch and wall time — the initializer returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" for"},{"type":"text","text":" "},{"type":"text","text":"any other — and, optionally, a realization from IvorModel that says what each"},{"type":"text","text":" "},{"type":"text","text":"instrument sounds as:"}]},{"code":["let playable    = try work.convert(timeBasis: .wall, pitchNotation: .keyboard)!","let performance = WorkPerformance(work: playable)!","","performance.duration        \/\/ the time of the last event","performance.events          \/\/ bank selects, program changes, pan, expression, notes, …"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Without a realization, each instrument sounds as the General MIDI instrument"},{"type":"text","text":" "},{"type":"text","text":"its name matches. Event times are exact "},{"type":"codeVoice","code":"WallTime"},{"type":"text","text":" values, never floating-point"},{"type":"text","text":" "},{"type":"text","text":"seconds, so events at the same moment stay together; at the same time,"},{"type":"text","text":" "},{"type":"text","text":"note-offs come first, then bank selects, program changes, pan, expression,"},{"type":"text","text":" "},{"type":"text","text":"other controllers, and note-ons."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each part plays on a channel of its own, given in"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance\/partChannels","isActive":true},{"type":"text","text":", unless an instrument’s assignment moves it;"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance\/partChannelSets","isActive":true},{"type":"text","text":" lists every channel each part plays on."},{"type":"text","text":" "},{"type":"text","text":"Given an output for each part,"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance\/channelOutputs(forPartOutputs:)","isActive":true},{"type":"text","text":" returns an output for each"},{"type":"text","text":" "},{"type":"text","text":"channel, in the form a MIDI router such as IvorConnect’s "},{"type":"codeVoice","code":"MIDIRouter"},{"type":"text","text":" takes."}]},{"anchor":"General-MIDI-helpers","level":2,"type":"heading","text":"General MIDI helpers"},{"type":"paragraph","inlineContent":[{"text":"IvorExtern also extends a few IvorModel and IvorMIDI types with the General MIDI","type":"text"},{"text":" ","type":"text"},{"text":"knowledge its formats need:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"Instrument.generalMIDIInstrument","type":"codeVoice"},{"text":" gives the General MIDI Level 1 instrument","type":"text"},{"text":" ","type":"text"},{"text":"whose name an instrument’s name matches, if any.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"Patch.generalMIDIName","type":"codeVoice"},{"text":" gives the General MIDI name of a patch’s sound.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"MIDIPatch(instrument:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"MIDIPatch(patch:)","type":"codeVoice"},{"text":" give the bank and program","type":"text"},{"text":" ","type":"text"},{"text":"that select an instrument or a patch.","type":"text"}]}]}],"type":"unorderedList"},{"anchor":"Error-handling","level":2,"type":"heading","text":"Error handling"},{"type":"paragraph","inlineContent":[{"text":"Thrown errors conform to ","type":"text"},{"code":"EnhancedError","type":"codeVoice"},{"text":" (from","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"https:\/\/github.com\/eBardX\/XestiTools","type":"reference"},{"text":"): each has a ","type":"text"},{"code":"category","type":"codeVoice"},{"text":" of","type":"text"},{"text":" ","type":"text"},{"code":"\"IvorExtern\"","type":"codeVoice"},{"text":" and a human-readable ","type":"text"},{"code":"message","type":"codeVoice"},{"text":". Each also has a ","type":"text"},{"code":"cause","type":"codeVoice"},{"text":", holding","type":"text"},{"text":" ","type":"text"},{"text":"the error of the lower-level package that failed, if any.","type":"text"}]},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Type","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Thrown by","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/ImportFileFormat\/Error","type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/ImportFileFormat\/read(from:options:)","type":"reference"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/ExportFileFormat\/Error","type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/ExportFileFormat\/write(works:options:)","type":"reference"}]}]]],"header":"row","type":"table","alignments":["left","left"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Looking up a format returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" for an unsupported tag, and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance\/init(work:realization:)","isActive":true},{"type":"text","text":" returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" for a work not in"},{"type":"text","text":" "},{"type":"text","text":"keyboard pitch and wall time."}]},{"anchor":"Concurrency","level":2,"type":"heading","text":"Concurrency"},{"type":"paragraph","inlineContent":[{"type":"text","text":"IvorExtern is built for Swift 6 strict concurrency. Every public type is a"},{"type":"text","text":" "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":" value type, so instances can be freely shared across tasks and actor"},{"type":"text","text":" "},{"type":"text","text":"boundaries."}]}]}],"variants":[{"paths":["\/documentation\/ivorextern\/usingivorextern"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","metadata":{"title":"Using IvorExtern","roleHeading":"Article","role":"article","modules":[{"name":"IvorExtern"}]},"hierarchy":{"paths":[["doc:\/\/IvorExtern\/documentation\/IvorExtern"]]},"identifier":{"url":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/UsingIvorExtern","interfaceLanguage":"swift"},"sections":[],"abstract":[{"type":"text","text":"Read works from external music notation files, write them back out, and turn"},{"type":"text","text":