{"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivorextern\/usingivorextern"]}],"hierarchy":{"paths":[["doc:\/\/IvorExtern\/documentation\/IvorExtern"]]},"kind":"article","metadata":{"role":"article","modules":[{"name":"IvorExtern"}],"roleHeading":"Article","title":"Using IvorExtern"},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/UsingIvorExtern"},"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"inlineContent":[{"text":"IvorExtern connects ","type":"text"},{"identifier":"https:\/\/github.com\/eBardX\/IvorModel","isActive":true,"type":"reference"},{"text":" works to","type":"text"},{"text":" ","type":"text"},{"text":"files in other formats. Each format is handled by a lower-level Ivor package,","type":"text"},{"text":" ","type":"text"},{"text":"which IvorExtern drives on your behalf:","type":"text"}],"type":"paragraph"},{"rows":[[[{"inlineContent":[{"type":"text","text":"Format"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Filename extensions"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Time basis"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Pitch notation"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Built on"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"ABC File"}],"type":"paragraph"}],[{"inlineContent":[{"code":"abc","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Beat"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Standard"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"IvorABC"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Guido Score File"}],"type":"paragraph"}],[{"inlineContent":[{"code":"gmn","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Beat"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Standard"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"IvorGMN"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"JohnnySonic Score File"}],"type":"paragraph"}],[{"inlineContent":[{"code":"dkm","type":"codeVoice"},{"type":"text","text":", "},{"code":"johnnysonic","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Beat"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Absolute, keyboard"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"IvorDKM"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Standard MIDI File"}],"type":"paragraph"}],[{"inlineContent":[{"code":"mid","type":"codeVoice"},{"type":"text","text":", "},{"code":"midi","type":"codeVoice"},{"type":"text","text":", "},{"code":"smf","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Beat, wall"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Keyboard"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"IvorSMF"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"MusicXML Document"}],"type":"paragraph"}],[{"inlineContent":[{"code":"musicxml","type":"codeVoice"},{"type":"text","text":", "},{"code":"xml","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Beat"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Standard"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"IvorMXL"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Compressed MusicXML Document"}],"type":"paragraph"}],[{"inlineContent":[{"code":"mxl","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Beat"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Standard"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"IvorMXL"}],"type":"paragraph"}]]],"header":"row","type":"table","alignments":["left","left","left","left","left"]},{"inlineContent":[{"text":"There are three public types: ","type":"text"},{"identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/ImportFileFormat","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/ExportFileFormat","isActive":true,"type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"which read and write files, and ","type":"text"},{"identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance","isActive":true,"type":"reference"},{"text":", which turns a work into","type":"text"},{"text":" ","type":"text"},{"text":"timed MIDI channel messages.","type":"text"}],"type":"paragraph"},{"text":"Finding a format","type":"heading","level":2,"anchor":"Finding-a-format"},{"inlineContent":[{"text":"A format is looked up by a filename extension or a MIME type, such as a","type":"text"},{"text":" ","type":"text"},{"text":"document picker or a URL gives you:","type":"text"}],"type":"paragraph"},{"code":["let abc  = ImportFileFormat.importFileFormat(for: \"abc\")","let midi = ExportFileFormat.exportFileFormat(for: \"audio\/midi\")"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Each returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" for a tag no format supports. The type properties","type":"text"},{"text":" ","type":"text"},{"code":"supportedFilenameExtensions","type":"codeVoice"},{"text":", ","type":"text"},{"code":"supportedMIMETypes","type":"codeVoice"},{"text":", ","type":"text"},{"code":"supportedTimeBases","type":"codeVoice"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"code":"supportedPitchNotations","type":"codeVoice"},{"text":" list what is supported across every format, and their","type":"text"},{"text":" ","type":"text"},{"code":"preferred…","type":"codeVoice"},{"text":" counterparts give one extension or MIME type per format, for","type":"text"},{"type":"text","text":" "},{"type":"text","text":"building a file type list. A format value also has a"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/ImportFileFormat\/displayName"},{"text":" and its own extensions, MIME types, time bases,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"and pitch notations."}],"type":"paragraph"},{"text":"Importing","type":"heading","level":2,"anchor":"Importing"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/ImportFileFormat\/read(from:)"},{"type":"text","text":" reads every work a "},{"type":"codeVoice","code":"FileWrapper"},{"text":" holds — an ABC","type":"text"},{"text":" ","type":"text"},{"text":"file can hold a whole tunebook:","type":"text"}],"type":"paragraph"},{"code":["let works = try ImportFileFormat.importFileFormat(for: \"abc\")!","    .read(from: FileWrapper(url: url))"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Each work comes back in the time basis and pitch notation of its format, as"},{"type":"text","text":" "},{"text":"the table above shows. It holds whatever the file records of its parts, notes,","type":"text"},{"type":"text","text":" "},{"text":"dynamics, instruments, and pan positions, and of its descriptive information —","type":"text"},{"type":"text","text":" "},{"text":"titles, credits, rights, and remarks — in the work’s ","type":"text"},{"code":"info","type":"codeVoice"},{"text":". A work read from a","type":"text"},{"text":" ","type":"text"},{"text":"Standard MIDI File whose times were measured in SMPTE frames reports","type":"text"},{"text":" ","type":"text"},{"code":"Work.hasMIDITimeCode","type":"codeVoice"},{"text":", so that writing it back keeps the same division.","type":"text"}],"type":"paragraph"},{"text":"Exporting","type":"heading","level":2,"anchor":"Exporting"},{"inlineContent":[{"text":"A format can write a work only in a time basis and pitch notation it supports.","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/ExportFileFormat\/canWrite(_:)","isActive":true,"type":"reference"},{"type":"text","text":" checks a work, and IvorModel’s"},{"text":" ","type":"text"},{"code":"convert(timeBasis:pitchNotation:context:dropsUnconvertibleNotes:)","type":"codeVoice"},{"type":"text","text":" converts"},{"type":"text","text":" "},{"type":"text","text":"one that doesn’t fit:"}],"type":"paragraph"},{"code":["let midi = ExportFileFormat.exportFileFormat(for: \"mid\")!","var work = works[0]                        \/\/ beat time, standard pitch","","if !midi.canWrite(work) {","    work = try work.convert(timeBasis: .beat, pitchNotation: .keyboard)!","}","","let file = try midi.write(works: [work])   \/\/ a FileWrapper"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/ExportFileFormat\/write(works:)","isActive":true},{"text":" writes one or more works to a ","type":"text"},{"code":"FileWrapper","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"ready to save or share.","type":"text"}],"type":"paragraph"},{"text":"Playing a work","type":"heading","level":2,"anchor":"Playing-a-work"},{"inlineContent":[{"text":"A ","type":"text"},{"type":"reference","identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance","isActive":true},{"text":" is a work as a MIDI player plays it: every part’s channel","type":"text"},{"text":" ","type":"text"},{"text":"messages, each at its time in the work, in the order they are sent. It is made","type":"text"},{"text":" ","type":"text"},{"text":"from a work in keyboard pitch and wall time — the initializer returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" for","type":"text"},{"text":" ","type":"text"},{"text":"any other — and, optionally, a realization from IvorModel that says what each","type":"text"},{"text":" ","type":"text"},{"text":"instrument sounds as:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let playable    = try work.convert(timeBasis: .wall, pitchNotation: .keyboard)!","let performance = WorkPerformance(work: playable)!","","performance.duration        \/\/ when the last note ends","performance.events          \/\/ bank selects, program changes, pan, expression, notes, …"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Without a realization, each instrument sounds as the General MIDI instrument"},{"type":"text","text":" "},{"type":"text","text":"its name matches. Event times are exact "},{"type":"codeVoice","code":"WallTime"},{"type":"text","text":" values, never floating-point"},{"type":"text","text":" "},{"type":"text","text":"seconds, so events at the same moment stay together; at the same time,"},{"type":"text","text":" "},{"type":"text","text":"note-offs come first, then bank selects, program changes, pan, expression,"},{"type":"text","text":" "},{"type":"text","text":"other controllers, and note-ons."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Each part plays on a channel of its own, given in"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance\/partChannels"},{"type":"text","text":", unless an instrument’s assignment moves it;"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance\/partChannelSets"},{"text":" lists every channel each part plays on.","type":"text"},{"text":" ","type":"text"},{"text":"Given an output for each part,","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance\/channelOutputs(forPartOutputs:)"},{"text":" returns an output for each","type":"text"},{"type":"text","text":" "},{"text":"channel, in the form a MIDI router such as IvorConnect’s ","type":"text"},{"type":"codeVoice","code":"MIDIRouter"},{"text":" takes.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"General-MIDI-helpers","type":"heading","text":"General MIDI helpers"},{"inlineContent":[{"text":"IvorExtern also extends a few IvorModel and IvorMIDI types with the General MIDI","type":"text"},{"type":"text","text":" "},{"type":"text","text":"knowledge its formats need:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"Instrument.generalMIDIInstrument","type":"codeVoice"},{"text":" gives the General MIDI 1 instrument whose","type":"text"},{"text":" ","type":"text"},{"text":"name an instrument’s name matches, if any.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"Patch.generalMIDIName","type":"codeVoice"},{"text":" gives the General MIDI name of a patch’s sound.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"MIDIPatch(instrument:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"MIDIPatch(patch:)","type":"codeVoice"},{"text":" give the bank and program","type":"text"},{"text":" ","type":"text"},{"text":"that select an instrument or a patch.","type":"text"}],"type":"paragraph"}]}]},{"level":2,"anchor":"Error-handling","type":"heading","text":"Error handling"},{"inlineContent":[{"type":"text","text":"Thrown errors conform to "},{"type":"codeVoice","code":"EnhancedError"},{"type":"text","text":" (from"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/eBardX\/XestiTools"},{"type":"text","text":"): each has a "},{"type":"codeVoice","code":"category"},{"type":"text","text":" of"},{"type":"text","text":" "},{"type":"codeVoice","code":"\"IvorExtern\""},{"type":"text","text":" and a human-readable "},{"type":"codeVoice","code":"message"},{"type":"text","text":". Each also has a "},{"type":"codeVoice","code":"cause"},{"type":"text","text":", holding"},{"type":"text","text":" "},{"type":"text","text":"the error of the lower-level package that failed, if any."}],"type":"paragraph"},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"text":"Type","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Thrown by","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/ImportFileFormat\/Error","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/ImportFileFormat\/read(from:)","isActive":true}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/ExportFileFormat\/Error","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/ExportFileFormat\/write(works:)","isActive":true}],"type":"paragraph"}]]],"alignments":["left","left"]},{"inlineContent":[{"text":"Looking up a format returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" for an unsupported tag, and","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance\/init(work:realization:)","isActive":true,"type":"reference"},{"text":" returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" for a work not in","type":"text"},{"text":" ","type":"text"},{"text":"keyboard pitch and wall time.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Concurrency","type":"heading","text":"Concurrency"},{"inlineContent":[{"text":"IvorExtern is built for Swift 6 strict concurrency. Every public type is a","type":"text"},{"text":" ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":" value type, so instances can be freely shared across tasks and actor","type":"text"},{"text":" ","type":"text"},{"text":"boundaries.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"text":"Read works from external music notation files, write them back out, and turn","type":"text"},{"text":" ","type":"text"},{"text":"them into MIDI for playback.","type":"text"}],"references":{"https://github.com/eBardX/XestiTools":{"type":"link","identifier":"https:\/\/github.com\/eBardX\/XestiTools","title":"XestiTools","titleInlineContent":[{"text":"XestiTools","type":"text"}],"url":"https:\/\/github.com\/eBardX\/XestiTools"},"doc://IvorExtern/documentation/IvorExtern/WorkPerformance":{"role":"symbol","title":"WorkPerformance","url":"\/documentation\/ivorextern\/workperformance","identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"WorkPerformance","kind":"identifier"}],"navigatorTitle":[{"text":"WorkPerformance","kind":"identifier"}],"abstract":[{"text":"A work as a MIDI player plays it: every part’s channel messages, each at","type":"text"},{"text":" ","type":"text"},{"text":"its time in the work, in the order they are sent.","type":"text"}],"kind":"symbol"},"doc://IvorExtern/documentation/IvorExtern/WorkPerformance/partChannelSets":{"type":"topic","url":"\/documentation\/ivorextern\/workperformance\/partchannelsets","title":"partChannelSets","kind":"symbol","identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance\/partChannelSets","role":"symbol","abstract":[{"text":"Every channel each part plays on, in the work’s order: its own, and","type":"text"},{"text":" ","type":"text"},{"text":"any its instruments’ assignments move it to.","type":"text"}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"partChannelSets","kind":"identifier"},{"text":": [[","kind":"text"},{"text":"MIDIChannel","preciseIdentifier":"s:8IvorMIDI11MIDI