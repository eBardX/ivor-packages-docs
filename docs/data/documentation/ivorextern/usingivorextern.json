{"metadata":{"title":"Using IvorExtern","role":"article","modules":[{"name":"IvorExtern"}],"roleHeading":"Article"},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/UsingIvorExtern"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivorextern\/usingivorextern"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"article","hierarchy":{"paths":[["doc:\/\/IvorExtern\/documentation\/IvorExtern"]]},"abstract":[{"text":"Read works from external music notation files, write them back out, and turn","type":"text"},{"text":" ","type":"text"},{"text":"them into MIDI for playback.","type":"text"}],"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"IvorExtern connects "},{"isActive":true,"identifier":"https:\/\/github.com\/eBardX\/IvorModel","type":"reference"},{"type":"text","text":" works to"},{"type":"text","text":" "},{"type":"text","text":"files in other formats. Each format is handled by a lower-level Ivor package,"},{"type":"text","text":" "},{"type":"text","text":"which IvorExtern drives on your behalf:"}]},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Format"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Filename extensions"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Time basis"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Pitch notation"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Built on"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"ABC File","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"abc"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Beat"}]}],[{"type":"paragraph","inlineContent":[{"text":"Standard","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"IvorABC","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Guido Score File"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"gmn"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Beat"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Standard"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"IvorGMN"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"JohnnySonic Score File"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"dkm"},{"text":", ","type":"text"},{"type":"codeVoice","code":"johnnysonic"}]}],[{"type":"paragraph","inlineContent":[{"text":"Beat","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Absolute, keyboard","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"IvorDKM","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Standard MIDI File","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"mid"},{"text":", ","type":"text"},{"type":"codeVoice","code":"midi"},{"text":", ","type":"text"},{"type":"codeVoice","code":"smf"}]}],[{"type":"paragraph","inlineContent":[{"text":"Beat, wall","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Keyboard","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"IvorSMF","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"MusicXML Document","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"musicxml"},{"text":", ","type":"text"},{"type":"codeVoice","code":"xml"}]}],[{"type":"paragraph","inlineContent":[{"text":"Beat","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Standard","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"IvorMXL","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Compressed MusicXML Document"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"mxl"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Beat"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Standard"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"IvorMXL"}]}]]],"type":"table","header":"row","alignments":["left","left","left","left","left"]},{"type":"paragraph","inlineContent":[{"text":"The core types are ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/ImportFileFormat"},{"type":"text","text":" and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/ExportFileFormat"},{"text":", which read","type":"text"},{"type":"text","text":" "},{"text":"and write files, and ","type":"text"},{"identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance","type":"reference","isActive":true},{"type":"text","text":", which turns a work into timed MIDI"},{"type":"text","text":" "},{"type":"text","text":"channel messages."}]},{"text":"Finding a format","type":"heading","anchor":"Finding-a-format","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A format is looked up by a filename extension or a MIME type, such as a"},{"text":" ","type":"text"},{"text":"document picker or a URL gives you:","type":"text"}]},{"type":"codeListing","code":["let abc  = ImportFileFormat.importFileFormat(for: \"abc\")","let midi = ExportFileFormat.exportFileFormat(for: \"audio\/midi\")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" for a tag no format supports. The type properties"},{"type":"text","text":" "},{"type":"codeVoice","code":"supportedFilenameExtensions"},{"type":"text","text":", "},{"type":"codeVoice","code":"supportedMIMETypes"},{"type":"text","text":", "},{"type":"codeVoice","code":"supportedTimeBases"},{"type":"text","text":", and"},{"type":"text","text":" "},{"code":"supportedPitchNotations","type":"codeVoice"},{"type":"text","text":" list what is supported across every format, and their"},{"type":"text","text":" "},{"code":"preferred…","type":"codeVoice"},{"type":"text","text":" counterparts give one extension or MIME type per format, for"},{"type":"text","text":" "},{"type":"text","text":"building a file type list. A format value also has a"},{"type":"text","text":" "},{"identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/ImportFileFormat\/displayName","type":"reference","isActive":true},{"type":"text","text":" and its own extensions, MIME types, time bases,"},{"type":"text","text":" "},{"type":"text","text":"and pitch notations."}]},{"level":2,"anchor":"Importing","type":"heading","text":"Importing"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/ImportFileFormat\/read(from:options:)","type":"reference","isActive":true},{"type":"text","text":" reads every work a "},{"type":"codeVoice","code":"FileWrapper"},{"type":"text","text":" holds — an ABC"},{"type":"text","text":" "},{"type":"text","text":"file can hold a whole tunebook:"}]},{"type":"codeListing","code":["let works = try ImportFileFormat.importFileFormat(for: \"abc\")!","    .read(from: FileWrapper(url: url))"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each work comes back in the time basis and pitch notation of its format, as"},{"type":"text","text":" "},{"type":"text","text":"the table above shows. It holds whatever the file records of its parts, notes,"},{"type":"text","text":" "},{"type":"text","text":"dynamics, instruments, and pan positions, and of its descriptive information —"},{"type":"text","text":" "},{"type":"text","text":"titles, credits, rights, and remarks — in the work’s "},{"code":"info","type":"codeVoice"},{"type":"text","text":". A work read from a"},{"type":"text","text":" "},{"type":"text","text":"Standard MIDI File whose times were measured in SMPTE frames reports"},{"type":"text","text":" "},{"code":"Work.hasMIDITimeCode","type":"codeVoice"},{"type":"text","text":", so that writing it back keeps the same division."}]},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/ImportOptions","type":"reference","isActive":true},{"type":"text","text":" adjusts how a format reads: its"},{"type":"text","text":" "},{"identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/ImportOptions\/pedalSimplification","type":"reference","isActive":true},{"type":"text","text":" simplifies each imported pedal table. A"},{"type":"text","text":" "},{"type":"text","text":"format ignores any option it doesn’t use, and"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/ImportFileFormat\/supportedOptions","type":"reference"},{"type":"text","text":" lists the ones it does."}]},{"level":2,"anchor":"Exporting","type":"heading","text":"Exporting"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A format can write a work only in a time basis and pitch notation it supports."},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/ExportFileFormat\/canWrite(_:)","type":"reference"},{"type":"text","text":" checks a work, and IvorModel’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"convert(timeBasis:pitchNotation:context:dropsUnconvertibleNotes:)"},{"type":"text","text":" converts"},{"type":"text","text":" "},{"type":"text","text":"one that doesn’t fit:"}]},{"type":"codeListing","code":["let midi = ExportFileFormat.exportFileFormat(for: \"mid\")!","var work = works[0]                        \/\/ beat time, standard pitch","","if !midi.canWrite(work) {","    work = try work.convert(timeBasis: .beat, pitchNotation: .keyboard)!","}","","let file = try midi.write(works: [work])   \/\/ a FileWrapper"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/ExportFileFormat\/write(works:options:)","type":"reference","isActive":true},{"type":"text","text":" writes one or more works to a "},{"type":"codeVoice","code":"FileWrapper"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"ready to save or share."}]},{"level":3,"anchor":"Keys","type":"heading","text":"Keys"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A beat-time work’s key table comes in from every format that has keys and goes"},{"type":"text","text":" "},{"type":"text","text":"back out to it. Each entry is a "},{"type":"codeVoice","code":"Key"},{"type":"text","text":": atonal, diatonic (with the mode the"},{"type":"text","text":" "},{"type":"text","text":"source names, or none where it names none), or custom. A key a format records"},{"type":"text","text":" "},{"type":"text","text":"but Ivor can’t represent (one with a double sharp or flat, or a microtonal"},{"type":"text","text":" "},{"type":"text","text":"alteration) is left out on import, and so is one that only repeats the key"},{"type":"text","text":" "},{"type":"text","text":"before it. Mode names are normalized on round trip: ABC’s "},{"type":"codeVoice","code":"K:Aaeo"},{"type":"text","text":" comes back"},{"type":"text","text":" "},{"type":"text","text":"as "},{"type":"codeVoice","code":"K:Am"},{"type":"text","text":", and MusicXML’s "},{"type":"codeVoice","code":"<mode>ionian<\/mode>"},{"type":"text","text":" as "},{"type":"codeVoice","code":"<mode>major<\/mode>"},{"type":"text","text":"."}]},{"type":"table","header":"row","alignments":["left","left","left","left"],"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Format"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Reads"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Writes"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Loses"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"MIDI"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key signature meta events of the first track that has any, each as major or minor"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"A meta event at each key, on the first track"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"A custom key, written as its nearest diatonic signature; modes other than minor, and no mode, which read back as major; an atonal key, written as C major"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"MusicXML"}]}],[{"type":"paragraph","inlineContent":[{"code":"<key>","type":"codeVoice"},{"type":"text","text":" of each part’s first staff, traditional or not, along the play order; "},{"code":"<mode>none<\/mode>","type":"codeVoice"},{"type":"text","text":" as atonal"}]}],[{"type":"paragraph","inlineContent":[{"code":"<key>","type":"codeVoice"},{"type":"text","text":" at each key, at a measure’s start or in the middle"}]}],[{"type":"paragraph","inlineContent":[{"code":"<key-octave>","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"ABC"}]}],[{"type":"paragraph","inlineContent":[{"code":"K:","type":"codeVoice"},{"type":"text","text":" fields, in the header and inline, along the play order; "},{"code":"K:none","type":"codeVoice"},{"type":"text","text":" as atonal"}]}],[{"type":"paragraph","inlineContent":[{"code":"K:","type":"codeVoice"},{"type":"text","text":" and inline "},{"code":"[K:…]","type":"codeVoice"},{"type":"text","text":", with every note’s accidental written against the key and the bar"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"No mode, written as major; no key at all, written as "},{"code":"K:C","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Guido"}]}],[{"type":"paragraph","inlineContent":[{"code":"\\key","type":"codeVoice"},{"type":"text","text":": a number of fifths (no mode), a key name (major or minor), or a free key"}]}],[{"type":"paragraph","inlineContent":[{"code":"\\key","type":"codeVoice"},{"type":"text","text":": a key name for major or minor, a number of fifths otherwise, or a free key for a custom key"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Modes other than major and minor; an atonal key, written as no sharps or flats"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"JohnnySonic"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"—"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"—"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Every key"}]}]]]},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/ExportOptions","type":"reference","isActive":true},{"type":"text","text":" adjusts how a format writes. For now its only options are"},{"type":"text","text":" "},{"type":"text","text":"the "},{"identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/MIDIExportOptions","type":"reference","isActive":true},{"type":"text","text":" of a Standard MIDI File: the ticks per quarter note"},{"type":"text","text":" "},{"type":"text","text":"for a beat-time work, and the frame rate and ticks per frame for a wall-time"},{"type":"text","text":" "},{"type":"text","text":"one. A format ignores any option it doesn’t use, and"},{"type":"text","text":" "},{"identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/ExportFileFormat\/supportedOptions","type":"reference","isActive":true},{"type":"text","text":" lists the ones it does."}]},{"level":2,"anchor":"Playing-a-work","type":"heading","text":"Playing a work"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance","type":"reference","isActive":true},{"type":"text","text":" is a work as a MIDI player plays it: every part’s channel"},{"type":"text","text":" "},{"type":"text","text":"messages, each at its time in the work, in the order they are sent. It is made"},{"type":"text","text":" "},{"type":"text","text":"from a work in keyboard pitch and wall time — the initializer returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" for"},{"type":"text","text":" "},{"type":"text","text":"any other — and, optionally, a realization from IvorModel that says what each"},{"type":"text","text":" "},{"type":"text","text":"instrument sounds as:"}]},{"type":"codeListing","code":["let playable    = try work.convert(timeBasis: .wall, pitchNotation: .keyboard)!","let performance = WorkPerformance(work: playable)!","","performance.duration        \/\/ the time of the last event","performance.events          \/\/ bank selects, program changes, pan, expression, notes, …"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Without a realization, each instrument sounds as the General MIDI instrument"},{"type":"text","text":" "},{"type":"text","text":"its name matches. Event times are exact "},{"type":"codeVoice","code":"WallTime"},{"type":"text","text":" values, never floating-point"},{"type":"text","text":" "},{"type":"text","text":"seconds, so events at the same moment stay together; at the same time,"},{"type":"text","text":" "},{"type":"text","text":"note-offs come first, then bank selects, program changes, pan, expression,"},{"type":"text","text":" "},{"type":"text","text":"other controllers, and note-ons."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each part plays on a channel of its own, given in"},{"type":"text","text":" "},{"identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance\/partChannels","type":"reference","isActive":true},{"type":"text","text":", unless an instrument’s assignment moves it;"},{"type":"text","text":" "},{"identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance\/partChannelSets","type":"reference","isActive":true},{"type":"text","text":" lists every channel each part plays on."},{"type":"text","text":" "},{"type":"text","text":"Given an output for each part,"},{"type":"text","text":" "},{"identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance\/channelOutputs(forPartOutputs:)","type":"reference","isActive":true},{"type":"text","text":" returns an output for each"},{"type":"text","text":" "},{"type":"text","text":"channel, in the form a MIDI router such as IvorConnect’s "},{"type":"codeVoice","code":"MIDIRouter"},{"type":"text","text":" takes."}]},{"level":2,"anchor":"General-MIDI-helpers","type":"heading","text":"General MIDI helpers"},{"type":"paragraph","inlineContent":[{"type":"text","text":"IvorExtern also extends a few IvorModel and IvorMIDI types with the General MIDI"},{"type":"text","text":" "},{"type":"text","text":"knowledge its formats need:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Instrument.generalMIDIInstrument"},{"text":" gives the General MIDI Level 1 instrument","type":"text"},{"text":" ","type":"text"},{"text":"whose name an instrument’s name matches, if any.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Patch.generalMIDIName"},{"text":" gives the General MIDI name of a patch’s sound.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"MIDIPatch(instrument:)"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"MIDIPatch(patch:)"},{"text":" give the bank and program","type":"text"},{"text":" ","type":"text"},{"text":"that select an instrument or a patch.","type":"text"}]}]}]},{"level":2,"anchor":"Error-handling","type":"heading","text":"Error handling"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Thrown errors conform to "},{"code":"EnhancedError","type":"codeVoice"},{"type":"text","text":" (from"},{"type":"text","text":" "},{"isActive":true,"identifier":"https:\/\/github.com\/eBardX\/XestiTools","type":"reference"},{"type":"text","text":"): each has a "},{"code":"category","type":"codeVoice"},{"type":"text","text":" of"},{"type":"text","text":" "},{"code":"\"IvorExtern\"","type":"codeVoice"},{"type":"text","text":" and a human-readable "},{"code":"message","type":"codeVoice"},{"type":"text","text":". Each also has a "},{"code":"cause","type":"codeVoice"},{"type":"text","text":", holding"},{"type":"text","text":" "},{"type":"text","text":"the error of the lower-level package that failed, if any."}]},{"type":"table","header":"row","alignments":["left","left"],"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Type","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Thrown by","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/ImportFileFormat\/Error","type":"reference","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/ImportFileFormat\/read(from:options:)","type":"reference","isActive":true}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/ExportFileFormat\/Error","type":"reference","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/ExportFileFormat\/write(works:options:)","type":"reference","isActive":true}]}]]]},{"type":"paragraph","inlineContent":[{"text":"Looking up a format returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" for an unsupported tag, and","type":"text"},{"text":" ","type":"text"},{"code":"WorkPerformance\/init(work:realization:)","type":"codeVoice"},{"text":" returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" for a work not in","type":"text"},{"text":" ","type":"text"},{"text":"keyboard pitch and wall time.","type":"text"}]},{"level":2,"anchor":"Concurrency","type":"heading","text":"Concurrency"},{"type":"paragraph","inlineContent":[{"text":"IvorExtern is built for Swift 6 strict concurrency. Every public type is a","type":"text"},{"text":" ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":" value type, so instances can be freely shared across tasks and actor","type":"text"},{"text":" ","type":"text"},{"text":"boundaries.","type":"text"}]}],"kind":"content"}],"references":{"doc://IvorExtern/documentation/IvorExtern/ExportOptions":{"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ExportOptions"}],"type":"topic","identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/ExportOptions","title":"ExportOptions","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"ExportOptions"}],"url":"\/documentation\/ivorextern\/exportoptions","abstract":[{"text":"Options that adjust how an ","type":"text"},{"identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/ExportFileFormat","type":"reference","isActive":true},{"text":" writes works.","type":"text"}]},"doc://IvorExtern/documentation/IvorExtern/ExportFileFormat/supportedOptions":{"role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"supportedOptions","kind":"identifier"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Set","preciseIdentifier":"s:Sh"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"ExportOptions","preciseIdentifier":"s:10IvorExtern13ExportOptionsV"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Key","preciseIdentifier":"s:10IvorExtern13ExportOptionsV3KeyO"},{"kind":"text","text":">"}],"type":"topic","identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/ExportFileFormat\/supportedOptions","title":"supportedOptions","kind":"symbol","abstract":[{"type":"text","text":"The export options that this format uses. It ignores any others."}],"url":"\/documentation\/ivorextern\/exportfileformat\/supportedoptions"},"doc://IvorExtern/documentation/IvorExtern/ExportFileFormat":{"type":"topic","navi