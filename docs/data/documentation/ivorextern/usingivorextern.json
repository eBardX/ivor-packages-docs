"preciseIdentifier":"s:10IvorExtern13ExportOptionsV3KeyO","text":"Key","kind":"typeIdentifier"},{"text":">","kind":"text"}],"title":"supportedOptions","url":"\/documentation\/ivorextern\/exportfileformat\/supportedoptions","identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/ExportFileFormat\/supportedOptions","role":"symbol","type":"topic","kind":"symbol","abstract":[{"text":"The export options that this format uses. It ignores any others.","type":"text"}]},"doc://IvorExtern/documentation/IvorExtern/WorkPerformance/partChannelSets":{"role":"symbol","title":"partChannelSets","identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance\/partChannelSets","url":"\/documentation\/ivorextern\/workperformance\/partchannelsets","kind":"symbol","abstract":[{"text":"Every channel each part plays on, in the work’s order: the one each","type":"text"},{"text":" ","type":"text"},{"text":"of its instruments sounds on, which is the part’s own unless an","type":"text"},{"text":" ","type":"text"},{"text":"assignment moves the instrument.","type":"text"}],"fragments":[{"text":"let","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"partChannelSets"},{"kind":"text","text":": [["},{"kind":"typeIdentifier","preciseIdentifier":"s:8IvorMIDI11MIDIChannelV","text":"MIDIChannel"},{"kind":"text","text":"]]"}],"type":"topic"},"doc://IvorExtern/documentation/IvorExtern":{"title":"IvorExtern","abstract":[{"text":"An import and export framework for external music notation formats.","type":"text"}],"type":"topic","url":"\/documentation\/ivorextern","identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern","role":"collection","kind":"symbol"},"doc://IvorExtern/documentation/IvorExtern/ExportFileFormat":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ExportFileFormat","kind":"identifier"}],"title":"ExportFileFormat","abstract":[{"text":"A value that encapsulates a file format supported for exporting works.","type"