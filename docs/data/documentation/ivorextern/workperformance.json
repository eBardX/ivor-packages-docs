{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"WorkPerformance"}],"platforms":["macOS"],"languages":["swift"]}]},{"content":[{"text":"Overview","type":"heading","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The times are kept exactly as the work has them — never as"},{"type":"text","text":" "},{"type":"text","text":"floating-point seconds — so that events at the same time are ordered as"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance\/Event"},{"type":"text","text":" says, never by rounding. Each part has a channel of its own,"},{"type":"text","text":" "},{"type":"text","text":"skipping channel 10, which General MIDI keeps for percussion, until there"},{"type":"text","text":" "},{"type":"text","text":"are more parts than channels, when they share."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each of a part’s instruments sounds as the realization assigns it — the"},{"type":"text","text":" "},{"type":"text","text":"part’s own assignment, else the realization’s default — and plays on the"},{"type":"text","text":" "},{"type":"text","text":"assignment’s channel, if it names one, or a percussion patch on channel"},{"type":"text","text":" "},{"type":"text","text":"10, or else on the part’s own channel. An instrument the realization"},{"type":"text","text":" "},{"type":"text","text":"doesn’t assign sounds as "},{"type":"codeVoice","code":"IvorMIDI\/MIDIPatch\/init(instrument:)"},{"type":"text","text":" has it."},{"type":"text","text":" "},{"text":"Every channel a part uses gets its first patch at the start, so an","type":"text"},{"text":" ","type":"text"},{"text":"instrument change that moves to another channel sends no program change","type":"text"},{"text":" ","type":"text"},{"text":"partway through; one that stays on the channel sends one, after a bank","type":"text"},{"text":" ","type":"text"},{"text":"select if the patch has a bank, or if the channel’s previous patch had","type":"text"},{"text":" ","type":"text"},{"text":"one, which is then reset to bank 0 (see","type":"text"},{"text":" ","type":"text"},{"code":"IvorMIDI\/MIDIPatch\/selectionMessages(on:after:)","type":"codeVoice"},{"text":").","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For now every note sounds at a fixed velocity, and a note that glides","type":"text"},{"text":" ","type":"text"},{"text":"plays its start key only. Only a keyboard-pitch, wall-time work can be","type":"text"},{"text":" ","type":"text"},{"text":"made into a performance.","type":"text"}]}],"kind":"content"}],"metadata":{"symbolKind":"struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"WorkPerformance"}],"externalID":"s:10IvorExtern15WorkPerformanceV","title":"WorkPerformance","role":"symbol","modules":[{"name":"IvorExtern"}],"navigatorTitle":[{"text":"WorkPerformance","kind":"identifier"}],"roleHeading":"Structure"},"topicSections":[{"title":"Structures","generated":true,"anchor":"Structures","identifiers":["doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance\/Event"]},{"title":"Initializers","generated":true,"anchor":"Initializers","identifiers":["doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance\/init(work:realization:)"]},{"title":"Instance Properties","generated":true,"anchor":"Instance-Properties","identifiers":["doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance\/duration","doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance\/events","doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance\/partChannelSets","doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance\/partChannels"]},{"title":"Instance Methods","generated":true,"anchor":"Instance-Methods","identifiers":["doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance\/channelOutputs(forPartOutputs:)"]},{"title":"Default Implementations","generated":true,"anchor":"Default-Implementations","identifiers":["doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance\/Equatable-Implementations"]}],"identifier":{"url":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance","interfaceLanguage":"swift"},"abstract":[{"text":"A work as a MIDI player plays it: every part’s channel messages, each at","type":"text"},{"text":" ","type":"text"},{"text":"its time in the work, in the order they are sent.","type":"text"}],"relationshipsSections":[{"title":"Conforms To","type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/IvorExtern\/s8CopyableP","doc:\/\/IvorExtern\/SQ","doc:\/\/IvorExtern\/s9EscapableP","doc:\/\/IvorExtern\/s8SendableP","doc:\/\/IvorExtern\/s16SendableMetatypeP"]}],"variants":[{"paths":["\/documentation\/ivorextern\/workperformance"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/IvorExtern\/documentation\/IvorExtern"]]},"references":{"doc://IvorExtern/documentation/IvorExtern/WorkPerformance/channelOutputs(forPartOutputs:)":{"url":"\/documentation\/ivorextern\/workperformance\/channeloutputs(forpartoutputs:)","role":"symbol","abstract":[{"type":"text","text":"Returns which output each channel plays through, given each part’s."}],"kind":"symbol","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"channelOutputs","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Output","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"forPartOutputs","kind":"externalParam"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:10IvorExtern15WorkPerformanceV14channelOutputs07forPartF0SayxSgGSayxG_tlF6OutputL_xmfp","text":"Output","kind":"typeIdentifier"},{"text":"]) -> [","kind":"text"},{"preciseIdentifier":"s:10IvorExtern15WorkPerformanceV14channelOutputs07forPartF0SayxSgGSayxG_tlF6OutputL_xmfp","text":"Output","kind":"typeIdentifier"},{"text":"?]","kind":"text"}],"title":"channelOutputs(forPartOutputs:)","identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance\/channelOutputs(forPartOutputs:)"},"doc://IvorExtern/documentation/IvorExtern/WorkPerformance/partChannelSets":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"partChannelSets","kind":"identifier"},{"text":": [[","kind":"text"},{"text":"MIDIChannel","preciseIdentifier":"s:8IvorMIDI11MIDIChannelV","kind":"typeIdentifier"},{"text":"]]","kind":"text"}],"abstract":[{"text":"Every channel each part plays on, in the work’s order: its own, and","type":"text"},{"text":" ","type":"text"},{"text":"any its instruments’ assignments move it to.","type":"text"}],"title":"partChannelSets","identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance\/partChannelSets","role":"symbol","url":"\/documentation\/ivorextern\/workperformance\/partchannelsets","kind":"symbol","type":"topic"},"doc://IvorExtern/documentation/IvorExtern/WorkPerformance/partChannels":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"partChannels","kind":"identifier"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:8IvorMIDI11MIDIChannelV","text":"MIDIChannel","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance\/partChannels","title":"partChannels","abstract":[{"text":"The channel each part plays on unless an assignment says otherwise,","type":"text"},{"text":" ","type":"text"},{"text":"in the work’s order.","type":"text"}],"role":"symbol","url":"\/documentation\/ivorextern\/workperformance\/partchannels","kind":"symbol","type":"topic"},"doc://IvorExtern/s16SendableMetatypeP":{"identifier":"doc:\/\/IvorExtern\/s16SendableMetatypeP","title":"Swift.SendableMetatype","type":"un