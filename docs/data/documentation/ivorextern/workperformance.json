{"hierarchy":{"paths":[["doc:\/\/IvorExtern\/documentation\/IvorExtern"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance"},"kind":"symbol","relationshipsSections":[{"identifiers":["doc:\/\/IvorExtern\/s8CopyableP","doc:\/\/IvorExtern\/SQ","doc:\/\/IvorExtern\/s9EscapableP","doc:\/\/IvorExtern\/s8SendableP","doc:\/\/IvorExtern\/s16SendableMetatypeP"],"title":"Conforms To","type":"conformsTo","kind":"relationships"}],"sections":[],"metadata":{"role":"symbol","title":"WorkPerformance","roleHeading":"Structure","symbolKind":"struct","modules":[{"name":"IvorExtern"}],"navigatorTitle":[{"kind":"identifier","text":"WorkPerformance"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WorkPerformance","kind":"identifier"}],"externalID":"s:10IvorExtern15WorkPerformanceV"},"topicSections":[{"anchor":"Structures","title":"Structures","generated":true,"identifiers":["doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance\/Event"]},{"anchor":"Initializers","generated":true,"identifiers":["doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance\/init(work:realization:)"],"title":"Initializers"},{"anchor":"Instance-Properties","generated":true,"identifiers":["doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance\/duration","doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance\/events","doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance\/ownedChannelSets","doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance\/partChannelSets","doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance\/partChannels"],"title":"Instance Properties"},{"title":"Instance Methods","identifiers":["doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance\/channelOutputs(forPartOutputs:)"],"generated":true,"anchor":"Instance-Methods"},{"anchor":"Default-Implementations","generated":true,"identifiers":["doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance\/Equatable-Implementations"],"title":"Default Implementations"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ivorextern\/workperformance"]}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WorkPerformance","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"mentions":["doc:\/\/IvorExtern\/documentation\/IvorExtern\/UsingIvorExtern"],"kind":"mentions"},{"content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"The times are kept exactly as the work has them — never as"},{"type":"text","text":" "},{"type":"text","text":"floating-point seconds — so that events at the same time are ordered as"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance\/Event","isActive":true},{"type":"text","text":" says, never by rounding. Each part has a channel of its own,"},{"type":"text","text":" "},{"type":"text","text":"skipping channel 10, which General MIDI keeps for percussion, until there"},{"type":"text","text":" "},{"type":"text","text":"are more parts than channels, when they share."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Each of a part’s instruments sounds as the realization assigns it — the"},{"type":"text","text":" "},{"type":"text","text":"part’s own assignment, else the realization’s default — and plays on the"},{"type":"text","text":" "},{"type":"text","text":"assignment’s channel, if it names one, or a percussion patch on channel"},{"type":"text","text":" "},{"type":"text","text":"10, or else on the part’s own channel. An instrument the realization"},{"type":"text","text":" "},{"type":"text","text":"doesn’t assign sounds as "},{"type":"codeVoice","code":"IvorMIDI\/MIDIPatch\/init(instrument:)"},{"type":"text","text":" has it."},{"type":"text","text":" "},{"type":"text","text":"Every channel a part uses gets its first patch at the start, so an"},{"type":"text","text":" "},{"type":"text","text":"instrument change that moves to another channel sends no program change"},{"type":"text","text":" "},{"type":"text","text":"partway through; one that stays on the channel sends one, after a bank"},{"type":"text","text":" "},{"type":"text","text":"select if the patch has a bank, or if the channel’s previous patch had"},{"type":"text","text":" "},{"type":"text","text":"one, which is then reset to bank 0 (see"},{"type":"text","text":" "},{"type":"codeVoice","code":"IvorMIDI\/MIDIPatch\/selectionMessages(on:after:)"},{"type":"text","text":")."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Each note sounds at the velocity of the part’s dynamic level at its"},{"type":"text","text":" "},{"type":"text","text":"attack, so a crescendo rises note by note — or, where an importer kept"},{"type":"text","text":" "},{"type":"text","text":"the note’s exact velocity (its "},{"type":"codeVoice","code":"attackVelocity"},{"type":"text","text":" extra), at that."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Pan and expression are per channel, so each channel takes those of the"},{"type":"text","text":" "},{"type":"text","text":"first part that plays on it, and a later part that shares the channel"},{"type":"text","text":" "},{"type":"text","text":"sends none. A part sends its pan on every channel it owns at the start,"},{"type":"text","text":" "},{"type":"text","text":"and again at a pan-map entry or one of its attacks where the pan has"},{"type":"text","text":" "},{"type":"text","text":"changed, and throughout a glide while a note sounds. An entry’s exact"},{"type":"text","text":" "},{"type":"text","text":"14-bit pan, where an importer kept one, is sent as it is."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A part also sends expression (CC 11) on every channel it owns except"},{"type":"text","text":" "},{"type":"text","text":"percussion, starting at the start, so that a crescendo or diminuendo"},{"type":"text","text":" "},{"type":"text","text":"reaches a note already sounding, wherever a held note would otherwise"},{"type":"text","text":" "},{"type":"text","text":"drift audibly from the written level. The expression is relative to the"},{"type":"text","text":" "},{"type":"text","text":"velocity: a note attacking during one has a higher velocity, so it still"},{"type":"text","text":" "},{"type":"text","text":"sounds at the written level. Where an importer kept a file’s exact"},{"type":"text","text":" "},{"type":"text","text":"expression (the "},{"type":"codeVoice","code":"expressionValue"},{"type":"text","text":" extra of a dynamic-map entry), that is"},{"type":"text","text":" "},{"type":"text","text":"sent as it is instead."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Every note says which part it belongs to, so that a mixer can mute one"},{"type":"text","text":" "},{"type":"text","text":"part of several sharing a channel. The performance itself sends no channel"},{"type":"text","text":" "},{"type":"text","text":"volume (CC 7), which it leaves to the mixer."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For now a note that glides plays its start key only. Only a"},{"type":"text","text":" "},{"type":"text","text":"keyboard-pitch, wall-time work can be made into a performance."}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"type":"text","text":"A work as a MIDI player plays it: every part’s channel messages, each at"},{"type":"text","text":" "},{"type":"text","text":"its time in the work, in the order they are sent."}],"references":{"doc://IvorExtern/documentation/IvorExtern/WorkPerformance":{"role":"symbol","title":"WorkPerformance","url":"\/documentation\/ivorextern\/workperformance","identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"WorkPerformance","kind":"identifier"}],"navigatorTitle":[{"text":"WorkPerformance","kind":"identifier"}],"abstract":[{"text":"A work as a MIDI player plays it: every part’s channel messages, each at","type":"text"},{"text":" ","type":"text"},{"text":"its time in the work, in the order they are sent.","type":"text"}],"kind":"symbol"},"doc://IvorExtern/documentation/IvorExtern/WorkPerformance/partChannelSets":{"type":"topic","url":"\/documentation\/ivorextern\/workperformance\/partchannelsets","title":"partChannelSets","kind":"symbol","identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance\/partChannelSets","role":"symbol","abstract":[{"text":"Every channel each part plays on, in the work’s order: its own, and","type":"text"},{"text":" ","type":"text"},{"text":"any its instruments’ assignments move it to.","type":"text"}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"partChannelSets","kind":"identifier"},{"text":": [[","kind":"text"},{"text":"MIDIChannel","preciseIdentifier":"s:8IvorMIDI11MIDIChannelV","kind":"typeIdentifier"},{"text":"]]","kind":"text"}]},"doc://IvorExtern/s9EscapableP":{"title":"Swift.Escapable","type":"unresolvable","identifier":"doc:\/\/IvorExtern\/s9EscapableP"},"doc://IvorExtern/s8SendableP":{"title":"Swift.Sendable","type":"unresolvable","identifier":"doc:\/\/IvorExtern\/s8SendableP"},"doc://IvorExtern/documentation/IvorExtern/UsingIvorExtern":{"role":"article","title":"Using IvorExtern","identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/UsingIvorExtern","url":"\/documentation\/ivorextern\/usingivorextern","type":"topic","abstract":[{"text":"Read works from external music notation files, write them back out, and turn","type":"text"},{"text":" ","type":"text"},{"text":"them into MIDI for playback.","type":"text"}],"kind":"article"},"doc://IvorExtern/documentation/IvorExtern/WorkPerformance/events":{"type":"topic","url":"\/documentation\/ivorextern\/workperformance\/events","title":"events","kind":"symbol","identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance\/events","role":"symbol","abstract":[{"type":"text","text":"The events, in the order they are sent."}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"events","kind":"identifier"},{"text":": [","kind":"text"},{"text":"Event","preciseIdentifier":"s:10IvorExtern15WorkPerformanceV5EventV","kind":"typeIdentifier"},{"text":"]","kind":"text"}]},"doc://IvorExtern/documentation/IvorExtern/WorkPerformance/Event":{"role":"symbol","title":"WorkPerformance.Event","identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance\/Event","url":"\/documentation\/ivorextern\/workperformance\/event","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"kind":"identifier","text":"Event"}],"navigatorTitle":[{"text":"Event","kind":"identifier"}],"abstract":[{"text":"One channel message at its time in a work, exactly as the work has","type":"text"},{"text":" ","type":"text"},{"text":"it.","type":"text"}],"kind":"symbol"},"doc://IvorExtern/s8CopyableP":{"title":"Swift.Copyable","type":"unresolvable","identifier":"doc:\/\/IvorExtern\/s8CopyableP"},"doc://IvorExtern/SQ":{"title":"Swift.Equatable","type":"unresolvable","identifier":"doc:\/\/IvorExtern\/SQ"},"doc://IvorExtern/documentation/IvorExtern/WorkPerformance/partChannels":{"type":"topic","url":"\/documentation\/ivorextern\/workperformance\/partchannels","identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance\/partChannels","kind":"symbol","title":"partChannels","role":"symbol","abstract":[{"text":"The channel each part plays on unless an assignment says otherwise,","type":"text"},{"text":" ","type":"text"},{"text":"in the work’s order.","type":"text"}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"partChannels","kind":"identifier"},{"text":": [","kind":"text"},{"text":"MIDIChannel","kind":"typeIdentifier","preciseIdentifier":"s:8IvorMIDI11MIDIChannelV"},{"text":"]","kind":"text"}]},"doc://IvorExtern/documentation/IvorExtern/WorkPerformance/duration":{"title":"duration","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"duration","kind":"identifier"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:10IvorTiming8WallTimeV","text":"WallTime"}],"identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance\/duration","kind":"symbol","type":"topic","url":"\/documentation\/ivorextern\/workperformance\/duration","abstract":[{"type":"text","text":"When the last note ends, or zero for a work with no notes."}]},"doc://IvorExtern/documentation/IvorExtern":{"role":"collection","title":"IvorExtern","identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern","url":"\/documentation\/ivorextern","type":"topic","abstract":[{"text":"An import and export framework for external music notation formats.","type":"text"}],"kind":"symbol"},"doc://IvorExtern/documentation/IvorExtern/WorkPerformance/ownedChannelSets":{"type":"topic","url":"\/documentation\/ivorextern\/workperformance\/ownedchannelsets","title":"ownedChannelSets","kind":"symbol","identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance\/ownedChannelSets","role":"symbol","abstract":[{"text":"The channels each part owns, in the work’s order: those of its","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance\/partChannelSets","isActive":true},{"text":" that no earlier part plays on.","type":"text"}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ownedChannelSets","kind":"identifier"},{"text":": [[","kind":"text"},{"text":"MIDIChannel","preciseIdentifier":"s:8IvorMIDI11MIDIChannelV","kind":"typeIdentifier"},{"text":"]]","kind":"text"}]},"doc://IvorExtern/documentation/IvorExtern/WorkPerformance/Equatable-Implementations":{"title":"Equatable Implementations","role":"collectionGroup","identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance\/Equatable-Implementations","kind":"article","type":"topic","url":"\/documentation\/ivorextern\/workperformance\/equatable-implementations","abstract":[]},"doc://IvorExtern/documentation/IvorExtern/WorkPerformance/channelOutputs(forPartOutputs:)":{"type":"topic","url":"\/documentation\/ivorextern\/workperformance\/channeloutputs(forpartoutputs:)","identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance\/channelOutputs(forPartOutputs:)","kind":"symbol","title":"channelOutputs(forPartOutputs:)","role":"symbol","abstract":[{"type":"text","text":"Returns which output each channel plays through, given each part’s."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"channelOutputs","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Output","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"forPartOutputs","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"Output","kind":"typeIdentifier","preciseIdentifier":"s:10IvorExtern15WorkPerformanceV14channelOutputs07forPartF0SayxSgGSayxG_tlF6OutputL_xmfp"},{"text":"]) -> [","kind":"text"},{"text":"Output","kind":"typeIdentifier","preciseIdentifier":"s:10IvorExtern15WorkPerformanceV14channelOutputs07forPartF0SayxSgGSayxG_tlF6OutputL_xmfp"},{"text":"?]","kind":"text"}]},"doc://IvorExtern/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","type":"unresolvable","identifier":"doc:\/\/IvorExtern\/s16SendableMetatypeP"},"doc://IvorExtern/documentation/IvorExtern/WorkPerformance/init(work:realization:)":{"type":"topic","url":"\/documentation\/ivorextern\/workperformance\/init(work:realization:)","identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance\/init(work:realization:)","kind":"symbol","title":"init(work:realization:)","role":"symbol","abstract":[{"text":"Creates a ","type":"text"},{"type":"codeVoice","code":"WorkPerformance"},{"text":" instance for the provided work, as the","type":"text"},{"text":" ","type":"text"},{"text":"provided realization assigns its sounds, or ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" if the work isn’t","type":"text"},{"text":" ","type":"text"},{"text":"in keyboard pitch and wall time.","type":"text"}],"fragments":[{"text":"init","kind":"identifier"},{"text":"?(","kind":"text"},{"text":"work","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Work","kind":"typeIdentifier","preciseIdentifier":"s:9IvorModel4WorkV"},{"text":", ","kind":"text"},{"text":"realization","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Realization","kind":"typeIdentifier","preciseIdentifier":"s:9IvorModel11RealizationV"},{"text":"?)","kind":"text"}]}}}