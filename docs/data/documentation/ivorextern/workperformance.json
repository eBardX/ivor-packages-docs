{"metadata":{"role":"symbol","roleHeading":"Structure","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"WorkPerformance"}],"externalID":"s:10IvorExtern15WorkPerformanceV","title":"WorkPerformance","modules":[{"name":"IvorExtern"}],"symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"WorkPerformance"}]},"topicSections":[{"title":"Structures","generated":true,"anchor":"Structures","identifiers":["doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance\/Event"]},{"title":"Initializers","generated":true,"anchor":"Initializers","identifiers":["doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance\/init(work:realization:partsWithoutExpression:)"]},{"title":"Instance Properties","generated":true,"anchor":"Instance-Properties","identifiers":["doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance\/duration","doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance\/events","doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance\/ownedChannelSets","doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance\/partChannelSets","doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance\/partChannels","doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance\/partsWithoutExpression"]},{"title":"Instance Methods","generated":true,"anchor":"Instance-Methods","identifiers":["doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance\/channelOutputs(forPartOutputs:)"]},{"title":"Default Implementations","generated":true,"anchor":"Default-Implementations","identifiers":["doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance\/Equatable-Implementations"]}],"sections":[],"identifier":{"url":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/ivorextern\/workperformance"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","relationshipsSections":[{"title":"Conforms To","type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/IvorExtern\/s8CopyableP","doc:\/\/IvorExtern\/SQ","doc:\/\/IvorExtern\/s9EscapableP","doc:\/\/IvorExtern\/s8SendableP","doc:\/\/IvorExtern\/s16SendableMetatypeP"]}],"hierarchy":{"paths":[["doc:\/\/IvorExtern\/documentation\/IvorExtern"]]},"abstract":[{"type":"text","text":"A work as a MIDI player plays it: every part’s channel messages, each at"},{"type":"text","text":" "},{"type":"text","text":"its time in the work, in the order they are sent."}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"WorkPerformance"}],"languages":["swift"]}],"kind":"declarations"},{"mentions":["doc:\/\/IvorExtern\/documentation\/IvorExtern\/UsingIvorExtern"],"kind":"mentions"},{"content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The times are kept exactly as the work has them — never as"},{"type":"text","text":" "},{"type":"text","text":"floating-point seconds — so that events at the same time are ordered as"},{"type":"text","text":" "},{"identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance\/Event","type":"reference","isActive":true},{"type":"text","text":" says, never by rounding. Each part has a channel of its own,"},{"type":"text","text":" "},{"type":"text","text":"skipping channel 10, which General MIDI keeps for percussion, until there"},{"type":"text","text":" "},{"type":"text","text":"are more parts than channels, when they share."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each of a part’s instruments sounds as the realization assigns it — the"},{"type":"text","text":" "},{"type":"text","text":"part’s own assignment, else the realization’s default — and plays on the"},{"type":"text","text":" "},{"type":"text","text":"assignment’s channel, if it names one, or a percussion patch on channel"},{"type":"text","text":" "},{"type":"text","text":"10, or else on the part’s own channel. An instrument the realization"},{"type":"text","text":" "},{"type":"text","text":"doesn’t assign sounds as "},{"type":"codeVoice","code":"IvorMIDI\/MIDIPatch\/init(instrument:)"},{"type":"text","text":" has it."},{"type":"text","text":" "},{"type":"text","text":"Every channel a part uses gets its first patch at the start, so an"},{"type":"text","text":" "},{"type":"text","text":"instrument change that moves to another channel sends no program change"},{"type":"text","text":" "},{"type":"text","text":"partway through; one that stays on the channel sends one, after a bank"},{"type":"text","text":" "},{"type":"text","text":"select if the patch has a bank, or if the channel’s previous patch had"},{"type":"text","text":" "},{"type":"text","text":"one, which is then reset to bank 0 (see"},{"type":"text","text":" "},{"type":"codeVoice","code":"IvorMIDI\/MIDIPatch\/selectionMessages(on:after:)"},{"type":"text","text":")."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each note sounds at the velocity of the part’s dynamic level at its"},{"type":"text","text":" "},{"type":"text","text":"attack, so a crescendo rises note by note — or, where an importer kept"},{"type":"text","text":" "},{"type":"text","text":"the note’s exact velocity (its "},{"type":"codeVoice","code":"attackVelocity"},{"type":"text","text":" extra), at that."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Pan and expression are per channel, so each channel takes those of the"},{"type":"text","text":" "},{"type":"text","text":"first part that plays on it, and a later part that shares the channel"},{"type":"text","text":" "},{"type":"text","text":"sends none. A part sends its pan on every channel it owns at the start,"},{"type":"text","text":" "},{"type":"text","text":"and again at a pan-map entry or one of its attacks where the pan has"},{"type":"text","text":" "},{"type":"text","text":"changed, and throughout a glide while a note sounds. An entry’s exact"},{"type":"text","text":" "},{"type":"text","text":"14-bit pan, where an importer kept one, is sent as it is."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A part also sends expression (CC 11) on every channel it owns except"},{"type":"text","text":" "},{"type":"text","text":"percussion, starting at the start, so that a crescendo or diminuendo"},{"type":"text","text":" "},{"type":"text","text":"reaches a note already sounding, wherever a held note would otherwise"},{"type":"text","text":" "},{"type":"text","text":"drift audibly from the written level. The expression is relative to the"},{"type":"text","text":" "},{"type":"text","text":"velocity: a note attacking during one has a higher velocity, so it still"},{"type":"text","text":" "},{"type":"text","text":"sounds at the written level. Where an importer kept a file’s exact"},{"type":"text","text":" "},{"type":"text","text":"expression (the "},{"type":"codeVoice","code":"expressionValue"},{"type":"text","text":" extra of a dynamic-map entry), that is"},{"type":"text","text":" "},{"type":"text","text":"sent as it is instead. A part in "},{"identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance\/partsWithoutExpression","type":"reference","isActive":true},{"type":"text","text":" — one that"},{"type":"text","text":" "},{"type":"text","text":"plays through an output that ignores CC 11 — sends no expression, and"},{"type":"text","text":" "},{"type":"text","text":"its notes keep their plain velocities, so dynamics fall back on velocity"},{"type":"text","text":" "},{"type":"text","text":"alone."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Pedals follow pan’s rule: a part sends its pedals on every channel it"},{"type":"text","text":" "},{"type":"text","text":"owns, percussion included, and a later part sharing a channel sends none,"},{"type":"text","text":" "},{"type":"text","text":"so a shared channel’s pedals hold every part’s notes on it. Each"},{"type":"text","text":" "},{"type":"text","text":"pedal-table entry is sent exactly as stored, in table order, never"},{"type":"text","text":" "},{"type":"text","text":"sampled, so a re-pedal (an Up then a Down at one time) lets the pedal up"},{"type":"text","text":" "},{"type":"text","text":"and puts it down again. Muting mutes notes only, so a muted part’s"},{"type":"text","text":" "},{"type":"text","text":"pedals are still sent. Portamento (CC 65) isn’t sent yet: a future"},{"type":"text","text":" "},{"type":"text","text":"gliding-notes feature will send it, and decide who owns it."}]},{"type":"paragraph","inlineContent":[{"text":"Every note says which part it belongs to, so that a mixer can mute one","type":"text"},{"text":" ","type":"text"},{"text":"part of several sharing a channel. The performance itself sends no channel","type":"text"},{"text":" ","type":"text"},{"text":"volume (CC 7), which it leaves to the mixer.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For now a note that glides plays its start key only. Only a","type":"text"},{"text":" ","type":"text"},{"text":"keyboard-pitch, wall-time work can be made into a performance.","type":"text"}]}],"kind":"content"}],"references":{"doc://IvorExtern/s8CopyableP":{"title":"Swift.Copyable","type":"unresolvable","identifier":"doc:\/\/IvorExtern\/s8CopyableP"},"doc://IvorExtern/documentation/IvorExtern/WorkPerformance/partChannelSets":{"role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"partChannelSets","kind":"identifier"},{"text":": [[","kind":"text"},{"text":"MIDIChannel","kind":"typeIdentifier","preciseIdentifier":"s:8IvorMIDI11MIDIChannelV"},{"text":"]]","kind":"text"}],"type":"topic","identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance\/partChannelSets","title":"partChannelSets","kind":"symbol","url":"\/documentation\/ivorextern\/workperformance\/partchannelsets","abstract":[{"type":"text","text":"Every channel each part plays on, in the work’s order: the one each"},{"type":"text","text":" "},{"type":"text","text":"of its instruments sounds on, which is the part’s own unless an"},{"type":"text","text":" "},{"type":"text","text":"assignment moves the instrument."}]},"doc://IvorExtern/documentation/IvorExtern/WorkPerformance/init(work:realization:partsWithoutExpression:)":{"title":"init(work:realization:partsWithoutExpression:)","abstract":[{"type":"text","text":"Creates a "},{"code":"WorkPerformance","type":"codeVoice"},{"type":"text","text":" instance for the provided work, as the"},{"type":"text","text":" "},{"type":"text","text":"provided realization assigns its sounds, or "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" if the work isn’t"},{"type":"text","text":" "},{"type":"text","text":"in keyboard pitch and wall time."}],"identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance\/init(work:realization:partsWithoutExpression:)","kind":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"?(","kind":"text"},{"text":"work","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Work","kind":"typeIdentifier","preciseIdentifier":"s:9IvorModel4WorkV"},{"text":", ","kind":"text"},{"text":"realization","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Realization","kind":"typeIdentifier","preciseIdentifier":"s:9IvorModel11RealizationV"},{"text":"?, ","kind":"text"},{"text":"partsWithoutExpression","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Set","kind":"typeIdentifier","preciseIdentifier":"s:Sh"},{"text":"<","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":">)","kind":"text"}],"url":"\/documentation\/ivorextern\/workperformance\/init(work:realization:partswithoutexpression:)","role":"symbol","type":"topic"},"doc://IvorExtern/documentation/IvorExtern/WorkPerformance/Equatable-Implementations":{"role":"collectionGroup","type":"topic","identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance\/Equatable-Implementations","title":"Equatable Implementations","kind":"article","url":"\/documentation\/ivorextern\/workperformance\/equatable-implementations","abstract":[]},"doc://IvorExtern/documentation/IvorExtern/WorkPerformance/partsWithoutExpression":{"role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"partsWithoutExpression"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sh","kind":"typeIdentifier","text":"Set"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":">"}],"type":"topic","identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance\/partsWithoutExpression","title":"partsWithoutExpression","kind":"symbol","url":"\/documentation\/ivorextern\/workperformance\/partswithoutexpression","abstract":[{"text":"The indices, in the work’s order, of the parts that send no","type":"text"},{"text":" ","type":"text"},{"text":"expression (CC 11), as given when the performance was made.","type":"text"}]},"doc://IvorExtern/SQ":{"title":"Swift.Equatable","identifier":"doc:\/\/IvorExtern\/SQ","type":"unresolvable"},"doc://IvorExtern/documentation/IvorExtern/WorkPerformance/ownedChannelSets":{"role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ownedChannelSets","kind":"identifier"},{"text":": [[","kind":"text"},{"text":"MIDIChannel","kind":"typeIdentifier","preciseIdentifier":"s:8IvorMIDI11MIDIChannelV"},{"text":"]]","kind":"text"}],"type":"topic","identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance\/ownedChannelSets","title":"ownedChannelSets","kind":"symbol","url":"\/documentation\/ivorextern\/workperformance\/ownedchannelsets","abstract":[{"type":"text","text":"The channels each part owns, in the work’s order: those of its"},{"type":"text","text":" "},{"identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance\/partChannelSets","type":"reference","isActive":true},{"type":"text","text":" that no earlier part plays on."}]},"doc://IvorExtern/documentation/IvorExtern/WorkPerformance/events":{"abstract":[{"text":"The events, in the order they are sent.","type":"text"}],"title":"events","identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance\/events","kind":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"events"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:10IvorExtern15WorkPerformanceV5EventV","kind":"typeIdentifier","text":"Event"},{"kind":"text","text":"]"}],"url":"\/documentation\/ivorextern\/workperformance\/events","role":"symbol","type":"topic"},"doc://IvorExtern/documentation/IvorExtern/WorkPerformance/channelOutputs(forPartOutputs:)":{"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"channelOutputs","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Output","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"forPartOutputs","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"Output","kind":"typeIdentifier","preciseIdentifier":"s:10IvorExtern15WorkPerformanceV14channelOutputs07forPartF0SayxSgGSayxG_tlF6OutputL_xmfp"},{"text":"]) -> [","kind":"text"},{"text":"Output","kind":"typeIdentifier","preciseIdentifier":"s:10IvorExtern15WorkPerformanceV14channelOutputs07forPartF0SayxSgGSayxG_tlF6OutputL_xmfp"},{"text":"?]","kind":"text"}],"type":"topic","identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance\/channelOutputs(forPartOutputs:)","title":"channelOutputs(forPartOutputs:)","kind":"symbol","url":"\/documentation\/ivorextern\/workperformance\/channeloutputs(forpartoutputs:)","abstract":[{"type":"text","text":"Returns which output each channel plays through, given each part’s."}]},"doc://IvorExtern/documentation/IvorExtern":{"role":"collection","type":"topic","identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern","title":"IvorExtern","kind":"symbol","url":"\/documentation\/ivorextern","abstract":[{"text":"An import and export framework for external music notation formats.","type":"text"}]},"doc://IvorExtern/documentation/IvorExtern/WorkPerformance":{"navigatorTitle":[{"kind":"identifier","text":"WorkPerformance"}],"title":"WorkPerformance","abstract":[{"type":"text","text":"A work as a MIDI player plays it: every part’s channel messages, each at"},{"type":"text","text":" "},{"type":"text","text":"its time in the work, in the order they are sent."}],"identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"WorkPerformance"}],"url":"\/documentation\/ivorextern\/workperformance","role":"symbol","type":"topic"},"doc://IvorExtern/documentation/IvorExtern/WorkPerformance/duration":{"role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"duration","kind":"identifier"},{"text":": ","kind":"text"},{"text":"WallTime","kind":"typeIdentifier","preciseIdentifier":"s:10IvorTiming8WallTimeV"}],"type":"topic","identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance\/duration","title":"duration","kind":"symbol","abstract":[{"type":"text","text":"The time of the last event, or zero for a work with no events."}],"url":"\/documentation\/ivorextern\/workperformance\/duration"},"doc://IvorExtern/documentation/IvorExtern/UsingIvorExtern":{"title":"Using IvorExtern","abstract":[{"type":"text","text":"Read works from external music notation files, write them back out, and turn"},{"type":"text","text":" "},{"type":"text","text":"them into MIDI for playback."}],"identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/UsingIvorExtern","kind":"article","url":"\/documentation\/ivorextern\/usingivorextern","role":"article","type":"topic"},"doc://IvorExtern/documentation/IvorExtern/WorkPerformance/Event":{"type":"topic","navigatorTitle":[{"kind":"identifier","text":"Event"}],"title":"WorkPerformance.Event","kind":"symbol","abstract":[{"type":"text","text":"One channel message at its time in a work, exactly as the work has"},{"type":"text","text":" "},{"type":"text","text":"it."}],"identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance\/Event","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Event"}],"url":"\/documentation\/ivorextern\/workperformance\/event","role":"symbol"},"doc://IvorExtern/s9EscapableP":{"title":"Swift.Escapable","type":"unresolvable","identifier":"doc:\/\/IvorExtern\/s9EscapableP"},"doc://IvorExtern/s8SendableP":{"title":"Swift.Sendable","type":"unresolvable","identifier":"doc:\/\/IvorExtern\/s8SendableP"},"doc://IvorExtern/documentation/IvorExtern/WorkPerformance/partChannels":{"title":"partChannels","abstract":[{"type":"text","text":"The channel each part plays on unless an assignment says otherwise,"},{"type":"text","text":" "},{"type":"text","text":"in the work’s order."}],"identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance\/partChannels","kind":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"partChannels"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:8IvorMIDI11MIDIChannelV","kind":"typeIdentifier","text":"MIDIChannel"},{"kind":"text","text":"]"}],"url":"\/documentation\/ivorextern\/workperformance\/partchannels","role":"symbol","type":"topic"},"doc://IvorExtern/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","type":"unresolvable","identifier":"doc:\/\/IvorExtern\/s16SendableMetatypeP"}}}