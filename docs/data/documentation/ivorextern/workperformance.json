 with no notes.","type":"text"}],"type":"topic","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"duration"},{"kind":"text","text":": "},{"preciseIdentifier":"s:10IvorTiming8WallTimeV","kind":"typeIdentifier","text":"WallTime"}],"title":"duration","identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern\/WorkPerformance\/duration"},"doc://IvorExtern/s8CopyableP":{"type":"unresolvable","title":"Swift.Copyable","identifier":"doc:\/\/IvorExtern\/s8CopyableP"},"doc://IvorExtern/s8SendableP":{"type":"unresolvable","title":"Swift.Sendable","identifier":"doc:\/\/IvorExtern\/s8SendableP"},"doc://IvorExtern/documentation/IvorExtern":{"url":"\/documentation\/ivorextern","role":"collection","abstract":[{"type":"text","text":"An import and export framework for external music notation formats."}],"kind":"symbol","type":"topic","title":"IvorExtern","identifier":"doc:\/\/IvorExtern\/documentation\/IvorExtern"}}}